with recursive RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 as Level,
        array[t.Id] as Path
    from Tags t
    where t.IsRequired = true

    union all

    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        r.Level + 1,
        r.Path || t.Id
    from Tags t
    join RecursiveTagHierarchy r on t.IsRequired = true and not t.Id = any(r.Path)
    where r.Level < 3
),
UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        coalesce(sum(case when b.TagBased = true then 1 else 0 end),0) as TagBasedBadges,
        row_number() over (partition by u.Id order by max(b.Date) desc nulls last) as BadgeRecencyRank
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostAnswerStats as (
    select
        p.Id as QuestionId,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        p.Score as QuestionScore,
        p.ViewCount,
        p.Tags,
        count(a.Id) as AnswerCount,
        max(a.Score) as MaxAnswerScore,
        avg(a.Score) as AvgAnswerScore,
        sum(case when a.OwnerUserId is null then 0 else 1 end) as AnswersWithOwner,
        bool_or(p.ClosedDate is not null) as IsClosed
    from Posts p
    left join Posts a on a.ParentId = p.Id and a.PostTypeId = 2
    where p.PostTypeId = 1
    group by p.Id, p.Title, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount, p.Tags, p.ClosedDate
),
PostVotesAgg as (
    select
        v.PostId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes,
        sum(case when vt.Name = 'Favorite' then 1 else 0 end) as Favorites,
        sum(case when vt.Name = 'BountyStart' then coalesce(v.BountyAmount,0) else 0 end) as TotalBountyStarted,
        sum(case when vt.Name = 'BountyClose' then coalesce(v.BountyAmount,0) else 0 end) as TotalBountyClosed
    from Votes v
    join VoteTypes vt on vt.Id = v.VoteTypeId
    group by v.PostId
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.CreationDate,
        count(*) over (partition by u.Id order by p.CreationDate rows between 29 preceding and current row) as PostsLast30Days,
        sum(case when p.PostTypeId = 1 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 29 preceding and current row) as QuestionsLast30Days,
        sum(case when p.PostTypeId = 2 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 29 preceding and current row) as AnswersLast30Days
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where p.CreationDate is not null
),
TopQuestionsWithComments as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        q.Tags,
        c.CommentCount,
        c.LatestCommentDate,
        c.LatestCommentUserId,
        c.LatestCommentText
    from Posts q
    left join (
        select
            PostId,
            count(*) as CommentCount,
            max(CreationDate) as LatestCommentDate,
            max(UserId) filter (where CreationDate = max(CreationDate) over (partition by PostId)) as LatestCommentUserId,
            max(Text) filter (where CreationDate = max(CreationDate) over (partition by PostId)) as LatestCommentText
        from Comments
        group by PostId
    ) c on c.PostId = q.Id
    where q.PostTypeId = 1 and q.Score > 10
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        u.DisplayName as PostOwner,
        ru.DisplayName as RelatedPostOwner
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId and lt.Name = 'Duplicate'
    join Posts p on p.Id = pl.PostId
    left join Users u on u.Id = p.OwnerUserId
    join Posts rp on rp.Id = pl.RelatedPostId
    left join Users ru on ru.Id = rp.OwnerUserId
),
QuestionsWithAcceptedAnswerDetails as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        q.Score as QuestionScore,
        a.Id as AcceptedAnswerId,
        a.Score as AcceptedAnswerScore,
        a.OwnerUserId as AcceptedAnswerOwnerUserId,
        a.CreationDate as AcceptedAnswerCreationDate,
        (extract(epoch from (a.CreationDate - q.CreationDate))/3600) as HoursToAccept
    from Posts q
    left join Posts a on a.Id = q.AcceptedAnswerId
    where q.PostTypeId = 1 and q.AcceptedAnswerId is not null
),
UserReputationRank as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
),
FinalAggregated as (
    select
        pqs.QuestionId,
        pqs.Title,
        pqs.OwnerUserId,
        u.DisplayName as QuestionOwnerName,
        pqs.CreationDate,
        pqs.QuestionScore,
        pqs.ViewCount,
        pqs.Tags,
        pqs.AnswerCount,
        pqs.MaxAnswerScore,
        pqs.AvgAnswerScore,
        pqs.AnswersWithOwner,
        pqs.IsClosed,
        pva.UpVotes,
        pva.DownVotes,
        pva.Favorites,
        pva.TotalBountyStarted,
        pva.TotalBountyClosed,
        ubs.GoldBadges,
        ubs.SilverBadges,
        ubs.BronzeBadges,
        ubs.TagBasedBadges,
        qaa.AcceptedAnswerId,
        qaa.AcceptedAnswerScore,
        qaa.AcceptedAnswerOwnerUserId,
        qaa.HoursToAccept,
        ur.ReputationRank
    from PostAnswerStats pqs
    left join PostVotesAgg pva on pva.PostId = pqs.QuestionId
    left join UserBadgeStats ubs on ubs.UserId = pqs.OwnerUserId
    left join QuestionsWithAcceptedAnswerDetails qaa on qaa.QuestionId = pqs.QuestionId
    left join Users u on u.Id = pqs.OwnerUserId
    left join UserReputationRank ur on ur.Id = pqs.OwnerUserId
)
select
    fa.QuestionId,
    fa.Title,
    fa.QuestionOwnerName,
    fa.CreationDate,
    fa.QuestionScore,
    fa.ViewCount,
    fa.Tags,
    fa.AnswerCount,
    fa.MaxAnswerScore,
    round(cast(fa.AvgAnswerScore as numeric),2) as AvgAnswerScore,
    fa.AnswersWithOwner,
    fa.IsClosed,
    fa.UpVotes,
    fa.DownVotes,
    fa.Favorites,
    fa.TotalBountyStarted,
    fa.TotalBountyClosed,
    fa.GoldBadges,
    fa.SilverBadges,
    fa.BronzeBadges,
    fa.TagBasedBadges,
    fa.AcceptedAnswerId,
    fa.AcceptedAnswerScore,
    fa.AcceptedAnswerOwnerUserId,
    round(cast(fa.HoursToAccept as numeric),2) as HoursToAccept,
    fa.ReputationRank,
    case
        when fa.IsClosed then 'Closed'
        when fa.AnswerCount = 0 then 'Unanswered'
        when fa.AcceptedAnswerId is not null then 'Answered-Accepted'
        else 'Answered-NoAccept'
    end as QuestionStatus,
    coalesce(substring(trim(both '<>' from fa.Tags) from 1 for position('><' in trim(both '<>' from fa.Tags)) - 1), 'none') as FirstTag,
    (fa.ViewCount > 10000 and fa.GoldBadges > 0 and fa.ReputationRank <= 1000) as IsPopularHighRepOwner
from FinalAggregated fa
where fa.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
group by
    fa.QuestionId,
    fa.Title,
    fa.QuestionOwnerName,
    fa.CreationDate,
    fa.QuestionScore,
    fa.ViewCount,
    fa.Tags,
    fa.AnswerCount,
    fa.MaxAnswerScore,
    fa.AvgAnswerScore,
    fa.AnswersWithOwner,
    fa.IsClosed,
    fa.UpVotes,
    fa.DownVotes,
    fa.Favorites,
    fa.TotalBountyStarted,
    fa.TotalBountyClosed,
    fa.GoldBadges,
    fa.SilverBadges,
    fa.BronzeBadges,
    fa.TagBasedBadges,
    fa.AcceptedAnswerId,
    fa.AcceptedAnswerScore,
    fa.AcceptedAnswerOwnerUserId,
    fa.HoursToAccept,
    fa.ReputationRank
order by fa.ViewCount desc, fa.QuestionScore desc
limit 100;