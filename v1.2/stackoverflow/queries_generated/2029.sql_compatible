WITH RecursiveRelatedPosts AS (
    SELECT PL.PostId, PL.RelatedPostId, 1 AS Depth
    FROM PostLinks PL
    WHERE PL.LinkTypeId = 3
  UNION ALL
    SELECT R.PostId, PL.RelatedPostId, R.Depth + 1
    FROM RecursiveRelatedPosts R
    JOIN PostLinks PL ON R.RelatedPostId = PL.PostId
    WHERE PL.LinkTypeId = 3 AND R.Depth < 5
),
AcceptedAnswerStarsLngComputedScore AS (
    SELECT 
        P.Id AS QuestionId,
        P.Title,
        P.OwnerUserId
    FROM Posts P
    WHERE P.Id IS NOT NULL
)
SELECT R.PostId, R.RelatedPostId, R.Depth, A.QuestionId, A.Title, A.OwnerUserId
FROM RecursiveRelatedPosts R
LEFT JOIN AcceptedAnswerStarsLngComputedScore A
  ON R.RelatedPostId = A.QuestionId
GROUP BY R.PostId, R.RelatedPostId, R.Depth, A.QuestionId, A.Title, A.OwnerUserId;