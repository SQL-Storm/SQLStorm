with RecursiveUserActivity as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.CreationDate as PostCreationDate,
        v.VoteTypeId,
        v.CreationDate as VoteDate,
        row_number() over (partition by u.Id order by p.CreationDate desc) as RecentPostRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.PostId = p.Id and v.UserId = u.Id
    where u.Reputation > 1000
),
UserTopPosts as (
    select UserId, PostId, PostTypeId, Score, PostCreationDate,
        sum(case when VoteTypeId = 2 then 1 else 0 end) as UpVotesCount,
        sum(case when VoteTypeId = 3 then 1 else 0 end) as DownVotesCount,
        RecentPostRank
    from RecursiveUserActivity
    group by UserId, PostId, PostTypeId, Score, PostCreationDate, RecentPostRank
    having RecentPostRank <= 10
),
PostSummary as (
    select 
        p.Id,
        p.Title,
        p.CreationDate,
        p.OwnerUserId,
        pt.Name as PostTypeName,
        coalesce(p.Score,0) as Score,
        coalesce(p.ViewCount,0) as ViewCount,
        case when p.AcceptedAnswerId is not null then 1 else 0 end as HasAcceptedAnswer,
        coalesce(b_agg.badge_label, '') as UserBadges,
        (select count(*) from Comments c where c.PostId = p.Id) as NumberOfComments,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 2) as TotalUpVotes,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 3) as TotalDownVotes,
        tag.tag_val as Tag
    from Posts p
    join PostTypes pt on pt.Id = p.PostTypeId
    left join lateral (
        select string_agg(b.label_with_date, ', ' order by b.label_with_date desc) as badge_label
        from (
            select
                bd.user_id,
                bd.post_id_ref,
                bd.name,
                bd.class,
                bd.date,
                (bd.name || ' (' || coalesce(cast(bd.class as varchar), '') || ')' || '||' || to_char(bd.date, 'YYYY-MM-DD HH24:MI:SS')) as label_with_date
            from (
                select b."UserId" as user_id, b."Name" as name, b."Class" as class, b."Date" as date, p2.Id as post_id_ref
                from Badges b
                left join Posts p2 on p2.OwnerUserId = b."UserId"
                where b."UserId" = p.OwnerUserId
            ) bd
            where bd.post_id_ref = p.Id
        ) b
    ) b_agg on true
    left join lateral (
        select unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><')) as tag_val
    ) tag on true
    where p.CreationDate >= cast('2024-10-01' as date) - interval '365 days'
    group by p.Id, p.Title, p.CreationDate, p.OwnerUserId, pt.Name, p.Score, p.ViewCount, p.AcceptedAnswerId, tag.tag_val, b_agg.badge_label
),
RichPostDetails as (
    select 
        ps.Id,
        ps.Title,
        ps.CreationDate,
        ps.OwnerUserId,
        ps.PostTypeName,
        ps.Score,
        ps.ViewCount,
        ps.HasAcceptedAnswer,
        coalesce(ps.UserBadges, '') as UserBadges,
        ps.NumberOfComments,
        ps.TotalUpVotes,
        ps.TotalDownVotes,
        ps.Tag,
        u.DisplayName as OwnerName,
        u.Reputation as OwnerRep,
        c.Name as CloseReason,
        coalesce(ph.Comment, 'N/A') as CloseComment,
        lead(ps.CreationDate) over (partition by ps.OwnerUserId order by ps.CreationDate) as NextPostDate
    from PostSummary ps
    left join Users u on u.Id = ps.OwnerUserId
    left join PostHistory ph on ph.PostId = ps.Id and ph.PostHistoryTypeId = 10
    left join CloseReasonTypes c on c.Id = cast(ph.Comment as integer)
),
PostComparisons as (
    select 
        rpd1.Id as Post1,
        rpd2.Id as Post2,
        rpd1.OwnerUserId,
        abs(extract(epoch from (rpd1.CreationDate - rpd2.CreationDate))) as TimeDiffSeconds,
        case when rpd1.Score > rpd2.Score then rpd1.Score else rpd2.Score end as MaxScore,
        rpd1.Tag as Tag1,
        rpd2.Tag as Tag2,
        case when rpd1.Tag = rpd2.Tag then 'Same' else 'Different' end as TagRelation
    from RichPostDetails rpd1
    inner join RichPostDetails rpd2 on rpd1.OwnerUserId = rpd2.OwnerUserId and rpd1.Id < rpd2.Id
    where rpd1.Tag is not null and rpd2.Tag is not null
    and abs(extract(epoch from (rpd1.CreationDate - rpd2.CreationDate))) < 86400 * 30
)
select 
    ri.OwnerUserId,
    ri.OwnerName,
    ri.OwnerRep,
    ri.Id as PostId,
    ri.Title,
    ri.PostTypeName,
    ri.Score,
    ri.ViewCount,
    ri.HasAcceptedAnswer,
    ri.NumberOfComments,
    ri.TotalUpVotes,
    ri.TotalDownVotes,
    ri.UserBadges,
    ri.CloseReason,
    ri.CloseComment,
    ri.NextPostDate,
    case 
        when ri.Title is null or char_length(ri.Title) = 0 then '<<No Title>>' 
        else substring(ri.Title from 1 for 20) || case when char_length(ri.Title) > 20 then '...' else '' end 
    end as ShortTitle,
    rank() over (partition by ri.OwnerUserId order by ri.Score desc) as UserPostScoreRank,
    pc.Post2,
    pc.TimeDiffSeconds,
    pc.MaxScore,
    pc.TagRelation
from RichPostDetails ri
left join PostComparisons pc on pc.Post1 = ri.Id
where ri.OwnerRep > 2000
and (ri.CloseReason is null or ri.CloseReason not in ('Exact Duplicate', 'Duplicate'))
and ri.PostTypeName in ('Question', 'Answer')
order by ri.OwnerRep desc, ri.Score desc, ri.CreationDate desc
limit 100;