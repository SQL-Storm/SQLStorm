WITH RecursiveTagHierarchy AS (
    -- recursively find all tagwiki excerpts linked via Tags excerpts to explore tag linkage depth
    SELECT 
        t.Id, 
        t.TagName, 
        1 AS lvl, 
        t.ExcerptPostId,
        ARRAY[t.TagName] AS PrevTags
    FROM Tags t
    WHERE t.ExampleISModeratorOnly = 0 AND t.IsRequired = 0 AND t.ExcerptPostId IS NOT NULL

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        parent.lvl + 1,
        child.ExcerptPostId,
        parent.PrevTags || child.TagName
    FROM Tags child
    JOIN RecursiveTagHierarchy parent 
        ON EXISTS (
            SELECT 1 FROM Posts p 
            WHERE p.Id = parent.ExcerptPostId 
            AND p.Tags ILIKE '%' || '<' || child.TagName || '>%'
            AND NOT child.TagName = ANY(parent.PrevTags) -- avoid cycles
        )
    WHERE child.ExcerptPostId IS NOT NULL AND array_length(parent.PrevTags, 1) < 5
