-- {"query": "1348.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.3, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1326} 
with RecursiveTagCounts as (
    select
        t.Id,
        t.TagName,
        t.Count,
        p.Id as PostId,
        p.CreationDate,
        row_number() over (partition by t.Id order by p.Score desc, p.CreationDate desc) as rn
    from
        Tags t
        left join Posts p on p.Tags like '%' || '<' || t.TagName || '>%'
),
LatestTagUsage as (
    select
        Id,
        TagName,
        PostId,
        CreationDate
    from RecursiveTagCounts
    where rn = 1
),
UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct b.Id) filter (where b.Class = 1) as GoldBadges,
        count(distinct b.Id) filter (where b.Class = 2) as SilverBadges,
        count(distinct b.Id) filter (where b.Class = 3) as BronzeBadges,
        count(distinct b.Id) as TotalBadges,
        avg(b.Class) filter (where b.Date between age(cast('2024-10-01' as date), interval '365 day') and cast('2024-10-01' as date)) as AvgBadgeClassYear
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
UserReputationWindow as (
    select 
        Id,
        DisplayName,
        Reputation,
        CreationDate,
        row_number() over (order by Reputation desc) as ReputationRank,
        rank() over (partition by date_trunc('year', CreationDate) order by Reputation desc) as YearlyRank
    from Users
),
QuestionWithAnswersCTE as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionDate,
        q.Score as QuestionScore,
        q.ViewCount,
        q.Tags,
        a.Id as AnswerId,
        a.CreationDate as AnswerDate,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerUserId,
        a.ParentId
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
),
AnswersScoreAgg as (
    select
        QuestionId,
        count(AnswerId) as TotalAnswers,
        max(AnswerScore) as MaxAnswerScore,
        avg(AnswerScore) filter (where AnswerScore is not null) as AvgAnswerScore,
        sum(case when AnswerScore >= 10 then 1 else 0 end) as HighScoreCount
    from QuestionWithAnswersCTE
    group by QuestionId
),
ComplexComments as (
    select
        c.Id,
        c.PostId,
        c.Score as CommentScore,
        c.UserId,
        u.DisplayName as CommenterName,
        c.CreationDate,
        length(c.Text) as CommentLength,
        lower(trim(c.Text)) like '%bug%' as ContainsBug,
        case when c.UserId is null then 'Anonymous' else 'Known User' end as UserStatus,
        case when c.Score >= 5 then 'Highly Rated' else 'Normal' end as ScoreLevel
    from Comments c
    left join Users u on u.Id = c.UserId
),
RankedQuestions as (
    select
        pq.QuestionId,
        pq.Title,
        pq.QuestionDate,
        pq.ViewCount,
        aa.TotalAnswers,
        aa.MaxAnswerScore,
        aa.AvgAnswerScore,
        aa.HighScoreCount,
        rank() over (order by pq.ViewCount desc, aa.MaxAnswerScore desc) as PopularityRank
    from QuestionWithAnswersCTE pq
    left join AnswersScoreAgg aa on aa.QuestionId = pq.QuestionId
),
FinalSelection as (
    select
        rq.PopularityRank,
        rq.QuestionId,
        rq.Title,
        rq.QuestionDate,
        rq.ViewCount,
        rq.TotalAnswers,
        rq.MaxAnswerScore,
        rq.AvgAnswerScore,
        rq.HighScoreCount,
        lat.TagName as PopularTag,
        urs.ReputationRank as OwnerReputationRank,
        urs.YearlyRank as OwnerYearlyRank,
        ubr.GoldBadges,
        ubr.SilverBadges,
        ubr.BronzeBadges,
        ubr.TotalBadges,
        usr.DisplayName as QuestionOwner,
        su.DisplayName as HighestAnswerer
    from RankedQuestions rq
    left join Posts qp on qp.Id = rq.QuestionId
    left join LatestTagUsage lat on qp.Tags like '%' || '<' || lat.TagName || '>%'
    left join Users usr on usr.Id = qp.OwnerUserId
    left join UserReputationWindow urs on urs.Id = qp.OwnerUserId
    left join UserBadgeStats ubr on ubr.UserId = qp.OwnerUserId
    left join (
        select
            parentid,
            OwnerUserId,
            DisplayName,
            row_number() over (partition by parentid order by score desc nulls last) as rn
        from Posts a
        left join Users ua on ua.Id = a.OwnerUserId
        where PostTypeId = 2
    ) su on su.parentid = rq.QuestionId and su.rn = 1
)
select * from FinalSelection
where PopularityRank <= 50
order by PopularityRank
union
select
    9999 as PopularityRank,
    p.Id as QuestionId,
    p.Title,
    p.CreationDate as QuestionDate,
    p.ViewCount,
    0 as TotalAnswers,
    0 as MaxAnswerScore,
    0::float as AvgAnswerScore,
    0 as HighScoreCount,
    null::varchar as PopularTag,
    null::int as OwnerReputationRank,
    null::int as OwnerYearlyRank,
    0 as GoldBadges,
    0 as SilverBadges,
    0 as BronzeBadges,
    0 as TotalBadges,
    p.OwnerDisplayName as QuestionOwner,
    null::varchar as HighestAnswerer
from Posts p
where p.PostTypeId = 1
and not exists (
    select 1 from Posts a where a.ParentId = p.Id and a.PostTypeId = 2
)
order by PopularityRank, QuestionDate desc;