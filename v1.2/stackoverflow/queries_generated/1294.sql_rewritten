-- {"query": "1294.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.2, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1413} 
with RecursiveUserTagStats as (
    select
        u.Id as UserId,
        t.TagName,
        count(p.Id) as QuestionCount,
        coalesce(sum(p.Score),0) as TotalScore,
        max(p.ViewCount) as MaxViewCount,
        row_number() over (partition by u.Id order by count(p.Id) desc, sum(p.Score) desc) as TagRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id and p.PostTypeId = 1 and p.Tags is not null
    left join LATERAL (
        select unnest(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) as TagName
    ) t on true
    group by u.Id, t.TagName
    having count(p.Id) > 0
), TopUserTags as (
    select UserId, TagName, QuestionCount, TotalScore, MaxViewCount
    from RecursiveUserTagStats
    where TagRank <= 3
), UserBadgesSummary as (
    select
        UserId,
        count(*) filter (where Class = 1) as GoldBadges,
        count(*) filter (where Class = 2) as SilverBadges,
        count(*) filter (where Class = 3) as BronzeBadges,
        count(distinct case when TagBased = 1 then Name end) as DistinctTagBadges
    from Badges
    group by UserId
), LatestPostActivities as (
    select
        p.Id as PostId,
        p.OwnerUserId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        ph.CreationDate as LastEditDate,
        row_number() over (partition by p.Id order by ph.CreationDate desc nulls last) as rn1
    from Posts p
    left join PostHistory ph on ph.PostId = p.Id and ph.PostHistoryTypeId in (4,5,6,10,11) -- title/tag/body edits and close/reopen
), LatestEdits as (
    select
        PostId,
        LastEditDate
    from LatestPostActivities
    where rn1 = 1
), DuplicateLinkWithScores as (
    select pl.PostId, pl.RelatedPostId, p1.Score as PostScore, p2.Score as RelatedPostScore
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where pl.LinkTypeId = 3 -- duplicates
), UserReputationBuckets as (
    select 
        Id as UserId,
        Reputation,
        case 
            when Reputation < 100 then 'Low'
            when Reputation between 100 and 999 then 'Medium'
            when Reputation >= 1000 then 'High'
            else 'Unknown'
        end as RepBucket
    from Users
), UserLastAccessGap as (
    select
        Id as UserId,
        extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - LastAccessDate)) / 86400 as DaysSinceLastAccess -- days
    from Users
), UserSummary as (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        repb.RepBucket,
        coalesce(bdg.GoldBadges, 0) as GoldBadges,
        coalesce(bdg.SilverBadges, 0) as SilverBadges,
        coalesce(bdg.BronzeBadges, 0) as BronzeBadges,
        coalesce(bdg.DistinctTagBadges, 0) as DistinctTagBadges,
        lla.DaysSinceLastAccess,
        tus.TagName,
        tus.QuestionCount,
        tus.TotalScore,
        tus.MaxViewCount
    from Users u
    left join UserReputationBuckets repb on repb.UserId = u.Id
    left join UserBadgesSummary bdg on bdg.UserId = u.Id
    left join UserLastAccessGap lla on lla.UserId = u.Id
    left join TopUserTags tus on tus.UserId = u.Id
    where u.Reputation > 0
), HighlyInteractivePosts as (
    select 
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CommentCount,
        coalesce(v.UpVotes,0) as UpVotes,
        coalesce(v.DownVotes,0) as DownVotes,
        p.AcceptedAnswerId,
        lag(p.Score) over (order by p.ViewCount desc) as PrevPostScore,
        lead(p.Score) over (order by p.ViewCount desc) as NextPostScore
    from Posts p
    left join (
        select
            PostId,
            sum(case when VoteTypeId = 2 then 1 else 0 end) as UpVotes,
            sum(case when VoteTypeId = 3 then 1 else 0 end) as DownVotes
        from Votes
        group by PostId
    ) v on v.PostId = p.Id
    where p.PostTypeId = 1 and p.ViewCount > 1000
)
select
    us.Id as UserID,
    us.DisplayName,
    us.Reputation,
    us.RepBucket,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.DistinctTagBadges,
    round(us.DaysSinceLastAccess,2) as DaysSinceLastAccess,
    us.TagName,
    us.QuestionCount,
    us.TotalScore,
    us.MaxViewCount,
    hp.Id as PopularQuestionId,
    hp.Title as PopularQuestionTitle,
    hp.Score as PopularQuestionScore,
    hp.ViewCount as PopularQuestionViewCount,
    hp.CommentCount as PopularQuestionCommentCount,
    hp.UpVotes,
    hp.DownVotes,
    dup.RelatedPostId as DuplicateOfQuestionId,
    dup.RelatedPostScore as DuplicateOfQuestionScore,
    case 
        when hp.NextPostScore is null then 'Last'
        when hp.PrevPostScore is null then 'First'
        else 'Middle'
    end as PositionByViewCount
from UserSummary us
left join LATERAL (
    select hq.*
    from HighlyInteractivePosts hq
    where hq.OwnerUserId = us.Id
    order by hq.ViewCount desc
    limit 1
) hp on true
left join DuplicateLinkWithScores dup on dup.PostId = hp.Id
where us.TagName is not null and us.QuestionCount > 5
order by us.Reputation desc, us.TagName, hp.ViewCount desc
limit 100;