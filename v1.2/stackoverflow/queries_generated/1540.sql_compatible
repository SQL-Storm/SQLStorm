WITH RankedPosts AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        u.DisplayName AS OwnerDisplayName,
        u.Reputation,
        u.Location,
        u.CreationDate AS UserCreationDate,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.CreationDate ASC) AS rn,
        COUNT(*) OVER (PARTITION BY p.PostTypeId) AS total_in_type
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.Score IS NOT NULL
),
TopRankedTagged AS (
    SELECT 
        rp.Id,
        rp.PostTypeId,
        rp.Title,
        rp.OwnerUserId,
        rp.CreationDate,
        rp.Score,
        rp.ViewCount,
        rp.Tags,
        rp.OwnerDisplayName,
        rp.Reputation,
        rp.Location,
        rp.UserCreationDate,
        rp.rn,
        rp.total_in_type,
        (SELECT string_agg(DISTINCT pt.Name, ', ')
            FROM PostHistory ph
            JOIN PostHistoryTypes pt ON ph.PostHistoryTypeId = pt.Id
            WHERE ph.PostId = rp.Id 
            AND pt.Name LIKE '%Tag%') AS TagEditsDescription,
        (SELECT AVG(vt.VoteWeight::numeric)
            FROM Votes v
            INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
            WHERE v.PostId = rp.Id
        ) AS AvgVoteWeight
    FROM RankedPosts rp
    WHERE rp.rn <= 50 AND rp.PostTypeId IN (1, 2)
),
AggregatedBadges AS (
    SELECT 
        b.UserId,
        b.Class,
        COUNT(*) AS BadgeCount,
        BOOL_OR(b.TagBased) AS TagBased
    FROM Badges b
    GROUP BY b.UserId, b.Class
),
UsersWithPrivilegeScore AS (
    SELECT
        u.Id,
        u.DisplayName,
        COALESCE(SUM(pb.BadgeScore),0) AS PrivilegeScore,
        u.Reputation,
        u.Location,
        'HasFacebook.com' AS HasSpecificWebDomain
    FROM Users u
    LEFT JOIN (
        SELECT
            UserId,
            SUM(
              CASE 
                WHEN Class = 1 THEN 10 
                WHEN Class = 2 THEN 5 
                ELSE 1
              END
            ) AS BadgeScore
        FROM Badges
        GROUP BY UserId
    ) pb ON pb.UserId = u.Id
    WHERE u.WebsiteUrl ILIKE '%facebook.com%'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
),
UserCommentsWindowed AS (
    SELECT
        c.UserId,
        COUNT(DISTINCT c.Id) AS CommentCount,
        AVG(c.Score) AS AvgCommentScore,
        MAX(c.CreationDate) AS LastCommentDate,
        p.Id AS PostId,
        p.PostTypeId,
        ROW_NUMBER() OVER (PARTITION BY c.UserId ORDER BY c.CreationDate DESC) AS RevRank
    FROM Comments c
    INNER JOIN Posts p ON c.PostId = p.Id
    WHERE c.UserId IS NOT NULL
    GROUP BY c.UserId, p.Id, p.PostTypeId
),
FilteredComments AS (
    SELECT userId, CommentCount, AvgCommentScore, MAX(LastCommentDate) AS MostRecentComment
    FROM UserCommentsWindowed
    WHERE RevRank <= 3
    GROUP BY userId, CommentCount, AvgCommentScore
),
AnswerWithDuplicateCount AS (
    SELECT
        a.Id AS AnswerId,
        COUNT(pl.Id) FILTER (WHERE lt.Name = 'Duplicate') AS DuplicateOfCount,
        (a.Score * 0.7 + COALESCE(u.Reputation / 1000.0, 0)) AS ComputedAnswerScore
    FROM Posts a
    LEFT JOIN PostLinks pl ON a.Id = pl.PostId
    LEFT JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
    LEFT JOIN Users u ON a.OwnerUserId = u.Id
    WHERE a.PostTypeId = 2
    GROUP BY a.Id, a.Score, u.Reputation
),
CorrelationCheck AS (
    SELECT
        bp.Id,
        (SELECT COUNT(*)
         FROM Posts p2
         WHERE p2.OwnerUserId = u.Id AND p2.ViewCount > bp.ViewCount) AS NumPostsHigerViewThanSelf
    FROM TopRankedTagged bp
    LEFT JOIN Users u ON bp.OwnerUserId = u.Id
)
SELECT
    bp.Id AS PostId,
    bp.PostTypeId,
    bp.Title,
    bp.OwnerDisplayName,
    bp.Reputation AS OwnerReputation,
    bp.Score,
    bp.ViewCount,
    bp.Tags,
    bp.TagEditsDescription,
    COALESCE(bp.AvgVoteWeight, 0) AS AverageVoteWeight,
    us.PrivilegeScore,
    us.HasSpecificWebDomain,
    avr.AvgCommentScore,
    avr.CommentCount,
    ac.ComputedAnswerScore,
    ac.DuplicateOfCount,
    cc.NumPostsHigerViewThanSelf,
    DENSE_RANK() OVER (ORDER BY bp.Score DESC) AS ScoreRankAcrossAll,
    CASE 
      WHEN bp.Score > 50 THEN 'High Score'
      WHEN bp.Score BETWEEN 25 AND 50 THEN 'Medium Score'
      ELSE COALESCE('Low Score','No Score')
     END AS ScoreCategory,
    LEFT(bp.Title || COALESCE(bp.Tags,''), 75) || '...' AS TL_STR, 
    loc.normalizedLocationCheck,
    (CAST('2024-10-01' AS date) - DATE_TRUNC('day', bp.CreationDate)::date) AS DaysSinceCreation,
    RANDOM() * bp.Score AS RandomizedLoad
FROM TopRankedTagged bp
LEFT JOIN UsersWithPrivilegeScore us ON bp.OwnerUserId = us.Id
LEFT JOIN FilteredComments avr ON avr.UserId = bp.OwnerUserId
LEFT JOIN AnswerWithDuplicateCount ac ON ac.AnswerId = bp.Id
LEFT JOIN CorrelationCheck cc ON cc.Id = bp.Id
LEFT JOIN LATERAL
    (SELECT LOWER(NULLIF(us.Location, '')) AS normalizedLocationCheck WHERE us.Location IS NOT NULL) loc ON TRUE
ORDER BY ScoreRankAcrossAll, bp.PostTypeId, DaysSinceCreation DESC, RandomizedLoad
LIMIT 100;