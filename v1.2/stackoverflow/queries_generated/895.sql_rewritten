-- {"query": "895.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.8, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1453} 
with RecursiveTagCounts as (
    select 
        t.Id as TagId,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as AnswerCount,
        p.Score as QuestionScore,
        p.ViewCount as QuestionViews,
        row_number() over (partition by t.Id order by p.Score desc) as rn
    from Tags t
    left join Posts p on p.Id = t.ExcerptPostId and p.PostTypeId = 1
    where t.TagName is not null
),
TopTags as (
    select TagId, TagName, Count, AnswerCount, QuestionScore, QuestionViews
    from RecursiveTagCounts
    where rn = 1
    order by Count desc limit 50
),
UserBadgeAgg as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(b.Id) filter (where b.Class = 1) as GoldBadges,
        count(b.Id) filter (where b.Class = 2) as SilverBadges,
        count(b.Id) filter (where b.Class = 3) as BronzeBadges,
        max(b.Date) as LastBadgeDate
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
QuestionStats as (
    select 
        q.Id,
        q.Title,
        q.Tags,
        q.OwnerUserId,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        q.AnswerCount,
        q.FavoriteCount,
        q.ClosedDate,
        u.DisplayName as OwnerName,
        row_number() over (partition by q.OwnerUserId order by q.Score desc) as UserTopQuestionRank
    from Posts q
    left join Users u on u.Id = q.OwnerUserId
    where q.PostTypeId = 1
),
AnswerStats as (
    select 
        a.Id,
        a.ParentId,
        a.OwnerUserId,
        a.CreationDate,
        a.Score,
        a.CommentCount,
        a.FavoriteCount,
        u.DisplayName as OwnerName,
        row_number() over (partition by a.ParentId order by a.Score desc) as AnswerRankForQuestion
    from Posts a
    left join Users u on u.Id = a.OwnerUserId
    where a.PostTypeId = 2
),
QuestionWithAnswers as (
    select 
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        q.OwnerName,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        q.FavoriteCount,
        q.ClosedDate,
        a.Id as AnswerId,
        a.OwnerUserId as AnswerOwnerId,
        a.OwnerName as AnswerOwnerName,
        a.CreationDate as AnswerCreation,
        a.Score as AnswerScore,
        a.CommentCount as AnswerComments,
        a.FavoriteCount as AnswerFavorites,
        a.AnswerRankForQuestion
    from QuestionStats q
    left join AnswerStats a on a.ParentId = q.Id
),
PostHistoryCloseInfo as (
    select 
        ph.PostId,
        crt.Name as CloseReason,
        ph.CreationDate as CloseDate
    from PostHistory ph
    inner join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId and pht.Name = 'Post Closed'
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as int)
    where ph.PostHistoryTypeId = 10
),
UserActivityWindow as (
    select 
        u.Id as UserId,
        u.DisplayName,
        extract(year from age(cast('2024-10-01' as date), u.CreationDate)) as UserAgeYears,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionsPosted,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswersPosted,
        count(c.Id) as CommentsMade,
        sum(v.BountyAmount) as TotalBountyGiven,
        row_number() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Votes v on v.UserId = u.Id and v.VoteTypeId in (8,9)
    group by u.Id, u.DisplayName, u.CreationDate, u.Reputation
),
RecentPopularQuestions as (
    select * from Posts
    where PostTypeId = 1 and CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '30 days' and Score > 10
),
DuplicationInfo as (
    select 
        pl.PostId, 
        pl.RelatedPostId,
        lt.Name as LinkTypeName,
        q.Title as RelatedQuestionTitle
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    left join Posts q on q.Id = pl.RelatedPostId and q.PostTypeId = 1
    where pl.LinkTypeId = 3
),
FinalResult as (
    select 
        qwa.QuestionId,
        qwa.Title,
        qwa.OwnerName,
        qwa.QuestionCreation,
        qwa.QuestionScore,
        qwa.ViewCount,
        qwa.AnswerCount,
        qwa.FavoriteCount,
        coalesce(pc.CloseReason, 'Open') as CloseReason,
        qwa.AnswerId,
        qwa.AnswerOwnerName,
        qwa.AnswerCreation,
        qwa.AnswerScore,
        qwa.AnswerComments,
        qwa.AnswerFavorites,
        uaw.UserAgeYears,
        uba.GoldBadges,
        uba.SilverBadges,
        uba.BronzeBadges,
        dt.RelatedPostId as DuplicateOf,
        dt.RelatedQuestionTitle,
        substring(qwa.Title from 1 for 30) || '...' as TitleSnippet,
        case when qwa.AnswerScore > 10 then 'Highly Rated Answer' else 'Normal Answer' end as AnswerQuality,
        case when qwa.CloseDate is null then 0 else 1 end as IsClosedFlag
    from QuestionWithAnswers qwa
    left join PostHistoryCloseInfo pc on pc.PostId = qwa.QuestionId
    left join UserActivityWindow uaw on uaw.UserId = qwa.OwnerUserId
    left join UserBadgeAgg uba on uba.UserId = qwa.OwnerUserId
    left join DuplicationInfo dt on dt.PostId = qwa.QuestionId
    where qwa.AnswerRankForQuestion is null or qwa.AnswerRankForQuestion <= 3
)
select * from FinalResult
where (GoldBadges + SilverBadges + BronzeBadges) > 10 and UserAgeYears > 1
order by QuestionScore desc, AnswerScore desc
limit 100;