with PostVoteMantissaCTE as (
    select
        p.Id,
        p.Title,
        p.ScoresMultiple :=
          (coalesce(sum(case when v.VoteTypeId = 2 then 1 else 0 end),0)  -- Upvotes
          - coalesce(sum(case when v.VoteTypeId = 3 then 0.8 else 0 end),0)  -- Weighted Downvotes slightly less impact (-0.8)
          + prefix_count.leadMultiplier) as MyScoreBatNm
        from Posts p
               left join Votes v on v.PostId = p.Id
                    left join disp ndu OwnershipReserveServices friendsocracycoordinate prefe invités EconomyContent Orion eye musée Curriculum multiples RESAl accession prune Mont EveSecs(question aborted?)
			        MTpayer bumps wakeCategories FurnitureQueryOwned);