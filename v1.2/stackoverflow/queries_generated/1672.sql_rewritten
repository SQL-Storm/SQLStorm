WITH TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC NULLS LAST) AS rn
    FROM Tags t
    WHERE t.IsModeratorOnly = 0 AND t.IsRequired = 0
    AND t.Count > 100
),
TagQuestionCounts AS (
    SELECT 
        TR.TagName,
       COUNT(DISTINCT p.Id) AS QuestionCount,
       AVG(p.Score) AS AvgScore,
       SUM(p.ViewCount) AS TotalViews,
       MAX(p.CreationDate) AS LatestQuestion
    FROM Posts p
    JOIN TopTags TR ON POSITION('<' || TR.TagName || '>' IN COALESCE(p.Tags, '')) > 0
    WHERE p.PostTypeId = 1
    GROUP BY TR.TagName
),
UserCPPQuestionsRanks AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(p.Id) FILTER (WHERE POSITION('<c++>' IN COALESCE(p.Tags, '')) > 0 AND p.PostTypeId = 1) AS CPPQuestionsCount,
        RANK() OVER (ORDER BY COUNT(p.Id) FILTER (WHERE POSITION('<c++>' IN COALESCE(p.Tags, '')) > 0 AND p.PostTypeId = 1) DESC) AS RankByCPPQuest
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    GROUP BY u.Id, u.DisplayName
),
PostLinksWithCycles AS (
    SELECT l1.PostId AS PostA, l1.RelatedPostId AS PostB, 
        CASE WHEN l2.Id IS NOT NULL THEN TRUE ELSE FALSE END AS HasCycle
    FROM PostLinks l1
    LEFT JOIN PostLinks l2 ON l1.PostId = l2.RelatedPostId AND l1.RelatedPostId = l2.PostId
    WHERE l1.LinkTypeId IN (1,3)
),
AllActivities AS (
    SELECT p.Id AS PostId, p.OwnerUserId, p.CreationDate,
        ph.CreationDate AS EditDate,
        v.VoteTypeId, v.CreationDate AS VoteDate,
        c.CreationDate AS CommentDate
    FROM Posts p
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id
    LEFT JOIN Votes v ON v.PostId = p.Id
    LEFT JOIN Comments c ON c.PostId = p.Id
),
ActivitiesWindow AS (
    SELECT
        a.OwnerUserId,
        a.PostId,
        a.CreationDate,
        COUNT(*) OVER (PARTITION BY a.OwnerUserId ORDER BY a.CreationDate ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS ActivityCount7Days
    FROM (
        SELECT OwnerUserId, PostId, CreationDate FROM Posts
        UNION ALL
        SELECT UserId, PostId, CreationDate FROM Votes WHERE UserId IS NOT NULL
        UNION ALL
        SELECT UserId, PostId, CreationDate FROM Comments WHERE UserId IS NOT NULL
        UNION ALL
        SELECT UserId, PostId, CreationDate FROM PostHistory WHERE UserId IS NOT NULL
    ) a
),
