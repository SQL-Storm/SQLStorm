with RecursiveVotes as (
    select
        p.Id as PostId,
        p.PostTypeId,
        p.OwnerUserId,
        v.VoteTypeId,
        v.CreationDate as VoteDate,
        v.BountyAmount,
        row_number() over (partition by p.Id order by v.CreationDate) as rn
    from Posts p
    left join Votes v on p.Id = v.PostId
    where p.PostTypeId in (1,2)
),
EnhancedPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.Title,
        p.Tags,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.OwnerUserId,
        u.DisplayName as OwnerName,
        substring(p.Tags from '<([^>]*)>') as first_tag,
        (select Score from Posts where Id = p.AcceptedAnswerId) as accepted_score,
        extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - p.CreationDate))/86400.0 as AgeDays
    from Posts p
    left join Users u on p.OwnerUserId = u.Id
    where p.PostTypeId = 1 and p.CreationDate < cast('2024-10-01 12:34:56' as timestamp)
),
BadgeSummary as (
   select
      UserId,
      count(*) as TotalBadges,
      count(case when Class = 1 then 1 end) as GoldBadges,
      count(case when Class = 2 then 1 end) as SilverBadges,
      count(case when Class = 3 then 1 end) as BronzeBadges
   from Badges
   group by UserId
),
PostActivityRank as (
    select
        p.Id,
        dense_rank() over (partition by p.PostTypeId order by coalesce(p.LastActivityDate, p.CreationDate) desc) as RankByLastActivity
    from Posts p
),
ComplexUserStats as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        bs.TotalBadges,
        bs.GoldBadges,
        bs.SilverBadges,
        bs.BronzeBadges,
        count(p.Id) as total_posts,
        count(case when p.PostTypeId = 2 then 1 end) as answers_count,
        count(case when p.PostTypeId = 1 then 1 end) as questions_count,
        avg(p.Score) as avg_post_score,
        max(p.Title) as recent_post_title,
        sum(p.Score * (CASE WHEN p.PostTypeId=1 THEN 1.5 ELSE 1 END)) as weighted_score
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join BadgeSummary bs on bs.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, bs.TotalBadges, bs.GoldBadges, bs.SilverBadges, bs.BronzeBadges
)
select distinct 
    ep.Id as QuestionId,
    ep.Title,
    ep.OwnerName,
    ep.Score as QuestionScore,
    ep.ViewCount,
    ep.AnswerCount,
    ep.accepted_score,
    ep.AgeDays,
    crucials.Reputation as UserReputation,
    crucials.TotalBadges,
    crucials.GoldBadges,
    crucials.SilverBadges,
    crucials.BronzeBadges,
    '<' || ep.first_tag || '>' as PrimaryTag,
    rvr.ranksum / nullif(rvr.rankedvotes,0) as AvgRankedVotePerPost,
    lor.CommentsOnAccepted,
    lor.TopAnswers,
    pa.RankByLastActivity
from EnhancedPosts ep
left join (
    select 
        PostId,
        count(*) as rankedvotes,
        sum(rn) as ranksum
    from RecursiveVotes 
    where VoteTypeId in (2,3)
    group by PostId
) rvr on rvr.PostId = ep.Id
left join (
    select 
        p.Id as QuestionRowId,
        p.ParentId as QuestionId, 
        count(distinct c.Id) as CommentsOnAccepted,
        count(distinct a.Id) as TopAnswers
    from Posts p
    left join Posts a on a.ParentId = p.ParentId and a.Score > 10 and a.PostTypeId = 2
    left join Comments c on c.PostId = p.AcceptedAnswerId
    where p.PostTypeId = 1
    group by p.Id, p.ParentId
) lor on lor.QuestionId = ep.Id
left join ComplexUserStats crucials on crucials.Id = ep.OwnerUserId
left join PostActivityRank pa on pa.Id = ep.Id
where (ep.Score > 10 or ep.AnswerCount >= 3)
  and (ep.accepted_score is null or ep.accepted_score > 15)
  and (ep.AgeDays between 10 and 365)
order by pa.RankByLastActivity asc, ep.Score desc
limit 100;