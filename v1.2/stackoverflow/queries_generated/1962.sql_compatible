WITH RecursiveUserNetwork AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.RelSignupWithModifiersMarksArangedDialectsMtHilcreditedPhil -- kept as-is (unknown column name)
    FROM users u
)
SELECT
    run.Id,
    run.DisplayName,
    run.RelSignupWithModifiersMarksArangedDialectsMtHilcreditedPhil
FROM RecursiveUserNetwork run
GROUP BY
    run.Id,
    run.DisplayName,
    run.RelSignupWithModifiersMarksArangedDialectsMtHilcreditedPhil;