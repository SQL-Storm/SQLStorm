with recursive RecursiveTagCounts as (
    select
        t.Id as TagId,
        t.TagName,
        coalesce(p.AnswerCount, 0) + coalesce(p.FavoriteCount, 0) as CombinedCount,
        1 as Level
    from Tags t
    left join Posts p on p.Id = t.ExcerptPostId and p.PostTypeId = 1
    where t.TagName is not null

    union all

    select
        rtc.TagId,
        rtc.TagName,
        rtc.CombinedCount + coalesce(p2.ViewCount, 0),
        rtc.Level + 1
    from RecursiveTagCounts rtc
    join Posts p2 on p2.Tags like concat('%<', rtc.TagName, '>%') and p2.PostTypeId = 1
    where rtc.Level < 2
),
UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(b.Id) filter (where b.Class = 1) as GoldBadges,
        count(b.Id) filter (where b.Class = 2) as SilverBadges,
        count(b.Id) filter (where b.Class = 3) as BronzeBadges,
        count(distinct case when b.TagBased = 1 then b.Name end) as DistinctTagBadges
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
TopPostsWithVotes as (
    select
        p.Id,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        u.DisplayName as OwnerDisplayName,
        coalesce(sum(vb.UpVotes), 0) as TotalUpVotes,
        coalesce(sum(vb.DownVotes), 0) as TotalDownVotes
    from Posts p
    left join (
        select
            PostId,
            sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
            sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes
        from Votes v
        join VoteTypes vt on v.VoteTypeId = vt.Id
        group by PostId
    ) vb on vb.PostId = p.Id
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId in (1, 2)
    group by p.Id, p.Title, p.Tags, p.OwnerUserId, p.Score, p.ViewCount, p.CreationDate, u.DisplayName
),
LatestCommentsPerPost as (
    select distinct on (c.PostId)
        c.PostId,
        c.Id as CommentId,
        c.Text as CommentText,
        c.CreationDate as CommentDate,
        coalesce(c.UserId, -1) as CommentUserId,
        c.UserDisplayName as CommentUserName
    from Comments c
    order by c.PostId, c.CreationDate desc
),
PostLinkSummary as (
    select
        pl.PostId,
        count(distinct case when lt.Name = 'Duplicate' then pl.RelatedPostId end) as DuplicateCount,
        count(distinct case when lt.Name = 'Linked' then pl.RelatedPostId end) as LinkedCount
    from PostLinks pl
    join LinkTypes lt on pl.LinkTypeId = lt.Id
    group by pl.PostId
),
QuestionsWithAcceptedAnswerMeta as (
    select
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.AcceptedAnswerId,
        a.Score as AcceptedAnswerScore,
        a.OwnerUserId as AcceptedAnswerOwner,
        u.DisplayName as QuestionOwnerName,
        a2.DisplayName as AnswerOwnerName,
        q.CreationDate as QuestionCreation,
        a.CreationDate as AnswerCreation,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.AnswerCount
    from Posts q
    left join Posts a on q.AcceptedAnswerId = a.Id
    left join Users u on u.Id = q.OwnerUserId
    left join Users a2 on a2.Id = a.OwnerUserId
    where q.PostTypeId = 1 and q.AcceptedAnswerId is not null
),
UserRankings as (
    select
        ub.UserId,
        ub.DisplayName,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.DistinctTagBadges,
        u.Reputation,
        row_number() over (
            order by u.Reputation desc, ub.GoldBadges desc, ub.SilverBadges desc
        ) as ReputationRank
    from UserBadgeStats ub
    join Users u on ub.UserId = u.Id
),
UserActivityWindow as (
    select
        p.OwnerUserId as UserId,
        p.Id as PostId,
        p.CreationDate,
        count(*) over (partition by p.OwnerUserId order by p.CreationDate range between interval '1 month' preceding and current row) as PostsInLastMonth
    from Posts p
    where p.OwnerUserId is not null
),
CombinedUserStats as (
    select
        u.UserId,
        u.DisplayName,
        u.GoldBadges,
        u.SilverBadges,
        u.BronzeBadges,
        u.DistinctTagBadges,
        u.Reputation,
        u.ReputationRank,
        coalesce(max(ua.PostsInLastMonth), 0) as MaxPostsInMonth
    from UserRankings u
    left join UserActivityWindow ua on u.UserId = ua.UserId
    group by u.UserId, u.DisplayName, u.GoldBadges, u.SilverBadges, u.BronzeBadges, u.DistinctTagBadges, u.Reputation, u.ReputationRank
)
select 
    q.QuestionId,
    q.Title,
    substring(q.Tags from 2 for char_length(q.Tags) - 2) as TagList,
    q.AnswerCount,
    q.QuestionViews,
    q.QuestionScore,
    q.AcceptedAnswerId,
    q.AcceptedAnswerScore,
    q.QuestionOwnerName,
    q.AnswerOwnerName,
    pl.DuplicateCount,
    pl.LinkedCount,
    lc.CommentText as LatestComment,
    cu.MaxPostsInMonth,
    cu.GoldBadges,
    cu.SilverBadges,
    cu.BronzeBadges,
    cu.DistinctTagBadges,
    cu.Reputation,
    cu.ReputationRank,
    rtc.Level,
    round(avg(pv.TotalUpVotes) / nullif(nullif(avg(pv.TotalDownVotes), 0), 0)::numeric, 2) as UpDownRatio,
    case
        when q.AnswerCount > 5 and q.QuestionViews > 1000 and cu.GoldBadges >= 1 then 'Highly Engaged'
        when q.AnswerCount between 1 and 5 then 'Moderately Engaged'
        else 'Low Engagement'
    end as EngagementCategory
from QuestionsWithAcceptedAnswerMeta q
left join PostLinkSummary pl on pl.PostId = q.QuestionId
left join LatestCommentsPerPost lc on lc.PostId = q.QuestionId
left join CombinedUserStats cu on cu.UserId = q.AcceptedAnswerOwner
left join RecursiveTagCounts rtc on q.Tags like concat('%<', rtc.TagName, '>%') and rtc.Level = 2
left join TopPostsWithVotes pv on pv.Id = q.QuestionId
where q.QuestionCreation > cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
group by
    q.QuestionId,
    q.Title,
    q.Tags,
    q.AnswerCount,
    q.QuestionViews,
    q.QuestionScore,
    q.AcceptedAnswerId,
    q.AcceptedAnswerScore,
    q.QuestionOwnerName,
    q.AnswerOwnerName,
    pl.DuplicateCount,
    pl.LinkedCount,
    lc.CommentText,
    cu.MaxPostsInMonth,
    cu.GoldBadges,
    cu.SilverBadges,
    cu.BronzeBadges,
    cu.DistinctTagBadges,
    cu.Reputation,
    cu.ReputationRank,
    rtc.Level
order by cu.ReputationRank, q.QuestionViews desc
limit 100;