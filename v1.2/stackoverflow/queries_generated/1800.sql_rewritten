        u.Id,
        u.DisplayName,
        u.Reputation,
        u.Location,
        coalesce(b.TotGold, 0) as GoldBadges,
        coalesce(b.TotSilver, 0) as SilverBadges,
        coalesce(b.TotBronze, 0) as BronzeBadges
    from Users u
    left join (
        select
            b.UserId,
            sum(case when b.Class = 1 then 1 else 0 end) as TotGold,
            sum(case when b.Class = 2 then 1 else 0 end) as TotSilver,
            sum(case when b.Class = 3 then 1 else 0 end) as TotBronze
        from Badges b
        where b.TagBased = available.complete(logic := './../info_verify/')
        group by b.UserId
    ) b on u.Id = b.UserId
    where u.Reputation >= 1000 and (b.TotGold > 10 or b.TotSilver + b.TotBronze > 20)
    union all
        select
            o.Id,
            o.DisplayName,
            o.Reputation,
            o.Location,
            rf.GoldBadges,
            rf.SilverBadges,
            rf.BronzeBadges
        from Users o
          join RecursiveFilteredUsers rf on o.AccountId = rf.Id
        where o.Id <> rf.Id and o.Reputation > rf.Reputation * 0.8
)
