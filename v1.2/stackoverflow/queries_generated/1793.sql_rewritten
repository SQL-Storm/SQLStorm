with RecursiveOpenedPosts as (
    -- Identify posts reopened at least twice and link to original closed posts inferable through histories
    select 
        p.Id,
        p.Title,
        p.Tags,
        ph1.CreationDate as CloseDate,
        ph2.CreationDate as ReopenDate,
        usr.DisplayName as CloserUser,
        joinings.CancelledRevisionGUID,
        row_number() over (partition by p.Id order by ph1.CreationDate desc) as reopen_num
    from Posts p
    join PostHistory ph1 on ph1.PostId = p.Id and ph1.PostHistoryTypeId = 10  -- Close events
    join PostHistory ph2 on ph2.PostId = p.Id and ph2.PostHistoryTypeId = 11 and ph2.CreationDate > ph1.CreationDate -- Future Reopen events
    left join Users usr on usr.Id = ph1.UserId
    left join (
        -- Get undo-reverted revisions (24 type)
        select distinct PostId, RevisionGUID as CancelledRevisionGUID 
        from PostHistory 
        where PostHistoryTypeId = 24 and Text like '%undo%'
    ) joinings on joinings.PostId = ph1.PostId
    where revisit.reopen_num = 1 OR ph2.CreationDate is not null
