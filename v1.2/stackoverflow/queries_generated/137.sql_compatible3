with recursive RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 as Level,
        array[t.TagName]::character varying[] as Path
    from Tags t
    where t.IsRequired = true

    union all

    select
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        t2.IsModeratorOnly,
        t2.IsRequired,
        r.Level + 1,
        r.Path || t2.TagName
    from Tags t2
    join RecursiveTagHierarchy r on t2.IsRequired = true and t2.Id <> r.Id and not t2.TagName = any(r.Path)
    where r.Level < 3
),
UserBadgeCounts as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserPostStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        coalesce(sum(p.Score),0) as TotalPostScore,
        max(p.CreationDate) as LastPostDate,
        avg(p.ViewCount) filter (where p.PostTypeId = 1) as AvgQuestionViews,
        sum(case when p.AcceptedAnswerId is not null then 1 else 0 end) as AcceptedAnswersCount
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    group by u.Id, u.DisplayName
),
PostWithCommentsAndVotes as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.AcceptedAnswerId,
        p.ParentId,
        coalesce(c.CommentCount,0) as CommentCount,
        coalesce(v.UpVotes,0) as UpVotes,
        coalesce(v.DownVotes,0) as DownVotes,
        row_number() over (partition by p.OwnerUserId order by p.Score desc NULLS LAST) as UserPostRank
    from Posts p
    left join (
        select PostId, count(*) as CommentCount
        from Comments
        group by PostId
    ) c on c.PostId = p.Id
    left join (
        select
            PostId,
            sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
            sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes
        from Votes v
        join VoteTypes vt on vt.Id = v.VoteTypeId
        group by PostId
    ) v on v.PostId = p.Id
),
TopUsersWithBadges as (
    select
        ups.UserId,
        ups.DisplayName,
        ups.QuestionCount,
        ups.AnswerCount,
        ups.TotalPostScore,
        ups.LastPostDate,
        ups.AvgQuestionViews,
        ups.AcceptedAnswersCount,
        coalesce(ubc_gold.BadgeCount,0) as GoldBadges,
        coalesce(ubc_silver.BadgeCount,0) as SilverBadges,
        coalesce(ubc_bronze.BadgeCount,0) as BronzeBadges
    from UserPostStats ups
    left join UserBadgeCounts ubc_gold on ubc_gold.UserId = ups.UserId and ubc_gold.Class = 1
    left join UserBadgeCounts ubc_silver on ubc_silver.UserId = ups.UserId and ubc_silver.Class = 2
    left join UserBadgeCounts ubc_bronze on ubc_bronze.UserId = ups.UserId and ubc_bronze.Class = 3
    where ups.QuestionCount > 10 and ups.AnswerCount > 20 and ups.TotalPostScore > 100
),
DuplicateLinkedPosts as (
    select
        pl.PostId,
        pl.RelatedPostId,
        p1.Title as PostTitle,
        p2.Title as RelatedPostTitle,
        pl.CreationDate as LinkCreationDate
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId and lt.Name = 'Duplicate'
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.CreationDate,
        count(*) over (partition by u.Id order by p.CreationDate range between interval '30 days' preceding and current row) as PostsLast30Days,
        sum(p.Score) over (partition by u.Id order by p.CreationDate range between interval '30 days' preceding and current row) as ScoreLast30Days
    from Users u
    join Posts p on p.OwnerUserId = u.Id
),
CorrelatedSubqueryExample as (
    select
        p.Id,
        p.Title,
        p.Tags,
        p.Score,
        p.ViewCount,
        (select count(*) from Comments c where c.PostId = p.Id and c.CreationDate > p.CreationDate - interval '7 days') as RecentCommentCount,
        (select max(Score) from Posts p2 where p2.ParentId = p.Id) as MaxAnswerScore,
        case
            when p.AcceptedAnswerId is not null then true
            else false
        end as HasAcceptedAnswer,
        p.OwnerUserId
    from Posts p
    where p.PostTypeId = 1
),
FinalSelection as (
    select
        t.UserId,
        t.DisplayName,
        t.QuestionCount,
        t.AnswerCount,
        t.TotalPostScore,
        t.GoldBadges,
        t.SilverBadges,
        t.BronzeBadges,
        da.PostId as DuplicatePostId,
        da.RelatedPostId as DuplicateOfPostId,
        da.PostTitle as DuplicatePostTitle,
        da.RelatedPostTitle as DuplicateOfPostTitle,
        ua.PostsLast30Days,
        ua.ScoreLast30Days,
        cs.Title as QuestionTitle,
        cs.Score as QuestionScore,
        cs.ViewCount as QuestionViews,
        cs.RecentCommentCount,
        cs.MaxAnswerScore,
        cs.HasAcceptedAnswer,
        rh.Level as TagHierarchyLevel,
        rh.Path as TagPath
    from TopUsersWithBadges t
    left join DuplicateLinkedPosts da on da.PostId = (
        select p.Id from Posts p where p.OwnerUserId = t.UserId order by p.CreationDate desc limit 1
    )
    left join UserActivityWindow ua on ua.UserId = t.UserId
    left join CorrelatedSubqueryExample cs on cs.OwnerUserId = t.UserId
    left join RecursiveTagHierarchy rh on rh.TagName = any(string_to_array(cs.Tags, '><'))
    where ua.PostsLast30Days > 5
    order by t.TotalPostScore desc, cs.Score desc
    limit 100
)
select
    UserId,
    DisplayName,
    QuestionCount,
    AnswerCount,
    TotalPostScore,
    GoldBadges,
    SilverBadges,
    BronzeBadges,
    DuplicatePostId,
    DuplicateOfPostId,
    DuplicatePostTitle,
    DuplicateOfPostTitle,
    PostsLast30Days,
    ScoreLast30Days,
    QuestionTitle,
    QuestionScore,
    QuestionViews,
    RecentCommentCount,
    MaxAnswerScore,
    HasAcceptedAnswer,
    TagHierarchyLevel,
    array_to_string(TagPath, ' > ') as TagHierarchyPath
from FinalSelection;