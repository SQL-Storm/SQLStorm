WITH RecursiveBadgesCTE AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        b.Name AS BadgeName,
        b.Class,
        b.Date,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY b.Date) AS BadgeSeq
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    WHERE u.Reputation >= 1000
), RecentActivePosts AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        COALESCE(p.AnswerCount,0) AS AnswerCount,
        LEAD(p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS NextPostDate
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
      AND p.OwnerUserId IS NOT NULL
      AND p.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
      AND (p.Tags IS NOT NULL AND p.Tags <> '')
), PostCloseReasons AS (
    SELECT
        ph.PostId,
        crt.Name AS CloseReasonName,
        MAX(ph.CreationDate) AS LastClosedDate
    FROM PostHistory ph
    INNER JOIN CloseReasonTypes crt ON crt.Id = CAST(ph.Comment AS SMALLINT) AND ph.PostHistoryTypeId = 10
    GROUP BY ph.PostId, crt.Name
), AnswerUpvoteRates AS (
    SELECT 
        a.ParentId AS QuestionId,
        COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS AnswerUpvotes,
        COUNT(*) AS TotalVotes
    FROM Posts a
    LEFT JOIN Votes v ON v.PostId = a.Id
    WHERE a.PostTypeId = 2
    GROUP BY a.ParentId
), UserActivePeriods AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        EXTRACT(EPOCH FROM (u.LastAccessDate - u.CreationDate))/3600 AS HoursActive,
        COUNT(DISTINCT p.Id) AS PostCount,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) AS AvgPostScore
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
), TagUsageAgg AS (
    SELECT 
        t.TagName,
        t.Count,
        COALESCE(ta.QuestionCount, 0) AS QuestionCount,
        COALESCE(ta.AnswerCount, 0) AS AnswerCount
    FROM Tags t
    LEFT JOIN (
        SELECT 
            tag AS TagName,
            COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
            COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount
        FROM Posts p,
             unnest(string_to_array(substring(p.Tags, 2, LENGTH(p.Tags) - 2), '><')) AS tag
        WHERE p.Tags IS NOT NULL AND p.Tags <> ''
        GROUP BY tag
    ) ta ON ta.TagName = t.TagName
), RecentCommentsAggregated AS (
    SELECT 
        c.PostId,
        COUNT(*) AS CommentCountPast30Days,
        STRING_AGG(c.UserDisplayName, ', ' ORDER BY c.UserDisplayName) FILTER (WHERE c.UserDisplayName IS NOT NULL) 
            || CASE WHEN COUNT(*) FILTER (WHERE c.UserDisplayName IS NULL) > 0 THEN
                    CASE WHEN STRING_AGG(c.UserDisplayName, ', ' ORDER BY c.UserDisplayName) FILTER (WHERE c.UserDisplayName IS NOT NULL) IS NULL THEN 'Anonymous' ELSE ', Anonymous' END
               ELSE '' END
            AS Commenters
    FROM Comments c
    WHERE c.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
    GROUP BY c.PostId
), ComplexPostData AS (
    SELECT 
      p.Id,
      p.PostTypeId,
      p.Title,
      p.OwnerUserId,
      u.DisplayName AS OwnerName,
      p.CreationDate,
      p.Score,
      p.ViewCount,
      p.Tags,
      r.CloseReasonName AS closeReasonName,
      c.CommentCountPast30Days,
      c.Commenters,
      CASE 
          WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Accepted'
          ELSE 'Not Accepted' 
      END AS AcceptStatus,
      (
            SELECT MAX(ph2.CreationDate)
            FROM PostHistory ph2
            WHERE ph2.PostId = p.Id AND ph2.PostHistoryTypeId = 10
      ) AS LastCloseDate,
      ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS OwnerPostRankByScore,
      NTILE(5) OVER (ORDER BY p.ViewCount DESC) AS ViewCountQuantile
    FROM Posts p
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
    LEFT JOIN PostCloseReasons r ON r.PostId = p.Id
    LEFT JOIN RecentCommentsAggregated c ON c.PostId = p.Id
    WHERE p.PostTypeId IN (1, 2)
), SetAggExample AS (
    SELECT 'AllQuestions' AS SetName, Id, Title, Score, OwnerUserId 
    FROM Posts WHERE PostTypeId = 1 AND Score > 10
    UNION
    SELECT 'HighViewPosts', Id, Title, Score, OwnerUserId 
    FROM Posts WHERE PostTypeId = 2 AND ViewCount > 1000
)
SELECT
    cd.Id AS PostId,
    cd.Title,
    cd.OwnerName,
    cd.PostTypeId,
    ua.HoursActive,
    ua.PostCount,
    ua.AvgPostScore,
    cd.Score,
    cd.ViewCount,
    cd.Tags,
    cd.closeReasonName,
    cd.CommentCountPast30Days,
    substring(cd.Commenters FROM 1 FOR 100) AS CommentersSample,
    rs.BasedBadgeNames,
    tga.QuestionCount AS TagQueryQuestions,
    tga.AnswerCount AS TagQueryAnswers,
    abr.BadgeSeq,
    abr.BadgeName,
    CASE WHEN abr.Class = 1 THEN 'Gold' WHEN abr.Class = 2 THEN 'Silver' WHEN abr.Class = 3 THEN 'Bronze' ELSE 'Unknown' END AS BadgeClass,
    abr.Date AS BadgeAwardedDate,
    COALESCE(ansUpR.AnswerUpvotes, 0) AS TotalAnswerUpvotes,
    COALESCE(ansUpR.TotalVotes,1) AS TotalVotes,
    ROUND(COALESCE(CAST(ansUpR.AnswerUpvotes AS numeric) / NULLIF(ansUpR.TotalVotes,0), 0), 4) AS AnswerUpvoteRatio,
    cd.AcceptStatus,
    cd.LastCloseDate,
    cd.OwnerPostRankByScore,
    cd.ViewCountQuantile
FROM ComplexPostData cd
LEFT JOIN UserActivePeriods ua ON ua.Id = cd.OwnerUserId
LEFT JOIN RecursiveBadgesCTE abr ON abr.UserId = cd.OwnerUserId AND abr.BadgeSeq <= 3
LEFT JOIN TagUsageAgg tga ON EXISTS (
    SELECT 1
    FROM unnest(string_to_array(substring(cd.Tags, 2, COALESCE(NULLIF(LENGTH(cd.Tags), 0),1) - 2), '><')) AS uTag
    WHERE uTag = tga.TagName
)
LEFT JOIN AnswerUpvoteRates ansUpR ON ansUpR.QuestionId = cd.Id
LEFT JOIN (
    SELECT
        UserId,
        STRING_AGG(Name, ', ' ORDER BY Date DESC) AS BasedBadgeNames
    FROM Badges
    WHERE Class = 1
    GROUP BY UserId
) rs ON rs.UserId = cd.OwnerUserId
WHERE cd.Id IS NOT NULL OR cd.OwnerUserId IS NOT NULL
GROUP BY
    cd.Id,
    cd.Title,
    cd.OwnerName,
    cd.PostTypeId,
    ua.HoursActive,
    ua.PostCount,
    ua.AvgPostScore,
    cd.Score,
    cd.ViewCount,
    cd.Tags,
    cd.closeReasonName,
    cd.CommentCountPast30Days,
    cd.Commenters,
    rs.BasedBadgeNames,
    tga.QuestionCount,
    tga.AnswerCount,
    abr.BadgeSeq,
    abr.BadgeName,
    abr.Class,
    abr.Date,
    ansUpR.AnswerUpvotes,
    ansUpR.TotalVotes,
    cd.AcceptStatus,
    cd.LastCloseDate,
    cd.OwnerPostRankByScore,
    cd.ViewCountQuantile
ORDER BY cd.Score DESC NULLS LAST, cd.ViewCount DESC NULLS LAST
LIMIT 100;