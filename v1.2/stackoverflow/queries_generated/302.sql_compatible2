with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(distinct c.Id) as CommentCount,
        coalesce(sum(case when v.VoteTypeId = 2 then 1 else 0 end), 0) as TotalUpVotes,
        coalesce(sum(case when v.VoteTypeId = 3 then 1 else 0 end), 0) as TotalDownVotes,
        row_number() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Votes v on v.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
BadgeSummary as (
    select
        b.UserId,
        count(*) filter (where b.Class = 1) as GoldBadges,
        count(*) filter (where b.Class = 2) as SilverBadges,
        count(*) filter (where b.Class = 3) as BronzeBadges,
        count(distinct b.Name) as DistinctBadges
    from Badges b
    group by b.UserId
),
TopTags as (
    select
        t.TagName,
        t.Count,
        p.OwnerUserId,
        row_number() over (partition by p.OwnerUserId order by t.Count desc) as TagRank
    from Tags t
    join Posts p on p.Tags like '%' || t.TagName || '%'
    where p.PostTypeId = 1
),
UserTopTags as (
    select
        OwnerUserId as UserId,
        string_agg(TagName, ', ' order by TagRank) as TopTagsList
    from TopTags
    where TagRank <= 3
    group by OwnerUserId
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.OwnerUserId as QuestionOwnerId,
        q.Title,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        a.Id as AnswerId,
        a.OwnerUserId as AnswerOwnerId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreation,
        a.Body,
        case when a.Id = q.AcceptedAnswerId then 1 else 0 end as IsAcceptedAnswer,
        dense_rank() over (partition by q.Id order by a.Score desc) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
),
AnswerVoteStats as (
    select
        a.AnswerId,
        count(v.Id) filter (where v.VoteTypeId = 2) as UpVotes,
        count(v.Id) filter (where v.VoteTypeId = 3) as DownVotes,
        count(v.Id) as TotalVotes
    from QuestionAnswerStats a
    left join Votes v on v.PostId = a.AnswerId
    group by a.AnswerId
),
CloseReasonCounts as (
    select
        ph.PostId,
        crt.Name as CloseReason,
        count(*) as CloseCount
    from PostHistory ph
    join CloseReasonTypes crt on crt.Id::text = ph.Comment
    where ph.PostHistoryTypeId = 10
    group by ph.PostId, crt.Name
),
UserActivitySummary as (
    select
        r.UserId,
        r.DisplayName,
        r.Reputation,
        r.ReputationRank,
        coalesce(b.GoldBadges, 0) as GoldBadges,
        coalesce(b.SilverBadges, 0) as SilverBadges,
        coalesce(b.BronzeBadges, 0) as BronzeBadges,
        coalesce(b.DistinctBadges, 0) as DistinctBadges,
        coalesce(u.TopTagsList, '') as TopTags,
        r.QuestionCount,
        r.AnswerCount,
        r.CommentCount,
        r.TotalUpVotes,
        r.TotalDownVotes
    from RecursiveUserActivity r
    left join BadgeSummary b on b.UserId = r.UserId
    left join UserTopTags u on u.UserId = r.UserId
),
FinalResult as (
    select
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.ReputationRank,
        uas.GoldBadges,
        uas.SilverBadges,
        uas.BronzeBadges,
        uas.DistinctBadges,
        uas.TopTags,
        uas.QuestionCount,
        uas.AnswerCount,
        uas.CommentCount,
        uas.TotalUpVotes,
        uas.TotalDownVotes,
        qa.QuestionId,
        qa.Title as QuestionTitle,
        qa.QuestionCreation,
        qa.QuestionScore,
        qa.ViewCount,
        qa.AnswerId,
        qa.AnswerOwnerId,
        qa.AnswerScore,
        qa.AnswerCreation,
        qa.IsAcceptedAnswer,
        avs.UpVotes,
        avs.DownVotes,
        avs.TotalVotes,
        crc.CloseReason,
        crc.CloseCount,
        length(coalesce(qa.Body, '')) as AnswerBodyLength,
        case when qa.AnswerScore > qa.QuestionScore then 'AnswerBetter' else 'QuestionBetterOrEqual' end as ScoreComparison,
        (select count(*) from Comments c where c.PostId = qa.QuestionId and c.CreationDate > qa.QuestionCreation) as CommentsAfterQuestionCreation
    from UserActivitySummary uas
    left join QuestionAnswerStats qa on qa.QuestionOwnerId = uas.UserId and qa.AnswerRank = 1
    left join AnswerVoteStats avs on avs.AnswerId = qa.AnswerId
    left join CloseReasonCounts crc on crc.PostId = qa.QuestionId
    where uas.Reputation > 1000
)
select *
from FinalResult
where (GoldBadges + SilverBadges + BronzeBadges) > 5
  and (QuestionCount > 10 or AnswerCount > 20)
  and (CloseReason is null or CloseCount < 3)
order by ReputationRank, QuestionCreation desc
limit 100;