WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        ARRAY[t.TagName] AS AncestorTags
    FROM Tags t
    WHERE t.IsModeratorOnly = 0

    UNION ALL

    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        r.AncestorTags || t2.TagName
    FROM Tags t2
    JOIN PostLinks pl ON pl.PostId = t2.ExcerptPostId AND pl.LinkTypeId = 1
    JOIN RecursiveTagHierarchy r ON r.Id = pl.RelatedPostId
    WHERE t2.IsModeratorOnly = 0
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        AVG(p.Score) FILTER (WHERE p.OwnerUserId = u.Id) AS AvgPostScore,
        MAX(b.Date) AS LastBadgeDate,
        MAX(b.Class) FILTER (WHERE b.Class = 1) AS HasGoldBadge,
        RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        ROW_NUMBER() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS LocationRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
),
PostTagStats AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        unnest(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) AS TagName
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) AND p.Tags IS NOT NULL
),
TopTags AS (
    SELECT
        TagName,
        COUNT(*) AS PostCount,
        AVG(Score) AS AvgScore,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionPosts,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerPosts
    FROM PostTagStats p
    GROUP BY TagName
    HAVING COUNT(*) > 100
    ORDER BY PostCount DESC
    LIMIT 50
),
AnswerWindow AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.Score,
        a.CreationDate,
        a.OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank,
        AVG(a.Score) OVER (PARTITION BY a.ParentId) AS AvgAnswerScore,
        COUNT(*) OVER (PARTITION BY a.ParentId) AS AnswerCount
    FROM Posts a
    WHERE a.PostTypeId = 2
),
LatestPostHistoryByType AS (
    SELECT DISTINCT ON (ph.PostId, ph.PostHistoryTypeId)
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ph.UserId,
        ph.Comment,
        ph.Text
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (10, 11) -- Close and Reopen events
    ORDER BY ph.PostId, ph.PostHistoryTypeId, ph.CreationDate DESC
),
ClosedQuestionsWithDetails AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        COALESCE(ph.Comment, 'Unknown') AS CloseReasonId,
        crt.Name AS CloseReasonName,
        ph.CreationDate AS CloseDate,
        u.DisplayName AS ClosedByUser,
        aq.AnswerCount,
        aq.AvgAnswerScore,
        aq.AnswerRank AS AcceptedAnswerRank,
        CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAcceptedAnswer
    FROM Posts p
    LEFT JOIN LatestPostHistoryByType ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId = 10
    LEFT JOIN CloseReasonTypes crt ON crt.Id = COALESCE(NULLIF(ph.Comment, ''), '0')::smallint
    LEFT JOIN Users u ON u.Id = ph.UserId
    LEFT JOIN (
        SELECT
            aw.QuestionId,
            COUNT(*) AS AnswerCount,
            AVG(aw.Score) AS AvgAnswerScore,
            MIN(aw.AnswerRank) FILTER (WHERE aw.AnswerId = p.AcceptedAnswerId) AS AnswerRank
        FROM AnswerWindow aw
        JOIN Posts p ON p.Id = aw.QuestionId
        GROUP BY aw.QuestionId
    ) aq ON aq.QuestionId = p.Id
    WHERE p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL
),
ComplexUserScore AS (
    SELECT
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.QuestionCount,
        ua.AnswerCount,
        ua.CommentCount,
        ua.AvgPostScore,
        COALESCE(ua.HasGoldBadge, 0) AS HasGoldBadge,
        -- Weighted Score combining several user metrics with complicated expressions
        ROUND(
            (ua.Reputation::numeric / NULLIF(ua.QuestionCount + ua.AnswerCount + 1,0)) * 0.4 + 
            (ua.AvgPostScore * COALESCE(ua.AnswerCount, 0) / NULLIF(ua.QuestionCount + 1, 0)) * 0.3 +
            (ua.CommentCount::numeric / NULLIF(ua.AnswerCount + 1, 0)) * 0.2 +
            (ua.HasGoldBadge::int * 1000) * 0.1
            , 2) AS WeightedUserScore
    FROM UserActivity ua
),
FinalSelectedPosts AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        u.DisplayName AS OwnerName,
        cu.WeightedUserScore,
        tg.TagName AS MostRelevantTag
    FROM Posts p
    LEFT JOIN ComplexUserScore cu ON cu.UserId = p.OwnerUserId
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
    LEFT JOIN LATERAL (
        SELECT TagName 
        FROM unnest(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) AS TagName
        WHERE TagName IN (SELECT TagName FROM TopTags)
        ORDER BY (SELECT PostCount FROM TopTags tt WHERE tt.TagName = TagName) DESC
        LIMIT 1
    ) tg ON true
    WHERE p.PostTypeId = 1 AND p.Score >= 5 AND p.ViewCount >= 1000
),
CombinedResults AS (
    SELECT
        fp.Id AS PostId,
        fp.Title,
        fp.CreationDate,
        fp.Score,
        fp.ViewCount,
        fp.OwnerName,
        fp.WeightedUserScore,
        fp.MostRelevantTag,
        cs.DuplicateCount,
        cs.LatestDuplicateDate,
        COALESCE(cq.CloseReasonName, 'Open') AS Status,
        cq.AnswerCount,
        cq.HasAcceptedAnswer
    FROM FinalSelectedPosts fp
    LEFT JOIN (
        SELECT
            pl.RelatedPostId,
            COUNT(*) AS DuplicateCount,
            MAX(pl.CreationDate) AS LatestDuplicateDate
        FROM PostLinks pl
        WHERE pl.LinkTypeId = 3
        GROUP BY pl.RelatedPostId
    ) cs ON cs.RelatedPostId = fp.Id
    LEFT JOIN ClosedQuestionsWithDetails cq ON cq.QuestionId = fp.Id
    WHERE fp.Id NOT IN (
        SELECT PostId FROM Votes WHERE VoteTypeId = 12 -- deletion votes
    )
)
SELECT
    cr.PostId,
    cr.Title,
    cr.CreationDate,
    cr.Score,
    cr.ViewCount,
    cr.OwnerName,
    cr.WeightedUserScore,
    cr.MostRelevantTag,
    cr.DuplicateCount,
    cr.LatestDuplicateDate,
    cr.Status,
    cr.AnswerCount,
    cr.HasAcceptedAnswer,
    -- String manipulation: normalized title and tag for deduplication check
    LOWER(TRIM(cr.Title)) AS NormalizedTitle,
    LOWER(cr.MostRelevantTag) AS NormalizedTag,
    -- Complex CASE with NULL logic
    CASE 
        WHEN cr.Status = 'Open' AND cr.Score > 50 THEN 'Hot Question'
        WHEN cr.Status != 'Open' THEN 'Closed Question'
        WHEN cr.AnswerCount > 10 AND cr.HasAcceptedAnswer = 1 THEN 'Popular Answered'
        ELSE 'Normal'
    END AS Classification
FROM CombinedResults cr
ORDER BY cr.WeightedUserScore DESC, cr.Score DESC, cr.ViewCount DESC
LIMIT 100;