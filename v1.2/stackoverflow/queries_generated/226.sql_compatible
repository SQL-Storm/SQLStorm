WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 AS Level,
        ARRAY[t.TagName] AS Path
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE AND t.IsRequired = FALSE

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        child.Count,
        child.ExcerptPostId,
        child.WikiPostId,
        rh.Level + 1,
        rh.Path || child.TagName
    FROM Tags child
    JOIN RecursiveTagHierarchy rh ON child.Id <> rh.Id
    WHERE child.IsModeratorOnly = FALSE AND child.IsRequired = FALSE
      AND NOT child.TagName = ANY(rh.Path)
      AND rh.Level < 3
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersPosted,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS UpVotesReceived,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS DownVotesReceived,
        MAX(p.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.CreationDate ASC) AS ReputationRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Votes v ON v.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
TopQuestions AS (
    SELECT
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.Tags,
        u.DisplayName AS OwnerName,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.ViewCount DESC) AS UserTopQuestionRank
    FROM Posts p
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
    WHERE p.PostTypeId = 1
      AND p.ClosedDate IS NULL
      AND p.Score > 5
),
AcceptedAnswerStats AS (
    SELECT
        a.ParentId AS QuestionId,
        COUNT(*) AS TotalAnswers,
        AVG(a.Score) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore,
        SUM(CASE WHEN a.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) AS HasAcceptedAnswer
    FROM Posts a
    JOIN Posts q ON q.Id = a.ParentId AND q.PostTypeId = 1
    WHERE a.PostTypeId = 2
    GROUP BY a.ParentId, q.AcceptedAnswerId
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(*) AS TotalBadges,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        STRING_AGG(DISTINCT b.Name, ', ') AS BadgeNames
    FROM Badges b
    GROUP BY b.UserId
),
QuestionCloseReasons AS (
    SELECT
        ph.PostId,
        crt.Name AS CloseReason,
        COUNT(*) AS CloseCount
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON crt.Id = CAST(ph.Comment AS INTEGER)
    WHERE ph.PostHistoryTypeId = 10
    GROUP BY ph.PostId, crt.Name
),
UserEngagement AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS TotalUpVotesGiven,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS TotalDownVotesGiven,
        COALESCE(COUNT(DISTINCT c.Id), 0) AS TotalCommentsMade,
        COALESCE(COUNT(DISTINCT p.Id), 0) AS TotalPostsOwned
    FROM Users u
    LEFT JOIN Votes v ON v.UserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName
)
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.QuestionsPosted,
    ua.AnswersPosted,
    ua.CommentsMade,
    ua.UpVotesReceived,
    ua.DownVotesReceived,
    ua.LastPostDate,
    ua.ReputationRank,
    COALESCE(ubs.TotalBadges, 0) AS TotalBadges,
    COALESCE(ubs.GoldBadges, 0) AS GoldBadges,
    COALESCE(ubs.SilverBadges, 0) AS SilverBadges,
    COALESCE(ubs.BronzeBadges, 0) AS BronzeBadges,
    ues.TotalUpVotesGiven,
    ues.TotalDownVotesGiven,
    ues.TotalCommentsMade,
    ues.TotalPostsOwned,
    tq.Id AS TopQuestionId,
    tq.Title AS TopQuestionTitle,
    tq.Score AS TopQuestionScore,
    tq.ViewCount AS TopQuestionViews,
    tq.AnswerCount AS TopQuestionAnswers,
    COALESCE(aa.AvgAnswerScore, 0) AS AvgAnswerScoreForTopQuestion,
    COALESCE(aa.MaxAnswerScore, 0) AS MaxAnswerScoreForTopQuestion,
    COALESCE(aa.HasAcceptedAnswer, 0) AS HasAcceptedAnswerForTopQuestion,
    qcr.CloseReason,
    qcr.CloseCount,
    rh.Level AS TagHierarchyLevel,
    rh.Path AS TagHierarchyPath,
    rh.Count AS TagUsageCount,
    rh.ExcerptPostId,
    rh.WikiPostId,
    CASE
        WHEN ua.Reputation > 10000 THEN 'Expert'
        WHEN ua.Reputation BETWEEN 5000 AND 10000 THEN 'Intermediate'
        ELSE 'Beginner'
    END AS UserReputationCategory,
    ('User ' || ua.DisplayName ||
        ' has posted ' || COALESCE(CAST(ua.QuestionsPosted AS VARCHAR), '0') || ' questions and ' ||
        COALESCE(CAST(ua.AnswersPosted AS VARCHAR), '0') || ' answers with a reputation of ' || COALESCE(CAST(ua.Reputation AS VARCHAR), '0') ||
        '. Top question "' || COALESCE(tq.Title, 'N/A') || '" scored ' || COALESCE(CAST(tq.Score AS VARCHAR), '0') ||
        ' and has ' || COALESCE(CAST(tq.ViewCount AS VARCHAR), '0') || ' views.'
    ) AS UserSummary
FROM UserActivity ua
LEFT JOIN UserBadgeSummary ubs ON ubs.UserId = ua.UserId
LEFT JOIN UserEngagement ues ON ues.UserId = ua.UserId
LEFT JOIN TopQuestions tq ON tq.OwnerUserId = ua.UserId AND tq.UserTopQuestionRank = 1
LEFT JOIN AcceptedAnswerStats aa ON aa.QuestionId = tq.Id
LEFT JOIN QuestionCloseReasons qcr ON qcr.PostId = tq.Id
LEFT JOIN RecursiveTagHierarchy rh ON rh.ExcerptPostId = tq.Id OR rh.WikiPostId = tq.Id
WHERE ua.Reputation > 1000
  AND (tq.Score > 10 OR tq.Score IS NULL)
ORDER BY ua.Reputation DESC, ua.QuestionsPosted DESC, ua.AnswersPosted DESC
LIMIT 100;