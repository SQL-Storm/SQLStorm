with RecursiveTagCounts as (
    select
        t.Id,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as TotalAnswers,
        coalesce(p.ViewCount, 0) as TotalViews,
        row_number() over (order by t.Count desc, t.TagName) as TagRank
    from Tags t
    left join (
        select
            Tag,
            sum(case when p.PostTypeId = 1 then p.AnswerCount else 0 end) as AnswerCount,
            sum(case when p.PostTypeId = 1 then p.ViewCount else 0 end) as ViewCount
        from (
            select
                p.*,
                -- remove surrounding angle brackets and split into tags
                regexp_split_to_table(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><') as Tag
            from Posts p
            where p.Tags is not null
        ) p
        group by Tag
    ) p on p.Tag = t.TagName
),
UserBadgeAgg as (
    select
        b.UserId,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        max(b.Date) as LastBadgeDate
    from Badges b
    group by b.UserId
),
TopUsers as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        u.Views,
        uba.GoldBadges,
        uba.SilverBadges,
        uba.BronzeBadges,
        uba.LastBadgeDate,
        rank() over (order by u.Reputation desc, u.Views desc) as UserRank
    from Users u
    left join UserBadgeAgg uba on uba.UserId = u.Id
    where u.Reputation > 1000
),
PostActivityWindow as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        count(c.Id) over (partition by p.Id order by coalesce(c.CreationDate, p.CreationDate) rows between unbounded preceding and current row) as CumulativeComments,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as RecentPostRank
    from Posts p
    left join Comments c on c.PostId = p.Id
    where p.PostTypeId in (1, 2)
),
ClosedQuestionsWithReasons as (
    select
        ph.PostId,
        ph.CreationDate as CloseDate,
        crt.Name as CloseReason,
        ph.UserId as CloserUserId,
        u.DisplayName as CloserUserName
    from PostHistory ph
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    left join Users u on u.Id = ph.UserId
    where ph.PostHistoryTypeId = 10
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        p1.Title as OriginalTitle,
        p2.Title as DuplicateTitle,
        pl.CreationDate
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId and lt.Name = 'Duplicate'
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
),
UserAnswerStats as (
    select
        u.Id as UserId,
        count(a.Id) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        sum(case when a.Score >= 10 then 1 else 0 end) as HighScoreAnswers,
        max(a.Score) as MaxAnswerScore
    from Users u
    left join Posts a on a.OwnerUserId = u.Id and a.PostTypeId = 2
    group by u.Id
),
ComplexUserSummary as (
    select
        tu.Id,
        tu.DisplayName,
        tu.Reputation,
        tu.Location,
        tu.Views,
        tu.GoldBadges,
        tu.SilverBadges,
        tu.BronzeBadges,
        coalesce(uas.AnswerCount, 0) as AnswerCount,
        coalesce(uas.AvgAnswerScore, 0) as AvgAnswerScore,
        coalesce(uas.HighScoreAnswers, 0) as HighScoreAnswers,
        coalesce(uas.MaxAnswerScore, 0) as MaxAnswerScore,
        tu.LastBadgeDate,
        tu.UserRank,
        case
            when tu.Views > 100000 then 'Very High'
            when tu.Views > 10000 then 'High'
            when tu.Views > 1000 then 'Medium'
            else 'Low'
        end as ViewCategory,
        case
            when tu.Reputation > 50000 then 'Elite'
            when tu.Reputation > 10000 then 'Experienced'
            else 'Regular'
        end as ReputationCategory
    from TopUsers tu
    left join UserAnswerStats uas on uas.UserId = tu.Id
)
select
    cuss.Id as UserId,
    cuss.DisplayName,
    cuss.Reputation,
    cuss.Location,
    cuss.Views,
    cuss.GoldBadges,
    cuss.SilverBadges,
    cuss.BronzeBadges,
    cuss.AnswerCount,
    round(cuss.AvgAnswerScore::numeric, 2) as AvgAnswerScore,
    cuss.HighScoreAnswers,
    cuss.MaxAnswerScore,
    cuss.LastBadgeDate,
    cuss.ViewCategory,
    cuss.ReputationCategory,
    rtc.TagName,
    rtc.Count as TagQuestionCount,
    rtc.TotalAnswers,
    rtc.TotalViews,
    cqwr.CloseReason,
    dq.OriginalTitle as DuplicateOriginalTitle,
    dq.DuplicateTitle as DuplicatePostTitle,
    paw.CreationDate as RecentPostDate,
    paw.Score as RecentPostScore,
    paw.CumulativeComments
from ComplexUserSummary cuss
left join RecursiveTagCounts rtc on rtc.TagRank <= 10
left join ClosedQuestionsWithReasons cqwr on cqwr.CloserUserId = cuss.Id
left join DuplicateLinks dq on dq.PostId in (
    select p.Id from Posts p where p.OwnerUserId = cuss.Id
)
left join PostActivityWindow paw on paw.OwnerUserId = cuss.Id and paw.RecentPostRank = 1
where cuss.AnswerCount > 5
  and (cqwr.CloseReason is null or lower(cqwr.CloseReason) not like '%duplicate%')
order by cuss.Reputation desc, cuss.Views desc, rtc.Count desc
limit 50;