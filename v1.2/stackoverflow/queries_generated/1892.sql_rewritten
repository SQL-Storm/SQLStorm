WITH RECURSIVE TagHierarchy AS (
    SELECT Id, TagName, ExcerptPostId, WikiPostId, 1 AS Level
    FROM Tags
    WHERE IsModeratorOnly = 0
    UNION ALL
    SELECT t.Id, t.TagName, t.ExcerptPostId, t.WikiPostId, th.Level + 1
    FROM Tags t
    JOIN TagHierarchy th ON t.Count < th.Count 
    WHERE th.Level < 3
