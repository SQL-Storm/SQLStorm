with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionsAsked,
        count(distinct p2.Id) filter (where p2.PostTypeId = 2) as AnswersGiven,
        count(distinct c.Id) as CommentsMade,
        coalesce(sum(case when v.VoteTypeId = 2 then 1 else 0 end),0) as UpVotesReceived,
        coalesce(sum(case when v.VoteTypeId = 3 then 1 else 0 end),0) as DownVotesReceived
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Posts p2 on p2.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Votes v on v.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
), UserBadgeCounts as (
    select
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        count(*) as TotalBadges
    from Badges b
    group by b.UserId
), PostAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount,
        count(a.Id) as AnswerCount,
        max(a.Score) as MaxAnswerScore,
        avg(a.Score) as AvgAnswerScore,
        sum(case when a.Id = q.AcceptedAnswerId then 1 else 0 end) as HasAcceptedAnswer
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.CreationDate, q.Score, q.ViewCount
), PostLinkDuplicates as (
    select
        pl.PostId,
        count(distinct pl.RelatedPostId) filter (where lt.Name = 'Duplicate') as DuplicateCount,
        string_agg(distinct lt.Name, ', ') as LinkTypes
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    group by pl.PostId
), TagUsage as (
    select
        t.TagName,
        t.Count,
        count(p.Id) filter (where p.PostTypeId = 1 and p.Tags like ('%' || '<' || t.TagName || '>' || '%')) as QuestionCount,
        count(p.Id) filter (where p.PostTypeId = 2 and p.Tags like ('%' || '<' || t.TagName || '>' || '%')) as AnswerCount
    from Tags t
    left join Posts p on p.Tags like ('%' || '<' || t.TagName || '>' || '%')
    group by t.TagName, t.Count
), UserActivityRanked as (
    select
        rua.UserId,
        rua.DisplayName,
        rua.Reputation,
        rua.CreationDate,
        rua.LastAccessDate,
        rua.QuestionsAsked,
        rua.AnswersGiven,
        rua.CommentsMade,
        rua.UpVotesReceived,
        rua.DownVotesReceived,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.TotalBadges,
        rank() over (order by rua.Reputation desc, rua.QuestionsAsked desc, rua.AnswersGiven desc) as UserRank,
        dense_rank() over (order by rua.Reputation desc) as ReputationRank
    from RecursiveUserActivity rua
    left join UserBadgeCounts ub on ub.UserId = rua.UserId
), RecentEdits as (
    select
        ph.PostId,
        ph.UserId,
        ph.CreationDate,
        ph.PostHistoryTypeId,
        p.Title,
        u.DisplayName as EditorName,
        ph.Comment,
        row_number() over (partition by ph.PostId order by ph.CreationDate desc) as rn
    from PostHistory ph
    join Posts p on p.Id = ph.PostId
    left join Users u on u.Id = ph.UserId
    where ph.PostHistoryTypeId in (4,5,6)
), LatestEdits as (
    select
        PostId,
        UserId,
        CreationDate,
        PostHistoryTypeId,
        Title,
        EditorName,
        Comment
    from RecentEdits
    where rn = 1
), ComplexPostAnalysis as (
    select
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        pl.DuplicateCount,
        pa.MaxAnswerScore,
        pa.AvgAnswerScore,
        pa.HasAcceptedAnswer,
        le.EditorName as LastEditor,
        le.CreationDate as LastEditDate,
        case
            when p.ClosedDate is not null then 'Closed'
            when pa.HasAcceptedAnswer > 0 then 'Answered'
            else 'Open'
        end as PostStatus,
        case
            when p.Tags is null then null
            else (
                select string_agg(tg, '|')
                from (
                    select unnest(string_to_array(substring(p.Tags, 2, char_length(p.Tags) - 2), '><')) as tg
                    limit 3
                ) sub
            )
        end as Top3Tags,
        coalesce(p.Score,0) * ln(coalesce(p.ViewCount,1) + 1) / nullif(pa.AnswerCount,0) as WeightedScore
    from Posts p
    left join PostLinkDuplicates pl on pl.PostId = p.Id
    left join PostAnswerStats pa on pa.QuestionId = p.Id
    left join LatestEdits le on le.PostId = p.Id
    where p.PostTypeId = 1
), UserPostSummary as (
    select
        uar.UserId,
        uar.DisplayName,
        count(distinct p.Id) filter (where cpa.PostStatus = 'Answered') as AnsweredQuestions,
        count(distinct p.Id) filter (where cpa.PostStatus = 'Closed') as ClosedQuestions,
        count(distinct p.Id) as TotalQuestions,
        avg(cpa.WeightedScore) as AvgWeightedScore
    from UserActivityRanked uar
    left join Posts p on p.OwnerUserId = uar.UserId and p.PostTypeId = 1
    left join ComplexPostAnalysis cpa on cpa.Id = p.Id
    group by uar.UserId, uar.DisplayName
)
select distinct
    uar.UserRank,
    uar.ReputationRank,
    uar.UserId,
    uar.DisplayName,
    uar.Reputation,
    uar.QuestionsAsked,
    uar.AnswersGiven,
    uar.CommentsMade,
    uar.UpVotesReceived,
    uar.DownVotesReceived,
    uar.GoldBadges,
    uar.SilverBadges,
    uar.BronzeBadges,
    ups.AnsweredQuestions,
    ups.ClosedQuestions,
    ups.TotalQuestions,
    round(cast(ups.AvgWeightedScore as numeric), 2) as AvgWeightedScore,
    (
        select string_agg(t.TagName, ', ')
        from Tags t
        where t.Count > 1000
        and exists (
            select 1 from Posts p where p.Tags like ('%' || '<' || t.TagName || '>' || '%') and p.OwnerUserId = uar.UserId limit 1
        )
        limit 5
    ) as TopTags,
    (
        select count(*) from Votes v
        where v.UserId = uar.UserId
        and v.VoteTypeId in (2,3)
        and v.CreationDate > uar.LastAccessDate - interval '30 days'
    ) as RecentVotesCast,
    (
        select count(*) from Comments c
        where c.UserId = uar.UserId
        and c.CreationDate > uar.LastAccessDate - interval '30 days'
    ) as RecentCommentsMade
from UserActivityRanked uar
left join UserPostSummary ups on ups.UserId = uar.UserId
where uar.Reputation > 10000
order by uar.UserRank
limit 25;