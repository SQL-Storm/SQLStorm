-- {"query": "654.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.6, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1726} 
with RecursiveTagCounts as (
    select
        t.Id,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount,0) as AnswerCount,
        coalesce(p.CommentCount,0) as CommentCount,
        coalesce(p.FavoriteCount,0) as FavoriteCount,
        row_number() over (order by t.Count desc, t.TagName) as Rank
    from Tags t
    left join Posts p on p.Id = t.ExcerptPostId and p.PostTypeId = 1
    where t.TagName is not null
), UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct b.Id) as TotalBadges,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        max(b.Date) as LastBadgeDate
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
), PostActivityWindow as (
    select
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        p.Tags,
        p.Title,
        count(distinct c.Id) over (partition by p.Id order by c.CreationDate rows between unbounded preceding and unbounded following) as CommentCountWindow,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as UserPostRank
    from Posts p
    left join Comments c on c.PostId = p.Id
    where p.PostTypeId in (1,2)
), PostLinkDuplicates as (
    select
        pl.PostId,
        pl.RelatedPostId,
        lt.Name as LinkTypeName
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where lt.Name = 'Duplicate'
), ClosedQuestions as (
    select
        ph.PostId,
        min(ph.CreationDate) as ClosedDate,
        crt.Name as CloseReason
    from PostHistory ph
    join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as int)
    where pht.Name = 'Post Closed'
    group by ph.PostId, crt.Name
), UserReputationRank as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        dense_rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
), CorrelatedAnswerCount as (
    select
        q.Id as QuestionId,
        (select count(*) from Posts a where a.ParentId = q.Id and a.PostTypeId = 2) as AnswerCount
    from Posts q
    where q.PostTypeId = 1
)
select distinct
    p.Id as PostId,
    p.Title,
    p.Tags,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    u.DisplayName as OwnerName,
    u.Reputation,
    ur.ReputationRank,
    ub.TotalBadges,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ub.LastBadgeDate,
    ca.AnswerCount,
    coalesce(cq.ClosedDate, timestamp '9999-12-31') as ClosedDate,
    cq.CloseReason,
    pl.LinkTypeName,
    rac.CommentCountWindow,
    rac.UserPostRank,
    -- Complex string and NULL logic expression:
    case
        when p.Tags is null or length(trim(p.Tags)) = 0 then 'No Tags'
        when position('sql' in lower(p.Tags)) > 0 then 'Contains SQL'
        else concat('Tags: ', substring(p.Tags from 2 for 50), case when length(p.Tags) > 52 then '...' else '' end)
    end as TagSummary,
    -- Window aggregate with NULL logic:
    avg(nullif(p.Score,0)) over (partition by p.OwnerUserId) as AvgNonZeroScoreByUser,
    -- Correlated subquery with NULL handling:
    (select max(ph.CreationDate)
     from PostHistory ph2
     where ph2.PostId = p.Id and ph2.PostHistoryTypeId in (4,5,6)
    ) as LastEditDate,
    -- Calculated field with NULL-safe arithmetic:
    coalesce(p.Score,0) * 0.7 + coalesce(p.ViewCount,0) * 0.01 + coalesce(ca.AnswerCount,0) * 5 as WeightedScore
from Posts p
left join Users u on u.Id = p.OwnerUserId
left join UserReputationRank ur on ur.Id = u.Id
left join UserBadgeStats ub on ub.UserId = u.Id
left join CorrelatedAnswerCount ca on ca.QuestionId = p.Id
left join ClosedQuestions cq on cq.PostId = p.Id
left join PostLinkDuplicates pl on pl.PostId = p.Id
left join PostActivityWindow rac on rac.Id = p.Id
where p.PostTypeId = 1
  and (
    (p.Score > (select avg(p2.Score) from Posts p2 where p2.PostTypeId = 1))
    or
    (u.Reputation > 10000 and ub.GoldBadges > 0)
  )
union
select
    p2.Id as PostId,
    p2.Title,
    p2.Tags,
    p2.Score,
    p2.ViewCount,
    p2.OwnerUserId,
    u2.DisplayName as OwnerName,
    u2.Reputation,
    ur2.ReputationRank,
    ub2.TotalBadges,
    ub2.GoldBadges,
    ub2.SilverBadges,
    ub2.BronzeBadges,
    ub2.LastBadgeDate,
    ca2.AnswerCount,
    coalesce(cq2.ClosedDate, timestamp '9999-12-31') as ClosedDate,
    cq2.CloseReason,
    pl2.LinkTypeName,
    rac2.CommentCountWindow,
    rac2.UserPostRank,
    case
        when p2.Tags is null or length(trim(p2.Tags)) = 0 then 'No Tags'
        when position('sql' in lower(p2.Tags)) > 0 then 'Contains SQL'
        else concat('Tags: ', substring(p2.Tags from 2 for 50), case when length(p2.Tags) > 52 then '...' else '' end)
    end as TagSummary,
    avg(nullif(p2.Score,0)) over (partition by p2.OwnerUserId) as AvgNonZeroScoreByUser,
    (select max(ph3.CreationDate)
     from PostHistory ph3
     where ph3.PostId = p2.Id and ph3.PostHistoryTypeId in (4,5,6)
    ) as LastEditDate,
    coalesce(p2.Score,0) * 0.7 + coalesce(p2.ViewCount,0) * 0.01 + coalesce(ca2.AnswerCount,0) * 5 as WeightedScore
from Posts p2
left join Users u2 on u2.Id = p2.OwnerUserId
left join UserReputationRank ur2 on ur2.Id = u2.Id
left join UserBadgeStats ub2 on ub2.UserId = u2.Id
left join CorrelatedAnswerCount ca2 on ca2.QuestionId = p2.Id
left join ClosedQuestions cq2 on cq2.PostId = p2.Id
left join PostLinkDuplicates pl2 on pl2.PostId = p2.Id
left join PostActivityWindow rac2 on rac2.Id = p2.Id
where p2.PostTypeId = 1
  and p2.CreationDate > cast('2024-10-01' as date) - interval '180 days'
order by WeightedScore desc, Score desc, ViewCount desc
limit 100;