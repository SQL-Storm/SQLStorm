WITH RECURSIVE RecursiveComments AS (
    SELECT
        c.Id,
        c.PostId,
        c.UserId,
        c.CreationDate,
        1 AS Level,
        ARRAY[c.Id] AS Path
    FROM Comments c
    WHERE c.CreationDate <= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
    
    UNION ALL
    
    SELECT
        c2.Id,
        c2.PostId,
        c2.UserId,
        c2.CreationDate,
        rc.Level + 1 AS Level,
        rc.Path || c2.Id
    FROM Comments c2
    INNER JOIN Posts p ON c2.PostId = p.Id
    INNER JOIN RecursiveComments rc ON c2.CreationDate > rc.CreationDate
    WHERE
        p.PostTypeId = 1
        AND rc.Level < 3
        AND c2.CreationDate <= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
),
RawCTE AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COALESCE(b.BadgeCount, 0) AS TotalBadges,
        COALESCE(b.GoldBadges, 0) AS GoldBadges,
        COALESCE(b.SilverBadges, 0) AS SilverBadges,
        COALESCE(b.BronzeBadges, 0) AS BronzeBadges,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT a.Id) AS AnswerCount,
        AVG(a.Score) AS AvgAnswerScore,
        SUM(COALESCE(v.UpVotesCount, 0) - COALESCE(v.DownVotesCount, 0)) AS VoteBalance,
        R.FavRank
    FROM Users u
    LEFT JOIN (
        SELECT
            UserId,
            COUNT(*) AS BadgeCount,
            SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
            SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
            SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
        FROM Badges
        GROUP BY UserId
    ) b ON u.Id = b.UserId
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    LEFT JOIN Posts a ON a.OwnerUserId = u.Id AND a.PostTypeId = 2
    LEFT JOIN (
        SELECT
            p.OwnerUserId,
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesCount,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesCount
        FROM Votes v
        INNER JOIN Posts p ON p.Id = v.PostId
        GROUP BY p.OwnerUserId
    ) v ON u.Id = v.OwnerUserId
    LEFT JOIN (
        SELECT
            rq.OwnerUserId,
            RANK() OVER (
                ORDER BY COALESCE(SUM(rq.FavoriteCount), 0) DESC,
                         COALESCE(SUM(rq.Score), 0) DESC
            ) AS FavRank
        FROM Posts rq
        WHERE rq.PostTypeId = 1
        GROUP BY rq.OwnerUserId
    ) R ON u.Id = R.OwnerUserId
    GROUP BY u.Id, b.BadgeCount, b.GoldBadges, b.SilverBadges, b.BronzeBadges, R.FavRank, u.DisplayName
),
DuplicatesCTE AS (
    SELECT
        pl.PostId, pl.RelatedPostId,
        COUNT(*) AS DuplicateCounts
    FROM PostLinks pl
    WHERE pl.LinkTypeId = 3
    GROUP BY pl.PostId, pl.RelatedPostId
),
ComplexRanking AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        u.DisplayName,
        COUNT(DISTINCT c.Id) AS CommentActivity,
        AVG(pra.RATIO) OVER (PARTITION BY p.Id ORDER BY a.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS AvgAnswerPopularity,
        ROW_NUMBER() OVER (
            PARTITION BY u.Id
            ORDER BY p.Score DESC NULLS LAST, p.ViewCount DESC NULLS LAST
        ) AS PostRankPerUser,
        CASE WHEN EXISTS (
            SELECT 1 FROM DuplicatesCTE d WHERE d.PostId = p.Id
        ) THEN 1 ELSE 0 END AS IsDuplicate,
        CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END AS IsClosedSeparated,
        p.ClosedDate
    FROM Posts p
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON c.PostId = p.Id
    LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
    LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId = 2
    LEFT JOIN Votes vDown ON vDown.PostId = p.Id AND vDown.VoteTypeId = 3
    LEFT JOIN (
      SELECT
        a.Id,
        CASE WHEN a.Score <> 0 THEN CAST(a.Score AS FLOAT) / GREATEST(a.ViewCount,1) ELSE 0 END AS RATIO
      FROM Posts a
      WHERE a.PostTypeId = 2
    ) pra ON pra.Id = a.Id
    GROUP BY p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount, u.DisplayName, p.ClosedDate
    HAVING AVG(pra.RATIO) > 0.01 OR COUNT(DISTINCT c.Id) >= 2
),
Final AS (
    SELECT
        rc.UserId,
        u.DisplayName AS UserName,
        rc.Level,
        MAX(c.Score) AS CommentHighScore,
        AVG(c.Score) FILTER (WHERE c.Score IS NOT NULL) AS AverageCommentScore,
        MAX(c.CreationDate) AS LastCommentDate,
        COUNT(rc.Id) AS RecursiveCommentCount,
        r.TotalBadges,
        r.GoldBadges,
        r.SilverBadges,
        r.BronzeBadges,
        r.QuestionCount,
        r.AnswerCount,
        r.AvgAnswerScore,
        r.VoteBalance,
        CASE 
            WHEN r.FavRank IS NULL THEN 9999 ELSE r.FavRank 
        END AS PopularityRank,
        r.FavRank
    FROM RecursiveComments rc
    INNER JOIN Comments c ON c.Id = rc.Id
    INNER JOIN Users u ON u.Id = rc.UserId
    INNER JOIN RawCTE r ON r.UserId = rc.UserId
    GROUP BY rc.UserId, u.DisplayName, rc.Level, r.TotalBadges, r.GoldBadges, r.SilverBadges, r.BronzeBadges, r.QuestionCount, r.AnswerCount, r.AvgAnswerScore, r.VoteBalance, r.FavRank
),
LateDistanceBounds AS (
    SELECT PostId,
    (EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - MIN(CreationDate)))) / 86400.0 AS DaysSinceFirstComment
    FROM Comments
    GROUP BY PostId
    HAVING COUNT(*) > 5
),
AnswerLaggedProgress AS (
    SELECT 
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.CreationDate,
        LAG(a.CreationDate) OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS PrevCreationDate,
        a.Score
    FROM Posts a
    WHERE a.PostTypeId = 2 AND a.ParentId IS NOT NULL
)
SELECT
    f.UserId,
    f.UserName,
    f.Level AS RecursiveCommentDepth,
    f.CommentHighScore,
    ROUND(CAST(f.AverageCommentScore AS NUMERIC), 2) AS AveragedCommentScore,
    f.LastCommentDate,
    f.RecursiveCommentCount,
    ( 'Badges Total: ' || f.TotalBadges || ' / Gold: ' || f.GoldBadges || ' / Silver: ' || f.SilverBadges || ' / Bronze: ' || f.BronzeBadges ) AS BadgeSummary,
    ('Q:' || f.QuestionCount || ' A:' || f.AnswerCount || ' VR: ' || f.VoteBalance) AS PostSummaries,
    f.AvgAnswerScore,
    f.PopularityRank,
    cb.Title AS HighlyRankedPostTitle,
    COALESCE(cb.PostRankPerUser, 999) AS UserPostRank,
    cb.IsDuplicate,
    cb.IsClosedSeparated,
    bpos.DaysSinceFirstComment,
    EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - a.lagTime)) AS DaysBetweenTopAnswers
FROM Final f
LEFT JOIN LATERAL (
    SELECT Title, PostRankPerUser, IsDuplicate, IsClosedSeparated, DisplayName
    FROM ComplexRanking cb
    WHERE cb.DisplayName = f.UserName
    ORDER BY cb.PostRankPerUser ASC
    LIMIT 1
) cb ON TRUE
LEFT JOIN LateDistanceBounds bpos ON bpos.PostId = (
    SELECT Id FROM Posts WHERE OwnerUserId = f.UserId AND PostTypeId = 1 ORDER BY CreationDate DESC LIMIT 1
)
LEFT JOIN LATERAL (
    SELECT
      a.AnswerId, lagged.PreviousDate,
      a.CreationDate - lagged.PreviousDate AS lagTime
    FROM AnswerLaggedProgress a
    CROSS JOIN LATERAL (
      SELECT
        LAG(a.CreationDate) OVER (PARTITION BY a.QuestionId ORDER BY a.Score DESC, a.CreationDate ASC) AS PreviousDate
    ) lagged
    WHERE a.AnswerId IN (
      SELECT a2.Id FROM Posts a2 WHERE a2.OwnerUserId = f.UserId AND a2.PostTypeId = 2 ORDER BY a2.CreationDate DESC LIMIT 1
    )
    LIMIT 1
) a ON TRUE
WHERE f.TotalBadges > 5
ORDER BY
    f.Level DESC,
    f.PopularityRank
LIMIT 50;