with RecursiveCTE as (
    select
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        u.Reputation,
        coalesce(nullif(trim(regexp_replace(p.Tags, '[<]', '', 'g')),''),'])[') as sanitized_tags,
        bigint_path.ItemSequence
    from Posts p
    left join Users u on p.OwnerUserId = u.Id
    cross join lateral (
      select array_position(string_to_array(coalesce(p.Tags,''),'><'), unnest(string_to_array(coalesce(p.Tags,''),'><'))) as ItemSequence  
      from Posts pp where pp.Id = p.Id limit 1
    ) bigint_path
    where p.PostTypeId = 1 and p.ViewCount > 1000 and p.OwnerUserId is not null
 
    union all

    select
        pl.RelatedPostId as Id,
        p2.Title,
        p2.CreationDate,
        p2.Score,
        p2.ViewCount,
        p2.OwnerUserId,
        u.Reputation,
        null,
        bigint_path.ItemSequence + 1
    from RecursiveCTE cte
    join PostLinks pl on pl.PostId = cte.Id and pl.LinkTypeId in (1,3) --linked and duplicates
    join Posts p2 on p2.Id = pl.RelatedPostId
    left join Users u on p2.OwnerUserId = u.Id
    where p2.OwnerUserId is not null
      and cte.ItemSequence < 5 --depth limit in graph rec check
)
