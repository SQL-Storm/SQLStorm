with Recursive CloseCycle as (
    select ph.PostId, ph.Id as HistoryId, ph.CreationDate, ph.UserId, ph.Comment, 1 as Depth
    from PostHistory ph
    where ph.PostHistoryTypeId = 10

    union all

    select ph.PostId, ph.Id, ph.CreationDate, ph.UserId, ph.Comment, cc.Depth + 1
    from PostHistory ph
    join CloseCycle cc on ph.PostId = cc.PostId and ph.CreationDate > cc.CreationDate
    where ph.PostHistoryTypeId in (10, 11)
    and cc.Depth < 5
),
UserBadges as (
    select u.Id as UserId, u.DisplayName, count(b.Id) as BadgeCount,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostScoreRanks as (
    select p.Id, p.PostTypeId, p.OwnerUserId,
        p.Score,
        rank() over (partition by p.PostTypeId order by p.Score desc) as ScoreRank,
        row_number() over (partition by p.PostTypeId order by p.CreationDate) as AgeRank
    from Posts p
    where p.Score is not null
),
QuestionAnswerStats as (
    select q.Id as QuestionId, q.Title, q.OwnerUserId as QuestionOwner,
        q.Score as QuestionScore, q.ViewCount,
        coalesce(a.AnswerCount, 0) as AnswerCount,
        coalesce(maxAns.Score, 0) as MaxAnswerScore,
        coalesce(avgAns.AvgScore, 0) as AvgAnswerScore
    from Posts q
    left join (
        select ParentId, count(*) as AnswerCount
        from Posts
        where PostTypeId = 2
        group by ParentId
    ) a on a.ParentId = q.Id
    left join (
        select ParentId, max(Score) as Score
        from Posts
        where PostTypeId = 2
        group by ParentId
    ) maxAns on maxAns.ParentId = q.Id
    left join (
        select ParentId, avg(CAST(Score AS numeric)) as AvgScore
        from Posts
        where PostTypeId = 2
        group by ParentId
    ) avgAns on avgAns.ParentId = q.Id
    where q.PostTypeId = 1
),
QuestionWithComments as (
    select q.QuestionId, q.Title, q.QuestionOwner, q.QuestionScore, q.ViewCount,
        q.AnswerCount, q.MaxAnswerScore, q.AvgAnswerScore,
        count(c.Id) filter (where c.UserId is not null) as NumComments,
        count(c.UserId) filter (where c.UserId is not null) as UniqueCommenters
    from QuestionAnswerStats q
    left join Comments c on c.PostId = q.QuestionId
    group by q.QuestionId, q.Title, q.QuestionOwner, q.QuestionScore, q.ViewCount, q.AnswerCount, q.MaxAnswerScore, q.AvgAnswerScore
),
PostTagExploded as (
    select p.Id as PostId, unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><')) as Tag
    from Posts p
    where p.Tags is not null and p.PostTypeId = 1
),
TopTags as (
    select Tag, count(*) as TagCount
    from PostTagExploded
    group by Tag
    order by TagCount desc
    limit 10
),
UserActivityWindows as (
    select u.Id as UserId, u.DisplayName,
        count(p.Id) over (partition by u.Id order by p.CreationDate range between interval '30 days' preceding and current row) as PostsLast30Days,
        count(v.Id) over (partition by u.Id order by v.CreationDate range between interval '30 days' preceding and current row) as VotesLast30Days,
        count(c.Id) over (partition by u.Id order by c.CreationDate range between interval '30 days' preceding and current row) as CommentsLast30Days
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.UserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName, p.CreationDate, v.CreationDate, c.CreationDate
),
UserReputationChange as (
    select v.UserId,
        sum(case when vt.Name = 'UpMod' then 10
                 when vt.Name = 'DownMod' then -2
                 when vt.Name = 'AcceptedByOriginator' then 15
                 else 0 end) as ReputationDelta
    from Votes v
    join VoteTypes vt on vt.Id = v.VoteTypeId
    where v.UserId is not null
    group by v.UserId
),
PostsWithLinks as (
    select p.Id, p.Title, p.PostTypeId, count(pl.Id) as OutboundLinks,
        (select count(*) from PostLinks pl2 where pl2.RelatedPostId = p.Id) as InboundLinks
    from Posts p
    left join PostLinks pl on pl.PostId = p.Id
    group by p.Id, p.Title, p.PostTypeId
),
DuplicatesCTE as (
    select pl.PostId as DuplicatePostId, pl.RelatedPostId as OriginalPostId,
        p1.Title as DuplicateTitle, p2.Title as OriginalTitle
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where pl.LinkTypeId = 3
),
Summary as (
    select u.Id as UserId, u.DisplayName,
        ub.BadgeCount, ub.GoldBadges, ub.SilverBadges, ub.BronzeBadges,
        ua.PostsLast30Days, ua.VotesLast30Days, ua.CommentsLast30Days,
        coalesce(ur.ReputationDelta, 0) as ReputationDelta
    from Users u
    left join UserBadges ub on ub.UserId = u.Id
    left join UserActivityWindows ua on ua.UserId = u.Id
    left join UserReputationChange ur on ur.UserId = u.Id
)
select qwc.QuestionId, qwc.Title, qwc.QuestionScore, qwc.ViewCount, qwc.AnswerCount, qwc.MaxAnswerScore, qwc.AvgAnswerScore,
    qwc.NumComments, qwc.UniqueCommenters,
    array_agg(tt.Tag) filter (where tt.Tag is not null) as TopTagsUsed,
    pl.OutboundLinks, pl.InboundLinks,
    dup.DuplicatePostId, dup.OriginalPostId, dup.DuplicateTitle, dup.OriginalTitle,
    sum(case when cc.Comment is not null then 1 else 0 end) as CloseEvents,
    max(cc.Depth) as MaxCloseDepth,
    s.UserId, s.DisplayName, s.BadgeCount, s.GoldBadges, s.SilverBadges, s.BronzeBadges,
    s.PostsLast30Days, s.VotesLast30Days, s.CommentsLast30Days, s.ReputationDelta,
    ps.ScoreRank, ps.AgeRank,
    concat_ws(' - ',
        coalesce(s.DisplayName, 'Anonymous'),
        'QScore:', qwc.QuestionScore,
        'Answers:', qwc.AnswerCount,
        'Views:', qwc.ViewCount) as SummaryString
from QuestionWithComments qwc
left join PostTagExploded pte on pte.PostId = qwc.QuestionId
left join TopTags tt on tt.Tag = pte.Tag
left join PostsWithLinks pl on pl.Id = qwc.QuestionId
left join DuplicatesCTE dup on dup.DuplicatePostId = qwc.QuestionId
left join CloseCycle cc on cc.PostId = qwc.QuestionId
left join Summary s on s.UserId = qwc.QuestionOwner
left join PostScoreRanks ps on ps.Id = qwc.QuestionId
where qwc.AnswerCount > 0
and (qwc.MaxAnswerScore > 5 or qwc.QuestionScore > 10)
group by qwc.QuestionId, qwc.Title, qwc.QuestionScore, qwc.ViewCount, qwc.AnswerCount, qwc.MaxAnswerScore, qwc.AvgAnswerScore,
    qwc.NumComments, qwc.UniqueCommenters,
    pl.OutboundLinks, pl.InboundLinks,
    dup.DuplicatePostId, dup.OriginalPostId, dup.DuplicateTitle, dup.OriginalTitle,
    s.UserId, s.DisplayName, s.BadgeCount, s.GoldBadges, s.SilverBadges, s.BronzeBadges,
    s.PostsLast30Days, s.VotesLast30Days, s.CommentsLast30Days, s.ReputationDelta,
    ps.ScoreRank, ps.AgeRank
order by qwc.QuestionScore desc, qwc.ViewCount desc
limit 100;