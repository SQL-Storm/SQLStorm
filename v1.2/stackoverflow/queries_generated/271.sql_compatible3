WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        1 AS Level,
        ARRAY[t.TagName]::varchar[] AS Path
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE
      AND t.IsRequired = FALSE

    UNION ALL

    SELECT
        t.Id,
        t.TagName,
        t.Count,
        r.Level + 1,
        r.Path || t.TagName
    FROM Tags t
    JOIN RecursiveTagHierarchy r
      ON t.Id > r.Id
    WHERE t.IsModeratorOnly = FALSE
      AND t.IsRequired = FALSE
      AND NOT t.TagName = ANY(r.Path)
      AND r.Level < 3
),
UserBadgeCounts AS (
    SELECT
        b.UserId,
        b.Class,
        COUNT(*) AS BadgeCount
    FROM Badges b
    GROUP BY b.UserId, b.Class
),
UserReputationRanks AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        RANK() OVER (ORDER BY u.Reputation DESC) AS RepRank,
        DENSE_RANK() OVER (PARTITION BY DATE_TRUNC('year', u.CreationDate) ORDER BY u.Reputation DESC) AS YearlyRepRank
    FROM Users u
    WHERE u.Reputation IS NOT NULL
),
PostScoreStats AS (
    SELECT
        p.OwnerUserId,
        AVG(p.Score) AS AvgScore,
        STDDEV_POP(p.Score) AS StdDevScore,
        COUNT(*) AS PostCount
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
      AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
TopQuestionsWithAnswers AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.Tags,
        a.Id AS AnswerId,
        a.Score AS AnswerScore,
        a.CreationDate AS AnswerCreationDate,
        u.DisplayName AS AnswererName,
        ROW_NUMBER() OVER (PARTITION BY q.Id ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN Users u ON u.Id = a.OwnerUserId
    WHERE q.PostTypeId = 1
      AND q.Score > 10
      AND q.ViewCount > 1000
),
CloseReasonCounts AS (
    SELECT
        cht.Name AS CloseReasonName,
        COUNT(ph.Id) AS CloseCount
    FROM PostHistory ph
    JOIN PostHistoryTypes chtype ON ph.PostHistoryTypeId = chtype.Id
    LEFT JOIN CloseReasonTypes cht ON CAST(ph.Comment AS INTEGER) = cht.Id AND ph.PostHistoryTypeId = 10
    WHERE ph.PostHistoryTypeId = 10
    GROUP BY cht.Name
),
UserActivityWindow AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        COUNT(*) OVER (PARTITION BY u.Id ORDER BY p.CreationDate RANGE BETWEEN INTERVAL '30 days' PRECEDING AND CURRENT ROW) AS PostsLast30Days
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
),
UserTopTags AS (
    SELECT
        p.OwnerUserId,
        UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><')) AS Tag,
        COUNT(*) AS TagCount
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId, Tag
),
UserTopTagRanks AS (
    SELECT
        ut.OwnerUserId,
        ut.Tag,
        ut.TagCount,
        RANK() OVER (PARTITION BY ut.OwnerUserId ORDER BY ut.TagCount DESC) AS TagRank
    FROM UserTopTags ut
),
FinalSelection AS (
    SELECT DISTINCT
        u.Id AS UserId,
        u.DisplayName,
        ur.RepRank,
        ur.YearlyRepRank,
        COALESCE(ubc_gold.BadgeCount, 0) AS GoldBadges,
        COALESCE(ubc_silver.BadgeCount, 0) AS SilverBadges,
        COALESCE(ubc_bronze.BadgeCount, 0) AS BronzeBadges,
        COALESCE(pss.AvgScore, 0) AS AvgPostScore,
        COALESCE(pss.StdDevScore, 0) AS StdDevPostScore,
        COALESCE(pss.PostCount, 0) AS TotalPosts,
        ua.PostsLast30Days,
        ut.Tag AS TopTag,
        ut.TagCount AS TopTagCount
    FROM Users u
    LEFT JOIN UserReputationRanks ur ON ur.Id = u.Id
    LEFT JOIN UserBadgeCounts ubc_gold ON ubc_gold.UserId = u.Id AND ubc_gold.Class = 1
    LEFT JOIN UserBadgeCounts ubc_silver ON ubc_silver.UserId = u.Id AND ubc_silver.Class = 2
    LEFT JOIN UserBadgeCounts ubc_bronze ON ubc_bronze.UserId = u.Id AND ubc_bronze.Class = 3
    LEFT JOIN PostScoreStats pss ON pss.OwnerUserId = u.Id
    LEFT JOIN UserActivityWindow ua ON ua.UserId = u.Id
    LEFT JOIN (
        SELECT OwnerUserId, Tag, TagCount FROM UserTopTagRanks WHERE TagRank = 1
    ) ut ON ut.OwnerUserId = u.Id
    WHERE u.Reputation > 1000
)
SELECT
    fs.UserId,
    fs.DisplayName,
    fs.RepRank,
    fs.YearlyRepRank,
    fs.GoldBadges,
    fs.SilverBadges,
    fs.BronzeBadges,
    fs.AvgPostScore,
    fs.StdDevPostScore,
    fs.TotalPosts,
    fs.PostsLast30Days,
    fs.TopTag,
    fs.TopTagCount,
    COALESCE(crc.CloseCount, 0) AS TotalClosedPosts,
    COALESCE(tqa.AnswerCount, 0) AS TotalAnswersToTopQuestions,
    STRING_AGG(DISTINCT rth.TagName, ', ') AS SampleTagsPath
FROM FinalSelection fs
LEFT JOIN (
    SELECT
        ph.PostId,
        COUNT(*) AS CloseCount
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10
    GROUP BY ph.PostId
) crc ON crc.PostId = fs.UserId
LEFT JOIN (
    SELECT
        q.OwnerUserId,
        COUNT(a.Id) AS AnswerCount
    FROM Posts q
    JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1
      AND q.Score > 20
    GROUP BY q.OwnerUserId
) tqa ON tqa.OwnerUserId = fs.UserId
LEFT JOIN RecursiveTagHierarchy rth ON rth.Level = 1
GROUP BY
    fs.UserId,
    fs.DisplayName,
    fs.RepRank,
    fs.YearlyRepRank,
    fs.GoldBadges,
    fs.SilverBadges,
    fs.BronzeBadges,
    fs.AvgPostScore,
    fs.StdDevPostScore,
    fs.TotalPosts,
    fs.PostsLast30Days,
    fs.TopTag,
    fs.TopTagCount,
    crc.CloseCount,
    tqa.AnswerCount
ORDER BY fs.RepRank
LIMIT 100;