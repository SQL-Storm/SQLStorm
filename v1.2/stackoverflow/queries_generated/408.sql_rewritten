-- {"query": "408.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.4, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1775} 
with RecursiveTagCounts as (
    select 
        t.Id,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as TotalAnswers,
        coalesce(p.ViewCount, 0) as TotalViews,
        p.OwnerUserId,
        u.DisplayName,
        row_number() over (partition by t.Id order by p.CreationDate desc) as rn
    from Tags t
    left join Posts p on p.Tags like concat('%<', t.TagName, '>%') and p.PostTypeId = 1
    left join Users u on u.Id = p.OwnerUserId
),
TopTagQuestions as (
    select 
        Id, TagName, Count, TotalAnswers, TotalViews, OwnerUserId, DisplayName
    from RecursiveTagCounts
    where rn = 1
),
UserBadgeAgg as (
    select 
        b.UserId,
        count(*) filter (where b.Class = 1) as GoldBadges,
        count(*) filter (where b.Class = 2) as SilverBadges,
        count(*) filter (where b.Class = 3) as BronzeBadges,
        count(distinct b.Name) as DistinctBadges,
        max(b.Date) as LastBadgeDate
    from Badges b
    group by b.UserId
),
UserPostStats as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        sum(p.Score) filter (where p.PostTypeId in (1,2)) as TotalScore,
        avg(p.Score) filter (where p.PostTypeId in (1,2)) as AvgScore,
        max(p.Score) filter (where p.PostTypeId in (1,2)) as MaxScore,
        sum(p.ViewCount) filter (where p.PostTypeId = 1) as TotalQuestionViews,
        max(p.CreationDate) filter (where p.PostTypeId in (1,2)) as LastPostDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    group by u.Id, u.DisplayName
),
UserActivityWindow as (
    select 
        UserId,
        CreationDate,
        count(*) over (partition by UserId order by CreationDate range between interval '30 days' preceding and current row) as PostsLast30Days
    from Posts
    where OwnerUserId is not null
),
HighActivityUsers as (
    select distinct UserId
    from UserActivityWindow
    where PostsLast30Days > 10
),
QuestionAnswerPairs as (
    select 
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionDate,
        a.Id as AnswerId,
        a.CreationDate as AnswerDate,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerOwner,
        u.DisplayName as AnswerOwnerName,
        row_number() over (partition by q.Id order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Users u on u.Id = a.OwnerUserId
    where q.PostTypeId = 1
),
TopAnswers as (
    select * from QuestionAnswerPairs where AnswerRank <= 3
),
ClosedQuestions as (
    select 
        p.Id,
        p.Title,
        p.ClosedDate,
        ph.Comment as CloseReason,
        crt.Name as CloseReasonName
    from Posts p
    join PostHistory ph on ph.PostId = p.Id and ph.PostHistoryTypeId = 10
    left join CloseReasonTypes crt on crt.Id::int = ph.Comment::int
    where p.ClosedDate is not null
),
UserReputationRanks as (
    select 
        Id,
        DisplayName,
        Reputation,
        rank() over (order by Reputation desc) as ReputationRank
    from Users
),
UserLinkDuplicates as (
    select 
        pl.PostId,
        pl.RelatedPostId,
        lt.Name as LinkTypeName,
        p1.OwnerUserId as PostOwner,
        p2.OwnerUserId as RelatedPostOwner
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where lt.Name = 'Duplicate'
),
UserCommentStats as (
    select 
        c.UserId,
        count(*) as CommentCount,
        avg(length(c.Text)) as AvgCommentLength,
        count(distinct c.PostId) as DistinctPostsCommented
    from Comments c
    group by c.UserId
)
select 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    ur.ReputationRank,
    coalesce(uba.GoldBadges,0) as GoldBadges,
    coalesce(uba.SilverBadges,0) as SilverBadges,
    coalesce(uba.BronzeBadges,0) as BronzeBadges,
    ups.QuestionCount,
    ups.AnswerCount,
    ups.TotalScore,
    ups.AvgScore,
    ups.MaxScore,
    ups.TotalQuestionViews,
    coalesce(ucs.CommentCount,0) as CommentCount,
    coalesce(ucs.AvgCommentLength,0) as AvgCommentLength,
    coalesce(ucs.DistinctPostsCommented,0) as DistinctPostsCommented,
    ha.PostsLast30Days,
    array_agg(distinct t.TagName) filter (where t.TagName is not null) as UserTags,
    array_agg(distinct concat_ws('->', cast(uld.PostId as varchar), cast(uld.RelatedPostId as varchar))) as DuplicateLinks,
    tq.QuestionId,
    tq.Title as TopQuestionTitle,
    ta.AnswerId as TopAnswerId,
    ta.AnswerScore as TopAnswerScore,
    cq.Id as ClosedQuestionId,
    cq.CloseReasonName,
    case 
        when u.LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - interval '7 days' then 'Active'
        when u.LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - interval '30 days' then 'Recently Active'
        else 'Inactive'
    end as UserActivityStatus
from Users u
left join UserBadgeAgg uba on uba.UserId = u.Id
left join UserPostStats ups on ups.UserId = u.Id
left join UserCommentStats ucs on ucs.UserId = u.Id
left join UserActivityWindow ha on ha.UserId = u.Id and ha.CreationDate = (
    select max(CreationDate) from Posts p where p.OwnerUserId = u.Id
)
left join RecursiveTagCounts t on t.OwnerUserId = u.Id and t.rn = 1
left join UserReputationRanks ur on ur.Id = u.Id
left join UserLinkDuplicates uld on uld.PostOwner = u.Id
left join (
    select distinct OwnerUserId, Id as QuestionId, Title
    from Posts
    where PostTypeId = 1
) tq on tq.OwnerUserId = u.Id
left join (
    select distinct OwnerUserId, Id as AnswerId, Score as AnswerScore
    from Posts
    where PostTypeId = 2
) ta on ta.OwnerUserId = u.Id
left join ClosedQuestions cq on cq.Id in (
    select Id from Posts where OwnerUserId = u.Id and ClosedDate is not null
)
where u.Id in (select UserId from HighActivityUsers)
group by 
    u.Id, u.DisplayName, u.Reputation, ur.ReputationRank, uba.GoldBadges, uba.SilverBadges, uba.BronzeBadges,
    ups.QuestionCount, ups.AnswerCount, ups.TotalScore, ups.AvgScore, ups.MaxScore, ups.TotalQuestionViews,
    ucs.CommentCount, ucs.AvgCommentLength, ucs.DistinctPostsCommented,
    ha.PostsLast30Days,
    tq.QuestionId, tq.Title,
    ta.AnswerId, ta.AnswerScore,
    cq.Id, cq.CloseReasonName,
    u.LastAccessDate
order by ur.ReputationRank
limit 100;