WITH UserBadgeRank AS (
    SELECT
        UserId,
        Name,
        Class,
        ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY Class, Date DESC) AS BadgeRank
    FROM Badges
    WHERE Name LIKE '%er' -- names ending with 'er' for complexity
), RecentPostsAndStats AS (
    SELECT
        P.Id,
        P.PostTypeId,
        P.Title,
        P.OwnerUserId,
        P.CreationDate,
        P.Score,
        P.ViewCount,
        P.Tags,
        Users.Reputation,
        Users.CreationDate AS UserCreation,
        COALESCE(UBR.BadgeRank, 999) AS TopBadgeRank,
        COUNT(V.Id) FILTER (WHERE V.VoteTypeId = 2) AS UpVotes,
        COUNT(V.Id) FILTER (WHERE V.VoteTypeId = 3) AS DownVotes,
        ROW_NUMBER() OVER (PARTITION BY OwnerUserId ORDER BY P.Score DESC, P.ViewCount DESC) AS UserPostRank
    FROM Posts P
    LEFT JOIN Users ON P.OwnerUserId = Users.Id
    LEFT JOIN Votes V ON V.PostId = P.Id
