with recursive RecursiveUserHierarchy as (
    select
        u.Id,
        u.DisplayName,
        1 as Level,
        cast(null as int) as ManagerId
    from Users u
    where u.Id in (select distinct OwnerUserId from Posts where OwnerUserId is not null)
    union all
    select
        u.Id,
        u.DisplayName,
        ruh.Level + 1,
        ruh.Id as ManagerId
    from Users u
    join RecursiveUserHierarchy ruh on u.Id = ruh.ManagerId
),
TopTags as (
    select
        t.TagName,
        t.Count,
        p.Id as QuestionId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId
    from Tags t
    join Posts p on p.PostTypeId = 1 and p.Tags like '%' || t.TagName || '%'
    where t.Count > 10000
),
QuestionWithAnswers as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId as QuestionOwner,
        a.Id as AnswerId,
        a.OwnerUserId as AnswerOwner,
        a.Score as AnswerScore,
        a.CreationDate as AnswerDate,
        row_number() over (partition by q.Id order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
),
FavoriteAnswers as (
    select
        AnswerOwner,
        count(distinct AnswerId) as FavoriteAnswerCount
    from QuestionWithAnswers qwa
    join Posts p on p.Id = qwa.AnswerId
    where p.FavoriteCount > 0
    group by AnswerOwner
),
VotesSummary as (
    select
        p.OwnerUserId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes,
        sum(case when vt.Name = 'Favorite' then 1 else 0 end) as Favorites
    from Votes v
    join VoteTypes vt on vt.Id = v.VoteTypeId
    join Posts p on p.Id = v.PostId
    group by p.OwnerUserId
),
LatestPostEdits AS (
    select distinct on (ph.PostId)
        ph.PostId,
        ph.Id as HistoryId,
        ph.PostHistoryTypeId,
        ph.CreationDate as EditDate,
        ph.UserId as EditorUserId,
        ph.UserDisplayName as EditorDisplayName,
        ph.Comment,
        ph.Text
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6)
    order by ph.PostId, ph.CreationDate desc
),
QuestionDuplicates as (
    select
        pl.PostId as QuestionId,
        pl.RelatedPostId as DuplicateOf,
        count(*) over (partition by pl.PostId) as DuplicateCount
    from PostLinks pl
    where pl.LinkTypeId = 3
),
QuestionsClosedWithReason AS (
   select
       ph.PostId,
       cr.Name as CloseReasonName,
       count(*) over (partition by ph.PostId) as CloseCount
   from PostHistory ph
   join CloseReasonTypes cr on cr.Id = cast(ph.Comment as integer)
   where ph.PostHistoryTypeId = 10
),
UserBadgeRanking as (
    select
        b.UserId,
        b.Name,
        b.Class,
        rank() over (partition by b.UserId order by b.Date desc) as RecentRank,
        count(*) over (partition by b.UserId, b.Class) as BadgeClassCount
    from Badges b
),
UserActivityStats as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionCount,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswerCount,
        count(distinct c.Id) as CommentCount,
        coalesce(vs.UpVotes,0) as TotalUpVotes,
        coalesce(vs.DownVotes,0) as TotalDownVotes,
        coalesce(vs.Favorites,0) as TotalFavorites,
        coalesce(fa.FavoriteAnswerCount,0) as FavoredAnswerCount,
        sum(case when bri.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when bri.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when bri.Class = 3 then 1 else 0 end) as BronzeBadges
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join VotesSummary vs on vs.OwnerUserId = u.Id
    left join FavoriteAnswers fa on fa.AnswerOwner = u.Id
    left join UserBadgeRanking bri on bri.UserId = u.Id and bri.RecentRank = 1
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, vs.UpVotes, vs.DownVotes, vs.Favorites, fa.FavoriteAnswerCount
),
RankedUserActivity AS (
    select
        uas.Id,
        uas.DisplayName,
        uas.Reputation,
        uas.CreationDate,
        uas.QuestionCount,
        uas.AnswerCount,
        uas.CommentCount,
        uas.GoldBadges,
        uas.SilverBadges,
        uas.BronzeBadges,
        uas.TotalUpVotes,
        uas.TotalDownVotes,
        uas.TotalFavorites,
        uas.FavoredAnswerCount,
        row_number() over (order by uas.Reputation desc, uas.GoldBadges desc, uas.QuestionCount desc) as UserRank
    from UserActivityStats uas
),
FilteredTopUsers AS (
    select 
        ru.Id,
        ru.DisplayName,
        ru.Reputation,
        ru.QuestionCount,
        ru.AnswerCount,
        ru.CommentCount,
        ru.GoldBadges,
        ru.SilverBadges,
        ru.BronzeBadges,
        ru.TotalUpVotes,
        ru.TotalDownVotes,
        ru.TotalFavorites,
        ru.FavoredAnswerCount
    from RankedUserActivity ru
    where ru.UserRank <= 100
),
ComplexPostStats AS (
    select
        p.Id,
        p.Title,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        coalesce(qd.DuplicateCount, 0) as DuplicateCount,
        coalesce(qc.CloseCount, 0) as ClosedCount,
        qc.CloseReasonName,
        latest.Title as LatestTitleEdit,
        latest.Text as LatestBodyEdit,
        coa.AggregatedCommentText,
        coalesce(windowed.PlaysOverTime, 0) as PlaysOverTime
    from Posts p
    left join QuestionDuplicates qd on qd.QuestionId = p.Id
    left join QuestionsClosedWithReason qc on qc.PostId = p.Id
    left join LatestPostEdits latest on latest.PostId = p.Id
    left join (
      select
          c.PostId,
          string_agg(coalesce(c.Text,''), ' || ' order by c.CreationDate desc) as AggregatedCommentText
      from Comments c
      group by c.PostId
    ) coa on coa.PostId = p.Id
    left join (
        select
            v.PostId,
            count(*) over (partition by v.PostId order by v.CreationDate rows between 30 preceding and current row) as PlaysOverTime
        from Votes v
        where v.VoteTypeId = 2
    ) windowed on windowed.PostId = p.Id
),
AggregatedUserPostStats AS (
    select
        p.OwnerUserId,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionCount,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswerCount,
        avg(case when p.PostTypeId = 1 then p.Score end) as AvgQuestionScore,
        avg(case when p.PostTypeId = 2 then p.Score end) as AvgAnswerScore,
        sum(case when p.PostTypeId = 1 then p.ViewCount else 0 end) as TotalQuestionViews
    from Posts p
    group by p.OwnerUserId
),
FinalOutput AS (
    select
        ftu.Id as UserId,
        ftu.DisplayName as UserName,
        ftu.Reputation,
        ftu.QuestionCount,
        ftu.AnswerCount,
        ftu.CommentCount,
        ftu.GoldBadges,
        ftu.SilverBadges,
        ftu.BronzeBadges,
        aps.TotalQuestionViews,
        aps.AvgQuestionScore,
        aps.AvgAnswerScore,
        ftu.TotalUpVotes,
        ftu.TotalDownVotes,
        ftu.TotalFavorites,
        ftu.FavoredAnswerCount,
        pstats.Id as PostId,
        pstats.Title as PostTitle,
        pstats.Score as PostScore,
        pstats.ViewCount as PostViewCount,
        pstats.DuplicateCount,
        pstats.ClosedCount,
        pstats.CloseReasonName,
        substring(pstats.AggregatedCommentText from 1 for 200) as SampleComments,
        pstats.LatestTitleEdit,
        pstats.LatestBodyEdit
    from FilteredTopUsers ftu
    left join AggregatedUserPostStats aps on aps.OwnerUserId = ftu.Id
    left join Posts p on p.OwnerUserId = ftu.Id
    left join ComplexPostStats pstats on pstats.Id = p.Id
    where p.PostTypeId = 1
    order by ftu.Reputation desc, pstats.Score desc
    limit 50
)
select * from FinalOutput;