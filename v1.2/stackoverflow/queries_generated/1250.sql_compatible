with recursive RecursiveUserPosts as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Tags,
        p.AcceptedAnswerId,
        1 as Depth
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where u.Reputation > 1000

    union all

    select
        rup.UserId,
        rup.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Tags,
        p.AcceptedAnswerId,
        rup.Depth + 1
    from RecursiveUserPosts rup
    join Posts p on p.ParentId = rup.PostId
    where rup.Depth < 3
), BadgeCounts as (
    select UserId,
        sum(case when "Class" = 1 then 1 else 0 end) as GoldBadges,
        sum(case when "Class" = 2 then 1 else 0 end) as SilverBadges,
        sum(case when "Class" = 3 then 1 else 0 end) as BronzeBadges
    from Badges
    group by UserId
), LatestUserAccess as (
    select
        u.Id as UserId,
        max(u.LastAccessDate) over (partition by u.Id) as MaxAccess
    from Users u
), QuestionAnswerStats as (
    select
        p.Id as QuestionId,
        p.OwnerUserId,
        p.Title,
        p.Score,
        p.ViewCount,
        (select count(*) from Posts ans where ans.ParentId = p.Id and ans.PostTypeId = 2) as Answers,
        (select max(Score) from Posts ans where ans.ParentId = p.Id and ans.PostTypeId = 2) as MaxAnswerScore,
        (select avg(Score) from Posts ans where ans.ParentId = p.Id and ans.PostTypeId = 2) as AvgAnswerScore,
        p.Tags,
        array_to_string(array(
          select regexp_split_to_array(trim(both '<>' from p.Tags), '><')
        ),',') as TagList
    from Posts p
    where p.PostTypeId = 1
), ClosedQuestionsDaily as (
    select
        cast(ph.CreationDate as date) as CloseDate,
        count(distinct ph.PostId) as ClosedCount,
        count(distinct case when crt.Name like '%duplicate%' then ph.PostId end) as DuplicateClosures,
        count(distinct case when crt.Name like '%off-topic%' then ph.PostId end) as OffTopicClosures,
        count(distinct case when crt.Name is null then ph.PostId end) as UnknownClosures
    from PostHistory ph
    left join CloseReasonTypes crt on ph.Comment = cast(crt.Id as varchar)
    where ph.PostHistoryTypeId = 10 and ph.Comment is not null
    group by cast(ph.CreationDate as date)
    order by CloseDate desc
), UserQuestionInteractions as (
    select 
        u.Id as UserId,
        u.DisplayName,
        coalesce(qas.AnsweredCount, 0) as AnsweredQuestions,
        coalesce(qaqs.AskedCount, 0) as AskedQuestions,
        coalesce(votes.UpVotes, 0) as TotalUpVotes,
        coalesce(votes.DownVotes, 0) as TotalDownVotes
    from Users u
    left join (
        select OwnerUserId, count(*) as AnsweredCount
        from Posts
        where PostTypeId = 2
        group by OwnerUserId
    ) qas on qas.OwnerUserId = u.Id
    left join (
        select OwnerUserId, count(*) as AskedCount
        from Posts
        where PostTypeId = 1
        group by OwnerUserId
    ) qaqs on qaqs.OwnerUserId = u.Id
    left join (
        select v.UserId,
            sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
            sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes
        from Votes v
        join VoteTypes vt on vt.Id = v.VoteTypeId
        group by v.UserId
    ) votes on votes.UserId = u.Id
    where u.Reputation > 500
), RankedPosts as (
    select
        p.Id,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Tags,
        dense_rank() over (partition by p.OwnerUserId order by p.Score desc NULLS LAST) as ScoreRank,
        row_number() over (partition by p.OwnerUserId order by p.ViewCount desc NULLS LAST) as ViewRank
    from Posts p
    where p.PostTypeId in (1, 2)
), UserTopPosts as (
    select
        rp.OwnerUserId,
        count(distinct case when rp.ScoreRank <= 5 then rp.Id end) as Top5ByScore,
        count(distinct case when rp.ViewRank <= 5 then rp.Id end) as Top5ByView
    from RankedPosts rp
    group by rp.OwnerUserId
)
select 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    bc.GoldBadges,
    bc.SilverBadges,
    bc.BronzeBadges,
    up.QuestionCount,
    up.AnswerCount,
    u.LastAccessDate,
    u.Location,
    uwe.AveragePostScore,
    uwe.TotalPostViews,
    ci.ClosedDate,
    ci.ClosedCount,
    ci.DuplicateClosures,
    ui.AnsweredQuestions,
    ui.AskedQuestions,
    ui.TotalUpVotes,
    ui.TotalDownVotes,
    utp.Top5ByScore,
    utp.Top5ByView,
    coalesce(u.Location, 'Unknown') || ' - ' || u.DisplayName as UserDisplayWithLocation
from Users u
left join (
    select
        OwnerUserId,
        count(*) as QuestionCount,
        sum(case when PostTypeId = 2 then 1 else 0 end) as AnswerCount
    from Posts
    where OwnerUserId is not null
    group by OwnerUserId
) up on up.OwnerUserId = u.Id
left join BadgeCounts bc on bc.UserId = u.Id
left join (
    select
        OwnerUserId,
        avg(Score) as AveragePostScore,
        sum(ViewCount) as TotalPostViews
    from Posts
    group by OwnerUserId
) uwe on uwe.OwnerUserId = u.Id
cross join lateral (
    select cd.CloseDate as ClosedDate, cd.ClosedCount, cd.DuplicateClosures
    from ClosedQuestionsDaily cd
    order by cd.CloseDate desc
    limit 1
) ci
left join UserQuestionInteractions ui on ui.UserId = u.Id
left join UserTopPosts utp on utp.OwnerUserId = u.Id
where u.Reputation > 1500
group by
    u.Id,
    u.DisplayName,
    u.Reputation,
    bc.GoldBadges,
    bc.SilverBadges,
    bc.BronzeBadges,
    up.QuestionCount,
    up.AnswerCount,
    u.LastAccessDate,
    u.Location,
    uwe.AveragePostScore,
    uwe.TotalPostViews,
    ci.ClosedDate,
    ci.ClosedCount,
    ci.DuplicateClosures,
    ui.AnsweredQuestions,
    ui.AskedQuestions,
    ui.TotalUpVotes,
    ui.TotalDownVotes,
    utp.Top5ByScore,
    utp.Top5ByView
order by u.Reputation desc, utp.Top5ByScore desc
limit 50;