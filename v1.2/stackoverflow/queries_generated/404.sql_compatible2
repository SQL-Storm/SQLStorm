with RecursiveTagCounts as (
    select
        t.Id as TagId,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as AnswerCount,
        coalesce(p.ViewCount, 0) as ViewCount,
        row_number() over (partition by t.Id order by p.CreationDate desc) as rn
    from Tags t
    left join Posts p on p.Id = t.ExcerptPostId and p.PostTypeId = 1
    where t.IsModeratorOnly = false
),
UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        sum(case when b.TagBased = true or b.TagBased = 1 then 1 else 0 end) as TagBasedBadges,
        max(b.Date) as LastBadgeDate
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostVoteAggregates as (
    select
        p.Id as PostId,
        p.PostTypeId,
        p.OwnerUserId,
        count(case when v.VoteTypeId = 2 then 1 end) as UpVotes,
        count(case when v.VoteTypeId = 3 then 1 end) as DownVotes,
        count(case when v.VoteTypeId = 5 then 1 end) as FavoriteVotes,
        sum(case when v.VoteTypeId in (8,9) then v.BountyAmount else 0 end) as TotalBounty
    from Posts p
    left join Votes v on v.PostId = p.Id
    group by p.Id, p.PostTypeId, p.OwnerUserId
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        pva.UpVotes as QuestionUpVotes,
        pva.DownVotes as QuestionDownVotes,
        pva.FavoriteVotes as QuestionFavorites,
        count(a.Id) as AnswerCount,
        avg(case when a.PostTypeId = 2 then a.Score end) as AvgAnswerScore,
        max(case when a.PostTypeId = 2 then a.Score end) as MaxAnswerScore,
        sum(case when a.OwnerUserId is not null then 1 else 0 end) as AnsweredByRegisteredUsers,
        sum(case when a.OwnerUserId is null or a.OwnerUserId = -1 then 1 else 0 end) as AnsweredByAnonymous
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join PostVoteAggregates pva on pva.PostId = q.Id
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.CreationDate, q.Score, q.ViewCount, pva.UpVotes, pva.DownVotes, pva.FavoriteVotes
),
RankedQuestions as (
    select
        QuestionId,
        Title,
        QuestionCreation,
        QuestionScore,
        QuestionViews,
        QuestionUpVotes,
        QuestionDownVotes,
        QuestionFavorites,
        AnswerCount,
        AvgAnswerScore,
        MaxAnswerScore,
        AnsweredByRegisteredUsers,
        AnsweredByAnonymous,
        rank() over (order by QuestionScore desc, QuestionViews desc) as ScoreRank,
        dense_rank() over (partition by date_trunc('year', QuestionCreation) order by QuestionScore desc) as YearlyScoreRank
    from QuestionAnswerStats
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        u.DisplayName as LinkCreator,
        p.Title as RelatedPostTitle
    from PostLinks pl
    left join Users u on u.Id = (select OwnerUserId from Posts where Id = pl.PostId)
    left join Posts p on p.Id = pl.RelatedPostId
    where pl.LinkTypeId = 3
),
TopUsersWithBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        u.Location,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        coalesce(ubs.GoldBadges,0) as GoldBadges,
        coalesce(ubs.SilverBadges,0) as SilverBadges,
        coalesce(ubs.BronzeBadges,0) as BronzeBadges,
        coalesce(ubs.TagBasedBadges,0) as TagBasedBadges,
        coalesce(ubs.LastBadgeDate, timestamp '1970-01-01') as LastBadgeDate,
        row_number() over (order by u.Reputation desc, u.Views desc) as UserRank
    from Users u
    left join UserBadgeStats ubs on ubs.UserId = u.Id
    where u.Reputation > 1000
),
RecentPostEdits as (
    select
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ph.UserId,
        ph.UserDisplayName,
        ph.Comment,
        p.Title,
        p.PostTypeId,
        row_number() over (partition by ph.PostId order by ph.CreationDate desc) as EditRank
    from PostHistory ph
    inner join Posts p on p.Id = ph.PostId
    where ph.PostHistoryTypeId in (4,5,6,10,11,14)
),
FilteredRecentEdits as (
    select
        rpe.PostId,
        rpe.PostHistoryTypeId,
        rpe.CreationDate,
        rpe.UserId,
        rpe.UserDisplayName,
        rpe.Comment,
        rpe.Title,
        rpe.PostTypeId,
        rpe.EditRank
    from RecentPostEdits rpe
    where rpe.EditRank = 1
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(case when p.PostTypeId = 1 then 1 end) as QuestionsPosted,
        count(case when p.PostTypeId = 2 then 1 end) as AnswersPosted,
        count(c.Id) as CommentsMade,
        count(distinct ph.PostId) as PostsEdited,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotesGiven,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotesGiven,
        row_number() over (order by u.Reputation desc) as UserRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join PostHistory ph on ph.UserId = u.Id
    left join Votes v on v.UserId = u.Id
    group by u.Id, u.DisplayName
)
select
    rq.QuestionId,
    rq.Title as QuestionTitle,
    rq.QuestionCreation,
    rq.QuestionScore,
    rq.QuestionViews,
    rq.QuestionUpVotes,
    rq.QuestionDownVotes,
    rq.QuestionFavorites,
    rq.AnswerCount,
    rq.AvgAnswerScore,
    rq.MaxAnswerScore,
    rq.AnsweredByRegisteredUsers,
    rq.AnsweredByAnonymous,
    dt.RelatedPostId as DuplicateOfQuestionId,
    dt.RelatedPostTitle as DuplicateOfQuestionTitle,
    dt.LinkCreator as DuplicateLinkCreator,
    tu.DisplayName as TopUserDisplayName,
    tu.Reputation as TopUserReputation,
    tu.GoldBadges,
    tu.SilverBadges,
    tu.BronzeBadges,
    tu.TagBasedBadges,
    fe.PostHistoryTypeId as LastEditType,
    fe.CreationDate as LastEditDate,
    fe.UserDisplayName as LastEditor,
    ua.QuestionsPosted,
    ua.AnswersPosted,
    ua.CommentsMade,
    ua.PostsEdited,
    ua.UpVotesGiven,
    ua.DownVotesGiven,
    rtc.TagName,
    rtc.Count as TagUsageCount,
    rtc.AnswerCount as TagAnswerCount,
    rtc.ViewCount as TagViewCount
from RankedQuestions rq
left join DuplicateLinks dt on dt.PostId = rq.QuestionId
left join TopUsersWithBadges tu on tu.UserRank = 1
left join FilteredRecentEdits fe on fe.PostId = rq.QuestionId
left join UserActivityWindow ua on ua.UserId = ((rq.QuestionId % (select coalesce(max(Id),1) from Users)) + 1)
left join RecursiveTagCounts rtc on rtc.rn = 1
where rq.ScoreRank <= 50
order by rq.ScoreRank, fe.CreationDate desc;