WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        ARRAY[t.Id] AS Ancestors
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE AND t.IsRequired = FALSE

    UNION ALL

    SELECT
        t.Id,
        t.TagName,
        t.Count,
        r.Ancestors || t.Id
    FROM Tags t
    JOIN RecursiveTagHierarchy r ON NOT (t.Id = ANY(r.Ancestors))
    WHERE t.IsModeratorOnly = FALSE AND t.IsRequired = FALSE
      AND array_length(r.Ancestors, 1) < 3
),
UserBadgeCounts AS (
    SELECT
        b.UserId,
        b.Class,
        COUNT(*) AS BadgeCount
    FROM Badges b
    GROUP BY b.UserId, b.Class
),
UserPostStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
        COALESCE(SUM(p.Score),0) AS TotalPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount END) AS AvgQuestionViews,
        SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS QuestionsWithAcceptedAnswer
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
TopPostsWithComments AS (
    SELECT
        p.Id,
        p.Title,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        COALESCE(c.CommentCount, 0) AS CommentCount,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.ViewCount DESC) AS rn
    FROM Posts p
    LEFT JOIN (
        SELECT PostId, COUNT(*) AS CommentCount
        FROM Comments
        GROUP BY PostId
    ) c ON c.PostId = p.Id
    WHERE p.PostTypeId IN (1,2)
),
UserVoteSummary AS (
    SELECT
        v.UserId,
        vt.Name AS VoteTypeName,
        COUNT(*) AS VoteCount,
        SUM(COALESCE(v.BountyAmount,0)) AS TotalBounty
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE v.UserId IS NOT NULL
    GROUP BY v.UserId, vt.Name
),
PostCloseReasons AS (
    SELECT
        ph.PostId,
        crt.Name AS CloseReason,
        ph.CreationDate AS CloseDate
    FROM PostHistory ph
    JOIN PostHistoryTypes pht ON pht.Id = ph.PostHistoryTypeId
    JOIN CloseReasonTypes crt ON crt.Id = CAST(ph.Comment AS INTEGER)
    WHERE ph.PostHistoryTypeId = 10
),
UserActivityWindow AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        COUNT(*) OVER (
            PARTITION BY u.Id
            ORDER BY p.CreationDate
            RANGE BETWEEN INTERVAL '30 days' PRECEDING AND CURRENT ROW
        ) AS PostsInLast30Days
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
),
QuestionAnswerRatio AS (
    SELECT
        u.Id AS UserId,
        COALESCE(NULLIF(q.QuestionCount,0),1) AS QuestionCount,
        COALESCE(a.AnswerCount,0) AS AnswerCount,
        ROUND(COALESCE(a.AnswerCount,0) * 1.0 / NULLIF(q.QuestionCount,1), 2) AS AnswerToQuestionRatio
    FROM (
        SELECT OwnerUserId, COUNT(*) AS QuestionCount
        FROM Posts
        WHERE PostTypeId = 1
        GROUP BY OwnerUserId
    ) q
    FULL OUTER JOIN (
        SELECT OwnerUserId, COUNT(*) AS AnswerCount
        FROM Posts
        WHERE PostTypeId = 2
        GROUP BY OwnerUserId
    ) a ON q.OwnerUserId = a.OwnerUserId
    JOIN Users u ON u.Id = COALESCE(q.OwnerUserId, a.OwnerUserId)
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    COALESCE(ubc_gold.BadgeCount,0) AS GoldBadges,
    COALESCE(ubc_silver.BadgeCount,0) AS SilverBadges,
    COALESCE(ubc_bronze.BadgeCount,0) AS BronzeBadges,
    ups.QuestionCount,
    ups.AnswerCount,
    ups.TotalPostScore,
    ups.AvgQuestionViews,
    ups.QuestionsWithAcceptedAnswer,
    COALESCE(uvs_up.VoteCount,0) AS UpVotesCast,
    COALESCE(uvs_down.VoteCount,0) AS DownVotesCast,
    COALESCE(uvs_bounty.TotalBounty,0) AS BountyGiven,
    qar.AnswerToQuestionRatio,
    MAX(pcr.CloseDate) AS LastCloseDate,
    COUNT(DISTINCT pcr.PostId) AS ClosedPostsCount,
    MAX(u.LastAccessDate) AS LastAccess,
    MAX(u.CreationDate) AS UserCreationDate,
    MAX(u.Reputation) AS Reputation,
    MAX(u.Views) AS ProfileViews,
    MAX(u.UpVotes) AS ProfileUpVotes,
    MAX(u.DownVotes) AS ProfileDownVotes,
    MAX(u.WebsiteUrl) AS Website,
    MAX(u.Location) AS Location,
    MAX(u.AboutMe) AS AboutMeSnippet,
    MAX(u.ProfileImageUrl) AS ProfileImage,
    MAX(u.EmailHash) AS EmailHash,
    MAX(u.AccountId) AS AccountId,
    MAX(uw.PostsInLast30Days) AS PostsInLast30Days,
    STRING_AGG(DISTINCT rth.TagName, ', ') AS SampleTags
FROM Users u
LEFT JOIN UserBadgeCounts ubc_gold ON ubc_gold.UserId = u.Id AND ubc_gold.Class = 1
LEFT JOIN UserBadgeCounts ubc_silver ON ubc_silver.UserId = u.Id AND ubc_silver.Class = 2
LEFT JOIN UserBadgeCounts ubc_bronze ON ubc_bronze.UserId = u.Id AND ubc_bronze.Class = 3
LEFT JOIN UserPostStats ups ON ups.UserId = u.Id
LEFT JOIN UserVoteSummary uvs_up ON uvs_up.UserId = u.Id AND uvs_up.VoteTypeName = 'UpMod'
LEFT JOIN UserVoteSummary uvs_down ON uvs_down.UserId = u.Id AND uvs_down.VoteTypeName = 'DownMod'
LEFT JOIN UserVoteSummary uvs_bounty ON uvs_bounty.UserId = u.Id AND uvs_bounty.VoteTypeName IN ('BountyStart', 'BountyClose')
LEFT JOIN PostCloseReasons pcr ON pcr.PostId IN (
    SELECT p2.Id FROM Posts p2 WHERE p2.OwnerUserId = u.Id
)
LEFT JOIN UserActivityWindow uw ON uw.UserId = u.Id
LEFT JOIN QuestionAnswerRatio qar ON qar.UserId = u.Id
LEFT JOIN RecursiveTagHierarchy rth ON rth.Id IN (
    SELECT UNNEST(STRING_TO_ARRAY(
        REGEXP_REPLACE(
            COALESCE((
                SELECT p3.Tags FROM Posts p3 WHERE p3.OwnerUserId = u.Id AND p3.PostTypeId = 1 ORDER BY p3.CreationDate DESC LIMIT 1
            ), ''), '[<>]', '', 'g'), ' ')
    )
)
GROUP BY
    u.Id, u.DisplayName,
    ubc_gold.BadgeCount, ubc_silver.BadgeCount, ubc_bronze.BadgeCount,
    ups.QuestionCount, ups.AnswerCount, ups.TotalPostScore, ups.AvgQuestionViews, ups.QuestionsWithAcceptedAnswer,
    uvs_up.VoteCount, uvs_down.VoteCount, uvs_bounty.TotalBounty,
    qar.AnswerToQuestionRatio
HAVING
    (ups.QuestionCount > 10 OR ups.AnswerCount > 20)
    AND MAX(u.Reputation) > 1000
ORDER BY
    Reputation DESC,
    ups.TotalPostScore DESC,
    GoldBadges DESC
LIMIT 100;