WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 AS Level,
        ARRAY[t.Id] AS Path
    FROM Tags t
    WHERE t.IsModeratorOnly = false AND t.IsRequired = false

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        child.Count,
        child.ExcerptPostId,
        child.WikiPostId,
        parent.Level + 1,
        parent.Path || child.Id
    FROM Tags child
    JOIN RecursiveTagHierarchy parent ON NOT (child.Id = ANY(parent.Path))
    WHERE child.IsModeratorOnly = false AND child.IsRequired = false
      AND child.Count < parent.Count
),
UserBadgeSummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
PostAnswerStats AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        q.Score AS QuestionScore,
        COUNT(a.Id) AS TotalAnswers,
        AVG(a.Score) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore,
        SUM(CASE WHEN a.Score >= 10 THEN 1 ELSE 0 END) AS HighScoreAnswers,
        BOOL_OR(a.OwnerUserId = q.OwnerUserId) AS HasSelfAnswer
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1
    GROUP BY q.Id, q.Title, q.OwnerUserId, q.CreationDate, q.Score
),
TopActiveUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersPosted,
        COUNT(c.Id) AS CommentsMade,
        SUM(vt.VoteCount) AS TotalVotesReceived
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN (
        SELECT p.OwnerUserId, COUNT(v.Id) AS VoteCount
        FROM Posts p
        JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId IN (2,3)
        GROUP BY p.OwnerUserId
    ) vt ON vt.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(p.Id) > 10 OR COUNT(c.Id) > 20
),
LatestPostEdits AS (
    SELECT
        ph.PostId,
        ph.UserId AS EditorUserId,
        ph.UserDisplayName AS EditorName,
        ph.CreationDate AS EditDate,
        ph.PostHistoryTypeId,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4,5,6,7,8,9)
),
DuplicateLinks AS (
    SELECT
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        p1.Title AS PostTitle,
        p2.Title AS RelatedPostTitle
    FROM PostLinks pl
    JOIN Posts p1 ON p1.Id = pl.PostId
    JOIN Posts p2 ON p2.Id = pl.RelatedPostId
    WHERE pl.LinkTypeId = 3
),
QuestionTagAggregates AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        STRING_AGG(DISTINCT t.TagName, ', ') AS Tags,
        COUNT(DISTINCT t.Id) AS TagCount,
        MAX(t.Count) AS MaxTagCount,
        MIN(t.Count) AS MinTagCount,
        AVG(t.Count) AS AvgTagCount
    FROM Posts p
    LEFT JOIN Tags t ON POSITION('<' || t.TagName || '>' IN p.Tags) > 0
    WHERE p.PostTypeId = 1
    GROUP BY p.Id, p.Title
)
SELECT 
    ta.DisplayName AS UserName,
    ta.Reputation,
    ta.QuestionsPosted,
    ta.AnswersPosted,
    ta.CommentsMade,
    ta.TotalVotesReceived,
    pas.QuestionId,
    pas.Title AS QuestionTitle,
    pas.TotalAnswers,
    pas.AvgAnswerScore,
    pas.MaxAnswerScore,
    pas.HighScoreAnswers,
    pas.HasSelfAnswer,
    qta.Tags,
    qta.TagCount,
    qta.MaxTagCount,
    qta.MinTagCount,
    qta.AvgTagCount,
    le.EditorName AS LastEditor,
    le.EditDate AS LastEditDate,
    dl.RelatedPostTitle AS DuplicateOf,
    rth.Level AS TagHierarchyLevel,
    rth.Path AS TagHierarchyPath
FROM TopActiveUsers ta
LEFT JOIN PostAnswerStats pas ON pas.OwnerUserId = ta.Id
LEFT JOIN QuestionTagAggregates qta ON qta.QuestionId = pas.QuestionId
LEFT JOIN LatestPostEdits le ON le.PostId = pas.QuestionId AND le.rn = 1
LEFT JOIN DuplicateLinks dl ON dl.PostId = pas.QuestionId
LEFT JOIN RecursiveTagHierarchy rth ON POSITION('<' || rth.TagName || '>' IN COALESCE(qta.Tags, '')) > 0
WHERE (ta.Reputation > 1000 OR pas.TotalAnswers > 5)
  AND (pas.HasSelfAnswer = true OR pas.MaxAnswerScore > 15)
GROUP BY
    ta.DisplayName,
    ta.Reputation,
    ta.QuestionsPosted,
    ta.AnswersPosted,
    ta.CommentsMade,
    ta.TotalVotesReceived,
    pas.QuestionId,
    pas.Title,
    pas.TotalAnswers,
    pas.AvgAnswerScore,
    pas.MaxAnswerScore,
    pas.HighScoreAnswers,
    pas.HasSelfAnswer,
    qta.Tags,
    qta.TagCount,
    qta.MaxTagCount,
    qta.MinTagCount,
    qta.AvgTagCount,
    le.EditorName,
    le.EditDate,
    dl.RelatedPostTitle,
    rth.Level,
    rth.Path
ORDER BY ta.Reputation DESC, pas.TotalAnswers DESC, le.EditDate DESC
LIMIT 100;