-- {"query": "1476.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.4, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1276} 
with RecursiveUserPosts as (
  select 
    u.Id as UserId,
    u.DisplayName,
    p.Id as PostId,
    p.PostTypeId,
    p.CreationDate,
    coalesce(p.Score,0) as Score,
    row_number() over (partition by u.Id order by p.CreationDate desc) as rn
  from Users u
  left join Posts p on p.OwnerUserId = u.Id
  where p.PostTypeId in (1,2)
),
TopPosts as (
  select UserId, PostId, PostTypeId, CreationDate, Score
  from RecursiveUserPosts
  where rn <= 3
),
CTE_PostComments as (
  select 
    c.PostId,
    count(*) filter (where c.Score >= 5) as HighScoreComments,
    count(*) filter (where c.Text ilike '%thanks%' or c.Text ilike '%thank you%') as ThankfulComments,
    sum(case when c.UserId is null then 1 else 0 end) as AnonymousComments
  from Comments c
  group by c.PostId
),
CTE_VotesDetail as (
  select 
    v.PostId,
    sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
    sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes,
    sum(case when vt.Name = 'Favorite' then 1 else 0 end) as Favorites,
    coalesce(max(v.BountyAmount),0) as MaxBounty
  from Votes v
  join VoteTypes vt on vt.Id = v.VoteTypeId
  group by v.PostId
),
PostTitleHistory as (
  select
    ph.PostId,
    string_agg(distinct ph.Text, ' || ') filter (where ph.PostHistoryTypeId in (1,4,7)) as TitleVersions
  from PostHistory ph
  group by ph.PostId
),
DuplicateLinkedPosts as (
  select
    p.Id as PostId,
    count(pl.Id) filter (where lt.Name = 'Duplicate') as DuplicateCount,
    string_agg(distinct t.TagName, ',') as Tags
  from Posts p
  left join PostLinks pl on pl.PostId = p.Id
  left join LinkTypes lt on lt.Id = pl.LinkTypeId
  left join lateral (
    select unnest(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) as TagName
  ) t on true
  group by p.Id
),
WindowScores as (
  select
    p.Id,
    p.OwnerUserId,
    p.Title,
    p.Score,
    dense_rank() over (partition by p.OwnerUserId order by p.Score desc nulls last) as ScoreRank,
    avg(p.Score) over (partition by p.OwnerUserId) as AvgUserScore,
    first_value(p.CreationDate) over (partition by p.OwnerUserId order by p.CreationDate asc) as FirstPostDate,
    max(b.Class) over (partition by p.OwnerUserId) as MaxBadgeClass
  from Posts p
  left join Badges b on b.UserId = p.OwnerUserId
  where p.PostTypeId = 1
)
select 
  u.Id as UserId,
  u.DisplayName,
  u.Reputation,
  wp.PostId,
  coalesce(wp.Title, '(No Title)') as PostTitle,
  wp.Score,
  ws.AvgUserScore,
  ws.ScoreRank,
  ws.FirstPostDate,
  case when ws.MaxBadgeClass = 1 then 'Gold'
       when ws.MaxBadgeClass = 2 then 'Silver'
       when ws.MaxBadgeClass = 3 then 'Bronze'
       else 'None' end as TopBadgeClass,
  tc.HighScoreComments,
  tc.ThankfulComments,
  tc.AnonymousComments,
  vd.UpVotes,
  vd.DownVotes,
  vd.Favorites,
  vd.MaxBounty,
  phh.TitleVersions,
  dlp.DuplicateCount,
  dlp.Tags as TagsString,
  -- energy metric combining score and bounty inversely by age in days (except for very recent posts)
  (coalesce(wp.Score,0) + vd.MaxBounty) / nullif(msg.total_days,30) as EnergyScore
from Users u
join TopPosts wp on wp.UserId = u.Id
left join WindowScores ws on ws.Id = wp.PostId
left join CTE_PostComments tc on tc.PostId = wp.PostId
left join CTE_VotesDetail vd on vd.PostId = wp.PostId
left join PostTitleHistory phh on phh.PostId = wp.PostId
left join DuplicateLinkedPosts dlp on dlp.PostId = wp.PostId
cross join lateral (
  select greatest(1, extract(day from cast('2024-10-01 12:34:56' as timestamp) - wp.CreationDate)::int) as total_days
) msg
where u.Reputation > 1000
and (ws.ScoreRank <= 3 or ws.AvgUserScore > 5)
order by u.Reputation desc, EnergyScore desc
union 
select 
  u.Id as UserId,
  u.DisplayName,
  u.Reputation,
  null as PostId,
  null as PostTitle,
  null as Score,
  null as AvgUserScore,
  null as ScoreRank,
  null as FirstPostDate,
  null as TopBadgeClass,
  null as HighScoreComments,
  null as ThankfulComments,
  null as AnonymousComments,
  null as UpVotes,
  null as DownVotes,
  null as Favorites,
  null as MaxBounty,
  null as TitleVersions,
  null as DuplicateCount,
  null as TagsString,
  null as EnergyScore
from Users u
where u.Reputation > 1000
and not exists (
  select 1 from Posts p where p.OwnerUserId = u.Id and p.PostTypeId in (1,2)
)
order by UserId
limit 50;