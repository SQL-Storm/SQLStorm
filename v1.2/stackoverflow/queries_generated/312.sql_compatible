with RecursiveTagCounts as (
    select
        t.Id,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as TotalAnswers,
        coalesce(p.ViewCount, 0) as TotalViews,
        row_number() over (partition by t.Id order by p.CreationDate desc nulls last) as rn
    from Tags t
    left join Posts p on p.PostTypeId = 1 and p.Tags like concat('%<', t.TagName, '>%')
),
UserBadgeSummary as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        sum(case when b.TagBased = true or b.TagBased = 1 then 1 else 0 end) as TagBasedBadges,
        max(b.Date) as LastBadgeDate
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostActivityWindow as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        count(c.Id) over (partition by p.Id) as CommentCount,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as UserPostRank,
        lag(p.Score) over (partition by p.OwnerUserId order by p.CreationDate) as PrevScore,
        lead(p.Score) over (partition by p.OwnerUserId order by p.CreationDate) as NextScore
    from Posts p
    left join Comments c on c.PostId = p.Id
    where p.PostTypeId in (1,2)
),
PostLinkDuplicates as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        lt.Name as LinkTypeName,
        p1.Title as PostTitle,
        p2.Title as RelatedPostTitle
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where lt.Name = 'Duplicate'
),
CorrelatedCloseVotes as (
    select
        p.Id as PostId,
        p.Title,
        p.CreationDate,
        (select count(*) from PostHistory ph where ph.PostId = p.Id and ph.PostHistoryTypeId = 10) as CloseVoteCount,
        (select max(ph.CreationDate) from PostHistory ph where ph.PostId = p.Id and ph.PostHistoryTypeId = 10) as LastCloseVoteDate
    from Posts p
    where p.PostTypeId = 1
),
CombinedResults as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        coalesce(ubs.GoldBadges,0) as GoldBadges,
        coalesce(ubs.SilverBadges,0) as SilverBadges,
        coalesce(ubs.BronzeBadges,0) as BronzeBadges,
        coalesce(ubs.TagBasedBadges,0) as TagBasedBadges,
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.CommentCount,
        p.UserPostRank,
        p.PrevScore,
        p.NextScore,
        ccv.CloseVoteCount,
        ccv.LastCloseVoteDate,
        pld.RelatedPostId,
        pld.RelatedPostTitle,
        pld.LinkTypeName
    from Users u
    left join UserBadgeSummary ubs on ubs.UserId = u.Id
    left join PostActivityWindow p on p.OwnerUserId = u.Id and p.UserPostRank = 1
    left join CorrelatedCloseVotes ccv on ccv.PostId = p.Id
    left join PostLinkDuplicates pld on pld.PostId = p.Id
    where u.Reputation > 1000
)
select
    cr.UserId,
    cr.DisplayName,
    cr.Reputation,
    cr.GoldBadges,
    cr.SilverBadges,
    cr.BronzeBadges,
    cr.TagBasedBadges,
    cr.PostId,
    cr.Title,
    cr.Score,
    cr.ViewCount,
    cr.CommentCount,
    cr.UserPostRank,
    cr.PrevScore,
    cr.NextScore,
    cr.CloseVoteCount,
    cr.LastCloseVoteDate,
    cr.RelatedPostId,
    cr.RelatedPostTitle,
    cr.LinkTypeName,
    case
        when cr.Score is null then 'No Score'
        when cr.Score > 100 then 'High Score'
        when cr.Score between 50 and 100 then 'Medium Score'
        else 'Low Score'
    end as ScoreCategory,
    case
        when cr.CloseVoteCount > 0 then 'Has Close Votes'
        else 'No Close Votes'
    end as CloseVoteStatus,
    concat_ws(' | ',
        coalesce(cr.Title, 'No Title'),
        coalesce(cr.RelatedPostTitle, 'No Related Post'),
        coalesce(cr.LinkTypeName, 'No Link')
    ) as CombinedTitleInfo
from CombinedResults cr
where cr.PostId is not null
order by cr.Reputation desc, cr.Score desc
limit 100;