with UserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct case when b.Class = 1 then b.Id end) as GoldBadges,
        count(distinct case when b.Class = 2 then b.Id end) as SilverBadges,
        count(distinct case when b.Class = 3 then b.Id end) as BronzeBadges,
        count(distinct b.Id) as TotalBadges,
        sum(case when b.TagBased = true or b.TagBased = 1 then 1 else 0 end) as TagBasedBadges
    from Users u
    left join Badges b on u.Id = b.UserId
    group by u.Id, u.DisplayName
),
PostStats as (
    select
        p.OwnerUserId as UserId,
        count(case when p.PostTypeId = 1 then p.Id end) as QuestionCount,
        count(case when p.PostTypeId = 2 then p.Id end) as AnswerCount,
        avg(nullif(p.Score,0)) as AvgScoreNonZero,
        max(p.ViewCount) as MaxViews,
        sum(coalesce(p.FavoriteCount,0)) as TotalFavorites,
        count(case when p.AcceptedAnswerId is not null then 1 end) as AcceptedAnswersCount,
        bool_or(p.ClosedDate is not null) as HasClosedPosts
    from Posts p
    where p.OwnerUserId is not null and p.OwnerUserId > 0
    group by p.OwnerUserId
),
UserActivity as (
    select 
        u.Id as UserId,
        row_number() over (partition by cast(u.CreationDate as date) order by u.Reputation desc) as DailyRankByRep,
        dense_rank() over (order by u.LastAccessDate desc) as LastAccessRank,
        coalesce(v.UpVotes,0) as UpVotesCast,
        coalesce(v.DownVotes,0) as DownVotesCast,
        case 
            when u.Location is null or length(trim(u.Location)) = 0 then 'Unknown'
            else trim(u.Location)
        end as LocationClean,
        length(coalesce(u.AboutMe, '')) as AboutMeLength,
        case 
            when u.WebsiteUrl ~* '(https?://)?([a-z0-9-]+\.)+[a-z]{2,}' then 'Valid URL'
            when u.WebsiteUrl is null then 'No URL'
            else 'Invalid URL'
        end as WebsiteUrlStatus
    from Users u
    left join (
        select v.UserId, 
               sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
               sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes
        from Votes v
        join VoteTypes vt on v.VoteTypeId = vt.Id
        where v.UserId is not null
        group by v.UserId
    ) v on u.Id = v.UserId
),
TagUseWindow as (
    select 
        p.Id as PostId,
        unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><')) as TagName,
        p.CreationDate,
        p.Score,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as RecentPostRankByUser
    from Posts p
    where p.PostTypeId = 1 and p.Tags is not null
),
UserTagStats as (
    select
        u.Id as UserId,
        tag.TagName,
        count(*) as TagUsageCount,
        max(tag.Score) as MaxTagScore,
        avg(tag.Score) as AvgTagScore,
        max(tag.RecentPostRankByUser) as MaxRecentRank
    from Users u
    left join TagUseWindow tag on u.Id = tag.PostId
    group by u.Id, tag.TagName
),
RecentClosedQuestions as (
    select p.Id, p.OwnerUserId, p.Title, p.CreationDate, p.ClosedDate,
        (select cht.Name from PostHistory ph join CloseReasonTypes cht on cast(ph.Comment as integer) = cht.Id where ph.PostId = p.Id and ph.PostHistoryTypeId = 10 order by ph.CreationDate desc limit 1) as LatestCloseReason,
        (select count(1) from PostLinks pl where pl.PostId = p.Id and pl.LinkTypeId = 3) as DuplicateCount
    from Posts p
    where p.PostTypeId = 1 and p.ClosedDate is not null 
),
CombinedUserProfiles as (
    select
        u.Id,
        u.DisplayName,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.TotalBadges,
        ub.TagBasedBadges,
        coalesce(ps.QuestionCount, 0) as QuestionCount,
        coalesce(ps.AnswerCount, 0) as AnswerCount,
        coalesce(ps.AvgScoreNonZero, 0) as AvgScore,
        coalesce(ps.MaxViews, 0) as MaxViews,
        coalesce(ps.TotalFavorites, 0) as TotalFavorites,
        coalesce(ps.AcceptedAnswersCount, 0) as AcceptedAnswers,
        ua.DailyRankByRep,
        ua.LastAccessRank,
        ua.UpVotesCast,
        ua.DownVotesCast,
        ua.LocationClean,
        ua.AboutMeLength,
        ua.WebsiteUrlStatus
    from Users u
    left join UserBadges ub on u.Id = ub.UserId
    left join PostStats ps on u.Id = ps.UserId
    left join UserActivity ua on u.Id = ua.UserId
),
HighImpactUsers as (
    select c.UserId
    from PostStats c
    where c.QuestionCount >= 10 and c.AnswerCount >= 30 and c.AcceptedAnswersCount >= 20 and c.AvgScoreNonZero > 5 and c.HasClosedPosts = false
)
select
    cup.Id as UserId,
    cup.DisplayName,
    cup.GoldBadges,
    cup.SilverBadges,
    cup.BronzeBadges,
    cup.TotalBadges,
    cup.TagBasedBadges,
    cup.QuestionCount,
    cup.AnswerCount,
    cup.AvgScore,
    cup.MaxViews,
    cup.TotalFavorites,
    cup.AcceptedAnswers,
    cup.DailyRankByRep,
    cup.LastAccessRank,
    cup.UpVotesCast,
    cup.DownVotesCast,
    cup.LocationClean,
    cup.AboutMeLength,
    cup.WebsiteUrlStatus,
    coalesce((
        select string_agg(distinct rs.LatestCloseReason || ' (' || cast(rs.DuplicateCount as varchar) || ' duplicates)', ', ')
        from RecentClosedQuestions rs
        where rs.OwnerUserId = cup.Id
        and rs.ClosedDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
    ), 'No recent closures') as RecentCloseReasonsSummary,
    exists(select 1 from HighImpactUsers h where h.UserId = cup.Id) as IsHighImpactUser
from CombinedUserProfiles cup
where cup.QuestionCount > 0
order by IsHighImpactUser desc, cup.GoldBadges desc, cup.AvgScore desc
limit 100;