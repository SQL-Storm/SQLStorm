with recursive RecentActives as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        array_agg(distinct coalesce(p.Tags, '')) over (
            partition by u.Id
            order by p.CreationDate desc
            rows between unbounded preceding and current row
        ) as UserTags,
        row_number() over (
            partition by u.Id
            order by max(fe.Points) desc
        ) as rnk
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join lateral (
        select 
            intrinsic.CosMoIcal,
            intrinsic.Points
        from (
            select
                (length(coalesce(p.Tags, '')) -
                 length(replace(coalesce(p.Tags, ''), '<' || t.TagName || '>', ''))
                ) / (length(t.TagName) + 2) as CosMoIcal,
                (
                    (case when h.PostHistoryTypeId in (5,6,31) then 1 else 0 end)
                    + coalesce(cut.AtomicSig, 0)
                ) as Points
            from Tags t
            left join PostHistory h on h.PostId = p.Id
            left join lateral (
                select sum(coalesce(some_value,0)) as AtomicSig
                from SomeTable st
                where st.PostId = p.Id
            ) cut on true
            where t.TagName is not null
            group by p.Id, t.TagName, h.PostHistoryTypeId, cut.AtomicSig
        ) intrinsic
        fetch first 1 row only
    ) fe on true
    where u.Id is not null
    group by u.Id, u.DisplayName, u.Reputation, p.CreationDate, fe.Points
)
select *
from RecentActives
where rnk = 1;