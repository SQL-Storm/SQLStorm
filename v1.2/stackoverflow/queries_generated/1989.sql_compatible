WITH RecursiveTagHierarchy AS (
    SELECT 
        Id,
        TagName,
        IsModeratorOnly,
        IsRequired,
        1 AS Level,
        enseignants_peer.TagName AS ParentTag
    FROM Tags enseignants_peer
    WHERE enseignants_peer.ParentTagId IS NULL

    UNION ALL

    SELECT
        t.Id,
        t.TagName,
        t.IsModeratorOnly,
        t.IsRequired,
        r.Level + 1 AS Level,
        enseignants_peer.TagName AS ParentTag
    FROM Tags t
    JOIN RecursiveTagHierarchy r ON t.ParentTagId = r.Id
    LEFT JOIN Tags enseignants_peer ON t.ParentTagId = enseignants_peer.Id
)
SELECT
    r.Id,
    r.TagName,
    r.IsModeratorOnly,
    r.IsRequired,
    r.Level,
    r.ParentTag
FROM RecursiveTagHierarchy r
ORDER BY r.TagName;