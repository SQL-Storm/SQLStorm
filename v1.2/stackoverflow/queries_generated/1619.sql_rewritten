with RecursiveTagHierarchy as (
    select t.Id, t.TagName, null::int as ParentTagId 
    from Tags t 
    where t.Id in (
        select post_tags.TagId from
          (select distinct unnest(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) as TagName from Posts p where p.PostTypeId = 1) pt
        join Tags post_tags on post_tags.TagName = pt.TagName
    )
    union all
    select c.Id, c.TagName, p.Id as ParentTagId
    from Tags c
    join RecursiveTagHierarchy p on p.Id != c.Id and c.IsRequired = 1 -- assume hierarchical/fictitious condition
    where length(c.TagName) > 0
)
, User_post_summary as (
    select
        u.Id as UserId,
        count(distinct p.Id) as TotalPosts,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionCount,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswerCount,
        max(case when p.PostTypeId = 1 then p.CreationDate else null end) as MostRecentQuestionDate,
        max(case when p.PostTypeId = 2 then p.CreationPostDate else null end) as MostRecentAnswerDate,
        sum(p.Score) as TotalScore,
        avg(p.Score) as AverageScore
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    group by u.Id
), User_badge_details as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount,
        string_agg(distinct b.Name || ' (' || to_char(b.Date,'YYYY-MM-DD') || ')', '; ' order by b.Date desc) as BadgeHistory
    from Badges b
    group by b.UserId, b.Class
)
, Question_with_accepts as (
    select 
      q.Id as QuestionId,
      q.Title,
      q.OwnerUserId,
      q.ViewCount,
      q.Score,
      q.CreationDate,
      q.Tags,
      q.AcceptedAnswerId,
      a.Score as AcceptedAnswerScore,
      a.OwnerUserId as AcceptedAnswerUserId,
      extract(epoch from cast('2024-10-01 12:34:56' as timestamp) - coalesce(q.ClosedDate, to_timestamp(0))) / 86400 as DaysUntilClosed,
      (select count(1) from Comments cm where cm.PostId = q.Id and cm.CreationDate > (cast('2024-10-01 12:34:56' as timestamp) - interval '30 days')) as CommentCount30Days,
      LAG(q.Score) OVER (ORDER BY q.CreationDate) as PrevQuestionScore,
      LEAD(q.ViewCount) OVER (ORDER BY q.CreationDate) as NextQuestionViewCount 
    from Posts q
    left join Posts a on a.Id = q.AcceptedAnswerId
    where q.PostTypeId = 1
    and q.AcceptedAnswerId is not null
)
