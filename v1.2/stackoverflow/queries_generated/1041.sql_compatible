with RecursiveUserPostCounts as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        coalesce(sum(case when v.VoteTypeId = 2 then 1 else 0 end), 0) as UpVotes,
        coalesce(sum(case when v.VoteTypeId = 3 then 1 else 0 end), 0) as DownVotes
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.PostId = p.Id
    group by u.Id, u.DisplayName
),
BadgeAggregates as (
    select 
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        count(distinct b.Name) as DistinctBadgeNames
    from Badges b
    group by b.UserId
),
PostDetails as (
    select
        p.Id,
        p.PostTypeId,
        pt.Name as PostTypeName,
        p.ParentId,
        p.AcceptedAnswerId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        regexp_replace(trim(both '<>' from p.Tags), '><', ',') as NormalizedTags,
        row_number() over (partition by p.OwnerUserId order by p.Score desc) as RankByScore
    from Posts p
    left join PostTypes pt on pt.Id = p.PostTypeId
    where p.PostTypeId in (1, 2)
),
TagUsage as (
    select 
        regexp_split_to_table(regexp_replace(trim(both '<>' from p.Tags), '><', ','), ',') as Tag,
        count(*) as PostsWithTag
    from Posts p
    where p.Tags is not null and p.PostTypeId = 1
    group by regexp_split_to_table(regexp_replace(trim(both '<>' from p.Tags), '><', ','), ',')
),
TopTags as (
    select Tag, PostsWithTag
    from TagUsage
    order by PostsWithTag desc
    limit 10
),
AnswerRanks as (
    select
        a.Id,
        a.ParentId as QuestionId,
        a.OwnerUserId as AnswererId,
        a.Score,
        rank() over (partition by a.ParentId order by a.Score desc, a.CreationDate asc) as ScoreRank
    from Posts a
    where a.PostTypeId = 2
),
AcceptedAnswerScore as (
    select
        q.Id as QuestionId,
        coalesce(a.Score, 0) as AcceptedAnswerScore
    from Posts q
    left join Posts a on a.Id = q.AcceptedAnswerId
    where q.PostTypeId = 1
),
QuestionCloseSummary as (
    select
        ph.PostId,
        max(case when ph.PostHistoryTypeId = 10 then ph.Comment else null end) as CloseReasonId,
        count(case when ph.PostHistoryTypeId = 10 then 1 else null end) as CloseVotesCount,
        max(ph.CreationDate) filter (where ph.PostHistoryTypeId = 10) as LastCloseDate
    from PostHistory ph
    where ph.PostHistoryTypeId in (10)
    group by ph.PostId
)
select 
    r.UserId,
    r.DisplayName,
    r.QuestionCount,
    r.AnswerCount,
    r.UpVotes,
    r.DownVotes,
    b.GoldBadges,
    b.SilverBadges,
    b.BronzeBadges,
    b.DistinctBadgeNames,
    pd.Id as TopPostId,
    pd.PostTypeName as TopPostType,
    pd.Score as TopPostScore,
    pd.ViewCount as TopPostViews,
    pd.Title as TopPostTitle,
    coalesce(aas.AcceptedAnswerScore, 0) as AcceptedAnswerScore,
    qc.CloseVotesCount,
    qc.CloseReasonId,
    qc.LastCloseDate,
    tt.Tag as PopularTag,
    tt.PostsWithTag
from RecursiveUserPostCounts r
left join BadgeAggregates b on b.UserId = r.UserId
left join PostDetails pd on pd.OwnerUserId = r.UserId and pd.RankByScore = 1
left join AcceptedAnswerScore aas on aas.QuestionId = pd.Id and pd.PostTypeId = 1
left join QuestionCloseSummary qc on qc.PostId = pd.Id
cross join lateral (
    select Tag, PostsWithTag from TopTags tt limit 1
) tt
where r.QuestionCount > 0 or r.AnswerCount > 0
order by r.UpVotes desc, r.UpVotes desc
limit 50;