WITH Recursive_TagBreadth AS (
  SELECT
    t.Id AS TagId,
    t.TagName,
    p.Id AS PostId,
    1 AS Depth
  FROM Tags t
  JOIN Posts p ON p.Tags ILIKE '%' || '<' || t.TagName || '>' || '%'
  WHERE LENGTH(t.TagName) <= 5 AND t.IsModeratorOnly = false

  UNION ALL

  SELECT
    tb.TagId,
    tb.TagName,
    p.Id AS PostId,
    tb.Depth + 1
  FROM Recursive_TagBreadth tb
  JOIN Tags t2 ON t2.Id <> tb.TagId
  JOIN PostLinks lpLink ON lpLink.PostId = tb.PostId AND lpLink.LinkTypeId = 1
  JOIN Posts p ON p.Id = lpLink.RelatedPostId
    AND p.Tags ~* ('<' || t2.TagName || '>')
  WHERE tb.Depth < 3
)
,
UserPostVoteAnchors AS (
  SELECT
      u.Id AS UserId,
      u.DisplayName,
      p.Id AS QuestionId,
      a.Id AS AnswerId,
      v_up.Counts AS UpVotesOnAnswer,
      v_down.Counts AS DownVotesOnAnswer,
      CAST(RANK() OVER (PARTITION BY u.Id ORDER BY MAX(p.CreationDate) DESC) AS INTEGER) AS UserRecentPostRank,
      ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.Score DESC) AS UserHighestScorePostNum
  FROM 
      Users u
  LEFT JOIN Posts p ON p.PostTypeId = 1 AND p.OwnerUserId = u.Id
  LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
  LEFT JOIN (
    SELECT PostId, COUNT(*) AS Counts FROM Votes WHERE VoteTypeId = 2 GROUP BY PostId
  ) v_up ON v_up.PostId = a.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) AS Counts FROM Votes WHERE VoteTypeId = 3 GROUP BY PostId
  ) v_down ON v_down.PostId = a.Id
  WHERE u.Reputation > 1000
  GROUP BY
    u.Id,
    u.DisplayName,
    p.Id,
    a.Id,
    v_up.Counts,
    v_down.Counts,
    p.Score
)
,
FamUserBadgeConsiderations AS (
  SELECT
    b.UserId,
    MAX(CASE WHEN b.Name ILIKE '%gold%' THEN b.Class ELSE NULL END) AS MaxGoldBadge,
    COUNT(DISTINCT b.Id) AS TotalBadges,
    COUNT(*) FILTER (WHERE b.TagBased = 1) AS TagBasedBadges,
    BOOL_AND(b.Date <= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '365 days')) AS AllOverOneYearAgo
  FROM Badges b
  GROUP BY b.UserId
)
,
CX_DefaultRequestStats AS (
  SELECT CAST(NULL AS INTEGER) AS Id
)
SELECT
  rt.TagId,
  rt.TagName,
  rt.PostId,
  rt.Depth,
  upva.UserId,
  upva.DisplayName,
  upva.QuestionId,
  upva.AnswerId,
  upva.UpVotesOnAnswer,
  upva.DownVotesOnAnswer,
  upva.UserRecentPostRank,
  upva.UserHighestScorePostNum,
  fub.UserId AS BadgeUserId,
  fub.MaxGoldBadge,
  fub.TotalBadges,
  fub.TagBasedBadges,
  fub.AllOverOneYearAgo,
  cds.Id AS CX_Id
FROM Recursive_TagBreadth rt
LEFT JOIN UserPostVoteAnchors upva ON upva.UserId IS NOT NULL
LEFT JOIN FamUserBadgeConsiderations fub ON fub.UserId = upva.UserId
LEFT JOIN CX_DefaultRequestStats cds ON cds.Id IS NOT NULL
GROUP BY
  rt.TagId,
  rt.TagName,
  rt.PostId,
  rt.Depth,
  upva.UserId,
  upva.DisplayName,
  upva.QuestionId,
  upva.AnswerId,
  upva.UpVotesOnAnswer,
  upva.DownVotesOnAnswer,
  upva.UserRecentPostRank,
  upva.UserHighestScorePostNum,
  fub.UserId,
  fub.MaxGoldBadge,
  fub.TotalBadges,
  fub.TagBasedBadges,
  fub.AllOverOneYearAgo,
  cds.Id;