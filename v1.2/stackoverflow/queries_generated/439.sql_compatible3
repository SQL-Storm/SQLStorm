with RecursiveUserActivity as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(distinct b.Id) as BadgeCount,
        row_number() over (partition by u.Location order by u.Reputation desc, u.Views desc) as LocationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Badges b on b.UserId = u.Id
    where u.Location is not null
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Location, u.Views, u.UpVotes, u.DownVotes
),
TopUsers as (
    select * from RecursiveUserActivity
    where LocationRank <= 5
),
PostScores as (
    select 
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        coalesce(a.AnswerCount, 0) as AnswerCount,
        coalesce(c.CommentCount, 0) as CommentCount,
        case when p.AcceptedAnswerId is not null then 1 else 0 end as HasAcceptedAnswer,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc) as UserPostRank
    from Posts p
    left join (
        select ParentId, count(*) as AnswerCount
        from Posts
        where PostTypeId = 2
        group by ParentId
    ) a on a.ParentId = p.Id
    left join (
        select PostId, count(*) as CommentCount
        from Comments
        group by PostId
    ) c on c.PostId = p.Id
    where p.PostTypeId in (1, 2)
),
FilteredPosts as (
    select * from PostScores
    where UserPostRank <= 3
),
PostTagExplode as (
    select 
        fp.Id as PostId,
        unnest(string_to_array(substring(fp.Tags from 2 for length(fp.Tags) - 2), '><')) as Tag,
        fp.Score,
        fp.ViewCount,
        fp.OwnerUserId,
        fp.CreationDate,
        fp.PostTypeId,
        fp.Title,
        fp.AnswerCount,
        fp.CommentCount,
        fp.HasAcceptedAnswer
    from FilteredPosts fp
    where fp.Tags is not null
),
TagAggregates as (
    select 
        Tag,
        count(distinct PostId) as PostsWithTag,
        avg(Score) as AvgScore,
        sum(ViewCount) as TotalViews,
        max(Score) as MaxScore,
        min(Score) as MinScore
    from PostTagExplode
    group by Tag
),
UserBadgeSummary as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(b.Id) filter (where b.Class = 1) as GoldBadges,
        count(b.Id) filter (where b.Class = 2) as SilverBadges,
        count(b.Id) filter (where b.Class = 3) as BronzeBadges,
        bool_or((b.TagBased IS NOT NULL AND b.TagBased <> false)) as HasTagBasedBadge
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
UserPostLinkSummary as (
    select 
        p.OwnerUserId as UserId,
        count(pl.Id) filter (where lt.Name = 'Duplicate') as DuplicateLinks,
        count(pl.Id) filter (where lt.Name = 'Linked') as LinkedPosts
    from Posts p
    left join PostLinks pl on pl.PostId = p.Id
    left join LinkTypes lt on lt.Id = pl.LinkTypeId
    group by p.OwnerUserId
),
UserActivitySummary as (
    select 
        t.UserId,
        t.DisplayName,
        t.Reputation,
        t.Location,
        t.Views,
        t.UpVotes,
        t.DownVotes,
        t.QuestionCount,
        t.AnswerCount,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.HasTagBasedBadge,
        upl.DuplicateLinks,
        upl.LinkedPosts
    from TopUsers t
    left join UserBadgeSummary ub on ub.UserId = t.UserId
    left join UserPostLinkSummary upl on upl.UserId = t.UserId
),
PostCloseReasonCounts as (
    select 
        ph.PostId,
        crt.Name as CloseReason,
        count(*) as CloseCount
    from PostHistory ph
    join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId and pht.Name = 'Post Closed'
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    group by ph.PostId, crt.Name
),
RecentActivePosts as (
    select 
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.PostTypeId,
        p.AcceptedAnswerId,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.ClosedDate,
        p.LastActivityDate,
        p.Body,
        row_number() over (partition by p.OwnerUserId order by p.LastActivityDate desc) as RecentPostRank
    from Posts p
    where p.LastActivityDate > (timestamp '2024-10-01 12:34:56' - interval '30 days')
),
UserRecentPostStats as (
    select 
        rap.OwnerUserId as UserId,
        count(*) as RecentPostCount,
        sum(case when rap.PostTypeId = 1 then 1 else 0 end) as RecentQuestions,
        sum(case when rap.PostTypeId = 2 then 1 else 0 end) as RecentAnswers,
        avg(rap.Score) as AvgRecentScore,
        max(rap.Score) as MaxRecentScore,
        sum(rap.FavoriteCount) as TotalFavorites,
        sum(case when rap.ClosedDate is not null then 1 else 0 end) as ClosedPosts
    from RecentActivePosts rap
    group by rap.OwnerUserId
)
select 
    uas.UserId,
    uas.DisplayName,
    uas.Location,
    uas.Reputation,
    uas.Views,
    uas.UpVotes,
    uas.DownVotes,
    uas.QuestionCount,
    uas.AnswerCount,
    uas.GoldBadges,
    uas.SilverBadges,
    uas.BronzeBadges,
    uas.HasTagBasedBadge,
    coalesce(uaps.RecentPostCount, 0) as RecentPostCount,
    coalesce(uaps.RecentQuestions, 0) as RecentQuestions,
    coalesce(uaps.RecentAnswers, 0) as RecentAnswers,
    coalesce(uaps.AvgRecentScore, 0) as AvgRecentScore,
    coalesce(uaps.MaxRecentScore, 0) as MaxRecentScore,
    coalesce(uaps.TotalFavorites, 0) as TotalFavorites,
    coalesce(uaps.ClosedPosts, 0) as ClosedPosts,
    coalesce(upl.DuplicateLinks, 0) as DuplicateLinks,
    coalesce(upl.LinkedPosts, 0) as LinkedPosts,
    array_agg(distinct t.Tag order by t.Tag) filter (where t.Tag is not null) as UserTags,
    array_agg(distinct concat_ws(':', ta.Tag, round(ta.AvgScore,2), ta.PostsWithTag)) filter (where ta.Tag is not null) as TagStats
from UserActivitySummary uas
left join UserRecentPostStats uaps on uaps.UserId = uas.UserId
left join UserPostLinkSummary upl on upl.UserId = uas.UserId
left join PostTagExplode t on t.OwnerUserId = uas.UserId
left join TagAggregates ta on ta.Tag = t.Tag
group by 
    uas.UserId, uas.DisplayName, uas.Location, uas.Reputation, uas.Views, uas.UpVotes, uas.DownVotes,
    uas.QuestionCount, uas.AnswerCount, uas.GoldBadges, uas.SilverBadges, uas.BronzeBadges, uas.HasTagBasedBadge,
    uaps.RecentPostCount, uaps.RecentQuestions, uaps.RecentAnswers, uaps.AvgRecentScore, uaps.MaxRecentScore, uaps.TotalFavorites, uaps.ClosedPosts,
    upl.DuplicateLinks, upl.LinkedPosts
order by uas.Reputation desc, uas.Views desc
limit 20;