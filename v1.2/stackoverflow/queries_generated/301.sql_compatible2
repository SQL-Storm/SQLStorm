with recursive RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 as Level,
        cast(t.TagName as varchar(1000)) as Path
    from Tags t
    where t.IsRequired = true
    union all
    select
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        r.Level + 1,
        r.Path || ' > ' || t2.TagName
    from Tags t2
    join RecursiveTagHierarchy r on t2.Id <> r.Id and t2.IsRequired = true and t2.Count < r.Count
    where r.Level < 3
),
UserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionsAsked,
        count(distinct case when p2.PostTypeId = 2 then p2.Id end) as AnswersGiven,
        count(distinct c.Id) as CommentsMade,
        count(distinct b.Id) as BadgesEarned,
        coalesce(sum(v.BountyAmount),0) as TotalBountyReceived,
        max(p.CreationDate) as LastPostDate,
        max(c.CreationDate) as LastCommentDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Posts p2 on p2.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Badges b on b.UserId = u.Id
    left join Votes v on v.UserId = u.Id and v.VoteTypeId = 8
    group by u.Id, u.DisplayName, u.Reputation
),
PostScoreRanks as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        row_number() over (partition by p.PostTypeId order by p.Score desc, p.ViewCount desc) as ScoreRank,
        dense_rank() over (partition by p.PostTypeId order by p.CreationDate desc) as RecentRank
    from Posts p
    where p.PostTypeId in (1,2)
),
AcceptedAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId as QuestionOwner,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        a.Id as AcceptedAnswerId,
        a.OwnerUserId as AnswerOwner,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreation,
        extract(epoch from (a.CreationDate - q.CreationDate)) / 3600.0 as HoursToAccept
    from Posts q
    left join Posts a on a.Id = q.AcceptedAnswerId
    where q.PostTypeId = 1 and q.AcceptedAnswerId is not null
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        u.DisplayName as LinkCreator,
        lt.Name as LinkTypeName
    from PostLinks pl
    left join Users u on u.Id = (select OwnerUserId from Posts where Id = pl.PostId)
    left join LinkTypes lt on lt.Id = pl.LinkTypeId
    where pl.LinkTypeId = 3
),
CloseReasonCounts as (
    select
        cht.Name as CloseReason,
        count(ph.Id) as CloseCount
    from PostHistory ph
    join PostHistoryTypes chtype on chtype.Id = ph.PostHistoryTypeId
    join CloseReasonTypes cht on cast(cht.Id as varchar) = ph.Comment
    where ph.PostHistoryTypeId = 10
    group by cht.Name
),
UserBadgeWindow as (
    select
        b.UserId,
        b.Name as BadgeName,
        b.Class,
        b.Date,
        lead(b.Date) over (partition by b.UserId order by b.Date) as NextBadgeDate,
        lag(b.Date) over (partition by b.UserId order by b.Date) as PrevBadgeDate
    from Badges b
),
UserBadgeIntervals as (
    select
        UserId,
        BadgeName,
        Class,
        Date,
        coalesce(extract(epoch from (NextBadgeDate - Date)) / 3600.0, 0) as HoursToNextBadge,
        coalesce(extract(epoch from (Date - PrevBadgeDate)) / 3600.0, 0) as HoursFromPrevBadge
    from UserBadgeWindow
),
TopActiveUsers as (
    select
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.QuestionsAsked,
        ua.AnswersGiven,
        ua.CommentsMade,
        ua.BadgesEarned,
        ua.TotalBountyReceived,
        ua.LastPostDate,
        ua.LastCommentDate,
        rank() over (order by ua.Reputation desc, ua.BadgesEarned desc) as UserRank
    from UserActivity ua
    where ua.Reputation > 10000 and ua.BadgesEarned > 10
),
FinalResults as (
    select
        ta.UserRank,
        ta.DisplayName,
        ta.Reputation,
        ta.QuestionsAsked,
        ta.AnswersGiven,
        ta.CommentsMade,
        ta.BadgesEarned,
        ta.TotalBountyReceived,
        ta.LastPostDate,
        ta.LastCommentDate,
        avg(uba.HoursToNextBadge) filter (where uba.HoursToNextBadge > 0) as AvgHoursBetweenBadges,
        max(case when ps.PostTypeId = 1 then ps.Score end) as MaxQuestionScore,
        max(case when ps.PostTypeId = 2 then ps.Score end) as MaxAnswerScore,
        count(distinct dl.PostId) as DuplicateLinksCount,
        crc.CloseCount,
        string_agg(distinct rth.Path, ' | ') as TagHierarchyPaths
    from TopActiveUsers ta
    left join UserBadgeIntervals uba on uba.UserId = ta.UserId
    left join PostScoreRanks ps on ps.OwnerUserId = ta.UserId
    left join DuplicateLinks dl on dl.LinkCreator = ta.DisplayName
    left join CloseReasonCounts crc on true
    left join RecursiveTagHierarchy rth on rth.Count > 1000
    group by
        ta.UserRank,
        ta.DisplayName,
        ta.Reputation,
        ta.QuestionsAsked,
        ta.AnswersGiven,
        ta.CommentsMade,
        ta.BadgesEarned,
        ta.TotalBountyReceived,
        ta.LastPostDate,
        ta.LastCommentDate,
        crc.CloseCount
)
select *
from FinalResults
order by UserRank
limit 50;