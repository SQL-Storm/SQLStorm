WITH FilteredQuestions AS (
    SELECT p.Id AS QuestionId,
           p.Title,
           p.OwnerUserId,
           p.CreationDate,
           p.Score,
           COALESCE(p.ViewCount,0) AS Views,
           COALESCE(p.AnswerCount,0) AS Answers,
           p.Tags,
           u.DisplayName AS OwnerName,
           u.Reputation,
           uwc.UserNameCollage
      FROM Posts p
      JOIN Users u ON p.OwnerUserId = u.Id
      LEFT JOIN (
          SELECT wo.OwnerUserId, 
                 STRING_AGG(DISTINCT uw.UserName COLLATE utf8mb4_unicode_ci, ',') AS UserNameCollage
            FROM Posts wo
            JOIN Users uw ON wo.OwnerUserId = uw.Id
           WHERE
           wo.OwnerUserId IS NOT NULL
           GROUP BY wo.OwnerUserId
       ) uwc ON u.Id = uwc.OwnerUserId
     WHERE p.PostTypeId = 1                            
       AND p.CreationDate BETWEEN cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years' AND cast('2024-10-01 12:34:56' as timestamp)
       AND COALESCE(p.Score,0) > 0
