WITH RecursiveTagAgg AS (
    SELECT
        p.Id AS PostId,
        ts / NULLIF(Post.Created, 0) AS CreatedRatio,
        p.OwnerUserId,
        p.Title,
        p.Body,
        p.Score,
        p.ViewCount,
        p.CommentCount,
        p.FavoriteCount
    FROM posts p
    JOIN posts Post ON p.Id = Post.Id
    JOIN tags t ON t.PostId = p.Id
    JOIN tagstats ts ON ts.PostId = p.Id
)
SELECT
    PostId,
    CreatedRatio,
    OwnerUserId,
    Title,
    Body,
    Score,
    ViewCount,
    CommentCount,
    FavoriteCount
FROM RecursiveTagAgg
GROUP BY
    PostId,
    CreatedRatio,
    OwnerUserId,
    Title,
    Body,
    Score,
    ViewCount,
    CommentCount,
    FavoriteCount;