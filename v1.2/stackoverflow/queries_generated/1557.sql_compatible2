WITH RecursiveTagHierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        0 AS Level,
        COALESCE((SELECT w.Score FROM Posts w WHERE w.Id = t.ExcerptPostId), 0) AS TagScore
    FROM 
        Tags t
    WHERE 
        t.IsModeratorOnly = FALSE

    UNION ALL

    SELECT
        t.Id,
        t.TagName,
        rth.Level + 1,
        rth.TagScore
    FROM
        RecursiveTagHierarchy rth
    JOIN
        Tags t ON t.Id = rth.Id
    WHERE
        rth.Level < 3
),
BadgedUsersCTE AS (
    SELECT 
        b.UserId,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id END) AS SilverBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id END) AS BronzeBadges,
        COUNT(DISTINCT b.Id) AS BadgeCount
    FROM
        Badges b
    GROUP BY 
        b.UserId
),
TopPostsbyComplexity AS (
    SELECT 
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        pt.Name AS PostTypeName,
        COUNT(DISTINCT ph.PostHistoryTypeId) AS DistinctHistoryEvents,
        COUNT(DISTINCT c.Id) AS CommentCount,
        prefix_tag.tag_names,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.ViewCount DESC) AS RankHigher
    FROM 
        Posts p
    LEFT JOIN 
        PostHistory ph ON p.Id = ph.PostId
    LEFT JOIN 
        Comments c ON c.PostId = p.Id
    LEFT JOIN LATERAL (
        SELECT string_agg(name, ',' ORDER BY name) AS tag_names
        FROM (
            SELECT unnest(
                string_to_array(substr(p.Tags, 2, char_length(p.Tags) - 2), '><')
            ) AS name
        ) tAllTags
        WHERE tAllTags.name IS NOT NULL AND char_length(tAllTags.name) > 0
    ) prefix_tag ON true
    JOIN 
        PostTypes pt ON p.PostTypeId = pt.Id
    WHERE 
        p.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '2 years')
    GROUP BY 
        p.Id, p.PostTypeId, p.OwnerUserId, p.Title, p.CreationDate, p.Score, p.ViewCount, pt.Name, prefix_tag.tag_names
),
UserActivityAgg AS (
    SELECT 
        u.Id, 
        u.DisplayName, 
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        ba.GoldBadges,
        ba.SilverBadges,
        ba.BronzeBadges,
        ba.BadgeCount,
        COALESCE(user_posts.NumPosts,0) AS NumPosts,
        COALESCE(user_comments.NumComments,0) AS NumComments,
        COALESCE(user_votes.NumVotes,0) AS NumVotes
    FROM 
        Users u
    LEFT JOIN 
        BadgedUsersCTE ba ON u.Id = ba.UserId
    LEFT JOIN  
        (
            SELECT OwnerUserId, COUNT(*) AS NumPosts 
            FROM Posts 
            WHERE OwnerUserId IS NOT NULL 
            GROUP BY OwnerUserId
        ) user_posts ON user_posts.OwnerUserId = u.Id
    LEFT JOIN 
        (
            SELECT UserId, COUNT(*) AS NumComments 
            FROM Comments 
            GROUP BY UserId 
        ) user_comments ON user_comments.UserId = u.Id
    LEFT JOIN
        (
            SELECT UserId, COUNT(*) AS NumVotes 
            FROM Votes 
            WHERE UserId IS NOT NULL 
            GROUP BY UserId
        ) user_votes ON user_votes.UserId = u.Id
),
AnalyticsSummary AS (
    SELECT 
        p.PostId,
        p.PostTypeId,
        p.Title,
        p.ViewCount,
        p.Score,
        p.CommentCount,
        p.DistinctHistoryEvents,
        U.DisplayName AS OwnerName,
        U.Reputation AS OwnerRep,
        COALESCE(U.BadgeCount, 0) AS OwnerBadges,
        prefixstagET.prefix_tag_string,
        SUBSTR(COALESCE(CAST(p.RankHigher AS VARCHAR), '99'), 1, 4) AS ScoredRankGroup,
        -- simplified numeric expression without dialect-specific cast
        MAX((RAND() * 1) + p.ViewCount * -10) AS DistScoreWindowNestCategoryMaxOfKernel_LevelAgg,
        p.RankHigher
    FROM TopPostsbyComplexity p
    LEFT JOIN UserActivityAgg U ON U.Id = p.OwnerUserId
    LEFT JOIN LATERAL (
        SELECT string_agg(t.TagName, ',') AS prefix_tag_string
        FROM Tags t 
        JOIN RecursiveTagHierarchy rth ON rth.Id = t.Id
        WHERE t.IsModeratorOnly = FALSE
    ) prefixstagET ON true
    GROUP BY
        p.PostId,
        p.PostTypeId,
        p.Title,
        p.ViewCount,
        p.Score,
        p.CommentCount,
        p.DistinctHistoryEvents,
        U.DisplayName,
        U.Reputation,
        U.BadgeCount,
        prefixstagET.prefix_tag_string,
        p.RankHigher
)

SELECT *
FROM AnalyticsSummary
ORDER BY DistinctHistoryEvents DESC, Score DESC, ViewCount DESC
LIMIT 17;