      ARRAY(
        SELECT DISTINCT unnest(z.ssl)
        FROM (
          SELECT 
            string_to_array(
              substring(Tags, 2, length(Tags)-2),
              '><'                
            ) AS ssl
      ) z         
      ),
      ', '
    ) AS TagList,
    ABS(p.Score * LOG(GREATEST(1, p.ViewCount))) + COALESCE(p.FavoriteCount,0) * 3 AS composite_score,
    view_counts.ev_moving_avg,
    post_window.LastScoreRank,
    reg_rank,
    u.Reputation,
    u.AboutMe,
    p.CreationDate,
    soir.posts_owned_count
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN LATERAL (
    SELECT AVG(p2.Score) AS ev_moving_avg
    FROM Posts p2 
    WHERE p2.OwnerUserId = p.OwnerUserId 
      AND p2.CreationDate BETWEEN p.CreationDate - INTERVAL '7 days' AND p.CreationDate
  ) view_counts ON true
  LEFT JOIN LATERAL (
    SELECT RANK() OVER (
      ORDER BY p.Score DESC, p.ViewCount DESC, u.Reputation DESC NULLS LAST
    ) AS LastScoreRank
  ) post_window ON true
  LEFT JOIN LATERAL (
    SELECT DENSE_RANK() OVER (
      PARTITION BY COALESCE(u.Location, 'UNKNOWN')
      ORDER BY p.Score DESC NULLS LAST, p.ViewCount DESC
