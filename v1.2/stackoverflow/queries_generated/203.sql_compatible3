with recursive RecursiveTagHierarchy as (
    select 
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 as Level,
        cast(t.TagName as varchar(1000)) as Path
    from Tags t
    where t.IsModeratorOnly = false and t.IsRequired = false
    union all
    select
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        r.Level + 1,
        cast(r.Path || ' > ' || t2.TagName as varchar(1000))
    from Tags t2
    join RecursiveTagHierarchy r on t2.Id <> r.Id and t2.Count < r.Count and t2.IsModeratorOnly = false and t2.IsRequired = false
    where r.Level < 3
),
UserBadgeCounts as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        coalesce(sum(b.Class),0) as BadgeScore
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostActivity as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.AcceptedAnswerId,
        p.ParentId,
        p.Title,
        p.ClosedDate,
        p.LastActivityDate,
        row_number() over (partition by p.OwnerUserId order by p.Score desc) as UserPostRank,
        case 
            when p.ClosedDate is not null then 1
            else 0
        end as IsClosed
    from Posts p
    where p.PostTypeId in (1,2)
),
AnswerStats as (
    select
        a.ParentId as QuestionId,
        count(*) as TotalAnswers,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore,
        sum(case when a.OwnerUserId is null then 0 else 1 end) as AnsweredByRegisteredUsers
    from Posts a
    where a.PostTypeId = 2
    group by a.ParentId
),
QuestionVotes as (
    select
        v.PostId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes,
        sum(case when vt.Name = 'Favorite' then 1 else 0 end) as Favorites
    from Votes v
    join VoteTypes vt on vt.Id = v.VoteTypeId
    group by v.PostId
),
UserRecentActivity as (
    select
        u.Id as UserId,
        max(p.LastActivityDate) as LastPostActivity,
        max(c.CreationDate) as LastCommentDate,
        max(ph.CreationDate) as LastEditDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join PostHistory ph on ph.UserId = u.Id
    group by u.Id
),
ClosedQuestionsWithReasons as (
    select
        ph.PostId,
        ph.CreationDate as CloseDate,
        crt.Name as CloseReason,
        ph.UserId as ClosedByUserId,
        u.DisplayName as ClosedByUserName
    from PostHistory ph
    join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId and pht.Name = 'Post Closed'
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    left join Users u on u.Id = ph.UserId
    where ph.PostId in (select Id from Posts where PostTypeId = 1)
),
TopQuestionsWithAnswers as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        u.DisplayName as QuestionOwner,
        q.CreationDate,
        q.Score as QuestionScore,
        q.ViewCount,
        q.Tags,
        av.TotalAnswers,
        av.AvgAnswerScore,
        av.MaxAnswerScore,
        av.AnsweredByRegisteredUsers,
        q.IsClosed,
        cqwr.CloseReason,
        cqwr.CloseDate,
        cqwr.ClosedByUserName,
        qv.UpVotes,
        qv.DownVotes,
        qv.Favorites,
        row_number() over (order by q.Score desc, q.ViewCount desc) as Rank
    from PostActivity q
    left join AnswerStats av on av.QuestionId = q.Id
    left join QuestionVotes qv on qv.PostId = q.Id
    left join ClosedQuestionsWithReasons cqwr on cqwr.PostId = q.Id
    left join Users u on u.Id = q.OwnerUserId
    where q.PostTypeId = 1
),
UserEngagement as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        ubc.GoldBadges,
        ubc.SilverBadges,
        ubc.BronzeBadges,
        ua.LastPostActivity,
        ua.LastCommentDate,
        ua.LastEditDate,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionsAsked,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswersGiven,
        count(distinct c.Id) as CommentsMade,
        coalesce(sum(vt2.VoteCount),0) as TotalVotesCast
    from Users u
    left join UserBadgeCounts ubc on ubc.UserId = u.Id
    left join UserRecentActivity ua on ua.UserId = u.Id
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join (
        select
            v.UserId,
            count(*) as VoteCount
        from Votes v
        group by v.UserId
    ) vt2 on vt2.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, ubc.GoldBadges, ubc.SilverBadges, ubc.BronzeBadges, ua.LastPostActivity, ua.LastCommentDate, ua.LastEditDate
),
ComplexStringAnalysis as (
    select
        p.Id as PostId,
        p.Title,
        p.Tags,
        length(p.Body) as BodyLength,
        length(regexp_replace(p.Body, '<[^>]*>', '', 'g')) as BodyTextLength,
        array_length(string_to_array(coalesce(p.Tags,''), '><'), 1) as TagCount,
        case 
            when p.Tags is null then 0
            else array_length(string_to_array(substring(p.Tags from 2 for length(p.Tags)-2), '><'), 1)
        end as ParsedTagCount,
        strpos(lower(p.Title), 'sql') as SqlKeywordPos,
        strpos(lower(p.Body), 'performance') as PerformanceKeywordPos,
        case when p.ClosedDate is not null then 1 else 0 end as IsClosed
    from Posts p
    where p.PostTypeId = 1
),
FinalSelection as (
    select
        tq.QuestionId,
        tq.Title,
        tq.QuestionOwner,
        tq.CreationDate,
        tq.QuestionScore,
        tq.ViewCount,
        tq.Tags,
        tq.TotalAnswers,
        tq.AvgAnswerScore,
        tq.MaxAnswerScore,
        tq.AnsweredByRegisteredUsers,
        tq.IsClosed,
        coalesce(tq.CloseReason, 'N/A') as CloseReason,
        tq.CloseDate,
        coalesce(tq.ClosedByUserName, 'N/A') as ClosedByUserName,
        tq.UpVotes,
        tq.DownVotes,
        tq.Favorites,
        ue.Reputation as OwnerReputation,
        ue.GoldBadges,
        ue.SilverBadges,
        ue.BronzeBadges,
        ue.QuestionsAsked,
        ue.AnswersGiven,
        ue.CommentsMade,
        ue.TotalVotesCast,
        csa.BodyLength,
        csa.BodyTextLength,
        csa.TagCount,
        csa.ParsedTagCount,
        csa.SqlKeywordPos,
        csa.PerformanceKeywordPos,
        csa.IsClosed as PostClosedFlag
    from TopQuestionsWithAnswers tq
    left join UserEngagement ue on ue.Id = tq.OwnerUserId
    left join ComplexStringAnalysis csa on csa.PostId = tq.QuestionId
    where tq.Rank <= 100
)
select 
    fs.QuestionId,
    fs.Title,
    fs.QuestionOwner,
    fs.CreationDate,
    fs.QuestionScore,
    fs.ViewCount,
    fs.Tags,
    fs.TotalAnswers,
    fs.AvgAnswerScore,
    fs.MaxAnswerScore,
    fs.AnsweredByRegisteredUsers,
    fs.IsClosed,
    fs.CloseReason,
    fs.CloseDate,
    fs.ClosedByUserName,
    fs.UpVotes,
    fs.DownVotes,
    fs.Favorites,
    fs.OwnerReputation,
    fs.GoldBadges,
    fs.SilverBadges,
    fs.BronzeBadges,
    fs.QuestionsAsked,
    fs.AnswersGiven,
    fs.CommentsMade,
    fs.TotalVotesCast,
    fs.BodyLength,
    fs.BodyTextLength,
    fs.TagCount,
    fs.ParsedTagCount,
    fs.SqlKeywordPos,
    fs.PerformanceKeywordPos,
    fs.PostClosedFlag,
    rank() over (
      partition by 
        case 
          when fs.OwnerReputation >= 100000 then 'HighRep'
          when fs.OwnerReputation >= 10000 then 'MidRep'
          else 'LowRep'
        end
      order by fs.QuestionScore desc
    ) as ScoreRankWithinRepGroup,
    (select count(*) from Comments c where c.PostId = fs.QuestionId) as CommentCount,
    (select string_agg(distinct t.TagName, ', ') from (
        select unnest(string_to_array(substring(fs.Tags from 2 for length(fs.Tags)-2), '><')) as TagName
        union
        select TagName from Tags
        order by Count desc
        limit 5
    ) t) as CombinedTagSet
from FinalSelection fs
order by fs.QuestionScore desc, fs.ViewCount desc
limit 50;