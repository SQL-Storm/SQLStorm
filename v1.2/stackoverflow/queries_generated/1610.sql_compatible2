with RecursiveTagCounts as (
    select
        t.Id as TagId,
        t.TagName,
        t.Count,
        coalesce(p.OwnersCount, 0) as OwnerfulPostCount
    from Tags t
    left join (
        select
            unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags)-2), '><')) as intag,
            count(*) as OwnersCount
        from Posts p
        where p.PostTypeId = 1 and p.OwnerUserId is not null and p.OwnerUserId != -1
        group by unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags)-2), '><'))
    ) p on p.intag = t.TagName
),
UserBadgeTypeAggregate as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        coalesce(sum(coalesce(valls.UpVoteScore, 0)), 0) as TotalUpVoteScore
    from Users u
    left join Badges b on b.UserId = u.Id
    left join lateral (
        select 
            p.OwnerUserId,
            sum(v.ValueExpected) as UpVoteScore
        from Posts p
        left join lateral (
            select 
                case
                    when v.VoteTypeId = 2 then 5
                    when v.VoteTypeId = 1 then 15
                    else 0
                end as ValueExpected,
                v.PostId
            from Votes v
            where v.VoteTypeId in (1, 2)
        ) v on v.PostId = p.Id
        where p.OwnerUserId = u.Id
        group by p.OwnerUserId
    ) valls on valls.OwnerUserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
),
LatestPostHistoryEtc as (
    select
        ph.PostId,
        ph.UserId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ph.Comment
    from PostHistory ph
    where ph.PostHistoryTypeId in (10, 12, 19)
    qualify row_number() over (partition by ph.PostId order by ph.CreationDate desc) = 1
),
PopularAndClosedQ16_25Ranked as (
    select
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        tus.UserId as Validator_UserId,
        tus.Comment as Validator_Comment,
        tuplebs.MarkFailures,
        rank() over (order by p.ViewCount desc, p.Score asc) as ViewRank,
        case
            when char_length(p.Tags) > 200 then 'LONG'
            when char_length(p.Tags) > 0 and char_length(p.Tags) <= 200 then 'MEDIUM'
            else 'SHORT/EMPTY'
        end as TagLengthCategory,
        olv.Helpfulness_MetaHint
    from Posts p
    left join LatestPostHistoryEtc tus on tus.PostId = p.Id and tus.PostHistoryTypeId = 10
    left join lateral (
       select count(*) as MarkFailures
       from Votes v
       where v.PostId = p.Id and v.VoteTypeId = 3
    ) tuplebs on true
    left join lateral (
        select 
           count(pl.Id) as Helpfulness_MetaHint
        from PostLinks pl
        where pl.PostId = p.Id and pl.LinkTypeId = 3
    ) olv on true
    where p.PostTypeId = 1
      and p.CreationDate between DATE '2016-01-01' and DATE '2016-06-25'
)
select *
from PopularAndClosedQ16_25Ranked;