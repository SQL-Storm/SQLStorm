-- {"query": "887.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.8, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1470} 
with RecursiveTagCounts as (
    select
        t.Id,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as AnswerCount,
        coalesce(p.FavoriteCount, 0) as FavoriteCount,
        coalesce(p.ViewCount, 0) as ViewCount,
        row_number() over (order by t.Count desc, t.TagName) as TagRank
    from Tags t
    left join Posts p on p.Id = t.ExcerptPostId and p.PostTypeId = 1
    where t.TagName is not null
),
UserBadgeSummary as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(b.Id) as TotalBadges,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        max(b.Date) as LastBadgeDate
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostActivityWindow as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.FavoriteCount,
        p.Tags,
        p.ClosedDate,
        lead(p.CreationDate) over (partition by p.OwnerUserId order by p.CreationDate) as NextPostCreationDate,
        lag(p.CreationDate) over (partition by p.OwnerUserId order by p.CreationDate) as PrevPostCreationDate
    from Posts p
    where p.PostTypeId in (1, 2)
),
RecentCloseReasons as (
    select distinct
        ph.PostId,
        crt.Name as CloseReasonName,
        ph.CreationDate as CloseDate
    from PostHistory ph
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as int)
    where ph.PostHistoryTypeId = 10
      and ph.CreationDate > cast('2024-10-01' as date) - interval '180 days'
),
TopAnswerers as (
    select
        p.OwnerUserId,
        count(p.Id) as AnswerCount,
        avg(p.Score) as AvgScore,
        max(p.Score) as MaxScore
    from Posts p
    where p.PostTypeId = 2
    group by p.OwnerUserId
    having count(p.Id) > 10
),
AnswerWithDuplicates as (
    select p.Id, p.ParentId, p.Score, p.CreationDate, p.OwnerUserId,
      exists (
        select 1 from PostLinks pl
        where pl.PostId = p.ParentId and pl.LinkTypeId = 3
      ) as ParentIsDuplicate
    from Posts p
    where p.PostTypeId = 2
)
select
    ut.TagName,
    ut.Count as TagGlobalCount,
    ut.AnswerCount as TagAnswerCount,
    ut.FavoriteCount as TagFavoriteCount,
    ut.ViewCount as TagViewCount,
    ub.DisplayName as TopUserDisplayName,
    ub.TotalBadges,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    coalesce(tac.AnswerCount, 0) as UserAnswerCount,
    coalesce(tac.AvgScore, 0) as UserAverageAnswerScore,
    coalesce(rc.CloseReasonName, 'No Recent Close') as RecentCloseReason,
    p.Id as SamplePostId,
    p.Title,
    p.Score as PostScore,
    p.ViewCount as PostViews,
    p.FavoriteCount as PostFavorites,
    case when p.ClosedDate is null then 'Open' else 'Closed' end as PostStatus,
    case when awd.ParentIsDuplicate then 'Duplicate Answer' else 'Original Answer' end as AnswerDuplicateStatus,
    -- Complicated string expression with null checks and concatenation
    concat(
      'User: ', coalesce(ub.DisplayName, 'Anonymous'), ' | ',
      'BadgeSummary: G=', ub.GoldBadges::text, ', S=', ub.SilverBadges::text, ', B=', ub.BronzeBadges::text, ' | ',
      'PostTitle: ', coalesce(nullif(p.Title, ''), '[No Title]'), ' | ',
      'Tags: ', coalesce(nullif(p.Tags, ''), '[No Tags]')
    ) as InfoSummary,
    -- Window function: rank of post score in user's posts
    rank() over (partition by p.OwnerUserId order by p.Score desc) as PostScoreRankByUser,
    -- Correlated subquery: number of comments on this post by users with reputation > 1000
    (select count(*) from Comments c join Users u on c.UserId = u.Id where c.PostId = p.Id and u.Reputation > 1000) as HighRepCommentCount
from RecursiveTagCounts ut
left join Users u on u.Id = (
    select OwnerUserId from Posts where Tags like concat('%<', ut.TagName, '>%') and OwnerUserId is not null
    order by Score desc nulls last limit 1
)
left join UserBadgeSummary ub on ub.UserId = u.Id
left join TopAnswerers tac on tac.OwnerUserId = u.Id
left join Posts p on p.OwnerUserId = u.Id and p.PostTypeId = 1 and p.Tags like concat('%<', ut.TagName, '>%')
left join RecentCloseReasons rc on rc.PostId = p.Id
left join AnswerWithDuplicates awd on awd.ParentId = p.Id
where ut.TagRank <= 50
union
select
    'Summary' as TagName,
    sum(t.Count) as TagGlobalCount,
    sum(coalesce(p.AnswerCount,0)) as TagAnswerCount,
    sum(coalesce(p.FavoriteCount,0)) as TagFavoriteCount,
    sum(coalesce(p.ViewCount,0)) as TagViewCount,
    null as TopUserDisplayName,
    null as TotalBadges,
    null as GoldBadges,
    null as SilverBadges,
    null as BronzeBadges,
    null as UserAnswerCount,
    null as UserAverageAnswerScore,
    null as RecentCloseReason,
    null as SamplePostId,
    null as Title,
    null as PostScore,
    null as PostViews,
    null as PostFavorites,
    null as PostStatus,
    null as AnswerDuplicateStatus,
    null as InfoSummary,
    null as PostScoreRankByUser,
    null as HighRepCommentCount
from RecursiveTagCounts t
left join Posts p on p.Id = t.ExcerptPostId
where t.TagRank <= 50
order by TagGlobalCount desc nulls last, TagName;