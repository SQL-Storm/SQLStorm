WITH RecentHighViewsQuestions AS (
    SELECT
        p.Id,
        p.Title,
        u.DisplayName AS Owner,
        p.ViewCount,
        (
            SELECT AVG(CAST(vo.Score AS NUMERIC))
            FROM Votes vo
            JOIN VoteTypes vt ON vo.VoteTypeId = vt.Id
            WHERE vo.PostId = p.Id
        ) AS AvgVoteScore
    FROM Posts p
    JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1
      AND p.ViewCount > 1000
)
SELECT
    Id,
    Title,
    Owner,
    ViewCount,
    AvgVoteScore
FROM RecentHighViewsQuestions
GROUP BY
    Id,
    Title,
    Owner,
    ViewCount,
    AvgVoteScore;