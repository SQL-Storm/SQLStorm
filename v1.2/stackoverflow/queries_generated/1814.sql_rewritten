    SELECT 
        p.Id, p.Title, p.CreationDate, u.DisplayName AS OwnerName,
        REGEXP_SPLIT_TO_TABLE(TRIM(BOTH '<>' FROM p.Tags), '><') AS Tag
    FROM 
        Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE 
        p.PostTypeId = 1
