-- {"query": "1385.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.3, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1077} 
with RecursiveTagCount as (
    select t.Id, t.TagName, t.Count,
        p.Id as PostId,
        case when p.ViewCount is null then 0 else p.ViewCount end as PostViews,
        row_number() over (partition by t.Id order by p.Score desc) as rn
    from Tags t
    left join Posts p on p.Tags like concat('%<', t.TagName,'>%')
), TopTagPosts as (
    select Id, TagName, Count, PostId, PostViews from RecursiveTagCount where rn <= 5
), UserReputationStats as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        sum(coalesce(b.Class,0)) as BadgeScore,
        rank() over (order by u.Reputation desc, u.CreationDate) as ReputationRank,
        sum(case when p.PostTypeId=1 then 1 else 0 end) as QuestionCount,
        sum(case when p.PostTypeId=2 then 1 else 0 end) as AnswerCount,
        count(distinct ph.PostId) as EditsMade
    from Users u
    left join Badges b on b.UserId = u.Id
    left join Posts p on p.OwnerUserId = u.Id
    left join PostHistory ph on ph.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
), ComplexVoteSummary as (
    select
        p.Id as PostId,
        p.Title,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        coalesce(avg(case when v.VoteTypeId = 2 then 1.0 else null end),0) as AvgUpVotePerVote,
        coalesce(max(case when v.VoteTypeId = 9 then v.BountyAmount else 0 end), 0) as MaxBounty,
        count(distinct v.UserId) as DistinctVoters,
        count(v.Id) as TotalVotes
    from Posts p
    left join Votes v on v.PostId = p.Id
    where p.PostTypeId in (1,2)
    group by p.Id, p.Title
)
select
    urs.Id as UserId,
    urs.DisplayName,
    urs.Reputation,
    coalesce(nullif(urs.BadgeScore,0), 999) as BadgeScoreOrDefault,
    urs.ReputationRank,
    urs.QuestionCount,
    urs.AnswerCount,
    urs.EditsMade,
    ttp.TagName as PopularTag,
    ttp.PostId as PopularPostId,
    ttp.PostViews,
    cvs.PostId,
    case when cvs.TotalVotes > 0 then
        cvs.UpVotes*1.0/cvs.TotalVotes else null end as UpVoteRatio,
    cvs.MaxBounty,
    case when urs.BadgeScore > 0 then 'Active Badge Holder'
        when urs.BadgeScore+urs.AnswerCount < 3 then 'Newbie'
        else 'Regular User' end as UserCategory,
   
    -- String manipulation with nested function calls and NULL handling:
    concat_ws(' | ', 
        coalesce(left(urs.DisplayName,10), 'NoName'),
        coalesce(substr(cvs.Title, 1, 20), 'NoTitle'),
        'Reputation: ' || cast(urs.Reputation as varchar),
        'VotesUp/Down: ' || cast(coalesce(cvs.UpVotes,0) as varchar) || '/' || cast(coalesce(cvs.DownVotes,0) as varchar)
    ) as SummaryString
from UserReputationStats urs
left join TopTagPosts ttp on ttp.PostId = (
    select p2.Id from Posts p2 
    where p2.OwnerUserId = urs.Id
    order by p2.Score desc nulls last limit 1
)
left join ComplexVoteSummary cvs on cvs.PostId = ttp.PostId
where urs.Reputation > (
    select percentile_cont(0.25) within group (order by Reputation) from Users
)
and exists (
    select 1 from Posts p where p.OwnerUserId = urs.Id and p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
)
union
select
    NULL as UserId,
    '[AGGREGATE ROW]' as DisplayName,
    max(Reputation) as Reputation,
    max(BadgeScore) as BadgeScoreOrDefault,
    NULL as ReputationRank,
    sum(QuestionCount) as QuestionCount,
    sum(AnswerCount) as AnswerCount,
    sum(EditsMade) as EditsMade,
    NULL as PopularTag,
    NULL as PopularPostId,
    NULL as PostViews,
    NULL as PostId,
    NULL as UpVoteRatio,
    max(MaxBounty) as MaxBounty,
    NULL as UserCategory,
    NULL as SummaryString
from UserReputationStats
having max(Reputation) > 10000
order by ReputationRank, UpVoteRatio desc NULLS LAST;