with RecursiveUserPosts as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.CreationDate,
        row_number() over (partition by u.Id order by p.CreationDate desc) as RecentPostRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where u.Reputation > 1000
),
FilteredPosts as (
    select *
    from RecursiveUserPosts
    where RecentPostRank <= 5
),
TagCountCTE as (
    select
        fp.UserId,
        unnest(string_to_array(trim(both '<>' from coalesce(fp.Tags, '')), '><')) as Tag,
        count(*) over (partition by fp.UserId, unnest(string_to_array(trim(both '<>' from coalesce(fp.Tags, '')), '><'))) as UserTagCount
    from FilteredPosts fp
),
UserTagStats as (
    select
        UserId,
        Tag,
        count(*) as TagAppearances,
        avg(UserTagCount) as AvgCountPerTag
    from TagCountCTE
    group by UserId, Tag
),
PostAnswerStats as (
    select
        p.Id as QuestionId,
        p.Title,
        p.OwnerUserId,
        p.Score as QuestionScore,
        p.ViewCount,
        p.Tags,
        coalesce(a.AnswerCount, 0) as AnswerCount,
        coalesce(a.HighestAnswerScore, 0) as HighestAnswerScore,
        coalesce(a.HighestAnswerId, null) as HighestAnswerId
    from Posts p
    left join (
        select 
            ParentId,
            count(*) as AnswerCount,
            max(Score) as HighestAnswerScore,
            max(id) filter (where Score = (select max(Score) from Posts p2 where p2.ParentId = Posts.ParentId)) as HighestAnswerId
        from Posts
        where PostTypeId = 2
        group by ParentId
    ) a on p.Id = a.ParentId
    where p.PostTypeId = 1 and p.ClosedDate is null
),
CommentVotesAgg as (
    select 
        p.Id as PostId,
        count(distinct c.Id) as CommentCount,
        sum(coalesce(v.Ups,0)) as UpVotesOnComments,
        sum(coalesce(v.Downs,0)) as DownVotesOnComments
    from Posts p
    left join Comments c on c.PostId = p.Id
    left join (
        select
            v.PostId,
            sum(case when vt.Name = 'UpMod' then 1 else 0 end) as Ups,
            sum(case when vt.Name = 'DownMod' then 1 else 0 end) as Downs
        from Votes v
        join VoteTypes vt on vt.Id = v.VoteTypeId
        group by v.PostId
    ) v on v.PostId = p.Id
    group by p.Id
),
UserBadgeRanks as (
    select
        b.UserId,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        rank() over (order by count(*) desc) as BadgeRank
    from Badges b
    group by b.UserId
),
UserParticipation as (
    select
        u.Id as UserId,
        count(distinct p.Id) as TotalPosts,
        coalesce(sum(p.Score), 0) as TotalPostScore,
        coalesce(sum(vtCnt.UpVotes),0) as TotalUpVotes,
        coalesce(sum(vtCnt.DownVotes),0) as TotalDownVotes
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join (
        select
            v.UserId,
            sum(case when vt.Name='UpMod' then 1 else 0 end) as UpVotes,
            sum(case when vt.Name='DownMod' then 1 else 0 end) as DownVotes
        from Votes v
        join VoteTypes vt on vt.Id = v.VoteTypeId
        where v.UserId is not null
        group by v.UserId
    ) vtCnt on vtCnt.UserId = u.Id
    group by u.Id
),
RecentEditsRevisions as (
    select
        ph.PostId,
        ph.UserId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        RANK() over (partition by ph.PostId order by ph.CreationDate desc) as RevisionRank
    from PostHistory ph
    join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId
    where ph.PostHistoryTypeId in (4,5,6,10,11,12)
),
LatestEdits as (
    select 
        ph.PostId,
        max(ph.CreationDate) as LastEditDate,
        count(case when ph.PostHistoryTypeId = 10 then 1 end) as CloseVotes,
        count(case when ph.PostHistoryTypeId = 11 then 1 end) as ReopenVotes,
        count(case when ph.PostHistoryTypeId in (4,5,6) then 1 end) as ContentEdits
    from PostHistory ph
    group by ph.PostId
)
select 
    u.Id as UserId,
    u.DisplayName,
    up.TotalPosts,
    up.TotalPostScore,
    up.TotalUpVotes,
    up.TotalDownVotes,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ps.QuestionId,
    ps.Title as QuestionTitle,
    ps.AnswerCount,
    ps.HighestAnswerScore,
    ps.ViewCount,
    coalesce(cvo.CommentCount, 0) as CommentCountOnQuestion,
    coalesce(cvo.UpVotesOnComments, 0) as UpVotesOnComments,
    coalesce(cvo.DownVotesOnComments, 0) as DownVotesOnComments,
    le.LastEditDate,
    le.CloseVotes,
    le.ReopenVotes,
    le.ContentEdits,
    uts.Tag,
    uts.TagAppearances,
    uts.AvgCountPerTag,
    case when ps.AnswerCount > 0 and ps.HighestAnswerScore >= ps.QuestionScore then 'Answer Outperforms Question' else 'Question Leads' end as PerformanceInsight,
    (
        'UserJoined: ' || to_char(cast(u.CreationDate as date), 'YYYY-MM-DD')
        || ' | LastSeen: ' || to_char(cast(u.LastAccessDate as date), 'YYYY-MM-DD')
        || ' | Location: ' || coalesce(nullif(u.Location, ''), 'Unknown')
        || ' | Website: ' || coalesce(nullif(u.WebsiteUrl, ''), 'None')
    ) as UserProfileSummary
from Users u
inner join UserParticipation up on up.UserId = u.Id
left join UserBadgeRanks ub on ub.UserId = u.Id
left join PostAnswerStats ps on ps.OwnerUserId = u.Id
left join CommentVotesAgg cvo on cvo.PostId = ps.QuestionId
left join LatestEdits le on le.PostId = ps.QuestionId
left join (
    select * from UserTagStats uts1
    where exists (
      select 1 from UserTagStats uts2
      where uts2.UserId = uts1.UserId and uts2.TagAppearances > 1
    )
) uts on uts.UserId = u.Id
where u.Reputation > 5000
  and (ps.AnswerCount >= 3 or ps.AnswerCount is null)
order by up.TotalPostScore desc nulls last, ub.GoldBadges desc nulls last
limit 100;