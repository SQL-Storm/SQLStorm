WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        ARRAY[t.TagName] AS TagPath
    FROM Tags t
    WHERE t.IsRequired = 1

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        child.Count,
        parent.TagPath || child.TagName
    FROM Tags child
    JOIN RecursiveTagHierarchy parent ON child.WikiPostId = parent.Id
    WHERE child.IsRequired = 1
),
UserBadgeStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COUNT(DISTINCT b.TagBased) AS DistinctBadgeTypes,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
PostScoresWithWindow AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC NULLS LAST, p.CreationDate DESC) AS UserTopPostRank,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) AS AvgUserPostScore,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) AS UserPostCount
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
RecentCommentsPerPost AS (
    SELECT
        c.PostId,
        c.Id AS CommentId,
        c.CreationDate,
        c.Text,
        ROW_NUMBER() OVER (PARTITION BY c.PostId ORDER BY c.CreationDate DESC) AS CommentRank
    FROM Comments c
),
PostLinkAggregates AS (
    SELECT
        pl.PostId,
        COUNT(DISTINCT CASE WHEN lt.Name = 'Linked' THEN pl.RelatedPostId END) AS LinkedCount,
        COUNT(DISTINCT CASE WHEN lt.Name = 'Duplicate' THEN pl.RelatedPostId END) AS DuplicateCount
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    GROUP BY pl.PostId
),
PostsWithCloseReasons AS (
    SELECT
        ph.PostId,
        STRING_AGG(DISTINCT crt.Name, ', ') FILTER (WHERE ph.PostHistoryTypeId = 10) AS CloseReasons,
        MAX(ph.CreationDate) FILTER (WHERE ph.PostHistoryTypeId = 10) AS LastCloseDate
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON crt.Id = CAST(ph.Comment AS SMALLINT)
    GROUP BY ph.PostId
),
UserActivitySummary AS (
    SELECT
        u.Id AS UserId,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    GROUP BY u.Id
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.Location,
    u.WebsiteUrl,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    COALESCE(ubs.GoldBadges, 0) AS GoldBadges,
    COALESCE(ubs.SilverBadges, 0) AS SilverBadges,
    COALESCE(ubs.BronzeBadges, 0) AS BronzeBadges,
    ubs.DistinctBadgeTypes,
    uas.QuestionCount,
    uas.AnswerCount,
    uas.CommentCount,
    uas.LastPostDate,
    uas.LastCommentDate,
    psw.PostTypeId,
    psw.Id AS TopPostId,
    psw.Score AS TopPostScore,
    psw.ViewCount AS TopPostViewCount,
    psw.Tags,
    psa.LinkedCount,
    psa.DuplicateCount,
    COALESCE(pcr.CloseReasons, 'None') AS CloseReasons,
    pcr.LastCloseDate,
    rh.TagName AS RequiredTag,
    rh.TagPath,
    CONCAT(
        'User ', u.DisplayName, ' has a top post with score ',
        COALESCE(CAST(psw.Score AS TEXT), 'N/A'),
        ' and average post score ',
        COALESCE(CAST(CAST(psw.AvgUserPostScore AS NUMERIC(10,2)) AS TEXT), 'N/A')
    ) AS UserSummary,
    CASE
        WHEN u.LastAccessDate < CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year' THEN 'Inactive'
        WHEN u.Reputation > 10000 THEN 'Expert'
        ELSE 'Active'
    END AS UserStatus
FROM Users u
LEFT JOIN UserBadgeStats ubs ON ubs.UserId = u.Id
LEFT JOIN UserActivitySummary uas ON uas.UserId = u.Id
LEFT JOIN PostScoresWithWindow psw ON psw.OwnerUserId = u.Id AND psw.UserTopPostRank = 1
LEFT JOIN PostLinkAggregates psa ON psa.PostId = psw.Id
LEFT JOIN PostsWithCloseReasons pcr ON pcr.PostId = psw.Id
LEFT JOIN RecursiveTagHierarchy rh ON rh.TagName = ANY(string_to_array(COALESCE(psw.Tags, ''), '><'))
WHERE u.Reputation > 500
  AND (psw.Score IS NULL OR psw.Score >= 0)
  AND (
    EXISTS (
        SELECT 1
        FROM Comments c2
        WHERE c2.UserId = u.Id
          AND c2.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months'
          AND LENGTH(TRIM(c2.Text)) > 10
    )
    OR u.Views > 1000
  )
ORDER BY u.Reputation DESC NULLS LAST, uas.QuestionCount DESC NULLS LAST
LIMIT 100;