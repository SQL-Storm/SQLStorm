WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.IsModeratorOnly,
        t.IsRequired,
        1 AS Level,
        CAST(ARRAY[t.TagName] AS VARCHAR[]) AS Path
    FROM Tags t
    WHERE t.IsRequired = TRUE

    UNION ALL

    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.IsModeratorOnly,
        t.IsRequired,
        r.Level + 1,
        r.Path || t.TagName
    FROM Tags t
    JOIN PostLinks pl ON pl.PostId = t.ExcerptPostId
    JOIN RecursiveTagHierarchy r ON pl.RelatedPostId = r.Id
    WHERE t.IsRequired = FALSE AND NOT t.TagName = ANY(r.Path)
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersPosted,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        COUNT(DISTINCT b.Id) AS BadgesEarned,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS UpVotesReceived,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS DownVotesReceived,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
PostScoresWithWindow AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.FavoriteCount,
        p.Tags,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS RankByScore,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) AS AvgScoreByUser,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) AS TotalPostsByUser
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
TopPostsWithComments AS (
    SELECT
        psw.Id AS PostId,
        psw.OwnerUserId,
        psw.PostTypeId,
        psw.CreationDate,
        psw.Score,
        psw.ViewCount,
        psw.AnswerCount,
        psw.FavoriteCount,
        psw.Tags,
        c.CommentCount,
        c.TopCommentText,
        c.TopCommentScore,
        c.TopCommentUserId,
        c.TopCommentUserName
    FROM PostScoresWithWindow psw
    LEFT JOIN LATERAL (
        SELECT
            COUNT(*) AS CommentCount,
            MAX(c.Score) AS TopCommentScore,
            MAX(c.Text) FILTER (WHERE c.Score = (SELECT MAX(Score) FROM Comments WHERE PostId = psw.Id)) AS TopCommentText,
            MAX(c.UserId) FILTER (WHERE c.Score = (SELECT MAX(Score) FROM Comments WHERE PostId = psw.Id)) AS TopCommentUserId,
            MAX(c.UserDisplayName) FILTER (WHERE c.Score = (SELECT MAX(Score) FROM Comments WHERE PostId = psw.Id)) AS TopCommentUserName
        FROM Comments c
        WHERE c.PostId = psw.Id
    ) c ON TRUE
    WHERE psw.RankByScore <= 5
),
DuplicateQuestionPairs AS (
    SELECT DISTINCT
        pl.PostId AS DuplicateQuestionId,
        pl.RelatedPostId AS OriginalQuestionId,
        pq.Score AS DuplicateScore,
        po.Score AS OriginalScore,
        pq.CreationDate AS DuplicateCreationDate,
        po.CreationDate AS OriginalCreationDate
    FROM PostLinks pl
    JOIN Posts pq ON pq.Id = pl.PostId AND pq.PostTypeId = 1
    JOIN Posts po ON po.Id = pl.RelatedPostId AND po.PostTypeId = 1
    WHERE pl.LinkTypeId = 3
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        b.Class,
        COUNT(*) AS BadgeCount,
        STRING_AGG(DISTINCT b.Name, ', ') AS BadgeNames
    FROM Badges b
    GROUP BY b.UserId, b.Class
),
UserReputationGrowth AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.CreationDate,
        MAX(p.CreationDate) AS LastPostDate,
        EXTRACT(EPOCH FROM (MAX(p.CreationDate) - u.CreationDate))/86400 AS DaysActive,
        SUM(p.Score) AS TotalPostScore,
        CASE WHEN EXTRACT(EPOCH FROM (MAX(p.CreationDate) - u.CreationDate))/86400 > 0
            THEN SUM(p.Score) / (EXTRACT(EPOCH FROM (MAX(p.CreationDate) - u.CreationDate))/86400)
            ELSE NULL
        END AS AvgScorePerDay
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.CreationDate
)
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.CreationDate,
    ua.QuestionsPosted,
    ua.AnswersPosted,
    ua.CommentsMade,
    ua.BadgesEarned,
    ua.UpVotesReceived,
    ua.DownVotesReceived,
    ua.LastPostDate,
    ua.LastCommentDate,
    upc.PostId,
    upc.PostTypeId,
    upc.CreationDate AS PostCreationDate,
    upc.Score AS PostScore,
    upc.ViewCount,
    upc.AnswerCount,
    upc.FavoriteCount,
    upc.Tags,
    upc.CommentCount,
    upc.TopCommentText,
    upc.TopCommentScore,
    upc.TopCommentUserId,
    upc.TopCommentUserName,
    dup.OriginalQuestionId,
    dup.DuplicateQuestionId,
    dup.OriginalScore,
    dup.DuplicateScore,
    dup.OriginalCreationDate,
    dup.DuplicateCreationDate,
    ubs.Class AS BadgeClass,
    ubs.BadgeCount,
    ubs.BadgeNames,
    urg.DaysActive,
    urg.TotalPostScore,
    urg.AvgScorePerDay,
    rh.Level AS TagHierarchyLevel,
    rh.Path AS TagHierarchyPath
FROM UserActivity ua
LEFT JOIN TopPostsWithComments upc ON upc.OwnerUserId = ua.UserId
LEFT JOIN DuplicateQuestionPairs dup ON dup.DuplicateQuestionId = upc.PostId
LEFT JOIN UserBadgeSummary ubs ON ubs.UserId = ua.UserId
LEFT JOIN UserReputationGrowth urg ON urg.UserId = ua.UserId
LEFT JOIN RecursiveTagHierarchy rh ON rh.TagName = ANY(string_to_array(COALESCE(upc.Tags, ''), '><'))
WHERE ua.Reputation > 1000
  AND (upc.Score > COALESCE(ua.Reputation / 100.0, 0) OR upc.FavoriteCount > 10)
  AND (dup.DuplicateQuestionId IS NULL OR dup.DuplicateScore < dup.OriginalScore)
ORDER BY ua.Reputation DESC, upc.Score DESC, upc.CreationDate DESC
LIMIT 100;