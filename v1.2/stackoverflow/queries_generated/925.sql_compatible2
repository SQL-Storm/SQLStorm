with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        p.Id as QuestionId,
        p.Title,
        p.Score as QuestionScore,
        p.ViewCount as QuestionViews,
        p.CreationDate as QuestionCreationDate,
        a.Id as AnswerId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreationDate,
        row_number() over (partition by u.Id order by p.CreationDate desc) as QuestionRank,
        p.Tags as Tags
    from Users u
    left join Posts p on p.OwnerUserId = u.Id and p.PostTypeId = 1
    left join Posts a on a.ParentId = p.Id and a.PostTypeId = 2
    where u.Reputation > 1000
),
UserBadgeRanks as (
    select
        b.UserId,
        b.Name as BadgeName,
        b.Class,
        row_number() over (partition by b.UserId order by b.Class) as BadgeRank
    from Badges b
    join Users u on b.UserId = u.Id
    where b.Date > (cast('2024-10-01' as date) - interval '365' day)
),
LatestPostHistoryEdits as (
    select ph.PostId, max(ph.CreationDate) as LastEditDate
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6)
    group by ph.PostId
),
UserCommentStats as (
    select
        c.UserId,
        count(*) as TotalComments,
        count(distinct c.PostId) as DistinctPostsCommented,
        max(c.CreationDate) as LastCommentDate
    from Comments c
    where c.UserId is not null
    group by c.UserId
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.OwnerUserId,
        count(a.Id) as AnswerCount,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as TotalUpVotesOnAnswers,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as TotalDownVotesOnAnswers
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Votes v on v.PostId = a.Id
    where q.PostTypeId = 1
    group by q.Id, q.OwnerUserId
),
TopTagsByQuestionCount as (
    select
        tag as TagName,
        count(*) as QuestionCount
    from (
        select
            regexp_split_to_table(
                substring(p.Tags FROM 2 FOR length(p.Tags) - 2),
                '><'
            ) as tag
        from Posts p
        where p.PostTypeId = 1 and p.Tags is not null
    ) t
    group by tag
    order by QuestionCount desc
    limit 10
)
select
    ru.UserId,
    ru.DisplayName,
    ru.Reputation,
    ru.Location,
    coalesce(uc.TotalComments,0) as TotalComments,
    coalesce(uc.DistinctPostsCommented,0) as DistinctPostsCommented,
    ru.QuestionId,
    ru.Title,
    ru.QuestionScore,
    ru.QuestionViews,
    ru.AnswerId,
    ru.AnswerScore,
    ur.BadgeName,
    case when ur.Class = 1 then 'Gold' when ur.Class = 2 then 'Silver' when ur.Class = 3 then 'Bronze' else 'Unknown' end as BadgeClass,
    ph.LastEditDate,
    qa.AnswerCount,
    qa.TotalUpVotesOnAnswers,
    qa.TotalDownVotesOnAnswers,
    tt.TagName as PopularTag,
    rank() over (partition by ru.UserId order by ru.QuestionScore desc, ru.QuestionViews desc) as QuestionPopularityRank
from RecursiveUserActivity ru
left join UserBadgeRanks ur on ur.UserId = ru.UserId and ur.BadgeRank = 1
left join UserCommentStats uc on uc.UserId = ru.UserId
left join LatestPostHistoryEdits ph on ph.PostId = ru.QuestionId
left join QuestionAnswerStats qa on qa.QuestionId = ru.QuestionId
left join TopTagsByQuestionCount tt on tt.TagName = (
    select tag from (
        select
            regexp_split_to_table(
                substring(ru.Tags FROM 2 FOR length(ru.Tags) - 2),
                '><'
            ) as tag
    ) t
    limit 1
)
where ru.QuestionRank <= 5

union

select
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    u.Location,
    0 as TotalComments,
    0 as DistinctPostsCommented,
    null::bigint as QuestionId,
    null as Title,
    null as QuestionScore,
    null as QuestionViews,
    null::bigint as AnswerId,
    null as AnswerScore,
    null as BadgeName,
    null as BadgeClass,
    null as LastEditDate,
    0 as AnswerCount,
    0 as TotalUpVotesOnAnswers,
    0 as TotalDownVotesOnAnswers,
    null as PopularTag,
    null as QuestionPopularityRank
from Users u
where not exists (
    select 1 from Posts p where p.OwnerUserId = u.Id and p.PostTypeId = 1
)
order by Reputation desc, DisplayName
limit 100;