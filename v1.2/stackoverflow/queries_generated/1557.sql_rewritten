with RecursiveTagHierarchy as (
    select 
        t.Id,
        t.TagName,
        0 as Level,
        coalesce((select w.Score from Posts w where w.Id = t.ExcerptPostId), 0) as TagScore
    from 
        Tags t
    where 
        t.IsModeratorOnly = 0
    union all
    select
        th.Id,
        th.TagName,
        th.Level + 1,
        th.TagScore
    from
        RecursiveTagHierarchy th
    join
        Tags t on t.Id = th.Id
    where
        Level < 3
),
BadgedUsersCTE as (
    select 
        b.UserId,
        count(distinct case when b.Class = 1 then b.Id else null end) as GoldBadges,
        count(distinct case when b.Class = 2 then b.Id else null end) as SilverBadges,
        count(distinct case when b.Class = 3 then b.Id else null end) as BronzeBadges,
        count(distinct b.Id) BadgeCount
    from
        Badges b
    group by 
        b.UserId
),
TopPostsbyComplexity as (
    select 
        p.Id as PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        pt.Name as PostTypeName,
        count(distinct ph.PostHistoryTypeId) as DistinctHistoryEvents,
        count(distinct c.Id) as CommentCount,
        prefix_tag.tag_names,
        row_number() over(partition by p.PostTypeId order by p.Score desc, p.ViewCount desc) as RankHigher scored post per PostType
    from 
        Posts p
    left join 
        PostHistory ph on p.Id = ph.PostId
    left join 
        Comments c on c.PostId = p.Id
    left join lateral (
        select listagg(name, ',') within group (order by name) as tag_names
        from (
            select unnest(
                string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><')
            ) as name
        ) tAllTags
        where tAllTags.name is not null and length(tAllTags.name) > 0
    ) prefix_tag on true
    join 
        PostTypes pt on p.PostTypeId = pt.Id
    where 
        p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
    group by 
        p.Id, p.PostTypeId, p.OwnerUserId, p.Title, p.CreationDate, p.Score, p.ViewCount, pt.Name, prefix_tag.tag_names
),
UserActivityAgg as (
    select 
        u.Id, 
        u.DisplayName, 
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        ba.GoldBadges,
        ba.SilverBadges,
        ba.BronzeBadges,
        ba.BadgeCount,
        coalesce(user_posts.NumPosts,0) NumPosts,
        coalesce(user_comments.NumComments,0) NumComments,
        coalesce(user_votes.NumVotes,0) NumVotes
    from 
        Users u
    left join 
        BadgedUsersCTE ba on u.Id = ba.UserId
    left join  
        (
            select OwnerUserId, count(*) NumPosts 
            from Posts where OwnerUserId is not null group by OwnerUserId
        ) user_posts on user_posts.OwnerUserId = u.Id
    left join 
        (
            select UserId, count(*) NumComments 
            from Comments group by UserId 
        ) user_comments on user_comments.UserId = u.Id
    left join
        (
            select UserId, count(*) NumVotes 
            from Votes where UserId is not null group by UserId
        ) user_votes on user_votes.UserId = u.Id
),
