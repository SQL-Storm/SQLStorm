WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 AS Level
    FROM Tags t
    WHERE t.IsRequired = TRUE

    UNION ALL

    SELECT 
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        t2.IsModeratorOnly,
        t2.IsRequired,
        r.Level + 1
    FROM Tags t2
    JOIN RecursiveTagHierarchy r ON t2.Id = r.Id + 1
    WHERE r.Level < 5
),
UserBadgeStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COALESCE(SUM(CASE WHEN b.TagBased = TRUE THEN 1 ELSE 0 END), 0) AS TagBasedBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
PostWithAnswerStats AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.AcceptedAnswerId,
        p.AnswerCount,
        p.FavoriteCount,
        p.ClosedDate,
        (SELECT COUNT(*) 
         FROM Comments c 
         WHERE c.PostId = p.Id AND c.Score > 0) AS PositiveCommentCount,
        (SELECT AVG(CAST(v.VoteTypeId AS NUMERIC)) 
         FROM Votes v 
         WHERE v.PostId = p.Id AND v.VoteTypeId IN (2,3)) AS AvgVoteType,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC NULLS LAST) AS UserTopPostRank
    FROM Posts p
    WHERE p.PostTypeId = 1
),
AnswerDetails AS (
    SELECT 
        a.Id,
        a.ParentId AS QuestionId,
        a.OwnerUserId,
        a.CreationDate,
        a.Score,
        a.Body,
        a.CommentCount,
        a.FavoriteCount,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC NULLS LAST, a.CreationDate ASC) AS AnswerRank,
        COUNT(*) OVER (PARTITION BY a.ParentId) AS TotalAnswers
    FROM Posts a
    WHERE a.PostTypeId = 2
),
QuestionAnswerSummary AS (
    SELECT 
        q.Id AS QuestionId,
        q.Title,
        q.Tags,
        q.CreationDate AS QuestionCreation,
        q.OwnerUserId AS QuestionOwner,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        q.FavoriteCount,
        q.PositiveCommentCount,
        q.ClosedDate,
        a.Id AS TopAnswerId,
        a.OwnerUserId AS TopAnswerOwner,
        a.Score AS TopAnswerScore,
        a.CreationDate AS TopAnswerCreation,
        a.AnswerRank,
        a.TotalAnswers
    FROM PostWithAnswerStats q
    LEFT JOIN AnswerDetails a ON a.QuestionId = q.Id AND a.AnswerRank = 1
),
UserActivityWindow AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) OVER (PARTITION BY u.Id ORDER BY u.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS QuestionsAsked,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) OVER (PARTITION BY u.Id ORDER BY u.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS AnswersGiven,
        AVG(p.Score) FILTER (WHERE p.OwnerUserId = u.Id) OVER (PARTITION BY u.Id) AS AvgPostScore,
        MAX(p.Score) FILTER (WHERE p.OwnerUserId = u.Id) OVER (PARTITION BY u.Id) AS MaxPostScore,
        COUNT(DISTINCT b.Id) OVER (PARTITION BY u.Id) AS TotalBadges
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
),
DuplicateQuestions AS (
    SELECT DISTINCT
        pl.PostId AS DuplicateQuestionId,
        pl.RelatedPostId AS OriginalQuestionId,
        p1.Title AS DuplicateTitle,
        p2.Title AS OriginalTitle,
        pl.CreationDate AS LinkCreated,
        lt.Name AS LinkTypeName
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    JOIN Posts p1 ON p1.Id = pl.PostId AND p1.PostTypeId = 1
    JOIN Posts p2 ON p2.Id = pl.RelatedPostId AND p2.PostTypeId = 1
    WHERE lt.Name = 'Duplicate'
),
ComplexFilteredPosts AS (
    SELECT 
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        ph.PostHistoryTypeId,
        ph.CreationDate AS HistoryDate,
        ph.Comment AS CloseReason,
        ph.UserId AS EditorUserId,
        u.DisplayName AS EditorName,
        ROW_NUMBER() OVER (PARTITION BY p.Id ORDER BY ph.CreationDate DESC) AS HistoryRank
    FROM Posts p
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId IN (10, 11)
    LEFT JOIN Users u ON u.Id = ph.UserId
    WHERE p.PostTypeId = 1
      AND (p.Score > 10 OR p.ViewCount > 1000)
      AND (ph.PostHistoryTypeId IS NULL OR ph.CreationDate > p.CreationDate)
),
FinalAggregatedStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COALESCE(ubs.GoldBadges, 0) AS GoldBadges,
        COALESCE(ubs.SilverBadges, 0) AS SilverBadges,
        COALESCE(ubs.BronzeBadges, 0) AS BronzeBadges,
        COALESCE(u.Reputation, 0) AS Reputation,
        COALESCE(u.Views, 0) AS Views,
        COALESCE(u.UpVotes, 0) AS UpVotes,
        COALESCE(u.DownVotes, 0) AS DownVotes,
        COALESCE(ua.QuestionsAsked, 0) AS QuestionsAsked,
        COALESCE(ua.AnswersGiven, 0) AS AnswersGiven,
        COALESCE(ua.AvgPostScore, 0) AS AvgPostScore,
        COALESCE(ua.MaxPostScore, 0) AS MaxPostScore,
        COALESCE(ua.TotalBadges, 0) AS TotalBadges,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS TotalQuestions,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS TotalAnswers,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS TotalUpVotes,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) AS TotalDownVotes
    FROM Users u
    LEFT JOIN UserBadgeStats ubs ON ubs.UserId = u.Id
    LEFT JOIN UserActivityWindow ua ON ua.UserId = u.Id
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, ubs.GoldBadges, ubs.SilverBadges, ubs.BronzeBadges, u.Reputation, u.Views, u.UpVotes, u.DownVotes,
             ua.QuestionsAsked, ua.AnswersGiven, ua.AvgPostScore, ua.MaxPostScore, ua.TotalBadges
)
SELECT 
    fas.UserId,
    fas.DisplayName,
    fas.Reputation,
    fas.GoldBadges,
    fas.SilverBadges,
    fas.BronzeBadges,
    fas.TotalBadges,
    fas.QuestionsAsked,
    fas.AnswersGiven,
    fas.AvgPostScore,
    fas.MaxPostScore,
    fas.TotalQuestions,
    fas.TotalAnswers,
    fas.TotalComments,
    fas.TotalUpVotes,
    fas.TotalDownVotes,
    qas.QuestionId,
    qas.Title AS QuestionTitle,
    qas.Tags,
    qas.QuestionCreation,
    qas.QuestionScore,
    qas.ViewCount,
    qas.AnswerCount,
    qas.FavoriteCount,
    qas.ClosedDate,
    qas.TopAnswerId,
    qas.TopAnswerOwner,
    qas.TopAnswerScore,
    qas.TopAnswerCreation,
    qas.TotalAnswers AS TotalAnswersForQuestion,
    dt.DuplicateQuestionId,
    dt.OriginalQuestionId,
    dt.DuplicateTitle,
    dt.OriginalTitle,
    dt.LinkCreated,
    dt.LinkTypeName,
    cfp.PostHistoryTypeId,
    cfp.HistoryDate,
    cfp.CloseReason,
    cfp.EditorUserId,
    cfp.EditorName
FROM FinalAggregatedStats fas
LEFT JOIN QuestionAnswerSummary qas ON qas.QuestionOwner = fas.UserId
LEFT JOIN DuplicateQuestions dt ON dt.DuplicateQuestionId = qas.QuestionId
LEFT JOIN ComplexFilteredPosts cfp ON cfp.OwnerUserId = fas.UserId
WHERE fas.Reputation > 1000
  AND (COALESCE(qas.QuestionScore, 0) > 5 OR COALESCE(qas.TopAnswerScore, 0) > 10)
ORDER BY fas.Reputation DESC, qas.QuestionCreation DESC
LIMIT 100;