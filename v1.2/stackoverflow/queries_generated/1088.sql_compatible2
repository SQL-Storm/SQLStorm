WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        0 AS Level,
        CAST(t.TagName AS VARCHAR(100)) AS FullPath
    FROM
        Tags t
    WHERE
        t.IsModeratorOnly = FALSE
        AND t.IsRequired = FALSE
    UNION ALL
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        r.Level + 1,
        CAST(r.FullPath || ' > ' || t.TagName AS VARCHAR(100))
    FROM
        Tags t
        JOIN RecursiveTagHierarchy r ON t.ExcerptPostId = r.Id
    WHERE
        t.IsModeratorOnly = FALSE
        AND t.IsRequired = FALSE
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT ph.Id) FILTER (WHERE ph.PostHistoryTypeId IN (10, 11)) AS CloseReopenEvents,
        AVG(COALESCE(p.Score, 0)) AS AvgPostScore,
        MAX(p.CreationDate) AS LatestPostDate,
        SUM(COALESCE(v_up.CountUpVotes,0)) AS TotalUpVotes,
        SUM(COALESCE(v_down.CountDownVotes,0)) AS TotalDownVotes,
        MAX(b_g.MaxBadgeClass) AS HighestBadgeClass
    FROM
        Users u
        LEFT JOIN Posts p ON p.OwnerUserId = u.Id
        LEFT JOIN PostHistory ph ON ph.UserId = u.Id
        LEFT JOIN (
            SELECT 
                PostId,
                COUNT(*) AS CountUpVotes
            FROM Votes v
            WHERE v.VoteTypeId = 2
            GROUP BY PostId
        ) v_up ON v_up.PostId = p.Id
        LEFT JOIN (
            SELECT 
                PostId,
                COUNT(*) AS CountDownVotes
            FROM Votes v
            WHERE v.VoteTypeId = 3
            GROUP BY PostId
        ) v_down ON v_down.PostId = p.Id
        LEFT JOIN (
            SELECT UserId, MAX(Class) AS MaxBadgeClass
            FROM Badges GROUP BY UserId
        ) b_g ON b_g.UserId = u.Id
    WHERE
        u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName
),
TopQuestions AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.AcceptedAnswerId,
        p.OwnerUserId,
        u.DisplayName AS OwnerName,
        COUNT(DISTINCT c.Id) AS CommentCount,
        SUM(COALESCE(v_vote_count.TotalVotes,0)) AS TotalVotes,
        AVG(COALESCE(a.Score,0)) AS AvgAnswerScore,
        MAX(a.CreationDate) AS LastAnswerDate
    FROM
        Posts p
        LEFT JOIN Comments c ON c.PostId = p.Id
        LEFT JOIN Votes v_vote_count ON v_vote_count.PostId = p.Id
        LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
        LEFT JOIN Users u ON u.Id = p.OwnerUserId
    WHERE
        p.PostTypeId = 1
        AND p.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '365 days')
    GROUP BY
        p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount, p.Tags, p.AcceptedAnswerId, p.OwnerUserId, u.DisplayName
    HAVING
        SUM(COALESCE(v_vote_count.TotalVotes,0)) > 10
),
VotesWithWindow AS (
    SELECT
        v.PostId,
        v.VoteTypeId,
        COUNT(*) OVER (PARTITION BY v.PostId, v.VoteTypeId) AS VoteCount,
        ROW_NUMBER() OVER (PARTITION BY v.PostId ORDER BY v.CreationDate DESC) AS VoteRecencyRank
    FROM Votes v
),
FilteredVotes AS (
    SELECT DISTINCT
        PostId,
        VoteTypeId,
        VoteCount
    FROM VotesWithWindow
    WHERE VoteRecencyRank = 1
),
MergeQuestionsAndUsers AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.Score,
        q.ViewCount,
        q.CommentCount,
        q.TotalVotes,
        q.AcceptedAnswerId,
        u.UserId,
        u.DisplayName,
        u.TotalPosts,
        u.CloseReopenEvents,
        u.AvgPostScore,
        u.LatestPostDate,
        u.TotalUpVotes,
        u.TotalDownVotes,
        u.HighestBadgeClass,
        q.OwnerUserId
    FROM TopQuestions q
    LEFT JOIN UserActivity u ON u.UserId = q.OwnerUserId
),
FinalAggregation AS (
    SELECT
        mq.QuestionId,
        mq.Title,
        mq.Score,
        mq.ViewCount,
        mq.TotalVotes,
        mq.CommentCount,
        mq.AcceptedAnswerId,
        mq.UserId,
        mq.DisplayName,
        mq.TotalPosts,
        mq.CloseReopenEvents,
        mq.AvgPostScore,
        mq.LatestPostDate,
        mq.TotalUpVotes,
        mq.TotalDownVotes,
        mq.HighestBadgeClass,
        STRING_AGG(DISTINCT rt.TagName, '|') FILTER (WHERE rt.Level = 0) AS RootTags,
        STRING_AGG(DISTINCT rt.FullPath, ', ') FILTER (WHERE rt.Level > 0) AS TagPaths
    FROM
        MergeQuestionsAndUsers mq
        LEFT JOIN RecursiveTagHierarchy rt ON POSITION(rt.TagName IN COALESCE(mq.Title, '')) > 0
    GROUP BY
        mq.QuestionId,
        mq.Title,
        mq.Score,
        mq.ViewCount,
        mq.TotalVotes,
        mq.CommentCount,
        mq.AcceptedAnswerId,
        mq.UserId,
        mq.DisplayName,
        mq.TotalPosts,
        mq.CloseReopenEvents,
        mq.AvgPostScore,
        mq.LatestPostDate,
        mq.TotalUpVotes,
        mq.TotalDownVotes,
        mq.HighestBadgeClass
)
SELECT DISTINCT
    fa.QuestionId,
    fa.Title,
    fa.Score,
    fa.ViewCount,
    fa.TotalVotes,
    fa.CommentCount,
    fa.AcceptedAnswerId,
    fa.UserId,
    fa.DisplayName,
    fa.TotalPosts,
    fa.CloseReopenEvents,
    fa.AvgPostScore,
    fa.LatestPostDate,
    fa.TotalUpVotes,
    fa.TotalDownVotes,
    CASE
        WHEN fa.HighestBadgeClass = 1 THEN 'Gold'
        WHEN fa.HighestBadgeClass = 2 THEN 'Silver'
        WHEN fa.HighestBadgeClass = 3 THEN 'Bronze'
        ELSE 'None'
    END AS BadgeClassName,
    fa.RootTags,
    fa.TagPaths,
    EXISTS (
        SELECT 1
        FROM PostLinks pl
        WHERE pl.PostId = fa.QuestionId
            AND pl.LinkTypeId = 3
            AND EXISTS (
                SELECT 1 
                FROM Posts p2 
                WHERE p2.Id = pl.RelatedPostId
                    AND p2.Score > fa.Score + 10
            )
    ) AS HasHighlyScoredDuplicateLink,
    TRIM(BOTH ' ' FROM REGEXP_REPLACE(COALESCE(fa.Title, ''), '<[^>]*>', '', 'g')) || ' [' ||
    COALESCE(fa.DisplayName, 'Anonymous') || ']' AS CleanedTitleWithOwner,
    (SELECT COUNT(*)
     FROM Posts a2
     WHERE a2.ParentId = fa.AcceptedAnswerId) AS AnswersToAcceptedAnswer
FROM FinalAggregation fa
WHERE
    (fa.ViewCount > 1000 OR fa.Score > 50)
    AND fa.TotalUpVotes - fa.TotalDownVotes > 10
    AND (fa.CloseReopenEvents IS NULL OR fa.CloseReopenEvents < 3)
ORDER BY
    fa.TotalVotes DESC,
    fa.ViewCount DESC
LIMIT 100;