WITH RecursiveTagHierarchy AS (
    SELECT 
        t.Id, 
        t.TagName, 
        t.Count, 
        t.ExcerptPostId, 
        t.WikiPostId,
        1 AS Level
    FROM Tags t
    WHERE t.IsRequired = 1
    UNION ALL
    SELECT 
        t2.Id,
        t2.TagName, 
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        r.Level + 1
    FROM Tags t2
    JOIN RecursiveTagHierarchy r ON t2.Id = r.Id + 1
    WHERE r.Level < 3
),
UserBadgeStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) AS TotalBadges,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.DisplayName
),
QuestionAnswerDetails AS (
    SELECT 
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate AS QuestionCreated,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.Tags,
        q.OwnerUserId,
        u.DisplayName AS OwnerName,
        q.AcceptedAnswerId,
        a.Id AS AnswerId,
        a.Score AS AnswerScore,
        a.CreationDate AS AnswerCreated,
        a.OwnerUserId AS AnswerOwnerUserId,
        au.DisplayName AS AnswerOwnerName,
        ROW_NUMBER() OVER (PARTITION BY q.Id ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN Users u ON q.OwnerUserId = u.Id
    LEFT JOIN Users au ON a.OwnerUserId = au.Id
    WHERE q.PostTypeId = 1
),
TopAnswersCTE AS (
    SELECT DISTINCT
        QuestionId,
        AnswerId,
        AnswerScore,
        AnswerCreated,
        AnswerOwnerUserId,
        AnswerOwnerName
    FROM QuestionAnswerDetails
    WHERE AnswerRank = 1
),
PostCloseInfo AS (
    SELECT
        ph.PostId,
        crt.Name AS CloseReason,
        ph.CreationDate AS CloseDate
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON TRY_CAST(ph.Comment AS INT) = crt.Id
    WHERE ph.PostHistoryTypeId = 10
),
UserActivityWindow AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        v.VoteTypeId,
        COUNT(v.Id) AS VoteCount,
        SUM(COALESCE(p.Score,0)) AS TotalPostScore,
        RANK() OVER (PARTITION BY u.Id ORDER BY COUNT(v.Id) DESC) AS VoteRank
    FROM Users u
    LEFT JOIN Votes v ON u.Id = v.UserId
    LEFT JOIN Posts p ON p.Id = v.PostId
    GROUP BY u.Id, u.DisplayName, v.VoteTypeId
),
ActiveUsers AS (
    SELECT DISTINCT UA.UserId, UA.DisplayName
    FROM UserActivityWindow UA
    WHERE UA.VoteRank = 1 AND UA.VoteTypeId = 2 AND UA.VoteCount > 50
),
AggregatedComments AS (
    SELECT 
        c.PostId,
        COUNT(c.Id) AS CommentCount,
        MAX(c.CreationDate) AS LastCommentDate,
        STRING_AGG(DISTINCT COALESCE(c.UserDisplayName, 'Anonymous'), ', ' ORDER BY c.UserDisplayName) AS Commenters
    FROM Comments c
    GROUP BY c.PostId
),
PostsWithLinks AS (
    SELECT 
        pl.PostId,
        COUNT(pl.RelatedPostId) FILTER (WHERE pl.LinkTypeId = 1) AS OutgoingLinks,
        COUNT(pl.PostId) FILTER (WHERE pl.LinkTypeId = 3) AS DuplicateLinks
    FROM PostLinks pl
    GROUP BY pl.PostId
)
SELECT
    qad.QuestionId,
    qad.Title,
    qad.QuestionCreated,
    qad.QuestionScore,
    qad.ViewCount,
    qad.Tags,
    COALESCE(qad.OwnerName, 'Unknown') AS QuestionOwner,
    tb.AnswerId AS TopAnswerId,
    tb.AnswerScore AS TopAnswerScore,
    tb.AnswerCreated AS TopAnswerCreated,
    COALESCE(tb.AnswerOwnerName, 'Unknown') AS TopAnswerOwner,
    ub.TotalBadges,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    pc.CloseReason,
    pc.CloseDate,
    ac.CommentCount,
    ac.LastCommentDate,
    ac.Commenters,
    pl.OutgoingLinks,
    pl.DuplicateLinks,
    ROW_NUMBER() OVER (
        PARTITION BY 
            COALESCE(qad.OwnerUserId, 0)
        ORDER BY qad.QuestionScore DESC, qad.ViewCount DESC
    ) AS QuestionOwnerRank,
    CASE 
        WHEN qad.AcceptedAnswerId IS NOT NULL THEN 'Accepted Answer Present'
        ELSE 'No Accepted Answer'
    END AS AcceptanceStatus,
    COALESCE(uas.DisplayName, 'Inactive') AS ActiveAnswerOwnerStatus,
    LENGTH(qad.Tags) - LENGTH(REPLACE(qad.Tags, '><', '')) + 1 AS TagCount,
    CONCAT(
        LOWER(SUBSTRING(qad.Title FROM 1 FOR 1)),
        SUBSTRING(qad.Title FROM 2)
    ) || ' [' || COALESCE(pc.CloseReason, 'Open') || ']' AS TitleProcessed
FROM QuestionAnswerDetails qad
LEFT JOIN TopAnswersCTE tb ON qad.Id = tb.QuestionId AND tb.AnswerRank = 1
LEFT JOIN UserBadgeStats ub ON ub.UserId = qad.OwnerUserId
LEFT JOIN PostCloseInfo pc ON pc.PostId = qad.QuestionId
LEFT JOIN AggregatedComments ac ON ac.PostId = qad.QuestionId
LEFT JOIN PostsWithLinks pl ON pl.PostId = qad.QuestionId
LEFT JOIN ActiveUsers uas ON uas.UserId = tb.AnswerOwnerUserId
WHERE qad.CreationDate > cast('2024-10-01' as date) - INTERVAL '365 days'
  AND (
      (qad.Tags LIKE '%<sql>%') OR 
      (qad.Tags LIKE '%<database>%') OR
      (qad.Tags IS NULL)
  )
ORDER BY qad.QuestionScore DESC, ac.CommentCount DESC
LIMIT 100
UNION
SELECT
    NULL,
    'Excluded Questions Summary',
    NULL,
    SUM(qad.QuestionScore),
    SUM(qad.ViewCount),
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL
FROM QuestionAnswerDetails qad
WHERE qad.CreationDate > cast('2024-10-01' as date) - INTERVAL '365 days'
  AND NOT (
      (qad.Tags LIKE '%<sql>%') OR 
      (qad.Tags LIKE '%<database>%') OR
      (qad.Tags IS NULL)
  );