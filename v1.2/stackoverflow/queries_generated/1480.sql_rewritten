-- {"query": "1480.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.4, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1468} 
WITH RecentQuestions AS (
    SELECT 
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        u.Reputation AS OwnerReputation,
        u.Location,
        COALESCE(
           NULLIF(p.Tags, ''), 
           (SELECT STRING_AGG(t.TagName, '|') FROM Tags t WHERE t.ExcerptPostId = p.Id OR t.WikiPostId = p.Id)
        ) AS TagsString,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS OwnerRecentQuestionRank
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1
      AND p.CreationDate > cast('2024-10-01' as date) - INTERVAL '180 days'
),
UserBadgesCount AS (
    SELECT
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        MAX(b.Date) AS MostRecentBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
AnswersStats AS (
    SELECT
        a.ParentId AS QuestionId,
        COUNT(*) AS TotalAnswers,
        AVG(a.Score) AS AvgAnswerScore,
        SUM(CASE WHEN a.Score > 10 THEN 1 ELSE 0 END) AS HighScoreAnswers,
        MAX((SELECT COUNT(*) FROM Comments c WHERE c.PostId = a.Id)) AS MaxCommentsOnAnswer
    FROM Posts a
    WHERE a.PostTypeId = 2
    GROUP BY a.ParentId
),
QuestionVoteStats AS (
    SELECT
        p.Id AS QuestionId,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpVotes,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownVotes,
        COUNT(v.Id) AS TotalVotes,
        SUM(CASE WHEN v.VoteTypeId = 8 THEN v.BountyAmount ELSE 0 END) AS TotalBounty
    FROM Posts p
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.PostTypeId = 1
    GROUP BY p.Id
),
ComplexLinkedDuplicates AS (
    SELECT 
        q.Id AS QuestionId,
        COUNT(DISTINCT pl.RelatedPostId) AS DuplicateCount,
        STRING_AGG(DISTINCT LOWER(t.TagName), ',' ORDER BY t.TagName) AS DuplicatesTags
    FROM Posts q
    LEFT JOIN PostLinks pl ON pl.PostId = q.Id AND pl.LinkTypeId = 3 -- duplication link
    LEFT JOIN Posts dup ON dup.Id = pl.RelatedPostId
    LEFT JOIN LATERAL (
        SELECT unnest(string_to_array(TRIM(BOTH '<>' FROM COALESCE(dup.Tags, '')), '><')) AS TagName
    ) sub_tags(tn) ON TRUE
    LEFT JOIN Tags t ON t.TagName = sub_tags.tn.TagName
    WHERE q.PostTypeId = 1
    GROUP BY q.Id
    HAVING COUNT(DISTINCT pl.RelatedPostId) > 0
),
UserActivityRanked AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsCount,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersCount,
        COUNT(c.Id) AS CommentsCount,
        RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        MAX(max_scores.MaxPostScore) AS MaxPostScore
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN (
        SELECT OwnerUserId, MAX(Score) AS MaxPostScore
        FROM Posts
        GROUP BY OwnerUserId
    ) max_scores ON max_scores.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
)
SELECT
    rq.Id AS QuestionId,
    rq.Title,
    rq.OwnerUserId,
    COALESCE(u.DisplayName, rq.OwnerDisplayName) AS OwnerName,
    u.Location,
    rq.CreatedDate,
    rq.Score AS QuestionScore,
    rq.ViewCount,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    rb.MostRecentBadgeDate,
    COALESCE(as.TotalAnswers, 0) AS AnswerCount,
    COALESCE(as.AvgAnswerScore, 0.0) AS AverageAnswerScore,
    COALESCE(as.HighScoreAnswers, 0) AS HighScoreAnswerCount,
    COALESCE(as.MaxCommentsOnAnswer, 0) AS MaxCommentsPerAnswer,
    qvs.UpVotes AS QuestionUpVotes,
    qvs.DownVotes AS QuestionDownVotes,
    qvs.TotalVotes AS TotalQuestionVotes,
    qvs.TotalBounty,
    cld.DuplicateCount,
    cld.DuplicatesTags,
    (case 
        when u.Reputation >= 20000 then 'Top3%'
        when u.Reputation >= 5000 then 'Top10%'
        when u.Reputation >= 1000 then 'Experienced'
        when u.Reputation IS NULL then 'Unknown'
        else 'Newbie'
     end) AS ReputationCategory,
    ua.QuestionsCount,
    ua.AnswersCount,
    ua.CommentsCount,
    ua.ReputationRank,
    ua.MaxPostScore
FROM RecentQuestions rq
LEFT JOIN Users u ON u.Id = rq.OwnerUserId
LEFT JOIN UserBadgesCount ub ON ub.UserId = rq.OwnerUserId
LEFT JOIN RecentQuestions rbq ON rbq.OwnerUserId = rq.OwnerUserId -- complex sublock to identify last badge (dummy usage)
LEFT JOIN UserBadgesCount rb ON rb.UserId = rq.OwnerUserId
LEFT JOIN AnswersStats as ON as.QuestionId = rq.Id
LEFT JOIN QuestionVoteStats qvs ON qvs.QuestionId = rq.Id
LEFT JOIN ComplexLinkedDuplicates cld ON cld.QuestionId = rq.Id
LEFT JOIN UserActivityRanked ua ON ua.Id = rq.OwnerUserId
WHERE rq.OwnerRecentQuestionRank <= 3
  AND (
    -- complex filters including NULL logic and string expressions
    (rq.Score > 5 OR (rq.ViewCount > 1000 AND rq.Score IS NULL)) AND
    CASE 
      WHEN u.Location IS NOT NULL THEN POSITION('united states' IN LOWER(u.Location)) > 0
      ELSE FALSE
    END
  )
ORDER BY ua.ReputationRank NULLS LAST, rq.Score DESC, rq.CreationDate DESC
LIMIT 100;