with RecursiveTagCounts as (
    select
        p.Id PostId,
        unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><')) TagName
    from Posts p
    where p.PostTypeId = 1 and p.Tags is not null
),
TagUsageRanks as (
    select
        r.TagName,
        count(distinct r.PostId) TagUsageCount,
        dense_rank() over (order by count(distinct r.PostId) desc) UsageRank
    from RecursiveTagCounts r
    group by r.TagName
),
UserBadgeAgg as (
    select
        u.Id UserId,
        count(b.Id) total_badges,
        count(case when b.Class = 1 then 1 end) gold_badges,
        count(case when b.Class = 2 then 1 end) silver_badges,
        count(case when b.Class = 3 then 1 end) bronze_badges,
