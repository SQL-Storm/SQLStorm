with recursive UserActivityBuckets as (
    select 
        u.Id as UserId,
        u.DisplayName,
        extract(year from u.CreationDate) as YearCreated,
        date_trunc('month', u.CreationDate) as CreationMonth,
        coalesce(u.Reputation, 0) as Reputation,
        coalesce(u.Views, 0) as Views,
        coalesce(u.UpVotes, 0) as UpVotes,
        coalesce(u.DownVotes, 0) as DownVotes,
        1 as ActivityCount
    from Users u
    where u.CreationDate is not null
    union all
    select 
        u.UserId,
        u.DisplayName,
        u.YearCreated,
        u.CreationMonth,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.ActivityCount + 1
    from UserActivityBuckets u
    join Users u2 on u.UserId = u2.Id
    where u.ActivityCount < 1
),
BadgeSummary as (
    select 
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        count(*) filter (where b.TagBased = 1) as TagBasedBadges
    from Badges b
    group by b.UserId
),
PostQuestionStats as (
    select 
        p.OwnerUserId as UserId,
        count(distinct p.Id) as QuestionCount,
        avg(p.Score) as AvgQuestionScore,
        count(distinct case when p.AcceptedAnswerId is not null then p.Id end) as QuestionWithAcceptedAnswer,
        max(p.ViewCount) as MaxQuestionViewCount,
        string_agg(distinct coalesce(p.Tags, ''), '><') as AllTagsConcatenated
    from Posts p
    where p.PostTypeId = 1
      and p.OwnerUserId is not null
    group by p.OwnerUserId
),
PostAnswerStats as (
    select 
        p.OwnerUserId as UserId,
        count(distinct p.Id) as AnswerCount,
        avg(p.Score) as AvgAnswerScore,
        max(p.Score) as MaxAnswerScore,
        coalesce(sum(case when exists (
            select 1 from Posts q where q.AcceptedAnswerId = p.Id
        ) then 1 else 0 end), 0) as AnswersAcceptedCount
    from Posts p
    where p.PostTypeId = 2
      and p.OwnerUserId is not null
    group by p.OwnerUserId
),
UserActivityRanking as (
    select 
        u.Id as UserId,
        u.DisplayName,
        psa.QuestionCount,
        psa.AvgQuestionScore,
        psa.QuestionWithAcceptedAnswer,
        psa.MaxQuestionViewCount,
        pas.AnswerCount,
        pas.AvgAnswerScore,
        pas.MaxAnswerScore,
        pas.AnswersAcceptedCount,
        bs.GoldBadges,
        bs.SilverBadges,
        bs.BronzeBadges,
        bs.TagBasedBadges,
        dense_rank() over (order by psa.QuestionCount desc nulls last, pas.AnswerCount desc nulls last, bs.GoldBadges desc nulls last) as UserRank,
        u.Reputation
    from Users u
    left join PostQuestionStats psa on u.Id = psa.UserId
    left join PostAnswerStats pas on u.Id = pas.UserId
    left join BadgeSummary bs on u.Id = bs.UserId
),
CloseReasonCounts as (
    select 
        pht.Comment as CloseReasonId,
        crt.Name as CloseReason,
        count(1) as CloseCount
    from PostHistory pht
    inner join CloseReasonTypes crt on crt.Id = cast(pht.Comment as smallint)
    where pht.PostHistoryTypeId = 10
    group by pht.Comment, crt.Name
),
RecentCommentsPerUser as (
    select
        c.UserId,
        c.PostId,
        c.CreationDate,
        row_number() over (partition by c.UserId order by c.CreationDate desc) as CommentRank,
        substr(c.Text, 1, 50) as CommentPreview
    from Comments c
    where c.UserId is not null
),
TopUserComments as (
    select
        r.UserId,
        string_agg(distinct concat_ws(' | ', coalesce(p.Title, 'n/a'), coalesce(r.CommentPreview, '')), ', ') as RecentCommentsSummary
    from RecentCommentsPerUser r
    left join Posts p on p.Id = r.PostId
    where r.CommentRank <= 5
    group by r.UserId
)
select 
    uar.UserId,
    uar.DisplayName,
    uar.QuestionCount,
    round(cast(uar.AvgQuestionScore as numeric), 2) as AvgQuestionScore,
    uar.QuestionWithAcceptedAnswer,
    uar.MaxQuestionViewCount,
    uar.AnswerCount,
    round(cast(uar.AvgAnswerScore as numeric), 2) as AvgAnswerScore,
    uar.MaxAnswerScore,
    uar.AnswersAcceptedCount,
    uar.GoldBadges,
    uar.SilverBadges,
    uar.BronzeBadges,
    uar.TagBasedBadges,
    coalesce(tuc.RecentCommentsSummary, 'No recent comments') as RecentCommentsSummary,
    crc.CloseReason,
    crc.CloseCount,
    case
        when uar.AvgQuestionScore is null and uar.AvgAnswerScore is null then 'Inactive'
        when uar.AvgQuestionScore >= 5 or uar.AvgAnswerScore >= 5 then 'High Scorer'
        else 'Regular'
    end as UserCategory,
    rank() over (partition by 
        case
            when uar.AvgQuestionScore is null and uar.AvgAnswerScore is null then 'Inactive'
            when uar.AvgQuestionScore >= 5 or uar.AvgAnswerScore >= 5 then 'High Scorer'
            else 'Regular'
        end order by uar.Reputation desc nulls last) as CategoryRank
from UserActivityRanking uar
left join CloseReasonCounts crc on cast(crc.CloseReasonId as integer) = (
    select cast(pht.Comment as integer)
    from PostHistory pht
    where pht.UserId = uar.UserId and pht.PostHistoryTypeId = 10
    order by pht.CreationDate desc
    limit 1
)
left join TopUserComments tuc on tuc.UserId = uar.UserId
where uar.UserRank <= 500
order by uar.UserRank, UserCategory desc;