-- {"query": "916.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.9, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1875} 
WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        ARRAY[t.TagName] AS TagPath,
        1 AS Level
    FROM Tags t
    WHERE t.IsRequired = 1

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        child.Count,
        child.ExcerptPostId,
        child.WikiPostId,
        rh.TagPath || child.TagName,
        rh.Level + 1
    FROM Tags child
    INNER JOIN RecursiveTagHierarchy rh ON child.WikiPostId = rh.ExcerptPostId
    WHERE rh.Level < 5
),
UserActivitySummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsAsked,
        COUNT(DISTINCT p2.Id) FILTER (WHERE p2.PostTypeId = 2) AS AnswersGiven,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        COUNT(DISTINCT b.Id) AS BadgesEarned,
        SUM(COALESCE(vt_up.CountUpVotes, 0)) AS TotalUpVotesReceived,
        SUM(COALESCE(vt_down.CountDownVotes, 0)) AS TotalDownVotesReceived,
        AVG(COALESCE(p.Score, 0)) FILTER (WHERE p.PostTypeId IN (1, 2)) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        MIN(p.CreationDate) AS FirstPostDate,
        CASE WHEN u.Location IS NULL OR LENGTH(TRIM(u.Location)) = 0 THEN 'Unknown' ELSE u.Location END AS LocationCleaned
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Posts p2 ON p2.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    LEFT JOIN (
        SELECT
            p.OwnerUserId,
            COUNT(*) AS CountUpVotes
        FROM Votes v
        INNER JOIN Posts p ON p.Id = v.PostId
        WHERE v.VoteTypeId = 2 -- UpMod
        GROUP BY p.OwnerUserId
    ) vt_up ON vt_up.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT
            p.OwnerUserId,
            COUNT(*) AS CountDownVotes
        FROM Votes v
        INNER JOIN Posts p ON p.Id = v.PostId
        WHERE v.VoteTypeId = 3 -- DownMod
        GROUP BY p.OwnerUserId
    ) vt_down ON vt_down.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, LocationCleaned
),
TopPostsWithWindows AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        u.DisplayName AS OwnerDisplayName,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.ViewCount DESC) AS RankByType,
        COUNT(*) OVER (PARTITION BY p.PostTypeId) AS TotalPostsOfType,
        AVG(p.Score) OVER (PARTITION BY p.PostTypeId) AS AvgScoreByType,
        SUM(p.ViewCount) OVER (PARTITION BY p.PostTypeId) AS TotalViewsByType
    FROM Posts p
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
    WHERE p.PostTypeId IN (1, 2) -- Questions and Answers only
),
CorrelatedVotes AS (
    SELECT
        p.Id AS PostId,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS UpVotes,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS DownVotes,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCount,
        CASE 
            WHEN EXISTS (SELECT 1 FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10) THEN 1
            ELSE 0
        END AS IsClosed
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
ClosedDuplicateQuestions AS (
    SELECT DISTINCT p.Id, p.Title, p.Tags, ph.Comment AS CloseReasonCode, lt.Name AS CloseReasonName
    FROM Posts p
    INNER JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId = 10
    LEFT JOIN CloseReasonTypes lt ON lt.Id::varchar = ph.Comment
    WHERE p.PostTypeId = 1
      AND ph.Comment::int = 101 -- Duplicate close reason
),
RecentActivityCTE AS (
    SELECT
        p.Id AS PostId,
        GREATEST(p.CreationDate, COALESCE(p.LastEditDate, '1900-01-01'::timestamp), COALESCE(p.LastActivityDate, '1900-01-01'::timestamp)) AS LastActivity,
        LEAD(GREATEST(p.CreationDate, COALESCE(p.LastEditDate, '1900-01-01'::timestamp), COALESCE(p.LastActivityDate, '1900-01-01'::timestamp))) OVER (PARTITION BY p.OwnerUserId ORDER BY GREATEST(p.CreationDate, COALESCE(p.LastEditDate, '1900-01-01'::timestamp), COALESCE(p.LastActivityDate, '1900-01-01'::timestamp)) DESC) AS NextNewerActivity
    FROM Posts p
),
CombinedResults AS (
    SELECT
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.QuestionsAsked,
        uas.AnswersGiven,
        uas.BadgesEarned,
        uas.TotalUpVotesReceived,
        uas.TotalDownVotesReceived,
        uas.AvgPostScore,
        uas.LocationCleaned,
        tp.PostTypeId,
        tp.Id AS PostId,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        cv.UpVotes,
        cv.DownVotes,
        cv.CommentCount,
        cv.IsClosed,
        cd.CloseReasonName,
        rh.LastActivity,
        rh.NextNewerActivity,
        rh.LastActivity - rh.NextNewerActivity AS ActivityGapInterval,
        string_agg(DISTINCT tg.TagName, ',' ORDER BY tg.TagName) AS RelatedTagsHierarchy
    FROM UserActivitySummary uas
    LEFT JOIN TopPostsWithWindows tp ON tp.OwnerUserId = uas.UserId AND tp.RankByType <= 3
    LEFT JOIN CorrelatedVotes cv ON cv.PostId = tp.Id
    LEFT JOIN ClosedDuplicateQuestions cd ON cd.Id = tp.Id
    LEFT JOIN RecentActivityCTE rh ON rh.PostId = tp.Id
    LEFT JOIN RecursiveTagHierarchy tg ON tg.TagName = ANY(string_to_array(COALESCE(tp.Tags, ''), '><'))
    GROUP BY
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.QuestionsAsked,
        uas.AnswersGiven,
        uas.BadgesEarned,
        uas.TotalUpVotesReceived,
        uas.TotalDownVotesReceived,
        uas.AvgPostScore,
        uas.LocationCleaned,
        tp.PostTypeId,
        tp.Id,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        cv.UpVotes,
        cv.DownVotes,
        cv.CommentCount,
        cv.IsClosed,
        cd.CloseReasonName,
        rh.LastActivity,
        rh.NextNewerActivity,
        rh.ActivityGapInterval
)
SELECT
    UserId,
    DisplayName,
    Reputation,
    QuestionsAsked,
    AnswersGiven,
    BadgesEarned,
    TotalUpVotesReceived,
    TotalDownVotesReceived,
    COALESCE(AvgPostScore, 0)::numeric(10,2) AS AvgPostScore,
    LocationCleaned,
    PostTypeId,
    PostId,
    Title,
    Score,
    ViewCount,
    UpVotes,
    DownVotes,
    CommentCount,
    CASE WHEN IsClosed = 1 THEN 'Closed: ' || COALESCE(CloseReasonName, 'Unknown') ELSE 'Open' END AS PostStatus,
    LastActivity,
    NextNewerActivity,
    ActivityGapInterval,
    RelatedTagsHierarchy
FROM CombinedResults
WHERE Reputation > 1000
  AND (QuestionsAsked + AnswersGiven) > 10
  AND (Score > 0 OR (UpVotes - DownVotes) > 5)
ORDER BY Reputation DESC, Score DESC, ViewCount DESC
LIMIT 100;