with recursive RecursiveUserBadgeCounts as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        b.Class as BadgeClass,
        count(*) as BadgeCount
    from Users u
    left join Badges b on u.Id = b.UserId
    group by u.Id, u.DisplayName, u.Reputation, b.Class

    union all

    select
        r.UserId,
        r.DisplayName,
        r.Reputation,
        r.BadgeClass,
        r.BadgeCount
    from RecursiveUserBadgeCounts r
    where r.BadgeCount > 0
),
TopQuestions as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.AnswerCount,
        p.Tags,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc) as rn
    from Posts p
    where p.PostTypeId = 1
      and p.CreationDate > (cast('2024-10-01' as date) - interval '365 days')
),
TopAnswers as (
    select
        a.Id,
        a.ParentId,
        a.OwnerUserId,
        a.Score,
        a.CreationDate,
        p.Title as QuestionTitle,
        p.Tags as QuestionTags,
        dense_rank() over (partition by a.OwnerUserId order by a.Score desc) as dr
    from Posts a
    join Posts p on a.ParentId = p.Id
    where a.PostTypeId = 2
      and a.CreationDate > (cast('2024-10-01' as date) - interval '365 days')
),
PostEngagement as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        count(distinct c.Id) as CommentCount,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        case when p.ClosedDate is not null then 1 else 0 end as IsClosed,
        p.CreationDate
    from Posts p
    left join Comments c on c.PostId = p.Id
    left join Votes v on v.PostId = p.Id
    group by p.Id, p.PostTypeId, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount, p.ClosedDate, p.CreationDate
),
DuplicateLinks as (
    select
        pl.PostId,
        count(distinct pl.RelatedPostId) as DuplicateCount
    from PostLinks pl
    where pl.LinkTypeId = 3
    group by pl.PostId
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionsCount,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswersCount,
        count(distinct c.Id) as CommentsCount,
        count(distinct case when b.Class = 1 then b.Id end) as GoldBadges,
        count(distinct case when b.Class = 2 then b.Id end) as SilverBadges,
        count(distinct case when b.Class = 3 then b.Id end) as BronzeBadges,
        max(p.CreationDate) as LastPostDate,
        min(p.CreationDate) as FirstPostDate,
        count(distinct case when v.VoteTypeId in (2,3) then v.Id end) as VotesCast
    from Users u
    left join Posts p on p.OwnerUserId = u.Id and p.CreationDate > (cast('2024-10-01' as date) - interval '1 year')
    left join Comments c on c.UserId = u.Id and c.CreationDate > (cast('2024-10-01' as date) - interval '1 year')
    left join Badges b on b.UserId = u.Id
    left join Votes v on v.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
),
ComplexPostSummary as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        pe.CommentCount,
        pe.UpVotes,
        pe.DownVotes,
        coalesce(dl.DuplicateCount, 0) as DuplicateCount,
        case when p.AcceptedAnswerId is not null then 1 else 0 end as HasAcceptedAnswer,
        (char_length(coalesce(p.Tags, '')) - char_length(replace(coalesce(p.Tags, ''), '><', '')) + 1) as TagCount,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc) as UserPostRank
    from Posts p
    left join PostEngagement pe on pe.Id = p.Id
    left join DuplicateLinks dl on dl.PostId = p.Id
    where p.PostTypeId in (1, 2)
),
CorrelatedTopBadgedUsers as (
    select distinct
        u.Id,
        u.DisplayName,
        u.Reputation,
        (
            select count(*)
            from Badges b
            where b.UserId = u.Id
              and b.Date > (cast('2024-10-01' as date) - interval '1 year')
              and b.Class = 1
        ) as RecentGoldBadges,
        (
            select count(*)
            from Posts p
            where p.OwnerUserId = u.Id
              and p.Score > 10
              and p.CreationDate > (cast('2024-10-01' as date) - interval '1 year')
        ) as HighlyScoredPosts,
        (
            select count(*)
            from Votes v
            where v.UserId = u.Id
              and v.VoteTypeId = 2
              and v.CreationDate > (cast('2024-10-01' as date) - interval '1 year')
        ) as UpvotesCast
    from Users u
    where u.Reputation > 1000
)
select distinct
    ctsu.Id as UserId,
    ctsu.DisplayName,
    ctsu.Reputation,
    ctsu.RecentGoldBadges,
    ctsu.HighlyScoredPosts,
    ctsu.UpvotesCast,
    ua.QuestionsCount,
    ua.AnswersCount,
    ua.CommentsCount,
    ua.GoldBadges,
    ua.SilverBadges,
    ua.BronzeBadges,
    ua.LastPostDate,
    ua.FirstPostDate,
    ps.Id as PostId,
    ps.Title as PostTitle,
    ps.CreationDate as PostCreationDate,
    ps.Score as PostScore,
    ps.ViewCount as PostViews,
    ps.CommentCount as PostComments,
    ps.UpVotes as PostUpVotes,
    ps.DownVotes as PostDownVotes,
    ps.DuplicateCount as PostDuplicateLinks,
    ps.HasAcceptedAnswer,
    ps.TagCount,
    ps.UserPostRank,
    case
        when ps.Score > 50 and ps.ViewCount > 1000 then 'HighImpact'
        when ps.Score between 10 and 50 then 'MediumImpact'
        else 'LowImpact'
    end as PostImpactCategory,
    case
        when ua.LastPostDate is not null and ua.FirstPostDate is not null then
            extract(day from (ua.LastPostDate - ua.FirstPostDate)) / greatest(nullif(ua.QuestionsCount + ua.AnswersCount, 0), 1)::numeric
        else null
    end as AvgDaysBetweenPosts,
    case
        when coalesce(ps.TagCount,0) > 3 and ps.Score > 5 then
            substring(ps.Title from 1 for 15) || '...'
        else ps.Title
    end as ShortTitle
from CorrelatedTopBadgedUsers ctsu
left join UserActivityWindow ua on ua.UserId = ctsu.Id
left join ComplexPostSummary ps on ps.OwnerUserId = ctsu.Id
where ps.UserPostRank <= 3
order by ctsu.Reputation desc, ps.Score desc, ps.ViewCount desc;