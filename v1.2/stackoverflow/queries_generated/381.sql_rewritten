-- {"query": "381.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.3, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1476} 
with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 as Level,
        cast(t.TagName as varchar(1000)) as Path
    from Tags t
    where t.IsModeratorOnly = 0 and t.IsRequired = 0

    union all

    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        r.Level + 1,
        r.Path || ' > ' || t.TagName
    from Tags t
    inner join RecursiveTagHierarchy r on t.Id = r.Id + 1
    where r.Level < 3
),
UserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionsAsked,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswersGiven,
        count(distinct c.Id) as CommentsMade,
        coalesce(sum(v.BountyAmount), 0) as TotalBountyGiven,
        max(p.Score) filter (where p.PostTypeId = 2) as MaxAnswerScore,
        min(p.CreationDate) as FirstPostDate,
        max(p.LastActivityDate) as LastActivityDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Votes v on v.UserId = u.Id and v.VoteTypeId = 8 -- BountyStart
    group by u.Id, u.DisplayName, u.Reputation
),
PostWithBadges as (
    select
        p.Id as PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        b.Name as BadgeName,
        b.Class as BadgeClass,
        row_number() over (partition by p.Id order by b.Class) as BadgeRank
    from Posts p
    left join Badges b on b.UserId = p.OwnerUserId
    where p.PostTypeId in (1,2)
),
TopPosts as (
    select
        PostId,
        PostTypeId,
        OwnerUserId,
        CreationDate,
        Score,
        ViewCount,
        Tags,
        Title,
        BadgeName,
        BadgeClass
    from PostWithBadges
    where BadgeRank = 1
),
CloseReasonCounts as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        count(*) as CloseCount
    from PostHistory ph
    inner join PostHistoryTypes pht on ph.PostHistoryTypeId = pht.Id and pht.Name = 'Post Closed'
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as int)
    group by ph.PostId, crt.Name
),
AnswerStats as (
    select
        q.Id as QuestionId,
        count(a.Id) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore,
        sum(case when a.OwnerUserId is null then 1 else 0 end) as AnonymousAnswerCount,
        sum(case when a.Score > 10 then 1 else 0 end) as HighlyRatedAnswers
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id
),
UserRankings as (
    select
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.QuestionsAsked,
        ua.AnswersGiven,
        ua.CommentsMade,
        ua.TotalBountyGiven,
        ua.MaxAnswerScore,
        ua.FirstPostDate,
        ua.LastActivityDate,
        rank() over (order by ua.Reputation desc, ua.AnswersGiven desc) as ReputationRank,
        dense_rank() over (order by ua.QuestionsAsked desc) as QuestionsRank,
        row_number() over (order by ua.CommentsMade desc) as CommentsRank
    from UserActivity ua
),
FinalSelection as (
    select
        t.Level,
        t.Path as TagHierarchy,
        tp.PostId,
        tp.PostTypeId,
        tp.OwnerUserId,
        u.DisplayName as OwnerName,
        tp.CreationDate,
        tp.Score,
        tp.ViewCount,
        tp.Tags,
        tp.Title,
        tp.BadgeName,
        tp.BadgeClass,
        crc.CloseReasonName,
        crc.CloseCount,
        ast.AnswerCount,
        ast.AvgAnswerScore,
        ast.MaxAnswerScore as QuestionMaxAnswerScore,
        ast.AnonymousAnswerCount,
        ast.HighlyRatedAnswers,
        ur.ReputationRank,
        ur.QuestionsRank,
        ur.CommentsRank,
        ur.TotalBountyGiven,
        ur.MaxAnswerScore as UserMaxAnswerScore,
        case
            when tp.Score > 0 and ur.Reputation > 1000 then 'HighRepHighScore'
            when tp.Score <= 0 and ur.Reputation < 100 then 'LowRepLowScore'
            else 'Medium'
        end as PostCategory,
        length(coalesce(tp.Title, '')) as TitleLength,
        coalesce(nullif(tp.Tags, ''), '<no-tags>') as TagsOrNone
    from RecursiveTagHierarchy t
    inner join TopPosts tp on tp.Tags like '%' || t.TagName || '%'
    left join CloseReasonCounts crc on crc.PostId = tp.PostId
    left join AnswerStats ast on ast.QuestionId = tp.PostId
    left join Users u on u.Id = tp.OwnerUserId
    left join UserRankings ur on ur.UserId = tp.OwnerUserId
    where tp.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
)
select
    Level,
    TagHierarchy,
    PostId,
    PostTypeId,
    OwnerUserId,
    OwnerName,
    CreationDate,
    Score,
    ViewCount,
    Title,
    BadgeName,
    BadgeClass,
    CloseReasonName,
    CloseCount,
    AnswerCount,
    round(AvgAnswerScore::numeric, 2) as AvgAnswerScore,
    QuestionMaxAnswerScore,
    AnonymousAnswerCount,
    HighlyRatedAnswers,
    ReputationRank,
    QuestionsRank,
    CommentsRank,
    TotalBountyGiven,
    UserMaxAnswerScore,
    PostCategory,
    TitleLength,
    TagsOrNone,
    row_number() over (partition by TagHierarchy order by Score desc, ViewCount desc) as RankWithinTag
from FinalSelection
where (Score > 5 or ViewCount > 1000 or CloseCount > 0)
  and (BadgeClass is not null or CloseCount is not null)
order by TagHierarchy, RankWithinTag
limit 100;