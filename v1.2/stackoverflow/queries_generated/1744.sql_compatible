with RecursiveCTE as (
    select
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        u.Reputation,
        coalesce(nullif(trim(regexp_replace(p.Tags, '[<]', '', 'g')),''),'])[') as sanitized_tags,
        bigint_path.ItemSequence
    from Posts p
    left join Users u on p.OwnerUserId = u.Id
    cross join lateral (
      select array_position(string_to_array(coalesce(p.Tags,''), '><'), unnest(string_to_array(coalesce(p.Tags,''), '><'))) as ItemSequence
      from Posts pp where pp.Id = p.Id limit 1
    ) bigint_path
    where p.PostTypeId = 1 and p.ViewCount > 1000 and p.OwnerUserId is not null

    union all

    select
        pl.RelatedPostId as Id,
        p2.Title,
        p2.CreationDate,
        p2.Score,
        p2.ViewCount,
        p2.OwnerUserId,
        u.Reputation,
        null as sanitized_tags,
        bigint_path.ItemSequence + 1
    from RecursiveCTE cte
    join PostLinks pl on pl.PostId = cte.Id and pl.LinkTypeId in (1,3)
    join Posts p2 on p2.Id = pl.RelatedPostId
    left join Users u on p2.OwnerUserId = u.Id
    cross join lateral (
      select array_position(string_to_array(coalesce(p2.Tags,''), '><'), unnest(string_to_array(coalesce(p2.Tags,''), '><'))) as ItemSequence
    ) bigint_path
    where p2.OwnerUserId is not null
      and cte.ItemSequence < 5
)
, PostFinding AS (
    select
        Id,
        Title,
        CreationDate,
        Score,
        ViewCount,
        OwnerUserId,
        Reputation
    from RecursiveCTE
)
select
    pf.Id,
    pf.Title,
    pf.CreationDate,
    pf.Score,
    pf.ViewCount,
    pf.OwnerUserId,
    pf.Reputation
from PostFinding pf
group by
    pf.Id,
    pf.Title,
    pf.CreationDate,
    pf.Score,
    pf.ViewCount,
    pf.OwnerUserId,
    pf.Reputation;