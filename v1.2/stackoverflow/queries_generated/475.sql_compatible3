with RecursiveUserBadges as (
    select 
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        row_number() over (partition by u.Id order by b.Date desc) as BadgeRank
    from Users u
    left join Badges b on b.UserId = u.Id
    where coalesce(b.TagBased, false) = false
),
TopUserBadges as (
    select UserId, DisplayName, BadgeName, Class
    from RecursiveUserBadges
    where BadgeRank <= 3
),
QuestionAnswerStats as (
    select 
        p.Id as QuestionId,
        p.Title,
        p.OwnerUserId,
        p.CreationDate as QuestionCreation,
        coalesce(a.AnswerCount,0) as AnswerCount,
        coalesce(a.MaxAnswerScore,0) as MaxAnswerScore,
        coalesce(a.AvgAnswerScore,0) as AvgAnswerScore,
        p.Score as QuestionScore,
        p.ViewCount,
        p.Tags
    from Posts p
    left join (
        select 
            ParentId,
            count(*) as AnswerCount,
            max(Score) as MaxAnswerScore,
            avg(Score) as AvgAnswerScore
        from Posts
        where PostTypeId = 2
        group by ParentId
    ) a on a.ParentId = p.Id
    where p.PostTypeId = 1
),
UserActivityWindow as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        sum(case when p.PostTypeId = 1 then 1 else 0 end) over (partition by u.Id order by u.CreationDate rows between unbounded preceding and current row) as QuestionsPosted,
        sum(case when p.PostTypeId = 2 then 1 else 0 end) over (partition by u.Id order by u.CreationDate rows between unbounded preceding and current row) as AnswersPosted,
        count(c.Id) over (partition by u.Id order by u.CreationDate rows between unbounded preceding and current row) as CommentsMade
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, p.PostTypeId
),
DuplicateQuestions as (
    select distinct pl.PostId as DuplicateQuestionId, pl.RelatedPostId as OriginalQuestionId
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId and lt.Name = 'Duplicate'
    join Posts p1 on p1.Id = pl.PostId and p1.PostTypeId = 1
    join Posts p2 on p2.Id = pl.RelatedPostId and p2.PostTypeId = 1
),
ClosedQuestionsWithReasons as (
    select 
        ph.PostId,
        cr.Name as CloseReason,
        ph.CreationDate as CloseDate
    from PostHistory ph
    join CloseReasonTypes cr on cast(ph.Comment as integer) = cr.Id
    where ph.PostHistoryTypeId = 10
),
QuestionsWithDuplicatesAndClose as (
    select 
        q.QuestionId,
        q.Title,
        q.OwnerUserId,
        q.QuestionCreation,
        q.AnswerCount,
        q.MaxAnswerScore,
        q.AvgAnswerScore,
        q.QuestionScore,
        q.ViewCount,
        q.Tags,
        dq.OriginalQuestionId,
        cqc.CloseReason,
        cqc.CloseDate
    from QuestionAnswerStats q
    left join DuplicateQuestions dq on dq.DuplicateQuestionId = q.QuestionId
    left join ClosedQuestionsWithReasons cqc on cqc.PostId = q.QuestionId
),
RankedAnswers as (
    select 
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId as AnswererId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreation,
        row_number() over (partition by a.ParentId order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts a
    where a.PostTypeId = 2
),
AcceptedAnswerDetails as (
    select 
        q.QuestionId,
        q.Title,
        q.OwnerUserId as QuestionOwner,
        ra.AnswerId,
        ra.AnswererId,
        ra.AnswerScore,
        ra.AnswerCreation,
        q.CloseReason,
        q.CloseDate
    from QuestionsWithDuplicatesAndClose q
    left join RankedAnswers ra on ra.AnswerId = (
        select p2.AcceptedAnswerId from Posts p2 where p2.Id = q.QuestionId and p2.AcceptedAnswerId is not null
    )
    where ra.AnswerRank = 1 or ra.AnswerRank is null
),
UserReputationWithBadges as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
),
FinalAggregated as (
    select
        aa.QuestionId,
        aa.Title,
        u.DisplayName as QuestionOwnerName,
        aa.AnswerId,
        ua.DisplayName as AnswerOwnerName,
        aa.AnswerScore,
        aa.AnswerCreation,
        aa.CloseReason,
        aa.CloseDate,
        ur.GoldBadges,
        ur.SilverBadges,
        ur.BronzeBadges,
        ur.Reputation,
        case 
            when aa.CloseDate is not null then 'Closed'
            when aa.AnswerId is not null then 'Answered'
            else 'Open'
        end as QuestionStatus,
        length(coalesce(aa.Title, '')) as TitleLength,
        position('sql' in lower(coalesce(aa.Title, ''))) as SqlKeywordPos,
        (select count(*) from Comments c where c.PostId = aa.QuestionId and c.Score > 0) as PositiveCommentsOnQuestion,
        (select count(*) from Votes v where v.PostId = aa.QuestionId and v.VoteTypeId = 2) as UpVotesOnQuestion,
        (select count(*) from Votes v where v.PostId = aa.QuestionId and v.VoteTypeId = 3) as DownVotesOnQuestion
    from AcceptedAnswerDetails aa
    left join Users u on u.Id = aa.QuestionOwner
    left join Users ua on ua.Id = aa.AnswererId
    left join UserReputationWithBadges ur on ur.UserId = aa.QuestionOwner
)
select *
from FinalAggregated
where 
    (QuestionStatus = 'Open' or QuestionStatus = 'Answered')
    and (coalesce(GoldBadges,0) > 0 or coalesce(SilverBadges,0) > 5)
    and (TitleLength > 20 or SqlKeywordPos > 0)
order by Reputation desc, AnswerScore desc nulls last, CloseDate nulls first
limit 100;