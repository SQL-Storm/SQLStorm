WITH RecentQuestions AS (
    SELECT 
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        u.DisplayName AS OwnerName,
        u.Reputation AS OwnerReputation,
        u.Id AS OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS QuestionRank
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1
      AND p.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '180 days'
      AND p.Score >= 0
),
AnswersAggregates AS (
    SELECT 
        p.ParentId AS QuestionId,
        COUNT(*) FILTER (WHERE p.Score > 0) AS PositiveAnswers,
        COUNT(*) FILTER (WHERE p.Score = 0) AS NeutralAnswers,
        COUNT(*) FILTER (WHERE p.Score < 0) AS NegativeAnswers,
        AVG(p.Score) AS AvgAnswerScore,
        MAX(p.Score) AS MaxAnswerScore,
        COUNT(*) AS TotalAnswers
    FROM Posts p
    WHERE p.PostTypeId = 2
    GROUP BY p.ParentId
),
UserBadges AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(*) AS TotalBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
UserVotes AS (
    SELECT 
        v.UserId,
        SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes,
        SUM(CASE WHEN vt.Name = 'Favorite' THEN 1 ELSE 0 END) AS Favorites
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    GROUP BY v.UserId
),
QuestionCloseInfo AS (
    SELECT 
        ph.PostId,
        ph.CreationDate AS CloseDate,
        crt.Name AS CloseReason,
        ph.UserId AS ClosedByUserId,
        u.DisplayName AS ClosedByUserName
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON CAST(ph.Comment AS INTEGER) = crt.Id
    LEFT JOIN Users u ON ph.UserId = u.Id
    WHERE ph.PostHistoryTypeId = 10
),
TagExploded AS (
    SELECT 
        q.Id AS QuestionId,
        TRIM(tag) AS TagName
    FROM RecentQuestions q,
    LATERAL unnest(string_to_array(substring(q.Tags FROM 2 FOR char_length(q.Tags)-2), '><')) AS tag
),
TagStats AS (
    SELECT 
        t.TagName,
        COUNT(DISTINCT te.QuestionId) AS QuestionCount,
        AVG(q.Score) AS AvgQuestionScore,
        AVG(a.AvgAnswerScore) AS AvgAnswerScore
    FROM TagExploded te
    JOIN RecentQuestions q ON te.QuestionId = q.Id
    LEFT JOIN AnswersAggregates a ON a.QuestionId = q.Id
    JOIN Tags t ON t.TagName = te.TagName
    GROUP BY t.TagName
),
Combined AS (
    SELECT 
        rq.Id AS QuestionId,
        rq.Title,
        rq.CreationDate,
        rq.Score,
        rq.ViewCount,
        rq.Tags,
        rq.OwnerName,
        rq.OwnerReputation,
        rq.OwnerUserId,
        ua.PositiveAnswers,
        ua.NeutralAnswers,
        ua.NegativeAnswers,
        ua.AvgAnswerScore,
        ua.TotalAnswers,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.TotalBadges,
        uv.UpVotes,
        uv.DownVotes,
        uv.Favorites,
        qci.CloseDate,
        qci.CloseReason,
        qci.ClosedByUserName,
        te.TagName,
        ts.QuestionCount AS TagQuestionCount,
        ts.AvgQuestionScore AS TagAvgQuestionScore,
        ts.AvgAnswerScore AS TagAvgAnswerScore
    FROM RecentQuestions rq
    LEFT JOIN AnswersAggregates ua ON ua.QuestionId = rq.Id
    LEFT JOIN UserBadges ub ON ub.UserId = rq.OwnerUserId
    LEFT JOIN UserVotes uv ON uv.UserId = rq.OwnerUserId
    LEFT JOIN QuestionCloseInfo qci ON qci.PostId = rq.Id
    LEFT JOIN TagExploded te ON te.QuestionId = rq.Id
    LEFT JOIN TagStats ts ON ts.TagName = te.TagName
    WHERE rq.QuestionRank = 1
)
SELECT
    c.QuestionId,
    c.Title,
    c.CreationDate,
    c.Score,
    c.ViewCount,
    COALESCE(c.Tags, '') AS Tags,
    COALESCE(c.OwnerName, 'Anonymous') AS OwnerName,
    COALESCE(c.OwnerReputation, 0) AS OwnerReputation,
    COALESCE(c.GoldBadges, 0) AS GoldBadges,
    COALESCE(c.SilverBadges, 0) AS SilverBadges,
    COALESCE(c.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(c.TotalBadges, 0) AS TotalBadges,
    COALESCE(c.UpVotes, 0) AS UpVotes,
    COALESCE(c.DownVotes, 0) AS DownVotes,
    COALESCE(c.Favorites, 0) AS Favorites,
    COALESCE(c.PositiveAnswers, 0) AS PositiveAnswers,
    COALESCE(c.NeutralAnswers, 0) AS NeutralAnswers,
    COALESCE(c.NegativeAnswers, 0) AS NegativeAnswers,
    COALESCE(c.TotalAnswers, 0) AS TotalAnswers,
    COALESCE(c.AvgAnswerScore, 0) AS AvgAnswerScore,
    c.CloseDate,
    c.CloseReason,
    COALESCE(c.ClosedByUserName, 'N/A') AS ClosedByUserName,
    c.TagName,
    COALESCE(c.TagQuestionCount, 0) AS TagQuestionCount,
    COALESCE(c.TagAvgQuestionScore, 0) AS TagAvgQuestionScore,
    COALESCE(c.TagAvgAnswerScore, 0) AS TagAvgAnswerScore,
    (c.Score * 2 + COALESCE(c.AvgAnswerScore,0) * 3 + COALESCE(c.ViewCount,0)/100 + 
     COALESCE(c.GoldBadges,0) * 10 + COALESCE(c.SilverBadges,0)*5 + COALESCE(c.BronzeBadges,0)*1 +
     COALESCE(c.UpVotes,0) - COALESCE(c.DownVotes,0) + COALESCE(c.Favorites,0)*2) AS WeightedScore,
    ('Q: ' || SUBSTRING(COALESCE(c.Title, '') FROM 1 FOR 50) || 
     ' | Owner: ' || COALESCE(c.OwnerName, 'Anonymous') || 
     ' | Tags: ' || COALESCE(c.TagName, 'none') || 
     ' | CloseReason: ' || COALESCE(c.CloseReason, 'Open')) AS Summary
FROM Combined c
WHERE c.ViewCount > 1000
  AND (c.CloseDate IS NULL OR c.CloseDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30 days')
UNION
SELECT
    p.Id AS QuestionId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.Tags,
    u.DisplayName AS OwnerName,
    u.Reputation AS OwnerReputation,
    0 AS GoldBadges,
    0 AS SilverBadges,
    0 AS BronzeBadges,
    0 AS TotalBadges,
    0 AS UpVotes,
    0 AS DownVotes,
    0 AS Favorites,
    0 AS PositiveAnswers,
    0 AS NeutralAnswers,
    0 AS NegativeAnswers,
    0 AS TotalAnswers,
    NULL AS AvgAnswerScore,
    NULL AS CloseDate,
    NULL AS CloseReason,
    'N/A' AS ClosedByUserName,
    NULL AS TagName,
    0 AS TagQuestionCount,
    0 AS TagAvgQuestionScore,
    0 AS TagAvgAnswerScore,
    (p.Score * 2 + 0 + p.ViewCount/100 + 0 + 0 + 0 + 0) AS WeightedScore,
    ('Q: ' || SUBSTRING(COALESCE(p.Title, '') FROM 1 FOR 50) || ' | Owner: ' || COALESCE(u.DisplayName, 'Anonymous') || ' | Tags: none | CloseReason: Open') AS Summary
FROM Posts p
LEFT JOIN Users u ON p.OwnerUserId = u.Id
WHERE p.PostTypeId = 1
  AND p.ViewCount > 10000
  AND p.Id NOT IN (SELECT Id FROM RecentQuestions)
ORDER BY WeightedScore DESC
LIMIT 100;