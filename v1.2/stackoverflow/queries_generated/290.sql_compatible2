with RecursiveUserActivity as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionsAsked,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswersGiven,
        count(distinct c.Id) as CommentsMade,
        count(distinct b.Id) as BadgesEarned,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as TotalUpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as TotalDownVotes
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Badges b on b.UserId = u.Id
    left join Votes v on v.UserId = u.Id
    left join VoteTypes vt on vt.Id = v.VoteTypeId
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
RankedPosts as (
    select 
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc) as PostRank,
        count(*) over (partition by p.OwnerUserId) as TotalPostsByUser,
        p.AcceptedAnswerId
    from Posts p
    where p.PostTypeId in (1, 2)
),
TopPostsWithAcceptedAnswers as (
    select 
        rp.Id,
        rp.PostTypeId,
        rp.OwnerUserId,
        rp.Score,
        rp.ViewCount,
        rp.CreationDate,
        rp.Title,
        rp.Tags,
        rp.PostRank,
        rp.TotalPostsByUser,
        rp.AcceptedAnswerId,
        a.Score as AcceptedAnswerScore,
        a.ViewCount as AcceptedAnswerViewCount,
        a.OwnerUserId as AcceptedAnswerOwnerUserId,
        au.DisplayName as AcceptedAnswerOwnerDisplayName
    from RankedPosts rp
    left join Posts a on a.Id = rp.AcceptedAnswerId
    left join Users au on au.Id = a.OwnerUserId
    where rp.PostRank <= 5
),
UserCloseReasonStats as (
    select 
        pha.UserId,
        crt.Name as CloseReason,
        count(*) as CloseVotesCast
    from PostHistory pha
    join PostHistoryTypes pht on pht.Id = pha.PostHistoryTypeId and pht.Name = 'Post Closed'
    left join CloseReasonTypes crt on crt.Id = pha.Comment
    where pha.UserId is not null
    group by pha.UserId, crt.Name
),
UserBadgeSummary as (
    select 
        UserId,
        sum(case when Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when Class = 3 then 1 else 0 end) as BronzeBadges,
        count(distinct Name) as DistinctBadgeNames
    from Badges
    group by UserId
),
UserActivityWithBadges as (
    select 
        rua.*,
        coalesce(ubs.GoldBadges, 0) as GoldBadges,
        coalesce(ubs.SilverBadges, 0) as SilverBadges,
        coalesce(ubs.BronzeBadges, 0) as BronzeBadges,
        coalesce(ubs.DistinctBadgeNames, 0) as DistinctBadgeNames
    from RecursiveUserActivity rua
    left join UserBadgeSummary ubs on ubs.UserId = rua.UserId
),
UserActivityWithCloseReasons as (
    select 
        uab.UserId,
        uab.DisplayName,
        uab.Reputation,
        uab.CreationDate,
        uab.LastAccessDate,
        uab.QuestionsAsked,
        uab.AnswersGiven,
        uab.CommentsMade,
        uab.BadgesEarned,
        uab.TotalUpVotes,
        uab.TotalDownVotes,
        uab.GoldBadges,
        uab.SilverBadges,
        uab.BronzeBadges,
        uab.DistinctBadgeNames,
        coalesce(json_agg(json_build_object('CloseReason', ucr.CloseReason, 'Count', ucr.CloseVotesCast)) filter (where ucr.CloseReason is not null), '[]') as CloseReasonDetails
    from UserActivityWithBadges uab
    left join UserCloseReasonStats ucr on ucr.UserId = uab.UserId
    group by uab.UserId, uab.DisplayName, uab.Reputation, uab.CreationDate, uab.LastAccessDate, uab.QuestionsAsked, uab.AnswersGiven, uab.CommentsMade, uab.BadgesEarned, uab.TotalUpVotes, uab.TotalDownVotes, uab.GoldBadges, uab.SilverBadges, uab.BronzeBadges, uab.DistinctBadgeNames
),
UserTagEngagement as (
    select 
        u.Id as UserId,
        unnest(string_to_array(trim(both '<>' from coalesce(p.Tags, '')), '><')) as Tag,
        count(*) as PostsWithTag,
        sum(p.Score) as TotalScoreForTag,
        avg(p.ViewCount) as AvgViewsForTag
    from Users u
    join Posts p on p.OwnerUserId = u.Id and p.PostTypeId = 1
    where p.Tags is not null and p.Tags <> ''
    group by u.Id, Tag
),
TopUserTags as (
    select 
        UserId,
        Tag,
        PostsWithTag,
        TotalScoreForTag,
        AvgViewsForTag,
        rank() over (partition by UserId order by PostsWithTag desc, TotalScoreForTag desc) as TagRank
    from UserTagEngagement
),
FilteredTopUserTags as (
    select * from TopUserTags where TagRank <= 3
),
FinalUserSummary as (
    select 
        uac.UserId,
        uac.DisplayName,
        uac.Reputation,
        uac.CreationDate,
        uac.LastAccessDate,
        uac.QuestionsAsked,
        uac.AnswersGiven,
        uac.CommentsMade,
        uac.BadgesEarned,
        uac.TotalUpVotes,
        uac.TotalDownVotes,
        uac.GoldBadges,
        uac.SilverBadges,
        uac.BronzeBadges,
        uac.DistinctBadgeNames,
        uac.CloseReasonDetails,
        json_agg(json_build_object('Tag', ftt.Tag, 'Posts', ftt.PostsWithTag, 'Score', ftt.TotalScoreForTag, 'AvgViews', ftt.AvgViewsForTag) order by ftt.TagRank) as TopTags,
        json_agg(json_build_object('PostId', tpa.Id, 'PostTypeId', tpa.PostTypeId, 'Score', tpa.Score, 'ViewCount', tpa.ViewCount, 'Title', tpa.Title, 'AcceptedAnswerScore', tpa.AcceptedAnswerScore, 'AcceptedAnswerViewCount', tpa.AcceptedAnswerViewCount, 'AcceptedAnswerOwnerUserId', tpa.AcceptedAnswerOwnerUserId, 'AcceptedAnswerOwnerDisplayName', tpa.AcceptedAnswerOwnerDisplayName) order by tpa.PostRank) as TopPosts
    from UserActivityWithCloseReasons uac
    left join FilteredTopUserTags ftt on ftt.UserId = uac.UserId
    left join TopPostsWithAcceptedAnswers tpa on tpa.OwnerUserId = uac.UserId
    group by uac.UserId, uac.DisplayName, uac.Reputation, uac.CreationDate, uac.LastAccessDate, uac.QuestionsAsked, uac.AnswersGiven, uac.CommentsMade, uac.BadgesEarned, uac.TotalUpVotes, uac.TotalDownVotes, uac.GoldBadges, uac.SilverBadges, uac.BronzeBadges, uac.DistinctBadgeNames, uac.CloseReasonDetails
)
select 
    UserId,
    DisplayName,
    Reputation,
    to_char(CreationDate, 'YYYY-MM-DD') as UserCreationDate,
    to_char(LastAccessDate, 'YYYY-MM-DD') as LastAccess,
    QuestionsAsked,
    AnswersGiven,
    CommentsMade,
    BadgesEarned,
    TotalUpVotes,
    TotalDownVotes,
    GoldBadges,
    SilverBadges,
    BronzeBadges,
    DistinctBadgeNames,
    CloseReasonDetails,
    TopTags,
    TopPosts
from FinalUserSummary
where Reputation > 1000
order by Reputation desc
limit 50;