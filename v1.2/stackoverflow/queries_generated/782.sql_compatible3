with recursive RecursiveTagHierarchy as (
  select
    t.Id,
    t.TagName,
    t.Count,
    t.IsModeratorOnly,
    t.IsRequired,
    1 as Level,
    cast(array[t.TagName] as varchar[]) as Path
  from Tags t
  where t.IsRequired = true

  union all

  select
    t.Id,
    t.TagName,
    t.Count,
    t.IsModeratorOnly,
    t.IsRequired,
    r.Level + 1,
    r.Path || t.TagName
  from Tags t
  join RecursiveTagHierarchy r on t.Id <> r.Id and t.IsRequired = true and not t.TagName = any(r.Path)
  where r.Level < 3
),
UserBadgeCounts as (
  select
    b.UserId,
    b.Class,
    count(*) as BadgeCount
  from Badges b
  group by b.UserId, b.Class
),
TopAnswerers as (
  select
    p.OwnerUserId as UserId,
    count(*) as AnswersCount,
    sum(p.Score) as TotalAnswerScore,
    avg(p.Score) as AvgAnswerScore,
    max(p.Score) as MaxAnswerScore
  from Posts p
  where p.PostTypeId = 2 and p.OwnerUserId is not null
  group by p.OwnerUserId
),
QuestionStats as (
  select
    p.Id,
    p.OwnerUserId,
    p.Score,
    p.ViewCount,
    p.FavoriteCount,
    p.AnswerCount,
    p.CreationDate,
    array_remove(string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><'), '') as TagArray,
    row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as RecentQuestionRank
  from Posts p
  where p.PostTypeId = 1
),
QuestionCommentsCount as (
  select
    c.PostId,
    count(*) as CommentCount
  from Comments c
  group by c.PostId
),
QuestionCloseReasons as (
  select
    ph.PostId,
    crt.Name as CloseReasonName,
    min(cast(ph.CreationDate as timestamp)) as FirstCloseDate
  from PostHistory ph
  join CloseReasonTypes crt on cast(ph.Comment as integer) = crt.Id
  where ph.PostHistoryTypeId = 10
  group by ph.PostId, crt.Name
),
UserEngagement as (
  select
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    coalesce(tb.Gold,0) as GoldBadges,
    coalesce(tb.Silver,0) as SilverBadges,
    coalesce(tb.Bronze,0) as BronzeBadges,
    coalesce(ta.AnswersCount,0) as TotalAnswers,
    coalesce(ta.TotalAnswerScore,0) as TotalAnswerScore,
    coalesce(ta.AvgAnswerScore,0) as AvgAnswerScore,
    coalesce(qs.QuestionCount,0) as TotalQuestions,
    coalesce(qs.LatestQuestionDate, cast('1900-01-01' as date)) as LatestQuestionDate
  from Users u
  left join (
    select
      UserId,
      sum(case when Class=1 then BadgeCount else 0 end) as Gold,
      sum(case when Class=2 then BadgeCount else 0 end) as Silver,
      sum(case when Class=3 then BadgeCount else 0 end) as Bronze
    from UserBadgeCounts
    group by UserId
  ) tb on u.Id = tb.UserId
  left join TopAnswerers ta on u.Id = ta.UserId
  left join (
    select
      OwnerUserId,
      count(*) as QuestionCount,
      max(CreationDate) as LatestQuestionDate
    from Posts
    where PostTypeId = 1
    group by OwnerUserId
  ) qs on u.Id = qs.OwnerUserId
),
ComplexPostStats as (
  select
    q.Id as QuestionId,
    q.OwnerUserId,
    q.Score as QuestionScore,
    q.ViewCount,
    q.FavoriteCount,
    q.AnswerCount,
    q.TagArray,
    coalesce(qcc.CommentCount,0) as QuestionComments,
    coalesce(qcr.CloseReasonName, 'Open') as CloseReason,
    qcr.FirstCloseDate,
    aa.Id as AnswerId,
    aa.Score as AnswerScore,
    aa.CreationDate as AnswerCreationDate,
    row_number() over (partition by q.Id order by aa.Score desc nulls last, aa.CreationDate asc) as AnswerRank
  from QuestionStats q
  left join QuestionCommentsCount qcc on q.Id = qcc.PostId
  left join QuestionCloseReasons qcr on q.Id = qcr.PostId
  left join Posts aa on aa.ParentId = q.Id and aa.PostTypeId = 2
  where q.RecentQuestionRank <= 5
),
AggregateAnswerStats as (
  select
    QuestionId,
    max(AnswerScore) as MaxAnswerScore,
    avg(AnswerScore) as AvgAnswerScore,
    sum(case when AnswerScore >= 10 then 1 else 0 end) as HighScoreAnswers
  from ComplexPostStats
  group by QuestionId
),
FinalResults as (
  select
    cps.QuestionId,
    u.DisplayName as QuestionOwner,
    cps.QuestionScore,
    cps.ViewCount,
    cps.FavoriteCount,
    cps.AnswerCount,
    array_to_string(cps.TagArray, ', ') as Tags,
    cps.QuestionComments,
    cps.CloseReason,
    cps.FirstCloseDate,
    agg.MaxAnswerScore,
    round(cast(agg.AvgAnswerScore as numeric), 2) as AverageAnswerScore,
    agg.HighScoreAnswers,
    ue.GoldBadges,
    ue.SilverBadges,
    ue.BronzeBadges,
    ue.TotalAnswers,
    ue.TotalQuestions,
    ue.Reputation,
    case
      when ue.Reputation > 10000 then 'Expert'
      when ue.Reputation between 1000 and 10000 then 'Intermediate'
      else 'Beginner'
    end as UserLevel,
    concat(
      'Q:', cps.QuestionScore,
      ' / V:', cps.ViewCount,
      ' / F:', cps.FavoriteCount,
      ' / A:', cps.AnswerCount,
      ' / C:', cps.QuestionComments,
      ' / Close:', cps.CloseReason,
      ' / MaxA:', coalesce(cast(cps.AnswerScore as text), 'N/A')
    ) as SummaryString
  from ComplexPostStats cps
  join Users u on cps.OwnerUserId = u.Id
  left join AggregateAnswerStats agg on cps.QuestionId = agg.QuestionId
  left join UserEngagement ue on cps.OwnerUserId = ue.UserId
  where cps.AnswerRank = 1 or cps.AnswerRank is null
),
UnionedResults as (
  select
    QuestionId,
    QuestionOwner,
    QuestionScore,
    ViewCount,
    FavoriteCount,
    AnswerCount,
    Tags,
    QuestionComments,
    CloseReason,
    FirstCloseDate,
    MaxAnswerScore,
    AverageAnswerScore,
    HighScoreAnswers,
    GoldBadges,
    SilverBadges,
    BronzeBadges,
    TotalAnswers,
    TotalQuestions,
    Reputation,
    UserLevel,
    SummaryString,
    1 as SourceFlag
  from FinalResults

  union all

  select
    p.Id,
    u.DisplayName,
    p.Score,
    p.ViewCount,
    p.FavoriteCount,
    0 as AnswerCount,
    array_to_string(array_remove(string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><'), ''), ', ') as Tags,
    coalesce(c.CommentCount, 0),
    'Open' as CloseReason,
    null as FirstCloseDate,
    null as MaxAnswerScore,
    null as AverageAnswerScore,
    null as HighScoreAnswers,
    0 as GoldBadges,
    0 as SilverBadges,
    0 as BronzeBadges,
    0 as TotalAnswers,
    0 as TotalQuestions,
    0 as Reputation,
    'No Answers' as UserLevel,
    ('Q:'||p.Score||' / V:'|| p.ViewCount||' / F:'||p.FavoriteCount||' / C:'||coalesce(c.CommentCount,0)) as SummaryString,
    2 as SourceFlag
  from Posts p
  left join Users u on p.OwnerUserId = u.Id
  left join (
    select PostId, count(*) as CommentCount from Comments group by PostId
  ) c on p.Id = c.PostId
  where p.PostTypeId = 1 and p.AnswerCount = 0
)
select *
from UnionedResults
order by Reputation desc nulls last, QuestionScore desc nulls last, ViewCount desc, FavoriteCount desc
limit 100;