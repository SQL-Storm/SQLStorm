WITH RecursiveTagCounts AS (
    SELECT 
        T.Id,
        T.TagName,
        T.Count,
        u.DisplayName AS UserWithMaxRepForTag,
        ROW_NUMBER() OVER (PARTITION BY T.Id ORDER BY u.Reputation DESC) AS RN
    FROM Tags T
    LEFT JOIN Posts p 
        ON p.PostTypeId = 1 
        AND p.Tags ILIKE '%' || '<' || T.TagName || '>' || '%'
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
), 
MaxRepUsersForTags AS (
    SELECT
        Id,
        TagName,
        UserWithMaxRepForTag
    FROM RecursiveTagCounts
    WHERE RN = 1
), 
RecentActivity AS (
    SELECT 
        p.Id AS PostId,
        p.CreationDate,
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        p.PostTypeId,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.LastActivityDate DESC) AS UserPostRank,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id AND c.CreationDate > cast('2024-10-01' as date) - interval '90 day') AS RecentCommentsCount
    FROM Posts p
    JOIN Users u ON u.Id = p.OwnerUserId
    WHERE p.PostTypeId IN (1, 2) 
),
RecentBadgeStats AS (
    SELECT 
        ub.UserId,
