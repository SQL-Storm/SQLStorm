WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        0 AS Level,
        CAST(ARRAY[t.TagName] AS varchar[]) AS Path
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE
  UNION ALL
    SELECT
        c.Id,
        c.TagName,
        c.Count,
        p.Level + 1,
        p.Path || c.TagName
    FROM Tags c
    JOIN RecursiveTagHierarchy p ON c.Id <> p.Id
    WHERE c.IsModeratorOnly = FALSE
      AND NOT c.TagName = ANY(p.Path)
      AND p.Level < 2
),
UserActivity AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsPosted,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersPosted,
        COALESCE(SUM(votes_up.UpVotes), 0) AS TotalUpVotes,
        COALESCE(SUM(votes_down.DownVotes), 0) AS TotalDownVotes,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, COUNT(DISTINCT p.Id) DESC) AS RankByReputation
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT PostId, COUNT(*) AS UpVotes
        FROM Votes
        WHERE VoteTypeId = 2
        GROUP BY PostId
    ) votes_up ON votes_up.PostId = p.Id
    LEFT JOIN (
        SELECT PostId, COUNT(*) AS DownVotes
        FROM Votes
        WHERE VoteTypeId = 3
        GROUP BY PostId
    ) votes_down ON votes_down.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopUserQuestions AS (
    SELECT
        p.Id AS PostId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        ua.Id AS OwnerId,
        ua.DisplayName AS OwnerName,
        ua.Reputation AS OwnerReputation,
        ua.TotalUpVotes,
        ua.TotalDownVotes,
        ua.TotalPosts,
        ua.RankByReputation,
        ROW_NUMBER() OVER (PARTITION BY ua.Id ORDER BY p.Score DESC, p.ViewCount DESC) AS QuestionRank
    FROM Posts p
    JOIN UserActivity ua ON p.OwnerUserId = ua.Id
    WHERE p.PostTypeId = 1
      AND ua.RankByReputation <= 50
),
TagUsageStats AS (
    SELECT
        t.tag AS tag,
        COUNT(DISTINCT p.Id) AS QuestionCount,
        AVG(p.Score) AS AvgScore,
        SUM(p.ViewCount) AS TotalViews,
        COUNT(DISTINCT CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN p.Id END) AS QuestionsWithAcceptedAnswer
    FROM Posts p,
    LATERAL unnest(string_to_array(substring(p.Tags FROM 2 FOR char_length(p.Tags) - 2), '><')) AS t(tag)
    WHERE p.PostTypeId = 1
    GROUP BY t.tag
),
QuestionCloseHistory AS (
    SELECT
        ph.PostId,
        MIN(ph.CreationDate) AS FirstCloseDate,
        MAX(ph.CreationDate) AS LastCloseDate,
        COUNT(*) AS CloseEvents,
        MAX(CAST(ph.Comment AS INTEGER)) AS CloseReasonId
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10
    GROUP BY ph.PostId
),
DuplicateQuestions AS (
    SELECT pl.PostId, pl.RelatedPostId
    FROM PostLinks pl
    WHERE pl.LinkTypeId = 3
),
UserBadgeStats AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        COUNT(DISTINCT b.Name) AS DistinctBadges
    FROM Badges b
    GROUP BY b.UserId
)

SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.TotalPosts,
    u.QuestionsPosted,
    u.AnswersPosted,
    u.TotalUpVotes,
    u.TotalDownVotes,
    COALESCE(badges.GoldBadges, 0) AS GoldBadges,
    COALESCE(badges.SilverBadges, 0) AS SilverBadges,
    COALESCE(badges.BronzeBadges, 0) AS BronzeBadges,
    u.RankByReputation,
    q.PostId AS TopQuestionId,
    q.Title AS TopQuestionTitle,
    q.Score AS TopQuestionScore,
    q.ViewCount AS TopQuestionViews,
    tagstats.QuestionCount AS TagQuestionCount,
    tagstats.AvgScore AS TagAvgScore,
    tagstats.TotalViews AS TagTotalViews,
    tagstats.QuestionsWithAcceptedAnswer,
    ch.FirstCloseDate,
    ch.LastCloseDate,
    ch.CloseEvents,
    crt.Name AS CloseReasonName,
    dup.RelatedPostId AS DuplicateOfQuestionId
FROM UserActivity u
LEFT JOIN TopUserQuestions q ON q.OwnerId = u.Id AND q.QuestionRank = 1
LEFT JOIN LATERAL (
    SELECT tagstats.*
    FROM TagUsageStats tagstats
    JOIN LATERAL unnest(string_to_array(substring(q.Tags FROM 2 FOR char_length(q.Tags) - 2), '><')) AS t(tag)
        ON tagstats.tag = t.tag
    ORDER BY tagstats.QuestionCount DESC
    LIMIT 1
) tagstats ON true
LEFT JOIN QuestionCloseHistory ch ON ch.PostId = q.PostId
LEFT JOIN CloseReasonTypes crt ON crt.Id = ch.CloseReasonId
LEFT JOIN DuplicateQuestions dup ON dup.PostId = q.PostId
LEFT JOIN UserBadgeStats badges ON badges.UserId = u.Id
WHERE u.RankByReputation <= 50
ORDER BY u.RankByReputation, q.Score DESC NULLS LAST;