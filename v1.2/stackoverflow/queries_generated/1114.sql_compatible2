with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        b.TagBased,
        RANK() OVER (partition by u.Id order by b.Class asc, b.Date desc) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    where u.Reputation > 1000
),
TopBadges as (
    select * from RecursiveUserBadges where BadgeRank <= 3
),
QuestionAnswerWindow as (
    select
        p.Id as PostId,
        p.PostTypeId,
        p.Title,
        p.Tags,
        p.CreationDate,
        p.ViewCount,
        p.Score,
        p.OwnerUserId,
        sum(case when a.PostTypeId = 2 then 1 else 0 end) over (partition by p.Id) as AnswerCountWindow,
        rank() over (partition by p.Tags order by p.Score desc) as ScoreRankByTag
    from Posts p
    left join Posts a on p.Id = a.ParentId and a.PostTypeId = 2
    where p.PostTypeId = 1 and p.Tags is not null
    group by
        p.Id, p.PostTypeId, p.Title, p.Tags, p.CreationDate, p.ViewCount, p.Score, p.OwnerUserId
),
CloseReasonSubQuery as (
    select cht.Name as CloseReasonName, count(ph.Id) as CloseCount
    from PostHistory ph
    join PostHistoryTypes cht on ph.PostHistoryTypeId = cht.Id
    where ph.PostHistoryTypeId = 10
    group by cht.Name
    having count(ph.Id) > 10
),
FirstAnswerDates as (
    select
        ParentId,
        min(CreationDate) as FirstAnswerDate
    from Posts
    where PostTypeId = 2
    group by ParentId
),
AnswerWithAge as (
    select
        a.Id,
        a.ParentId,
        a.CreationDate,
        u.DisplayName as AnswerUser,
        p.Title,
        extract(epoch from (a.CreationDate - q.CreationDate))/3600 as HoursToAnswer,
        row_number() over (partition by a.ParentId order by a.CreationDate) as AnswerOrder
    from Posts a
    join Posts q on a.ParentId = q.Id and q.PostTypeId = 1
    left join Users u on a.OwnerUserId = u.Id
    left join Posts p on q.Id = p.Id
    where a.PostTypeId = 2
),
HighScoreTagQuestions as (
    select distinct p.Id, unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags) - 2), '><')) as Tag
    from Posts p
    where PostTypeId = 1 and p.Score >= 50
),
TagStats as (
    select
        Tag,
        count(*) as QuestionCount,
        avg(p.Score) as AvgScore,
        sum(p.ViewCount) as TotalViews
    from HighScoreTagQuestions hq
    join Posts p on p.Id = hq.Id
    group by Tag
),
CombinedResults as (
    select
        q.PostId,
        q.Title,
        q.Tags,
        q.ViewCount,
        q.Score,
        q.AnswerCountWindow,
        rs.CloseCount,
        ts.QuestionCount,
        ts.AvgScore,
        ts.TotalViews,
        b.BadgeName,
        b.Class as BadgeClass,
        b.TagBased,
        row_number() over (partition by q.PostId order by ts.QuestionCount desc nulls last, q.Score desc nulls last) as FinalRank
    from QuestionAnswerWindow q
    left join CloseReasonSubQuery rs on true
    left join LATERAL (
        select Tag, QuestionCount, AvgScore, TotalViews
        from TagStats ts
        where ts.Tag = any (string_to_array(substring(q.Tags from 2 for char_length(q.Tags) - 2), '><'))
        order by QuestionCount desc
        limit 1
    ) ts on true
    left join TopBadges b on b.UserId = q.OwnerUserId
)
select
    c.PostId,
    initcap(c.Title) as FormattedTitle,
    c.Tags,
    c.ViewCount,
    c.Score,
    c.AnswerCountWindow,
    coalesce(c.CloseCount, 0) as TotalClosures,
    coalesce(c.QuestionCount, 0) as TagQuestionCount,
    round(coalesce(c.AvgScore, 0), 2) as AvgTagScore,
    c.TotalViews,
    coalesce(c.BadgeName, 'No Badge') as TopBadge,
    case when c.BadgeClass = 1 then 'Gold'
         when c.BadgeClass = 2 then 'Silver'
         when c.BadgeClass = 3 then 'Bronze'
         else 'None' end as BadgeClass,
    c.TagBased,
    c.FinalRank
from CombinedResults c
where c.FinalRank <= 25
order by c.FinalRank, c.Score desc;