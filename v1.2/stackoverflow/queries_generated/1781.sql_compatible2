with UserPostStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(case when p.PostTypeId = 1 then 1 end) as QuestionCount,
        count(case when p.PostTypeId = 2 then 1 end) as AnswerCount,
        sum(case when p.PostTypeId in (1,2) then p.Score else 0 end) as TotalPostScore,
        coalesce(avg(case when p.PostTypeId in (1,2) then p.Score end), 0) as AvgPostScore,
        max(p.CreationDate) as LastPostDate,
        min(p.CreationDate) as FirstPostDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    group by u.Id, u.DisplayName
),
UserBadgeRanks as (
    select
        b.UserId,
        -- string_agg with ORDER BY must have ordering inside aggregate's arguments for some dialects; use array_agg then array_to_string where available,
        -- but to remain generic, aggregate distinct names by concatenating after ordering using subquery
        (
          select listagg(x.name, ', ') within group (order by x.sort_key) from (
            select distinct b2.name,
                   case when b2.Class = 1 then 0
                        when b2.Class = 2 then 1
                        when b2.Class = 3 then 2
                        else 99 end as sort_key
            from Badges b2
            where b2.UserId = b.UserId and b2.Class is not null
          ) x
        ) as BadgesSummary
    from Badges b
    group by b.UserId
),
RepliesAge as (
    select
        a.ParentId as QuestionId,
        round(sum(extract(epoch from (a.CreationDate - q.CreationDate)))/60.0 / count(a.Id)::numeric, 2) as AvgReplyLatencyMin
    from Posts a
    join Posts q on q.Id = a.ParentId and q.PostTypeId = 1 and a.PostTypeId = 2
    where a.CreationDate is not null and q.CreationDate is not null
    group by a.ParentId
),
AnswerRanking as (
    select
      innerQ.Id,
      innerQ.ParentId as QuestionId,
      innerQ.Score as AnswerScore,
      innerQ.OwnerUserId as AnswererUserId,
      u.DisplayName as AnswererName,
      innerQ.RowsWithin
    from (
          select
                 Answers.Id,
                 rank() over (partition by Answers.ParentId order by Answers.Score desc) as ScoreRankPerQuestion,
                 row_number() over (partition by Answers.ParentId order by Answers.CreationDate asc) as RowsWithin,
                 Answers.ParentId,
                 Answers.Score,
                 Answers.OwnerUserId
          from Posts Answers
          join Users on Users.Id = Answers.OwnerUserId
          where Answers.PostTypeId = 2
         ) innerQ
    join Users u on u.Id = innerQ.OwnerUserId
    where innerQ.ScoreRankPerQuestion between 1 and 3
    order by QuestionId, innerQ.ScoreRankPerQuestion
),
StringProcessedPosts as (
    select
        p.Id,
        coalesce(lower(trim(p.Title)), '') as OptimTitle,
        coalesce(lower(replace(replace (regexp_replace(p.Tags, '(><)+', '> <', 'g'), '<>', ' ' ), '<', '')), '') as ParsedTagsLower
    from Posts p
    where p.PostTypeId = 1 and p.Tags is not null
)

select
    upr.UserId,
    upr.DisplayName,
    upr.QuestionCount,
    upr.AnswerCount,
    upr.AvgPostScore,
    ubr.BadgesSummary,
    ra.AvgReplyLatencyMin,
    ar.AnswerScore,
    ar.AnswererUserId,
    ar.AnswererName,
    s.OptimTitle,
    s.ParsedTagsLower
from UserPostStats upr
join UserBadgeRanks ubr on upr.UserId = ubr.UserId
left join RepliesAge ra on ra.QuestionId = upr.UserId
left join AnswerRanking ar on ar.AnswererUserId = upr.UserId
left join StringProcessedPosts s on s.Id = upr.UserId;