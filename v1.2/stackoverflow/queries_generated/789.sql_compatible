WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 AS Level,
        ARRAY[t.TagName] AS Path
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE AND t.IsRequired = FALSE

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        child.Count,
        child.ExcerptPostId,
        child.WikiPostId,
        parent.Level + 1,
        parent.Path || child.TagName
    FROM Tags child
    JOIN RecursiveTagHierarchy parent ON child.Id <> parent.Id
    WHERE child.IsModeratorOnly = FALSE AND child.IsRequired = FALSE
        AND NOT child.TagName = ANY(parent.Path)
        AND child.Count < parent.Count
),
UserBadgeCounts AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COUNT(DISTINCT b.Name) AS UniqueBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsAsked,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersGiven,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpVotesCast,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownVotesCast,
        AVG(EXTRACT(EPOCH FROM (p.LastActivityDate - p.CreationDate))/3600) FILTER (WHERE p.LastActivityDate IS NOT NULL AND p.CreationDate IS NOT NULL) AS AvgPostActiveHours
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY u.Id
),
TopPosts AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.CreationDate,
        p.AcceptedAnswerId,
        RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.ViewCount DESC) AS RankByScoreView
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
PostWithAcceptedAnswer AS (
    SELECT
        q.Id AS QuestionId,
        q.Title AS QuestionTitle,
        q.OwnerUserId AS QuestionOwner,
        a.Id AS AnswerId,
        a.OwnerUserId AS AnswerOwner,
        a.Score AS AnswerScore,
        a.CreationDate AS AnswerCreationDate,
        q.AcceptedAnswerId,
        q.Tags
    FROM Posts q
    LEFT JOIN Posts a ON a.Id = q.AcceptedAnswerId
    WHERE q.PostTypeId = 1
),
DuplicateLinks AS (
    SELECT
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        u.DisplayName AS LinkCreator
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId AND lt.Name = 'Duplicate'
    LEFT JOIN Users u ON u.Id = (SELECT OwnerUserId FROM Posts WHERE Id = pl.PostId)
),
QuestionCloseReasons AS (
    SELECT
        ph.PostId,
        crt.Name AS CloseReason,
        ph.CreationDate AS CloseDate,
        ph.UserId AS ClosedByUserId
    FROM PostHistory ph
    JOIN PostHistoryTypes pht ON pht.Id = ph.PostHistoryTypeId
    LEFT JOIN CloseReasonTypes crt ON crt.Id = ph.Comment
    WHERE pht.Name = 'Post Closed'
),
WindowedVotes AS (
    SELECT
        v.PostId,
        v.VoteTypeId,
        v.UserId,
        v.CreationDate,
        LEAD(v.CreationDate) OVER (PARTITION BY v.PostId, v.VoteTypeId ORDER BY v.CreationDate) AS NextVoteDate,
        EXTRACT(EPOCH FROM (LEAD(v.CreationDate) OVER (PARTITION BY v.PostId, v.VoteTypeId ORDER BY v.CreationDate) - v.CreationDate))/60 AS MinutesUntilNextVote
    FROM Votes v
),
FilteredUsers AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        ua.QuestionsAsked,
        ua.AnswersGiven,
        ua.CommentsMade,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.UniqueBadges
    FROM Users u
    LEFT JOIN UserActivity ua ON ua.UserId = u.Id
    LEFT JOIN UserBadgeCounts ub ON ub.UserId = u.Id
    WHERE u.Reputation > 1000
      AND COALESCE(ua.QuestionsAsked, 0) > 5
      AND COALESCE(ub.GoldBadges, 0) > 0
),
ComplexStringAnalysis AS (
    SELECT
        p.Id,
        p.Title,
        LENGTH(p.Body) AS BodyLength,
        LENGTH(REGEXP_REPLACE(p.Body, '[^a-zA-Z]', '', 'g')) AS AlphaChars,
        LENGTH(REGEXP_REPLACE(p.Body, '[^0-9]', '', 'g')) AS NumericChars,
        (LENGTH(p.Body) - LENGTH(REGEXP_REPLACE(p.Body, '\s', '', 'g'))) AS WhitespaceCount,
        COALESCE(p.Tags, '') AS Tags,
        CARDINALITY(string_to_array(COALESCE(p.Tags, ''), '><')) AS TagCount,
        CASE WHEN p.ClosedDate IS NOT NULL THEN 'Closed' ELSE 'Open' END AS PostStatus
    FROM Posts p
    WHERE p.PostTypeId = 1
)
SELECT
    fu.Id AS UserId,
    fu.DisplayName,
    fu.Reputation,
    fu.QuestionsAsked,
    fu.AnswersGiven,
    fu.CommentsMade,
    fu.GoldBadges,
    fu.SilverBadges,
    fu.BronzeBadges,
    fu.UniqueBadges,
    pwa.QuestionId,
    pwa.QuestionTitle,
    pwa.AnswerId,
    pwa.AnswerScore,
    pwa.AnswerCreationDate,
    dl.RelatedPostId AS DuplicateOf,
    qcr.CloseReason,
    qcr.CloseDate,
    ua.AvgPostActiveHours,
    csa.BodyLength,
    csa.AlphaChars,
    csa.NumericChars,
    csa.WhitespaceCount,
    csa.TagCount,
    csa.PostStatus,
    STRING_AGG(DISTINCT rt.TagName, ',' ORDER BY rt.Level DESC) AS RelatedTagsPath
FROM FilteredUsers fu
LEFT JOIN PostWithAcceptedAnswer pwa ON pwa.QuestionOwner = fu.Id
LEFT JOIN DuplicateLinks dl ON dl.PostId = pwa.QuestionId
LEFT JOIN QuestionCloseReasons qcr ON qcr.PostId = pwa.QuestionId
LEFT JOIN UserActivity ua ON ua.UserId = fu.Id
LEFT JOIN ComplexStringAnalysis csa ON csa.Id = pwa.QuestionId
LEFT JOIN RecursiveTagHierarchy rt ON rt.TagName = ANY(string_to_array(COALESCE(pwa.Tags, ''), '><'))
GROUP BY
    fu.Id,
    fu.DisplayName,
    fu.Reputation,
    fu.QuestionsAsked,
    fu.AnswersGiven,
    fu.CommentsMade,
    fu.GoldBadges,
    fu.SilverBadges,
    fu.BronzeBadges,
    fu.UniqueBadges,
    pwa.QuestionId,
    pwa.QuestionTitle,
    pwa.AnswerId,
    pwa.AnswerScore,
    pwa.AnswerCreationDate,
    dl.RelatedPostId,
    qcr.CloseReason,
    qcr.CloseDate,
    ua.AvgPostActiveHours,
    csa.BodyLength,
    csa.AlphaChars,
    csa.NumericChars,
    csa.WhitespaceCount,
    csa.TagCount,
    csa.PostStatus
ORDER BY fu.Reputation DESC, pwa.AnswerScore DESC NULLS LAST
LIMIT 50;