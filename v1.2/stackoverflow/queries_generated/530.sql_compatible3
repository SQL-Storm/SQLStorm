with recursive RecursiveTagCounts as (
    select
        t.Id as TagId,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as TotalAnswers,
        coalesce(p.ViewCount, 0) as TotalViews,
        1 as Level
    from Tags t
    left join Posts p on p.Id = t.ExcerptPostId and p.PostTypeId = 1
    where t.IsModeratorOnly = false and t.IsRequired = false

    union all

    select
        t2.Id,
        t2.TagName,
        t2.Count,
        rtc.TotalAnswers + coalesce(p2.AnswerCount, 0),
        rtc.TotalViews + coalesce(p2.ViewCount, 0),
        rtc.Level + 1
    from RecursiveTagCounts rtc
    join Tags t2 on t2.Id > rtc.TagId and t2.IsModeratorOnly = false
    left join Posts p2 on p2.Id = t2.ExcerptPostId and p2.PostTypeId = 1
    where rtc.Level < 3
),
UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct case when b.Class = 1 then b.Id end) as GoldBadges,
        count(distinct case when b.Class = 2 then b.Id end) as SilverBadges,
        count(distinct case when b.Class = 3 then b.Id end) as BronzeBadges,
        coalesce(sum(b.Class), 0) as BadgeScore,
        row_number() over (order by coalesce(sum(b.Class), 0) desc, u.Reputation desc) as BadgeRank
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
TopPostsWithVotes as (
    select
        p.Id,
        p.Title,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as FavoriteVotes,
        row_number() over (partition by p.PostTypeId order by p.Score desc, p.ViewCount desc) as PostRank
    from Posts p
    left join Votes v on v.PostId = p.Id
    where p.PostTypeId in (1, 2)
    group by p.Id, p.Title, p.PostTypeId, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount
),
AcceptedAnswersCTE as (
    select
        q.Id as QuestionId,
        q.Title as QuestionTitle,
        a.Id as AnswerId,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerOwnerUserId,
        u.DisplayName as AnswerOwnerName,
        a.CreationDate as AnswerCreationDate,
        row_number() over (partition by q.Id order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Users u on u.Id = a.OwnerUserId
    where q.PostTypeId = 1 and q.AcceptedAnswerId is not null
    group by q.Id, q.Title, a.Id, a.Score, a.OwnerUserId, u.DisplayName, a.CreationDate
),
CloseReasonSummary as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        count(*) as CloseVotesCount,
        max(ph.CreationDate) as LastCloseVoteDate
    from PostHistory ph
    join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId and pht.Name = 'Post Closed'
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    group by ph.PostId, crt.Name
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.CreationDate,
        count(c.Id) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as CommentsInLast30Days,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as UpVotesInLast30Days
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.PostId = p.Id
    left join Votes v on v.PostId = p.Id
    where p.CreationDate >= (cast('2024-10-01' as date) - cast('90 days' as interval))
),
CombinedResults as (
    select
        rtc.TagName,
        rtc.Count as TagCount,
        rtc.TotalAnswers,
        rtc.TotalViews,
        ubs.DisplayName as TopUserByBadge,
        ubs.GoldBadges,
        ubs.SilverBadges,
        ubs.BronzeBadges,
        tpv.Title as TopQuestionTitle,
        tpv.Score as TopQuestionScore,
        aa.AnswerId as AcceptedAnswerId,
        aa.AnswerScore,
        aa.AnswerOwnerName,
        crs.CloseReasonName,
        crs.CloseVotesCount,
        ua.CommentsInLast30Days,
        ua.UpVotesInLast30Days
    from RecursiveTagCounts rtc
    left join UserBadgeStats ubs on ubs.BadgeRank = 1
    left join TopPostsWithVotes tpv on tpv.PostRank = 1 and tpv.PostTypeId = 1
    left join AcceptedAnswersCTE aa on aa.QuestionId = tpv.Id and aa.AnswerRank = 1
    left join CloseReasonSummary crs on crs.PostId = tpv.Id
    left join UserActivityWindow ua on ua.UserId = aa.AnswerOwnerUserId
    where rtc.Level = 3
)
select
    TagName,
    TagCount,
    TotalAnswers,
    TotalViews,
    TopUserByBadge,
    GoldBadges,
    SilverBadges,
    BronzeBadges,
    TopQuestionTitle,
    TopQuestionScore,
    AcceptedAnswerId,
    AnswerScore,
    AnswerOwnerName,
    coalesce(CloseReasonName, 'Open') as CloseStatus,
    CloseVotesCount,
    CommentsInLast30Days,
    UpVotesInLast30Days,
    case
        when TotalViews > 100000 then 'High Traffic'
        when TotalViews between 10000 and 100000 then 'Medium Traffic'
        else 'Low Traffic'
    end as TrafficCategory,
    case
        when AnswerScore is null then 'No Accepted Answer'
        when AnswerScore > 50 then 'Highly Rated Answer'
        when AnswerScore between 10 and 50 then 'Moderately Rated Answer'
        else 'Low Rated Answer'
    end as AnswerQuality
from CombinedResults
order by TotalViews desc, TagCount desc
limit 50;