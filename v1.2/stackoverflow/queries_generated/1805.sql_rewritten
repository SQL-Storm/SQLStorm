with RankedPosts as (
  select
    p.Id,
    p.PostTypeId,
    p.ParentId,
    p.AcceptedAnswerId,
    p.CreationDate,
    p.Score,
    p.Title,
    p.Tags,
    p.ViewCount,
    u.Reputation as OwnerReputation,
    coalesce(p.AnswerCount, 0) AnswerCountOrZero,
    count(b.Id) over (partition by p.OwnerUserId) BadgeCount,
    row_number() over (partition by p.OwnerUserId order by p.Score desc, p.CreationDate asc) UserPostRank,
    string_agg(distinct pt.Name, ',') over () AllPostTypes,
    extract(epoch from cast('2024-10-01 12:34:56' as timestamp) - p.CreationDate)/86400.0 as AgeInDays
  from 
    Posts p
  left join Users u on u.Id = p.OwnerUserId
  left join Badges b on b.UserId = p.OwnerUserId
  left join PostTypes pt on pt.Id = p.PostTypeId
  where p.PostTypeId in (1,2) -- questions & answers
)

