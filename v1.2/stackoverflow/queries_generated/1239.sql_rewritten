-- {"query": "1239.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.2, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1317} 
with RecursiveUserActivity AS (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.AcceptedAnswerId,
        row_number() over (partition by u.Id order by p.CreationDate asc) as PostRank,
        count(p.Id) over (partition by u.Id) as TotalPosts,
        coalesce((select max(ph.CreationDate)
                  from PostHistory ph
                  where ph.PostId = p.Id), p.CreationDate) as LastPostHistoryDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where u.Reputation > 5000 and u.CreationDate < cast('2024-10-01 12:34:56' as timestamp) - interval '2 year'
),
BadgeCountPerUser AS (
    select
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        count(*) as TotalBadges
    from Badges b
    group by b.UserId
),
QuestionAnswerStats AS (
    select
        q.Id as QuestionId,
        q.OwnerUserId,
        q.Title,
        q.Tags,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.AnswerCount,
        a.Id as AnswerId,
        a.OwnerUserId as AnswererUserId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreationDate,
        row_number() over (partition by q.Id order by a.Score desc, a.CreationDate) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
),
TopScoringAnswerers AS (
    select
        qs.QuestionId,
        u.Id as UserId,
        u.DisplayName,
        qs.AnswerScore,
        qs.AnswerCreationDate
    from QuestionAnswerStats qs
    join Users u on u.Id = qs.AnswererUserId
    where qs.AnswerRank = 1
),
PostLinksSummary AS (
    select
        pl.PostId,
        count(distinct case when lt.Name = 'Linked' then pl.RelatedPostId end) as LinkedCount,
        count(distinct case when lt.Name = 'Duplicate' then pl.RelatedPostId end) as DuplicateCount
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    group by pl.PostId
),
PostLatestComments AS (
    select distinct on (c.PostId)
        c.PostId,
        c.Id as CommentId,
        c.UserId as CommenterUserId,
        c.UserDisplayName,
        c.Score as CommentScore,
        c.CreationDate as CommentDate,
        substring(c.Text from 1 for 50) as CommentSnippet
    from Comments c
    order by c.PostId, c.Score desc, c.CreationDate desc
),
PopularTags AS (
    select
        t.TagName,
        t.Count,
        coalesce(t.ExcerptPostId, -1) as ExcerptPostId,
        coalesce(t.WikiPostId, -1) as WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired
    from Tags t
    where t.Count > (
        select percentile_cont(0.75) within group (order by Count) from Tags
    )
)
select
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.CreationDate,
    ua.TotalPosts,
    b.GoldBadges,
    b.SilverBadges,
    b.BronzeBadges,
    qs.QuestionId,
    qs.Title,
    substring(qs.Tags from 1 for 100) as QuestionTags,
    qs.QuestionScore,
    qs.QuestionViews,
    pl.LinkedCount,
    pl.DuplicateCount,
    coalesce(tla.DisplayName, 'No Top Answerer') as TopAnswererName,
    tla.AnswerScore,
    pc.CommentId,
    pc.CommenterUserId,
    pc.UserDisplayName as CommenterName,
    pc.CommentScore,
    pc.CommentDate,
    pc.CommentSnippet,
    pt.TagName as PopularTagName,
    pt.Count as PopularTagCount,
    case when pt.IsRequired = 1 then 'Yes' else 'No' end as TagIsRequired,
    case when pt.IsModeratorOnly = 1 then 'Yes' else 'No' end as TagIsModeratorOnly,
    -- Complex conditional expression mixing NULL logic and string concatenation
    case 
        when qs.QuestionScore > 10 and psa.AnswerScore > 5 and ua.Reputation > 10000 
            then concat('HOT: ', coalesce(qs.Title, 'Untitled'), ' [Views:', qs.QuestionViews, ']')
        when ua.Reputation between 5000 and 10000 then concat('ActiveUser: ', ua.DisplayName)
        else 'OtherUser'
    end as UserPostCategory
from RecursiveUserActivity ua
left join BadgeCountPerUser b on b.UserId = ua.UserId
left join QuestionAnswerStats qs on qs.OwnerUserId = ua.UserId and qs.AnswerRank = 1
left join PostLinksSummary pl on pl.PostId = qs.QuestionId
left join TopScoringAnswerers tla on tla.QuestionId = qs.QuestionId
left join PostLatestComments pc on pc.PostId = qs.QuestionId
left join (
    select distinct on (pt.TagName) pt.*
    from PopularTags pt
    order by pt.TagName
    limit 10
) pt on strpos(qs.Tags, concat('<', pt.TagName, '>')) > 0
left join QuestionAnswerStats psa on psa.QuestionId = qs.QuestionId and psa.AnswerRank = 1
where ua.PostRank = 1
order by ua.Reputation desc, qs.QuestionScore desc
limit 100;