with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(b.Id) as BadgeCount,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as TotalUpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as TotalDownVotes,
        row_number() over (partition by u.Id order by p.CreationDate desc nulls last) as LastPostRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.UserId = u.Id
    left join VoteTypes vt on vt.Id = v.VoteTypeId
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
UserTopPosts as (
    select
        p.Id as PostId,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        p.AcceptedAnswerId,
        row_number() over (partition by p.OwnerUserId order by p.Score desc nulls last, p.ViewCount desc nulls last) as PostRank
    from Posts p
    where p.PostTypeId in (1, 2)
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.CreationDate as QuestionCreationDate,
        a.Id as AnswerId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreationDate,
        u.DisplayName as AnswerOwnerName,
        coalesce((select count(*) from Comments c where c.PostId = a.Id), 0) as AnswerCommentCount,
        coalesce((select count(*) from Votes v where v.PostId = a.Id and v.VoteTypeId = 2), 0) as AnswerUpVotes,
        coalesce((select count(*) from Votes v where v.PostId = a.Id and v.VoteTypeId = 3), 0) as AnswerDownVotes
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Users u on u.Id = a.OwnerUserId
    where q.PostTypeId = 1
),
CloseReasonSummary as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        count(*) as CloseCount
    from PostHistory ph
    join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId and pht.Name = 'Post Closed'
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as int)
    group by ph.PostId, crt.Name
),
UserBadgeRanks as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserReputationWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        sum(case when p.PostTypeId = 1 then p.Score else 0 end) over (order by u.Reputation desc rows between unbounded preceding and current row) as CumulativeQuestionScore,
        sum(case when p.PostTypeId = 2 then p.Score else 0 end) over (order by u.Reputation desc rows between unbounded preceding and current row) as CumulativeAnswerScore
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
),
TagPopularity as (
    select
        t.TagName,
        t.Count,
        coalesce(avg(p.Score), 0) as AvgPostScore,
        coalesce(sum(p.ViewCount), 0) as TotalViews,
        coalesce(count(distinct p.OwnerUserId), 0) as DistinctAuthors
    from Tags t
    left join Posts p on p.PostTypeId = 1 and p.Tags like '%' || t.TagName || '%'
    group by t.TagName, t.Count
),
CombinedUserStats as (
    select
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.QuestionCount,
        ua.AnswerCount,
        ua.BadgeCount,
        ua.TotalUpVotes,
        ua.TotalDownVotes,
        coalesce(ubr_badge.Gold, 0) as GoldBadges,
        coalesce(ubr_badge.Silver, 0) as SilverBadges,
        coalesce(ubr_badge.Bronze, 0) as BronzeBadges
    from RecursiveUserActivity ua
    left join (
        select
            UserId,
            max(case when Class = 1 then BadgeCount else 0 end) as Gold,
            max(case when Class = 2 then BadgeCount else 0 end) as Silver,
            max(case when Class = 3 then BadgeCount else 0 end) as Bronze
        from UserBadgeRanks
        group by UserId
    ) ubr_badge on ubr_badge.UserId = ua.UserId
)
select
    cus.UserId,
    cus.DisplayName,
    cus.Reputation,
    cus.QuestionCount,
    cus.AnswerCount,
    cus.BadgeCount,
    cus.GoldBadges,
    cus.SilverBadges,
    cus.BronzeBadges,
    ua.LastAccessDate,
    ua.CreationDate,
    qas.QuestionId,
    qas.Title as QuestionTitle,
    qas.QuestionScore,
    qas.QuestionViews,
    qas.AnswerId,
    qas.AnswerScore,
    qas.AnswerOwnerName,
    qas.AnswerCommentCount,
    qas.AnswerUpVotes,
    qas.AnswerDownVotes,
    crs.CloseReasonName,
    crs.CloseCount,
    tp.TagName,
    tp.Count as TagUsageCount,
    tp.AvgPostScore,
    tp.TotalViews as TagTotalViews,
    tp.DistinctAuthors as TagDistinctAuthors,
    urw.CumulativeQuestionScore,
    urw.CumulativeAnswerScore
from CombinedUserStats cus
join RecursiveUserActivity ua on ua.UserId = cus.UserId
left join QuestionAnswerStats qas on qas.AnswerOwnerName = cus.DisplayName
left join CloseReasonSummary crs on crs.PostId = qas.QuestionId
left join TagPopularity tp on tp.TagName = any(string_to_array(coalesce(qas.Tags, ''), '><'))
left join UserReputationWindow urw on urw.UserId = cus.UserId
where cus.Reputation > 1000
  and (qas.QuestionScore > 5 or qas.AnswerScore > 5)
  and (crs.CloseCount is null or crs.CloseCount < 3)
order by cus.Reputation desc, qas.QuestionScore desc nulls last, qas.AnswerScore desc nulls last
limit 100;