WITH RecursiveTagHierarchy AS (
    -- Recursively find tags linked to a starting tag via duplicates in posts cycles with Linked and Duplicate PostLinks
    SELECT t.Id, t.TagName, ARRAY[t.TagName] AS HierarchyPath, 1 AS Depth
    FROM Tags t
    WHERE t.IsModeratorOnly = 0

    UNION ALL

    SELECT t2.Id,
           t2.TagName,
           r.HierarchyPath || t2.TagName,
           r.Depth + 1
    FROM RecursiveTagHierarchy r
    INNER JOIN Posts p
      ON p.Tags LIKE '%' || '<' || r.TagName || '>' || '%' -- Rough blocking posts belonging to tag
    INNER JOIN PostLinks pl ON pl.PostId = p.Id AND pl.LinkTypeId IN (1,3) -- Linked or Duplicate
    INNER JOIN Posts related_p ON related_p.Id = pl.RelatedPostId
    INNER JOIN Tags t2
      ON related_p.Tags LIKE '%' || '<' || t2.TagName || '>' || '%'
    WHERE t2.IsModeratorOnly = 0
)
SELECT r.Id,
       r.TagName,
       r.HierarchyPath,
       r.Depth
FROM RecursiveTagHierarchy r
GROUP BY r.Id, r.TagName, r.HierarchyPath, r.Depth;