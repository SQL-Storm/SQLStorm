WITH RECURSIVE RECURArmy(ctitle_order, created, owner_uid, ancestry_ids, id, titulo_medonautapaiso) AS (
    SELECT
        "Title" AS ctitle_order,
        "created",
        "owner_uid",
        "ancestry_ids",
        "ID" AS id,
        "TITULO_MEDONAUTAPAISO" AS titulo_medonautapaiso
    FROM
        stackoverflow
)
SELECT
    ctitle_order,
    created,
    owner_uid,
    ancestry_ids,
    id,
    titulo_medonautapaiso
FROM
    RECURArmy;