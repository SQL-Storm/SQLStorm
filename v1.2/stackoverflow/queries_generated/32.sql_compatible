with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        1 as Level,
        array[t.TagName] as Path
    from Tags t
    where t.IsModeratorOnly = false and t.IsRequired = false
    union all
    select
        t.Id,
        t.TagName,
        t.Count,
        r.Level + 1,
        r.Path || t.TagName
    from Tags t
    join RecursiveTagHierarchy r on t.Id > r.Id and t.IsModeratorOnly = false and t.IsRequired = false
    where not t.TagName = any(r.Path)
    and r.Level < 3
),
UserBadgeCounts as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserReputationStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        coalesce(ubc_gold.BadgeCount,0) as GoldBadges,
        coalesce(ubc_silver.BadgeCount,0) as SilverBadges,
        coalesce(ubc_bronze.BadgeCount,0) as BronzeBadges,
        row_number() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join UserBadgeCounts ubc_gold on ubc_gold.UserId = u.Id and ubc_gold.Class = 1
    left join UserBadgeCounts ubc_silver on ubc_silver.UserId = u.Id and ubc_silver.Class = 2
    left join UserBadgeCounts ubc_bronze on ubc_bronze.UserId = u.Id and ubc_bronze.Class = 3
),
TopQuestions as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Tags,
        p.AcceptedAnswerId,
        u.DisplayName as OwnerName,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc) as UserTopQuestionRank
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId = 1
),
AnswerStats as (
    select
        a.ParentId as QuestionId,
        count(*) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore,
        sum(case when a.OwnerUserId is null then 0 else 1 end) as AnsweredByRegisteredUsers
    from Posts a
    where a.PostTypeId = 2
    group by a.ParentId
),
QuestionCloseInfo as (
    select
        ph.PostId,
        max(case when ph.PostHistoryTypeId = 10 then ph.CreationDate else null end) as ClosedDate,
        max(case when ph.PostHistoryTypeId = 11 then ph.CreationDate else null end) as ReopenedDate,
        max(case when ph.PostHistoryTypeId = 10 then ph.Comment else null end) as CloseReasonId
    from PostHistory ph
    where ph.PostHistoryTypeId in (10,11)
    group by ph.PostId
),
QuestionVoteSummary as (
    select
        v.PostId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes,
        sum(case when vt.Name = 'Favorite' then 1 else 0 end) as Favorites
    from Votes v
    join VoteTypes vt on vt.Id = v.VoteTypeId
    group by v.PostId
),
QuestionWithDetails as (
    select
        q.Id,
        q.Title,
        q.OwnerUserId,
        q.Score,
        q.ViewCount,
        q.CreationDate,
        q.Tags,
        q.AcceptedAnswerId,
        q.OwnerName,
        ac.AnswerCount,
        ac.AvgAnswerScore,
        ac.MaxAnswerScore,
        ac.AnsweredByRegisteredUsers,
        qc.ClosedDate,
        qc.ReopenedDate,
        qc.CloseReasonId,
        qvs.UpVotes,
        qvs.DownVotes,
        qvs.Favorites
    from TopQuestions q
    left join AnswerStats ac on ac.QuestionId = q.Id
    left join QuestionCloseInfo qc on qc.PostId = q.Id
    left join QuestionVoteSummary qvs on qvs.PostId = q.Id
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.CreationDate,
        count(*) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as PostsLast30Days,
        sum(case when p.PostTypeId = 1 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as QuestionsLast30Days,
        sum(case when p.PostTypeId = 2 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as AnswersLast30Days
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where p.CreationDate is not null
),
UserTopActivity as (
    select
        UserId,
        DisplayName,
        PostsLast30Days,
        QuestionsLast30Days,
        AnswersLast30Days
    from (
        select
            UserId,
            DisplayName,
            PostsLast30Days,
            QuestionsLast30Days,
            AnswersLast30Days,
            row_number() over (partition by UserId order by PostsLast30Days desc) as rn
        from UserActivityWindow
    ) t
    where rn = 1
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        p1.Title as PostTitle,
        p2.Title as RelatedPostTitle
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId and lt.Name = 'Duplicate'
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
),
QuestionsWithDuplicateCount as (
    select
        q.Id,
        q.Title,
        count(dl.RelatedPostId) as DuplicateCount
    from Posts q
    left join DuplicateLinks dl on dl.PostId = q.Id
    where q.PostTypeId = 1
    group by q.Id, q.Title
),
FinalResult as (
    select
        u.DisplayName as User,
        u.Reputation,
        u.GoldBadges,
        u.SilverBadges,
        u.BronzeBadges,
        ua.PostsLast30Days,
        ua.QuestionsLast30Days,
        ua.AnswersLast30Days,
        qd.DuplicateCount,
        q.Id as QuestionId,
        q.Title as QuestionTitle,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.AnswerCount,
        q.AvgAnswerScore,
        q.MaxAnswerScore,
        q.ClosedDate,
        q.ReopenedDate,
        q.CloseReasonId,
        q.UpVotes,
        q.DownVotes,
        q.Favorites,
        case
            when q.ClosedDate is not null and q.ReopenedDate is null then 'Closed'
            when q.ReopenedDate is not null then 'Reopened'
            else 'Open'
        end as QuestionStatus,
        string_agg(distinct rth.TagName, ', ') as RelatedTagsPath
    from UserReputationStats u
    left join UserTopActivity ua on ua.UserId = u.UserId
    left join QuestionWithDetails q on q.OwnerUserId = u.UserId and q.UserTopQuestionRank = 1
    left join QuestionsWithDuplicateCount qd on qd.Id = q.Id
    left join RecursiveTagHierarchy rth on position(rth.TagName in coalesce(q.Tags, '')) > 0
    where u.Reputation > 1000
    group by u.DisplayName, u.Reputation, u.GoldBadges, u.SilverBadges, u.BronzeBadges, ua.PostsLast30Days, ua.QuestionsLast30Days, ua.AnswersLast30Days, qd.DuplicateCount, q.Id, q.Title, q.Score, q.ViewCount, q.AnswerCount, q.AvgAnswerScore, q.MaxAnswerScore, q.ClosedDate, q.ReopenedDate, q.CloseReasonId, q.UpVotes, q.DownVotes, q.Favorites
    order by u.Reputation desc, q.Score desc
    limit 50
)
select * from FinalResult;