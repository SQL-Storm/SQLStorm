with RecursiveTagHierarchy as (
    select 
        t.Id,
        t.TagName,
        t.Count,
        coalesce(p.Score, 0) as ExcerptScore,
        ROW_NUMBER() over (partition by t.TagName order by coalesce(p.Score, 0) desc) as rn
    from Tags t
    left join Posts p on t.ExcerptPostId = p.Id
    where t.IsModeratorOnly = 0
),
TopTags as (
    select Id, TagName, Count
    from RecursiveTagHierarchy
    where rn = 1
    and Count > (
       select avg(Count)*0.8 from Tags where IsModeratorOnly = 0
    )
),
