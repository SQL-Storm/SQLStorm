with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 as Level,
        array[t.TagName] as Path
    from Tags t
    where t.IsRequired = true
    union all
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        rh.Level + 1,
        rh.Path || t.TagName
    from Tags t
    join PostLinks pl on pl.PostId = t.ExcerptPostId and pl.LinkTypeId = 1
    join RecursiveTagHierarchy rh on pl.RelatedPostId = rh.ExcerptPostId
    where not t.TagName = any(rh.Path)
),
TopContributors as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        sum(coalesce(p.Score,0)) as TotalScore,
        row_number() over (order by sum(coalesce(p.Score,0)) desc) as Rank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where u.Reputation > 1000 and u.CreationDate < cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
    group by u.Id, u.DisplayName
),
PostCloseStats as (
    select
        p.Id as PostId,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        p.ClosedDate,
        crt.Name as CloseReason,
        ph.UserId as CloseVoterUserId,
        ph.CreationDate as CloseVoteDate
    from Posts p
    left join PostHistory ph on ph.PostId = p.Id and ph.PostHistoryTypeId = 10
    left join CloseReasonTypes crt on cast(crt.Id as varchar) = ph.Comment
    where p.PostTypeId = 1
),
UserBadgeCounts as (
    select
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges
    from Badges b
    group by b.UserId
),
UserActivityWindows as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.CreationDate,
        lag(p.CreationDate) over (partition by u.Id order by p.CreationDate) as PrevPostDate,
        lead(p.CreationDate) over (partition by u.Id order by p.CreationDate) as NextPostDate,
        count(*) over (partition by u.Id order by p.CreationDate rows between 5 preceding and current row) as PostsInLast6
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where u.Reputation > 500
),
QuestionAnswerLinkage as (
    select
        q.Id as QuestionId,
        q.Title as QuestionTitle,
        a.Id as AnswerId,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswererId,
        u.DisplayName as AnswererName,
        row_number() over (partition by q.Id order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Users u on u.Id = a.OwnerUserId
    where q.PostTypeId = 1
),
UserCloseVoteLag as (
    select
        pcs.PostId,
        pcs.CloseVoterUserId,
        pcs.CloseVoteDate,
        lag(pcs.CloseVoteDate) over (partition by pcs.CloseVoterUserId order by pcs.CloseVoteDate) as PrevCloseVoteDate,
        pcs.CloseVoteDate - lag(pcs.CloseVoteDate) over (partition by pcs.CloseVoterUserId order by pcs.CloseVoteDate) as CloseVoteInterval
    from PostCloseStats pcs
    where pcs.CloseVoterUserId is not null
)
select
    tc.UserId,
    tc.DisplayName,
    tc.QuestionCount,
    tc.AnswerCount,
    tc.TotalScore,
    coalesce(ub.GoldBadges,0) as GoldBadges,
    coalesce(ub.SilverBadges,0) as SilverBadges,
    coalesce(ub.BronzeBadges,0) as BronzeBadges,
    ua.PostsInLast6,
    (select count(*) from PostCloseStats pcs where pcs.OwnerUserId = tc.UserId and pcs.ClosedDate is not null) as ClosedQuestionsCount,
    string_agg(distinct coalesce(rh.TagName, 'Unknown'), ', ') as RequiredTagsInHierarchy,
    qa.AnswerId,
    qa.AnswerScore,
    qa.AnswererName,
    ucv.CloseVoteInterval,
    case
        when tc.TotalScore > 10000 and coalesce(ub.GoldBadges,0) > 5 then 'Legendary'
        when tc.TotalScore > 5000 and coalesce(ub.SilverBadges,0) > 10 then 'Expert'
        else 'Contributor'
    end as UserLevel,
    left(tc.DisplayName || ' [' || coalesce(string_agg(distinct rh.TagName, '|'), 'NoTags') || ']', 100) as DisplaySummary,
    (
        select count(*)
        from Posts pa
        where pa.PostTypeId = 2
          and pa.OwnerUserId = tc.UserId
          and pa.Score > (
            select avg(pas.Score) from Posts pas where pas.ParentId = pa.ParentId and pas.PostTypeId = 2
          )
    ) as AboveAvgAnswersCount
from TopContributors tc
left join UserBadgeCounts ub on ub.UserId = tc.UserId
left join UserActivityWindows ua on ua.UserId = tc.UserId
left join RecursiveTagHierarchy rh on rh.Level <= 3
left join QuestionAnswerLinkage qa on qa.AnswererId = tc.UserId and qa.AnswerRank = 1
left join UserCloseVoteLag ucv on ucv.CloseVoterUserId = tc.UserId
group by
    tc.UserId,
    tc.DisplayName,
    tc.QuestionCount,
    tc.AnswerCount,
    tc.TotalScore,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ua.PostsInLast6,
    qa.AnswerId,
    qa.AnswerScore,
    qa.AnswererName,
    ucv.CloseVoteInterval
order by tc.TotalScore desc, AboveAvgAnswersCount desc
limit 50;