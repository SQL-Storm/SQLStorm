with recursive RecursiveTagCounts as (
    select
        t.Id as TagId,
        t.TagName,
        t.Count,
        coalesce(p.AnswerCount, 0) as TotalAnswers,
        coalesce(p.ViewCount, 0) as TotalViews
    from Tags t
    left join Posts p on p.Id = t.ExcerptPostId and p.PostTypeId = 1
    union all
    select
        rtc.TagId,
        rtc.TagName,
        rtc.Count,
        rtc.TotalAnswers + coalesce(p2.AnswerCount, 0),
        rtc.TotalViews + coalesce(p2.ViewCount, 0)
    from RecursiveTagCounts rtc
    join Posts p2 on p2.ParentId = rtc.TagId and p2.PostTypeId = 2
    where rtc.TotalAnswers < 1000 and rtc.TotalViews < 1000000
),
UserActivity AS (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct ph.PostId) as EditsCount,
        count(distinct case when v.VoteTypeId = 2 then v.Id end) as UpVotesGiven,
        count(distinct case when v.VoteTypeId = 3 then v.Id end) as DownVotesGiven,
        rank() over (order by count(distinct ph.PostId) desc) as EditRank,
        avg(length(coalesce(c.Text, ''))) over (partition by u.Id) as AvgCommentLength
    from Users u
    left join PostHistory ph on ph.UserId = u.Id and ph.PostHistoryTypeId in (4,5,6)
    left join Votes v on v.UserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostDetails AS (
    select
        p.Id,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        p.AcceptedAnswerId,
        p.ParentId,
        case when p.ClosedDate is not null then 1 else 0 end as IsClosed,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.CreationDate desc) as OwnerTopPostRank
    from Posts p
),
ClosedPostsWithReasons AS (
    select
        ph.PostId,
        crt.Name as CloseReason,
        ph.CreationDate as CloseDate
    from PostHistory ph
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    where ph.PostHistoryTypeId = 10 and ph.Comment is not null
),
AggregatedVotes AS (
    select
        p.Id as PostId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as Favorites,
        count(v.Id) as TotalVotes
    from Posts p
    left join Votes v on v.PostId = p.Id
    group by p.Id
),
AnswerStats AS (
    select
        q.Id as QuestionId,
        count(a.Id) as AnswerCount,
        max(a.Score) as MaxAnswerScore,
        avg(a.Score) as AvgAnswerScore,
        sum(case when a.OwnerUserId = q.OwnerUserId then 1 else 0 end) as SelfAnsweredCount
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id
)
select
    pd.Id as PostId,
    pd.PostTypeId,
    pd.Score,
    pd.ViewCount,
    pd.IsClosed,
    coalesce(cpr.CloseReason, 'N/A') as CloseReason,
    ua.DisplayName as OwnerName,
    ua.EditsCount,
    ua.UpVotesGiven,
    ua.DownVotesGiven,
    ua.EditRank,
    av.UpVotes,
    av.DownVotes,
    av.Favorites,
    av.TotalVotes,
    ast.AnswerCount,
    ast.MaxAnswerScore,
    ast.AvgAnswerScore,
    ast.SelfAnsweredCount,
    rtc.TagName,
    rtc.Count as TagCount,
    rtc.TotalAnswers,
    rtc.TotalViews,
    case 
        when pd.OwnerTopPostRank = 1 then 'Top Post'
        when pd.OwnerTopPostRank <= 3 then 'Top 3 Post'
        else 'Other Post'
    end as OwnerPostRankCategory,
    (length(coalesce(pd.Tags, '')) - length(replace(coalesce(pd.Tags, ''), '><', '')) + 1) as TagCountInPost,
    coalesce(ua.AvgCommentLength, 0) as AvgCommentLength
from PostDetails pd
left join ClosedPostsWithReasons cpr on cpr.PostId = pd.Id
left join UserActivity ua on ua.UserId = pd.OwnerUserId
left join AggregatedVotes av on av.PostId = pd.Id
left join AnswerStats ast on ast.QuestionId = pd.Id
left join RecursiveTagCounts rtc on rtc.TagName = (
    select parts[1]
    from (
        select regexp_split_to_array(substring(pd.Tags from 2 for char_length(pd.Tags)-2), '><') as parts
    ) s
    limit 1
)
where pd.Score > (
    select avg(p2.Score) from Posts p2 where p2.PostTypeId = pd.PostTypeId
)
and (av.UpVotes > coalesce(av.DownVotes,0) or av.TotalVotes is null)
order by pd.Score desc, pd.ViewCount desc
limit 100;