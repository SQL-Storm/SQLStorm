  DisplayName, Location, Reputation, 0 as QuestionsPosted, 0 as CommentsMade, 0 as TotalUpVotesReceived,
  NULL, NULL, NULL, 0, 0, 0, NULL, 0, 0, NULL
FROM Users
WHERE Reputation > 10000 AND NOT EXISTS (
    SELECT 1 FROM Posts AS p WHERE p.OwnerUserId = Users.Id
)
