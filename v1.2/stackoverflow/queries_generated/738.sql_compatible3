with RecursiveUserBadges as (
    select 
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        row_number() over (partition by u.Id order by b.Date desc) as rn
    from Users u
    left join Badges b on b.UserId = u.Id
    where b.Name is not null
), LatestBadges as (
    select UserId, DisplayName, BadgeName, Class
    from RecursiveUserBadges
    where rn <= 3
), QuestionStats as (
    select 
        p.Id as QuestionId,
        p.OwnerUserId,
        p.Title,
        p.CreationDate,
        p.Score as QuestionScore,
        p.ViewCount,
        p.AnswerCount,
        p.Tags,
        coalesce(p.AcceptedAnswerId, -1) as AcceptedAnswerId,
        (select count(*) from Comments c where c.PostId = p.Id) as CommentCount,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 2) as UpVotes,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 3) as DownVotes,
        case 
            when p.ClosedDate is not null then 1
            else 0
        end as IsClosed
    from Posts p
    where p.PostTypeId = 1
), AnswerStats as (
    select 
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId,
        a.CreationDate,
        a.Score,
        (select count(*) from Comments c where c.PostId = a.Id) as CommentCount,
        (select count(*) from Votes v where v.PostId = a.Id and v.VoteTypeId = 2) as UpVotes,
        (select count(*) from Votes v where v.PostId = a.Id and v.VoteTypeId = 3) as DownVotes
    from Posts a
    where a.PostTypeId = 2
), QuestionAnswerRanks as (
    select 
        a.*,
        row_number() over (partition by a.QuestionId order by a.Score desc, a.CreationDate asc) as AnswerRank
    from AnswerStats a
), TagAggregates as (
    select 
        tag as Tag,
        q.QuestionId,
        q.QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        q.IsClosed
    from (
        select 
            QuestionId,
            QuestionScore,
            ViewCount,
            AnswerCount,
            IsClosed,
            regexp_split_to_table(
                substring(Tags from 2 for char_length(Tags)-2),
                '><'
            ) as tag
        from QuestionStats
    ) q
), UserActivity as (
    select 
        u.Id,
        u.DisplayName,
        count(distinct q.QuestionId) as QuestionsPosted,
        count(distinct a.AnswerId) as AnswersPosted,
        count(distinct c.Id) as CommentsMade,
        sum(case when q.IsClosed = 1 then 1 else 0 end) as ClosedQuestions,
        avg(q.QuestionScore) as AvgQuestionScore,
        avg(coalesce(a.Score,0)) as AvgAnswerScore,
        max(coalesce(a.Score,0)) as MaxAnswerScore,
        max(q.ViewCount) as MaxQuestionViews,
        min(u.CreationDate) as UserSince,
        max(u.LastAccessDate) as LastSeen
    from Users u
    left join QuestionStats q on q.OwnerUserId = u.Id
    left join AnswerStats a on a.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName
), PostLinkDetails as (
    select
        pl.PostId,
        pl.RelatedPostId,
        lt.Name as LinkTypeName,
        p1.PostTypeId as PostType,
        p2.PostTypeId as RelatedPostType,
        pl.CreationDate as LinkCreationDate
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
), CloseReasonsDetails as (
    select 
        ph.PostId,
        crt.Name as CloseReasonName,
        ph.CreationDate
    from PostHistory ph
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    where ph.PostHistoryTypeId = 10
), UserReputationWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        sum(coalesce(b.Class,0)) over (partition by u.Id order by b.Date rows between unbounded preceding and current row) as BadgeScoreAccumulated,
        row_number() over (partition by u.Id order by b.Date desc) as BadgeRecentRank
    from Users u
    left join Badges b on b.UserId = u.Id
), CombinedUserSummary as (
    select 
        ua.Id,
        ua.DisplayName,
        ua.QuestionsPosted,
        ua.AnswersPosted,
        ua.CommentsMade,
        ua.ClosedQuestions,
        ua.AvgQuestionScore,
        ua.AvgAnswerScore,
        ua.MaxAnswerScore,
        ua.MaxQuestionViews,
        ua.UserSince,
        ua.LastSeen,
        coalesce(lb.BadgeScoreAccumulated,0) as TotalBadgeScore,
        coalesce(lb.BadgeRecentRank,0) as RecentBadgesCount
    from UserActivity ua
    left join (
        select UserId, max(BadgeScoreAccumulated) as BadgeScoreAccumulated, count(*) as BadgeRecentRank
        from UserReputationWindow
        group by UserId
    ) lb on lb.UserId = ua.Id
)
select
    cus.Id as UserId,
    cus.DisplayName,
    cus.QuestionsPosted,
    cus.AnswersPosted,
    cus.CommentsMade,
    cus.ClosedQuestions,
    round(coalesce(cus.AvgQuestionScore,0),2) as AvgQuestionScore,
    round(coalesce(cus.AvgAnswerScore,0),2) as AvgAnswerScore,
    cus.MaxAnswerScore,
    cus.MaxQuestionViews,
    cus.UserSince,
    cus.LastSeen,
    cus.TotalBadgeScore,
    cus.RecentBadgesCount,
    (
        select array_agg(distinct t.Tag order by t.Tag) 
        from TagAggregates t
        join Posts p on p.Id = t.QuestionId
        where p.OwnerUserId = cus.Id and p.PostTypeId = 1 and t.Tag is not null
    ) as TagsParticipated,
    coalesce((
        select crd.CloseReasonName
        from CloseReasonsDetails crd
        join Posts p on p.Id = crd.PostId
        where p.OwnerUserId = cus.Id and p.PostTypeId = 1
        order by crd.CreationDate desc
        limit 1
    ), 'No Close Reason') as LastCloseReason,
    coalesce((
        select pld.LinkTypeName
        from PostLinkDetails pld
        join Posts p on p.Id = pld.PostId
        where p.OwnerUserId = cus.Id
        order by pld.LinkCreationDate desc
        limit 1
    ), 'No Link') as RecentPostLinkType
from CombinedUserSummary cus
where cus.QuestionsPosted > 5 and cus.AnswersPosted > 10
order by cus.TotalBadgeScore desc, cus.AvgAnswerScore desc, cus.Id, cus.DisplayName
limit 50;