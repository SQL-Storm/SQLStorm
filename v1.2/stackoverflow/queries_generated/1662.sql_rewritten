    SELECT
        OwnerUserId,
        MAX(Score) AS Score,
        FIRST_VALUE(Id) OVER (PARTITION BY OwnerUserId ORDER BY Score DESC, ViewCount DESC NULLS LAST) AS PostId
    FROM Posts 
    WHERE OwnerUserId IS NOT NULL AND PostTypeId IN (1,2)
) ump 
    ON ump.OwnerUserId = u.Id
