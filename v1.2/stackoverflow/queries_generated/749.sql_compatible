with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        b.Name as BadgeName,
        b.Class as BadgeClass,
        row_number() over (partition by u.Id order by b.Date desc) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    where u.Reputation > 1000
),
TopBadges as (
    select
        UserId,
        DisplayName,
        BadgeName,
        BadgeClass
    from RecursiveUserBadges
    where BadgeRank <= 3
),
PopularQuestions as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.CreationDate,
        dense_rank() over (order by p.Score desc, p.ViewCount desc) as PopularRank
    from Posts p
    where p.PostTypeId = 1
      and p.CreationDate > cast('2024-10-01' as date) - interval '1 year'
      and p.Score is not null
),
AnswerStats as (
    select
        a.ParentId as QuestionId,
        count(a.Id) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore,
        sum(case when a.OwnerUserId is null then 0 else 1 end) as AnswersWithOwner
    from Posts a
    where a.PostTypeId = 2
    group by a.ParentId
),
QuestionComments as (
    select
        c.PostId,
        count(c.Id) as CommentCount,
        sum(case when c.UserId is null then 1 else 0 end) as AnonymousComments
    from Comments c
    group by c.PostId
),
DuplicateLinks as (
    select
        pl.PostId,
        count(pl.RelatedPostId) as DuplicateCount
    from PostLinks pl
    where pl.LinkTypeId = 3
    group by pl.PostId
),
UserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionsPosted,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswersPosted,
        max(p.CreationDate) as LastPostDate,
        count(distinct c.Id) as CommentsMade,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotesGiven
    from Users u
    left join Posts p on u.Id = p.OwnerUserId
    left join Comments c on u.Id = c.UserId
    left join Votes v on v.UserId = u.Id
    group by u.Id, u.DisplayName
),
RecentEdits as (
    select
        ph.PostId,
        ph.UserId,
        ph.UserDisplayName,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        row_number() over (partition by ph.PostId order by ph.CreationDate desc) as EditRank
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6)
      and ph.CreationDate > cast('2024-10-01' as date) - interval '30 days'
),
TopTags as (
    select
        unnest(string_to_array(substring(p.Tags from 2 for length(p.Tags)-2), '><')) as Tag,
        count(p.Id) as QuestionCount,
        avg(p.Score) as AvgScore
    from Posts p
    where p.PostTypeId = 1
      and p.Tags is not null
    group by unnest(string_to_array(substring(p.Tags from 2 for length(p.Tags)-2), '><'))
    having count(p.Id) > 100
),
CombinedResults as (
    select
        pq.Id as QuestionId,
        pq.Title,
        pq.Score as QuestionScore,
        pq.ViewCount,
        pq.Tags,
        pq.CreationDate as QuestionCreationDate,
        ast.AnswerCount,
        ast.AvgAnswerScore,
        ast.MaxAnswerScore,
        qc.CommentCount,
        coalesce(dl.DuplicateCount, 0) as DuplicateCount,
        ua.QuestionsPosted,
        ua.AnswersPosted,
        ua.CommentsMade,
        ua.UpVotesGiven,
        tb.BadgeName,
        tb.BadgeClass,
        re.UserDisplayName as LastEditor,
        re.PostHistoryTypeId as LastEditType,
        re.CreationDate as LastEditDate
    from PopularQuestions pq
    left join AnswerStats ast on pq.Id = ast.QuestionId
    left join QuestionComments qc on pq.Id = qc.PostId
    left join DuplicateLinks dl on pq.Id = dl.PostId
    left join UserActivity ua on pq.OwnerUserId = ua.UserId
    left join TopBadges tb on pq.OwnerUserId = tb.UserId and tb.BadgeClass = 1
    left join RecentEdits re on pq.Id = re.PostId and re.EditRank = 1
)
select
    cr.QuestionId,
    cr.Title,
    cr.QuestionScore,
    cr.ViewCount,
    cr.Tags,
    cr.AnswerCount,
    cr.AvgAnswerScore,
    cr.MaxAnswerScore,
    cr.CommentCount,
    cr.DuplicateCount,
    cr.QuestionsPosted,
    cr.AnswersPosted,
    cr.CommentsMade,
    cr.UpVotesGiven,
    cr.BadgeName,
    cr.BadgeClass,
    cr.LastEditor,
    cr.LastEditType,
    cr.LastEditDate,
    tt.Tag as PopularTag,
    tt.QuestionCount as PopularTagQuestionCount,
    tt.AvgScore as PopularTagAvgScore
from CombinedResults cr
left join lateral (
    select Tag, QuestionCount, AvgScore
    from TopTags tt
    where cr.Tags like '%' || tt.Tag || '%'
    order by QuestionCount desc
    limit 1
) tt on true
where coalesce(cr.AnswerCount, 0) > 5
  and cr.QuestionScore > 10
  and (cr.LastEditDate is null or cr.LastEditDate > cast('2024-10-01' as date) - interval '7 days')
order by cr.QuestionScore desc, cr.ViewCount desc
limit 100;