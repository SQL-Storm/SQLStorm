with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        coalesce(u.Views, 0) as Views,
        coalesce(u.UpVotes,0) as UpVotes,
        coalesce(u.DownVotes,0) as DownVotes,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionsAsked,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswersProvided,
        count(distinct c.Id) as CommentsMade,
        row_number() over (partition by u.Id order by max(ph.CreationDate) desc) as LastActivityRank,
        max(ph.CreationDate) as LastPostHistoryDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join PostHistory ph on ph.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Location, u.Views, u.UpVotes, u.DownVotes
),
UserBadgeSummary as (
    select
        b.UserId,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        count(distinct b.Name) as UniqueBadges
    from Badges b
    group by b.UserId
),
PostScoreRankings as (
    select
        p.Id as PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        dense_rank() over (partition by p.PostTypeId order by p.Score desc, p.ViewCount desc) as ScoreRankWithinType,
        rank() over (partition by p.PostTypeId order by p.CreationDate desc) as RecentRankWithinType,
        regexp_substr(p.Body, 'href="([^"]+)"', 1, 1, NULL, 1) as FirstHyperlink,
        coalesce(p.FavoriteCount,0) as Favorites
    from Posts p
),
TagExplode as (
    select
        p.PostId,
        trim(t.tag) as Tag
    from (
        select
            Id as PostId,
            regexp_split_to_table(substring(Tags from 2 for length(Tags) - 2), '><') as tag
        from Posts
        where PostTypeId = 1 and Tags is not null
    ) p
),
AnswerRankingPerQuestion as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId,
        a.Score,
        row_number() over (partition by a.ParentId order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts a
    where a.PostTypeId = 2
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        pl.LinkTypeId,
        p1.Title as PostTitle,
        p2.Title as RelatedPostTitle
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where pl.LinkTypeId = 3
),
UsersWithBadgesAndActivity as (
    select
        ua.*,
        coalesce(ubs.GoldBadges,0) as GoldBadges,
        coalesce(ubs.SilverBadges,0) as SilverBadges,
        coalesce(ubs.BronzeBadges,0) as BronzeBadges,
        coalesce(ubs.UniqueBadges,0) as UniqueBadges
    from RecursiveUserActivity ua
    left join UserBadgeSummary ubs on ubs.UserId = ua.UserId
),
PostsEnriched as (
    select
        ps.*,
        te.Tag,
        ar.AnswerRank,
        dl.RelatedPostId as DuplicateOfPostId,
        dl.RelatedPostTitle as DuplicateOfPostTitle
    from PostScoreRankings ps
    left join TagExplode te on te.PostId = ps.PostId
    left join AnswerRankingPerQuestion ar on ar.AnswerId = ps.PostId
    left join DuplicateLinks dl on dl.PostId = ps.PostId
)
select
    ue.UserId,
    ue.DisplayName,
    ue.Reputation,
    ue.Location,
    ue.Views,
    ue.UpVotes,
    ue.DownVotes,
    ue.QuestionsAsked,
    ue.AnswersProvided,
    ue.CommentsMade,
    ue.LastPostHistoryDate,
    ue.GoldBadges,
    ue.SilverBadges,
    ue.BronzeBadges,
    ue.UniqueBadges,
    pe.PostId,
    pe.PostTypeId,
    pe.CreationDate as PostCreationDate,
    pe.Score as PostScore,
    pe.ViewCount,
    pe.Tag,
    pe.AnswerRank,
    pe.DuplicateOfPostId,
    pe.DuplicateOfPostTitle,
    case 
        when pe.PostTypeId = 1 and pe.Favorites > 10 then 'PopularQuestion'
        when pe.PostTypeId = 2 and pe.AnswerRank = 1 then 'TopAnswer'
        else 'Other'
    end as PostCategory,
    coalesce(
        (select count(*) from Comments c where c.PostId = pe.PostId and c.Score > 0),
        0
    ) as PositiveCommentsCount,
    coalesce(
        (select sum(v.BountyAmount) from Votes v where v.PostId = pe.PostId and v.VoteTypeId in (8,9)),
        0
    ) as TotalBountyAwarded,
    row_number() over (
        partition by ue.UserId 
        order by pe.Score desc, pe.ViewCount desc
    ) as UserPostRank,
    (ue.DisplayName || ' / ' || coalesce(pe.Tag, 'NoTag') || ' / ' || 
        (case when pe.DuplicateOfPostId is not null then 'DuplicateOf:' || cast(pe.DuplicateOfPostId as varchar) else 'Original' end)
    ) as CompositeIdentifier
from UsersWithBadgesAndActivity ue
left join PostsEnriched pe on pe.OwnerUserId = ue.UserId
where ue.Reputation > 1000
  and (pe.PostTypeId = 1 or pe.PostTypeId = 2)
  and (pe.CreationDate > ue.CreationDate + interval '180 days' or pe.CreationDate is null)
  and pe.Score is not null
  and (pe.Tag not ilike '%deprecated%' or pe.Tag is null)
group by
    ue.UserId,
    ue.DisplayName,
    ue.Reputation,
    ue.Location,
    ue.Views,
    ue.UpVotes,
    ue.DownVotes,
    ue.QuestionsAsked,
    ue.AnswersProvided,
    ue.CommentsMade,
    ue.LastPostHistoryDate,
    ue.GoldBadges,
    ue.SilverBadges,
    ue.BronzeBadges,
    ue.UniqueBadges,
    pe.PostId,
    pe.PostTypeId,
    pe.CreationDate,
    pe.Score,
    pe.ViewCount,
    pe.Tag,
    pe.AnswerRank,
    pe.DuplicateOfPostId,
    pe.DuplicateOfPostTitle,
    pe.Favorites,
    ue.DisplayName,
    pe.DuplicateOfPostId
order by ue.Reputation desc, pe.Score desc
limit 100;