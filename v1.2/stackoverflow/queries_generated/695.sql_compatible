WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        ARRAY[t.TagName] AS TagPath
    FROM Tags t
    WHERE t.IsRequired = 1
    UNION ALL
    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        rth.TagPath || t2.TagName
    FROM Tags t2
    JOIN RecursiveTagHierarchy rth ON t2.Id != rth.Id AND t2.Count < rth.Count
    WHERE array_length(rth.TagPath, 1) < 3
),
UserBadgeStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COALESCE(SUM(CASE WHEN b.TagBased = 1 THEN 1 ELSE 0 END), 0) AS TagBasedBadges,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.CreationDate) AS UserRank
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
PostActivityWindows AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        LEAD(p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS NextPostDate,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PrevScore,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) AS TotalPostsByUser,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) AS AvgScoreByUser
    FROM Posts p
    WHERE p.PostTypeId IN (1,2)
),
ClosedQuestionsWithReasons AS (
    SELECT
        ph.PostId,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN crt.Name ELSE NULL END) AS CloseReason,
        COUNT(DISTINCT ph.UserId) AS CloseVotersCount,
        MAX(ph.CreationDate) AS ClosedAt
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON (CASE WHEN ph.Comment ~ '^[0-9]+$' THEN CAST(ph.Comment AS INTEGER) ELSE NULL END) = crt.Id AND ph.PostHistoryTypeId = 10
    WHERE ph.PostHistoryTypeId = 10
    GROUP BY ph.PostId
),
AnswerScoresWithVotes AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.OwnerUserId,
        a.Score AS AnswerScore,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS UpVotesCount,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS DownVotesCount,
        (COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) - COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0)) AS NetVotes,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank
    FROM Posts a
    LEFT JOIN Votes v ON v.PostId = a.Id
    WHERE a.PostTypeId = 2
    GROUP BY a.Id, a.ParentId, a.OwnerUserId, a.Score, a.CreationDate
),
TopAnswersPerQuestion AS (
    SELECT
        AnswerId,
        QuestionId,
        OwnerUserId,
        AnswerScore,
        UpVotesCount,
        DownVotesCount,
        NetVotes
    FROM AnswerScoresWithVotes
    WHERE AnswerRank = 1
),
QuestionsWithTopAnswers AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate AS QuestionCreation,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.Tags,
        ta.AnswerId,
        ta.AnswerScore,
        ta.UpVotesCount,
        ta.DownVotesCount,
        ta.NetVotes,
        ubs.DisplayName AS AnswererName,
        ubs.GoldBadges,
        ubs.SilverBadges,
        ubs.BronzeBadges,
        ubs.TagBasedBadges
    FROM Posts q
    LEFT JOIN TopAnswersPerQuestion ta ON ta.QuestionId = q.Id
    LEFT JOIN UserBadgeStats ubs ON ubs.UserId = ta.OwnerUserId
    WHERE q.PostTypeId = 1
),
QuestionsWithCloseInfo AS (
    SELECT
        qta.*,
        cqr.CloseReason,
        cqr.CloseVotersCount,
        cqr.ClosedAt
    FROM QuestionsWithTopAnswers qta
    LEFT JOIN ClosedQuestionsWithReasons cqr ON cqr.PostId = qta.QuestionId
),
FinalAggregatedStats AS (
    SELECT
        q.CloseReason,
        COUNT(DISTINCT q.QuestionId) AS QuestionsCount,
        AVG(q.QuestionScore) AS AvgQuestionScore,
        AVG(q.AnswerScore) AS AvgTopAnswerScore,
        AVG(q.NetVotes) AS AvgTopAnswerNetVotes,
        AVG(q.GoldBadges) AS AvgGoldBadgesOfTopAnswerers,
        AVG(q.SilverBadges) AS AvgSilverBadgesOfTopAnswerers,
        AVG(q.BronzeBadges) AS AvgBronzeBadgesOfTopAnswerers,
        AVG(q.TagBasedBadges) AS AvgTagBadgesOfTopAnswerers,
        AVG(EXTRACT(EPOCH FROM (COALESCE(q.ClosedAt, CAST('2024-10-01 12:34:56' AS timestamp)) - q.QuestionCreation))/3600) AS AvgHoursToClose
    FROM QuestionsWithCloseInfo q
    GROUP BY q.CloseReason
    ORDER BY QuestionsCount DESC
)
SELECT
    fas.CloseReason,
    fas.QuestionsCount,
    fas.AvgQuestionScore,
    fas.AvgTopAnswerScore,
    fas.AvgTopAnswerNetVotes,
    fas.AvgGoldBadgesOfTopAnswerers,
    fas.AvgSilverBadgesOfTopAnswerers,
    fas.AvgBronzeBadgesOfTopAnswerers,
    fas.AvgTagBadgesOfTopAnswerers,
    fas.AvgHoursToClose,
    STRING_AGG(DISTINCT rh.TagName, ', ') FILTER (WHERE rh.TagName IS NOT NULL) AS RelatedRequiredTagsPath
FROM FinalAggregatedStats fas
LEFT JOIN RecursiveTagHierarchy rh ON rh.TagName IS NOT NULL
GROUP BY fas.CloseReason, fas.QuestionsCount, fas.AvgQuestionScore, fas.AvgTopAnswerScore, fas.AvgTopAnswerNetVotes, fas.AvgGoldBadgesOfTopAnswerers, fas.AvgSilverBadgesOfTopAnswerers, fas.AvgBronzeBadgesOfTopAnswerers, fas.AvgTagBadgesOfTopAnswerers, fas.AvgHoursToClose
ORDER BY fas.QuestionsCount DESC;