with TagScores as (
    select
        distinct
        TagsValue as Tag,
        avg_secret_score,
        postcount_in_tag,
        linked_dupl_count
    from (
        select 
            p.Id,
            case 
                when p.Tags is NULL then ''
                else p.Tags
            end as TagsValue,
            avg_secret_score,
            postcount_in_tag,
            linked_dupl_count
        from posts p
        left join post_tag_stats s on s.post_id = p.Id
    ) t
)
select
    Tag,
    avg_secret_score,
    postcount_in_tag,
    linked_dupl_count
from TagScores
group by
    Tag,
    avg_secret_score,
    postcount_in_tag,
    linked_dupl_count;