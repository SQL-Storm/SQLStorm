with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        1 as Level,
        array[t.TagName] as Path
    from Tags t
    where t.IsModeratorOnly = false and t.IsRequired = false
    union all
    select
        t2.Id,
        t2.TagName,
        t2.Count,
        r.Level + 1,
        r.Path || t2.TagName
    from Tags t2
    join RecursiveTagHierarchy r on t2.Id > r.Id and t2.IsModeratorOnly = false and t2.IsRequired = false
    where not t2.TagName = any(r.Path)
    and r.Level < 3
),
UserBadgeCounts as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserReputationRanks as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.Tags,
        count(a.Id) filter (where a.Id is not null) as AnswerCount,
        max(a.Score) filter (where a.Id is not null) as MaxAnswerScore,
        avg(a.Score) filter (where a.Id is not null) as AvgAnswerScore,
        sum(case when a.OwnerUserId is not null then 1 else 0 end) filter (where a.Id is not null) as AnswersWithOwner
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.CreationDate, q.Score, q.ViewCount, q.Tags
),
TopVoters as (
    select
        v.UserId,
        count(*) as VoteCount,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes
    from Votes v
    join VoteTypes vt on v.VoteTypeId = vt.Id
    where v.UserId is not null
    group by v.UserId
),
PostCloseReasons as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        count(*) as CloseCount
    from PostHistory ph
    join PostHistoryTypes pht on ph.PostHistoryTypeId = pht.Id
    left join CloseReasonTypes crt on cast(ph.Comment as integer) = crt.Id
    where ph.PostHistoryTypeId = 10
    group by ph.PostId, crt.Name
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionsPosted,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswersPosted,
        count(c.Id) as CommentsMade,
        row_number() over (partition by u.Id order by p.CreationDate desc) as LastPostRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
UserRecentPosts as (
    select
        p.Id,
        p.OwnerUserId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as PostRank
    from Posts p
    where p.OwnerUserId is not null
),
UserTopPosts as (
    select
        urp.OwnerUserId,
        count(*) as TopPostsCount,
        avg(urp.Score) as AvgTopPostScore,
        max(urp.Score) as MaxTopPostScore
    from UserRecentPosts urp
    where urp.PostRank <= 5
    group by urp.OwnerUserId
)
select
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    ur.ReputationRank,
    coalesce(ubc_gold.BadgeCount,0) as GoldBadges,
    coalesce(ubc_silver.BadgeCount,0) as SilverBadges,
    coalesce(ubc_bronze.BadgeCount,0) as BronzeBadges,
    coalesce(tv.VoteCount,0) as TotalVotesCast,
    coalesce(tv.UpVotes,0) as UpVotesCast,
    coalesce(tv.DownVotes,0) as DownVotesCast,
    ua.QuestionsPosted,
    ua.AnswersPosted,
    ua.CommentsMade,
    utp.TopPostsCount,
    utp.AvgTopPostScore,
    utp.MaxTopPostScore,
    qas.AnswerCount as TotalAnswersToUserQuestions,
    qas.MaxAnswerScore as MaxAnswerScoreOnUserQuestions,
    qas.AvgAnswerScore as AvgAnswerScoreOnUserQuestions,
    pcr.CloseReasonName,
    pcr.CloseCount,
    string_agg(distinct rth.TagName, ',' order by rth.TagName) as SampleTagHierarchy
from Users u
left join UserReputationRanks ur on u.Id = ur.Id
left join UserBadgeCounts ubc_gold on u.Id = ubc_gold.UserId and ubc_gold.Class = 1
left join UserBadgeCounts ubc_silver on u.Id = ubc_silver.UserId and ubc_silver.Class = 2
left join UserBadgeCounts ubc_bronze on u.Id = ubc_bronze.UserId and ubc_bronze.Class = 3
left join TopVoters tv on u.Id = tv.UserId
left join UserActivityWindow ua on u.Id = ua.UserId
left join UserTopPosts utp on u.Id = utp.OwnerUserId
left join (
    select
        q.OwnerUserId,
        sum(qas.AnswerCount) as AnswerCount,
        max(qas.MaxAnswerScore) as MaxAnswerScore,
        avg(qas.AvgAnswerScore) as AvgAnswerScore
    from Posts q
    join QuestionAnswerStats qas on q.Id = qas.QuestionId
    where q.PostTypeId = 1 and q.OwnerUserId is not null
    group by q.OwnerUserId
) qas on u.Id = qas.OwnerUserId
left join (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        count(*) as CloseCount
    from PostHistory ph
    join CloseReasonTypes crt on cast(ph.Comment as integer) = crt.Id
    where ph.PostHistoryTypeId = 10
    group by ph.PostId, crt.Name
    order by CloseCount desc
    limit 1
) pcr on true
left join RecursiveTagHierarchy rth on rth.Level = 1
where u.Reputation > 1000
group by
    u.Id, u.DisplayName, u.Reputation, ur.ReputationRank,
    ubc_gold.BadgeCount, ubc_silver.BadgeCount, ubc_bronze.BadgeCount,
    tv.VoteCount, tv.UpVotes, tv.DownVotes,
    ua.QuestionsPosted, ua.AnswersPosted, ua.CommentsMade,
    utp.TopPostsCount, utp.AvgTopPostScore, utp.MaxTopPostScore,
    qas.AnswerCount, qas.MaxAnswerScore, qas.AvgAnswerScore,
    pcr.CloseReasonName, pcr.CloseCount, rth.TagName
order by u.Reputation desc
limit 100;