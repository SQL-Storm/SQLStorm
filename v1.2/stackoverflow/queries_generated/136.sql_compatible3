with recursive RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 as Level,
        cast(array[t.TagName] as text[]) as Path
    from Tags t
    where t.IsRequired = true

    union all

    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        r.Level + 1,
        r.Path || t.TagName
    from Tags t
    join RecursiveTagHierarchy r on t.IsRequired = true and t.Id <> r.Id and not t.TagName = any(r.Path)
    where r.Level < 3
),
UserBadgeCounts as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserReputationStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        coalesce(ubc_gold.BadgeCount, 0) as GoldBadges,
        coalesce(ubc_silver.BadgeCount, 0) as SilverBadges,
        coalesce(ubc_bronze.BadgeCount, 0) as BronzeBadges,
        row_number() over (order by u.Reputation desc) as ReputationRank,
        dense_rank() over (partition by u.Location order by u.Reputation desc) as LocationReputationRank
    from Users u
    left join UserBadgeCounts ubc_gold on ubc_gold.UserId = u.Id and ubc_gold.Class = 1
    left join UserBadgeCounts ubc_silver on ubc_silver.UserId = u.Id and ubc_silver.Class = 2
    left join UserBadgeCounts ubc_bronze on ubc_bronze.UserId = u.Id and ubc_bronze.Class = 3
),
TopQuestionsWithAnswers as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreationDate,
        q.Score as QuestionScore,
        q.ViewCount,
        q.Tags,
        q.OwnerUserId,
        a.Id as AnswerId,
        a.CreationDate as AnswerCreationDate,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerOwnerUserId,
        a.ParentId,
        a.Body as AnswerBody,
        row_number() over (partition by q.Id order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
      and q.Score > 10
      and q.ViewCount > 1000
),
AnswerCommentsAggregated as (
    select
        c.PostId,
        count(*) filter (where c.Score > 0) as PositiveComments,
        count(*) filter (where c.Score <= 0 or c.Score is null) as NonPositiveComments,
        string_agg(distinct coalesce(c.UserDisplayName, 'Anonymous'), ', ' order by c.CreationDate desc) as Commenters
    from Comments c
    group by c.PostId
),
QuestionCloseReasons as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        count(*) as CloseVotesCount
    from PostHistory ph
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    where ph.PostHistoryTypeId = 10
    group by ph.PostId, crt.Name
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.CreationDate,
        count(*) over (partition by u.Id order by p.CreationDate range between interval '30 days' preceding and current row) as PostsLast30Days,
        sum(case when p.PostTypeId = 1 then 1 else 0 end) over (partition by u.Id order by p.CreationDate range between interval '30 days' preceding and current row) as QuestionsLast30Days,
        sum(case when p.PostTypeId = 2 then 1 else 0 end) over (partition by u.Id order by p.CreationDate range between interval '30 days' preceding and current row) as AnswersLast30Days
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
),
HighImpactPosts as (
    select
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 2) as UpVotes,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 3) as DownVotes,
        (select count(*) from Comments c where c.PostId = p.Id) as CommentCount,
        case
            when p.Score > 100 and p.ViewCount > 10000 then 'High'
            when p.Score between 50 and 100 and p.ViewCount between 5000 and 10000 then 'Medium'
            else 'Low'
        end as ImpactCategory
    from Posts p
    where p.PostTypeId in (1,2)
),
CombinedUserStats as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        coalesce(hp.HighImpactPostCount, 0) as HighImpactPostCount,
        coalesce(ua.PostsLast30Days, 0) as PostsLast30Days,
        coalesce(ua.QuestionsLast30Days, 0) as QuestionsLast30Days,
        coalesce(ua.AnswersLast30Days, 0) as AnswersLast30Days,
        coalesce(ubc_gold.BadgeCount, 0) as GoldBadges,
        coalesce(ubc_silver.BadgeCount, 0) as SilverBadges,
        coalesce(ubc_bronze.BadgeCount, 0) as BronzeBadges
    from Users u
    left join (
        select OwnerUserId, count(*) as HighImpactPostCount
        from HighImpactPosts
        group by OwnerUserId
    ) hp on hp.OwnerUserId = u.Id
    left join (
        select UserId,
            max(PostsLast30Days) as PostsLast30Days,
            max(QuestionsLast30Days) as QuestionsLast30Days,
            max(AnswersLast30Days) as AnswersLast30Days
        from UserActivityWindow
        group by UserId
    ) ua on ua.UserId = u.Id
    left join UserBadgeCounts ubc_gold on ubc_gold.UserId = u.Id and ubc_gold.Class = 1
    left join UserBadgeCounts ubc_silver on ubc_silver.UserId = u.Id and ubc_silver.Class = 2
    left join UserBadgeCounts ubc_bronze on ubc_bronze.UserId = u.Id and ubc_bronze.Class = 3
)
select
    q.QuestionId,
    q.Title as QuestionTitle,
    q.QuestionCreationDate,
    q.QuestionScore,
    q.ViewCount,
    q.Tags,
    u.DisplayName as QuestionOwner,
    u.Reputation as QuestionOwnerReputation,
    coalesce(ac.PositiveComments, 0) as AnswerPositiveComments,
    coalesce(ac.NonPositiveComments, 0) as AnswerNonPositiveComments,
    ac.Commenters as AnswerCommenters,
    cr.CloseReasonName,
    cr.CloseVotesCount,
    ans.AnswerId,
    ans.AnswerCreationDate,
    ans.AnswerScore,
    ans.AnswerOwnerUserId,
    ans.AnswerBody,
    urs.GoldBadges,
    urs.SilverBadges,
    urs.BronzeBadges,
    urs.ReputationRank,
    urs.LocationReputationRank,
    cus.HighImpactPostCount,
    cus.PostsLast30Days,
    cus.QuestionsLast30Days,
    cus.AnswersLast30Days
from TopQuestionsWithAnswers q
left join Users u on u.Id = q.OwnerUserId
left join AnswerCommentsAggregated ac on ac.PostId = q.AnswerId
left join QuestionCloseReasons cr on cr.PostId = q.QuestionId
left join Posts ans on ans.Id = q.AnswerId
left join UserReputationStats urs on urs.UserId = q.OwnerUserId
left join CombinedUserStats cus on cus.Id = q.OwnerUserId
where q.AnswerRank = 1
  and (cr.CloseVotesCount is null or cr.CloseVotesCount < 3)
order by q.QuestionScore desc, ans.AnswerScore desc
limit 100;