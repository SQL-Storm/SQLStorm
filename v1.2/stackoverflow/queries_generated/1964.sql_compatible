WITH RecursiveCte AS (
    SELECT
        p.Id AS post_id,
        p.OwnerUserId AS user_id,
        p.PostTypeId,
        p.ScopescoreScore AS fact_comb,
        p.TitleTitleIfcitiesiber_Kill_etd_fo AS title
    FROM posts p
)
SELECT
    post_id,
    user_id,
    PostTypeId,
    fact_comb,
    title
FROM RecursiveCte
GROUP BY
    post_id,
    user_id,
    PostTypeId,
    fact_comb,
    title;