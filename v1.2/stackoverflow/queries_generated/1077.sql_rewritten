-- {"query": "1077.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1437} 
with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 as Level,
        array[t.TagName] as HierarchyPath
    from Tags t
    where t.IsRequired = 1

    union all

    select
        child.Id,
        child.TagName,
        child.Count,
        child.ExcerptPostId,
        child.WikiPostId,
        child.IsModeratorOnly,
        child.IsRequired,
        r.Level + 1,
        r.HierarchyPath || child.TagName
    from Tags child
    join RecursiveTagHierarchy r on child.IsRequired = 1 and child.TagName <> all(r.HierarchyPath)
    where r.Level < 3
),
AnswerStats as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        u.Id as OwnerUserId,
        u.DisplayName,
        a.Score,
        a.CreationDate,
        rank() over(partition by a.ParentId order by a.Score desc, a.CreationDate asc) as ScoreRank,
        count(c.Id) as CommentCount,
        bool_or(v.VoteTypeId = 2) as HasUpvote,
        bool_or(v.VoteTypeId = 3) as HasDownvote
    from Posts a
    left join Users u on a.OwnerUserId = u.Id
    left join Comments c on c.PostId = a.Id
    left join Votes v on v.PostId = a.Id
    where a.PostTypeId = 2
    group by a.Id, a.ParentId, u.Id, u.DisplayName, a.Score, a.CreationDate
),
QuestionAggregates as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate,
        q.OwnerUserId,
        u.DisplayName as OwnerDisplayName,
        q.Score as QuestionScore,
        q.ViewCount,
        q.Tags,
        count(a.AnswerId) as TotalAnswers,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore,
        sum(case when a.ScoreRank = 1 then 1 else 0 end) as TopRankedAnswers,
        tagh.Level as TagDepth
    from Posts q
    left join Users u on q.OwnerUserId = u.Id
    left join AnswerStats a on a.QuestionId = q.Id
    left join RecursiveTagHierarchy tagh on position(concat('<', tagh.TagName, '>') in q.Tags) > 0
    where q.PostTypeId = 1 and q.ClosedDate is null
    group by q.Id, q.Title, q.CreationDate, q.OwnerUserId, u.DisplayName, q.Score, q.ViewCount, q.Tags, tagh.Level
),
UserBadgeCounts as (
    select
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges
    from Badges b
    group by b.UserId
),
UserReputationRanks as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        row_number() over(order by u.Reputation desc) as ReputationRank
    from Users u
),
ComplexAggregates as (
    select
        q.QuestionId,
        q.Title,
        q.OwnerDisplayName,
        q.QuestionScore,
        q.ViewCount,
        q.TotalAnswers,
        q.AvgAnswerScore,
        q.MaxAnswerScore,
        q.TopRankedAnswers,
        q.TagDepth,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ur.Reputation,
        ur.ReputationRank,
        case
            when q.ViewCount > 10000 then 'High Traffic'
            when q.ViewCount between 1000 and 10000 then 'Medium Traffic'
            else 'Low Traffic'
        end as TrafficCategory,
        concat(
            'Q: ',
            coalesce(q.Title, 'N/A'),
            ' | Owner: ',
            coalesce(q.OwnerDisplayName, '???'),
            ' | Score: ', q.QuestionScore,
            ' | Answers: ', q.TotalAnswers,
            ' | TopAns: ', q.TopRankedAnswers,
            ' | Rep: ', ur.Reputation
        ) as Summary
    from QuestionAggregates q
    left join UserBadgeCounts ub on ub.UserId = q.OwnerUserId
    left join UserReputationRanks ur on ur.UserId = q.OwnerUserId
)
select
    ca.QuestionId,
    ca.Title,
    ca.OwnerDisplayName,
    ca.ReputationRank,
    ca.GoldBadges,
    ca.SilverBadges,
    ca.BronzeBadges,
    ca.QuestionScore,
    ca.ViewCount,
    ca.TotalAnswers,
    ca.AvgAnswerScore,
    ca.MaxAnswerScore,
    ca.TopRankedAnswers,
    ca.TrafficCategory,
    ca.TagDepth,
    ca.Summary,
    (select ph.Comment
     from PostHistory ph
     where ph.PostId = ca.QuestionId
       and ph.PostHistoryTypeId = 10
     order by ph.CreationDate desc
     limit 1) as LastCloseReasonComment,
    case
        when exists(
            select 1
            from PostLinks pl
            where pl.PostId = ca.QuestionId
              and pl.LinkTypeId = 3
              and pl.CreationDate > cast('2024-10-01' as date) - interval '30 days'
        ) then 'Recently Marked Duplicate'
        else 'No Recent Duplicate'
    end as DuplicateStatus
from ComplexAggregates ca
where ca.TotalAnswers > 5
  and ca.AvgAnswerScore is not null
  and ca.ReputationRank <= 100
union
select
    ca.QuestionId + 1000000000,
    ca.Title,
    ca.OwnerDisplayName,
    ca.ReputationRank,
    ca.GoldBadges,
    ca.SilverBadges,
    ca.BronzeBadges,
    ca.QuestionScore,
    ca.ViewCount,
    ca.TotalAnswers,
    ca.AvgAnswerScore,
    ca.MaxAnswerScore,
    ca.TopRankedAnswers,
    ca.TrafficCategory,
    ca.TagDepth,
    ca.Summary || ' (UNION COPY)',
    null,
    'No Recent Duplicate'
from ComplexAggregates ca
where ca.TotalAnswers > 10
order by ReputationRank, QuestionScore desc, TotalAnswers desc
limit 50;