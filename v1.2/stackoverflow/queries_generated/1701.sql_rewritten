with RecursiveUserEdits as (
    select
        ph.UserId,
        ph.PostId,
        count(*) as EditCount,
        min(ph.CreationDate) as FirstEdit,
        max(ph.CreationDate) as LastEdit
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6,7,8,9,24)
    group by ph.UserId, ph.PostId

    union all

    select
        r.UserId,
        ph.PostId,
        r.EditCount + 1,
        least(r.FirstEdit, ph.CreationDate),
        greatest(r.LastEdit, ph.CreationDate)
    from RecursiveUserEdits r
    join PostHistory ph on ph.UserId = r.UserId and ph.PostId = r.PostId
        and ph.CreationDate > r.LastEdit
        and ph.PostHistoryTypeId in (4,5,6,7,8,9,24)
    where r.EditCount < 10
),
post_scores as (
    select p.Id,
        p.Title,
        p.Tags,
        p.CreationDate,
        OwnerDisplayName,
        Reputation as OwnerReputation,
        dense_rank() over (partition by date_part('year', p.CreationDate) order by Coalesce(p.Score, 0) desc) as year_rank,
        row_number() over (partition by date_part('year', p.CreationDate) order by p.Views desc NULLS LAST) as popular_post_num
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId = 1 and p.Score > 5
),
antwort_details as (
    select a.ParentId,
        count(*) as AnswerCount,
        sum(case when a.Score > 0 then 1 else 0 end) as GoodAnswers,
        avg(a.Score)::numeric(10,2) as AvgAnswerScore,
        considered_hot.QuestionId hot_candidate
    from Posts a
    left join (
        select q.Id as QuestionId, V.Id as VoteID
        from Posts q
        join Votes V on V.PostId = q.Id and V.VoteTypeId = 52
        where q.PostTypeId = 1
    ) considered_hot on considered_hot.QuestionId = a.ParentId
    where a.PostTypeId = 2
    group by a.ParentId, considered_hot.QuestionId
),
text_SearchLabel as (
    select p.Id,
        concat_ws('|',
            substring(coalesce(p.Title, 'NoTitle'), 1, 30),
            substring(replace(replace(p.Body, '<code>', ''), '</code>', ''), 1, 40),
            toggles.FlagName
        ) as SearchLabel
    from Posts p
    left join (
        select ph.PostId,
            string_agg(coalesce(plt.Name, 'NoFlag'),'...') as FlagName
        from PostHistory ph 
        left join PostHistoryTypes plt on ph.PostHistoryTypeId = plt.Id
        where ph.PostHistoryTypeId in (10, 12, 16) 
        group by ph.PostId
    ) toggles on toggles.PostId = p.Id
    where p.PostTypeId in (1, 2)
),
combined_vote_breakdown as (
    select v.PostId,
        min(v.CreationDate) filter (where v.VoteTypeId = 1) AcceptedFirst,
        count(*) filter (where v.VoteTypeId = 1) AcceptedNum,
        count(distinct v.UserId) filter (where v.VoteTypeId in (2, 3)) UniqueLikTHumbs,
        min(nullif(v.VoteTypeId, NULL)) + sum(v.BountyAmount) filter( where v.VoteTypeId in (8, 9)) MoneyDeferred
    from Votes v
    group by v.PostId
),
