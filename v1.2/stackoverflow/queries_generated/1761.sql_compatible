WITH RecursiveAnswerTree AS (
    SELECT 
        p.Id,
        p.ParentId,
        p.Score,
        1 AS Depth,
        ARRAY[p.Id] AS PathIds
    FROM Posts p
    WHERE p.PostTypeId = 2 AND p.ParentId IS NOT NULL
    UNION ALL
    SELECT 
        p.Id,
        p.ParentId,
        p.Score,
        rat.Depth + 1 AS Depth,
        rat.PathIds || p.Id
    FROM Posts p
    INNER JOIN RecursiveAnswerTree rat ON p.ParentId = rat.Id
), UserMaxBadge AS (
    SELECT
        b.UserId,
        MAX(b.Class) AS MaxBadgeClass
    FROM Badges b
    GROUP BY b.UserId
), SpecialVotes AS (
    SELECT
        v.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS Upvotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS Downvotes,
        SUM(CASE WHEN v.VoteTypeId IN (8,9) THEN COALESCE(v.BountyAmount,0) ELSE 0 END) AS TotalBounty
    FROM Votes v
    GROUP BY v.PostId
), QuestionAggregates AS (
    SELECT
        p.Id,
        p.Title,
        p.OwnerUserId,
        COALESCE(sv.Upvotes,0) AS Upvotes,
        COALESCE(sv.Downvotes,0) AS Downvotes,
        COALESCE(sv.TotalBounty,0) AS TotalBounty,
        p.Score
    FROM Posts p
    LEFT JOIN SpecialVotes sv ON sv.PostId = p.Id
    WHERE p.PostTypeId = 1
)
SELECT
    qa.Id,
    qa.Title,
    qa.OwnerUserId,
    qa.Upvotes,
    qa.Downvotes,
    qa.TotalBounty,
    qa.Score,
    umb.MaxBadgeClass
FROM QuestionAggregates qa
LEFT JOIN UserMaxBadge umb ON umb.UserId = qa.OwnerUserId
GROUP BY
    qa.Id,
    qa.Title,
    qa.OwnerUserId,
    qa.Upvotes,
    qa.Downvotes,
    qa.TotalBounty,
    qa.Score,
    umb.MaxBadgeClass;