WITH RecentQuestions AS (
    SELECT 
        p.Id,
        p.Title,
        p.CreationDate,
        p.ViewCount,
        p.Score,
        u.DisplayName AS OwnerName,
        CASE 
          WHEN p.Tags IS NULL THEN ARRAY[]::varchar[]
          ELSE string_to_array(substring(p.Tags FROM 2 FOR char_length(p.Tags) - 2), '><')
        END AS TagsArray
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1
      AND p.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
),
AnswerStats AS (
    SELECT 
        p.ParentId AS QuestionId,
        COUNT(p.Id) FILTER (WHERE p.Score > 0) AS PositiveAnswers,
        COUNT(p.Id) AS TotalAnswers,
        AVG(COALESCE(p.Score,0)) FILTER (WHERE p.Score IS NOT NULL) AS AvgAnswerScore,
        MAX(p.Score) AS MaxAnswerScore,
        SUM(COALESCE(char_length(p.Body) - char_length(replace(p.Body,'code','')),0)) AS CodeHunks
    FROM Posts p
    WHERE p.PostTypeId = 2
    GROUP BY p.ParentId
),
UserBadgeAggregates AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(DISTINCT b.Name) AS UniqueBadges 
    FROM Badges b
    GROUP BY b.UserId
),
TopUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        ua.GoldBadges,
        ua.SilverBadges,
        ua.BronzeBadges,
        ua.UniqueBadges
    FROM Users u
    LEFT JOIN UserBadgeAggregates ua ON u.Id = ua.UserId
    WHERE u.Reputation > 5000
),
TaggedQuestions AS (
    SELECT 
        tag AS TagName,
        oq.Id AS QuestionId,
        oq.Title,
        oq.Score,
        oq.ViewCount,
        ans.PositiveAnswers,
        ans.TotalAnswers,
        ans.MaxAnswerScore,
        ans.CodeHunks,
        oq.OwnerName,
        ROW_NUMBER() OVER (PARTITION BY tag ORDER BY oq.Score DESC) AS TagRank
    FROM (
        SELECT 
            q.Id, q.Title, q.Score, q.ViewCount, q.TagsArray, q.OwnerName
        FROM RecentQuestions q
    ) oq
    CROSS JOIN LATERAL unnest(oq.TagsArray) AS tag
    LEFT JOIN AnswerStats ans ON ans.QuestionId = oq.Id
    WHERE tag IS NOT NULL
),
TopContributorsByTag AS (
    SELECT 
        tq.TagName,
        u.Id AS ThoughtUserId,
        u.DisplayName,
        u.Reputation,
        uba.GoldBadges,
        uba.SilverBadges,
        uba.BronzeBadges,
        RANK() OVER (PARTITION BY tq.TagName ORDER BY u.Reputation DESC) AS rank_rep
    FROM TaggedQuestions tq
    JOIN Posts p ON p.PostTypeId = 2 AND p.ParentId = tq.QuestionId
    JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN UserBadgeAggregates uba ON u.Id = uba.UserId
    GROUP BY tq.TagName, u.Id, u.DisplayName, u.Reputation, uba.GoldBadges, uba.SilverBadges, uba.BronzeBadges
),
TopContributorPerTag AS (
    SELECT
        TagName,
        ThoughtUserId,
        DisplayName,
        Reputation,
        GoldBadges,
        SilverBadges,
        BronzeBadges
    FROM TopContributorsByTag
    WHERE rank_rep = 1
),
WindowedMetrics AS (
    SELECT
        tq.TagName,
        tq.QuestionId,
        tq.Title,
        tq.OwnerName,
        tq.Score,
        tq.ViewCount,
        tq.PositiveAnswers,
        tq.TotalAnswers,
        tq.MaxAnswerScore,
        tq.CodeHunks,
        RANK() OVER (PARTITION BY tq.TagName ORDER BY tq.CreationDate DESC NULLS LAST) AS BehindCreationRank,
        tq.Score - AVG(tq.Score) OVER (PARTITION BY tq.TagName) AS ScoreWithinTagSurround
    FROM (
        SELECT 
            tq.*,
            rq.CreationDate
        FROM TaggedQuestions tq
        LEFT JOIN RecentQuestions rq ON rq.Id = tq.QuestionId
    ) tq
),
Final AS (
    SELECT 
        w.TagName,
        w.QuestionId,
        w.Title,
        COALESCE(w.OwnerName,'<anonymous>') || ' scored ' || COALESCE(w.Score::text, '0') || ' with ' || COALESCE(w.ViewCount::text,'0') || ' views' AS Summary,
        w.PositiveAnswers,
        w.TotalAnswers,
        w.MaxAnswerScore,
        w.CodeHunks,
        tc.DisplayName AS TopContributor,
        tc.Reputation,
        tc.GoldBadges,
        tc.SilverBadges,
        tc.BronzeBadges,
        w.BehindCreationRank,
        w.ScoreWithinTagSurround
    FROM WindowedMetrics w
    LEFT JOIN TopContributorPerTag tc ON tc.TagName = w.TagName
)
SELECT *
FROM Final
WHERE BehindCreationRank IS NULL OR BehindCreationRank <= 5
ORDER BY TagName, BehindCreationRank NULLS LAST;