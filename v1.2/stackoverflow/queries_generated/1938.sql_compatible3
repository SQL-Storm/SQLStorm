WITH RecursiveTagHierarchy AS (
    SELECT CAST(NULL AS INTEGER) AS ParentId, CAST(NULL AS VARCHAR) AS ChildTag
    WHERE FALSE
), 
TmpPostsWithRecursiveTags AS (
    SELECT
        Posts.Id AS PostId,
        LOWER(value) AS Tag
    FROM Posts,
    LATERAL (
        SELECT UNNEST(string_to_array(Posts.Tags, ',')) AS value
    ) t
)
SELECT
    p.Id,
    p.Title,
    p.CreationDate,
    COUNT(a.Id) AS AnswerCount,
    COUNT(DISTINCT tp.PostId) AS TaggedPostCount
FROM Posts p
LEFT JOIN Answers a ON a.ParentId = p.Id
LEFT JOIN TmpPostsWithRecursiveTags tp ON tp.PostId = p.Id
GROUP BY
    p.Id,
    p.Title,
    p.CreationDate;