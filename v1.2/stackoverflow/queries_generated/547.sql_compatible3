WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT 
        t.Id, 
        t.TagName, 
        t.Count, 
        t.ExcerptPostId,
        1 AS Level,
        CAST(ARRAY[t.TagName] AS VARCHAR[]) AS Path
    FROM Tags t
    WHERE t.IsRequired = TRUE

    UNION ALL

    SELECT 
        child.Id, 
        child.TagName, 
        child.Count, 
        child.ExcerptPostId,
        parent.Level + 1,
        parent.Path || child.TagName
    FROM Tags child
    JOIN RecursiveTagHierarchy parent ON child.Id <> parent.Id AND child.Count < parent.Count
    WHERE child.IsRequired = FALSE AND NOT child.TagName = ANY(parent.Path)
),
UserBadgeStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COUNT(b.Id) AS TotalBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
PostActivityRanked AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.AcceptedAnswerId,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS UserPostRank,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) AS UserPostCount,
        LEAD(p.Id) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS NextPostId,
        LAG(p.Id) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PrevPostId
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
TopQuestionsWithAnswers AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate AS QuestionDate,
        q.Score AS QuestionScore,
        q.ViewCount AS QuestionViews,
        q.Tags,
        a.Id AS AnswerId,
        a.CreationDate AS AnswerDate,
        a.Score AS AnswerScore,
        a.OwnerUserId AS AnswerOwnerUserId,
        u.DisplayName AS AnswerOwnerName,
        ua.GoldBadges,
        ua.SilverBadges,
        ua.BronzeBadges,
        ua.TotalBadges,
        ua.LastBadgeDate,
        ph.Comment AS CloseReason,
        ph.CreationDate AS CloseDate
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN Users u ON u.Id = a.OwnerUserId
    LEFT JOIN UserBadgeStats ua ON ua.UserId = a.OwnerUserId
    LEFT JOIN PostHistory ph ON ph.PostId = q.Id AND ph.PostHistoryTypeId = 10
    WHERE q.PostTypeId = 1
      AND q.Score > 5
      AND (a.Score IS NULL OR a.Score > 0)
),
DuplicateLinkCounts AS (
    SELECT
        pl.PostId,
        COUNT(*) FILTER (WHERE pl.LinkTypeId = 3) AS DuplicateCount
    FROM PostLinks pl
    GROUP BY pl.PostId
),
UserCommentStats AS (
    SELECT
        c.UserId,
        COUNT(c.Id) AS TotalComments,
        AVG(LENGTH(c.Text)) AS AvgCommentLength,
        COUNT(DISTINCT c.PostId) AS DistinctPostsCommented,
        MAX(c.CreationDate) AS LastCommentDate
    FROM Comments c
    WHERE c.UserId IS NOT NULL
    GROUP BY c.UserId
),
FinalResult AS (
    SELECT
        tq.QuestionId,
        tq.Title,
        tq.QuestionDate,
        tq.QuestionScore,
        tq.QuestionViews,
        tq.Tags,
        COALESCE(tq.AnswerId, -1) AS AnswerId,
        tq.AnswerDate,
        tq.AnswerScore,
        tq.AnswerOwnerUserId,
        COALESCE(tq.AnswerOwnerName, 'Unknown') AS AnswerOwnerName,
        COALESCE(tq.GoldBadges, 0) AS GoldBadges,
        COALESCE(tq.SilverBadges, 0) AS SilverBadges,
        COALESCE(tq.BronzeBadges, 0) AS BronzeBadges,
        COALESCE(tq.TotalBadges, 0) AS TotalBadges,
        tq.LastBadgeDate,
        dq.DuplicateCount,
        COALESCE(ucs.TotalComments, 0) AS UserTotalComments,
        COALESCE(ucs.AvgCommentLength, 0) AS UserAvgCommentLength,
        COALESCE(ucs.DistinctPostsCommented, 0) AS UserDistinctPostsCommented,
        COALESCE(ucs.LastCommentDate, TIMESTAMP '1970-01-01') AS UserLastCommentDate,
        COALESCE(tq.CloseReason, 'Open') AS CloseReason,
        tq.CloseDate
    FROM TopQuestionsWithAnswers tq
    LEFT JOIN DuplicateLinkCounts dq ON dq.PostId = tq.QuestionId
    LEFT JOIN UserCommentStats ucs ON ucs.UserId = tq.AnswerOwnerUserId
)
SELECT
    fr.QuestionId,
    fr.Title,
    fr.QuestionDate,
    fr.QuestionScore,
    fr.QuestionViews,
    fr.Tags,
    fr.AnswerId,
    fr.AnswerDate,
    fr.AnswerScore,
    fr.AnswerOwnerUserId,
    fr.AnswerOwnerName,
    fr.GoldBadges,
    fr.SilverBadges,
    fr.BronzeBadges,
    fr.TotalBadges,
    fr.LastBadgeDate,
    fr.DuplicateCount,
    fr.UserTotalComments,
    fr.UserAvgCommentLength,
    fr.UserDistinctPostsCommented,
    fr.UserLastCommentDate,
    fr.CloseReason,
    fr.CloseDate,
    CONCAT(
        COALESCE(NULLIF(REGEXP_REPLACE(fr.Tags, '^<|>$', ''), ''), 'no-tags'),
        ' | Top Answerer: ',
        fr.AnswerOwnerName,
        ' | TitleLen: ',
        CAST(LENGTH(fr.Title) AS VARCHAR)
    ) AS SummaryString,
    RANK() OVER (PARTITION BY fr.CloseReason ORDER BY fr.QuestionScore DESC) AS RankWithinCloseReason,
    CASE 
        WHEN fr.TotalBadges = 0 AND fr.UserTotalComments = 0 THEN 'Inactive Contributor'
        WHEN fr.TotalBadges > 0 AND fr.UserTotalComments > 10 THEN 'Active Contributor'
        ELSE 'Moderate Contributor'
    END AS ContributorStatus
FROM FinalResult fr
WHERE fr.QuestionDate > (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year')
  AND (fr.CloseReason = 'Open' OR fr.CloseReason IS NULL)
GROUP BY
    fr.QuestionId,
    fr.Title,
    fr.QuestionDate,
    fr.QuestionScore,
    fr.QuestionViews,
    fr.Tags,
    fr.AnswerId,
    fr.AnswerDate,
    fr.AnswerScore,
    fr.AnswerOwnerUserId,
    fr.AnswerOwnerName,
    fr.GoldBadges,
    fr.SilverBadges,
    fr.BronzeBadges,
    fr.TotalBadges,
    fr.LastBadgeDate,
    fr.DuplicateCount,
    fr.UserTotalComments,
    fr.UserAvgCommentLength,
    fr.UserDistinctPostsCommented,
    fr.UserLastCommentDate,
    fr.CloseReason,
    fr.CloseDate,
    CONCAT(
        COALESCE(NULLIF(REGEXP_REPLACE(fr.Tags, '^<|>$', ''), ''), 'no-tags'),
        ' | Top Answerer: ',
        fr.AnswerOwnerName,
        ' | TitleLen: ',
        CAST(LENGTH(fr.Title) AS VARCHAR)
    ),
    RANK() OVER (PARTITION BY fr.CloseReason ORDER BY fr.QuestionScore DESC),
    CASE 
        WHEN fr.TotalBadges = 0 AND fr.UserTotalComments = 0 THEN 'Inactive Contributor'
        WHEN fr.TotalBadges > 0 AND fr.UserTotalComments > 10 THEN 'Active Contributor'
        ELSE 'Moderate Contributor'
    END
ORDER BY RankWithinCloseReason, fr.QuestionScore DESC
LIMIT 100;