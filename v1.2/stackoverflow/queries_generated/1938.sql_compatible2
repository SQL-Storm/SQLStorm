WITH RecursiveTagHierarchy AS (
    -- Recursive CTE to find conquered tag hierarchy (placeholder cleaned)
    SELECT CAST(NULL AS INTEGER) AS ParentId, CAST(NULL AS TEXT) AS ChildTag
    WHERE false
), 
TmpPostsWithRecursiveTags AS (
    SELECT
        Posts.Id AS PostId,
        LOWER(t.value) AS Tag
    FROM Posts
    CROSS JOIN LATERAL (
        SELECT UNNEST(string_to_array(Posts.Tags, ',')) AS value
    ) t
)
SELECT
    p.Id,
    p.Title,
    p.CreationDate,
    COUNT(a.Id) AS AnswerCount,
    COUNT(DISTINCT tp.PostId) AS TaggedPostCount
FROM Posts p
LEFT JOIN Answers a ON a.ParentId = p.Id
LEFT JOIN TmpPostsWithRecursiveTags tp ON tp.PostId = p.Id
GROUP BY
    p.Id,
    p.Title,
    p.CreationDate;