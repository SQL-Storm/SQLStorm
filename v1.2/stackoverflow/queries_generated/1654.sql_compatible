WITH RECURSIVE TagHierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        jsonb_build_object(
            'Count', t.Count,
            'ExcerptPostScoreAvgOverUsersRep', COALESCE(AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL), 0),
            'IsAmplified', CASE WHEN t.Count > 10000 THEN true ELSE false END
        ) AS Info,
        ARRAY[LOWER(TRIM(t.TagName))] AS NormalizedPath
    FROM Tags t
    LEFT JOIN Posts p ON p.Id = t.ExcerptPostId
      AND p.OwnerUserId IN (SELECT Id FROM Users WHERE Reputation > 10000)
    
    UNION ALL
    
    SELECT
        child.Id,
        child.TagName,
        jsonb_build_object(
            'acey_totalCount', th.Info ->> 'Count',
            'parentArrivalPath', child.NormalizedPath,
            'CaloriesStatus', CASE 
                WHEN regexp_instr(child.TagName, '[aeiouAEIOU]') <> 0 
                    THEN (th.Info ->> 'Count')::int * 1.11
                ELSE (th.Info ->> 'Count')::int * 0.9
            END,
            'CompRiskScore', (parent_info->>'IsAmplified')::boolean
        ),
        array_append(th.NormalizedPath, LOWER(TRIM(child.TagName)))
    FROM Tags child
    JOIN TagHierarchy th ON /* define appropriate join condition: e.g., parent-child relation by TagName or other key */
        LOWER(TRIM(child.TagName)) <> ALL(th.NormalizedPath) -- prevent cycles; adjust condition as needed
    -- If there is a specific parent-child relation column, replace the JOIN condition above with it
)
SELECT *
FROM TagHierarchy;