with UserBadgeStats as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        coalesce(sum(case when b.TagBased = true then 1 else 0 end),0) as TagBasedBadges,
        row_number() over (partition by u.Id order by max(b.Date) desc) as RecentBadgeRank,
        max(b.Date) as MostRecentBadgeDate
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostActivity as (
    select
        p.Id as PostId,
        p.OwnerUserId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        (
            select avg(coalesce(c.Score,0)) 
            from Comments c 
            where c.PostId = p.Id and c.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
        ) as AvgCommentScore30Days,
        (
            select array_agg(distinct coalesce(cast(pe2.UserDisplayName as text), 'Unknown'))
            from PostHistory pe2
            where pe2.PostId = p.Id
              and pe2.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days'
        ) as RecentEditors
    from Posts p
    left join PostHistory pe on pe.PostId = p.Id
    where p.PostTypeId in (1,2)
),
DuplicateLinks as (
    select
        pl.PostId,
        count(case when pl.LinkTypeId = 3 then 1 end) as DuplicateCount,
        string_agg(distinct cast(pl.RelatedPostId as varchar), ',') filter (where pl.LinkTypeId = 3) as DuplicatePostIds
    from PostLinks pl
    group by pl.PostId
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.OwnerUserId,
        count(a.Id) as AnswerCount,
        coalesce(avg(a.Score),0) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore,
        sum(case when a.Score > q.Score then 1 else 0 end) as AnswersOutscoreQuestion,
        q.CreationDate,
        q.ClosedDate,
        q.ViewCount,
        q.Score as QuestionScore,
        d.DuplicateCount,
        d.DuplicatePostIds
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join DuplicateLinks d on d.PostId = q.Id
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.Tags, q.OwnerUserId, q.CreationDate, q.ClosedDate, q.ViewCount, q.Score, d.DuplicateCount, d.DuplicatePostIds
),
TopAnswererSubset as (
    select
        a.OwnerUserId,
        u.DisplayName,
        count(*) as AnswerCount,
        sum(a.Score) as TotalAnswerScore,
        rank() over (order by sum(a.Score) desc) as ScoreRank
    from Posts a
    join Users u on u.Id = a.OwnerUserId
    where a.PostTypeId = 2 and a.OwnerUserId is not null
    group by a.OwnerUserId, u.DisplayName
    having count(*) > 20
    -- LIMIT inside a CTE can be non-portable; if required, apply limit in outer query
),
WindowScoreStats as (
    select
        p.Id,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        sum(p.Score) over (partition by p.PostTypeId order by p.CreationDate 
                          rows between 9 preceding and current row) as RollingScoreSum,
        lag(p.Score) over (partition by p.PostTypeId order by p.CreationDate) as PrevScore,
        lead(p.Score) over (partition by p.PostTypeId order by p.CreationDate) as NextScore,
        p.CreationDate
    from Posts p
    where p.PostTypeId in (1,2)
)
select 
    qa.QuestionId,
    qa.Title,
    cardinality(string_to_array(regexp_replace(qa.Tags, '[<>]', '', 'g'), '>')) as TagCount,
    qa.AnswerCount,
    qa.AvgAnswerScore,
    qa.MaxAnswerScore,
    qa.AnswersOutscoreQuestion,
    qa.ViewCount,
    qa.QuestionScore,
    case when qa.ClosedDate is not null then 'Closed' else 'Open' end as QuestionStatus,
    coalesce(ubs.GoldBadges,0) as UserGoldBadges,
    coalesce(ubs.SilverBadges,0) as UserSilverBadges,
    coalesce(ubs.BronzeBadges,0) as UserBronzeBadges,
    coalesce(ubs.TagBasedBadges,0) as UserTagBadges,
    coalesce(tb.AnswerCount,0) as TopAnswererAnswers,
    coalesce(tb.TotalAnswerScore,0) as TopAnswererScore,
    coalesce(wss.RollingScoreSum, 0) as Recent10PostsScoreSum,
    case 
        when wss.PrevScore is null then 'N/A'
        when wss.PrevScore < wss.Score and wss.Score > wss.NextScore then 'Peak'
        when wss.PrevScore > wss.Score and wss.Score < wss.NextScore then 'Valley'
        else 'Normal'
    end as ScoreTrend,
    dl.DuplicateCount,
    dl.DuplicatePostIds
from QuestionAnswerStats qa
left join UserBadgeStats ubs on ubs.UserId = qa.OwnerUserId
left join TopAnswererSubset tb on tb.OwnerUserId = qa.OwnerUserId
left join WindowScoreStats wss on wss.Id = qa.QuestionId
left join DuplicateLinks dl on dl.PostId = qa.QuestionId
where qa.AnswerCount > 3 
  and qa.QuestionScore > 5 
  and coalesce(ubs.GoldBadges,0) >= 1
  and qa.ClosedDate is null
order by qa.AnswerCount desc, qa.QuestionScore desc
limit 50;