with recursive UserBadgeCounts as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(b.Id) filter (where b.Class = 1) as GoldBadges,
        count(b.Id) filter (where b.Class = 2) as SilverBadges,
        count(b.Id) filter (where b.Class = 3) as BronzeBadges,
        row_number() over (partition by u.Id order by b.Date desc nulls last) as BadgeRank,
        b.Date
    from Users u
    left join Badges b on u.Id = b.UserId
    group by u.Id, u.DisplayName, b.Date
),
TopUsers as (
    select UserId, DisplayName, GoldBadges, SilverBadges, BronzeBadges
    from UserBadgeCounts
    where BadgeRank = 1
),
QuestionStats as (
    select
        p.Id as QuestionId,
        p.OwnerUserId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        coalesce(p.AnswerCount, 0) as AnswerCount,
        p.AcceptedAnswerId,
        (select count(*) from Comments c where c.PostId = p.Id) as CommentCount,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 2) as UpVotes,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 3) as DownVotes,
        case when p.ClosedDate is not null then 1 else 0 end as IsClosed,
        (select pht.Name from PostHistoryTypes pht join PostHistory ph on ph.PostHistoryTypeId = pht.Id and ph.PostId = p.Id and ph.CreationDate = (
            select min(ph2.CreationDate) from PostHistory ph2 where ph2.PostId = p.Id and ph2.PostHistoryTypeId = pht.Id
        ) limit 1) as FirstPostHistoryType
    from Posts p
    where p.PostTypeId = 1
),
AnswerStats as (
    select
        p.Id as AnswerId,
        p.ParentId as QuestionId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        (select count(*) from Comments c where c.PostId = p.Id) as CommentCount,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 2) as UpVotes,
        (select count(*) from Votes v where v.PostId = p.Id and v.VoteTypeId = 3) as DownVotes,
        case when p.Id = (select q.AcceptedAnswerId from Posts q where q.Id = p.ParentId) then 1 else 0 end as IsAccepted
    from Posts p
    where p.PostTypeId = 2
),
UserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionsPosted,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswersPosted,
        count(distinct c.Id) as CommentsMade,
        count(distinct v.Id) filter (where v.VoteTypeId = 2) as UpVotesGiven,
        count(distinct v.Id) filter (where v.VoteTypeId = 3) as DownVotesGiven,
        max(p.CreationDate) filter (where p.PostTypeId in (1,2)) as LastPostDate,
        max(c.CreationDate) as LastCommentDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Votes v on v.UserId = u.Id
    group by u.Id, u.DisplayName
),
CombinedPosts as (
    select
        q.QuestionId as PostId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        q.Tags,
        q.AnswerCount,
        q.CommentCount,
        q.UpVotes,
        q.DownVotes,
        q.IsClosed,
        'Question' as PostType,
        q.AcceptedAnswerId
    from QuestionStats q
    union all
    select
        a.AnswerId as PostId,
        null as Title,
        a.OwnerUserId,
        a.CreationDate,
        a.Score,
        null as ViewCount,
        null as Tags,
        null as AnswerCount,
        a.CommentCount,
        a.UpVotes,
        a.DownVotes,
        0 as IsClosed,
        'Answer' as PostType,
        null as AcceptedAnswerId
    from AnswerStats a
),
RankedPosts as (
    select
        cp.*,
        row_number() over (partition by cp.OwnerUserId order by cp.Score desc, cp.CreationDate desc) as UserPostRank,
        count(*) over (partition by cp.OwnerUserId) as UserPostCount
    from CombinedPosts cp
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pt1.Name as PostTypeName,
        pt2.Name as RelatedPostTypeName,
        lt.Name as LinkTypeName
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    join PostTypes pt1 on pt1.Id = p1.PostTypeId
    join PostTypes pt2 on pt2.Id = p2.PostTypeId
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where lt.Name = 'Duplicate'
),
TagExplode as (
    select
        q.QuestionId,
        trim(both ' ' from t.value) as TagName
    from QuestionStats q
    cross join lateral (
        select regexp_split_to_table(substring(q.Tags from 2 for (length(q.Tags)-2)), '><') as value
    ) t
    where q.Tags is not null and q.Tags <> ''
),
TagStats as (
    select
        te.TagName,
        count(distinct te.QuestionId) as QuestionCount,
        avg(q.Score) as AvgQuestionScore,
        avg(q.ViewCount) as AvgQuestionViews,
        max(q.Score) as MaxQuestionScore,
        min(q.Score) as MinQuestionScore
    from TagExplode te
    join QuestionStats q on q.QuestionId = te.QuestionId
    group by te.TagName
),
UserReputationWindow as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        sum(case when p.PostTypeId = 1 then p.Score else 0 end) over (order by u.Reputation desc rows between unbounded preceding and current row) as RunningQuestionScore,
        sum(case when p.PostTypeId = 2 then p.Score else 0 end) over (order by u.Reputation desc rows between unbounded preceding and current row) as RunningAnswerScore
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
),
ClosedQuestionsWithReason as (
    select
        ph.PostId,
        cr.Name as CloseReasonName,
        min(ph.CreationDate) as CloseDate
    from PostHistory ph
    join CloseReasonTypes cr on cr.Id = cast(ph.Comment as integer)
    where ph.PostHistoryTypeId = 10
    group by ph.PostId, cr.Name
)
select
    ru.Id as UserId,
    ru.DisplayName,
    ru.Reputation,
    ru.RunningQuestionScore,
    ru.RunningAnswerScore,
    ua.QuestionsPosted,
    ua.AnswersPosted,
    ua.CommentsMade,
    ua.UpVotesGiven,
    ua.DownVotesGiven,
    ru.CreationDate as UserCreationDate,
    max(rp.Score) filter (where rp.PostType = 'Question') as MaxQuestionScore,
    max(rp.Score) filter (where rp.PostType = 'Answer') as MaxAnswerScore,
    count(distinct dl.PostId) as DuplicateLinksCount,
    ts.TagName,
    ts.QuestionCount as TagQuestionCount,
    ts.AvgQuestionScore as TagAvgScore,
    ts.MaxQuestionScore as TagMaxScore,
    ts.MinQuestionScore as TagMinScore,
    cqwr.CloseReasonName,
    cqwr.CloseDate
from UserReputationWindow ru
left join UserActivity ua on ua.UserId = ru.Id
left join RankedPosts rp on rp.OwnerUserId = ru.Id and rp.UserPostRank = 1
left join DuplicateLinks dl on dl.PostId = rp.PostId
left join TagExplode te on te.QuestionId = rp.PostId and rp.PostType = 'Question'
left join TagStats ts on ts.TagName = te.TagName
left join ClosedQuestionsWithReason cqwr on cqwr.PostId = rp.PostId and rp.PostType = 'Question'
where ru.Reputation > 1000
  and (ts.QuestionCount > 50 or ts.QuestionCount is null)
group by
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.RunningQuestionScore,
    ru.RunningAnswerScore,
    ua.QuestionsPosted,
    ua.AnswersPosted,
    ua.CommentsMade,
    ua.UpVotesGiven,
    ua.DownVotesGiven,
    ru.CreationDate,
    ts.TagName,
    ts.QuestionCount,
    ts.AvgQuestionScore,
    ts.MaxQuestionScore,
    ts.MinQuestionScore,
    cqwr.CloseReasonName,
    cqwr.CloseDate
order by ru.Reputation desc, ua.QuestionsPosted desc, max(rp.Score) desc
limit 100;