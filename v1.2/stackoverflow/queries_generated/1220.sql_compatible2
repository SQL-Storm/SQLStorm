with recursive UserRecursion as (
    select Id, DisplayName, Reputation, 1 as Level
    from Users
    where Reputation > 10000

    union all

    select u.Id, u.DisplayName, u.Reputation, ur.Level + 1
    from Users u
    join Posts p on p.OwnerUserId = u.Id
    join UserRecursion ur on p.OwnerUserId = ur.Id
    where u.Reputation > 5000 and ur.Level < 3
),
PostAnswerStats as (
    select 
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.CreationDate,
        count(a.Id) filter (where a.Score > 5) as HighScoreAnswerCount,
        count(a.Id) filter (where a.Score <= 5) as LowScoreAnswerCount,
        coalesce(avg(a.Score), 0) as AvgAnswerScore,
        max(a.CreationDate) as LastAnswerDate,
        sum(case when a.Score > 0 then 1 else 0 end) as PositiveScoreAnswers,
        (select max(CreationDate) from Comments c where c.PostId = q.Id) as LastCommentDate
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1 and q.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - interval '2 years')
    group by q.Id, q.Title, q.Tags, q.CreationDate
),
BadgeStats as (
    select 
        UserId,
        count(*) filter (where Class = 1) as GoldBadges,
        count(*) filter (where Class = 2) as SilverBadges,
        count(*) filter (where Class = 3) as BronzeBadges,
        sum(case when TagBased then 1 else 0 end) as TagBasedCount
    from Badges
    group by UserId
),
UserActivityWindow as (
    select 
        Id,
        DisplayName,
        Reputation,
        Views,
        UpVotes,
        DownVotes,
        row_number() over (partition by 1 order by LastAccessDate desc) as RecentAccessRank,
        lag(LastAccessDate) over (partition by 1 order by LastAccessDate desc) as PreviousAccess,
        max(CreationDate) over (partition by 1) as MaxCreationDate,
        LastAccessDate
    from Users
    where Id in (select Id from UserRecursion)
),
PostWithLinkDuplicates as (
    select
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        (case when pl.LinkTypeId = 3 then 1 else 0 end) as IsDuplicateLink,
        coalesce(pl.RelatedPostId, -1) as RelatedPostId
    from Posts p
    left join PostLinks pl on p.Id = pl.PostId and pl.LinkTypeId in (1, 3)
    where p.PostTypeId = 1
),
QuestionsWithLatestHistory as (
    select distinct on (ph.PostId)
        ph.PostId,
        ph.CreationDate as LatestEditDate,
        ph.PostHistoryTypeId,
        ph.UserId as EditorUserId,
        ph.Comment as CloseReasonCode
    from PostHistory ph
    where ph.PostId in (select Id from Posts where PostTypeId = 1)
    order by ph.PostId, ph.CreationDate desc
)
select 
    qas.QuestionId,
    left(qas.Title, 100) as QuestionPreviewTitle,
    u.DisplayName as OwnerName,
    u.Reputation as OwnerReputation,
    bs.GoldBadges,
    bs.SilverBadges,
    bs.BronzeBadges,
    qas.HighScoreAnswerCount,
    qas.LowScoreAnswerCount,
    round(qas.AvgAnswerScore,2) as AverageAnswerScore,
    qas.LastAnswerDate,
    qas.LastCommentDate,
    pld.IsDuplicateLink,
    pld.RelatedPostId,
    ph.LatestEditDate as QuestionLastEditDate,
    case 
        when ph.PostHistoryTypeId in (10, 11) then coalesce(co.Name, 'Unknown')
        when ph.PostHistoryTypeId is null then 'No Close History' 
        else 'Other' 
    end as CloseReasonName,
    ur.Level as UserRecursionDepth,
    ua.PreviousAccess,
    ua.MaxCreationDate,
    case 
        when ua.Reputation > 20000 then 'HighRepUser' 
        when ua.Reputation between 10000 and 20000 then 'MidRepUser' 
        else 'LowRepUser' 
    end as ReputationCategory,
    substitute_tags.TagsReformatted,
    substitute_mystic.ComplexScore
from PostAnswerStats qas
join Posts pq on qas.QuestionId = pq.Id
join Users u on pq.OwnerUserId = u.Id
left join BadgeStats bs on u.Id = bs.UserId
left join PostWithLinkDuplicates pld on qas.QuestionId = pld.PostId
left join QuestionsWithLatestHistory ph on qas.QuestionId = ph.PostId
left join UserRecursion ur on u.Id = ur.Id
left join UserActivityWindow ua on u.Id = ua.Id
left join lateral (
    select 
        string_agg(replace(t,'&lt;', '<') || replace('&gt;', '>'), ',') as TagsReformatted
    from unnest(string_to_array(coalesce(pq.Tags, ''), '><')) t
    where t is not null and trim(t) <> ''
) substitute_tags on true
left join lateral (
    select 
        greatest(
            (qas.AvgAnswerScore * 0.4 + coalesce(cast(bs.GoldBadges as double precision),0) * 2 + coalesce(bs.SilverBadges,0) * 1.5 + coalesce(bs.BronzeBadges,0) * 1)
            * (1 + least(u.Reputation / 100000.0,1))
        , 0) as ComplexScore
) substitute_mystic on true
where qas.HighScoreAnswerCount > 0
and ur.Level between 1 and 3
order by substitute_mystic.ComplexScore desc nulls last, qas.LastAnswerDate desc
limit 100;