WITH
UserReputationBuckets AS (
   SELECT
      Id,
      DisplayName,
      Reputation,
      CASE
         WHEN Reputation >= 100000 THEN 'Expert'
         WHEN Reputation BETWEEN 10000 AND 99999 THEN 'Advanced'
         WHEN Reputation BETWEEN 1000 AND 9999 THEN 'Intermediate'
         ELSE 'Beginner'
      END AS ReputationLevel
   FROM Users
),
RecentHighlyActiveQuestions AS (
   SELECT
      p.Id,
      p.Title,
      p.OwnerUserId,
      p.Score,
      p.ViewCount,
      p.CreationDate,
      p.Tags,
      COALESCE(ans.AnswerCount, 0) AS AnswerCount,
      uf_badge.GoldBadges,
      CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END AS IsClosed,
      STRING_AGG(DISTINCT bhistorusers.DisplayName, ', ') AS Editors
   FROM Posts p
   LEFT JOIN PostLinks pl ON pl.PostId = p.Id AND pl.LinkTypeId = 3
   LEFT JOIN (
       SELECT ParentId, COUNT(*) AS AnswerCount
       FROM Posts
       WHERE PostTypeId = 2
       GROUP BY ParentId
   ) ans ON ans.ParentId = p.Id
   LEFT JOIN (
      SELECT UserId,
             SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldBadges
      FROM Badges
      GROUP BY UserId
   ) uf_badge ON uf_badge.UserId = p.OwnerUserId
   LEFT JOIN (
     SELECT ph.PostId, ph.UserId
     FROM PostHistory ph
     WHERE ph.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
   ) phr_recent ON phr_recent.PostId = p.Id
   LEFT JOIN Users bhistorusers ON bhistorusers.Id = phr_recent.UserId
   WHERE p.PostTypeId = 1
     AND p.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '180 days'
     AND (p.Score > 10 OR p.ViewCount > 5000)
   GROUP BY p.Id, p.Title, p.OwnerUserId, p.Score, p.ViewCount, p.CreationDate, p.Tags, ans.AnswerCount, uf_badge.GoldBadges, p.ClosedDate
),
DailyVotesWindow AS (
   SELECT
      v.PostId,
      DATE(v.CreationDate) AS VoteDay,
      SUM(CASE WHEN vt.Name IN ('UpMod', 'AcceptedByOriginator') THEN 1 ELSE 0 END) AS UpVotes,
      SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes,
      RANK() OVER (PARTITION BY v.PostId ORDER BY DATE(v.CreationDate) DESC) AS rn_last30
   FROM Votes v
   JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
   WHERE v.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
   GROUP BY v.PostId, DATE(v.CreationDate)
),
CompositeTopPostData AS (
   SELECT
       q.Id AS QuestionId,
       q.Title,
       ur.DisplayName AS Author,
       ur.Reputation,
       ur.ReputationLevel,
       q.Score,
       q.ViewCount,
       q.AnswerCount,
       COALESCE(vbin.UpVotes, 0) AS Last30dUpVotes,
       COALESCE(vbin.DownVotes, 0) AS Last30dDownVotes,
       q.GoldBadges,
       q.IsClosed,
       q.Tags,
       COALESCE(q.Editors, '') AS RecentEditors,
       LAG(q.Score) OVER (ORDER BY q.ViewCount DESC) AS PriorScore,
       LEAD(q.Score) OVER (ORDER BY q.ViewCount DESC) AS NextScore,
       CASE
            WHEN q.IsClosed = 1 THEN 
                (SELECT STRING_AGG(ct.Name, '; ')
                 FROM CloseReasonTypes ct
                 JOIN PostHistory pmaintenance ON pmaintenance.PostId = q.Id
                    AND pmaintenance.PostHistoryTypeId = 10
                    AND pmaintenance.Comment LIKE '%' || CAST(ct.Id AS varchar) || '%'
                 WHERE pmaintenance.PostId = q.Id
                )
            ELSE NULL 
       END AS CloseReasons,
       (
         q.ViewCount /
         NULLIF(
           NULLIF(
             NULLIF(
               NULLIF(EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS timestamp) - q.CreationDate)), 0)
             , 400)
           , 0)
         , 1)
       ) +
       LEAST(q.AnswerCount * 3, 50) AS CompositeScore
   FROM RecentHighlyActiveQuestions q
   LEFT JOIN DailyVotesWindow vbin ON vbin.PostId = q.Id AND vbin.rn_last30 = 1
   LEFT JOIN Users ur ON ur.Id = q.OwnerUserId
   LEFT JOIN UserReputationBuckets urb ON urb.Id = ur.Id
   GROUP BY
       q.Id,
       q.Title,
       ur.DisplayName,
       ur.Reputation,
       ur.ReputationLevel,
       q.Score,
       q.ViewCount,
       q.AnswerCount,
       vbin.UpVotes,
       vbin.DownVotes,
       q.GoldBadges,
       q.IsClosed,
       q.Tags,
       q.Editors,
       q.OwnerUserId,
       q.CreationDate
)
SELECT *
FROM CompositeTopPostData
ORDER BY CompositeScore DESC;