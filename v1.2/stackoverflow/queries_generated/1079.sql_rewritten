-- {"query": "1079.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1830} 
with recursive UserBadgeCounts as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(b.Id) filter (where b.Class = 1) as GoldBadges,
        count(b.Id) filter (where b.Class = 2) as SilverBadges,
        count(b.Id) filter (where b.Class = 3) as BronzeBadges,
        rank() over (order by u.Reputation desc, u.CreationDate) as UserRank
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate

    union all

    select
        ub.UserId,
        ub.DisplayName,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.UserRank + 1
    from UserBadgeCounts ub
    join Users u on u.Id = ub.UserId
    where ub.UserRank < 5
),
LatestPostsAsQuestions as (
    select 
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        u.Id as OwnerUserId,
        u.DisplayName as OwnerDisplayName,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as rn
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId = 1
),
TopQuestionsWithRecentComments as (
    select
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        coalesce(lc.CommentCount, 0) as RecentComments,
        p.OwnerUserId,
        p.OwnerDisplayName,
        u.Reputation as OwnerReputation,
        case 
            when ps.AcceptedAnswerId is not null then 1
            else 0
        end as HasAcceptedAnswer,
        -- string manipulation of tags: remove angle brackets and split then array length
        array_length(string_to_array(substring(p.Tags from 2 for char_length(p.Tags)-2), '><'), 1) as TagCount
    from LatestPostsAsQuestions p
    left join (
        select PostId, count(*) as CommentCount
        from Comments
        where CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
        group by PostId
    ) lc on lc.PostId = p.Id
    left join Posts ps on ps.Id = p.Id
    left join Users u on u.Id = p.OwnerUserId
    where p.rn = 1 and p.Score > 5
),
DuplicatePostPairs as (
    select pl.PostId, pl.RelatedPostId, pl.CreationDate, lt.Name as LinkTypeName
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where lt.Name = 'Duplicate'
),
QuestionsWithDuplicates as (
    select distinct p.Id, p.Title, p.Score, p.OwnerUserId
    from Posts p
    join DuplicatePostPairs dp on dp.PostId = p.Id
    where p.PostTypeId = 1
),
UserActivityStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        coalesce(q.QuestionsCount, 0) as QuestionsCount,
        coalesce(a.AnswersCount, 0) as AnswersCount,
        coalesce(c.CommentsCount, 0) as CommentsCount,
        coalesce(v.UpVotes, 0) as UpVotesReceived,
        coalesce(v.DownVotes, 0) as DownVotesReceived
    from Users u
    left join (
        select OwnerUserId, count(*) as QuestionsCount
        from Posts
        where PostTypeId = 1
        group by OwnerUserId
    ) q on q.OwnerUserId = u.Id
    left join (
        select OwnerUserId, count(*) as AnswersCount
        from Posts
        where PostTypeId = 2
        group by OwnerUserId
    ) a on a.OwnerUserId = u.Id
    left join (
        select UserId, count(*) as CommentsCount
        from Comments
        group by UserId
    ) c on c.UserId = u.Id
    left join (
        select p.OwnerUserId,
            sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
            sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes
        from Votes v
        join Posts p on p.Id = v.PostId
        group by p.OwnerUserId
    ) v on v.OwnerUserId = u.Id
),
ComplexRankedPosts as (
    select 
        p.Id, p.Title, p.Score, p.ViewCount, p.Tags,
        u.DisplayName as OwnerDisplayName,
        -- Calculate a weighted popularity score combining score, views, recent comments, and accepted answer presence
        (p.Score * 5 + p.ViewCount / 100 + coalesce(rc.RecentComments, 0) * 3 + case when p.AcceptedAnswerId is not null then 50 else 0 end) as PopularityScore,
        rank() over (order by (p.Score * 5 + p.ViewCount / 100 + coalesce(rc.RecentComments, 0) * 3 + case when p.AcceptedAnswerId is not null then 50 else 0 end) desc) as PopularityRank,
        case when p.ClosedDate is null then 0 else 1 end as IsClosed
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    left join (
        select PostId, count(*) as RecentComments
        from Comments
        where CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '60 days'
        group by PostId
    ) rc on rc.PostId = p.Id
    where p.PostTypeId = 1
),
RecursiveBadgeHierarchy as (
    select 
        Id, Name, 1 as Level
    from Badges
    where Class = 1
    union all
    select
        b.Id, b.Name, rb.Level + 1
    from Badges b
    join RecursiveBadgeHierarchy rb on b.UserId = rb.Id
    where rb.Level < 3
)
select
    cce.PopularityRank,
    cce.Id as QuestionId,
    cce.Title,
    cce.OwnerDisplayName,
    cce.Score,
    cce.ViewCount,
    cce.PopularityScore,
    cce.IsClosed,
    bq.GoldBadges,
    bq.SilverBadges,
    bq.BronzeBadges,
    uas.QuestionsCount,
    uas.AnswersCount,
    uas.CommentsCount,
    uas.UpVotesReceived,
    uas.DownVotesReceived,
    -- Most frequent close reason name for closed posts (correlated subquery with null logic)
    (select crt.Name
     from CloseReasonTypes crt
     join PostHistory ph on ph.PostId = cce.Id and ph.PostHistoryTypeId = 10
     where ph.Comment::int = crt.Id
     order by ph.CreationDate desc
     limit 1) as MostRecentCloseReason,
    -- String manipulation: concatenate Tags with '|' delimiter after removing angle brackets, handling nulls
    coalesce(array_to_string(string_to_array(substring(cce.Tags from 2 for char_length(cce.Tags)-2), '><'), '|'), 'NoTags') as TagsFlat,
    -- Use window function to get difference from avg score over same TagCount
    (cce.Score - avg(cce.Score) over (partition by array_length(string_to_array(substring(cce.Tags from 2 for char_length(cce.Tags)-2), '><'), 1)))::float) as ScoreVsTagAvg
from ComplexRankedPosts cce
left join (
    select UserId, 
        count(*) filter (where Class = 1) as GoldBadges,
        count(*) filter (where Class = 2) as SilverBadges,
        count(*) filter (where Class = 3) as BronzeBadges
    from Badges
    group by UserId
) bq on bq.UserId = (select OwnerUserId from Posts where Id = cce.Id)
left join UserActivityStats uas on uas.UserId = (select OwnerUserId from Posts where Id = cce.Id)
where cce.PopularityRank <= 50 and (cce.IsClosed = 0 or MostRecentCloseReason is not null)
order by cce.PopularityRank;