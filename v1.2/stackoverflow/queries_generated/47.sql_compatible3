WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        1 AS Level,
        CAST(ARRAY[t.TagName] AS VARCHAR[]) AS Path
    FROM Tags t
    WHERE t.IsModeratorOnly = false AND t.IsRequired = false
    UNION ALL
    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        r.Level + 1,
        r.Path || t2.TagName
    FROM Tags t2
    JOIN RecursiveTagHierarchy r ON t2.Id <> r.Id AND NOT t2.TagName = ANY(r.Path)
    WHERE t2.IsModeratorOnly = false AND t2.IsRequired = false AND r.Level < 3
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsAsked,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersGiven,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        COALESCE(SUM(vb.BountyAmount),0) AS TotalBountyGiven,
        MAX(u.Reputation) AS Reputation,
        ROW_NUMBER() OVER (ORDER BY MAX(u.Reputation) DESC) AS ReputationRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '365 days'
    LEFT JOIN Comments c ON c.UserId = u.Id AND c.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '365 days'
    LEFT JOIN Votes vb ON vb.UserId = u.Id AND vb.VoteTypeId = 8 AND vb.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '365 days'
    GROUP BY u.Id, u.DisplayName
),
PostScoreStats AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        DENSE_RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) AS ScoreRank,
        AVG(p.Score) OVER (PARTITION BY p.PostTypeId) AS AvgScore,
        STDDEV_SAMP(p.Score) OVER (PARTITION BY p.PostTypeId) AS StdDevScore
    FROM Posts p
    WHERE p.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '180 days'
),
TopQuestionsWithAnswers AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId AS QuestionOwner,
        q.CreationDate AS QuestionDate,
        q.Score AS QuestionScore,
        a.Id AS AnswerId,
        a.OwnerUserId AS AnswerOwner,
        a.CreationDate AS AnswerDate,
        a.Score AS AnswerScore,
        ROW_NUMBER() OVER (PARTITION BY q.Id ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1 AND q.Score > 10 AND q.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '365 days'
),
CloseReasonCounts AS (
    SELECT
        cht.Name AS CloseReason,
        COUNT(DISTINCT ph.PostId) AS ClosedPostsCount
    FROM PostHistory ph
    JOIN PostHistoryTypes chtt ON ph.PostHistoryTypeId = chtt.Id
    JOIN CloseReasonTypes cht ON CAST(ph.Comment AS INTEGER) = cht.Id
    WHERE ph.PostHistoryTypeId = 10 AND ph.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '365 days'
    GROUP BY cht.Name
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COUNT(DISTINCT b.Name) AS DistinctBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
UserPostLinkStats AS (
    SELECT
        u.Id AS UserId,
        COUNT(DISTINCT pl.Id) FILTER (WHERE pl.LinkTypeId = 1) AS LinkedPosts,
        COUNT(DISTINCT pl.Id) FILTER (WHERE pl.LinkTypeId = 3) AS DuplicatePosts
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN PostLinks pl ON pl.PostId = p.Id
    GROUP BY u.Id
),
FinalUserStats AS (
    SELECT
        ua.UserId,
        ua.DisplayName,
        ua.QuestionsAsked,
        ua.AnswersGiven,
        ua.CommentsMade,
        ua.TotalBountyGiven,
        ua.Reputation,
        ua.ReputationRank,
        COALESCE(ubs.GoldBadges,0) AS GoldBadges,
        COALESCE(ubs.SilverBadges,0) AS SilverBadges,
        COALESCE(ubs.BronzeBadges,0) AS BronzeBadges,
        COALESCE(ubs.DistinctBadges,0) AS DistinctBadges,
        COALESCE(ups.LinkedPosts,0) AS LinkedPosts,
        COALESCE(ups.DuplicatePosts,0) AS DuplicatePosts,
        CASE WHEN ua.QuestionsAsked > 0 THEN ROUND(CAST(ua.AnswersGiven AS NUMERIC) / ua.QuestionsAsked, 2) ELSE NULL END AS AnswerToQuestionRatio,
        CASE WHEN ua.Reputation > 0 THEN ROUND((CAST(ua.TotalBountyGiven AS NUMERIC) / ua.Reputation) * 100, 2) ELSE 0 END AS BountyPctOfReputation
    FROM UserActivity ua
    LEFT JOIN UserBadgeSummary ubs ON ubs.UserId = ua.UserId
    LEFT JOIN UserPostLinkStats ups ON ups.UserId = ua.UserId
)
SELECT
    fus.UserId,
    fus.DisplayName,
    fus.Reputation,
    fus.ReputationRank,
    fus.QuestionsAsked,
    fus.AnswersGiven,
    fus.CommentsMade,
    fus.GoldBadges,
    fus.SilverBadges,
    fus.BronzeBadges,
    fus.DistinctBadges,
    fus.LinkedPosts,
    fus.DuplicatePosts,
    fus.AnswerToQuestionRatio,
    fus.BountyPctOfReputation,
    cr.CloseReason,
    cr.ClosedPostsCount,
    pss.Id AS PostId,
    pss.PostTypeId,
    pss.Score,
    pss.ViewCount,
    pss.AvgScore,
    pss.StdDevScore,
    pss.ScoreRank,
    rth.Level AS TagHierarchyLevel,
    array_to_string(rth.Path, ' > ') AS TagHierarchyPath,
    tqwa.QuestionId,
    tqwa.Title AS QuestionTitle,
    tqwa.QuestionScore,
    tqwa.AnswerId,
    tqwa.AnswerScore,
    tqwa.AnswerRank
FROM FinalUserStats fus
LEFT JOIN CloseReasonCounts cr ON cr.CloseReason = (
    SELECT cht.Name
    FROM PostHistory ph2
    JOIN CloseReasonTypes cht ON CAST(ph2.Comment AS INTEGER) = cht.Id
    WHERE ph2.PostHistoryTypeId = 10 AND ph2.UserId = fus.UserId
    ORDER BY ph2.CreationDate DESC
    LIMIT 1
)
LEFT JOIN PostScoreStats pss ON pss.OwnerUserId = fus.UserId
LEFT JOIN RecursiveTagHierarchy rth ON rth.TagName = ANY(string_to_array(COALESCE(pss.Tags,''), '><'))
LEFT JOIN TopQuestionsWithAnswers tqwa ON tqwa.QuestionOwner = fus.UserId AND tqwa.AnswerOwner = fus.UserId
WHERE fus.ReputationRank <= 100
ORDER BY fus.ReputationRank, pss.ScoreRank NULLS LAST, tqwa.AnswerRank NULLS LAST
LIMIT 200;