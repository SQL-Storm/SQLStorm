WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        1 AS Level,
        CAST(t.TagName AS VARCHAR(255)) AS AncestryPath
    FROM Tags t
    WHERE t.IsModeratorOnly = 0

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        child.Count,
        parent.Level + 1,
        CAST(parent.AncestryPath || ' > ' || child.TagName AS VARCHAR(255))
    FROM Tags child
    JOIN RecursiveTagHierarchy parent ON child.Count < parent.Count AND child.Id <> parent.Id
    WHERE child.IsModeratorOnly = 0
    AND parent.Level < 3 -- limit recursion to depth 3 for performance benchmarking
),
UserActivityRankings AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Location,
        DATE(u.CreationDate) AS CreatedDay,
        COALESCE(SUM(CASE v.VoteTypeId WHEN 2 THEN 1 ELSE 0 END),0) AS TotalUpVotes,
        COALESCE(COUNT(p.Id),0) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        ROUND(
            SUM(
                CASE
                    WHEN p.PostTypeId = 2 THEN p.Score
                    ELSE 0
                END
            )::NUMERIC / NULLIF(COUNT(p.Id), 0), 3
         ) AS AvgAnswerScore,
        ROW_NUMBER() OVER(PARTITION BY COALESCE(u.Location,'unknown') ORDER BY u.Reputation DESC, u.CreationDate ASC) AS Loc_Rank_Reputation,
        RANK() OVER(PARTITION BY DATE(u.CreationDate) ORDER BY COALESCE(SUM(ci.CommentCount),0) DESC) AS Day_Rank_Comments
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id AND v.VoteTypeId IN (2,3)
    LEFT JOIN (
        SELECT PostId, SUM(CommentCount) as CommentCount
        FROM Posts
        GROUP BY PostId
    ) ci ON ci.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location, DATE(u.CreationDate), u.CreationDate
),
