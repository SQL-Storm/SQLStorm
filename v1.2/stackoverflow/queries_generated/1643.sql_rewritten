with RankedPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.OwnerUserId,
        p.Score,
        p.AnswerCount,
        p.ViewCount,
        p.Tags,
        row_number() over(partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc, p.CreationDate) as rn,
        rank() over(partition by p.PostTypeId order by p.CreationDate) as c_rnk
    from
        Posts p
    where
        p.PostTypeId in (1,2) -- questions and answers
        and p.CreationDate > (cast('2024-10-01' as date) - interval '365 days')
),
UserBadgeCounts as (
    select 
        b.UserId, 
        sum(case when b.Class = 1 then 1 else 0 end) as Gold,
        sum(case when b.Class = 2 then 1 else 0 end) as Silver,
        sum(case when b.Class = 3 then 1 else 0 end) as Bronze,
        count(*) as TotalBadges
    from Badges b
    group by b.UserId
),
