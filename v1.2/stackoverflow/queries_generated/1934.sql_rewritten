       LEFT JOIN LATERAL(
            SELECT a.Id, a.Score
            FROM Posts a
            WHERE a.ParentId = p.Id AND a.PostTypeId = 2
            ORDER BY a.CreationDate ASC
            LIMIT 1
       ) first_answer ON true
    WHERE p.PostTypeId = 1
