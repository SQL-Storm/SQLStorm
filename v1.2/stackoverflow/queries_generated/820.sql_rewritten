-- {"query": "820.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.8, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 2001} 
WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        1 AS Level
    FROM Tags t
    WHERE t.IsModeratorOnly = 0 AND t.IsRequired = 0
    UNION ALL
    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        r.Level + 1
    FROM Tags t2
    JOIN RecursiveTagHierarchy r ON t2.Id = r.Id + 1
    WHERE r.Level < 3
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        COUNT(DISTINCT p2.Id) FILTER (WHERE p2.PostTypeId = 2) AS AnswersPosted,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        SUM(COALESCE(vt_up.VoteCount, 0)) AS TotalUpVotes,
        SUM(COALESCE(vt_down.VoteCount, 0)) AS TotalDownVotes,
        MAX(b.Date) AS LastBadgeDate,
        STRING_AGG(DISTINCT b.Name, ', ') FILTER (WHERE b.Id IS NOT NULL) AS BadgesList
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Posts p2 ON p2.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Votes vt_up ON vt_up.UserId = u.Id AND vt_up.VoteTypeId = 2
    LEFT JOIN Votes vt_down ON vt_down.UserId = u.Id AND vt_down.VoteTypeId = 3
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopQuestionsWithDetails AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        COALESCE(u.DisplayName, 'unknown') AS OwnerDisplayName,
        COALESCE(u.Reputation, 0) AS OwnerReputation,
        (SELECT COUNT(*) FROM Posts a WHERE a.ParentId = p.Id) AS AnswerCount,
        COALESCE((SELECT MAX(v.CreationDate) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2), p.CreationDate) AS LastUpvoteDate,
        ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS RankByScore
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1
      AND p.ClosedDate IS NULL
      AND p.Score > 5
),
AnswerStats AS (
    SELECT
        a.ParentId AS QuestionId,
        COUNT(*) AS TotalAnswers,
        AVG(a.Score) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore,
        MIN(a.Score) AS MinAnswerScore,
        COUNT(DISTINCT CASE WHEN a.LastActivityDate > cast('2024-10-01 12:34:56' as timestamp) - interval '30 days' THEN a.Id END) AS RecentAnswers
    FROM Posts a
    WHERE a.PostTypeId = 2
    GROUP BY a.ParentId
),
PostHistorySummary AS (
    SELECT
        ph.PostId,
        ph.PostHistoryTypeId,
        COUNT(*) AS HistoryCount,
        MAX(ph.CreationDate) AS LastHistoryDate
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (1,2,3,4,5,6)
    GROUP BY ph.PostId, ph.PostHistoryTypeId
),
CombinedQuestions AS (
    SELECT
        tq.QuestionId,
        tq.Title,
        tq.CreationDate,
        tq.Score,
        tq.ViewCount,
        tq.Tags,
        tq.OwnerDisplayName,
        tq.OwnerReputation,
        tq.AnswerCount,
        tq.LastUpvoteDate,
        a.TotalAnswers,
        a.AvgAnswerScore,
        a.MaxAnswerScore,
        a.MinAnswerScore,
        a.RecentAnswers,
        phs.HistoryCount FILTER (WHERE phs.PostHistoryTypeId = 1) AS TitleEdits,
        phs.HistoryCount FILTER (WHERE phs.PostHistoryTypeId = 5) AS BodyEdits,
        phs.HistoryCount FILTER (WHERE phs.PostHistoryTypeId = 6) AS TagEdits,
        CASE
            WHEN a.MaxAnswerScore > tq.Score THEN 'High scoring answer exists'
            ELSE 'No high scoring answer'
        END AS AnswerQualityFlag,
        ROW_NUMBER() OVER (PARTITION BY tq.OwnerDisplayName ORDER BY tq.Score DESC) AS UserQuestionRank
    FROM TopQuestionsWithDetails tq
    LEFT JOIN AnswerStats a ON a.QuestionId = tq.QuestionId
    LEFT JOIN PostHistorySummary phs ON phs.PostId = tq.QuestionId
)
SELECT
    cq.QuestionId,
    cq.Title,
    cq.CreationDate,
    cq.Score,
    cq.ViewCount,
    cq.Tags,
    cq.OwnerDisplayName,
    cq.OwnerReputation,
    cq.AnswerCount,
    cq.TotalAnswers,
    ROUND(cq.AvgAnswerScore::numeric, 2) AS AvgAnswerScore,
    cq.MaxAnswerScore,
    cq.MinAnswerScore,
    cq.RecentAnswers,
    COALESCE(cq.TitleEdits, 0) AS TitleEdits,
    COALESCE(cq.BodyEdits, 0) AS BodyEdits,
    COALESCE(cq.TagEdits, 0) AS TagEdits,
    cq.AnswerQualityFlag,
    cq.UserQuestionRank,
    ua.QuestionsPosted,
    ua.AnswersPosted,
    ua.CommentsMade,
    ua.TotalUpVotes,
    ua.TotalDownVotes,
    ua.LastBadgeDate,
    ua.BadgesList,
    CASE
        WHEN ua.Reputation > 10000 THEN 'Experienced User'
        WHEN ua.Reputation BETWEEN 1000 AND 10000 THEN 'Intermediate User'
        ELSE 'Newbie'
    END AS UserReputationClass,
    CASE
        WHEN POSITION('sql' IN LOWER(cq.Tags)) > 0 THEN 'Contains SQL Tag'
        ELSE 'No SQL Tag'
    END AS TagPresenceSQL,
    CASE
        WHEN cq.ViewCount > 10000 THEN 'High View Count'
        WHEN cq.ViewCount BETWEEN 1000 AND 10000 THEN 'Medium View Count'
        ELSE 'Low View Count'
    END AS ViewCountClass,
    CONCAT('Q#', cq.QuestionId, ': ', LEFT(cq.Title, 50), '...') AS ShortTitle,
    LENGTH(cq.Title) AS TitleLength,
    COALESCE(NULLIF(cq.Tags, ''), '<no tags>') AS TagsNonNull,
    CASE
        WHEN strpos(cq.Title, 'error') > 0 THEN TRUE ELSE FALSE
    END AS TitleContainsError
FROM CombinedQuestions cq
LEFT JOIN UserActivity ua ON ua.UserId = (
    SELECT u.Id FROM Users u WHERE u.DisplayName = cq.OwnerDisplayName LIMIT 1
)
WHERE cq.UserQuestionRank <= 5
ORDER BY cq.Score DESC, cq.ViewCount DESC
LIMIT 100
UNION
SELECT
    p.Id AS QuestionId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.Tags,
    COALESCE(u.DisplayName, 'unknown') AS OwnerDisplayName,
    COALESCE(u.Reputation, 0) AS OwnerReputation,
    p.AnswerCount,
    0 AS TotalAnswers,
    NULL::numeric AS AvgAnswerScore,
    NULL AS MaxAnswerScore,
    NULL AS MinAnswerScore,
    0 AS RecentAnswers,
    0 AS TitleEdits,
    0 AS BodyEdits,
    0 AS TagEdits,
    'No answers yet' AS AnswerQualityFlag,
    0 AS UserQuestionRank,
    0 AS QuestionsPosted,
    0 AS AnswersPosted,
    0 AS CommentsMade,
    0 AS TotalUpVotes,
    0 AS TotalDownVotes,
    NULL AS LastBadgeDate,
    NULL AS BadgesList,
    'Unknown' AS UserReputationClass,
    CASE
        WHEN POSITION('sql' IN LOWER(p.Tags)) > 0 THEN 'Contains SQL Tag'
        ELSE 'No SQL Tag'
    END AS TagPresenceSQL,
    CASE
        WHEN p.ViewCount > 10000 THEN 'High View Count'
        WHEN p.ViewCount BETWEEN 1000 AND 10000 THEN 'Medium View Count'
        ELSE 'Low View Count'
    END AS ViewCountClass,
    CONCAT('Q#', p.Id, ': ', LEFT(p.Title, 50), '...') AS ShortTitle,
    LENGTH(p.Title) AS TitleLength,
    COALESCE(NULLIF(p.Tags, ''), '<no tags>') AS TagsNonNull,
    CASE
        WHEN strpos(p.Title, 'error') > 0 THEN TRUE ELSE FALSE
    END AS TitleContainsError
FROM Posts p
LEFT JOIN Users u ON p.OwnerUserId = u.Id
WHERE p.PostTypeId = 1
  AND p.ClosedDate IS NULL
  AND p.Score <= 5
ORDER BY Score DESC, ViewCount DESC
LIMIT 20;