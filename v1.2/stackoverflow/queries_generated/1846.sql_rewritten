      dense_rank() over (partition by p.PostTypeId order by p.Score desc, p.ViewCount desc) as RankPerType        
    from Posts p
    where p.CreationDate > dateadd(year, -2, cast('2024-10-01 12:34:56' as timestamp)) and p.OwnerUserId is not null 
    
