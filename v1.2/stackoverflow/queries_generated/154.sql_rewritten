-- {"query": "154.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.1, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1900} 
with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        0 as Level,
        array[t.Id] as Path
    from Tags t
    where t.IsModeratorOnly = 0 and t.IsRequired = 0

    union all

    select
        t2.Id,
        t2.TagName,
        t2.Count,
        r.Level + 1,
        r.Path || t2.Id
    from Tags t2
    join RecursiveTagHierarchy r on t2.Id <> all(r.Path)
    where t2.IsModeratorOnly = 0 and t2.IsRequired = 0 and r.Level < 2
),
UserBadgeCounts as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserReputationStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        coalesce(ubc_gold.BadgeCount, 0) as GoldBadges,
        coalesce(ubc_silver.BadgeCount, 0) as SilverBadges,
        coalesce(ubc_bronze.BadgeCount, 0) as BronzeBadges,
        row_number() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join UserBadgeCounts ubc_gold on ubc_gold.UserId = u.Id and ubc_gold.Class = 1
    left join UserBadgeCounts ubc_silver on ubc_silver.UserId = u.Id and ubc_silver.Class = 2
    left join UserBadgeCounts ubc_bronze on ubc_bronze.UserId = u.Id and ubc_bronze.Class = 3
),
TopQuestions as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Tags,
        p.AcceptedAnswerId,
        u.DisplayName as OwnerName,
        dense_rank() over (order by p.Score desc, p.ViewCount desc) as ScoreRank
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId = 1 and p.ClosedDate is null
),
AcceptedAnswerDetails as (
    select
        a.Id,
        a.ParentId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreationDate,
        u.DisplayName as AnswerOwnerName,
        u.Reputation as AnswerOwnerReputation
    from Posts a
    left join Users u on u.Id = a.OwnerUserId
    where a.PostTypeId = 2
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        count(a.Id) as AnswerCount,
        max(a.Score) as MaxAnswerScore,
        min(a.CreationDate) as EarliestAnswerDate,
        sum(case when a.Score > 0 then 1 else 0 end) as PositiveAnswers,
        sum(case when a.Score <= 0 then 1 else 0 end) as NonPositiveAnswers
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.CreationDate,
        count(*) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as PostsLast30Days,
        sum(p.Score) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as ScoreLast30Days
    from Users u
    join Posts p on p.OwnerUserId = u.Id
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        p1.Title as PostTitle,
        p2.Title as RelatedPostTitle
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where pl.LinkTypeId = 3
),
CloseReasonCounts as (
    select
        ph.PostId,
        crt.Name as CloseReason,
        count(*) as CloseVotes
    from PostHistory ph
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as int)
    where ph.PostHistoryTypeId = 10
    group by ph.PostId, crt.Name
),
QuestionsWithCloseInfo as (
    select
        q.Id,
        q.Title,
        q.OwnerUserId,
        crc.CloseReason,
        crc.CloseVotes
    from Posts q
    left join CloseReasonCounts crc on crc.PostId = q.Id
    where q.PostTypeId = 1
),
UserCommentStats as (
    select
        c.UserId,
        count(*) as CommentCount,
        avg(length(c.Text)) as AvgCommentLength,
        sum(case when c.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '1 year' then 1 else 0 end) as CommentsLastYear
    from Comments c
    group by c.UserId
),
UserSummary as (
    select
        urs.UserId,
        urs.DisplayName,
        urs.Reputation,
        urs.Location,
        urs.GoldBadges,
        urs.SilverBadges,
        urs.BronzeBadges,
        coalesce(ucs.CommentCount, 0) as TotalComments,
        coalesce(ucs.AvgCommentLength, 0) as AvgCommentLength,
        coalesce(ucs.CommentsLastYear, 0) as CommentsLastYear,
        ua.PostsLast30Days,
        ua.ScoreLast30Days
    from UserReputationStats urs
    left join UserCommentStats ucs on ucs.UserId = urs.UserId
    left join (
        select distinct on (UserId) UserId, PostsLast30Days, ScoreLast30Days
        from UserActivityWindow
        order by UserId, PostsLast30Days desc
    ) ua on ua.UserId = urs.UserId
)
select
    q.Id as QuestionId,
    q.Title,
    q.OwnerUserId,
    us.DisplayName as OwnerName,
    q.Score as QuestionScore,
    q.ViewCount,
    q.Tags,
    q.AcceptedAnswerId,
    a.AnswerScore,
    a.AnswerOwnerName,
    a.AnswerOwnerReputation,
    qa.AnswerCount,
    qa.MaxAnswerScore,
    qa.PositiveAnswers,
    qa.NonPositiveAnswers,
    coalesce(qc.CloseReason, 'Open') as CloseReason,
    coalesce(qc.CloseVotes, 0) as CloseVotes,
    us.Reputation as OwnerReputation,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.TotalComments,
    us.AvgCommentLength,
    us.CommentsLastYear,
    us.PostsLast30Days,
    us.ScoreLast30Days,
    string_agg(distinct rth.TagName, ', ') as RelatedTags,
    dl.PostTitle as DuplicateOfTitle,
    case
        when q.AcceptedAnswerId is not null then 'Accepted'
        else 'No Accepted Answer'
    end as AcceptedStatus,
    case
        when q.Score > 100 then 'Hot'
        when q.Score between 50 and 100 then 'Trending'
        else 'Normal'
    end as PopularityCategory
from TopQuestions q
left join AcceptedAnswerDetails a on a.Id = q.AcceptedAnswerId
left join QuestionAnswerStats qa on qa.QuestionId = q.Id
left join QuestionsWithCloseInfo qc on qc.Id = q.Id
left join UserSummary us on us.UserId = q.OwnerUserId
left join RecursiveTagHierarchy rth on position('<' || rth.TagName || '>' in q.Tags) > 0
left join DuplicateLinks dl on dl.PostId = q.Id
where q.ScoreRank <= 100
group by
    q.Id, q.Title, q.OwnerUserId, q.Score, q.ViewCount, q.Tags, q.AcceptedAnswerId,
    a.AnswerScore, a.AnswerOwnerName, a.AnswerOwnerReputation,
    qa.AnswerCount, qa.MaxAnswerScore, qa.PositiveAnswers, qa.NonPositiveAnswers,
    qc.CloseReason, qc.CloseVotes,
    us.Reputation, us.GoldBadges, us.SilverBadges, us.BronzeBadges,
    us.TotalComments, us.AvgCommentLength, us.CommentsLastYear, us.PostsLast30Days, us.ScoreLast30Days,
    dl.PostTitle
order by q.Score desc, qa.AnswerCount desc
limit 50;