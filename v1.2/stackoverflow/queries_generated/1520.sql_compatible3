WITH RankedAnswers AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.OwnerUserId,
        a.CreationDate,
        a.Score,
        RANK() OVER(PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS RankByScore,
        COALESCE(u.Reputation, 0) AS OwnerReputation,
        p.Tags
    FROM Posts a
    LEFT JOIN Posts p ON p.Id = a.ParentId
    LEFT JOIN Users u ON u.Id = a.OwnerUserId
    WHERE a.PostTypeId = 2
),
TopRoughViewQuestions AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        q.OwnerUserId,
        q.AnswerCount,
        COALESCE(u.Reputation, 0) AS OwnerReputation,
        q.Tags,
        RANK() OVER(ORDER BY q.ViewCount DESC, q.Score DESC) AS ViewRank
    FROM Posts q
    LEFT JOIN Users u ON u.Id = q.OwnerUserId
    WHERE q.PostTypeId = 1
      AND q.CreationDate BETWEEN DATE '2015-01-01' AND DATE '2017-01-01'
      AND q.ViewCount IS NOT NULL
),
FilteredQuestionsWithAcceptedAnswers AS (
    SELECT 
        tq.QuestionId,
        tq.Title,
        tq.CreationDate AS QuestionCreationDate,
        tq.Score AS QuestionScore,
        tq.ViewCount,
        tq.OwnerUserId AS QuestionOwnerId,
        tq.OwnerReputation AS QuestionOwnerReputation,
        COALESCE(au.Reputation, 0) AS AcceptedAnswererReputation,
        a.Id AS AcceptedAnswerId,
        a.Score AS AcceptedAnswerScore,
        COALESCE(Lq.RelativeFrenchaqs, 0) AS FrenchaRelatedCount,
        tailst.topic_frequency_as_fraction,
        (
          SELECT COUNT(DISTINCT pl.Id)
          FROM PostLinks pl
          WHERE pl.PostId = tq.QuestionId AND pl.LinkTypeId = 3
        ) AS DuplicateCount,
        CASE
          WHEN LOWER(tq.Title) LIKE '%performance%' OR LOWER(tq.Tags) LIKE '%performance%' THEN 1
          ELSE 0
        END AS HasPerformanceTi,
        CASE
          WHEN LOWER(tq.Title) LIKE '%benchmark%' OR LOWER(tq.Tags) LIKE '%benchmark%' THEN 1
          ELSE 0
        END AS HasBenchmarkTi
    FROM TopRoughViewQuestions tq
    LEFT JOIN Posts a ON a.Id = (
       SELECT q2.AcceptedAnswerId
       FROM Posts q2
       WHERE q2.Id = tq.QuestionId AND q2.PostTypeId = 1
       LIMIT 1
    )
    LEFT JOIN Users au ON au.Id = a.OwnerUserId
    LEFT JOIN (
      SELECT ParentId AS PostId, COUNT(*) AS RelativeFrenchaqs
      FROM Posts
      WHERE Tags LIKE '%<french qaq>%'
      GROUP BY ParentId
    ) Lq ON Lq.PostId = tq.QuestionId
    LEFT JOIN (
      SELECT t.Id AS Id,
             1.0 * qs.Count / SUM(qs.Count) OVER() AS topic_frequency_as_fraction,
             qs.tag AS TagName,
             t.TagName AS tTagName
      FROM Tags t
      JOIN (
          SELECT tag, COUNT(*) AS Count
          FROM (
              SELECT
                  -- Extract tags from the Tags string formatted like '<tag1><tag2>'
                  -- This uses a numbers/tally approach to split without UNNEST or string_to_array.
                  SUBSTRING(q.Tags FROM pos FOR (CASE
                      WHEN POSITION('><' IN SUBSTRING(q.Tags FROM pos)) > 0
                      THEN POSITION('><' IN SUBSTRING(q.Tags FROM pos)) - 1
                      ELSE LENGTH(q.Tags) - pos + 1
                  END)) AS tag
              FROM Posts q
              CROSS JOIN (
                  -- generate positions of '<' in the Tags string
                  SELECT generate_series AS pos
                  FROM (SELECT 1) s -- placeholder to allow generate_series in dialects that support it
                  CROSS JOIN LATERAL (
                    SELECT g.generate_series
                    FROM (SELECT 1) g1, LATERAL (
                      SELECT generate_series(1, CASE WHEN q.Tags IS NULL THEN 0 ELSE LENGTH(q.Tags) END) 
                    ) g(generate_series)
                  ) g(generate_series)
              ) positions
              WHERE q.PostTypeId = 1
                AND q.Tags IS NOT NULL
                AND SUBSTRING(q.Tags FROM positions.pos FOR 1) = '<'
          ) split_tags
          GROUP BY tag
      ) qs ON qs.tag = t.TagName
      WHERE t.TagName IS NOT NULL
    ) tailst ON tailst.Id = tq.QuestionId
),
FinalComputations AS (
   SELECT
       fq.QuestionId,
       fq.Title,
       fq.QuestionCreationDate,
       fq.QuestionScore,
       fq.ViewCount,
       fq.QuestionOwnerId,
       fq.QuestionOwnerReputation,
       fq.AcceptedAnswererReputation,
       fq.AcceptedAnswerId,
       fq.AcceptedAnswerScore,
       fq.DuplicateCount,
       fq.HasPerformanceTi,
       fq.HasBenchmarkTi,
       fq.FrenchaRelatedCount,
       fq.topic_frequency_as_fraction,
       LENGTH(fq.Title) AS TitleLength
   FROM FilteredQuestionsWithAcceptedAnswers fq
)
SELECT *
FROM FinalComputations;