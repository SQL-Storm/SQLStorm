with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        u.Views,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionsCount,
        count(distinct p2.Id) filter (where p2.PostTypeId = 2) as AnswersCount,
        sum(coalesce(p.Score, 0)) filter (where p.PostTypeId in (1, 2)) as TotalPostScore,
        row_number() over (partition by u.Location order by u.Reputation desc) as LocationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Posts p2 on p2.OwnerUserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Location, u.Views
), UserBadgeSummary as (
    select
        b.UserId,
        count(*) filter (where b.Class = 1) as GoldBadges,
        count(*) filter (where b.Class = 2) as SilverBadges,
        count(*) filter (where b.Class = 3) as BronzeBadges,
        bool_or(b.TagBased) as HasTagBasedBadge
    from Badges b
    group by b.UserId
), LatestPostEdits as (
    select ph.PostId, max(ph.CreationDate) as LastEditDate
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6,7,8,9)
    group by ph.PostId
), TopAnsweredQuestions as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate,
        q.Score as QuestionScore,
        q.ViewCount,
        a.Id as TopAnswerId,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswererId,
        a.CreationDate as AnswerCreationDate,
        row_number() over (partition by q.Id order by a.Score desc) as AnswerRank
    from Posts q
    join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
), DuplicateLinks as (
    select pl.PostId, pl.RelatedPostId, lt.Name as LinkTypeName
    from PostLinks pl
    join LinkTypes lt on pl.LinkTypeId = lt.Id
    where lt.Name = 'Duplicate'
), QuestionCloseReasons as (
    select ph.PostId,
           crt.Name as CloseReasonName,
           ph.CreationDate as CloseDate
    from PostHistory ph
    left join CloseReasonTypes crt on cast(ph.Comment as integer) = crt.Id
    where ph.PostHistoryTypeId = 10
), UserVoteSummary as (
    select
        v.UserId,
        count(*) filter (where vt.Name = 'UpMod') as UpvotesGiven,
        count(*) filter (where vt.Name = 'DownMod') as DownvotesGiven,
        count(*) filter (where vt.Name = 'Favorite') as FavoritesGiven
    from Votes v
    join VoteTypes vt on v.VoteTypeId = vt.Id
    group by v.UserId
)
select
    ru.UserId,
    ru.DisplayName,
    ru.Reputation,
    ru.Location,
    coalesce(ubs.GoldBadges,0) as GoldBadges,
    coalesce(ubs.SilverBadges,0) as SilverBadges,
    coalesce(ubs.BronzeBadges,0) as BronzeBadges,
    coalesce(uvs.UpvotesGiven,0) as UpvotesGiven,
    coalesce(uvs.DownvotesGiven,0) as DownvotesGiven,
    coalesce(uvs.FavoritesGiven,0) as FavoritesGiven,
    ru.QuestionsCount,
    ru.AnswersCount,
    ru.TotalPostScore,
    ru.Views,
    ru.CreationDate,
    ru.LocationRank,
    case when coalesce(ubs.HasTagBasedBadge, false) then 'Yes' else 'No' end as HasTagBasedBadge,
    q.QuestionId,
    q.Title,
    q.QuestionScore,
    q.QuestionViewCount,
    q.CloseDate,
    q.CloseReasonName,
    q.DuplicateOfTitle,
    q.TopAnswerId,
    q.AnswerScore,
    q.AnswerCreationDate,
    q.AnswererId,
    u.DisplayName as AnswererDisplayName
from RecursiveUserActivity ru
left join UserBadgeSummary ubs on ubs.UserId = ru.UserId
left join UserVoteSummary uvs on uvs.UserId = ru.UserId
left join (
    select
        q.Id as QuestionId,
        q.Title,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViewCount,
        qcr.CloseDate,
        qcr.CloseReasonName,
        dup.Title as DuplicateOfTitle,
        ta.TopAnswerId,
        ta.AnswerScore,
        ta.AnswerCreationDate,
        ta.AnswererId
    from Posts q
    left join QuestionCloseReasons qcr on qcr.PostId = q.Id
    left join DuplicateLinks dl on dl.PostId = q.Id
    left join Posts dup on dup.Id = dl.RelatedPostId
    left join (
        select
            QuestionId,
            TopAnswerId,
            AnswerScore,
            AnswerCreationDate,
            AnswererId
        from TopAnsweredQuestions
        where AnswerRank = 1
    ) ta on ta.QuestionId = q.Id
    where q.PostTypeId = 1
      and q.Score > 0
) q on q.QuestionId = ru.UserId
left join Users u on u.Id = q.AnswererId
where (ru.Reputation > 1000 or ru.Location is not null)
  and (coalesce(ubs.GoldBadges,0) + coalesce(ubs.SilverBadges,0) + coalesce(ubs.BronzeBadges,0)) > 5
  and (coalesce(uvs.UpvotesGiven,0) > 10 or coalesce(uvs.FavoritesGiven,0) > 5)
  and exists (
      select 1
      from Posts psub
      where psub.OwnerUserId = ru.UserId
        and psub.PostTypeId = 1
        and psub.Score > (
            select avg(p2.Score) from Posts p2 where p2.PostTypeId = 1
        )
  )
order by ru.Reputation desc, ru.Location asc
limit 100;