with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(distinct c.Id) as CommentCount,
        count(distinct b.Id) as BadgeCount,
        sum(v.VoteCount) as TotalVotesReceived
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Badges b on b.UserId = u.Id
    left join (
        select PostId, count(*) as VoteCount
        from Votes
        group by PostId
    ) v on v.PostId = p.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
RankedPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc) as PostRank
    from Posts p
    where p.PostTypeId in (1, 2)
),
TopPostsWithHistory as (
    select
        rp.Id as PostId,
        rp.OwnerUserId,
        rp.PostTypeId,
        rp.Score,
        rp.ViewCount,
        rp.CreationDate,
        rp.Title,
        rp.Tags,
        ph.PostHistoryTypeId,
        pht.Name as HistoryTypeName,
        ph.CreationDate as HistoryCreationDate,
        ph.UserId as EditorUserId,
        ph.UserDisplayName as EditorDisplayName,
        ph.Comment as HistoryComment
    from RankedPosts rp
    left join PostHistory ph on ph.PostId = rp.Id
    left join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId
    where rp.PostRank <= 3
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        lt.Name as LinkTypeName
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where lt.Name = 'Duplicate'
),
UserBadgesSummary as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserBadgePivot as (
    select
        ub.UserId,
        coalesce(max(case when ub.Class = 1 then ub.BadgeCount end), 0) as GoldBadges,
        coalesce(max(case when ub.Class = 2 then ub.BadgeCount end), 0) as SilverBadges,
        coalesce(max(case when ub.Class = 3 then ub.BadgeCount end), 0) as BronzeBadges
    from UserBadgesSummary ub
    group by ub.UserId
),
UserActivityWithBadges as (
    select
        rua.*,
        ubp.GoldBadges,
        ubp.SilverBadges,
        ubp.BronzeBadges
    from RecursiveUserActivity rua
    left join UserBadgePivot ubp on ubp.UserId = rua.UserId
),
UserTopPosts as (
    select
        upb.UserId,
        upb.DisplayName,
        upb.Reputation,
        upb.QuestionCount,
        upb.AnswerCount,
        upb.CommentCount,
        upb.BadgeCount,
        upb.GoldBadges,
        upb.SilverBadges,
        upb.BronzeBadges,
        tp.Id as PostId,
        tp.PostTypeId,
        tp.Score,
        tp.ViewCount,
        tp.CreationDate as PostCreationDate,
        tp.Title,
        tp.Tags,
        tp.PostRank
    from UserActivityWithBadges upb
    left join RankedPosts tp on tp.OwnerUserId = upb.UserId and tp.PostRank <= 3
),
UserPostVotes as (
    select
        p.OwnerUserId as UserId,
        count(v.Id) filter (where v.VoteTypeId = 2) as UpVotesReceived,
        count(v.Id) filter (where v.VoteTypeId = 3) as DownVotesReceived,
        count(v.Id) filter (where v.VoteTypeId = 5) as FavoritesReceived
    from Posts p
    left join Votes v on v.PostId = p.Id
    group by p.OwnerUserId
),
FinalUserStats as (
    select
        utp.UserId,
        utp.DisplayName,
        utp.Reputation,
        utp.QuestionCount,
        utp.AnswerCount,
        utp.CommentCount,
        utp.BadgeCount,
        utp.GoldBadges,
        utp.SilverBadges,
        utp.BronzeBadges,
        coalesce(upv.UpVotesReceived, 0) as UpVotesReceived,
        coalesce(upv.DownVotesReceived, 0) as DownVotesReceived,
        coalesce(upv.FavoritesReceived, 0) as FavoritesReceived,
        utp.PostId,
        utp.PostTypeId,
        utp.Score,
        utp.ViewCount,
        utp.PostCreationDate,
        utp.Title,
        utp.Tags,
        utp.PostRank
    from UserTopPosts utp
    left join UserPostVotes upv on upv.UserId = utp.UserId
)
select
    fus.UserId,
    fus.DisplayName,
    fus.Reputation,
    fus.QuestionCount,
    fus.AnswerCount,
    fus.CommentCount,
    fus.BadgeCount,
    fus.GoldBadges,
    fus.SilverBadges,
    fus.BronzeBadges,
    fus.UpVotesReceived,
    fus.DownVotesReceived,
    fus.FavoritesReceived,
    fus.PostId,
    case fus.PostTypeId when 1 then 'Question' when 2 then 'Answer' else 'Other' end as PostType,
    fus.Score,
    fus.ViewCount,
    fus.PostCreationDate,
    fus.Title,
    fus.Tags,
    fus.PostRank,
    case
        when fus.Tags is not null and fus.Tags <> '' then
            substring(fus.Tags from '<([^>]+)>')
        else null
    end as FirstTag,
    case
        when fus.ViewCount > 0 then round(fus.Score::numeric / fus.ViewCount, 4)
        else null
    end as ScoreViewRatio,
    rank() over (partition by fus.GoldBadges, fus.SilverBadges, fus.BronzeBadges order by fus.Reputation desc) as ReputationRankWithinBadgeClass,
    (
        select count(distinct dl.PostId)
        from DuplicateLinks dl
        join Posts p2 on p2.Id = dl.PostId
        where p2.OwnerUserId = fus.UserId
    ) as DuplicatePostsCount
from FinalUserStats fus
where fus.Reputation > 1000
group by
    fus.UserId,
    fus.DisplayName,
    fus.Reputation,
    fus.QuestionCount,
    fus.AnswerCount,
    fus.CommentCount,
    fus.BadgeCount,
    fus.GoldBadges,
    fus.SilverBadges,
    fus.BronzeBadges,
    fus.UpVotesReceived,
    fus.DownVotesReceived,
    fus.FavoritesReceived,
    fus.PostId,
    fus.PostTypeId,
    fus.Score,
    fus.ViewCount,
    fus.PostCreationDate,
    fus.Title,
    fus.Tags,
    fus.PostRank
order by fus.Reputation desc, fus.BadgeCount desc, fus.QuestionCount desc
limit 100;