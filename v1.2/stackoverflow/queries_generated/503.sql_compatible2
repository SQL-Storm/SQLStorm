WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        ARRAY[t.TagName] AS TagPath
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE AND t.IsRequired = FALSE
    UNION ALL
    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        r.TagPath || t2.TagName
    FROM Tags t2
    JOIN RecursiveTagHierarchy r ON t2.Id > r.Id
    WHERE t2.IsModeratorOnly = FALSE AND t2.IsRequired = FALSE
      AND cardinality(r.TagPath) < 3
),
UserPostStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        COALESCE(SUM(p.Score),0) AS TotalPostScore,
        AVG(p.Score) FILTER (WHERE p.PostTypeId IN (1,2)) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT c.Id) AS CommentCount
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName
),
PostWithVotes AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpVotes,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownVotes,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 8) AS BountyStarts,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 9) AS BountyEnds,
        MAX(v.BountyAmount) FILTER (WHERE v.VoteTypeId IN (8,9)) AS MaxBounty
    FROM Posts p
    LEFT JOIN Votes v ON v.PostId = p.Id
    WHERE p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')
    GROUP BY p.Id, p.PostTypeId, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount, p.Tags, p.Title
),
PostAnswerStats AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId AS QuestionOwner,
        q.CreationDate AS QuestionDate,
        q.Score AS QuestionScore,
        q.ViewCount AS QuestionViews,
        COUNT(a.Id) AS AnswerCount,
        AVG(a.Score) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore,
        SUM(CASE WHEN a.OwnerUserId = q.OwnerUserId THEN 1 ELSE 0 END) AS SelfAnswerCount,
        MAX(a.CreationDate) AS LastAnswerDate
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1 AND q.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '2 years')
    GROUP BY q.Id, q.Title, q.OwnerUserId, q.CreationDate, q.Score, q.ViewCount
),
PostHistoryCloseInfo AS (
    SELECT
        ph.PostId,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.CreationDate ELSE NULL END) AS ClosedDate,
        MAX(CASE WHEN ph.PostHistoryTypeId = 11 THEN ph.CreationDate ELSE NULL END) AS ReopenedDate,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.Comment ELSE NULL END) AS CloseReasonId
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (10,11)
    GROUP BY ph.PostId
),
TopUsersByBadge AS (
    SELECT
        b.UserId,
        COUNT(*) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges b
    WHERE b.Class = 1
    GROUP BY b.UserId
    ORDER BY GoldBadges DESC
    LIMIT 50
),
UserActivityWindow AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS RecentPostRank,
        COUNT(*) OVER (PARTITION BY u.Id) AS TotalPosts
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    WHERE u.Reputation > 500
)
SELECT
    ups.UserId,
    ups.DisplayName,
    ups.QuestionCount,
    ups.AnswerCount,
    ups.TotalPostScore,
    ups.AvgPostScore,
    ups.BadgeCount,
    ups.CommentCount,
    pas.QuestionId,
    pas.Title AS QuestionTitle,
    pas.AnswerCount AS QuestionAnswerCount,
    pas.AvgAnswerScore,
    pas.MaxAnswerScore,
    phci.ClosedDate,
    phci.ReopenedDate,
    crt.Name AS CloseReason,
    twb.GoldBadges,
    twb.SilverBadges,
    twb.BronzeBadges,
    uaw.TotalPosts,
    uaw.RecentPostRank,
    CASE 
        WHEN ups.AvgPostScore IS NULL THEN 'No posts'
        WHEN ups.AvgPostScore > 10 AND ups.BadgeCount > 5 THEN 'High quality user'
        WHEN ups.AvgPostScore BETWEEN 5 AND 10 THEN 'Moderate quality user'
        ELSE 'Low quality user'
    END AS UserQualityCategory,
    (COALESCE(SUBSTRING(ups.DisplayName FROM 1 FOR 10), 'Anonymous')
        || ' (#' || CAST(ups.UserId AS varchar) || ')') AS UserLabel,
    RANK() OVER (ORDER BY ups.TotalPostScore DESC) AS UserScoreRank
FROM UserPostStats ups
LEFT JOIN PostAnswerStats pas ON pas.QuestionOwner = ups.UserId
LEFT JOIN PostHistoryCloseInfo phci ON phci.PostId = pas.QuestionId
LEFT JOIN CloseReasonTypes crt ON crt.Id = phci.CloseReasonId
LEFT JOIN TopUsersByBadge twb ON twb.UserId = ups.UserId
LEFT JOIN UserActivityWindow uaw ON uaw.UserId = ups.UserId AND uaw.RecentPostRank = 1
WHERE ups.QuestionCount > 10
  AND (pas.AnswerCount > 0 OR pas.AnswerCount IS NULL)
  AND (phci.ClosedDate IS NULL OR phci.ReopenedDate > phci.ClosedDate)
GROUP BY
    ups.UserId,
    ups.DisplayName,
    ups.QuestionCount,
    ups.AnswerCount,
    ups.TotalPostScore,
    ups.AvgPostScore,
    ups.BadgeCount,
    ups.CommentCount,
    pas.QuestionId,
    pas.Title,
    pas.AnswerCount,
    pas.AvgAnswerScore,
    pas.MaxAnswerScore,
    phci.ClosedDate,
    phci.ReopenedDate,
    crt.Name,
    twb.GoldBadges,
    twb.SilverBadges,
    twb.BronzeBadges,
    uaw.TotalPosts,
    uaw.RecentPostRank,
    ups.UserId,
    ups.DisplayName
ORDER BY ups.TotalPostScore DESC, ups.BadgeCount DESC, ups.QuestionCount DESC
LIMIT 100;