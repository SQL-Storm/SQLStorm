WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 AS Depth
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE
    UNION ALL
    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        t2.IsModeratorOnly,
        t2.IsRequired,
        r.Depth + 1
    FROM Tags t2
    INNER JOIN RecursiveTagHierarchy r ON t2.WikiPostId = r.ExcerptPostId
    WHERE r.Depth < 3
),
RecentHighScoreAnswers AS (
    SELECT 
        a.Id,
        a.ParentId,
        a.Score,
        a.CreationDate,
        a.OwnerUserId,
        u.DisplayName AS OwnerName,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate DESC) AS rn
    FROM Posts a
    LEFT JOIN Users u ON a.OwnerUserId = u.Id
    WHERE a.PostTypeId = 2
      AND a.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '90 days')
      AND a.Score >= 5
),
QuestionStats AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.OwnerUserId,
        u.DisplayName AS QuestionOwner,
        q.AcceptedAnswerId,
        COALESCE(rha.Score, 0) AS TopAnswerScore,
        COALESCE(rha.OwnerName, 'Unknown') AS TopAnswerOwner,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = q.Id AND c.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '30 days')) AS RecentCommentCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = q.Id AND v.VoteTypeId = 2) AS UpVotesCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = q.Id AND v.VoteTypeId = 3) AS DownVotesCount,
        CASE WHEN q.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAcceptedAnswer,
        dlt.LastEditorUserId,
        dlt.LastEditDate,
        dlt.LastEditorDisplayName,
        UPPER(SPLIT_PART(SUBSTRING(q.Tags FROM 2 FOR LENGTH(q.Tags) - 2), '><', 1)) || '|' || COALESCE(u.DisplayName, 'Anonymous') AS TagOwnerConcat,
        CASE 
            WHEN q.OwnerUserId IS NULL OR q.OwnerUserId = -1 THEN COALESCE(q.OwnerDisplayName, 'Community')
            ELSE u.DisplayName
        END AS EffectiveOwnerName
    FROM Posts q
    LEFT JOIN Users u ON q.OwnerUserId = u.Id
    LEFT JOIN RecentHighScoreAnswers rha ON q.Id = rha.ParentId AND rha.rn = 1
    LEFT JOIN LATERAL (
        SELECT ph.LastEditorUserId, ph.LastEditDate, ph.LastEditorDisplayName
        FROM Posts ph
        WHERE ph.Id = q.Id
        ORDER BY ph.LastEditDate DESC NULLS LAST
        LIMIT 1
    ) dlt ON TRUE
    WHERE q.PostTypeId = 1
      AND q.ClosedDate IS NULL
      AND q.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '180 days')
),
DuplicateLinks AS (
    SELECT DISTINCT pl.PostId
    FROM PostLinks pl
    WHERE pl.LinkTypeId = 3
),
BadgeAggregates AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        COUNT(DISTINCT CASE WHEN b.TagBased = 1 THEN b.Name ELSE NULL END) AS DistinctTagBadges
    FROM Badges b
    GROUP BY b.UserId
),
UserActivityWindow AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        COUNT(DISTINCT p.Id) AS PostsCount,
        COUNT(DISTINCT c.Id) AS CommentsCount,
        SUM(COALESCE(vb.UpVotes,0)) AS UserUpVotes,
        SUM(COALESCE(vb.DownVotes,0)) AS UserDownVotes,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS UserRankByReputation
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '365 days')
    LEFT JOIN Comments c ON c.UserId = u.Id AND c.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '365 days')
    LEFT JOIN (
        SELECT 
            v.UserId,
            SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
        WHERE v.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '365 days')
        GROUP BY v.UserId
    ) vb ON vb.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Location
),
CompositeResults AS (
    SELECT 
        qs.QuestionId,
        qs.Title,
        qs.CreationDate,
        qs.QuestionScore,
        qs.ViewCount,
        qs.QuestionOwner,
        qs.HasAcceptedAnswer,
        qs.TopAnswerScore,
        qs.TopAnswerOwner,
        qs.RecentCommentCount,
        qs.UpVotesCount,
        qs.DownVotesCount,
        dl.PostId AS IsDuplicate,
        ba.GoldBadges,
        ba.SilverBadges,
        ba.BronzeBadges,
        ba.DistinctTagBadges,
        qs.TagOwnerConcat,
        qs.EffectiveOwnerName,
        ua.UserRankByReputation,
        ua.PostsCount,
        ua.CommentsCount,
        ua.UserUpVotes,
        ua.UserDownVotes,
        COUNT(qs.QuestionId) OVER (PARTITION BY DATE_TRUNC('month', qs.CreationDate)) AS QuestionsPostedThisMonth,
        PERCENT_RANK() OVER (PARTITION BY DATE_TRUNC('month', qs.CreationDate) ORDER BY qs.QuestionScore) AS QuestionScorePercentile
    FROM QuestionStats qs
    LEFT JOIN DuplicateLinks dl ON qs.QuestionId = dl.PostId
    LEFT JOIN BadgeAggregates ba ON ba.UserId = (SELECT u2.Id FROM Users u2 WHERE u2.DisplayName = qs.EffectiveOwnerName LIMIT 1)
    LEFT JOIN UserActivityWindow ua ON ua.DisplayName = qs.EffectiveOwnerName
)
SELECT *
FROM CompositeResults
WHERE (COALESCE(GoldBadges,0) + COALESCE(SilverBadges,0) + COALESCE(BronzeBadges,0)) >= 5
  AND QuestionScore >= 10
  AND ViewCount > 500
  AND RecentCommentCount > 2
  AND (DownVotesCount IS NULL OR DownVotesCount < (UpVotesCount / 10.0))
  AND IsDuplicate IS NULL
ORDER BY QuestionScore DESC, ViewCount DESC, CreationDate DESC
LIMIT 50;