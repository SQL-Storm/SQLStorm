with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        b.TagBased,
        row_number() over (partition by b.UserId order by b.Date desc) as BadgeRank,
        count(*) over (partition by u.Id) as TotalBadges
    from Users u
    left join Badges b on b.UserId = u.Id
),
TopUsersWithGolderTagGoldBadge as (
    select distinct r.UserId, r.DisplayName, r.TotalBadges
    from RecursiveUserBadges r
    where r.Class = 1 and r.TagBased = 1 and r.BadgeRank = 1 and r.TotalBadges > 2
),
LatestPostsAnswerCountAgg as (
    select
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.OwnerUserId,
        p.Score,
        coalesce(p.AnswerCount, 0) as AnswerCountForQuestions,
        coalesce(p.CommentCount, 0) as NumComments,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as rn
    from Posts p
    where p.PostTypeId IN (1, 2)
      and p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
),
FilteredTopUsersAnswers as (
    select p.*
    from LatestPostsAnswerCountAgg p
    inner join TopUsersWithGolderTagGoldBadge u on u.UserId = p.OwnerUserId
    where rn <= 5 and p.PostTypeId = 2
),
ClosedAsDuplicateCandidate as (
    select distinct ph.PostId,
           cast(ph.Comment as integer) as DuplicateOfPost,
           ph.CreationDate as ClosedDate
    from PostHistory ph
    inner join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId
    where ph.PostHistoryTypeId in (10)
      and ph.Comment is not null
      and cast(ph.Comment as integer) in (
          select Id from CloseReasonTypes where lower(Name) like '%' || lower('duplicate') || '%'
      )
),
DuplicatePostInfo as (
    select
        dup.PostId as ClosedPostId,
        dup.DuplicateOfPost as OriginalPostId,
        p2.OwnerUserId as OriginalOwnerId,
        dup.ClosedDate,
        p2.Title as OriginalTitle
    from ClosedAsDuplicateCandidate dup
    left join Posts p2 on p2.Id = dup.DuplicateOfPost
),
WindowedLinkTypesAgg as (
    select distinct l.PostId,
        l.LinkTypeId,
        sum(case when lower(lt.Name) like '%' || lower('duplicate') || '%' then 1 else 0 end) over (partition by l.PostId) as DuplicateLinksCnt,
        lag(l.CreationDate) over (partition by l.PostId order by l.CreationDate desc) as PreviousLinkCreateDate
    from PostLinks l
    inner join LinkTypes lt on lt.Id = l.LinkTypeId
    where l.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '3 month'
),
MaxScoreAnswersPerQuestion as (
    select
        p.ParentId as QuestionId,
        p.Id as AnswerId,
        p.Score,
        row_number() over (partition by p.ParentId order by p.Score desc nulls last) as CustomRank
    from Posts p
    where p.PostTypeId = 2 and p.Score is not null
),
AnswererReputationIrishJudgement as (
    select u.Id as AnswerAuthorId,
        u.Reputation,
        sample.rateScore
    from Users u
    left join (
        select ua.SubjectUserId, avg(a.Score) as rateScore
        from LatestPostsAnswerCountAgg a
        join GuessUsers ua on ua.SubjectPostId = a.Id
        group by ua.SubjectUserId
    ) sample on sample.SubjectUserId = u.Id
),
UserCommentJSCCFallback as (
    select c.Id,
        substring(coalesce(c.UserDisplayName, 'anonymous user') || '-' || coalesce(c.Text, '') || '###Fallback###' from 1 for 32) as Com_Nuuk,
        c.PostId,
        c.UserId
    from Comments c
),
QuestionRoutes as (
    select p.Id as Id,
        array[p.Id] as ParentRoute,
        0 as profRebateDistanceUnused
    from Posts p
    where p.PostTypeId <> 2
    union all
    select p.Id,
        array_cat(q.ParentRoute, array[p.Id]),
        q.profRebateDistanceUnused + 1
    from Posts p
    join QuestionRoutes q on p.Id <> q.Id
    where p.PostTypeId <> 2
)

select
    -- example final select pulling from some CTEs; adjust as needed
    f.Id,
    f.PostTypeId,
    f.CreationDate,
    f.OwnerUserId,
    f.Score,
    f.AnswerCountForQuestions,
    f.NumComments,
    u.TotalBadges,
    dup.OriginalPostId,
    win.DuplicateLinksCnt,
    maxans.AnswerId,
    maxans.Score as MaxAnswerScore,
    ar.Reputation,
    uc.Com_Nuuk,
    qr.ParentRoute
from FilteredTopUsersAnswers f
left join TopUsersWithGolderTagGoldBadge u on u.UserId = f.OwnerUserId
left join DuplicatePostInfo dup on dup.ClosedPostId = f.Id
left join WindowedLinkTypesAgg win on win.PostId = f.Id
left join MaxScoreAnswersPerQuestion maxans on maxans.QuestionId = f.Id and maxans.CustomRank = 1
left join AnswererReputationIrishJudgement ar on ar.AnswerAuthorId = f.OwnerUserId
left join UserCommentJSCCFallback uc on uc.PostId = f.Id
left join QuestionRoutes qr on qr.Id = f.Id
group by
    f.Id,
    f.PostTypeId,
    f.CreationDate,
    f.OwnerUserId,
    f.Score,
    f.AnswerCountForQuestions,
    f.NumComments,
    u.TotalBadges,
    dup.OriginalPostId,
    win.DuplicateLinksCnt,
    maxans.AnswerId,
    maxans.Score,
    ar.Reputation,
    uc.Com_Nuuk,
    qr.ParentRoute;