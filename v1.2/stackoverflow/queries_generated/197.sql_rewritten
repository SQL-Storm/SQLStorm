-- {"query": "197.sql", "dataset": "stackoverflow", "version": "v1.2", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 0.1, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1710} 
with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 as Level,
        cast(t.TagName as varchar(1000)) as Path
    from Tags t
    where t.IsRequired = 1

    union all

    select
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        t2.IsModeratorOnly,
        t2.IsRequired,
        r.Level + 1,
        r.Path || ' > ' || t2.TagName
    from Tags t2
    join RecursiveTagHierarchy r on t2.Id <> r.Id and t2.IsRequired = 1 and t2.Count < r.Count
    where r.Level < 3
),
UserBadgeCounts as (
    select
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserReputationRank as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        dense_rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
    where u.Reputation is not null
),
PostScoreStats as (
    select
        p.OwnerUserId,
        count(*) filter (where p.PostTypeId = 1) as QuestionCount,
        count(*) filter (where p.PostTypeId = 2) as AnswerCount,
        avg(p.Score) filter (where p.PostTypeId = 1) as AvgQuestionScore,
        avg(p.Score) filter (where p.PostTypeId = 2) as AvgAnswerScore,
        max(p.Score) filter (where p.PostTypeId = 1) as MaxQuestionScore,
        max(p.Score) filter (where p.PostTypeId = 2) as MaxAnswerScore
    from Posts p
    where p.OwnerUserId is not null
    group by p.OwnerUserId
),
TopPostsWithComments as (
    select
        p.Id,
        p.PostTypeId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        u.DisplayName as OwnerName,
        coalesce(c.CommentCount, 0) as CommentCount,
        row_number() over (partition by p.PostTypeId order by p.Score desc, p.ViewCount desc) as rn
    from Posts p
    left join Users u on p.OwnerUserId = u.Id
    left join (
        select PostId, count(*) as CommentCount
        from Comments
        group by PostId
    ) c on p.Id = c.PostId
    where p.PostTypeId in (1, 2)
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        pt1.Title as PostTitle,
        pt2.Title as RelatedPostTitle
    from PostLinks pl
    join Posts pt1 on pl.PostId = pt1.Id
    join Posts pt2 on pl.RelatedPostId = pt2.Id
    where pl.LinkTypeId = 3 -- Duplicate
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.CreationDate,
        count(*) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as PostsLast30Days,
        sum(case when p.PostTypeId = 1 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as QuestionsLast30Days,
        sum(case when p.PostTypeId = 2 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as AnswersLast30Days
    from Users u
    left join Posts p on u.Id = p.OwnerUserId
    where u.CreationDate < cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
),
ClosedQuestionsWithReasons as (
    select
        ph.PostId,
        ph.CreationDate as ClosedDate,
        crt.Name as CloseReason,
        p.Title,
        p.OwnerUserId,
        u.DisplayName as OwnerName
    from PostHistory ph
    join CloseReasonTypes crt on cast(ph.Comment as int) = crt.Id
    join Posts p on ph.PostId = p.Id
    left join Users u on p.OwnerUserId = u.Id
    where ph.PostHistoryTypeId = 10 -- Post Closed
),
QuestionsWithAcceptedAnswers as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreation,
        a.Id as AcceptedAnswerId,
        a.CreationDate as AnswerCreation,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerOwnerId,
        u.DisplayName as AnswerOwnerName,
        extract(epoch from (a.CreationDate - q.CreationDate))/3600 as HoursToAccept
    from Posts q
    left join Posts a on q.AcceptedAnswerId = a.Id
    left join Users u on a.OwnerUserId = u.Id
    where q.PostTypeId = 1 and q.AcceptedAnswerId is not null
),
UserBadgesSummary as (
    select
        ub.UserId,
        max(case when ub.Class = 1 then ub.BadgeCount else 0 end) as GoldBadges,
        max(case when ub.Class = 2 then ub.BadgeCount else 0 end) as SilverBadges,
        max(case when ub.Class = 3 then ub.BadgeCount else 0 end) as BronzeBadges
    from UserBadgeCounts ub
    group by ub.UserId
)
select
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    coalesce(pb.QuestionCount,0) as TotalQuestions,
    coalesce(pb.AnswerCount,0) as TotalAnswers,
    coalesce(pb.AvgQuestionScore,0) as AvgQuestionScore,
    coalesce(pb.AvgAnswerScore,0) as AvgAnswerScore,
    coalesce(ubs.GoldBadges,0) as GoldBadges,
    coalesce(ubs.SilverBadges,0) as SilverBadges,
    coalesce(ubs.BronzeBadges,0) as BronzeBadges,
    ua.PostsLast30Days,
    ua.QuestionsLast30Days,
    ua.AnswersLast30Days,
    dq.PostId as DuplicatePostId,
    dq.RelatedPostId as DuplicateOfPostId,
    dq.PostTitle as DuplicatePostTitle,
    dq.RelatedPostTitle as DuplicateOfPostTitle,
    cq.ClosedDate,
    cq.CloseReason,
    cq.Title as ClosedQuestionTitle,
    qa.HoursToAccept,
    qa.AnswerScore as AcceptedAnswerScore,
    qa.AnswerOwnerName as AcceptedAnswerOwner,
    rth.Path as RequiredTagPath
from Users u
left join PostScoreStats pb on u.Id = pb.OwnerUserId
left join UserBadgesSummary ubs on u.Id = ubs.UserId
left join UserActivityWindow ua on u.Id = ua.UserId
left join DuplicateLinks dq on dq.PostId = (
    select p.Id from Posts p where p.OwnerUserId = u.Id order by p.Score desc limit 1
)
left join ClosedQuestionsWithReasons cq on cq.OwnerUserId = u.Id
left join QuestionsWithAcceptedAnswers qa on qa.AnswerOwnerId = u.Id
left join RecursiveTagHierarchy rth on rth.Level = 1
where u.Reputation > 1000
  and (ua.PostsLast30Days > 5 or ua.PostsLast30Days is null)
order by u.Reputation desc, pb.AnswerCount desc
limit 100;