WITH RankedAnswers AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.OwnerUserId,
        a.CreationDate,
        a.Score,
        RANK() OVER(PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS RankByScore,
        COALESCE(u.Reputation, 0) AS OwnerReputation,
        p.Tags
    FROM Posts a
    LEFT JOIN Posts p ON p.Id = a.ParentId
    LEFT JOIN Users u ON u.Id = a.OwnerUserId
    WHERE a.PostTypeId = 2 -- Answer
),
TopRoughViewQuestions AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        q.OwnerUserId,
        q.AnswerCount,
        COALESCE(u.Reputation, 0) AS OwnerReputation,
        q.Tags,
        RANK() OVER(ORDER BY q.ViewCount DESC, q.Score DESC NULLS LAST) AS ViewRank
    FROM Posts q
    LEFT JOIN Users u ON u.Id = q.OwnerUserId
    WHERE q.PostTypeId = 1 -- Question
      AND q.CreationDate BETWEEN '2015-01-01' AND '2017-01-01'
      AND q.ViewCount IS NOT NULL
),
FilteredQuestionsWithAcceptedAnswers AS (
    SELECT 
        tq.QuestionId,
        tq.Title,
        tq.CreationDate AS QuestionCreationDate,
        tq.Score AS QuestionScore,
        tq.ViewCount,
        tq.OwnerUserId AS QuestionOwnerId,
        tq.OwnerReputation AS QuestionOwnerReputation,
        COALESCE(au.Reputation, 0) AS AcceptedAnswererReputation,
        a.Id AS AcceptedAnswerId,
        a.Score AS AcceptedAnswerScore,
        COALESCE(Lq.RelativeFrenchaqs, 0) AS FrenchaRelatedCount,
        tailst.topic_frequency_as_fraction,
        
