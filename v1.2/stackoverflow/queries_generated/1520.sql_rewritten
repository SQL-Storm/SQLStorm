        (SELECT COUNT(DISTINCT pl.Id) 
         FROM PostLinks pl
         WHERE pl.PostId = tq.QuestionId AND pl.LinkTypeId = 3  -- 3 = Duplicate links only                     
        ) AS DuplicateCount,
        
        -- Presence of "performance" key word or "benchmark" keyword counter/computation        
        CASE
         WHEN LOWER(tq.Title) LIKE '%performance%' OR LOWER(tq.Tags) LIKE '%performance%'
           THEN 1 ELSE 0 END AS HasPerformanceTi,

        CASE
         WHEN LOWER(tq.Title) LIKE '%benchmark%' OR LOWER(tq.Tags) LIKE '%benchmark%'
           THEN 1 ELSE 0 END AS HasBenchmarkTi

    
    FROM TopRoughViewQuestions tq                                  

