WITH RecursiveAnswerTree AS (
    SELECT 
        p.Id,
        p.ParentId,
        p.Score,
        1 AS Depth,
        ARRAY[p.Id] AS PathIds
    FROM Posts p
    WHERE p.PostTypeId = 2 AND p.ParentId IS NOT NULL
    UNION ALL
    SELECT 
        p.Id,
        p.ParentId,
        p.Score,
        rat.Depth + 1 AS Depth,
        rat.PathIds || p.Id
    FROM Posts p
    INNER JOIN RecursiveAnswerTree rat ON p.ParentId = rat.Id
