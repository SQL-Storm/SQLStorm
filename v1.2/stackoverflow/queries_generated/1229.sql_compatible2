WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        1 AS Level
    FROM Tags t
    WHERE t.IsRequired = TRUE

    UNION ALL

    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        r.Level + 1
    FROM Tags t2
    JOIN RecursiveTagHierarchy r ON r.Id = t2.Id - 1
    WHERE r.Level < 3
), 
RankedPosts AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Title,
        p.Tags,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AcceptedAnswerId,
        u.DisplayName,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) AS total_posts
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId IN (1, 2)
      AND p.CreationDate > DATE '2010-01-01'
),
AggregatedVotes AS (
    SELECT
        p.Id AS PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
        SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS Favorites,
        COUNT(v.Id) AS TotalVotes
    FROM Posts p
    LEFT JOIN Votes v ON p.Id = v.PostId
    GROUP BY p.Id
), 
ClosingStats AS (
    SELECT
        ph.PostId,
        SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseEvents,
        MAX(ph.Comment) AS LatestCloseReasonId,
        MAX(ph.CreationDate) AS LastCloseDate
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (10, 11)
    GROUP BY ph.PostId
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(DISTINCT b.Name) AS UniqueBadgesCount,
        MAX(b.Date) AS LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
UserActivityWindows AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.CreationDate,
        u.DisplayName,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
        LAG(u.Reputation) OVER (ORDER BY u.CreationDate) AS PrevReputation,
        LEAD(u.Reputation) OVER (ORDER BY u.CreationDate) AS NextReputation
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    GROUP BY u.Id, u.Reputation, u.CreationDate, u.DisplayName
),
TopContributors AS (
    SELECT
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.QuestionCount,
        ua.AnswerCount,
        ua.UpVotesGiven,
        ua.DownVotesGiven,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.UniqueBadgesCount,
        ua.PrevReputation,
        ua.NextReputation,
        RANK() OVER (ORDER BY ua.Reputation DESC) AS ReputationRank
    FROM UserActivityWindows ua
    LEFT JOIN UserBadgeSummary ub ON ua.UserId = ub.UserId
)
SELECT
    tp.UserId,
    COALESCE(tp.DisplayName, 'Unknown') AS DisplayName,
    tp.Reputation,
    tp.QuestionCount,
    tp.AnswerCount,
    tp.UpVotesGiven,
    tp.DownVotesGiven,
    tp.GoldBadges,
    tp.SilverBadges,
    tp.BronzeBadges,
    tp.UniqueBadgesCount,
    tp.PrevReputation,
    tp.NextReputation,
    p.Id AS RecentPostId,
    p.PostTypeId,
    p.Title,
    p.CreationDate AS PostDate,
    COALESCE(av.UpVotes, 0) AS PostUpVotes,
    COALESCE(av.DownVotes, 0) AS PostDownVotes,
    COALESCE(av.Favorites, 0) AS PostFavorites,
    COALESCE(logging.CloseEvents, 0) AS TotalCloseVotes,
    ct.Name AS LatestCloseReason,
    CASE 
      WHEN p.AcceptedAnswerId IS NOT NULL THEN 'AcceptedAnswer'
      WHEN p.PostTypeId = 1 THEN 'QuestionWithNoAcceptedAnswer'
      WHEN p.PostTypeId = 2 THEN 'Answer'
      ELSE 'Other'
    END AS PostCategory,
    LENGTH(COALESCE(p.Body, '')) AS BodyLength,
    SUBSTRING(p.Body FROM '(\w{5,})') AS SampleWord,
    CASE WHEN p.Tags IS NULL THEN 'NoTags'
         ELSE REPLACE(REPLACE(p.Tags, '<', ''), '>', ', ') END AS TagsNormalized,
    ROW_NUMBER() OVER (PARTITION BY tp.UserId ORDER BY p.CreationDate DESC) AS PostRank,
    rh.Level AS TagRecursionLevel,
    rh.TagName AS SampleRecursiveTagName,
    tp.ReputationRank
FROM TopContributors tp
JOIN RankedPosts p ON p.OwnerUserId = tp.UserId AND p.rn = 1
LEFT JOIN AggregatedVotes av ON p.Id = av.PostId
LEFT JOIN ClosingStats logging ON logging.PostId = p.Id
LEFT JOIN CloseReasonTypes ct ON ct.Id = CAST(logging.LatestCloseReasonId AS INTEGER)
LEFT JOIN RecursiveTagHierarchy rh ON rh.ExcerptPostId = p.Id
WHERE tp.Reputation > 10000

UNION

SELECT
    tp.UserId,
    COALESCE(tp.DisplayName, 'Unknown') AS DisplayName,
    tp.Reputation,
    tp.QuestionCount,
    tp.AnswerCount,
    tp.UpVotesGiven,
    tp.DownVotesGiven,
    tp.GoldBadges,
    tp.SilverBadges,
    tp.BronzeBadges,
    tp.UniqueBadgesCount,
    tp.PrevReputation,
    tp.NextReputation,
    q.Id AS RecentQuestionId,
    q.PostTypeId,
    q.Title,
    q.CreationDate AS PostDate,
    COALESCE(av.UpVotes, 0) AS PostUpVotes,
    COALESCE(av.DownVotes, 0) AS PostDownVotes,
    COALESCE(av.Favorites, 0) AS PostFavorites,
    COALESCE(logging.CloseEvents, 0) AS TotalCloseVotes,
    ct.Name AS LatestCloseReason,
    'QuestionDuplicated' AS PostCategory,
    LENGTH(COALESCE(q.Body, '')) AS BodyLength,
    SUBSTRING(q.Body FROM '(\w{8,})') AS SampleWord,
    CASE WHEN q.Tags IS NULL THEN 'NoTags'
         ELSE REPLACE(REPLACE(q.Tags, '<', ''), '>', ', ') END AS TagsNormalized,
    ROW_NUMBER() OVER (PARTITION BY tp.UserId ORDER BY q.CreationDate DESC) AS PostRank,
    rh.Level AS TagRecursionLevel,
    rh.TagName AS SampleRecursiveTagName,
    tp.ReputationRank
FROM TopContributors tp
JOIN Posts q ON q.PostTypeId = 1 AND q.OwnerUserId = tp.UserId
JOIN PostLinks pl ON pl.PostId = q.Id AND pl.LinkTypeId = 3
LEFT JOIN AggregatedVotes av ON q.Id = av.PostId
LEFT JOIN ClosingStats logging ON logging.PostId = q.Id
LEFT JOIN CloseReasonTypes ct ON ct.Id = CAST(logging.LatestCloseReasonId AS INTEGER)
LEFT JOIN RecursiveTagHierarchy rh ON rh.ExcerptPostId = q.Id
WHERE q.CreationDate > DATE '2015-01-01'
ORDER BY ReputationRank, PostDate DESC
LIMIT 100;