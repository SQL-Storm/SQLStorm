WITH RecentQuestions AS (
    SELECT 
        p.Id,
        p.Title,
        p.CreationDate,
        p.ViewCount,
        p.Score,
        u.DisplayName AS OwnerName,
        CASE 
          WHEN p.Tags IS NULL THEN ARRAY[]::varchar[]
          ELSE string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')
        END AS TagsArray
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1 AND p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
),
AnswerStats AS (
    SELECT 
        p.ParentId AS QuestionId,
        COUNT(p.Id) FILTER (WHERE p.Score > 0) AS PositiveAnswers,
        COUNT(p.Id) AS TotalAnswers,
        AVG(COALESCE(p.Score,0)) FILTER (WHERE p.Score IS NOT NULL) AS AvgAnswerScore,
        MAX(p.Score) AS MaxAnswerScore,
        SUM(COALESCE(LENGTH(p.Body) - LENGTH(REPLACE(p.Body,'code','')),0)) AS CodeHunks -- crude count of 'code' occurrences
    FROM Posts p
    WHERE p.PostTypeId = 2
    GROUP BY p.ParentId
),
UserBadgeAggregates AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(DISTINCT b.Name) AS UniqueBadges 
    FROM Badges b
    GROUP BY b.UserId
),
TopUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        ua.GoldBadges,
        ua.SilverBadges,
        ua.BronzeBadges,
        ua.UniqueBadges
    FROM Users u
    LEFT JOIN UserBadgeAggregates ua ON u.Id = ua.UserId
    WHERE u.Reputation > 5000
),
TaggedQuestions AS (
    SELECT 
        unnest(t.aggTags) AS TagName,
        q.Id AS QuestionId,
        q.Title,
        q.Score,
        q.ViewCount,
        ans.PositiveAnswers,
        ans.TotalAnswers,
        ans.MaxAnswerScore,
        ans.CodeHunks,
        oq.OwnerName,
        ROW_NUMBER() OVER (PARTITION BY unnest(t.aggTags) ORDER BY q.Score DESC) AS TagRank
    FROM (
        SELECT 
            q.Id, q.Title, q.Score, q.ViewCount, q.TagsArray, q.OwnerName
        FROM RecentQuestions q
    ) oq
    CROSS JOIN LATERAL (
        SELECT array_agg(tag) as aggTags
        FROM unnest(oq.TagsArray) AS tag
    ) t(aggTags)
    LEFT JOIN AnswerStats ans ON ans.QuestionId = oq.Id
    APPLY(ans.PositiveAnswers IS NOT NULL)  -- Dummy pseudo to indicate relevance aka filter Ineولوجечека"},
