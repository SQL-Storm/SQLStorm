with RecursiveTagCounts as (
    select
        t.Id,
        t.TagName,
        t.Count,
        p.Id as PostId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        u.Reputation,
        row_number() over (partition by t.Id order by p.CreationDate desc) as rn
    from Tags t
    left join Posts p on p.Tags like concat('%<', t.TagName, '>%') and p.PostTypeId = 1
    left join Users u on p.OwnerUserId = u.Id
    where t.Count > 1000
),
FilteredPosts as (
    select
        Id,
        TagName,
        Count,
        PostId,
        CreationDate,
        Score,
        ViewCount,
        OwnerUserId,
        Reputation
    from RecursiveTagCounts
    where rn <= 5
),
PostVotesAgg as (
    select
        v.PostId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes,
        sum(case when vt.Name = 'Favorite' then 1 else 0 end) as Favorites
    from Votes v
    join VoteTypes vt on v.VoteTypeId = vt.Id
    group by v.PostId
),
PostCommentsAgg as (
    select
        c.PostId,
        count(*) as CommentCount,
        sum(c.Score) as CommentScoreSum,
        max(c.CreationDate) as LastCommentDate
    from Comments c
    group by c.PostId
),
UserBadgeCounts as (
    select
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges
    from Badges b
    group by b.UserId
),
PostCloseReasons as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        ph.CreationDate as CloseDate
    from PostHistory ph
    join PostHistoryTypes pht on ph.PostHistoryTypeId = pht.Id
    left join CloseReasonTypes crt on cast(ph.Comment as integer) = crt.Id
    where ph.PostHistoryTypeId = 10
),
RankedAnswers as (
    select
        p.Id,
        p.ParentId,
        p.Score,
        p.CreationDate,
        p.OwnerUserId,
        row_number() over (partition by p.ParentId order by p.Score desc, p.CreationDate asc) as AnswerRank
    from Posts p
    where p.PostTypeId = 2
),
TopAnswers as (
    select
        ra.*
    from RankedAnswers ra
    where ra.AnswerRank <= 3
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        -- replace DISTINCT-in-window with COUNT(*) FILTER over a grouped subquery per user and date range approach
        -- compute counts per user per post date, then window-sum these indicators
        sum(case when p.PostTypeId = 1 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 365 preceding and current row) as QuestionsLastYear,
        sum(case when p.PostTypeId = 2 then 1 else 0 end) over (partition by u.Id order by p.CreationDate rows between 365 preceding and current row) as AnswersLastYear,
        max(p.CreationDate) over (partition by u.Id) as LastPostDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        u.DisplayName as OwnerDisplayName,
        p.Title as RelatedPostTitle
    from PostLinks pl
    join LinkTypes lt on pl.LinkTypeId = lt.Id and lt.Name = 'Duplicate'
    join Posts p on pl.RelatedPostId = p.Id
    left join Users u on pl.PostId = u.Id
),
CombinedPosts as (
    select
        fp.PostId,
        fp.TagName,
        fp.Count as TagCount,
        fp.CreationDate,
        fp.Score,
        fp.ViewCount,
        fp.OwnerUserId,
        fp.Reputation,
        coalesce(pva.UpVotes,0) as UpVotes,
        coalesce(pva.DownVotes,0) as DownVotes,
        coalesce(pva.Favorites,0) as Favorites,
        coalesce(pca.CommentCount,0) as CommentCount,
        coalesce(pca.CommentScoreSum,0) as CommentScoreSum,
        coalesce(pca.LastCommentDate, timestamp '1970-01-01') as LastCommentDate,
        coalesce(ubc.GoldBadges,0) as GoldBadges,
        coalesce(ubc.SilverBadges,0) as SilverBadges,
        coalesce(ubc.BronzeBadges,0) as BronzeBadges,
        pcr.CloseReasonName,
        pcr.CloseDate
    from FilteredPosts fp
    left join PostVotesAgg pva on fp.PostId = pva.PostId
    left join PostCommentsAgg pca on fp.PostId = pca.PostId
    left join UserBadgeCounts ubc on fp.OwnerUserId = ubc.UserId
    left join PostCloseReasons pcr on fp.PostId = pcr.PostId
)
select
    cp.PostId,
    cp.TagName,
    cp.TagCount,
    to_char(cp.CreationDate, 'YYYY-MM-DD') as CreationDate,
    cp.Score,
    cp.ViewCount,
    cp.UpVotes,
    cp.DownVotes,
    cp.Favorites,
    cp.CommentCount,
    cp.CommentScoreSum,
    to_char(cp.LastCommentDate, 'YYYY-MM-DD') as LastCommentDate,
    cp.GoldBadges,
    cp.SilverBadges,
    cp.BronzeBadges,
    cp.CloseReasonName,
    to_char(cp.CloseDate, 'YYYY-MM-DD') as CloseDate,
    ua.QuestionsLastYear,
    ua.AnswersLastYear,
    ua.LastPostDate,
    (
        select string_agg(t.TagName, ', ') from (
            select distinct t.TagName, t.Count
            from Tags t
            where cp.PostId in (
                select p.Id from Posts p where p.Tags like concat('%<', t.TagName, '>%')
            )
            order by t.Count desc
            limit 3
        ) s
    ) as TopRelatedTags,
    case
        when cp.Score > 100 and cp.ViewCount > 10000 then 'Hot'
        when cp.Score between 50 and 100 then 'Warm'
        else 'Cold'
    end as PopularityCategory,
    concat(
        'Score: ', cp.Score, ', Views: ', cp.ViewCount, ', UpVotes: ', cp.UpVotes,
        ', DownVotes: ', cp.DownVotes, ', Favorites: ', cp.Favorites
    ) as ScoreSummary,
    (select count(*) from TopAnswers ta where ta.ParentId = cp.PostId) as TopAnswerCount,
    (select string_agg(u.DisplayName, ', ')
     from (
         select distinct u.DisplayName
         from Users u
         join Posts p on p.OwnerUserId = u.Id
         where p.ParentId = cp.PostId and p.Score > 10
     ) sub
    ) as HighScoringAnswerers
from CombinedPosts cp
left join UserActivityWindow ua on cp.OwnerUserId = ua.UserId
where cp.CloseReasonName is null or cp.CloseDate > cast('2024-10-01' as date) - interval '180 days'
order by cp.TagCount desc, cp.Score desc, cp.ViewCount desc
limit 50;