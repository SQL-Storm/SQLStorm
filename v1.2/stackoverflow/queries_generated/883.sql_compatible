WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        1 AS Level
    FROM Tags t
    WHERE t.Count > 1000
  UNION ALL
    SELECT
        t2.Id,
        t2.TagName,
        t2.Count,
        t2.ExcerptPostId,
        t2.WikiPostId,
        r.Level + 1
    FROM Tags t2
    INNER JOIN PostLinks pl ON pl.PostId = t2.ExcerptPostId
    INNER JOIN RecursiveTagHierarchy r ON r.ExcerptPostId = pl.RelatedPostId
    WHERE r.Level < 3
),
UserBadgeStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName
),
TopPosts AS (
    SELECT 
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Tags,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.ViewCount DESC) AS RankByScoreView
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
      AND p.Score IS NOT NULL
      AND p.ViewCount IS NOT NULL
),
UserActivitySummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersCount,
        COUNT(DISTINCT c.Id) AS CommentsCount,
        COALESCE(SUM(vtUp.VoteCount), 0) AS UpVotesReceived,
        COALESCE(SUM(vtDown.VoteCount), 0) AS DownVotesReceived
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN (
        SELECT v.PostId, COUNT(*) AS VoteCount
        FROM Votes v
        WHERE v.VoteTypeId = 2
        GROUP BY v.PostId
    ) vtUp ON vtUp.PostId = p.Id
    LEFT JOIN (
        SELECT v.PostId, COUNT(*) AS VoteCount
        FROM Votes v
        WHERE v.VoteTypeId = 3
        GROUP BY v.PostId
    ) vtDown ON vtDown.PostId = p.Id
    GROUP BY u.Id, u.DisplayName
),
RecentPostEdits AS (
    SELECT
        ph.PostId,
        ph.UserId,
        ph.UserDisplayName,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS EditRank
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4,5,6)
      AND ph.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY)
),
PostsWithDuplicateLinks AS (
    SELECT DISTINCT
        pl.PostId,
        p.Title,
        p.Score,
        pl.RelatedPostId AS DuplicateOfId,
        p2.Title AS DuplicateOfTitle
    FROM PostLinks pl
    INNER JOIN Posts p ON p.Id = pl.PostId
    INNER JOIN Posts p2 ON p2.Id = pl.RelatedPostId
    WHERE pl.LinkTypeId = 3
),
ComplexUserStringExpressions AS (
    SELECT 
        u.Id,
        u.DisplayName,
        COALESCE(u.Location, 'Unknown') AS LocationCleaned,
        CONCAT(
            'User: ', COALESCE(u.DisplayName, 'Anonymous'), ' | ',
            'Reputation: ', CAST(u.Reputation AS VARCHAR), ' | ',
            'Member Since: ', TO_CHAR(u.CreationDate, 'YYYY-MM-DD'), ' | ',
            'Last Access: ', TO_CHAR(u.LastAccessDate, 'YYYY-MM-DD'), ' | ',
            'Website: ', COALESCE(NULLIF(u.WebsiteUrl, ''), 'N/A')
        ) AS UserSummary
    FROM Users u
    WHERE u.Reputation > 500
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    ub.TotalBadges,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    uas.QuestionsCount,
    uas.AnswersCount,
    uas.CommentsCount,
    uas.UpVotesReceived,
    uas.DownVotesReceived,
    cuse.LocationCleaned,
    cuse.UserSummary,
    tp.Title AS TopQuestionTitle,
    tp.Score AS TopQuestionScore,
    COALESCE(rpe.EditRank, 0) AS RecentEditRank,
    pdl.DuplicateOfTitle,
    rh.Level AS TagRecursionLevel,
    rh.TagName AS RelatedTagName
FROM Users u
LEFT JOIN UserBadgeStats ub ON ub.UserId = u.Id
LEFT JOIN UserActivitySummary uas ON uas.UserId = u.Id
LEFT JOIN ComplexUserStringExpressions cuse ON cuse.Id = u.Id
LEFT JOIN TopPosts tp ON tp.OwnerUserId = u.Id AND tp.PostTypeId = 1 AND tp.RankByScoreView = 1
LEFT JOIN RecentPostEdits rpe ON rpe.UserId = u.Id
LEFT JOIN PostsWithDuplicateLinks pdl ON pdl.PostId = (
    SELECT psub.Id 
    FROM Posts psub 
    WHERE psub.OwnerUserId = u.Id AND psub.PostTypeId = 1
    ORDER BY psub.CreationDate DESC
    LIMIT 1
)
LEFT JOIN RecursiveTagHierarchy rh ON rh.ExcerptPostId = tp.Id
WHERE u.Reputation > 1000
  AND (COALESCE(ub.GoldBadges, 0) > 0 OR COALESCE(ub.SilverBadges, 0) > 2)
  AND (tp.Score > 50 OR tp.ViewCount > 1000)
GROUP BY
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    ub.TotalBadges,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    uas.QuestionsCount,
    uas.AnswersCount,
    uas.CommentsCount,
    uas.UpVotesReceived,
    uas.DownVotesReceived,
    cuse.LocationCleaned,
    cuse.UserSummary,
    tp.Title,
    tp.Score,
    rpe.EditRank,
    pdl.DuplicateOfTitle,
    rh.Level,
    rh.TagName
ORDER BY u.Reputation DESC, ub.TotalBadges DESC, uas.UpVotesReceived DESC
LIMIT 100;