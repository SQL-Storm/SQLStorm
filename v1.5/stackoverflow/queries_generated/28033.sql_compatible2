WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        AVG(p.Score) OVER (PARTITION BY u.Id) AS AvgPostScore,
        MIN(u.Reputation) OVER (PARTITION BY u.Id) AS Reputation -- placeholder to satisfy group by
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id
), PostAnalysis AS (
    SELECT
        p.Id AS PostId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', '')) + 1 AS TagCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes,
        (SELECT COUNT(*) FROM PostHistory ph 
         WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10 
         AND CAST(ph.Comment AS INTEGER) IN (SELECT Id FROM CloseReasonTypes WHERE Name LIKE '%duplicate%')) AS DuplicateCloseEvents
    FROM Posts p
    WHERE p.PostTypeId = 1
)
SELECT 
    u.Id,
    u.DisplayName,
    -- include non-aggregated columns in GROUP BY or window functions; use existing grouping
    ua.BadgeCount,
    ua.QuestionCount + ua.AnswerCount AS TotalPosts,
    pa.TagCount,
    (SELECT STRING_AGG(t.TagName, '; ') 
     FROM Tags t 
     WHERE t.Id IN (
         SELECT UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><'))
     )) AS CommonTags,
    COALESCE(ph.RevisionCount, 0) AS EditHistoryCount,
    RANK() OVER (ORDER BY (ua.QuestionCount * 2 + ua.AnswerCount) DESC) AS ActivityRank,
    CASE 
        WHEN ua.AvgPostScore > 50 THEN 'High Quality' 
        WHEN ua.AvgPostScore BETWEEN 20 AND 50 THEN 'Medium Quality' 
        ELSE 'Low Quality' 
    END AS QualityCategory
FROM Users u
JOIN UserActivity ua ON u.Id = ua.UserId
LEFT JOIN PostAnalysis pa ON u.Id = (SELECT OwnerUserId FROM Posts WHERE Id = pa.PostId)
LEFT JOIN (
    SELECT 
        UserId, 
        COUNT(*) AS RevisionCount,
        PERCENT_RANK() OVER (ORDER BY COUNT(*) DESC) AS RevisionPercentile
    FROM PostHistory
    GROUP BY UserId
) ph ON u.Id = ph.UserId
WHERE u.Reputation > 1000
  AND ua.CommentCount > (SELECT AVG(CommentCount) FROM UserActivity)
  AND EXISTS (
      SELECT 1 
      FROM Votes v 
      WHERE v.UserId = u.Id 
        AND v.VoteTypeId IN (2, 8)
        AND v.CreationDate > DATE '2024-10-01' - INTERVAL '1 year'
  )
HAVING MAX(pa.Upvotes) > 10 OR MAX(pa.DuplicateCloseEvents) > 0
ORDER BY 
    ua.ReputationRank, 
    ActivityRank, 
    ph.RevisionPercentile DESC NULLS LAST
LIMIT 100;