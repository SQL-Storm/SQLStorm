-- {"query": "36020.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-5-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 1985, "output_tokens": 386} 
SELECT
  u.Id AS UserId,
  u.DisplayName,
  u.Reputation,
  COUNT(DISTINCT p.Id) AS PostsCreated,
  SUM(p.Score) AS TotalPostScore,
  AVG(p.Score) AS AvgPostScore,
  SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS Questions,
  SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS Answers,
  MAX(p.CreationDate) AS LastActive,
  COUNT(DISTINCT bh.Id) AS TotalEdits,
  COUNT(DISTINCT b.Id) AS BadgesEarned,
  SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
  SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
  AVG(DATEDIFF(day, u.CreationDate, COALESCE(v.CreationDate, cast('2024-10-01 12:34:56' as timestamp)))) AS AvgDaysBetweenCreationAndVotes
FROM
  Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  LEFT JOIN PostHistory bh ON bh.PostId = p.Id
    AND bh.PostHistoryTypeId = 5 -- Edit Body (examples of edits)
  LEFT JOIN Badges b ON b.UserId = u.Id
  LEFT JOIN Votes v ON v.PostId = p.Id
WHERE
  u.Id IN (
    SELECT DISTINCT OwnerUserId
    FROM Posts
    WHERE CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 years'
  )
GROUP BY
  u.Id, u.DisplayName, u.Reputation
HAVING
  COUNT(DISTINCT p.Id) > 0
ORDER BY
  TotalPostScore DESC, PostsCreated DESC
LIMIT 100;