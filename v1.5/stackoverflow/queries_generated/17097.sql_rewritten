-- {"query": "17097.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "claude-4.1-opus", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 228830, "output_tokens": 225750} 
WITH user_activity AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as total_posts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as answers,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) as avg_post_score,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ', ') FILTER (WHERE p.Tags IS NOT NULL) as all_tags,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) as reputation_rank,
        LAG(u.Reputation, 1) OVER (ORDER BY u.CreationDate) as prev_user_reputation
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 years'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
post_metrics AS (
    SELECT 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        COALESCE(p.AnswerCount, 0) as answer_count,
        COUNT(c.Id) as comment_count,
        MAX(c.Score) as max_comment_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY c.Score) as median_comment_score,
        FIRST_VALUE(c.Text) OVER (PARTITION BY p.Id ORDER BY c.Score DESC NULLS LAST) as top_comment,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC NULLS LAST) as user_post_rank
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    WHERE p.PostTypeId = 1
        AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
        AND (p.ClosedDate IS NULL OR p.ClosedDate > p.CreationDate + INTERVAL '7 days')
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.OwnerUserId, p.AnswerCount
),
badge_analysis AS (
    SELECT 
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) as gold_badges,
        COUNT(*) FILTER (WHERE b.Class = 2) as silver_badges,
        COUNT(*) FILTER (WHERE b.Class = 3) as bronze_badges,
        ARRAY_AGG(b.Name ORDER BY b.Date DESC) FILTER (WHERE b.TagBased = '1') as tag_badges,
        MAX(b.Date) as latest_badge_date
    FROM Badges b
    GROUP BY b.UserId
),
complex_correlations AS (
    SELECT 
        ua.Id as user_id,
        ua.DisplayName,
        ua.Reputation,
        ua.reputation_rank,
        ua.total_posts,
        ua.questions,
        ua.answers,
        ROUND(ua.avg_post_score::numeric, 2) as avg_score,
        COALESCE(ba.gold_badges, 0) + COALESCE(ba.silver_badges, 0) * 0.5 + COALESCE(ba.bronze_badges, 0) * 0.25 as badge_score,
        COUNT(DISTINCT pm.Id) as high_quality_questions,
        AVG(pm.ViewCount) FILTER (WHERE pm.ViewCount > 0) as avg_view_count,
        CASE 
            WHEN ua.Reputation > 10000 THEN 'Expert'
            WHEN ua.Reputation > 1000 THEN 'Experienced'
            WHEN ua.Reputation > 100 THEN 'Regular'
            ELSE 'Beginner'
        END as user_tier,
        COALESCE(NULLIF(TRIM(ua.all_tags), ''), 'No Tags') as user_tags,
        EXISTS (
            SELECT 1 
            FROM Posts p2 
            WHERE p2.OwnerUserId = ua.Id 
                AND p2.Score > (SELECT AVG(Score) * 2 FROM Posts WHERE PostTypeId = p2.PostTypeId)
        ) as has_exceptional_post,
        (
            SELECT COUNT(DISTINCT ph.PostId)
            FROM PostHistory ph
            WHERE ph.UserId = ua.Id
                AND ph.PostHistoryTypeId IN (4, 5, 6)
                AND ph.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months'
        ) as recent_edits
    FROM user_activity ua
    LEFT JOIN badge_analysis ba ON ua.Id = ba.UserId
    LEFT JOIN post_metrics pm ON ua.Id = pm.OwnerUserId AND pm.user_post_rank <= 5
    WHERE ua.Reputation > 0
        OR ua.total_posts > 0
        OR ba.gold_badges IS NOT NULL
    GROUP BY ua.Id, ua.DisplayName, ua.Reputation, ua.reputation_rank, ua.total_posts, 
             ua.questions, ua.answers, ua.avg_post_score, ua.all_tags, ba.gold_badges, 
             ba.silver_badges, ba.bronze_badges
)
SELECT 
    cc.*,
    COALESCE(
        (
            SELECT STRING_AGG(DISTINCT vt.Name, ', ')
            FROM Votes v
            INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
            WHERE v.UserId = cc.user_id
                AND v.VoteTypeId IN (2, 3, 8)
            GROUP BY v.UserId
        ), 
        'No Votes'
    ) as vote_types_used,
    CASE 
        WHEN cc.badge_score > 100 AND cc.avg_score > 10 THEN 'Elite Contributor'
        WHEN cc.high_quality_questions >= 10 THEN 'Quality Asker'
        WHEN cc.answers > cc.questions * 2 THEN 'Helper'
        WHEN cc.recent_edits > 50 THEN 'Editor'
        WHEN cc.has_exceptional_post THEN 'Star Performer'
        ELSE 'Community Member'
    END as contributor_type,
    DENSE_RANK() OVER (
        PARTITION BY CASE 
            WHEN cc.Reputation > 10000 THEN 'Expert'
            WHEN cc.Reputation > 1000 THEN 'Experienced'
            WHEN cc.Reputation > 100 THEN 'Regular'
            ELSE 'Beginner'
        END
        ORDER BY cc.badge_score DESC NULLS LAST, cc.avg_score DESC NULLS LAST
    ) as tier_badge_rank
FROM complex_correlations cc
WHERE cc.total_posts > 0 
    OR cc.badge_score > 0
ORDER BY 
    cc.reputation_rank ASC NULLS LAST,
    cc.badge_score DESC NULLS LAST,
    cc.high_quality_questions DESC NULLS LAST
LIMIT 1000;