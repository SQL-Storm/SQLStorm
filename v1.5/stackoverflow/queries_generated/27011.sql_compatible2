WITH UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(p.Id) AS TotalPosts,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) AS TotalVotes,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        MAX(p.LastActivityDate) AS LastActivity
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    GROUP BY
        u.Id, u.Reputation, u.DisplayName, u.Views, u.UpVotes, u.DownVotes
), HighActivityUsers AS (
    SELECT
        UserId,
        Reputation,
        DisplayName,
        TotalPosts,
        TotalComments,
        TotalVotes,
        TotalBadges,
        LastActivity
    FROM
        UserActivity
    WHERE
        TotalPosts > 100 AND TotalComments > 50 AND TotalVotes > 200
), PopularTags AS (
    SELECT
        t.TagName,
        t.Count,
        EXTRACT(YEAR FROM p.CreationDate) AS Year,
        COUNT(p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        SUM(p.ViewCount) AS TotalViews
    FROM
        Tags t
    JOIN
        Posts p ON t.Id = (
            SELECT
                CAST(value AS INTEGER)
            FROM
                UNNEST(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><')) AS value
        )
    WHERE
        p.PostTypeId = 1
    GROUP BY
        t.TagName, t.Count, Year
    HAVING
        COUNT(p.Id) > 500 AND SUM(p.Score) > 1000
), TaggedPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        u.DisplayName AS OwnerDisplayName,
        t.TagName,
        t.Count AS TagCount,
        COALESCE(v.Id, 0) AS VoteId,
        vt.Name AS VoteType,
        COALESCE(c.Id, 0) AS CommentId,
        COALESCE(ph.Id, 0) AS PostHistoryId,
        ph.PostHistoryTypeId,
        ph.UserId AS EditorUserId,
        ph.CreationDate AS EditDate,
        ph.Comment AS EditComment,
        ph.Text AS EditText,
        ph.ContentLicense AS EditContentLicense
    FROM
        Posts p
    JOIN
        Users u ON p.OwnerUserId = u.Id
    JOIN
        Tags t ON t.Id = (
            SELECT
                CAST(value AS INTEGER)
            FROM
                UNNEST(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><')) AS value
        )
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN
        VoteTypes vt ON v.VoteTypeId = vt.Id
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    LEFT JOIN
        PostHistory ph ON p.Id = ph.PostId
    WHERE
        p.PostTypeId = 1 AND vt.Name = 'UpMod'
), ComplexPostMetrics AS (
    SELECT
        tp.PostId,
        tp.PostTypeId,
        tp.CreationDate,
        tp.Score,
        tp.ViewCount,
        tp.Title,
        tp.Tags,
        tp.OwnerUserId,
        tp.OwnerDisplayName,
        tp.TagName,
        tp.TagCount,
        tp.VoteId,
        tp.VoteType,
        tp.CommentId,
        tp.PostHistoryId,
        tp.PostHistoryTypeId,
        tp.EditorUserId,
        tp.EditDate,
        tp.EditComment,
        tp.EditText,
        tp.EditContentLicense,
        LAG(tp.Score, 1) OVER (PARTITION BY tp.TagName ORDER BY tp.CreationDate) AS PrevScore,
        LEAD(tp.Score, 1) OVER (PARTITION BY tp.TagName ORDER BY tp.CreationDate) AS NextScore,
        ROW_NUMBER() OVER (PARTITION BY tp.TagName ORDER BY tp.Score DESC) AS TagRank,
        RANK() OVER (PARTITION BY tp.OwnerUserId ORDER BY tp.Score DESC) AS UserRank,
        DENSE_RANK() OVER (PARTITION BY tp.OwnerUserId ORDER BY tp.ViewCount DESC) AS UserViewRank,
        NTILE(10) OVER (PARTITION BY tp.TagName ORDER BY tp.Score DESC) AS TagDecile
    FROM
        TaggedPosts tp
)
SELECT
    cpm.PostId,
    cpm.PostTypeId,
    cpm.CreationDate,
    cpm.Score,
    cpm.ViewCount,
    cpm.Title,
    cpm.Tags,
    cpm.OwnerUserId,
    cpm.OwnerDisplayName,
    cpm.TagName,
    cpm.TagCount,
    cpm.VoteId,
    cpm.VoteType,
    cpm.CommentId,
    cpm.PostHistoryId,
    cpm.PostHistoryTypeId,
    cpm.EditorUserId,
    cpm.EditDate,
    cpm.EditComment,
    cpm.EditText,
    cpm.EditContentLicense,
    cpm.PrevScore,
    cpm.NextScore,
    cpm.TagRank,
    cpm.UserRank,
    cpm.UserViewRank,
    cpm.TagDecile,
    hau.Reputation AS OwnerReputation,
    hau.DisplayName AS HighActivityOwnerDisplayName,
    hau.TotalPosts,
    hau.TotalComments,
    hau.TotalVotes,
    hau.TotalBadges,
    hau.LastActivity,
    pt.TagName AS PopularTag,
    pt.PostCount AS PopularTagPostCount,
    pt.TotalScore AS PopularTagTotalScore,
    pt.TotalViews AS PopularTagTotalViews
FROM
    ComplexPostMetrics cpm
JOIN
    HighActivityUsers hau ON cpm.OwnerUserId = hau.UserId
JOIN
    PopularTags pt ON cpm.TagName = pt.TagName
WHERE
    cpm.Score > 100 AND cpm.ViewCount > 500 AND cpm.TagRank <= 10
ORDER BY
    cpm.Score DESC, cpm.ViewCount DESC;