WITH ActiveUserTags AS (
    SELECT u.Id, 
           u.DisplayName, 
           t.TagName, 
           COUNT(p.Id) AS PostCount,
           AVG(p.Score) AS AvgPostScore
    FROM Users AS u
    JOIN Posts AS p ON u.Id = p.OwnerUserId
    JOIN (
        SELECT DISTINCT unnest(string_to_array(substr(Tags FROM 2 FOR char_length(Tags)-2), '><')) AS TagName
        FROM Posts
    ) AS t ON p.Tags LIKE '%' || t.TagName || '%'
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, t.TagName
    HAVING COUNT(p.Id) > 10
),
TagPerformance AS (
    SELECT TagName, 
           MAX(PostCount) AS MaxUserPostCount,
           AVG(AvgPostScore) AS OverallTagScore,
           COUNT(DISTINCT Id) AS UniqueActiveUsers
    FROM ActiveUserTags
    GROUP BY TagName
)
SELECT 
    tp.TagName, 
    tp.MaxUserPostCount, 
    tp.OverallTagScore, 
    tp.UniqueActiveUsers,
    v.VoteCount,
    p.ViewCount
FROM TagPerformance AS tp
JOIN (
    SELECT Tags, COUNT(v.Id) AS VoteCount
    FROM Posts AS p
    JOIN Votes AS v ON p.Id = v.PostId
    GROUP BY Tags
) AS v ON tp.TagName = v.Tags
JOIN (
    SELECT Tags, SUM(ViewCount) AS ViewCount
    FROM Posts
    GROUP BY Tags
) AS p ON tp.TagName = p.Tags
ORDER BY tp.OverallTagScore DESC, tp.UniqueActiveUsers DESC
LIMIT 50;