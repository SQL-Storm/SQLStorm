WITH UserStats AS (
    SELECT 
        u.Id,
        u.Reputation,
        u.CreationDate AS JoinDate,
        COALESCE(u.WebsiteUrl, 'No Website') AS Website,
        LEFT(u.Location, POSITION(',' IN u.Location) - 1) AS PrimaryLocation,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Votes v WHERE v.UserId = u.Id AND v.VoteTypeId = 2) AS UpvotesGiven,
        RANK() OVER (ORDER BY u.Reputation DESC) AS GlobalRank,
        NTILE(4) OVER (ORDER BY u.Reputation) AS ReputationQuartile
    FROM Users u
    WHERE u.Reputation > 1000
),
PostAnalysis AS (
    SELECT 
        p.OwnerUserId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
        MAX(p.AnswerCount) AS MaxAnswersReceived,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (4,5,6) THEN 1 ELSE 0 END) AS BodyEdits,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2), ', ') AS CommonTags
    FROM Posts p
    LEFT JOIN PostHistory ph 
        ON p.Id = ph.PostId 
        AND ph.PostHistoryTypeId BETWEEN 4 AND 6
    GROUP BY p.OwnerUserId
)
SELECT 
    us.Id,
    us.GlobalRank,
    pa.CommonTags,
    (us.UpvotesGiven * 0.3 + pa.AvgQuestionScore * 0.7) AS EngagementScore,
    FIRST_VALUE(pa.MaxAnswersReceived) OVER (
        PARTITION BY us.ReputationQuartile 
        ORDER BY pa.TotalPosts DESC
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS QuartileMaxAnswers,
    COALESCE((
        SELECT MIN(b.CreateDate) 
        FROM Badges b 
        WHERE b.UserId = us.Id 
        AND b.Name LIKE '%Epic%'
    ), us.JoinDate + INTERVAL '30 days') AS FirstEpicBadgeDate
FROM UserStats us
JOIN PostAnalysis pa ON us.Id = pa.OwnerUserId
WHERE us.PrimaryLocation IN ('New York', 'London', 'Paris')
    AND EXISTS (
        SELECT 1 
        FROM Comments c 
        WHERE c.UserId = us.Id 
        AND LENGTH(c.Text) > 100
    )
    AND pa.TotalPosts > (SELECT AVG(TotalPosts) FROM PostAnalysis)
UNION ALL
SELECT 
    u.Id,
    NULL,
    NULL,
    NULL,
    NULL,
    u.CreationDate
FROM Users u
WHERE u.Id NOT IN (SELECT OwnerUserId FROM Posts)
    AND u.DownVotes > (SELECT PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY DownVotes) FROM Users)
ORDER BY EngagementScore DESC NULLS LAST
LIMIT 500;