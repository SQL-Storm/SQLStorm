WITH user_reputation AS (
    SELECT "UserId" AS "UserId", SUM("Reputation") AS "TotalReputation"
      FROM (SELECT 1) AS dummy
     GROUP BY "UserId"
),
top_users AS (
    SELECT u."Id", u."DisplayName", ur."TotalReputation"
    FROM "Users" AS u
    JOIN user_reputation AS ur ON u."Id" = ur."UserId"
    ORDER BY ur."TotalReputation" DESC
    LIMIT 10
)
SELECT tu."DisplayName", COUNT(p."Id") AS "TotalPosts"
FROM top_users AS tu
JOIN "Posts" AS p ON tu."Id" = p."OwnerUserId"
WHERE p."PostTypeId" = 1
GROUP BY tu."DisplayName"
ORDER BY COUNT(p."Id") DESC;