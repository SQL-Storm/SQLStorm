-- {"query": "28099.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "deepseek-r1", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2074, "output_tokens": 1397} 
WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        AVG(p.Score) OVER (PARTITION BY u.Location) AS AvgLocationScore,
        RANK() OVER (ORDER BY u.Reputation DESC) AS GlobalRank,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PrevPostScore
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId IN (1, 2)
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate > '2010-01-01' OR u.WebsiteUrl IS NOT NULL
    GROUP BY u.Id, u.Location, u.Reputation, p.Score, p.CreationDate
),
PostAnalysis AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        COALESCE(p.AcceptedAnswerId, p.ParentId) AS LinkedPostId,
        CASE 
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Wiki'
            ELSE 'Active'
        END AS PostStatus,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes,
        (SELECT STRING_AGG(DISTINCT SUBSTRING(t.Tags, 2, LENGTH(t.Tags)-2), ', ') 
         FROM Posts t 
         WHERE t.PostTypeId = 5 AND t.Tags LIKE '%<' || SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2) || '>%') AS RelatedWikis
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.AnswerCount > 0
)
SELECT 
    u.UserId,
    u.GlobalRank,
    pa.PostStatus,
    pa.Upvotes * 100.0 / NULLIF(u.UpVotes + u.DownVotes, 0) AS VoteRatio,
    (SELECT COUNT(*) FROM PostHistory ph 
     WHERE ph.PostId = pa.Id AND ph.PostHistoryTypeId = 10 
     AND ph.Comment::INT IN (SELECT Id FROM CloseReasonTypes WHERE Name LIKE '%Duplicate%')) AS DuplicateCloseEvents,
    u.AvgLocationScore,
    u.PrevPostScore,
    (SELECT SUM(BountyAmount) FROM Votes v 
     WHERE v.UserId = u.UserId AND v.VoteTypeId = 8 
     AND v.CreationDate BETWEEN '2015-01-01' AND '2020-01-01') AS TotalBounty,
    pa.RelatedWikis,
    (EXTRACT(YEAR FROM u.Reputation::DATE) - EXTRACT(YEAR FROM (SELECT MIN(CreationDate) FROM Posts WHERE OwnerUserId = u.UserId))) AS AccountAgeYears
FROM UserStats u
JOIN PostAnalysis pa ON u.UserId = pa.OwnerUserId
LEFT JOIN Comments c ON c.PostId = pa.Id AND c.UserId = u.UserId
WHERE u.GoldBadges > (SELECT AVG(GoldBadges) FROM UserStats)
  AND EXISTS (SELECT 1 FROM Posts p2 WHERE p2.OwnerUserId = u.UserId AND p2.ClosedDate IS NOT NULL)
  AND (u.Reputation > 10000 OR pa.Upvotes > 50)
ORDER BY 
    u.GlobalRank,
    VoteRatio DESC NULLS LAST
LIMIT 100;