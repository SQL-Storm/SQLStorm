WITH UserEngagement AS (
    -- CTE 1: Summarize core user engagement metrics from posts and comments
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        COUNT(DISTINCT c.Id) AS TotalCommentsMade,
        SUM(COALESCE(p.Score, 0)) AS TotalPostScoreReceived,
        SUM(COALESCE(p.ViewCount, 0)) AS TotalPostViewsReceived,
        SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL AND p.OwnerUserId = u.Id THEN 1 ELSE 0 END) AS AcceptedAnswersGiven, -- This user's answers were accepted
        SUM(CASE WHEN q.AcceptedAnswerId = p.Id AND q.OwnerUserId = u.Id THEN 1 ELSE 0 END) AS QuestionsWithAcceptedAnswers, -- This user's questions have accepted answers
        AVG(CASE WHEN p.Score > 0 THEN p.Score ELSE 0 END) AS AvgPositivePostScore,
        MAX(p.CreationDate) AS LastPostDate,
        MIN(p.CreationDate) AS FirstPostDate
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Posts q ON p.Id = q.AcceptedAnswerId AND p.PostTypeId = 2 -- For answers that were accepted by others
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views
),
TagInfluence AS (
    -- CTE 2: Identify top influential tags for users based on high-scoring questions and answers
    SELECT
        ue.UserId,
        t.TagName,
        SUM(p.Score) AS TagScoreContribution,
        COUNT(p.Id) AS TaggedPostCount,
        ROW_NUMBER() OVER(PARTITION BY ue.UserId ORDER BY SUM(p.Score) DESC, COUNT(p.Id) DESC) AS TagRank
    FROM UserEngagement ue
    JOIN Posts p ON ue.UserId = p.OwnerUserId
    CROSS JOIN LATERAL UNNEST(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) AS t(TagName)
    WHERE p.PostTypeId IN (1, 2) AND p.Score > 5 -- Focus on questions and answers with positive scores
    GROUP BY ue.UserId, t.TagName
),
PostHistoryTimeline AS (
    -- CTE 3: Analyze sequential post history events for users, including edits and moderation actions
    SELECT
        ph.UserId,
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        LAG(ph.CreationDate, 1, ph.CreationDate) OVER (PARTITION BY ph.UserId, ph.PostId ORDER BY ph.CreationDate) AS PreviousActionDate,
        LEAD(ph.CreationDate, 1, ph.CreationDate) OVER (PARTITION BY ph.UserId, ph.PostId ORDER BY ph.CreationDate) AS NextActionDate,
        ph.Text AS HistoryText,
        ph.Comment AS HistoryComment,
        p.OwnerUserId AS PostOwnerId
    FROM PostHistory ph
    JOIN Posts p ON ph.PostId = p.Id
    WHERE ph.UserId IS NOT NULL
),
UserModerationActivity AS (
    -- CTE 4: Summarize user participation in moderation activities (close, reopen, delete, undelete votes)
    SELECT
        pht.UserId,
        COUNT(DISTINCT pht.PostId) AS DistinctPostsModerated,
        SUM(CASE WHEN pht.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseVotesInitiated, -- Post Closed
        SUM(CASE WHEN pht.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS ReopenVotesInitiated, -- Post Reopened
        SUM(CASE WHEN pht.PostHistoryTypeId = 12 THEN 1 ELSE 0 END) AS DeleteVotesInitiated, -- Post Deleted
        SUM(CASE WHEN pht.PostHistoryTypeId = 13 THEN 1 ELSE 0 END) AS UndeleteVotesInitiated, -- Post Undeleted
        SUM(CASE WHEN pht.PostHistoryTypeId IN (10, 11, 12, 13) AND pht.UserId = pht.PostOwnerId THEN 1 ELSE 0 END) AS SelfModerationActions
    FROM PostHistoryTimeline pht
    WHERE pht.PostHistoryTypeId IN (10, 11, 12, 13)
    GROUP BY pht.UserId
),
UserVoteDistribution AS (
    -- CTE 5: Analyze the distribution of vote types given by users
    SELECT
        v.UserId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS FavoritesGiven, -- Bookmarks
        SUM(CASE WHEN v.VoteTypeId = 12 THEN 1 ELSE 0 END) AS SpamVotesGiven,
        COUNT(v.Id) AS TotalVotesCast,
        AVG(EXTRACT(EPOCH FROM (v.CreationDate - (SELECT MIN(p.CreationDate) FROM Posts p WHERE p.Id = v.PostId))) / (3600 * 24)) AS AvgDaysToVoteFromPostCreation
    FROM Votes v
    WHERE v.UserId IS NOT NULL
    GROUP BY v.UserId
)
SELECT
    ue.DisplayName,
    ue.Reputation,
    ue.Views AS UserProfileViews,
    ue.TotalPosts,
    ue.TotalQuestions,
    ue.TotalAnswers,
    ue.TotalCommentsMade,
    ue.TotalPostScoreReceived,
    ue.TotalPostViewsReceived,
    ue.AcceptedAnswersGiven,
    ue.QuestionsWithAcceptedAnswers,
    COALESCE(ue.AvgPositivePostScore, 0.0) AS AveragePositivePostScore,
    uvd.UpvotesGiven,
    uvd.DownvotesGiven,
    uvd.SpamVotesGiven,
    COALESCE(uvd.TotalVotesCast, 0) AS TotalVotesCast,
    COALESCE(uvd.AvgDaysToVoteFromPostCreation, 0.0) AS AvgDaysToVoteFromPostCreation,
    COALESCE(ti.TagName, 'N/A') AS TopInfluentialTag,
    COALESCE(ti.TagScoreContribution, 0) AS TopTagScoreContribution,
    COALESCE(ti.TaggedPostCount, 0) AS TopTagPostCount,
    um.CloseVotesInitiated,
    um.ReopenVotesInitiated,
    um.SelfModerationActions,
    -- Correlated subquery to find user's latest self-edited post title
    (
        SELECT
            p.Title
        FROM Posts p
        JOIN PostHistoryTimeline pht_inner ON p.Id = pht_inner.PostId
        WHERE pht_inner.UserId = ue.UserId
          AND pht_inner.PostHistoryTypeId IN (4, 5, 6) -- Edit Title, Body, Tags
          AND pht_inner.UserId = pht_inner.PostOwnerId -- Self-edit
        ORDER BY pht_inner.CreationDate DESC
        LIMIT 1
    ) AS LatestSelfEditedPostTitle,
    -- Window function: Calculate average time between a user's consecutive edits on a single post
    (
        SELECT
            AVG(EXTRACT(EPOCH FROM (pht_sub.NextActionDate - pht_sub.CreationDate))) / 3600 -- Average hours between actions
        FROM PostHistoryTimeline pht_sub
        WHERE pht_sub.UserId = ue.UserId
          AND pht_sub.PostHistoryTypeId IN (4, 5, 6)
          AND pht_sub.PreviousActionDate != pht_sub.CreationDate
    ) AS AvgHoursBetweenSelfEdits,
    -- Complex calculated field: "Impact Score"
    -- A weighted sum of posts, comments, score, and badges, adjusted by moderation activity
    CAST(
        (ue.TotalPosts * 0.5 + ue.TotalCommentsMade * 0.3 + ue.TotalPostScoreReceived * 0.01 + COALESCE(b.TotalBadges, 0) * 0.2)
        / NULLIF(1 + um.CloseVotesInitiated * 0.1 + um.DeleteVotesInitiated * 0.2, 0) -- Penalize negative moderation actions slightly
    AS NUMERIC) AS ImpactScore,
    -- Check if user is a "veteran moderator" - high reputation, has initiated close/reopen votes, and has many posts
    (u.Reputation > 20000 AND um.CloseVotesInitiated > 50 AND um.ReopenVotesInitiated > 10 AND ue.TotalPosts > 200) AS IsVeteranModerator,
    -- Example of set operation (EXCEPT) within a boolean expression:
    -- Has the user made comments, but never cast a downvote?
    CASE WHEN EXISTS (
        SELECT 1 FROM Comments c_sub WHERE c_sub.UserId = ue.UserId
        EXCEPT
        SELECT 1 FROM Votes v_sub WHERE v_sub.UserId = ue.UserId AND v_sub.VoteTypeId = 3
    ) THEN TRUE ELSE FALSE END AS CommentsButNoDownvotes,
    -- Complex string and NULL handling: Check if AboutMe contains certain keywords or if Location implies developer and has high reputation
    (
        (u.AboutMe IS NOT NULL AND (LOWER(u.AboutMe) LIKE '%developer%' OR LOWER(u.AboutMe) LIKE '%engineer%' OR LOWER(u.AboutMe) LIKE '%programmer%'))
        OR
        (u.Location IS NOT NULL AND (LOWER(u.Location) LIKE '%dev%' OR LOWER(u.Location) LIKE '%software%') AND u.Reputation > 5000)
    ) AS HasDeveloperPersona,
    -- Correlated subquery for total votes on their posts by users from specific locations
    (
        SELECT
            SUM(v_loc.Score)
        FROM Posts p_loc
        JOIN Votes v_loc ON p_loc.Id = v_loc.PostId
        JOIN Users u_loc ON v_loc.UserId = u_loc.Id
        WHERE p_loc.OwnerUserId = ue.UserId
          AND u_loc.Location IS NOT NULL
          AND (LOWER(u_loc.Location) LIKE '%usa%' OR LOWER(u_loc.Location) LIKE '%india%')
    ) AS VotesFromSpecificLocations,
    u.CreationDate,
    u.LastAccessDate
FROM Users u
JOIN UserEngagement ue ON u.Id = ue.UserId
LEFT JOIN UserVoteDistribution uvd ON u.Id = uvd.UserId
LEFT JOIN UserModerationActivity um ON u.Id = um.UserId
LEFT JOIN TagInfluence ti ON u.Id = ti.UserId AND ti.TagRank = 1
LEFT JOIN ( -- Subquery for total badges, inline for less CTEs if only total is needed
    SELECT UserId, COUNT(Id) AS TotalBadges
    FROM Badges
    GROUP BY UserId
) AS b ON u.Id = b.UserId
WHERE
    ue.Reputation > 5000 -- Filter for more established users
    AND ue.TotalPosts >= 20
    AND u.LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months' -- Recently active
    AND (LOWER(u.DisplayName) NOT LIKE '%deleted user%' OR ue.DisplayName IS NULL) -- Exclude deleted/placeholder users
    AND NOT EXISTS ( -- Exclude users who have never posted an answer but have a high number of questions
        SELECT 1 FROM Posts p_na WHERE p_na.OwnerUserId = u.Id AND p_na.PostTypeId = 1
        GROUP BY p_na.OwnerUserId HAVING COUNT(DISTINCT p_na.Id) > 10 AND SUM(CASE WHEN p_na.PostTypeId = 2 THEN 1 ELSE 0 END) = 0
    )
ORDER BY ImpactScore DESC, ue.Reputation DESC
LIMIT 200;