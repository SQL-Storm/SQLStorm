WITH RECURSIVE RecursiveUserCount AS (
    SELECT UserId, COUNT(*) AS TotalVotes
    FROM Votes
    WHERE CreationDate >= DATE '2022-01-01'
    GROUP BY UserId

    UNION ALL

    SELECT V.UserId,
           SUM(R.TotalVotes) + 1 AS TotalVotes
    FROM Votes V
    JOIN RecursiveUserCount R ON V.UserId = R.UserId
    WHERE V.CreationDate >= DATE '2022-01-01'
    GROUP BY V.UserId
)
SELECT UserId, TotalVotes
FROM RecursiveUserCount
WHERE TotalVotes > 100
ORDER BY TotalVotes DESC;