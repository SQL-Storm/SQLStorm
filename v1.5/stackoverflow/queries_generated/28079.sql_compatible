WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id
),
PostMetrics AS (
    SELECT 
        p.OwnerUserId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) AS TotalVotes,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS Upvotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS Downvotes
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
    GROUP BY p.OwnerUserId
),
ClosedPosts AS (
    SELECT 
        ph.PostId,
        FIRST_VALUE(ph.Comment) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate) AS FirstCloseReason,
        CAST(REGEXP_SUBSTR(ph.Comment, '[0-9]+') AS SMALLINT) AS CloseReasonId
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10
)
SELECT 
    u.Id,
    u.DisplayName,
    us.Reputation,
    COALESCE(pm.TotalPosts, 0) AS TotalPosts,
    (us.UpVotes + us.DownVotes) * 1.0 / NULLIF(us.Reputation, 0) AS VoteToRepRatio,
    RANK() OVER (ORDER BY us.Reputation DESC) AS GlobalRank,
    DENSE_RANK() OVER (PARTITION BY u.Location ORDER BY us.Reputation DESC) AS LocalRank,
    (SELECT Name FROM Badges WHERE UserId = u.Id ORDER BY Date DESC LIMIT 1) AS LatestBadge,
    STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 1 FOR 20), '; ') AS TagSnippets,
    ARRAY_AGG(DISTINCT t.TagName ORDER BY t.Count DESC) AS TopTags,
    COALESCE(cp.CloseReasonId, -1) AS CloseReason,
    CASE 
        WHEN EXISTS (SELECT 1 FROM Posts p2 WHERE p2.OwnerUserId = u.Id AND p2.PostTypeId = 2 AND p2.Score > 10)
        THEN (SELECT MAX(p2.Score) FROM Posts p2 WHERE p2.OwnerUserId = u.Id AND p2.PostTypeId = 2)
        ELSE NULL 
    END AS MaxAnswerScore,
    (SELECT COUNT(*) FROM PostLinks pl 
     WHERE pl.LinkTypeId = 3 AND pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id)) AS DupeLinksCreated
FROM Users u
LEFT JOIN UserStats us ON u.Id = us.UserId
LEFT JOIN PostMetrics pm ON u.Id = pm.OwnerUserId
LEFT JOIN ClosedPosts cp ON cp.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id)
LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
LEFT JOIN Tags t ON t.TagName = ANY(STRING_TO_ARRAY(REPLACE(REPLACE(p.Tags, '><', ','), '<>', ''), ','))
WHERE u.Reputation BETWEEN 1000 AND 100000
  AND u.WebsiteUrl IS NOT NULL
  AND u.Location ~* '^(New York|London|Paris)'
  AND (us.GoldBadges > 0 OR us.SilverBadges > 5)
GROUP BY u.Id, u.DisplayName, us.Reputation, pm.TotalPosts, us.UpVotes, us.DownVotes, cp.CloseReasonId
HAVING COUNT(DISTINCT p.Id) > 10 OR COUNT(DISTINCT cp.PostId) > 2
ORDER BY us.Reputation DESC
LIMIT 100;