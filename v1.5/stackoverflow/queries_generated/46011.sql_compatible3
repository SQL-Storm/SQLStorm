WITH RECURSIVE UserEngagementMetrics AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate as UserCreationDate,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as AnswerCount,
        COALESCE(AVG(p.Score), 0) as AvgPostScore,
        COALESCE(SUM(p.ViewCount), 0) as TotalViews
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '3 years'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
TagPopularity AS (
    SELECT 
        t.TagName,
        t.Count as TagUseCount,
        COUNT(DISTINCT p.OwnerUserId) as UniqueContributors,
        AVG(p.Score) as AvgTagScore,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) as MedianScore,
        COUNT(DISTINCT CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN p.Id END) as QuestionsWithAcceptedAnswer
    FROM Tags t
    INNER JOIN Posts p ON p.Tags LIKE '%' || '<' || t.TagName || '>' || '%' AND p.PostTypeId = 1
    WHERE t.Count > 100
    GROUP BY t.TagName, t.Count
),
AnswerQualityScore AS (
    SELECT 
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerDate,
        q.CreationDate as QuestionDate,
        EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate))/3600.0 as HoursToAnswer,
        CASE WHEN a.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END as IsAccepted,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT v.Id) as VoteCount
    FROM Posts a
    INNER JOIN Posts q ON a.ParentId = q.Id
    LEFT JOIN Comments c ON a.Id = c.PostId
    LEFT JOIN Votes v ON a.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    WHERE a.PostTypeId = 2 
        AND q.PostTypeId = 1
        AND a.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '2 years'
    GROUP BY a.Id, a.ParentId, a.OwnerUserId, a.Score, a.CreationDate, q.CreationDate, q.AcceptedAnswerId
),
BadgeDistribution AS (
    SELECT 
        b.UserId,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) as GoldBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id END) as SilverBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id END) as BronzeBadges,
        COUNT(DISTINCT CASE WHEN b.TagBased = 1 THEN b.Id END) as TagBasedBadges,
        MIN(b.Date) as FirstBadgeDate,
        MAX(b.Date) as LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
TopContributorsByTag AS (
    SELECT 
        tp.TagName,
        uem.UserId,
        uem.DisplayName,
        COUNT(DISTINCT p.Id) as PostsInTag,
        SUM(p.Score) as TotalScoreInTag,
        ROW_NUMBER() OVER (PARTITION BY tp.TagName ORDER BY COUNT(DISTINCT p.Id) DESC, SUM(p.Score) DESC) as RankInTag
    FROM TagPopularity tp
    INNER JOIN Posts p ON p.Tags LIKE '%' || '<' || tp.TagName || '>' || '%'
    INNER JOIN UserEngagementMetrics uem ON p.OwnerUserId = uem.UserId
    WHERE p.PostTypeId = 1
    GROUP BY tp.TagName, uem.UserId, uem.DisplayName
),
InteractionNetwork AS (
    SELECT 
        q.OwnerUserId as QuestionAuthorId,
        a.OwnerUserId as AnswerAuthorId,
        COUNT(DISTINCT a.Id) as AnswerInteractions,
        AVG(a.Score) as AvgAnswerScore,
        COUNT(DISTINCT CASE WHEN a.Id = q.AcceptedAnswerId THEN a.Id END) as AcceptedAnswers
    FROM Posts q
    INNER JOIN Posts a ON q.Id = a.ParentId
    WHERE q.PostTypeId = 1 
        AND a.PostTypeId = 2
        AND q.OwnerUserId IS NOT NULL 
        AND a.OwnerUserId IS NOT NULL
        AND q.OwnerUserId != a.OwnerUserId
    GROUP BY q.OwnerUserId, a.OwnerUserId
    HAVING COUNT(DISTINCT a.Id) >= 3
)
SELECT 
    uem.DisplayName,
    uem.Reputation,
    uem.QuestionCount,
    uem.AnswerCount,
    ROUND(CAST(uem.AvgPostScore AS numeric), 2) as AvgScore,
    bd.GoldBadges,
    bd.SilverBadges,
    bd.BronzeBadges,
    COALESCE(aqs_stats.AvgAnswerQuality, 0) as AvgAnswerQualityScore,
    COALESCE(aqs_stats.AcceptanceRate, 0) as AnswerAcceptanceRate,
    COALESCE(tc.TagExpertiseCount, 0) as TopTagCount,
    COALESCE(net_out.OutgoingInteractions, 0) as TimesAnsweredOthers,
    COALESCE(net_in.IncomingInteractions, 0) as TimesAnsweredByOthers,
    EXTRACT(EPOCH FROM (CAST('2024-10-01' AS DATE) - uem.UserCreationDate))/86400.0 as AccountAgeInDays,
    ROUND((uem.TotalPosts::numeric / NULLIF(EXTRACT(EPOCH FROM (CAST('2024-10-01' AS DATE) - uem.UserCreationDate))/86400.0, 0)), 4) as PostsPerDay
FROM UserEngagementMetrics uem
LEFT JOIN BadgeDistribution bd ON uem.UserId = bd.UserId
LEFT JOIN (
    SELECT 
        OwnerUserId,
        AVG(AnswerScore + (IsAccepted * 15) - (HoursToAnswer / 24.0)) as AvgAnswerQuality,
        AVG(IsAccepted::numeric) * 100 as AcceptanceRate
    FROM AnswerQualityScore
    GROUP BY OwnerUserId
) aqs_stats ON uem.UserId = aqs_stats.OwnerUserId
LEFT JOIN (
    SELECT UserId, COUNT(DISTINCT TagName) as TagExpertiseCount
    FROM TopContributorsByTag
    WHERE RankInTag <= 10
    GROUP BY UserId
) tc ON uem.UserId = tc.UserId
LEFT JOIN (
    SELECT QuestionAuthorId, SUM(AnswerInteractions) as OutgoingInteractions
    FROM InteractionNetwork
    GROUP BY QuestionAuthorId
) net_out ON uem.UserId = net_out.QuestionAuthorId
LEFT JOIN (
    SELECT AnswerAuthorId, SUM(AnswerInteractions) as IncomingInteractions
    FROM InteractionNetwork
    GROUP BY AnswerAuthorId
) net_in ON uem.UserId = net_in.AnswerAuthorId
WHERE uem.TotalPosts >= 10
    AND uem.Reputation >= 1000
ORDER BY 
    (uem.Reputation * 0.3 + 
     COALESCE(aqs_stats.AvgAnswerQuality, 0) * 0.25 + 
     (bd.GoldBadges * 10 + bd.SilverBadges * 5 + bd.BronzeBadges) * 0.2 +
     COALESCE(net_in.IncomingInteractions, 0) * 0.15 +
     COALESCE(tc.TagExpertiseCount, 0) * 0.1) DESC
LIMIT 100;