WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        CASE 
            WHEN u.Reputation >= 100000 THEN 'Master'
            WHEN u.Reputation >= 50000 THEN 'Expert'
            WHEN u.Reputation >= 10000 THEN 'Professional'
            ELSE 'Beginner'
        END AS ReputationLevel
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.AnswerCount,
        p.CommentCount,
        p.OwnerUserId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END AS PostType,
        CASE 
            WHEN p.Score > 100 THEN 'Highly Rated'
            WHEN p.Score > 50 THEN 'Moderately Rated'
            WHEN p.Score > 0 THEN 'Slightly Rated'
            ELSE 'Not Rated'
        END AS RatingLevel,
        CAST(EXTRACT(DAY FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) AS INTEGER) AS DaysOld,
        COALESCE(p.Tags, '') AS Tags,
        COALESCE(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags) - 2), '') AS TagList,
        CAST(STRING_TO_ARRAY(COALESCE(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags) - 2), ''), '><') AS VARCHAR[]) AS TagArray
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count AS TagCount,
        t.ExcerptPostId,
        CONCAT('Tag: ', t.TagName, ' (', t.Count, ' posts)') AS TagDescription,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 100 THEN 'Moderate'
            WHEN t.Count > 10 THEN 'Niche'
            ELSE 'Rare'
        END AS PopularityLevel
    FROM Tags t
    WHERE t.TagName IS NOT NULL AND t.TagName <> ''
),
ComplexPostMetrics AS (
    SELECT 
        pa.PostId,
        pa.Title,
        pa.OwnerUserId,
        pa.Score,
        pa.ViewCount,
        pa.CommentCount,
        pa.AnswerCount,
        pa.PostType,
        pa.RatingLevel,
        pa.DaysOld,
        pa.TagList,
        pa.TagArray,
        (pa.Score * 1.0 / NULLIF(pa.ViewCount, 0)) AS ScoreToViewRatio,
        CASE 
            WHEN pa.AnswerCount IS NOT NULL AND pa.AnswerCount > 0 THEN 
                (pa.CommentCount * 1.0 / NULLIF(pa.AnswerCount, 0))
            ELSE 0
        END AS CommentsPerAnswer,
        (pa.Score + pa.ViewCount + pa.CommentCount + COALESCE(pa.AnswerCount, 0)) AS TotalEngagement,
        ROW_NUMBER() OVER (PARTITION BY pa.OwnerUserId ORDER BY pa.Score DESC) AS UserPostRank,
        RANK() OVER (ORDER BY pa.Score DESC) AS OverallScoreRank,
        DENSE_RANK() OVER (ORDER BY pa.ViewCount DESC) AS ViewRank,
        PERCENT_RANK() OVER (ORDER BY pa.Score) AS ScorePercentile,
        NTH_VALUE(pa.Title, 1) OVER (PARTITION BY pa.OwnerUserId ORDER BY pa.Score DESC) AS HighestRatedPost,
        LAG(pa.Score, 1) OVER (ORDER BY pa.Score DESC) AS PreviousScore,
        LEAD(pa.Score, 1) OVER (ORDER BY pa.Score DESC) AS NextScore,
        AVG(pa.Score) OVER (PARTITION BY pa.OwnerUserId) AS UserAverageScore,
        MAX(pa.Score) OVER (PARTITION BY pa.OwnerUserId) AS UserMaxScore,
        MIN(pa.Score) OVER (PARTITION BY pa.OwnerUserId) AS UserMinScore,
        COUNT(*) OVER (PARTITION BY pa.OwnerUserId) AS UserPostCount,
        CASE 
            WHEN pa.Score > 100 THEN 'Elite'
            WHEN pa.Score > 50 THEN 'Above Average'
            WHEN pa.Score > 0 THEN 'Below Average'
            ELSE 'Low'
        END AS PerformanceLevel
    FROM PostAnalysis pa
),
CombinedAnalysis AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Reputation,
        us.PostCount,
        us.CommentCount,
        us.BadgeCount,
        us.ReputationLevel,
        us.ReputationRank,
        cpm.PostId,
        cpm.Title,
        cpm.OwnerUserId,
        cpm.Score,
        cpm.ViewCount,
        cpm.CommentCount AS CommentCount2,
        cpm.AnswerCount,
        cpm.PostType,
        cpm.RatingLevel,
        cpm.DaysOld,
        cpm.TagList,
        cpm.TagArray,
        cpm.ScoreToViewRatio,
        cpm.CommentsPerAnswer,
        cpm.TotalEngagement,
        cpm.UserPostRank,
        cpm.OverallScoreRank,
        cpm.ViewRank,
        cpm.ScorePercentile,
        cpm.HighestRatedPost,
        cpm.PreviousScore,
        cpm.NextScore,
        cpm.UserAverageScore,
        cpm.UserMaxScore,
        cpm.UserMinScore,
        cpm.UserPostCount,
        cpm.PerformanceLevel,
        CASE 
            WHEN cpm.TotalEngagement > 500 THEN 'High Engagement'
            WHEN cpm.TotalEngagement > 100 THEN 'Medium Engagement'
            WHEN cpm.TotalEngagement > 0 THEN 'Low Engagement'
            ELSE 'No Engagement'
        END AS EngagementLevel,
        CASE 
            WHEN cpm.DaysOld > 365 THEN 'Established'
            WHEN cpm.DaysOld > 180 THEN 'Active'
            WHEN cpm.DaysOld > 30 THEN 'Recent'
            ELSE 'New'
        END AS ActivityLevel,
        CASE 
            WHEN LENGTH(cpm.TagList) > 0 THEN 
                (SELECT COUNT(*) FROM UNNEST(cpm.TagArray) AS tag)
            ELSE 0
        END AS TagCount,
        (SELECT STRING_AGG(tag, ', ') FROM UNNEST(cpm.TagArray) AS tag) AS AllTags,
        (SELECT STRING_AGG(tag, ', ') FROM UNNEST(cpm.TagArray) AS tag WHERE tag LIKE '%sql%') AS SqlTags,
        (SELECT COUNT(*) FROM UNNEST(cpm.TagArray) AS tag WHERE tag LIKE '%sql%') AS SqlTagCount
    FROM UserStats us
    INNER JOIN ComplexPostMetrics cpm ON us.UserId = cpm.OwnerUserId
    WHERE us.PostCount > 0 AND us.Reputation > 100
),
FinalAggregation AS (
    SELECT 
        fa.UserId,
        fa.DisplayName,
        fa.Reputation,
        fa.PostCount,
        fa.CommentCount,
        fa.BadgeCount,
        fa.ReputationLevel,
        fa.ReputationRank,
        fa.PostId,
        fa.Title,
        fa.Score,
        fa.ViewCount,
        fa.CommentCount AS CommentCount2,
        fa.AnswerCount,
        fa.PostType,
        fa.RatingLevel,
        fa.DaysOld,
        fa.TagList,
        fa.TagCount,
        fa.AllTags,
        fa.SqlTags,
        fa.SqlTagCount,
        fa.ScoreToViewRatio,
        fa.CommentsPerAnswer,
        fa.TotalEngagement,
        fa.UserPostRank,
        fa.OverallScoreRank,
        fa.ViewRank,
        fa.ScorePercentile,
        fa.HighestRatedPost,
        fa.PreviousScore,
        fa.NextScore,
        fa.UserAverageScore,
        fa.UserMaxScore,
        fa.UserMinScore,
        fa.UserPostCount,
        fa.PerformanceLevel,
        fa.EngagementLevel,
        fa.ActivityLevel,
        fa.SqlExpertiseLevel,
        fa.ImpactLevel,
        fa.RankByScoreAndView,
        fa.RankByCommentsPerAnswer,
        fa.PerformanceQuartile,
        fa.EngagementRank,
        fa.OverallAverageScore,
        fa.ScoreStandardDeviation,
        fa.MaxDaysOld,
        CASE 
            WHEN fa.SqlTagCount > 0 THEN 
                CASE 
                    WHEN fa.SqlTagCount >= 3 THEN 'SQL Specialist'
                    WHEN fa.SqlTagCount >= 2 THEN 'SQL Enthusiast'
                    ELSE 'SQL Beginner'
                END
            ELSE 'No SQL Tags'
        END AS SqlExpertiseLevel,
        CASE 
            WHEN fa.Score > 100 AND fa.ViewCount > 1000 THEN 'High Impact'
            WHEN fa.Score > 50 AND fa.ViewCount > 500 THEN 'Medium Impact'
            WHEN fa.Score > 0 AND fa.ViewCount > 100 THEN 'Low Impact'
            ELSE 'No Impact'
        END AS ImpactLevel,
        ROW_NUMBER() OVER (ORDER BY fa.Score DESC, fa.ViewCount DESC) AS RankByScoreAndView,
        DENSE_RANK() OVER (ORDER BY fa.CommentsPerAnswer DESC) AS RankByCommentsPerAnswer,
        NTILE(4) OVER (ORDER BY fa.Score) AS PerformanceQuartile,
        RANK() OVER (ORDER BY fa.TotalEngagement DESC) AS EngagementRank,
        AVG(fa.Score) OVER () AS OverallAverageScore,
        STDDEV(fa.Score) OVER () AS ScoreStandardDeviation,
        MAX(fa.DaysOld) OVER () AS MaxDaysOld
    FROM CombinedAnalysis fa
),
FinalOutput AS (
    SELECT 
        fa.UserId,
        fa.DisplayName,
        fa.Reputation,
        fa.PostCount,
        fa.CommentCount,
        fa.BadgeCount,
        fa.ReputationLevel,
        fa.ReputationRank,
        fa.PostId,
        fa.Title,
        fa.Score,
        fa.ViewCount,
        fa.CommentCount AS CommentCountRef,
        fa.AnswerCount,
        fa.PostType,
        fa.RatingLevel,
        fa.DaysOld,
        fa.TagList,
        fa.TagCount,
        fa.AllTags,
        fa.SqlTags,
        fa.SqlTagCount,
        fa.ScoreToViewRatio,
        fa.CommentsPerAnswer,
        fa.TotalEngagement,
        fa.UserPostRank,
        fa.OverallScoreRank,
        fa.ViewRank,
        fa.ScorePercentile,
        fa.HighestRatedPost,
        fa.PreviousScore,
        fa.NextScore,
        fa.UserAverageScore,
        fa.UserMaxScore,
        fa.UserMinScore,
        fa.UserPostCount,
        fa.PerformanceLevel,
        fa.EngagementLevel,
        fa.ActivityLevel,
        fa.SqlExpertiseLevel,
        fa.ImpactLevel,
        fa.RankByScoreAndView,
        fa.RankByCommentsPerAnswer,
        fa.PerformanceQuartile,
        fa.EngagementRank,
        fa.OverallAverageScore,
        fa.ScoreStandardDeviation,
        fa.MaxDaysOld,
        CASE 
            WHEN fa.Reputation > 50000 AND fa.PostCount > 50 THEN 'Veteran Contributor'
            WHEN fa.Reputation > 10000 AND fa.PostCount > 20 THEN 'Experienced Contributor'
            WHEN fa.Reputation > 1000 AND fa.PostCount > 5 THEN 'Active Contributor'
            ELSE 'New Contributor'
        END AS ContributorStatus,
        CASE 
            WHEN fa.DaysOld > 365 AND fa.PostCount > 100 THEN 'Long Term Active'
            WHEN fa.DaysOld > 180 AND fa.PostCount > 50 THEN 'Moderately Active'
            WHEN fa.DaysOld > 30 AND fa.PostCount > 20 THEN 'Recently Active'
            ELSE 'Newly Active'
        END AS ActivityStatus,
        CASE 
            WHEN fa.TagCount > 10 AND fa.SqlTagCount > 3 THEN 'Well Tagged Expert'
            WHEN fa.TagCount > 5 AND fa.SqlTagCount > 2 THEN 'Good Tagging'
            WHEN fa.TagCount > 0 THEN 'Basic Tagging'
            ELSE 'No Tagging'
        END AS TaggingQuality,
        ROUND((fa.Score * 100.0 / NULLIF(fa.OverallAverageScore, 0)), 2) AS ScoreVsAveragePercent,
        CASE 
            WHEN fa.Score > fa.UserAverageScore THEN 'Above Average'
            WHEN fa.Score < fa.UserAverageScore THEN 'Below Average'
            ELSE 'Average'
        END AS ScoreVsUserAverage,
        CASE 
            WHEN fa.TotalEngagement > 1000 THEN 'Viral Content'
            WHEN fa.TotalEngagement > 500 THEN 'Popular Content'
            WHEN fa.TotalEngagement > 100 THEN 'Noticeable Content'
            ELSE 'Regular Content'
        END AS ContentPopularity,
        CAST(COALESCE(STRING_AGG(DISTINCT fa.SqlTags, ' | '), '') AS VARCHAR) AS UniqueSqlTags,
        COUNT(*) OVER () AS TotalRecords,
        MAX(fa.UserId) OVER () AS MaxUserId,
        MIN(fa.UserId) OVER () AS MinUserId
    FROM FinalAggregation fa
)
