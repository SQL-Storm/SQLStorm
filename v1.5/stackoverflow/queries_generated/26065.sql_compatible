WITH ranked_posts AS (
  SELECT 
    p.Id,
    p.Score,
    p.ViewCount,
    p.Title,
    p.Tags,
    ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) AS row_num,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) OVER (PARTITION BY p.Id) AS upvotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) OVER (PARTITION BY p.Id) AS downvotes
  FROM 
    Posts p
  LEFT JOIN 
    Votes v ON p.Id = v.PostId
),
top_posts AS (
  SELECT 
    Id,
    Score,
    ViewCount,
    Title,
    Tags,
    upvotes,
    downvotes
  FROM 
    ranked_posts
  WHERE 
    row_num <= 10
),
user_badges AS (
  SELECT 
    u.Id,
    COUNT(b.Id) AS badge_count
  FROM 
    Users u
  LEFT JOIN 
    Badges b ON u.Id = b.UserId
  GROUP BY 
    u.Id
)
SELECT 
  p.Id,
  p.Score,
  p.ViewCount,
  p.Title,
  p.Tags,
  u.DisplayName,
  u.Reputation,
  ub.badge_count,
  ph.Comment,
  ph.CreationDate,
  ph.UserId,
  COALESCE(ph.Text, '') AS post_history_text
FROM 
  top_posts p
JOIN 
  Users u ON p.OwnerUserId = u.Id
JOIN 
  user_badges ub ON u.Id = ub.Id
LEFT JOIN 
  PostHistory ph ON p.Id = ph.PostId
WHERE 
  ph.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15, 19, 20, 35)
  AND p.Score > 0
  AND p.ViewCount > 100
  AND u.Reputation > 1000
  AND ub.badge_count > 5
ORDER BY 
  p.Score DESC,
  p.ViewCount DESC;