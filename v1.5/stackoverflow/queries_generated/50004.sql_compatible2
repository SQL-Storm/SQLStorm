WITH QuestionStats AS (
    SELECT
        p.Id AS QuestionId,
        p.OwnerUserId,
        p.ViewCount,
        p.AnswerCount,
        p.Score,
        p.CreationDate,
        tag.TagName
    FROM
        Posts p,
        LATERAL unnest(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><')) AS tag(TagName)
    WHERE
        p.PostTypeId = 1
        AND p.ClosedDate IS NULL
        AND p.DeletionDate IS NULL
        AND p.AnswerCount > 2
),
UserAnswerStats AS (
    SELECT
        a.OwnerUserId,
        qs.TagName,
        COUNT(a.Id) AS TotalAnswersInTag,
        SUM(a.Score) AS TotalAnswerScoreInTag,
        AVG(a.Score) AS AvgAnswerScoreInTag,
        SUM(CASE WHEN a.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) AS AcceptedAnswersInTag,
        AVG(EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate))) AS AvgTimeToAnswerSeconds
    FROM
        Posts AS a
    JOIN Posts AS q ON a.ParentId = q.Id
    JOIN QuestionStats AS qs ON q.Id = qs.QuestionId
    WHERE
        a.PostTypeId = 2
        AND a.OwnerUserId IS NOT NULL
        AND a.DeletionDate IS NULL
    GROUP BY
        a.OwnerUserId,
        qs.TagName
),
UserTagBadges AS (
    SELECT
        UserId,
        Name AS TagName,
        COUNT(*) FILTER (WHERE Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE Class = 3) AS BronzeBadges
    FROM
        Badges
    WHERE
        TagBased = true
    GROUP BY
        UserId,
        Name
),
UserEngagement AS (
    SELECT
        uas.OwnerUserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        uas.TagName,
        uas.TotalAnswersInTag,
        uas.TotalAnswerScoreInTag,
        uas.AcceptedAnswersInTag,
        COALESCE(utb.GoldBadges, 0) AS GoldBadges,
        COALESCE(utb.SilverBadges, 0) AS SilverBadges,
        (
            (uas.AvgAnswerScoreInTag * LOG(1 + uas.TotalAnswersInTag)) +
            (uas.AcceptedAnswersInTag * 20) +
            (COALESCE(utb.GoldBadges, 0) * 100) +
            (COALESCE(utb.SilverBadges, 0) * 50)
        ) / NULLIF(LOG(2 + uas.AvgTimeToAnswerSeconds / 3600.0), 0) AS TagExpertiseScore
    FROM
        UserAnswerStats AS uas
    JOIN Users AS u ON uas.OwnerUserId = u.Id
    LEFT JOIN UserTagBadges AS utb ON uas.OwnerUserId = utb.UserId AND uas.TagName = utb.TagName
    WHERE
        uas.TotalAnswersInTag > 10
        AND u.Reputation > (SELECT percentile_cont(0.75) WITHIN GROUP (ORDER BY Reputation) FROM Users)
),
RankedUsers AS (
    SELECT
        *,
        DENSE_RANK() OVER (PARTITION BY TagName ORDER BY TagExpertiseScore DESC, Reputation DESC) AS RankInTag,
        AVG(CommentInterval) OVER (PARTITION BY OwnerUserId, TagName) AS AvgCommentIntervalInTag
    FROM (
        SELECT
            ue.*,
            EXTRACT(EPOCH FROM (c.CreationDate - LAG(c.CreationDate, 1, c.CreationDate) OVER (PARTITION BY ue.OwnerUserId, ue.TagName ORDER BY c.CreationDate))) AS CommentInterval
        FROM
            UserEngagement ue
        JOIN Posts AS p_q ON p_q.OwnerUserId = ue.OwnerUserId
        JOIN Comments AS c ON c.PostId = p_q.Id AND c.UserId = ue.OwnerUserId
        WHERE
            p_q.Id IN (SELECT QuestionId FROM QuestionStats qs WHERE qs.TagName = ue.TagName)
    ) AS SubQueryWithIntervals
)
SELECT
    ru.TagName,
    ru.RankInTag,
    ru.DisplayName,
    ru.Reputation,
    ru.TagExpertiseScore,
    ru.TotalAnswersInTag,
    ru.AcceptedAnswersInTag,
    ru.GoldBadges,
    ru.SilverBadges,
    ph.CloseReason,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = ph.PostId AND v.VoteTypeId = 5) AS PostFavorites
FROM
    RankedUsers ru
LEFT JOIN LATERAL (
    SELECT
        crt.Name AS CloseReason,
        ph.PostId
    FROM
        PostHistory ph
    JOIN
        CloseReasonTypes crt ON CAST(ph.Comment AS VARCHAR) = CAST(crt.Id AS VARCHAR)
    WHERE
        ph.PostHistoryTypeId = 10
        AND ph.PostId IN (SELECT QuestionId FROM QuestionStats qs WHERE qs.TagName = ru.TagName AND qs.OwnerUserId != ru.OwnerUserId)
    GROUP BY
        crt.Name, ph.PostId
    ORDER BY
        COUNT(*) DESC
    LIMIT 1
) ph ON TRUE
WHERE
    ru.RankInTag <= 5
ORDER BY
    ru.TagName,
    ru.RankInTag;