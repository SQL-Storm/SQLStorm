WITH RankedPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        COALESCE(p.Title, '') AS Title,
        COALESCE(p.Tags, '') AS Tags,
        COALESCE(p.Body, '') AS Body,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS Rank
    FROM
        Posts p
    WHERE
        p.PostTypeId IN (1, 2)
),
TopPosts AS (
    SELECT
        PostId,
        PostTypeId,
        CreationDate,
        Score,
        ViewCount,
        OwnerUserId,
        AnswerCount,
        CommentCount,
        FavoriteCount,
        Title,
        Tags,
        Body
    FROM
        RankedPosts
    WHERE
        Rank <= 5
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.DisplayName,
        u.LastAccessDate,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COALESCE(p.Id, 0) AS LastPostId,
        COALESCE(p.CreationDate, u.CreationDate) AS LastPostDate,
        COALESCE(v.Id, 0) AS LastVotePostId,
        COALESCE(v.CreationDate, u.CreationDate) AS LastVoteDate
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    WHERE
        u.Reputation > 1000
),
ActiveTags AS (
    SELECT
        t.Id AS TagId,
        t.TagName,
        t.Count,
        COALESCE(EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - p.LastActivityDate)), 0) AS DaysSinceLastActivity,
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId
    FROM
        Tags t
    JOIN
        Posts p ON t.TagName = ANY(STRING_TO_ARRAY(p.Tags, '><'))
    WHERE
        p.PostTypeId = 1
),
HighActivityUsers AS (
    SELECT
        u.UserId,
        COUNT(p.Id) AS PostCount,
        COUNT(c.Id) AS CommentCount,
        COUNT(v.Id) AS VoteCount
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    GROUP BY
        u.UserId
    HAVING
        COUNT(p.Id) > 10 OR COUNT(c.Id) > 50 OR COUNT(v.Id) > 100
),
View_Uses AS (
    SELECT
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY u.AccountId) AS ROW1,
        ROW_NUMBER() OVER (PARTITION BY u.AccountId ORDER BY u.Id) AS ROW2,
        U.Id,
        U.DisplayName,
        U.Reputation,
        U.location,
        (SELECT COUNT(*) FROM Votes WHERE Votes.UserId = U.Id) AS VoteCount,
        (SELECT COUNT(*) FROM Posts WHERE Posts.OwnerUserId = U.Id) AS NumberOfPosts,
        U.Views,
        U.UpVotes,
        U.DownVotes,
        (SELECT ARRAY_AGG(Badges.Abbreviation) FROM Badges Badges WHERE Badges.UserId = U.Id AND Badges.tagbased) AS BadgeNames,
        (CASE
            WHEN (SELECT ARRAY_AGG(urel.class) FROM badges urel WHERE u.Id = urel.UserId AND urel.class != 3) IS NOT NULL
                 AND (SELECT ARRAY_AGG(urel.class) FROM badges urel WHERE u.Id = urel.UserId AND urel.class != 3) != ALL (SELECT Badges.class FROM Badges WHERE Badges.UserId = U.Id)
            THEN 1
            ELSE 0
         END) AS BronzeBadgesComplete
    FROM
        Users U
    WHERE
        U.Reputation >= 50 AND U.Reputation < 1000
        AND U.Id IN (SELECT UserId FROM Badges GROUP BY UserId HAVING COUNT(*) > 20)
    ORDER BY
        U.Reputation DESC
),
AnswersWithComments AS (
    SELECT
        P1.Id AS PostId,
        CT.Text AS Comment,
        U1.Id AS UserId,
        P1.CommentCount,
        U1.DisplayName
    FROM
        Posts P1
        JOIN Comments CT ON CT.PostId = P1.Id
        JOIN Users U1 ON U1.Id = P1.UserId
    WHERE
        P1.PostTypeId = 2 AND P1.AnswerCount > 0 AND P1.CommentCount > 0
        AND P1.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 month'
    ORDER BY
        P1.CommentCount DESC, P1.OwnerUserId DESC
)
SELECT
    U.*,
    COALESCE(AO.PostId, 0) AS TopAnswer,
    NUMERIC_STATS.UpvotedAnswersComp,
    NUMERIC_STATS.AnsweredQuestionsComp,
    COALESCE(Philip.TopAnswerBody, ARRAY[]::text[]) AS TopAnswer
FROM
    View_Uses U
LEFT JOIN LATERAL (
    SELECT
        AnswersWithComments.UserId AS UserId,
        AnswersWithComments.PostId,
        COUNT(AnswersWithComments.Comment) AS CommentsToAnswers
    FROM
        AnswersWithComments
    WHERE
        AnswersWithComments.UserId = U.Id
    GROUP BY
        AnswersWithComments.UserId, PostId
    ORDER BY
        CommentsToAnswers DESC
    LIMIT 5
) AS AO ON U.Id = AO.UserId
LEFT JOIN LATERAL (
    SELECT
        Username,
        COUNT(DISTINCT VT2.PostId) AS AnsweredQuestionsComp,
        COUNT(DISTINCT CASE
            WHEN VP.Id IS NOT NULL THEN 1
            ELSE NULL
        END) AS UpvotedAnswersComp
    FROM
        Users AS AO2
        CROSS JOIN LATERAL (
            SELECT
                Posts.Id AS PostId,
                Posts.OwnerUserId AS UserId
            FROM Posts
            WHERE Posts.PostTypeId = 2
        ) AS VP
        LEFT JOIN Votes vp_inner ON vp_inner.UserId = AO2.Id AND vp_inner.PostId = VP.PostId
    GROUP BY
        Username
) AS NUMERIC_STATS ON NUMERIC_STATS.Username = U.DisplayName
LEFT JOIN LATERAL (
    SELECT
        P2.Id AS PostId,
        P2.Body AS TopAnswerBody
    FROM Posts P2
    JOIN Users U2 ON U2.Id = P2.OwnerUserId
    WHERE P2.PostTypeId = 2 AND U2.Id = AO.UserId
    ORDER BY U2.UpVotes DESC
    LIMIT 1
) AS Philip ON U.Id = AO.UserId;