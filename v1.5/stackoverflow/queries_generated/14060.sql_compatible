WITH cte AS (
  SELECT p.Id, p.PostTypeId, p.ParentId, p.OwnerUserId, p.Score, p.Tags, p.AnswerCount, p.CommentCount, p.FavoriteCount, p.CreationDate, p.LastActivityDate,
         CASE WHEN p.PostTypeId = 1 THEN (
           SELECT COUNT(*) 
           FROM Votes v
           WHERE v.PostId = p.Id 
             AND v.VoteTypeId = 2
         ) ELSE 0 END AS UpVoteCount,
         CASE WHEN p.PostTypeId = 1 THEN (
           SELECT COUNT(*)
           FROM Votes v
           WHERE v.PostId = p.Id
             AND v.VoteTypeId = 3  
         ) ELSE 0 END AS DownVoteCount,
         CASE WHEN p.PostTypeId = 1 THEN (
           SELECT COUNT(*)
           FROM Votes v
           WHERE v.PostId = p.Id
             AND v.VoteTypeId = 1
         ) ELSE 0 END AS AcceptedAnswerCount,
         COALESCE((
           SELECT SUM(CAST(SUBSTRING(v.Text FROM 2 FOR (CHAR_LENGTH(v.Text) - 2)) AS INTEGER))
           FROM PostHistory ph
           JOIN Votes v ON ph.PostId = v.PostId
           WHERE ph.PostId = p.Id
             AND ph.PostHistoryTypeId IN (33, 34)
             AND v.VoteTypeId = 2
           GROUP BY ph.PostId
         ), 0) AS PostNoticeUpVoteCount,
         COALESCE((
           SELECT SUM(CAST(SUBSTRING(v.Text FROM 2 FOR (CHAR_LENGTH(v.Text) - 2)) AS INTEGER))
           FROM PostHistory ph
           JOIN Votes v ON ph.PostId = v.PostId
           WHERE ph.PostId = p.Id
             AND ph.PostHistoryTypeId IN (33, 34)
             AND v.VoteTypeId = 3  
           GROUP BY ph.PostId
         ), 0) AS PostNoticeDownVoteCount
  FROM Posts p
),
cte2 AS (
  SELECT c.Id, c.PostId, c.Score, c.CreationDate, c.UserId, u.Reputation, u.DisplayName, u.WebsiteUrl, u.Location, u.AboutMe, u.Views, u.UpVotes, u.DownVotes, u.ProfileImageUrl, u.EmailHash, u.AccountId
  FROM Comments c
  JOIN Users u ON c.UserId = u.Id
),
cte3 AS (
  SELECT b.Id, b.UserId, b.Name, b.Date, b.Class, b.TagBased,
         DENSE_RANK() OVER (PARTITION BY b.UserId ORDER BY b.Date) AS BadgeRank
  FROM Badges b
)
SELECT
  cte.Id, 
  cte.PostTypeId,
  cte.ParentId,
  cte.OwnerUserId,
  cte.Score,
  cte.Tags,
  cte.AnswerCount,
  cte.CommentCount,
  cte.FavoriteCount,
  cte.CreationDate,
  cte.LastActivityDate,
  cte.UpVoteCount,
  cte.DownVoteCount,
  cte.AcceptedAnswerCount,
  cte.PostNoticeUpVoteCount,
  cte.PostNoticeDownVoteCount,
  cte2.Id AS CommentId,
  cte2.Score AS CommentScore,
  cte2.CreationDate AS CommentCreationDate,
  cte2.UserId AS CommentUserId,
  cte2.Reputation AS CommentUserReputation,
  cte2.DisplayName AS CommentUserDisplayName,
  cte2.WebsiteUrl AS CommentUserWebsiteUrl,
  cte2.Location AS CommentUserLocation,
  cte2.AboutMe AS CommentUserAboutMe,
  cte2.Views AS CommentUserViews,
  cte2.UpVotes AS CommentUserUpVotes,
  cte2.DownVotes AS CommentUserDownVotes,
  cte2.ProfileImageUrl AS CommentUserProfileImageUrl,
  cte2.EmailHash AS CommentUserEmailHash,
  cte2.AccountId AS CommentUserAccountId,
  cte3.Id AS BadgeId,
  cte3.UserId AS BadgeUserId,
  cte3.Name AS BadgeName,
  cte3.Date AS BadgeDate,
  cte3.Class AS BadgeClass,
  cte3.TagBased AS BadgeTagBased,
  cte3.BadgeRank
FROM cte
LEFT JOIN cte2 ON cte.Id = cte2.PostId
LEFT JOIN cte3 ON cte.OwnerUserId = cte3.UserId
GROUP BY
  cte.Id, 
  cte.PostTypeId,
  cte.ParentId,
  cte.OwnerUserId,
  cte.Score,
  cte.Tags,
  cte.AnswerCount,
  cte.CommentCount,
  cte.FavoriteCount,
  cte.CreationDate,
  cte.LastActivityDate,
  cte.UpVoteCount,
  cte.DownVoteCount,
  cte.AcceptedAnswerCount,
  cte.PostNoticeUpVoteCount,
  cte.PostNoticeDownVoteCount,
  cte2.Id,
  cte2.Score,
  cte2.CreationDate,
  cte2.UserId,
  cte2.Reputation,
  cte2.DisplayName,
  cte2.WebsiteUrl,
  cte2.Location,
  cte2.AboutMe,
  cte2.Views,
  cte2.UpVotes,
  cte2.DownVotes,
  cte2.ProfileImageUrl,
  cte2.EmailHash,
  cte2.AccountId,
  cte3.Id,
  cte3.UserId,
  cte3.Name,
  cte3.Date,
  cte3.Class,
  cte3.TagBased,
  cte3.BadgeRank
ORDER BY cte.Id, cte2.Id, cte3.BadgeRank;