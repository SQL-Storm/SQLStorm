WITH TopUsers AS (
    SELECT 
        u.Id, 
        u.DisplayName, 
        u.Reputation,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS [Rank]
    FROM Users u
    WHERE u.CreationDate >= DATEADD(YEAR, -1, cast('2024-10-01 12:34:56' as timestamp))
),
UserBadges AS (
    SELECT 
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
),
RecentActivity AS (
    SELECT 
        p.OwnerUserId AS UserId,
        COUNT(*) AS RecentPosts,
        SUM(CASE WHEN p.PostTypeId = (SELECT Id FROM PostTypes WHERE Name = 'Question') THEN 1 ELSE 0 END) AS RecentQuestions,
        SUM(CASE WHEN p.PostTypeId = (SELECT Id FROM PostTypes WHERE Name = 'Answer')   THEN 1 ELSE 0 END) AS RecentAnswers
    FROM Posts p
    WHERE p.CreationDate >= DATEADD(MONTH, -6, cast('2024-10-01 12:34:56' as timestamp))
      AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
TagsCountPerUser AS (
    SELECT 
        p.OwnerUserId AS UserId,
        AVG(
            (LEN(p.Tags) - LEN(REPLACE(p.Tags, '><', '')))
            + CASE WHEN p.Tags IS NOT NULL THEN 1 ELSE 0 END
        ) AS AvgTagsPerQuestion
    FROM Posts p
    JOIN PostTypes pt 
      ON p.PostTypeId = pt.Id 
     AND pt.Name = 'Question'
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
VoteTypesUpMod AS (
    SELECT Id 
    FROM VoteTypes 
    WHERE Name = 'UpMod'
),
UpVotesReceived AS (
    SELECT 
        p.OwnerUserId AS UserId,
        COUNT(v.Id) AS UpVotesReceived
    FROM Posts p
    JOIN Votes v 
      ON v.PostId = p.Id
    JOIN VoteTypesUpMod vt 
      ON v.VoteTypeId = vt.Id
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
LinkTypeDuplicate AS (
    SELECT Id 
    FROM LinkTypes 
    WHERE Name = 'Duplicate'
),
DuplicateChain AS (
    SELECT 
        pl.PostId, 
        pl.RelatedPostId, 
        1 AS Depth
    FROM PostLinks pl
    JOIN LinkTypeDuplicate ltd 
      ON pl.LinkTypeId = ltd.Id

    UNION ALL

    SELECT 
        dc.PostId, 
        pl.RelatedPostId, 
        dc.Depth + 1
    FROM DuplicateChain dc
    JOIN PostLinks pl 
      ON pl.PostId = dc.RelatedPostId
    JOIN LinkTypeDuplicate ltd 
      ON pl.LinkTypeId = ltd.Id
    WHERE dc.Depth < 5
)
SELECT 
    tu.Id,
    tu.DisplayName,
    tu.Reputation,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ISNULL(ra.RecentPosts, 0)        AS RecentPosts,
    ISNULL(ra.RecentQuestions, 0)    AS RecentQuestions,
    ISNULL(ra.RecentAnswers, 0)      AS RecentAnswers,
    ISNULL(tc.AvgTagsPerQuestion, 0) AS AvgTagsPerQuestion,
    ISNULL(uv.UpVotesReceived, 0)    AS UpVotesReceived,
    COUNT(DISTINCT dc.RelatedPostId) AS DownstreamDuplicates
FROM TopUsers tu
LEFT JOIN UserBadges ub 
  ON ub.UserId = tu.Id
LEFT JOIN RecentActivity ra 
  ON ra.UserId = tu.Id
LEFT JOIN TagsCountPerUser tc 
  ON tc.UserId = tu.Id
LEFT JOIN UpVotesReceived uv 
  ON uv.UserId = tu.Id
LEFT JOIN Posts pOwn 
  ON pOwn.OwnerUserId = tu.Id
LEFT JOIN DuplicateChain dc 
  ON dc.PostId = pOwn.Id
GROUP BY 
    tu.Id,
    tu.DisplayName,
    tu.Reputation,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ra.RecentPosts,
    ra.RecentQuestions,
    ra.RecentAnswers,
    tc.AvgTagsPerQuestion,
    uv.UpVotesReceived,
    tu.[Rank]
ORDER BY tu.[Rank];