-- {"query": "39095.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "codex-mini-latest", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 1972, "output_tokens": 2487} 
WITH
-- 1. Grab each user’s most recent questions from the last year
RecentQuestions AS (
    SELECT
        p.OwnerUserId,
        p.Id            AS QuestionId,
        p.CreationDate,
        p.Score,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
),

-- 2. Identify users with at least 3 questions among their top 5 recent
TopActiveUsers AS (
    SELECT
        u.Id           AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(rq.QuestionId)    AS NumRecentQuestions,
        SUM(rq.Score)           AS SumRecentScores
    FROM Users u
    JOIN RecentQuestions rq
      ON rq.OwnerUserId = u.Id
     AND rq.rn <= 5
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(rq.QuestionId) >= 3
),

-- 3. Aggregate global tag performance over the last two years
TagPerformance AS (
    SELECT
        tag,
        COUNT(*)        AS QuestionCount,
        AVG(p.Score)    AS AvgScore,
        SUM(vote_count) AS TotalVotes
    FROM (
        SELECT
            unnest(string_to_array(substring(p.Tags,2,length(p.Tags)-2),'><')) AS tag,
            p.Score,
            (SELECT COUNT(*) 
             FROM Votes v 
             WHERE v.PostId = p.Id 
               AND v.VoteTypeId IN (2,3)
            ) AS vote_count
        FROM Posts p
        WHERE p.PostTypeId = 1
          AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 years'
    ) AS x
    GROUP BY tag
),

-- 4. Count recent badges per user in the last 6 months
BadgeCounts AS (
    SELECT
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges
    FROM Badges b
    WHERE b.Date >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months'
    GROUP BY b.UserId
),

-- 5. Compose the final report
FinalReport AS (
    SELECT
        u.DisplayName,
        u.Reputation,
        t.NumRecentQuestions,
        t.SumRecentScores,
        COALESCE(b.GoldBadges, 0)   AS GoldBadges,
        COALESCE(b.SilverBadges, 0) AS SilverBadges,
        COALESCE(b.BronzeBadges, 0) AS BronzeBadges,
        -- Top 3 performing tags globally
        (
          SELECT array_agg(tp.tag)
          FROM (
            SELECT tag
            FROM TagPerformance
            ORDER BY QuestionCount DESC
            LIMIT 3
          ) AS tp
        )                           AS TopGlobalTags,
        TO_CHAR(u.CreationDate,'YYYY-MM-DD') AS MemberSince
    FROM TopActiveUsers t
    JOIN Users u
      ON u.Id = t.UserId
    LEFT JOIN BadgeCounts b
      ON b.UserId = t.UserId
)

-- 6. Return the top 10 users by their recent score sum
SELECT *
FROM FinalReport
ORDER BY SumRecentScores DESC
LIMIT 10;