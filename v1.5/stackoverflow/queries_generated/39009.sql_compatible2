WITH TopTags AS (
  SELECT TagName
  FROM Tags
  ORDER BY Count DESC
  LIMIT 3
),
AnswererStats AS (
  SELECT
    t.TagName,
    u.Id        AS UserId,
    u.DisplayName,
    COUNT(a.Id) AS AnswersCount,
    COALESCE(SUM(vu.UpVotes),   0) AS TotalUpVotes,
    COALESCE(SUM(vu.DownVotes), 0) AS TotalDownVotes,
    MAX(b.Date) AS LastBadgeDate
  FROM TopTags t
  JOIN Posts q
    ON q.PostTypeId = 1
   AND q.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
  JOIN Posts a
    ON a.ParentId   = q.Id
   AND a.PostTypeId = 2
  JOIN Users u
    ON u.Id = a.OwnerUserId
  LEFT JOIN (
    SELECT
      PostId,
      COUNT(*) FILTER (WHERE VoteTypeId = 2) AS UpVotes,
      COUNT(*) FILTER (WHERE VoteTypeId = 3) AS DownVotes
    FROM Votes
    GROUP BY PostId
  ) vu
    ON vu.PostId = a.Id
  LEFT JOIN Badges b
    ON b.UserId = u.Id
  GROUP BY
    t.TagName,
    u.Id,
    u.DisplayName
),
RankedAnswerers AS (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY TagName
      ORDER BY AnswersCount DESC, TotalUpVotes DESC
    ) AS Rank
  FROM AnswererStats
)
SELECT
  ra.TagName,
  ra.Rank,
  ra.DisplayName,
  ra.AnswersCount,
  ra.TotalUpVotes,
  ra.TotalDownVotes,
  ra.LastBadgeDate,
  (
    SELECT COALESCE(
             JSON_AGG(
               JSON_BUILD_OBJECT(
                 'CommentId', c.Id,
                 'Score',     c.Score,
                 'Text',      c.Text
               )
             ),
             '[]'::json
           )
    FROM Comments c
    WHERE c.UserId = ra.UserId
      AND c.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days'
  ) AS RecentComments
FROM RankedAnswerers ra
WHERE ra.Rank <= 3
ORDER BY ra.TagName, ra.Rank;