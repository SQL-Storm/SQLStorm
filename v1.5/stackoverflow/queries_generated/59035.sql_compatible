SELECT 
    p.Id AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation,
    COUNT(DISTINCT c.Id) AS CommentCount,
    COUNT(DISTINCT v.Id) AS VoteCount,
    COUNT(DISTINCT bh.Id) AS HistoryCount,
    STRING_AGG(DISTINCT t.TagName, ', ') AS Tags,
    CASE 
        WHEN p.PostTypeId = 1 THEN 'Question'
        WHEN p.PostTypeId = 2 THEN 'Answer'
        WHEN p.PostTypeId = 3 THEN 'Wiki'
        WHEN p.PostTypeId = 4 THEN 'TagWikiExcerpt'
        WHEN p.PostTypeId = 5 THEN 'TagWiki'
        WHEN p.PostTypeId = 6 THEN 'ModeratorNomination'
        WHEN p.PostTypeId = 7 THEN 'WikiPlaceholder'
        WHEN p.PostTypeId = 8 THEN 'PrivilegeWiki'
    END AS PostType,
    CASE 
        WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
        WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
        WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Answer Accepted'
        ELSE 'Open'
    END AS PostStatus,
    AVG(v.Score) AS AvgVoteScore,
    MAX(v.CreationDate) AS LastVoteDate,
    MIN(bh.CreationDate) AS FirstHistoryDate,
    MAX(bh.CreationDate) AS LastHistoryDate,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (10, 11, 12, 13) THEN bh.Id END) AS ModerationEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (1, 4, 7) THEN bh.Id END) AS TitleEdits,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (2, 5, 8) THEN bh.Id END) AS BodyEdits,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (3, 6, 9) THEN bh.Id END) AS TagEdits,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId = 24 THEN bh.Id END) AS SuggestedEdits,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (17, 35, 36) THEN bh.Id END) AS Migrations,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (19, 20) THEN bh.Id END) AS ProtectionEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (14, 15) THEN bh.Id END) AS LockUnlockEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId IN (52, 53) THEN bh.Id END) AS HotNetworkEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId = 31 THEN bh.Id END) AS ChatEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId = 50 THEN bh.Id END) AS CommunityBumpEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId BETWEEN 8 AND 15 THEN bh.Id END) AS LockedEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId BETWEEN 19 AND 23 THEN bh.Id END) AS ProtectedEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId BETWEEN 25 AND 30 THEN bh.Id END) AS TwitterEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId BETWEEN 31 AND 38 THEN bh.Id END) AS TransferEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId BETWEEN 50 AND 55 THEN bh.Id END) AS BumpEvents,
    COUNT(DISTINCT CASE WHEN bh.PostHistoryTypeId BETWEEN 60 AND 66 THEN bh.Id END) AS OtherEvents,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS UpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS DownVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 5 THEN v.Id END) AS FavoriteVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 8 THEN v.Id END) AS BountyStartVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 9 THEN v.Id END) AS BountyCloseVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 10 THEN v.Id END) AS DeletionVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 11 THEN v.Id END) AS UndeletionVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 14 THEN v.Id END) AS NominateModeratorVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 15 THEN v.Id END) AS ModeratorReviewVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 16 THEN v.Id END) AS ApproveEditSuggestionVotes
FROM Posts p
LEFT JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Comments c ON p.Id = c.PostId
LEFT JOIN Votes v ON p.Id = v.PostId
LEFT JOIN PostHistory bh ON p.Id = bh.PostId
LEFT JOIN (
    SELECT PostId, UNNEST(string_to_array(SUBSTRING(Tags, 2, LENGTH(Tags)-2), '><')) AS TagName
    FROM Posts
    WHERE Tags IS NOT NULL AND LENGTH(Tags) > 2
) t ON p.Id = t.PostId
WHERE p.PostTypeId IN (1, 2)
    AND p.CreationDate >= TIMESTAMP '2023-01-01 00:00:00'
    AND p.CreationDate < TIMESTAMP '2024-01-01 00:00:00'
    AND p.Score > 0
    AND (p.ViewCount IS NULL OR p.ViewCount > 100)
GROUP BY 
    p.Id, 
    p.Title, 
    p.Score, 
    p.ViewCount, 
    p.CreationDate, 
    u.DisplayName, 
    u.Reputation, 
    p.PostTypeId,
    p.ClosedDate,
    p.CommunityOwnedDate,
    p.AcceptedAnswerId
HAVING 
    COUNT(DISTINCT c.Id) > 0
    AND COUNT(DISTINCT v.Id) > 0
ORDER BY 
    p.Score DESC,
    p.ViewCount DESC,
    p.CreationDate DESC
LIMIT 10000;