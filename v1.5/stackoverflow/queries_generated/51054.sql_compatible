WITH popular_users AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as post_count,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) as question_count,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) as answer_count,
        AVG(p.Score) as avg_score,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) as reputation_rank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(DISTINCT p.Id) > 10 AND u.Reputation > 1000
),
user_badges AS (
    SELECT 
        pu.Id,
        COUNT(*) as total_badges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) as gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) as silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) as bronze_badges
    FROM popular_users pu
    LEFT JOIN Badges b ON pu.Id = b.UserId
    GROUP BY pu.Id
),
top_tags AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as tag_rank
    FROM Tags t
    WHERE t.Count > 50
),
question_tags AS (
    SELECT 
        p.Id as question_id,
        p.Title,
        p.Score as question_score,
        p.ViewCount,
        p.FavoriteCount,
        STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><') as tag_array
    FROM Posts p
    WHERE p.PostTypeId = 1 
        AND p.Score > 0 
        AND p.CreationDate > cast('2024-10-01' as date) - INTERVAL '1 year'
),
tag_popularity AS (
    SELECT 
        tt.Id as tag_id,
        tt.TagName,
        COUNT(qt.question_id) as questions_with_tag,
        AVG(qt.question_score) as avg_question_score,
        SUM(qt.ViewCount) as total_views,
        SUM(qt.FavoriteCount) as total_favorites
    FROM top_tags tt
    CROSS JOIN LATERAL (
        SELECT qt.question_id, qt.question_score, qt.ViewCount, qt.FavoriteCount
        FROM question_tags qt
        WHERE tt.TagName = ANY(qt.tag_array)
    ) qt
    GROUP BY tt.Id, tt.TagName
    HAVING COUNT(qt.question_id) > 5
),
answer_stats AS (
    SELECT 
        p.ParentId as question_id,
        COUNT(p.Id) as answer_count,
        AVG(p.Score) as avg_answer_score,
        MAX(p.Score) as best_answer_score,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) as total_upvotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) as total_downvotes
    FROM Posts p
    LEFT JOIN Votes v ON p.Id = v.PostId 
        AND v.VoteTypeId IN (2, 3)
    WHERE p.PostTypeId = 2 
        AND p.ParentId IS NOT NULL
    GROUP BY p.ParentId
),
comment_engagement AS (
    SELECT 
        c.PostId as question_id,
        COUNT(c.Id) as comment_count,
        AVG(c.Score) as avg_comment_score,
        MAX(c.CreationDate) as latest_comment_date
    FROM Comments c
    WHERE c.Score >= 0
    GROUP BY c.PostId
),
accepted_answers AS (
    SELECT 
        q.Id as question_id,
        q.AcceptedAnswerId,
        a.Score as accepted_score,
        a.CreationDate as accepted_date
    FROM Posts q
    LEFT JOIN Posts a ON q.AcceptedAnswerId = a.Id
    WHERE q.PostTypeId = 1 AND q.AcceptedAnswerId IS NOT NULL
),
activity_timeline AS (
    SELECT 
        ph.PostId as question_id,
        ph.PostHistoryTypeId,
        COUNT(*) as activity_count,
        MIN(ph.CreationDate) as first_activity,
        MAX(ph.CreationDate) as last_activity,
        AVG(EXTRACT(EPOCH FROM (ph.CreationDate - q.CreationDate)) / 3600) as avg_hours_after_creation
    FROM PostHistory ph
    JOIN Posts q ON ph.PostId = q.Id
    WHERE q.PostTypeId = 1 
        AND ph.PostHistoryTypeId IN (4, 5, 6, 10, 11, 12, 13)
    GROUP BY ph.PostId, ph.PostHistoryTypeId, q.CreationDate
)
SELECT 
    pu.DisplayName as top_user,
    pu.reputation_rank,
    pu.question_count,
    pu.answer_count,
    COALESCE(ub.total_badges, 0) as total_badges,
    COALESCE(ub.gold_badges, 0) as gold_badges,
    tp.TagName as popular_tag,
    tp.questions_with_tag,
    tp.avg_question_score,
    tp.total_views,
    COALESCE(answers.answer_count, 0) as answers_count,
    COALESCE(answers.avg_answer_score, 0) as avg_answer_score,
    COALESCE(comments.comment_count, 0) as comments_count,
    COALESCE(accepted.accepted_score, 0) as accepted_answer_score,
    COALESCE(timeline.activity_count, 0) as total_activities,
    ROUND((COALESCE(answers.total_upvotes, 0) / NULLIF(pu.post_count, 0))::numeric, 2) as upvotes_per_post,
    ROUND((COALESCE(comments.total_views, 0) / NULLIF(tp.questions_with_tag, 0)), 0) as avg_views_per_question
FROM popular_users pu
CROSS JOIN top_tags tt
LEFT JOIN user_badges ub ON pu.Id = ub.Id
LEFT JOIN tag_popularity tp ON tt.Id = tp.tag_id
LEFT JOIN (
    SELECT *
    FROM answer_stats
) answers ON pu.Id = (
    SELECT OwnerUserId 
    FROM Posts 
    WHERE Id = answers.question_id 
    LIMIT 1
)
LEFT JOIN comment_engagement comments ON answers.question_id = comments.question_id
LEFT JOIN accepted_answers accepted ON answers.question_id = accepted.question_id
LEFT JOIN activity_timeline timeline ON answers.question_id = timeline.question_id
WHERE pu.reputation_rank <= 50
    AND tt.tag_rank <= 20
    AND (answers.answer_count > 0 OR comments.comment_count > 0)
ORDER BY pu.reputation_rank, tt.tag_rank, pu.question_count DESC
LIMIT 1000;