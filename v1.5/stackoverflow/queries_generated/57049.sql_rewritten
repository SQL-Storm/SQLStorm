WITH TopUsers AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        SUM(v.VoteTypeId = 2) AS TotalUpVotes,
        SUM(v.VoteTypeId = 3) AS TotalDownVotes
    FROM
        Users u
    JOIN
        Posts p ON u.Id = p.OwnerUserId
    JOIN
        Votes v ON p.Id = v.PostId
    WHERE
        p.PostTypeId IN (1, 2)
    GROUP BY
        u.Id, u.DisplayName
    ORDER BY
        TotalScore DESC
    LIMIT 100
), RecenPostsWithTags AS (
    SELECT
        p.Id AS PostId,
        p.Title,
        p.Tags,
        p.ViewCount,
        p.AnswerCount,
        u.DisplayName AS OwnerDisplayName,
        t.TagName
    FROM
        Posts p
		JOIN Tags t ON p.Id = t.ExcerptPostId
    JOIN
        Users u ON p.OwnerUserId = u.Id
    WHERE
        p.PostTypeId = 1 AND
        p.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days')
    ORDER BY
        p.ViewCount DESC
    LIMIT 1000
), HighTrafficTags AS (
    SELECT
		Tags, array_to_string(array_agg(DISTINCT t.TagName ORDER BY t.TagName),' ' ) TagNames, AVG (p.ViewCount) AS AverageViews
    FROM
		RecenPostsWithTags p
	LEFT JOIN Tags t
		ON t.TagName = ANY (string_to_array(Tags,'><'))
    GROUP BY Tags, p.ViewCount
    ORDER BY AverageViews DESC
    LIMIT 20
), TagActivity AS (
	SELECT
	   t.TagName, SUM(p.ViewCount) AS ViewTotal, COUNT(DISTINCT v.UserId) AS UniqueCommenters,
	   AVG(p.ViewCount) AS AvgViews, SUM(p.AnswerCount) AS AnswerTotal, MAX(p.Id) AS LatestPostId,MAX(p.CreationDate) AS LatestPostDate
    FROM
        RecenPostsWithTags rp
        JOIN Tags t ON t.TagName =ANY(string_to_array(rp.Tags,'><'))
        JOIN Posts p ON p.Id = rp.PostId
        LEFT JOIN Comments c ON c.PostId = rp.PostId LEFT JOIN Votes v ON v.PostId=c.PostId
    GROUP BY  t.TagName, p.Id, c.Id
    ORDER BY AvgViews, UniqueCommenters DESC, LatestPostDate DESC,ViewTotal, AnswerTotal  DESC

), TagRankings AS (
    SELECT
		t1.TagName,t1.AnswerTotal, t1.ViewTotal, t1.AvgViews,
		DENSE_RANK () OVER (ORDER BY t1.AvgViews DESC, t1.UniqueCommenters DESC, t1.LatestPostDate DESC) AS TagRank,
		DENSE_RANK () OVER (ORDER BY (t1.AvgViews *random()+ t1.UniqueCommenters + t1.LatestPostDate )) AS RandomTagPos
    FROM TagActivity t1
)
SELECT
    tu.UserId,
    tu.DisplayName,
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.ViewCount,
    p.AnswerCount,
    tu.TotalScore,
    tu.TotalUpVotes,
    tu.TotalDownVotes,
	t2.TagName,
	t2.TagRank,
	t2.RandomTagPos,
	t2.AnswerTotal,
	t2.ViewTotal,
	t2.AvgViews

FROM
    TopUsers tu
JOIN
    RecenPostsWithTags p ON tu.UserId = p.OwnerUserId
LEFT JOIN
	TagRankings t2 ON  ANY(string_to_array(p.Tags,'><'))=t2.TagName
WHERE t2.TagRank<11 OR t2.RandomTagPos<11
ORDER BY tu.TotalScore DESC, t2.TagRank, t2.RandomTagPos, p.ViewCount DESC