WITH RECURSIVE tag_hierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        COUNT(DISTINCT pt.Id) AS direct_posts,
        1 AS level
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    JOIN Posts pt ON pt.Id = p.Id
    WHERE t.Count > 1000
    GROUP BY t.Id, t.TagName
    
    UNION ALL
    
    SELECT 
        t.Id,
        t.TagName,
        th.direct_posts,
        th.level + 1
    FROM tag_hierarchy th
    JOIN Tags t ON t.Id != th.Id
    WHERE th.level < 3
),
user_expertise AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        t.TagName,
        COUNT(DISTINCT p.Id) AS answers_count,
        SUM(p.Score) AS total_score,
        AVG(p.Score) AS avg_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS median_score,
        COUNT(DISTINCT CASE WHEN p.AcceptedAnswerId = p.Id THEN p.Id END) AS accepted_answers,
        COUNT(DISTINCT b.Id) AS tag_badges,
        DENSE_RANK() OVER (PARTITION BY t.TagName ORDER BY SUM(p.Score) DESC) AS tag_rank
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 2
    JOIN Posts q ON q.Id = p.ParentId
    JOIN Tags t ON q.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    LEFT JOIN Badges b ON b.UserId = u.Id AND b.Name = t.TagName AND b.TagBased = 1
    WHERE u.Reputation > 5000
        AND p.Score > 0
        AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
    GROUP BY u.Id, u.DisplayName, t.TagName
    HAVING COUNT(DISTINCT p.Id) >= 10
),
question_complexity AS (
    SELECT 
        q.Id,
        q.Title,
        q.Tags,
        q.Score AS question_score,
        q.ViewCount,
        q.AnswerCount,
        q.CreationDate,
        EXTRACT(EPOCH FROM (COALESCE(a.CreationDate, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) - q.CreationDate)) / 3600 AS hours_to_first_answer,
        LENGTH(q.Body) AS body_length,
        (LENGTH(q.Body) - LENGTH(REPLACE(LOWER(q.Body), '<code>', ''))) / 6 AS code_blocks,
        CARDINALITY(STRING_TO_ARRAY(SUBSTRING(q.Tags, 2, LENGTH(q.Tags) - 2), '><')) AS tag_count,
        COUNT(DISTINCT c.Id) AS comment_count,
        COUNT(DISTINCT ph.Id) AS edit_count,
        COUNT(DISTINCT pl.RelatedPostId) AS linked_posts,
        MAX(a.Score) AS best_answer_score,
        AVG(a.Score) FILTER (WHERE a.Score > 0) AS avg_positive_answer_score,
        COUNT(DISTINCT a.OwnerUserId) FILTER (WHERE a.Score >= 5) AS expert_answerers
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN Comments c ON c.PostId = q.Id
    LEFT JOIN PostHistory ph ON ph.PostId = q.Id AND ph.PostHistoryTypeId IN (4,5,6)
    LEFT JOIN PostLinks pl ON pl.PostId = q.Id
    WHERE q.PostTypeId = 1
        AND q.ClosedDate IS NULL
        AND q.Score >= 10
        AND q.ViewCount > 1000
    GROUP BY q.Id, q.Title, q.Tags, q.Score, q.ViewCount, q.AnswerCount, q.CreationDate, a.CreationDate, q.Body
),
user_activity_patterns AS (
    SELECT 
        u.Id,
        u.DisplayName,
        EXTRACT(DOW FROM p.CreationDate) AS day_of_week,
        EXTRACT(HOUR FROM p.CreationDate) AS hour_of_day,
        COUNT(*) AS post_count,
        AVG(p.Score) AS avg_score,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS answers,
        STDDEV(p.Score) AS score_variance
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id
    WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
    GROUP BY u.Id, u.DisplayName, EXTRACT(DOW FROM p.CreationDate), EXTRACT(HOUR FROM p.CreationDate)
)
SELECT 
    ue.TagName,
    ue.DisplayName AS expert_name,
    ue.tag_rank,
    ue.total_score AS expert_total_score,
    ue.accepted_answers,
    ue.tag_badges,
    qc.Title AS complex_question,
    qc.question_score,
    qc.ViewCount,
    qc.hours_to_first_answer,
    qc.code_blocks,
    qc.tag_count,
    qc.expert_answerers,
    qc.best_answer_score,
    uap.day_of_week AS expert_most_active_day,
    uap.hour_of_day AS expert_most_active_hour,
    uap.post_count AS activity_in_period,
    th.level AS tag_hierarchy_level,
    RANK() OVER (ORDER BY qc.ViewCount * LOG(qc.expert_answerers + 1) * qc.best_answer_score DESC) AS question_impact_rank,
    DENSE_RANK() OVER (PARTITION BY ue.TagName ORDER BY ue.total_score * ue.accepted_answers DESC) AS expert_effectiveness,
    LAG(qc.best_answer_score, 1) OVER (PARTITION BY ue.TagName ORDER BY qc.CreationDate) AS prev_best_answer,
    LEAD(qc.ViewCount, 1) OVER (PARTITION BY ue.TagName ORDER BY qc.CreationDate) AS next_view_count,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY uap.avg_score) OVER (PARTITION BY ue.DisplayName) AS user_75th_percentile_score
FROM user_expertise ue
JOIN question_complexity qc ON qc.Tags LIKE '%' || '<' || ue.TagName || '>' || '%'
JOIN user_activity_patterns uap ON uap.Id = ue.UserId
LEFT JOIN tag_hierarchy th ON th.TagName = ue.TagName
WHERE ue.tag_rank <= 50
    AND qc.expert_answerers >= 3
    AND qc.hours_to_first_answer < 48
    AND uap.post_count > 5
ORDER BY 
    question_impact_rank,
    ue.tag_rank,
    qc.ViewCount DESC
LIMIT 100;