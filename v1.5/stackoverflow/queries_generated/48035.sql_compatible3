WITH RankedPosts AS (
  SELECT
    p.Id,
    p.OwnerUserId,
    p.Score,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.ViewCount,
    p.CreationDate,
    p.LastActivityDate,
    ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC, p.CreationDate ASC) AS RowNum
  FROM Posts AS p
  WHERE
    p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL AND p.AnswerCount IS NOT NULL
),
UserActivity AS (
  SELECT
    u.Id AS UserId,
    COUNT(DISTINCT ph.PostId) AS PostHistoryCount,
    COUNT(DISTINCT c.Id) AS CommentCount,
    COUNT(DISTINCT v.Id) AS VoteCount,
    MAX(u.Reputation) AS MaxReputation,
    AVG(u.Views) AS AvgUserViews
  FROM Users AS u
  LEFT JOIN PostHistory AS ph
    ON u.Id = ph.UserId
  LEFT JOIN Comments AS c
    ON u.Id = c.UserId
  LEFT JOIN Votes AS v
    ON u.Id = v.UserId
  GROUP BY
    u.Id
)
SELECT
  rp.Id AS QuestionId,
  rp.Score AS QuestionScore,
  rp.AnswerCount AS QuestionAnswerCount,
  rp.CommentCount AS QuestionCommentCount,
  rp.FavoriteCount AS QuestionFavoriteCount,
  rp.ViewCount AS QuestionViewCount,
  rp.CreationDate AS QuestionCreationDate,
  rp.LastActivityDate AS QuestionLastActivityDate,
  ua.PostHistoryCount,
  ua.CommentCount AS UserCommentCount,
  ua.VoteCount,
  ua.MaxReputation,
  ua.AvgUserViews,
  CASE
    WHEN rp.Score > 1000 THEN 'Very High Score'
    WHEN rp.Score > 100 THEN 'High Score'
    ELSE 'Moderate Score'
  END AS ScoreCategory,
  CASE
    WHEN rp.AnswerCount > 10 THEN 'Many Answers'
    WHEN rp.AnswerCount > 0 THEN 'Some Answers'
    ELSE 'No Answers'
  END AS AnswerCountCategory,
  CASE
    WHEN rp.ViewCount > 100000 THEN 'Very High Views'
    WHEN rp.ViewCount > 10000 THEN 'High Views'
    ELSE 'Moderate Views'
  END AS ViewCountCategory,
  DATEDIFF(day, rp.CreationDate, TIMESTAMP '2024-10-01 12:34:56') AS DaysSinceCreation,
  DATEDIFF(day, rp.LastActivityDate, TIMESTAMP '2024-10-01 12:34:56') AS DaysSinceLastActivity,
  CASE
    WHEN DATEDIFF(day, rp.CreationDate, TIMESTAMP '2024-10-01 12:34:56') = 0 THEN NULL
    ELSE CAST(ua.PostHistoryCount AS FLOAT) / NULLIF(DATEDIFF(day, rp.CreationDate, TIMESTAMP '2024-10-01 12:34:56'), 0)
  END AS AvgPostHistoryPerDay,
  CASE
    WHEN DATEDIFF(day, rp.CreationDate, TIMESTAMP '2024-10-01 12:34:56') = 0 THEN NULL
    ELSE CAST(ua.CommentCount AS FLOAT) / NULLIF(DATEDIFF(day, rp.CreationDate, TIMESTAMP '2024-10-01 12:34:56'), 0)
  END AS AvgCommentsPerDay,
  CASE
    WHEN DATEDIFF(day, rp.CreationDate, TIMESTAMP '2024-10-01 12:34:56') = 0 THEN NULL
    ELSE CAST(ua.VoteCount AS FLOAT) / NULLIF(DATEDIFF(day, rp.CreationDate, TIMESTAMP '2024-10-01 12:34:56'), 0)
  END AS AvgVotesPerDay
FROM RankedPosts AS rp
JOIN UserActivity AS ua
  ON rp.OwnerUserId = ua.UserId
WHERE
  rp.RowNum <= 1000
GROUP BY
  rp.Id,
  rp.OwnerUserId,
  rp.Score,
  rp.AnswerCount,
  rp.CommentCount,
  rp.FavoriteCount,
  rp.ViewCount,
  rp.CreationDate,
  rp.LastActivityDate,
  ua.PostHistoryCount,
  ua.CommentCount,
  ua.VoteCount,
  ua.MaxReputation,
  ua.AvgUserViews
ORDER BY
  rp.RowNum;