WITH ranked_users AS (
    SELECT Id,
           Reputation,
           ROW_NUMBER() OVER (ORDER BY Reputation DESC) AS rank
    FROM Users
),
top_users AS (
    SELECT Id,
           Reputation
    FROM ranked_users
    WHERE rank <= 100
)
SELECT u.Id,
       u.DisplayName,
       u.Reputation,
       COUNT(DISTINCT p.Id) AS num_posts
FROM top_users AS u
LEFT JOIN Posts AS p
  ON u.Id = p.OwnerUserId
WHERE p.Score >= 10
GROUP BY u.Id,
         u.DisplayName,
         u.Reputation
ORDER BY num_posts DESC;