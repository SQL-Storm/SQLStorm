-- {"query": "17057.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "claude-4.1-opus", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 135430, "output_tokens": 134626} 
WITH user_activity AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as post_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as question_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as answer_count,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) as avg_post_score,
        MAX(p.CreationDate) as last_post_date,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) as median_score
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
top_tags AS (
    SELECT 
        p.OwnerUserId,
        UNNEST(string_to_array(SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), '><')) as tag,
        COUNT(*) as tag_usage,
        SUM(p.Score) as total_tag_score,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY COUNT(*) DESC, SUM(p.Score) DESC) as tag_rank
    FROM Posts p
    WHERE p.Tags IS NOT NULL 
        AND p.OwnerUserId IS NOT NULL
        AND p.PostTypeId = 1
    GROUP BY p.OwnerUserId, tag
),
badge_analysis AS (
    SELECT 
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) as gold_badges,
        COUNT(*) FILTER (WHERE b.Class = 2) as silver_badges,
        COUNT(*) FILTER (WHERE b.Class = 3) as bronze_badges,
        STRING_AGG(DISTINCT CASE WHEN b.Class = 1 THEN b.Name END, ', ' ORDER BY b.Name) as gold_badge_names,
        DENSE_RANK() OVER (ORDER BY COUNT(*) FILTER (WHERE b.Class = 1) DESC, 
                                   COUNT(*) FILTER (WHERE b.Class = 2) DESC,
                                   COUNT(*) FILTER (WHERE b.Class = 3) DESC) as badge_rank
    FROM Badges b
    GROUP BY b.UserId
),
edit_history AS (
    SELECT 
        ph.UserId,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4,5,6)) as edit_count,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (7,8,9)) as rollback_count,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 10) as close_vote_count,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 11) as reopen_vote_count,
        CASE 
            WHEN COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (7,8,9)) > 0 
            THEN COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4,5,6))::NUMERIC / 
                 NULLIF(COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (7,8,9)), 0)
            ELSE NULL 
        END as edit_to_rollback_ratio
    FROM PostHistory ph
    WHERE ph.UserId IS NOT NULL
    GROUP BY ph.UserId
),
interaction_network AS (
    SELECT 
        p1.OwnerUserId as questioner_id,
        p2.OwnerUserId as answerer_id,
        COUNT(DISTINCT p1.Id) as interaction_count,
        AVG(p2.Score) as avg_answer_score,
        SUM(CASE WHEN p2.Id = p1.AcceptedAnswerId THEN 1 ELSE 0 END) as accepted_answers
    FROM Posts p1
    INNER JOIN Posts p2 ON p1.Id = p2.ParentId
    WHERE p1.PostTypeId = 1 
        AND p2.PostTypeId = 2
        AND p1.OwnerUserId IS NOT NULL
        AND p2.OwnerUserId IS NOT NULL
        AND p1.OwnerUserId != p2.OwnerUserId
    GROUP BY p1.OwnerUserId, p2.OwnerUserId
)
SELECT 
    ua.DisplayName,
    ua.Reputation,
    ua.post_count,
    ua.question_count,
    ua.answer_count,
    ROUND(ua.avg_post_score, 2) as avg_post_score,
    ua.median_score,
    COALESCE(tt.tag, 'NO_TAGS') as top_tag,
    COALESCE(tt.tag_usage, 0) as top_tag_usage,
    COALESCE(tt.total_tag_score, 0) as top_tag_score,
    COALESCE(ba.gold_badges, 0) as gold_badges,
    COALESCE(ba.silver_badges, 0) as silver_badges,
    COALESCE(ba.bronze_badges, 0) as bronze_badges,
    COALESCE(ba.gold_badge_names, 'NONE') as gold_badge_names,
    COALESCE(eh.edit_count, 0) as edit_count,
    COALESCE(eh.rollback_count, 0) as rollback_count,
    ROUND(COALESCE(eh.edit_to_rollback_ratio, 0), 2) as edit_to_rollback_ratio,
    (SELECT COUNT(DISTINCT c.Id) 
     FROM Comments c 
     WHERE c.UserId = ua.Id 
        AND c.Score > 5
        AND EXISTS (
            SELECT 1 
            FROM Posts p 
            WHERE p.Id = c.PostId 
                AND p.Score > 100
        )) as high_value_comments,
    COALESCE((
        SELECT STRING_AGG(CONCAT(u2.DisplayName, '(', inn.interaction_count, ')'), ', ' ORDER BY inn.interaction_count DESC)
        FROM interaction_network inn
        INNER JOIN Users u2 ON inn.answerer_id = u2.Id
        WHERE inn.questioner_id = ua.Id
            AND inn.accepted_answers > 0
        LIMIT 3
    ), 'NO_INTERACTIONS') as top_answerers,
    CASE 
        WHEN ua.last_post_date > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days' THEN 'VERY_ACTIVE'
        WHEN ua.last_post_date > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days' THEN 'ACTIVE'
        WHEN ua.last_post_date > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '365 days' THEN 'MODERATE'
        WHEN ua.last_post_date IS NOT NULL THEN 'INACTIVE'
        ELSE 'NO_POSTS'
    END as activity_level,
    EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - ua.last_post_date)) / 86400 as days_since_last_post,
    LAG(ua.Reputation) OVER (ORDER BY ua.Reputation DESC) - ua.Reputation as rep_gap_to_next,
    DENSE_RANK() OVER (ORDER BY ua.Reputation DESC, ua.post_count DESC) as overall_rank
FROM user_activity ua
LEFT JOIN top_tags tt ON ua.Id = tt.OwnerUserId AND tt.tag_rank = 1
LEFT JOIN badge_analysis ba ON ua.Id = ba.UserId
LEFT JOIN edit_history eh ON ua.Id = eh.UserId
WHERE ua.post_count > 10
    AND (ua.question_count > 0 OR ua.answer_count > 5)
    AND NOT EXISTS (
        SELECT 1 
        FROM PostHistory ph 
        WHERE ph.UserId = ua.Id 
            AND ph.PostHistoryTypeId = 12
            AND ph.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '180 days'
    )
ORDER BY 
    ua.Reputation DESC,
    COALESCE(ba.gold_badges, 0) * 100 + COALESCE(ba.silver_badges, 0) * 10 + COALESCE(ba.bronze_badges, 0) DESC,
    ua.avg_post_score DESC NULLS LAST
LIMIT 100;