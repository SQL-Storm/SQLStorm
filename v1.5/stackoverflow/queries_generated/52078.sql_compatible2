WITH UserPostStats AS (
    SELECT 
        p.OwnerUserId,
        COUNT(*) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
        AVG(p.Score) AS AvgScore,
        MAX(p.CreationDate) AS LastPostDate
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
UserVoteStats AS (
    SELECT 
        v.PostId,
        p.OwnerUserId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvoteCount,
        SUM(CASE WHEN v.VoteTypeId = 8 THEN 1 ELSE 0 END) AS BountyStarts,
        SUM(v.BountyAmount) AS TotalBountyAmount
    FROM Votes v
    INNER JOIN Posts p ON v.PostId = p.Id
    WHERE v.VoteTypeId IN (2, 3, 8) AND p.OwnerUserId IS NOT NULL
    GROUP BY v.PostId, p.OwnerUserId
),
UserBadgeStats AS (
    SELECT 
        b.UserId,
        COUNT(*) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        SUM(CASE WHEN b.TagBased = 1 THEN 1 ELSE 0 END) AS TagBasedBadges
    FROM Badges b
    GROUP BY b.UserId
),
CommentStats AS (
    SELECT 
        c.UserId,
        COUNT(*) AS TotalComments,
        AVG(c.Score) AS AvgCommentScore
    FROM Comments c
    WHERE c.UserId IS NOT NULL
    GROUP BY c.UserId
),
TagPostCounts AS (
    SELECT 
        p.Id AS PostId,
        UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><')) AS TagName
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
),
UserTagActivity AS (
    SELECT 
        p.OwnerUserId,
        tpc.TagName,
        COUNT(*) AS PostsInTag
    FROM TagPostCounts tpc
    INNER JOIN Posts p ON tpc.PostId = p.Id
    INNER JOIN Tags t ON t.TagName = tpc.TagName
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId, tpc.TagName
    ORDER BY p.OwnerUserId, COUNT(*) DESC
    LIMIT 100000
),
TopUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        ups.TotalPosts,
        ups.QuestionCount,
        ups.AnswerCount,
        ups.AvgScore,
        COALESCE(uvs.TotalUpvotes, 0) AS TotalUpvotesReceived,
        COALESCE(uvs.TotalDownvotes, 0) AS TotalDownvotesReceived,
        COALESCE(uvs.TotalBounties, 0) AS TotalBountiesReceived,
        COALESCE(uvs.TotalBountyAmount, 0) AS TotalBountyAmountReceived,
        COALESCE(ubs.TotalBadges, 0) AS TotalBadges,
        COALESCE(ubs.GoldBadges, 0) AS GoldBadges,
        COALESCE(ubs.SilverBadges, 0) AS SilverBadges,
        COALESCE(ubs.BronzeBadges, 0) AS BronzeBadges,
        COALESCE(cs.TotalComments, 0) AS TotalComments,
        COALESCE(cs.AvgCommentScore, 0) AS AvgCommentScore
    FROM Users u
    LEFT JOIN (
        SELECT OwnerUserId,
               COUNT(*) AS TotalUpvotes,
               SUM(DownvoteCount) AS TotalDownvotes,
               SUM(BountyStarts) AS TotalBounties,
               SUM(TotalBountyAmount) AS TotalBountyAmount
        FROM UserVoteStats
        GROUP BY OwnerUserId
    ) uvs ON u.Id = uvs.OwnerUserId
    LEFT JOIN UserPostStats ups ON u.Id = ups.OwnerUserId
    LEFT JOIN UserBadgeStats ubs ON u.Id = ubs.UserId
    LEFT JOIN CommentStats cs ON u.Id = cs.UserId
    WHERE CAST(u.Reputation AS bigint) > 1000 AND COALESCE(ups.TotalPosts, 0) > 10
)
SELECT tu.*,
       ARRAY_AGG(DISTINCT uta.TagName || ':' || uta.PostsInTag) FILTER (WHERE uta.OwnerUserId = tu.Id) AS TopTagsAndPosts
FROM TopUsers tu
LEFT JOIN UserTagActivity uta ON tu.Id = uta.OwnerUserId
GROUP BY tu.Id, tu.DisplayName, tu.Reputation, tu.CreationDate, tu.TotalPosts, tu.QuestionCount, tu.AnswerCount, tu.AvgScore, tu.TotalUpvotesReceived, tu.TotalDownvotesReceived, tu.TotalBountiesReceived, tu.TotalBountyAmountReceived, tu.TotalBadges, tu.GoldBadges, tu.SilverBadges, tu.BronzeBadges, tu.TotalComments, tu.AvgCommentScore
ORDER BY tu.Reputation DESC, tu.TotalPosts DESC
LIMIT 500;