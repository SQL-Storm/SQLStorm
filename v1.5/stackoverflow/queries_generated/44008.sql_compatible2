WITH cte AS (
    SELECT p.Id, p.PostTypeId, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount,
           u.Reputation, u.CreationDate AS UserCreationDate, u.Views, u.UpVotes, u.DownVotes,
           b.Id AS BadgeId, b.Name AS BadgeName, b.Date AS BadgeDate, b.Class AS BadgeClass, b.TagBased AS BadgeTagBased,
           l.Id AS LinkId, l.LinkTypeId, l.RelatedPostId,
           v.Id AS VoteId, v.VoteTypeId, v.CreationDate AS VoteCreationDate, v.BountyAmount
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN PostLinks l ON p.Id = l.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.PostTypeId IN (1, 2)
      AND p.CreationDate BETWEEN TIMESTAMP '2021-01-01 00:00:00' AND TIMESTAMP '2021-12-31 23:59:59'
),
aggregated AS (
    SELECT Id,
           PostTypeId,
           OwnerUserId,
           CreationDate,
           Score,
           ViewCount,
           AnswerCount,
           CommentCount,
           FavoriteCount,
           Reputation,
           UserCreationDate,
           Views,
           UpVotes,
           DownVotes,
           COUNT(DISTINCT CAST(BadgeId AS BIGINT)) AS NumBadges,
           COUNT(DISTINCT CASE WHEN BadgeTagBased = 1 THEN CAST(BadgeId AS BIGINT) END) AS NumTagBadges,
           COUNT(DISTINCT CASE WHEN BadgeClass = 1 THEN CAST(BadgeId AS BIGINT) END) AS NumGoldBadges,
           COUNT(DISTINCT CASE WHEN BadgeClass = 2 THEN CAST(BadgeId AS BIGINT) END) AS NumSilverBadges,
           COUNT(DISTINCT CASE WHEN BadgeClass = 3 THEN CAST(BadgeId AS BIGINT) END) AS NumBronzeBadges,
           COUNT(DISTINCT CAST(LinkId AS BIGINT)) AS NumLinks,
           COUNT(DISTINCT CASE WHEN LinkTypeId = 1 THEN CAST(LinkId AS BIGINT) END) AS NumLinkedPosts,
           COUNT(DISTINCT CASE WHEN LinkTypeId = 3 THEN CAST(LinkId AS BIGINT) END) AS NumDuplicatePosts,
           COUNT(DISTINCT CAST(VoteId AS BIGINT)) AS NumVotes,
           COUNT(DISTINCT CASE WHEN VoteTypeId = 2 THEN CAST(VoteId AS BIGINT) END) AS NumUpVotes,
           COUNT(DISTINCT CASE WHEN VoteTypeId = 3 THEN CAST(VoteId AS BIGINT) END) AS NumDownVotes,
           COUNT(DISTINCT CASE WHEN VoteTypeId = 8 THEN CAST(VoteId AS BIGINT) END) AS NumBountyStarts,
           COUNT(DISTINCT CASE WHEN VoteTypeId = 9 THEN CAST(VoteId AS BIGINT) END) AS NumBountyClosed,
           SUM(COALESCE(v.BountyAmount, 0)) AS TotalBounty
    FROM cte
    GROUP BY Id,
             PostTypeId,
             OwnerUserId,
             CreationDate,
             Score,
             ViewCount,
             AnswerCount,
             CommentCount,
             FavoriteCount,
             Reputation,
             UserCreationDate,
             Views,
             UpVotes,
             DownVotes
)
SELECT *
FROM aggregated
ORDER BY NumVotes DESC
LIMIT 100;