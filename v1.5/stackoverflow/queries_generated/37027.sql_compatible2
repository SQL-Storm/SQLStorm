WITH RECURSIVE
ActiveUsers AS (
  SELECT u.Id AS UserId,
         u.DisplayName,
         u.Reputation,
         u.CreationDate,
         (COALESCE(pq.QuestionCount,0)*5 + COALESCE(pa.AnswerCount,0)*3 + COALESCE(c.CommentCount,0)*1
          + COALESCE(v.VoteCount,0)*0.5 + COALESCE(b.BadgeScore,0)*2
          + CASE WHEN u.LastAccessDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30 days' THEN 20 ELSE 0 END) AS EngagementScore,
         GREATEST(COALESCE(u.LastAccessDate, TIMESTAMP '1970-01-01'), COALESCE(u.CreationDate, TIMESTAMP '1970-01-01')) AS RecentActivity
  FROM Users u
  LEFT JOIN (
      SELECT OwnerUserId, COUNT(*) AS QuestionCount
      FROM Posts
      WHERE PostTypeId = 1 AND CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
      GROUP BY OwnerUserId
  ) pq ON pq.OwnerUserId = u.Id
  LEFT JOIN (
      SELECT OwnerUserId, COUNT(*) AS AnswerCount
      FROM Posts
      WHERE PostTypeId = 2 AND CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
      GROUP BY OwnerUserId
  ) pa ON pa.OwnerUserId = u.Id
  LEFT JOIN (
      SELECT UserId, COUNT(*) AS CommentCount
      FROM Comments
      WHERE CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
      GROUP BY UserId
  ) c ON c.UserId = u.Id
  LEFT JOIN (
      SELECT UserId, COUNT(*) AS VoteCount
      FROM Votes
      WHERE CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
      GROUP BY UserId
  ) v ON v.UserId = u.Id
  LEFT JOIN (
      SELECT UserId, SUM(CASE Class WHEN 1 THEN 5 WHEN 2 THEN 3 WHEN 3 THEN 1 ELSE 0 END) AS BadgeScore
      FROM Badges
      WHERE Date >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
      GROUP BY UserId
  ) b ON b.UserId = u.Id
  WHERE u.Id IS NOT NULL
),
TopUsers AS (
  SELECT UserId, DisplayName, Reputation, EngagementScore, RecentActivity,
         ROW_NUMBER() OVER (ORDER BY EngagementScore DESC, Reputation DESC, RecentActivity DESC) AS rn
  FROM ActiveUsers
),
SelectedUsers AS (
  SELECT UserId, DisplayName, Reputation, EngagementScore
  FROM TopUsers
  WHERE rn <= 100
),
UserPostStats AS (
  SELECT su.UserId,
         COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS Questions,
         COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS Answers,
         AVG(CASE WHEN p.PostTypeId IN (1,2) THEN p.Score END) AS AvgPostScore,
         MAX(p.Score) AS MaxPostScore,
         SUM(p.ViewCount) FILTER (WHERE p.PostTypeId = 1) AS TotalQuestionViews,
         COUNT(DISTINCT unq.Tag) AS DistinctTagsUsed
  FROM SelectedUsers su
  LEFT JOIN Posts p ON p.OwnerUserId = su.UserId
  LEFT JOIN LATERAL (
      SELECT unnest(string_to_array(substring(p.Tags from 2 for greatest(length(p.Tags)-2,0)), '><')) AS Tag
  ) unq ON p.Tags IS NOT NULL AND p.Tags <> ''
  GROUP BY su.UserId
),
UserAnswerImpact AS (
  SELECT su.UserId,
         COUNT(a.Id) AS AnswerCountRecent,
         AVG(CASE WHEN q.AcceptedAnswerId = a.Id THEN 1.0 ELSE 0 END) AS AcceptanceRate,
         MAX(a.Score) AS MaxAnswerScore,
         SUM(q.ViewCount) AS ViewsOnAnsweredQuestions,
         COUNT(DISTINCT q.Id) FILTER (WHERE q.Score >= 10 OR q.ViewCount >= 1000) AS HighImpactAnswers
  FROM SelectedUsers su
  LEFT JOIN Posts a ON a.OwnerUserId = su.UserId AND a.PostTypeId = 2
      AND a.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
  LEFT JOIN Posts q ON q.Id = a.ParentId
  GROUP BY su.UserId
),
UserTagAffinity AS (
  SELECT t.UserId, t.Tag, t.Cnt,
         ROW_NUMBER() OVER (PARTITION BY t.UserId ORDER BY t.Cnt DESC, t.Tag) AS rk
  FROM (
    SELECT p.OwnerUserId AS UserId,
           unnest(string_to_array(substring(p.Tags from 2 for greatest(length(p.Tags)-2,0)), '><')) AS Tag,
           COUNT(*) AS Cnt
    FROM Posts p
    JOIN SelectedUsers su ON su.UserId = p.OwnerUserId
    WHERE p.Tags IS NOT NULL AND p.Tags <> ''
    GROUP BY p.OwnerUserId, Tag
  ) t
),
TopTagsPerUser AS (
  SELECT UserId,
         max(CASE WHEN rk=1 THEN Tag END) AS TopTag1,
         max(CASE WHEN rk=1 THEN Cnt END) AS TopTag1Count,
         max(CASE WHEN rk=2 THEN Tag END) AS TopTag2,
         max(CASE WHEN rk=2 THEN Cnt END) AS TopTag2Count,
         max(CASE WHEN rk=3 THEN Tag END) AS TopTag3,
         max(CASE WHEN rk=3 THEN Cnt END) AS TopTag3Count
  FROM UserTagAffinity
  WHERE rk <= 3
  GROUP BY UserId
),
UserMonthlyActivity AS (
  SELECT su.UserId,
         ARRAY_AGG(COALESCE(cnt,0) ORDER BY month_start) AS MonthlyCounts
  FROM (
    SELECT generate_series(date_trunc('month', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '23 months'),
                           date_trunc('month', CAST('2024-10-01 12:34:56' AS TIMESTAMP)), INTERVAL '1 month') AS month_start
  ) m
  CROSS JOIN SelectedUsers su
  LEFT JOIN LATERAL (
    SELECT date_trunc('month', CreationDate) AS month_start, COUNT(*) AS cnt
    FROM (
       SELECT CreationDate FROM Posts WHERE OwnerUserId = su.UserId AND CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '24 months'
       UNION ALL
       SELECT CreationDate FROM Comments WHERE UserId = su.UserId AND CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '24 months'
       UNION ALL
       SELECT CreationDate FROM Votes WHERE UserId = su.UserId AND CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '24 months'
    ) allacts
    GROUP BY date_trunc('month', CreationDate)
  ) a ON a.month_start = m.month_start
  GROUP BY su.UserId
),
UserNetwork AS (
  SELECT su.UserId,
         COUNT(DISTINCT CASE WHEN c.UserId IS NOT NULL THEN c.UserId END) AS DistinctCommenters,
         COUNT(DISTINCT CASE WHEN v.UserId IS NOT NULL THEN v.UserId END) AS DistinctVoters,
         COUNT(DISTINCT CASE WHEN a.OwnerUserId IS NOT NULL THEN a.OwnerUserId END) AS DistinctAnswerers
  FROM SelectedUsers su
  LEFT JOIN Posts p ON p.OwnerUserId = su.UserId
  LEFT JOIN Comments c ON c.PostId = p.Id
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
  GROUP BY su.UserId
),
UserControversy AS (
  SELECT su.UserId,
         COUNT(p.Id) FILTER (WHERE p.Score >= 0 AND p.CommentCount >= 10 AND EXISTS (
             SELECT 1 FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3
         )) AS ControversialPosts
  FROM SelectedUsers su
  LEFT JOIN Posts p ON p.OwnerUserId = su.UserId
  GROUP BY su.UserId
),
UserAnalytics AS (
  SELECT su.UserId,
         su.DisplayName,
         su.Reputation,
         su.EngagementScore,
         ups.Questions, ups.Answers, ups.AvgPostScore, ups.MaxPostScore, ups.TotalQuestionViews, ups.DistinctTagsUsed,
         uai.AnswerCountRecent, uai.AcceptanceRate, uai.MaxAnswerScore, uai.ViewsOnAnsweredQuestions, uai.HighImpactAnswers,
         tt.TopTag1, tt.TopTag1Count, tt.TopTag2, tt.TopTag2Count, tt.TopTag3, tt.TopTag3Count,
         uma.MonthlyCounts,
         un.DistinctCommenters, un.DistinctVoters, un.DistinctAnswerers,
         uc.ControversialPosts,
         (CASE WHEN ups.Answers > 0 THEN ROUND(uai.ViewsOnAnsweredQuestions / ups.Answers, 2) ELSE 0 END) AS AvgViewsPerAnswer,
         (CASE WHEN ups.Questions > 0 THEN ROUND(ups.TotalQuestionViews / ups.Questions, 2) ELSE 0 END) AS AvgViewsPerQuestion,
         (CASE WHEN (un.DistinctCommenters + un.DistinctVoters + un.DistinctAnswerers) > 0
               THEN ROUND((un.DistinctCommenters) / (GREATEST(un.DistinctVoters,1)), 2) ELSE 0 END) AS CommenterToVoterRatio
  FROM SelectedUsers su
  LEFT JOIN UserPostStats ups ON ups.UserId = su.UserId
  LEFT JOIN UserAnswerImpact uai ON uai.UserId = su.UserId
  LEFT JOIN TopTagsPerUser tt ON tt.UserId = su.UserId
  LEFT JOIN UserMonthlyActivity uma ON uma.UserId = su.UserId
  LEFT JOIN UserNetwork un ON un.UserId = su.UserId
  LEFT JOIN UserControversy uc ON uc.UserId = su.UserId
)
SELECT ua.*,
       ROUND(
         (ua.EngagementScore * 0.4
          + COALESCE(ua.AvgPostScore,0) * 3
          + COALESCE(ua.AcceptanceRate,0) * 50
          + COALESCE(ua.HighImpactAnswers,0) * 10
          + (COALESCE(ua.TopTag1Count,0) + COALESCE(ua.TopTag2Count,0) + COALESCE(ua.TopTag3Count,0)) * 2
          - COALESCE(ua.ControversialPosts,0) * 5) numeric,2) AS CompositeRankScore
FROM UserAnalytics ua
ORDER BY CompositeRankScore DESC, ua.EngagementScore DESC, ua.Reputation DESC
LIMIT 100;