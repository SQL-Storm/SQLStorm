WITH
RecentHigh AS (
    SELECT
        p.Id,
        p.Title,
        p.Tags,
        p.Score,
        u.DisplayName,
        p.CreationDate,
        ROW_NUMBER() OVER (
            PARTITION BY
                SUBSTRING(p.Tags FROM 2 FOR POSITION('><' IN (p.Tags || '><')) - 2)
            ORDER BY p.Score DESC
        ) AS TagRank
    FROM Posts AS p
    LEFT JOIN Users AS u
        ON p.OwnerUserId = u.Id
    WHERE
        p.PostTypeId = 1
        AND p.CreationDate >= DATEADD(day, -30, CAST('2024-10-01 12:34:56' AS TIMESTAMP))
),

AnswerStats AS (
    SELECT
        q.Id AS QuestionId,
        COUNT(a.Id)                                   AS AnswerCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS AnswerUpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS AnswerDownVotes,
        AVG(CASE WHEN v.VoteTypeId IN (2,3) THEN CAST(v.VoteTypeId AS FLOAT) * 1.0 ELSE NULL END) AS AvgVoteType
    FROM Posts AS q
    LEFT JOIN Posts AS a
        ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN Votes AS v
        ON v.PostId = a.Id
    WHERE
        q.PostTypeId = 1
    GROUP BY
        q.Id
),

CommentInsights AS (
    SELECT
        c.PostId,
        MAX(c.Score)                           AS MaxCommentScore,
        MIN(LEN(c.Text))                       AS MinCommentLen,
        COUNT(DISTINCT c.UserId)               AS DistinctCommenters,
        CAST(',' AS VARCHAR(1)) AS dummy
        /* Rebuild tokenizer for portability below */
    FROM Comments AS c
    GROUP BY c.PostId

    UNION ALL

    SELECT
        c.PostId,
        MAX(c.Score)                           AS MaxCommentScore,
        MIN(LEN(c.Text))                       AS MinCommentLen,
        COUNT(DISTINCT c.UserId)               AS DistinctCommenters,
        '' AS dummy
    FROM Comments AS c
    GROUP BY c.PostId
),

HistoryCount AS (
    SELECT
        ph.PostId,
        COUNT(*) AS EditCountLastWeek
    FROM PostHistory AS ph
    WHERE ph.CreationDate >= DATEADD(week, -1, CAST('2024-10-01 12:34:56' AS TIMESTAMP))
    GROUP BY ph.PostId
)

SELECT
    rh.Id,
    rh.Title,
    rh.DisplayName              AS Asker,
    rh.Score                    AS QuestionScore,
    COALESCE(ans.AnswerCount, 0)                                     AS TotalAnswers,
    COALESCE(ans.AnswerUpVotes, 0) - COALESCE(ans.AnswerDownVotes, 0)   AS NetAnswerVotes,
    ci.MaxCommentScore,
    hc.EditCountLastWeek,
    CASE WHEN rh.TagRank = 1 THEN 'TopTagQ' ELSE 'OtherTagQ' END    AS RankCategory,
    (LENGTH(rh.Tags) - LENGTH(REPLACE(rh.Tags, '<', ''))) / 2             AS TagCount,
    rh.CreationDate,
    (
        SELECT COUNT(*)
        FROM PostLinks AS pl
        WHERE pl.PostId = rh.Id
          AND pl.LinkTypeId = 1
    )                                                             AS OutgoingLinks
FROM RecentHigh AS rh
LEFT JOIN AnswerStats AS ans
    ON rh.Id = ans.QuestionId
LEFT JOIN CommentInsights AS ci
    ON rh.Id = ci.PostId
LEFT JOIN HistoryCount AS hc
    ON rh.Id = hc.PostId
WHERE rh.TagRank <= 3

UNION ALL

SELECT
    p.Id,
    p.Title,
    COALESCE(u.DisplayName, '') AS DisplayName,
    p.Score,
    0,
    0,
    NULL,
    NULL,
    'RecentQ',
    (LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '<', ''))) / 2,
    p.CreationDate,
    0
FROM Posts AS p
LEFT JOIN Users AS u
    ON p.OwnerUserId = u.Id
WHERE p.PostTypeId = 1
ORDER BY CreationDate DESC
LIMIT 5

EXCEPT

SELECT
    p.Id,
    p.Title,
    COALESCE(u.DisplayName, '<anon>') AS DisplayName,
    p.Score,
    COALESCE(ans.AnswerCount, 0),
    COALESCE(ans.AnswerUpVotes, 0) - COALESCE(ans.AnswerDownVotes, 0),
    ci.MaxCommentScore,
    hc.EditCountLastWeek,
    'FilteredNeg' AS RankCategory,
    (LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '<', ''))) / 2,
    p.CreationDate,
    (
        SELECT COUNT(*)
        FROM PostLinks AS pl
        WHERE pl.PostId = p.Id
          AND pl.LinkTypeId = 1
    )
FROM Posts AS p
LEFT JOIN Users AS u
    ON p.OwnerUserId = u.Id
LEFT JOIN AnswerStats AS ans
    ON p.Id = ans.QuestionId
LEFT JOIN CommentInsights AS ci
    ON p.Id = ci.PostId
LEFT JOIN HistoryCount AS hc
    ON p.Id = hc.PostId
WHERE p.Score < 0;