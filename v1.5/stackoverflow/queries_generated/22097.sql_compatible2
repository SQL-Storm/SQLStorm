WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) AS TotalPosts,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgScore,
        STRING_AGG(DISTINCT LOWER(SPLIT_PART(t.TagName, ' ', 1)), ', ') AS TopTags
    FROM Users AS u
    LEFT JOIN Posts AS p ON u.Id = p.OwnerUserId AND p.PostTypeId IN (1, 2)
    LEFT JOIN LATERAL (
        SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><')) AS Tag
        FROM Tags t
        WHERE t.TagName = UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><'))
        LIMIT 1
    ) AS tag_sub ON TRUE
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
BadgeStats AS (
    SELECT 
        UserId,
        COUNT(*) AS TotalBadges,
        COUNT(CASE WHEN Class = 1 THEN 1 END) AS GoldBadges,
        SUM(CASE WHEN Name LIKE '%Editor%' THEN 1 ELSE 0 END) AS EditorBadges
    FROM Badges
    GROUP BY UserId
),
RankedUsers AS (
    SELECT 
        us.*,
        bs.TotalBadges,
        bs.GoldBadges,
        bs.EditorBadges,
        ROW_NUMBER() OVER (ORDER BY us.TotalScore DESC, us.Reputation DESC) AS OverallRank,
        RANK() OVER (PARTITION BY CASE WHEN us.TotalPosts > 0 THEN 1 ELSE 0 END ORDER BY us.AvgScore DESC) AS ScoreRank
    FROM UserStats AS us
    LEFT JOIN BadgeStats AS bs ON us.UserId = bs.UserId
)
SELECT 
    ru.UserId,
    ru.DisplayName,
    ru.Reputation,
    ru.TotalPosts,
    ru.TotalScore,
    ru.AvgScore,
    ru.TopTags,
    ru.TotalBadges,
    ru.GoldBadges,
    ru.EditorBadges,
    ru.OverallRank,
    ru.ScoreRank,
    CASE 
        WHEN ru.TotalPosts IS NULL OR ru.TotalPosts = 0 THEN 'Inactive'
        WHEN ru.TotalScore > (SELECT AVG(TotalScore) FROM RankedUsers WHERE TotalScore > 0) THEN 'High Performer'
        ELSE 'Average'
    END AS PerformanceCategory,
    (
        SELECT COUNT(*) 
        FROM Votes AS v
        WHERE v.UserId = ru.UserId 
          AND v.VoteTypeId IN (2, 3)
          AND v.CreationDate > CAST(ru.UserId AS VARCHAR) || '-01-01'
    ) AS RecentVotes,
    STRING_TO_ARRAY(ru.TopTags, ', ') AS TagArray
FROM RankedUsers AS ru
WHERE ru.OverallRank <= 100
   AND EXISTS (
       SELECT 1 
       FROM Posts AS p 
       WHERE p.OwnerUserId = ru.UserId 
         AND p.Score > (
             SELECT AVG(pp.Score) 
             FROM Posts AS pp 
             WHERE pp.OwnerUserId = ru.UserId
         )
         AND p.ClosedDate IS NULL
   )
   AND NOT EXISTS (
       SELECT 1 
       FROM PostHistory AS ph 
       WHERE ph.UserId = ru.UserId 
         AND ph.PostHistoryTypeId IN (12, 13)
         AND ph.CreationDate > CAST('2024-10-01' AS DATE) - INTERVAL '1 year'
   )
UNION ALL
SELECT 
    ru.UserId,
    ru.DisplayName,
    ru.Reputation,
    ru.TotalPosts,
    ru.TotalScore,
    ru.AvgScore,
    ru.TopTags,
    ru.TotalBadges,
    ru.GoldBadges,
    ru.EditorBadges,
    ru.OverallRank,
    ru.ScoreRank,
    'Moderator' AS PerformanceCategory,
    NULL AS RecentVotes,
    NULL AS TagArray
FROM RankedUsers AS ru
INNER JOIN (
    SELECT DISTINCT UserId FROM Badges WHERE Name = 'Moderator'
) AS mods ON ru.UserId = mods.UserId
ORDER BY Reputation DESC
LIMIT 200;