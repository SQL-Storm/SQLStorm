WITH UserStats AS (
    SELECT 
        u.Id,
        u.Reputation,
        u.CreationDate,
        COUNT(b.Id) AS BadgeCount,
        RANK() OVER (PARTITION BY b.Class ORDER BY COUNT(b.Id) DESC) AS BadgeRank,
        SUM(CASE WHEN b.Class = 1 THEN 3 WHEN b.Class = 2 THEN 2 ELSE 1 END) AS WeightedBadgeScore
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.Reputation, u.CreationDate, b.Class
), PostAnalysis AS (
    SELECT 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        COALESCE(p.Tags, '') AS ProcessedTags,
        (SELECT MAX(ph.CreationDate) 
         FROM PostHistory ph 
         WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4,5,6)) AS LastEditDate,
        AVG(c.Score) FILTER (WHERE c.Score IS NOT NULL) AS AvgCommentScore,
        COUNT(DISTINCT v.Id) AS TotalVotes
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.PostTypeId = 1
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.Tags
    HAVING COUNT(c.Id) > 5 OR COUNT(v.Id) > 10
)
SELECT 
    pa.Id AS PostId,
    pa.Title,
    (pa.Score * 1.0) / NULLIF(pa.ViewCount, 0) AS EngagementRatio,
    STRING_AGG(lt.Name, '; ') AS LinkTypes,
    us.WeightedBadgeScore * LOG(us.Reputation) AS UserInfluence,
    (SELECT COUNT(*) 
     FROM PostLinks pl 
     WHERE pl.PostId = pa.Id AND pl.LinkTypeId = 3) AS DuplicateCount,
    ROW_NUMBER() OVER (ORDER BY pa.AvgCommentScore DESC) AS CommentRank,
    CASE 
        WHEN pa.ProcessedTags LIKE '%<sql>%' THEN 1 
        WHEN pa.ProcessedTags LIKE '%<python>%' THEN 2 
        ELSE 0 
    END AS TagCategory,
    COALESCE(ph.Comment, 'No close reason') AS CloseReason,
    COUNT(*) OVER (PARTITION BY us.BadgeRank) AS UsersPerBadgeRank
FROM PostAnalysis pa
INNER JOIN Users u ON pa.Id = u.Id
LEFT JOIN UserStats us ON u.Id = us.Id
LEFT JOIN PostHistory ph ON pa.Id = ph.PostId AND ph.PostHistoryTypeId = 10
LEFT JOIN PostLinks pl ON pa.Id = pl.PostId
LEFT JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
WHERE pa.LastEditDate BETWEEN TIMESTAMP '2019-01-01 00:00:00' AND TIMESTAMP '2023-01-01 00:00:00'
  AND (us.WeightedBadgeScore > 10 OR (pa.Score * 1.0) / NULLIF(pa.ViewCount, 0) > 0.001)
  AND CAST((ph.Text ->> 'CloseReasonId') AS integer) IN (101,102,103)
UNION ALL
SELECT 
    p.Id,
    p.Title,
    NULL,
    NULL,
    NULL,
    (SELECT COUNT(*) FROM Votes WHERE PostId = p.Id AND VoteTypeId = 2) - 
    (SELECT COUNT(*) FROM Votes WHERE PostId = p.Id AND VoteTypeId = 3),
    0,
    CASE 
        WHEN EXISTS (SELECT 1 FROM PostHistory WHERE PostId = p.Id AND PostHistoryTypeId = 19) THEN 3 
        ELSE 0 
    END,
    'Open post',
    NULL
FROM Posts p
WHERE p.ClosedDate IS NULL
  AND p.PostTypeId = 1
  AND p.Score > 50
ORDER BY EngagementRatio DESC NULLS LAST, UserInfluence DESC
LIMIT 100;