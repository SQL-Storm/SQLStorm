WITH top_users AS (
    SELECT u.Id, u.DisplayName, u.Reputation, 
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS row_num
    FROM Users u
    WHERE u.Reputation > 10000
),
top_posts AS (
    SELECT p.Id, p.Title, p.Score, p.ViewCount, p.OwnerUserId,
    ROW_NUMBER() OVER (ORDER BY p.ViewCount DESC) AS row_num
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.Score > 10
),
post_links AS (
    SELECT pl.PostId, pl.RelatedPostId, lt.Name AS LinkTypeName
    FROM PostLinks pl
    JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
    WHERE pl.CreationDate > DATE '2020-01-01'
),
votes AS (
    SELECT v.PostId, v.VoteTypeId, vt.Name AS VoteTypeName
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    WHERE v.CreationDate > DATE '2020-01-01'
),
post_history AS (
    SELECT ph.PostId, ph.PostHistoryTypeId, pht.Name AS PostHistoryTypeName
    FROM PostHistory ph
    JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
    WHERE ph.CreationDate > DATE '2020-01-01'
)
SELECT 
    tu.DisplayName AS TopUserDisplayName, 
    tu.Reputation AS TopUserReputation, 
    tp.Title AS TopPostTitle, 
    tp.Score AS TopPostScore, 
    pl.LinkTypeName, 
    v.VoteTypeName, 
    ph.PostHistoryTypeName, 
    COUNT(DISTINCT pl.RelatedPostId) AS RelatedPostCount, 
    COUNT(DISTINCT v.VoteTypeId) AS VoteCount, 
    COUNT(DISTINCT ph.PostHistoryTypeId) AS PostHistoryCount
FROM top_users tu
LEFT JOIN top_posts tp ON tu.Id = tp.OwnerUserId
LEFT JOIN post_links pl ON tp.Id = pl.PostId
LEFT JOIN votes v ON tp.Id = v.PostId
LEFT JOIN post_history ph ON tp.Id = ph.PostId
WHERE tu.row_num <= 10 AND tp.row_num <= 10
GROUP BY
    tu.DisplayName,
    tu.Reputation,
    tp.Title,
    tp.Score,
    pl.LinkTypeName,
    v.VoteTypeName,
    ph.PostHistoryTypeName
HAVING COUNT(DISTINCT pl.RelatedPostId) > 5
   AND COUNT(DISTINCT v.VoteTypeId) > 2
   AND COUNT(DISTINCT ph.PostHistoryTypeId) > 1
ORDER BY
    tu.Reputation DESC,
    tp.ViewCount DESC;