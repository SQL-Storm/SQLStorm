WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.Reputation,
        u.DisplayName,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        MAX(p.CreationDate) as LastPostDate,
        MAX(c.CreationDate) as LastCommentDate,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT c.Id) DESC) as CommentRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.Reputation, u.DisplayName
),
TopPosts AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) as ScoreRank,
        CASE 
            WHEN p.Score > 100 THEN 'High'
            WHEN p.Score > 50 THEN 'Medium'
            ELSE 'Low'
        END as ScoreCategory,
        COALESCE(
            (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id),
            0
        ) as CommentCount,
        CASE 
            WHEN p.Tags IS NOT NULL AND LENGTH(p.Tags) > 2 THEN 
                (SELECT COUNT(*) FROM unnest(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) as tag WHERE tag != '')
            ELSE 0
        END as TagCount
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) -- Questions and Answers
),
UserPostAnalysis AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        ua.PostCount,
        ua.CommentCount,
        ua.BadgeCount,
        CASE 
            WHEN ua.PostCount > 100 THEN 'Active'
            WHEN ua.PostCount > 50 THEN 'Moderate'
            ELSE 'Casual'
        END as ActivityLevel,
        CASE 
            WHEN ua.CommentCount > 50 THEN 'Commenter'
            WHEN ua.CommentCount > 10 THEN 'Occasional Commenter'
            ELSE 'Rare Commenter'
        END as CommentLevel,
        CASE 
            WHEN ua.BadgeCount > 20 THEN 'Badge Collector'
            WHEN ua.BadgeCount > 10 THEN 'Moderate Collector'
            ELSE 'Casual Collector'
        END as BadgeLevel,
        DATEDIFF(day, ua.LastPostDate, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) as DaysSinceLastPost,
        DATEDIFF(day, ua.LastCommentDate, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) as DaysSinceLastComment
    FROM Users u
    INNER JOIN UserActivityStats ua ON u.Id = ua.UserId
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count as TagCount,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 500 THEN 'Moderate'
            ELSE 'Niche'
        END as PopularityLevel,
        CASE 
            WHEN t.IsRequired = 1 THEN 'Required'
            WHEN t.IsModeratorOnly = 1 THEN 'Moderator Only'
            ELSE 'Standard'
        END as TagType
    FROM Tags t
    WHERE t.Count > 100
),
ComplexMetrics AS (
    SELECT 
        u.UserId,
        u.DisplayName,
        u.Reputation,
        u.PostCount,
        u.CommentCount,
        u.BadgeCount,
        u.ActivityLevel,
        u.CommentLevel,
        u.BadgeLevel,
        u.DaysSinceLastPost,
        u.DaysSinceLastComment,
        CASE 
            WHEN u.PostCount > 0 AND u.CommentCount > 0 THEN 
                CAST(u.CommentCount AS FLOAT) / CAST(u.PostCount AS FLOAT)
            ELSE 0
        END as CommentPerPostRatio,
        CASE 
            WHEN u.Reputation > 0 THEN 
                CAST(u.BadgeCount AS FLOAT) / CAST(u.Reputation AS FLOAT) * 1000
            ELSE 0
        END as BadgePerRepRatio,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
        DENSE_RANK() OVER (ORDER BY u.PostCount DESC) as PostRank,
        DENSE_RANK() OVER (ORDER BY u.CommentCount DESC) as CommentRank,
        DENSE_RANK() OVER (ORDER BY u.BadgeCount DESC) as BadgeRank
    FROM UserPostAnalysis u
),
FinalAnalysis AS (
    SELECT 
        cm.UserId,
        cm.DisplayName,
        cm.Reputation,
        cm.PostCount,
        cm.CommentCount,
        cm.BadgeCount,
        cm.ActivityLevel,
        cm.CommentLevel,
        cm.BadgeLevel,
        cm.DaysSinceLastPost,
        cm.DaysSinceLastComment,
        cm.CommentPerPostRatio,
        cm.BadgePerRepRatio,
        cm.ReputationRank,
        cm.PostRank,
        cm.CommentRank,
        cm.BadgeRank,
        CASE 
            WHEN cm.Reputation > 50000 AND cm.PostCount > 500 THEN 'Elite Contributor'
            WHEN cm.Reputation > 10000 AND cm.PostCount > 200 THEN 'Experienced Contributor'
            WHEN cm.Reputation > 5000 AND cm.PostCount > 100 THEN 'Regular Contributor'
            ELSE 'New Contributor'
        END as ContributorTier,
        CASE 
            WHEN cm.CommentPerPostRatio > 2 THEN 'High Commenter'
            WHEN cm.CommentPerPostRatio > 1 THEN 'Moderate Commenter'
            ELSE 'Low Commenter'
        END as CommentEngagement
    FROM ComplexMetrics cm
),
PostQualityAnalysis AS (
    SELECT 
        tp.PostId,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        tp.CreationDate,
        tp.OwnerUserId,
        tp.ScoreCategory,
        tp.CommentCount,
        tp.TagCount,
        CASE 
            WHEN tp.Score > 100 AND tp.CommentCount > 10 THEN 'High Quality'
            WHEN tp.Score > 50 AND tp.CommentCount > 5 THEN 'Medium Quality'
            ELSE 'Low Quality'
        END as QualityLevel,
        CASE 
            WHEN tp.TagCount > 3 THEN 'Well Tagged'
            WHEN tp.TagCount > 1 THEN 'Moderately Tagged'
            ELSE 'Poorly Tagged'
        END as TagQuality,
        DATEDIFF(day, tp.CreationDate, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) as AgeInDays,
        CASE 
            WHEN DATEDIFF(day, tp.CreationDate, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) < 30 THEN 'Fresh'
            WHEN DATEDIFF(day, tp.CreationDate, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) < 365 THEN 'Recent'
            ELSE 'Old'
        END as AgeCategory
    FROM TopPosts tp
    WHERE tp.ScoreRank <= 50
)
SELECT 
    fa.UserId,
    fa.DisplayName,
    fa.Reputation,
    fa.PostCount,
    fa.CommentCount,
    fa.BadgeCount,
    fa.ActivityLevel,
    fa.CommentLevel,
    fa.BadgeLevel,
    fa.DaysSinceLastPost,
    fa.DaysSinceLastComment,
    fa.CommentPerPostRatio,
    fa.BadgePerRepRatio,
    fa.ReputationRank,
    fa.PostRank,
    fa.CommentRank,
    fa.BadgeRank,
    fa.ContributorTier,
    fa.CommentEngagement,
    pa.PostId,
    pa.Title,
    pa.Score,
    pa.ViewCount,
    pa.CreationDate,
    pa.ScoreCategory,
    pa.CommentCount,
    pa.TagCount,
    pa.QualityLevel,
    pa.TagQuality,
    pa.AgeInDays,
    pa.AgeCategory,
    CASE 
        WHEN pa.TagCount > 0 THEN 
            CAST(pa.TagCount AS FLOAT) / CAST(pa.CommentCount AS FLOAT)
        ELSE 0
    END as TagPerCommentRatio,
    CASE 
        WHEN pa.Score > 0 THEN 
            CAST(pa.ViewCount AS FLOAT) / CAST(pa.Score AS FLOAT)
        ELSE 0
    END as ViewsPerScoreRatio,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = fa.UserId AND p.PostTypeId = 1) as QuestionCount,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = fa.UserId AND p.PostTypeId = 2) as AnswerCount,
    (SELECT MAX(v.CreationDate) FROM Votes v WHERE v.UserId = fa.UserId AND v.VoteTypeId IN (2,3)) as LastVoteDate,
    CASE 
        WHEN pa.TagQuality = 'Well Tagged' AND pa.QualityLevel = 'High Quality' THEN 'Optimal'
        WHEN pa.TagQuality = 'Moderately Tagged' OR pa.QualityLevel = 'Medium Quality' THEN 'Good'
        ELSE 'Needs Improvement'
    END as PostPerformance,
    CASE 
        WHEN fa.PostRank <= 10 AND fa.BadgeRank <= 10 THEN 'Top Performer'
        WHEN fa.PostRank <= 50 OR fa.BadgeRank <= 50 THEN 'High Performer'
        ELSE 'Regular Performer'
    END as PerformanceTier
FROM FinalAnalysis fa
FULL OUTER JOIN PostQualityAnalysis pa ON fa.UserId = pa.OwnerUserId
WHERE (fa.UserId IS NOT NULL OR pa.PostId IS NOT NULL)
AND NULLIF(fa.PostCount, 0) IS NOT NULL
AND NULLIF(pa.Score, 0) IS NOT NULL
AND (
    (fa.UserId IS NOT NULL AND fa.Reputation > 1000)
    OR 
    (pa.PostId IS NOT NULL AND pa.Score > 10)
)
ORDER BY 
    CASE WHEN fa.ReputationRank IS NOT NULL THEN fa.ReputationRank ELSE 10000 END,
    CASE WHEN pa.Score IS NOT NULL THEN pa.Score ELSE 0 END DESC,
    fa.DaysSinceLastPost ASC
LIMIT 1000;