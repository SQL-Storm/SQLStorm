SELECT
    p.PostTypeId,
    pt.Name AS PostTypeName,
    p.Title,
    p.Tags,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.LastActivityDate,
    COUNT(DISTINCT c.Id) AS CommentCount,
    COUNT(DISTINCT v.Id) AS VoteCount,
    AVG(COALESCE(vs.BountyAmount, 0)) OVER () AS AverageBountyOnReopenVotes,
    ARRAY_AGG(DISTINCT pl.RelatedPostId) AS RelatedPosts,
    ARRAY_AGG(DISTINCT b.Name) FILTER (WHERE b.UserId = p.OwnerUserId) AS AchievedBadges,
    (SELECT COUNT(*) FROM PostLinks pl2 WHERE pl2.PostId = p.Id) AS TotalLinks,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4,6,10,20,24)) AS SignificantEditsCount
FROM
    Posts p
JOIN
    PostTypes pt ON p.PostTypeId = pt.Id
LEFT JOIN
    Comments c ON c.PostId = p.Id
LEFT JOIN
    Votes v ON v.PostId = p.Id
LEFT JOIN
    Users u ON u.Id = p.OwnerUserId
LEFT JOIN
    Badges b ON b.UserId = p.OwnerUserId
LEFT JOIN
    PostLinks pl ON pl.PostId = p.Id
LEFT JOIN
    PostHistory ph ON ph.PostId = p.Id
LEFT JOIN
    PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
LEFT JOIN
    VoteTypes vt ON v.VoteTypeId = vt.Id
LEFT JOIN
    (
        SELECT
            UserId,
            SUM(COALESCE(BountyAmount, 0)) AS BountyAmount
        FROM
            Votes
        WHERE
            VoteTypeId = 8
        GROUP BY
            UserId
    ) vs ON vs.UserId = p.OwnerUserId
WHERE
    p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
GROUP BY
    p.Id,
    p.PostTypeId,
    pt.Name,
    p.Title,
    p.Tags,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.LastActivityDate,
    p.OwnerUserId
ORDER BY
    p.CreationDate DESC
LIMIT 100;