WITH PopularTags AS (
    SELECT 
        t.Id AS TagId,
        t.TagName,
        t.Count AS TagCount,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS TagRank
    FROM Tags t
    WHERE t.Count > 1000
),
UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(p.Score) AS TotalScore,
        AVG(p.ViewCount) AS AvgViewCount
    FROM Users u
    JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE p.CreationDate >= DATE '2020-01-01'
    GROUP BY u.Id, u.Reputation
    HAVING COUNT(DISTINCT p.Id) > 50 AND SUM(p.Score) > 1000
),
BadgeSummary AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
),
TopAnswers AS (
    SELECT 
        p.ParentId AS QuestionId,
        p.Id AS AnswerId,
        p.Score AS AnswerScore,
        p.OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC) AS AnswerRank
    FROM Posts p
    WHERE p.PostTypeId = 2 AND p.Score > 10
),
QuestionDetails AS (
    SELECT 
        p.Id AS QuestionId,
        p.Title,
        p.ViewCount,
        p.AnswerCount,
        STRING_AGG(pt.TagName, ' ') AS TagsList
    FROM Posts p
    LEFT JOIN LATERAL (
        SELECT s.TagName
        FROM unnest(p.Tags) AS s(TagName)
    ) AS s ON TRUE
    LEFT JOIN PostTags pt ON pt.PostId = p.Id
    WHERE p.PostTypeId = 1 AND p.AnswerCount > 5
    GROUP BY p.Id, p.Title, p.ViewCount, p.AnswerCount
),
VoteAggregates AS (
    SELECT 
        v.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS Upvotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS Downvotes
    FROM Votes v
    WHERE v.CreationDate >= DATE '2020-01-01'
    GROUP BY v.PostId
    HAVING SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) > 50
)
SELECT 
    ua.UserId,
    ua.Reputation,
    ua.TotalPosts,
    ua.TotalScore,
    ua.AvgViewCount,
    bs.GoldBadges,
    bs.SilverBadges,
    bs.BronzeBadges,
    qd.QuestionId,
    qd.Title,
    qd.ViewCount,
    qd.AnswerCount,
    qd.TagsList,
    ta.AnswerId,
    ta.AnswerScore,
    va.Upvotes,
    va.Downvotes,
    pt.TagName AS PopularTag,
    pt.TagCount
FROM UserActivity ua
JOIN BadgeSummary bs ON ua.UserId = bs.UserId
JOIN TopAnswers ta ON ua.UserId = ta.OwnerUserId AND ta.AnswerRank = 1
JOIN QuestionDetails qd ON ta.QuestionId = qd.QuestionId
JOIN VoteAggregates va ON ta.AnswerId = va.PostId
JOIN PostLinks pl ON qd.QuestionId = pl.PostId AND pl.LinkTypeId = 1
JOIN Posts linked_p ON pl.RelatedPostId = linked_p.Id
JOIN PopularTags pt ON POSITION(pt.TagName IN linked_p.Tags) > 0
WHERE ua.Reputation > 10000 AND pt.TagRank <= 10
ORDER BY ua.TotalScore DESC, qd.ViewCount DESC
LIMIT 100;