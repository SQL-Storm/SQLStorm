WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        MAX(b.Date) AS LastBadgeDate,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                (COUNT(DISTINCT p.Id) * 100.0 / NULLIF(COUNT(DISTINCT p.Id) + COUNT(DISTINCT c.Id), 0))
            ELSE 0 
        END AS PostContributionPercentage
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
RankedUsers AS (
    SELECT 
        *,
        ROW_NUMBER() OVER (ORDER BY PostCount DESC, Reputation DESC) AS PostRank,
        RANK() OVER (ORDER BY Views DESC) AS ViewRank,
        DENSE_RANK() OVER (PARTITION BY CASE WHEN Reputation > 10000 THEN 'High' ELSE 'Low' END ORDER BY BadgeCount DESC) AS BadgeRank
    FROM UserActivity
),
PostStats AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        p.PostTypeId,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostType,
        COALESCE(p.AnswerCount, 0) AS AnswerCountAdjusted,
        COALESCE(p.CommentCount, 0) AS CommentCountAdjusted,
        CASE 
            WHEN p.Tags IS NOT NULL AND p.Tags <> '' THEN 
                (SELECT CAST(ARRAY_LENGTH(string_to_array(SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2), '><'), 1) AS INTEGER))
            ELSE 0 
        END AS TagCount,
        CASE 
            WHEN p.Score > 100 THEN 'High'
            WHEN p.Score > 10 THEN 'Medium'
            WHEN p.Score >= 0 THEN 'Low'
            ELSE 'Negative'
        END AS ScoreCategory
    FROM Posts p
    WHERE p.Score IS NOT NULL
),
TagPopularity AS (
    SELECT 
        t.TagName,
        t.Count AS TagCount,
        AVG(p.Score) AS AvgScore,
        STRING_AGG(p.Title, ', ' ORDER BY p.Score DESC) AS PopularQuestions,
        COUNT(DISTINCT p.OwnerUserId) AS AuthorCount
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    WHERE p.PostTypeId = 1 AND p.Score IS NOT NULL
    GROUP BY t.TagName, t.Count
    HAVING COUNT(p.Id) > 0
),
CombinedData AS (
    SELECT 
        ru.UserId,
        ru.DisplayName,
        ru.Reputation,
        ru.Views,
        ru.PostCount,
        ru.CommentCount,
        ru.BadgeCount,
        ru.PostContributionPercentage,
        ps.PostId,
        ps.Title,
        ps.Score,
        ps.ViewCount,
        ps.AnswerCountAdjusted,
        ps.CommentCountAdjusted,
        ps.PostType,
        ps.ScoreCategory,
        ps.TagCount,
        tp.TagName,
        tp.TagCount AS TagPopularity,
        tp.AvgScore,
        CASE 
            WHEN ps.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1 AND Score IS NOT NULL) THEN 'AboveAverage'
            WHEN ps.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1 AND Score IS NOT NULL) THEN 'BelowAverage'
            ELSE 'Average'
        END AS ScorePerformance,
        CASE 
            WHEN (ps.ViewCount * ps.AnswerCountAdjusted) > 1000 THEN 'Popular'
            ELSE 'Standard'
        END AS PopularityLevel,
        CAST(DATE_PART('day', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - ps.CreationDate) AS INTEGER) AS AgeInDays,
        ROUND((ps.Score * 1.0 / NULLIF(ps.ViewCount, 0)), 2) AS ScoreToViewRatio,
        (ps.AnswerCountAdjusted * 100.0 / NULLIF(ps.ViewCount, 0)) AS AnswerToViewRatio,
        CASE 
            WHEN ps.CommentCountAdjusted > ps.AnswerCountAdjusted THEN 'CommentHeavy'
            WHEN ps.AnswerCountAdjusted > ps.CommentCountAdjusted THEN 'AnswerHeavy'
            ELSE 'Balanced'
        END AS EngagementType
    FROM RankedUsers ru
    LEFT JOIN PostStats ps ON ru.UserId = ps.OwnerUserId
    LEFT JOIN TagPopularity tp ON ps.Tags IS NOT NULL 
        AND tp.TagName IN (
            SELECT TRIM(SUBSTRING(SUBSTRING(ps.Tags, 2, LENGTH(ps.Tags) - 2),
                POSITION('><' IN SUBSTRING(ps.Tags, 2, LENGTH(ps.Tags) - 2)) + 2,
                LENGTH(SUBSTRING(ps.Tags, 2, LENGTH(ps.Tags) - 2)) - POSITION('><' IN SUBSTRING(ps.Tags, 2, LENGTH(ps.Tags) - 2)) - 2)) 
            FROM Posts p2 
            WHERE p2.Id = ps.PostId AND ps.Tags IS NOT NULL
        )
    WHERE ps.PostId IS NOT NULL OR ru.UserId IN (SELECT DISTINCT OwnerUserId FROM Posts WHERE OwnerUserId IS NOT NULL)
),
FinalAggregation AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        Views,
        PostCount,
        CommentCount,
        BadgeCount,
        PostContributionPercentage,
        COUNT(DISTINCT PostId) AS TotalPosts,
        SUM(CASE WHEN ScoreCategory = 'High' THEN 1 ELSE 0 END) AS HighScorePosts,
        SUM(CASE WHEN ScoreCategory = 'Medium' THEN 1 ELSE 0 END) AS MediumScorePosts,
        AVG(Score) AS AvgScore,
        AVG(ViewCount) AS AvgViewCount,
        AVG(AnswerCountAdjusted) AS AvgAnswerCount,
        AVG(CommentCountAdjusted) AS AvgCommentCount,
        AVG(TagCount) AS AvgTagCount,
        STRING_AGG(DISTINCT TagName, ', ') AS AllTagsUsed,
        COUNT(DISTINCT CASE WHEN ScorePerformance = 'AboveAverage' THEN PostId END) AS AboveAvgPosts,
        COUNT(DISTINCT CASE WHEN PopularityLevel = 'Popular' THEN PostId END) AS PopularPosts,
        MAX(AgeInDays) AS MaxAge,
        MIN(AgeInDays) AS MinAge,
        AVG(ScoreToViewRatio) AS AvgScoreToViewRatio,
        AVG(AnswerToViewRatio) AS AvgAnswerToViewRatio,
        STRING_AGG(DISTINCT EngagementType, ', ') AS EngagementTypes,
        SUM(CASE WHEN TagName IS NOT NULL THEN 1 ELSE 0 END) AS TagCountUsed,
        CASE 
            WHEN AVG(ScoreToViewRatio) > 0.1 AND AVG(AnswerToViewRatio) > 0.05 THEN 'Engaging'
            WHEN AVG(ScoreToViewRatio) > 0.05 AND AVG(AnswerToViewRatio) > 0.02 THEN 'ModeratelyEngaging'
            ELSE 'Passive'
        END AS EngagementStatus
    FROM CombinedData
    GROUP BY UserId, DisplayName, Reputation, Views, PostCount, CommentCount, BadgeCount, PostContributionPercentage
)
SELECT 
    f.UserId,
    f.DisplayName,
    f.Reputation,
    f.Views,
    f.PostCount,
    f.CommentCount,
    f.BadgeCount,
    f.PostContributionPercentage,
    f.TotalPosts,
    f.HighScorePosts,
    f.MediumScorePosts,
    f.AvgScore,
    f.AvgViewCount,
    f.AvgAnswerCount,
    f.AvgCommentCount,
    f.AvgTagCount,
    f.AllTagsUsed,
    f.AboveAvgPosts,
    f.PopularPosts,
    f.MaxAge,
    f.MinAge,
    f.AvgScoreToViewRatio,
    f.AvgAnswerToViewRatio,
    f.EngagementTypes,
    f.TagCountUsed,
    f.EngagementStatus,
    CASE 
        WHEN f.PostCount > 100 THEN 'Elite'
        WHEN f.PostCount > 50 THEN 'Active'
        WHEN f.PostCount > 10 THEN 'Regular'
        ELSE 'Beginner'
    END AS UserLevel,
    CASE 
        WHEN f.Reputation > 100000 THEN 'Veteran'
        WHEN f.Reputation > 10000 THEN 'Experienced'
        WHEN f.Reputation > 1000 THEN 'Intermediate'
        ELSE 'Newbie'
    END AS ReputationLevel,
    CASE 
        WHEN f.BadgeCount > 20 THEN 'AchievementSeeker'
        WHEN f.BadgeCount > 10 THEN 'BadgeCollector'
        WHEN f.BadgeCount > 5 THEN 'RegularBadgeUser'
        ELSE 'CasualBadgeUser'
    END AS BadgeClassification,
    CASE 
        WHEN f.AvgScore > 50 AND f.AvgViewCount > 1000 THEN 'HighPerforming'
        WHEN f.AvgScore > 20 AND f.AvgViewCount > 500 THEN 'MidPerforming'
        ELSE 'LowPerforming'
    END AS PerformanceCategory
FROM FinalAggregation f
WHERE f.PostCount > 0
ORDER BY f.Reputation DESC, f.PostCount DESC, f.AvgScore DESC
LIMIT 1000;