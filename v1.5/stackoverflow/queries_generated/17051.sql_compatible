WITH UserMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, 'Unknown') AS Location,
        EXTRACT(YEAR FROM AGE(DATE '2024-10-01', u.CreationDate)) AS YearsActive,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COALESCE(SUM(p.Score), 0) AS TotalPostScore,
        COALESCE(AVG(CASE WHEN p.Score > 0 THEN p.Score END), 0) AS AvgPositiveScore,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        NULLIF(
            STRING_AGG(DISTINCT CASE WHEN b.Class = 1 THEN b.Name END, ', '),
            ''
        ) AS GoldBadgeNames,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS MedianScore,
        MAX(p.ViewCount) AS MaxViewsOnPost
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate < DATE '2024-10-01' - INTERVAL '6 months'
    GROUP BY u.Id, u.DisplayName, u.Reputation, COALESCE(u.Location, 'Unknown'), u.CreationDate
),
TopAnswerers AS (
    SELECT 
        p2.OwnerUserId,
        COUNT(*) AS AcceptedAnswers,
        AVG(EXTRACT(EPOCH FROM (p1.LastActivityDate - p2.CreationDate))/3600) AS AvgHoursToAccept
    FROM Posts p1
    INNER JOIN Posts p2 ON p1.AcceptedAnswerId = p2.Id
    WHERE p2.OwnerUserId IS NOT NULL
    GROUP BY p2.OwnerUserId
),
TagExperts AS (
    SELECT 
        p.OwnerUserId,
        te.Tag,
        SUM(p.Score) AS TagScore,
        COUNT(*) AS TagPostCount,
        ROW_NUMBER() OVER (
            PARTITION BY p.OwnerUserId
            ORDER BY SUM(p.Score) DESC
        ) AS TagRank
    FROM Posts p
    CROSS APPLY (
        SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), '><')) AS Tag
    ) AS te
    WHERE p.Tags IS NOT NULL 
        AND p.OwnerUserId IS NOT NULL
        AND p.Score > 0
    GROUP BY p.OwnerUserId, te.Tag
),
RecentActivity AS (
    SELECT 
        UserId,
        COUNT(*) FILTER (WHERE PostHistoryTypeId IN (4,5,6)) AS RecentEdits,
        COUNT(*) FILTER (WHERE PostHistoryTypeId = 10) AS RecentCloseVotes,
        MAX(CreationDate) AS LastActivityDate,
        CASE 
            WHEN MAX(CreationDate) > DATE '2024-10-01' - INTERVAL '7 days' THEN 'Very Active'
            WHEN MAX(CreationDate) > DATE '2024-10-01' - INTERVAL '30 days' THEN 'Active'
            WHEN MAX(CreationDate) > DATE '2024-10-01' - INTERVAL '90 days' THEN 'Moderate'
            ELSE 'Inactive'
        END AS ActivityLevel
    FROM PostHistory
    WHERE CreationDate > DATE '2024-10-01' - INTERVAL '3 months'
        AND UserId IS NOT NULL
    GROUP BY UserId
)
SELECT 
    um.DisplayName,
    um.Location,
    um.Reputation,
    um.YearsActive,
    um.PostCount,
    um.QuestionCount,
    um.AnswerCount,
    ROUND(um.TotalPostScore / NULLIF(um.PostCount, 0) , 2) AS AvgScorePerPost,
    um.MedianScore,
    um.MaxViewsOnPost,
    um.BadgeCount,
    um.GoldBadges,
    COALESCE(um.GoldBadgeNames, 'None') AS GoldBadgeNames,
    COALESCE(ta.AcceptedAnswers, 0) AS AcceptedAnswers,
    ROUND(COALESCE(ta.AvgHoursToAccept, 0), 2) AS AvgHoursToAccept,
    COALESCE(ra.ActivityLevel, 'Inactive') AS RecentActivityLevel,
    COALESCE(ra.RecentEdits, 0) AS RecentEditCount,
    (
        SELECT STRING_AGG(te.Tag || ' (' || te.TagScore || ')', ', ' ORDER BY te.TagScore DESC)
        FROM TagExperts te
        WHERE te.OwnerUserId = um.Id AND te.TagRank = 1
        LIMIT 5
    ) AS TopExpertTags,
    EXISTS (
        SELECT 1 
        FROM Comments c 
        WHERE c.UserId = um.Id 
            AND c.Score > 10
            AND LENGTH(c.Text) > 100
    ) AS HasHighQualityComments,
    CASE 
        WHEN um.Reputation > 10000 AND um.GoldBadges > 5 THEN 'Elite'
        WHEN um.Reputation > 5000 AND um.BadgeCount > 20 THEN 'Expert'
        WHEN um.Reputation > 1000 AND um.PostCount > 50 THEN 'Contributor'
        WHEN um.PostCount > 10 THEN 'Participant'
        ELSE 'Observer'
    END AS UserTier,
    DENSE_RANK() OVER (
        PARTITION BY CASE 
            WHEN um.Reputation > 10000 THEN 'High Rep'
            WHEN um.Reputation > 1000 THEN 'Mid Rep'
            ELSE 'Low Rep'
        END
        ORDER BY um.TotalPostScore DESC NULLS LAST, um.BadgeCount DESC
    ) AS TierRank
FROM UserMetrics um
LEFT JOIN TopAnswerers ta ON um.Id = ta.OwnerUserId
LEFT JOIN RecentActivity ra ON um.Id = ra.UserId
WHERE um.PostCount > 0
    OR um.BadgeCount > 0
    OR EXISTS (
        SELECT 1 
        FROM Votes v 
        WHERE v.UserId = um.Id 
            AND v.VoteTypeId IN (2, 3)
    )
ORDER BY 
    CASE WHEN um.Location LIKE '%San Francisco%' THEN 0 ELSE 1 END,
    um.Reputation DESC,
    um.TotalPostScore DESC NULLS LAST,
    um.YearsActive DESC,
    um.DisplayName ASC NULLS LAST
LIMIT 100;