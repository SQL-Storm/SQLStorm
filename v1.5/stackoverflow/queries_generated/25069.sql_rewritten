-- {"query": "25069.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 1971} 
WITH
/* ------------------------------------------------------------------
   1️⃣  User baseline stats – include users even if they have no posts
   ------------------------------------------------------------------ */
user_base AS (
    SELECT
        u.Id                           AS user_id,
        u.DisplayName                  AS display_name,
        u.Reputation                   AS reputation,
        u.CreationDate                 AS user_created,
        COALESCE(u.Location, 'N/A')    AS location,
        COUNT(p.Id)                    AS total_posts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS total_questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS total_answers,
        COUNT(b.Id)                    AS total_badges,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.ParentId END) AS distinct_questions_answered
    FROM Users u
    LEFT JOIN Posts p   ON p.OwnerUserId = u.Id
    LEFT JOIN Badges b  ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Location
),

/* ------------------------------------------------------------------
   2️⃣  Recent activity per user – most recent post, edit and vote dates
   ------------------------------------------------------------------ */
recent_activity AS (
    SELECT
        ua.user_id,
        MAX(p.CreationDate)               AS last_post_date,
        MAX(ph.CreationDate)              AS last_edit_date,
        MAX(v.CreationDate)               AS last_vote_date
    FROM user_base ua
    LEFT JOIN Posts p
           ON p.OwnerUserId = ua.user_id
    LEFT JOIN PostHistory ph
           ON ph.PostId = p.Id
          AND ph.PostHistoryTypeId IN (4,5,6)            -- edit events
    LEFT JOIN Votes v
           ON v.PostId = p.Id
    GROUP BY ua.user_id
),

/* ------------------------------------------------------------------
   3️⃣  Tag‑centric view – most used tags by the user’s answers (top 5)
   ------------------------------------------------------------------ */
user_tags AS (
    SELECT
        a.OwnerUserId                         AS user_id,
        UNNEST(string_to_array(
                TRIM(BOTH '<>' FROM q.Tags),
                '><'))                         AS tag,
        COUNT(*)                              AS tag_uses
    FROM Posts a
    JOIN Posts q ON q.Id = a.ParentId          -- question of the answer
    WHERE a.PostTypeId = 2                     -- answers only
      AND a.OwnerUserId IS NOT NULL
    GROUP BY a.OwnerUserId, tag
),

top_user_tags AS (
    SELECT
        user_id,
        STRING_AGG(tag || ':' || tag_uses, ', ') 
            WITHIN GROUP (ORDER BY tag_uses DESC) AS top_tags
    FROM (
        SELECT
            ut.*,
            ROW_NUMBER() OVER (PARTITION BY ut.user_id ORDER BY ut.tag_uses DESC) AS rn
        FROM user_tags ut
    ) sub
    WHERE rn <= 5                                 -- keep only top‑5 tags
    GROUP BY user_id
),

/* ------------------------------------------------------------------
   4️⃣  Score analytics – rolling 7‑day average of answer scores
   ------------------------------------------------------------------ */
answer_scores AS (
    SELECT
        a.OwnerUserId                         AS user_id,
        a.CreationDate                        AS answer_date,
        a.Score                               AS answer_score
    FROM Posts a
    WHERE a.PostTypeId = 2
),

rolling_scores AS (
    SELECT
        user_id,
        answer_date,
        AVG(answer_score) OVER (
            PARTITION BY user_id
            ORDER BY answer_date
            RANGE BETWEEN INTERVAL '6 days' PRECEDING AND CURRENT ROW
        )                                        AS avg_score_7d
    FROM answer_scores
),

max_avg_score AS (
    SELECT
        user_id,
        MAX(avg_score_7d) AS max_7d_avg_score
    FROM rolling_scores
    GROUP BY user_id
),

/* ------------------------------------------------------------------
   5️⃣  Badges breakdown – gold / silver / bronze counts (including NULL handling)
   ------------------------------------------------------------------ */
badge_counts AS (
    SELECT
        b.UserId                       AS user_id,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze_badges
    FROM Badges b
    GROUP BY b.UserId
),

/* ------------------------------------------------------------------
   6️⃣  Union of two perspectives:
        a) Users with at least one answer
        b) Users with no answers (to test outer‑join paths)
   ------------------------------------------------------------------ */
users_with_answers AS (
    SELECT ub.user_id
    FROM user_base ub
    WHERE ub.total_answers > 0
),

users_without_answers AS (
    SELECT ub.user_id
    FROM user_base ub
    WHERE ub.total_answers = 0
),

combined_users AS (
    SELECT user_id, 'HAS_ANSWERS' AS answer_flag FROM users_with_answers
    UNION ALL
    SELECT user_id, 'NO_ANSWERS'   AS answer_flag FROM users_without_answers
)

/* ------------------------------------------------------------------
   FINAL SELECT – mash everything together
   ------------------------------------------------------------------ */
SELECT
    ub.user_id,
    ub.display_name,
    ub.reputation,
    ub.location,
    ub.total_posts,
    ub.total_questions,
    ub.total_answers,
    ub.distinct_questions_answered,
    COALESCE(ra.last_post_date, '1970-01-01')      AS last_post_date,
    COALESCE(ra.last_edit_date, '1970-01-01')      AS last_edit_date,
    COALESCE(ra.last_vote_date, '1970-01-01')      AS last_vote_date,
    COALESCE(tut.top_tags, '')                     AS top_5_tags,
    COALESCE(mas.max_7d_avg_score, 0)              AS best_7d_avg_answer_score,
    COALESCE(bc.gold_badges, 0)   AS gold_badges,
    COALESCE(bc.silver_badges, 0) AS silver_badges,
    COALESCE(bc.bronze_badges, 0) AS bronze_badges,
    cu.answer_flag,
    /* Complex calculated column using CASE, NULL handling and string ops */
    CASE 
        WHEN ub.reputation >= 20000 THEN 'Elite'
        WHEN ub.reputation BETWEEN 10000 AND 19999 THEN 'Veteran'
        WHEN ub.reputation < 1000 THEN 'Newbie'
        ELSE 'Experienced'
    END                                         AS reputation_tier,
    /* Example of a correlated sub‑query: count of distinct voters on user's answers */
    (SELECT COUNT(DISTINCT v.UserId)
     FROM Posts a
     JOIN Votes v ON v.PostId = a.Id
     WHERE a.OwnerUserId = ub.user_id
       AND a.PostTypeId = 2
       AND v.VoteTypeId = 2)                    AS distinct_upvoters,
    /* Window function: rank users by total reputation (ties get same rank) */
    RANK() OVER (ORDER BY ub.reputation DESC)   AS reputation_rank
FROM combined_users cu
JOIN user_base        ub ON ub.user_id = cu.user_id
LEFT JOIN recent_activity ra ON ra.user_id = ub.user_id
LEFT JOIN top_user_tags   tut ON tut.user_id = ub.user_id
LEFT JOIN max_avg_score   mas ON mas.user_id = ub.user_id
LEFT JOIN badge_counts    bc  ON bc.user_id = ub.user_id
ORDER BY ub.reputation DESC
LIMIT 100;