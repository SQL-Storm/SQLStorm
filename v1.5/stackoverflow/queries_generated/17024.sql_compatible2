WITH user_activity_metrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS total_posts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS questions_asked,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answers_given,
        AVG(p.Score) AS avg_post_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS median_post_score,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ', ') AS all_tags_used
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '2 years'
        AND u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
power_users AS (
    SELECT 
        Id,
        DisplayName,
        Reputation,
        total_posts,
        questions_asked,
        answers_given,
        avg_post_score,
        median_post_score,
        DENSE_RANK() OVER (ORDER BY Reputation DESC) AS reputation_rank,
        RANK() OVER (ORDER BY total_posts DESC) AS activity_rank,
        ROW_NUMBER() OVER (PARTITION BY CASE 
            WHEN Reputation >= 100000 THEN 'legendary'
            WHEN Reputation >= 50000 THEN 'epic'
            WHEN Reputation >= 10000 THEN 'trusted'
            ELSE 'established'
        END ORDER BY avg_post_score DESC NULLS LAST) AS tier_performance_rank
    FROM user_activity_metrics
    WHERE total_posts > 10
),
question_answer_pairs AS (
    SELECT 
        q.Id AS question_id,
        q.Title,
        q.Score AS question_score,
        q.ViewCount,
        a.Id AS answer_id,
        a.Score AS answer_score,
        a.OwnerUserId AS answerer_id,
        q.OwnerUserId AS questioner_id,
        COALESCE(a.Score, 0) - COALESCE(q.Score, 0) AS score_differential,
        EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate))/3600 AS hours_to_answer
    FROM Posts q
    LEFT OUTER JOIN Posts a ON q.Id = a.ParentId AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1
        AND q.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '6 months'
        AND q.ClosedDate IS NULL
),
tag_performance AS (
    SELECT 
        t.TagName,
        t.Count AS tag_usage_count,
        AVG(CASE WHEN p.Score > 0 THEN p.Score END) AS avg_positive_score,
        COUNT(DISTINCT p.OwnerUserId) AS unique_contributors,
        MAX(p.Score) FILTER (WHERE p.PostTypeId = 1) AS best_question_score,
        MAX(p.Score) FILTER (WHERE p.PostTypeId = 2) AS best_answer_score,
        COUNT(*) FILTER (WHERE p.AcceptedAnswerId IS NOT NULL) AS accepted_answers_count
    FROM Tags t
    INNER JOIN Posts p ON POSITION('<' || t.TagName || '>' IN p.Tags) > 0
    WHERE t.Count >= 100
    GROUP BY t.TagName, t.Count
)
SELECT 
    pu.DisplayName,
    pu.Reputation,
    pu.reputation_rank,
    pu.activity_rank,
    pu.total_posts,
    COALESCE(pu.avg_post_score, 0) AS avg_post_score,
    COALESCE(pu.median_post_score, 0) AS median_post_score,
    COUNT(DISTINCT qap.question_id) AS questions_answered_recently,
    AVG(qap.hours_to_answer) FILTER (WHERE qap.answerer_id = pu.Id) AS avg_response_time_hours,
    SUM(CASE WHEN qap.score_differential > 10 THEN 1 ELSE 0 END) AS exceptional_answers,
    COALESCE(MAX(tp.avg_positive_score), 0) AS best_tag_avg_score,
    COUNT(DISTINCT b.Name) FILTER (WHERE b.Class = 1) AS gold_badges,
    COUNT(DISTINCT b.Name) FILTER (WHERE b.Class = 2) AS silver_badges,
    (SELECT COUNT(*) 
     FROM Comments c 
     WHERE c.UserId = pu.Id 
        AND c.Score > 5
        AND EXISTS (
            SELECT 1 
            FROM Posts p2 
            WHERE p2.Id = c.PostId 
                AND p2.Score > 50
        )
    ) AS helpful_comments_on_popular_posts,
    COALESCE(
        (SELECT STRING_AGG(DISTINCT vt.Name, ', ')
         FROM Votes v
         INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
         WHERE v.UserId = pu.Id 
            AND v.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '30 days'
            AND v.VoteTypeId IN (2, 3, 8)
        ), 
        'No recent votes'
    ) AS recent_vote_types,
    CASE 
        WHEN pu.Reputation > 50000 AND COUNT(DISTINCT b.Name) FILTER (WHERE b.Class = 1) > 10 THEN 'Elite Contributor'
        WHEN AVG(qap.hours_to_answer) < 1 AND COUNT(DISTINCT qap.question_id) > 20 THEN 'Lightning Responder'
        WHEN SUM(CASE WHEN qap.score_differential > 10 THEN 1 ELSE 0 END) > 5 THEN 'Quality Expert'
        WHEN pu.activity_rank <= 100 THEN 'Top 100 Active'
        ELSE 'Regular Contributor'
    END AS contributor_classification,
    COALESCE(NULLIF(TRIM(SUBSTRING(pu.all_tags_used FROM 1 FOR 200)), ''), 'No tags') AS primary_tags_excerpt
FROM power_users pu
LEFT OUTER JOIN question_answer_pairs qap ON pu.Id = qap.answerer_id
LEFT OUTER JOIN Badges b ON pu.Id = b.UserId
LEFT OUTER JOIN tag_performance tp ON POSITION(tp.TagName IN COALESCE(pu.all_tags_used, '')) > 0
WHERE pu.reputation_rank <= 1000
    OR pu.activity_rank <= 500
    OR EXISTS (
        SELECT 1
        FROM PostHistory ph
        WHERE ph.UserId = pu.Id
            AND ph.PostHistoryTypeId IN (4, 5, 6)
            AND ph.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '7 days'
    )
GROUP BY 
    pu.Id,
    pu.DisplayName,
    pu.Reputation,
    pu.reputation_rank,
    pu.activity_rank,
    pu.total_posts,
    pu.avg_post_score,
    pu.median_post_score,
    pu.all_tags_used
HAVING 
    COUNT(DISTINCT qap.question_id) > 0
    OR pu.total_posts > 50
ORDER BY 
    pu.reputation_rank ASC,
    COALESCE(AVG(qap.score_differential), 0) DESC,
    COUNT(DISTINCT b.Name) FILTER (WHERE b.Class = 1) DESC
LIMIT 100;