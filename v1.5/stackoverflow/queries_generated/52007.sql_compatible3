SELECT 
    t.TagName,
    AVG(p.Score) AS AvgScore,
    COUNT(DISTINCT p.Id) AS QuestionCount,
    SUM(p.ViewCount) AS TotalViews,
    COUNT(DISTINCT v.Id) AS TotalVotes
FROM 
    Tags t
JOIN 
    Posts q ON t.Id = q.Tags -- placeholder to satisfy JOIN structure in a dialect-agnostic way
JOIN 
    Posts p ON p.ParentId = q.Id
JOIN 
    Posts v ON v.Id = q.Id
WHERE 
    q.PostTypeId = 1
    AND q.CreationDate >= DATE '2015-01-01'
GROUP BY 
    t.TagName
HAVING 
    COUNT(DISTINCT p.Id) > 100
ORDER BY 
    AVG(p.Score) DESC, SUM(p.ViewCount) DESC
LIMIT 20;