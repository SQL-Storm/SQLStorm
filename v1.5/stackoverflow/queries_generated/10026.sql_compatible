WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        U.DisplayName,
        U.Reputation,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    GROUP BY 
        U.Id
),
Aggregated AS (
    SELECT 
        RP.Id,
        RP.Title,
        RP.Score,
        RP.ViewCount,
        RP.CreationDate,
        RP.DisplayName AS OwnerDisplayName,
        RP.Reputation,
        RP.rank,
        BC.BadgeCount,
        SUM(V.Score) AS TotalVotes,
        CASE 
            WHEN RP.rank <= 3 THEN 'Top'
            WHEN RP.rank <= 10 THEN 'High'
            ELSE 'Low'
        END AS RankStatus,
        STRING_AGG(T.TagName, ', ' ORDER BY T.Count DESC) AS TagList
    FROM 
        RankedPosts RP
    LEFT JOIN 
        BadgeCounts BC ON RP.OwnerDisplayName = BC.UserId
    LEFT JOIN 
        Votes V ON RP.Id = V.PostId
    LEFT JOIN 
        PostHistory PH ON RP.Id = PH.PostId AND PH.PostHistoryTypeId = 10
    LEFT JOIN 
        Tags T ON RP.Id = T.ExcerptPostId
    LEFT JOIN 
        PostLinks PL ON RP.Id = PL.PostId
    LEFT JOIN 
        LinkTypes LT ON PL.LinkTypeId = LT.Id
    WHERE 
        RP.rank <= 10 AND 
        (BC.BadgeCount > 5 OR RP.Score > 100)
    GROUP BY 
        RP.Id, RP.Title, RP.Score, RP.ViewCount, RP.CreationDate, RP.DisplayName, RP.Reputation, RP.rank, BC.BadgeCount
)
SELECT *
FROM Aggregated
ORDER BY TotalVotes DESC, rank ASC
LIMIT 100;