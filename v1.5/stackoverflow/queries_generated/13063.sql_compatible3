WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        AVG(p.Score) AS AvgScore,
        MAX(p.CreationDate) AS LastPostDate,
        DENSE_RANK() OVER (ORDER BY SUM(p.Score) DESC) AS RankByScore
    FROM 
        Users u
    LEFT JOIN 
        Posts p ON u.Id = p.OwnerUserId
    WHERE 
        p.CreationDate > DATE '2024-10-01' - INTERVAL '1' YEAR
    GROUP BY 
        u.Id, u.DisplayName
),
TopQuestions AS (
    SELECT 
        p.Id AS QuestionId,
        p.Title,
        p.Score,
        COUNT(a.Id) AS AnswerCount,
        STRING_AGG(DISTINCT t.TagName, ', ') AS Tags
    FROM 
        Posts p
    LEFT JOIN 
        Posts a ON p.Id = a.ParentId AND a.PostTypeId = 2
    LEFT JOIN 
        Tags t ON p.Tags LIKE CONCAT('%<', t.TagName, '>%')
    WHERE 
        p.PostTypeId = 1
    GROUP BY 
        p.Id, p.Title, p.Score
    HAVING 
        COUNT(a.Id) > 0
),
LastQuestionPostText AS (
    SELECT
        tq.QuestionId,
        ph.Text AS LastQuestionText
    FROM (
        SELECT
            tq.QuestionId
        FROM TopQuestions tq
    ) AS x
    LEFT JOIN PostHistory ph
        ON ph.PostId = x.QuestionId
        AND ph.PostHistoryTypeId = 6
    ORDER BY ph.CreationDate DESC
    LIMIT 1
)
SELECT 
    frs.UserId,
    frs.DisplayName,
    frs.TotalPosts,
    frs.TotalQuestions,
    frs.TotalAnswers,
    frs.AvgScore,
    frs.RankByScore,
    tq.QuestionId,
    tq.Title,
    tq.Score AS QuestionScore,
    tq.AnswerCount,
    tq.Tags,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = frs.UserId AND b.Class = 1) AS GoldBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = frs.UserId AND b.Class = 2) AS SilverBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = frs.UserId AND b.Class = 3) AS BronzeBadges
FROM 
    UserActivity frs
JOIN (
    SELECT *
    FROM TopQuestions
    ORDER BY Score DESC, AnswerCount DESC
    LIMIT 5
) tq ON 1=1
WHERE 
    frs.TotalPosts > 10
ORDER BY 
    frs.RankByScore, frs.TotalQuestions DESC
LIMIT 100;