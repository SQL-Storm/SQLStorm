-- {"query": "42008.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "nova-pro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2057, "output_tokens": 240} 
SELECT DISTINCT U.DisplayName, P.Title, COUNT(V.Id) AS VoteCount, COUNT(C.Id) AS CommentCount, COUNT(DISTINCT T.TagName) AS TagCount
FROM Users U
JOIN Posts P ON U.Id = P.OwnerUserId
LEFT JOIN Votes V ON P.Id = V.PostId AND V.VoteTypeId IN (2, 3)
LEFT JOIN Comments C ON P.Id = C.PostId
LEFT JOIN (
    SELECT DISTINCT P.Id, T.TagName
    FROM Posts P, unnest(string_to_array(substring(P.Tags, 2, length(P.Tags)-2), ''><'')) T(TagName)
) T ON P.Id = T.Id
WHERE P.PostTypeId = 1
GROUP BY U.DisplayName, P.Title
HAVING COUNT(V.Id) > 0 OR COUNT(C.Id) > 0
ORDER BY VoteCount DESC, CommentCount DESC, TagCount DESC
LIMIT 100;