WITH UserPostStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(p2.Id) FILTER (WHERE p2.PostTypeId = 1) AS QuestionCount,
        COUNT(p3.Id) FILTER (WHERE p3.PostTypeId = 2) AS AnswerCount,
        AVG(p2.Score) AS AvgQuestionScore,
        AVG(p3.Score) AS AvgAnswerScore,
        COUNT(DISTINCT c.Id) AS TotalComments
    FROM Users u
    LEFT JOIN Posts p1 ON p1.OwnerUserId = u.Id
    LEFT JOIN Posts p2 ON p2.OwnerUserId = u.Id AND p2.PostTypeId = 1
    LEFT JOIN Posts p3 ON p3.OwnerUserId = u.Id AND p3.PostTypeId = 2
    LEFT JOIN Comments c ON c.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
), PostHistoryCounts AS (
    SELECT
        p.Id AS PostId,
        COUNT(ph.Id) AS RevisionCount,
        COUNT(DISTINCT ph2.UserId) FILTER (WHERE ph2.UserId IS NOT NULL) AS UniqueEditors
    FROM Posts p
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id
    LEFT JOIN PostHistory ph2 ON ph2.PostId = p.Id AND ph2.UserId IS NOT NULL
    GROUP BY p.Id
), TagStatistics AS (
    SELECT
        t.TagName,
        t.Count AS TagCount,
        AVG(t2.RevisionCount) AS AvgTagRevisionCount
    FROM Tags t
    LEFT JOIN Posts p ON p.Id = t.WikiPostId
    LEFT JOIN PostHistoryCounts t2 ON t2.PostId = p.Id
    GROUP BY t.TagName, t.Count
)
SELECT 
    up.UserId,
    up.DisplayName,
    up.QuestionCount,
    up.AnswerCount,
    up.AvgQuestionScore,
    up.AvgAnswerScore,
    up.TotalComments,
    pcs.RevisionCount,
    pcs.UniqueEditors,
    ts.TagName,
    ts.TagCount,
    ts.AvgTagRevisionCount,
    CASE WHEN (up.QuestionCount + up.AnswerCount) > 0 THEN
        ( (up.QuestionCount * 1.0 / NULLIF((up.QuestionCount + up.AnswerCount), 0)) * 100 )
    ELSE NULL END AS QuestionAnswerRatio,
    SUM(
        CASE 
            WHEN p.PostTypeId = 1 AND p.Tags LIKE CONCAT('%','<javascript>','%') THEN 1
            ELSE 0
        END
    ) OVER (PARTITION BY up.UserId) AS JavaScriptQuestionsWithTags,
    STRING_AGG(DISTINCT c.UserDisplayName, ', ') FILTER (WHERE c.Score > 0 AND c.UserDisplayName IS NOT NULL) AS ActiveCommenters,
    CASE WHEN EXISTS (
        SELECT 1 FROM Posts p_down
        JOIN Votes v ON v.PostId = p_down.Id
        WHERE p_down.OwnerUserId = up.UserId AND v.VoteTypeId = 3 AND v.CreationDate > DATE '2024-10-01' - INTERVAL '30 days'
    ) THEN TRUE ELSE FALSE END AS HasRecentDownvote
FROM UserPostStats up
LEFT JOIN PostHistoryCounts pcs ON pcs.PostId IN (
    SELECT p.Id FROM Posts p WHERE p.OwnerUserId = up.UserId
)
LEFT JOIN TagStatistics ts ON ts.TagName IN (
    SELECT unnest(string_to_array(substring(p.Tags from 2 for length(p.Tags)-2), '><')) FROM Posts p WHERE p.OwnerUserId = up.UserId AND p.PostTypeId = 1
)
LEFT JOIN Posts p ON p.OwnerUserId = up.UserId
LEFT JOIN Comments c ON c.PostId = p.Id
WHERE up.QuestionCount + up.AnswerCount > 0
GROUP BY
    up.UserId,
    up.DisplayName,
    up.QuestionCount,
    up.AnswerCount,
    up.AvgQuestionScore,
    up.AvgAnswerScore,
    up.TotalComments,
    pcs.RevisionCount,
    pcs.UniqueEditors,
    ts.TagName,
    ts.TagCount,
    ts.AvgTagRevisionCount
ORDER BY up.UserId DESC
LIMIT 100;