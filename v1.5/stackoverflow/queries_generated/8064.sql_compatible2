with recent_questions as (
    select
        q.Id as QuestionId,
        q.CreationDate,
        q.OwnerUserId,
        q.Score,
        q.ViewCount,
        q.Title,
        q.Tags,
        coalesce(q.AnswerCount, 0) as AnswerCount,
        array_length(string_to_array(substring(q.Tags, 2, greatest(length(q.Tags)-2,0)), '><'), 1) as TagCount
    from Posts q
    where q.PostTypeId = 1
      and q.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '365 days'
),
answer_stats as (
    select
        a.ParentId as QuestionId,
        count(*) as AnswersTotal,
        sum(case when a.Score > 0 then 1 else 0 end) as AnswersPositive,
        max(a.Score) as MaxAnswerScore,
        min(a.CreationDate) as FirstAnswerDate,
        max(a.CreationDate) as LastAnswerDate
    from Posts a
    where a.PostTypeId = 2
    group by a.ParentId
),
vote_agg as (
    select
        v.PostId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as Favorites,
        sum(case when v.VoteTypeId in (8,9) then coalesce(v.BountyAmount,0) else 0 end) as BountyTotal,
        count(*) as TotalVotes
    from Votes v
    group by v.PostId
),
comment_agg as (
    select
        c.PostId,
        count(*) as CommentCount,
        max(c.Score) as MaxCommentScore,
        max(c.CreationDate) as LastCommentDate
    from Comments c
    group by c.PostId
),
postlink_agg as (
    select
        pl.PostId,
        sum(case when pl.LinkTypeId = 1 then 1 else 0 end) as LinkedOut,
        sum(case when pl.LinkTypeId = 3 then 1 else 0 end) as DuplicateOf
    from PostLinks pl
    group by pl.PostId
),
close_events as (
    select
        ph.PostId,
        min(case when ph.PostHistoryTypeId = 10 then ph.CreationDate end) as FirstClosedDate,
        max(case when ph.PostHistoryTypeId = 10 then ph.CreationDate end) as LastClosedDate,
        count(*) FILTER (where ph.PostHistoryTypeId = 10) as CloseCount,
        count(*) FILTER (where ph.PostHistoryTypeId = 11) as ReopenCount
    from PostHistory ph
    where ph.PostHistoryTypeId in (10,11)
    group by ph.PostId
),
user_enrichment as (
    select
        u.Id as UserId,
        u.Reputation,
        u.CreationDate as UserCreationDate,
        u.DisplayName,
        u.Location,
        u.UpVotes as UserUpVotes,
        u.DownVotes as UserDownVotes,
        u.Views as UserViews,
        coalesce(nullif(trim(u.Location), ''), 'Unknown') as NormLocation
    from Users u
),
tag_explode as (
    select
        rq.QuestionId,
        unnest(string_to_array(substring(rq.Tags, 2, greatest(length(rq.Tags)-2,0)), '><')) as TagName
    from recent_questions rq
    where rq.Tags is not null
),
tag_stats as (
    select
        te.QuestionId,
        count(*) as QuestionTagCount,
        count(*) filter (where t.IsModeratorOnly = 1) as ModOnlyTags,
        sum(coalesce(t.Count,0)) as GlobalTagUsage
    from tag_explode te
    left join Tags t on lower(t.TagName) = lower(te.TagName)
    group by te.QuestionId
),
accepted_answer_latency as (
    select
        q.Id as QuestionId,
        case
            when q.AcceptedAnswerId is null then null
            else (select a.CreationDate from Posts a where a.Id = q.AcceptedAnswerId)
        end as AcceptedAnswerDate
    from Posts q
    where q.PostTypeId = 1
),
question_activity as (
    select
        rq.QuestionId,
        rq.CreationDate as QuestionCreation,
        greatest(
            rq.CreationDate,
            coalesce(as1.LastAnswerDate, rq.CreationDate),
            coalesce(ca.LastCommentDate, rq.CreationDate),
            coalesce(q.LastActivityDate, rq.CreationDate)
        ) as LastActivity
    from recent_questions rq
    left join answer_stats as1 on as1.QuestionId = rq.QuestionId
    left join comment_agg ca on ca.PostId = rq.QuestionId
    left join Posts q on q.Id = rq.QuestionId
),
ranked_questions as (
    select
        rq.QuestionId,
        rq.Title,
        rq.Score,
        rq.ViewCount,
        rq.AnswerCount,
        rq.TagCount,
        ua.Reputation,
        coalesce(va.UpVotes,0) as UpVotes,
        coalesce(va.DownVotes,0) as DownVotes,
        coalesce(va.Favorites,0) as Favorites,
        coalesce(va.BountyTotal,0) as BountyTotal,
        coalesce(as1.AnswersTotal,0) as AnswersTotal,
        coalesce(as1.AnswersPositive,0) as AnswersPositive,
        coalesce(as1.MaxAnswerScore,0) as MaxAnswerScore,
        coalesce(ts.GlobalTagUsage,0) as GlobalTagUsage,
        coalesce(ts.QuestionTagCount,0) as QuestionTagCount,
        coalesce(ts.ModOnlyTags,0) as ModOnlyTags,
        coalesce(pl.DuplicateOf,0) as DuplicateOf,
        coalesce(pl.LinkedOut,0) as LinkedOut,
        ce.CloseCount,
        ce.ReopenCount,
        qa.LastActivity,
        aal.AcceptedAnswerDate,
        case
            when aal.AcceptedAnswerDate is null then null
            else extract(epoch from (aal.AcceptedAnswerDate - rq.CreationDate)) / 3600.0
        end as AcceptedLatencyHours,
        -- Composite score using window functions later
        0.0 as CompositeScore,
        ua.DisplayName,
        ua.NormLocation
    from recent_questions rq
    left join answer_stats as1 on as1.QuestionId = rq.QuestionId
    left join vote_agg va on va.PostId = rq.QuestionId
    left join comment_agg ca on ca.PostId = rq.QuestionId
    left join postlink_agg pl on pl.PostId = rq.QuestionId
    left join close_events ce on ce.PostId = rq.QuestionId
    left join Posts q on q.Id = rq.QuestionId
    left join user_enrichment ua on ua.UserId = q.OwnerUserId
    left join tag_stats ts on ts.QuestionId = rq.QuestionId
    left join question_activity qa on qa.QuestionId = rq.QuestionId
    left join accepted_answer_latency aal on aal.QuestionId = rq.QuestionId
),
scored as (
    select
        r.*,
        (r.Score - avg(r.Score) over ()) / nullif(stddev_pop(r.Score) over (), 0) as z_score,
        (r.ViewCount - avg(r.ViewCount) over ()) / nullif(stddev_pop(r.ViewCount) over (), 0) as z_views,
        (coalesce(r.UpVotes,0) - avg(coalesce(r.UpVotes,0)) over ()) / nullif(stddev_pop(coalesce(r.UpVotes,0)) over (), 0) as z_up,
        (coalesce(r.DownVotes,0) - avg(coalesce(r.DownVotes,0)) over ()) / nullif(stddev_pop(coalesce(r.DownVotes,0)) over (), 0) as z_down,
        (coalesce(r.Favorites,0) - avg(coalesce(r.Favorites,0)) over ()) / nullif(stddev_pop(coalesce(r.Favorites,0)) over (), 0) as z_fav,
        (coalesce(r.AnswersTotal,0) - avg(coalesce(r.AnswersTotal,0)) over ()) / nullif(stddev_pop(coalesce(r.AnswersTotal,0)) over (), 0) as z_ans,
        (coalesce(r.MaxAnswerScore,0) - avg(coalesce(r.MaxAnswerScore,0)) over ()) / nullif(stddev_pop(coalesce(r.MaxAnswerScore,0)) over (), 0) as z_maxa,
        (coalesce(r.GlobalTagUsage,0) - avg(coalesce(r.GlobalTagUsage,0)) over ()) / nullif(stddev_pop(coalesce(r.GlobalTagUsage,0)) over (), 0) as z_tglobal,
        (coalesce(r.LinkedOut,0) - avg(coalesce(r.LinkedOut,0)) over ()) / nullif(stddev_pop(coalesce(r.LinkedOut,0)) over (), 0) as z_linked,
        (coalesce(r.DuplicateOf,0) - avg(coalesce(r.DuplicateOf,0)) over ()) / nullif(stddev_pop(coalesce(r.DuplicateOf,0)) over (), 0) as z_dupe,
        (extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - r.LastActivity))/3600.0 - avg(extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - r.LastActivity))/3600.0) over ())
            / nullif(stddev_pop(extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - r.LastActivity))/3600.0) over (), 0) as z_recency,
        (coalesce(r.AcceptedLatencyHours, 24*365.0) - avg(coalesce(r.AcceptedLatencyHours, 24*365.0)) over ())
            / nullif(stddev_pop(coalesce(r.AcceptedLatencyHours, 24*365.0)) over (), 0) as z_accept_latency
    from ranked_questions r
),
weighted as (
    select
        s.*,
        (
            coalesce(s.z_score,0) * 0.25 +
            coalesce(s.z_views,0) * 0.15 +
            coalesce(s.z_up,0) * 0.20 +
            coalesce(-s.z_down,0) * 0.10 +
            coalesce(s.z_ans,0) * 0.10 +
            coalesce(s.z_maxa,0) * 0.05 +
            coalesce(s.z_tglobal,0) * 0.05 +
            coalesce(s.z_linked,0) * 0.03 +
            coalesce(-s.z_dupe,0) * 0.04 +
            coalesce(-s.z_recency,0) * 0.02 +
            coalesce(-s.z_accept_latency,0) * 0.01
        ) as CompositeScore
    from scored s
),
location_rollup as (
    select
        NormLocation,
        count(*) as QuestionsFromLocation,
        avg(CompositeScore) as AvgCompositeFromLocation,
        percentile_cont(0.9) within group (order by CompositeScore) as P90CompositeFromLocation
    from weighted
    group by NormLocation
),
topk as (
    select
        w.*,
        row_number() over (order by w.CompositeScore desc, w.ViewCount desc, w.Score desc) as rn
    from weighted w
),
dupe_chain as (
    select
        q.QuestionId,
        count(pl2.Id) as DupeChainLength
    from recent_questions q
    left join PostLinks pl1 on pl1.PostId = q.QuestionId and pl1.LinkTypeId = 3
    left join PostLinks pl2 on pl2.PostId = pl1.RelatedPostId and pl2.LinkTypeId = 3
    group by q.QuestionId
)
select
    t.QuestionId,
    t.Title,
    t.Score,
    t.ViewCount,
    t.UpVotes,
    t.DownVotes,
    t.Favorites,
    t.AnswersTotal,
    t.AnswersPositive,
    t.MaxAnswerScore,
    t.TagCount,
    t.GlobalTagUsage,
    t.LinkedOut,
    t.DuplicateOf,
    t.CloseCount,
    t.ReopenCount,
    round(t.CompositeScore::numeric, 4) as CompositeScore,
    t.DisplayName as OwnerDisplayName,
    t.NormLocation as OwnerLocation,
    lr.QuestionsFromLocation,
    round(lr.AvgCompositeFromLocation::numeric, 4) as AvgCompositeFromLocation,
    round(lr.P90CompositeFromLocation::numeric, 4) as P90CompositeFromLocation,
    dc.DupeChainLength,
    case
        when t.AcceptedAnswerDate is null then 'Unaccepted'
        when t.AcceptedLatencyHours <= 1 then 'Accepted in 1h'
        when t.AcceptedLatencyHours <= 24 then 'Accepted in 1d'
        when t.AcceptedLatencyHours <= 168 then 'Accepted in 1w'
        else 'Accepted later'
    end as AcceptanceBucket
from topk t
left join location_rollup lr on lr.NormLocation = t.NormLocation
left join dupe_chain dc on dc.QuestionId = t.QuestionId
where t.rn <= 200
order by t.CompositeScore desc, t.ViewCount desc, t.Score desc;