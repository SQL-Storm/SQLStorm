with params as (
  select
    date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) - interval '24 months' as start_month,
    date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) as end_month
),
months as (
  select generate_series(p.start_month, p.end_month, interval '1 month') as month_start
  from params p
),
user_activity as (
  select
    u.id as user_id,
    u.displayname,
    date_trunc('month', u.creationdate) as created_month,
    u.reputation,
    u.location,
    coalesce(nullif(trim(u.websiteurl), ''), 'unknown') as websiteurl_norm
  from users u
),
post_core as (
  select
    p.id,
    p.posttypeid,
    p.owneruserid,
    p.parentid,
    p.acceptedanswerid,
    p.score,
    p.viewcount,
    p.answercount,
    p.title,
    p.tags,
    p.creationdate,
    date_trunc('month', p.creationdate) as created_month
  from posts p
  where p.creationdate >= (select start_month from params) - interval '3 months'
),
answers as (
  select
    a.id,
    a.parentid as question_id,
    a.owneruserid as answerer_id,
    a.score,
    a.creationdate,
    date_trunc('month', a.creationdate) as created_month,
    dense_rank() over (partition by a.parentid order by a.score desc, a.creationdate asc, a.id asc) as rank_in_q
  from post_core a
  where a.posttypeid = 2
),
questions as (
  select
    q.id as question_id,
    q.owneruserid as asker_id,
    q.acceptedanswerid,
    q.score as q_score,
    q.viewcount,
    q.answercount,
    q.title,
    q.tags,
    q.creationdate,
    date_trunc('month', q.creationdate) as created_month
  from post_core q
  where q.posttypeid = 1
),
q_top_a as (
  select
    q.question_id,
    q.asker_id,
    q.acceptedanswerid,
    a.id as top_answer_id,
    a.answerer_id as top_answerer_id,
    a.score as top_answer_score,
    a.rank_in_q
  from questions q
  left join answers a
    on a.question_id = q.question_id
   and a.rank_in_q = 1
),
close_events as (
  select
    ph.postid as question_id,
    date_trunc('month', ph.creationdate) as closed_month,
    min(ph.creationdate) as first_closed_at,
    max(ph.creationdate) filter (where ph.posthistorytypeid = 11) as any_reopened_at,
    case
      when bool_or(ph.posthistorytypeid = 11) then 1
      else 0
    end as was_reopened
  from posthistory ph
  where ph.posthistorytypeid in (10,11)
  group by ph.postid, date_trunc('month', ph.creationdate)
),
dup_links as (
  select
    pl.postid as dup_question_id,
    pl.relatedpostid as canonical_question_id,
    date_trunc('month', pl.creationdate) as dup_month,
    count(*) as dup_link_count
  from postlinks pl
  where pl.linktypeid = 3
  group by pl.postid, pl.relatedpostid, date_trunc('month', pl.creationdate)
),
vote_aggs as (
  select
    v.postid,
    date_trunc('month', v.creationdate) as vote_month,
    sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
    sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
    sum(case when v.votetypeid = 5 then 1 else 0 end) as favorites,
    sum(case when v.votetypeid = 8 then coalesce(v.bountyamount,0) else 0 end) as bounty_started,
    sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded
  from votes v
  where v.creationdate >= (select start_month from params) - interval '3 months'
  group by v.postid, date_trunc('month', v.creationdate)
),
comment_sentiment as (
  select
    c.postid,
    date_trunc('month', c.creationdate) as comment_month,
    count(*) as comment_count,
    sum(case when c.score > 0 then 1 else 0 end) as pos_comments,
    sum(case when c.score < 0 then 1 else 0 end) as neg_comments,
    avg(nullif(length(c.text),0)) as avg_comment_len,
    sum(case when c.text ilike '%thanks%' or c.text ilike '%thank you%' then 1 else 0 end) as gratitude_hits
  from comments c
  where c.creationdate >= (select start_month from params) - interval '3 months'
  group by c.postid, date_trunc('month', c.creationdate)
),
tag_expansion as (
  select
    q.question_id,
    unnest(string_to_array(substring(q.tags, 2, greatest(length(q.tags)-2,0)), '><')) as tag
  from questions q
  where q.tags is not null
),
tag_stats as (
  select
    te.tag,
    count(*) as tag_q_count
  from tag_expansion te
  group by te.tag
),
user_badges as (
  select
    b.userid,
    date_trunc('month', b.date) as badge_month,
    sum(case when b.class = 1 then 1 else 0 end) as golds,
    sum(case when b.class = 2 then 1 else 0 end) as silvers,
    sum(case when b.class = 3 then 1 else 0 end) as bronzes,
    sum(case when b.tabbased = 1 then 1 else 0 end) as tag_badges
  from badges b
  where b.date >= (select start_month from params) - interval '3 months'
  group by b.userid, date_trunc('month', b.date)
),
question_months as (
  select
    m.month_start,
    q.question_id,
    q.asker_id
  from months m
  left join questions q
    on date_trunc('month', q.creationdate) = m.month_start
),
post_quality as (
  select
    qm.month_start,
    qm.question_id,
    q.q_score,
    q.viewcount,
    q.answercount,
    coalesce(va.upvotes,0) as upvotes,
    coalesce(va.downvotes,0) as downvotes,
    coalesce(va.favorites,0) as favorites,
    coalesce(va.bounty_started,0) as bounty_started,
    coalesce(va.bounty_awarded,0) as bounty_awarded,
    coalesce(cs.comment_count,0) as comment_count,
    coalesce(cs.pos_comments,0) as pos_comments,
    coalesce(cs.neg_comments,0) as neg_comments,
    coalesce(cs.avg_comment_len,0) as avg_comment_len,
    coalesce(cs.gratitude_hits,0) as gratitude_hits,
    coalesce(ce.was_reopened,0) as was_reopened,
    case when dl.dup_link_count is not null then 1 else 0 end as is_marked_duplicate
  from question_months qm
  left join questions q on q.question_id = qm.question_id
  left join vote_aggs va on va.postid = qm.question_id and va.vote_month = qm.month_start
  left join comment_sentiment cs on cs.postid = qm.question_id and cs.comment_month = qm.month_start
  left join close_events ce on ce.question_id = qm.question_id and ce.closed_month = qm.month_start
  left join dup_links dl on dl.dup_question_id = qm.question_id and dl.dup_month = qm.month_start
),
user_engagement as (
  select
    qm.month_start,
    u.user_id,
    u.displayname,
    u.reputation,
    u.location,
    u.websiteurl_norm,
    count(distinct qm.question_id) as questions_asked,
    count(distinct a.id) filter (where a.answerer_id = u.user_id and date_trunc('month', a.creationdate) = qm.month_start) as answers_posted,
    sum(pq.upvotes - pq.downvotes) as net_votes_on_questions,
    sum(pq.favorites) as favorites_on_questions
  from question_months qm
  left join user_activity u on u.user_id = qm.asker_id
  left join answers a on a.question_id = qm.question_id
  left join post_quality pq on pq.question_id = qm.question_id and pq.month_start = qm.month_start
  group by qm.month_start, u.user_id, u.displayname, u.reputation, u.location, u.websiteurl_norm
),
top_answer_vs_accept as (
  select
    qta.question_id,
    case
      when qta.top_answer_id is null then null
      when qta.acceptedanswerid is null then 0
      when qta.acceptedanswerid = qta.top_answer_id then 1
      else 0
    end as is_top_equal_accepted,
    qta.rank_in_q
  from q_top_a qta
),
question_scored as (
  select
    pq.*,
    tas.is_top_equal_accepted,
    tas.rank_in_q,
    case
      when pq.is_marked_duplicate = 1 then -10
      else 0
    end
    + coalesce(pq.q_score,0) * 2
    + coalesce(pq.upvotes,0) * 3
    - coalesce(pq.downvotes,0) * 5
    + coalesce(pq.favorites,0) * 4
    + coalesce(pq.bounty_awarded,0) / 50
    + case when pq.was_reopened = 1 then -15 else 0 end
    + least(coalesce(pq.viewcount,0) / 1000, 50)
    + greatest(0, 5 - coalesce(pq.answercount,0))
    - coalesce(pq.neg_comments,0)
    + case when pq.gratitude_hits > 0 then 2 else 0 end
    + case when tas.is_top_equal_accepted = 1 then 5 when tas.is_top_equal_accepted = 0 then -2 else 0 end
    as composite_quality_score
  from post_quality pq
  left join top_answer_vs_accept tas on tas.question_id = pq.question_id
),
ranked_questions as (
  select
    qs.*,
    dense_rank() over (partition by qs.month_start order by qs.composite_quality_score desc nulls last, qs.question_id) as rank_in_month,
    row_number() over (partition by qs.month_start order by coalesce(qs.viewcount,0) desc nulls last) as views_rank_in_month
  from question_scored qs
),
user_month_rollup as (
  select
    ue.month_start,
    ue.user_id,
    ue.displayname,
    ue.reputation,
    ue.location,
    ue.websiteurl_norm,
    ue.questions_asked,
    ue.answers_posted,
    ue.net_votes_on_questions,
    ue.favorites_on_questions,
    count(*) filter (where rq.rank_in_month <= 10) as top10_questions_count,
    avg(rq.composite_quality_score) as avg_quality_score,
    percentile_cont(0.9) within group (order by rq.composite_quality_score) as p90_quality_score
  from user_engagement ue
  left join ranked_questions rq
    on rq.month_start = ue.month_start
   and exists (
     select 1
     from questions q
     where q.question_id = rq.question_id
       and q.asker_id = ue.user_id
   )
  group by ue.month_start, ue.user_id, ue.displayname, ue.reputation, ue.location, ue.websiteurl_norm,
           ue.questions_asked, ue.answers_posted, ue.net_votes_on_questions, ue.favorites_on_questions
),
leaderboard as (
  select
    umr.*,
    dense_rank() over (
      partition by umr.month_start
      order by
        coalesce(umr.avg_quality_score, -1e9) desc,
        coalesce(umr.top10_questions_count, 0) desc,
        coalesce(umr.net_votes_on_questions, -1e9) desc,
        umr.user_id
    ) as user_rank
  from user_month_rollup umr
),
null_safety as (
  select
    l.month_start,
    l.user_id,
    coalesce(nullif(l.displayname, ''), '(unknown)') as displayname,
    coalesce(l.location, '(unspecified)') as location,
    case when position('://' in l.websiteurl_norm) > 0 then l.websiteurl_norm else 'http://' || l.websiteurl_norm end as websiteurl_norm,
    coalesce(l.reputation, 0) as reputation,
    coalesce(l.questions_asked, 0) as questions_asked,
    coalesce(l.answers_posted, 0) as answers_posted,
    coalesce(l.net_votes_on_questions, 0) as net_votes_on_questions,
    coalesce(l.favorites_on_questions, 0) as favorites_on_questions,
    coalesce(l.top10_questions_count, 0) as top10_questions_count,
    coalesce(l.avg_quality_score, 0) as avg_quality_score,
    coalesce(l.p90_quality_score, 0) as p90_quality_score,
    l.user_rank
  from leaderboard l
),
interleaved as (
  select
    to_char(n.month_start, 'YYYY-MM') as period,
    n.user_id,
    n.displayname,
    n.location,
    n.websiteurl_norm,
    n.reputation,
    n.questions_asked,
    n.answers_posted,
    n.net_votes_on_questions,
    n.favorites_on_questions,
    n.top10_questions_count,
    round(n.avg_quality_score, 2) as avg_quality_score,
    round(n.p90_quality_score, 2) as p90_quality_score,
    n.user_rank
  from null_safety n
  union all
  select
    to_char(rq.month_start, 'YYYY-MM') as period,
    rq.question_id as user_id,
    '(detail) Q:' || left(coalesce(q.title,''), 60) as displayname,
    coalesce(u.location, '(unspecified)') as location,
    coalesce(u.websiteurl, 'http://unknown') as websiteurl_norm,
    coalesce(u.reputation,0) as reputation,
    1 as questions_asked,
    0 as answers_posted,
    coalesce(rq.upvotes - rq.downvotes,0) as net_votes_on_questions,
    coalesce(rq.favorites,0) as favorites_on_questions,
    case when rq.rank_in_month <= 10 then 1 else 0 end as top10_questions_count,
    round(coalesce(rq.composite_quality_score,0) ,2) as avg_quality_score,
    round(coalesce(rq.composite_quality_score,0) ,2) as p90_quality_score,
    rq.rank_in_month as user_rank
  from ranked_questions rq
  join questions q on q.question_id = rq.question_id
  left join users u on u.id = q.asker_id
  where rq.rank_in_month <= 5
),
final as (
  select
    i.*,
    row_number() over (partition by i.period order by i.user_rank, i.user_id) as row_in_period
  from interleaved i
)
select *
from final
where period between to_char((select start_month from params), 'YYYY-MM') and to_char((select end_month from params), 'YYYY-MM')
order by period desc, row_in_period asc, user_rank asc, user_id asc;