WITH UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT c.Id) AS TotalComments,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsAsked,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersGiven,
        SUM(COALESCE(p.ViewCount,0)) AS TotalViews,
        SUM(COALESCE(p.Score,0)) AS PostScore,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        MIN(u.CreationDate) AS FirstSeen,
        MAX(u.LastAccessDate) AS LastSeen
    FROM
        Users AS u
        LEFT JOIN Posts AS p ON u.Id = p.OwnerUserId
        LEFT JOIN Comments AS c ON u.Id = c.UserId
        LEFT JOIN Badges AS b ON u.Id = b.UserId
    GROUP BY
        u.Id, u.DisplayName, u.Reputation
)
, MostActiveTags AS (
    SELECT
        p.OwnerUserId AS UserId,
        TRIM(BOTH '>' FROM
            REGEXP_REPLACE(REGEXP_SUBSTR(p.Tags, '>[^<]+<', 1, 1, '', 1), '^<|>$', '', 'g')) AS Tag,
        COUNT(*) AS TagUsage
    FROM
        Posts AS p
    WHERE
        p.PostTypeId = 1 AND p.Tags IS NOT NULL AND p.OwnerUserId IS NOT NULL
    GROUP BY
        p.OwnerUserId,
        TRIM(BOTH '>' FROM REGEXP_SUBSTR(p.Tags, '>[^<]+<', 1, 1, '', 1))
)
, TopTagsPerUser AS (
    SELECT
        UserId,
        Tag,
        TagUsage,
        ROW_NUMBER() OVER(PARTITION BY UserId ORDER BY TagUsage DESC NULLS LAST, Tag ASC) AS rn
    FROM
        MostActiveTags
)
, PostInterlinking AS (
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(CASE WHEN pl.LinkTypeId = 3 THEN 1 END) AS DuplicateLinks,
        COUNT(CASE WHEN pl.LinkTypeId = 1 THEN 1 END) AS RelatedLinks
    FROM
        PostLinks AS pl
        INNER JOIN Posts AS p ON pl.PostId = p.Id
    WHERE
        p.OwnerUserId IS NOT NULL
    GROUP BY
        p.OwnerUserId
)
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.TotalPosts,
    ua.TotalComments,
    ua.QuestionsAsked,
    ua.AnswersGiven,
    ua.TotalBadges,
    ua.FirstSeen,
    ua.LastSeen,
    ua.TotalViews,
    ua.PostScore,
    COALESCE(dup.DuplicateLinks, 0) AS DuplicateLinks,
    COALESCE(dup.RelatedLinks, 0) AS RelatedLinks,
    tt.Tag AS TopTag,
    tt.TagUsage AS TopTagUsage
FROM
    UserActivity AS ua
    LEFT JOIN PostInterlinking AS dup ON ua.UserId = dup.UserId
    LEFT JOIN (
        SELECT UserId, Tag, TagUsage FROM TopTagsPerUser WHERE rn = 1
    ) AS tt ON ua.UserId = tt.UserId
ORDER BY
    ua.PostScore DESC NULLS LAST,
    ua.TotalPosts DESC,
    ua.UserId
LIMIT 100;