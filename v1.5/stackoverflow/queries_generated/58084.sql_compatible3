WITH ActiveUsers AS (
    SELECT 
        u.Id, 
        u.DisplayName, 
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) AS TotalVotes,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        AVG(p.Score) OVER (PARTITION BY u.Id) AS AvgPostScore,
        RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank
    FROM Users AS u
    LEFT JOIN Posts AS p ON u.Id = p.OwnerUserId AND p.PostTypeId IN (1, 2)
    LEFT JOIN Comments AS c ON u.Id = c.UserId
    LEFT JOIN Votes AS v ON u.Id = v.UserId AND v.VoteTypeId IN (2, 3, 8)
    LEFT JOIN Badges AS b ON u.Id = b.UserId AND b.Class = 1
    WHERE 
        u.Reputation > 1000 AND
        p.CreationDate BETWEEN DATE '2020-01-01' AND DATE '2023-12-31' AND
        p.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId IN (1, 2))
    GROUP BY u.Id, u.DisplayName
),
TagAnalysis AS (
    SELECT 
        p.Id AS PostId,
        CARDINALITY(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><')) AS TagCount,
        SUM(p.AnswerCount) OVER (PARTITION BY p.OwnerUserId) AS UserTotalAnswers
    FROM Posts AS p
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
)
SELECT 
    au.Id,
    au.DisplayName,
    au.TotalPosts,
    au.TotalComments,
    au.TotalVotes,
    au.TotalBadges,
    au.AvgPostScore,
    ta.TagCount,
    ta.UserTotalAnswers,
    ph.CreationDate AS LastActivity,
    (SELECT COUNT(*) FROM PostHistory AS phis WHERE phis.UserId = au.Id AND phis.PostHistoryTypeId = 2) AS EditsMade
FROM ActiveUsers AS au
JOIN TagAnalysis AS ta ON au.Id = (
    SELECT OwnerUserId 
    FROM Posts AS p2 
    WHERE p2.Id = ta.PostId
    LIMIT 1
)
JOIN PostHistory AS ph ON au.Id = ph.UserId AND ph.PostHistoryTypeId IN (5, 6, 10)
WHERE 
    au.PostRank <= 100 AND
    ta.TagCount > 3 AND
    ph.CreationDate = (
        SELECT MAX(CreationDate) 
        FROM PostHistory AS ph2 
        WHERE ph2.UserId = au.Id
    )
ORDER BY 
    au.TotalPosts DESC, 
    au.AvgPostScore DESC
LIMIT 100;