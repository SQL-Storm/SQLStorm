WITH
TopQuestioners AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(*) AS QuestionsAsked,
        SUM(p.Score) AS TotalScore,
        ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC, SUM(p.Score) DESC) AS RankByQuestions
    FROM Posts p
    JOIN Users u
      ON u.Id = p.OwnerUserId
    WHERE p.PostTypeId = 1
    GROUP BY u.Id, u.DisplayName
),
TagStats AS (
    SELECT
        t.TagName,
        COUNT(p.Id) AS QuestionCount,
        AVG(p.Score) AS AvgScore
    FROM Tags t
    JOIN Posts p
      ON p.PostTypeId = 1
     AND p.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    GROUP BY t.TagName
    HAVING COUNT(p.Id) > 100
),
UserBadgeStats AS (
    SELECT
        u.Id AS UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Users u
    LEFT JOIN Badges b
      ON b.UserId = u.Id
    GROUP BY u.Id
),
UserLastActivity AS (
    SELECT
        OwnerUserId AS UserId,
        MAX(LastActivityDate) AS LastActivity
    FROM Posts
    GROUP BY OwnerUserId
)
SELECT
    tq.RankByQuestions,
    tq.DisplayName,
    tq.QuestionsAsked,
    tq.TotalScore,
    ubs.GoldBadges,
    ubs.SilverBadges,
    ubs.BronzeBadges,
    TO_CHAR(ula.LastActivity, 'YYYY-MM') AS LastActiveMonth,
    COUNT(p.Id) OVER (PARTITION BY EXTRACT(YEAR FROM CAST(ula.LastActivity AS DATE)) * 12 + EXTRACT(MONTH FROM CAST(ula.LastActivity AS DATE))) AS PostsThisMonth,
    JSON_AGG(
      JSON_BUILD_OBJECT(
        'tag', ts.TagName,
        'count', ts.QuestionCount,
        'avgScore', ROUND(ts.AvgScore, 2)
      )
      ORDER BY ts.QuestionCount DESC
    ) FILTER (WHERE ts.TagName IS NOT NULL) AS TopTags
FROM TopQuestioners tq
JOIN UserBadgeStats ubs
  ON ubs.UserId = tq.UserId
JOIN UserLastActivity ula
  ON ula.UserId = tq.UserId
JOIN Posts p
  ON p.OwnerUserId = tq.UserId
LEFT JOIN TagStats ts
  ON TRUE
WHERE tq.RankByQuestions <= 50
GROUP BY
    tq.RankByQuestions,
    tq.DisplayName,
    tq.QuestionsAsked,
    tq.TotalScore,
    ubs.GoldBadges,
    ubs.SilverBadges,
    ubs.BronzeBadges,
    TO_CHAR(ula.LastActivity, 'YYYY-MM')
ORDER BY
    tq.RankByQuestions,
    LastActiveMonth DESC;