WITH TopActiveUsers AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(b.Id) AS BadgeCount,
        SUM(COALESCE(p.ViewCount, 0)) AS TotalViews,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS QuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS AnswerScore
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    WHERE u.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '2' YEAR
    GROUP BY u.Id, u.DisplayName
    HAVING COUNT(DISTINCT p.Id) > 20
),
TopTags AS (
    SELECT 
        tag.TagName,
        COUNT(*) AS UsageCount
    FROM (
        SELECT
            TRIM(BOTH ' ' FROM x.value) AS TagName
        FROM Posts p
        CROSS JOIN LATERAL (
            SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags) - 2), '><')) AS value
        ) AS x
        WHERE p.PostTypeId = 1
    ) AS tag
    GROUP BY tag.TagName
    ORDER BY UsageCount DESC
    LIMIT 20
),
TagExperts AS (
    SELECT
        tu.UserId,
        tt.TagName,
        COUNT(DISTINCT p.Id) AS AnsweredQuestions,
        SUM(p.Score) AS AnswerScore
    FROM TopActiveUsers tu
    JOIN Posts p ON p.OwnerUserId = tu.UserId AND p.PostTypeId = 2
    JOIN Posts q ON p.ParentId = q.Id AND q.PostTypeId = 1
    JOIN TopTags tt ON q.Tags LIKE '%' || tt.TagName || '%'
    GROUP BY tu.UserId, tt.TagName
),
BadgePerformance AS (
    SELECT
        tu.UserId,
        tu.DisplayName,
        b.Name AS BadgeName,
        b.Class AS BadgeClass,
        COUNT(*) AS BadgeCount
    FROM TopActiveUsers tu
    JOIN Badges b ON b.UserId = tu.UserId
    GROUP BY tu.UserId, tu.DisplayName, b.Name, b.Class
),
UserActivityTimeline AS (
    SELECT
        tu.UserId,
        DATE_TRUNC('month', p.CreationDate) AS ActivityMonth,
        COUNT(*) AS PostsInMonth,
        SUM(COALESCE(p.Score,0)) AS TotalScore
    FROM TopActiveUsers tu
    JOIN Posts p ON p.OwnerUserId = tu.UserId
    GROUP BY tu.UserId, DATE_TRUNC('month', p.CreationDate)
    HAVING COUNT(*) > 2
)

SELECT
    tu.UserId,
    tu.DisplayName,
    tu.PostCount,
    tu.CommentCount,
    tu.BadgeCount,
    tu.TotalViews,
    tu.QuestionScore,
    tu.AnswerScore,
    COALESCE(string_agg(DISTINCT te.TagName, ','), '') AS TopTagsAnswered,
    COALESCE(SUM(te.AnsweredQuestions), 0) AS TotalTaggedAnswers,
    COALESCE(SUM(te.AnswerScore), 0) AS TotalTaggedAnswerScore,
    COALESCE(ba.TopBadge, '') AS MostEarnedBadge,
    COALESCE(ba.BadgeClass, '') AS TopBadgeClass,
    COALESCE(ua.ActivityMonths, 0) AS MonthsActive
FROM TopActiveUsers tu
LEFT JOIN TagExperts te ON te.UserId = tu.UserId
LEFT JOIN (
    SELECT UserId, BadgeName AS TopBadge, BadgeClass
    FROM (
        SELECT
            bp.UserId,
            bp.BadgeName,
            bp.BadgeClass,
            bp.BadgeCount,
            ROW_NUMBER() OVER (PARTITION BY bp.UserId ORDER BY bp.BadgeCount DESC, bp.BadgeClass ASC) AS rnk
        FROM BadgePerformance bp
    ) b WHERE rnk = 1
) ba ON ba.UserId = tu.UserId
LEFT JOIN (
    SELECT UserId, COUNT(*) AS ActivityMonths
    FROM UserActivityTimeline
    GROUP BY UserId
) ua ON ua.UserId = tu.UserId
GROUP BY
    tu.UserId, tu.DisplayName, tu.PostCount, tu.CommentCount, tu.BadgeCount,
    tu.TotalViews, tu.QuestionScore, tu.AnswerScore, ba.TopBadge, ba.BadgeClass, ua.ActivityMonths
ORDER BY
    tu.AnswerScore + tu.QuestionScore DESC,
    tu.TotalViews DESC
LIMIT 25;