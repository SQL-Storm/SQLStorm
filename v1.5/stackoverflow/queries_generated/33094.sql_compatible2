SELECT
    p.Id AS PostId,
    p.Title,
    p.PostTypeId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    u.Id AS OwnerUserId,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation,
    u.AccountId,
    u.LastAccessDate,
    u.Location,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    c.CommentId,
    c.Score AS CommentScore,
    c.Text AS CommentText,
    c.CreationDate AS CommentCreationDate,
    v.VoteTypeId,
    vt.Name AS VoteTypeName,
    v.CreationDate AS VoteCreationDate,
    pl.RelatedPostId,
    rt.TagName,
    t.TagName AS QuestionTag,
    th.PostHistoryTypeId,
    pht.Name AS PostHistoryTypeName,
    pht.Id AS PostHistoryTypeId,
    ph.RevisionGUID,
    ph.CreationDate AS PostHistoryDate,
    pl.LinkTypeId,
    lt.Name AS LinkTypeName
FROM Posts AS p
LEFT JOIN Users AS u ON p.OwnerUserId = u.Id
LEFT JOIN Comments AS c ON c.PostId = p.Id
LEFT JOIN Votes AS v ON v.PostId = p.Id
LEFT JOIN VoteTypes AS vt ON v.VoteTypeId = vt.Id
LEFT JOIN PostLinks AS pl ON pl.PostId = p.Id
LEFT JOIN Posts AS rel_post ON pl.RelatedPostId = rel_post.Id
LEFT JOIN PostTypes AS pt ON p.PostTypeId = pt.Id
LEFT JOIN PostHistory AS ph ON ph.PostId = p.Id
LEFT JOIN PostHistoryTypes AS pht ON ph.PostHistoryTypeId = pht.Id
LEFT JOIN Taggings AS tt ON p.Id = tt.PostId
LEFT JOIN Tags AS t ON tt.TagId = t.Id
LEFT JOIN LinkTypes AS lt ON pl.LinkTypeId = lt.Id
LEFT JOIN TagWikiArticles AS twa ON t.WikiPostId = twa.PostId
LEFT JOIN QuestionTags AS qtags ON p.Id = qtags.PostId
WHERE
    p.PostTypeId IN (1, 2)
    AND p.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year'
    AND (u.Reputation >= 1000 OR u.Views >= 10000)
    AND (
        EXISTS (
            SELECT 1 FROM Votes AS vv WHERE vv.PostId = p.Id AND vv.VoteTypeId IN (2, 3)
        )
        OR p.Score >= 10
    )
    AND EXISTS (
        SELECT 1 FROM PostLinks AS plk WHERE plk.PostId = p.Id AND plk.LinkTypeId = 1
    )
ORDER BY
    p.CreationDate DESC
LIMIT 100;