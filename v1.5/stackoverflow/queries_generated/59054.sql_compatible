SELECT 
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN p.Id END) AS QuestionsWithAcceptedAnswers,
    COUNT(DISTINCT b.Id) AS Badges,
    COUNT(DISTINCT v.Id) AS Votes,
    COUNT(DISTINCT c.Id) AS Comments,
    COUNT(DISTINCT ph.Id) AS PostHistoryEntries,
    COUNT(DISTINCT pl.Id) AS PostLinks,
    COUNT(DISTINCT t.Id) AS Tags,
    AVG(p.Score) AS AvgPostScore,
    MAX(p.Score) AS MaxPostScore,
    MIN(p.Score) AS MinPostScore,
    SUM(p.ViewCount) AS TotalViews,
    SUM(p.FavoriteCount) AS TotalFavorites,
    COUNT(DISTINCT CASE WHEN p.CreationDate >= DATE '2023-01-01' THEN p.Id END) AS RecentPosts,
    COUNT(DISTINCT CASE WHEN p.CreationDate >= DATE '2023-01-01' AND p.PostTypeId = 1 THEN p.Id END) AS RecentQuestions,
    COUNT(DISTINCT CASE WHEN p.CreationDate >= DATE '2023-01-01' AND p.PostTypeId = 2 THEN p.Id END) AS RecentAnswers,
    COUNT(DISTINCT CASE WHEN u.CreationDate >= DATE '2023-01-01' THEN u.Id END) AS NewUsers,
    COUNT(DISTINCT CASE WHEN u.LastAccessDate >= DATE '2023-01-01' THEN u.Id END) AS ActiveUsers,
    COUNT(DISTINCT CASE WHEN u.LastAccessDate >= DATE '2023-01-01' AND u.Reputation > 1000 THEN u.Id END) AS ActiveHighRepUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation > 10000 THEN u.Id END) AS HighRepUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation < 100 THEN u.Id END) AS LowRepUsers,
    COUNT(DISTINCT CASE WHEN u.Views > 1000 THEN u.Id END) AS HighViewsUsers,
    COUNT(DISTINCT CASE WHEN u.UpVotes > 100 THEN u.Id END) AS HighUpVotesUsers,
    COUNT(DISTINCT CASE WHEN u.DownVotes > 100 THEN u.Id END) AS HighDownVotesUsers,
    COUNT(DISTINCT CASE WHEN u.AccountId IS NOT NULL THEN u.Id END) AS UsersWithAccounts,
    COUNT(DISTINCT CASE WHEN u.WebsiteUrl IS NOT NULL AND u.WebsiteUrl <> '' THEN u.Id END) AS UsersWithWebsite,
    COUNT(DISTINCT CASE WHEN u.Location IS NOT NULL AND u.Location <> '' THEN u.Id END) AS UsersWithLocation,
    COUNT(DISTINCT CASE WHEN u.AboutMe IS NOT NULL AND LENGTH(u.AboutMe) > 100 THEN u.Id END) AS UsersWithDetailedAboutMe,
    COUNT(DISTINCT CASE WHEN p.Tags IS NOT NULL AND p.Tags <> '' THEN p.Id END) AS TaggedPosts,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 1 THEN ph.Id END) AS InitialTitleEdits,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 2 THEN ph.Id END) AS InitialBodyEdits,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 3 THEN ph.Id END) AS InitialTagEdits,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 4 THEN ph.Id END) AS EditTitleEdits,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 5 THEN ph.Id END) AS EditBodyEdits,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 6 THEN ph.Id END) AS EditTagEdits,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.Id END) AS PostClosed,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 11 THEN ph.Id END) AS PostReopened,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 12 THEN ph.Id END) AS PostDeleted,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 13 THEN ph.Id END) AS PostUndeleted,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 14 THEN ph.Id END) AS PostLocked,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 15 THEN ph.Id END) AS PostUnlocked,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 16 THEN ph.Id END) AS CommunityOwned,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 17 THEN ph.Id END) AS PostMigrated,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 18 THEN ph.Id END) AS QuestionMerged,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 19 THEN ph.Id END) AS QuestionProtected,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 20 THEN ph.Id END) AS QuestionUnprotected,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 22 THEN ph.Id END) AS QuestionUnmerged,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 24 THEN ph.Id END) AS SuggestedEditApplied,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 31 THEN ph.Id END) AS DiscussionMovedToChat,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 33 THEN ph.Id END) AS PostNoticeAdded,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 34 THEN ph.Id END) AS PostNoticeRemoved,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 35 THEN ph.Id END) AS PostMigratedAway,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 36 THEN ph.Id END) AS PostMigratedHere,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 37 THEN ph.Id END) AS PostMergeSource,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 38 THEN ph.Id END) AS PostMergeDestination,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 50 THEN ph.Id END) AS CommunityBump,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 52 THEN ph.Id END) AS SelectedHotQuestion,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 53 THEN ph.Id END) AS RemovedHotQuestion,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 66 THEN ph.Id END) AS CreatedFromWizard,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 1 THEN v.Id END) AS AcceptedAnswers,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS UpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS DownVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 4 THEN v.Id END) AS OffensiveVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 5 THEN v.Id END) AS FavoriteVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 6 THEN v.Id END) AS CloseVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 7 THEN v.Id END) AS ReopenVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 8 THEN v.Id END) AS BountyStartVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 9 THEN v.Id END) AS BountyCloseVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 10 THEN v.Id END) AS DeletionVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 11 THEN v.Id END) AS UndeletionVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 12 THEN v.Id END) AS SpamVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 14 THEN v.Id END) AS NominateModeratorVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 15 THEN v.Id END) AS ModeratorReviewVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 16 THEN v.Id END) AS ApproveEditSuggestionVotes,
    COUNT(DISTINCT CASE WHEN c.Score > 0 THEN c.Id END) AS PositiveComments,
    COUNT(DISTINCT CASE WHEN c.Score < 0 THEN c.Id END) AS NegativeComments,
    COUNT(DISTINCT CASE WHEN c.Score = 0 THEN c.Id END) AS NeutralComments,
    COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 1 THEN pl.Id END) AS LinkedPosts,
    COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN pl.Id END) AS DuplicatePosts,
    COUNT(DISTINCT CASE WHEN t.IsRequired = 1 THEN t.Id END) AS RequiredTags,
    COUNT(DISTINCT CASE WHEN t.IsModeratorOnly = 1 THEN t.Id END) AS ModeratorOnlyTags,
    COUNT(DISTINCT CASE WHEN t.Count > 100 THEN t.Id END) AS PopularTags,
    COUNT(DISTINCT CASE WHEN t.Count < 10 THEN t.Id END) AS RareTags
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId OR u.Id = p.LastEditorUserId
LEFT JOIN Badges b ON u.Id = b.UserId
LEFT JOIN Votes v ON u.Id = v.UserId OR u.Id = v.UserId
LEFT JOIN Comments c ON u.Id = c.UserId OR u.Id = c.UserId
LEFT JOIN PostHistory ph ON u.Id = ph.UserId
LEFT JOIN PostLinks pl ON u.Id = pl.Id OR u.Id = pl.Id
LEFT JOIN Tags t ON u.Id = t.Id
WHERE u.CreationDate >= DATE '2008-01-01'
GROUP BY u.Id, u.DisplayName, u.Reputation
HAVING COUNT(DISTINCT p.Id) > 0
ORDER BY u.Reputation DESC, COUNT(DISTINCT p.Id) DESC
LIMIT 1000;