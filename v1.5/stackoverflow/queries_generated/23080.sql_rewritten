-- {"query": "23080.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "grok-4", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2685, "output_tokens": 939} 
WITH UserPostStats AS (
    SELECT 
        u.Id AS UserId,
        COUNT(p.Id) AS TotalPosts,
        AVG(COALESCE(p.Score, 0)) AS AvgScore,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE 0 END) AS TotalQuestionViews,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS PostRank
    FROM Users u
    LEFT OUTER JOIN Posts p ON u.Id = p.OwnerUserId
    GROUP BY u.Id
),
TopTagsPerUser AS (
    SELECT 
        u.Id AS UserId,
        t.TagName,
        COUNT(*) AS TagCount,
        RANK() OVER (PARTITION BY u.Id ORDER BY COUNT(*) DESC) AS TagRank
    FROM Users u
    INNER JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
    CROSS JOIN LATERAL string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><') AS tag_arr
    INNER JOIN Tags t ON t.TagName = tag_arr
    GROUP BY u.Id, t.TagName
    HAVING COUNT(*) > 1
),
UserBadges AS (
    SELECT 
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        STRING_AGG(b.Name || ' (' || CASE b.Class WHEN 1 THEN 'Gold' WHEN 2 THEN 'Silver' ELSE 'Bronze' END || ')', ', ') AS BadgeList
    FROM Badges b
    WHERE b.TagBased = TRUE OR b.Class = 1
    GROUP BY b.UserId
),
RecentActivity AS (
    SELECT 
        ph.UserId,
        MAX(ph.CreationDate) AS LastEditDate,
        COUNT(DISTINCT ph.PostId) AS EditedPosts
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4,5,6) AND ph.Comment IS NOT NULL
    GROUP BY ph.UserId
),
CorrelatedSubqueryExample AS (
    SELECT 
        u.Id AS UserId,
        (SELECT COUNT(v.Id) FROM Votes v WHERE v.PostId IN (SELECT p.Id FROM Posts p WHERE p.OwnerUserId = u.Id) AND v.VoteTypeId = 2) AS UpvotesReceived
    FROM Users u
)
SELECT 
    u.DisplayName,
    u.Reputation,
    ups.TotalPosts,
    ups.AvgScore,
    ups.TotalQuestionViews,
    COALESCE(tt.TagName, 'No Tags') AS TopTag,
    COALESCE(ub.TotalBadges, 0) AS TotalBadges,
    ub.BadgeList,
    ra.LastEditDate,
    ra.EditedPosts,
    cs.UpvotesReceived,
    DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank
FROM Users u
LEFT OUTER JOIN UserPostStats ups ON u.Id = ups.UserId AND ups.PostRank = 1
LEFT OUTER JOIN TopTagsPerUser tt ON u.Id = tt.UserId AND tt.TagRank = 1
LEFT OUTER JOIN UserBadges ub ON u.Id = ub.UserId
LEFT OUTER JOIN RecentActivity ra ON u.Id = ra.UserId
LEFT OUTER JOIN CorrelatedSubqueryExample cs ON u.Id = cs.UserId
WHERE u.Reputation > (SELECT AVG(Reputation) FROM Users) * 2
  AND (u.Location LIKE '%USA%' OR u.Location IS NULL)
  AND EXISTS (SELECT 1 FROM Comments c WHERE c.UserId = u.Id AND c.Score > 5)
UNION ALL
SELECT 
    'Community' AS DisplayName,
    0 AS Reputation,
    COUNT(p.Id) AS TotalPosts,
    AVG(COALESCE(p.Score, 0)) AS AvgScore,
    SUM(p.ViewCount) AS TotalQuestionViews,
    NULL AS TopTag,
    0 AS TotalBadges,
    NULL AS BadgeList,
    MAX(ph.CreationDate) AS LastEditDate,
    COUNT(DISTINCT ph.PostId) AS EditedPosts,
    (SELECT COUNT(v.Id) FROM Votes v WHERE v.PostId IN (SELECT p.Id FROM Posts p WHERE p.OwnerUserId = -1) AND v.VoteTypeId = 2) AS UpvotesReceived,
    NULL AS ReputationRank
FROM Posts p
LEFT OUTER JOIN PostHistory ph ON p.Id = ph.PostId
WHERE p.OwnerUserId = -1
GROUP BY ()
ORDER BY Reputation DESC
LIMIT 10;