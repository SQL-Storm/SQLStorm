WITH RECURSIVE user_expertise AS (
    SELECT 
        u.Id AS UserId,
        t.TagName,
        COUNT(DISTINCT p.Id) AS AnswerCount,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgScore,
        DENSE_RANK() OVER (PARTITION BY t.TagName ORDER BY SUM(p.Score) DESC) AS TagRank
    FROM Users u
    INNER JOIN Posts p ON u.Id = p.OwnerUserId
    INNER JOIN Posts q ON p.ParentId = q.Id
    CROSS JOIN LATERAL string_to_array(substring(q.Tags, 2, length(q.Tags)-2), '><') AS tag_array(tag)
    INNER JOIN Tags t ON t.TagName = tag_array.tag
    WHERE p.PostTypeId = 2
        AND p.Score > 0
        AND u.Reputation > 1000
    GROUP BY u.Id, t.TagName
    HAVING COUNT(DISTINCT p.Id) >= 5
),
badge_patterns AS (
    SELECT 
        b.UserId,
        b.Class,
        COUNT(*) AS BadgeCount,
        STRING_AGG(DISTINCT b.Name, ', ' ORDER BY b.Name) AS BadgeNames,
        MIN(b.Date) AS FirstBadgeDate,
        MAX(b.Date) AS LastBadgeDate
    FROM Badges b
    WHERE b.Date >= cast('2024-10-01' as date) - INTERVAL '2 years'
    GROUP BY b.UserId, b.Class
),
question_quality AS (
    SELECT 
        p.OwnerUserId,
        COUNT(DISTINCT p.Id) AS QuestionCount,
        AVG(p.Score) AS AvgQuestionScore,
        AVG(p.ViewCount) AS AvgViews,
        AVG(p.AnswerCount) AS AvgAnswers,
        CAST(SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS FLOAT) / NULLIF(COUNT(*), 0) AS AcceptanceRate,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS MedianScore
    FROM Posts p
    WHERE p.PostTypeId = 1
        AND p.OwnerUserId IS NOT NULL
        AND p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '1 year'
    GROUP BY p.OwnerUserId
),
edit_activity AS (
    SELECT 
        ph.UserId,
        COUNT(DISTINCT ph.PostId) AS EditedPosts,
        COUNT(*) AS TotalEdits,
        COUNT(DISTINCT DATE(ph.CreationDate)) AS ActiveEditDays,
        AVG(LENGTH(ph.Text)) AS AvgEditSize
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4, 5, 6)
        AND ph.UserId IS NOT NULL
    GROUP BY ph.UserId
),
community_engagement AS (
    SELECT 
        c.UserId,
        COUNT(*) AS CommentCount,
        AVG(c.Score) AS AvgCommentScore,
        COUNT(DISTINCT p.OwnerUserId) FILTER (WHERE p.OwnerUserId != c.UserId) AS UniqueUsersHelped,
        COUNT(DISTINCT DATE(c.CreationDate)) AS ActiveCommentDays
    FROM Comments c
    INNER JOIN Posts p ON c.PostId = p.Id
    WHERE c.UserId IS NOT NULL
    GROUP BY c.UserId
)
SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.Location,
    DATE_PART('day', CAST('2024-10-01' AS DATE) - u.CreationDate) AS AccountAgeDays,
    COALESCE(ue.TagCount, 0) AS ExpertiseTagCount,
    COALESCE(ue.TopTags, '') AS TopTags,
    COALESCE(ue.TopTagScores, '') AS TopTagScores,
    COALESCE(bp_gold.BadgeCount, 0) AS GoldBadges,
    COALESCE(bp_silver.BadgeCount, 0) AS SilverBadges,
    COALESCE(bp_bronze.BadgeCount, 0) AS BronzeBadges,
    COALESCE(qq.QuestionCount, 0) AS QuestionsAsked,
    ROUND(COALESCE(qq.AvgQuestionScore, 0), 2) AS AvgQuestionScore,
    ROUND(COALESCE(qq.AcceptanceRate, 0) * 100, 2) AS AcceptanceRatePercent,
    COALESCE(ea.TotalEdits, 0) AS TotalEdits,
    COALESCE(ea.ActiveEditDays, 0) AS ActiveEditDays,
    COALESCE(ce.CommentCount, 0) AS TotalComments,
    ROUND(COALESCE(ce.AvgCommentScore, 0), 2) AS AvgCommentScore,
    COALESCE(ce.UniqueUsersHelped, 0) AS UniqueUsersHelped,
    ROUND(
        (COALESCE(ue.NormalizedScore, 0) * 0.35) +
        (COALESCE(qq.NormalizedQuality, 0) * 0.25) +
        (COALESCE(ea.NormalizedActivity, 0) * 0.20) +
        (COALESCE(ce.NormalizedEngagement, 0) * 0.20), 2
    ) AS CompositeScore
FROM Users u
LEFT JOIN LATERAL (
    SELECT 
        COUNT(DISTINCT TagName) AS TagCount,
        STRING_AGG(TagName, ', ' ORDER BY TotalScore DESC) AS TopTags,
        STRING_AGG(CAST(TotalScore AS VARCHAR), ', ' ORDER BY TotalScore DESC) AS TopTagScores,
        SUM(TotalScore) / NULLIF(MAX(SUM(TotalScore)) OVER (), 0) AS NormalizedScore
    FROM user_expertise
    WHERE UserId = u.Id AND TagRank <= 10
    GROUP BY UserId
) ue ON TRUE
LEFT JOIN badge_patterns bp_gold ON u.Id = bp_gold.UserId AND bp_gold.Class = 1
LEFT JOIN badge_patterns bp_silver ON u.Id = bp_silver.UserId AND bp_silver.Class = 2
LEFT JOIN badge_patterns bp_bronze ON u.Id = bp_bronze.UserId AND bp_bronze.Class = 3
LEFT JOIN LATERAL (
    SELECT 
        qq.*,
        (AvgQuestionScore * AcceptanceRate * LOG(QuestionCount + 1)) / 
            NULLIF(MAX(AvgQuestionScore * AcceptanceRate * LOG(QuestionCount + 1)) OVER (), 0) AS NormalizedQuality
    FROM question_quality qq
    WHERE qq.OwnerUserId = u.Id
) qq ON TRUE
LEFT JOIN LATERAL (
    SELECT 
        ea.*,
        (TotalEdits * ActiveEditDays) / NULLIF(MAX(TotalEdits * ActiveEditDays) OVER (), 0) AS NormalizedActivity
    FROM edit_activity ea
    WHERE ea.UserId = u.Id
) ea ON TRUE
LEFT JOIN LATERAL (
    SELECT 
        ce.*,
        (CommentCount * UniqueUsersHelped * COALESCE(AvgCommentScore + 1, 1)) / 
            NULLIF(MAX(CommentCount * UniqueUsersHelped * COALESCE(AvgCommentScore + 1, 1)) OVER (), 0) AS NormalizedEngagement
    FROM community_engagement ce
    WHERE ce.UserId = u.Id
) ce ON TRUE
WHERE u.Reputation > 500
    AND u.LastAccessDate >= CAST('2024-10-01' AS DATE) - INTERVAL '6 months'
    AND (ue.TagCount > 0 OR qq.QuestionCount > 0 OR ea.TotalEdits > 0 OR ce.CommentCount > 0)
ORDER BY CompositeScore DESC
FETCH FIRST 100 ROWS ONLY;