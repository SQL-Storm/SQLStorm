WITH cte AS (
  SELECT p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount, p.ClosedDate, p.CommunityOwnedDate, u.Id AS UserId, u.Reputation, u.CreationDate AS UserCreationDate, u.LastAccessDate, u.Views, u.UpVotes, u.DownVotes, b.Id AS BadgeId, b.Name AS BadgeName, b.Date AS BadgeDate, b.Class AS BadgeClass, b.TagBased AS BadgeTagBased, c.Id AS CommentId, c.Score AS CommentScore, c.CreationDate AS CommentCreationDate, v.Id AS VoteId, v.VoteTypeId, v.CreationDate AS VoteCreationDate, v.BountyAmount, pl.Id AS PostLinkId, pl.LinkTypeId, pl.CreationDate AS PostLinkCreationDate, pt.Name AS PostTypeName, ct.Name AS CloseReasonName, lt.Name AS LinkTypeName, vt.Name AS VoteTypeName
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN Badges b ON u.Id = b.UserId
  LEFT JOIN Comments c ON p.Id = c.PostId
  LEFT JOIN Votes v ON p.Id = v.PostId
  LEFT JOIN PostLinks pl ON p.Id = pl.PostId
  LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
  LEFT JOIN CloseReasonTypes ct ON p.ClosedDate IS NOT NULL AND EXTRACT(EPOCH FROM p.ClosedDate) = EXTRACT(EPOCH FROM (SELECT ct2.Id FROM CloseReasonTypes ct2 WHERE ct2.Id = ct.Id))
  LEFT JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
  LEFT JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
)
SELECT
  COUNT(*) AS TotalPosts,
  COUNT(DISTINCT UserId) AS UniqueUserCount,
  COUNT(DISTINCT BadgeId) AS UniqueBadgeCount,
  COUNT(DISTINCT CommentId) AS UniqueCommentCount,
  COUNT(DISTINCT VoteId) AS UniqueVoteCount,
  COUNT(DISTINCT PostLinkId) AS UniquePostLinkCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'Question' THEN p.Id END) AS QuestionCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'Answer' THEN p.Id END) AS AnswerCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'Wiki' THEN p.Id END) AS WikiCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'TagWikiExcerpt' THEN p.Id END) AS TagWikiExcerptCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'TagWiki' THEN p.Id END) AS TagWikiCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'ModeratorNomination' THEN p.Id END) AS ModeratorNominationCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'WikiPlaceholder' THEN p.Id END) AS WikiPlaceholderCount,
  COUNT(DISTINCT CASE WHEN PostTypeName = 'PrivilegeWiki' THEN p.Id END) AS PrivilegeWikiCount,
  COUNT(DISTINCT CASE WHEN p.ClosedDate IS NOT NULL THEN p.Id END) AS ClosedPostCount,
  COUNT(DISTINCT CASE WHEN p.CommunityOwnedDate IS NOT NULL THEN p.Id END) AS CommunityOwnedPostCount,
  AVG(p.Score) AS AvgPostScore,
  AVG(p.ViewCount) AS AvgPostViewCount,
  AVG(p.AnswerCount) AS AvgPostAnswerCount,
  AVG(p.CommentCount) AS AvgPostCommentCount,
  AVG(p.FavoriteCount) AS AvgPostFavoriteCount,
  AVG(u.Reputation) AS AvgUserReputation,
  AVG(u.Views) AS AvgUserViews,
  AVG(u.UpVotes) AS AvgUserUpVotes,
  AVG(u.DownVotes) AS AvgUserDownVotes,
  AVG(CASE WHEN p.BadgeClass IS NULL THEN 0 ELSE p.BadgeClass END) AS AvgBadgeClass,
  AVG(c.Score) AS AvgCommentScore,
  AVG(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteRatio,
  AVG(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteRatio,
  AVG(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS FavoriteVoteRatio,
  AVG(CASE WHEN v.VoteTypeId = 6 THEN 1 ELSE 0 END) AS CloseVoteRatio,
  AVG(CASE WHEN v.VoteTypeId = 7 THEN 1 ELSE 0 END) AS ReopenVoteRatio,
  AVG(p.BountyAmount) AS AvgBountyAmount,
  COUNT(DISTINCT CASE WHEN lt.Name = 'Linked' THEN pl.Id END) AS LinkedPostLinkCount,
  COUNT(DISTINCT CASE WHEN lt.Name = 'Duplicate' THEN pl.Id END) AS DuplicatePostLinkCount
FROM cte p
GROUP BY
  p.Id,
  p.PostTypeId,
  p.CreationDate,
  p.Score,
  p.ViewCount,
  p.AnswerCount,
  p.CommentCount,
  p.FavoriteCount,
  p.ClosedDate,
  p.CommunityOwnedDate,
  p.UserId,
  p.Reputation,
  p.UserCreationDate,
  p.LastAccessDate,
  p.Views,
  p.UpVotes,
  p.DownVotes,
  p.BadgeId,
  p.BadgeName,
  p.BadgeDate,
  p.BadgeClass,
  p.BadgeTagBased,
  p.CommentId,
  p.CommentScore,
  p.CommentCreationDate,
  p.VoteId,
  p.VoteTypeId,
  p.VoteCreationDate,
  p.BountyAmount,
  p.PostLinkId,
  p.LinkTypeId,
  p.PostLinkCreationDate,
  p.PostTypeName,
  p.CloseReasonName,
  p.LinkTypeName,
  p.VoteTypeName,
  pt.Name,
  ct.Name,
  lt.Name,
  vt.Name