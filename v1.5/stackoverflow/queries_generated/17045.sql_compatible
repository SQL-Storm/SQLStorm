WITH UserMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, 'Unknown') AS Location,
        DATE_PART('year', AGE(DATE '2024-10-01', u.CreationDate)) AS YearsActive,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        AVG(CASE WHEN p.Score IS NOT NULL THEN p.Score ELSE 0 END) AS AvgPostScore,
        STRING_AGG(DISTINCT SUBSTR(p.Tags, 2, POSITION('>' IN p.Tags) - 2), ', ') 
            FILTER (WHERE p.Tags IS NOT NULL AND LENGTH(p.Tags) > 2) AS TopTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate < DATE '2024-10-01' - INTERVAL '6 months'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location, u.CreationDate
),
BadgeAnalysis AS (
    SELECT 
        UserId,
        SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        MAX(CASE WHEN TagBased = B'1' THEN Name END) AS TopTagBadge,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY DATE_PART('day', Date - LAG(Date) OVER (PARTITION BY UserId ORDER BY Date))) AS MedianBadgeInterval
    FROM Badges
    GROUP BY UserId
),
PostEngagement AS (
    SELECT 
        p.Id AS PostId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        COALESCE(p.AnswerCount, 0) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpvoteCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownvoteCount,
        COUNT(DISTINCT pl.Id) FILTER (WHERE pl.LinkTypeId = 1) AS LinkedCount,
        FIRST_VALUE(c.Text) OVER (
            PARTITION BY p.Id 
            ORDER BY c.Score DESC NULLS LAST, c.CreationDate
        ) AS TopComment,
        DENSE_RANK() OVER (
            PARTITION BY p.OwnerUserId 
            ORDER BY p.Score DESC NULLS LAST
        ) AS UserPostRank,
        CASE 
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community'
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Answered'
            ELSE 'Open'
        END AS PostStatus
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    LEFT JOIN PostLinks pl ON p.Id = pl.PostId
    WHERE p.CreationDate > DATE '2024-10-01' - INTERVAL '2 years'
        AND p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount, 
             p.ClosedDate, p.CommunityOwnedDate, p.AcceptedAnswerId, c.Text, c.Score, c.CreationDate
),
EditPatterns AS (
    SELECT 
        ph.UserId,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4, 5, 6)) AS EditCount,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (7, 8, 9)) AS RollbackCount,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 10) AS CloseVoteCount,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 11) AS ReopenVoteCount,
        ARRAY_AGG(DISTINCT 
            CASE 
                WHEN ph.Comment ~ '^[0-9]+$' AND ph.PostHistoryTypeId = 10 
                THEN COALESCE(crt.Name, 'Unknown Reason')
                ELSE NULL 
            END
        ) FILTER (WHERE ph.Comment IS NOT NULL) AS CloseReasons
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON crt.Id = CAST(ph.Comment AS BIGINT)
    WHERE ph.CreationDate > DATE '2024-10-01' - INTERVAL '1 year'
    GROUP BY ph.UserId
)
SELECT 
    um.DisplayName,
    um.Location,
    um.Reputation,
    um.YearsActive,
    um.TotalPosts,
    ROUND(um.AvgPostScore, 2) AS AvgPostScore,
    COALESCE(ba.GoldBadges, 0) + COALESCE(ba.SilverBadges, 0) * 0.5 + COALESCE(ba.BronzeBadges, 0) * 0.25 AS WeightedBadgeScore,
    SUBSTR(COALESCE(um.TopTags, 'No Tags'), 1, 100) AS TopTags,
    COALESCE(ba.TopTagBadge, 'None') AS TopTagBadge,
    (
        SELECT COUNT(DISTINCT pe2.PostId)
        FROM PostEngagement pe2
        WHERE pe2.OwnerUserId = um.Id
            AND pe2.UserPostRank <= 5
            AND pe2.Score > (
                SELECT AVG(pe3.Score) * 1.5
                FROM PostEngagement pe3
                WHERE pe3.OwnerUserId = pe2.OwnerUserId
            )
    ) AS ExceptionalPostCount,
    COALESCE(ep.EditCount, 0) AS TotalEdits,
    COALESCE(ep.RollbackCount, 0) AS TotalRollbacks,
    CASE 
        WHEN um.Reputation > 10000 AND COALESCE(ba.GoldBadges, 0) > 5 THEN 'Elite'
        WHEN um.Reputation > 5000 OR COALESCE(ba.GoldBadges, 0) > 2 THEN 'Expert'
        WHEN um.Reputation > 1000 OR um.TotalPosts > 50 THEN 'Active'
        WHEN um.TotalPosts > 10 THEN 'Contributor'
        ELSE 'Beginner'
    END AS UserTier,
    EXISTS (
        SELECT 1
        FROM Posts p
        WHERE p.OwnerUserId = um.Id
            AND p.Score >= 100
            AND p.ViewCount >= 10000
    ) AS HasViralContent,
    COALESCE(
        ARRAY_TO_STRING(
            ARRAY(
                SELECT DISTINCT crt2.Name
                FROM UNNEST(ep.CloseReasons) AS cr(Name)
                JOIN CloseReasonTypes crt2 ON crt2.Name = cr.Name
                LIMIT 3
            ), 
            ', '
        ),
        'No close votes'
    ) AS TopCloseReasons
FROM UserMetrics um
LEFT JOIN BadgeAnalysis ba ON um.Id = ba.UserId
LEFT JOIN EditPatterns ep ON um.Id = ep.UserId
WHERE um.Reputation > 100
    AND um.TotalPosts > 0
    AND (
        um.QuestionCount > 5 
        OR um.AnswerCount > 10
        OR COALESCE(ba.GoldBadges, 0) > 0
    )
ORDER BY 
    um.Reputation * POWER(1.1, COALESCE(ba.GoldBadges, 0)) * 
    GREATEST(LN(um.TotalPosts + 1), 1) * 
    CASE WHEN um.AvgPostScore > 0 THEN SQRT(um.AvgPostScore) ELSE 0.5 END DESC
LIMIT 100;