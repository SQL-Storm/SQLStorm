SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.Location,
    AVG(p.Score) AS AvgPostScore,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS TotalUpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS TotalDownVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 8 THEN v.Id END) AS BountiesStarted,
    SUM(v.BountyAmount) AS TotalBountyAwarded,
    COUNT(DISTINCT b.Id) AS BadgesCount,
    COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id END) AS SilverBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id END) AS BronzeBadges,
    MAX(p.CreationDate) AS LastPostDate,
    MAX(pc.CreationDate) AS LastCommentDate
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
LEFT JOIN Votes v ON p.Id = v.PostId
LEFT JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
LEFT JOIN Badges b ON u.Id = b.UserId
LEFT JOIN Comments pc ON pc.UserId = u.Id
WHERE u.LastAccessDate > date '2021-01-01'
GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
HAVING COUNT(DISTINCT p.Id) > 5
ORDER BY AvgPostScore DESC, TotalBountyAwarded DESC, BadgesCount DESC;