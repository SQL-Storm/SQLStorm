WITH active_users AS (
  SELECT 
    u.Id AS user_id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS user_creation_date,
    ROW_NUMBER() OVER (PARTITION BY EXTRACT(YEAR FROM u.CreationDate) ORDER BY u.Reputation DESC) AS reputation_rank_year
  FROM Users u
  WHERE u.Reputation > 1000 
    AND u.LastAccessDate > (CAST('2024-10-01' AS DATE) - INTERVAL '1 year')
),
top_posts_per_user AS (
  SELECT 
    p.Id AS post_id,
    p.OwnerUserId AS owner_user_id,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate AS post_creation_date,
    p.Tags,
    LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS prev_post_score,
    FIRST_VALUE(p.ViewCount) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_views
  FROM Posts p
  INNER JOIN active_users au ON p.OwnerUserId = au.user_id
  WHERE p.PostTypeId = 1  -- Questions only
    AND p.Score > 0
    AND p.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '2 years')
),
post_engagement AS (
  SELECT 
    tppu.post_id,
    tppu.owner_user_id,
    tppu.cumulative_views,
    COALESCE(v.upvote_count, 0) + COALESCE(v.favorite_count, 0) AS total_positive_votes,
    COALESCE(c.comment_count, 0) AS comment_count,
    CASE 
      WHEN tppu.ViewCount > 10000 THEN 'High Traffic'
      WHEN tppu.ViewCount > 1000 THEN 'Medium Traffic'
      ELSE 'Low Traffic'
    END AS traffic_category,
    LENGTH(COALESCE(tppu.Tags, '')) - LENGTH(REGEXP_REPLACE(COALESCE(tppu.Tags, ''), '<[^>]*>', '')) AS tag_complexity_score,
    -- Complex string manipulation for tag analysis
    CONCAT(
      UPPER(SUBSTRING(tppu.Title FROM 1 FOR 1)),
      LOWER(REGEXP_REPLACE(tppu.Title, '[^a-zA-Z0-9\\s]', '', 'g'))
    ) AS normalized_title
  FROM top_posts_per_user tppu
  LEFT JOIN (
    SELECT 
      PostId,
      SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS upvote_count,
      SUM(CASE WHEN VoteTypeId = 5 THEN 1 ELSE 0 END) AS favorite_count
    FROM Votes
    WHERE VoteTypeId IN (2, 5)  -- Upvotes and Favorites
      AND CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '6 months')
    GROUP BY PostId
  ) v ON tppu.post_id = v.PostId
  LEFT JOIN (
    SELECT 
      PostId,
      COUNT(*) AS comment_count
    FROM Comments
    WHERE Score >= 0  -- Non-negative comments only
    GROUP BY PostId
  ) c ON tppu.post_id = c.PostId
),
user_achievement_metrics AS (
  SELECT 
    au.user_id,
    COUNT(DISTINCT b.Id) AS total_badges,
    SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold_badges,
    AVG(CASE WHEN b.Date > (CAST('2024-10-01' AS DATE) - INTERVAL '1 year') THEN b.Date END) AS recent_badge_avg_date,
    STRING_AGG(DISTINCT b.Name, '; ' ORDER BY b.Date DESC) AS recent_badges_list
  FROM active_users au
  LEFT JOIN Badges b ON au.user_id = b.UserId 
    AND b.Date > (CAST('2024-10-01' AS DATE) - INTERVAL '1 year')
  GROUP BY au.user_id
  HAVING COUNT(DISTINCT b.Id) > 0 OR au.reputation_rank_year <= 50
),
linked_content_analysis AS (
  SELECT 
    pl.PostId AS linking_post_id,
    pl.RelatedPostId AS linked_post_id,
    p1.Title AS linking_title,
    p2.Score AS linked_score,
    p2.ViewCount AS linked_views,
    CASE 
      WHEN pl.LinkTypeId = 3 THEN 'Duplicate'
      WHEN pl.LinkTypeId = 1 THEN 'Reference'
      ELSE 'Unknown'
    END AS link_category,
    ROW_NUMBER() OVER (PARTITION BY pl.PostId ORDER BY pl.CreationDate DESC) AS link_recency_rank
  FROM PostLinks pl
  INNER JOIN Posts p1 ON pl.PostId = p1.Id
  LEFT JOIN Posts p2 ON pl.RelatedPostId = p2.Id
  WHERE pl.LinkTypeId IN (1, 3)
    AND p1.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '1 year')
    AND p2.Score IS NOT NULL
)
SELECT 
  au.DisplayName AS user_name,
  au.Reputation AS user_reputation,
  au.reputation_rank_year,
  pe.post_id,
  pe.normalized_title,
  pe.total_positive_votes,
  pe.traffic_category,
  pe.tag_complexity_score,
  uam.total_badges,
  uam.gold_badges,
  lca.linking_title,
  lca.linked_score,
  -- Complex calculations with NULL handling
  CASE 
    WHEN pe.total_positive_votes > 0 
    THEN ROUND(
      (pe.total_positive_votes * 1.0 / NULLIF(pe.comment_count, 0)) * 
      LOG(GREATEST(pe.ViewCount, 1)) / 
      NULLIF(pe.tag_complexity_score, 0), 2
    )
    ELSE 0 
  END AS engagement_efficiency_score,
  -- Window function for cross-post comparison
  RANK() OVER (
    PARTITION BY au.reputation_rank_year 
    ORDER BY COALESCE(pe.total_positive_votes, 0) DESC, 
             COALESCE(lca.linked_score, 0) DESC
  ) AS engagement_rank,
  -- Correlated subquery for average performance
  (SELECT AVG(p.Score) 
   FROM Posts p 
   WHERE p.OwnerUserId = au.user_id 
     AND p.CreationDate BETWEEN au.user_creation_date AND CAST('2024-10-01' AS DATE)
     AND p.Score IS NOT NULL
  ) AS avg_historical_score,
  -- Set operation simulation via conditional aggregation
  SUM(CASE WHEN lca.link_category = 'Duplicate' THEN 1 ELSE 0 END) OVER (
    PARTITION BY au.user_id 
    ORDER BY pe.post_creation_date 
    ROWS BETWEEN 3 PRECEDING AND CURRENT ROW
  ) AS recent_duplicate_links
FROM post_engagement pe
INNER JOIN active_users au ON pe.owner_user_id = au.user_id
LEFT JOIN user_achievement_metrics uam ON au.user_id = uam.user_id
LEFT JOIN linked_content_analysis lca ON pe.post_id = lca.linking_post_id 
  AND lca.link_recency_rank = 1
WHERE au.reputation_rank_year <= 100
  AND (pe.traffic_category = 'High Traffic' 
       OR (pe.total_positive_votes > 50 AND pe.comment_count > 10))
  AND (uam.gold_badges > 0 OR au.Reputation > 5000)
ORDER BY 
  engagement_efficiency_score DESC NULLS LAST,
  au.reputation_rank_year,
  pe.post_creation_date DESC
LIMIT 500;