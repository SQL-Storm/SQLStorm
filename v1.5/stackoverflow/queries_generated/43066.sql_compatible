WITH UserReputation AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM 
        Users u
    LEFT JOIN 
        Badges b ON u.Id = b.UserId
    GROUP BY 
        u.Id, u.DisplayName, u.Reputation
),
PostActivity AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        COUNT(DISTINCT ph.Id) AS EditCount
    FROM 
        Posts p
    LEFT JOIN 
        PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (4, 5, 6, 8)
    WHERE 
        p.PostTypeId = 1
    GROUP BY 
        p.Id, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount
),
TopUsers AS (
    SELECT 
        ur.Id,
        ur.DisplayName,
        ur.Reputation,
        ur.TotalBadges,
        SUM(pa.Score * 0.4 + pa.ViewCount * 0.3 + pa.AnswerCount * 1.0 + pa.CommentCount * 0.2 + pa.FavoriteCount * 0.1) AS ActivityScore,
        SUM(pa.EditCount) AS TotalEdits
    FROM 
        UserReputation ur
    JOIN 
        PostActivity pa ON ur.Id = pa.OwnerUserId
    GROUP BY 
        ur.Id, ur.DisplayName, ur.Reputation, ur.TotalBadges
    ORDER BY 
        ActivityScore DESC, Reputation DESC
    LIMIT 10
)
SELECT 
    tu.DisplayName,
    tu.Reputation,
    tu.TotalBadges,
    tu.GoldBadges,
    tu.SilverBadges,
    tu.BronzeBadges,
    tu.ActivityScore,
    tu.TotalEdits,
    COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS TotalUpvotes,
    COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS TotalDownvotes
FROM 
    TopUsers tu
LEFT JOIN 
    Votes v ON tu.Id = v.UserId
GROUP BY 
    tu.Id,
    tu.DisplayName,
    tu.Reputation,
    tu.TotalBadges,
    tu.GoldBadges,
    tu.SilverBadges,
    tu.BronzeBadges,
    tu.ActivityScore,
    tu.TotalEdits
ORDER BY 
    tu.ActivityScore DESC;