-- {"query": "18088.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1345} 
WITH
  RankedPostEdits AS (
    SELECT
      ph.PostId,
      ph.UserId,
      ph.CreationDate AS EditDate,
      ph.PostHistoryTypeId,
      pht.Name AS HistoryTypeName,
      ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM
      PostHistory AS ph
    JOIN
      PostHistoryTypes AS pht
      ON ph.PostHistoryTypeId = pht.Id
    WHERE
      ph.PostHistoryTypeId IN (4, 5, 6) -- Edit Title, Edit Body, Edit Tags
  ),
  UserPostActivity AS (
    SELECT
      p.OwnerUserId,
      COUNT(DISTINCT p.Id) AS QuestionCount,
      SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
      SUM(p.ViewCount) AS TotalViews,
      MAX(p.CreationDate) AS LatestPostDate
    FROM
      Posts AS p
    WHERE
      p.OwnerUserId IS NOT NULL
      AND p.OwnerUserId <> -1
      AND p.PostTypeId IN (1, 2) -- Questions and Answers
    GROUP BY
      p.OwnerUserId
  ),
  HighReputationUsers AS (
    SELECT
      u.Id,
      u.DisplayName,
      u.Reputation,
      u.CreationDate,
      u.UpVotes,
      u.DownVotes,
      u.Views AS ProfileViews,
      CASE
        WHEN u.WebsiteUrl IS NOT NULL AND u.WebsiteUrl <> '' THEN 'Has Website'
        WHEN u.Location IS NOT NULL AND u.Location <> '' THEN 'Has Location'
        ELSE 'No External Info'
      END AS UserInfoStatus
    FROM
      Users AS u
    WHERE
      u.Reputation > 10000
  )
SELECT
  hru.DisplayName,
  hru.Reputation,
  hru.UserInfoStatus,
  upa.QuestionCount,
  upa.AnswerCount,
  upa.TotalViews,
  rpe.EditDate AS LatestEditDate,
  rpe.HistoryTypeName AS LatestEditType,
  COALESCE(
    (
      SELECT
        COUNT(*)
      FROM
        Badges AS b
      WHERE
        b.UserId = hru.Id AND b.Class = 1 -- Gold Badges
    ),
    0
  ) AS GoldBadgeCount,
  COALESCE(
    (
      SELECT
        SUM(v.VoteTypeId = 2) -- Upvotes
      FROM
        Votes AS v
      WHERE
        v.UserId = hru.Id
    ),
    0
  ) AS TotalUpvotesCast,
  p.Title AS SamplePostTitle,
  p.CreationDate AS SamplePostDate,
  p.Score AS SamplePostScore,
  CASE
    WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
    WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
    ELSE 'Active'
  END AS PostStatus,
  '--' || LOWER(SUBSTRING(p.Tags FROM 2 FOR POSITION('>' IN p.Tags)-2)) || '--' AS TagSubstringExample
FROM
  HighReputationUsers AS hru
LEFT OUTER JOIN
  UserPostActivity AS upa
  ON hru.Id = upa.OwnerUserId
LEFT OUTER JOIN
  RankedPostEdits AS rpe
  ON hru.Id = rpe.UserId AND rpe.rn = 1
LEFT OUTER JOIN
  Posts AS p
  ON hru.Id = p.OwnerUserId AND p.PostTypeId = 1 -- Sample Question
WHERE
  upa.LatestPostDate BETWEEN hru.CreationDate AND cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
  OR upa.AnswerCount > 50
UNION ALL
SELECT
  hru.DisplayName,
  hru.Reputation,
  hru.UserInfoStatus,
  upa.QuestionCount,
  upa.AnswerCount,
  upa.TotalViews,
  rpe.EditDate AS LatestEditDate,
  rpe.HistoryTypeName AS LatestEditType,
  COALESCE(
    (
      SELECT
        COUNT(*)
      FROM
        Badges AS b
      WHERE
        b.UserId = hru.Id AND b.Class = 2 -- Silver Badges
    ),
    0
  ) AS SilverBadgeCount,
  COALESCE(
    (
      SELECT
        SUM(v.VoteTypeId = 3) -- Downvotes
      FROM
        Votes AS v
      WHERE
        v.UserId = hru.Id
    ),
    0
  ) AS TotalDownvotesCast,
  p.Title AS SamplePostTitle,
  p.CreationDate AS SamplePostDate,
  p.Score AS SamplePostScore,
  CASE
    WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
    WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
    ELSE 'Active'
  END AS PostStatus,
  '--' || UPPER(SUBSTRING(p.Tags FROM 2 FOR POSITION('>' IN p.Tags)-2)) || '--' AS TagSubstringExample
FROM
  HighReputationUsers AS hru
JOIN
  UserPostActivity AS upa
  ON hru.Id = upa.OwnerUserId
JOIN
  RankedPostEdits AS rpe
  ON hru.Id = rpe.UserId AND rpe.rn = 1
JOIN
  Posts AS p
  ON hru.Id = p.OwnerUserId AND p.PostTypeId = 2 -- Sample Answer
WHERE
  upa.TotalViews > 1000000
  OR (upa.QuestionCount > 0 AND upa.AnswerCount = 0)
ORDER BY
  Reputation DESC
LIMIT 100;