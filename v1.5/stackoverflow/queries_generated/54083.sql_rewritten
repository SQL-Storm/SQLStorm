-- {"query": "54083.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-oss-20b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2048, "output_tokens": 2253} 
WITH
-- Count votes per post and split them by type
post_votes AS (
    SELECT
        pos.Id                AS post_id,
        COUNT(*)              AS vote_cnt,
        SUM(CASE WHEN vt.Id = 2 THEN 1 END) AS upvotes,
        SUM(CASE WHEN vt.Id = 3 THEN 1 END) AS downvotes,
        SUM(CASE WHEN vt.Id = 5 THEN 1 END) AS favorites
    FROM Posts pos
    JOIN Votes v       ON v.PostId = pos.Id
    JOIN VoteTypes vt  ON vt.Id = v.VoteTypeId
    GROUP BY pos.Id
),
-- Aggregates of users: score, votes, badges
user_stats AS (
    SELECT
        u.Id                                   AS user_id,
        u.DisplayName                          AS user_name,
        COUNT(p.Id)                            AS post_cnt,
        SUM(p.Score)                           AS total_score,
        AVG(p.Score)                           AS avg_score,
        SUM(v.upvotes)                         AS total_up,
        SUM(v.downvotes)                       AS total_down,
        SUM(v.favorites)                       AS total_fav,
        COUNT(DISTINCT b.Id)                   AS badge_cnt,
        STRING_AGG(DISTINCT b.Name, '; ')      AS badge_names
    FROM Users u
    LEFT JOIN Posts p                ON p.OwnerUserId = u.Id
    LEFT JOIN post_votes v           ON v.post_id   = p.Id
    LEFT JOIN Badges b               ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
-- Add tags by exploding the Tags column (Postgres syntax)
question_tags AS (
    SELECT
        p.Id          AS question_id,
        tag_array.elem AS tag
    FROM Posts p
    CROSS JOIN LATERAL STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><') AS tag_array(elem)
    WHERE p.PostTypeId = 1
),
-- Pivot tags into a boolean column per tag of interest
tag_flags AS (
    SELECT
        qt.question_id,
        SUM(CASE WHEN qt.tag = 'sql'          THEN 1 ELSE 0 END) AS sql_tag,
        SUM(CASE WHEN qt.tag = 'performance' THEN 1 ELSE 0 END) AS perf_tag,
        SUM(CASE WHEN qt.tag = 'benchmark'   THEN 1 ELSE 0 END) AS bench_tag
    FROM question_tags qt
    GROUP BY qt.question_id
),
-- Final aggregation: per user per tag type
final_stats AS (
    SELECT
        us.user_id,
        us.user_name,
        us.post_cnt,
        us.total_score,
        us.avg_score,
        us.total_up,
        us.total_down,
        us.total_fav,
        us.badge_cnt,
        us.badge_names,
        SUM(tf.sql_tag)  AS sql_tq,
        SUM(tf.perf_tag) AS perf_tq,
        SUM(tf.bench_tag) AS bench_tq
    FROM user_stats us
    LEFT JOIN tag_flags tf ON tf.question_id = us.post_id
    GROUP BY
        us.user_id,
        us.user_name,
        us.post_cnt,
        us.total_score,
        us.avg_score,
        us.total_up,
        us.total_down,
        us.total_fav,
        us.badge_cnt,
        us.badge_names
)
-- Rank users by total score and pick the top 20
SELECT *
FROM (
    SELECT *,
           RANK() OVER (ORDER BY total_score DESC) AS score_rank,
           NTILE(5) OVER (ORDER BY avg_score)    AS score_decile
    FROM final_stats
) sub
WHERE score_rank <= 20
ORDER BY total_score DESC, avg_score DESC;