-- {"query": "25055.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2281} 
WITH
/* 1️⃣ Top users by reputation, badge count and net post score */
TopUsers AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COALESCE(SUM(
            CASE v.VoteTypeId
                WHEN 2 THEN  1   -- upvote
                WHEN 3 THEN -1   -- downvote
                ELSE 0
            END),0)                         AS NetScore,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, GoldBadges DESC) AS rn
    FROM Users u
    LEFT JOIN Badges b          ON b.UserId = u.Id
    LEFT JOIN Posts p           ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v           ON v.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) >= 5        -- at least 5 questions
),

/* 2️⃣ Tag popularity with excerpt length and visibility */
TagPopularity AS (
    SELECT
        t.TagName,
        t.Count                        AS TagUseCount,
        COALESCE(e.ExcerptLength,0)    AS ExcerptLen,
        CASE WHEN t.IsModeratorOnly = 1 THEN 'Mod' ELSE 'Public' END AS Visibility,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rn_tag
    FROM Tags t
    LEFT JOIN (
        SELECT p.Id, LENGTH(p.Body) AS ExcerptLength
        FROM Posts p
        WHERE p.PostTypeId = 4               -- tag wiki excerpt
    ) e ON e.Id = t.ExcerptPostId
),

/* 3️⃣ Per‑user tag activity on questions */
UserTagActivity AS (
    SELECT
        u.Id                                        AS UserId,
        COUNT(DISTINCT UNNEST(string_to_array(p.Tags,'><'))) AS DistinctTagsUsed,
        MAX(p.CreationDate)                         AS LastQuestionDate,
        COALESCE(SUM(p.Score),0)                     AS TotalQuestionScore
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id
               AND p.PostTypeId = 1               -- questions only
    GROUP BY u.Id
),

/* 4️⃣ Combine the pieces and check for recent accepted answers */
Combined AS (
    SELECT
        tu.Id,
        tu.DisplayName,
        tu.Reputation,
        tu.GoldBadges,
        tu.SilverBadges,
        tu.BronzeBadges,
        tu.NetScore,
        uta.DistinctTagsUsed,
        uta.TotalQuestionScore,
        COALESCE(uta.LastQuestionDate, TIMESTAMP '1970‑01‑01') AS LastQDate,
        CASE WHEN recent_cnt.cnt > 0 THEN TRUE ELSE FALSE END AS HasRecentAcceptedAnswer
    FROM TopUsers tu
    LEFT JOIN UserTagActivity uta ON uta.UserId = tu.Id
    LEFT JOIN LATERAL (
        SELECT COUNT(*) AS cnt
        FROM Posts a
        WHERE a.PostTypeId = 2                                   -- answers
          AND a.ParentId IN (
                SELECT q.Id
                FROM Posts q
                WHERE q.OwnerUserId = tu.Id
                  AND q.PostTypeId = 1
          )
          AND a.AcceptedAnswerId IS NOT NULL
          AND a.CreationDate > (cast('2024-10-01' as date) - INTERVAL '30 days')
    ) recent_cnt ON TRUE
    WHERE tu.rn <= 50
)

SELECT
    c.Id,
    c.DisplayName,
    c.Reputation,
    c.GoldBadges,
    c.SilverBadges,
    c.BronzeBadges,
    c.NetScore,
    c.DistinctTagsUsed,
    c.TotalQuestionScore,
    c.HasRecentAcceptedAnswer,
    tp.TagName,
    tp.TagUseCount,
    tp.ExcerptLen,
    tp.Visibility
FROM Combined c
LEFT JOIN LATERAL (
    SELECT tp2.TagName, tp2.TagUseCount, tp2.ExcerptLen, tp2.Visibility
    FROM TagPopularity tp2
    WHERE tp2.rn_tag <= 5
    ORDER BY tp2.TagUseCount DESC
    LIMIT 1
) tp ON TRUE

UNION ALL

/* 5️⃣ Fallback rows for users created in the last year who are not in TopUsers */
SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    0 AS GoldBadges,
    0 AS SilverBadges,
    0 AS BronzeBadges,
    0 AS NetScore,
    0 AS DistinctTagsUsed,
    0 AS TotalQuestionScore,
    FALSE AS HasRecentAcceptedAnswer,
    NULL AS TagName,
    NULL AS TagUseCount,
    NULL AS ExcerptLen,
    NULL AS Visibility
FROM Users u
WHERE NOT EXISTS (SELECT 1 FROM TopUsers tu WHERE tu.Id = u.Id)
  AND u.CreationDate > (cast('2024-10-01' as date) - INTERVAL '1 year')

ORDER BY Reputation DESC, GoldBadges DESC
LIMIT 100;