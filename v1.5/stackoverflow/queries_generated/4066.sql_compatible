with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(distinct c.Id) as CommentCount,
        count(distinct b.Id) as BadgeCount
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
UserLatestPostActivity as (
    select
        ua.UserId,
        max(p.LastActivityDate) as MaxPostActivityDate
    from RecursiveUserActivity ua
    left join Posts p on p.OwnerUserId = ua.UserId
    group by ua.UserId
),
QuestionsWithAcceptedAnswers as (
    select
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.CreationDate as QuestionCreationDate,
        a.Id as AcceptedAnswerId,
        a.Score as AcceptedAnswerScore,
        a.CreationDate as AcceptedAnswerCreationDate,
        u.DisplayName as QuestionOwnerName,
        ua.BadgeCount,
        row_number() over (partition by q.Id order by a.Score desc) as rn
    from Posts q
    join Posts a on a.Id = q.AcceptedAnswerId
    join Users u on q.OwnerUserId = u.Id
    join RecursiveUserActivity ua on ua.UserId = u.Id
    where q.PostTypeId = 1 and q.AcceptedAnswerId is not null 
),
HighScoreAnswers as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.Score,
        a.CreationDate,
        u.DisplayName as AnswerOwnerName,
        count(distinct v.Id) as UpVotes,
        coalesce(sum(case when v.VoteTypeId = 3 then 1 else 0 end),0) as DownVotes
    from Posts a
    left join Votes v on v.PostId = a.Id and v.VoteTypeId in (2,3)
    join Users u on a.OwnerUserId = u.Id
    where a.PostTypeId = 2
    group by a.Id, a.ParentId, a.Score, a.CreationDate, u.DisplayName
    having a.Score > 10
),
QuestionsCommentsWithSentiment as (
    select
        c.PostId,
        c.Id as CommentId,
        c.CreationDate,
        c.Text,
        length(c.Text) - length(replace(lower(c.Text), 'good', '')) as GoodCount,
        length(c.Text) - length(replace(lower(c.Text), 'bad', '')) as BadCount,
        case 
            when (length(c.Text) - length(replace(lower(c.Text), 'good', ''))) > (length(c.Text) - length(replace(lower(c.Text), 'bad', ''))) then 'Positive'
            when (length(c.Text) - length(replace(lower(c.Text), 'good', ''))) < (length(c.Text) - length(replace(lower(c.Text), 'bad', ''))) then 'Negative'
            else 'Neutral'
        end as Sentiment
    from Comments c
    join Posts p on c.PostId = p.Id and p.PostTypeId = 1
),
CombinedData as (
    select
        q.QuestionId,
        q.Title,
        q.Tags,
        q.QuestionCreationDate,
        q.AcceptedAnswerId,
        q.AcceptedAnswerScore,
        q.AcceptedAnswerCreationDate,
        q.QuestionOwnerName,
        q.BadgeCount,
        ha.AnswerId,
        ha.Score as AnswerScore,
        ha.CreationDate as AnswerCreationDate,
        ha.AnswerOwnerName,
        ha.UpVotes,
        ha.DownVotes,
        qc.CommentId,
        qc.CreationDate as CommentCreationDate,
        qc.Text as CommentText,
        qc.Sentiment,
        ua.Reputation,
        ua.QuestionCount,
        ua.AnswerCount,
        ua.CommentCount
    from QuestionsWithAcceptedAnswers q
    left join HighScoreAnswers ha on ha.QuestionId = q.QuestionId
    left join QuestionsCommentsWithSentiment qc on qc.PostId = q.QuestionId
    left join RecursiveUserActivity ua on ua.UserId = (
        select OwnerUserId from Posts where Id = q.QuestionId
    )
    where ha.AnswerId is not null or qc.CommentId is not null
),
RankedCombinedData as (
    select *,
        row_number() over (partition by QuestionId order by coalesce(AnswerScore, 0) desc nulls last, CommentCreationDate desc nulls last) as rn
    from CombinedData
),
FilteredData as (
    select *
    from RankedCombinedData
    where rn = 1
)
select
    fd.QuestionId,
    fd.Title,
    regexp_replace(fd.Tags, '[<>]', '', 'g') as CleanTags,
    fd.QuestionCreationDate,
    extract(epoch from (fd.AcceptedAnswerCreationDate - fd.QuestionCreationDate))/3600 as HoursToAcceptedAnswer,
    fd.AcceptedAnswerScore,
    fd.AnswerId,
    fd.AnswerScore,
    fd.AnswerCreationDate,
    fd.AnswerOwnerName,
    fd.UpVotes,
    fd.DownVotes,
    fd.CommentId,
    substring(fd.CommentText for 100) as CommentSnippet,
    fd.Sentiment,
    fd.QuestionOwnerName,
    fd.Reputation,
    fd.QuestionCount,
    fd.AnswerCount,
    fd.CommentCount,
    fd.BadgeCount,
    case 
        when fd.Reputation > 10000 then 'Expert'
        when fd.Reputation between 1000 and 10000 then 'Intermediate'
        else 'Newbie'
    end as UserExperienceLevel
from FilteredData fd
where 
    (fd.Reputation > 500 or fd.BadgeCount > 0)
    and (fd.AnswerScore > 15 or (fd.Sentiment = 'Positive' and fd.CommentId is not null))
    and fd.Tags is not null
union all
select
    q.Id as QuestionId,
    q.Title,
    null as CleanTags,
    q.CreationDate as QuestionCreationDate,
    null as HoursToAcceptedAnswer,
    null as AcceptedAnswerScore,
    null as AnswerId,
    null as AnswerScore,
    null as AnswerCreationDate,
    null as AnswerOwnerName,
    null as UpVotes,
    null as DownVotes,
    null as CommentId,
    null as CommentSnippet,
    null as Sentiment,
    u.DisplayName as QuestionOwnerName,
    u.Reputation,
    1 as QuestionCount,
    0 as AnswerCount,
    0 as CommentCount,
    0 as BadgeCount,
    case 
        when u.Reputation > 10000 then 'Expert'
        when u.Reputation between 1000 and 10000 then 'Intermediate'
        else 'Newbie'
    end as UserExperienceLevel
from Posts q
join Users u on u.Id = q.OwnerUserId
left join QuestionsWithAcceptedAnswers qa on qa.QuestionId = q.Id
where q.PostTypeId = 1 and qa.QuestionId is null
order by Reputation desc, HoursToAcceptedAnswer nulls last, AcceptedAnswerScore desc nulls last
limit 100;