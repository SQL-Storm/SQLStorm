WITH RankedAnswers AS (
    SELECT 
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.Score AS AnswerScore,
        a.CreationDate AS AnswerCreationDate,
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank
    FROM Posts a
    JOIN Users u ON a.OwnerUserId = u.Id
    WHERE a.PostTypeId = 2
),
TopAnswers AS (
    SELECT * FROM RankedAnswers WHERE AnswerRank <= 3
),
QuestionStats AS (
    SELECT 
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate AS QuestionCreationDate,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        q.CommentCount,
        q.FavoriteCount,
        q.Tags,
        qt.Name AS QuestionTypeName,
        u.DisplayName AS QuestionOwnerName,
        u.Reputation AS QuestionOwnerReputation
    FROM Posts q
    LEFT JOIN PostTypes qt ON q.PostTypeId = qt.Id
    LEFT JOIN Users u ON q.OwnerUserId = u.Id
    WHERE q.PostTypeId = 1
),
QuestionBadges AS (
    SELECT 
        b.UserId,
        b.Name AS BadgeName,
        b.Class,
        COUNT(*) OVER (PARTITION BY b.UserId) AS TotalBadges
    FROM Badges b
),
AnswerVotesSummary AS (
    SELECT 
        v.PostId AS AnswerId,
        SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes,
        SUM(CASE WHEN vt.Name = 'AcceptedByOriginator' THEN 1 ELSE 0 END) AS AcceptedCount
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    WHERE v.PostId IN (SELECT Id FROM Posts WHERE PostTypeId = 2)
    GROUP BY v.PostId
),
TagCounts AS (
    SELECT 
        TagName,
        COUNT(*) AS TagUsageCount
    FROM (
        SELECT unnest(string_to_array(substring(q.Tags, 2, char_length(q.Tags) - 2), '><')) AS TagName
        FROM Posts q
        WHERE q.PostTypeId = 1
    ) AS t
    GROUP BY TagName
    ORDER BY TagUsageCount DESC
    LIMIT 10
),
TopUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersPosted,
        COUNT(b.Id) AS BadgesEarned
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
    ORDER BY u.Reputation DESC
    LIMIT 50
)
SELECT 
    qs.QuestionId,
    qs.Title,
    qs.QuestionCreationDate,
    qs.QuestionScore,
    qs.ViewCount,
    qs.AnswerCount,
    qs.CommentCount,
    qs.FavoriteCount,
    qs.Tags,
    qs.QuestionTypeName,
    qs.QuestionOwnerName,
    qs.QuestionOwnerReputation,
    ta.AnswerId,
    ta.AnswerScore,
    ta.AnswerCreationDate,
    ta.UserId AS AnswerUserId,
    ta.Reputation AS AnswerUserReputation,
    ta.DisplayName AS AnswerUserName,
    avs.UpVotes,
    avs.DownVotes,
    avs.AcceptedCount,
    (SELECT STRING_AGG(tb.BadgeName || '(' || tb.Class || ')', ', ')
     FROM QuestionBadges tb 
     WHERE tb.UserId = qs.QuestionOwnerReputation LIMIT 5) AS QuestionOwnerBadges,
    tc.TagUsageCount AS PopularTagUsageCount,
    tu.DisplayName AS TopUserName,
    tu.Reputation AS TopUserReputation,
    tu.QuestionsPosted,
    tu.AnswersPosted,
    tu.BadgesEarned
FROM QuestionStats qs
LEFT JOIN TopAnswers ta ON ta.QuestionId = qs.QuestionId
LEFT JOIN AnswerVotesSummary avs ON avs.AnswerId = ta.AnswerId
LEFT JOIN TagCounts tc ON tc.TagName = ANY(string_to_array(substring(qs.Tags, 2, char_length(qs.Tags) - 2), '><'))
LEFT JOIN TopUsers tu ON tu.Id = qs.QuestionOwnerReputation
WHERE qs.QuestionScore > 10
ORDER BY qs.ViewCount DESC, qs.QuestionScore DESC, ta.AnswerScore DESC
LIMIT 100;