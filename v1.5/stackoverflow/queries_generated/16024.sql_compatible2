WITH UserEngagementMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetVotes,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id END) AS SilverBadges,
        EXTRACT(YEAR FROM AGE(CAST('2024-10-01 12:34:56' AS TIMESTAMP), u.CreationDate)) AS YearsActive
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.UpVotes, u.DownVotes
),
PostPerformance AS (
    SELECT 
        p.Id AS PostId,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        COALESCE(LENGTH(p.Body), 0) AS BodyLength,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 1
            ELSE 0
        END AS HasAcceptedAnswer,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS UpvoteCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS DownvoteCount,
        AVG(CASE WHEN a.PostTypeId = 2 THEN a.Score END) AS AvgAnswerScore,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.ViewCount DESC NULLS LAST) AS UserPostRank
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    LEFT JOIN Posts a ON p.Id = a.ParentId AND a.PostTypeId = 2
    WHERE p.PostTypeId IN (1, 2)
        AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '3 years'
    GROUP BY p.Id, p.OwnerUserId, p.PostTypeId, p.Score, p.ViewCount, p.AnswerCount, p.Body, p.AcceptedAnswerId
),
TagPopularity AS (
    SELECT 
        t.TagName,
        t.Count AS TagUsageCount,
        AVG(pp.Score) AS AvgScoreForTag,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY pp.ViewCount) AS MedianViews,
        COUNT(DISTINCT pp.OwnerUserId) AS UniqueContributors
    FROM Tags t
    INNER JOIN Posts p ON p.Tags LIKE CONCAT('%<', t.TagName, '>%')
    INNER JOIN PostPerformance pp ON p.Id = pp.PostId
    WHERE t.Count > 100
    GROUP BY t.TagName, t.Count
),
AnswerQuality AS (
    SELECT 
        ans.ParentId AS QuestionId,
        ans.Id AS AnswerId,
        ans.OwnerUserId,
        ans.Score AS AnswerScore,
        CASE 
            WHEN q.AcceptedAnswerId = ans.Id THEN 1
            ELSE 0
        END AS IsAccepted,
        EXTRACT(EPOCH FROM (ans.CreationDate - q.CreationDate))/3600.0 AS HoursToAnswer,
        LAG(ans.Score) OVER (PARTITION BY ans.ParentId ORDER BY ans.CreationDate) AS PreviousAnswerScore,
        (SELECT COUNT(*) 
         FROM PostHistory ph 
         WHERE ph.PostId = ans.Id 
           AND ph.PostHistoryTypeId IN (4, 5, 6)) AS EditCount
    FROM Posts ans
    INNER JOIN Posts q ON ans.ParentId = q.Id
    WHERE ans.PostTypeId = 2
        AND q.PostTypeId = 1
        AND ans.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
)
SELECT 
    uem.DisplayName,
    uem.Reputation,
    uem.ReputationRank,
    ROUND(uem.NetVotes::numeric / NULLIF(uem.YearsActive, 0), 2) AS AvgNetVotesPerYear,
    CONCAT(uem.GoldBadges, 'G/', uem.SilverBadges, 'S') AS BadgeSummary,
    COUNT(DISTINCT pp.PostId) AS TotalPosts,
    ROUND(AVG(pp.Score), 2) AS AvgPostScore,
    MAX(pp.ViewCount) AS MaxViews,
    SUM(pp.HasAcceptedAnswer) AS QuestionsWithAcceptedAnswers,
    COALESCE(ROUND(AVG(aq.HoursToAnswer) FILTER (WHERE aq.IsAccepted = 1), 2), 0) AS AvgHoursToAcceptedAnswer,
    STRING_AGG(DISTINCT SUBSTRING(tp.TagName, 1, 15) ORDER BY SUBSTRING(tp.TagName, 1, 15) , ', ') FILTER (WHERE tp.AvgScoreForTag > 5) AS TopTags,
    CASE 
        WHEN uem.Reputation > 10000 AND uem.GoldBadges >= 3 THEN 'Elite'
        WHEN uem.Reputation > 5000 OR uem.GoldBadges >= 1 THEN 'Advanced'
        WHEN uem.Reputation > 1000 THEN 'Intermediate'
        ELSE 'Beginner'
    END AS UserTier,
    (SELECT COUNT(*) 
     FROM PostLinks pl 
     INNER JOIN Posts p2 ON pl.PostId = p2.Id 
     WHERE p2.OwnerUserId = uem.Id 
       AND pl.LinkTypeId = 1) AS LinkedPostsCount,
    COALESCE(
        (SELECT SUM(v.BountyAmount) 
         FROM Votes v 
         INNER JOIN Posts p3 ON v.PostId = p3.Id 
         WHERE p3.OwnerUserId = uem.Id 
           AND v.VoteTypeId = 9), 0) AS TotalBountiesEarned
FROM UserEngagementMetrics uem
INNER JOIN PostPerformance pp ON uem.Id = pp.OwnerUserId
LEFT JOIN AnswerQuality aq ON pp.PostId = aq.AnswerId
LEFT JOIN Posts p ON pp.PostId = p.Id
LEFT JOIN LATERAL (
    SELECT UNNEST(string_to_array(SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), '><')) AS tag_split
) AS tags_split ON TRUE
LEFT JOIN TagPopularity tp ON tags_split.tag_split = tp.TagName
WHERE pp.UserPostRank <= 50
    AND (pp.UpvoteCount > pp.DownvoteCount OR pp.DownvoteCount IS NULL)
    AND uem.ReputationRank <= 5000
GROUP BY 
    uem.Id,
    uem.DisplayName, 
    uem.Reputation, 
    uem.ReputationRank, 
    uem.NetVotes, 
    uem.YearsActive, 
    uem.GoldBadges, 
    uem.SilverBadges
HAVING COUNT(DISTINCT pp.PostId) >= 5
    AND AVG(pp.Score) > 0
ORDER BY 
    CASE 
        WHEN AVG(pp.Score) > 10 THEN uem.Reputation * 2
        ELSE uem.Reputation
    END DESC,
    COUNT(DISTINCT pp.PostId) DESC
LIMIT 100;