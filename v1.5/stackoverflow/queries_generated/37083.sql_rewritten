-- {"query": "37083.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-5-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 1985, "output_tokens": 2179} 
WITH RecursiveTagPairs AS (
  -- explode Tags into individual tag rows for questions
  SELECT
    p.Id AS QuestionId,
    lower(trim(both '<>' FROM unnest(string_to_array(substring(p.Tags,2,length(p.Tags)-2), '><')))) AS Tag
  FROM Posts p
  WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
),
TagCooccurrence AS (
  -- compute co-occurrence counts and distinct question counts per tag pair
  SELECT
    t1.Tag AS TagA,
    t2.Tag AS TagB,
    COUNT(*)::bigint AS CoCount
  FROM RecursiveTagPairs t1
  JOIN RecursiveTagPairs t2
    ON t1.QuestionId = t2.QuestionId
   AND t1.Tag < t2.Tag
  GROUP BY t1.Tag, t2.Tag
),
TagStats AS (
  -- per-tag statistics: total questions, avg views/score/answercount, median score approximation via percentile_cont
  SELECT
    tag,
    COUNT(DISTINCT QuestionId) AS Questions,
    AVG(p.ViewCount)::numeric(12,3) AS AvgViews,
    AVG(p.Score)::numeric(10,3) AS AvgScore,
    AVG(p.AnswerCount)::numeric(10,3) AS AvgAnswers,
    -- median score using percentile_cont over window partition
    (SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY sub.Score)
     FROM Posts sub
     WHERE sub.PostTypeId = 1 AND sub.Tags IS NOT NULL AND lower(substring(sub.Tags,2,length(sub.Tags)-2)) LIKE concat('%', tag, '%')
    )::numeric(10,3) AS MedianScore
  FROM RecursiveTagPairs r
  JOIN Posts p ON p.Id = r.QuestionId
  GROUP BY tag
),
TopTagPairs AS (
  -- enrich pairs with tag stats and relative lift metric
  SELECT
    c.TagA,
    c.TagB,
    c.CoCount,
    tsa.Questions AS QuestionsA,
    tsb.Questions AS QuestionsB,
    tsa.AvgViews AS AvgViewsA,
    tsb.AvgViews AS AvgViewsB,
    tsa.AvgScore AS AvgScoreA,
    tsb.AvgScore AS AvgScoreB,
    -- expected co-occurrence under independence = p(A)*p(B)*N, use lift = observed / expected
    (CASE WHEN ( (tsa.Questions::numeric/NULLIF((SELECT COUNT(*) FROM Posts WHERE PostTypeId=1),0)) * (tsb.Questions::numeric/NULLIF((SELECT COUNT(*) FROM Posts WHERE PostTypeId=1),0)) ) = 0
          THEN NULL
          ELSE (c.CoCount::numeric / ( (tsa.Questions::numeric/(SELECT COUNT(*) FROM Posts WHERE PostTypeId=1)) * (tsb.Questions::numeric/(SELECT COUNT(*) FROM Posts WHERE PostTypeId=1)) * (SELECT COUNT(*) FROM Posts WHERE PostTypeId=1) ) )
     END) AS Lift,
    -- Jaccard similarity on questions containing tags
    (c.CoCount::numeric / (tsa.Questions + tsb.Questions - c.CoCount))::numeric(10,6) AS Jaccard
  FROM TagCooccurrence c
  JOIN TagStats tsa ON tsa.tag = c.Taga
  JOIN TagStats tsb ON tsb.tag = c.Tagb
),
HotQuestions AS (
  -- compute hotness score per question combining recent activity, score, views, answers, favorites, and top tag lift
  SELECT
    q.Id,
    q.Title,
    q.CreationDate,
    q.Score,
    q.ViewCount,
    q.AnswerCount,
    q.FavoriteCount,
    q.LastActivityDate,
    -- aggregate tag-based signal: max lift of any pair between the question's tags and any other tag it co-occurs with
    (
      SELECT MAX(tp.Lift) FROM (
        SELECT lower(trim(both '<>' FROM unnest(string_to_array(substring(q.Tags,2,length(q.Tags)-2),'><')))) AS t
      ) AS qt
      JOIN TopTagPairs tp ON (tp.Taga = qt.t OR tp.TagB = qt.t)
    ) AS MaxTagLift,
    -- recency weight: exponential decay by days since last activity
    exp(- greatest(extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - COALESCE(q.LastActivityDate, q.CreationDate)))/86400, 0) / 30.0) AS RecencyWeight,
    -- composite hotness score
    (
      (COALESCE(q.Score,0) * 2.5)
      + (LN(GREATEST(COALESCE(q.ViewCount,0),1)) * 1.2)
      + (COALESCE(q.AnswerCount,0) * 3.0)
      + (COALESCE(q.FavoriteCount,0) * 5.0)
      + (COALESCE( (SELECT MAX(tp.Lift) FROM (
            SELECT lower(trim(both '<>' FROM unnest(string_to_array(substring(q.Tags,2,length(q.Tags)-2),'><')))) AS t
          ) AS qt
          JOIN TopTagPairs tp ON (tp.Taga = qt.t OR tp.TagB = qt.t)
        ), 0) * 50.0)
    ) * exp(- greatest(extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - COALESCE(q.LastActivityDate, q.CreationDate)))/86400, 0) / 30.0)
    AS HotnessScore
  FROM Posts q
  WHERE q.PostTypeId = 1 AND q.Tags IS NOT NULL
),
RecentActiveUsers AS (
  -- find users who recently engaged (comments, answers, votes) and compute influence score
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT a.Id) FILTER (WHERE a.PostTypeId=2) AS RecentAnswers,
    COUNT(DISTINCT c.Id) FILTER (WHERE c.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '90 days') AS RecentComments,
    COUNT(DISTINCT v.Id) FILTER (WHERE v.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '90 days') AS RecentVotes,
    -- influence: reputation * log(1+recent activity)
    (u.Reputation::numeric * LN(GREATEST(1, 1 + COUNT(DISTINCT a.Id) FILTER (WHERE a.PostTypeId=2) + COUNT(DISTINCT c.Id) FILTER (WHERE c.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '90 days') + COUNT(DISTINCT v.Id) FILTER (WHERE v.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '90 days')))) AS Influence
  FROM Users u
  LEFT JOIN Posts a ON a.OwnerUserId = u.Id AND a.PostTypeId = 2 AND a.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '365 days'
  LEFT JOIN Comments c ON c.UserId = u.Id
  LEFT JOIN Votes v ON v.UserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation
),
AnswerQuality AS (
  -- per-answer quality signals aggregated to question level
  SELECT
    ans.ParentId AS QuestionId,
    COUNT(*) FILTER (WHERE ans.Score >= 5) AS HighScoreAnswers,
    AVG(ans.Score)::numeric(8,3) AS AvgAnswerScore,
    SUM(CASE WHEN EXISTS (SELECT 1 FROM Votes vv WHERE vv.PostId = ans.Id AND vv.VoteTypeId = 8) THEN 1 ELSE 0 END) AS HasBountyAnswers
  FROM Posts ans
  WHERE ans.PostTypeId = 2
  GROUP BY ans.ParentId
)
SELECT
  h.Id AS QuestionId,
  h.Title,
  h.CreationDate,
  h.Score,
  h.ViewCount,
  h.AnswerCount,
  h.FavoriteCount,
  COALESCE(aq.HighScoreAnswers,0) AS HighScoreAnswers,
  COALESCE(aq.AvgAnswerScore,0)::numeric(8,3) AS AvgAnswerScore,
  COALESCE(h.MaxTagLift,0)::numeric(10,6) AS MaxTagLift,
  COALESCE(h.RecencyWeight,0)::numeric(10,6) AS RecencyWeight,
  h.HotnessScore::numeric(14,6) AS HotnessScore,
  -- find top 3 recent active users who answered or commented on this question in last 180 days and their combined influence
  (
    SELECT json_agg(json_build_object('UserId', ru.UserId, 'DisplayName', ru.DisplayName, 'Influence', ru.Influence)::json ORDER BY ru.Influence DESC)
    FROM (
      SELECT DISTINCT u.UserId, u.DisplayName, u.Influence
      FROM RecentActiveUsers u
      JOIN (
        SELECT OwnerUserId AS uid FROM Posts p2 WHERE p2.ParentId = h.Id AND p2.PostTypeId = 2 AND p2.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '180 days'
        UNION
        SELECT UserId FROM Comments c2 WHERE c2.PostId = h.Id AND c2.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '180 days'
      ) engaged ON engaged.uid = u.UserId
      ORDER BY u.Influence DESC
      LIMIT 3
    ) ru
  ) AS TopContributors,
  -- related trending tags: top 5 tags co-occurring with any tag on this question, ordered by Jaccard * CoCount
  (
    SELECT json_agg(json_build_object('Tag', t.TagB, 'CoCount', t.CoCount, 'Jaccard', t.Jaccard, 'Score', (t.Jaccard * t.CoCount)::numeric(12,6)) ORDER BY (t.Jaccard * t.CoCount) DESC)
    FROM TopTagPairs t
    WHERE t.Taga IN (
      SELECT lower(trim(both '<>' FROM unnest(string_to_array(substring(h.Tags,2,length(h.Tags)-2),'><'))))
    )
    LIMIT 5
  ) AS RelatedTrendingTags
FROM HotQuestions h
LEFT JOIN AnswerQuality aq ON aq.QuestionId = h.Id
ORDER BY h.HotnessScore DESC
LIMIT 250;