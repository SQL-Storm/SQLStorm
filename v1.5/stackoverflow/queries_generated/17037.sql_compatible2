WITH UserMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, 'Unknown') AS Location,
        (EXTRACT(YEAR FROM AGE(DATE '2024-10-01', u.CreationDate)) * 12)
        + EXTRACT(MONTH FROM AGE(DATE '2024-10-01', u.CreationDate)) AS AccountAgeMonths,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        AVG(CASE WHEN p.Score IS NOT NULL THEN p.Score ELSE 0 END) AS AvgPostScore,
        STRING_AGG(DISTINCT 
            CASE WHEN b.Class = 1 THEN b.Name END, ', ' 
            ORDER BY CASE WHEN b.Class = 1 THEN b.Name END
        ) AS GoldBadges,
        LAG(u.Reputation, 1, 0) OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS PrevUserRep,
        DENSE_RANK() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS LocationRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate < DATE '2024-10-01' - INTERVAL '180 days'
        AND (u.Reputation > 1000 OR u.Reputation IS NULL)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location, u.CreationDate
),
TopQuestions AS (
    SELECT 
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.Tags,
        COALESCE(q.AnswerCount, 0) AS AnswerCount,
        MAX(a.Score) AS BestAnswerScore,
        COUNT(DISTINCT ph.UserId) FILTER (WHERE ph.PostHistoryTypeId IN (4, 5, 6)) AS EditCount,
        FIRST_VALUE(a.OwnerUserId) OVER (
            PARTITION BY q.Id 
            ORDER BY a.Score DESC NULLS LAST, a.CreationDate ASC
        ) AS BestAnswerUserId,
        ROW_NUMBER() OVER (
            PARTITION BY q.OwnerUserId 
            ORDER BY q.Score DESC, q.ViewCount DESC NULLS LAST
        ) AS UserQuestionRank
    FROM Posts q
    LEFT JOIN Posts a ON q.Id = a.ParentId AND a.PostTypeId = 2
    LEFT JOIN PostHistory ph ON q.Id = ph.PostId
    WHERE q.PostTypeId = 1 
        AND q.ClosedDate IS NULL
        AND q.Score >= 5
        AND q.CreationDate BETWEEN DATE '2024-10-01' - INTERVAL '2 years' AND DATE '2024-10-01' - INTERVAL '1 month'
    GROUP BY q.Id, q.Title, q.OwnerUserId, q.Score, q.ViewCount, q.Tags, q.AnswerCount, a.Score, a.CreationDate, a.OwnerUserId
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count AS TagUsageCount,
        COUNT(DISTINCT p.Id) AS RecentPostCount,
        AVG(p.Score) FILTER (WHERE p.Score > 0) AS AvgPositiveScore,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.ViewCount) AS MedianViews,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 100 AND AVG(p.Score) > 10 THEN 'Hot'
            WHEN COUNT(DISTINCT p.Id) < 10 THEN 'Cold'
            ELSE 'Moderate'
        END AS TagTemperature,
        EXISTS (
            SELECT 1 
            FROM Posts p2 
            WHERE p2.Tags LIKE '%<' || t.TagName || '>%' 
                AND p2.CreationDate > DATE '2024-10-01' - INTERVAL '7 days'
        ) AS HasRecentActivity
    FROM Tags t
    INNER JOIN Posts p ON p.Tags LIKE '%<' || t.TagName || '>%'
    WHERE t.Count > 50
        AND p.CreationDate > DATE '2024-10-01' - INTERVAL '6 months'
    GROUP BY t.TagName, t.Count
)
SELECT 
    um.DisplayName,
    um.Reputation,
    um.Location,
    um.AccountAgeMonths,
    um.PostCount,
    ROUND(um.AvgPostScore, 2) AS AvgPostScore,
    um.LocationRank,
    COALESCE(um.GoldBadges, 'None') AS GoldBadges,
    tq.Title AS TopQuestionTitle,
    tq.QuestionScore,
    tq.ViewCount,
    SUBSTRING(tq.Tags FROM 2 FOR LENGTH(tq.Tags) - 2) AS QuestionTags,
    tq.BestAnswerScore,
    CASE 
        WHEN tq.BestAnswerUserId = um.Id THEN 'Self-Answered'
        WHEN tq.BestAnswerUserId IS NOT NULL THEN 'Answered by Others'
        ELSE 'Unanswered'
    END AS AnswerStatus,
    tq.EditCount,
    ta2.TagName AS PrimaryTag,
    ta2.TagTemperature,
    ta2.AvgPositiveScore AS TagAvgScore,
    COALESCE(
        (SELECT COUNT(DISTINCT c.Id)
         FROM Comments c
         WHERE c.PostId IN (
             SELECT p.Id 
             FROM Posts p 
             WHERE p.OwnerUserId = um.Id
         ) AND c.Score > 5),
        0
    ) AS HighScoredCommentsReceived,
    um.Reputation - um.PrevUserRep AS ReputationGapInLocation,
    CASE 
        WHEN um.Reputation > 10000 AND um.QuestionCount > 50 AND um.AnswerCount > 100 THEN 'Expert'
        WHEN um.Reputation > 5000 OR (um.QuestionCount > 20 AND um.AnswerCount > 40) THEN 'Active Contributor'
        WHEN um.PostCount > 10 THEN 'Regular User'
        ELSE 'Newcomer'
    END AS UserCategory,
    COALESCE(
        (SELECT STRING_AGG(DISTINCT vt.Name, ', ' ORDER BY vt.Name)
         FROM Votes v
         INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
         WHERE v.UserId = um.Id
            AND v.CreationDate > DATE '2024-10-01' - INTERVAL '30 days'
            AND v.VoteTypeId IN (2, 3, 8)),
        'No Recent Votes'
    ) AS RecentVoteTypes
FROM UserMetrics um
LEFT JOIN TopQuestions tq ON um.Id = tq.OwnerUserId AND tq.UserQuestionRank = 1
LEFT JOIN LATERAL (
    SELECT ta2.*
    FROM TagAnalysis ta2
    WHERE tq.Tags LIKE '%<' || ta2.TagName || '>%'
    ORDER BY ta2.TagUsageCount DESC
    LIMIT 1
) ta2 ON TRUE
WHERE um.PostCount > 0
    AND (um.LocationRank <= 10 OR um.Reputation > 50000)
    AND NOT EXISTS (
        SELECT 1 
        FROM PostHistory ph 
        WHERE ph.UserId = um.Id 
            AND ph.PostHistoryTypeId = 12 
            AND ph.CreationDate > DATE '2024-10-01' - INTERVAL '90 days'
    )
ORDER BY 
    um.Location NULLS LAST,
    um.LocationRank,
    um.Reputation DESC,
    tq.QuestionScore DESC NULLS LAST
LIMIT 500;