-- {"query": "55040.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2048, "output_tokens": 1966} 
WITH user_stats AS (
    SELECT u.Id,
           u.DisplayName,
           u.Reputation,
           COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END)               AS QuestionCount,
           COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END)               AS AnswerCount,
           COALESCE(SUM(p.Score),0)                                               AS TotalPostScore,
           AVG(p.Score) FILTER (WHERE p.PostTypeId = 2)                           AS AvgAnswerScore,
           MAX(p.CreationDate)                                                    AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
badge_stats AS (
    SELECT b.UserId,
           COUNT(*) FILTER (WHERE b.Class = 1)                                   AS GoldBadges,
           COUNT(*) FILTER (WHERE b.Class = 2)                                   AS SilverBadges,
           COUNT(*) FILTER (WHERE b.Class = 3)                                   AS BronzeBadges,
           jsonb_agg(DISTINCT b.Name) FILTER (WHERE b.TagBased = 0)              AS NamedBadges,
           jsonb_agg(DISTINCT b.Name) FILTER (WHERE b.TagBased = 1)              AS TagBadges
    FROM Badges b
    GROUP BY b.UserId
),
vote_stats AS (
    SELECT v.PostId,
           SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END)                    AS UpVotes,
           SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END)                    AS DownVotes,
           MAX(v.CreationDate)                                                  AS LastVoteDate
    FROM Votes v
    GROUP BY v.PostId
),
recent_activity AS (
    SELECT u.Id AS UserId,
           MAX(a.activity_date)                                                 AS LastActivity
    FROM Users u
    LEFT JOIN LATERAL (
        SELECT GREATEST(p.CreationDate,
                        COALESCE(p.LastEditDate, '1970-01-01'::timestamp),
                        COALESCE(vs.LastVoteDate, '1970-01-01'::timestamp)) AS activity_date
        FROM Posts p
        LEFT JOIN vote_stats vs ON vs.PostId = p.Id
        WHERE p.OwnerUserId = u.Id
        UNION ALL
        SELECT c.CreationDate
        FROM Comments c
        WHERE c.UserId = u.Id
        UNION ALL
        SELECT ph.CreationDate
        FROM PostHistory ph
        WHERE ph.UserId = u.Id
    ) a ON true
    GROUP BY u.Id
)
SELECT us.Id,
       us.DisplayName,
       us.Reputation,
       us.QuestionCount,
       us.AnswerCount,
       us.TotalPostScore,
       ROUND(us.AvgAnswerScore::numeric,2)                                      AS AvgAnswerScore,
       us.LastPostDate,
       bs.GoldBadges,
       bs.SilverBadges,
       bs.BronzeBadges,
       bs.NamedBadges,
       bs.TagBadges,
       ra.LastActivity,
       jsonb_build_object(
           'TopTags',
               (SELECT jsonb_agg(t.TagName)
                FROM (
                      SELECT replace(replace(tag,'<',''),'>','') AS clean_tag
                      FROM (
                            SELECT unnest(string_to_array(p.Tags, '><')) AS tag
                            FROM Posts p
                            WHERE p.OwnerUserId = us.Id AND p.PostTypeId = 1
                      ) sub
                ) pt
                JOIN Tags t ON t.TagName = pt.clean_tag
                GROUP BY t.TagName
                ORDER BY COUNT(*) DESC
                LIMIT 5),
           'DuplicateLinks',
               (SELECT jsonb_agg(jsonb_build_object('PostId', pl.PostId,
                                                    'DuplicateOf', pl.RelatedPostId))
                FROM PostLinks pl
                WHERE pl.LinkTypeId = 3
                  AND pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = us.Id))
       )                                                                          AS ExtraInfo
FROM user_stats us
LEFT JOIN badge_stats bs   ON bs.UserId = us.Id
LEFT JOIN recent_activity ra ON ra.UserId = us.Id
WHERE us.Reputation > 50000
ORDER BY us.Reputation DESC
LIMIT 10;