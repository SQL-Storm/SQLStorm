-- {"query": "51055.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "grok-4-fast-non-reasoning", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2129, "output_tokens": 933} 
WITH tag_stats AS (
    SELECT 
        t.TagName,
        COUNT(DISTINCT p.Id) AS question_count,
        AVG(p.Score) AS avg_score,
        SUM(CASE WHEN p.Score > 0 THEN 1 ELSE 0 END) AS positive_questions,
        PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY p.Score) AS top_90_percentile_score
    FROM Tags t
    INNER JOIN Posts p ON position(t.TagName IN p.Tags) > 0
    WHERE p.PostTypeId = 1
    GROUP BY t.TagName
    HAVING COUNT(DISTINCT p.Id) > 10
),
user_activity AS (
    SELECT 
        u.Id AS user_id,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS posts_counted,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (4,5,6) THEN ph.Id END) AS edits_made,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS upvotes_given,
        COUNT(DISTINCT CASE WHEN p.AcceptedAnswerId = v.PostId THEN v.PostId END) AS accepted_answers
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId IN (1,2)
    LEFT JOIN PostHistory ph ON ph.UserId = u.Id AND ph.PostId = p.Id
    LEFT JOIN Votes v ON v.UserId = u.Id AND v.VoteTypeId IN (2,3)
    WHERE u.Reputation > 100
    GROUP BY u.Id, u.Reputation
),
linked_activity AS (
    SELECT 
        pl.PostId,
        COUNT(DISTINCT pl.RelatedPostId) AS outbound_links,
        AVG(plp.Score) AS avg_linked_post_score,
        COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN pl.RelatedPostId END) AS duplicate_links
    FROM PostLinks pl
    INNER JOIN Posts plp ON pl.RelatedPostId = plp.Id
    WHERE pl.LinkTypeId IN (1,3)
    GROUP BY pl.PostId
)
SELECT 
    ts.TagName,
    ts.question_count,
    ts.avg_score,
    ts.positive_questions * 100.0 / NULLIF(ts.question_count, 0) AS positivity_rate,
    ts.top_90_percentile_score,
    COALESCE(ua.posts_counted, 0) AS active_users_in_tag,
    COALESCE(ua.edits_made, 0) AS total_edits_in_tag,
    COALESCE(la.outbound_links, 0) AS avg_links_per_question,
    COALESCE(la.avg_linked_post_score, 0) AS avg_linked_quality,
    RANK() OVER (ORDER BY ts.question_count DESC, ts.avg_score DESC) AS popularity_rank
FROM tag_stats ts
LEFT JOIN (
    SELECT 
        SUBSTRING(p.Tags FROM '<' || t.TagName || '><') IS NOT NULL AS has_tag,
        COUNT(DISTINCT p.OwnerUserId) AS posts_counted,
        SUM(ua2.posts_counted) AS total_user_activity,
        SUM(ua2.edits_made) AS total_edits,
        AVG(ua2.Reputation) AS avg_user_reputation
    FROM Posts p
    CROSS JOIN Tags t
    LEFT JOIN user_activity ua2 ON ua2.user_id = p.OwnerUserId
    WHERE SUBSTRING(p.Tags FROM '<' || t.TagName || '><') IS NOT NULL
      AND p.PostTypeId = 1
    GROUP BY t.TagName
) user_tag_activity ON user_tag_activity.has_tag = true
LEFT JOIN (
    SELECT 
        p2.Id,
        AVG(la2.outbound_links) AS avg_links,
        AVG(la2.avg_linked_post_score) AS avg_linked_score
    FROM Posts p2
    LEFT JOIN linked_activity la2 ON la2.PostId = p2.Id
    WHERE p2.PostTypeId = 1
    GROUP BY p2.Tags
) link_stats ON position(ts.TagName IN link_stats.Tags) > 0
LEFT JOIN linked_activity la ON la.PostId IN (
    SELECT p3.Id 
    FROM Posts p3 
    WHERE position(ts.TagName IN p3.Tags) > 0 AND p3.PostTypeId = 1
    LIMIT 100
)
ORDER BY popularity_rank
LIMIT 50;