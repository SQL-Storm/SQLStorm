WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        U.DisplayName,
        U.Reputation,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    WHERE 
        B.Class = 1 AND B.TagBased = FALSE
    GROUP BY 
        U.Id
)
SELECT 
    RP.Id,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.rank,
    RP.DisplayName AS UserDisplayName,
    RP.Reputation,
    B.BadgeCount,
    CASE 
        WHEN RP.rank <= 3 THEN 'Top'
        WHEN RP.rank <= 10 THEN 'High'
        ELSE 'Low'
    END AS RankStatus,
    SUBSTRING(SUBSTRING(RP.Title FROM POSITION(' ' IN RP.Title) + 1) FROM 1 FOR (POSITION(' ' IN SUBSTRING(RP.Title FROM POSITION(' ' IN RP.Title) + 1) FROM 1) - 1)) AS FirstKeyword,
    SUBSTRING(SUBSTRING(RP.Title FROM (CHAR_LENGTH(RP.Title) - CHAR_LENGTH(REVERSE(RP.Title)) - POSITION(' ' IN REVERSE(RP.Title)) + 2) FROM 1)) AS LastKeyword,
    CASE 
        WHEN RP.Reputation >= 10000 THEN 'Veteran'
        ELSE 'Newbie'
    END AS UserStatus,
    LAG(RP.Score) OVER (ORDER BY RP.rank) AS PreviousScore,
    LEAD(RP.Score) OVER (ORDER BY RP.rank) AS NextScore,
    COALESCE(SUM(V.BountyAmount) OVER (PARTITION BY RP.Id ORDER BY V.CreationDate), 0) AS TotalBounty
FROM 
    RankedPosts RP
LEFT JOIN 
    Users U ON RP.Id = U.Id
LEFT JOIN 
    BadgeCounts B ON RP.Id = B.UserId
LEFT JOIN 
    Votes V ON RP.Id = V.PostId AND V.VoteTypeId = 8
WHERE 
    RP.rank <= 10
ORDER BY 
    RP.rank;