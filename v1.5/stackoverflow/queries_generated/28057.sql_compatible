WITH ActiveUsers AS (
    SELECT 
        u.Id, 
        u.DisplayName, 
        u.Reputation, 
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS ReputationRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    WHERE u.Reputation > 1000
    GROUP BY u.Id
), TopPosts AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        p.Score,
        p.Title,
        p.Tags,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS Downvotes,
        RANK() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS PostRank
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.ClosedDate IS NULL
)
SELECT 
    au.DisplayName,
    au.Reputation,
    au.TotalPosts,
    au.TotalComments,
    au.GoldBadges,
    tp.Title,
    tp.Tags,
    tp.Upvotes,
    tp.Downvotes,
    COALESCE(ph.Comment, 'No close history') AS CloseHistory,
    STRING_AGG(DISTINCT lt.Name, ', ') AS LinkTypesUsed,
    AVG(v.BountyAmount) FILTER (WHERE v.VoteTypeId = 8) AS AvgBounty,
    (tp.Upvotes * 1.0 / NULLIF(tp.Downvotes, 0)) AS UpvoteRatio,
    CASE 
        WHEN au.ReputationRank <= 10 THEN 'Top 10 User'
        WHEN au.GoldBadges >= 5 THEN 'Elite Badge Holder'
        ELSE 'Active Contributor'
    END AS UserCategory
FROM ActiveUsers au
INNER JOIN TopPosts tp ON au.Id = tp.OwnerUserId AND tp.PostRank = 1
LEFT JOIN PostHistory ph 
    ON ph.PostId = tp.Id 
    AND ph.PostHistoryTypeId IN (10, 11, 12, 13)
LEFT JOIN PostLinks pl 
    ON pl.PostId = tp.Id 
    AND pl.LinkTypeId IN (1, 3)
LEFT JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
LEFT JOIN Votes v 
    ON v.PostId = tp.Id 
    AND v.VoteTypeId IN (8, 9)
WHERE EXISTS (
    SELECT 1 
    FROM Badges b 
    WHERE b.UserId = au.Id 
    AND b.Class = 1 
    AND b.Name LIKE '%Legendary%'
)
OR tp.Score > 1000
GROUP BY 
    au.DisplayName, 
    au.Reputation, 
    au.TotalPosts, 
    au.TotalComments, 
    au.GoldBadges, 
    tp.Title, 
    tp.Tags, 
    tp.Upvotes, 
    tp.Downvotes, 
    ph.Comment
HAVING AVG(v.BountyAmount) > 50 OR COUNT(pl.Id) > 2
ORDER BY 
    ReputationRank ASC, 
    UpvoteRatio DESC
LIMIT 100;