WITH PopularTags AS (
    SELECT TagName, COUNT(*) AS TagUsageCount
    FROM Tags
    INNER JOIN Posts ON Tags.ExcerptPostId = Posts.Id
    WHERE Posts.PostTypeId = 1
    GROUP BY TagName
    HAVING COUNT(*) > 100
),
ActiveUsers AS (
    SELECT Id, DisplayName, COALESCE(Views, 0) AS TotalViews
    FROM Users
    WHERE Reputation >= 1000
),
RecentEdits AS (
    SELECT ph.PostId, COUNT(*) AS EditCount
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4, 5, 6) -- Edit Title, Edit Body, Edit Tags
      AND ph.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
    GROUP BY ph.PostId
),
UserActivity AS (
    SELECT u.Id AS UserId, 
           p.Id AS PostId, 
           COALESCE(rpo.EditCount, 0) AS EditCount,
           ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS PostRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN RecentEdits rpo ON p.Id = rpo.PostId
    WHERE u.Reputation > 1000
      AND p.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
),
CombinedActivity AS (
    SELECT pa.UserId, 
           STRING_AGG(pt.TagName, ', ') AS PopularTags
    FROM UserActivity pa
    LEFT JOIN Posts p ON pa.PostId = p.Id
    LEFT JOIN PopularTags pt ON p.Tags LIKE '%' || pt.TagName || '%'
    GROUP BY pa.UserId
),
FinalResults AS (
    SELECT au.Id AS UserId,
           au.DisplayName AS UserName,
           ca.PopularTags,
           COALESCE(SUM(COALESCE(v.Score, 0)), 0) AS TotalVoteScore,
           au.TotalViews
    FROM ActiveUsers au
    LEFT JOIN CombinedActivity ca ON au.Id = ca.UserId
    LEFT JOIN Votes v ON au.Id = v.UserId
    WHERE (au.TotalViews > 500 OR ca.PopularTags IS NOT NULL)
    GROUP BY au.Id, au.DisplayName, ca.PopularTags, au.TotalViews
)
SELECT * 
FROM FinalResults
ORDER BY TotalVoteScore DESC, TotalViews DESC;