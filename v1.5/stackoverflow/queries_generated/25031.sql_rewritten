       NULL::varchar,
       NULL::int,
       NULL::int,
       NULL::int,
       NULL::int,
       NULL::int,
       NULL::varchar,
       NULL::int,
       NULL::timestamp,
       NULL::varchar,
       NULL::varchar[],
       NULL::int,
       NULL::int,
       NULL::int
WHERE NOT EXISTS (SELECT 1 FROM Users WHERE Reputation > 1000);