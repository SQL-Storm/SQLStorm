-- {"query": "49051.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2074, "output_tokens": 1831} 
WITH TargetTags AS (
    SELECT 'sql-server' AS Tag
    UNION ALL SELECT 'database-performance'
    UNION ALL SELECT 'optimization'
    UNION ALL SELECT 'postgresql'
    UNION ALL SELECT 'mysql'
    UNION ALL SELECT 'indexing'
),
UserQuestionPostHistory AS (
    -- Aggregates user activity related to editing their own questions
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(ph.Id) AS QuestionEditCount,
        MAX(ph.CreationDate) AS LastQuestionEditDate
    FROM Posts p
    JOIN PostHistory ph ON p.Id = ph.PostId AND p.OwnerUserId = ph.UserId
    WHERE p.PostTypeId = 1 -- Only questions
      AND ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9) -- Edit/Rollback Title, Body, Tags
    GROUP BY p.OwnerUserId
),
UserAnswerCommentActivity AS (
    -- Aggregates user activity related to commenting on answers to their own questions
    SELECT
        q.OwnerUserId AS UserId,
        COUNT(c.Id) AS AnswerCommentCount,
        COUNT(DISTINCT c.PostId) AS DistinctAnswerCommented,
        MAX(c.CreationDate) AS LastAnswerCommentDate
    FROM Posts q -- Original Questions
    JOIN Posts a ON q.Id = a.ParentId -- Answers to those questions
    JOIN Comments c ON a.Id = c.PostId AND q.OwnerUserId = c.UserId -- Comments by the question owner on those answers
    WHERE q.PostTypeId = 1
      AND a.PostTypeId = 2
    GROUP BY q.OwnerUserId
),
RelevantQuestionsWithTags AS (
    -- Filters questions by specific tags and calculates their initial metrics
    SELECT
        q.Id AS QuestionId,
        q.OwnerUserId,
        q.CreationDate AS QuestionCreationDate,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.Title,
        ARRAY_AGG(tt.Tag) FILTER (WHERE tt.Tag IS NOT NULL) AS MatchedTags
    FROM Posts q
    LEFT JOIN UNNEST(string_to_array(SUBSTRING(q.Tags, 2, LENGTH(q.Tags)-2), '><')) AS q_tag ON TRUE
    LEFT JOIN TargetTags tt ON q_tag = tt.Tag
    WHERE q.PostTypeId = 1
      AND q.Tags IS NOT NULL
      AND tt.Tag IS NOT NULL -- Ensures at least one target tag matches
    GROUP BY q.Id, q.OwnerUserId, q.CreationDate, q.Score, q.ViewCount, q.Title
    HAVING COUNT(tt.Tag) > 0
),
HighScoringAnswersToRelevantQuestions AS (
    -- Identifies high-scoring answers to the relevant questions
    SELECT
        r.OwnerUserId AS QuestionOwnerId,
        a.Id AS AnswerId,
        a.Score AS AnswerScore,
        a.CreationDate AS AnswerCreationDate,
        r.QuestionId,
        r.QuestionCreationDate
    FROM Posts a -- Answers
    JOIN RelevantQuestionsWithTags r ON a.ParentId = r.QuestionId
    WHERE a.PostTypeId = 2
      AND a.Score >= 10 -- Arbitrary threshold for "high-scoring"
),
UserQuestionPerformance AS (
    -- Aggregates question and answer performance metrics for each user
    SELECT
        hs.QuestionOwnerId AS UserId,
        COUNT(DISTINCT hs.QuestionId) AS TotalQuestionsAsked,
        COUNT(hs.AnswerId) AS TotalHighScoringAnswers,
        SUM(hs.AnswerScore) AS SumOfHighScoringAnswerScores,
        AVG(hs.AnswerScore) AS AvgHighScoringAnswerScore,
        MAX(hs.AnswerScore) AS MaxHighScoringAnswerScore,
        AVG(EXTRACT(EPOCH FROM (hs.AnswerCreationDate - hs.QuestionCreationDate))/(3600*24)) AS AvgTimeToAnswerDays
    FROM HighScoringAnswersToRelevantQuestions hs
    GROUP BY hs.QuestionOwnerId
),
UserReputationAndBadgeStats AS (
    -- Aggregates user reputation and badge statistics, especially focusing on 'Gold' badges
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate AS UserCreationDate,
        u.UpVotes,
        u.DownVotes,
        u.Views,
        COUNT(b.Id) AS TotalBadges,
        COUNT(CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadgesCount,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.CreationDate, u.UpVotes, u.DownVotes, u.Views
)
-- Final selection, combination, filtering, ordering, and ranking of users
SELECT
    uos.UserId,
    uos.DisplayName,
    uos.Reputation,
    uos.UpVotes,
    uos.Views,
    uos.TotalQuestionsAsked,
    uos.TotalHighScoringAnswers,
    uos.SumOfHighScoringAnswerScores,
    uos.AvgHighScoringAnswerScore,
    uos.MaxHighScoringAnswerScore,
    uos.AvgTimeToAnswerDays,
    uos.SelfEditCount,
    uos.SelfCommentOnAnswerCount,
    uos.DistinctAnswerCommented,
    uos.TotalBadges,
    uos.GoldBadgesCount,
    uos.LastBadgeDate,
    EXTRACT(YEAR FROM AGE(cast('2024-10-01 12:34:56' as timestamp), uos.UserCreationDate)) AS YearsOnPlatform,
    -- Calculate a complex 'Engagement and Impact Score'
    (
        (uos.TotalHighScoringAnswers * 15.0) +
        (uos.SumOfHighScoringAnswerScores * 0.7) +
        (uos.SelfEditCount * 5.0) +
        (uos.SelfCommentOnAnswerCount * 3.0) +
        (uos.GoldBadgesCount * 50.0) +
        (uos.Reputation * 0.01) +
        (uos.Views * 0.005)
    ) AS EngagementImpactScore,
    RANK() OVER (ORDER BY (
        (uos.TotalHighScoringAnswers * 15.0) +
        (uos.SumOfHighScoringAnswerScores * 0.7) +
        (uos.SelfEditCount * 5.0) +
        (uos.SelfCommentOnAnswerCount * 3.0) +
        (uos.GoldBadgesCount * 50.0) +
        (uos.Reputation * 0.01) +
        (uos.Views * 0.005)
    ) DESC) AS OverallEngagementRank,
    NTILE(5) OVER (ORDER BY uos.AvgTimeToAnswerDays ASC) AS SpeedyAnswererQuintile
FROM UserReputationAndBadgeStats uos
LEFT JOIN UserQuestionPerformance uqp ON uos.UserId = uqp.UserId
LEFT JOIN UserQuestionPostHistory uqph ON uos.UserId = uqph.UserId
LEFT JOIN UserAnswerCommentActivity uaca ON uos.UserId = uaca.UserId
WHERE
    uos.Reputation > 5000 -- Focus on more established users
    AND COALESCE(uqp.TotalQuestionsAsked, 0) > 10 -- Users who asked at least 10 relevant questions
    AND COALESCE(uqp.TotalHighScoringAnswers, 0) > 5 -- Users whose questions received at least 5 high-scoring answers
    AND COALESCE(uqph.QuestionEditCount, 0) > 2 -- Users who actively edit their questions
    AND uos.UserCreationDate < (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') -- Active for at least a year
ORDER BY EngagementImpactScore DESC, OverallEngagementRank
LIMIT 50;