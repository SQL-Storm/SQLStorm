-- {"query": "39088.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "codex-mini-latest", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 1972, "output_tokens": 1967} 
WITH
-- explode tags on each question into individual tag rows
QuestionTags AS (
    SELECT
        p.Id         AS QuestionId,
        unnest(
            string_to_array(
                substring(p.Tags, 2, length(p.Tags) - 2),
                '><'
            )
        )             AS Tag
    FROM Posts p
    WHERE p.PostTypeId = 1
),
-- compute average score and question count per tag
TagScores AS (
    SELECT
        qt.Tag,
        AVG(p.Score)  AS AvgScore,
        COUNT(*)      AS QuestionCount
    FROM QuestionTags qt
    JOIN Posts p
      ON p.Id = qt.QuestionId
    GROUP BY qt.Tag
),
-- summarize badges by user (total plus breakdown by class)
BadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(*)                                           AS TotalBadges,
        COUNT(*) FILTER (WHERE b.Class = 1)               AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2)               AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3)               AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
),
-- count posts in the last 30 days per user
RecentPosts AS (
    SELECT
        p.OwnerUserId              AS UserId,
        COUNT(*)                   AS PostsLast30Days,
        MAX(p.CreationDate)        AS LastPostDate
    FROM Posts p
    WHERE p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
      AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
-- rank users by reputation
UserStats AS (
    SELECT
        u.Id                       AS UserId,
        u.DisplayName,
        u.Reputation,
        RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank
    FROM Users u
)
SELECT
    us.DisplayName,
    us.Reputation,
    us.ReputationRank,
    COALESCE(rp.PostsLast30Days, 0) AS PostsLast30Days,
    rp.LastPostDate,
    COALESCE(bs.TotalBadges,     0) AS TotalBadges,
    COALESCE(bs.GoldBadges,      0) AS GoldBadges,
    COALESCE(bs.SilverBadges,    0) AS SilverBadges,
    COALESCE(bs.BronzeBadges,    0) AS BronzeBadges,
    -- top 5 tags by average question score for each user, as JSON array
    (
      SELECT json_agg(json_build_object(
                 'Tag',           ts.Tag,
                 'AvgScore',      ts.AvgScore,
                 'QuestionCount', ts.QuestionCount
             ) ORDER BY ts.AvgScore DESC)
      FROM (
          SELECT
              qt.Tag,
              ts2.AvgScore,
              ts2.QuestionCount
          FROM QuestionTags qt
          JOIN TagScores ts2
            ON ts2.Tag = qt.Tag
          JOIN Posts pq
            ON pq.Id = qt.QuestionId
          WHERE pq.OwnerUserId = us.UserId
          GROUP BY qt.Tag, ts2.AvgScore, ts2.QuestionCount
          ORDER BY ts2.AvgScore DESC
          LIMIT 5
      ) ts
    ) AS TopTags
FROM UserStats us
LEFT JOIN RecentPosts  rp ON rp.UserId = us.UserId
LEFT JOIN BadgeSummary bs ON bs.UserId = us.UserId
ORDER BY us.ReputationRank
LIMIT 100;