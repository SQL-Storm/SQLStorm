SELECT 
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
    COUNT(DISTINCT b.Id) AS Badges,
    COUNT(DISTINCT v.Id) AS Votes,
    COUNT(DISTINCT c.Id) AS Comments,
    COUNT(DISTINCT ph.Id) AS PostHistoryEntries,
    COUNT(DISTINCT pl.Id) AS PostLinks,
    STRING_AGG(DISTINCT t.TagName, ', ') AS TagsUsed,
    MAX(p.CreationDate) AS LatestPostDate,
    MAX(u.LastAccessDate) AS LastAccess,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.ViewCount > 1000 THEN p.Id END) AS HighViewQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 AND p.Score > 10 THEN p.Id END) AS HighScoreAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Score > 50 THEN p.Id END) AS HighScoreQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AnswerCount > 10 THEN p.Id END) AS HighlyAnsweredQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.CommentCount > 5 THEN p.Id END) AS HighlyCommentedQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.FavoriteCount > 20 THEN p.Id END) AS HighlyFavoritedQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL THEN p.Id END) AS ClosedQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.CommunityOwnedDate IS NOT NULL THEN p.Id END) AS CommunityOwnedQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN p.Id END) AS QuestionsWithAcceptedAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags IS NOT NULL AND p.Tags <> '' THEN p.Id END) AS TaggedQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.LastActivityDate > u.LastAccessDate THEN p.Id END) AS RecentlyActiveQuestions,
    AVG(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount END) AS AvgQuestionViews,
    AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS AvgAnswerScore,
    AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%python%' THEN p.Id END) AS PythonQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%java%' THEN p.Id END) AS JavaQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%javascript%' THEN p.Id END) AS JavaScriptQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%c#%' THEN p.Id END) AS CSharpQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%c++%' THEN p.Id END) AS CPlusPlusQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%sql%' THEN p.Id END) AS SQLQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%react%' THEN p.Id END) AS ReactQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%angular%' THEN p.Id END) AS AngularQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%vue%' THEN p.Id END) AS VueQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%php%' THEN p.Id END) AS PHPQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%ruby%' THEN p.Id END) AS RubyQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%go%' THEN p.Id END) AS GoQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%rust%' THEN p.Id END) AS RustQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%r%' THEN p.Id END) AS RQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%swift%' THEN p.Id END) AS SwiftQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%kotlin%' THEN p.Id END) AS KotlinQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%scala%' THEN p.Id END) AS ScalaQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%perl%' THEN p.Id END) AS PerlQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%lua%' THEN p.Id END) AS LuaQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%typescript%' THEN p.Id END) AS TypeScriptQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%graphql%' THEN p.Id END) AS GraphQLQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%docker%' THEN p.Id END) AS DockerQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%kubernetes%' THEN p.Id END) AS KubernetesQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%aws%' THEN p.Id END) AS AWSQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%azure%' THEN p.Id END) AS AzureQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%gcp%' THEN p.Id END) AS GCPQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%tensorflow%' THEN p.Id END) AS TensorFlowQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%pytorch%' THEN p.Id END) AS PyTorchQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%machine-learning%' THEN p.Id END) AS MLQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%data-science%' THEN p.Id END) AS DataScienceQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%big-data%' THEN p.Id END) AS BigDataQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%security%' THEN p.Id END) AS SecurityQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%networking%' THEN p.Id END) AS NetworkingQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags LIKE '%database%' THEN p.Id END) AS DatabaseQuestions
FROM users u
LEFT JOIN posts p ON p.OwnerUserId = u.Id
LEFT JOIN badges b ON b.UserId = u.Id
LEFT JOIN votes v ON v.UserId = u.Id
LEFT JOIN comments c ON c.UserId = u.Id
LEFT JOIN posthistory ph ON ph.UserId = u.Id
LEFT JOIN postlinks pl ON pl.UserId = u.Id
LEFT JOIN tags t ON t.PostId = p.Id
GROUP BY 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.LastAccessDate;