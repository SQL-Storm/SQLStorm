WITH recent_posts AS (
    SELECT
        p.Id,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.CreationDate,
        p.Tags
    FROM Posts p
    WHERE p.CreationDate >= (DATE '2024-10-01' - INTERVAL '1 year')
      AND p.PostTypeId IN (1, 2)
),
post_agg AS (
    SELECT
        rp.OwnerUserId,
        SUM(rp.Score) AS total_score,
        COUNT(*) AS post_cnt,
        SUM(CASE WHEN rp.PostTypeId = 1 THEN 1 ELSE 0 END) AS question_cnt,
        SUM(CASE WHEN rp.PostTypeId = 2 THEN 1 ELSE 0 END) AS answer_cnt
    FROM recent_posts rp
    GROUP BY rp.OwnerUserId
),
badge_cnt AS (
    SELECT
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS gold,
        COUNT(*) FILTER (WHERE b.Class = 2) AS silver,
        COUNT(*) FILTER (WHERE b.Class = 3) AS bronze
    FROM Badges b
    GROUP BY b.UserId
),
vote_agg AS (
    SELECT
        p.OwnerUserId AS UserId,
        SUM(CASE
                WHEN vt.Id = 2 THEN 1
                WHEN vt.Id = 3 THEN -1
                ELSE 0
            END) AS net_votes
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    JOIN Posts p ON v.PostId = p.Id
    GROUP BY p.OwnerUserId
),
user_tag_usage AS (
    SELECT
        rp.OwnerUserId,
        tn.TagName,
        COUNT(*) AS tag_use
    FROM recent_posts rp
    CROSS JOIN LATERAL (
        SELECT unnest(string_to_array(trim(both '<>' FROM rp.Tags), '><')) AS TagName
    ) AS tn
    JOIN Tags t ON t.TagName = tn.TagName
    GROUP BY rp.OwnerUserId, tn.TagName
),
top_tags AS (
    SELECT
        utu.OwnerUserId,
        jsonb_agg(
            jsonb_build_object('tag', utu.TagName, 'use', utu.tag_use)
        ORDER BY utu.tag_use DESC) AS tags_json
    FROM user_tag_usage utu
    GROUP BY utu.OwnerUserId
),
recent_history AS (
    SELECT
        ph.UserId,
        jsonb_agg(
            jsonb_build_object(
                'postId', ph.PostId,
                'type', ph.PostHistoryTypeId,
                'date', ph.CreationDate
            )
        ORDER BY ph.CreationDate DESC) AS recent_history
    FROM PostHistory ph
    WHERE ph.CreationDate >= (DATE '2024-10-01' - INTERVAL '30 days')
    GROUP BY ph.UserId
)
SELECT
    u.Id AS user_id,
    u.DisplayName,
    u.Reputation,
    pa.total_score,
    pa.post_cnt,
    pa.question_cnt,
    pa.answer_cnt,
    bc.gold,
    bc.silver,
    bc.bronze,
    COALESCE(va.net_votes, 0) AS net_votes,
    tt.tags_json,
    rh.recent_history
FROM Users u
LEFT JOIN post_agg pa      ON u.Id = pa.OwnerUserId
LEFT JOIN badge_cnt bc     ON u.Id = bc.UserId
LEFT JOIN vote_agg va      ON u.Id = va.UserId
LEFT JOIN top_tags tt      ON u.Id = tt.OwnerUserId
LEFT JOIN recent_history rh ON u.Id = rh.UserId
WHERE pa.total_score IS NOT NULL
ORDER BY pa.total_score DESC
LIMIT 10;