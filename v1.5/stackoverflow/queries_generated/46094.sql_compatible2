WITH TopQuestionAuthors AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as QuestionCount,
        AVG(p.Score) as AvgScore,
        SUM(p.ViewCount) as TotalViews
    FROM Users u
    INNER JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE p.PostTypeId = 1
        AND p.CreationDate >= TIMESTAMP '2020-01-01'
        AND p.Score >= 5
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(DISTINCT p.Id) >= 10
),
AnswerMetrics AS (
    SELECT 
        a.ParentId as QuestionId,
        COUNT(DISTINCT a.Id) as AnswerCount,
        MAX(a.Score) as BestAnswerScore,
        AVG(a.Score) as AvgAnswerScore,
        COUNT(DISTINCT a.OwnerUserId) as UniqueAnswerers,
        SUM(CASE WHEN a.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) as HasAccepted
    FROM Posts a
    INNER JOIN Posts q ON a.ParentId = q.Id
    WHERE a.PostTypeId = 2
        AND q.PostTypeId = 1
        AND a.CreationDate >= TIMESTAMP '2020-01-01'
    GROUP BY a.ParentId
),
TagAnalysis AS (
    SELECT 
        UNNEST(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) as TagName,
        p.Id as PostId,
        p.Score,
        p.ViewCount
    FROM Posts p
    WHERE p.PostTypeId = 1
        AND p.Tags IS NOT NULL
        AND p.CreationDate >= TIMESTAMP '2020-01-01'
),
VotePatterns AS (
    SELECT 
        v.PostId,
        COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) as UpVotes,
        COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) as DownVotes,
        COUNT(CASE WHEN v.VoteTypeId = 5 THEN 1 END) as Favorites,
        COUNT(CASE WHEN v.VoteTypeId = 8 THEN 1 END) as Bounties,
        SUM(CASE WHEN v.VoteTypeId = 8 THEN v.BountyAmount ELSE 0 END) as TotalBountyAmount
    FROM Votes v
    WHERE v.CreationDate >= TIMESTAMP '2020-01-01'
    GROUP BY v.PostId
),
CommentActivity AS (
    SELECT 
        c.PostId,
        COUNT(*) as CommentCount,
        COUNT(DISTINCT c.UserId) as UniqueCommenters,
        AVG(c.Score) as AvgCommentScore,
        MAX(c.CreationDate) as LastCommentDate
    FROM Comments c
    WHERE c.CreationDate >= TIMESTAMP '2020-01-01'
    GROUP BY c.PostId
),
BadgeStats AS (
    SELECT 
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) as GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) as SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) as BronzeBadges,
        COUNT(CASE WHEN b.TagBased = 1 THEN 1 END) as TagBasedBadges
    FROM Badges b
    WHERE b.Date >= TIMESTAMP '2020-01-01'
    GROUP BY b.UserId
)
SELECT 
    tqa.DisplayName,
    tqa.Reputation,
    tqa.QuestionCount,
    ROUND(CAST(tqa.AvgScore AS numeric), 2) as AvgQuestionScore,
    tqa.TotalViews,
    ROUND(AVG(CAST(am.AnswerCount AS numeric))::numeric, 2) as AvgAnswersPerQuestion,
    ROUND(AVG(CAST(am.BestAnswerScore AS numeric))::numeric, 2) as AvgBestAnswerScore,
    ROUND(AVG(CAST(am.AvgAnswerScore AS numeric))::numeric, 2) as AvgOfAvgAnswerScores,
    STRING_AGG(DISTINCT ta.TagName, ', ' ORDER BY ta.TagName) FILTER (WHERE ta.TagName IN (
        SELECT TagName FROM TagAnalysis GROUP BY TagName ORDER BY COUNT(*) DESC LIMIT 3
    )) as TopTags,
    ROUND(AVG(CAST(vp.UpVotes AS numeric))::numeric, 2) as AvgUpVotes,
    ROUND(AVG(CAST(vp.DownVotes AS numeric))::numeric, 2) as AvgDownVotes,
    SUM(vp.TotalBountyAmount) as TotalBountiesReceived,
    ROUND(AVG(CAST(ca.ComponentCommentCount AS numeric))::numeric, 2) as AvgCommentsPerPost,
    COALESCE(bs.GoldBadges, 0) as GoldBadges,
    COALESCE(bs.SilverBadges, 0) as SilverBadges,
    COALESCE(bs.BronzeBadges, 0) as BronzeBadges,
    COUNT(DISTINCT pl.RelatedPostId) as LinkedPosts,
    ROUND(AVG(EXTRACT(EPOCH FROM (p.LastActivityDate - p.CreationDate))/86400)::numeric, 2) as AvgDaysActive
FROM TopQuestionAuthors tqa
INNER JOIN Posts p ON tqa.Id = p.OwnerUserId AND p.PostTypeId = 1
LEFT JOIN AnswerMetrics am ON p.Id = am.QuestionId
LEFT JOIN TagAnalysis ta ON p.Id = ta.PostId
LEFT JOIN VotePatterns vp ON p.Id = vp.PostId
LEFT JOIN CommentActivity ca ON p.Id = ca.PostId
LEFT JOIN BadgeStats bs ON tqa.Id = bs.UserId
LEFT JOIN PostLinks pl ON p.Id = pl.PostId
WHERE p.CreationDate >= TIMESTAMP '2020-01-01'
GROUP BY tqa.Id, tqa.DisplayName, tqa.Reputation, tqa.QuestionCount, tqa.AvgScore, tqa.TotalViews, bs.GoldBadges, bs.SilverBadges, bs.BronzeBadges
HAVING COUNT(DISTINCT p.Id) >= 5
ORDER BY tqa.Reputation DESC, tqa.QuestionCount DESC
LIMIT 100;