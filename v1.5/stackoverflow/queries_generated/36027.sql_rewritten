SELECT
  p.Id AS PostId,
  p.Title,
  p.PostTypeId,
  p.CreationDate,
  p.ViewCount,
  p.Score,
  p.OwnerUserId,
  u.DisplayName AS OwnerDisplayName,
  COUNT(*) OVER () AS TotalPosts,
  COUNT(DISTINCT v.UserId) OVER () AS DistinctVoters,
  AVG(v.BountyAmount) FILTER (WHERE v.BountyAmount IS NOT NULL) OVER () AS AvgBounty
FROM Posts p
JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Votes v ON v.PostId = p.Id
WHERE
  p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
  AND p.PostTypeId IN (1, 2)
GROUP BY
  p.Id, p.Title, p.PostTypeId, p.CreationDate, p.ViewCount, p.Score, p.OwnerUserId, u.DisplayName
ORDER BY p.CreationDate DESC
LIMIT 100;