WITH PostLinkAggregates AS (
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(pl.Id) FILTER (WHERE p.Id = pl.PostId AND pl.LinkTypeId = 1) AS OutboundLinksFromUserPosts,
        COUNT(pl.Id) FILTER (WHERE p.Id = pl.RelatedPostId AND pl.LinkTypeId = 1) AS InboundLinksToUserPosts,
        COUNT(pl.Id) FILTER (WHERE p.Id = pl.PostId AND pl.LinkTypeId = 3) AS UserPostsAsDuplicateSource,
        COUNT(pl.Id) FILTER (WHERE p.Id = pl.RelatedPostId AND pl.LinkTypeId = 3) AS UserPostsAsDuplicateTarget
    FROM Posts p
    JOIN PostLinks pl ON p.Id = pl.PostId OR p.Id = pl.RelatedPostId
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
UserPostAggregates AS (
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(p.Score) AS TotalPostScore,
        SUM(p.ViewCount) AS TotalViewCount,
        SUM(COALESCE(p.FavoriteCount, 0)) AS TotalFavoriteCount,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersCount,
        COUNT(CASE WHEN p.PostTypeId = 2 AND p.Id = q.AcceptedAnswerId THEN 1 ELSE NULL END) AS AcceptedAnswersProvided,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL) AS QuestionsWithAcceptedAnswers,
        AVG(p.Score) FILTER (WHERE p.PostTypeId = 1) AS AvgQuestionScore,
        AVG(p.Score) FILTER (WHERE p.PostTypeId = 2) AS AvgAnswerScore
    FROM Posts p
    LEFT JOIN Posts q ON p.PostTypeId = 2 AND p.ParentId = q.Id
    WHERE p.OwnerUserId IS NOT NULL
      AND p.PostTypeId IN (1, 2)
      AND p.CreationDate >= DATE '2020-01-01'
    GROUP BY p.OwnerUserId
),
UserCommentAggregates AS (
    SELECT
        c.UserId,
        COUNT(c.Id) AS TotalComments,
        SUM(c.Score) AS TotalCommentScore,
        AVG(c.Score) AS AvgCommentScore
    FROM Comments c
    WHERE c.UserId IS NOT NULL
      AND c.CreationDate >= DATE '2020-01-01'
    GROUP BY c.UserId
),
UserBadgeAggregates AS (
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        COUNT(CASE WHEN b.Class = 1 THEN 1 ELSE NULL END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 ELSE NULL END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 ELSE NULL END) AS BronzeBadges,
        COUNT(CASE WHEN b.TagBased = TRUE THEN 1 ELSE NULL END) AS TagBasedBadges
    FROM Badges b
    GROUP BY b.UserId
),
UserTagTopContrib AS (
    SELECT
        OwnerUserId AS UserId,
        ARRAY_AGG(DISTINCT t_split.tag ORDER BY tag_score DESC, tag_count DESC) FILTER (WHERE rn <= 3) AS Top3TagsByScore
    FROM (
        SELECT
            p.OwnerUserId,
            t_split.tag AS TagName,
            SUM(p.Score) AS tag_score,
            COUNT(p.Id) AS tag_count,
            ROW_NUMBER() OVER(PARTITION BY p.OwnerUserId ORDER BY SUM(p.Score) DESC, COUNT(p.Id) DESC) AS rn
        FROM Posts p
        JOIN LATERAL UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><')) AS t_split(tag)
            ON p.PostTypeId = 1 AND p.Tags IS NOT NULL AND LENGTH(p.Tags) > 2
        WHERE p.OwnerUserId IS NOT NULL
          AND p.CreationDate >= DATE '2020-01-01'
          AND p.Score > 0
        GROUP BY p.OwnerUserId, t_split.tag
    ) AS TagScores
    GROUP BY OwnerUserId
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.UpVotes,
    u.DownVotes,
    u.Views AS ProfileViews,
    COALESCE(upa.TotalPosts, 0) AS TotalPosts,
    COALESCE(upa.TotalPostScore, 0) AS TotalPostScore,
    COALESCE(upa.TotalViewCount, 0) AS TotalViewCount,
    COALESCE(upa.TotalFavoriteCount, 0) AS TotalFavoriteCount,
    COALESCE(upa.QuestionsCount, 0) AS QuestionsCount,
    COALESCE(upa.AnswersCount, 0) AS AnswersCount,
    COALESCE(upa.AcceptedAnswersProvided, 0) AS AcceptedAnswersProvided,
    COALESCE(upa.QuestionsWithAcceptedAnswers, 0) AS QuestionsWithAcceptedAnswers,
    COALESCE(uca.TotalComments, 0) AS TotalComments,
    COALESCE(uca.TotalCommentScore, 0) AS TotalCommentScore,
    COALESCE(uba.GoldBadges, 0) AS GoldBadges,
    COALESCE(uba.SilverBadges, 0) AS SilverBadges,
    COALESCE(uba.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(pla.OutboundLinksFromUserPosts, 0) AS PostsLinkingOut,
    COALESCE(pla.InboundLinksToUserPosts, 0) AS PostsLinkedTo,
    COALESCE(pla.UserPostsAsDuplicateSource, 0) AS UserPostsAsDuplicateSource,
    COALESCE(pla.UserPostsAsDuplicateTarget, 0) AS UserPostsAsDuplicateTarget,
    COALESCE(utc.Top3TagsByScore, '{}') AS Top3ContributingTags,
    (
        u.Reputation * 0.5 +
        COALESCE(upa.TotalPostScore, 0) * 0.1 +
        COALESCE(upa.TotalViewCount, 0) * 0.0005 +
        COALESCE(upa.TotalFavoriteCount, 0) * 0.02 +
        COALESCE(upa.AcceptedAnswersProvided, 0) * 20 +
        COALESCE(upa.QuestionsWithAcceptedAnswers, 0) * 5 +
        COALESCE(uca.TotalCommentScore, 0) * 0.05 +
        COALESCE(uba.GoldBadges, 0) * 100 +
        COALESCE(uba.SilverBadges, 0) * 40 +
        COALESCE(uba.BronzeBadges, 0) * 10 +
        COALESCE(pla.OutboundLinksFromUserPosts, 0) * 0.2 +
        COALESCE(pla.InboundLinksToUserPosts, 0) * 0.4 +
        COALESCE(pla.UserPostsAsDuplicateSource, 0) * 1.0 +
        COALESCE(pla.UserPostsAsDuplicateTarget, 0) * -0.5
    ) AS CompositeUserScore
FROM Users u
LEFT JOIN UserPostAggregates upa ON u.Id = upa.UserId
LEFT JOIN UserCommentAggregates uca ON u.Id = uca.UserId
LEFT JOIN UserBadgeAggregates uba ON u.Id = uba.UserId
LEFT JOIN PostLinkAggregates pla ON u.Id = pla.UserId
LEFT JOIN UserTagTopContrib utc ON u.Id = utc.UserId
WHERE u.Reputation > 100
  AND (COALESCE(upa.TotalPosts, 0) > 0 OR COALESCE(uca.TotalComments, 0) > 0 OR COALESCE(uba.TotalBadges, 0) > 0)
ORDER BY CompositeUserScore DESC, u.Reputation DESC
LIMIT 100;