WITH UserMetrics AS (
    SELECT u.Id,
           u.DisplayName,
           u.Reputation,
           COALESCE(qcnt.qcnt, 0)               AS QuestionCount,
           COALESCE(acnt.acnt, 0)               AS AnswerCount,
           COALESCE(vscore.avg_score, 0)        AS AvgVoteScore,
           COALESCE(cmt.cmtcnt, 0)              AS CommentCount,
           COALESCE(gold.badges_cnt, 0)         AS GoldBadgeCount
    FROM Users AS u
    LEFT JOIN (
        SELECT OwnerUserId, COUNT(*) AS qcnt
        FROM Posts
        WHERE PostTypeId = 1
        GROUP BY OwnerUserId
    ) AS qcnt ON qcnt.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT OwnerUserId, COUNT(*) AS acnt
        FROM Posts
        WHERE PostTypeId = 2
        GROUP BY OwnerUserId
    ) AS acnt ON acnt.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT p.OwnerUserId, AVG(COALESCE(v.Score, 0)) AS avg_score
        FROM Posts AS p
        JOIN Votes AS v ON v.PostId = p.Id
        WHERE p.OwnerUserId IS NOT NULL
        GROUP BY p.OwnerUserId
    ) AS vscore ON vscore.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT UserId, COUNT(*) AS cmtcnt
        FROM Comments
        GROUP BY UserId
    ) AS cmt ON cmt.UserId = u.Id
    LEFT JOIN (
        SELECT UserId, COUNT(*) AS badges_cnt
        FROM Badges
        WHERE Class = 1
        GROUP BY UserId
    ) AS gold ON gold.UserId = u.Id
    WHERE u.Reputation >= 20000
)
SELECT
    um.Id           AS UserId,
    um.DisplayName,
    um.Reputation,
    um.QuestionCount,
    um.AnswerCount,
    um.AvgVoteScore,
    um.CommentCount,
    um.GoldBadgeCount,
    ROW_NUMBER() OVER (PARTITION BY um.Reputation ORDER BY um.AnswerCount DESC) AS RankWithinRep
FROM UserMetrics AS um
ORDER BY um.Reputation DESC
       , um.AnswerCount DESC
LIMIT 100;