WITH RECURSIVE tag_hierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        COUNT(DISTINCT pt.Id) AS direct_questions,
        ARRAY[t.TagName] AS tag_path,
        1 AS depth
    FROM Tags t
    INNER JOIN Posts pt ON pt.Tags LIKE '%' || '<' || t.TagName || '>' || '%' 
    WHERE pt.PostTypeId = 1
      AND t.Count > 1000
    GROUP BY t.Id, t.TagName
    
    UNION ALL
    
    SELECT 
        t2.Id,
        t2.TagName,
        th.direct_questions,
        th.tag_path || t2.TagName,
        th.depth + 1
    FROM tag_hierarchy th
    CROSS JOIN Tags t2
    WHERE th.depth < 3
      AND t2.Id <> ALL(
          SELECT t3.Id FROM Tags t3 WHERE t3.TagName = ANY(th.tag_path)
      )
      AND EXISTS (
          SELECT 1 FROM Posts p
          WHERE p.Tags LIKE '%' || '<' || th.tag_path[array_upper(th.tag_path, 1)] || '>' || '%' 
            AND p.Tags LIKE '%' || '<' || t2.TagName || '>%' 
            AND p.PostTypeId = 1
      )
),
user_expertise AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        t.TagName,
        COUNT(DISTINCT p.Id) AS answers_count,
        SUM(p.Score) AS total_score,
        AVG(p.Score) AS avg_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS median_score,
        COUNT(DISTINCT CASE WHEN p.AcceptedAnswerId = p2.Id THEN p2.Id END) AS accepted_answers,
        STRING_AGG(DISTINCT b.Name, ', ' ORDER BY b.Class, b.Name) AS tag_badges,
        DENSE_RANK() OVER (PARTITION BY t.TagName ORDER BY SUM(p.Score) DESC) AS tag_rank
    FROM Users u
    INNER JOIN Posts p ON p.OwnerUserId = u.Id
    INNER JOIN Posts q ON q.Id = p.ParentId
    INNER JOIN Tags t ON q.Tags LIKE '%' || '<' || t.TagName || '>' || '%' 
    LEFT JOIN Posts p2 ON p2.ParentId = q.Id AND p2.OwnerUserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id AND b.TagBased = CAST(1 AS BOOLEAN) AND LOWER(b.Name) = LOWER(t.TagName)
    WHERE p.PostTypeId = 2
      AND p.Score > 0
      AND t.Count > 500
      AND u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, t.TagName
    HAVING COUNT(DISTINCT p.Id) >= 10
),
temporal_patterns AS (
    SELECT 
        DATE_TRUNC('quarter', p.CreationDate) AS quarter,
        pt.Name AS post_type,
        COUNT(*) AS post_count,
        AVG(p.Score) AS avg_score,
        AVG(p.ViewCount) AS avg_views,
        AVG(p.AnswerCount) AS avg_answers,
        PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY p.Score) AS q1_score,
        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY p.Score) AS q3_score,
        COUNT(DISTINCT p.OwnerUserId) AS unique_contributors,
        (SUM(CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END) * 1.0) / NULLIF(COUNT(*), 0) AS close_rate,
        (SUM(CASE WHEN p.CommunityOwnedDate IS NOT NULL THEN 1 ELSE 0 END) * 1.0) / NULLIF(COUNT(*), 0) AS wiki_rate
    FROM Posts p
    INNER JOIN PostTypes pt ON pt.Id = p.PostTypeId
    WHERE p.CreationDate >= DATE_TRUNC('quarter', DATE '2024-10-01') - INTERVAL '5 years'
      AND p.PostTypeId IN (1, 2)
    GROUP BY DATE_TRUNC('quarter', p.CreationDate), pt.Name
),
vote_networks AS (
    SELECT 
        v1.UserId AS voter,
        p.OwnerUserId AS recipient,
        vt.Name AS vote_type,
        COUNT(*) AS vote_count,
        SUM(CASE WHEN v1.VoteTypeId = 2 THEN 1 ELSE -1 END) AS net_votes,
        MIN(v1.CreationDate) AS first_interaction,
        MAX(v1.CreationDate) AS last_interaction,
        EXTRACT(EPOCH FROM (MAX(v1.CreationDate) - MIN(v1.CreationDate))) / 86400 AS interaction_span_days
    FROM Votes v1
    INNER JOIN Posts p ON p.Id = v1.PostId
    INNER JOIN VoteTypes vt ON vt.Id = v1.VoteTypeId
    WHERE v1.UserId IS NOT NULL
      AND p.OwnerUserId IS NOT NULL
      AND v1.UserId <> p.OwnerUserId
      AND v1.VoteTypeId IN (2, 3)
    GROUP BY v1.UserId, p.OwnerUserId, vt.Name
    HAVING COUNT(*) >= 5
)
SELECT 
    th.tag_path[1] AS primary_tag,
    th.tag_path AS related_tags,
    ue.DisplayName AS expert_user,
    ue.tag_rank,
    ue.answers_count,
    ue.total_score,
    ue.avg_score,
    ue.median_score,
    ue.accepted_answers,
    ue.tag_badges,
    tp.quarter,
    tp.post_type,
    tp.post_count,
    tp.avg_score AS quarterly_avg_score,
    tp.avg_views,
    tp.avg_answers,
    tp.q1_score,
    tp.q3_score,
    tp.unique_contributors,
    tp.close_rate,
    tp.wiki_rate,
    vn.voter AS network_voter_id,
    vn.recipient AS network_recipient_id,
    vn.vote_count,
    vn.net_votes,
    vn.interaction_span_days,
    LAG(tp.post_count, 4) OVER (PARTITION BY tp.post_type ORDER BY tp.quarter) AS year_ago_count,
    ((tp.post_count - LAG(tp.post_count, 4) OVER (PARTITION BY tp.post_type ORDER BY tp.quarter)) * 1.0 /
      NULLIF(LAG(tp.post_count, 4) OVER (PARTITION BY tp.post_type ORDER BY tp.quarter), 0)) * 100 AS yoy_growth_rate,
    RANK() OVER (PARTITION BY th.tag_path[1] ORDER BY ue.total_score DESC) AS expert_rank_in_tag,
    DENSE_RANK() OVER (ORDER BY tp.post_count DESC) AS quarter_activity_rank
FROM tag_hierarchy th
CROSS JOIN user_expertise ue
CROSS JOIN temporal_patterns tp
LEFT JOIN vote_networks vn ON vn.voter = ue.UserId OR vn.recipient = ue.UserId
WHERE th.depth <= 2
  AND ue.TagName = th.tag_path[1]
  AND ue.tag_rank <= 10
  AND tp.quarter >= DATE_TRUNC('quarter', DATE '2024-10-01' - INTERVAL '2 years')
ORDER BY 
    th.tag_path[1],
    ue.tag_rank,
    tp.quarter DESC,
    vn.vote_count DESC
LIMIT 10000;