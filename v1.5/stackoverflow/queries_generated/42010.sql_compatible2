WITH RankedPosts AS (
    SELECT 
        p.Id, 
        p.PostTypeId, 
        p.CreationDate, 
        p.Score, 
        p.ViewCount, 
        u.Reputation AS UserReputation, 
        u.CreationDate AS UserCreationDate, 
        COUNT(v.Id) AS VoteCount, 
        COUNT(c.Id) AS CommentCount, 
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.CreationDate) AS PostRank
    FROM 
        Posts p
    JOIN 
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    LEFT JOIN 
        Comments c ON p.Id = c.PostId
    WHERE 
        p.PostTypeId IN (1, 2) AND 
        p.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year'
    GROUP BY 
        p.Id, u.Reputation, u.CreationDate
), 
TagStats AS (
    SELECT 
        t.TagName, 
        COUNT(p.Id) AS TagUsageCount, 
        SUM(p.Score) AS TotalTagScore
    FROM 
        Tags t
    JOIN 
        Posts p ON t.TagName = ANY(string_to_array(p.Tags, '<'))
    WHERE 
        p.PostTypeId = 1 AND 
        p.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year'
    GROUP BY 
        t.TagName
)
SELECT 
    rp.Id AS PostId, 
    rp.PostTypeId, 
    rp.CreationDate, 
    rp.Score, 
    rp.ViewCount, 
    rp.UserReputation, 
    rp.UserCreationDate, 
    rp.VoteCount, 
    rp.CommentCount, 
    rp.PostRank, 
    ts.TagName, 
    ts.TagUsageCount, 
    ts.TotalTagScore
FROM 
    RankedPosts rp
JOIN 
    LATERAL (
        SELECT 
            UNNEST(STRING_TO_ARRAY(rp.Tags, '<')) AS TagName
    ) AS t(TagName) ON true
JOIN 
    TagStats ts ON t.TagName = ts.TagName
WHERE 
    rp.PostRank <= 10
ORDER BY 
    rp.PostTypeId, 
    rp.Score DESC, 
    rp.CreationDate;