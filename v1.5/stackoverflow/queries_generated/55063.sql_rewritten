-- {"query": "55063.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2048, "output_tokens": 1543} 
WITH RECURSIVE
-- 1. Aggregate basic statistics per tag
tag_stats AS (
    SELECT
        t.Id                                   AS tag_id,
        t.TagName,
        COUNT(p.Id)                            AS question_count,
        SUM(p.Score)                           AS total_score,
        AVG(p.AnswerCount)::NUMERIC(10,2)      AS avg_answers,
        MAX(p.CreationDate)                    AS latest_question_date
    FROM Tags t
    JOIN Posts p
      ON p.PostTypeId = 1                         -- only questions
     AND p.Tags LIKE ('%<' || t.TagName || '>%')
    GROUP BY t.Id, t.TagName
),

-- 2. Find the top 3 answerers per tag (by answer count)
top_answerers AS (
    SELECT
        ts.tag_id,
        u.Id                                   AS user_id,
        u.DisplayName,
        COUNT(a.Id)                            AS answers_given,
        ROW_NUMBER() OVER (PARTITION BY ts.tag_id
                           ORDER BY COUNT(a.Id) DESC) AS rn
    FROM tag_stats ts
    JOIN Posts q
      ON q.PostTypeId = 1
     AND q.Tags LIKE ('%<' || (SELECT TagName FROM Tags WHERE Id = ts.tag_id) || '>%')
    JOIN Posts a
      ON a.PostTypeId = 2               -- answers
     AND a.ParentId = q.Id
    JOIN Users u
      ON u.Id = a.OwnerUserId
    GROUP BY ts.tag_id, u.Id, u.DisplayName
),

-- 3. Recent voting activity on the most recent question per tag
recent_votes AS (
    SELECT
        q.Id                                   AS question_id,
        ts.tag_id,
        COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS up_votes,
        COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS down_votes,
        MAX(v.CreationDate)                    AS last_vote_date
    FROM tag_stats ts
    JOIN LATERAL (
        SELECT *
        FROM Posts p
        WHERE p.PostTypeId = 1
          AND p.Tags LIKE ('%<' || (SELECT TagName FROM Tags WHERE Id = ts.tag_id) || '>%')
        ORDER BY p.CreationDate DESC
        LIMIT 1
    ) q ON true
    LEFT JOIN Votes v
      ON v.PostId = q.Id
    GROUP BY q.Id, ts.tag_id
),

-- 4. Build a JSON array of duplicate links for each tag's questions
duplicate_links AS (
    SELECT
        ts.tag_id,
        JSONB_AGG(
            JSONB_BUILD_OBJECT(
                'question_id', q.Id,
                'duplicate_of', pl.RelatedPostId,
                'link_created', pl.CreationDate
            )
        ) FILTER (WHERE pl.LinkTypeId = 3) AS duplicates_json
    FROM tag_stats ts
    JOIN Posts q
      ON q.PostTypeId = 1
     AND q.Tags LIKE ('%<' || (SELECT TagName FROM Tags WHERE Id = ts.tag_id) || '>%')
    LEFT JOIN PostLinks pl
      ON pl.PostId = q.Id
    GROUP BY ts.tag_id
)

SELECT
    ts.TagName,
    ts.question_count,
    ts.total_score,
    ts.avg_answers,
    ts.latest_question_date,
    ta.user_id                      AS top_answerer_id,
    ta.DisplayName                  AS top_answerer_name,
    ta.answers_given,
    rv.up_votes,
    rv.down_votes,
    rv.last_vote_date,
    dl.duplicates_json
FROM tag_stats ts
LEFT JOIN top_answerers ta
  ON ta.tag_id = ts.tag_id AND ta.rn = 1
LEFT JOIN recent_votes rv
  ON rv.tag_id = ts.tag_id
LEFT JOIN duplicate_links dl
  ON dl.tag_id = ts.tag_id
WHERE ts.question_count > 100                -- filter to “popular” tags
ORDER BY ts.question_count DESC
LIMIT 50;