WITH user_activity_metrics AS (
  SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.Location,
    COUNT(DISTINCT p.Id) as post_count,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as question_count,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as answer_count,
    AVG(p.Score) as avg_post_score,
    SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL AND p.PostTypeId = 2 THEN 1 ELSE 0 END) as accepted_answers,
    MAX(p.ViewCount) as max_views,
    COALESCE(STRING_AGG(DISTINCT SUBSTRING(b.Name, 1, 20), '|'), 'NO_BADGES') as badge_summary
  FROM Users u
  LEFT OUTER JOIN Posts p ON u.Id = p.OwnerUserId
  LEFT OUTER JOIN Badges b ON u.Id = b.UserId AND b.Class <= 2
  WHERE u.Reputation > 100 
    AND u.CreationDate >= DATE '2020-01-01'
    AND (u.Location IS NULL OR LENGTH(TRIM(u.Location)) > 0)
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
  HAVING COUNT(DISTINCT p.Id) > 5
),
tagged_questions AS (
  SELECT 
    p.Id as question_id,
    p.OwnerUserId,
    p.Score,
    p.AnswerCount,
    p.ViewCount,
    p.Title,
    CASE 
      WHEN p.Tags LIKE '%<sql>%' THEN 'SQL'
      WHEN p.Tags LIKE '%<python>%' THEN 'Python'
      WHEN p.Tags LIKE '%<javascript>%' THEN 'JavaScript'
      WHEN p.Tags LIKE '%<java>%' THEN 'Java'
      ELSE 'Other'
    END as primary_tag,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.ViewCount DESC NULLS LAST) as view_rank,
    DENSE_RANK() OVER (PARTITION BY EXTRACT(YEAR FROM p.CreationDate) ORDER BY p.Score DESC) as yearly_score_rank,
    LAG(p.Score, 1, 0) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_score,
    LEAD(p.CreationDate, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as next_post_date
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= DATE '2019-01-01'
    AND p.Score IS NOT NULL
    AND p.ClosedDate IS NULL
),
vote_aggregations AS (
  SELECT 
    v.PostId,
    COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) as upvote_count,
    COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) as downvote_count,
    COUNT(CASE WHEN v.VoteTypeId = 5 THEN 1 END) as favorite_count,
    MAX(CASE WHEN v.VoteTypeId = 8 THEN v.BountyAmount ELSE 0 END) as max_bounty,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY v.CreationDate) as median_vote_date
  FROM Votes v
  WHERE v.VoteTypeId IN (2, 3, 5, 8)
  GROUP BY v.PostId
)
SELECT 
  uam.DisplayName,
  COALESCE(NULLIF(uam.Location, ''), 'Unknown') as user_location,
  uam.Reputation,
  uam.post_count,
  uam.question_count,
  uam.answer_count,
  ROUND(CAST(uam.avg_post_score AS numeric), 2) as avg_score,
  tq.primary_tag,
  tq.Title as top_viewed_question,
  tq.ViewCount,
  tq.view_rank,
  tq.yearly_score_rank,
  COALESCE(va.upvote_count, 0) as upvotes,
  COALESCE(va.downvote_count, 0) as downvotes,
  COALESCE(va.favorite_count, 0) as favorites,
  CASE 
    WHEN va.max_bounty > 0 THEN CONCAT('Bounty: ', CAST(va.max_bounty AS text))
    ELSE 'No Bounty'
  END as bounty_info,
  (SELECT COUNT(*) 
   FROM Comments c 
   WHERE c.PostId = tq.question_id 
     AND c.Score > 0
     AND c.UserId IS NOT NULL) as high_quality_comments,
  (SELECT COUNT(DISTINCT pl.RelatedPostId)
   FROM PostLinks pl
   WHERE pl.PostId = tq.question_id
     AND pl.LinkTypeId = 1) as linked_posts,
  CASE
    WHEN tq.Score - tq.prev_score > 10 THEN 'Significant Improvement'
    WHEN tq.Score - tq.prev_score > 0 THEN 'Moderate Improvement'
    WHEN tq.Score = tq.prev_score THEN 'No Change'
    ELSE 'Decline'
  END as score_trend,
  EXTRACT(EPOCH FROM (COALESCE(tq.next_post_date, TIMESTAMP '2024-10-01 12:34:56') - TIMESTAMP '2024-10-01')) / 86400 as days_to_next_post,
  SUBSTRING(uam.badge_summary, 1, 50) as top_badges,
  EXISTS(
    SELECT 1 
    FROM PostHistory ph 
    WHERE ph.PostId = tq.question_id 
      AND ph.PostHistoryTypeId IN (4, 5, 6)
      AND ph.UserId != tq.OwnerUserId
  ) as has_community_edits
FROM user_activity_metrics uam
INNER JOIN tagged_questions tq ON uam.Id = tq.OwnerUserId
LEFT OUTER JOIN vote_aggregations va ON tq.question_id = va.PostId
WHERE tq.view_rank <= 3
  AND tq.yearly_score_rank <= 1000
  AND (tq.AnswerCount > 0 OR tq.ViewCount > 100)
  AND LENGTH(COALESCE(tq.Title, '')) BETWEEN 10 AND 200
  AND NOT EXISTS (
    SELECT 1 
    FROM Posts p2 
    WHERE p2.ParentId = tq.question_id 
      AND p2.Score < -5
  )
ORDER BY 
  uam.Reputation DESC,
  tq.ViewCount DESC NULLS LAST,
  va.upvote_count DESC
LIMIT 500;