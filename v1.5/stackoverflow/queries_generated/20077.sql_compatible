WITH UserMetrics AS (
    -- Calculate aggregated metrics for each user: post counts, badge counts, etc.
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        SUM(p.Score) FILTER (WHERE p.PostTypeId = 2) AS TotalAnswerScore,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        MAX(CASE WHEN p.Id = q.AcceptedAnswerId THEN p.CreationDate ELSE NULL END) AS LastAcceptedAnswerDate
    FROM
        Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts q ON p.Id = q.AcceptedAnswerId -- Join to find if an answer was accepted
    WHERE u.Reputation > 1000
    GROUP BY
        u.Id, u.DisplayName, u.Reputation, u.CreationDate
    HAVING
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) > SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END)
),
RankedPosts AS (
    -- For each user, rank their answers by score and find details about the questions they answered.
    SELECT
        p.OwnerUserId,
        p.Id AS AnswerId,
        p.Score AS AnswerScore,
        p.CreationDate AS AnswerDate,
        q.Id AS QuestionId,
        q.Title AS QuestionTitle,
        q.Tags AS QuestionTags,
        q.ViewCount AS QuestionViewCount,
        q.FavoriteCount AS QuestionFavoriteCount,
        -- Use window functions to rank answers and calculate running totals
        ROW_NUMBER() OVER(PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate ASC) AS AnswerRank,
        SUM(p.Score) OVER(PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CumulativeScore,
        LAG(p.Score, 1, 0) OVER(PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PreviousAnswerScore
    FROM
        Posts p
    INNER JOIN Posts q ON p.ParentId = q.Id
    WHERE
        p.PostTypeId = 2 -- Answers only
        AND p.OwnerUserId IS NOT NULL
        AND q.ClosedDate IS NULL
        AND q.DeletionDate IS NULL
)
-- Combine user metrics with their top-ranked posts to identify and analyze "power users" vs "niche experts"
SELECT
    'Power User' AS UserType,
    um.UserId,
    um.DisplayName,
    um.Reputation,
    rp.QuestionTitle,
    rp.AnswerScore,
    -- Complex calculation involving multiple fields and NULL handling
    (rp.AnswerScore * 1.0 / NULLIF(rp.QuestionViewCount, 0)) * (1 + um.GoldBadges * 0.1) AS WeightedImpactScore,
    -- String manipulation on tags
    '<' || (string_to_array(substring(rp.QuestionTags, 2, length(rp.QuestionTags)-2), '><'))[1] || '>' AS PrimaryTag,
    rp.CumulativeScore,
    EXTRACT(EPOCH FROM (rp.AnswerDate - um.UserCreationDate)) / 86400.0 AS DaysToTopAnswer,
    -- Correlated subquery to find the edit count of their top answer
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = rp.AnswerId AND ph.PostHistoryTypeId IN (5, 8)) AS AnswerEditCount
FROM
    UserMetrics um
JOIN
    RankedPosts rp ON um.UserId = rp.OwnerUserId
WHERE
    um.Reputation > 50000
    AND um.GoldBadges > 5
    AND rp.AnswerRank <= 3 -- Top 3 answers
    AND EXISTS ( -- Subquery to ensure the user is active in popular tags
        SELECT 1
        FROM Tags t
        WHERE rp.QuestionTags LIKE '%' || t.TagName || '%' AND t.Count > 10000
    )

UNION ALL

-- Find "Niche Experts": users with a very high-scoring answer but lower overall reputation
SELECT
    'Niche Expert' AS UserType,
    um.UserId,
    um.DisplayName,
    um.Reputation,
    rp.QuestionTitle,
    rp.AnswerScore,
    (rp.AnswerScore * 1.0 / NULLIF(rp.QuestionViewCount, 0)) * (1 + um.GoldBadges * 0.1) AS WeightedImpactScore,
    '<' || (string_to_array(substring(rp.QuestionTags, 2, length(rp.QuestionTags)-2), '><'))[1] || '>' AS PrimaryTag,
    rp.CumulativeScore,
    EXTRACT(EPOCH FROM (rp.AnswerDate - um.UserCreationDate)) / 86400.0 AS DaysToTopAnswer,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = rp.AnswerId) AS AnswerCommentCount
FROM
    UserMetrics um
JOIN
    RankedPosts rp ON um.UserId = rp.OwnerUserId
WHERE
    um.Reputation BETWEEN 2000 AND 20000
    AND rp.AnswerRank = 1 -- Only their single best answer
    AND rp.AnswerScore > 100 -- A very high score for their reputation level
    AND rp.AnswerScore > (um.TotalAnswerScore / 2.0) -- The single answer is more than half their total score
    AND um.LastAcceptedAnswerDate IS NOT NULL
ORDER BY
    UserType, WeightedImpactScore DESC, Reputation DESC
LIMIT 500;