WITH
-- recent active questions with tag arrays
question_base AS (
  SELECT p.Id, p.Title, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount,
         COALESCE(string_to_array(substr(p.Tags, 2, length(p.Tags)-2), '><'), ARRAY[]::varchar[]) AS tags,
         p.AnswerCount, p.FavoriteCount
  FROM Posts p
  JOIN PostTypes pt ON p.PostTypeId = pt.Id AND pt.Name = 'Question'
  WHERE p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
),
-- top answerers per question (by score then creation)
best_answers AS (
  SELECT a.ParentId AS QuestionId,
         a.Id AS AnswerId,
         a.OwnerUserId AS AnswerOwner,
         a.Score AS AnswerScore,
         a.CreationDate AS AnswerCreation,
         ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS rn
  FROM Posts a
  JOIN PostTypes apt ON a.PostTypeId = apt.Id AND apt.Name = 'Answer'
  WHERE a.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '3 years'
),
top_answers AS (
  SELECT QuestionId, AnswerId, AnswerOwner, AnswerScore, AnswerCreation
  FROM best_answers
  WHERE rn = 1
),
-- aggregate comment sentiment/workload per post (using simple length heuristics)
comment_agg AS (
  SELECT c.PostId,
         count(*) AS comment_count,
         avg(char_length(c.Text)) AS avg_comment_len,
         max(char_length(c.Text)) AS max_comment_len,
         sum(case when char_length(c.Text) < 80 then 1 else 0 end) AS short_comments
  FROM Comments c
  WHERE c.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
  GROUP BY c.PostId
),
-- user reputation and activity window
user_activity AS (
  SELECT u.Id, u.Reputation, u.CreationDate, u.LastAccessDate,
         CASE WHEN u.LastAccessDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days' THEN 1 ELSE 0 END AS active_30d,
         CASE WHEN u.Reputation >= 10000 THEN 'power' WHEN u.Reputation >= 2000 THEN 'established' WHEN u.Reputation >= 200 THEN 'regular' ELSE 'newbie' END AS tier
  FROM Users u
),
-- tag popularity snapshot (questions in last 2 years)
tag_pop AS (
  SELECT t.tag AS tagname,
         count(*) AS q_count,
         AVG(q.Score) AS avg_q_score,
         SUM(q.ViewCount) AS views
  FROM (
    SELECT q.Id, unnest(q.tags) AS tag, q.Score, q.ViewCount
    FROM question_base q
  ) t
  GROUP BY t.tag
),
-- linked-post network metrics (both directions) for recent posts
post_links_agg AS (
  SELECT pl.PostId,
         COUNT(*) FILTER (WHERE lt.Name = 'Linked') AS linked_out,
         COUNT(*) FILTER (WHERE lt.Name = 'Duplicate') AS dup_out,
         COUNT(DISTINCT pl.RelatedPostId) AS distinct_related,
         MIN(pl.CreationDate) AS first_linked
  FROM PostLinks pl
  JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
  WHERE pl.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '3 years'
  GROUP BY pl.PostId
),
-- votes summary last 2 years
vote_agg AS (
  SELECT v.PostId,
         SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS upvotes,
         SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS downvotes,
         SUM(CASE WHEN vt.Name = 'Favorite' THEN 1 ELSE 0 END) AS favorites,
         COUNT(*) AS total_votes
  FROM Votes v
  JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
  WHERE v.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
  GROUP BY v.PostId
),
-- recent edit churn from PostHistory
edit_churn AS (
  SELECT ph.PostId,
         COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4,5,6,7,8,9,24)) AS edits,
         MAX(ph.CreationDate) AS last_edit,
         MIN(ph.CreationDate) AS first_edit
  FROM PostHistory ph
  WHERE ph.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
  GROUP BY ph.PostId
)
-- final heavy query: combine everything, compute complex metrics, rank and window
SELECT
  q.Id AS question_id,
  q.Title,
  CAST(q.CreationDate AS DATE) AS asked_on,
  q.Score AS question_score,
  q.ViewCount,
  q.AnswerCount,
  q.FavoriteCount,
  array_to_string(q.tags, ',') AS tag_list,
  tp.q_count AS tag_popularity,
  tp.avg_q_score AS tag_avg_score,
  ta.AnswerId AS top_answer_id,
  ta.AnswerOwner AS top_answer_owner,
  ua.Reputation AS asker_reputation,
  ua.tier AS asker_tier,
  ua.active_30d AS asker_active_30d,
  ca.comment_count,
  ca.avg_comment_len,
  va.upvotes,
  va.downvotes,
  va.favorites,
  el.edits AS recent_edits,
  pla.linked_out,
  pla.distinct_related,
  -- derived composite engagement score (heavy computation with weights and nonlinear transforms)
  (
    -- base: weighted sum
    (COALESCE(q.Score,0) * 3.2) +
    (LN(1 + COALESCE(q.ViewCount,0)) * 1.5) +
    (COALESCE(q.AnswerCount,0) * 7.0) +
    (COALESCE(va.upvotes,0) * 2.8) -
    (COALESCE(va.downvotes,0) * 4.5) +
    (COALESCE(ca.comment_count,0) * 1.6) +
    (COALESCE(q.FavoriteCount,0) * 2.2) +
    (COALESCE(el.edits,0) * 1.1) +
    (COALESCE(pla.distinct_related,0) * 0.9)
  ) *
  -- multiplier bonus for active asker / top answer quality
  (1 +
    CASE WHEN ua.active_30d = 1 THEN 0.07 ELSE 0 END +
    CASE WHEN ta.AnswerScore >= 10 THEN 0.12 WHEN ta.AnswerScore >= 5 THEN 0.06 ELSE 0 END
  ) *
  -- decaying function by age (newer questions slightly boosted)
  (1 + EXP(-EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - q.CreationDate)) / (60*60*24*90)) * 0.18)
  AS engagement_score,
  -- density-style metrics for hotspots: ratio of upvotes to views, comments per answer
  (CASE WHEN q.ViewCount > 0 THEN (COALESCE(va.upvotes,0)::numeric / q.ViewCount) ELSE 0 END) AS upvote_per_view,
  (CASE WHEN q.AnswerCount > 0 THEN (COALESCE(ca.comment_count,0)::numeric / q.AnswerCount) ELSE COALESCE(ca.comment_count,0) END) AS comments_per_answer,
  -- windowed ranks to stress sorting and analytic functions
  RANK() OVER (PARTITION BY tp.tagname ORDER BY
    (
      (COALESCE(q.Score,0) * 3.2) +
      (LN(1 + COALESCE(q.ViewCount,0)) * 1.5) +
      (COALESCE(va.upvotes,0) * 2.8)
    ) DESC
  ) AS tag_rank,
  ROW_NUMBER() OVER (ORDER BY ( 
      (
        (COALESCE(q.Score,0) * 3.2) +
        (LN(1 + COALESCE(q.ViewCount,0)) * 1.5) +
        (COALESCE(va.upvotes,0) * 2.8)
      ) * (1 + CASE WHEN ua.active_30d = 1 THEN 0.05 ELSE 0 END)
    ) DESC
  ) AS global_row
FROM question_base q
LEFT JOIN top_answers ta ON ta.QuestionId = q.Id
LEFT JOIN user_activity ua ON ua.Id = q.OwnerUserId
LEFT JOIN comment_agg ca ON ca.PostId = q.Id
LEFT JOIN vote_agg va ON va.PostId = q.Id
LEFT JOIN edit_churn el ON el.PostId = q.Id
LEFT JOIN post_links_agg pla ON pla.PostId = q.Id
LEFT JOIN LATERAL (
  SELECT tp.tagname, tp.q_count
  FROM tag_pop tp
  WHERE tp.tagname = (SELECT unnest(q.tags) LIMIT 1)
  LIMIT 1
) tp ON true
WHERE q.Score IS NOT NULL
ORDER BY engagement_score DESC
LIMIT 250;