WITH
GoldUsers AS (
    SELECT DISTINCT UserId
    FROM Badges
    WHERE Class = 1
),
RecentQuestions AS (
    SELECT
        p.Id,
        p.Score,
        p.Tags,
        p.OwnerUserId
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.Score > 0
      AND p.CreationDate >= DATE_TRUNC('year', CAST('2024-10-01' AS DATE))
      AND p.OwnerUserId IN (SELECT UserId FROM GoldUsers)
),
QuestionTags AS (
    SELECT
        rq.Id,
        rq.OwnerUserId,
        rq.Score,
        t.tag
    FROM RecentQuestions rq
    CROSS JOIN LATERAL (
        SELECT tag
        FROM UNNEST(
            STRING_TO_ARRAY(
                SUBSTRING(rq.Tags FROM 2 FOR CHAR_LENGTH(rq.Tags) - 2),
                ' ><'
            )
        ) AS tag
    ) AS t
)
SELECT
    qt.tag,
    COUNT(DISTINCT qt.Id)            AS QuestionCount,
    AVG(qt.Score)                    AS AvgScore,
    COUNT(DISTINCT qt.OwnerUserId)   AS GoldUserCount,
    RANK() OVER (ORDER BY AVG(qt.Score) DESC, COUNT(DISTINCT qt.Id) DESC) AS Rank
FROM QuestionTags qt
GROUP BY qt.tag
ORDER BY Rank
FETCH FIRST 20 ROWS ONLY;