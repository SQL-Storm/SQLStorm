-- {"query": "37042.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-5-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 1985, "output_tokens": 1584} 
WITH
-- top contributors per tag: compute question stats and answer stats per user per tag
QuestionTags AS (
  SELECT p.Id AS QuestionId,
         u.Id AS UserId,
         u.DisplayName,
         regexp_split_to_table(substring(p.Tags,2,length(p.Tags)-2), '><') AS Tag
  FROM Posts p
  JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.PostTypeId = 1
),
Answers AS (
  SELECT a.Id AS AnswerId, a.ParentId AS QuestionId, a.OwnerUserId AS UserId, a.Score, a.CreationDate
  FROM Posts a
  WHERE a.PostTypeId = 2
),
TagUserAggregates AS (
  SELECT
    qt.Tag,
    qt.UserId,
    qt.DisplayName,
    COUNT(DISTINCT qt.QuestionId) AS QuestionsAsked,
    COUNT(DISTINCT CASE WHEN ans.AnswerId IS NOT NULL THEN ans.AnswerId END) FILTER (WHERE ans.UserId = qt.UserId) AS AnswersToOwnQuestions,
    COALESCE(SUM(ans2.Score),0) AS AnswerScoreOnTag,
    MAX(p.Score) FILTER (WHERE p.PostTypeId = 1) AS MaxQuestionScore,
    AVG(p.ViewCount) FILTER (WHERE p.PostTypeId = 1) AS AvgQuestionViews,
    MIN(p.CreationDate) AS FirstAsked,
    MAX(p.LastActivityDate) AS LastActivity
  FROM QuestionTags qt
  LEFT JOIN Posts p ON p.Id = qt.QuestionId
  LEFT JOIN Answers ans ON ans.QuestionId = qt.QuestionId AND ans.UserId = qt.UserId
  LEFT JOIN Posts ans2 ON ans2.Id = ans.AnswerId
  GROUP BY qt.Tag, qt.UserId, qt.DisplayName
),
-- compute tag trends: recent growth in questions and views
TagTrends AS (
  SELECT
    t.TagName AS Tag,
    t.Count AS TotalCount,
    COALESCE(recent.QuestionsLast30,0) AS QuestionsLast30,
    COALESCE(recent.ViewsLast30,0) AS ViewsLast30,
    COALESCE(recent.AvgScoreLast30,0) AS AvgScoreLast30
  FROM Tags t
  LEFT JOIN (
    SELECT
      regexp_split_to_table(substring(p.Tags,2,length(p.Tags)-2), '><') AS Tag,
      COUNT(*) FILTER (WHERE p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days') AS QuestionsLast30,
      SUM(p.ViewCount) FILTER (WHERE p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days') AS ViewsLast30,
      AVG(p.Score) FILTER (WHERE p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days') AS AvgScoreLast30
    FROM Posts p
    WHERE p.PostTypeId = 1
    GROUP BY Tag
  ) recent ON recent.Tag = t.TagName
),
-- detect unusually active users: many upvotes, badges, and answers recently
ActiveUserSignals AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 2 AND v.CreationDate >= cast('2024-10-01 12:34:56' as timestamp)-interval '90 days') AS UpVotesReceived90,
    COUNT(b.Id) FILTER (WHERE b.Date >= cast('2024-10-01 12:34:56' as timestamp)-interval '365 days') AS BadgesLastYear,
    COUNT(a.AnswerId) FILTER (WHERE a.CreationDate >= cast('2024-10-01 12:34:56' as timestamp)-interval '90 days') AS AnswersLast90,
    MAX(u.LastAccessDate) AS LastAccess
  FROM Users u
  LEFT JOIN Votes v ON v.UserId IS NULL AND v.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id) OR v.UserId = u.Id
    -- the above OR is to include votes by others on their posts or votes cast by user (implementation-dependent)
  LEFT JOIN Badges b ON b.UserId = u.Id
  LEFT JOIN Posts a ON a.OwnerUserId = u.Id AND a.PostTypeId = 2
  GROUP BY u.Id, u.DisplayName, u.Reputation
),
-- heavy post edits and closures: posts with many history events and links
PostActivityProfile AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.PostTypeId,
    p.OwnerUserId,
    p.Score,
    p.ViewCount,
    COUNT(ph.Id) AS RevisionCount,
    COUNT(pl.Id) FILTER (WHERE pl.LinkTypeId = 3) AS DuplicateLinksIn,
    COUNT(pl.Id) FILTER (WHERE pl.LinkTypeId = 1) AS LinkedOut,
    MAX(ph.CreationDate) AS LastRevisionDate,
    BOOL_OR(ph.PostHistoryTypeId IN (10,11,12,13,14,15,19,20,35)) AS HasModerationEvents
  FROM Posts p
  LEFT JOIN PostHistory ph ON ph.PostId = p.Id
  LEFT JOIN PostLinks pl ON pl.PostId = p.Id OR pl.RelatedPostId = p.Id
  GROUP BY p.Id, p.Title, p.Tags, p.PostTypeId, p.OwnerUserId, p.Score, p.ViewCount
),
-- combine everything: pick top tag experts, hottest tags, active users cross-referenced
Combined AS (
  SELECT
    tu.Tag,
    tu.UserId,
    tu.DisplayName AS UserDisplayName,
    tu.QuestionsAsked,
    tu.AnswersToOwnQuestions,
    tu.AnswerScoreOnTag,
    tt.TotalCount AS TagTotalQuestions,
    tt.QuestionsLast30,
    tt.ViewsLast30,
    aus.Reputation,
    aus.UpVotesReceived90,
    aus.BadgesLastYear,
    pap.PostId AS RepresentativePostId,
    pap.Score AS RepresentativePostScore,
    pap.ViewCount AS RepresentativeViewCount,
    ROW_NUMBER() OVER (PARTITION BY tu.Tag ORDER BY (tu.QuestionsAsked * 2 + tu.AnswerScoreOnTag + COALESCE(tt.QuestionsLast30,0)) DESC) AS RankInTag
  FROM TagUserAggregates tu
  LEFT JOIN TagTrends tt ON tt.Tag = tu.Tag
  LEFT JOIN ActiveUserSignals aus ON aus.UserId = tu.UserId
  LEFT JOIN LATERAL (
    SELECT p2.Id, p2.Score, p2.ViewCount
    FROM Posts p2
    WHERE p2.OwnerUserId = tu.UserId
      AND p2.PostTypeId = 1
      AND p2.Tags LIKE '%' || '<' || tu.Tag || '>' || '%'
    ORDER BY p2.Score DESC NULLS LAST, p2.ViewCount DESC NULLS LAST
    LIMIT 1
  ) pap ON true
)
SELECT
  c.Tag,
  c.RankInTag,
  c.UserId,
  c.UserDisplayName,
  c.QuestionsAsked,
  c.AnswersToOwnQuestions,
  c.AnswerScoreOnTag,
  c.TagTotalQuestions,
  c.QuestionsLast30,
  c.ViewsLast30,
  c.Reputation,
  c.UpVotesReceived90,
  c.BadgesLastYear,
  c.RepresentativePostId,
  c.RepresentativePostScore,
  c.RepresentativeViewCount
FROM Combined c
WHERE c.RankInTag <= 5
  AND (c.QuestionsAsked >= 3 OR c.AnswerScoreOnTag >= 10 OR c.QuestionsLast30 >= 2)
ORDER BY c.Tag, c.RankInTag;