WITH QuestionData AS (
    SELECT
        p.Id AS QuestionId,
        p.Title AS QuestionTitle,
        p.Score AS QuestionScore,
        p.ViewCount AS QuestionViewCount,
        p.AnswerCount AS QuestionAnswerCount,
        p.CommentCount AS QuestionCommentCount,
        p.FavoriteCount AS QuestionFavoriteCount,
        p.CreationDate AS QuestionCreationDate,
        u.DisplayName AS OwnerDisplayName,
        u.Reputation AS OwnerReputation,
        u.Views AS OwnerViews,
        u.UpVotes AS OwnerUpVotes,
        u.DownVotes AS OwnerDownVotes,
        (
            SELECT COUNT(*) FROM Badges WHERE UserId = u.Id AND Class = 1
        ) AS GoldBadges,
        (
            SELECT COUNT(*) FROM Badges WHERE UserId = u.Id AND Class = 2
        ) AS SilverBadges,
        (
            SELECT COUNT(*) FROM Badges WHERE UserId = u.Id AND Class = 3
        ) AS BronzeBadges,
        (
            SELECT SUM(Score)
            FROM Posts
            WHERE ParentId = p.Id AND PostTypeId = 2
        ) AS TotalAnswerScore,
        (
            SELECT COUNT(*)
            FROM Comments
            WHERE PostId = p.Id
        ) AS TotalComments
    FROM Posts p
    JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1 AND p.ClosedDate IS NULL AND p.CommunityOwnedDate IS NULL
),
AnswerData AS (
    SELECT
        p.ParentId AS QuestionId,
        COUNT(p.Id) AS AnswerCount,
        SUM(p.Score) AS TotalAnswerScore,
        AVG(p.Score) AS AverageAnswerScore,
        SUM(p.CommentCount) AS TotalAnswerComments,
        MAX(p.CreationDate) AS LastAnswerCreationDate
    FROM Posts p
    WHERE p.PostTypeId = 2
    GROUP BY p.ParentId
),
TagData AS (
    SELECT
        p.Id AS QuestionId,
        STRING_AGG(t.TagName, ',') AS Tags,
        COUNT(DISTINCT t.Id) AS DistinctTagCount
    FROM Posts p
    JOIN Tags t ON POSITION(t.TagName IN REPLACE(REPLACE(p.Tags, ' ', ''), ',', ',')) > 0
    WHERE p.PostTypeId = 1
    GROUP BY p.Id
),
UserActivity AS (
    SELECT
        ph.UserId,
        COUNT(ph.Id) AS PostHistoryCount,
        MAX(ph.CreationDate) AS LastPostHistoryDate
    FROM PostHistory ph
    WHERE ph.UserId IS NOT NULL
    GROUP BY ph.UserId
),
VoteDistribution AS (
    SELECT
        v.PostId,
        COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpVotes,
        COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownVotes,
        COUNT(CASE WHEN v.VoteTypeId = 8 THEN 1 END) AS BountyStartVotes,
        COUNT(CASE WHEN v.VoteTypeId = 10 THEN 1 END) AS DeletionVotes
    FROM Votes v
    WHERE v.VoteTypeId IN (2, 3, 8, 10)
    GROUP BY v.PostId
)
SELECT
    qd.QuestionId,
    qd.QuestionTitle,
    qd.QuestionScore,
    qd.QuestionViewCount,
    qd.QuestionAnswerCount,
    qd.QuestionCommentCount,
    qd.QuestionFavoriteCount,
    qd.QuestionCreationDate,
    qd.OwnerDisplayName,
    qd.OwnerReputation,
    qd.OwnerViews,
    qd.OwnerUpVotes,
    qd.OwnerDownVotes,
    qd.GoldBadges,
    qd.SilverBadges,
    qd.BronzeBadges,
    qd.TotalAnswerScore AS QuestionTotalAnswerScore,
    qd.TotalComments AS QuestionTotalComments,
    COALESCE(ad.AnswerCount, 0) AS ActualAnswerCount,
    COALESCE(ad.TotalAnswerScore, 0) AS ActualTotalAnswerScore,
    COALESCE(ad.AverageAnswerScore, 0.0) AS ActualAverageAnswerScore,
    COALESCE(ad.TotalAnswerComments, 0) AS ActualTotalAnswerComments,
    ad.LastAnswerCreationDate,
    td.Tags,
    td.DistinctTagCount,
    COALESCE(vd.UpVotes, 0) AS TotalUpVotes,
    COALESCE(vd.DownVotes, 0) AS TotalDownVotes,
    COALESCE(vd.BountyStartVotes, 0) AS TotalBountyStartVotes,
    COALESCE(vd.DeletionVotes, 0) AS TotalDeletionVotes,
    ua.PostHistoryCount AS OwnerPostHistoryCount,
    ua.LastPostHistoryDate AS OwnerLastPostHistoryDate,
    (qd.QuestionViewCount * 1000 + qd.QuestionScore * 500 + qd.QuestionAnswerCount * 100 + qd.QuestionFavoriteCount * 200 + qd.OwnerReputation) AS PerformanceMetric
FROM QuestionData qd
LEFT JOIN AnswerData ad ON qd.QuestionId = ad.QuestionId
LEFT JOIN TagData td ON qd.QuestionId = td.QuestionId
LEFT JOIN VoteDistribution vd ON qd.QuestionId = vd.PostId
LEFT JOIN UserActivity ua ON qd.OwnerViews = ua.UserId
ORDER BY PerformanceMetric DESC
LIMIT 1000;