SELECT
    p.PostTypeId,
    pt.Name AS PostTypeName,
    COUNT(*) AS TotalPosts,
    AVG(p.Score) AS AverageScore,
    SUM(p.ViewCount) AS TotalViews,
    COUNT(DISTINCT u.Id) AS UniqueAuthors,
    AVG(DATEDIFF(p.CreationDate, u.CreationDate)) AS AvgAuthorAgeAtPosting,
    COUNT(c.Id) AS TotalComments,
    AVG(c.Score) AS AvgCommentScore,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpVotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownVotes,
    COUNT(DISTINCT v.UserId) AS UniqueVoters,
    ARRAY_AGG(DISTINCT t.TagName) AS TopTags
FROM
    Posts p
JOIN
    PostTypes pt ON p.PostTypeId = pt.Id
LEFT JOIN
    Users u ON p.OwnerUserId = u.Id
LEFT JOIN
    Comments c ON c.PostId = p.Id
LEFT JOIN
    Votes v ON v.PostId = p.Id
LEFT JOIN
    (
        SELECT
            TRIM(tag) AS TagName,
            p2.Id AS PostId
        FROM
            Posts p2
        CROSS JOIN LATERAL (
            SELECT TRIM(x.value) AS tag
            FROM UNNEST(
                STRING_TO_ARRAY(REPLACE(REPLACE(p2.Tags, '<', ''), '>', ''), ',')
            ) AS x(value)
        ) AS tag_list
        GROUP BY p2.Id, TRIM(tag)
    ) AS t ON t.PostId = p.Id
GROUP BY
    p.PostTypeId, pt.Name
ORDER BY
    TotalPosts DESC
LIMIT 100;