WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.CreationDate AS UserJoinDate,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) AS TotalVotes,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        AVG(p.Score) OVER() AS AvgPostScore,
        RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId AND v.VoteTypeId IN (2, 3, 8)
    LEFT JOIN Badges b ON u.Id = b.UserId AND b.Date >= cast('2024-10-01' as date) - INTERVAL '1 year'
    WHERE u.Reputation > 1000
      AND u.CreationDate >= cast('2024-10-01' as date) - INTERVAL '5 years'
    GROUP BY u.Id, u.Reputation, u.CreationDate
)
SELECT 
    ua.UserId,
    ua.Reputation,
    ua.TotalPosts,
    ua.TotalComments,
    ua.TotalVotes,
    ua.GoldBadges,
    ph.PostHistoryCount,
    pl.DuplicateLinks,
    (SELECT AVG(AnswerCount) FROM Posts WHERE OwnerUserId = ua.UserId) AS AvgAnswersPerQuestion,
    ua.PostRank
FROM UserActivity ua
LEFT JOIN (
    SELECT 
        UserId,
        COUNT(DISTINCT Id) AS PostHistoryCount
    FROM PostHistory
    WHERE PostHistoryTypeId IN (2, 5, 10, 12)
    GROUP BY UserId
) ph ON ua.UserId = ph.UserId
LEFT JOIN (
    SELECT 
        PostId,
        COUNT(*) AS DuplicateLinks
    FROM PostLinks
    WHERE LinkTypeId = 3
    GROUP BY PostId
) pl ON pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = ua.UserId)
WHERE ua.GoldBadges >= 3
  AND ua.TotalPosts > (SELECT AVG(TotalPosts) FROM UserActivity)
ORDER BY 
    ua.Reputation DESC,
    ua.TotalPosts DESC,
    ph.PostHistoryCount DESC
LIMIT 100;