WITH RecentAnswers AS (
    SELECT 
        p.Id,
        p.ParentId,
        p.Score,
        p.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC) AS rn
    FROM Posts p
    WHERE p.PostTypeId = 2
      AND p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days')
),
TopAnswers AS (
    SELECT 
        ra.ParentId   AS QuestionId,
        ra.Id         AS AnswerId,
        ra.Score
    FROM RecentAnswers ra
    WHERE ra.rn <= 3
),
UserStats AS (
    SELECT 
        u.Id                         AS UserId,
        u.DisplayName,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id END) AS SilverBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id END) AS BronzeBadges,
        COALESCE(AVG(p.Score), 0)    AS AvgQuestionScore
    FROM Users u
    LEFT JOIN Badges b 
        ON b.UserId = u.Id
    LEFT JOIN Posts p 
        ON p.OwnerUserId = u.Id 
       AND p.PostTypeId   = 1
    GROUP BY u.Id, u.DisplayName
),
DuplicatedLinks AS (
    SELECT 
        pl.PostId,
        COUNT(DISTINCT pl.RelatedPostId) AS DupCount
    FROM PostLinks pl
    WHERE pl.LinkTypeId = 3
    GROUP BY pl.PostId
)
SELECT
    q.Id                                 AS QuestionId,
    q.Title,
    COALESCE(ta.AnswerId, -1)            AS TopAnswerId,
    COALESCE(ta.Score,   0)              AS TopAnswerScore,
    us.DisplayName 
      || COALESCE(' (' || CAST(us.UserId AS VARCHAR) || ')', '') AS Author,
    us.GoldBadges + us.SilverBadges + us.BronzeBadges AS TotalBadges,
    us.AvgQuestionScore,
    dl.DupCount,
    CASE
      WHEN q.ClosedDate IS NOT NULL THEN 'Closed'
      WHEN q.FavoriteCount > 100      THEN 'Popular'
      ELSE 'Active'
    END                                  AS QuestionStatus,
    REPLACE(
      SUBSTRING(q.Tags FROM 2 FOR CHAR_LENGTH(q.Tags) - 2),
      '><',
      ' , '
    )                                    AS TagList,
    EXISTS (
      SELECT 1
      FROM Votes v
      WHERE v.PostId      = q.Id
        AND v.VoteTypeId  = 2
        AND v.CreationDate > q.CreationDate + INTERVAL '1 day'
    )                                    AS FastUpvoted
FROM Posts q
LEFT JOIN TopAnswers ta 
    ON ta.QuestionId = q.Id
LEFT JOIN UserStats us 
    ON us.UserId     = q.OwnerUserId
LEFT JOIN DuplicatedLinks dl 
    ON dl.PostId     = q.Id
WHERE q.PostTypeId = 1
  AND q.Score >= COALESCE((
        SELECT AVG(p2.Score) * 1.5
        FROM Posts p2
        WHERE p2.PostTypeId = 1
          AND p2.CreationDate BETWEEN (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '90 days') AND TIMESTAMP '2024-10-01 12:34:56'
    ), 0)
  AND EXISTS (
      SELECT 1
      FROM Comments c
      WHERE c.PostId = q.Id
        AND c.Text ILIKE '(benchmark|performance)'
  )

UNION ALL

SELECT
    'TOTAL' AS QuestionId,
    NULL AS Title,
    NULL AS TopAnswerId,
    NULL AS TopAnswerScore,
    NULL AS Author,
    NULL AS TotalBadges,
    NULL AS AvgQuestionScore,
    NULL AS DupCount,
    NULL AS QuestionStatus,
    NULL AS TagList,
    NULL AS FastUpvoted
FROM Posts q2
RIGHT JOIN Votes v2 
    ON v2.PostId    = q2.Id
WHERE q2.PostTypeId = 1
  AND v2.VoteTypeId = 5
LIMIT 100;