WITH RECURSIVE TagHierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        CAST(t.TagName AS VARCHAR(1000)) AS TagPath,
        1 AS Level
    FROM Tags t
    WHERE t.Count > 10000
    
    UNION ALL
    
    SELECT 
        t2.Id,
        t2.TagName,
        t2.Count,
        CAST(th.TagPath || ' -> ' || t2.TagName AS VARCHAR(1000)),
        th.Level + 1
    FROM Tags t2
    INNER JOIN TagHierarchy th ON t2.Count < th.Count / 2
    WHERE th.Level < 3 AND t2.Count > 1000
),
UserExpertise AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        STRING_AGG(DISTINCT t.TagName, ', ' ORDER BY t.TagName) AS ExpertTags,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgScore,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS MedianScore,
        MAX(p.Score) AS MaxScore,
        COUNT(DISTINCT CASE WHEN p.Score > 100 THEN p.Id END) AS HighScorePosts,
        COUNT(DISTINCT CASE WHEN b.Name IS NOT NULL AND b.Class = 1 THEN b.Name END) AS GoldBadges,
        COUNT(DISTINCT CASE WHEN b.Name IS NOT NULL AND b.Class = 2 THEN b.Name END) AS SilverBadges,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS ActivityRank
    FROM Users u
    INNER JOIN Posts p ON u.Id = p.OwnerUserId
    INNER JOIN Posts q ON (p.PostTypeId = 2 AND p.ParentId = q.Id) OR (p.PostTypeId = 1 AND p.Id = q.Id)
    LEFT JOIN Badges b ON u.Id = b.UserId
    CROSS JOIN LATERAL (SELECT string_to_array(substring(q.Tags, 2, length(q.Tags) - 2), '><') AS tag_array) AS tag_array_sub
    CROSS JOIN LATERAL (SELECT UNNEST(tag_array_sub.tag_array) AS tag) AS t
    INNER JOIN Tags t ON t.TagName = t.tag
    WHERE p.Score > 0
        AND u.Reputation > 1000
        AND p.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '2 years'
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(DISTINCT p.Id) >= 10
),
PostEngagement AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        (COALESCE(p.ViewCount, 0) * 1.0) / NULLIF((EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - p.CreationDate)) / 86400), 0) AS ViewsPerDay,
        (COALESCE(p.Score, 0) * 1.0) / NULLIF(p.ViewCount, 0) AS ScorePerView,
        COUNT(DISTINCT v.UserId) FILTER (WHERE v.VoteTypeId = 2) AS Upvotes,
        COUNT(DISTINCT v.UserId) FILTER (WHERE v.VoteTypeId = 3) AS Downvotes,
        COUNT(DISTINCT ph.UserId) AS UniqueEditors,
        MAX(ph.CreationDate) AS LastEditDate,
        (EXTRACT(EPOCH FROM (COALESCE(p.ClosedDate, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) - p.CreationDate)) / 3600) AS HoursToClose,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 
                (EXTRACT(EPOCH FROM (a.CreationDate - p.CreationDate)) / 3600)
            ELSE NULL
        END AS HoursToAcceptedAnswer,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PrevPostScore,
        LEAD(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS NextPostScore
    FROM Posts p
    LEFT JOIN Posts a ON p.AcceptedAnswerId = a.Id
    LEFT JOIN Votes v ON p.Id = v.PostId
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (4, 5, 6)
    WHERE p.PostTypeId = 1
        AND p.Score > 5
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, 
             p.FavoriteCount, p.CreationDate, p.ClosedDate, p.AcceptedAnswerId, 
             a.CreationDate, p.OwnerUserId
),
NetworkAnalysis AS (
    SELECT 
        pl.PostId AS SourcePost,
        pl.RelatedPostId AS TargetPost,
        p1.OwnerUserId AS SourceUser,
        p2.OwnerUserId AS TargetUser,
        COUNT(*) OVER (PARTITION BY pl.PostId) AS OutDegree,
        COUNT(*) OVER (PARTITION BY pl.RelatedPostId) AS InDegree,
        CASE 
            WHEN p1.OwnerUserId = p2.OwnerUserId THEN 'Self'
            WHEN EXISTS (
                SELECT 1 FROM Posts p3 
                WHERE p3.OwnerUserId = p1.OwnerUserId 
                    AND p3.ParentId IN (SELECT Id FROM Posts WHERE OwnerUserId = p2.OwnerUserId)
            ) THEN 'Collaborator'
            ELSE 'Other'
        END AS RelationshipType
    FROM PostLinks pl
    INNER JOIN Posts p1 ON pl.PostId = p1.Id
    INNER JOIN Posts p2 ON pl.RelatedPostId = p2.Id
    WHERE pl.LinkTypeId IN (1, 3)
)
SELECT 
    ue.DisplayName,
    ue.Reputation,
    ue.ExpertTags,
    ue.TotalPosts,
    ue.TotalScore,
    ROUND(CAST(ue.AvgScore AS NUMERIC), 2) AS AvgScore,
    ue.MedianScore,
    ue.MaxScore,
    ue.HighScorePosts,
    ue.GoldBadges,
    ue.SilverBadges,
    ue.ReputationRank,
    ue.ActivityRank,
    COUNT(DISTINCT pe.PostId) AS EngagingPosts,
    ROUND(AVG(pe.ViewsPerDay)::NUMERIC, 2) AS AvgViewsPerDay,
    ROUND(AVG(pe.ScorePerView)::NUMERIC, 4) AS AvgScorePerView,
    ROUND(AVG(pe.HoursToAcceptedAnswer)::NUMERIC, 2) AS AvgHoursToAcceptedAnswer,
    COUNT(DISTINCT na.TargetPost) AS LinkedPosts,
    COUNT(DISTINCT na.TargetUser) FILTER (WHERE na.RelationshipType = 'Collaborator') AS Collaborators,
    STRING_AGG(DISTINCT th.TagPath, ' | ' ORDER BY th.TagPath) AS TagPaths,
    ROUND(
        (ue.TotalScore * 0.3 + 
         ue.HighScorePosts * 10 + 
         ue.GoldBadges * 100 + 
         ue.SilverBadges * 10 + 
         COUNT(DISTINCT pe.PostId) * 5 +
         (100.0 / NULLIF(ue.ReputationRank, 0)) * 50 +
         (100.0 / NULLIF(ue.ActivityRank, 0)) * 30)::NUMERIC, 2
    ) AS CompositeScore
FROM UserExpertise ue
LEFT JOIN PostEngagement pe ON pe.PostId IN (
    SELECT Id FROM Posts WHERE OwnerUserId = ue.UserId AND PostTypeId = 1
)
LEFT JOIN NetworkAnalysis na ON na.SourceUser = ue.UserId
LEFT JOIN TagHierarchy th ON th.TagName = ANY(STRING_TO_ARRAY(ue.ExpertTags, ', '))
WHERE ue.ReputationRank <= 100
GROUP BY 
    ue.UserId, ue.DisplayName, ue.Reputation, ue.ExpertTags, 
    ue.TotalPosts, ue.TotalScore, ue.AvgScore, ue.MedianScore,
    ue.MaxScore, ue.HighScorePosts, ue.GoldBadges, ue.SilverBadges,
    ue.ReputationRank, ue.ActivityRank
ORDER BY CompositeScore DESC, ue.Reputation DESC
LIMIT 50;