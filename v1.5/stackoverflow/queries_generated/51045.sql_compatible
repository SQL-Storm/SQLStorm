WITH 
  active_users AS (
    SELECT u.Id, u.Reputation, u.CreationDate
    FROM Users u
    WHERE u.Reputation > 1000 
      AND u.LastAccessDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
  ),
  popular_tags AS (
    SELECT t.Id, t.TagName, t.Count
    FROM Tags t
    WHERE t.Count > 500
  ),
  question_stats AS (
    SELECT 
      p.Id AS question_id,
      p.OwnerUserId,
      p.Score,
      p.ViewCount,
      p.AnswerCount,
      p.FavoriteCount,
      p.CreationDate,
      p.Tags,
      COUNT(DISTINCT v.Id) AS total_votes,
      COUNT(DISTINCT CASE WHEN v.VoteTypeId IN (2) THEN 1 END) AS upvotes,
      COUNT(DISTINCT CASE WHEN v.VoteTypeId IN (3) THEN 1 END) AS downvotes,
      AVG(p2.Score) AS avg_answer_score
    FROM Posts p
    LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId IN (2, 3)
    LEFT JOIN Posts p2 ON p2.ParentId = p.Id AND p2.PostTypeId = 2
    WHERE p.PostTypeId = 1 
      AND p.ClosedDate IS NULL
      AND p.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months'
    GROUP BY p.Id, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount, p.FavoriteCount, p.CreationDate, p.Tags
    HAVING COUNT(DISTINCT p2.Id) > 1
  ),
  tag_usage AS (
    SELECT 
      qs.question_id,
      STRING_AGG(pt.TagName, ', ') AS tag_list,
      COUNT(pt.TagName) AS tag_count
    FROM question_stats qs
    CROSS JOIN LATERAL (
      SELECT TRIM(BOTH '\"' FROM SPLIT_PART(SPLIT_PART(qs.Tags, '><', generate_series(1, LENGTH(qs.Tags) - 2) / 3 + 1), '<', 1)) AS tag_name
      FROM generate_series(1, 20) s
      WHERE SPLIT_PART(qs.Tags, '><', s) <> ''
    ) tags
    INNER JOIN popular_tags pt ON pt.TagName = tags.tag_name
    GROUP BY qs.question_id
    HAVING COUNT(pt.TagName) >= 2
  ),
  user_activity AS (
    SELECT 
      au.Id AS user_id,
      au.Reputation,
      COUNT(DISTINCT qs.question_id) AS question_count,
      SUM(qs.total_votes) AS total_votes_received,
      SUM(qs.upvotes - qs.downvotes) AS net_votes,
      AVG(qs.avg_answer_score) AS avg_answer_quality,
      COUNT(DISTINCT b.Id) AS badge_count
    FROM active_users au
    LEFT JOIN question_stats qs ON qs.OwnerUserId = au.Id
    LEFT JOIN Badges b ON b.UserId = au.Id AND b.Date > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months'
    GROUP BY au.Id, au.Reputation
    HAVING COUNT(DISTINCT qs.question_id) > 0
  )
SELECT 
  ua.user_id,
  u.DisplayName,
  ua.Reputation,
  ua.question_count,
  tu.tag_list,
  qs.Score AS best_question_score,
  qs.ViewCount AS max_views,
  ROUND(COALESCE(ua.net_votes, 0) / NULLIF(ua.question_count, 0), 2) AS avg_votes_per_question,
  ROUND(COALESCE(ua.avg_answer_quality, 0), 2) AS avg_answer_quality,
  ua.badge_count,
  (
    SELECT JSON_AGG(
      json_build_object(
        'post_id', pl.RelatedPostId,
        'link_type', lt.Name,
        'creation_date', pl.CreationDate
      )
    )
    FROM PostLinks pl
    INNER JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    WHERE pl.PostId = qs.question_id
      AND pl.LinkTypeId IN (1, 3)
  ) AS linked_posts
FROM user_activity ua
INNER JOIN Users u ON u.Id = ua.user_id
INNER JOIN question_stats qs ON qs.OwnerUserId = ua.user_id 
  AND qs.Score = (
    SELECT MAX(qs2.Score) 
    FROM question_stats qs2 
    WHERE qs2.OwnerUserId = ua.user_id
  )
LEFT JOIN tag_usage tu ON tu.question_id = qs.question_id
WHERE ua.question_count >= 3
  AND ua.net_votes > 10
  AND ua.avg_answer_quality > 2.5
ORDER BY ua.net_votes DESC, ua.question_count DESC, ua.Reputation DESC
LIMIT 100;