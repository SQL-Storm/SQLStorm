    END as ActivityIndex,
    (ROW_NUMBER() OVER (ORDER BY uas.Reputation DESC) - 
     ROW_NUMBER() OVER (ORDER BY (uas.Answers + uas.Questions + uas.Comments) DESC)) as ReputationRankDiff,
    CASE 
        WHEN uas.LastPostDate IS NOT NULL THEN CAST(DATE_PART('day', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uas.LastPostDate) AS INT)
        ELSE NULL 
    END as DaysSinceLastPost,
    CASE 
        WHEN uas.LastCommentDate IS NOT NULL THEN CAST(DATE_PART('day', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uas.LastCommentDate) AS INT)
        ELSE NULL 
    END as DaysSinceLastComment,
    CASE 
        WHEN uas.LastCommentDate IS NOT NULL AND uas.LastPostDate IS NOT NULL THEN 
            CAST(DATE_PART('day', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - GREATEST(uas.LastCommentDate, uas.LastPostDate)) AS INT)
        ELSE NULL 
    END as DaysSinceLastActivity,
    (SELECT COUNT(DISTINCT UserId) FROM Votes v WHERE v.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = uas.UserId)) as UniqueVoters,
    (SELECT COUNT(DISTINCT UserId) FROM Comments c WHERE c.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = uas.UserId)) as UniqueCommenters
FROM UserActivityStats uas
LEFT JOIN UserEngagement ue ON uas.UserId = ue.UserId
LEFT JOIN PostComplexityMetrics pcm ON uas.UserId = pcm.OwnerUserId
WHERE uas.Reputation > 100
  AND (uas.TotalPosts > 0 OR uas.Comments > 0 OR uas.Badges > 0)
GROUP BY 
    uas.UserId, uas.DisplayName, uas.Reputation, uas.Views, uas.UpVotes, uas.DownVotes, uas.TotalPosts, 
    uas.Questions, uas.Answers, uas.Comments, uas.Badges, uas.ReputationRank, uas.ActivityRank,
    ue.UpvotesReceived, ue.DownvotesReceived, ue.Favorites, ue.TotalVotes
HAVING 
    uas.TotalPosts + uas.Answers + uas.Comments > 0
    OR uas.Badges > 0
EXCEPT
SELECT 
    uas.UserId,
    uas.DisplayName,
    uas.Reputation,
    uas.Views,
    uas.UpVotes,
    uas.DownVotes,
    uas.TotalPosts,
    uas.Questions,
    uas.Answers,
    uas.Comments,
    uas.Badges,
    uas.ReputationRank,
    uas.ActivityRank,
    COALESCE(ue.UpvotesReceived, 0) as UpvotesReceived,
    COALESCE(ue.DownvotesReceived, 0) as DownvotesReceived,
    COALESCE(ue.Favorites, 0) as Favorites,
    COALESCE(ue.TotalVotes, 0) as TotalVotes,
    CASE 
        WHEN uas.Questions > 0 THEN (COALESCE(ue.UpvotesReceived, 0) * 1.0 / uas.Questions)
        ELSE 0 
    END as UpvotesPerQuestion,
    CASE 
        WHEN uas.Answers > 0 THEN (COALESCE(ue.DownvotesReceived, 0) * 1.0 / uas.Answers)
        ELSE 0 
    END as DownvotesPerAnswer,
    CASE 
        WHEN uas.TotalPosts > 0 THEN (CAST(uas.Answers AS DECIMAL(10,2)) / CAST(uas.TotalPosts AS DECIMAL(10,2))) * 100
        ELSE 0 
    END as AnswerPercentage,
    CASE 
        WHEN (uas.Questions + uas.Answers) > 0 THEN (CAST(uas.Comments AS DECIMAL(10,2)) / CAST((uas.Questions + uas.Answers) AS DECIMAL(10,2))) * 100
        ELSE 0 
    END as CommentsPerPost,
    MAX(CASE WHEN pcm.PostTypeId = 1 THEN pcm.Score END) as MaxQuestionScore,
    MAX(CASE WHEN pcm.PostTypeId = 2 THEN pcm.Score END) as MaxAnswerScore,
    AVG(CASE WHEN pcm.PostTypeId = 1 THEN pcm.Score END) as AvgQuestionScore,
    AVG(CASE WHEN pcm.PostTypeId = 2 THEN pcm.Score END) as AvgAnswerScore,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 1 AND p.Score > 100) as HighScoreQuestions,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 2 AND p.Score > 100) as HighScoreAnswers,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 1 AND p.HasAcceptedAnswer = 1) as QuestionsWithAcceptedAnswer,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 2 AND p.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 2)) as AboveAvgAnswers,
    (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 1) as AvgQuestionScoreUser,
    (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 2) as AvgAnswerScoreUser,
    (SELECT COUNT(DISTINCT ParentId) FROM Posts WHERE OwnerUserId = uas.UserId AND PostTypeId = 2) as QuestionsAnswered,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = uas.UserId AND b.Class = 1) as GoldBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = uas.UserId AND b.Class = 2) as SilverBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = uas.UserId AND b.Class = 3) as BronzeBadges,
    (SELECT COUNT(DISTINCT PostId) FROM Votes v WHERE v.UserId = uas.UserId AND v.VoteTypeId = 4) as OffensiveVotes,
    (SELECT COUNT(DISTINCT PostId) FROM Votes v WHERE v.UserId = uas.UserId AND v.VoteTypeId = 10) as DeletionVotes,
    (SELECT COUNT(DISTINCT PostId) FROM Votes v WHERE v.UserId = uas.UserId AND v.VoteTypeId = 11) as UndeletionVotes,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.UserId = uas.UserId AND ph.PostHistoryTypeId IN (10,11,12,13)) as ClosureActivity,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = uas.UserId)) as LinkedPosts,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.UserId = uas.UserId AND ph.PostHistoryTypeId IN (2,5,6)) as EditActivity,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.LastEditDate IS NOT NULL) as EditedPosts,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.Tags IS NOT NULL AND LENGTH(p.Tags) > 0) as TaggedPosts,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.UserId = uas.UserId AND ph.PostHistoryTypeId IN (16,17,18,19,20)) as ModerationActivity,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.ViewCount > 1000) as HighViewCountPosts,
    (SELECT STRING_AGG(p.Title, ', ') FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 1) as RecentQuestions,
    (SELECT STRING_AGG(p.Title, ', ') FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 2) as RecentAnswers,
    CASE 
        WHEN uas.Questions > 0 AND uas.Answers > 0 THEN 
            (CAST(uas.Answers AS DECIMAL(10,2)) / CAST(uas.Questions AS DECIMAL(10,2))) * 100
        ELSE 0 
    END as QAToQuestionRatio,
    CASE 
        WHEN (uas.Questions + uas.Answers + uas.Comments) > 0 THEN 
            (uas.Reputation + uas.UpVotes + uas.DownVotes + uas.Views + uas.Badges * 10) / 
            CAST((uas.Questions + uas.Answers + uas.Comments) AS DECIMAL(10,2))
        ELSE 0 
    END as ActivityIndex,
    (ROW_NUMBER() OVER (ORDER BY uas.Reputation DESC) - 
     ROW_NUMBER() OVER (ORDER BY (uas.Answers + uas.Questions + uas.Comments) DESC)) as ReputationRankDiff,
    CASE 
        WHEN uas.LastPostDate IS NOT NULL THEN CAST(DATE_PART('day', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uas.LastPostDate) AS INT)
        ELSE NULL 
    END as DaysSinceLastPost,
    CASE 
        WHEN uas.LastCommentDate IS NOT NULL THEN CAST(DATE_PART('day', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uas.LastCommentDate) AS INT)
        ELSE NULL 
    END as DaysSinceLastComment,
    CASE 
        WHEN uas.LastCommentDate IS NOT NULL AND uas.LastPostDate IS NOT NULL THEN 
            CAST(DATE_PART('day', CAST('2024-10-01 12:34:56' AS TIMESTAMP) - GREATEST(uas.LastCommentDate, uas.LastPostDate)) AS INT)
        ELSE NULL 
    END as DaysSinceLastActivity,
    (SELECT COUNT(DISTINCT UserId) FROM Votes v WHERE v.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = uas.UserId)) as UniqueVoters,
    (SELECT COUNT(DISTINCT UserId) FROM Comments c WHERE c.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = uas.UserId)) as UniqueCommenters
FROM UserActivityStats uas
LEFT JOIN UserEngagement ue ON uas.UserId = ue.UserId
LEFT JOIN PostComplexityMetrics pcm ON uas.UserId = pcm.OwnerUserId
WHERE uas.Reputation > 50000
  AND (uas.TotalPosts > 0 OR uas.Comments > 0 OR uas.Badges > 0)
GROUP BY 
    uas.UserId, uas.DisplayName, uas.Reputation, uas.Views, uas.UpVotes, uas.DownVotes, uas.TotalPosts, 
    uas.Questions, uas.Answers, uas.Comments, uas.Badges, uas.ReputationRank, uas.ActivityRank,
    ue.UpvotesReceived, ue.DownvotesReceived, ue.Favorites, ue.TotalVotes
HAVING 
    uas.TotalPosts + uas.Answers + uas.Comments > 0
    OR uas.Badges > 0
ORDER BY uas.Reputation DESC, uas.TotalPosts DESC
LIMIT 1000;