SELECT 
    CASE WHEN p.PostTypeId = 1 THEN p.Title 
         ELSE (SELECT p2.Title 
               FROM Posts p2 
               WHERE p2.Id = p.ParentId) 
    END AS PostTitle,
    COALESCE(u.DisplayName, 'Community') AS DisplayName,
    CAST(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT) AS DaysSinceCreation,
    CAST(p.Score AS FLOAT) / NULLIF(CAST(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 0) AS ScorePerDay,
    CASE WHEN p.ClosedDate IS NOT NULL THEN 'Closed' 
         WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
         ELSE 'Open' 
    END AS PostStatus,
    COALESCE(NULLIF(ROUND(CAST(p.ViewCount AS FLOAT) / NULLIF(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS ViewsPerDay,
    COALESCE(NULLIF(ROUND(CAST(p.AnswerCount AS FLOAT) / NULLIF(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS AnswersPerDay,
    COALESCE(NULLIF(ROUND(CAST(p.CommentCount AS FLOAT) / NULLIF(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS CommentsPerDay,
    COALESCE(NULLIF(ROUND(CAST(p.FavoriteCount AS FLOAT) / NULLIF(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS FavoritesPerDay,
    COALESCE(NULLIF(ROUND(CAST(u.Reputation AS FLOAT) / NULLIF(DATEDIFF('day', u.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS ReputationPerDay,
    COALESCE(ROUND(CAST(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS FLOAT) / NULLIF(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS UpvotesPerDay,
    COALESCE(ROUND(CAST(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS FLOAT) / NULLIF(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS DownvotesPerDay,
    COALESCE(ROUND(CAST(SUM(CASE WHEN v.VoteTypeId = 1 THEN 1 ELSE 0 END) AS FLOAT) / NULLIF(DATEDIFF('day', p.CreationDate, TIMESTAMP '1970-01-01 00:00:00' + (TIMESTAMP '2024-10-01 12:34:56' - TIMESTAMP '1970-01-01')) AS BIGINT), 2), 0), 0) AS AcceptedAnswersPerDay,
    REPLACE(REPLACE(p.Tags, '><', ','), '<', '') AS Tags
FROM Posts p
LEFT JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Votes v ON p.Id = v.PostId
GROUP BY p.Id, p.PostTypeId, p.Title, p.CreationDate, p.ClosedDate, p.CommunityOwnedDate, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount, u.Id, u.DisplayName, u.CreationDate, u.Reputation
ORDER BY ScorePerDay DESC
FETCH FIRST 100 ROWS ONLY;