WITH RankedAnswers AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.OwnerUserId,
        a.Score,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank
    FROM Posts a
    WHERE a.PostTypeId = 2 -- Answers
),
TopAnswersWithBadges AS (
    SELECT
        ra.AnswerId,
        ra.QuestionId,
        ra.OwnerUserId,
        ra.Score,
        b.Name AS BadgeName,
        b.Class AS BadgeClass,
        b.Date AS BadgeDate
    FROM RankedAnswers ra
    LEFT JOIN Badges b ON ra.OwnerUserId = b.UserId
    WHERE ra.AnswerRank = 1
),
QuestionWithAnswerStats AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId AS QuestionOwnerId,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.CreationDate AS QuestionCreationDate,
        q.Tags,
        COALESCE(COUNT(a.Id), 0) AS TotalAnswers,
        COALESCE(SUM(a.Score), 0) AS TotalAnswerScore
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1
    GROUP BY q.Id, q.Title, q.OwnerUserId, q.Score, q.ViewCount, q.CreationDate, q.Tags
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS PostsCount,
        COUNT(DISTINCT c.Id) AS CommentsCount,
        COUNT(DISTINCT ph.Id) AS PostEditsCount,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS TotalUpVotes,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS TotalDownVotes
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN PostHistory ph ON ph.UserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
TagUsage AS (
    SELECT
        unnest(string_to_array(substring(q.Tags, 2, length(q.Tags) - 2), '><')) AS Tag,
        COUNT(q.Id) AS QuestionsCount,
        AVG(q.Score) AS AvgQuestionScore,
        SUM(q.ViewCount) AS TotalViews
    FROM Posts q
    WHERE q.PostTypeId = 1 AND q.Tags IS NOT NULL AND q.Tags <> ''
    GROUP BY Tag
),
TopTagUsers AS (
    SELECT
        bu.UserId,
        bu.Name AS BadgeName,
        COUNT(*) AS BadgeCount,
        t.TagName
    FROM Badges bu
    JOIN Tags t ON bu.Name = t.TagName
    GROUP BY bu.UserId, bu.Name, t.TagName
    ORDER BY BadgeCount DESC
    LIMIT 100
)
SELECT
    q.QuestionId,
    q.Title,
    q.QuestionOwnerId,
    ua.DisplayName AS QuestionOwnerName,
    q.QuestionScore,
    q.ViewCount,
    q.TotalAnswers,
    q.TotalAnswerScore,
    ta.AnswerId AS TopAnswerId,
    ta.Score AS TopAnswerScore,
    ta.BadgeName AS TopAnswererBadge,
    ta.BadgeClass AS TopAnswererBadgeClass,
    ua.PostsCount AS OwnerPostsCount,
    ua.CommentsCount AS OwnerCommentsCount,
    ua.PostEditsCount AS OwnerEditsCount,
    tu.Tag AS QuestionTag,
    tu.QuestionsCount AS TagQuestionsCount,
    tu.AvgQuestionScore AS TagAvgScore,
    tu.TotalViews AS TagTotalViews
FROM QuestionWithAnswerStats q
LEFT JOIN TopAnswersWithBadges ta ON q.QuestionId = ta.QuestionId
LEFT JOIN UserActivity ua ON q.QuestionOwnerId = ua.UserId
LEFT JOIN TagUsage tu ON tu.Tag = (SELECT unnest(string_to_array(substring(q.Tags, 2, length(q.Tags) - 2), '><')) LIMIT 1)
WHERE q.ViewCount > 1000 AND q.TotalAnswers >= 5 AND q.QuestionScore > 0
ORDER BY q.ViewCount DESC, q.QuestionScore DESC
LIMIT 50;