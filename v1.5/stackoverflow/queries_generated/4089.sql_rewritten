-- {"query": "4089.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1628} 
WITH RecursivePostsHierarchy AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.ParentId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        COALESCE(u.DisplayName, 'Unknown') AS OwnerName,
        p.Title,
        1 AS Depth
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1  -- questions only top level
    UNION ALL
    SELECT 
        c.Id,
        c.PostTypeId,
        c.ParentId,
        c.CreationDate,
        c.Score,
        c.ViewCount,
        c.Tags,
        COALESCE(u.DisplayName, 'Unknown'),
        c.Title,
        r.Depth + 1
    FROM Posts c
    JOIN RecursivePostsHierarchy r ON c.ParentId = r.Id
    LEFT JOIN Users u ON c.OwnerUserId = u.Id
    WHERE c.PostTypeId = 2 -- answers only in hierarchy
),
LatestUserActivity AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        u.Location,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY u.LastAccessDate DESC) AS rn
    FROM Users u
),
PostCommentsCount AS (
    SELECT 
        c.PostId,
        COUNT(*) AS TotalComments,
        SUM(CASE WHEN c.UserId IS NULL THEN 1 ELSE 0 END) AS AnonymousCommentsCount
    FROM Comments c
    GROUP BY c.PostId
),
PostVotesSummary AS (
    SELECT 
        v.PostId,
        SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes,
        SUM(CASE WHEN vt.Name = 'Favorite' THEN 1 ELSE 0 END) AS FavoriteVotes
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    GROUP BY v.PostId
),
CloseReasonsApplied AS (
    SELECT 
        ph.PostId,
        STRING_AGG(DISTINCT crt.Name, ', ') AS CloseReasons,
        MAX(ph.CreationDate) AS LastCloseDate
    FROM PostHistory ph
    JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
    LEFT JOIN CloseReasonTypes crt ON ph.Comment::int = crt.Id
    WHERE ph.PostHistoryTypeId = 10 -- Post Closed
    GROUP BY ph.PostId
),
UserBadgesRanked AS (
    SELECT 
        b.UserId,
        b.Name,
        b.Class,
        ROW_NUMBER() OVER (PARTITION BY b.UserId ORDER BY b.Date DESC) AS rn
    FROM Badges b
),
TopUserBadges AS (
    SELECT DISTINCT ON (ub.UserId)
        ub.UserId,
        STRING_AGG(ub.Name || ' (' || 
            CASE ub.Class 
                WHEN 1 THEN 'Gold'
                WHEN 2 THEN 'Silver'
                WHEN 3 THEN 'Bronze'
                ELSE 'Unknown'
            END || ')', ', ') AS Badges
    FROM UserBadgesRanked ub
    WHERE ub.rn <= 5
    GROUP BY ub.UserId
),
PostWithStats AS (
    SELECT 
        rp.Id AS PostId,
        rp.PostTypeId,
        rp.ParentId,
        rp.CreationDate,
        rp.Score,
        rp.ViewCount,
        rp.Tags,
        rp.OwnerName,
        rp.Title,
        rp.Depth,
        COALESCE(pcs.TotalComments,0) AS CommentCount,
        COALESCE(pcs.AnonymousCommentsCount,0) AS AnonymousCommentsCount,
        COALESCE(pvs.UpVotes,0) AS UpVotes,
        COALESCE(pvs.DownVotes,0) AS DownVotes,
        COALESCE(pvs.FavoriteVotes,0) AS FavoriteVotes,
        COALESCE(cr.CloseReasons, 'None') AS CloseReasons,
        TO_CHAR(rp.CreationDate, 'YYYY-MM-DD') AS PostDate,
        TO_CHAR(ph.LastCloseDate, 'YYYY-MM-DD HH24:MI') AS LastCloseTimestamp
    FROM RecursivePostsHierarchy rp
    LEFT JOIN PostCommentsCount pcs ON rp.Id = pcs.PostId
    LEFT JOIN PostVotesSummary pvs ON rp.Id = pvs.PostId
    LEFT JOIN CloseReasonsApplied cr ON rp.Id = cr.PostId
    LEFT JOIN CloseReasonsApplied ph ON rp.Id = ph.PostId
),
UserPerformanceWindow AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        ub.Badges,
        ROW_NUMBER() OVER (
            ORDER BY u.Reputation DESC, u.Views DESC, (COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0)) DESC
        ) AS RankByReputation
    FROM Users u
    LEFT JOIN TopUserBadges ub ON u.Id = ub.UserId
    WHERE u.Reputation > 1000 AND u.CreationDate < cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
)
SELECT
    pws.PostId,
    pws.PostTypeId,
    CASE pws.PostTypeId WHEN 1 THEN 'Question' WHEN 2 THEN 'Answer' ELSE 'Other' END AS PostType,
    pws.Depth,
    pws.Title,
    pws.OwnerName,
    pws.CreationDate,
    pws.Score,
    pws.ViewCount,
    pws.CommentCount,
    pws.AnonymousCommentsCount,
    pws.UpVotes,
    pws.DownVotes,
    pws.FavoriteVotes,
    pws.CloseReasons,
    pws.PostDate,
    pws.LastCloseTimestamp,
    upw.DisplayName AS UserDisplayName,
    upw.Reputation AS UserReputation,
    upw.Views AS UserViews,
    upw.UpVotes AS UserUpVotes,
    upw.DownVotes AS UserDownVotes,
    upw.Badges AS UserBadges,
    upw.RankByReputation,
    /* Complex Expression: Engagement Score with weighting and null-safe coalesce */
    (pws.ViewCount * 0.1 + pws.Score * 2 + (pws.UpVotes - pws.DownVotes) * 5 + pws.FavoriteVotes * 10
     - pws.AnonymousCommentsCount * 1.5 + COALESCE(upw.Reputation,0)/1000.0) AS EngagementScore,
    /* String Manipulation: Extract 3 tags or 'NoTags' */
    COALESCE(
        CASE 
            WHEN pws.Tags IS NULL OR LENGTH(TRIM(pws.Tags)) = 0 THEN 'NoTags'
            ELSE
                array_to_string(
                    array_slice(
                        string_to_array(
                            substring(pws.Tags FROM 2 FOR LENGTH(pws.Tags)-2), '><'
                        ), 1, 3
                    ), ', '
                )
        END, 'NoTags'
    ) AS TopTags
FROM PostWithStats pws
LEFT JOIN Users u ON pws.OwnerName = u.DisplayName
LEFT JOIN UserPerformanceWindow upw ON u.Id = upw.Id
WHERE 
    (pws.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year' OR pws.Score > 10)
    AND (pws.ViewCount > 500 OR pws.CommentCount > 5)
ORDER BY EngagementScore DESC, pws.Score DESC
LIMIT 100
;