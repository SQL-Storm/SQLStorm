WITH TopUsers AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) AS PostCount,
        COUNT(DISTINCT a.Id) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesReceived,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesReceived,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS DirectAnswerCount,
        AVG(p.Score) AS AveragePostScore,
        MAX(p.Score) AS MaxPostScore,
        MIN(p.Score) AS MinPostScore,
        COUNT(DISTINCT b.Id) AS BadgeCount
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Posts a ON u.Id = a.OwnerUserId AND a.PostTypeId = 2
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    GROUP BY
        u.Id, u.DisplayName, u.Reputation
    ORDER BY
        u.Reputation DESC
    LIMIT 100
),
ActiveTags AS (
    SELECT
        t.Id AS TagId,
        t.TagName,
        t.Count AS TotalUsage,
        COUNT(p.Id) AS RecentPostCount,
        AVG(p.Score) AS AveragePostScore,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS RecentQuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS RecentAnswerCount,
        MAX(p.Score) AS MaxPostScore,
        MIN(p.Score) AS MinPostScore,
        COUNT(DISTINCT v.Id) AS VoteCount,
        COUNT(DISTINCT c.Id) AS CommentCount
    FROM
        Tags t
    LEFT JOIN
        Posts p ON t.TagName = ANY(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) 
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    WHERE
        p.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30 days'
    GROUP BY
        t.Id, t.TagName, t.Count
    ORDER BY
        RecentPostCount DESC
    LIMIT 50
),
HighEngagementPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.OwnerUserId,
        u.DisplayName AS OwnerDisplayName,
        COUNT(v.Id) AS VoteCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        CASE WHEN COUNT(v.Id) = 0 THEN NULL ELSE AVG(CAST(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END AS FLOAT)) END AS UpVoteRatio,
        CASE WHEN COUNT(v.Id) = 0 THEN NULL ELSE AVG(CAST(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END AS FLOAT)) END AS DownVoteRatio,
        MAX(v.CreationDate) AS LastVoteDate,
        COUNT(DISTINCT ph.Id) AS PostHistoryCount,
        COUNT(DISTINCT pl.Id) AS LinkCount
    FROM
        Posts p
    LEFT JOIN
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    LEFT JOIN
        PostHistory ph ON p.Id = ph.PostId
    LEFT JOIN
        PostLinks pl ON p.Id = pl.PostId
    WHERE
        p.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
    GROUP BY
        p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.Title, p.OwnerUserId, u.DisplayName
    ORDER BY
        COUNT(v.Id) DESC
    LIMIT 200
)
SELECT
    tu.UserId,
    tu.DisplayName,
    tu.Reputation,
    tu.PostCount,
    tu.AnswerCount,
    tu.CommentCount,
    tu.UpVotesReceived,
    tu.DownVotesReceived,
    tu.QuestionCount,
    tu.DirectAnswerCount,
    tu.AveragePostScore,
    tu.MaxPostScore,
    tu.MinPostScore,
    tu.BadgeCount,
    at.TagId,
    at.TagName,
    at.TotalUsage,
    at.RecentPostCount,
    at.AveragePostScore AS TagAvgPostScore,
    at.RecentQuestionCount,
    at.RecentAnswerCount,
    at.MaxPostScore AS TagMaxPostScore,
    at.MinPostScore AS TagMinPostScore,
    at.VoteCount AS TagVoteCount,
    at.CommentCount AS TagCommentCount,
    hep.PostId,
    hep.PostTypeId,
    hep.CreationDate,
    hep.Score,
    hep.ViewCount,
    hep.Title,
    hep.OwnerUserId,
    hep.OwnerDisplayName,
    hep.VoteCount,
    hep.CommentCount,
    hep.UpVoteRatio,
    hep.DownVoteRatio,
    hep.LastVoteDate,
    hep.PostHistoryCount,
    hep.LinkCount
FROM
    TopUsers tu
CROSS JOIN
    ActiveTags at
LEFT JOIN
    HighEngagementPosts hep ON tu.UserId = hep.OwnerUserId
ORDER BY
    tu.Reputation DESC,
    at.RecentPostCount DESC,
    hep.VoteCount DESC;