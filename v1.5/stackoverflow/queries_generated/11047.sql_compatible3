WITH RecentPosts AS (
    SELECT 
        p.Id, 
        p.Title, 
        p.CreationDate, 
        p.Score, 
        p.ViewCount, 
        p.AnswerCount, 
        u.DisplayName AS OwnerDisplayName, 
        u.Reputation,
        COUNT(DISTINCT v.Id) AS VoteCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvoteCount,
        MAX(c.CreationDate) AS LastCommentDate,
        COUNT(DISTINCT c.Id) AS CommentCount
    FROM 
        Posts p
    JOIN 
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    LEFT JOIN 
        Comments c ON p.Id = c.PostId
    WHERE 
        p.CreationDate > INTERVAL '30 days' + DATE '2024-10-01' - INTERVAL '30 days'
    GROUP BY 
        p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, u.DisplayName, u.Reputation
),
UserActivity AS (
    SELECT 
        p.OwnerUserId AS UserId, 
        COUNT(DISTINCT p.Id) AS PostsCreated, 
        SUM(p.Score) AS TotalScore, 
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS UpvotesGiven, 
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS DownvotesGiven
    FROM 
        Posts p
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    GROUP BY 
        p.OwnerUserId
),
TopUsers AS (
    SELECT 
        ua.UserId, 
        ua.PostsCreated, 
        ua.TotalScore, 
        ua.UpvotesGiven, 
        ua.DownvotesGiven,
        ROW_NUMBER() OVER (ORDER BY ua.TotalScore DESC) AS Rank
    FROM 
        UserActivity ua
    WHERE 
        ua.PostsCreated > 0
),
PostTags AS (
    SELECT 
        p.Id, 
        t.TagName
    FROM 
        Posts p
    JOIN 
        Tags t ON p.Id = t.ExcerptPostId
)
SELECT 
    rp.Id AS PostId, 
    rp.Title, 
    rp.CreationDate, 
    rp.Score, 
    rp.ViewCount, 
    rp.AnswerCount, 
    rp.OwnerDisplayName, 
    rp.Reputation, 
    rp.VoteCount, 
    rp.UpvoteCount, 
    rp.DownvoteCount, 
    rp.LastCommentDate, 
    rp.CommentCount, 
    STRING_AGG(pt.TagName, ', ') AS Tags, 
    tu.PostsCreated, 
    tu.TotalScore, 
    tu.UpvotesGiven, 
    tu.DownvotesGiven, 
    tu.Rank
FROM 
    RecentPosts rp
LEFT JOIN 
    PostTags pt ON rp.Id = pt.Id
LEFT JOIN 
    TopUsers tu ON rp.OwnerUserId = tu.UserId
GROUP BY 
    rp.Id, rp.Title, rp.CreationDate, rp.Score, rp.ViewCount, rp.AnswerCount, rp.OwnerDisplayName, rp.Reputation, rp.VoteCount, rp.UpvoteCount, rp.DownvoteCount, rp.LastCommentDate, rp.CommentCount, tu.PostsCreated, tu.TotalScore, tu.UpvotesGiven, tu.DownvotesGiven, tu.Rank
ORDER BY 
    rp.Score DESC, 
    rp.ViewCount DESC, 
    tu.TotalScore DESC, 
    tu.Rank
LIMIT 100;