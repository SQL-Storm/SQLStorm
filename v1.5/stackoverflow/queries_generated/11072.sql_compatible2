WITH RecentPosts AS (
    SELECT 
        p.Id, 
        p.Title, 
        p.CreationDate, 
        p.Score, 
        p.ViewCount, 
        u.DisplayName AS OwnerDisplayName, 
        u.Reputation AS OwnerReputation,
        COUNT(v.Id) AS VoteCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
        p.OwnerUserId
    FROM Posts p
    JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56') - INTERVAL '30 days'
    GROUP BY p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount, u.DisplayName, u.Reputation, p.OwnerUserId
),
PostTags AS (
    SELECT 
        CAST(PostId AS INTEGER) AS PostId,
        REGEXP_SPLIT_TO_TABLE(TRIM(BOTH '[]' FROM Tags), ',') AS TagName
    FROM Posts
    WHERE Tags IS NOT NULL
),
Tagged AS (
    SELECT
        pt.PostId,
        LOWER(REPLACE(TagName, '"', '')) AS TagName
    FROM PostTags pt
),
TagCounts AS (
    SELECT 
        TagName, 
        COUNT(*) AS PostCount
    FROM Tagged
    GROUP BY TagName
),
UserActivity AS (
    SELECT 
        u.Id AS UserId, 
        COUNT(DISTINCT p.Id) AS PostsCreated, 
        COUNT(DISTINCT c.Id) AS CommentsCreated, 
        COALESCE(SUM(p.Score), 0) AS TotalScore
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id
)
SELECT 
    rp.Id AS PostId, 
    rp.Title, 
    rp.CreationDate, 
    rp.Score, 
    rp.ViewCount, 
    rp.OwnerDisplayName, 
    rp.OwnerReputation, 
    rp.VoteCount, 
    rp.UpVoteCount, 
    rp.DownVoteCount,
    ua.PostsCreated, 
    ua.CommentsCreated, 
    ua.TotalScore,
    tc.TagName, 
    tc.PostCount
FROM RecentPosts rp
JOIN UserActivity ua ON rp.OwnerUserId = ua.UserId
LEFT JOIN TagCounts tc ON rp.Id IN (
    SELECT PostId
    FROM PostTags
    WHERE TagName = tc.TagName
)
ORDER BY rp.CreationDate DESC, rp.Score DESC, ua.TotalScore DESC
LIMIT 100;