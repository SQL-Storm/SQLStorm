with
-- recent active questions with parsed tags and tag array elements expanded
RecentQuestions as (
  select p.Id as QuestionId,
         p.Title,
         p.CreationDate,
         p.Score,
         coalesce(p.ViewCount,0) as Views,
         p.OwnerUserId,
         p.AnswerCount,
         p.AcceptedAnswerId,
         p.Tags,
         case when p.Tags is null then array[]::text[] else string_to_array(substring(p.Tags from 2 for char_length(p.Tags)-2), '><') end as TagArray
  from Posts p
  where p.PostTypeId = 1
    and p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
),

QuestionTags as (
  select rq.*,
         t.tag as Tag
  from RecentQuestions rq
  cross join lateral unnest(rq.TagArray) as t(tag)
),

TagMetrics as (
  select Tag,
         count(distinct QuestionId) as QuestionsInPeriod,
         avg(Score) filter (where Score is not null) as AvgScore,
         avg(Views) as AvgViews,
         sum(case when AcceptedAnswerId is not null then 1 else 0 end) as AcceptedCount,
         sum(coalesce(AnswerCount,0)) as TotalAnswers,
         (cast(sum(case when AcceptedAnswerId is not null then 1 else 0 end) as numeric) / nullif(count(distinct QuestionId),0)) as AcceptedRate
  from QuestionTags
  group by Tag
  having count(distinct QuestionId) > 10
),

QuestionContext as (
  select q.QuestionId,
         q.Title,
         q.CreationDate,
         q.Score,
         q.Views,
         q.OwnerUserId,
         q.AcceptedAnswerId,
         q.AnswerCount,
         q.Tags,
         q.Tag,
         tm.QuestionsInPeriod,
         tm.AvgScore as TagAvgScore,
         tm.AvgViews  as TagAvgViews,
         tm.AcceptedRate,
         (select count(distinct c.UserId) from Comments c where c.PostId = q.QuestionId and c.UserId is not null) as DistinctCommenters,
         (select ph.CreationDate from PostHistory ph where ph.PostId = q.QuestionId order by ph.CreationDate desc limit 1) as LastHistoryDate,
         (select ph.UserId from PostHistory ph where ph.PostId = q.QuestionId order by ph.CreationDate desc limit 1) as LastHistoryUserId,
         (select count(*) filter (where a.Score >= 5) from Posts a where a.ParentId = q.QuestionId and a.PostTypeId = 2) as HighScoringAnswers,
         (select count(*) filter (where a.Score between 1 and 4) from Posts a where a.ParentId = q.QuestionId and a.PostTypeId = 2) as MediumScoringAnswers,
         (select count(*) filter (where a.Score <= 0) from Posts a where a.ParentId = q.QuestionId and a.PostTypeId = 2) as LowScoringAnswers,
         (select avg(extract(epoch from (a.CreationDate - q.CreationDate))) from Posts a where a.ParentId = q.QuestionId and a.PostTypeId = 2) as AvgAnswerDelaySeconds
  from QuestionTags q
  left join TagMetrics tm on tm.Tag = q.Tag
),

RankedQuestions as (
  select qc.QuestionId,
         qc.Title,
         qc.CreationDate,
         qc.Score,
         qc.Views,
         qc.OwnerUserId,
         qc.AcceptedAnswerId,
         qc.AnswerCount,
         qc.Tags,
         qc.Tag,
         qc.QuestionsInPeriod,
         qc.TagAvgScore,
         qc.TagAvgViews,
         qc.AcceptedRate,
         qc.DistinctCommenters,
         qc.LastHistoryDate,
         qc.LastHistoryUserId,
         qc.HighScoringAnswers,
         qc.MediumScoringAnswers,
         qc.LowScoringAnswers,
         qc.AvgAnswerDelaySeconds,
         (
           coalesce(qc.Score,0) * 2.0
           + coalesce(qc.Views,0) / nullif(1000.0,0)
           + coalesce(qc.AcceptedRate,0) * 50
           + coalesce(qc.HighScoringAnswers,0) * 5
           - coalesce(qc.LowScoringAnswers,0) * 2
           - coalesce(qc.AvgAnswerDelaySeconds, (365*24*3600)) / (24*3600)
         ) as CompositeScore,
         row_number() over (partition by qc.Tag order by
           (
             coalesce(qc.Score,0) * 2.0
             + coalesce(qc.Views,0) / nullif(1000.0,0)
             + coalesce(qc.AcceptedRate,0) * 50
             + coalesce(qc.HighScoringAnswers,0) * 5
             - coalesce(qc.LowScoringAnswers,0) * 2
             - coalesce(qc.AvgAnswerDelaySeconds, (365*24*3600)) / (24*3600)
           ) desc
         ) as TagRank,
         rank() over (partition by qc.Tag order by qc.Score desc nulls last, qc.Views desc) as ScoreRank
  from QuestionContext qc
),

TopQuestionsPerTag as (
  select rq.Tag,
         rq.QuestionId,
         rq.Title,
         rq.CreationDate,
         rq.Score,
         rq.Views,
         rq.OwnerUserId,
         u.DisplayName as OwnerName,
         u.Reputation as OwnerReputation,
         rq.AcceptedAnswerId,
         aa.Score as AcceptedAnswerScore,
         aa.OwnerUserId as AcceptedAnswerOwnerUserId,
         au.DisplayName as AcceptedAnswerOwnerName,
         rq.CompositeScore,
         rq.TagRank,
         rq.ScoreRank,
         rq.QuestionsInPeriod,
         rq.AcceptedRate,
         rq.HighScoringAnswers,
         rq.MediumScoringAnswers,
         rq.LowScoringAnswers,
         rq.DistinctCommenters,
         rq.AvgAnswerDelaySeconds,
         rq.LastHistoryDate,
         rq.LastHistoryUserId,
         exists (
           select 1 from Votes v
           join Posts pa on pa.Id = v.PostId and pa.ParentId = rq.QuestionId and pa.PostTypeId = 2
           where v.VoteTypeId in (8,9)
         ) as HasBountyActivity,
         exists (
           select 1 from Votes v2
           where v2.PostId = rq.QuestionId and v2.VoteTypeId in (10,12,14)
         ) as HasModerationVotes
  from RankedQuestions rq
  left join Users u on u.Id = rq.OwnerUserId
  left join Posts aa on aa.Id = rq.AcceptedAnswerId
  left join Users au on au.Id = aa.OwnerUserId
  where rq.TagRank <= 5
),

TagSummaries as (
  select Tag,
         QuestionsInPeriod,
         AvgScore,
         AvgViews,
         AcceptedRate,
         row_number() over (order by QuestionsInPeriod desc nulls last) as PopularityRank
  from TagMetrics
),

HotTagPairs as (
  select t1.Tag as TagA, t2.Tag as TagB,
         count(distinct q.QuestionId) as CoOccurrenceCount,
         sum(coalesce(q.Score,0)) as CoOccScoreSum,
         avg(coalesce(q.Views,0)) as CoOccAvgViews
  from QuestionTags q
  join QuestionTags t1 on t1.QuestionId = q.QuestionId
  join QuestionTags t2 on t2.QuestionId = q.QuestionId and t2.Tag > t1.Tag
  group by t1.Tag, t2.Tag
  having count(distinct q.QuestionId) > 20
),

FinalOutput as (
  select
    ts.PopularityRank,
    ts.Tag,
    ts.QuestionsInPeriod,
    ts.AvgScore,
    ts.AvgViews,
    ts.AcceptedRate,
    (select string_agg(substring(tq.Title from 1 for 120) || coalesce(' [' || tq.OwnerName || ']', ''), ' ||| ')
     from TopQuestionsPerTag tq
     where tq.Tag = ts.Tag
     order by tq.CompositeScore desc
    ) as TopTitlesConcat,
    (select array_agg(tq.QuestionId order by tq.CompositeScore desc) from TopQuestionsPerTag tq where tq.Tag = ts.Tag) as TopQuestionIds,
    (select string_agg(htp.TagB || ':' || cast(htp.CoOccurrenceCount as text), ', ' order by htp.CoOccurrenceCount desc)
     from HotTagPairs htp where htp.TagA = ts.Tag
     limit 3
    ) as TopCoOccurringTags,
    (select string_agg(distinct coalesce(u2.DisplayName, 'user#' || coalesce(cast(ph.UserId as text),'-')), ', ')
     from PostHistory ph
     left join Users u2 on u2.Id = ph.UserId
     where ph.PostId in (
       select q.QuestionId from QuestionTags q where q.Tag = ts.Tag
     )
       and ph.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days'
     -- ensure ordering of contributors by their max activity: aggregate then order in an outer query if needed
    ) as RecentEditors,
    (case when ts.AcceptedRate > 0.6 and (select avg(q.AvgAnswerDelaySeconds) from QuestionContext q where q.Tag = ts.Tag) < 172800 then true else false end) as QuickAndAccepted
  from TagSummaries ts
  where ts.PopularityRank <= 50
)

select
  fo.PopularityRank,
  fo.Tag,
  fo.QuestionsInPeriod,
  round(coalesce(fo.AvgScore,0),2) as AvgScore,
  round(coalesce(fo.AvgViews,0),2) as AvgViews,
  round(coalesce(fo.AcceptedRate,0),3) as AcceptedRate,
  fo.TopTitlesConcat,
  fo.TopQuestionIds,
  coalesce(fo.TopCoOccurringTags,'') as TopCoOccurringTags,
  coalesce(fo.RecentEditors,'') as RecentEditors,
  fo.QuickAndAccepted
from FinalOutput fo
order by fo.PopularityRank;