-- {"query": "227.sql", "dataset": "stackoverflow", "version": "v1.3", "prompt": "p1", "model": "gpt-5-mini", "temperature": 1.0, "max_tokens": 32768, "reasoning": "medium", "input_tokens": 2026, "output_tokens": 4022} 
WITH
-- recent questions and tag expansion
recent_q AS (
  SELECT p.*
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
tag_explode AS (
  SELECT
    p.Id AS PostId,
    trim(t) AS Tag
  FROM recent_q p
  CROSS JOIN LATERAL (
    SELECT unnest(string_to_array(substring(coalesce(p.Tags,''), 2, greatest(length(coalesce(p.Tags,'')) - 2,0)), '><')) AS t
  ) tx
  WHERE tx.t IS NOT NULL AND tx.t <> ''
),
-- co-occurring tag pairs (unordered)
tag_pairs AS (
  SELECT
    least(a.Tag, b.Tag) AS tag_a,
    greatest(a.Tag, b.Tag) AS tag_b,
    count(*) AS cooccur
  FROM tag_explode a
  JOIN tag_explode b ON a.PostId = b.PostId AND a.Tag <> b.Tag
  GROUP BY 1,2
),
-- aggregate votes per post with pivot (Up/Down/Favorite/Bounty)
vote_agg AS (
  SELECT
    v.PostId,
    count(*) FILTER (WHERE v.VoteTypeId = 2) AS upvotes,
    count(*) FILTER (WHERE v.VoteTypeId = 3) AS downvotes,
    count(*) FILTER (WHERE v.VoteTypeId = 5) AS favorites,
    sum(v.BountyAmount) FILTER (WHERE v.BountyAmount IS NOT NULL) AS bounty_total,
    count(*) AS total_votes
  FROM Votes v
  GROUP BY v.PostId
),
-- comments per post
comment_agg AS (
  SELECT PostId, count(*) AS comments, max(CreationDate) AS last_comment_date
  FROM Comments
  GROUP BY PostId
),
-- answer aggregates per question with correlated subquery for accepted answer creation
answer_stats AS (
  SELECT
    q.Id AS QuestionId,
    coalesce(count(a.Id),0) AS answer_count,
    coalesce(avg(a.Score)::numeric,0) AS avg_answer_score,
    coalesce(max(a.Score),0) AS max_answer_score,
    -- time to accepted answer in seconds if exists (correlated)
    (SELECT EXTRACT(EPOCH FROM (aa.CreationDate - q.CreationDate))
     FROM Posts aa
     WHERE aa.Id = q.AcceptedAnswerId
     LIMIT 1) AS seconds_to_accept,
    -- distribution of answer creation across last 30/90/365 days
    sum((CASE WHEN a.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days' THEN 1 ELSE 0 END)) AS answers_30d,
    sum((CASE WHEN a.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days' THEN 1 ELSE 0 END)) AS answers_90d,
    sum((CASE WHEN a.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '365 days' THEN 1 ELSE 0 END)) AS answers_365d
  FROM Posts q
  LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
  WHERE q.PostTypeId = 1
  GROUP BY q.Id, q.CreationDate, q.AcceptedAnswerId
),
-- user aggregates: posts, badges, votes cast, recent activity window functions
user_agg AS (
  SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    coalesce(pq.q_count,0) AS question_count,
    coalesce(pa.a_count,0) AS answer_count,
    coalesce(b.badge_count,0) AS badge_count,
    coalesce(votes_cast.votes_cast,0) AS votes_cast,
    -- recency features
    u.LastAccessDate,
    -- sliding rank of users by combined signal
    ROW_NUMBER() OVER (ORDER BY (coalesce(pq.q_count,0) * 2 + coalesce(pa.a_count,0) * 1.5 + coalesce(b.badge_count,0) * 1.2 + coalesce(votes_cast.votes_cast,0) * 0.5 + u.Reputation/100.0) DESC) AS user_power_rank
  FROM Users u
  LEFT JOIN (
    SELECT OwnerUserId, count(*) AS q_count
    FROM Posts
    WHERE PostTypeId = 1
    GROUP BY OwnerUserId
  ) pq ON pq.OwnerUserId = u.Id
  LEFT JOIN (
    SELECT OwnerUserId, count(*) AS a_count
    FROM Posts
    WHERE PostTypeId = 2
    GROUP BY OwnerUserId
  ) pa ON pa.OwnerUserId = u.Id
  LEFT JOIN (
    SELECT UserId, count(*) AS badge_count
    FROM Badges
    GROUP BY UserId
  ) b ON b.UserId = u.Id
  LEFT JOIN (
    SELECT UserId, count(*) AS votes_cast
    FROM Votes
    WHERE UserId IS NOT NULL
    GROUP BY UserId
  ) votes_cast ON votes_cast.UserId = u.Id
),
-- activity timeline per user using window functions (latest 3 activities)
user_activity AS (
  SELECT ua.Id AS UserId, ua.DisplayName, events.*
  FROM user_agg ua
  LEFT JOIN LATERAL (
    SELECT ev.type, ev.id, ev.created_at
    FROM (
      SELECT 'post'::text AS type, p.Id AS id, p.CreationDate AS created_at
      FROM Posts p WHERE p.OwnerUserId = ua.Id
      UNION ALL
      SELECT 'comment'::text, c.Id, c.CreationDate
      FROM Comments c WHERE c.UserId = ua.Id
      UNION ALL
      SELECT 'vote'::text, v.Id, v.CreationDate
      FROM Votes v WHERE v.UserId = ua.Id
      ORDER BY created_at DESC
      LIMIT 3
    ) ev
  ) events ON true
),
-- recent active users set, power users set, and combine with set operators for benchmarking
recent_active_users AS (
  SELECT DISTINCT COALESCE(OwnerUserId, UserId) AS uid
  FROM (
    SELECT OwnerUserId, NULL::int AS UserId, CreationDate FROM Posts WHERE CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
    UNION ALL
    SELECT NULL::int AS OwnerUserId, UserId, CreationDate FROM Comments WHERE CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
  ) s
  WHERE COALESCE(OwnerUserId, UserId) IS NOT NULL
),
power_users AS (
  SELECT Id AS uid FROM Users WHERE Reputation >= 50000
),
active_power_intersect AS (
  SELECT uid FROM recent_active_users INTERSECT SELECT uid FROM power_users
),
power_not_active AS (
  SELECT uid FROM power_users EXCEPT SELECT uid FROM recent_active_users
),
-- base question metrics combining many aggregates and expressions
question_metrics AS (
  SELECT
    q.Id,
    q.Title,
    q.OwnerUserId,
    u.DisplayName AS OwnerName,
    q.CreationDate,
    q.Score,
    q.ViewCount,
    coalesce(va.upvotes,0) AS upvotes,
    coalesce(va.downvotes,0) AS downvotes,
    coalesce(ca.comments,0) AS comments,
    coalesce(ans.answer_count,0) AS answer_count,
    coalesce(ans.avg_answer_score,0) AS avg_answer_score,
    coalesce(ans.max_answer_score,0) AS max_answer_score,
    coalesce(ans.seconds_to_accept, NULL) AS seconds_to_accept,
    -- engagement score: nonlinear combination with null-safe math
    ( (coalesce(q.ViewCount,0)::numeric * 0.1)
      + (coalesce(q.Score,0)::numeric * 5)
      + (coalesce(ans.answer_count,0)::numeric * 10)
      + (coalesce(ca.comments,0)::numeric * 2)
      + sqrt(coalesce(va.upvotes,0)::numeric + 1) * 3
      - log(greatest(coalesce(va.downvotes,0)::numeric,1)) * 2
      + coalesce(va.bounty_total,0)::numeric
    ) AS engagement_score,
    -- cleaned snippet from Body removing tags and truncating
    left(regexp_replace(coalesce(q.Body,''), '<[^>]+>', ' ', 'g'), 240) AS body_snippet,
    -- concatenated tags
    (SELECT string_agg(DISTINCT tx.Tag, ',') FROM tag_explode tx WHERE tx.PostId = q.Id) AS tag_list
  FROM recent_q q
  LEFT JOIN Users u ON u.Id = q.OwnerUserId
  LEFT JOIN vote_agg va ON va.PostId = q.Id
  LEFT JOIN comment_agg ca ON ca.PostId = q.Id
  LEFT JOIN answer_stats ans ON ans.QuestionId = q.Id
),
-- rank questions by engagement and also compute dense ranks by tag for more window function usage
question_ranks AS (
  SELECT
    qm.*,
    ROW_NUMBER() OVER (ORDER BY qm.engagement_score DESC NULLS LAST) AS global_rank,
    DENSE_RANK() OVER (PARTITION BY qm.tag_list ORDER BY qm.engagement_score DESC NULLS LAST) AS tag_dense_rank,
    PERCENT_RANK() OVER (ORDER BY qm.engagement_score DESC NULLS LAST) AS pct_rank
  FROM question_metrics qm
),
-- top tag pairs for inclusion
top_tag_pairs AS (
  SELECT tag_a || '|' || tag_b AS pair, cooccur
  FROM tag_pairs
  ORDER BY cooccur DESC NULLS LAST
  LIMIT 25
),
-- union components prepared with matching column sets for final UNION ALL
questions_portion AS (
  SELECT
    'question'::text AS entity_type,
    q.Id::text AS entity_id,
    left(coalesce(q.Title, q.body_snippet, '<no title>'), 200) AS label,
    q.OwnerUserId::text AS owner_id,
    coalesce(q.OwnerName, '<unknown>') AS owner_name,
    q.engagement_score,
    q.answer_count,
    q.avg_answer_score,
    q.seconds_to_accept,
    q.upvotes,
    q.downvotes,
    q.comments,
    q.tag_list AS aux_text,
    q.global_rank,
    q.pct_rank
  FROM question_ranks q
  WHERE q.global_rank <= 50
  ORDER BY q.engagement_score DESC NULLS LAST
),
users_portion AS (
  SELECT
    'user'::text AS entity_type,
    ua.Id::text AS entity_id,
    left(coalesce(ua.DisplayName,'<no name>'), 200) AS label,
    NULL::text AS owner_id,
    NULL::text AS owner_name,
    -- user "engagement" metric analog
    (ua.Reputation::numeric/10 + ua.question_count * 20 + ua.answer_count * 15 + ua.badge_count * 5 + ua.votes_cast * 0.2) AS engagement_score,
    ua.answer_count AS answer_count,
    NULL::numeric AS avg_answer_score,
    NULL::numeric AS seconds_to_accept,
    NULL::int AS upvotes,
    NULL::int AS downvotes,
    NULL::int AS comments,
    'badges=' || coalesce(ua.badge_count::text,'0') || ';last=' || to_char(ua.LastAccessDate,'YYYY-MM-DD') AS aux_text,
    ua.user_power_rank AS global_rank,
    ua.user_power_rank::numeric / NULLIF((SELECT max(user_power_rank) FROM user_agg),0) AS pct_rank
  FROM user_agg ua
  WHERE ua.user_power_rank <= 50
  ORDER BY engagement_score DESC NULLS LAST
),
tagpairs_portion AS (
  SELECT
    'tag_pair'::text AS entity_type,
    NULL::text AS entity_id,
    pair AS label,
    NULL::text AS owner_id,
    NULL::text AS owner_name,
    cooccur::numeric AS engagement_score,
    cooccur AS answer_count,
    NULL::numeric AS avg_answer_score,
    NULL::numeric AS seconds_to_accept,
    NULL::int AS upvotes,
    NULL::int AS downvotes,
    NULL::int AS comments,
    'cooccur' || '=' || cooccur::text AS aux_text,
    ROW_NUMBER() OVER (ORDER BY cooccur DESC) AS global_rank,
    PERCENT_RANK() OVER (ORDER BY cooccur DESC) AS pct_rank
  FROM top_tag_pairs
)
-- final unioned SELECT for benchmarking; uses ORDER BY, NULL logic, set operators above used in CTEs
SELECT * FROM questions_portion
UNION ALL
SELECT * FROM users_portion
UNION ALL
SELECT * FROM tagpairs_portion
ORDER BY entity_type, engagement_score DESC NULLS LAST, global_rank ASC
LIMIT 150;