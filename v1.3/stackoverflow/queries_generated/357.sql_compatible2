WITH
questions AS (
  SELECT
    p.Id,
    p.Title,
    p.OwnerUserId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.Tags,
    CASE WHEN p.Tags IS NULL THEN '' ELSE substring(p.Tags from 2 for char_length(p.Tags)-2) END AS tags_inner
  FROM Posts p
  WHERE p.PostTypeId = 1
),
question_tags AS (
  SELECT q.*, t.tag
  FROM questions q
  CROSS JOIN LATERAL regexp_split_to_table(q.tags_inner, '><') AS t(tag)
  WHERE q.tags_inner <> ''
),
answers AS (
  SELECT p.*
  FROM Posts p
  WHERE p.PostTypeId = 2
),
first_answer_per_question AS (
  SELECT a.ParentId AS QuestionId, min(a.CreationDate) AS FirstAnswerDate, min(a.Id) AS FirstAnswerId
  FROM answers a
  WHERE a.ParentId IS NOT NULL
  GROUP BY a.ParentId
),
postlink_dup_counts AS (
  SELECT pl.PostId, count(*) FILTER (WHERE pl.LinkTypeId = 3) AS duplicate_count
  FROM PostLinks pl
  GROUP BY pl.PostId
),
post_activity_summary AS (
  SELECT
    qt.tag,
    CAST(count(*) AS bigint) AS question_count,
    CAST(sum(coalesce(qt.ViewCount,0)) AS bigint) AS views,
    sum(CASE WHEN qt.Score > 0 THEN 1 ELSE 0 END) AS positive_scores,
    avg(coalesce(qt.Score,0)) AS avg_score,
    avg(coalesce(qt.AnswerCount,0)) AS avg_answer_count,
    avg( extract(epoch FROM (coalesce(fa.FirstAnswerDate, qt.CreationDate) - qt.CreationDate)) / 3600 ) AS avg_hours_to_first_answer,
    CAST(sum(coalesce(pl.duplicate_count,0)) AS bigint) AS duplicate_links
  FROM question_tags qt
  LEFT JOIN first_answer_per_question fa ON fa.QuestionId = qt.Id
  LEFT JOIN postlink_dup_counts pl ON pl.PostId = qt.Id
  GROUP BY qt.tag
),
tag_badge_impact AS (
  SELECT
    qt.tag,
    CAST(count(DISTINCT qt.OwnerUserId) FILTER (WHERE EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = qt.OwnerUserId)) AS bigint) AS badge_users,
    CAST(sum((SELECT count(*) FROM Badges b WHERE b.UserId = qt.OwnerUserId AND b.Class = 1)) AS bigint) AS golds,
    CAST(sum((SELECT count(*) FROM Badges b WHERE b.UserId = qt.OwnerUserId AND b.Class = 2)) AS bigint) AS silvers,
    CAST(sum((SELECT count(*) FROM Badges b WHERE b.UserId = qt.OwnerUserId AND b.Class = 3)) AS bigint) AS bronzes
  FROM question_tags qt
  GROUP BY qt.tag
),
top_answerers_per_tag AS (
  SELECT t.tag,
         a.OwnerUserId AS UserId,
         CAST(count(*) AS bigint) AS answers_count,
         CAST(sum(coalesce(a.Score,0)) AS bigint) AS answers_score,
         avg( extract(epoch FROM (a.CreationDate - q.CreationDate)) / 3600 ) AS avg_hours_to_answer,
         row_number() OVER (PARTITION BY t.tag ORDER BY count(*) DESC, sum(coalesce(a.Score,0)) DESC) AS rn
  FROM Posts a
  JOIN Posts q ON a.ParentId = q.Id AND q.PostTypeId = 1
  CROSS JOIN LATERAL regexp_split_to_table(CASE WHEN q.Tags IS NULL THEN '' ELSE substring(q.Tags from 2 for char_length(q.Tags)-2) END, '><') AS t(tag)
  WHERE a.PostTypeId = 2
  GROUP BY t.tag, a.OwnerUserId, q.CreationDate
),
tag_top_k AS (
  SELECT tag, UserId, answers_count, answers_score, avg_hours_to_answer
  FROM top_answerers_per_tag
  WHERE rn <= 3
),
user_influence AS (
  SELECT u.Id AS user_id,
         u.DisplayName,
         u.Reputation,
         CAST(count(p.Id) FILTER (WHERE p.PostTypeId = 1) AS int) AS questions_asked,
         CAST(count(p.Id) FILTER (WHERE p.PostTypeId = 2) AS int) AS answers_posted,
         CAST(sum(coalesce(p.Score,0)) AS int) AS total_score,
         dense_rank() OVER (ORDER BY sum(coalesce(p.Score,0)) DESC) AS score_rank,
         rank() OVER (ORDER BY u.Reputation DESC) AS reputation_rank
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation
),
top_tags AS (
  SELECT tag FROM (
    SELECT tag, row_number() OVER (ORDER BY question_count DESC, views DESC) AS rn
    FROM post_activity_summary
  ) x
  WHERE rn <= 50
  INTERSECT
  SELECT TagName FROM Tags
),
tag_leaderboard AS (
  SELECT
    ps.tag,
    row_number() OVER (ORDER BY ps.question_count DESC, ps.views DESC) AS tag_popularity_rank,
    ps.question_count,
    ps.views,
    (CAST(ps.views AS numeric) / NULLIF(ps.question_count,0)) AS avg_views_per_question,
    ps.avg_score,
    ps.avg_answer_count,
    ps.avg_hours_to_first_answer,
    ps.duplicate_links
  FROM post_activity_summary ps
  WHERE ps.tag IN (SELECT tag FROM top_tags)
),
per_tag_detail AS (
  SELECT
    CAST(tl.tag AS text) AS tag,
    CAST(tl.tag_popularity_rank AS int) AS tag_popularity_rank,
    CAST(tl.question_count AS bigint) AS question_count,
    CAST(tl.views AS bigint) AS views,
    round(tl.avg_views_per_question,3) AS avg_views_per_question,
    round(tl.avg_score,3) AS avg_score,
    round(tl.avg_answer_count,3) AS avg_answers,
    round(tl.avg_hours_to_first_answer,3) AS avg_hours_to_first_answer,
    CAST(tl.duplicate_links AS bigint) AS duplicate_links,
    COALESCE(tbi.golds,0) AS badge_golds,
    COALESCE(tbi.silvers,0) AS badge_silvers,
    COALESCE(tbi.bronzes,0) AS badge_bronzes,
    (SELECT json_agg(json_object(
               ARRAY['user_id','answers','score','avg_hours_to_answer'],
               ARRAY[tt.UserId::text, tt.answers_count::text, tt.answers_score::text, round(tt.avg_hours_to_answer,3)::text]
             ) ORDER BY tt.answers_count DESC)
     FROM tag_top_k tt WHERE tt.tag = tl.tag) AS top_answerers_json,
    (SELECT count(*) FROM Posts p WHERE p.PostTypeId = 1 AND p.Tags ILIKE ('%<'||tl.tag||'>%')) AS exact_tag_match_questions,
    (SELECT count(*) FROM PostHistory ph WHERE ph.PostId IN (SELECT Id FROM Posts WHERE Tags ILIKE ('%<'||tl.tag||'>%')) AND ph.PostHistoryTypeId = 52) AS hot_history_count,
    CASE
      WHEN tl.avg_hours_to_first_answer IS NULL THEN 'no-answers'
      WHEN tl.avg_hours_to_first_answer < 1 THEN 'fast'
      WHEN tl.avg_hours_to_first_answer < 24 THEN 'moderate'
      ELSE 'slow'
    END AS responsiveness_class
  FROM tag_leaderboard tl
  LEFT JOIN tag_badge_impact tbi ON tbi.tag = tl.tag
),
global_summary AS (
  SELECT
    CAST('<<GLOBAL>>' AS text) AS tag,
    CAST(0 AS int) AS tag_popularity_rank,
    CAST(sum(question_count) AS bigint) AS question_count,
    CAST(sum(views) AS bigint) AS views,
    round((CAST(sum(views) AS numeric) / NULLIF(CAST(sum(question_count) AS numeric),0)),3) AS avg_views_per_question,
    round(avg(avg_score),3) AS avg_score,
    round(avg(avg_answer_count),3) AS avg_answers,
    round(avg(avg_hours_to_first_answer),3) AS avg_hours_to_first_answer,
    CAST(sum(duplicate_links) AS bigint) AS duplicate_links,
    (SELECT count(*) FROM Badges b WHERE b.Class = 1) AS badge_golds,
    (SELECT count(*) FROM Badges b WHERE b.Class = 2) AS badge_silvers,
    (SELECT count(*) FROM Badges b WHERE b.Class = 3) AS badge_bronzes,
    NULL AS top_answerers_json,
    NULL AS exact_tag_match_questions,
    (SELECT count(*) FROM PostHistory ph WHERE ph.PostHistoryTypeId = 52) AS hot_history_count,
    CAST('global' AS text) AS responsiveness_class
  FROM post_activity_summary
)
SELECT *
FROM (
  SELECT *
  FROM per_tag_detail
  UNION ALL
  SELECT *
  FROM global_summary
) combined
ORDER BY CASE WHEN tag = '<<GLOBAL>>' THEN 1 ELSE 0 END, tag_popularity_rank
LIMIT 1000;