with
-- top active users by weighted recent activity
recent_activity as (
  select u.id as user_id,
         u.displayname,
         u.reputation,
         count(distinct p.id) filter (where p.posttypeid = 1) as questions_posted,
         count(distinct p.id) filter (where p.posttypeid = 2) as answers_posted,
         sum(coalesce(p.score, 0)) as total_post_score,
         max(u.lastaccessdate) as last_access,
         sum(case when p.creationdate > cast('2024-10-01 12:34:56' as timestamp) - interval '90 days' then 3
                  when p.creationdate > cast('2024-10-01 12:34:56' as timestamp) - interval '365 days' then 1
                  else 0 end) as recency_weight
  from users u
  left join posts p on p.owneruserid = u.id
  group by u.id, u.displayname, u.reputation
),
-- compute tag expertise per user from their answers' parent question tags
user_tag_expertise as (
  select a.owneruserid as user_id,
         lower(trim(t.tagname)) as tag,
         count(*) as answers_count,
         sum(coalesce(a.score, 0)) as answer_score,
         sum(case when a.creationdate > cast('2024-10-01 12:34:56' as timestamp) - interval '365 days' then 1 else 0 end) as answers_last_year
  from posts a
  join posts q on q.id = a.parentid and q.posttypeid = 1
  cross join lateral (
    select unnest(string_to_array(substring(q.tags from 2 for char_length(q.tags) - 2), '><')) as tagname
  ) t
  where a.posttypeid = 2 and a.owneruserid is not null
  group by a.owneruserid, lower(trim(t.tagname))
),
-- pick favorite tag per user (highest weighted score, break ties by recency)
favorite_tag as (
  select ut.user_id,
         ut.tag,
         ut.answers_count,
         ut.answer_score,
         ut.answers_last_year,
         row_number() over (partition by ut.user_id order by (ut.answer_score * 2 + ut.answers_last_year) desc, ut.answers_count desc) as rn
  from user_tag_expertise ut
),
fav_tag_top as (
  select user_id, tag, answers_count, answer_score from favorite_tag where rn = 1
),
-- compute question-answers relationships with aggregates
qa_summary as (
  select q.id as question_id,
         q.title,
         q.owneruserid as question_owner,
         q.creationdate as question_created,
         q.score as question_score,
         q.viewcount,
         q.tags,
         count(a.id) filter (where a.id is not null) as answer_count,
         max(a.score) filter (where a.id is not null) as top_answer_score,
         max(case when a.id = q.acceptedanswerid then 1 else 0 end) as has_accepted_answer,
         min(a.creationdate) filter (where a.id is not null) as first_answer_date,
         max(a.creationdate) filter (where a.id is not null) as last_answer_date
  from posts q
  left join posts a on a.parentid = q.id and a.posttypeid = 2
  where q.posttypeid = 1
  group by q.id, q.title, q.owneruserid, q.creationdate, q.score, q.viewcount, q.tags, q.acceptedanswerid
),
-- compute slowest-to-answer questions (time to first answer), with correlated subquery
slow_to_answer as (
  select q.id as question_id,
         q.title,
         q.creationdate,
         (select min(a.creationdate) from posts a where a.parentid = q.id and a.posttypeid = 2) as first_answer_date,
         extract(epoch from ((select min(a.creationdate) from posts a where a.parentid = q.id and a.posttypeid = 2) - q.creationdate)) / 3600.0 as hours_to_first_answer
  from posts q
  where q.posttypeid = 1
    and exists (select 1 from posts a where a.parentid = q.id and a.posttypeid = 2)
),
-- assemble votes per post with conditional aggregates and null-aware math
post_votes as (
  select p.id as post_id,
         p.posttypeid,
         sum(case when v.votetypeid = 2 then 1 when v.votetypeid = 3 then -1 else 0 end) as net_votes,
         sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
         sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
         count(v.id) as vote_count,
         avg(case when v.bountyamount is not null then v.bountyamount end) as avg_bounty
  from posts p
  left join votes v on v.postid = p.id
  group by p.id, p.posttypeid
),
-- combine everything to produce a heavy query for benchmarking
benchmark_seed as (
  select ra.user_id,
         ra.displayname,
         ra.reputation,
         ra.questions_posted,
         ra.answers_posted,
         ra.total_post_score,
         coalesce(ft.tag, '<<none>>') as favorite_tag,
         coalesce(ft.answer_score, 0) as fav_tag_score,
         coalesce(ft.answers_last_year, 0) as fav_tag_recent_answers,
         qs.question_id,
         qs.title as sample_question_title,
         qs.answercount as answer_count,
         qs.top_answer_score,
         qs.has_accepted_answer,
         sv.hours_to_first_answer,
         pv.net_votes,
         pv.upvotes,
         pv.downvotes,
         -- compute an artificial "impact" metric with null-safe calculations and string manipulations
         (coalesce(ra.reputation, 0) * greatest(1, coalesce(ra.recency_weight, 0)) + coalesce(qs.answercount, 0) * 5 + coalesce(pv.net_votes, 0) * 2
           - (case when qs.has_accepted_answer = 1 then 10 else 0 end)
         ) as impact_score,
         -- complex derived string: safe substring of title plus tag summary
         left(coalesce(qs.title, '(no title)'), 120) || ' :: tag=' || coalesce(ft.tag, '(none)') || ' :: rep=' || coalesce(cast(ra.reputation as text), '0') as signature
  from recent_activity ra
  left join fav_tag_top ft on ft.user_id = ra.user_id
  -- join to a sample question authored by the user (choose most recent question)
  left join lateral (
    select q.id as question_id, q.title, q.answercount, q.creationdate, q.score, q.tags,
           max(a.score) over (partition by q.id) as top_answer_score,
           case when q.acceptedanswerid is not null then 1 else 0 end as has_accepted_answer
    from posts q
    left join posts a on a.parentid = q.id and a.posttypeid = 2
    where q.posttypeid = 1 and q.owneruserid = ra.user_id
    order by q.creationdate desc
    limit 1
  ) qs on true
  left join slow_to_answer sv on sv.question_id = qs.question_id
  left join post_votes pv on pv.post_id = qs.question_id
  where ra.reputation > 50 or ra.recency_weight > 0
),
-- final ranking with window functions, set operators for some synthetic sets
ranked as (
  select bs.*,
         row_number() over (order by impact_score desc nulls last, fav_tag_recent_answers desc) as global_rank,
         rank() over (partition by coalesce(favorite_tag, '(none)') order by impact_score desc) as tag_rank
  from benchmark_seed bs
)
select r.global_rank,
       r.user_id,
       r.displayname,
       r.reputation,
       r.questions_posted,
       r.answers_posted,
       r.favorite_tag,
       r.fav_tag_score,
       r.fav_tag_recent_answers,
       r.sample_question_title,
       r.answer_count,
       r.top_answer_score,
       r.has_accepted_answer,
       round(coalesce(r.hours_to_first_answer, 0)::double precision, 2) as hours_to_first_answer,
       r.net_votes,
       r.upvotes,
       r.downvotes,
       round(cast(r.impact_score as double precision), 2) as impact_score,
       r.signature,
       r.tag_rank
from ranked r
where (r.global_rank <= 200)
  and (
    (r.favorite_tag is not null and r.favorite_tag <> '(none)' and position('sql' in lower(r.favorite_tag)) > 0)
    or (r.questions_posted > 0 and coalesce(r.answer_count, 0) >= 1)
    or (r.reputation > (select avg(reputation) from users))
  )
union
-- include a few randomly selected low-activity users to create skew
select 999999 as global_rank,
       u.id as user_id,
       u.displayname,
       u.reputation,
       0 as questions_posted,
       0 as answers_posted,
       '(random-sample)' as favorite_tag,
       0 as fav_tag_score,
       0 as fav_tag_recent_answers,
       null as sample_question_title,
       0 as answer_count,
       null as top_answer_score,
       0 as has_accepted_answer,
       null as hours_to_first_answer,
       0 as net_votes,
       0 as upvotes,
       0 as downvotes,
       0.0 as impact_score,
       '(random)' as signature,
       999 as tag_rank
from users u
where u.reputation between 1 and 10
order by global_rank, impact_score desc, user_id
limit 250;