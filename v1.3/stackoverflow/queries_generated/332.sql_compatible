WITH
votes_agg AS (
  SELECT v.PostId,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS upvotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS downvotes,
    SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS favorites,
    SUM(CASE WHEN v.VoteTypeId IN (12,14) THEN 1 ELSE 0 END) AS spam_or_nominate,
    COUNT(*) AS total_votes
  FROM Votes v
  GROUP BY v.PostId
),
posthistory_agg AS (
  SELECT ph.PostId,
    COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4,5,6,24)) AS content_edits,
    COUNT(*) AS total_changes,
    MAX(ph.CreationDate) AS last_history_date,
    BOOL_OR(ph.PostHistoryTypeId = 10) AS ever_closed
  FROM PostHistory ph
  GROUP BY ph.PostId
),
badges_agg AS (
  SELECT b.UserId,
    COUNT(*) AS badge_count,
    COUNT(*) FILTER (WHERE b.Class = 1) AS gold,
    COUNT(*) FILTER (WHERE b.Class = 2) AS silver,
    COUNT(*) FILTER (WHERE b.Class = 3) AS bronze,
    COUNT(*) FILTER (WHERE b.TagBased = TRUE) AS tag_badges,
    MAX(b.Date) AS last_badge_date
  FROM Badges b
  GROUP BY b.UserId
),
users_agg AS (
  SELECT u.Id AS user_id,
    u.Reputation AS reputation,
    u.DisplayName,
    u.CreationDate AS user_creation,
    EXTRACT(epoch FROM (CAST('2024-10-01 12:34:56' AS timestamp) - u.CreationDate))/86400.0 AS account_days,
    COALESCE(b.badge_count, 0) AS badge_count, COALESCE(b.gold,0) AS gold,
    COALESCE(b.silver,0) AS silver, COALESCE(b.bronze,0) AS bronze
  FROM Users u
  LEFT JOIN badges_agg b ON b.UserId = u.Id
),
tag_exploded AS (
  SELECT q.Id AS question_id,
    q.Title,
    q.CreationDate,
    q.Score,
    q.ViewCount,
    q.AnswerCount,
    q.AcceptedAnswerId,
    q.OwnerUserId,
    lower(trim(both ' ' FROM t.tag)) AS tag
  FROM Posts q
  LEFT JOIN LATERAL (
    SELECT regexp_split_to_table(substring(q.Tags FROM 2 FOR (length(q.Tags)-2)), E'\\>\\<') AS tag
  ) t ON (q.Tags IS NOT NULL AND q.Tags <> '')
  WHERE q.PostTypeId = 1
),
tag_popularity AS (
  SELECT tag, COUNT(*) AS questions_with_tag, SUM(ViewCount) AS total_views_for_tag, AVG(Score) AS avg_question_score
  FROM tag_exploded
  GROUP BY tag
),
per_question_top_tag AS (
  SELECT te.question_id, te.tag,
    ROW_NUMBER() OVER (PARTITION BY te.question_id ORDER BY tp.questions_with_tag DESC NULLS LAST, te.tag) AS rn
  FROM tag_exploded te
  LEFT JOIN tag_popularity tp ON tp.tag = te.tag
),
question_metrics AS (
  SELECT q.Id AS question_id, q.Title, q.CreationDate, q.Score AS raw_score, q.ViewCount, q.AnswerCount,
    COALESCE(v.upvotes,0) AS upvotes, COALESCE(v.downvotes,0) AS downvotes, COALESCE(v.favorites,0) AS favorites,
    COALESCE(ph.total_changes,0) AS total_edits, COALESCE(ph.content_edits,0) AS content_edits, COALESCE(ph.ever_closed,FALSE) AS ever_closed,
    COALESCE(u.reputation,0) AS owner_reputation, u.DisplayName AS owner_name, u.account_days, u.badge_count AS owner_badges,
    q.AcceptedAnswerId,
    (SELECT min(a.CreationDate) FROM Posts a WHERE a.ParentId = q.Id AND a.PostTypeId = 2) AS first_answer_date,
    (SELECT max(a.Score) FROM Posts a WHERE a.ParentId = q.Id AND a.PostTypeId = 2) AS top_answer_score,
    (SELECT count(*) FROM PostLinks pl WHERE pl.PostId = q.Id) AS outgoing_links,
    (SELECT count(*) FROM PostLinks pl WHERE pl.RelatedPostId = q.Id) AS incoming_links
  FROM Posts q
  LEFT JOIN votes_agg v ON v.PostId = q.Id
  LEFT JOIN posthistory_agg ph ON ph.PostId = q.Id
  LEFT JOIN users_agg u ON u.user_id = q.OwnerUserId
  WHERE q.PostTypeId = 1
),
impact AS (
  SELECT qm.*,
    COALESCE(qm.raw_score,0) * GREATEST(1, LN(GREATEST(qm.ViewCount,1)) + 1) AS score_weighted,
    (GREATEST(COALESCE(qm.upvotes,0) - COALESCE(qm.downvotes,0), 0) * POWER(1 + COALESCE(qm.favorites,0), 0.5)) AS vote_signal,
    (CASE WHEN qm.AcceptedAnswerId IS NOT NULL THEN 200 ELSE 0 END) AS accepted_bonus,
    (COALESCE(qm.total_edits,0) * 10) AS edit_bonus,
    (COALESCE(qm.incoming_links,0) * 25) AS linked_bonus,
    (COALESCE(qm.top_answer_score,0) * 15) AS top_answer_bonus,
    (CASE WHEN qm.first_answer_date IS NOT NULL THEN LEAST(100, 100.0 / (1 + EXTRACT(epoch FROM (qm.first_answer_date - qm.CreationDate))/3600.0)) ELSE 10 END) AS first_answer_factor,
    (
      COALESCE(qm.raw_score,0) * (1 + LN(GREATEST(qm.ViewCount,1))) +
      (GREATEST(COALESCE(qm.upvotes,0) - COALESCE(qm.downvotes,0),0) * 50) +
      (COALESCE(qm.favorites,0) * 30) +
      (CASE WHEN qm.AcceptedAnswerId IS NOT NULL THEN 400 ELSE 0 END) +
      (COALESCE(qm.total_edits,0) * 5) +
      (COALESCE(qm.incoming_links,0) * 40) +
      (COALESCE(qm.top_answer_score,0) * 20) +
      (LEAST(100, 100.0 / (1 + COALESCE(EXTRACT(epoch FROM (qm.first_answer_date - qm.CreationDate))/3600.0, 1)))) -
      (COALESCE(qm.downvotes,0) * 30)
    ) * (1 + (COALESCE(qm.owner_reputation,0) / NULLIF(10000 + COALESCE(qm.owner_reputation,0), 0))) AS impact_score
  FROM question_metrics qm
),
per_tag_top AS (
  SELECT pt.question_id, pt.tag
  FROM per_question_top_tag pt
  WHERE pt.rn = 1
),
tag_summary AS (
  SELECT tp.tag, tp.questions_with_tag, tp.total_views_for_tag, tp.avg_question_score,
    ROW_NUMBER() OVER (ORDER BY tp.questions_with_tag DESC) AS tag_pop_rank
  FROM tag_popularity tp
),
dup_summary AS (
  SELECT pl.PostId AS source_post, COUNT(*) AS duplicate_count
  FROM PostLinks pl
  WHERE pl.LinkTypeId = 3
  GROUP BY pl.PostId
),
activity_score_prep AS (
  SELECT i.question_id, i.impact_score, qm.owner_reputation, qm.owner_name, qm.raw_score, qm.ViewCount, qm.AnswerCount,
    qm.upvotes, qm.downvotes, qm.favorites, qm.total_edits, qm.content_edits, qm.incoming_links, qm.outgoing_links,
    EXTRACT(epoch FROM (i.first_answer_date - qm.CreationDate))/3600.0 AS first_answer_hours,
    EXTRACT(epoch FROM (CAST('2024-10-01 12:34:56' AS timestamp) - qm.CreationDate))/86400.0 AS age_days,
    COALESCE(ds.duplicate_count,0) AS duplicate_count,
    pt.tag AS representative_tag
  FROM impact i
  JOIN question_metrics qm ON qm.question_id = i.question_id
  LEFT JOIN dup_summary ds ON ds.source_post = i.question_id
  LEFT JOIN per_tag_top pt ON pt.question_id = i.question_id
),
activity AS (
  SELECT asp.*,
    (
      (COALESCE(asp.total_edits,0) * 4) +
      (GREATEST(COALESCE(asp.upvotes,0) - COALESCE(asp.downvotes,0),0) * 6) +
      (COALESCE(asp.favorites,0) * 10) +
      (COALESCE(asp.AnswerCount,0) * 15) +
      (COALESCE(asp.ViewCount,0) / NULLIF(GREATEST((SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1), 1), 0) * 5) +
      (COALESCE(asp.duplicate_count,0) * 8) +
      (CASE WHEN asp.first_answer_hours IS NULL THEN 0 ELSE LEAST(50, 50.0 / (1 + asp.first_answer_hours)) END) +
      (CASE WHEN asp.age_days < 7 THEN 20 WHEN asp.age_days < 30 THEN 10 ELSE 0 END)
    ) AS activity_score
  FROM activity_score_prep asp
),
top_by_impact AS (
  SELECT a.question_id, a.representative_tag AS top_tag, a.owner_name, a.owner_reputation, i.impact_score,
    a.activity_score,
    (i.impact_score + a.activity_score) AS combined_score,
    a.raw_score, a.ViewCount, a.AnswerCount, a.upvotes, a.downvotes, a.favorites, a.total_edits, a.incoming_links, a.outgoing_links, a.duplicate_count,
    a.first_answer_hours, a.age_days, qm.ever_closed, (a.upvotes - a.downvotes + a.favorites) AS net_feedback
  FROM activity a
  JOIN impact i ON i.question_id = a.question_id
  JOIN question_metrics qm ON qm.question_id = a.question_id
  ORDER BY i.impact_score DESC NULLS LAST
  LIMIT 100
),
top_by_activity AS (
  SELECT a.question_id, a.representative_tag AS top_tag, a.owner_name, a.owner_reputation, i.impact_score,
    a.activity_score,
    (i.impact_score + a.activity_score) AS combined_score,
    a.raw_score, a.ViewCount, a.AnswerCount, a.upvotes, a.downvotes, a.favorites, a.total_edits, a.incoming_links, a.outgoing_links, a.duplicate_count,
    a.first_answer_hours, a.age_days, qm.ever_closed, (a.upvotes - a.downvotes + a.favorites) AS net_feedback
  FROM activity a
  JOIN impact i ON i.question_id = a.question_id
  JOIN question_metrics qm ON qm.question_id = a.question_id
  ORDER BY a.activity_score DESC NULLS LAST
  LIMIT 100
),
combined AS (
  SELECT CAST('impact' AS text) AS source, tb.* FROM top_by_impact tb
  UNION ALL
  SELECT CAST('activity' AS text) AS source, tb.* FROM top_by_activity tb
),
final_ranks AS (
  SELECT c.*,
    ROW_NUMBER() OVER (ORDER BY combined_score DESC NULLS LAST) AS global_rank,
    DENSE_RANK() OVER (PARTITION BY source ORDER BY combined_score DESC NULLS LAST) AS source_rank,
    RANK() OVER (PARTITION BY COALESCE(top_tag, '(none)') ORDER BY combined_score DESC NULLS LAST) AS tag_rank,
    PERCENT_RANK() OVER (ORDER BY combined_score DESC NULLS LAST) AS percent_of_top
  FROM combined c
)
SELECT
  global_rank,
  source,
  source_rank,
  tag_rank,
  ROUND(CAST(percent_of_top AS numeric),4) AS percent_of_top,
  question_id,
  COALESCE(top_tag,'(none)') AS top_tag,
  owner_name,
  owner_reputation,
  ROUND(CAST(impact_score AS numeric),2) AS impact_score,
  ROUND(CAST(activity_score AS numeric),2) AS activity_score,
  ROUND(CAST(combined_score AS numeric),2) AS combined_score,
  raw_score,
  ViewCount,
  AnswerCount,
  upvotes,
  downvotes,
  favorites,
  total_edits,
  incoming_links,
  outgoing_links,
  duplicate_count,
  ROUND(CAST(COALESCE(first_answer_hours, -1) AS numeric),2) AS first_answer_hours,
  ROUND(CAST(COALESCE(age_days,0) AS numeric),1) AS age_days,
  ever_closed,
  net_feedback
FROM final_ranks
ORDER BY global_rank
LIMIT 200;