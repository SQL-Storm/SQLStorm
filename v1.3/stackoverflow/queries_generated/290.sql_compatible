WITH
recent_questions AS (
  SELECT p.Id, p.Title, p.Tags, p.CreationDate, p.Score, p.ViewCount, p.OwnerUserId,
         p.AcceptedAnswerId, p.AnswerCount, p.CommentCount,
         CASE WHEN p.Tags IS NOT NULL AND length(p.Tags) > 1 THEN string_to_array(substring(p.Tags,2,length(p.Tags)-2), '><') ELSE NULL END AS tag_array
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '2 years'
),
answers AS (
  SELECT a.Id, a.ParentId, a.Score, a.CreationDate, a.OwnerUserId, a.CommentCount,
         ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC NULLS LAST, a.CreationDate ASC) AS answer_rank,
         RANK() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC NULLS LAST) AS answer_rank_ties
  FROM Posts a
  WHERE a.PostTypeId = 2
),
tags_exploded AS (
  SELECT rq.Id AS QuestionId, lower(trim(u.unnested_tag)) AS tag
  FROM recent_questions rq
  CROSS JOIN LATERAL (
    SELECT unnest(rq.tag_array) AS unnested_tag
  ) u
),
user_badge_counts AS (
  SELECT b.UserId,
         count(*) AS total_badges,
         sum(case when b.Class = 1 then 1 else 0 end) AS gold_badges,
         sum(case when b.Class = 3 then 1 else 0 end) AS bronze_badges,
         sum(case when b.TagBased = true then 1 else 0 end) AS tag_badges
  FROM Badges b
  GROUP BY b.UserId
),
top_comments AS (
  SELECT c.PostId, c.Text,
         row_number() OVER (PARTITION BY c.PostId ORDER BY c.Score DESC NULLS LAST, c.CreationDate ASC) rn
  FROM Comments c
),
comment_snippets AS (
  SELECT tc.PostId, substring(tc.Text from 1 for 200) AS top_comment
  FROM top_comments tc
  WHERE tc.rn = 1
),
link_stats AS (
  SELECT pl.PostId,
         count(*) AS total_links,
         sum(case when pl.LinkTypeId = 3 then 1 else 0 end) AS duplicate_links,
         max(pl.RelatedPostId) FILTER (WHERE pl.LinkTypeId = 3) AS any_duplicate_related
  FROM PostLinks pl
  GROUP BY pl.PostId
),
history_stats AS (
  SELECT ph.PostId,
         count(*) AS revisions,
         max(ph.CreationDate) AS last_revision,
         max(ph.UserId) AS last_editor_userid,
         sum(case when ph.PostHistoryTypeId IN (4,5,6) then 1 else 0 end) AS content_edits
  FROM PostHistory ph
  GROUP BY ph.PostId
),
question_metrics AS (
  SELECT
    rq.Id AS Id,
    rq.Title AS Title,
    rq.Tags AS Tags,
    rq.CreationDate AS CreationDate,
    rq.Score AS Score,
    rq.ViewCount AS ViewCount,
    rq.OwnerUserId AS OwnerUserId,
    rq.AcceptedAnswerId AS AcceptedAnswerId,
    rq.AnswerCount AS AnswerCount,
    rq.CommentCount AS CommentCount,
    rq.tag_array AS tag_array,
    COALESCE(rq.ViewCount,0) AS vc,
    COALESCE(rq.Score,0) AS sc,
    COALESCE(rq.AnswerCount,0) AS ac,
    COALESCE(ub.total_badges,0) AS owner_badges,
    COALESCE(ls.total_links,0) AS total_links,
    COALESCE(hs.revisions,0) AS revisions,
    CAST(COALESCE(rq.Score,0) AS numeric) / NULLIF(COALESCE(rq.ViewCount,0),0) AS score_per_view,
    (COALESCE(rq.Score,0) * (1 + COALESCE(ub.total_badges,0)/10.0) + COALESCE(ls.total_links,0)*0.5) AS popularity_raw
  FROM recent_questions rq
  LEFT JOIN Users u ON u.Id = rq.OwnerUserId
  LEFT JOIN user_badge_counts ub ON ub.UserId = rq.OwnerUserId
  LEFT JOIN link_stats ls ON ls.PostId = rq.Id
  LEFT JOIN history_stats hs ON hs.PostId = rq.Id
),
question_answer_agg AS (
  SELECT q.Id AS QuestionId,
         count(a.Id) AS answers_total,
         max(a.Score) AS top_answer_score,
         avg(a.Score) AS avg_answer_score,
         percentile_cont(0.5) WITHIN GROUP (ORDER BY a.Score) AS median_answer_score
  FROM question_metrics q
  LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
  GROUP BY q.Id
),
tag_popularity AS (
  SELECT te.tag,
         count(distinct te.QuestionId) AS questions_with_tag,
         sum(qm.vc) AS tag_views
  FROM tags_exploded te
  JOIN question_metrics qm ON qm.Id = te.QuestionId
  GROUP BY te.tag
),
selected AS (
  SELECT
    qm.Id,
    qm.Title,
    qm.Tags,
    qm.CreationDate,
    qm.sc,
    qm.vc,
    qm.ac,
    qm.owner_badges,
    qm.total_links,
    qm.revisions,
    qa.top_answer_score,
    qa.avg_answer_score,
    qa.median_answer_score,
    cs.top_comment,
    CAST(COALESCE(qm.popularity_raw,0) / NULLIF(GREATEST(qm.vc,1),1) AS numeric) AS popularity_idx,
    CASE
      WHEN qm.sc >= 100 OR qa.top_answer_score >= 50 THEN 'High'
      WHEN qm.sc >= 10 OR qa.top_answer_score >= 10 THEN 'Medium'
      ELSE 'Low'
    END AS quality_band,
    (SELECT string_agg(te.tag, ',' ORDER BY tp.questions_with_tag DESC)
     FROM (
       SELECT DISTINCT te.tag, tp.questions_with_tag
       FROM tags_exploded te
       JOIN tag_popularity tp ON tp.tag = te.tag
       WHERE te.QuestionId = qm.Id
       ORDER BY tp.questions_with_tag DESC
     ) sub(te, questions_with_tag)
    ) AS tags_ranked,
    EXISTS (
      SELECT 1 FROM PostLinks pl WHERE pl.PostId = qm.Id AND pl.LinkTypeId = 3
    ) AS has_duplicate_link,
    (SELECT pl.RelatedPostId FROM PostLinks pl WHERE pl.PostId = qm.Id ORDER BY pl.CreationDate DESC LIMIT 1) AS last_related_post,
    regexp_replace(coalesce(qm.Title,''), E'\\s+', ' ', 'g') AS title_clean
  FROM question_metrics qm
  LEFT JOIN question_answer_agg qa ON qa.QuestionId = qm.Id
  LEFT JOIN comment_snippets cs ON cs.PostId = qm.Id
  WHERE (qm.sc > -1000)
)
SELECT s.Id, s.Title, s.Tags, s.CreationDate, s.sc AS score, s.vc AS views, s.ac AS answer_count,
       s.owner_badges, s.total_links, s.revisions, s.top_answer_score, s.avg_answer_score, s.median_answer_score,
       s.top_comment, s.popularity_idx, s.quality_band, s.tags_ranked, s.has_duplicate_link, s.last_related_post, s.title_clean,
       row_number() OVER (ORDER BY s.popularity_idx DESC) AS rn
FROM selected s
WHERE s.quality_band <> 'Low'

UNION ALL

SELECT s2.Id, s2.Title, s2.Tags, s2.CreationDate, s2.sc AS score, s2.vc AS views, s2.ac AS answer_count,
       s2.owner_badges, s2.total_links, s2.revisions, s2.top_answer_score, s2.avg_answer_score, s2.median_answer_score,
       s2.top_comment, s2.popularity_idx, s2.quality_band, s2.tags_ranked, s2.has_duplicate_link, s2.last_related_post, s2.title_clean,
       row_number() OVER (ORDER BY s2.popularity_idx DESC) + 100000 AS rn
FROM (
  SELECT qm.Id, qm.Title, qm.Tags, qm.CreationDate, qm.sc, qm.vc, qm.ac, qm.owner_badges, qm.total_links, qm.revisions,
         CAST(NULL AS integer) AS top_answer_score, CAST(NULL AS numeric) AS avg_answer_score, CAST(NULL AS numeric) AS median_answer_score,
         CAST(NULL AS varchar) AS top_comment,
         CAST(COALESCE(qm.popularity_raw,0)/NULLIF(GREATEST(qm.vc,1),1) AS numeric) AS popularity_idx,
         'Unanswered' AS quality_band,
         (SELECT string_agg(te.tag,',' ORDER BY tp.questions_with_tag DESC)
          FROM (
            SELECT DISTINCT te.tag, tp.questions_with_tag
            FROM tags_exploded te
            JOIN tag_popularity tp ON tp.tag = te.tag
            WHERE te.QuestionId = qm.Id
            ORDER BY tp.questions_with_tag DESC
          ) sub2(te, questions_with_tag)
         ) AS tags_ranked,
         false AS has_duplicate_link,
         CAST(NULL AS integer) AS last_related_post,
         regexp_replace(coalesce(qm.Title,''), E'\\s+', ' ', 'g') AS title_clean
  FROM question_metrics qm
  WHERE qm.ac = 0 AND qm.vc > 1000
) s2

ORDER BY rn
LIMIT 500;