WITH
question_tags AS (
  SELECT
    q.Id AS question_id,
    q.CreationDate AS question_date,
    q.Score AS qscore,
    q.ViewCount AS qviews,
    q.AcceptedAnswerId,
    q.OwnerUserId AS asker_id,
    LOWER(unnest(string_to_array(substring(q.Tags, 2, length(q.Tags)-2), '><'))) AS tag
  FROM Posts q
  WHERE q.PostTypeId = 1
    AND q.Tags IS NOT NULL
    AND q.Tags <> ''
),
recent_and_legacy AS (
  SELECT qt.*,
         CASE WHEN qt.question_date >= cast('2024-10-01 12:34:56' AS timestamp) - INTERVAL '5 years' THEN 'recent' ELSE 'legacy' END AS era
  FROM question_tags qt
),
answers AS (
  SELECT a.Id AS answer_id,
         a.ParentId AS question_id,
         a.CreationDate AS answer_date,
         a.Score AS answer_score,
         a.OwnerUserId AS answerer_id
  FROM Posts a
  WHERE a.PostTypeId = 2
),
question_stats AS (
  SELECT
    r.question_id,
    r.tag,
    r.question_date,
    r.qscore,
    r.qviews,
    r.AcceptedAnswerId,
    r.asker_id,
    (SELECT COUNT(*) FROM answers a WHERE a.question_id = r.question_id) AS answer_count,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = r.question_id AND v.VoteTypeId = 2) AS upvote_count,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = r.question_id AND v.VoteTypeId = 3) AS downvote_count,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = r.question_id) AS comment_count,
    (SELECT MIN(a.answer_date) FROM answers a WHERE a.question_id = r.question_id) AS first_answer_at,
    CASE WHEN r.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS has_accepted,
    COALESCE(EXTRACT(EPOCH FROM ((SELECT MIN(a.answer_date) FROM answers a WHERE a.question_id = r.question_id) - r.question_date)), NULL) AS secs_to_first_answer,
    (SELECT a.answerer_id FROM answers a WHERE a.question_id = r.question_id ORDER BY a.answer_score DESC NULLS LAST, a.answer_date ASC LIMIT 1) AS top_answerer_id
  FROM recent_and_legacy r
),
tag_agg AS (
  SELECT
    ts.tag,
    COUNT(*) FILTER (WHERE ts.question_date >= cast('2024-10-01 12:34:56' AS timestamp) - INTERVAL '5 years') AS questions_recent,
    COUNT(*) FILTER (WHERE ts.question_date < cast('2024-10-01 12:34:56' AS timestamp) - INTERVAL '5 years') AS questions_legacy,
    COUNT(*) AS total_questions,
    SUM(COALESCE(ts.answer_count, 0)) AS total_answers,
    AVG(COALESCE(ts.qscore, 0)) AS avg_question_score,
    AVG(COALESCE(ts.qviews, 0)) AS avg_views,
    AVG(COALESCE(ts.secs_to_first_answer, NULL)) AS avg_secs_to_first_answer,
    SUM(COALESCE(ts.has_accepted, 0)) AS total_accepted,
    (SUM(CASE WHEN ts.has_accepted = 1 THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(*), 0)) AS accepted_rate,
    percentile_cont(0.5) WITHIN GROUP (ORDER BY ts.qviews) AS median_views,
    BOOL_OR(ts.has_accepted = 1) AS any_accepted
  FROM question_stats ts
  GROUP BY ts.tag
),
tag_answerers AS (
  SELECT sub.tag,
         sub.answerer_id,
         sub.answers_by_user,
         sub.avg_answer_score,
         RANK() OVER (PARTITION BY sub.tag ORDER BY sub.answers_by_user DESC) AS rnk
  FROM (
    SELECT
      qt.tag,
      a.OwnerUserId AS answerer_id,
      COUNT(*) AS answers_by_user,
      AVG(a.Score) AS avg_answer_score
    FROM question_tags qt
    JOIN Posts q ON q.Id = qt.question_id AND q.PostTypeId = 1
    JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    GROUP BY qt.tag, a.OwnerUserId
  ) sub
),
top_tag_answerers AS (
  SELECT tag, answerer_id, answers_by_user, avg_answer_score
  FROM tag_answerers
  WHERE rnk = 1
),
tag_badges AS (
  SELECT LOWER(b.Name) AS tag,
         COUNT(*) AS badge_count,
         SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold,
         SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver,
         SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze
  FROM Badges b
  WHERE b.TagBased = 1
  GROUP BY LOWER(b.Name)
),
top_tags_by_questions AS (
  SELECT tag FROM tag_agg ORDER BY total_questions DESC LIMIT 50
),
top_tags_by_answers AS (
  SELECT tag FROM tag_agg ORDER BY total_answers DESC LIMIT 50
),
union_top_tags AS (
  SELECT tag FROM top_tags_by_questions
  UNION
  SELECT tag FROM top_tags_by_answers
),
intersect_top_tags AS (
  SELECT tag FROM top_tags_by_questions
  INTERSECT
  SELECT tag FROM top_tags_by_answers
),
except_low_activity AS (
  SELECT tag FROM union_top_tags
  EXCEPT
  SELECT tag FROM tag_agg WHERE total_questions < 5
),
tag_combined AS (
  SELECT
    COALESCE(tA.tag, tB.tag) AS tag,
    tA.total_questions,
    tA.total_answers,
    tA.avg_question_score,
    tA.avg_views,
    tA.avg_secs_to_first_answer,
    tA.accepted_rate,
    COALESCE(tB.badge_count, 0) AS badge_count,
    COALESCE(tB.gold, 0) AS gold_badges,
    COALESCE(tB.silver, 0) AS silver_badges,
    COALESCE(tB.bronze, 0) AS bronze_badges
  FROM tag_agg tA
  FULL OUTER JOIN tag_badges tB ON tA.tag = tB.tag
),
user_stats AS (
  SELECT
    u.Id AS user_id,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS total_answers,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS total_questions,
    SUM(p.Score) FILTER (WHERE p.PostTypeId = 2) AS sum_answer_scores,
    AVG(p.Score) FILTER (WHERE p.PostTypeId = 2) AS avg_answer_score,
    MAX(p.LastActivityDate) AS last_activity
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation
),
final_candidates AS (
  SELECT
    tc.tag,
    tc.total_questions,
    tc.total_answers,
    tc.avg_question_score,
    tc.avg_views,
    tc.avg_secs_to_first_answer,
    tc.accepted_rate,
    tc.badge_count,
    tc.gold_badges,
    tc.silver_badges,
    tc.bronze_badges,
    tta.answerer_id AS top_answerer_id
  FROM tag_combined tc
  LEFT JOIN top_tag_answerers tta ON tc.tag = tta.tag
  WHERE tc.total_questions > 0
  ORDER BY tc.total_questions DESC NULLS LAST
  LIMIT 100
)
SELECT
  fc.tag,
  fc.total_questions,
  fc.total_answers,
  ROUND(CAST(fc.avg_question_score AS numeric), 3) AS avg_question_score,
  ROUND(CAST(fc.avg_views AS numeric), 2) AS avg_views,
  ROUND(CAST(fc.avg_secs_to_first_answer AS numeric), 2) AS avg_secs_to_first_answer,
  ROUND(CAST(fc.accepted_rate AS numeric), 3) AS accepted_rate,
  fc.badge_count,
  fc.gold_badges,
  fc.silver_badges,
  fc.bronze_badges,
  us.DisplayName AS top_answerer_name,
  us.Reputation AS top_answerer_reputation,
  us.total_answers AS top_answerer_total_answers,
  RANK() OVER (ORDER BY fc.total_questions DESC) AS tag_popularity_rank,
  PERCENT_RANK() OVER (ORDER BY fc.avg_views DESC) AS views_percent_rank,
  (COALESCE(fc.total_answers,0) * 0.3
   + COALESCE(fc.total_questions,0) * 0.5
   + (COALESCE(fc.badge_count,0) * 5)
   + COALESCE(fc.avg_views,0) / NULLIF(GREATEST(fc.total_questions,1),0)
  ) AS composite_score,
  LEFT(CONCAT(UPPER(SUBSTRING(fc.tag FROM 1 FOR 1)), LOWER(SUBSTRING(fc.tag FROM 2 FOR 100))), 20) AS tag_signature,
  (SELECT COUNT(DISTINCT substring(fc.tag FROM gs.i FOR 1))
   FROM generate_series(1, char_length(fc.tag)) AS gs(i)
  ) AS tag_char_distinct_count,
  CASE
    WHEN fc.accepted_rate >= 0.9 THEN 'excellent'
    WHEN fc.accepted_rate BETWEEN 0.5 AND 0.9 THEN 'good'
    WHEN fc.accepted_rate BETWEEN 0.1 AND 0.5 THEN 'low'
    ELSE 'poor'
  END AS acceptance_category
FROM final_candidates fc
LEFT JOIN user_stats us ON us.user_id = fc.top_answerer_id
WHERE fc.tag IS NOT NULL
ORDER BY composite_score DESC, fc.total_questions DESC
LIMIT 50;