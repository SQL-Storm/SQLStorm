WITH badge_influence AS (
  SELECT
    b.UserId,
    COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
    COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
    COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
    MAX(b.Date) AS LastBadgeDate,
    string_agg(DISTINCT CASE WHEN b.TagBased = TRUE THEN b.Name END, ', ' ORDER BY b.Date DESC) FILTER (WHERE EXISTS (SELECT 1 FROM Badges bb WHERE bb.UserId = b.UserId AND bb.TagBased = TRUE)) AS TagBadges
  FROM Badges b
  GROUP BY b.UserId
),
author_vote_stats AS (
  SELECT
    p.OwnerUserId AS UserId,
    COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS TotalUpvotesReceived,
    COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS TotalDownvotesReceived,
    COUNT(CASE WHEN v.VoteTypeId = 5 THEN 1 END) AS TotalFavoritesReceived,
    SUM(COALESCE(v.BountyAmount,0)) AS TotalBountyReceived
  FROM Posts p
  LEFT JOIN Votes v ON v.PostId = p.Id
  WHERE p.OwnerUserId IS NOT NULL
  GROUP BY p.OwnerUserId
),
duplicate_chains AS (
  SELECT pl.PostId, pl.RelatedPostId, pl.CreationDate, 1 AS depth, ARRAY[pl.PostId, pl.RelatedPostId] AS chain
  FROM PostLinks pl
  WHERE pl.LinkTypeId = 3
  UNION ALL
  SELECT prev.PostId, pl.RelatedPostId, pl.CreationDate, prev.depth + 1,
         prev.chain || pl.RelatedPostId
  FROM duplicate_chains prev
  JOIN PostLinks pl ON pl.PostId = prev.RelatedPostId AND pl.LinkTypeId = 3
  WHERE prev.depth < 5
),
long_duplicate_chains AS (
  SELECT DISTINCT chain, depth, PostId
  FROM duplicate_chains
  WHERE depth >= 2
),
user_rank_signals AS (
  SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    COALESCE(bd.GoldBadges,0) AS GoldBadges,
    COALESCE(bd.SilverBadges,0) AS SilverBadges,
    COALESCE(bd.BronzeBadges,0) AS BronzeBadges,
    COALESCE(av.TotalUpvotesReceived,0) AS UpvotesReceived,
    COALESCE(ua.PostsLast90,0) AS RecentPosts,
    COALESCE(ua.DistinctTagsAuthored,0) AS DistinctTags,
    (
      0.4 * NULLIF(ua.Reputation,0) / GREATEST((SELECT MAX(Reputation) FROM Users),1)
      + 0.25 * (COALESCE(bd.GoldBadges,0)*3 + COALESCE(bd.SilverBadges,0)*2 + COALESCE(bd.BronzeBadges,0)*1)
      + 0.2 * COALESCE(av.TotalUpvotesReceived,0) / GREATEST((SELECT MAX(COALESCE(TotalUpvotesReceived,0)) FROM author_vote_stats),1)
      + 0.15 * (COALESCE(ua.PostsLast90,0) / GREATEST((SELECT MAX(PostsLast90) FROM user_activity),1))
    ) AS EngagementScore,
    bd.LastBadgeDate,
    ua.FirstPostDate
  FROM user_activity ua
  LEFT JOIN badge_influence bd ON bd.UserId = ua.UserId
  LEFT JOIN author_vote_stats av ON av.UserId = ua.UserId
),
top_contributors AS (
  SELECT
    urs.UserId,
    urs.DisplayName,
    urs.Reputation,
    urs.GoldBadges,
    urs.SilverBadges,
    urs.BronzeBadges,
    urs.UpvotesReceived,
    urs.RecentPosts,
    urs.DistinctTags,
    urs.EngagementScore,
    urs.LastBadgeDate,
    urs.FirstPostDate,
    ROW_NUMBER() OVER (PARTITION BY COALESCE(ua.Location,'(none)') ORDER BY urs.EngagementScore DESC NULLS LAST) AS rn,
    COALESCE(ua.Location,'(none)') AS CanonicalLocation
  FROM user_rank_signals urs
  JOIN user_activity ua ON ua.UserId = urs.UserId
)
SELECT
  'TopContributorsByLocation' AS ReportType,
  tc.CanonicalLocation,
  tc.UserId,
  tc.DisplayName,
  ROUND(CAST(tc.EngagementScore AS numeric),6) AS EngagementScore,
  tc.Reputation,
  tc.GoldBadges,
  tc.SilverBadges,
  tc.BronzeBadges,
  tc.UpvotesReceived,
  tc.RecentPosts,
  tc.DistinctTags,
  tc.LastBadgeDate,
  tc.FirstPostDate
FROM top_contributors tc
WHERE tc.rn <= 3
UNION ALL
SELECT
  'LowPerformersRecent' AS ReportType,
  COALESCE(u.Location,'(none)') AS CanonicalLocation,
  u.Id AS UserId,
  u.DisplayName,
  ROUND(
    CAST(
      (
        0.6 * (1.0 - COALESCE(u.Reputation,0) / GREATEST((SELECT MAX(Reputation) FROM Users),1))
        + 0.4 * (1.0 - COALESCE((
            SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days'
          ),0) / GREATEST((SELECT MAX(PostsLast90) FROM user_activity),1))
      ) AS numeric
    ),6
  ) AS EngagementScore,
  u.Reputation,
  COALESCE(b.GoldBadges,0) AS GoldBadges,
  COALESCE(b.SilverBadges,0) AS SilverBadges,
  COALESCE(b.BronzeBadges,0) AS BronzeBadges,
  COALESCE(av.TotalUpvotesReceived,0) AS UpvotesReceived,
  (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days') AS RecentPosts,
  (SELECT COUNT(DISTINCT regexp_split_to_table(substring(p.Tags,2,length(p.Tags)-2),'\\><')) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1 AND p.Tags IS NOT NULL) AS DistinctTags,
  b.LastBadgeDate,
  (SELECT MIN(p.CreationDate) FROM Posts p WHERE p.OwnerUserId = u.Id) AS FirstPostDate
FROM Users u
LEFT JOIN badge_influence b ON b.UserId = u.Id
LEFT JOIN author_vote_stats av ON av.UserId = u.Id
WHERE EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id AND p.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days')
ORDER BY CanonicalLocation, EngagementScore DESC
LIMIT 100;