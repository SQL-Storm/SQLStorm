select count(distinct ph2.userid) from posthistory ph2 where ph2.postid = pg.question_id and ph2.creationdate > CAST('2024-10-01 12:34:56' as timestamp) - interval '90 days') as recent_editors,
    -- string expression on history comments aggregated
    (select string_agg(distinct coalesce(trim(ph3.comment),'[no-comment]') , ' || ') from posthistory ph3 where ph3.postid = pg.question_id and ph3.comment is not null) as history_comments_agg
  from post_graph pg
  left join lateral (
    select ph2.postid, max(ph2.creationdate) as history_date
    from posthistory ph2
    where ph2.postid = pg.question_id
    group by ph2.postid
  ) ph_max on ph_max.postid = pg.question_id
)
select
  fr.*,
  us.displayname,
  us.reputation,
  us.location,
  us.posts_per_year,
  -- tag-based badge density: correlated scalar subquery counting tag-based badges for owner of question if any
  (select count(*) from badges b where b.userid = (select owneruserid from posts where id = fr.question_id) and b.tagbased = 1) as owner_tag_badges,
  -- recent activity timestamp combining last history and last answer
  greatest(coalesce(fr.last_history, CAST('1970-01-01' as timestamp)), coalesce((
    select max(a.creationdate) from posts a where a.parentid = fr.question_id and a.posttypeid = 2
  ), CAST('1970-01-01' as timestamp))) as recent_activity,
  -- ranking and percentile among the selected final set
  row_number() over (order by fr.blended_score desc nulls last, fr.recent_editors desc) as rank_by_blended,
  ntile(10) over (order by fr.blended_score desc) as decile_by_blend
from final_rank fr
left join posts p_owner on p_owner.id = fr.question_id
left join users us on us.id = p_owner.owneruserid
where fr.blended_score is not null
order by fr.blended_score desc, fr.recent_editors desc
limit 250;