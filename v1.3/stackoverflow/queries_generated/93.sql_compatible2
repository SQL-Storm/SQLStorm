with
-- recent active questions with parsed tag array and age metrics
RecentQuestions as (
  select
    p.id,
    p.title,
    p.tags,
    -- split tags like '<tag1><tag2>' into array elements
    regexp_split_to_array(substring(p.tags from 2 for char_length(p.tags)-2), '><') as tag_arr,
    p.owneruserid,
    p.creationdate,
    p.lastactivitydate,
    extract(epoch from cast('2024-10-01 12:34:56' as timestamp) - p.creationdate) / 86400.0 as age_days,
    p.viewcount,
    p.score,
    p.answercount,
    p.favoritecount
  from posts p
  where p.posttypeid = 1
    and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
    and p.viewcount is not null
),
-- aggregate user stats (including null-safe computations)
UserAgg as (
  select
    u.id as userid,
    u.displayname,
    u.reputation,
    coalesce(u.views,0) as profile_views,
    coalesce(u.upvotes,0) as upvotes,
    coalesce(u.downvotes,0) as downvotes,
    -- diversity: number of distinct tags they have participated in (via answers to questions with tags)
    (select count(distinct tag) from (
       select unnest(regexp_split_to_array(substring(q.tags from 2 for char_length(q.tags)-2), '><')) as tag
       from posts q
       join posts a on a.parentid = q.id
       where a.owneruserid = u.id and q.posttypeid = 1
         and q.tags is not null
    ) t) as distinct_answer_tags,
    -- recency: days since last access
    extract(epoch from cast('2024-10-01 12:34:56' as timestamp) - u.lastaccessdate) / 86400.0 as days_since_last_access
  from users u
),
-- windowed ranking of answers per question with lateral correlated subquery for body length and spammy heuristics
AnswerRanked as (
  select
    a.id as answer_id,
    a.parentid as question_id,
    a.owneruserid as answer_owner,
    a.creationdate,
    a.score,
    a.commentcount,
    length(coalesce(a.body,'')) as body_len,
    -- a heuristic: proportion of HTML tags vs text (naive)
    case when length(coalesce(a.body,'')) = 0 then 0.0
         else greatest(0.0, least(1.0,
           (length(regexp_replace(coalesce(a.body,''),'[^<>]','','g'))::numeric / nullif(length(coalesce(a.body,'')),0) )
         )) end as html_noise_ratio,
    row_number() over (partition by a.parentid order by a.score desc, a.creationdate asc) as rn_by_score,
    -- correlated exists: does this answer have an accepted mark on its question?
    exists (
      select 1 from posts q where q.id = a.parentid and q.acceptedanswerid = a.id
    ) as is_accepted
  from posts a
  where a.posttypeid = 2
),
-- pick top N answers and compute aggregates per question
TopAnswersPerQuestion as (
  select
    ar.question_id,
    count(*) filter (where ar.rn_by_score <= 5) as top5_count,
    avg(ar.score) filter (where ar.rn_by_score <= 5) as top5_mean_score,
    max(ar.html_noise_ratio) filter (where ar.rn_by_score <= 5) as top5_max_noise,
    sum(case when ar.is_accepted then 1 else 0 end) as accepted_count_all
  from AnswerRanked ar
  group by ar.question_id
),
-- link graph metrics: number of inbound/outbound post links, duplicates, and cycles (simple heuristic via self-join)
PostLinkStats as (
  select
    p.id,
    coalesce(pl_out.out_count,0) as out_links,
    coalesce(pl_in.in_count,0) as in_links,
    coalesce(pl_dup.out_dup,0) as out_dup_links,
    coalesce(pl_dup_in.in_dup,0) as in_dup_links,
    -- cycle if post links to a related post that links back
    coalesce(pl_cycle.cycle_count,0) as mutual_link_pairs
  from posts p
  left join (
    select postid, count(*) as out_count from postlinks group by postid
  ) pl_out on pl_out.postid = p.id
  left join (
    select relatedpostid as pid, count(*) as in_count from postlinks group by relatedpostid
  ) pl_in on pl_in.pid = p.id
  left join (
    select postid,
           sum(case when linktypeid = 3 then 1 else 0 end) as out_dup
    from postlinks group by postid
  ) pl_dup on pl_dup.postid = p.id
  left join (
    select relatedpostid as pid, sum(case when linktypeid = 3 then 1 else 0 end) as in_dup
    from postlinks group by relatedpostid
  ) pl_dup_in on pl_dup_in.pid = p.id
  left join (
    select l1.postid, count(*) as cycle_count
    from postlinks l1
    join postlinks l2 on l2.postid = l1.relatedpostid and l2.relatedpostid = l1.postid
    group by l1.postid
  ) pl_cycle on pl_cycle.postid = p.id
),
-- compute tag popularity with set operators and string expressions
TagPopularity as (
  select
    t.tagname,
    t.id as tagid,
    t.count as tag_count,
    coalesce(tp.q_count,0) as question_count,
    coalesce(tp.avg_views,0) as avg_question_views,
    -- most recent question title for the tag
    (select title from posts pq
     where pq.posttypeid = 1 and pq.tags like '%' || '<' || t.tagname || '>' || '%'
     order by pq.creationdate desc limit 1) as most_recent_title
  from tags t
  left join (
    select
      unnest(regexp_split_to_array(substring(p.tags from 2 for char_length(p.tags)-2), '><')) as tag,
      count(*) as q_count,
      avg(p.viewcount) as avg_views
    from posts p
    where p.posttypeid = 1
    group by 1
  ) tp on tp.tag = t.tagname
),
-- label suspicious posts by combining many predicates
SuspiciousPosts as (
  select
    p.id,
    p.title,
    p.owneruserid,
    p.creationdate,
    p.score,
    pls.out_links,
    pls.in_links,
    case
      when p.owneruserid is null then 'deleted_owner'
      when p.score < 0 and coalesce(p.viewcount,0) < 10 then 'low_score_low_views'
      when pls.out_dup_links + pls.in_dup_links > 0 then 'dup_linked'
      when length(coalesce(p.body,'')) < 50 and p.posttypeid = 1 then 'short_body_question'
      when exists (select 1 from votes v where v.postid = p.id and v.votetypeid = 4) then 'offensive_flagged'
      else null
    end as suspicion_label
  from posts p
  left join PostLinkStats pls on pls.id = p.id
),
-- final join and heavy analytics with window functions, set operators, and correlated subqueries
FinalResult as (
  select
    rq.id as question_id,
    rq.title,
    rq.owneruserid,
    ua.displayname,
    ua.reputation,
    rq.age_days,
    rq.viewcount,
    rq.score,
    coalesce(tap.top5_count,0) as top5_answer_count,
    coalesce(tap.top5_mean_score,0) as top5_mean_answer_score,
    coalesce(psl.suspicion_label,'ok') as suspicion,
    -- tag explosion: keep first three tags concatenated, with fallback
    (case
      when cardinality(rq.tag_arr) = 0 then '(no-tags)'
      when cardinality(rq.tag_arr) = 1 then rq.tag_arr[1]
      when cardinality(rq.tag_arr) = 2 then rq.tag_arr[1] || ',' || rq.tag_arr[2]
      else rq.tag_arr[1] || ',' || rq.tag_arr[2] || ',' || rq.tag_arr[3]
    end) as tag_preview,
    -- percent rank of views among recent questions
    percent_rank() over (order by rq.viewcount) as view_pr,
    -- popularity band via NTILE
    ntile(5) over (order by rq.viewcount desc nulls last) as view_band,
    -- correlated scalar: count of distinct users who answered this question
    (select count(distinct a.owneruserid) from posts a where a.parentid = rq.id and a.posttypeid = 2 and a.owneruserid is not null) as distinct_answering_users,
    -- existence of accepted answer and its owner's reputation (correlated subquery)
    (select u.reputation from posts q join users u on u.id = q.acceptedanswerid where q.id = rq.id and q.acceptedanswerid is not null limit 1) as accepted_owner_rep,
    -- whether any top answer is accepted
    (select bool_or(a.id = rq.id) from posts a where a.parentid = rq.id and a.id = (select q.acceptedanswerid from posts q where q.id = rq.id)) as weird_boolean_check,
    -- compute a synthetic complexity score using many expressions and null logic
    (coalesce(rq.score,0) * 2
     + coalesce(rq.answercount,0) * 3
     + coalesce(tap.top5_mean_score,0) * 1.5
     - coalesce(ua.days_since_last_access, 365) / 30
     + case when pld.mutual_link_pairs > 0 then 5 else 0 end
     - case when psl.suspicion_label is not null then 10 else 0 end
    ) * 1.0 as complexity_score
  from RecentQuestions rq
  left join UserAgg ua on ua.userid = rq.owneruserid
  left join TopAnswersPerQuestion tap on tap.question_id = rq.id
  left join SuspiciousPosts psl on psl.id = rq.id
  left join PostLinkStats pld on pld.id = rq.id
)
select
  fr.*,
  tp.tag_count as tag_global_count,
  tp.avg_question_views as tag_avg_views,
  -- join to top tag popularity via first tag
  case when fr.tag_preview = '(no-tags)' then null
       else (select tagid from tags t where t.tagname = split_part(fr.tag_preview,',',1) limit 1)
  end as top_tag_id
from FinalResult fr
left join TagPopularity tp on tp.tagname = split_part(fr.tag_preview,',',1)
order by fr.complexity_score desc, fr.viewcount desc
limit 250;