with
QuestionTags as (
  select
    p.Id as QuestionId,
    p.Title,
    p.CreationDate,
    coalesce(p.Score,0) as Score,
    coalesce(p.ViewCount,0) as Views,
    regexp_split_to_table(substring(coalesce(p.Tags,''),2,length(coalesce(p.Tags,''))-2), '><') as Tag
  from Posts p
  where p.PostTypeId = 1
),
UserAgg as (
  select
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    count(b.Id) filter (where b.Class = 1) as GoldBadges,
    count(b.Id) filter (where b.Class = 2) as SilverBadges,
    count(b.Id) filter (where b.Class = 3) as BronzeBadges,
    sum(case when v.VoteTypeId = 2 then 1 when v.VoteTypeId = 3 then -1 else 0 end) as VoteSentiment,
    row_number() over (partition by u.Id order by coalesce(c.CreationDate, timestamp '1970-01-01') desc) as LastCommentRank,
    max(c.CreationDate) as LastCommentDate
  from Users u
  left join Badges b on b.UserId = u.Id
  left join Votes v on v.UserId = u.Id
  left join Comments c on c.UserId = u.Id
  group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
QuestionAnswers as (
  select
    q.Id as QuestionId,
    count(a.Id) filter (where a.PostTypeId = 2) as AnswerCount,
    max(a.Score) filter (where a.PostTypeId = 2) as TopAnswerScore,
    sum(a.Score) filter (where a.PostTypeId = 2) as AnswerScoreSum,
    qa.Id as AcceptedAnswerId
  from Posts q
  left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
  left join Posts qa on qa.Id = q.AcceptedAnswerId
  where q.PostTypeId = 1
  group by q.Id, qa.Id
),
PostEditors as (
  select distinct on (ph.PostId, ph.UserId)
    ph.PostId,
    ph.UserId,
    ph.PostHistoryTypeId,
    ph.CreationDate as EditDate,
    ph.Comment,
    lead(ph.CreationDate) over (partition by ph.PostId order by ph.CreationDate desc) as PrevEditDate
  from PostHistory ph
  where ph.PostId is not null
  order by ph.PostId, ph.UserId, ph.CreationDate desc
),
TitleFingerprint as (
  select
    q.Id as QuestionId,
    lower(regexp_replace(coalesce(q.Title,''), '[^a-z0-9 ]', '', 'g')) as CleanTitle,
    substr(lower(regexp_replace(coalesce(q.Title,''), '[^a-z0-9 ]', '', 'g')),1,50) as ShortFingerprint,
    length(coalesce(q.Title,'')) as TitleLen,
    case
      when q.Title is null then 'NO_TITLE'
      when q.Title ~* '\b(java|python|c#|c\+\+|sql)\b' then 'HAS_LANG'
      else 'OTHER'
    end as TitleClass
  from Posts q
  where q.PostTypeId = 1
),
TagRank as (
  select
    qt.Tag,
    count(distinct qt.QuestionId) as Questions,
    sum(qt.Score) as ScoreSum,
    sum(qt.Views) as ViewSum,
    avg(qt.Score) as AvgScore,
    percentile_cont(0.5) within group (order by qt.Score) as MedianScore,
    rank() over (order by sum(qt.Views) desc, sum(qt.Score) desc) as PopularRank
  from QuestionTags qt
  group by qt.Tag
),
ComplexBase as (
  select
    q.Id as QuestionId,
    q.Title,
    q.CreationDate,
    q.OwnerUserId,
    ta.Tag,
    tf.CleanTitle,
    tf.ShortFingerprint,
    tf.TitleLen,
    tf.TitleClass,
    qa.AnswerCount,
    qa.TopAnswerScore,
    qa.AnswerScoreSum,
    coalesce(ta.Score,0) as QuestionScore,
    coalesce(ta.Views,0) as QuestionViews,
    tr.Questions as TagQuestionCount,
    tr.PopularRank
  from Posts q
  left join QuestionTags ta on ta.QuestionId = q.Id
  left join TitleFingerprint tf on tf.QuestionId = q.Id
  left join QuestionAnswers qa on qa.QuestionId = q.Id
  left join TagRank tr on tr.Tag = ta.Tag
  where q.PostTypeId = 1
),
Metrics as (
  select
    cb.QuestionId,
    cb.Title,
    cb.CreationDate,
    cb.OwnerUserId,
    cb.Tag,
    cb.CleanTitle,
    cb.ShortFingerprint,
    cb.TitleLen,
    cb.TitleClass,
    cb.AnswerCount,
    cb.TopAnswerScore,
    cb.AnswerScoreSum,
    cb.QuestionScore,
    cb.QuestionViews,
    cb.TagQuestionCount,
    cb.PopularRank,
    ua.DisplayName as OwnerName,
    ua.Reputation as OwnerReputation,
    ua.GoldBadges,
    ua.SilverBadges,
    ua.BronzeBadges,
    sum(case when cb.CreationDate >= (timestamp '2024-10-01 12:34:56' - interval '90 days') then 1 else 0 end) over (partition by cb.Tag order by cb.CreationDate rows between unbounded preceding and current row) as RecentQuestionsForTag,
    rank() over (partition by cb.Tag order by (coalesce(cb.QuestionScore,0)*2 + coalesce(cb.QuestionViews,0)/100.0 + coalesce(cb.TopAnswerScore,0)) desc) as TagCompoundRank,
    (select count(distinct a.OwnerUserId)
     from Posts a
     join Posts q2 on q2.Id = a.ParentId and q2.OwnerUserId = cb.OwnerUserId
     where a.PostTypeId = 2
       and a.CreationDate >= (timestamp '2024-10-01 12:34:56' - interval '1 year')
       and a.Score >= 0
    ) as DistinctAnswerersLastYear,
    exists (
      select 1 from PostLinks pl
      where pl.PostId = cb.QuestionId and pl.LinkTypeId = 3
    ) as IsMarkedDuplicate,
    trim(
      coalesce(cb.Title, '') || ' | tags: ' || coalesce(cb.Tag,'') || ' | fp=' || coalesce(cb.ShortFingerprint,'-') ||
      ' | rank=' || coalesce(cast(rank() over (partition by cb.Tag order by cb.QuestionViews desc) as text), '0')
    ) as SyntheticSummary
  from ComplexBase cb
  left join UserAgg ua on ua.UserId = cb.OwnerUserId
  group by
    cb.QuestionId, cb.Title, cb.CreationDate, cb.OwnerUserId, cb.Tag, cb.CleanTitle, cb.ShortFingerprint, cb.TitleLen, cb.TitleClass,
    cb.AnswerCount, cb.TopAnswerScore, cb.AnswerScoreSum, cb.QuestionScore, cb.QuestionViews, cb.TagQuestionCount, cb.PopularRank,
    ua.DisplayName, ua.Reputation, ua.GoldBadges, ua.SilverBadges, ua.BronzeBadges
),
FinalSet as (
  select
    m.QuestionId,
    m.Title,
    m.OwnerName,
    m.OwnerReputation,
    m.Tag,
    m.QuestionScore,
    m.QuestionViews,
    m.AnswerCount,
    m.TopAnswerScore,
    m.TagCompoundRank,
    m.PopularRank,
    m.RecentQuestionsForTag,
    m.DistinctAnswerersLastYear,
    m.IsMarkedDuplicate,
    m.SyntheticSummary,
    row_number() over (partition by m.Tag order by m.QuestionScore desc, m.QuestionViews desc) as RowInTag
  from Metrics m
  where m.QuestionScore is not null
    and m.QuestionViews > 0
    and (m.TitleClass = 'HAS_LANG' or lower(m.Tag) like '%sql%')
),
FinalSetGrouped AS (
  select
    fs.QuestionId,
    fs.Title,
    fs.OwnerName,
    fs.OwnerReputation,
    fs.Tag,
    fs.QuestionScore,
    fs.QuestionViews,
    fs.AnswerCount,
    fs.TopAnswerScore,
    fs.TagCompoundRank,
    fs.PopularRank,
    fs.RecentQuestionsForTag,
    fs.DistinctAnswerersLastYear,
    fs.IsMarkedDuplicate,
    fs.SyntheticSummary,
    fs.RowInTag
  from FinalSet fs
  group by
    fs.QuestionId, fs.Title, fs.OwnerName, fs.OwnerReputation, fs.Tag, fs.QuestionScore, fs.QuestionViews,
    fs.AnswerCount, fs.TopAnswerScore, fs.TagCompoundRank, fs.PopularRank, fs.RecentQuestionsForTag,
    fs.DistinctAnswerersLastYear, fs.IsMarkedDuplicate, fs.SyntheticSummary, fs.RowInTag
)
select
  fs.QuestionId,
  fs.Title,
  fs.OwnerName,
  fs.OwnerReputation,
  fs.Tag,
  fs.QuestionScore,
  fs.QuestionViews,
  fs.AnswerCount,
  fs.TopAnswerScore,
  fs.TagCompoundRank,
  fs.PopularRank,
  fs.RecentQuestionsForTag,
  fs.DistinctAnswerersLastYear,
  fs.IsMarkedDuplicate,
  fs.SyntheticSummary,
  fs.RowInTag,
  dense_rank() over (order by (coalesce(fs.QuestionScore,0)*3 + coalesce(fs.QuestionViews,0)/50.0 + coalesce(fs.TopAnswerScore,0)*2 + coalesce(fs.OwnerReputation,0)/1000.0) desc) as GlobalPopularityRank,
  ntile(100) over (order by (coalesce(fs.QuestionScore,0)*3 + coalesce(fs.QuestionViews,0)/50.0) desc) as PopularityPercentile
from FinalSetGrouped fs
where fs.RowInTag <= 25
order by GlobalPopularityRank, fs.Tag, fs.TagCompoundRank;