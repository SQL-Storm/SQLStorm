SELECT q.Id AS QuestionId,
         lower(trim(tg)) AS tag
  FROM recent_q q,
       unnest(q.tag_list) AS tg
),
tag_metrics AS (
  SELECT te.tag,
         count(distinct te.QuestionId) AS questions_in_period,
         avg(coalesce(p.Score,0)) FILTER (WHERE p.PostTypeId = 1) AS avg_question_score,
         sum(coalesce(p.ViewCount,0)) AS total_views
  FROM tags_exploded te
  JOIN Posts p ON p.Id = te.QuestionId
  GROUP BY te.tag
),
top_tags_candidates AS (
  SELECT tag FROM tag_metrics WHERE questions_in_period >= 3
  EXCEPT
  SELECT t.TagName FROM Tags t WHERE t.Count < 50
),
question_scoring AS (
  SELECT q.Id AS QuestionId,
         q.q_title,
         q.CreationDate,
         q.Score AS question_score,
         coalesce(a.answer_count,0) AS answer_count,
         coalesce(a.avg_answer_score,0) AS avg_answer_score,
         coalesce(a.median_answer_score,0) AS median_answer_score,
         coalesce(act.answers_last_30d,0) AS answers_30d,
         coalesce(pls.outgoing_duplicate_links,0) AS outgoing_dup,
         coalesce(pls.incoming_count,0) AS incoming_links,
         coalesce(hs.history_revisions,0) AS revisions,
         length(q.q_title) AS title_len,
         (CASE WHEN position('?' IN q.q_title) > 0 THEN 1 ELSE 0 END) AS has_question_mark,
         (CASE WHEN q.q_body ~* '<code>' THEN 1 ELSE 0 END) AS has_code_block,
         (CASE WHEN (q.q_title || ' ' || q.q_body) ~* '\m(homework|urgent|plz|please help|help me)\M' THEN 1 ELSE 0 END) AS contains_help_tokens,
         (
           coalesce(q.Score,0) * 1.5
           + ln(coalesce(NULLIF(q.ViewCount,0),1) + 1) * 2.0
           + (coalesce(a.answer_count,0) * 3.0)
           + (coalesce(a.avg_answer_score,0) * 1.2)
           + (coalesce(act.answers_last_7d,0) * 2.5)
           - (coalesce(pls.outgoing_duplicate_links,0) * 5.0)
           - (coalesce(hs.history_revisions,0) * 0.4)
           - (CASE WHEN (q.CreationDate < CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '180 days' AND coalesce(act.answers_last_30d,0) = 0) THEN 10 ELSE 0 END)
           - (CASE WHEN (q.Score < 0) THEN 8 ELSE 0 END)
           - (CASE WHEN (q.q_body IS NULL OR q.q_body = '') THEN 20 ELSE 0 END)
           - (CASE WHEN ( (q.q_title || ' ' || q.q_body) ~* '\m(homework|urgent|plz|please help|help me)\M' ) THEN 6 ELSE 0 END)
         ) AS composite_score
  FROM recent_q q
  LEFT JOIN answer_stats a ON a.QuestionId = q.Id
  LEFT JOIN answer_activity act ON act.QuestionId = q.Id
  LEFT JOIN post_links_stats pls ON pls.PostId = q.Id
  LEFT JOIN history_significance hs ON hs.PostId = q.Id
),
per_tag_ranks AS (
  SELECT te.tag,
         qs.QuestionId,
         qs.q_title,
         qs.CreationDate,
         qs.question_score,
         qs.answer_count,
         qs.avg_answer_score,
         qs.median_answer_score,
         qs.answers_30d,
         qs.outgoing_dup,
         qs.incoming_links,
         qs.revisions,
         qs.title_len,
         qs.has_question_mark,
         qs.has_code_block,
         qs.contains_help_tokens,
         qs.composite_score,
         row_number() OVER (PARTITION BY te.tag ORDER BY qs.composite_score DESC, qs.answer_count DESC, qs.question_score DESC) AS tag_rank,
         dense_rank() OVER (PARTITION BY te.tag ORDER BY qs.composite_score DESC) AS tag_dense_rank
  FROM tags_exploded te
  JOIN question_scoring qs ON qs.QuestionId = te.QuestionId
  WHERE te.tag IN (SELECT tag FROM top_tags_candidates)
),
top_per_tag AS (
  SELECT tag,
         count(*) AS tag_questions_sampled,
         avg(composite_score) AS avg_composite_score,
         max(composite_score) AS max_composite_score,
         min(composite_score) AS min_composite_score,
         jsonb_agg(jsonb_build_object('id', QuestionId, 'title', q_title, 'score', composite_score) ORDER BY composite_score DESC) FILTER (WHERE true) AS top_examples
  FROM per_tag_ranks
  WHERE tag_rank <= 25
  GROUP BY tag
),
final_candidates AS (
  SELECT DISTINCT qs.QuestionId,
         qs.q_title,
         qs.CreationDate,
         qs.question_score,
         qs.answer_count,
         qs.avg_answer_score,
         qs.median_answer_score,
         qs.answers_30d,
         qs.incoming_links,
         qs.outgoing_dup,
         qs.revisions,
         qs.has_code_block,
         qs.contains_help_tokens,
         qs.composite_score,
         u.DisplayName AS owner_name,
         u.Reputation AS owner_reputation,
         (SELECT count(DISTINCT c.UserId) FROM Comments c WHERE c.PostId = qs.QuestionId AND c.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 days') AS recent_unique_commenters,
         (SELECT count(*) FROM Votes v WHERE v.PostId = qs.QuestionId AND v.VoteTypeId = 2) AS upvotes_count,
         (SELECT count(*) FROM Votes v WHERE v.PostId = qs.QuestionId AND v.VoteTypeId = 3) AS downvotes_count,
         (CASE WHEN qs.answer_count = 0 AND qs.CreationDate < CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '365 days' THEN true ELSE false END) AS is_stale,
         qs.q_title || COALESCE('', '') AS q_body -- include q_body reference for downstream hash usage
  FROM question_scoring qs
  LEFT JOIN Users u ON u.Id = (SELECT p.OwnerUserId FROM Posts p WHERE p.Id = qs.QuestionId)
  LEFT JOIN tags_exploded te ON te.QuestionId = qs.QuestionId
  WHERE qs.QuestionId IN (
    SELECT QuestionId FROM per_tag_ranks WHERE tag_rank <= 10
    UNION
    SELECT QuestionId FROM question_scoring WHERE composite_score > 50
  )
),
final_ranked AS (
  SELECT fc.*,
         row_number() OVER (ORDER BY fc.is_stale ASC, fc.composite_score DESC, fc.recent_unique_commenters DESC, md5(coalesce(fc.q_title,'') || coalesce(fc.q_body,''))) AS overall_rank
  FROM final_candidates fc
)
SELECT fr.overall_rank,
       fr.QuestionId,
       left(fr.q_title, 200) AS title_snippet,
       fr.CreationDate,
       fr.question_score,
       fr.answer_count,
       fr.avg_answer_score,
       fr.median_answer_score,
       fr.answers_30d,
       fr.incoming_links,
       fr.outgoing_dup,
       fr.revisions,
       fr.has_code_block,
       fr.contains_help_tokens,
       fr.composite_score,
       fr.owner_name,
       fr.owner_reputation,
       fr.recent_unique_commenters,
       fr.upvotes_count,
       fr.downvotes_count,
       fr.is_stale
FROM final_ranked fr
ORDER BY fr.overall_rank
LIMIT 250;