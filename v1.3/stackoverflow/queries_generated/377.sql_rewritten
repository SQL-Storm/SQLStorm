-- {"query": "377.sql", "dataset": "stackoverflow", "version": "v1.3", "prompt": "p1", "model": "gpt-5-mini", "temperature": 1.0, "max_tokens": 32768, "reasoning": "high", "input_tokens": 2026, "output_tokens": 15292} 
WITH
recent_questions AS (
  SELECT p.*
  FROM posts p
  WHERE p.PostTypeId = 1
    AND COALESCE(p.CreationDate, p.LastActivityDate) >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months'
),
exploded_tags AS (
  SELECT q.Id AS QuestionId,
         trim(tag) AS Tag
  FROM recent_questions q
  CROSS JOIN LATERAL regexp_split_to_table(
    substring(coalesce(q.Tags, ''), 2, GREATEST(char_length(coalesce(q.Tags, '')) - 2, 0)),
    '><'
  ) AS tag
  WHERE q.Tags IS NOT NULL AND q.Tags <> ''
),
answers_stats AS (
  SELECT a.Id AS AnswerId,
         a.ParentId AS QuestionId,
         a.OwnerUserId AS AnswererId,
         a.Score AS AnswerScore,
         a.CreationDate AS AnswerCreationDate,
         q.CreationDate AS QuestionCreationDate,
         EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate)) AS SecondsToAnswer,
         CASE WHEN q.AcceptedAnswerId = a.Id THEN 1 ELSE 0 END AS IsAccepted,
         ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC NULLS LAST, a.CreationDate ASC) AS AnswerRankByScore,
         RANK() OVER (PARTITION BY a.ParentId ORDER BY a.CreationDate ASC) AS AnswerChronoRank,
         NTILE(5) OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC NULLS LAST) AS ScoreQuintile,
         PERCENT_RANK() OVER (PARTITION BY a.ParentId ORDER BY a.Score) AS ScorePercentRank
  FROM posts a
  JOIN posts q ON q.Id = a.ParentId
  WHERE a.PostTypeId = 2
),
user_agg AS (
  SELECT u.Id AS UserId,
         u.DisplayName,
         u.Reputation,
         u.CreationDate,
         u.LastAccessDate,
         COALESCE(COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId IN (1,2)), 0) AS NumPosts,
         COALESCE(COUNT(b.Id), 0) AS NumBadges,
         COALESCE(SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END), 0) AS GoldBadges,
         COALESCE(SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END), 0) AS SilverBadges,
         COALESCE(SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END), 0) AS BronzeBadges,
         COALESCE(AVG(p.Score)::numeric, 0) AS AvgPostScore,
         COALESCE(COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 2), 0) AS UpVotesGiven
  FROM users u
  LEFT JOIN posts p ON p.OwnerUserId = u.Id
  LEFT JOIN badges b ON b.UserId = u.Id
  LEFT JOIN votes v ON v.UserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
tag_leaders AS (
  SELECT Tag, AnswererId, AnswersByUserInTag, TotalScoreInTag,
         ROW_NUMBER() OVER (PARTITION BY Tag ORDER BY TotalScoreInTag DESC NULLS LAST) AS TagRank
  FROM (
    SELECT et.Tag, a.AnswererId, COUNT(*) AS AnswersByUserInTag, SUM(a.AnswerScore) AS TotalScoreInTag
    FROM answers_stats a
    JOIN exploded_tags et ON et.QuestionId = a.QuestionId
    GROUP BY et.Tag, a.AnswererId
  ) sub
),
question_metrics AS (
  SELECT q.Id AS QuestionId,
         q.Title,
         q.OwnerUserId,
         q.CreationDate,
         q.Score AS QuestionScore,
         q.ViewCount,
         COALESCE(a.ACount, 0) AS AnswerCount,
         COALESCE(a.AcceptedAnswerCount, 0) AS AcceptedCount,
         COALESCE(vs.UpVotes, 0) AS UpVotes,
         COALESCE(vs.DownVotes, 0) AS DownVotes,
         COALESCE(pl.DupLinks, 0) AS DuplicateLinks,
         COALESCE(cmt.CommentCount, 0) AS CommentCount,
         et.Tag,
         q.Tags,
         (SELECT EXTRACT(EPOCH FROM MIN(ans.CreationDate - q2.CreationDate))
          FROM posts ans
          JOIN posts q2 ON q2.Id = ans.ParentId
          WHERE ans.ParentId = q.Id AND ans.PostTypeId = 2
         ) AS SecondsToFirstAnswer,
         (SELECT COUNT(DISTINCT v2.UserId) FROM votes v2 WHERE v2.PostId = q.Id AND v2.VoteTypeId = 2) AS DistinctUpvoters,
         (SELECT CASE WHEN COUNT(*) = 0 THEN NULL ELSE ROUND(100.0 * SUM(CASE WHEN EXTRACT(EPOCH FROM (ans.CreationDate - q3.CreationDate)) <= 86400 THEN 1 ELSE 0 END) / COUNT(*)::numeric, 2) END
          FROM posts ans
          JOIN posts q3 ON q3.Id = ans.ParentId
          WHERE ans.ParentId = q.Id AND ans.PostTypeId = 2
         ) AS PercentAnswersWithin24h
  FROM recent_questions q
  LEFT JOIN (
    SELECT QuestionId, COUNT(*) AS ACount, SUM(IsAccepted) AS AcceptedAnswerCount
    FROM answers_stats
    GROUP BY QuestionId
  ) a ON a.QuestionId = q.Id
  LEFT JOIN (
    SELECT PostId,
           SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
           SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
    FROM votes
    GROUP BY PostId
  ) vs ON vs.PostId = q.Id
  LEFT JOIN (
    SELECT pl.PostId, SUM(CASE WHEN pl.LinkTypeId = 3 THEN 1 ELSE 0 END) AS DupLinks
    FROM postlinks pl
    GROUP BY pl.PostId
  ) pl ON pl.PostId = q.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) AS CommentCount FROM comments GROUP BY PostId
  ) cmt ON cmt.PostId = q.Id
  JOIN exploded_tags et ON et.QuestionId = q.Id
),
full_metrics AS (
  SELECT qm.*,
         ua.DisplayName AS OwnerDisplayName,
         ua.Reputation AS OwnerReputation,
         ua.GoldBadges AS OwnerGoldBadges,
         ua.NumBadges AS OwnerBadgeCount,
         tl.AnswererId AS TagLeaderId,
         tl.AnswersByUserInTag AS TagLeaderAnswers,
         tl.TotalScoreInTag AS TagLeaderTotalScore,
         tl_u.DisplayName AS TagLeaderDisplayName,
         (
           GREATEST(COALESCE(qm.QuestionScore,0),0)::numeric * 1.5
           + COALESCE(qm.AnswerCount,0) * 2.0
           + LEAST(COALESCE(qm.ViewCount,0), 100000)::numeric / 1000.0
           + (COALESCE(qm.UpVotes,0) - COALESCE(qm.DownVotes,0))::numeric
           + COALESCE(ua.GoldBadges,0) * 5
           + COALESCE(qm.DistinctUpvoters,0) * 0.1
           + COALESCE(qm.PercentAnswersWithin24h,0) * 0.2
         ) AS GoodnessScore,
         (
           COALESCE(NULLIF((ABS(COALESCE(qm.UpVotes,0) - COALESCE(qm.DownVotes,0))::numeric / NULLIF((COALESCE(qm.UpVotes,0) + COALESCE(qm.DownVotes,0)), 0)), 0), 0)
           * pow((COALESCE(qm.UpVotes,0) + COALESCE(qm.DownVotes,0))::numeric, 0.5)
           * 10
         ) AS ControversyScore,
         (SELECT COUNT(DISTINCT ph.UserId) FROM posthistory ph WHERE ph.PostId = qm.QuestionId AND ph.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days') AS RecentEditorsCount,
         (SELECT COUNT(*) FROM posthistory ph2 WHERE ph2.PostId = qm.QuestionId AND ph2.PostHistoryTypeId = 10) AS CloseEventsCount
  FROM question_metrics qm
  LEFT JOIN user_agg ua ON ua.UserId = qm.OwnerUserId
  LEFT JOIN (
    SELECT Tag, AnswererId, AnswersByUserInTag, TotalScoreInTag FROM tag_leaders WHERE TagRank = 1
  ) tl ON tl.Tag = qm.Tag
  LEFT JOIN user_agg tl_u ON tl_u.UserId = tl.AnswererId
)
SELECT *
FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY QuestionId ORDER BY CASE WHEN Kind = 'HOT' THEN 1 ELSE 2 END, GoodnessScore DESC NULLS LAST, ControversyScore DESC NULLS LAST) AS KeepRank
  FROM (
    (
      SELECT fm.QuestionId,
             fm.Title,
             fm.Tag,
             fm.OwnerUserId,
             fm.OwnerDisplayName,
             fm.OwnerReputation,
             fm.OwnerGoldBadges,
             fm.OwnerBadgeCount,
             fm.QuestionScore,
             fm.ViewCount,
             fm.AnswerCount,
             fm.AcceptedCount,
             fm.UpVotes,
             fm.DownVotes,
             fm.DuplicateLinks,
             fm.CommentCount,
             fm.SecondsToFirstAnswer,
             fm.DistinctUpvoters,
             fm.PercentAnswersWithin24h,
             fm.RecentEditorsCount,
             fm.CloseEventsCount,
             fm.GoodnessScore,
             fm.ControversyScore,
             fm.TagLeaderId,
             fm.TagLeaderDisplayName,
             fm.TagLeaderAnswers,
             fm.TagLeaderTotalScore,
             'HOT'::text AS Kind
      FROM full_metrics fm
      WHERE fm.GoodnessScore > 10
      ORDER BY fm.GoodnessScore DESC, fm.ViewCount DESC NULLS LAST
      LIMIT 100
    )
    UNION ALL
    (
      SELECT fm.QuestionId,
             fm.Title,
             fm.Tag,
             fm.OwnerUserId,
             fm.OwnerDisplayName,
             fm.OwnerReputation,
             fm.OwnerGoldBadges,
             fm.OwnerBadgeCount,
             fm.QuestionScore,
             fm.ViewCount,
             fm.AnswerCount,
             fm.AcceptedCount,
             fm.UpVotes,
             fm.DownVotes,
             fm.DuplicateLinks,
             fm.CommentCount,
             fm.SecondsToFirstAnswer,
             fm.DistinctUpvoters,
             fm.PercentAnswersWithin24h,
             fm.RecentEditorsCount,
             fm.CloseEventsCount,
             fm.GoodnessScore,
             fm.ControversyScore,
             fm.TagLeaderId,
             fm.TagLeaderDisplayName,
             fm.TagLeaderAnswers,
             fm.TagLeaderTotalScore,
             'CONTROVERSIAL'::text AS Kind
      FROM full_metrics fm
      WHERE fm.ControversyScore > 20
      ORDER BY fm.ControversyScore DESC, fm.AnswerCount DESC
      LIMIT 100
    )
  ) combined
) dedup
WHERE KeepRank = 1
ORDER BY GoodnessScore DESC NULLS LAST, ControversyScore DESC NULLS LAST
LIMIT 200;