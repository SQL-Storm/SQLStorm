with
user_posts as (
  select
    u.id as user_id,
    u.displayname,
    count(p.id) filter (where p.posttypeid = 1) as questions,
    count(p.id) filter (where p.posttypeid = 2) as answers,
    sum(coalesce(p.score,0)) as total_post_score,
    sum(coalesce(p.viewcount,0)) as total_views,
    max(p.creationdate) as last_post_at
  from users u
  left join posts p on p.owneruserid = u.id
  group by u.id, u.displayname
),
recent_activity as (
  select
    p.id,
    p.parentid,
    p.posttypeid,
    p.owneruserid,
    p.creationdate,
    p.score,
    u.id as user_id,
    row_number() over (partition by u.id order by p.creationdate desc) as rn_by_user,
    dense_rank() over (partition by u.id order by p.posttypeid) as type_rank
  from posts p
  join users u on u.id = p.owneruserid
  where p.creationdate >= (cast('2024-10-01 12:34:56' as timestamp) - interval '365 days')
),
badge_summary as (
  select
    b.userid,
    count(*) as badge_count,
    max(b.date) as last_badge_at,
    (select name
     from badges b2
     where b2.userid = b.userid
     group by name
     order by count(*) desc, max(b2.date) desc
     limit 1
    ) as top_badge_name
  from badges b
  group by b.userid
),
tag_usage as (
  select
    p.owneruserid as user_id,
    lower(trim(t)) as tag,
    count(*) as uses
  from posts p
  cross join lateral (
    select unnest(string_to_array(substring(p.tags from 2 for char_length(p.tags)-2), '><')) as t
  ) s
  where p.posttypeid = 1 and p.tags is not null and p.tags <> ''
  group by p.owneruserid, lower(trim(t))
),
top_tag as (
  select distinct on (tu.user_id)
    tu.user_id,
    tu.tag as top_tag,
    tu.uses as top_tag_uses
  from tag_usage tu
  order by tu.user_id, tu.uses desc, tu.tag
),
interactions as (
  select
    u.id as user_id,
    count(distinct v.id) filter (where v.userid is not null) as votes_cast,
    count(distinct c.id) filter (where c.userid is not null) as comments_made,
    sum(case when v.votetypeid = 2 then 1 when v.votetypeid = 3 then -1 else 0 end) filter (where v.postid in (select id from posts where owneruserid = u.id)) as score_from_votes_on_their_posts
  from users u
  left join votes v on v.userid = u.id or v.postid in (select id from posts where owneruserid = u.id)
  left join comments c on c.userid = u.id
  group by u.id
),
latest_accepted as (
  select
    u.id as user_id,
    (
      select json_agg(a_row)
      from (
        select p.id as answer_id, p.parentid as question_id, p.creationdate, p.score
        from posts p
        where p.owneruserid = u.id and p.posttypeid = 2 and exists (
          select 1 from posts q where q.id = p.parentid and q.acceptedanswerid = p.id
        )
        order by p.creationdate desc
        limit 5
      ) a_row
    ) as latest_accepted_answers
  from users u
),
user_score as (
  select
    up.user_id,
    up.displayname,
    coalesce(up.questions,0) as questions,
    coalesce(up.answers,0) as answers,
    coalesce(bs.badge_count,0) as badges,
    coalesce(i.votes_cast,0) as votes_cast,
    coalesce(i.comments_made,0) as comments_made,
    coalesce(up.total_post_score,0) as total_post_score,
    coalesce(up.total_views,0) as total_views,
    coalesce(tt.top_tag, '<<none>>') as top_tag,
    coalesce(tt.top_tag_uses,0) as top_tag_uses,
    cast(
      (
        (coalesce(up.answers,0) * 3)
        + (coalesce(up.questions,0) * 2)
        + (coalesce(up.total_post_score,0) * 1.5)
        + (coalesce(bs.badge_count,0) * 1.25)
        + (coalesce(i.votes_cast,0) * 0.1)
        + ln(1 + coalesce(up.total_views,0)) * 0.05
        - greatest(0, coalesce(i.comments_made,0) - 100) * 0.01
      ) as numeric(18,6)
    ) as raw_performance_score
  from user_posts up
  left join badge_summary bs on bs.userid = up.user_id
  left join interactions i on i.user_id = up.user_id
  left join top_tag tt on tt.user_id = up.user_id
),
ranked_users as (
  select
    us.user_id,
    us.displayname,
    us.questions,
    us.answers,
    us.badges,
    us.votes_cast,
    us.comments_made,
    us.total_post_score,
    us.total_views,
    us.top_tag,
    us.top_tag_uses,
    us.raw_performance_score,
    row_number() over (order by us.raw_performance_score desc nulls last, us.total_post_score desc) as performance_rank,
    rank() over (order by us.raw_performance_score desc nulls last) as performance_rank_dense,
    (select percentile_cont(0.5) within group (order by sub.raw_performance_score)
     from user_score sub
     where sub.raw_performance_score is not null
    ) as median_score
  from user_score us
),
inactive_recent as (
  select u.id as user_id, u.displayname
  from users u
  where u.id not in (select owneruserid from posts where owneruserid is not null)
    and u.creationdate >= (cast('2024-10-01 12:34:56' as timestamp) - interval '365 days')
)
select
  ru.performance_rank,
  ru.performance_rank_dense,
  ru.user_id,
  ru.displayname,
  ru.questions,
  ru.answers,
  ru.badges,
  ru.votes_cast,
  ru.comments_made,
  ru.total_post_score,
  ru.total_views,
  ru.top_tag,
  ru.top_tag_uses,
  ru.raw_performance_score,
  ru.median_score,
  coalesce(
    (select p.title from posts p where p.owneruserid = ru.user_id order by p.creationdate desc limit 1),
    '--no-title--'
  ) as last_post_title,
  (exists (select 1 from posts p where p.owneruserid = ru.user_id and p.posttypeid = 1 and p.answercount > 0)) as has_questions_with_answers,
  (exists (select 1 from posts p where p.owneruserid = ru.user_id and p.posttypeid = 2 and p.score >= 10)) as has_high_scoring_answers,
  la.latest_accepted_answers,
  case
    when ir.user_id is not null and ru.user_id is null then 'recent_inactive'
    when ir.user_id is null and ru.user_id is not null then 'active'
    else 'active_and_recent_inactive'
  end as status_hint
from ranked_users ru
left join latest_accepted la on la.user_id = ru.user_id
full join inactive_recent ir on ir.user_id = ru.user_id
where ru.raw_performance_score is not null
order by ru.performance_rank
limit 250;