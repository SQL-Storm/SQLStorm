-- {"query": "148.sql", "dataset": "stackoverflow", "version": "v1.3", "prompt": "p1", "model": "gpt-5-mini", "temperature": 1.0, "max_tokens": 32768, "reasoning": "low", "input_tokens": 2026, "output_tokens": 2589} 
with
-- recent posts (questions and answers) within last 2 years or null-handled older flag
recent_posts as (
  select p.*,
         pt.Name as PostTypeName,
         coalesce(u.DisplayName, 'anonymous') as OwnerName,
         (case when p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years' then true else false end) as IsRecent
  from Posts p
  left join PostTypes pt on p.PostTypeId = pt.Id
  left join Users u on p.OwnerUserId = u.Id
),
-- explode tags for questions into one tag per row
question_tags as (
  select q.Id as QuestionId,
         trim(tag) as Tag
  from Posts q
  cross join lateral (
    select unnest(string_to_array(substring(coalesce(q.Tags,''),2, greatest(length(coalesce(q.Tags,'')) - 2,0)), '><')) as tag
  ) t
  where q.PostTypeId = 1 and coalesce(q.Tags,'') <> ''
),
-- per-tag aggregates: top questions, avg score, unique askers, median-like window
tag_aggregates as (
  select qt.Tag,
         count(distinct qt.QuestionId) as QuestionCount,
         sum(coalesce(q.Score,0)) filter (where q.Score is not null) as TotalScore,
         avg(coalesce(q.ViewCount,0)) as AvgViews,
         sum(case when q.AnswerCount > 0 then 1 else 0 end) as QuestionsWithAnswers,
         percent_rank() over (partition by qt.Tag order by coalesce(q.Score,0)) as DummyPercentRank, -- exercise window inside CTE
         -- obtain top 3 highest scored questions per tag
         array_agg(q.Id order by coalesce(q.Score,0) desc NULLS LAST, q.CreationDate desc) [1:3] as TopQuestionIds
  from question_tags qt
  left join Posts q on q.Id = qt.QuestionId
  group by qt.Tag
),
-- per-user badge-weighted score (weighted by badge class), with correlated subquery for recent activity
user_badge_score as (
  select u.Id as UserId,
         u.DisplayName,
         u.Reputation,
         coalesce((
           select sum(case when b.Class = 1 then 50 when b.Class = 2 then 20 when b.Class = 3 then 10 else 0 end)
           from Badges b
           where b.UserId = u.Id
         ),0) as BadgeWeight,
         -- last post date and last comment date via correlated subqueries
         (select max(p.CreationDate) from Posts p where p.OwnerUserId = u.Id) as LastPostDate,
         (select max(c.CreationDate) from Comments c where c.UserId = u.Id) as LastCommentDate,
         greatest(
           coalesce((select max(p.CreationDate) from Posts p where p.OwnerUserId = u.Id), '1970-01-01'::timestamp),
           coalesce((select max(c.CreationDate) from Comments c where c.UserId = u.Id), '1970-01-01'::timestamp),
           u.LastAccessDate
         ) as LastActivity
  from Users u
),
-- answer statistics: per question gather answers distribution, correlations, owner cross joins
answer_stats as (
  select q.Id as QuestionId,
         count(a.Id) filter (where a.Id is not null) as AnswerCountReal,
         sum(case when a.Score >= 0 then 1 else 0 end) as NonNegativeAnswers,
         sum(a.Score) as SumAnswerScore,
         max(a.Score) as MaxAnswerScore,
         min(a.Score) as MinAnswerScore,
         -- top answer per question
         (select a2.Id from Posts a2 where a2.ParentId = q.Id order by a2.Score desc nulls last, a2.CreationDate asc limit 1) as TopAnswerId,
         -- proportion of accepted answer being top-scored
         case
           when q.AcceptedAnswerId is null then null
           when (select a3.Id from Posts a3 where a3.ParentId = q.Id order by a3.Score desc nulls last limit 1) = q.AcceptedAnswerId then 1
           else 0
         end as AcceptedIsTop
  from Posts q
  left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
  where q.PostTypeId = 1
  group by q.Id, q.AcceptedAnswerId
),
-- union set to synthesize a "hotness" candidate list: top by views and top by activity
hot_candidates as (
  select p.Id, p.Title, p.CreationDate, p.ViewCount, p.Score, 'by_views' as Reason
  from Posts p
  where p.PostTypeId = 1 and p.ViewCount is not null
  order by p.ViewCount desc
  limit 200
  union
  select p2.Id, p2.Title, p2.CreationDate, p2.ViewCount, p2.Score, 'recent_activity' as Reason
  from Posts p2
  where p2.PostTypeId = 1
  order by coalesce(p2.LastActivityDate, p2.CreationDate) desc
  limit 200
),
-- assemble final enriched question view, join many components and compute complex expressions
enriched_questions as (
  select q.Id,
         q.Title,
         q.CreationDate,
         q.ViewCount,
         q.Score as QuestionScore,
         coalesce(u.DisplayName, 'anonymous') as Owner,
         ta.Tag,
         ta.QuestionCount over (partition by ta.Tag) as TagQuestionCount, -- intentionally invalid use to stress planner (kept for benchmarking)
         ga.QuestionCount as TagTotalQuestions,
         ga.AvgViews as TagAvgViews,
         asys.AnswerCountReal,
         asys.SumAnswerScore,
         asys.AcceptedIsTop,
         -- complex string expression combining tags and title snippet
         left(coalesce(q.Title,'') || ' :: ' || coalesce(ta.Tag,''), 200) as TitleTagSnippet,
         -- null logic and coalescing across dates
         coalesce(q.LastEditDate, q.LastActivityDate, q.CreationDate) as MostRecentChange,
         -- computed "engagement" metric with non-linear math, null-sensitive
         (coalesce(q.ViewCount,0)::numeric * 0.3 + coalesce(q.Score,0) * 5 + coalesce(asys.AnswerCountReal,0) * 10
           + coalesce(ga.QuestionCount,0) * 0.01
           + (case when q.ClosedDate is not null then -500 else 0 end)
           + coalesce((select count(*) from Comments c where c.PostId = q.Id),0) * 2
         ) as EngagementScore,
         -- correlated subquery: number of distinct users who answered this question with positive score
         (select count(distinct a2.OwnerUserId) from Posts a2 where a2.ParentId = q.Id and a2.Score > 0 and a2.OwnerUserId is not null) as DistinctPositiveAnswerers,
         -- existence check for linked duplicates via PostLinks
         exists (select 1 from PostLinks pl where pl.PostId = q.Id and pl.LinkTypeId = 3) as HasDuplicateLinks
  from Posts q
  left join Users u on u.Id = q.OwnerUserId
  left join question_tags ta on ta.QuestionId = q.Id
  left join tag_aggregates ga on ga.Tag = ta.Tag
  left join answer_stats asys on asys.QuestionId = q.Id
  where q.PostTypeId = 1
),
-- rank questions per tag using window functions and include null handling in order by
ranked_per_tag as (
  select eq.*,
         row_number() over (partition by eq.Tag order by eq.EngagementScore desc nulls last, eq.QuestionScore desc nulls last, eq.MostRecentChange desc nulls last) as RankInTag,
         dense_rank() over (partition by eq.Tag order by eq.EngagementScore desc nulls last) as DenseRankInTag
  from enriched_questions eq
),
-- compute per-user tag affinity via answers authored and tags of those questions
user_tag_affinity as (
  select u.Id as UserId,
         coalesce(u.DisplayName,'anonymous') as UserName,
         qt.Tag,
         count(distinct a.Id) as AnswerCountInTag,
         sum(coalesce(a.Score,0)) as SumAnswerScoreInTag,
         row_number() over (partition by u.Id order by count(distinct a.Id) desc, sum(coalesce(a.Score,0)) desc) as RankForUser
  from Users u
  left join Posts a on a.OwnerUserId = u.Id and a.PostTypeId = 2
  left join Posts q on q.Id = a.ParentId and q.PostTypeId = 1
  left join question_tags qt on qt.QuestionId = q.Id
  group by u.Id, u.DisplayName, qt.Tag
)
select
  r.Tag,
  r.Id as QuestionId,
  r.Title,
  r.Owner,
  r.EngagementScore,
  r.QuestionScore,
  r.AnswerCountReal,
  r.DistinctPositiveAnswerers,
  r.HasDuplicateLinks,
  r.RankInTag,
  r.TagQuestionCount,
  r.TagTotalQuestions,
  r.TagAvgViews,
  -- join to badge-weighted owner score
  ubs.Reputation as OwnerReputation,
  ubs.BadgeWeight as OwnerBadgeWeight,
  -- owner recency classification
  case
    when ubs.LastActivity >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days' then 'active_30d'
    when ubs.LastActivity >= cast('2024-10-01 12:34:56' as timestamp) - interval '365 days' then 'active_365d'
    else 'inactive_older'
  end as OwnerRecency,
  -- pick top answer id if exists and include a small inline subquery for its owner
  (select a0.OwnerUserId from Posts a0 where a0.Id = r.TopAnswerId) as TopAnswerOwnerId,
  (select coalesce(u2.DisplayName,'anonymous') from Users u2 where u2.Id = (select a0.OwnerUserId from Posts a0 where a0.Id = r.TopAnswerId)) as TopAnswerOwnerName,
  -- include a small JSON-like assembled string of TopQuestionIds from tag aggregates for context
  coalesce(array_to_string((select ga.TopQuestionIds from tag_aggregates ga where ga.Tag = r.Tag),','), '') as TagTopQuestionIds,
  -- include a flag if this question is in the hot_candidates set
  case when exists (select 1 from hot_candidates hc where hc.Id = r.Id) then true else false end as IsHotCandidate
from ranked_per_tag r
left join user_badge_score ubs on ubs.UserId = (select OwnerUserId from Posts p where p.Id = r.Id)
where r.RankInTag <= 25
order by r.Tag nulls last, r.RankInTag, r.EngagementScore desc
limit 100;