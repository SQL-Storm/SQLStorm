SELECT 
    u.DisplayName, 
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(p.Score) AS HighestScoredPost,
    MIN(p.CreationDate) AS FirstPostDate,
    MAX(p.LastActivityDate) AS LastActivityDate,
    b.Name AS LatestBadge,
    v.Name AS MostRecentVote,
    AVG(p.ViewCount) AS AvgViewsPerPost,
    STRING_AGG(DISTINCT t.TagName, ', ') AS PopularTags
FROM 
    Users u
LEFT JOIN 
    (SELECT 
        UserId, 
        MAX("Date") AS MaxDate
     FROM 
        Badges
     GROUP BY 
        UserId) b2 ON u.Id = b2.UserId
LEFT JOIN 
    Badges b ON u.Id = b.UserId AND b."Date" = b2.MaxDate
LEFT JOIN 
    (SELECT 
        UserId, 
        MAX(CreationDate) AS MaxVoteDate
     FROM 
        Votes
     GROUP BY 
        UserId) v2 ON u.Id = v2.UserId
LEFT JOIN 
    Votes v ON u.Id = v.UserId AND v.CreationDate = v2.MaxVoteDate
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN LATERAL 
    (SELECT 
        pp.Id AS PostId, 
        STRING_AGG(tg.TagName, ', ') AS TagName
     FROM 
        Tags tg
     JOIN 
        Posts pp ON tg.ExcerptPostId = pp.Id
     WHERE pp.Id = p.Id
     GROUP BY 
        pp.Id) t ON TRUE
WHERE 
    u.Reputation > 100
    AND p.LastActivityDate > (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months')
GROUP BY 
    u.DisplayName, u.Reputation, u.Id, b.Name, v.Name
ORDER BY 
    u.Reputation DESC;