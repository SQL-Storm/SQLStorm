WITH RECURSIVE user_influence_tree AS (
  SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    0 AS depth,
    ARRAY[u.Id] AS path
  FROM Users u
  WHERE u.Reputation > 10000
    AND EXTRACT(YEAR FROM u.CreationDate) >= 2015
  
  UNION ALL
  
  SELECT 
    u2.Id,
    u2.DisplayName,
    u2.Reputation,
    u2.CreationDate,
    uit.depth + 1,
    uit.path || ARRAY[u2.Id]
  FROM user_influence_tree uit
  JOIN Posts p ON p.OwnerUserId = uit.Id
  JOIN Comments c ON c.PostId = p.Id
  JOIN Users u2 ON u2.Id = c.UserId
  WHERE uit.depth < 3
    AND NOT u2.Id = ANY(uit.path)
),
top_tags_per_user AS (
  tag_split AS (
    SELECT
      p.OwnerUserId,
      TRIM(BOTH '<>' FROM p.Tags) AS tags_trimmed
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.Tags IS NOT NULL
      AND p.OwnerUserId IS NOT NULL
  ),
  tag_explode AS (
    SELECT
      OwnerUserId,
      CASE 
        WHEN POSITION('><' IN tags_trimmed) = 0 THEN tags_trimmed
        ELSE SUBSTRING(tags_trimmed FROM 1 FOR POSITION('><' IN tags_trimmed) - 1)
      END AS tag,
      CASE 
        WHEN POSITION('><' IN tags_trimmed) = 0 THEN ''
        ELSE SUBSTRING(tags_trimmed FROM POSITION('><' IN tags_trimmed) + 2)
      END AS rest
    FROM tag_split

    UNION ALL

    SELECT
      te.OwnerUserId,
      CASE 
        WHEN POSITION('><' IN te.rest) = 0 THEN te.rest
        ELSE SUBSTRING(te.rest FROM 1 FOR POSITION('><' IN te.rest) - 1)
      END AS tag,
      CASE 
        WHEN POSITION('><' IN te.rest) = 0 THEN ''
        ELSE SUBSTRING(te.rest FROM POSITION('><' IN te.rest) + 2)
      END AS rest
    FROM tag_explode te
    WHERE te.rest <> ''
  )
  SELECT
    OwnerUserId,
    tag,
    COUNT(*) AS tag_count,
    AVG(p.Score) AS avg_score,
    ROW_NUMBER() OVER (PARTITION BY OwnerUserId ORDER BY COUNT(*) DESC) AS rn
  FROM tag_explode te
  JOIN Posts p ON p.OwnerUserId = te.OwnerUserId
    AND POSITION(te.tag IN TRIM(BOTH '<>' FROM p.Tags)) > 0
  GROUP BY OwnerUserId, tag
),
engagement_metrics AS (
  SELECT 
    p.Id AS PostId,
    p.OwnerUserId,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    COUNT(DISTINCT c.Id) AS comment_count,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS upvote_count,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS downvote_count,
    COUNT(DISTINCT b.Id) AS badges_earned_around_post,
    MAX(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS has_accepted_answer
  FROM Posts p
  LEFT JOIN Comments c ON c.PostId = p.Id
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN Badges b ON b.UserId = p.OwnerUserId 
    AND b.Date BETWEEN p.CreationDate AND (p.CreationDate + INTERVAL '30' DAY)
  WHERE p.PostTypeId IN (1, 2)
    AND p.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '5' YEAR)
  GROUP BY p.Id, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount
),
complex_post_history AS (
  SELECT 
    ph.PostId,
    COUNT(DISTINCT ph.UserId) AS unique_editors,
    COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4, 5, 6)) AS edit_count,
    COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (10, 102, 103, 104, 105)) AS close_attempts,
    MAX(ph.CreationDate) - MIN(ph.CreationDate) AS lifetime_duration
  FROM PostHistory ph
  WHERE ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6, 10, 102, 103, 104, 105)
  GROUP BY ph.PostId
  HAVING COUNT(*) > 5
)
SELECT 
  uit.DisplayName AS influencer_name,
  uit.Reputation AS influencer_reputation,
  uit.depth AS network_depth,
  COALESCE(ttu.tag, 'N/A') AS primary_tag,
  ttu.tag_count AS posts_in_tag,
  ROUND(CAST(ttu.avg_score AS numeric), 2) AS avg_tag_score,
  COUNT(DISTINCT em.PostId) AS total_posts,
  ROUND(CAST(AVG(em.Score) AS numeric), 2) AS avg_post_score,
  SUM(em.ViewCount) AS total_views,
  ROUND(CAST(AVG(em.comment_count) AS numeric), 2) AS avg_comments_per_post,
  SUM(em.upvote_count) AS total_upvotes,
  SUM(em.downvote_count) AS total_downvotes,
  COUNT(DISTINCT cph.PostId) AS complex_edited_posts,
  ROUND(CAST(AVG(EXTRACT(EPOCH FROM cph.lifetime_duration)/86400) AS numeric), 2) AS avg_post_lifetime_days,
  COUNT(DISTINCT pl.RelatedPostId) AS linked_posts_count,
  SUM(CASE WHEN em.has_accepted_answer = 1 THEN 1 ELSE 0 END) AS questions_with_accepted_answers,
  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY em.ViewCount) AS median_views
FROM user_influence_tree uit
LEFT JOIN top_tags_per_user ttu ON ttu.OwnerUserId = uit.Id AND ttu.rn <= 3
LEFT JOIN engagement_metrics em ON em.OwnerUserId = uit.Id
LEFT JOIN complex_post_history cph ON cph.PostId = em.PostId
LEFT JOIN PostLinks pl ON pl.PostId = em.PostId AND pl.LinkTypeId = 1
WHERE em.Score IS NOT NULL
GROUP BY 
  uit.Id,
  uit.DisplayName, 
  uit.Reputation, 
  uit.depth,
  ttu.tag,
  ttu.tag_count,
  ttu.avg_score
HAVING COUNT(DISTINCT em.PostId) > 5
ORDER BY 
  uit.Reputation DESC,
  total_upvotes DESC,
  avg_post_score DESC
LIMIT 100;