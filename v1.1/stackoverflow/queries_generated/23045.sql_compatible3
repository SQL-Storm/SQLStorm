WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        COUNT(p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        MAX(p.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY SUM(p.Score) DESC) AS ScoreRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    GROUP BY u.Id, u.Reputation, u.DisplayName
),
BadgeStats AS (
    SELECT 
        UserId,
        COUNT(CASE WHEN "class" = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN "class" = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN "class" = 3 THEN 1 END) AS BronzeBadges,
        STRING_AGG(Name, ', ' ORDER BY "Date" DESC) AS BadgeNames,
        MAX("Date") AS MaxDate
    FROM Badges
    GROUP BY UserId
),
TopQuestions AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.ViewCount,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id AND c.Score > 0) AS PositiveComments
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.ViewCount > 1000
),
CombinedData AS (
    SELECT 
        ua.UserId,
        ua.DisplayName,
        COALESCE(ua.PostCount, 0) AS PostCount,
        ua.TotalScore,
        ua.ScoreRank,
        bs.GoldBadges,
        bs.SilverBadges,
        bs.BronzeBadges,
        bs.BadgeNames,
        CASE 
            WHEN ua.LastPostDate IS NULL THEN 'No Posts'
            ELSE TO_CHAR(CAST(ua.LastPostDate AS TIMESTAMP), 'YYYY-MM-DD') 
                 || ' (' || EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - CAST(ua.LastPostDate AS TIMESTAMP))) || ' days ago)'
        END AS LastPostInfo,
        (SELECT AVG(v.BountyAmount) FROM Votes v WHERE v.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = ua.UserId) AND v.VoteTypeId = 8 AND v.BountyAmount IS NOT NULL) AS AvgBounty
    FROM UserActivity ua
    LEFT JOIN BadgeStats bs ON ua.UserId = bs.UserId
    WHERE EXISTS (
        SELECT 1 FROM Posts po WHERE po.OwnerUserId = ua.UserId AND po.Score > (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.PostTypeId = po.PostTypeId)
    )
    UNION
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        0 AS PostCount,
        0 AS TotalScore,
        NULL AS ScoreRank,
        NULL AS GoldBadges,
        NULL AS SilverBadges,
        NULL AS BronzeBadges,
        NULL AS BadgeNames,
        'Inactive' AS LastPostInfo,
        NULL AS AvgBounty
    FROM Users u
    WHERE u.Id NOT IN (SELECT UserId FROM UserActivity WHERE PostCount > 0)
)
SELECT 
    cd.UserId,
    cd.DisplayName,
    cd.PostCount,
    cd.TotalScore,
    cd.ScoreRank,
    cd.GoldBadges,
    cd.SilverBadges,
    cd.BronzeBadges,
    cd.BadgeNames,
    cd.LastPostInfo,
    cd.AvgBounty,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = cd.UserId) AND pl.LinkTypeId = 3) AS DuplicateLinks,
    RANK() OVER (PARTITION BY cd.GoldBadges ORDER BY cd.TotalScore DESC) AS GoldRank,
    UPPER(SUBSTRING(cd.DisplayName FROM 1 FOR 1)) || LOWER(SUBSTRING(cd.DisplayName FROM 2 FOR 1000)) AS FormattedName,
    CASE 
        WHEN cd.AvgBounty IS NULL OR cd.AvgBounty < 50 THEN 'Low Bounty User'
        WHEN cd.AvgBounty >= 50 AND cd.AvgBounty <= 200 THEN 'Medium Bounty User'
        ELSE 'High Bounty User'
    END AS BountyCategory
FROM CombinedData cd
LEFT JOIN TopQuestions tq ON 1=1 AND tq.PositiveComments > 5
WHERE cd.PostCount > 10 OR COALESCE(cd.GoldBadges, 0) > 0
GROUP BY
    cd.UserId,
    cd.DisplayName,
    cd.PostCount,
    cd.TotalScore,
    cd.ScoreRank,
    cd.GoldBadges,
    cd.SilverBadges,
    cd.BronzeBadges,
    cd.BadgeNames,
    cd.LastPostInfo,
    cd.AvgBounty
ORDER BY cd.ScoreRank ASC NULLS LAST, cd.TotalScore DESC;