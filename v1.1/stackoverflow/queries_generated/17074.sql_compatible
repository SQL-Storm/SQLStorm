WITH user_activity_metrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS total_posts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS questions_asked,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answers_given,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) AS avg_post_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) FILTER (WHERE p.Score > 0) AS median_positive_score,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ', ') FILTER (WHERE p.Tags IS NOT NULL) AS all_tags_used
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '2 years'
        AND u.Reputation > 100
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
elite_users AS (
    SELECT 
        uam.*,
        DENSE_RANK() OVER (ORDER BY uam.Reputation DESC) AS reputation_rank,
        NTILE(10) OVER (ORDER BY uam.total_posts DESC) AS activity_decile,
        LAG(uam.avg_post_score, 1) OVER (ORDER BY uam.Reputation DESC) AS prev_user_avg_score,
        LEAD(uam.avg_post_score, 1) OVER (ORDER BY uam.Reputation DESC) AS next_user_avg_score,
        FIRST_VALUE(uam.DisplayName) OVER (PARTITION BY NTILE(10) OVER (ORDER BY uam.total_posts DESC) ORDER BY uam.Reputation DESC) AS top_user_in_decile
    FROM user_activity_metrics uam
    WHERE uam.total_posts >= 10
),
complex_post_analysis AS (
    SELECT 
        p.Id AS post_id,
        p.Title,
        p.Score,
        p.ViewCount,
        COALESCE(p.OwnerUserId, -1) AS owner_id,
        COALESCE(u.DisplayName, p.OwnerDisplayName, 'Anonymous') AS author_name,
        CASE 
            WHEN p.Score >= 100 THEN 'Legendary'
            WHEN p.Score >= 50 THEN 'Epic'
            WHEN p.Score >= 20 THEN 'Great'
            WHEN p.Score >= 5 THEN 'Good'
            WHEN p.Score >= 0 THEN 'Neutral'
            ELSE 'Controversial'
        END AS post_quality,
        LENGTH(p.Body) - LENGTH(REPLACE(REPLACE(LOWER(p.Body), '<code>', ''), '</code>', '')) AS code_content_length,
        CARDINALITY(STRING_TO_ARRAY(SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), '><')) AS tag_count,
        EXISTS (
            SELECT 1 
            FROM Comments c 
            WHERE c.PostId = p.Id 
                AND c.Score > 5
                AND (c.Text LIKE '%thank%' OR c.Text LIKE '%helpful%')
        ) AS has_appreciation_comments,
        (
            SELECT COUNT(DISTINCT ph.UserId)
            FROM PostHistory ph
            WHERE ph.PostId = p.Id
                AND ph.PostHistoryTypeId IN (4, 5, 6)
                AND ph.UserId IS NOT NULL
        ) AS unique_editors,
        COALESCE((
            SELECT STRING_AGG(DISTINCT b.Name, ', ' ORDER BY b.Class, b.Name)
            FROM Badges b
            WHERE b.UserId = p.OwnerUserId
                AND b.TagBased = true
                AND b.Date BETWEEN p.CreationDate - INTERVAL '30 days' AND p.CreationDate + INTERVAL '30 days'
        ), 'No relevant badges') AS related_badges
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId IN (1, 2)
        AND p.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '1 year'
        AND (p.Score > 10 OR p.ViewCount > 1000 OR p.AnswerCount > 5)
)
SELECT 
    eu.DisplayName,
    eu.Reputation,
    eu.reputation_rank,
    eu.activity_decile,
    eu.questions_asked,
    eu.answers_given,
    ROUND(CAST(eu.avg_post_score AS numeric), 2) AS avg_score,
    ROUND(CAST(eu.median_positive_score AS numeric), 2) AS median_positive_score,
    ROUND(
        CAST(
            CASE 
                WHEN eu.prev_user_avg_score IS NULL THEN eu.avg_post_score
                WHEN eu.next_user_avg_score IS NULL THEN eu.avg_post_score
                ELSE (COALESCE(eu.prev_user_avg_score, 0) + eu.avg_post_score + COALESCE(eu.next_user_avg_score, 0)) / 3.0
            END
        AS numeric), 2
    ) AS smoothed_avg_score,
    CASE 
        WHEN eu.top_user_in_decile = eu.DisplayName THEN '★ DECILE LEADER ★'
        ELSE eu.top_user_in_decile
    END AS decile_leader,
    cpa.post_id,
    LEFT(COALESCE(cpa.Title, 'Untitled'), 50) || CASE WHEN LENGTH(COALESCE(cpa.Title, '')) > 50 THEN '...' ELSE '' END AS truncated_title,
    cpa.post_quality,
    cpa.Score AS post_score,
    cpa.ViewCount AS views,
    cpa.code_content_length,
    COALESCE(cpa.tag_count, 0) AS tags_used,
    cpa.has_appreciation_comments,
    cpa.unique_editors,
    cpa.related_badges,
    CASE 
        WHEN cpa.Score > eu.avg_post_score * 2 THEN 'Exceptional Performance'
        WHEN cpa.Score > eu.avg_post_score THEN 'Above Average'
        WHEN cpa.Score >= eu.avg_post_score * 0.5 THEN 'Near Average'
        ELSE 'Below Expectations'
    END AS relative_performance,
    ROW_NUMBER() OVER (PARTITION BY eu.Id ORDER BY cpa.Score DESC, cpa.ViewCount DESC) AS user_post_rank,
    eu.Id
FROM elite_users eu
CROSS JOIN LATERAL (
    SELECT * FROM complex_post_analysis cpa
    WHERE cpa.owner_id = eu.Id
    ORDER BY cpa.Score DESC, cpa.ViewCount DESC
    LIMIT 3
) cpa
WHERE eu.reputation_rank <= 100
    AND (eu.questions_asked > 0 OR eu.answers_given > 0)
UNION ALL
SELECT 
    'ORPHANED CONTENT' AS DisplayName,
    0 AS Reputation,
    999999 AS reputation_rank,
    0 AS activity_decile,
    0 AS questions_asked,
    0 AS answers_given,
    NULL AS avg_score,
    NULL AS median_positive_score,
    NULL AS smoothed_avg_score,
    'SYSTEM' AS decile_leader,
    cpa.post_id,
    LEFT(COALESCE(cpa.Title, 'Untitled'), 50) || CASE WHEN LENGTH(COALESCE(cpa.Title, '')) > 50 THEN '...' ELSE '' END AS truncated_title,
    cpa.post_quality,
    cpa.Score AS post_score,
    cpa.ViewCount AS views,
    cpa.code_content_length,
    COALESCE(cpa.tag_count, 0) AS tags_used,
    cpa.has_appreciation_comments,
    cpa.unique_editors,
    cpa.related_badges,
    'Orphaned' AS relative_performance,
    ROW_NUMBER() OVER (ORDER BY cpa.Score DESC) AS user_post_rank,
    -1 AS Id
FROM complex_post_analysis cpa
WHERE cpa.owner_id = -1
    AND cpa.Score > 50
LIMIT 10
ORDER BY reputation_rank, user_post_rank;