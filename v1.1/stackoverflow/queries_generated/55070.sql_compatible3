WITH
    BadgeStats AS (
        SELECT
            b.UserId,
            SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
            SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
            SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
            COUNT(*) AS TotalBadges
        FROM Badges b
        GROUP BY b.UserId
    ),

    PostVoteAgg AS (
        SELECT
            v.PostId,
            COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpVotes,
            COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownVotes,
            COUNT(CASE WHEN v.VoteTypeId = 5 THEN 1 END) AS Favorites,
            COUNT(CASE WHEN v.VoteTypeId = 12 THEN 1 END) AS SpamFlags,
            COUNT(CASE WHEN v.VoteTypeId = 14 THEN 1 END) AS ModeratorNominations
        FROM Votes v
        GROUP BY v.PostId
    ),

    LatestEdit AS (
        SELECT
            ph.PostId,
            ph.PostHistoryTypeId,
            ph.CreationDate AS EditDate,
            ph.UserId AS EditorUserId,
            ph.Comment AS EditComment
        FROM (
            SELECT
                ph.*,
                ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
            FROM PostHistory ph
            WHERE ph.PostHistoryTypeId IN (4,5,6)
        ) ph
        WHERE ph.rn = 1
    ),

    TopTags AS (
        SELECT TagName
        FROM Tags
        ORDER BY Count DESC
        FETCH FIRST 20 ROWS ONLY
    ),

    TagPairs AS (
        SELECT
            t1.TagName AS TagA,
            t2.TagName AS TagB,
            COUNT(*) AS CoOccurrence
        FROM Posts p
        CROSS JOIN LATERAL (
            SELECT TRIM(x) AS TagName
            FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS x
        ) pt
        JOIN TopTags t1 ON t1.TagName = pt.TagName
        CROSS JOIN LATERAL (
            SELECT TRIM(x) AS TagName
            FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS x
        ) pt2
        JOIN TopTags t2 ON t2.TagName = pt2.TagName AND t2.TagName > t1.TagName
        GROUP BY t1.TagName, t2.TagName
    ),

    RecentActivity AS (
        SELECT
            p.OwnerUserId,
            COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS RecentQuestions,
            COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS RecentAnswers,
            SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS QuestionScoreSum,
            SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS AnswerScoreSum,
            MAX(p.CreationDate) AS LastPostDate
        FROM Posts p
        WHERE p.CreationDate >= (DATE '2024-10-01' - INTERVAL '90' DAY)
          AND p.OwnerUserId IS NOT NULL
        GROUP BY p.OwnerUserId
    ),

    UserProfile AS (
        SELECT
            u.Id,
            u.DisplayName,
            u.Reputation,
            u.CreationDate AS JoinDate,
            u.LastAccessDate,
            u.Views,
            u.UpVotes,
            u.DownVotes,
            bs.GoldBadges,
            bs.SilverBadges,
            bs.BronzeBadges,
            bs.TotalBadges,
            ra.RecentQuestions,
            ra.RecentAnswers,
            ra.QuestionScoreSum,
            ra.AnswerScoreSum,
            ra.LastPostDate
        FROM Users u
        LEFT JOIN BadgeStats bs ON bs.UserId = u.Id
        LEFT JOIN RecentActivity ra ON ra.OwnerUserId = u.Id
    )

SELECT
    up.Id AS UserId,
    up.DisplayName,
    up.Reputation,
    up.GoldBadges,
    up.SilverBadges,
    up.BronzeBadges,
    up.TotalBadges,
    up.RecentQuestions,
    up.RecentAnswers,
    up.QuestionScoreSum,
    up.AnswerScoreSum,
    up.LastPostDate,
    (
      SELECT JSON_AGG(j ORDER BY j."CreationDate" DESC) FROM (
        SELECT
          JSON_BUILD_OBJECT(
            'PostId', p_inner.Id,
            'Title', p_inner.Title,
            'PostType', pt_inner.Name,
            'Score', p_inner.Score,
            'ViewCount', p_inner.ViewCount,
            'CreationDate', p_inner.CreationDate,
            'LastActivity', p_inner.LastActivityDate,
            'UpVotes', COALESCE(pva_inner.UpVotes,0),
            'DownVotes', COALESCE(pva_inner.DownVotes,0),
            'Favorites', COALESCE(pva_inner.Favorites,0),
            'LatestEdit', JSON_BUILD_OBJECT(
              'EditType', le_inner.PostHistoryTypeId,
              'EditDate', le_inner.EditDate,
              'EditorUserId', le_inner.EditorUserId,
              'EditComment', le_inner.EditComment
            )
          ) AS j,
          p_inner.CreationDate AS "CreationDate"
        FROM Posts p_inner
        LEFT JOIN PostTypes pt_inner ON pt_inner.Id = p_inner.PostTypeId
        LEFT JOIN PostVoteAgg pva_inner ON pva_inner.PostId = p_inner.Id
        LEFT JOIN LatestEdit le_inner ON le_inner.PostId = p_inner.Id
        WHERE p_inner.OwnerUserId = up.Id
        ORDER BY p_inner.CreationDate DESC
        FETCH FIRST 5 ROWS ONLY
      ) sub
    ) AS RecentPostsJson,
    (
      SELECT JSON_AGG(tagj) FROM (
        SELECT
          JSON_BUILD_OBJECT(
            'Tag', t_inner.TagName,
            'CoTags', (
              SELECT JSON_AGG(JSON_BUILD_OBJECT('CoTag', tp.TagB, 'Count', tp.CoOccurrence) ORDER BY tp.CoOccurrence DESC)
              FROM TagPairs tp
              WHERE tp.TagA = t_inner.TagName OR tp.TagB = t_inner.TagName
              FETCH FIRST 5 ROWS ONLY
            )
          ) AS tagj
        FROM (
          SELECT DISTINCT TRIM(x) AS TagName
          FROM UNNEST(STRING_TO_ARRAY(COALESCE(SUBSTRING(p2.Tags FROM 2 FOR CHAR_LENGTH(p2.Tags)-2),''), '><')) AS x
          JOIN Posts p2 ON TRUE
          WHERE p2.OwnerUserId = up.Id
        ) t_inner
      ) tsub
    ) AS TagCoOccurrenceJson
FROM UserProfile up
LEFT JOIN Posts p ON p.OwnerUserId = up.Id
LEFT JOIN PostTypes pt ON pt.Id = p.PostTypeId
LEFT JOIN PostVoteAgg pva ON pva.PostId = p.Id
LEFT JOIN LatestEdit le ON le.PostId = p.Id
LEFT JOIN LATERAL (
    SELECT TRIM(x) AS TagName
    FROM UNNEST(STRING_TO_ARRAY(COALESCE(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2),''), '><')) AS x
) t ON TRUE
WHERE up.Reputation > 1000
GROUP BY
    up.Id,
    up.DisplayName,
    up.Reputation,
    up.GoldBadges,
    up.SilverBadges,
    up.BronzeBadges,
    up.TotalBadges,
    up.RecentQuestions,
    up.RecentAnswers,
    up.QuestionScoreSum,
    up.AnswerScoreSum,
    up.LastPostDate
ORDER BY up.Reputation DESC
FETCH FIRST 100 ROWS ONLY;