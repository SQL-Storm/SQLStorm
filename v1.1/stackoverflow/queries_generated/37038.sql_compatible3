WITH
Questions AS (
  SELECT p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount,
         p.AnswerCount, p.CommentCount,
         regexp_split_to_array(substring(coalesce(p.Tags,''),2,length(coalesce(p.Tags,''))-2), '><') AS Tags,
         EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate))/3600.0 AS HoursOld,
         p.OwnerUserId
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '365 days'
),
AnswerStats AS (
  SELECT q.Id AS QuestionId,
         COUNT(a.Id) FILTER (WHERE a.Score > 0) AS PosAnswers,
         COUNT(a.Id) FILTER (WHERE a.Score <= 0) AS NonPosAnswers,
         COALESCE(MAX(a.Score),0) AS BestAnswerScore,
         COALESCE(MIN(a.Score),0) AS WorstAnswerScore,
         SUM(a.Score) AS SumAnswerScore,
         (SELECT row_to_json(t) FROM (
            SELECT a2.Id, a2.OwnerUserId, a2.Score, a2.CreationDate
            FROM Posts a2
            WHERE a2.ParentId = q.Id AND a2.PostTypeId = 2
            ORDER BY a2.Score DESC NULLS LAST, a2.CreationDate DESC
            LIMIT 1
         ) t) AS TopAnswer
  FROM Questions q
  LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
  GROUP BY q.Id
),
VoteAggregates AS (
  SELECT v.PostId,
         COUNT(*) FILTER (WHERE v.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '365 days') AS VotesYear,
         COUNT(*) FILTER (WHERE v.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '30 days') AS Votes30,
         COUNT(*) FILTER (WHERE v.VoteTypeId = 2 AND v.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '365 days') AS UpVotesYear,
         COUNT(*) FILTER (WHERE v.VoteTypeId = 3 AND v.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '365 days') AS DownVotesYear,
         COUNT(*) FILTER (WHERE v.VoteTypeId = 2 AND v.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '30 days') AS UpVotes30,
         COUNT(*) FILTER (WHERE v.VoteTypeId = 3 AND v.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '30 days') AS DownVotes30
  FROM Votes v
  GROUP BY v.PostId
),
CommentStats AS (
  SELECT c.PostId,
         COUNT(*) AS CommentCountTotal,
         AVG(char_length(c.Text)) AS AvgCommentLen,
         COUNT(DISTINCT c.UserId) AS UniqueCommenters,
         MAX(c.CreationDate) AS LastComment
  FROM Comments c
  WHERE c.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '365 days'
  GROUP BY c.PostId
),
LinkGraph AS (
  SELECT pl.PostId,
         COUNT(*) FILTER (WHERE pl.LinkTypeId = 1) AS OutgoingLinks,
         COUNT(*) FILTER (WHERE pl.LinkTypeId = 3) AS DuplicateEdges,
         COUNT(DISTINCT pl.RelatedPostId) AS DistinctRelated
  FROM PostLinks pl
  WHERE pl.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - interval '365 days'
  GROUP BY pl.PostId
),
AskerStats AS (
  SELECT u.Id AS UserId,
         u.DisplayName, u.Reputation,
         COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
         COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
         COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
         COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END),0) AS NumQuestions,
         COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END),0) AS NumAnswers,
         u.CreationDate
  FROM Users u
  LEFT JOIN Badges b ON b.UserId = u.Id
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
Core AS (
  SELECT q.Id,
         q.Title,
         q.CreationDate,
         q.Score,
         q.ViewCount,
         q.AnswerCount,
         q.CommentCount,
         q.Tags,
         q.HoursOld,
         a.PosAnswers, a.NonPosAnswers, a.BestAnswerScore, a.WorstAnswerScore, a.SumAnswerScore, a.TopAnswer,
         coalesce(v.VotesYear,0) AS VotesYear, coalesce(v.Votes30,0) AS Votes30,
         coalesce(v.UpVotesYear,0) AS UpVotesYear, coalesce(v.DownVotesYear,0) AS DownVotesYear,
         coalesce(c.CommentCountTotal,0) AS CommentCountYear, coalesce(c.AvgCommentLen,0) AS AvgCommentLen,
         coalesce(l.OutgoingLinks,0) AS OutgoingLinks, coalesce(l.DuplicateEdges,0) AS DuplicateEdges,
         us.UserId, us.DisplayName AS AskerName, us.Reputation AS AskerReputation,
         us.GoldBadges, us.SilverBadges, us.BronzeBadges,
         (
           (1.0 / NULLIF(GREATEST(q.HoursOld,1),0)) * 10.0
           + LEAST(1.0, GREATEST(CAST(q.ViewCount AS numeric) / NULLIF(NULLIF(q.AnswerCount,0),0), 0)) * 5.0
           + (CASE WHEN a.BestAnswerScore > 0 THEN 5 ELSE 0 END)
           + (coalesce(v.UpVotesYear,0) - coalesce(v.DownVotesYear,0)) * 0.2
           + GREATEST(coalesce(c.UniqueCommenters,0),0) * 0.5
         ) AS HotnessScore,
         a.SumAnswerScore
  FROM Questions q
  LEFT JOIN AnswerStats a ON a.QuestionId = q.Id
  LEFT JOIN VoteAggregates v ON v.PostId = q.Id
  LEFT JOIN CommentStats c ON c.PostId = q.Id
  LEFT JOIN LinkGraph l ON l.PostId = q.Id
  LEFT JOIN AskerStats us ON us.UserId = q.OwnerUserId
)
SELECT
  to_char(CAST('2024-10-01 12:34:56' AS timestamp), 'YYYY-MM-DD"T"HH24:MI:SS') AS BenchmarkRun,
  core.Id AS QuestionId,
  core.Title,
  core.Tags,
  core.CreationDate,
  core.HoursOld,
  core.ViewCount,
  core.Score AS QuestionScore,
  core.AnswerCount,
  core.PosAnswers,
  core.BestAnswerScore,
  CAST(core.TopAnswer ->> 'OwnerUserId' AS integer) AS TopAnswerOwner,
  CAST(core.TopAnswer ->> 'Score' AS integer) AS TopAnswerScore,
  core.VotesYear, core.Votes30, core.UpVotesYear, core.DownVotesYear,
  core.CommentCountYear, core.AvgCommentLen,
  core.OutgoingLinks, core.DuplicateEdges,
  core.AskerName AS AskerName,
  core.AskerReputation AS AskerReputation,
  core.GoldBadges, core.SilverBadges, core.BronzeBadges,
  core.HotnessScore,
  rank() OVER (ORDER BY core.HotnessScore DESC) AS HotRank,
  dense_rank() OVER (ORDER BY (core.SumAnswerScore) DESC NULLS LAST) AS AnswerQualityRank,
  ntile(100) OVER (ORDER BY core.HotnessScore DESC) AS HotnessPercentile,
  CASE
    WHEN core.ViewCount > 1000 AND core.AnswerCount = 0 THEN 'HighViewNoAnswers'
    WHEN core.DuplicateEdges > 0 THEN 'PossibleDuplicateCluster'
    WHEN core.DownVotesYear > core.UpVotesYear THEN 'NegativeReception'
    ELSE 'Normal'
  END AS IssueTag
FROM Core core
WHERE core.HotnessScore IS NOT NULL
ORDER BY core.HotnessScore DESC
LIMIT 500;