WITH RecentHighActivityUsers AS (
    SELECT 
        OwnerUserId,
        COUNT(*) AS PostCount,
        SUM(Score) AS TotalScore,
        AVG(ViewCount) AS AvgViewCount
    FROM 
        Posts
    WHERE 
        LastActivityDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months'
        AND OwnerUserId IS NOT NULL
    GROUP BY 
        OwnerUserId
    HAVING 
        COUNT(*) > 10
), TopTags AS (
    SELECT 
        t.TagName,
        COUNT(*) AS UsageCount
    FROM 
        Tags t
        INNER JOIN Posts p ON p.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE 
        p.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
    GROUP BY 
        t.TagName
    ORDER BY 
        UsageCount DESC
    LIMIT 10
), UserTagExpertise AS (
    SELECT 
        ph.UserId,
        t.TagName,
        COUNT(*) AS TagPostCount
    FROM 
        PostHistory ph
        INNER JOIN Posts p ON ph.PostId = p.Id
        INNER JOIN Tags t ON p.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE 
        ph.PostHistoryTypeId IN (2, 5)
        AND t.TagName IN (SELECT TagName FROM TopTags)
    GROUP BY 
        ph.UserId, t.TagName
), UserReputationGrowth AS (
    SELECT 
        UserId,
        DATE_TRUNC('month', CreationDate) AS Month,
        AVG(Reputation) AS AvgMonthlyReputation
    FROM (
        SELECT 
            b.UserId,
            b.Date AS CreationDate,
            u.Reputation
        FROM 
            Badges b
            INNER JOIN Users u ON b.UserId = u.Id
        UNION ALL
        SELECT 
            p.OwnerUserId AS UserId,
            p.CreationDate,
            u.Reputation
        FROM 
            Posts p
            INNER JOIN Users u ON p.OwnerUserId = u.Id
    ) AS Combined
    GROUP BY 
        UserId, DATE_TRUNC('month', CreationDate)
)
SELECT 
    u.DisplayName,
    u.Reputation,
    rau.PostCount,
    rau.TotalScore,
    rau.AvgViewCount,
    JSON_AGG(JSON_BUILD_OBJECT('TagName', ute.TagName, 'TagPostCount', ute.TagPostCount)) FILTER (WHERE ute.UserId IS NOT NULL) AS TagExpertise,
    JSON_AGG(JSON_BUILD_OBJECT('Month', TO_CHAR(urg.Month, 'YYYY-MM-DD'), 'AvgMonthlyReputation', urg.AvgMonthlyReputation)) FILTER (WHERE urg.UserId IS NOT NULL) AS ReputationGrowth
FROM 
    RecentHighActivityUsers rau
    INNER JOIN Users u ON rau.OwnerUserId = u.Id
    LEFT JOIN UserTagExpertise ute ON rau.OwnerUserId = ute.UserId
    LEFT JOIN UserReputationGrowth urg ON rau.OwnerUserId = urg.UserId
GROUP BY 
    u.DisplayName,
    u.Reputation,
    rau.PostCount,
    rau.TotalScore,
    rau.AvgViewCount,
    u.Id,
    ute.TagName,
    ute.TagPostCount,
    urg.Month,
    urg.AvgMonthlyReputation,
    ute.UserId,
    urg.UserId
ORDER BY 
    rau.TotalScore DESC
LIMIT 50;