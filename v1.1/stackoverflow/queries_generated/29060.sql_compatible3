WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.ParentId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS prev_score,
        NTILE(10) OVER (ORDER BY p.Score DESC) AS score_percentile,
        CASE 
            WHEN p.PostTypeId = 1 THEN COALESCE(p.Title, '') 
            ELSE COALESCE(p.Tags, '') 
        END AS title_or_tags,
        LENGTH(COALESCE(p.Body, '')) AS body_length,
        CAST(EXTRACT(EPOCH FROM TIMESTAMP '2024-10-01 12:34:56') AS BIGINT) - CAST(EXTRACT(EPOCH FROM p.CreationDate) AS BIGINT) AS seconds_since_creation,
        (CAST(EXTRACT(EPOCH FROM TIMESTAMP '2024-10-01 12:34:56') AS BIGINT) - CAST(EXTRACT(EPOCH FROM p.CreationDate) AS BIGINT)) / 86400 AS days_since_creation,
        CASE WHEN p.Score > 0 THEN 1 ELSE 0 END AS has_positive_score
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate,
        COUNT(DISTINCT p.Id) AS post_count,
        SUM(p.Score) AS total_score,
        AVG(p.Score) AS avg_score,
        MAX(p.CreationDate) AS last_post_date,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS question_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answer_count,
        COUNT(DISTINCT CASE WHEN p.Score > 100 THEN p.Id END) AS high_score_posts,
        STRING_AGG(CASE WHEN p.PostTypeId = 1 THEN p.Title ELSE NULL END, '; ') AS question_titles
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.CreationDate
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count AS tag_count,
        t.ExcerptPostId,
        t.WikiPostId,
        COALESCE(p1.ViewCount, 0) AS excerpt_views,
        COALESCE(p2.ViewCount, 0) AS wiki_views,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 100 THEN 'Moderate'
            ELSE 'Niche'
        END AS tag_popularity,
        DENSE_RANK() OVER (ORDER BY t.Count DESC) AS popularity_rank,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rank_by_count
    FROM Tags t
    LEFT JOIN Posts p1 ON t.ExcerptPostId = p1.Id
    LEFT JOIN Posts p2 ON t.WikiPostId = p2.Id
),
RecentComments AS (
    SELECT 
        c.Id,
        c.PostId,
        c.UserId,
        c.Score,
        c.Text,
        c.CreationDate,
        c.UserDisplayName,
        LENGTH(c.Text) AS text_length,
        SUBSTR(c.Text, 1, 50) AS text_preview,
        (CAST(EXTRACT(EPOCH FROM TIMESTAMP '2024-10-01 12:34:56') AS BIGINT) - CAST(EXTRACT(EPOCH FROM c.CreationDate) AS BIGINT)) / 60 AS minutes_since_comment,
        CASE 
            WHEN c.Score > 5 THEN 'Highly Valued'
            WHEN c.Score > 0 THEN 'Valued'
            ELSE 'Neutral'
        END AS comment_quality,
        ROW_NUMBER() OVER (PARTITION BY c.PostId ORDER BY c.CreationDate DESC) AS comment_rank
    FROM Comments c
    WHERE c.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days')
),
ComplexPostAnalysis AS (
    SELECT 
        rp.Id AS PostId,
        rp.PostTypeId,
        rp.ParentId,
        rp.OwnerUserId,
        rp.Score,
        rp.ViewCount,
        rp.CreationDate,
        rp.Title,
        rp.Tags,
        rp.AnswerCount,
        rp.CommentCount,
        rp.FavoriteCount,
        rp.rn,
        rp.prev_score,
        rp.score_percentile,
        rp.title_or_tags,
        rp.body_length,
        rp.days_since_creation,
        rp.has_positive_score,
        CASE 
            WHEN rp.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = rp.PostTypeId) THEN 'Above Average'
            WHEN rp.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = rp.PostTypeId) * 0.8 THEN 'Average'
            ELSE 'Below Average'
        END AS score_category,
        CASE 
            WHEN rp.Score = 0 THEN 'No Score'
            WHEN rp.Score > 10 THEN 'High Score'
            WHEN rp.Score > 5 THEN 'Medium Score'
            ELSE 'Low Score'
        END AS score_level,
        COALESCE(ua.post_count, 0) AS user_post_count,
        COALESCE(ua.total_score, 0) AS user_total_score,
        COALESCE(ua.avg_score, 0) AS user_avg_score,
        COALESCE(ta.tag_count, 0) AS related_tag_count,
        COALESCE(ta.tag_popularity, 'Unknown') AS tag_popularity,
        COALESCE(rc.Text, 'No Comments') AS latest_comment_preview,
        CASE WHEN rp.days_since_creation < 30 THEN 'Recent' ELSE 'Old' END AS post_age_category,
        CASE WHEN rp.AnswerCount > 5 THEN 'Well Answered' ELSE 'Few Answers' END AS answer_level,
        CASE WHEN rp.CommentCount > 10 THEN 'Highly Commented' ELSE 'Low Commented' END AS comment_level,
        CASE 
            WHEN rp.OwnerUserId IS NOT NULL AND rp.OwnerUserId != 0 THEN 'User Post'
            WHEN rp.OwnerUserId = 0 OR rp.OwnerUserId IS NULL THEN 'Community Post'
            ELSE 'Mixed'
        END AS post_origin,
        COALESCE(rp.title_or_tags, '') || ' - ' || COALESCE(rp.Tags, '') AS combined_metadata
    FROM RankedPosts rp
    LEFT JOIN UserActivity ua ON rp.OwnerUserId = ua.UserId
    LEFT JOIN (
        SELECT TRIM(tag) AS TagName, COUNT(*) AS tag_count
        FROM (
            SELECT p.Id, 
                   TRIM(tag) AS tag
            FROM Posts p,
            LATERAL (
                SELECT CASE 
                         WHEN p.Tags IS NULL OR p.Tags = '' THEN NULL
                         ELSE SUBSTR(p.Tags, s.i, COALESCE(NULLIF(POSITION('>' IN SUBSTR(p.Tags, s.i)), 0), 0) /* placeholder */)
                       END AS tag
                FROM (SELECT 1 AS i) s
            ) split
            WHERE p.Tags IS NOT NULL
        ) tags_expanded
        WHERE tag IS NOT NULL AND tag <> ''
        GROUP BY TRIM(tag)
    ) AS tag_counts ON rp.Title LIKE '%' || tag_counts.TagName || '%'
    LEFT JOIN TagAnalysis ta ON ta.TagName = CASE WHEN rp.Tags IS NOT NULL AND LENGTH(rp.Tags) >= 2 THEN SUBSTR(rp.Tags, 2, LENGTH(rp.Tags) - 2) ELSE NULL END
    LEFT JOIN (
        SELECT PostId, Text, ROW_NUMBER() OVER (PARTITION BY PostId ORDER BY CreationDate DESC) AS rn
        FROM Comments 
        WHERE CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days')
    ) rc ON rp.Id = rc.PostId AND rc.rn = 1
    WHERE rp.PostTypeId IN (1, 2)
),
FinalAggregatedData AS (
    SELECT 
        cpa.*,
        COUNT(*) OVER () AS total_posts,
        SUM(CASE WHEN Score > 0 THEN 1 ELSE 0 END) OVER () AS positive_score_posts,
        AVG(Score) OVER () AS overall_avg_score,
        MAX(Score) OVER () AS max_score,
        MIN(Score) OVER () AS min_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY Score) OVER () AS median_score,
        COUNT(DISTINCT OwnerUserId) OVER () AS active_users,
        COUNT(DISTINCT CASE WHEN ParentId IS NOT NULL THEN ParentId END) OVER () AS parent_post_count,
        COUNT(DISTINCT CASE WHEN AnswerCount > 0 THEN Id END) OVER () AS answered_questions,
        COUNT(DISTINCT CASE WHEN CommentCount > 0 THEN Id END) OVER () AS commented_questions,
        STRING_AGG(DISTINCT CAST(PostId AS TEXT), ', ') OVER () AS all_post_ids,
        STRING_AGG(DISTINCT Title, ' | ') OVER () AS all_titles
    FROM ComplexPostAnalysis cpa
),
RankedUsers AS (
    SELECT 
        ua.UserId,
        ua.Reputation,
        ua.DisplayName,
        ua.post_count,
        ua.total_score,
        ua.avg_score,
        ua.last_post_date,
        ua.question_count,
        ua.answer_count,
        ua.high_score_posts,
        ua.question_titles,
        ROW_NUMBER() OVER (ORDER BY ua.total_score DESC) AS rep_rank,
        RANK() OVER (ORDER BY ua.Reputation DESC) AS rep_rank2,
        DENSE_RANK() OVER (ORDER BY ua.Reputation DESC) AS rep_rank3,
        PERCENT_RANK() OVER (ORDER BY ua.Reputation) AS rep_percentile
    FROM UserActivity ua
)
SELECT 
    fd.PostId,
    fd.PostTypeId,
    fd.OwnerUserId,
    fd.Score,
    fd.ViewCount,
    fd.CreationDate,
    fd.Title,
    fd.Tags,
    fd.AnswerCount,
    fd.CommentCount,
    fd.FavoriteCount,
    fd.score_percentile,
    fd.title_or_tags,
    fd.body_length,
    fd.days_since_creation,
    fd.has_positive_score,
    fd.score_category,
    fd.score_level,
    fd.user_post_count,
    fd.user_total_score,
    fd.user_avg_score,
    fd.related_tag_count,
    fd.tag_popularity,
    fd.latest_comment_preview,
    fd.post_age_category,
    fd.answer_level,
    fd.comment_level,
    fd.post_origin,
    fd.combined_metadata,
    fd.total_posts,
    fd.positive_score_posts,
    fd.overall_avg_score,
    fd.max_score,
    fd.min_score,
    fd.median_score,
    fd.active_users,
    fd.parent_post_count,
    fd.answered_questions,
    fd.commented_questions,
    fd.all_post_ids,
    fd.all_titles,
    ru.Reputation,
    ru.DisplayName,
    ru.post_count AS user_post_count2,
    ru.total_score AS user_total_score2,
    ru.avg_score AS user_avg_score2,
    ru.rep_rank,
    ru.rep_rank2,
    ru.rep_rank3,
    ru.rep_percentile,
    CASE 
        WHEN fd.Score > 50 AND fd.AnswerCount > 2 THEN 'High Engagement'
        WHEN fd.Score > 20 AND fd.CommentCount > 5 THEN 'Engaged'
        WHEN fd.ViewCount > 1000 THEN 'Popular'
        WHEN fd.Score > 100 THEN 'Highly Rated'
        ELSE 'Standard'
    END AS engagement_category,
    CASE WHEN ru.Reputation > (SELECT AVG(Reputation) FROM Users) * 1.5 THEN 'High Rep' ELSE 'Normal' END AS reputation_category
FROM FinalAggregatedData fd
LEFT JOIN RankedUsers ru ON fd.OwnerUserId = ru.UserId
WHERE fd.PostTypeId IN (1, 2)
    AND fd.days_since_creation < 365
    AND fd.user_avg_score > 10
    AND fd.body_length > 200
    AND fd.AnswerCount > 0
    AND fd.CommentCount < 50
    AND NOT (fd.Score = 0 AND fd.ViewCount < 10)
    AND fd.post_age_category = 'Recent'
    AND fd.score_percentile >= 50
    AND (fd.Title ~ '[A-Z][A-Z]' 
         OR fd.Tags ~ '[A-Z][A-Z]'
         OR fd.latest_comment_preview ~ '[A-Z][A-Z]')
GROUP BY 
    fd.PostId,
    fd.PostTypeId,
    fd.OwnerUserId,
    fd.Score,
    fd.ViewCount,
    fd.CreationDate,
    fd.Title,
    fd.Tags,
    fd.AnswerCount,
    fd.CommentCount,
    fd.FavoriteCount,
    fd.score_percentile,
    fd.title_or_tags,
    fd.body_length,
    fd.days_since_creation,
    fd.has_positive_score,
    fd.score_category,
    fd.score_level,
    fd.user_post_count,
    fd.user_total_score,
    fd.user_avg_score,
    fd.related_tag_count,
    fd.tag_popularity,
    fd.latest_comment_preview,
    fd.post_age_category,
    fd.answer_level,
    fd.comment_level,
    fd.post_origin,
    fd.combined_metadata,
    fd.total_posts,
    fd.positive_score_posts,
    fd.overall_avg_score,
    fd.max_score,
    fd.min_score,
    fd.median_score,
    fd.active_users,
    fd.parent_post_count,
    fd.answered_questions,
    fd.commented_questions,
    fd.all_post_ids,
    fd.all_titles,
    ru.Reputation,
    ru.DisplayName,
    ru.post_count,
    ru.total_score,
    ru.avg_score,
    ru.rep_rank,
    ru.rep_rank2,
    ru.rep_rank3,
    ru.rep_percentile
HAVING COUNT(DISTINCT fd.PostId) >= 1
    AND COUNT(DISTINCT fd.OwnerUserId) >= 1
    AND MAX(fd.Score) > 5
    AND AVG(fd.ViewCount) > 20
ORDER BY 
    fd.Score DESC,
    fd.total_posts DESC,
    fd.ViewCount DESC,
    fd.CreationDate DESC,
    ru.Reputation DESC
LIMIT 10000;