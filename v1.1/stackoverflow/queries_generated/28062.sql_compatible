WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT c.Id) AS TotalComments,
        RANK() OVER (PARTITION BY b.Class ORDER BY u.Reputation DESC) AS ReputationRank
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id, u.Reputation, u.UpVotes, u.DownVotes, b.Class
),
PostClosures AS (
    SELECT 
        ph.PostId AS PostId,
        MAX(ph.CreationDate) AS LastCloseDate,
        (SELECT Name FROM CloseReasonTypes WHERE Id = CAST(JSON_EXTRACT_PATH_TEXT(ph.Comment, 'CloseReasonId') AS INTEGER)
            ) AS CloseReason
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10
    GROUP BY ph.PostId, ph.Comment
)
SELECT 
    us.UserId,
    us.Reputation,
    COALESCE(u.DisplayName, 'Anonymous') AS DisplayName,
    (us.UpVotes - us.DownVotes) * 0.5 + us.Reputation * 0.1 AS WeightedScore,
    pc.CloseReason,
    STRING_AGG(DISTINCT t.TagName, '; ') AS FrequentTags,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsAsked,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersProvided,
    AVG(p.Score) OVER (PARTITION BY us.UserId) AS AvgPostScore,
    CASE 
        WHEN us.Reputation > 100000 THEN 'Legendary'
        WHEN us.Reputation BETWEEN 50000 AND 100000 THEN 'Epic'
        ELSE 'Regular'
    END AS UserTier
FROM UserStats us
JOIN Users u ON us.UserId = u.Id
LEFT JOIN Posts p ON us.UserId = p.OwnerUserId
LEFT JOIN PostClosures pc ON p.Id = pc.PostId
LEFT JOIN LATERAL (
    SELECT DISTINCT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><')) AS TagName
) pt ON TRUE
LEFT JOIN Tags t ON pt.TagName = t.TagName
LEFT JOIN Comments c ON us.UserId = c.UserId
WHERE p.CreationDate BETWEEN DATE '2015-01-01' AND DATE '2023-12-31'
    AND (p.ClosedDate IS NOT NULL OR pc.CloseReason IS NULL)
    AND (p.OwnerUserId IS NOT NULL OR p.OwnerDisplayName LIKE '%Community%')
GROUP BY us.UserId, us.Reputation, u.DisplayName, us.UpVotes, us.DownVotes, pc.CloseReason, us.UserId, AvgPostScore, p.Score
HAVING COUNT(DISTINCT p.Id) > 10 AND COUNT(DISTINCT c.Id) > 50

UNION ALL

SELECT 
    pl.RelatedPostId AS UserId,
    0 AS Reputation,
    'Duplicate Post' AS DisplayName,
    NULL AS WeightedScore,
    'Duplicate' AS CloseReason,
    (SELECT STRING_AGG(TagName, '; ') FROM Tags WHERE Id IN (
        SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><'))
    )) AS FrequentTags,
    0 AS QuestionsAsked,
    0 AS AnswersProvided,
    0 AS AvgPostScore,
    'System' AS UserTier
FROM PostLinks pl
JOIN Posts p ON pl.PostId = p.Id
WHERE pl.LinkTypeId = 3
ORDER BY WeightedScore DESC
LIMIT 100;