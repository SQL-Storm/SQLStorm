with recent_questions as (
  select p.Id as QuestionId,
         p.CreationDate,
         p.Score,
         p.ViewCount,
         p.OwnerUserId,
         p.Tags,
         coalesce(p.AnswerCount, 0) as AnswerCount
  from Posts p
  where p.PostTypeId = 1
    and p.CreationDate >= (select max(CreationDate) - interval '90' day from Posts)
),
answers as (
  select a.Id as AnswerId,
         a.ParentId as QuestionId,
         a.OwnerUserId as AnswerOwnerId,
         a.Score as AnswerScore,
         a.CreationDate as AnswerCreationDate
  from Posts a
  where a.PostTypeId = 2
    and a.ParentId is not null
),
first_answer as (
  select a.QuestionId,
         min(a.AnswerCreationDate) as FirstAnswerDate
  from answers a
  group by a.QuestionId
),
accepted as (
  select q.Id as QuestionId,
         q.AcceptedAnswerId
  from Posts q
  where q.PostTypeId = 1
    and q.AcceptedAnswerId is not null
),
accepted_answer as (
  select ac.QuestionId,
         a.AnswerId,
         a.AnswerOwnerId,
         a.AnswerScore,
         a.AnswerCreationDate
  from accepted ac
  join answers a on a.AnswerId = ac.AcceptedAnswerId
),
comment_stats as (
  select c.PostId,
         count(*) as CommentCount,
         sum(case when c.Score > 0 then 1 else 0 end) as PosComments,
         max(c.Score) as MaxCommentScore,
         min(c.CreationDate) as FirstCommentDate,
         max(c.CreationDate) as LastCommentDate
  from Comments c
  group by c.PostId
),
vote_agg as (
  select v.PostId,
         sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
         sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
         sum(case when v.VoteTypeId = 5 then 1 else 0 end) as Favorites,
         sum(case when v.VoteTypeId in (8,9) then coalesce(v.BountyAmount,0) else 0 end) as BountyTotal,
         min(case when v.VoteTypeId in (8,9) then v.CreationDate end) as FirstBountyDate
  from Votes v
  group by v.PostId
),
dup_links as (
  select pl.PostId as DuplicateOf,
         sum(case when pl.LinkTypeId = 3 then 1 else 0 end) as DuplicateCount,
         sum(case when pl.LinkTypeId = 1 then 1 else 0 end) as LinkedCount
  from PostLinks pl
  group by pl.PostId
),
close_history as (
  select ph.PostId,
         sum(case when ph.PostHistoryTypeId = 10 then 1 else 0 end) as CloseVotes,
         sum(case when ph.PostHistoryTypeId = 11 then 1 else 0 end) as ReopenVotes,
         min(case when ph.PostHistoryTypeId = 10 then ph.CreationDate end) as FirstCloseDate,
         max(case when ph.PostHistoryTypeId = 10 then ph.CreationDate end) as LastCloseDate,
         sum(case when ph.PostHistoryTypeId in (12,13) then 1 else 0 end) as DeleteUndeleteEvents
  from PostHistory ph
  group by ph.PostId
),
tag_expansion as (
  select q.QuestionId,
         unnest(string_to_array(substring(q.Tags, 2, length(q.Tags)-2), '><')) as TagName
  from recent_questions q
  where q.Tags is not null and q.Tags <> ''
),
tag_rank as (
  select te.QuestionId,
         te.TagName,
         t.Count as GlobalTagCount,
         row_number() over (partition by te.QuestionId order by t.Count desc nulls last, te.TagName) as TagRankByGlobalPopularity
  from tag_expansion te
  left join Tags t on lower(t.TagName) = lower(te.TagName)
),
question_owner as (
  select u.Id as UserId,
         u.Reputation,
         u.CreationDate as UserCreationDate,
         u.UpVotes as UserUpVotes,
         u.DownVotes as UserDownVotes,
         u.Views as UserViews
  from Users u
),
answer_owner as (
  select u.Id as UserId,
         u.Reputation as AnswererReputation,
         u.UpVotes as AnswererUpVotes,
         u.DownVotes as AnswererDownVotes
  from Users u
),
badge_agg as (
  select b.UserId,
         sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
         sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
         sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
         -- fix boolean vs integer comparison by comparing TagBased to true/false or casting explicitly
         sum(case when (b.TagBased = true) then 1 else 0 end) as TagBadges
  from Badges b
  group by b.UserId
),
activity_window as (
  select p.Id as PostId,
         p.CreationDate,
         p.LastActivityDate,
         extract(epoch from (p.LastActivityDate - p.CreationDate)) / 3600.0 as ActiveHours
  from Posts p
),
question_metrics as (
  select
    rq.QuestionId,
    rq.CreationDate,
    rq.Score as QuestionScore,
    rq.ViewCount,
    rq.AnswerCount,
    coalesce(va.UpVotes,0) as UpVotes,
    coalesce(va.DownVotes,0) as DownVotes,
    coalesce(va.Favorites,0) as Favorites,
    coalesce(va.BountyTotal,0) as BountyTotal,
    va.FirstBountyDate,
    coalesce(cs.CommentCount,0) as CommentCount,
    coalesce(cs.PosComments,0) as PositiveComments,
    cs.MaxCommentScore,
    cs.FirstCommentDate,
    cs.LastCommentDate,
    coalesce(dl.DuplicateCount,0) as DuplicateLinks,
    coalesce(dl.LinkedCount,0) as LinkedLinks,
    coalesce(ch.CloseVotes,0) as CloseVotes,
    coalesce(ch.ReopenVotes,0) as ReopenVotes,
    ch.FirstCloseDate,
    ch.LastCloseDate,
    coalesce(ch.DeleteUndeleteEvents,0) as DeleteUndeleteEvents
  from recent_questions rq
  left join vote_agg va on va.PostId = rq.QuestionId
  left join comment_stats cs on cs.PostId = rq.QuestionId
  left join dup_links dl on dl.DuplicateOf = rq.QuestionId
  left join close_history ch on ch.PostId = rq.QuestionId
),
time_to_first_answer as (
  select fa.QuestionId,
         extract(epoch from (fa.FirstAnswerDate - rq.CreationDate)) / 60.0 as MinutesToFirstAnswer
  from first_answer fa
  join recent_questions rq on rq.QuestionId = fa.QuestionId
),
accept_metrics as (
  select rq.QuestionId,
         aa.AnswerId as AcceptedAnswerId,
         aa.AnswerOwnerId as AcceptedAnswerOwnerId,
         aa.AnswerScore as AcceptedAnswerScore,
         extract(epoch from (aa.AnswerCreationDate - rq.CreationDate)) / 60.0 as MinutesToAcceptCandidate
  from recent_questions rq
  left join accepted_answer aa on aa.QuestionId = rq.QuestionId
),
owner_enriched as (
  select rq.QuestionId,
         u.UserId as OwnerUserId,
         u.Reputation as OwnerReputation,
         u.UserUpVotes,
         u.UserDownVotes,
         u.UserViews,
         ba.GoldBadges as OwnerGoldBadges,
         ba.SilverBadges as OwnerSilverBadges,
         ba.BronzeBadges as OwnerBronzeBadges,
         ba.TagBadges as OwnerTagBadges
  from recent_questions rq
  left join question_owner u on u.UserId = rq.OwnerUserId
  left join badge_agg ba on ba.UserId = rq.OwnerUserId
),
accepted_owner_enriched as (
  select am.QuestionId,
         ao.UserId as AcceptedOwnerUserId,
         ao.AnswererReputation,
         ao.AnswererUpVotes,
         ao.AnswererDownVotes,
         ba.GoldBadges as AcceptedOwnerGoldBadges,
         ba.SilverBadges as AcceptedOwnerSilverBadges,
         ba.BronzeBadges as AcceptedOwnerBronzeBadges,
         ba.TagBadges as AcceptedOwnerTagBadges
  from accept_metrics am
  left join answer_owner ao on ao.UserId = am.AcceptedAnswerOwnerId
  left join badge_agg ba on ba.UserId = am.AcceptedAnswerOwnerId
),
tag_top3 as (
  select tr.QuestionId,
         -- build top 3 tags and counts in a SQL-dialect-neutral way
         listagg(tr.TagName, ',') within group (order by tr.TagRankByGlobalPopularity) as AllTagsOrdered,
         listagg(cast(tr.GlobalTagCount as varchar), ',') within group (order by tr.TagRankByGlobalPopularity) as AllTagCountsOrdered
  from tag_rank tr
  group by tr.QuestionId
),
tag_top3_sliced as (
  select
    t3.QuestionId,
    case
      when position(',' in t3.AllTagsOrdered) = 0 then t3.AllTagsOrdered
      else substring(t3.AllTagsOrdered from 1 for position(',' in t3.AllTagsOrdered)-1)
    end as TopTag1,
    case
      when position(',' in t3.AllTagsOrdered) = 0 then null
      else
        case
          when position(',' in substring(t3.AllTagsOrdered from position(',' in t3.AllTagsOrdered)+1)) = 0
          then substring(t3.AllTagsOrdered from position(',' in t3.AllTagsOrdered)+1)
          else substring(
                 substring(t3.AllTagsOrdered from position(',' in t3.AllTagsOrdered)+1)
                 from 1 for position(',' in substring(t3.AllTagsOrdered from position(',' in t3.AllTagsOrdered)+1))-1)
        end
    end as TopTag2,
    case
      when position(',' in t3.AllTagsOrdered) = 0 then null
      else
        case
          when position(',' in substring(t3.AllTagsOrdered from position(',' in t3.AllTagsOrdered)+1)) = 0 then null
          else
            case
              when position(',' in substring(
                t3.AllTagsOrdered from position(',' in t3.AllTagsOrdered)+1
              )) = 0 then null
              else
                substring(
                  substring(t3.AllTagsOrdered from (position(',' in t3.AllTagsOrdered) + 1 + position(',' in substring(t3.AllTagsOrdered from position(',' in t3.AllTagsOrdered)+1))))
                )
            end
        end
    end as TopTag3,
    case
      when position(',' in t3.AllTagCountsOrdered) = 0 then t3.AllTagCountsOrdered
      else substring(t3.AllTagCountsOrdered from 1 for position(',' in t3.AllTagCountsOrdered)-1)
    end as TopCount1,
    case
      when position(',' in t3.AllTagCountsOrdered) = 0 then null
      else
        case
          when position(',' in substring(t3.AllTagCountsOrdered from position(',' in t3.AllTagCountsOrdered)+1)) = 0
          then substring(t3.AllTagCountsOrdered from position(',' in t3.AllTagCountsOrdered)+1)
          else substring(
                 substring(t3.AllTagCountsOrdered from position(',' in t3.AllTagCountsOrdered)+1)
                 from 1 for position(',' in substring(t3.AllTagCountsOrdered from position(',' in t3.AllTagCountsOrdered)+1))-1)
        end
    end as TopCount2,
    case
      when position(',' in t3.AllTagCountsOrdered) = 0 then null
      else
        case
          when position(',' in substring(t3.AllTagCountsOrdered from position(',' in t3.AllTagCountsOrdered)+1)) = 0 then null
          else
            case
              when position(',' in substring(
                t3.AllTagCountsOrdered from position(',' in t3.AllTagCountsOrdered)+1
              )) = 0 then null
              else
                substring(
                  substring(t3.AllTagCountsOrdered from (position(',' in t3.AllTagCountsOrdered) + 1 + position(',' in substring(t3.AllTagCountsOrdered from position(',' in t3.AllTagCountsOrdered)+1))))
                )
            end
        end
    end as TopCount3
  from tag_top3 t3
)
select
  qm.QuestionId,
  qm.CreationDate,
  qm.QuestionScore,
  qm.ViewCount,
  qm.AnswerCount,
  qm.UpVotes,
  qm.DownVotes,
  qm.Favorites,
  qm.BountyTotal,
  qm.FirstBountyDate,
  qm.CommentCount,
  qm.PositiveComments,
  qm.MaxCommentScore,
  qm.FirstCommentDate,
  qm.LastCommentDate,
  qm.DuplicateLinks,
  qm.LinkedLinks,
  qm.CloseVotes,
  qm.ReopenVotes,
  qm.FirstCloseDate,
  qm.LastCloseDate,
  qm.DeleteUndeleteEvents,
  tw.MinutesToFirstAnswer,
  am.AcceptedAnswerId,
  am.AcceptedAnswerScore,
  am.MinutesToAcceptCandidate,
  oe.OwnerUserId,
  oe.OwnerReputation,
  oe.UserUpVotes as OwnerUpVotes,
  oe.UserDownVotes as OwnerDownVotes,
  oe.UserViews as OwnerViews,
  oe.OwnerGoldBadges,
  oe.OwnerSilverBadges,
  oe.OwnerBronzeBadges,
  oe.OwnerTagBadges,
  aoe.AcceptedOwnerUserId,
  aoe.AnswererReputation,
  aoe.AnswererUpVotes,
  aoe.AnswererDownVotes,
  aoe.AcceptedOwnerGoldBadges,
  aoe.AcceptedOwnerSilverBadges,
  aoe.AcceptedOwnerBronzeBadges,
  aoe.AcceptedOwnerTagBadges,
  array[tts.TopTag1, tts.TopTag2, tts.TopTag3] as Top3Tags,
  array[tts.TopCount1, tts.TopCount2, tts.TopCount3] as Top3TagCounts,
  aw.ActiveHours
from question_metrics qm
left join time_to_first_answer tw on tw.QuestionId = qm.QuestionId
left join accept_metrics am on am.QuestionId = qm.QuestionId
left join owner_enriched oe on oe.QuestionId = qm.QuestionId
left join accepted_owner_enriched aoe on aoe.QuestionId = qm.QuestionId
left join tag_top3_sliced tts on tts.QuestionId = qm.QuestionId
left join activity_window aw on aw.PostId = qm.QuestionId
order by
  qm.BountyTotal desc,
  qm.ViewCount desc,
  qm.QuestionScore desc,
  qm.CommentCount desc
limit 500;