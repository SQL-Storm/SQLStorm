SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS QuestionCount,
    COUNT(DISTINCT a.Id) AS AnswerCount,
    AVG(p.Score) AS AvgQuestionScore,
    SUM((v.Score) * (CASE WHEN vt.Name = 'UpMod' THEN 1 WHEN vt.Name = 'DownMod' THEN -1 ELSE 0 END)) AS CalculatedRepFromVotes,
    COUNT(DISTINCT b.Id) AS BadgeCount,
    COUNT(DISTINCT ph.Id) AS EditHistoryCount,
    COUNT(DISTINCT c.Id) AS CommentCount,
    MAX(p.CreationDate) AS LastPostDate
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
LEFT JOIN 
    Posts a ON u.Id = a.OwnerUserId AND a.PostTypeId = 2
LEFT JOIN 
    Votes v ON (p.Id = v.PostId OR a.Id = v.PostId) AND v.VoteTypeId IN (2, 3) AND v.UserId IS NOT NULL
LEFT JOIN 
    VoteTypes vt ON v.VoteTypeId = vt.Id
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    PostHistory ph ON (p.Id = ph.PostId OR a.Id = ph.PostId) AND ph.PostHistoryTypeId IN (4,5,6)
LEFT JOIN 
    Comments c ON (p.Id = c.PostId OR a.Id = c.PostId) AND c.UserId = u.Id
WHERE 
    u.Reputation > 1000
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, p.Score, vt.Name, v.Score, p.CreationDate
ORDER BY 
    u.Reputation DESC, BadgeCount DESC
LIMIT 100;