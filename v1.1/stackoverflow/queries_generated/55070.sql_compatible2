WITH
    BadgeStats AS (
        SELECT
            b.UserId,
            SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
            SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
            SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
            COUNT(*) AS TotalBadges
        FROM Badges b
        GROUP BY b.UserId
    ),

    PostVoteAgg AS (
        SELECT
            v.PostId,
            COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpVotes,
            COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownVotes,
            COUNT(CASE WHEN v.VoteTypeId = 5 THEN 1 END) AS Favorites,
            COUNT(CASE WHEN v.VoteTypeId = 12 THEN 1 END) AS SpamFlags,
            COUNT(CASE WHEN v.VoteTypeId = 14 THEN 1 END) AS ModeratorNominations
        FROM Votes v
        GROUP BY v.PostId
    ),

    LatestEdit AS (
        SELECT
            ph.PostId,
            ph.PostHistoryTypeId,
            ph.CreationDate AS EditDate,
            ph.UserId AS EditorUserId,
            ph.Comment AS EditComment
        FROM PostHistory ph
        WHERE ph.PostHistoryTypeId IN (4,5,6)
        -- emulate DISTINCT ON by selecting latest per post using window
        QUALIFY ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) = 1
    ),

    TopTags AS (
        SELECT TagName
        FROM Tags
        ORDER BY Count DESC
        FETCH FIRST 20 ROWS ONLY
    ),

    TagPairs AS (
        SELECT
            t1.TagName AS TagA,
            t2.TagName AS TagB,
            COUNT(*) AS CoOccurrence
        FROM Posts p
        CROSS JOIN LATERAL (
            SELECT TRIM(x) AS TagName
            FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS x
        ) pt
        JOIN TopTags t1 ON t1.TagName = pt.TagName
        CROSS JOIN LATERAL (
            SELECT TRIM(x) AS TagName
            FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS x
        ) pt2
        JOIN TopTags t2 ON t2.TagName = pt2.TagName AND t2.TagName > t1.TagName
        GROUP BY t1.TagName, t2.TagName
    ),

    RecentActivity AS (
        SELECT
            p.OwnerUserId,
            COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS RecentQuestions,
            COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS RecentAnswers,
            SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS QuestionScoreSum,
            SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS AnswerScoreSum,
            MAX(p.CreationDate) AS LastPostDate
        FROM Posts p
        WHERE p.CreationDate >= (DATE '2024-10-01' - INTERVAL '90' DAY)
          AND p.OwnerUserId IS NOT NULL
        GROUP BY p.OwnerUserId
    ),

    UserProfile AS (
        SELECT
            u.Id,
            u.DisplayName,
            u.Reputation,
            u.CreationDate AS JoinDate,
            u.LastAccessDate,
            u.Views,
            u.UpVotes,
            u.DownVotes,
            bs.GoldBadges,
            bs.SilverBadges,
            bs.BronzeBadges,
            bs.TotalBadges,
            ra.RecentQuestions,
            ra.RecentAnswers,
            ra.QuestionScoreSum,
            ra.AnswerScoreSum,
            ra.LastPostDate
        FROM Users u
        LEFT JOIN BadgeStats bs ON bs.UserId = u.Id
        LEFT JOIN RecentActivity ra ON ra.OwnerUserId = u.Id
    )

SELECT
    up.Id AS UserId,
    up.DisplayName,
    up.Reputation,
    up.GoldBadges,
    up.SilverBadges,
    up.BronzeBadges,
    up.TotalBadges,
    up.RecentQuestions,
    up.RecentAnswers,
    up.QuestionScoreSum,
    up.AnswerScoreSum,
    up.LastPostDate,
    JSON_AGG(
        JSON_OBJECT(
            'PostId' VALUE p.Id,
            'Title' VALUE p.Title,
            'PostType' VALUE pt.Name,
            'Score' VALUE p.Score,
            'ViewCount' VALUE p.ViewCount,
            'CreationDate' VALUE p.CreationDate,
            'LastActivity' VALUE p.LastActivityDate,
            'UpVotes' VALUE COALESCE(pva.UpVotes,0),
            'DownVotes' VALUE COALESCE(pva.DownVotes,0),
            'Favorites' VALUE COALESCE(pva.Favorites,0),
            'LatestEdit' VALUE JSON_OBJECT(
                'EditType' VALUE le.PostHistoryTypeId,
                'EditDate' VALUE le.EditDate,
                'EditorUserId' VALUE le.EditorUserId,
                'EditComment' VALUE le.EditComment
            )
        )
        ORDER BY p.CreationDate DESC
    ) FILTER (WHERE p.Id IS NOT NULL) KEEP (DENSE_RANK FIRST 5) AS RecentPostsJson,
    JSON_AGG(
        JSON_OBJECT(
            'Tag' VALUE t.TagName,
            'CoTags' VALUE (
                SELECT JSON_AGG(JSON_OBJECT('CoTag' VALUE tp.TagB, 'Count' VALUE tp.CoOccurrence) ORDER BY tp.CoOccurrence DESC)
                FROM TagPairs tp
                WHERE tp.TagA = t.TagName OR tp.TagB = t.TagName
                FETCH FIRST 5 ROWS ONLY
            )
        )
    ) FILTER (WHERE t.TagName IS NOT NULL) AS TagCoOccurrenceJson
FROM UserProfile up
LEFT JOIN Posts p ON p.OwnerUserId = up.Id
LEFT JOIN PostTypes pt ON pt.Id = p.PostTypeId
LEFT JOIN PostVoteAgg pva ON pva.PostId = p.Id
LEFT JOIN LatestEdit le ON le.PostId = p.Id
LEFT JOIN LATERAL (
    SELECT TRIM(x) AS TagName
    FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS x
) t ON TRUE
WHERE up.Reputation > 1000
GROUP BY
    up.Id,
    up.DisplayName,
    up.Reputation,
    up.GoldBadges,
    up.SilverBadges,
    up.BronzeBadges,
    up.TotalBadges,
    up.RecentQuestions,
    up.RecentAnswers,
    up.QuestionScoreSum,
    up.AnswerScoreSum,
    up.LastPostDate
ORDER BY up.Reputation DESC
FETCH FIRST 100 ROWS ONLY;