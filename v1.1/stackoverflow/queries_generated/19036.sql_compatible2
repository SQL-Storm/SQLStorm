WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.Views AS UserProfileViews,
        U.UpVotes AS UserGivenUpVotes,
        U.DownVotes AS UserGivenDownVotes,
        COUNT(DISTINCT P.Id) AS TotalPostsOwned,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COUNT(DISTINCT B.Id) AS TotalBadgesEarned,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCountOwned,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCountOwned,
        SUM(COALESCE(P.Score, 0)) AS TotalPostsScore,
        AVG(COALESCE(P.Score, 0)) AS AveragePostsScore,
        MIN(COALESCE(P.CreationDate, C.CreationDate, TIMESTAMP '2000-01-01')) AS FirstInteractionDate,
        MAX(COALESCE(P.LastActivityDate, C.CreationDate, U.LastAccessDate)) AS LastInteractionDate,
        (
            SELECT COUNT(DISTINCT PH.Id)
            FROM PostHistory PH
            WHERE PH.UserId = U.Id
              AND PH.PostHistoryTypeId IN (4, 5, 6, 8, 9, 24)
        ) AS TotalEditsMadeByUsers,
        COALESCE(U.WebsiteUrl, 'N/A_Website') AS UserWebsiteStatus,
        LENGTH(COALESCE(U.AboutMe, '')) AS AboutMeLengthChars,
        CASE
            WHEN U.LastAccessDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days') AND U.Reputation > 5000 THEN 'HighlyActiveVeteran'
            WHEN U.LastAccessDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '90 days') THEN 'Active'
            ELSE 'Dormant'
        END AS UserActivityCategory
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate,
        U.Views, U.UpVotes, U.DownVotes, U.WebsiteUrl, U.AboutMe
),
PostPerformanceMetrics AS (
    SELECT
        Q.Id AS QuestionId,
        Q.Title AS QuestionTitle,
        Q.CreationDate AS QuestionCreationDate,
        Q.ViewCount,
        Q.Score AS QuestionScore,
        Q.AnswerCount AS DeclaredAnswerCount,
        Q.FavoriteCount,
        Q.ClosedDate,
        Q.AcceptedAnswerId,
        Q.OwnerUserId AS QuestionOwnerUserId,
        Q.Tags AS QuestionTagsString,
        (
            SELECT MIN(A_sub.CreationDate)
            FROM Posts A_sub
            WHERE A_sub.ParentId = Q.Id AND A_sub.PostTypeId = 2
        ) AS FirstAnswerDate,
        (
            SELECT SUM(A_inner.Score)
            FROM Posts A_inner
            WHERE A_inner.ParentId = Q.Id AND A_inner.PostTypeId = 2
        ) AS SumOfAllAnswerScores,
        (
            SELECT COUNT(A_inner.Id)
            FROM Posts A_inner
            WHERE A_inner.ParentId = Q.Id AND A_inner.PostTypeId = 2
        ) AS ActualAnswerCount,
        LAG(Q.CreationDate, 1, TIMESTAMP '1900-01-01') OVER (PARTITION BY Q.OwnerUserId ORDER BY Q.CreationDate ASC) AS PreviousQuestionCreationDateByUser,
        EXTRACT(DAY FROM (Q.ClosedDate - Q.CreationDate)) AS DaysToClose,
        PH_Close.Comment AS CloseReasonCode,
        CRT.Name AS CloseReasonTypeName,
        ROW_NUMBER() OVER (PARTITION BY Q.OwnerUserId ORDER BY Q.Score DESC, Q.CreationDate DESC) AS UserQuestionRankByScore,
        NTILE(10) OVER (ORDER BY Q.ViewCount DESC) AS ViewCountDecile,
        AVG(Q.Score) OVER (PARTITION BY EXTRACT(YEAR FROM Q.CreationDate)) AS AvgQuestionScoreInYear,
        MAX(Q.LastActivityDate) AS LastQuestionActivityDate
    FROM Posts Q
    LEFT JOIN (
        SELECT PostId, MAX(CreationDate) AS LatestCloseDate
        FROM PostHistory
        WHERE PostHistoryTypeId = 10
        GROUP BY PostId
    ) AS LatestClosePH ON Q.Id = LatestClosePH.PostId
    LEFT JOIN PostHistory PH_Close ON LatestClosePH.PostId = PH_Close.PostId
                                  AND LatestClosePH.LatestCloseDate = PH_Close.CreationDate
                                  AND PH_Close.PostHistoryTypeId = 10
    LEFT JOIN CloseReasonTypes CRT ON PH_Close.Comment = CAST(CRT.Id AS VARCHAR)
    WHERE Q.PostTypeId = 1
      AND Q.CreationDate >= TIMESTAMP '2021-01-01'
    GROUP BY
        Q.Id, Q.Title, Q.CreationDate, Q.ViewCount, Q.Score, Q.AnswerCount, Q.FavoriteCount,
        Q.ClosedDate, Q.AcceptedAnswerId, Q.OwnerUserId, Q.Tags, PH_Close.Comment, CRT.Name, Q.LastActivityDate
),
AnswerDetails AS (
    SELECT
        A.Id AS AnswerId,
        A.ParentId AS QuestionId,
        A.Score AS AnswerScore,
        A.CreationDate AS AnswerCreationDate,
        A.OwnerUserId AS AnswerOwnerUserId,
        A.CommentCount AS AnswerCommentCount,
        ROW_NUMBER() OVER (PARTITION BY A.ParentId ORDER BY A.Score DESC, A.CreationDate ASC) AS RankInAnswersForQuestion,
        RANK() OVER (PARTITION BY A.ParentId ORDER BY A.CreationDate ASC) AS ChronologicalRankInAnswers,
        MAX(A.Score) OVER (PARTITION BY A.ParentId) AS MaxAnswerScoreForQuestion
    FROM Posts A
    WHERE A.PostTypeId = 2
      AND A.ParentId IS NOT NULL
),
HighlyEngagedQuestions AS (
    SELECT
        PPM.QuestionId,
        PPM.QuestionTitle,
        PPM.QuestionCreationDate,
        PPM.QuestionScore,
        PPM.QuestionOwnerUserId,
        'HighEngagement' AS QuestionCategoryType
    FROM PostPerformanceMetrics PPM
    WHERE PPM.QuestionScore >= 150
      AND PPM.ViewCount >= 5000
      AND PPM.ActualAnswerCount > 5
)
SELECT
    UAS.UserId,
    UAS.DisplayName,
    UAS.Reputation,
    UAS.UserWebsiteStatus,
    UAS.AboutMeLengthChars,
    UAS.UserActivityCategory,
    PPM.QuestionId,
    PPM.QuestionTitle,
    PPM.QuestionScore,
    PPM.ViewCount,
    PPM.DeclaredAnswerCount,
    PPM.ActualAnswerCount,
    PPM.FavoriteCount,
    PPM.QuestionCreationDate,
    PPM.ClosedDate,
    PPM.DaysToClose,
    PPM.CloseReasonTypeName,
    PPM.FirstAnswerDate,
    EXTRACT(HOUR FROM (PPM.FirstAnswerDate - PPM.QuestionCreationDate)) AS HoursToFirstAnswer,
    PPM.SumOfAllAnswerScores,
    PPM.UserQuestionRankByScore,
    PPM.ViewCountDecile,
    PPM.AvgQuestionScoreInYear,
    AD.AnswerId AS BestAnswerIdByScore,
    AD.AnswerScore AS BestAnswerScore,
    AD.AnswerCreationDate AS BestAnswerCreationDate,
    AD.AnswerOwnerUserId AS BestAnswerOwnerUserId,
    AD.AnswerCommentCount AS BestAnswerCommentCount,
    COALESCE(T1.TagName, 'UNKNOWN_TAG') AS PrimaryTag,
    COALESCE(T2.TagName, 'NO_SECONDARY_TAG') AS SecondaryTag,
    TRIM(LOWER(SUBSTRING(UAS.DisplayName FROM 1 FOR 4))) || '-' || LPAD(CAST(UAS.UserId AS VARCHAR), 8, '0') AS UserIdentifierHash,
    (
        SELECT COUNT(DISTINCT PL.RelatedPostId)
        FROM PostLinks PL
        WHERE PL.PostId = PPM.QuestionId AND PL.LinkTypeId = 1
    ) AS LinkedQuestionCount,
    (
        SELECT SUM(C.Score)
        FROM Comments C
        WHERE C.PostId = PPM.QuestionId AND C.UserId = UAS.UserId
    ) AS TotalUserCommentScoreOnOwnQuestion,
    (PPM.QuestionScore * 0.4 + PPM.ViewCount * 0.1 + COALESCE(PPM.FavoriteCount, 0) * 0.2 + COALESCE(PPM.SumOfAllAnswerScores, 0) * 0.3) AS WeightedQuestionEngagementScore,
    (UAS.TotalPostsOwned * 0.5 + UAS.TotalCommentsMade * 0.3 + UAS.TotalBadgesEarned * 0.2) AS UserActivityIndex,
    CASE
        WHEN PPM.DaysToClose IS NOT NULL AND PPM.DaysToClose <= 5 THEN 'QuicklyClosed'
        WHEN PPM.DaysToClose IS NOT NULL AND PPM.DaysToClose > 5 THEN 'EventuallyClosed'
        WHEN PPM.ClosedDate IS NULL AND PPM.ActualAnswerCount > 0 AND (PPM.FirstAnswerDate - PPM.QuestionCreationDate) < INTERVAL '24 hour' THEN 'QuicklyAnsweredOpen'
        WHEN PPM.ClosedDate IS NULL AND PPM.ActualAnswerCount > 0 THEN 'AnsweredOpen'
        ELSE 'UnansweredOpen'
    END AS DetailedQuestionStatus,
    PPM.LastQuestionActivityDate AS QuestionLastActivityDate,
    'ComprehensiveAnalysisSegment' AS SegmentSource
FROM UserActivitySummary UAS
INNER JOIN PostPerformanceMetrics PPM ON UAS.UserId = PPM.QuestionOwnerUserId
LEFT JOIN AnswerDetails AD ON PPM.QuestionId = AD.QuestionId AND AD.RankInAnswersForQuestion = 1
LEFT JOIN LATERAL (
    SELECT T.TagName
    FROM UNNEST(string_to_array(TRIM(BOTH '<>' FROM PPM.QuestionTagsString), '><')) AS tag_name_unnested
    JOIN Tags T ON T.TagName = tag_name_unnested
    ORDER BY T.Count DESC, T.TagName ASC
    LIMIT 1
) AS T1 ON TRUE
LEFT JOIN LATERAL (
    SELECT T.TagName
    FROM UNNEST(string_to_array(TRIM(BOTH '<>' FROM PPM.QuestionTagsString), '><')) AS tag_name_unnested
    JOIN Tags T ON T.TagName = tag_name_unnested
    ORDER BY T.Count DESC, T.TagName ASC
    OFFSET 1
    LIMIT 1
) AS T2 ON TRUE
WHERE
    UAS.Reputation > 5000
    AND PPM.QuestionScore > 50
    AND PPM.ViewCount > 1000
    AND (PPM.ClosedDate IS NULL OR PPM.ActualAnswerCount >= 1)
    AND UAS.TotalEditsMadeByUsers > 5
    AND NOT EXISTS (
        SELECT 1
        FROM PostHistory PH_Del
        WHERE PH_Del.PostId = PPM.QuestionId AND PH_Del.PostHistoryTypeId = 12
          AND PH_Del.CreationDate > PPM.QuestionCreationDate
    )
    AND UAS.DisplayName IS NOT NULL
    AND PPM.QuestionTitle IS NOT NULL

UNION ALL

SELECT
    UAS.UserId,
    UAS.DisplayName,
    UAS.Reputation,
    UAS.UserWebsiteStatus,
    UAS.AboutMeLengthChars,
    UAS.UserActivityCategory,
    HEQ.QuestionId,
    HEQ.QuestionTitle,
    HEQ.QuestionScore,
    NULL AS ViewCount,
    NULL AS DeclaredAnswerCount,
    NULL AS ActualAnswerCount,
    NULL AS FavoriteCount,
    HEQ.QuestionCreationDate,
    NULL AS ClosedDate,
    NULL AS DaysToClose,
    NULL AS CloseReasonTypeName,
    NULL AS FirstAnswerDate,
    NULL AS HoursToFirstAnswer,
    NULL AS SumOfAllAnswerScores,
    NULL AS UserQuestionRankByScore,
    NULL AS ViewCountDecile,
    NULL AS AvgQuestionScoreInYear,
    NULL AS BestAnswerIdByScore,
    NULL AS BestAnswerScore,
    NULL AS BestAnswerCreationDate,
    NULL AS BestAnswerOwnerUserId,
    NULL AS BestAnswerCommentCount,
    'HOT_TOPIC' AS PrimaryTag,
    'GLOBAL_IMPACT' AS SecondaryTag,
    TRIM(LOWER(SUBSTRING(UAS.DisplayName FROM 1 FOR 4))) || '-' || LPAD(CAST(UAS.UserId AS VARCHAR), 8, '0') AS UserIdentifierHash,
    NULL AS LinkedQuestionCount,
    NULL AS TotalUserCommentScoreOnOwnQuestion,
    (HEQ.QuestionScore * 1.5) AS WeightedQuestionEngagementScore,
    (UAS.TotalPostsOwned * 0.7 + UAS.TotalBadgesEarned * 0.3) AS UserActivityIndex,
    HEQ.QuestionCategoryType AS DetailedQuestionStatus,
    NULL AS QuestionLastActivityDate,
    'HighlyEngagedSegment' AS SegmentSource
FROM UserActivitySummary UAS
INNER JOIN HighlyEngagedQuestions HEQ ON UAS.UserId = HEQ.QuestionOwnerUserId
WHERE
    UAS.Reputation > 10000
    AND UAS.TotalBadgesEarned >= 10
    AND UAS.TotalPostsOwned >= 50
    AND UAS.UserActivityCategory = 'HighlyActiveVeteran'
    AND HEQ.QuestionScore >= 250
    AND NOT EXISTS (
        SELECT 1
        FROM Badges B
        WHERE B.UserId = UAS.UserId AND B.Name ILIKE '%deputy%'
    )

ORDER BY WeightedQuestionEngagementScore DESC, UserActivityIndex DESC, QuestionCreationDate DESC
LIMIT 20000;