WITH user_activity_metrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS total_posts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS questions_asked,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answers_given,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) AS avg_post_score,
        SUM(COALESCE(p.ViewCount, 0)) AS total_views,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) FILTER (WHERE p.Score IS NOT NULL) AS median_score,
        MAX(p.CreationDate) AS last_post_date,
        MIN(p.CreationDate) AS first_post_date
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Reputation > 100
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
tag_expertise AS (
    SELECT 
        p.OwnerUserId,
        TRIM(tag_name) AS tag_name,
        COUNT(*) AS tag_post_count,
        SUM(p.Score) AS tag_total_score,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY SUM(p.Score) DESC) AS tag_rank
    FROM (
        SELECT p.*, UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), '><')) AS tag_name
        FROM Posts p
        WHERE p.Tags IS NOT NULL 
            AND p.PostTypeId = 1
            AND p.OwnerUserId IS NOT NULL
    ) p
    GROUP BY p.OwnerUserId, tag_name
),
edit_patterns AS (
    SELECT 
        ph.UserId,
        COUNT(DISTINCT ph.PostId) AS edited_posts,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (4,5,6) THEN ph.Id END) AS edit_actions,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (7,8,9) THEN ph.Id END) AS rollback_actions,
        STRING_AGG(DISTINCT pht.Name, ', ' ORDER BY pht.Name) AS edit_types_used,
        AVG(EXTRACT(EPOCH FROM (ph.CreationDate - p.CreationDate))/3600.0) AS avg_hours_to_first_edit
    FROM PostHistory ph
    INNER JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
    INNER JOIN Posts p ON ph.PostId = p.Id
    WHERE ph.UserId IS NOT NULL
        AND ph.PostHistoryTypeId BETWEEN 2 AND 9
    GROUP BY ph.UserId
),
voting_behavior AS (
    SELECT 
        v.UserId,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 2) AS upvotes_cast,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 3) AS downvotes_cast,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 5) AS favorites_marked,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 8) AS bounties_started,
        SUM(v.BountyAmount) FILTER (WHERE v.VoteTypeId = 8) AS total_bounty_offered,
        CASE 
            WHEN COUNT(*) FILTER (WHERE v.VoteTypeId = 3) = 0 THEN NULL
            ELSE CAST(COUNT(*) FILTER (WHERE v.VoteTypeId = 2) AS DOUBLE PRECISION) / 
                 NULLIF(COUNT(*) FILTER (WHERE v.VoteTypeId = 3), 0)
        END AS upvote_downvote_ratio
    FROM Votes v
    WHERE v.UserId IS NOT NULL
    GROUP BY v.UserId
),
badge_achievements AS (
    SELECT 
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS gold_badges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS silver_badges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS bronze_badges,
        COUNT(DISTINCT b.Name) AS unique_badges,
        STRING_AGG(CASE WHEN b.Class = 1 THEN b.Name END, ', ' ORDER BY b.Date DESC) AS gold_badge_names,
        MAX(b.Date) AS last_badge_date
    FROM Badges b
    GROUP BY b.UserId
)
SELECT 
    uam.DisplayName,
    COALESCE(uam.DisplayName, 'Anonymous User #' || CAST(uam.Id AS VARCHAR)) AS display_name_fallback,
    uam.Reputation,
    uam.total_posts,
    uam.questions_asked,
    uam.answers_given,
    ROUND(CAST(uam.avg_post_score AS numeric), 2) AS avg_post_score,
    uam.median_score,
    uam.total_views,
    EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uam.first_post_date)) AS days_since_first_post,
    CASE 
        WHEN uam.total_posts > 0 
        THEN ROUND(CAST(uam.total_views AS numeric) / NULLIF(uam.total_posts, 0), 1)
        ELSE 0 
    END AS avg_views_per_post,
    COALESCE(te.tag_name, 'No Primary Tag') AS primary_expertise_tag,
    COALESCE(te.tag_total_score, 0) AS primary_tag_score,
    COALESCE(ep.edited_posts, 0) AS posts_edited,
    COALESCE(ep.edit_actions, 0) AS total_edits,
    COALESCE(ep.rollback_actions, 0) AS total_rollbacks,
    ROUND(CAST(COALESCE(ep.avg_hours_to_first_edit, 0) AS numeric), 2) AS avg_hours_to_edit,
    SUBSTRING(COALESCE(ep.edit_types_used, 'No edits') FROM 1 FOR 100) AS edit_types_summary,
    COALESCE(vb.upvotes_cast, 0) AS upvotes_given,
    COALESCE(vb.downvotes_cast, 0) AS downvotes_given,
    ROUND(CAST(COALESCE(vb.upvote_downvote_ratio, 0) AS numeric), 2) AS vote_ratio,
    COALESCE(vb.bounties_started, 0) AS bounties_offered,
    COALESCE(vb.total_bounty_offered, 0) AS total_bounty_amount,
    COALESCE(ba.gold_badges, 0) AS gold_count,
    COALESCE(ba.silver_badges, 0) AS silver_count,
    COALESCE(ba.bronze_badges, 0) AS bronze_count,
    COALESCE(ba.unique_badges, 0) AS unique_badge_count,
    SUBSTRING(COALESCE(ba.gold_badge_names, 'None') FROM 1 FOR 200) AS gold_badges_earned,
    CASE 
        WHEN uam.last_post_date IS NULL THEN 'Never Posted'
        WHEN EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uam.last_post_date)) > 365 THEN 'Inactive'
        WHEN EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uam.last_post_date)) > 90 THEN 'Low Activity'
        WHEN EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - uam.last_post_date)) > 30 THEN 'Moderate Activity'
        ELSE 'Active'
    END AS activity_status,
    RANK() OVER (ORDER BY uam.Reputation DESC) AS reputation_rank,
    DENSE_RANK() OVER (ORDER BY COALESCE(te.tag_total_score, 0) DESC) AS expertise_rank,
    ROW_NUMBER() OVER (PARTITION BY 
        CASE 
            WHEN uam.Reputation >= 10000 THEN 'Expert'
            WHEN uam.Reputation >= 1000 THEN 'Advanced'
            WHEN uam.Reputation >= 100 THEN 'Intermediate'
            ELSE 'Beginner'
        END 
        ORDER BY uam.total_views DESC) AS views_rank_in_tier,
    LAG(uam.Reputation, 1) OVER (ORDER BY uam.Reputation DESC) - uam.Reputation AS reputation_gap_to_next,
    FIRST_VALUE(uam.DisplayName) OVER (
        PARTITION BY EXTRACT(YEAR FROM uam.first_post_date) 
        ORDER BY uam.Reputation DESC
    ) AS top_user_in_cohort_year,
    uam.Id,
    te.tag_total_score,
    ep.avg_hours_to_first_edit,
    uam.last_post_date,
    uam.first_post_date
FROM user_activity_metrics uam
LEFT JOIN tag_expertise te ON uam.Id = te.OwnerUserId AND te.tag_rank = 1
LEFT JOIN edit_patterns ep ON uam.Id = ep.UserId
LEFT JOIN voting_behavior vb ON uam.Id = vb.UserId
LEFT JOIN badge_achievements ba ON uam.Id = ba.UserId
WHERE uam.total_posts > 0
    OR EXISTS (
        SELECT 1 
        FROM Comments c 
        WHERE c.UserId = uam.Id
            AND CHAR_LENGTH(c.Text) > 50
    )
    OR uam.Id IN (
        SELECT ph.UserId 
        FROM PostHistory ph 
        WHERE ph.PostHistoryTypeId IN (10, 11, 12, 13)
            AND ph.UserId IS NOT NULL
        INTERSECT
        SELECT v.UserId
        FROM Votes v
        WHERE v.VoteTypeId IN (8, 9)
            AND v.UserId IS NOT NULL
    )
ORDER BY 
    uam.Reputation DESC,
    COALESCE(te.tag_total_score, 0) DESC,
    uam.total_views DESC
FETCH FIRST 100 ROWS ONLY;