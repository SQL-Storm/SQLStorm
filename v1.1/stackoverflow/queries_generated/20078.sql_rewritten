-- {"query": "20078.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-pro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1723} 
WITH UserActivity AS (
    -- Step 1: Select active users and calculate their tenure.
    SELECT
        Id,
        Reputation,
        CreationDate,
        DisplayName,
        EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - CreationDate)) / 86400.0 AS AccountAgeDays,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount
    FROM
        Users u
    WHERE
        LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
        AND Reputation > 1000
        AND AboutMe IS NOT NULL
),
PostStats AS (
    -- Step 2: Analyze user's posts, focusing on answers. Use window functions to find time between posts.
    SELECT
        p.OwnerUserId,
        AVG(p.Score) AS AvgAnswerScore,
        SUM(CASE WHEN p.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) * 100.0 / COUNT(p.Id) AS PctAcceptedAnswers,
        AVG(EXTRACT(EPOCH FROM (p.CreationDate - LAG(p.CreationDate, 1, p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate)))) / 3600.0 AS AvgHoursBetweenAnswers,
        COUNT(DISTINCT regexp_replace(unnest(string_to_array(substring(q.Tags, 2, length(q.Tags)-2), '><')), E'<|>', '', 'g')) AS DistinctTagsAnswered
    FROM
        Posts p
    JOIN
        Posts q ON p.ParentId = q.Id
    WHERE
        p.PostTypeId = 2 -- Answers
        AND p.OwnerUserId IN (SELECT Id FROM UserActivity)
        AND p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '5 years'
    GROUP BY
        p.OwnerUserId
),
BadgeAndVoteStats AS (
    -- Step 3: Aggregate badge counts and voting activity.
    SELECT
        u.Id AS UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        (
            SELECT
                AVG(EXTRACT(EPOCH FROM (v.CreationDate - p_sub.CreationDate)))
            FROM
                Votes v
            JOIN
                Posts p_sub ON v.PostId = p_sub.Id
            WHERE
                v.VoteTypeId = 2 -- UpMod
                AND p_sub.OwnerUserId = u.Id
                AND v.CreationDate > p_sub.CreationDate
        ) AS AvgTimeToFirstUpvoteSeconds
    FROM
        UserActivity u
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    GROUP BY
        u.Id
),
CommunityEngagement AS (
    -- Step 4: Analyze non-post contributions like comments and close votes.
    SELECT
        ua.Id AS UserId,
        COUNT(c.Id) AS TotalComments,
        SUM(c.Score) AS TotalCommentScore,
        (
            SELECT COUNT(*)
            FROM PostHistory ph
            WHERE ph.UserId = ua.Id
            AND ph.PostHistoryTypeId = 10 -- Post Closed
            AND ph.Comment ~ '^[0-9]+$' -- Check if comment is a CloseReasonId
        ) AS CloseVotesCast
    FROM
        UserActivity ua
    LEFT JOIN
        Comments c ON ua.Id = c.UserId
    GROUP BY
        ua.Id
)
-- Final Aggregation and Ranking
SELECT
    ua.DisplayName,
    ua.Reputation,
    ps.AvgAnswerScore,
    bvs.GoldBadges,
    bvs.SilverBadges,
    ce.CloseVotesCast,
    ps.PctAcceptedAnswers,
    ps.AvgHoursBetweenAnswers,
    -- A complex, arbitrary "Power User Score"
    (
        LOG(ua.Reputation) * 100 +
        COALESCE(ps.AvgAnswerScore, 0) * 5 +
        COALESCE(ps.PctAcceptedAnswers, 0) * 10 +
        bvs.GoldBadges * 100 +
        bvs.SilverBadges * 20 +
        ce.CloseVotesCast * 2 -
        COALESCE(ps.AvgHoursBetweenAnswers, ua.AccountAgeDays * 24) / 100 -
        COALESCE(bvs.AvgTimeToFirstUpvoteSeconds, 3600*24) / 3600
    ) AS PowerScore,
    -- Rank users based on the score
    DENSE_RANK() OVER (ORDER BY (
        LOG(ua.Reputation) * 100 +
        COALESCE(ps.AvgAnswerScore, 0) * 5 +
        COALESCE(ps.PctAcceptedAnswers, 0) * 10 +
        bvs.GoldBadges * 100 +
        bvs.SilverBadges * 20 +
        ce.CloseVotesCast * 2 -
        COALESCE(ps.AvgHoursBetweenAnswers, ua.AccountAgeDays * 24) / 100 -
        COALESCE(bvs.AvgTimeToFirstUpvoteSeconds, 3600*24) / 3600
    ) DESC) AS UserRank,
    -- Categorize users based on their score and activity
    CASE
        WHEN ps.PctAcceptedAnswers > 50 AND bvs.GoldBadges > 5 THEN 'Guru'
        WHEN ps.AvgAnswerScore > 10 OR ce.CloseVotesCast > 100 THEN 'Expert'
        WHEN ua.AnswerCount > ua.QuestionCount THEN 'Answerer'
        ELSE 'Contributor'
    END AS UserCategory,
    -- Example of a correlated subquery and string manipulation
    REVERSE(SUBSTRING(REVERSE((SELECT Text FROM Comments c WHERE c.UserId = ua.Id ORDER BY CreationDate DESC LIMIT 1)), 1, 50)) AS LastCommentSnippet
FROM
    UserActivity ua
LEFT JOIN
    PostStats ps ON ua.Id = ps.OwnerUserId
LEFT JOIN
    BadgeAndVoteStats bvs ON ua.Id = bvs.UserId
LEFT JOIN
    CommunityEngagement ce ON ua.Id = ce.UserId
WHERE
    ua.AnswerCount > 10 AND (ps.AvgAnswerScore > 2 OR bvs.GoldBadges > 0)

UNION ALL

-- Use a set operator to add a baseline "Community User" for comparison
SELECT
    '-- Community Baseline --' AS DisplayName,
    (SELECT AVG(Reputation) FROM Users) AS Reputation,
    (SELECT AVG(Score) FROM Posts WHERE PostTypeId=2) AS AvgAnswerScore,
    0 AS GoldBadges,
    0 AS SilverBadges,
    0 AS CloseVotesCast,
    0 AS PctAcceptedAnswers,
    NULL AS AvgHoursBetweenAnswers,
    0 AS PowerScore,
    99999 AS UserRank,
    'Baseline' AS UserCategory,
    NULL AS LastCommentSnippet

ORDER BY
    UserRank, PowerScore DESC
LIMIT 100;