WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank,
        AVG(COALESCE(p.Score, 0)) AS AvgScore
    FROM 
        Users u
    LEFT JOIN 
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN 
        Badges b ON u.Id = b.UserId
    WHERE 
        u.CreationDate >= DATE_TRUNC('month', DATE '2024-10-01' - INTERVAL '1 year')
        AND p.CreationDate >= DATE_TRUNC('month', DATE '2024-10-01' - INTERVAL '1 year')
    GROUP BY 
        u.Id, u.DisplayName
),
TopTags AS (
    SELECT 
        t.TagName,
        COUNT(p.Id) AS PostCount,
        STRING_AGG(DISTINCT SUBSTRING(p.Title FROM 1 FOR 50), ', ') AS SampleTitles
    FROM 
        Tags t
    JOIN 
        Posts p ON EXISTS (
            SELECT 1
            FROM (
                SELECT REGEXP_SPLIT_TO_TABLE(TRIM(BOTH '[]' FROM p.Tags), '][') AS tagid
            ) s
            WHERE s.tagid ~ '^[0-9]+$'
              AND CAST(s.tagid AS INTEGER) = t.Id
        )
    WHERE 
        p.PostTypeId = 1
        AND p.CreationDate >= DATE_TRUNC('month', DATE '2024-10-01' - INTERVAL '6 months')
    GROUP BY 
        t.TagName
    ORDER BY 
        PostCount DESC
    LIMIT 5
)
SELECT 
    ua.UserId,
    ua.DisplayName,
    ua.TotalPosts,
    ua.TotalQuestions,
    ua.TotalAnswers,
    ua.TotalBadges,
    tt.TagName,
    tt.PostCount,
    tt.SampleTitles,
    COALESCE(ph.EditCount, 0) AS EditCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId IN (SELECT p2.Id FROM Posts p2 WHERE p2.OwnerUserId = ua.UserId)) AS TotalVotes
FROM 
    UserActivity ua
CROSS JOIN 
    TopTags tt
LEFT JOIN (
    SELECT 
        UserId,
        COUNT(*) AS EditCount
    FROM 
        PostHistory
    WHERE 
        PostHistoryTypeId IN (4, 5, 6)
    GROUP BY 
        UserId
) ph ON ua.UserId = ph.UserId
WHERE 
    ua.AvgScore > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1)
GROUP BY
    ua.UserId,
    ua.DisplayName,
    ua.TotalPosts,
    ua.TotalQuestions,
    ua.TotalAnswers,
    ua.TotalBadges,
    ua.PostRank,
    ua.AvgScore,
    tt.TagName,
    tt.PostCount,
    tt.SampleTitles,
    ph.EditCount
ORDER BY 
    ua.PostRank, tt.PostCount DESC
LIMIT 10;