WITH ActiveUsers AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        COUNT(p.Id) AS PostCount,
        COUNT(c.Id) AS CommentCount,
        COUNT(v.Id) AS VoteCount
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    WHERE
        u.LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
    GROUP BY
        u.Id, u.Reputation, u.DisplayName
), TopTags AS (
    SELECT
        t.TagName,
        t.Count,
        COUNT(p.Id) AS PostsWithTag,
        AVG(p.Score) AS AverageScore
    FROM
        Tags t
    JOIN
        Posts p ON t.TagName = ANY(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), ''><''))
    WHERE
        p.PostTypeId = 1
    GROUP BY
        t.TagName, t.Count
    ORDER BY
        PostsWithTag DESC
    LIMIT 10
), UserActivity AS (
    SELECT
        au.UserId,
        au.DisplayName,
        au.Reputation,
        au.PostCount,
        au.CommentCount,
        au.VoteCount,
        COUNT(ph.Id) AS PostHistoryCount,
        COUNT(DISTINCT pl.RelatedPostId) AS LinkedPosts,
        COUNT(DISTINCT v.Id) AS UpVotes,
        COUNT(DISTINCT v2.Id) AS DownVotes,
        COALESCE (MAX(b.Class), 3) AS HighestBadgeClass
    FROM
        ActiveUsers au
    LEFT JOIN
        PostHistory ph ON au.UserId = ph.UserId
    LEFT JOIN
        PostLinks pl ON au.UserId = pl.PostId OR au.UserId = pl.RelatedPostId
    LEFT JOIN
        Votes v ON au.UserId = v.UserId AND v.VoteTypeId = 2
    LEFT JOIN
        Votes v2 ON au.UserId = v2.UserId AND v2.VoteTypeId = 3
    LEFT JOIN
        Badges b ON au.UserId = b.UserId
    GROUP BY
        au.UserId, au.DisplayName, au.Reputation, au.PostCount, au.CommentCount, au.VoteCount
    ORDER BY
        au.Reputation DESC, au.PostCount DESC
    LIMIT 20
)
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.PostCount,
    ua.CommentCount,
    ua.VoteCount,
    ua.PostHistoryCount,
    ua.LinkedPosts,
    ua.UpVotes,
    ua.DownVotes,
    ua.HighestBadgeClass,
    tt.TagName,
    tt.PostsWithTag,
    tt.AverageScore
FROM
    UserActivity ua
CROSS JOIN
    TopTags tt
ORDER BY
    ua.Reputation DESC,
    tt.PostsWithTag DESC;