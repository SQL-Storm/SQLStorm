WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS PostCount,
        SUM(p.Score) AS TotalPostScore,
        AVG(p.Score) AS AvgPostScore,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS UpVoteReceived,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS DownVoteReceived,
        MIN(p.CreationDate) AS FirstPostDate,
        MAX(p.CreationDate) AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
RankedUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        PostCount,
        TotalPostScore,
        AvgPostScore,
        CommentCount,
        BadgeCount,
        UpVoteReceived,
        DownVoteReceived,
        FirstPostDate,
        LastPostDate,
        ROW_NUMBER() OVER (ORDER BY TotalPostScore DESC, BadgeCount DESC, Reputation DESC) AS Rank
    FROM UserStats
),
UserTagCounts AS (
    SELECT
        p.OwnerUserId AS UserId,
        t.TagName,
        COUNT(*) AS TagCount
    FROM Posts p
    CROSS JOIN LATERAL (
        -- split tags like '<tag1><tag2>' into rows; compatible approach using string functions
        SELECT TRIM(tag) AS tag_str
        FROM (
            SELECT UNNEST(string_to_array(substring(p.Tags FROM 2 FOR char_length(p.Tags)-2), '><')) AS tag
        ) s
    ) split_tags
    JOIN Tags t ON t.TagName = split_tags.tag_str
    GROUP BY p.OwnerUserId, t.TagName
),
TopTagsPerUser AS (
    SELECT
        utc.UserId,
        utc.TagName
    FROM (
        SELECT
            utc.*,
            ROW_NUMBER() OVER (PARTITION BY utc.UserId ORDER BY utc.TagCount DESC, utc.TagName) AS rn
        FROM UserTagCounts utc
    ) utc
    WHERE utc.rn <= 5
)
SELECT 
    ru.UserId,
    ru.DisplayName,
    ru.Reputation,
    ru.PostCount,
    ru.TotalPostScore,
    ru.AvgPostScore,
    ru.CommentCount,
    ru.BadgeCount,
    ru.UpVoteReceived,
    ru.DownVoteReceived,
    ru.FirstPostDate,
    ru.LastPostDate,
    ru.Rank,
    CASE 
        WHEN ru.TotalPostScore > 1000 AND ru.BadgeCount > 10 THEN 'Elite Contributor'
        WHEN ru.TotalPostScore > 500 THEN 'Active User'
        ELSE 'Casual User'
    END AS UserCategory,
    (SELECT STRING_AGG(tt.TagName, ', ' ORDER BY tt.TagName)
     FROM TopTagsPerUser tt
     WHERE tt.UserId = ru.UserId
    ) AS TopTags
FROM RankedUsers ru
ORDER BY ru.Rank
LIMIT 100;