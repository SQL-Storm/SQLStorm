SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.BadgeClass AS BadgeClass,
    t.TagName,
    ph.RevisionGUID,
    ph.LastAccessDate AS LastRevisionDate,
    ph.Comment,
    v.VoteTypeId,
    AVG(v.BountyAmount) AS AvgBountyPerPost,
    AVG(p.Score) AS AvgScore,
    AVG(p.ViewCount) AS AvgViewCount
FROM 
    Users u
LEFT JOIN 
    (
      SELECT 
         Id, 
         UserId, 
         MAX(CreationDate) AS LastAccessDate,
         MAX(RevisionGUID) AS RevisionGUID,
         MAX(Comment) AS Comment
     FROM 
         PostHistory
     GROUP BY 
         Id, UserId
    ) ph ON u.Id = ph.UserId
LEFT JOIN 
    (
      SELECT 
         Id, 
         UserId, 
         BadgeClass, 
         Date
     FROM 
         Badges
     WHERE 
         TagBased = FALSE
    ) b ON u.Id = b.UserId
RIGHT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Tags t ON p.Tags LIKE '%' || t.TagName || '%'
LEFT JOIN 
    Votes v ON p.Id = v.PostId
WHERE 
    u.Reputation > 1000
    AND p.LastActivityDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1' YEAR)
GROUP BY 
    u.DisplayName, 
    u.Reputation, 
    u.CreationDate,
    p.LastActivityDate,
    b.BadgeClass, 
    t.TagName, 
    ph.RevisionGUID, 
    ph.LastAccessDate, 
    ph.Comment, 
    v.VoteTypeId
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    AvgScore DESC, 
    AvgViewCount DESC
LIMIT 100;