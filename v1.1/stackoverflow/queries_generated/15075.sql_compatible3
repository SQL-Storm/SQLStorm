WITH RankedUserPosts AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        p.Id AS PostId,
        p.Score,
        p.CreationDate,
        DENSE_RANK() OVER (PARTITION BY u.Id ORDER BY p.Score DESC) AS ScoreRank,
        COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) OVER (PARTITION BY u.Id) AS TotalUpvotes,
        COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) AS TotalInteractions
    FROM 
        Users u
    LEFT JOIN 
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    WHERE 
        p.PostTypeId IN (1, 2)
        AND u.Reputation > 100
),
TagStatistics AS (
    SELECT 
        t.TagName,
        COUNT(DISTINCT p.Id) AS PostCount,
        AVG(p.Score) AS AverageTagScore,
        (SELECT TRIM(BOTH ',' FROM XMLSERIALIZE(CONTENT XMLAGG(XMLELEMENT(NAME x, t2.TagName || ',') ORDER BY t2.TagName) AS CLOB)))
            AS AllTags
    FROM 
        Tags t
    JOIN 
        Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    LEFT JOIN
        Tags t2 ON 1=1
    GROUP BY 
        t.TagName
)
SELECT 
    r.UserId,
    r.DisplayName,
    r.PostId,
    r.Score,
    r.ScoreRank,
    r.TotalUpvotes,
    r.TotalInteractions,
    ts.TagName,
    ts.PostCount,
    ts.AverageTagScore,
    CASE 
        WHEN r.Score > (SELECT AVG(p2.Score) FROM Posts p2) THEN 'High Performance'
        WHEN r.Score < (SELECT AVG(p2.Score) FROM Posts p2) THEN 'Low Performance'
        ELSE 'Average Performance'
    END AS PerformanceCategory,
    ROUND(r.TotalUpvotes * 100.0 / NULLIF(r.TotalInteractions, 0), 2) AS UpvotePercentage,
    ts.AllTags
FROM 
    RankedUserPosts r
JOIN 
    TagStatistics ts ON EXISTS (
        SELECT 1 
        FROM Posts p 
        WHERE p.Id = r.PostId 
        AND p.Tags LIKE '%' || ts.TagName || '%'
    )
WHERE 
    r.ScoreRank <= 3
    AND r.TotalInteractions > 0
GROUP BY
    r.UserId,
    r.DisplayName,
    r.PostId,
    r.Score,
    r.ScoreRank,
    r.TotalUpvotes,
    r.TotalInteractions,
    ts.TagName,
    ts.PostCount,
    ts.AverageTagScore,
    ts.AllTags
ORDER BY 
    r.TotalUpvotes DESC, 
    r.Score DESC
FETCH FIRST 100 ROWS ONLY;