WITH cte AS (
  SELECT 
    p.Id,
    p.PostTypeId,
    p.AcceptedAnswerId,
    p.ParentId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.LastEditorUserId,
    p.LastEditDate,
    p.LastActivityDate,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.ClosedDate,
    p.CommunityOwnedDate,
    p.ContentLicense,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    u.Views AS UserViews,
    u.UpVotes AS UserUpVotes,
    u.DownVotes AS UserDownVotes,
    u.ProfileImageUrl,
    u.EmailHash AS EmailHash,
    u.AccountId,
    b.Id AS BadgeId,
    b.Name AS BadgeName,
    b.Date AS BadgeDate,
    b.Class AS BadgeClass,
    b.TagBased AS IsBadgeTagBased,
    l.Name AS LinkTypeName,
    c.Id AS CommentId,
    c.Score AS CommentScore,
    c.Text AS CommentText,
    c.CreationDate AS CommentCreationDate,
    c.UserDisplayName AS CommentUserDisplayName,
    c.UserId AS CommentUserId,
    c.ContentLicense AS CommentContentLicense,
    pt.Name AS PostTypeName,
    cr.Name AS CloseReasonName,
    vt.Name AS VoteTypeName,
    ph.Id AS PostHistoryId,
    ph.PostHistoryTypeId,
    ph.RevisionGUID,
    ph.CreationDate AS PostHistoryCreationDate,
    ph.UserId AS PostHistoryUserId,
    ph.UserDisplayName AS PostHistoryUserDisplayName,
    ph.Comment AS PostHistoryComment,
    ph.Text AS PostHistoryText,
    ph.ContentLicense AS PostHistoryContentLicense,
    pl.Id AS PostLinkId,
    pl.CreationDate AS PostLinkCreationDate,
    pl.RelatedPostId,
    t.TagName,
    t.Count AS TagCount,
    t.ExcerptPostId,
    t.WikiPostId,
    t.IsModeratorOnly,
    t.IsRequired,
    v.Id AS VoteId,
    v.VoteTypeId,
    v.UserId AS VoteUserId,
    v.CreationDate AS VoteCreationDate,
    v.BountyAmount
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN Badges b ON u.Id = b.UserId
  LEFT JOIN PostLinks pl ON p.Id = pl.PostId
  LEFT JOIN LinkTypes l ON pl.LinkTypeId = l.Id
  LEFT JOIN Comments c ON p.Id = c.PostId
  LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
  LEFT JOIN PostHistory ph ON p.Id = ph.PostId
  LEFT JOIN CloseReasonTypes cr 
    ON p.ClosedDate IS NOT NULL 
    AND (
      ph.Text IS NOT NULL AND POSITION(CAST(cr.Id AS VARCHAR) IN ph.Text) > 0
    )
  LEFT JOIN Votes v ON p.Id = v.PostId
  LEFT JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
  LEFT JOIN Tags t ON p.Id = t.ExcerptPostId OR p.Id = t.WikiPostId
),
ranked_cte AS (
  SELECT 
    cte.Id,
    cte.PostTypeId,
    cte.AcceptedAnswerId,
    cte.ParentId,
    cte.CreationDate,
    cte.Score,
    cte.ViewCount,
    cte.OwnerUserId,
    cte.LastEditorUserId,
    cte.LastEditDate,
    cte.LastActivityDate,
    cte.AnswerCount,
    cte.CommentCount,
    cte.FavoriteCount,
    cte.ClosedDate,
    cte.CommunityOwnedDate,
    cte.ContentLicense,
    cte.Reputation,
    cte.UserCreationDate,
    cte.LastAccessDate,
    cte.UserViews,
    cte.UserUpVotes,
    cte.UserDownVotes,
    cte.ProfileImageUrl,
    cte.EmailHash,
    cte.AccountId,
    cte.BadgeId,
    cte.BadgeName,
    cte.BadgeDate,
    cte.BadgeClass,
    cte.IsBadgeTagBased,
    cte.LinkTypeName,
    cte.CommentId,
    cte.CommentScore,
    cte.CommentText,
    cte.CommentCreationDate,
    cte.CommentUserDisplayName,
    cte.CommentUserId,
    cte.CommentContentLicense,
    cte.PostTypeName,
    cte.CloseReasonName,
    cte.VoteTypeName,
    cte.PostHistoryId,
    cte.PostHistoryTypeId,
    cte.RevisionGUID,
    cte.PostHistoryCreationDate,
    cte.PostHistoryUserId,
    cte.PostHistoryUserDisplayName,
    cte.PostHistoryComment,
    cte.PostHistoryText,
    cte.PostHistoryContentLicense,
    cte.PostLinkId,
    cte.PostLinkCreationDate,
    cte.RelatedPostId,
    cte.TagName,
    cte.TagCount,
    cte.ExcerptPostId,
    cte.WikiPostId,
    cte.IsModeratorOnly,
    cte.IsRequired,
    cte.VoteId,
    cte.VoteTypeId,
    cte.VoteUserId,
    cte.VoteCreationDate,
    cte.BountyAmount,
    RANK() OVER (PARTITION BY cte.Id ORDER BY cte.LastActivityDate DESC) AS activity_rank
  FROM cte
)
SELECT 
  ranked_cte.Id,
  ranked_cte.PostTypeId,
  ranked_cte.AcceptedAnswerId,
  ranked_cte.ParentId,
  ranked_cte.CreationDate,
  ranked_cte.Score,
  ranked_cte.ViewCount,
  ranked_cte.OwnerUserId,
  ranked_cte.LastEditorUserId,
  ranked_cte.LastEditDate,
  ranked_cte.LastActivityDate,
  ranked_cte.AnswerCount,
  ranked_cte.CommentCount,
  ranked_cte.FavoriteCount,
  ranked_cte.ClosedDate,
  ranked_cte.CommunityOwnedDate,
  ranked_cte.ContentLicense,
  ranked_cte.Reputation,
  ranked_cte.UserCreationDate,
  ranked_cte.LastAccessDate,
  ranked_cte.UserViews,
  ranked_cte.UserUpVotes,
  ranked_cte.UserDownVotes,
  ranked_cte.ProfileImageUrl,
  ranked_cte.EmailHash,
  ranked_cte.AccountId,
  ranked_cte.BadgeId,
  ranked_cte.BadgeName,
  ranked_cte.BadgeDate,
  ranked_cte.BadgeClass,
  ranked_cte.IsBadgeTagBased,
  ranked_cte.LinkTypeName,
  ranked_cte.CommentId,
  ranked_cte.CommentScore,
  ranked_cte.CommentText,
  ranked_cte.CommentCreationDate,
  ranked_cte.CommentUserDisplayName,
  ranked_cte.CommentUserId,
  ranked_cte.CommentContentLicense,
  ranked_cte.PostTypeName,
  ranked_cte.CloseReasonName,
  ranked_cte.VoteTypeName,
  ranked_cte.PostHistoryId,
  ranked_cte.PostHistoryTypeId,
  ranked_cte.RevisionGUID,
  ranked_cte.PostHistoryCreationDate,
  ranked_cte.PostHistoryUserId,
  ranked_cte.PostHistoryUserDisplayName,
  ranked_cte.PostHistoryComment,
  ranked_cte.PostHistoryText,
  ranked_cte.PostHistoryContentLicense,
  ranked_cte.PostLinkId,
  ranked_cte.PostLinkCreationDate,
  ranked_cte.RelatedPostId,
  ranked_cte.TagName,
  ranked_cte.TagCount,
  ranked_cte.ExcerptPostId,
  ranked_cte.WikiPostId,
  ranked_cte.IsModeratorOnly,
  ranked_cte.IsRequired,
  ranked_cte.VoteId,
  ranked_cte.VoteTypeId,
  ranked_cte.VoteUserId,
  ranked_cte.VoteCreationDate,
  ranked_cte.BountyAmount
FROM ranked_cte
WHERE activity_rank = 1
ORDER BY ranked_cte.LastActivityDate DESC
FETCH FIRST 10 ROWS ONLY;