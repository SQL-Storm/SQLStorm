WITH TagPopularity AS (
    SELECT 
        Tags.TagName, 
        Tags.Count,
        NTILE(10) OVER (ORDER BY Tags.Count DESC) AS PopularityTier,
        AVG(Posts.Score) OVER (PARTITION BY Tags.TagName) AS AvgTagScore
    FROM Tags
    JOIN Posts ON (
        -- convert post tags string like '<tag1><tag2>' into array of tag text
        regexp_split_to_array(substring(Posts.Tags FROM 2 FOR (char_length(Posts.Tags)-2)), '><') && ARRAY[Tags.TagName]
        OR
        -- fallback for SQL dialects without regexp_split_to_array/operator overlap: use EXISTS with LIKE
        EXISTS (
            SELECT 1
            WHERE substring(Posts.Tags FROM 2 FOR (char_length(Posts.Tags)-2)) LIKE '%' || Tags.TagName || '%'
        )
    )
),
UserContribution AS (
    SELECT 
        Users.Id AS UserId,
        Users.DisplayName,
        COUNT(DISTINCT Posts.Id) AS PostCount,
        SUM(Posts.Score) AS TotalScore,
        MAX(Posts.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT Posts.Id) DESC) AS PostRank
    FROM Users
    LEFT JOIN Posts ON Users.Id = Posts.OwnerUserId
    GROUP BY Users.Id, Users.DisplayName
)
SELECT 
    COALESCE(uc.DisplayName, 'Anonymous') AS UserName,
    tp.TagName,
    tp.PopularityTier,
    uc.PostCount,
    tp.AvgTagScore,
    CASE 
        WHEN uc.TotalScore > 1000 THEN 'High Impact'
        WHEN uc.TotalScore > 500 THEN 'Moderate Impact'
        ELSE 'Low Impact'
    END AS ContributionLevel,
    EXTRACT(YEAR FROM uc.LastPostDate) AS MostRecentYear,
    (SELECT COUNT(*) 
     FROM Votes v 
     WHERE v.UserId = uc.UserId AND v.VoteTypeId = 2) AS UpvoteCount
FROM UserContribution uc
JOIN TagPopularity tp ON 
    EXISTS (
        SELECT 1 
        FROM Posts p 
        WHERE p.OwnerUserId = uc.UserId 
        AND (
            regexp_split_to_array(substring(p.Tags FROM 2 FOR (char_length(p.Tags)-2)), '><') && ARRAY[tp.TagName]
            OR substring(p.Tags FROM 2 FOR (char_length(p.Tags)-2)) LIKE '%' || tp.TagName || '%'
        )
    )
WHERE 
    uc.PostCount > 10 
    AND tp.PopularityTier <= 5
    AND (uc.TotalScore IS NULL OR uc.TotalScore > 0)
GROUP BY
    uc.DisplayName,
    tp.TagName,
    tp.PopularityTier,
    uc.PostCount,
    tp.AvgTagScore,
    uc.TotalScore,
    uc.LastPostDate,
    uc.UserId
ORDER BY 
    tp.PopularityTier, 
    uc.PostCount DESC
LIMIT 500;