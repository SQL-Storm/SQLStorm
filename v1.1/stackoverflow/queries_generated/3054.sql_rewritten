WITH UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.AnswerCount) AS AnswerCount,
        COUNT(c.Id) AS CommentCount,
        COUNT(DISTINCT bl.RelatedPostId) FILTER (WHERE bl.LinkTypeId = 3) AS DuplicateLinks,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesReceived,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesReceived
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId IN (1, 2)
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        PostLinks bl ON u.Id = (SELECT OwnerUserId FROM Posts WHERE Id = bl.RelatedPostId)
        AND bl.LinkTypeId = 3
    LEFT JOIN
        Votes v ON u.Id = v.UserId
        AND v.PostId IN (
            SELECT Id FROM Posts WHERE OwnerUserId = u.Id
        )
    GROUP BY
        u.Id, u.DisplayName
),
PostHistorySummary AS (
    SELECT
        ph.PostId,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4, 6)) AS EditsCount,
        MAX(ph.CreationDate) AS LastEditDate
    FROM
        PostHistory ph
    GROUP BY
        ph.PostId
),
PostStatistics AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.Tags,
        p.PostTypeId,
        phs.EditsCount,
        phs.LastEditDate
    FROM
        Posts p
    LEFT JOIN
        PostHistorySummary phs ON p.Id = phs.PostId
),
ActivityFlags AS (
    SELECT
        ps.Id,
        CASE WHEN ps.Score > 10 THEN true ELSE false END AS Popular,
        CASE WHEN ps.ViewCount > 1000 THEN true ELSE false END AS HighlyViewed,
        CASE WHEN ps.PostTypeId = 1 AND ps.AnswerCount > 5 THEN true ELSE false END AS EngagedQuestion
    FROM
        PostStatistics ps
),
ComplexQuery AS (
    SELECT
        us.UserId,
        us.DisplayName,
        ps.Title,
        ps.CreationDate,
        ps.Score,
        ps.ViewCount,
        ps.AnswerCount,
        ps.CommentCount,
        ps.Tags,
        af.Popular,
        af.HighlyViewed,
        af.EngagedQuestion,
        COUNT(*) OVER (PARTITION BY us.UserId) AS TotalUserPosts,
        ROW_NUMBER() OVER (PARTITION BY us.UserId ORDER BY ps.CreationDate DESC) AS RecentActivityRank
    FROM
        UserActivity us
    LEFT JOIN
        PostStatistics ps ON us.UserId = ps.OwnerUserId
    LEFT JOIN
        ActivityFlags af ON ps.Id = af.Id
    WHERE
        ps.PostTypeId = 1
        AND ps.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
        AND (
            (af.Popular = true AND af.HighlyViewed = true)
            OR
            (ps.AnswerCount > 10 AND ps.ViewCount > 2000)
        )
        AND EXISTS (
            SELECT 1 FROM Votes v WHERE v.PostId = ps.Id AND v.VoteTypeId = 2
        )
        AND NOT EXISTS (
            SELECT 1 FROM Votes v2 WHERE v2.PostId = ps.Id AND v2.VoteTypeId = 3 AND v2.UserId = us.UserId
        )
)
SELECT
    UserId,
    DisplayName,
    Title,
    CreationDate,
    Score,
    ViewCount,
    AnswerCount,
    CommentCount,
    Tags,
    Popular,
    HighlyViewed,
    EngagedQuestion,
    TotalUserPosts,
    RecentActivityRank
FROM
    ComplexQuery
WHERE
    RecentActivityRank = 1
ORDER BY
    CreationDate DESC
LIMIT 100;