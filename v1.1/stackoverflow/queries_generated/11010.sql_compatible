WITH RecentPosts AS (
    SELECT 
        p.Id, 
        p.Title, 
        p.CreationDate, 
        p.Score, 
        p.ViewCount, 
        p.OwnerUserId,
        u.DisplayName AS OwnerDisplayName, 
        u.Reputation AS OwnerReputation
    FROM 
        Posts p
    JOIN 
        Users u ON p.OwnerUserId = u.Id
    WHERE 
        p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30' DAY)
),
PostVotes AS (
    SELECT 
        PostId, 
        COUNT(*) AS VoteCount
    FROM 
        Votes
    GROUP BY 
        PostId
),
PostTags AS (
    SELECT 
        p.Id AS PostId, 
        GROUP_CONCAT(t.TagName, ', ') AS Tags
    FROM 
        Posts p
    JOIN 
        PostTags pt ON p.Id = pt.PostId
    JOIN
        Tags t ON pt.TagId = t.Id
    GROUP BY 
        p.Id
),
UserBadges AS (
    SELECT 
        UserId, 
        COUNT(*) AS BadgeCount
    FROM 
        Badges
    GROUP BY 
        UserId
)
SELECT 
    RecentPosts.Id, 
    RecentPosts.Title, 
    RecentPosts.CreationDate, 
    RecentPosts.Score, 
    RecentPosts.ViewCount, 
    RecentPosts.OwnerDisplayName, 
    RecentPosts.OwnerReputation, 
    COALESCE(PostVotes.VoteCount, 0) AS VoteCount, 
    COALESCE(PostTags.Tags, '') AS Tags, 
    COALESCE(UserBadges.BadgeCount, 0) AS BadgeCount
FROM 
    RecentPosts
LEFT JOIN 
    PostVotes ON RecentPosts.Id = PostVotes.PostId
LEFT JOIN 
    PostTags ON RecentPosts.Id = PostTags.PostId
LEFT JOIN 
    UserBadges ON RecentPosts.OwnerUserId = UserBadges.UserId
ORDER BY 
    RecentPosts.Score DESC, 
    RecentPosts.ViewCount DESC, 
    RecentPosts.CreationDate DESC
LIMIT 10;