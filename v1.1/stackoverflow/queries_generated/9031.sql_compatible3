WITH RecentBadgeCounts AS (
    SELECT b.UserId,
           COUNT(*) AS BadgeCount
    FROM Badges b
    WHERE b.Date >= CAST('2024-10-01' AS date) - INTERVAL '365' DAY
    GROUP BY b.UserId
),
PostActivity AS (
    SELECT p.Id,
           p.OwnerUserId,
           p.Score,
           p.CreationDate,
           ROW_NUMBER() OVER (
               PARTITION BY p.OwnerUserId
               ORDER BY p.Score DESC, p.CreationDate
           ) AS rn,
           COUNT(*) OVER (PARTITION BY p.OwnerUserId) AS TotalPosts
    FROM Posts p
    WHERE p.PostTypeId = 1
),
TopPosts AS (
    SELECT Id,
           OwnerUserId,
           Score,
           CreationDate
    FROM PostActivity
    WHERE rn <= 3
),
CorrelatedComments AS (
    SELECT p.Id AS PostId,
           SUM(CASE WHEN c.Score > 0 THEN 1 ELSE 0 END) AS PosComments,
           SUM(CASE WHEN c.Score < 0 THEN 1 ELSE 0 END) AS NegComments
    FROM Posts p
    LEFT JOIN Comments c ON c.PostId = p.Id
    WHERE p.PostTypeId = 1
    GROUP BY p.Id
),
-- Recursive split of tags of the form '<tag1><tag2>'
RecursiveSplit AS (
    SELECT p.Id AS PostId,
           CASE
             WHEN SUBSTR(p.Tags, 1, 1) = '<' THEN
               CASE WHEN INSTR(p.Tags, '><') = 0 THEN SUBSTR(p.Tags, 2, LENGTH(p.Tags) - 2)
                    ELSE SUBSTR(p.Tags, 2, INSTR(p.Tags, '><') - 2)
               END
             ELSE NULL
           END AS tag,
           CASE
             WHEN INSTR(p.Tags, '><') = 0 THEN NULL
             ELSE SUBSTR(p.Tags, INSTR(p.Tags, '><') + 2)
           END AS rest
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    UNION ALL
    SELECT r.PostId,
           CASE
             WHEN SUBSTR(r.rest, 1, 1) = '<' THEN
               CASE WHEN INSTR(r.rest, '><') = 0 THEN SUBSTR(r.rest, 2, LENGTH(r.rest) - 2)
                    ELSE SUBSTR(r.rest, 2, INSTR(r.rest, '><') - 2)
               END
             ELSE NULL
           END AS tag,
           CASE
             WHEN r.rest IS NULL THEN NULL
             WHEN INSTR(r.rest, '><') = 0 THEN NULL
             ELSE SUBSTR(r.rest, INSTR(r.rest, '><') + 2)
           END AS rest
    FROM RecursiveSplit r
    WHERE r.rest IS NOT NULL
),
PostTagsNormalized AS (
    SELECT PostId,
           tag
    FROM RecursiveSplit
    WHERE tag IS NOT NULL
),
TagAggregates AS (
    SELECT pt.tag,
           COUNT(*) AS QCount,
           SUM(p.Score) AS TotalScore
    FROM Posts p
    JOIN PostTagsNormalized pt ON pt.PostId = p.Id
    WHERE p.PostTypeId = 1
    GROUP BY pt.tag
),
AllTags AS (
    SELECT TagName AS tag
    FROM Tags
    WHERE IsRequired = TRUE
    UNION
    SELECT Name AS tag
    FROM PostHistoryTypes
),
ActiveUsers AS (
    SELECT u.Id,
           u.DisplayName,
           COALESCE(r.BadgeCount, 0) AS RecentBadges,
           COALESCE(q.TotalQuestions, 0) AS NumQuestions,
           COALESCE(v.UpVotes, 0) AS UpVotes,
           COALESCE(v.DownVotes, 0) AS DownVotes
    FROM Users u
    LEFT JOIN RecentBadgeCounts r ON r.UserId = u.Id
    LEFT JOIN (
        SELECT OwnerUserId,
               COUNT(*) AS TotalQuestions
        FROM Posts
        WHERE PostTypeId = 1
        GROUP BY OwnerUserId
    ) q ON q.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT UserId,
               SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
               SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes
        WHERE VoteTypeId IN (2, 3)
        GROUP BY UserId
    ) v ON v.UserId = u.Id
    WHERE u.Reputation > 1000
),
MainQuery AS (
    SELECT au.Id,
           au.DisplayName,
           tp.Score AS TopScore,
           COALESCE(cc.PosComments, 0) - COALESCE(cc.NegComments, 0) AS CommentBalance,
           COALESCE(ta.QCount, 0) AS TaggedQuestions,
           GREATEST(au.UpVotes - au.DownVotes, 0) AS NetVotes,
           CASE
             WHEN au.NumQuestions > 0 THEN ROUND(CAST(au.RecentBadges AS DECIMAL) / au.NumQuestions, 2)
             ELSE NULL
           END AS BadgesPerQuestion,
           (au.DisplayName || '_' || CAST(au.Id AS VARCHAR)) AS UniqueHandle,
           au.RecentBadges
           + COALESCE(tp.Score, 0)
           + (au.UpVotes - au.DownVotes) AS PerfMetric,
           ta.tag AS AggregatedTag,
           at.tag AS ReferenceTag
    FROM ActiveUsers au
    LEFT JOIN TopPosts tp ON tp.OwnerUserId = au.Id
    LEFT JOIN CorrelatedComments cc ON cc.PostId = tp.Id
    LEFT JOIN TagAggregates ta ON ta.tag IN (
         SELECT pt.tag FROM PostTagsNormalized pt WHERE pt.PostId = tp.Id
    )
    FULL OUTER JOIN AllTags at ON ta.tag = at.tag
    GROUP BY
      au.Id,
      au.DisplayName,
      tp.Score,
      cc.PosComments,
      cc.NegComments,
      ta.QCount,
      au.UpVotes,
      au.DownVotes,
      au.NumQuestions,
      au.RecentBadges,
      tp.Id,
      ta.tag,
      at.tag
),
FilteredPositive AS (
    SELECT Id,
           DisplayName,
           TopScore,
           CommentBalance,
           TaggedQuestions,
           NetVotes,
           BadgesPerQuestion,
           UniqueHandle,
           PerfMetric,
           AggregatedTag,
           ReferenceTag
    FROM MainQuery
    WHERE PerfMetric > 0
)
SELECT Id,
       DisplayName,
       TopScore,
       CommentBalance,
       TaggedQuestions,
       NetVotes,
       BadgesPerQuestion,
       UniqueHandle,
       PerfMetric,
       AggregatedTag,
       ReferenceTag
FROM MainQuery
INTERSECT
SELECT Id,
       DisplayName,
       TopScore,
       CommentBalance,
       TaggedQuestions,
       NetVotes,
       BadgesPerQuestion,
       UniqueHandle,
       PerfMetric,
       AggregatedTag,
       ReferenceTag
FROM FilteredPositive
ORDER BY PerfMetric DESC
LIMIT 20;