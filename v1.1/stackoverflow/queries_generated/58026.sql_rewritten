WITH ActiveUsers AS (
    SELECT u.Id, u.DisplayName, u.Reputation, u.Location,
           COUNT(DISTINCT b.Id) AS BadgeCount,
           RANK() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS LocationRank
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId AND b.Date >= cast('2024-10-01' as date) - INTERVAL '1 year'
    WHERE u.Reputation > 1000
    GROUP BY u.Id
    HAVING COUNT(DISTINCT b.Id) > 5
)
SELECT au.DisplayName, au.Reputation, au.Location,
       COUNT(DISTINCT p.Id) AS QuestionCount,
       COUNT(DISTINCT c.Id) AS CommentCount,
       COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpvotesGiven,
       COUNT(DISTINCT ph.Id) FILTER (WHERE ph.PostHistoryTypeId = 10) AS ClosedPosts,
       AVG(p.Score) AS AvgQuestionScore,
       SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS AcceptedAnswers,
       STRING_AGG(DISTINCT t.TagName, ', ' ORDER BY t.TagName) AS TopTags
FROM ActiveUsers au
LEFT JOIN Posts p ON au.Id = p.OwnerUserId
     AND p.PostTypeId = 1
     AND p.Score > 5
     AND p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '1 year'
LEFT JOIN Comments c ON au.Id = c.UserId AND c.CreationDate >= cast('2024-10-01' as date) - INTERVAL '1 year'
LEFT JOIN Votes v ON au.Id = v.UserId AND v.VoteTypeId = 2 AND v.CreationDate >= cast('2024-10-01' as date) - INTERVAL '1 year'
LEFT JOIN PostHistory ph ON au.Id = ph.UserId AND ph.PostHistoryTypeId = 10
LEFT JOIN Posts pt ON ph.PostId = pt.Id AND pt.PostTypeId = 1
LEFT JOIN Tags t ON pt.Tags LIKE CONCAT('%<', t.TagName, '>%')
GROUP BY au.DisplayName, au.Reputation, au.Location
ORDER BY (QuestionCount + CommentCount + UpvotesGiven) DESC, AvgQuestionScore DESC
LIMIT 100;