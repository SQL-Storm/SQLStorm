WITH
  question_posts AS (
    SELECT p.Id                         AS post_id,
           p.Title                      AS title,
           p.Tags                       AS tags,
           p.CreationDate,
           p.LastActivityDate            AS last_activity_date,
           p.AnswerCount,
           p.ViewCount,
           COALESCE(u.Reputation,0)      AS owner_rep,
           COALESCE(u.DisplayName,'Community') AS owner_name,
           COALESCE(v.up_votes,0)-COALESCE(v.down_votes,0) AS net_score
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN (
      SELECT PostId,
             SUM(CASE WHEN VoteTypeId=2 THEN 1 ELSE 0 END) AS up_votes,
             SUM(CASE WHEN VoteTypeId=3 THEN 1 ELSE 0 END) AS down_votes
      FROM Votes
      WHERE VoteTypeId IN (2,3)
      GROUP BY PostId
    ) v ON v.PostId = p.Id
    WHERE p.PostTypeId = 1
  ),

  post_hist AS (
    SELECT ph.PostId,
           MAX(CASE WHEN ph.PostHistoryTypeId=5 THEN ph.CreationDate END)  AS last_edit_date,
           MAX(CASE WHEN ph.PostHistoryTypeId=10 THEN ph.Comment END)      AS close_reason_id
    FROM PostHistory ph
    GROUP BY ph.PostId
  ),

  tag_arr AS (
    SELECT qp.post_id,
           TRIM(tag) AS tag
    FROM question_posts qp,
         UNNEST(STRING_TO_ARRAY(REGEXP_REPLACE(qp.tags,'^[<>]|[<>]$','', 'g'),'"><')) AS t(tag)
  ),

  tag_count AS (
    SELECT ta.post_id,
           ta.tag,
           COUNT(*) OVER(PARTITION BY ta.tag) AS tag_freq
    FROM tag_arr ta
  ),

  ranked AS (
    SELECT qp.post_id,
           qp.title,
           qp.tags,
           qp.CreationDate,
           qp.last_activity_date,
           qp.AnswerCount,
           qp.ViewCount,
           qp.owner_rep,
           qp.owner_name,
           qp.net_score,
           ph.last_edit_date,
           ph.close_reason_id,
           ROW_NUMBER() OVER(PARTITION BY qp.post_id ORDER BY qp.net_score DESC, qp.last_activity_date DESC) AS rn
    FROM question_posts qp
    LEFT JOIN post_hist ph ON ph.PostId = qp.post_id
  ),

  final AS (
    SELECT r.post_id,
           r.title,
           r.net_score,
           r.AnswerCount,
           r.ViewCount,
           r.owner_rep,
           r.owner_name,
           r.last_edit_date,
           cr.Name AS close_reason_name,
           tc.tag,
           tc.tag_freq
    FROM ranked r
    JOIN tag_count tc ON tc.post_id = r.post_id
    LEFT JOIN CloseReasonTypes cr ON cr.Id = CAST(r.close_reason_id AS TEXT) OR cr.Id = r.close_reason_id
    WHERE r.rn = 1
  )

SELECT f.post_id,
       f.title,
       f.net_score,
       f.AnswerCount,
       f.ViewCount,
       f.owner_rep,
       f.owner_name,
       f.last_edit_date,
       f.close_reason_name,
       STRING_AGG(DISTINCT f.tag || '(' || f.tag_freq || ')', ', ') AS tags_info
FROM final f
GROUP BY f.post_id, f.title, f.net_score, f.AnswerCount, f.ViewCount, f.owner_rep, f.owner_name, f.last_edit_date, f.close_reason_name
HAVING f.net_score > 10
ORDER BY f.net_score DESC, f.last_edit_date DESC
LIMIT 200;