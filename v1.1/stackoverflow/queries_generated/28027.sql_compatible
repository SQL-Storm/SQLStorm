WITH UserBadgeStats AS (
    SELECT 
        UserId, 
        COUNT(*) AS TotalBadges,
        MIN(Date) AS FirstBadgeDate,
        ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY MIN(Date)) AS BadgeSequence
    FROM Badges
    GROUP BY UserId
), PostActivity AS (
    SELECT 
        p.Id AS PostId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CreationDate,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id AND c.UserId = p.OwnerUserId) AS OwnerComments,
        COALESCE(NULLIF(p.Tags, ''), 'untagged') AS ProcessedTags,
        RANK() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS PostRecencyRank
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.ClosedDate IS NULL
)
SELECT 
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    CASE 
        WHEN u.Reputation > 100000 THEN 'Legendary'
        WHEN u.Reputation BETWEEN 50000 AND 100000 THEN 'Epic'
        WHEN u.Reputation BETWEEN 20000 AND 49999 THEN 'Mythical'
        ELSE 'Common'
    END AS ReputationTier,
    pa.PostId,
    pa.Score * (pa.ViewCount / 1000.0) + pa.AnswerCount * 10 AS EngagementScore,
    STRING_AGG(DISTINCT ph.Comment, '; ') FILTER (WHERE ph.PostHistoryTypeId = 10) AS CloseReasons,
    (SELECT COUNT(*) FROM Votes v1 WHERE v1.PostId = pa.PostId AND v1.VoteTypeId = 2) -
    (SELECT COUNT(*) FROM Votes v2 WHERE v2.PostId = pa.PostId AND v2.VoteTypeId = 3) AS NetVotes,
    CARDINALITY(STRING_TO_ARRAY(pa.ProcessedTags, '><')) AS TagCount,
    (SELECT SUM(v3.BountyAmount) FROM Votes v3 WHERE v3.UserId = u.Id AND v3.VoteTypeId = 8) AS TotalBountyGiven,
    COALESCE(ub.TotalBadges, 0) AS BadgeCount,
    FIRST_VALUE(pa.ProcessedTags) OVER (PARTITION BY u.Id ORDER BY (pa.Score * (pa.ViewCount / 1000.0) + pa.AnswerCount * 10) DESC) AS TopPostTags
FROM Users u
LEFT JOIN PostActivity pa ON u.Id = pa.OwnerUserId AND pa.PostRecencyRank <= 3
LEFT JOIN UserBadgeStats ub ON u.Id = ub.UserId AND ub.BadgeSequence = 1
LEFT JOIN PostHistory ph ON pa.PostId = ph.PostId AND ph.PostHistoryTypeId IN (10, 11, 12)
LEFT JOIN (
    SELECT PostId, 'Upvote' AS VoteType FROM Votes WHERE VoteTypeId = 2
    UNION ALL
    SELECT PostId, 'Downvote' AS VoteType FROM Votes WHERE VoteTypeId = 3
) v ON pa.PostId = v.PostId
WHERE u.Reputation > 1000
    AND ( (pa.Score * (pa.ViewCount / 1000.0) + pa.AnswerCount * 10) > 100 OR pa.OwnerComments > 5 )
    AND u.Id IN (SELECT UserId FROM Badges WHERE Class = 1)
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, 
    pa.PostId, pa.Score, pa.ViewCount, pa.AnswerCount, pa.CreationDate, pa.OwnerComments, pa.ProcessedTags,
    ub.TotalBadges
HAVING CARDINALITY(STRING_TO_ARRAY(pa.ProcessedTags, '><')) > 3
ORDER BY u.Reputation DESC, EngagementScore DESC, NetVotes DESC
LIMIT 100;