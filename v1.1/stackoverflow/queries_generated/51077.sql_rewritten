-- {"query": "51077.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "grok-4-fast-non-reasoning", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2129, "output_tokens": 769} 
WITH user_activity AS (
    SELECT 
        u.Id AS user_id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS post_count,
        SUM(p.Score) AS total_post_score,
        AVG(p.Score) AS avg_post_score,
        COUNT(DISTINCT v.Id) AS vote_count,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS upvotes_given,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS downvotes_given,
        COUNT(DISTINCT b.Id) AS badge_count,
        SUM(b.Class) AS total_badge_class
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId IN (1, 2)
    LEFT JOIN Votes v ON v.UserId = u.Id AND v.VoteTypeId IN (2, 3)
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
top_tags AS (
    SELECT 
        t.TagName,
        t.Count AS tag_usage,
        COUNT(DISTINCT p.OwnerUserId) AS unique_users,
        AVG(p.Score) AS avg_question_score
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
        AND p.PostTypeId = 1
    WHERE t.Count > 100
    GROUP BY t.Id, t.TagName, t.Count
    HAVING COUNT(DISTINCT p.OwnerUserId) > 10
),
user_tag_interactions AS (
    SELECT 
        ua.user_id,
        tt.TagName,
        COUNT(DISTINCT p.Id) AS questions_asked,
        AVG(p.Score) AS avg_score_for_tag,
        SUM(p.ViewCount) AS total_views_for_tag
    FROM user_activity ua
    JOIN Posts p ON p.OwnerUserId = ua.user_id AND p.PostTypeId = 1
    JOIN top_tags tt ON p.Tags LIKE '%' || tt.TagName || '%'
    GROUP BY ua.user_id, tt.TagName
    HAVING COUNT(DISTINCT p.Id) >= 2
)
SELECT 
    ua.DisplayName AS user_name,
    ua.Reputation,
    ua.post_count,
    ua.avg_post_score,
    tt.tag_usage,
    uti.questions_asked,
    uti.avg_score_for_tag,
    uti.total_views_for_tag,
    (ua.upvotes_given * 1.0 / NULLIF(ua.vote_count, 0)) AS upvote_ratio,
    RANK() OVER (
        PARTITION BY tt.TagName 
        ORDER BY uti.avg_score_for_tag DESC, uti.questions_asked DESC
    ) AS rank_in_tag,
    DENSE_RANK() OVER (
        ORDER BY (ua.total_post_score + ua.Reputation * 0.1) DESC
    ) AS overall_user_rank
FROM user_activity ua
JOIN user_tag_interactions uti ON uti.user_id = ua.user_id
JOIN top_tags tt ON tt.TagName = uti.TagName
LEFT JOIN Comments c ON c.UserId = ua.user_id 
    AND c.PostId IN (
        SELECT Id FROM Posts 
        WHERE PostTypeId = 1 AND Tags LIKE '%' || uti.TagName || '%'
    )
WHERE ua.post_count > 5 
    AND ua.Reputation > 100
    AND tt.unique_users > 50
    AND uti.total_views_for_tag > 1000
ORDER BY tt.TagName, uti.avg_score_for_tag DESC, ua.Reputation DESC
LIMIT 1000;