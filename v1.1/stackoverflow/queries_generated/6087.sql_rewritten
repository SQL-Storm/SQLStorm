WITH ranked_posts AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.LastActivityDate,
    p.Tags,
    p.ParentId,
    p.AcceptedAnswerId,
    p.CommentCount,
    p.FavoriteCount,
    p.ContentLicense,
    ROW_NUMBER() OVER (
      PARTITION BY p.PostTypeId
      ORDER BY
        CASE WHEN p.OwnerUserId IS NULL THEN 1 ELSE 0 END,
        p.Score DESC,
        p.ViewCount DESC,
        p.CreationDate DESC
    ) AS rn
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.ClosedDate IS NULL
),
top_questions AS (
  SELECT
    rp.PostId,
    rp.Title,
    rp.CreationDate,
    rp.Score,
    rp.ViewCount,
    rp.Tags,
    rp.OwnerUserId,
    rp.LastActivityDate,
    rp.CommentCount
  FROM ranked_posts rp
  WHERE rp.PostTypeId = 1 -- Question
    AND rp.rn <= 100
),
recent_activity AS (
  SELECT
    q.PostId,
    q.Title,
    q.CreationDate,
    q.LastActivityDate,
    q.Score,
    q.ViewCount,
    q.OwnerUserId,
    DATEDIFF(day, q.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS DaysOld,
    CASE
      WHEN q.LastActivityDate > q.CreationDate THEN 'updated'
      ELSE 'new'
    END AS ActivityFlag
  FROM top_questions q
),
tags_expanded AS (
  SELECT
    ra.PostId,
    ra.Title,
    ra.CreationDate,
    ra.LastActivityDate,
    ra.Score,
    ra.ViewCount,
    ra.OwnerUserId,
    t.TagName
  FROM recent_activity ra
  CROSS APPLY (
    SELECT value AS TagName
    FROM string_split(REPLACE(REPLACE(ra.Tags, '<', ''), '>', ''), ',')
    WHERE value <> ''
  ) t
),
stats AS (
  SELECT
    t.PostId,
    t.Title,
    t.TagName,
    t.CreationDate,
    t.LastActivityDate,
    t.Score,
    t.ViewCount,
    t.OwnerUserId,
    COUNT(*) OVER (PARTITION BY t.PostId) AS TagCount
  FROM tags_expanded t
)
SELECT
  s.PostId,
  s.Title,
  s.TagName,
  s.CreationDate,
  s.LastActivityDate,
  s.Score,
  s.ViewCount,
  s.OwnerUserId,
  s.TagCount
FROM stats s
ORDER BY s.LastActivityDate DESC, s.Score DESC, s.PostId
LIMIT 100;