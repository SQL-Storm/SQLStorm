-- {"query": "9058.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "codex-mini-latest", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2013, "output_tokens": 3001} 
WITH
-- Aggregate badge counts by user
BadgeStats AS (
    SELECT
        u.Id AS UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COUNT(*) FILTER (WHERE b.TagBased = 1) AS TagBadges
    FROM Users AS u
    LEFT JOIN Badges AS b
      ON b.UserId = u.Id
    GROUP BY u.Id
),
-- Compute per‑user question/answer counts and score/view aggregates
PostStats AS (
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(*) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(*) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        AVG(p.Score)            AS AvgPostScore,
        SUM(p.ViewCount)        AS TotalViews
    FROM Posts AS p
    GROUP BY p.OwnerUserId
),
-- Vote activity by user
VoteStats AS (
    SELECT
        v.UserId,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 2) AS UpvotesCast,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 3) AS DownvotesCast,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 5) AS FavoritesCast
    FROM Votes AS v
    GROUP BY v.UserId
),
-- Most recent activity & latest comment text per user
RecentActivity AS (
    SELECT
        u.Id                       AS UserId,
        MAX(GREATEST(
            COALESCE(u.LastAccessDate,'1970-01-01'),
            COALESCE(p.LastActivityDate,'1970-01-01'),
            COALESCE(c.CreationDate,'1970-01-01')
        )) AS LastActivity,
        (SELECT c2.Text
         FROM Comments AS c2
         WHERE c2.UserId = u.Id
         ORDER BY c2.CreationDate DESC
         LIMIT 1
        ) AS LastCommentSnippet
    FROM Users AS u
    LEFT JOIN Posts    AS p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments AS c ON c.UserId      = u.Id
    GROUP BY u.Id
),
-- Top tag per user (by frequency of asking questions)
TopTags AS (
    SELECT
        qt.OwnerUserId   AS UserId,
        qt.TagName       AS TopTag,
        ROW_NUMBER() OVER (PARTITION BY qt.OwnerUserId ORDER BY qt.TagCount DESC, qt.TagName) AS rn
    FROM (
        SELECT
            p.OwnerUserId,
            unnest(string_to_array(substring(p.Tags,2, length(p.Tags)-2), '><')) AS TagName,
            COUNT(*) AS TagCount
        FROM Posts AS p
        WHERE p.PostTypeId = 1
          AND p.Tags IS NOT NULL
        GROUP BY p.OwnerUserId, unnest(string_to_array(substring(p.Tags,2,length(p.Tags)-2), '><'))
    ) AS qt
),
-- Users above‐average reputation at time of their signup, who have at least one above‐average–scoring post
FilteredUsers AS (
    SELECT u.Id
    FROM Users AS u
    WHERE u.Reputation >
          (SELECT AVG(u2.Reputation) FROM Users AS u2 WHERE u2.CreationDate < u.CreationDate)
      AND EXISTS (
          SELECT 1
          FROM Posts AS p2
          WHERE p2.OwnerUserId = u.Id
            AND p2.Score > (
                SELECT AVG(p3.Score) FROM Posts AS p3 WHERE p3.OwnerUserId = u.Id
            )
      )
)
SELECT
    u.Id,
    u.DisplayName,
    COALESCE(ps.QuestionCount,0)   AS Questions,
    COALESCE(ps.AnswerCount,0)     AS Answers,
    COALESCE(bs.GoldBadges,0)       AS GoldBadges,
    COALESCE(bs.SilverBadges,0)     AS SilverBadges,
    COALESCE(bs.BronzeBadges,0)     AS BronzeBadges,
    COALESCE(bs.TagBadges,0)        AS TagBadges,
    COALESCE(vs.UpvotesCast,0)      AS UpvotesCast,
    COALESCE(vs.DownvotesCast,0)    AS DownvotesCast,
    COALESCE(vs.FavoritesCast,0)    AS FavoritesCast,
    COALESCE(ps.AvgPostScore,0)     AS AvgScore,
    COALESCE(ps.TotalViews,0)       AS TotalViews,
    ra.LastActivity,
    ra.LastCommentSnippet,
    tt.TopTag,
    RANK() OVER (
        ORDER BY
            COALESCE(ps.QuestionCount,0) DESC,
            COALESCE(ps.AnswerCount,0)   DESC,
            COALESCE(ps.AvgPostScore,0)   DESC
    ) AS UserRank
FROM FilteredUsers AS fu
INNER JOIN Users        AS u  ON u.Id = fu.Id
LEFT  JOIN BadgeStats   AS bs ON bs.UserId = u.Id
LEFT  JOIN PostStats    AS ps ON ps.UserId = u.Id
LEFT  JOIN VoteStats    AS vs ON vs.UserId = u.Id
LEFT  JOIN RecentActivity AS ra ON ra.UserId = u.Id
LEFT  JOIN TopTags      AS tt ON tt.UserId = u.Id AND tt.rn = 1

UNION

-- include all users with zero activity as a control set, excluding those already in the main result
SELECT
    u.Id,
    u.DisplayName,
    0 AS Questions,
    0 AS Answers,
    0 AS GoldBadges,
    0 AS SilverBadges,
    0 AS BronzeBadges,
    0 AS TagBadges,
    0 AS UpvotesCast,
    0 AS DownvotesCast,
    0 AS FavoritesCast,
    0 AS AvgScore,
    0 AS TotalViews,
    NULL AS LastActivity,
    NULL AS LastCommentSnippet,
    NULL AS TopTag,
    NULL AS UserRank
FROM Users AS u

EXCEPT

-- subtract out any overlap with the main result set
SELECT
    u.Id,
    u.DisplayName,
    COALESCE(ps.QuestionCount,0),
    COALESCE(ps.AnswerCount,0),
    COALESCE(bs.GoldBadges,0),
    COALESCE(bs.SilverBadges,0),
    COALESCE(bs.BronzeBadges,0),
    COALESCE(bs.TagBadges,0),
    COALESCE(vs.UpvotesCast,0),
    COALESCE(vs.DownvotesCast,0),
    COALESCE(vs.FavoritesCast,0),
    COALESCE(ps.AvgPostScore,0),
    COALESCE(ps.TotalViews,0),
    ra.LastActivity,
    ra.LastCommentSnippet,
    tt.TopTag,
    RANK() OVER (
        ORDER BY
            COALESCE(ps.QuestionCount,0) DESC,
            COALESCE(ps.AnswerCount,0)   DESC,
            COALESCE(ps.AvgPostScore,0)   DESC
    )
FROM FilteredUsers AS fu
INNER JOIN Users        AS u  ON u.Id = fu.Id
LEFT  JOIN BadgeStats   AS bs ON bs.UserId = u.Id
LEFT  JOIN PostStats    AS ps ON ps.UserId = u.Id
LEFT  JOIN VoteStats    AS vs ON vs.UserId = u.Id
LEFT  JOIN RecentActivity AS ra ON ra.UserId = u.Id
LEFT  JOIN TopTags      AS tt ON tt.UserId = u.Id AND tt.rn = 1;