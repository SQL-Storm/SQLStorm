WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1 AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 YEAR') AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2 AND p.Score > 10) AS HighScoreAnswers,
        (SELECT AVG(p.ViewCount) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS AvgQuestionViews,
        (SELECT COUNT(DISTINCT ph.PostId) FROM PostHistory ph WHERE ph.UserId = u.Id AND ph.PostHistoryTypeId IN (2,5,8) AND ph.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 MONTHS') AS RecentEdits
    FROM Users u
    WHERE u.Reputation > 10000
),
VoteAnalysis AS (
    SELECT 
        v.UserId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotes,
        SUM(CASE WHEN v.VoteTypeId IN (8,9) THEN COALESCE(v.BountyAmount,0) ELSE 0 END) AS TotalBountyGiven,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 5 THEN v.PostId END) AS BookmarkedPosts
    FROM Votes v
    WHERE v.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 YEARS'
    GROUP BY v.UserId
),
BadgeAchievements AS (
    SELECT 
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Name LIKE '%Great%' THEN 1 END) AS GreatQuestionBadges
    FROM Badges b
    WHERE b.Date >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '3 YEARS'
    GROUP BY b.UserId
),
TopTagsPerUser AS (
    SELECT
        p.OwnerUserId AS UserId,
        tags.tag AS TagName,
        COUNT(*) AS TagCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY COUNT(*) DESC) AS rn
    FROM Posts p,
    LATERAL (
        SELECT REGEXP_SPLIT_TO_TABLE(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)), '><') AS tag
    ) AS tags
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId, tags.tag
),
Main AS (
    SELECT 
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.QuestionCount,
        ua.HighScoreAnswers,
        ua.AvgQuestionViews,
        ua.RecentEdits,
        va.TotalUpvotes,
        va.TotalBountyGiven,
        va.BookmarkedPosts,
        ba.GoldBadges,
        ba.GreatQuestionBadges,
        (ua.QuestionCount * 0.3 + ua.HighScoreAnswers * 0.5 + va.TotalUpvotes * 0.2) AS EngagementScore
    FROM UserActivity ua
    JOIN VoteAnalysis va ON ua.UserId = va.UserId
    JOIN BadgeAchievements ba ON ua.UserId = ba.UserId
    WHERE ua.QuestionCount > 50
      AND va.TotalUpvotes > 100
      AND ba.GoldBadges >= 3
)
SELECT 
    m.UserId,
    m.DisplayName,
    m.Reputation,
    m.QuestionCount,
    m.HighScoreAnswers,
    m.AvgQuestionViews,
    m.RecentEdits,
    m.TotalUpvotes,
    m.TotalBountyGiven,
    m.BookmarkedPosts,
    m.GoldBadges,
    m.GreatQuestionBadges,
    DENSE_RANK() OVER (ORDER BY m.EngagementScore DESC) AS EngagementScoreRank,
    (SELECT STRING_AGG(t.TagName, ', ' ORDER BY t.TagCount DESC)
     FROM (
         SELECT TagName, TagCount
         FROM TopTagsPerUser tpu
         WHERE tpu.UserId = m.UserId
         ORDER BY TagCount DESC
         LIMIT 5
     ) t
    ) AS TopTags
FROM Main m
ORDER BY 
    EngagementScoreRank ASC,
    m.Reputation DESC,
    m.TotalBountyGiven DESC
LIMIT 100 OFFSET 0;