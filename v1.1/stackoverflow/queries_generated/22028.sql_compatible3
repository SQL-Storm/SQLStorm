WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Location,
        u.Reputation,
        COALESCE(u.Views, 0) AS Views,
        COALESCE(u.AboutMe, '') AS AboutMe,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
        (SELECT SUM(p.Score) FROM Posts p WHERE p.OwnerUserId = u.Id) AS TotalScore,
        (SELECT AVG(LENGTH(p.Body)) FROM Posts p WHERE p.OwnerUserId = u.Id) AS AvgPostLength
    FROM Users u
),
TopTags AS (
    /* Portable splitter: using a recursive CTE to split strings by delimiter '><' after removing surrounding angle brackets.
       This should work in many SQL dialects that support recursive CTEs. */
    SELECT
        p.OwnerUserId,
        TRIM(t.tag) AS Tag,
        COUNT(*) AS TagCount
    FROM Posts p
    JOIN (
        -- prepare inner_tags per post
        SELECT
            p2.Id AS PostId,
            CASE WHEN p2.Tags IS NULL THEN NULL
                 WHEN LENGTH(p2.Tags) >= 2 AND SUBSTR(p2.Tags,1,1) = '<' AND SUBSTR(p2.Tags,LENGTH(p2.Tags),1) = '>'
                 THEN SUBSTR(p2.Tags,2,LENGTH(p2.Tags)-2)
                 ELSE p2.Tags
            END AS inner_tags
        FROM Posts p2
        WHERE p2.PostTypeId = 1 AND p2.Tags IS NOT NULL
    ) prep ON prep.PostId = p.Id
    JOIN (
        -- recursive splitter
        WITH RECURSIVE splitter(post_id, rest, tag) AS (
            SELECT p0.Id, prep0.inner_tags, NULL FROM Posts p0 JOIN (
                SELECT
                    p2.Id AS PostId,
                    CASE WHEN p2.Tags IS NULL THEN NULL
                         WHEN LENGTH(p2.Tags) >= 2 AND SUBSTR(p2.Tags,1,1) = '<' AND SUBSTR(p2.Tags,LENGTH(p2.Tags),1) = '>'
                         THEN SUBSTR(p2.Tags,2,LENGTH(p2.Tags)-2)
                         ELSE p2.Tags
                    END AS inner_tags
                FROM Posts p2
                WHERE p2.PostTypeId = 1 AND p2.Tags IS NOT NULL
            ) prep0 ON prep0.PostId = p0.Id
            UNION ALL
            SELECT post_id,
                   CASE
                     WHEN INSTR(rest, '><') > 0 THEN SUBSTR(rest, INSTR(rest, '><') + 2)
                     ELSE ''
                   END AS rest,
                   CASE
                     WHEN INSTR(rest, '><') > 0 THEN SUBSTR(rest, 1, INSTR(rest, '><') - 1)
                     ELSE rest
                   END AS tag
            FROM splitter
            WHERE rest IS NOT NULL AND rest <> ''
        )
        SELECT post_id AS OwnerPostId, tag AS tag FROM splitter WHERE tag IS NOT NULL
    ) t ON t.OwnerPostId = p.Id
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId, TRIM(t.tag)
),
FavoriteTag AS (
    SELECT 
        OwnerUserId,
        Tag,
        ROW_NUMBER() OVER (PARTITION BY OwnerUserId ORDER BY TagCount DESC, Tag) AS Rn
    FROM TopTags
),
PostHistorySummary AS (
    SELECT 
        ph.PostId,
        COUNT(CASE WHEN ph.PostHistoryTypeId IN (4,5,6) THEN 1 END) AS EditCount,
        COUNT(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 END) AS CloseCount,
        STRING_AGG(DISTINCT CASE WHEN ph.PostHistoryTypeId = 24 THEN ph.UserDisplayName END, ', ') AS EditorNames
    FROM PostHistory ph
    GROUP BY ph.PostId
),
VoteSummary AS (
    SELECT 
        v.UserId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 1 THEN 1 ELSE 0 END) AS AcceptsGiven
    FROM Votes v
    GROUP BY v.UserId
),
CompositeScore AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Location,
        us.Reputation,
        us.Views,
        LENGTH(us.AboutMe) AS AboutMeLength,
        us.GoldBadges,
        us.SilverBadges,
        us.BronzeBadges,
        us.QuestionCount,
        us.AnswerCount,
        us.TotalScore,
        us.AvgPostLength,
        ft.Tag AS FavoriteTag,
        COALESCE(vs.UpvotesGiven, 0) AS UpvotesGiven,
        COALESCE(vs.DownvotesGiven, 0) AS DownvotesGiven,
        COALESCE(vs.AcceptsGiven, 0) AS AcceptsGiven,
        ROW_NUMBER() OVER (
            PARTITION BY us.Location 
            ORDER BY ((us.Reputation * 1.0 + COALESCE(us.TotalScore, 0) + us.GoldBadges * 100 + us.SilverBadges * 10 + us.BronzeBadges) / NULLIF(us.Views + 1, 0)) DESC
        ) AS RankByLocation,
        CASE 
            WHEN us.AboutMe IS NULL OR TRIM(us.AboutMe) = '' THEN 'No Bio'
            ELSE SUBSTR(us.AboutMe, 1, 50) || '...'
        END AS BioSnippet
    FROM UserStats us
    LEFT JOIN FavoriteTag ft ON us.UserId = ft.OwnerUserId AND ft.Rn = 1
    LEFT OUTER JOIN VoteSummary vs ON us.UserId = vs.UserId
)
SELECT 
    cs.UserId,
    cs.DisplayName,
    cs.Location,
    cs.Reputation,
    cs.Views,
    cs.AboutMeLength,
    cs.GoldBadges,
    cs.SilverBadges,
    cs.BronzeBadges,
    cs.QuestionCount,
    cs.AnswerCount,
    cs.TotalScore,
    cs.AvgPostLength,
    cs.FavoriteTag,
    cs.UpvotesGiven,
    cs.DownvotesGiven,
    cs.AcceptsGiven,
    cs.RankByLocation,
    cs.BioSnippet,
    (
        SELECT AVG(phs.EditCount) 
        FROM PostHistorySummary phs 
        WHERE phs.PostId IN (SELECT p.Id FROM Posts p WHERE p.OwnerUserId = cs.UserId)
    ) AS AvgEditsPerPost
FROM CompositeScore cs
WHERE cs.RankByLocation <= 10
    AND cs.Reputation > 100
    AND (cs.QuestionCount + cs.AnswerCount) > 5
ORDER BY cs.Location, cs.RankByLocation;