WITH
  RankedAnswers AS (
    SELECT
      p.Id AS PostId,
      p.ParentId AS QuestionId,
      p.OwnerUserId,
      p.Score,
      p.CreationDate,
      ROW_NUMBER() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC, p.CreationDate ASC) AS AnswerRank,
      AVG(CAST(c.Score AS NUMERIC(10, 2))) OVER (PARTITION BY p.ParentId) AS AvgCommentScoreOnQuestionAnswers,
      COUNT(c.Id) OVER (PARTITION BY p.ParentId) AS TotalCommentsOnQuestionAnswers,
      LAG(p.Score, 1, 0) OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC) AS PreviousAnswerScore
    FROM Posts p
    LEFT JOIN Comments c
      ON p.Id = c.PostId
    WHERE
      p.PostTypeId = 2 AND p.ParentId IS NOT NULL
    GROUP BY
      p.Id,
      p.ParentId,
      p.OwnerUserId,
      p.Score,
      p.CreationDate
  ),
  QuestionStats AS (
    SELECT
      p.Id AS QuestionId,
      p.Title,
      p.OwnerUserId AS QuestionOwnerUserId,
      p.CreationDate AS QuestionCreationDate,
      p.ViewCount,
      p.AnswerCount,
      p.FavoriteCount,
      COUNT(DISTINCT ph.UserId) AS DistinctEditorsOfQuestion,
      SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseVoteCount,
      CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END AS IsClosed
    FROM Posts p
    LEFT JOIN PostHistory ph
      ON p.Id = ph.PostId
    WHERE
      p.PostTypeId = 1
    GROUP BY
      p.Id,
      p.Title,
      p.OwnerUserId,
      p.CreationDate,
      p.ViewCount,
      p.AnswerCount,
      p.FavoriteCount,
      p.ClosedDate
  ),
  UserActivity AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      u.Reputation,
      COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
      COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
      COUNT(DISTINCT b.Id) AS BadgeCount,
      SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
      SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
      MAX(u.LastAccessDate) AS LastAccessDate
    FROM Users u
    LEFT JOIN Posts p
      ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b
      ON u.Id = b.UserId
    LEFT JOIN Votes v
      ON u.Id = v.UserId
    GROUP BY
      u.Id,
      u.DisplayName,
      u.Reputation
  )
SELECT
  qs.QuestionId,
  qs.Title,
  qs.QuestionOwnerUserId,
  ua.DisplayName AS QuestionOwnerDisplayName,
  qs.QuestionCreationDate,
  qs.ViewCount,
  qs.AnswerCount,
  qs.FavoriteCount,
  qs.IsClosed,
  qs.DistinctEditorsOfQuestion,
  qs.CloseVoteCount,
  ra.AnswerRank,
  ra.OwnerUserId AS AnswerOwnerUserId,
  ua_ans.DisplayName AS AnswerOwnerDisplayName,
  ra.Score AS AnswerScore,
  ra.CreationDate AS AnswerCreationDate,
  ra.AvgCommentScoreOnQuestionAnswers,
  ra.TotalCommentsOnQuestionAnswers,
  ra.PreviousAnswerScore,
  CASE
    WHEN qs.ViewCount > 10000 AND ra.AnswerRank = 1 AND qs.IsClosed = 0 THEN 'High Traffic, Top Answered, Open'
    WHEN qs.ViewCount > 5000 AND COALESCE(qs.FavoriteCount,0) > 50 AND qs.AnswerCount > 10 THEN 'Popular Question'
    WHEN ra.AnswerRank > 1 AND ra.Score > 0 AND ra.PreviousAnswerScore > ra.Score THEN 'Underrated Answer'
    WHEN qs.CloseVoteCount > 5 AND qs.IsClosed = 0 THEN 'Potential Closure Candidate'
    WHEN COALESCE(ua.Reputation,0) < 1000 AND COALESCE(ua_ans.Reputation,0) < 1000 AND ra.AnswerScore > 10 THEN 'Newcomer Success'
    WHEN qs.QuestionCreationDate < (cast('2024-10-01' as date) - INTERVAL '1 year') AND qs.AnswerCount = 0 THEN 'Old Unanswered Question'
    WHEN qs.FavoriteCount IS NULL OR qs.FavoriteCount = 0 THEN 'Not Favorited'
    WHEN COALESCE(ua.BadgeCount,0) > 10 THEN 'Highly Decorated User'
    ELSE 'Standard Case'
  END AS PerformanceCategory,
  (
    COALESCE(ua.Reputation,0) * 1.0 + COALESCE(ua_ans.Reputation,0) * 1.0
  ) / (
    ra.AnswerScore + 1
  ) AS ReputationToAnswerScoreRatio,
  UPPER(SUBSTRING(qs.Title FROM 1 FOR 3)) AS TitlePrefix,
  CASE
    WHEN LOWER(qs.Title) LIKE '%sql%' THEN 'SQL Related'
    WHEN LOWER(qs.Title) LIKE '%performance%' THEN 'Performance Focused'
    ELSE 'Other Topic'
  END AS TopicCategory,
  COALESCE(ua.LastAccessDate, qs.QuestionCreationDate) AS LastRelevantActivity
FROM QuestionStats qs
JOIN RankedAnswers ra
  ON qs.QuestionId = ra.QuestionId
LEFT JOIN UserActivity ua
  ON qs.QuestionOwnerUserId = ua.UserId
LEFT JOIN UserActivity ua_ans
  ON ra.OwnerUserId = ua_ans.UserId
WHERE
  ra.AnswerRank <= 3
  AND qs.ViewCount > 100
  AND ra.Score > 0
ORDER BY
  PerformanceCategory,
  qs.ViewCount DESC,
  ra.AnswerScore DESC;