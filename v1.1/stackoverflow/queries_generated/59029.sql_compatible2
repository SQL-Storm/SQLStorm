SELECT 
    p.Id AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId IN (2,3)) AS NetVotes,
    (SELECT COUNT(*) FROM Posts a WHERE a.ParentId = p.Id AND a.PostTypeId = 2) AS AnswerCount,
    (SELECT STRING_AGG(t.TagName, ', ') FROM (
        SELECT regexp_split_to_table(trim(both '<' FROM regexp_replace(p.Tags, '><', '>|<', 'g')), '\\|') AS TagName
    ) t WHERE t.TagName IS NOT NULL AND t.TagName <> '') AS TagsList,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 1) AS GoldBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 2) AS SilverBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 3) AS BronzeBadges,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (1,4,6)) AS EditCount,
    (SELECT MAX(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (10,11,12,13)) AS LastModerationAction,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3) AS DuplicateLinks,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 8) AS BountyCount,
    (SELECT SUM(v.BountyAmount) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 9) AS TotalBountyAmount,
    (SELECT COUNT(*) FROM Posts p2 WHERE p2.ParentId = p.Id AND p2.PostTypeId = 2 AND p2.Score > 0) AS PositiveAnswers,
    (SELECT AVG(p3.Score) FROM Posts p3 WHERE p3.ParentId = p.Id AND p3.PostTypeId = 2) AS AvgAnswerScore,
    (SELECT COUNT(*) FROM Posts p4 WHERE p4.OwnerUserId = p.OwnerUserId AND p4.PostTypeId = 1 AND p4.CreationDate > p.CreationDate) AS SubsequentQuestions,
    (SELECT STRING_AGG(DISTINCT COALESCE(v2.UserDisplayName, ''), ', ') FROM Votes v2 WHERE v2.PostId = p.Id AND v2.UserId IS NOT NULL) AS VotedByUsers,
    (SELECT STRING_AGG(DISTINCT COALESCE(ph2.UserDisplayName, ''), ', ') FROM PostHistory ph2 WHERE ph2.PostId = p.Id AND ph2.UserId IS NOT NULL) AS EditedByUsers,
    (SELECT COUNT(*) FROM Posts p5 WHERE p5.ParentId = p.Id AND p5.PostTypeId = 2 AND p5.CreationDate > p.CreationDate) AS AnswersAfterQuestion,
    (SELECT COUNT(*) FROM Posts p6 WHERE p6.OwnerUserId = p.OwnerUserId AND p6.PostTypeId = 1 AND p6.CreationDate BETWEEN p.CreationDate AND (p.CreationDate + INTERVAL '30' DAY)) AS QuestionsInFirstMonth
FROM Posts p
INNER JOIN Users u ON p.OwnerUserId = u.Id
WHERE p.PostTypeId = 1 
    AND p.CreationDate >= DATE '2023-01-01'
    AND p.CreationDate < DATE '2024-01-01'
    AND p.Score >= 0
    AND p.ViewCount >= 100
    AND EXISTS (
        SELECT 1 FROM PostHistory ph 
        WHERE ph.PostId = p.Id 
        AND ph.PostHistoryTypeId IN (10,11,12,13,14,15,19,20,35,36)
        AND ph.CreationDate >= DATE '2023-06-01'
    )
GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, u.DisplayName, u.Reputation, p.Tags, p.OwnerUserId
HAVING COUNT(DISTINCT CASE WHEN p.OwnerUserId IS NOT NULL THEN p.OwnerUserId END) >= 1
ORDER BY p.Score DESC, p.ViewCount DESC, p.CreationDate DESC
LIMIT 1000;