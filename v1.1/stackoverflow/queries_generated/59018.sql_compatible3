SELECT 
    p.Id AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.OwnerUserId,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.Tags,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS Downvotes,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCount,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (1,2,3,4,5,6)) AS EditCount,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 1) AS GoldBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 2) AS SilverBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 3) AS BronzeBadges,
    (SELECT SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) FROM PostHistory ph WHERE ph.PostId = p.Id) AS ClosedCount,
    (SELECT SUM(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) FROM PostHistory ph WHERE ph.PostId = p.Id) AS ReopenedCount,
    (SELECT MIN(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 1) AS FirstTitleChange,
    (SELECT MAX(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 1) AS LastTitleChange,
    (SELECT MIN(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 2) AS FirstBodyChange,
    (SELECT MAX(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 2) AS LastBodyChange,
    (SELECT MIN(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 3) AS FirstTagChange,
    (SELECT MAX(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 3) AS LastTagChange,
    (SELECT AVG(ph.Score) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (1,2,3,4,5,6)) AS AverageScoreChange
FROM Posts p
INNER JOIN Users u ON p.OwnerUserId = u.Id
WHERE p.PostTypeId = 1
  AND p.CreationDate > CAST('2020-01-01 00:00:00' AS timestamp)
  AND p.Score > 100
  AND p.ViewCount > 1000
  AND p.AnswerCount > 0
  AND p.CommentCount > 0
  AND p.FavoriteCount > 0
  AND u.Reputation > 10000
  AND (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate) < INTERVAL '365 day'
GROUP BY
    p.Id,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.OwnerUserId,
    u.DisplayName,
    u.Reputation,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.Tags
ORDER BY p.Score DESC, p.ViewCount DESC, p.CreationDate DESC
LIMIT 100;