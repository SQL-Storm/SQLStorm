WITH ActiveUsers AS (
    SELECT
        Id,
        Reputation,
        CreationDate,
        DisplayName,
        LastAccessDate,
        UpVotes,
        DownVotes,
        Views,
        DENSE_RANK() OVER (ORDER BY Reputation DESC) AS ReputationRank,
        COUNT(p.Id) OVER (PARTITION BY Id) AS TotalPosts,
        SUM(v.VoteTypeId = 2) OVER (PARTITION BY Id) AS TotalUpVotes,
        SUM(v.VoteTypeId = 3) OVER (PARTITION BY Id) AS TotalDownVotes
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    WHERE
        u.LastAccessDate > DATE_TRUNC('month', cast('2024-10-01' as date)) - INTERVAL '1 year'
    GROUP BY
        u.Id, u.Reputation, u.CreationDate, u.DisplayName, u.LastAccessDate, u.UpVotes, u.DownVotes, u.Views
),
TopTags AS (
    SELECT
        Id AS TagId,
        TagName,
        Count,
        ROW_NUMBER() OVER (ORDER BY Count DESC) AS TagRank
    FROM
        Tags
    WHERE
        Count > 1000
),
PostMetrics AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        COUNT(c.Id) AS TotalComments,
        COUNT(v.Id) AS TotalVotes,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownVotes,
        COUNT(DISTINCT ph.Id) AS TotalEdits,
        COUNT(DISTINCT l.RelatedPostId) AS TotalLinks
    FROM
        Posts p
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN
        PostHistory ph ON p.Id = ph.PostId
    LEFT JOIN
        PostLinks l ON p.Id = l.PostId
    WHERE
        p.PostTypeId IN (1, 2)
    GROUP BY
        p.Id, p.PostTypeId, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount
),
UserBadgeSummary AS (
    SELECT
        UserId,
        COUNT(*) AS TotalBadges,
        SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN Class = 3 THEN 1 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM
        Badges
    GROUP BY
        UserId
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.ReputationRank,
    u.TotalPosts,
    COALESCE(ub.TotalBadges, 0) AS TotalBadges,
    COALESCE(ub.GoldBadges, 0) AS GoldBadges,
    COALESCE(ub.SilverBadges, 0) AS SilverBadges,
    COALESCE(ub.BronzeBadges, 0) AS BronzeBadges,
    u.TotalUpVotes,
    u.TotalDownVotes,
    u.Views,
    p.PostId,
    p.PostTypeId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.TotalComments,
    p.TotalVotes,
    p.TotalEdits,
    p.TotalLinks,
    SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2) AS TagList,
    tt.TagName AS TopTag,
    tt.TagRank
FROM
    ActiveUsers u
LEFT JOIN
    PostMetrics p ON u.Id = p.OwnerUserId
LEFT JOIN
    Tags tt ON p.PostId = tt.ExcerptPostId
LEFT JOIN
    UserBadgeSummary ub ON u.Id = ub.UserId
WHERE
    p.TotalVotes > 0
    AND tt.TagRank <= 5
ORDER BY
    u.Reputation DESC,
    p.Score DESC,
    tt.TagRank ASC;