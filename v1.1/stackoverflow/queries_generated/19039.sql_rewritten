-- {"query": "19039.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 4909} 
WITH UserPostSummary AS (
    -- Summarize user post activity, including distinct counts and score aggregates
    SELECT
        u.Id AS UserId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsAsked,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersGiven,
        SUM(COALESCE(p.Score, 0)) AS TotalPostScore,
        SUM(COALESCE(p.ViewCount, 0)) AS TotalPostViews,
        MAX(p.CreationDate) AS LastPostDate,
        MIN(p.CreationDate) AS FirstPostDate,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    GROUP BY
        u.Id
),
UserCommentActivity AS (
    -- Summarize user comment activity, filtering for recent activity
    SELECT
        u.Id AS UserId,
        COUNT(c.Id) AS TotalComments,
        SUM(COALESCE(c.Score, 0)) AS TotalCommentScore,
        MAX(c.CreationDate) AS LastCommentDate,
        MIN(c.CreationDate) AS FirstCommentDate,
        COUNT(c.Id) FILTER (WHERE c.CreationDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days')) AS RecentCommentCount
    FROM
        Users u
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    GROUP BY
        u.Id
),
PostEditActivity AS (
    -- Analyze post editing frequency, unique editors, and duration of active editing
    SELECT
        ph.PostId,
        COUNT(ph.Id) AS TotalEdits,
        COUNT(DISTINCT ph.UserId) AS UniqueEditors,
        MAX(ph.CreationDate) AS LastEditActivity,
        -- Time difference in days between earliest and latest edit for a post
        EXTRACT(EPOCH FROM (MAX(ph.CreationDate) - MIN(ph.CreationDate))) / (60*60*24) AS DaysActiveEditing,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (4, 7) THEN 1 ELSE 0 END) AS TitleEdits, -- Edit/Rollback Title
        SUM(CASE WHEN ph.PostHistoryTypeId IN (5, 8) THEN 1 ELSE 0 END) AS BodyEdits -- Edit/Rollback Body
    FROM
        PostHistory ph
    WHERE
        ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9) -- Only consider actual edits or rollbacks
    GROUP BY
        ph.PostId
),
PostVoteAggregates AS (
    -- Aggregate votes received for each post
    SELECT
        v.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesReceived, -- UpMod
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesReceived, -- DownMod
        SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS FavoritesReceived, -- Favorite
        MAX(v.CreationDate) AS LastVoteDate
    FROM
        Votes v
    GROUP BY
        v.PostId
),
UserBadgeSummary AS (
    -- Summarize user badges by class and type
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        SUM(CASE WHEN b.TagBased = TRUE THEN 1 ELSE 0 END) AS TagBadges
    FROM
        Badges b
    GROUP BY
        b.UserId
),
PostContentAnalysis AS (
    -- Analyze post content, tags, and link relationships
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        p.ParentId,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount AS PostViewCount,
        p.AnswerCount AS PostAnswerCount,
        p.CommentCount AS PostCommentCount,
        p.FavoriteCount AS PostFavoriteCount,
        p.LastActivityDate,
        p.ClosedDate,
        p.CommunityOwnedDate,
        -- Extract first tag and count of tags, handling potential NULLs or empty strings
        COALESCE(SPLIT_PART(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><', 1), '') AS FirstTag,
        COALESCE(ARRAY_LENGTH(string_to_array(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><'), 1), 0) AS TagCount,
        LENGTH(COALESCE(p.Body, '')) AS BodyLength,
        -- Check if title or tags are related to 'SQL' or 'Database' (case-insensitive)
        CASE WHEN (p.Title ILIKE '%SQL%' OR p.Title ILIKE '%Database%') OR (p.Tags ILIKE '%<sql>%') THEN TRUE ELSE FALSE END AS IsSqlOrDbRelated,
        -- Count of incoming links (duplicate or general link)
        COUNT(pl_in.RelatedPostId) FILTER (WHERE pl_in.LinkTypeId IN (1,3)) AS IncomingLinkCount,
        -- Count of outgoing links from this post (only type 1, general link)
        COUNT(pl_out.PostId) FILTER (WHERE pl_out.LinkTypeId = 1) AS OutgoingLinkCount
    FROM
        Posts p
    LEFT JOIN PostLinks pl_in ON p.Id = pl_in.RelatedPostId AND pl_in.LinkTypeId IN (1,3) -- Linked or Duplicate OF this post
    LEFT JOIN PostLinks pl_out ON p.Id = pl_out.PostId AND pl_out.LinkTypeId = 1 -- Links FROM this post
    GROUP BY
        p.Id, p.PostTypeId, p.OwnerUserId, p.AcceptedAnswerId, p.ParentId, p.CreationDate, p.Score, p.ViewCount,
        p.AnswerCount, p.CommentCount, p.FavoriteCount, p.LastActivityDate, p.ClosedDate,
        p.CommunityOwnedDate, p.Tags, p.Body, p.Title
),
FinalPostMetrics AS (
    -- Combine PostContentAnalysis with PostEditActivity and PostVoteAggregates
    SELECT
        pca.PostId,
        pca.PostTypeId,
        pca.OwnerUserId,
        pca.AcceptedAnswerId,
        pca.ParentId,
        pca.PostCreationDate,
        pca.PostScore,
        pca.PostViewCount,
        pca.PostAnswerCount,
        pca.PostCommentCount,
        pca.PostFavoriteCount,
        pca.LastActivityDate,
        pca.ClosedDate,
        pca.CommunityOwnedDate,
        pca.FirstTag,
        pca.TagCount,
        pca.BodyLength,
        pca.IsSqlOrDbRelated,
        pca.IncomingLinkCount,
        pca.OutgoingLinkCount,
        COALESCE(pea.TotalEdits, 0) AS TotalEdits,
        COALESCE(pea.UniqueEditors, 0) AS UniqueEditors,
        COALESCE(pea.DaysActiveEditing, 0) AS DaysActiveEditing,
        COALESCE(pea.TitleEdits, 0) AS TitleEdits,
        COALESCE(pea.BodyEdits, 0) AS BodyEdits,
        COALESCE(pva.UpVotesReceived, 0) AS UpVotesReceived,
        COALESCE(pva.DownVotesReceived, 0) AS DownVotesReceived,
        COALESCE(pva.FavoritesReceived, 0) AS FavoritesReceived,
        pva.LastVoteDate,
        -- Calculate a composite "Engagement Score" for posts
        (pca.PostScore * 0.5) + (pca.PostViewCount * 0.01) + (COALESCE(pca.PostAnswerCount, 0) * 2) +
        (COALESCE(pca.PostCommentCount, 0) * 1) + (COALESCE(pva.FavoritesReceived, 0) * 3) + (COALESCE(pea.TotalEdits, 0) * 0.2) AS EngagementScore,
        -- Determine detailed post status
        CASE
            WHEN pca.ClosedDate IS NOT NULL AND pca.CommunityOwnedDate IS NOT NULL THEN 'Closed & Community Owned'
            WHEN pca.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN pca.CommunityOwnedDate IS NOT NULL THEN 'CommunityOwned'
            WHEN pca.AcceptedAnswerId IS NOT NULL THEN 'Answered'
            WHEN (cast('2024-10-01 12:34:56' as timestamp) - pca.LastActivityDate) < INTERVAL '30 days' AND pca.PostTypeId = 1 THEN 'Active Question'
            WHEN (cast('2024-10-01 12:34:56' as timestamp) - pca.LastActivityDate) < INTERVAL '30 days' AND pca.PostTypeId = 2 THEN 'Active Answer'
            ELSE 'Dormant'
        END AS PostStatus
    FROM
        PostContentAnalysis pca
    LEFT JOIN PostEditActivity pea ON pca.PostId = pea.PostId
    LEFT JOIN PostVoteAggregates pva ON pca.PostId = pva.PostId
)
-- Branch 1: Identify Highly Influential Users
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    COALESCE(ups.TotalPosts, 0) AS UserTotalPosts,
    COALESCE(ups.QuestionsAsked, 0) AS UserQuestionsAsked,
    COALESCE(ups.AnswersGiven, 0) AS UserAnswersGiven,
    COALESCE(ups.TotalPostScore, 0) AS UserTotalPostScore,
    COALESCE(uca.TotalComments, 0) AS UserTotalComments,
    COALESCE(ubs.GoldBadges, 0) AS UserGoldBadges,
    COALESCE(ubs.SilverBadges, 0) AS UserSilverBadges,
    COALESCE(ubs.BronzeBadges, 0) AS UserBronzeBadges,
    (u.Reputation * 0.1) + (COALESCE(ubs.GoldBadges, 0) * 100) + (COALESCE(ubs.SilverBadges, 0) * 50) +
    (COALESCE(ups.TotalPostScore, 0) * 0.5) + (COALESCE(ups.AnswersGiven, 0) * 5) AS UserInfluenceScore,
    RANK() OVER (ORDER BY (u.Reputation * 0.1 + COALESCE(ubs.GoldBadges, 0) * 100 + COALESCE(ups.TotalPostScore, 0) * 0.5) DESC) AS UserInfluenceRank,
    (
        -- Correlated subquery: Find the highest scoring post edited by this user (not owned by them) within the last year
        SELECT
            COALESCE(MAX(p_sub.Score), 0)
        FROM
            Posts p_sub
        WHERE
            p_sub.LastEditorUserId = u.Id AND p_sub.OwnerUserId IS DISTINCT FROM u.Id
            AND p_sub.LastEditDate IS NOT NULL AND p_sub.LastEditDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year')
    ) AS MaxScoreEditedOtherPostLastYear,
    SUM(CASE WHEN fpm.EngagementScore > 100 AND fpm.PostStatus != 'Closed' AND fpm.OwnerUserId = u.Id THEN 1 ELSE 0 END) AS HighEngagementPostsOwned,
    AVG(fpm.EngagementScore) FILTER (WHERE fpm.OwnerUserId = u.Id) AS AvgOwnedPostEngagementScore,
    MAX(CASE WHEN p_answer.PostTypeId = 2 AND fpm_answer_parent.IsSqlOrDbRelated AND fpm_answer.UpVotesReceived > 50 THEN 1 ELSE 0 END) AS AnsweredHighScoreSqlDbQuestion,
    AVG(u.Reputation) OVER (PARTITION BY u.Location) AS AvgReputationInLocation,
    CASE
        WHEN u.WebsiteUrl IS NOT NULL AND LENGTH(u.WebsiteUrl) > 10 AND u.AboutMe IS NOT NULL AND LENGTH(u.AboutMe) > 100 THEN 'Highly Detailed Profile'
        WHEN u.Location IS NOT NULL AND u.Reputation > 5000 AND COALESCE(ups.TotalPosts, 0) > 50 THEN 'Established Regional Contributor'
        WHEN COALESCE(ups.TotalPosts, 0) = 0 AND COALESCE(uca.TotalComments, 0) = 0 THEN 'Lurker/Newbie'
        ELSE 'Active General Contributor'
    END AS UserProfileCategory,
    UPPER(LEFT(COALESCE(u.DisplayName, 'UNKNOWN'), 5)) AS DisplayNamePrefixUpper,
    CAST(COALESCE(ups.AnswersGiven, 0) AS NUMERIC) / NULLIF(COALESCE(ups.QuestionsAsked, 0), 0) AS AnswerQuestionRatio,
    'Influential User' AS UserCategoryType,
    (cast('2024-10-01 12:34:56' as timestamp) - u.CreationDate) AS AccountAge
FROM
    Users u
LEFT JOIN UserPostSummary ups ON u.Id = ups.UserId
LEFT JOIN UserCommentActivity uca ON u.Id = uca.UserId
LEFT JOIN UserBadgeSummary ubs ON u.Id = ubs.UserId
LEFT JOIN FinalPostMetrics fpm ON u.Id = fpm.OwnerUserId
LEFT JOIN Posts p_answer ON u.Id = p_answer.OwnerUserId AND p_answer.PostTypeId = 2
LEFT JOIN FinalPostMetrics fpm_answer ON p_answer.Id = fpm_answer.PostId
LEFT JOIN FinalPostMetrics fpm_answer_parent ON p_answer.ParentId = fpm_answer_parent.PostId
WHERE
    u.Reputation > 1000 -- Filter for somewhat established users
    AND u.LastAccessDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') -- Active in the last year
    AND COALESCE(ups.TotalPosts, 0) + COALESCE(uca.TotalComments, 0) > 5 -- At least some combined activity
    AND u.AboutMe IS NOT NULL -- Users with some self-description
GROUP BY
    u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.WebsiteUrl, u.AboutMe, u.Location,
    ups.TotalPosts, ups.QuestionsAsked, ups.AnswersGiven, ups.TotalPostScore, uca.TotalComments,
    ubs.GoldBadges, ubs.SilverBadges, ubs.BronzeBadges
HAVING
    COUNT(DISTINCT fpm.PostId) > 0 -- Ensure the user owns at least one post considered in FinalPostMetrics
    OR MAX(CASE WHEN p_answer.PostTypeId = 2 AND fpm_answer_parent.IsSqlOrDbRelated AND fpm_answer.UpVotesReceived > 50 THEN 1 ELSE 0 END) = 1
ORDER BY
    UserInfluenceScore DESC
LIMIT 50

UNION ALL

-- Branch 2: Identify Emerging SQL/Database Experts
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    COALESCE(ups.TotalPosts, 0) AS UserTotalPosts,
    COALESCE(ups.QuestionsAsked, 0) AS UserQuestionsAsked,
    COALESCE(ups.AnswersGiven, 0) AS UserAnswersGiven,
    COALESCE(ups.TotalPostScore, 0) AS UserTotalPostScore,
    COALESCE(uca.TotalComments, 0) AS UserTotalComments,
    COALESCE(ubs.GoldBadges, 0) AS UserGoldBadges,
    COALESCE(ubs.SilverBadges, 0) AS UserSilverBadges,
    COALESCE(ubs.BronzeBadges, 0) AS UserBronzeBadges,
    (u.Reputation * 0.1) + (COALESCE(ubs.GoldBadges, 0) * 100) + (COALESCE(ubs.SilverBadges, 0) * 50) +
    (COALESCE(ups.TotalPostScore, 0) * 0.5) + (COALESCE(ups.AnswersGiven, 0) * 5) AS UserInfluenceScore, -- Keep calculation consistent
    RANK() OVER (ORDER BY SUM(CASE WHEN fpm_answer.IsSqlOrDbRelated THEN fpm_answer.UpVotesReceived ELSE 0 END) DESC,
                          COALESCE(uca.RecentCommentCount, 0) DESC) AS UserInfluenceRank, -- Rank by SQL answers & recent comments
    0 AS MaxScoreEditedOtherPostLastYear, -- Not directly calculated for this branch, default to 0
    SUM(CASE WHEN fpm.EngagementScore > 50 AND fpm.PostStatus = 'Active Answer' AND fpm.IsSqlOrDbRelated AND fpm.OwnerUserId = u.Id THEN 1 ELSE 0 END) AS HighEngagementPostsOwned,
    AVG(fpm.EngagementScore) FILTER (WHERE fpm.OwnerUserId = u.Id AND fpm.IsSqlOrDbRelated) AS AvgOwnedPostEngagementScore,
    MAX(CASE WHEN p_answer.PostTypeId = 2 AND fpm_answer_parent.IsSqlOrDbRelated AND fpm_answer.UpVotesReceived > 20 THEN 1 ELSE 0 END) AS AnsweredHighScoreSqlDbQuestion,
    AVG(u.Reputation) OVER (PARTITION BY u.Location) AS AvgReputationInLocation,
    CASE
        WHEN COALESCE(ups.AnswersGiven, 0) > 50 AND COALESCE(ubs.TagBadges, 0) > 0 AND u.Reputation > 500 THEN 'Emerging SQL/DB Expert'
        WHEN COALESCE(uca.RecentCommentCount, 0) > 10 AND COALESCE(ups.AnswersGiven, 0) > 10 THEN 'Recently Active Specialist'
        ELSE 'Specialized Contributor'
    END AS UserProfileCategory,
    UPPER(LEFT(COALESCE(u.DisplayName, 'UNKNOWN'), 5)) AS DisplayNamePrefixUpper,
    CAST(COALESCE(ups.AnswersGiven, 0) AS NUMERIC) / NULLIF(COALESCE(ups.QuestionsAsked, 0), 0) AS AnswerQuestionRatio,
    'Emerging Expert' AS UserCategoryType,
    (cast('2024-10-01 12:34:56' as timestamp) - u.CreationDate) AS AccountAge
FROM
    Users u
LEFT JOIN UserPostSummary ups ON u.Id = ups.UserId
LEFT JOIN UserCommentActivity uca ON u.Id = uca.UserId
LEFT JOIN UserBadgeSummary ubs ON u.Id = ubs.UserId
LEFT JOIN FinalPostMetrics fpm ON u.Id = fpm.OwnerUserId
LEFT JOIN Posts p_answer ON u.Id = p_answer.OwnerUserId AND p_answer.PostTypeId = 2
LEFT JOIN FinalPostMetrics fpm_answer ON p_answer.Id = fpm_answer.PostId
LEFT JOIN FinalPostMetrics fpm_answer_parent ON p_answer.ParentId = fpm_answer_parent.PostId
WHERE
    u.Reputation > 500 -- Lower reputation threshold for emerging experts
    AND u.LastAccessDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months') -- More recent activity focus
    AND COALESCE(ups.AnswersGiven, 0) > 10 -- Must have some answers
    AND EXISTS (
        SELECT 1 FROM FinalPostMetrics fpm_check
        WHERE fpm_check.OwnerUserId = u.Id AND fpm_check.PostTypeId = 2 AND fpm_check.IsSqlOrDbRelated
    ) -- At least one SQL/DB related answer
GROUP BY
    u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.WebsiteUrl, u.AboutMe, u.Location,
    ups.TotalPosts, ups.QuestionsAsked, ups.AnswersGiven, ups.TotalPostScore, uca.TotalComments, uca.RecentCommentCount,
    ubs.GoldBadges, ubs.SilverBadges, ubs.BronzeBadges, ubs.TagBadges
HAVING
    SUM(CASE WHEN fpm_answer.IsSqlOrDbRelated THEN fpm_answer.UpVotesReceived ELSE 0 END) > 50 -- At least 50 upvotes on SQL/DB answers
    AND COALESCE(uca.RecentCommentCount, 0) > 5 -- At least 5 comments in last 90 days
ORDER BY
    UserInfluenceScore DESC
LIMIT 50;