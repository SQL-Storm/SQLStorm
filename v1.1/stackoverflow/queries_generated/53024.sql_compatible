WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsAsked,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersGiven,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE 0 END) AS TotalQuestionViews,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE NULL END) AS AvgAnswerScore,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        SUM(v.BountyAmount) AS TotalBountiesEarned
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (8, 9)
    GROUP BY u.Id, u.Reputation
),
BadgeStats AS (
    SELECT 
        UserId,
        COUNT(CASE WHEN Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN Class = 3 THEN 1 END) AS BronzeBadges
    FROM Badges
    GROUP BY UserId
),
EditActivity AS (
    SELECT 
        UserId,
        COUNT(*) AS TotalEdits,
        COUNT(DISTINCT PostId) AS UniquePostsEdited
    FROM PostHistory
    WHERE PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)
    GROUP BY UserId
),
TagPopularity AS (
    -- Split tags using standard SQL: replace delimiters and split via a derived table of numbers
    SELECT 
        p.OwnerUserId AS UserId,
        STRING_AGG(t.TagName, ', ') AS TopTags,
        SUM(p.Score) AS TotalTagScore
    FROM Posts p
    JOIN (
        -- generate positions of individual tags from the Tags string like '<tag1><tag2>'
        -- works in many dialects that support generate_series or a numbers table; fallback using recursive CTE
        WITH RECURSIVE nums(pos) AS (
            SELECT 1
            UNION ALL
            SELECT pos + 1 FROM nums WHERE pos < 100
        ),
        splits AS (
            SELECT
                p2.Id,
                TRIM(BOTH '<>' FROM SUBSTR(p2.Tags,
                    instr(p2.Tags || '>', '<', pos),  -- using instr-like function where available
                    CASE
                        WHEN instr(SUBSTR(p2.Tags || '>', instr(p2.Tags || '>', '<', pos) + 1), '>') = 0 THEN 1000
                        ELSE instr(SUBSTR(p2.Tags || '>', instr(p2.Tags || '>', '<', pos) + 1), '>') 
                    END
                )) AS tagname
            FROM Posts p2
            JOIN nums n ON instr(p2.Tags || '>', '<', n.pos) > 0
            WHERE p2.Tags IS NOT NULL
        )
        SELECT Id, tagname FROM splits
    ) tag_split ON tag_split.Id = p.Id
    JOIN Tags t ON t.TagName = tag_split.tagname
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId
    HAVING COUNT(DISTINCT t.TagName) > 5
),
RankedUsers AS (
    SELECT 
        ua.UserId,
        ua.Reputation,
        ua.QuestionsAsked,
        ua.AnswersGiven,
        ua.TotalQuestionViews,
        ua.AvgAnswerScore,
        ua.CommentsMade,
        ua.TotalBountiesEarned,
        COALESCE(bs.GoldBadges, 0) AS GoldBadges,
        COALESCE(bs.SilverBadges, 0) AS SilverBadges,
        COALESCE(bs.BronzeBadges, 0) AS BronzeBadges,
        COALESCE(ea.TotalEdits, 0) AS TotalEdits,
        COALESCE(ea.UniquePostsEdited, 0) AS UniquePostsEdited,
        tp.TopTags,
        COALESCE(tp.TotalTagScore, 0) AS TotalTagScore,
        ROW_NUMBER() OVER (ORDER BY ua.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY ua.TotalQuestionViews DESC) AS ViewRank
    FROM UserActivity ua
    LEFT JOIN BadgeStats bs ON ua.UserId = bs.UserId
    LEFT JOIN EditActivity ea ON ua.UserId = ea.UserId
    LEFT JOIN TagPopularity tp ON ua.UserId = tp.UserId
    WHERE ua.Reputation > 10000
)
SELECT 
    ru.UserId,
    ru.Reputation,
    ru.QuestionsAsked,
    ru.AnswersGiven,
    ru.TotalQuestionViews,
    ru.AvgAnswerScore,
    ru.CommentsMade,
    ru.TotalBountiesEarned,
    ru.GoldBadges,
    ru.SilverBadges,
    ru.BronzeBadges,
    ru.TotalEdits,
    ru.UniquePostsEdited,
    ru.TopTags,
    ru.TotalTagScore,
    ru.ReputationRank,
    ru.ViewRank,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = ru.UserId) AND pl.LinkTypeId = 3) AS DuplicateLinks,
    (SELECT AVG(v.Score) FROM Votes v JOIN Posts p ON v.PostId = p.Id WHERE p.OwnerUserId = ru.UserId AND v.VoteTypeId = 2) AS AvgUpvoteScore
FROM RankedUsers ru
WHERE ru.ReputationRank <= 100
ORDER BY ru.Reputation DESC, ru.TotalQuestionViews DESC;