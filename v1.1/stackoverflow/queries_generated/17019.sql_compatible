WITH user_activity AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        EXTRACT(YEAR FROM u.CreationDate) AS join_year,
        COUNT(DISTINCT p.Id) AS total_posts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answers,
        COALESCE(SUM(p.Score), 0) AS total_score,
        ROW_NUMBER() OVER (PARTITION BY EXTRACT(YEAR FROM u.CreationDate) ORDER BY u.Reputation DESC) AS year_rank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS post_rank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '5 years')
        AND u.Reputation > 100
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
tag_experts AS (
    SELECT 
        t.TagName,
        p.OwnerUserId,
        COUNT(*) AS tag_posts,
        AVG(p.Score) AS avg_score,
        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY p.Score) AS score_75th,
        -- For portability, move ORDER BY inside a STRING_AGG equivalent by using an ordered subquery aggregation.
        -- Build top_titles by aggregating from a subquery that orders by p.Score DESC.
        (SELECT STRING_AGG(title_part, ' | ')
         FROM (
             SELECT DISTINCT SUBSTRING(p2.Title FROM 1 FOR 30) AS title_part
             FROM Posts p2
             WHERE p2.OwnerUserId = p.OwnerUserId
               AND p2.PostTypeId IN (1,2)
               AND p2.Score > 10
               AND p2.Title IS NOT NULL
               AND p2.Tags LIKE '%<' || t.TagName || '>%'
             ORDER BY p2.Score DESC
         ) s
        ) AS top_titles
    FROM Tags t
    INNER JOIN Posts p ON p.Tags LIKE '%<' || t.TagName || '>%'
    WHERE p.PostTypeId IN (1, 2)
        AND p.Score > 0
        AND t.Count > 1000
    GROUP BY t.TagName, p.OwnerUserId
    HAVING COUNT(*) >= 10
),
recursive_comments AS (
    SELECT 
        c.PostId,
        c.UserId,
        c.CreationDate,
        1 AS level,
        c.Score,
        CASE 
            WHEN c.Text LIKE '%thank%' OR c.Text LIKE '%Thanks%' THEN 1 
            ELSE 0 
        END AS is_thank_you
    FROM Comments c
    WHERE c.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '1 year')
    
    UNION ALL
    
    SELECT 
        rc.PostId,
        c2.UserId,
        c2.CreationDate,
        rc.level + 1,
        c2.Score,
        CASE 
            WHEN c2.Text ILIKE ('%' || '@' || u.DisplayName || '%') THEN 1 
            ELSE 0 
        END AS is_thank_you
    FROM recursive_comments rc
    INNER JOIN Comments c2 ON rc.PostId = c2.PostId 
        AND c2.CreationDate > rc.CreationDate
        AND c2.CreationDate < rc.CreationDate + INTERVAL '1 hour'
    LEFT JOIN Users u ON rc.UserId = u.Id
    WHERE rc.level < 3
)
SELECT 
    ua.DisplayName,
    ua.Reputation,
    ua.join_year,
    ua.total_posts,
    ua.questions + ua.answers AS qa_posts,
    ROUND(COALESCE(NULLIF(ua.total_posts,0),0)::numeric = COALESCE(NULLIF(ua.total_posts,0),0), 0) * 0 + 0 AS _fix_numeric_div_zero, -- placeholder to keep compatibility removed
    -- Replace :: casts with CAST and compute avg_post_score safely
    ROUND(CAST(ua.total_score AS numeric) / NULLIF(ua.total_posts, 0), 2) AS avg_post_score,
    ua.year_rank,
    COALESCE(te.TagName, 'No Expertise') AS top_tag,
    COALESCE(te.tag_posts, 0) AS tag_post_count,
    ROUND(CAST(COALESCE(te.avg_score, 0) AS numeric), 2) AS tag_avg_score,
    COALESCE(te.top_titles, 'N/A') AS sample_titles,
    badge_stats.gold_badges,
    badge_stats.total_badges,
    COALESCE(recent_edits.edit_count, 0) AS recent_edits,
    CASE 
        WHEN EXISTS (
            SELECT 1 FROM Posts p2 
            WHERE p2.OwnerUserId = ua.Id 
                AND p2.CommunityOwnedDate IS NOT NULL
        ) THEN 'Community Contributor'
        WHEN ua.Reputation > 10000 THEN 'Expert'
        WHEN ua.Reputation > 5000 THEN 'Advanced'
        WHEN ua.Reputation > 1000 THEN 'Intermediate'
        ELSE 'Beginner'
    END AS user_tier,
    COALESCE(comment_activity.total_comments, 0) AS recent_comments,
    COALESCE(comment_activity.thank_yous, 0) AS thank_you_comments,
    FIRST_VALUE(closing_activity.close_count) OVER (
        PARTITION BY ua.Id 
        ORDER BY closing_activity.close_count DESC NULLS LAST
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
    ) AS posts_closed,
    LAG(ua.Reputation, 1) OVER (PARTITION BY ua.join_year ORDER BY ua.Reputation) AS prev_user_rep,
    LEAD(ua.DisplayName, 1, 'None') OVER (PARTITION BY ua.join_year ORDER BY ua.Reputation) AS next_user
FROM user_activity ua
LEFT JOIN LATERAL (
    SELECT te2.* 
    FROM tag_experts te2 
    WHERE te2.OwnerUserId = ua.Id 
    ORDER BY te2.tag_posts DESC, te2.avg_score DESC 
    LIMIT 1
) te ON true
LEFT JOIN LATERAL (
    SELECT 
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS gold_badges,
        COUNT(*) AS total_badges
    FROM Badges b
    WHERE b.UserId = ua.Id
) badge_stats ON true
LEFT JOIN LATERAL (
    SELECT COUNT(DISTINCT ph.PostId) AS edit_count
    FROM PostHistory ph
    WHERE ph.UserId = ua.Id
        AND ph.PostHistoryTypeId IN (4, 5, 6)
        AND ph.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '90 days')
) recent_edits ON true
LEFT JOIN LATERAL (
    SELECT 
        COUNT(*) AS total_comments,
        SUM(is_thank_you) AS thank_yous
    FROM recursive_comments rc
    WHERE rc.UserId = ua.Id
) comment_activity ON true
LEFT JOIN LATERAL (
    SELECT COUNT(*) AS close_count
    FROM PostHistory ph2
    WHERE ph2.UserId = ua.Id
        AND ph2.PostHistoryTypeId = 10
        AND ph2."Comment" ~ '^\d+$'
) closing_activity ON true
WHERE ua.year_rank <= 100
    AND (ua.questions > 0 OR ua.answers > 0)
    AND NOT (ua.DisplayName IS NULL AND badge_stats.total_badges = 0)
ORDER BY 
    ua.join_year DESC,
    ua.Reputation DESC,
    COALESCE(te.avg_score, 0) DESC
LIMIT 500;