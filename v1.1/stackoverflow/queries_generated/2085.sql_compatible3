WITH RecentQuestions AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.OwnerUserId,
        u.DisplayName,
        p.CreationDate,
        COUNT(a.Id) AS AnswerCount,
        RANK() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS Rank
    FROM 
        Posts p
    LEFT JOIN 
        Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
    JOIN
        Users u ON u.Id = p.OwnerUserId
    WHERE 
        p.PostTypeId = 1
    GROUP BY 
        p.Id, p.Title, p.OwnerUserId, u.DisplayName, p.CreationDate
),
TopUsers AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        SUM(CASE WHEN b.Class = 1 THEN 3 ELSE 1 END) AS BadgePoints,
        AVG(COALESCE(v.Score, 0.0)) AS AverageVoteScore
    FROM 
        Users u
    LEFT JOIN 
        Badges b ON b.UserId = u.Id
    LEFT JOIN 
        Votes v ON v.UserId = u.Id
    GROUP BY 
        u.Id, u.DisplayName
    HAVING 
        SUM(CASE WHEN b.Class = 1 THEN 3 ELSE 1 END) > 50
)
SELECT 
    rq.PostId,
    rq.Title,
    rq.OwnerUserId,
    rq.DisplayName,
    rq.CreationDate,
    rq.AnswerCount,
    tu.BadgePoints,
    tu.AverageVoteScore
FROM 
    RecentQuestions rq
JOIN 
    TopUsers tu ON tu.UserId = rq.OwnerUserId
WHERE 
    rq.Rank = 1
ORDER BY 
    tu.BadgePoints DESC, rq.CreationDate DESC;