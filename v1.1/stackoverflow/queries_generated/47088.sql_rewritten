-- {"query": "47088.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "claude-4.1-opus", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 201872, "output_tokens": 178887} 
WITH RECURSIVE TagHierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        CAST(t.TagName AS VARCHAR(500)) AS TagPath,
        1 AS Level
    FROM Tags t
    WHERE t.Count > 1000
    
    UNION ALL
    
    SELECT 
        t2.Id,
        t2.TagName,
        t2.Count,
        CAST(th.TagPath || ' -> ' || t2.TagName AS VARCHAR(500)),
        th.Level + 1
    FROM Tags t2
    INNER JOIN TagHierarchy th ON th.Id != t2.Id
    INNER JOIN Posts p1 ON p1.Tags LIKE '%<' || th.TagName || '>%'
    INNER JOIN Posts p2 ON p2.Tags LIKE '%<' || t2.TagName || '>%' AND p2.Id = p1.Id
    WHERE th.Level < 3 AND t2.Count > 500
),
UserExpertise AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        SUBSTRING(p.Tags, 2, POSITION('>' IN p.Tags) - 2) AS PrimaryTag,
        COUNT(DISTINCT p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgScore,
        COUNT(DISTINCT CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN p.Id END) AS AcceptedAnswers,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS MedianScore,
        STDDEV(p.Score) AS ScoreStdDev
    FROM Users u
    INNER JOIN Posts p ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId IN (1, 2)
        AND p.Score > 0
        AND u.Reputation > 1000
        AND p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '2 years'
    GROUP BY u.Id, u.DisplayName, u.Reputation, SUBSTRING(p.Tags, 2, POSITION('>' IN p.Tags) - 2)
    HAVING COUNT(DISTINCT p.Id) >= 10
),
PostEvolution AS (
    SELECT 
        ph.PostId,
        p.PostTypeId,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6) THEN ph.Id END) AS EditCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (7, 8, 9) THEN ph.Id END) AS RollbackCount,
        COUNT(DISTINCT ph.UserId) AS UniqueEditors,
        MAX(ph.CreationDate) - MIN(ph.CreationDate) AS EditTimeSpan,
        STRING_AGG(DISTINCT ph.Comment, ' | ' ORDER BY ph.CreationDate) AS EditComments
    FROM PostHistory ph
    INNER JOIN Posts p ON p.Id = ph.PostId
    WHERE ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)
    GROUP BY ph.PostId, p.PostTypeId
),
VotingPatterns AS (
    SELECT 
        v.PostId,
        COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpVotes,
        COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownVotes,
        COUNT(CASE WHEN v.VoteTypeId = 8 THEN 1 END) AS Bounties,
        SUM(CASE WHEN v.VoteTypeId = 8 THEN v.BountyAmount ELSE 0 END) AS TotalBountyAmount,
        COUNT(DISTINCT v.UserId) AS UniqueVoters,
        COUNT(DISTINCT DATE(v.CreationDate)) AS VotingDays
    FROM Votes v
    WHERE v.CreationDate >= cast('2024-10-01' as date) - INTERVAL '1 year'
    GROUP BY v.PostId
),
BadgeAnalysis AS (
    SELECT 
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        COUNT(CASE WHEN b.TagBased = true THEN 1 END) AS TagBadges,
        STRING_AGG(CASE WHEN b.Class = 1 THEN b.Name END, ', ' ORDER BY b.Date) AS GoldBadgeNames,
        MIN(b.Date) AS FirstBadgeDate,
        MAX(b.Date) AS LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
)
SELECT 
    ue.DisplayName,
    ue.Reputation,
    ue.PrimaryTag,
    ue.PostCount,
    ue.TotalScore,
    ue.AvgScore,
    ue.MedianScore,
    ue.AcceptedAnswers,
    ba.GoldBadges,
    ba.SilverBadges,
    ba.BronzeBadges,
    ba.TagBadges,
    ba.GoldBadgeNames,
    COALESCE(th.TagPath, ue.PrimaryTag) AS TagHierarchyPath,
    COUNT(DISTINCT p.Id) AS RecentQuestions,
    COUNT(DISTINCT a.Id) AS RecentAnswers,
    AVG(pe.EditCount) AS AvgEditsPerPost,
    AVG(pe.UniqueEditors) AS AvgEditorsPerPost,
    SUM(vp.UpVotes) AS TotalUpVotesReceived,
    SUM(vp.DownVotes) AS TotalDownVotesReceived,
    SUM(vp.TotalBountyAmount) AS TotalBountiesReceived,
    COUNT(DISTINCT pl.RelatedPostId) AS LinkedPosts,
    COUNT(DISTINCT c.Id) AS CommentsReceived,
    AVG(c.Score) AS AvgCommentScore,
    EXTRACT(DAY FROM (MAX(p.LastActivityDate) - MIN(p.CreationDate))) AS ActiveDays,
    COUNT(DISTINCT DATE_TRUNC('week', p.CreationDate)) AS ActiveWeeks,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.ClosedDate IS NOT NULL) AS ClosedPosts,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.CommunityOwnedDate IS NOT NULL) AS CommunityWikiPosts,
    RANK() OVER (PARTITION BY ue.PrimaryTag ORDER BY ue.TotalScore DESC) AS TagRank,
    DENSE_RANK() OVER (ORDER BY ue.Reputation DESC) AS GlobalRank,
    NTILE(100) OVER (ORDER BY ue.AvgScore) AS ScorePercentile,
    LAG(ue.TotalScore, 1) OVER (PARTITION BY ue.PrimaryTag ORDER BY ue.TotalScore DESC) AS NextLowerScore,
    LEAD(ue.TotalScore, 1) OVER (PARTITION BY ue.PrimaryTag ORDER BY ue.TotalScore DESC) AS NextHigherScore
FROM UserExpertise ue
LEFT JOIN BadgeAnalysis ba ON ba.UserId = ue.UserId
LEFT JOIN TagHierarchy th ON th.TagName = ue.PrimaryTag
LEFT JOIN Posts p ON p.OwnerUserId = ue.UserId 
    AND p.PostTypeId = 1 
    AND p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '6 months'
LEFT JOIN Posts a ON a.OwnerUserId = ue.UserId 
    AND a.PostTypeId = 2 
    AND a.CreationDate >= cast('2024-10-01' as date) - INTERVAL '6 months'
LEFT JOIN PostEvolution pe ON pe.PostId IN (p.Id, a.Id)
LEFT JOIN VotingPatterns vp ON vp.PostId IN (p.Id, a.Id)
LEFT JOIN PostLinks pl ON pl.PostId IN (p.Id, a.Id)
LEFT JOIN Comments c ON c.PostId IN (p.Id, a.Id)
WHERE ue.Reputation > 5000
GROUP BY 
    ue.UserId, ue.DisplayName, ue.Reputation, ue.PrimaryTag, 
    ue.PostCount, ue.TotalScore, ue.AvgScore, ue.MedianScore,
    ue.AcceptedAnswers, ue.ScoreStdDev,
    ba.GoldBadges, ba.SilverBadges, ba.BronzeBadges, ba.TagBadges,
    ba.GoldBadgeNames, ba.FirstBadgeDate, ba.LastBadgeDate,
    th.TagPath
HAVING COUNT(DISTINCT p.Id) + COUNT(DISTINCT a.Id) > 5
ORDER BY ue.TotalScore DESC, ue.Reputation DESC
LIMIT 100;