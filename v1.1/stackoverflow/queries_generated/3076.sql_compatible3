WITH RecentPostUpdates AS (
    SELECT
        ph.PostId,
        ph.CreationDate,
        ph.UserId,
        ph.Comment,
        ph.PostHistoryTypeId,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM
        PostHistory ph
    WHERE
        ph.PostHistoryTypeId IN (4,5,6,10,14,16)
),
LatestPostComments AS (
    SELECT
        c.PostId,
        c.CreationDate,
        c.UserId,
        c.UserDisplayName,
        c.Text,
        ROW_NUMBER() OVER (PARTITION BY c.PostId ORDER BY c.CreationDate DESC) AS rn
    FROM
        Comments c
),
TopQuestions AS (
    SELECT
        p.Id,
        p.Title,
        p.Tags,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount
    FROM
        Posts p
    WHERE
        p.PostTypeId = 1
),
QuestionsWithHighAnswerScore AS (
    SELECT
        tq.Id AS QuestionId,
        tq.Title,
        tq.Tags,
        tq.Score,
        tq.ViewCount,
        tq.CreationDate,
        tq.OwnerUserId,
        tq.AnswerCount,
        tq.CommentCount,
        tq.FavoriteCount
    FROM
        TopQuestions tq
    WHERE
        tq.AnswerCount > (SELECT AVG(AnswerCount) FROM TopQuestions)
),
PopularTags AS (
    SELECT
        t.TagName,
        t.Count,
        t.IsRequired,
        t.IsModeratorOnly,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rank
    FROM
        Tags t
    WHERE
        t.IsModeratorOnly = FALSE
),
TagRelations AS (
    SELECT
        tt1.TagName AS TagA,
        tt2.TagName AS TagB,
        COUNT(*) AS LinkCount
    FROM
        Posts p1
        JOIN Posts p2 ON p1.Id = p2.ParentId
        JOIN LATERAL unnest(string_to_array(substring(p1.Tags FROM 2 FOR (char_length(p1.Tags)-2)), '><')) AS t1(TagName) ON TRUE
        JOIN LATERAL unnest(string_to_array(substring(p2.Tags FROM 2 FOR (char_length(p2.Tags)-2)), '><')) AS t2(TagName) ON TRUE
        JOIN Tags tt1 ON tt1.TagName = t1.TagName
        JOIN Tags tt2 ON tt2.TagName = t2.TagName
    GROUP BY
        tt1.TagName, tt2.TagName
),
MostPopularTags AS (
    SELECT
        TagName,
        Count,
        ROW_NUMBER() OVER (ORDER BY Count DESC) AS rank
    FROM
        Tags
),
AnswerCommentAnalysis AS (
    SELECT
        c.UserId,
        c.UserDisplayName,
        AVG(CASE WHEN LOWER(c.Text) LIKE '%thanks%' OR LOWER(c.Text) LIKE '%thank you%' THEN 1 ELSE 0 END) AS AvgThankComments,
        COUNT(*) AS TotalComments,
        COUNT(CASE WHEN LOWER(c.Text) LIKE '%bug%' OR LOWER(c.Text) LIKE '%error%' THEN 1 END) AS BugRelatedComments
    FROM
        Comments c
    WHERE
        c.PostId IN (SELECT Id FROM Posts WHERE PostTypeId = 2)
    GROUP BY
        c.UserId, c.UserDisplayName
),
AnswerVotes AS (
    SELECT
        v.PostId,
        COUNT(*) AS VoteCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
    FROM
        Votes v
    WHERE
        v.PostId IN (SELECT Id FROM Posts WHERE PostTypeId = 2)
    GROUP BY
        v.PostId
),
ActiveUsers AS (
    SELECT
        u.Id,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        u.Location,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.EmailHash
    FROM
        Users u
    WHERE
        u.LastAccessDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30' DAY)
)
SELECT
    rp.PostId,
    rp.CreationDate AS PostCreated,
    uc.DisplayName AS OwnerName,
    t.Tags,
    hl.Comment AS LatestPostComment,
    hp.Title AS QuestionTitle,
    hr.TypeName AS LastChangeType,
    laut.Text AS LastComment
FROM
    Posts p
    LEFT JOIN Users uc ON p.OwnerUserId = uc.Id
    LEFT JOIN (
        SELECT
            p_in.Id,
            p_in.CreationDate,
            ROW_NUMBER() OVER (PARTITION BY p_in.Id ORDER BY p_in.CreationDate DESC) AS rn
        FROM
            Posts p_in
    ) rp ON p.Id = rp.Id AND rp.rn = 1
    LEFT JOIN LATERAL (
        SELECT
            c.Text,
            c.CreationDate
        FROM
            Comments c
        WHERE
            c.PostId = p.Id
        ORDER BY
            c.CreationDate DESC
        LIMIT 1
    ) laut ON TRUE
    LEFT JOIN LATERAL (
        SELECT
            t2.TagName,
            t2.Count,
            t2.IsRequired,
            t2.IsModeratorOnly
        FROM
            Tags t2
        WHERE
            t2.TagName IN (
                SELECT unnest(string_to_array(substring(p.Tags FROM 2 FOR (char_length(p.Tags)-2)), '><'))
            )
        LIMIT 1
    ) t ON TRUE
    LEFT JOIN LATERAL (
        SELECT
            ph.TypeName,
            ph.CreationDate
        FROM
            PostHistory ph
        WHERE
            ph.PostId = p.Id AND ph.PostHistoryTypeId = 4
        ORDER BY
            ph.CreationDate DESC
        LIMIT 1
    ) hr ON TRUE
    LEFT JOIN LATERAL (
        SELECT
            ph.Comment,
            ph.CreationDate
        FROM
            PostHistory ph
        WHERE
            ph.PostId = p.Id AND ph.PostHistoryTypeId = 11
        ORDER BY
            ph.CreationDate DESC
        LIMIT 1
    ) hl ON TRUE
    LEFT JOIN LATERAL (
        SELECT
            ph.Comment,
            ph.CreationDate
        FROM
            PostHistory ph
        WHERE
            ph.PostId = p.Id AND ph.PostHistoryTypeId = 52
        ORDER BY
            ph.CreationDate DESC
        LIMIT 1
    ) last_hot ON TRUE
    JOIN Posts q ON p.AcceptedAnswerId = q.Id
    LEFT JOIN Votes v ON q.Id = v.PostId
    LEFT JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    LEFT JOIN Users u ON v.UserId = u.Id
    LEFT JOIN Posts hp ON p.Id = hp.Id
WHERE
    p.PostTypeId = 1
    AND EXISTS (
        SELECT 1
        FROM
            PostLinks pl
        WHERE
            pl.PostId = p.Id AND pl.LinkTypeId = 3
    )
ORDER BY
    p.CreationDate DESC
LIMIT 100;