WITH PostBase AS (
  SELECT p.Id,
         p.Title,
         COALESCE(u.DisplayName, '[deleted]') AS OwnerName,
         COALESCE(p.Score, 0) AS VoteScore,
         CAST(COALESCE(p.AnswerCount, 0) AS INTEGER) AS AnswerCount,
         CAST(COALESCE(pc.CommentCount, 0) AS INTEGER) AS CommentCount,
         (SELECT COUNT(DISTINCT c.UserId)
            FROM Comments c
           WHERE c.PostId = p.Id) AS UniqueCommenters,
         p.Tags
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN (
      SELECT PostId, COUNT(*) AS CommentCount
      FROM Comments
      GROUP BY PostId
    ) pc ON pc.PostId = p.Id
   WHERE p.PostTypeId = 1
),
TagAgg AS (
  SELECT pb.Id,
         pb.Title,
         pb.OwnerName,
         pb.VoteScore,
         pb.AnswerCount,
         pb.CommentCount,
         pb.UniqueCommenters,
         (SELECT string_agg(t.TagName, ', ')
            FROM (
              SELECT UNNEST(string_to_array(SUBSTRING(pb.Tags FROM 2 FOR CHAR_LENGTH(pb.Tags) - 2), '><')) AS tagname
            ) AS unnested
            JOIN Tags t ON t.TagName = unnested.tagname
         ) AS TagsCombined,
         CASE WHEN pb.VoteScore > 10 THEN 'High' ELSE 'Low' END AS ScoreLevel
    FROM PostBase pb
),
TopScore AS (
  SELECT Id, Title, OwnerName, VoteScore, AnswerCount, CommentCount, UniqueCommenters, TagsCombined, ScoreLevel,
         ROW_NUMBER() OVER (ORDER BY VoteScore DESC, CommentCount DESC) AS RN
    FROM TagAgg
   WHERE VoteScore IS NOT NULL
   ORDER BY VoteScore DESC, CommentCount DESC
   FETCH FIRST 10 ROWS ONLY
),
TopComment AS (
  SELECT Id, Title, OwnerName, VoteScore, AnswerCount, CommentCount, UniqueCommenters, TagsCombined, ScoreLevel,
         ROW_NUMBER() OVER (ORDER BY CommentCount DESC, VoteScore DESC) AS RN
    FROM TagAgg
   WHERE CommentCount IS NOT NULL
   ORDER BY CommentCount DESC, VoteScore DESC
   FETCH FIRST 10 ROWS ONLY
),
Combined AS (
  SELECT 'Score' AS Criteria,
         Id, Title, OwnerName, VoteScore, CommentCount, UniqueCommenters,
         TagsCombined, ScoreLevel
    FROM TopScore
  UNION ALL
  SELECT 'Comment' AS Criteria,
         Id, Title, OwnerName, VoteScore, CommentCount, UniqueCommenters,
         TagsCombined, ScoreLevel
    FROM TopComment
)
SELECT Criteria, Id, Title, OwnerName, VoteScore, CommentCount, UniqueCommenters, TagsCombined, ScoreLevel
  FROM Combined
 ORDER BY Criteria, VoteScore DESC, CommentCount DESC;