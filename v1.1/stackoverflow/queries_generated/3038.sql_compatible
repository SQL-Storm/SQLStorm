WITH UserReputation AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY u.CreationDate DESC) AS RevRank
    FROM Users u
),
RecentVotes AS (
    SELECT
        v.PostId,
        v.UserId,
        v.CreationDate AS VoteDate,
        vt.Name AS VoteTypeName
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    WHERE v.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '180 days'
),
PostTagSummary AS (
    SELECT
        p.Id AS PostId,
        p.Title,
        p.CreationDate,
        ARRAY_AGG(pt.TagName) AS Tags,
        p.Score,
        p.ViewCount,
        pc.CommentCount,
        COALESCE(ru.RecentUpVotes, 0) AS RecentUpVotes,
        COALESCE(rd.RecentDownVotes, 0) AS RecentDownVotes
    FROM Posts p
    LEFT JOIN PostTags pt ON pt.PostId = p.Id
    LEFT JOIN LATERAL (
        SELECT COUNT(*) AS RecentUpVotes FROM Votes v2
        JOIN VoteTypes vt2 ON v2.VoteTypeId = vt2.Id
        WHERE v2.PostId = p.Id AND vt2.Name = 'UpMod' AND v2.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '180 days'
    ) ru ON true
    LEFT JOIN LATERAL (
        SELECT COUNT(*) AS RecentDownVotes FROM Votes v3
        JOIN VoteTypes vt3 ON v3.VoteTypeId = vt3.Id
        WHERE v3.PostId = p.Id AND vt3.Name = 'DownMod' AND v3.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '180 days'
    ) rd ON true
    LEFT JOIN (
        SELECT PostId, COUNT(*) AS CommentCount
        FROM Comments
        GROUP BY PostId
    ) pc ON pc.PostId = p.Id
    WHERE p.PostTypeId = 1
    GROUP BY p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount, pc.CommentCount
),
PostsWithLifecycle AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        COALESCE(ph1.PostHistoryTypeId, NULL) AS FirstEditTypeId,
        COALESCE(ph2.PostHistoryTypeId, NULL) AS LastEditTypeId,
        COALESCE(phCC.PostHistoryTypeId, NULL) AS CloseReasonId,
        g.FirstBadges,
        u.Reputation AS UserReputation,
        u.DisplayName AS UserDisplayName
    FROM Posts p
    LEFT JOIN PostHistory ph1 ON ph1.PostId = p.Id AND ph1.CreationDate = (
        SELECT MIN(phx.CreationDate) FROM PostHistory phx WHERE phx.PostId = p.Id
    )
    LEFT JOIN PostHistory ph2 ON ph2.PostId = p.Id AND ph2.CreationDate = (
        SELECT MAX(phy.CreationDate) FROM PostHistory phy WHERE phy.PostId = p.Id
    )
    LEFT JOIN PostHistory phCC ON phCC.PostId = p.Id AND phCC.PostHistoryTypeId = 10
    LEFT JOIN (
        SELECT
            b.UserId,
            ARRAY_AGG(b.Name) AS FirstBadges
        FROM Badges b
        WHERE b.Class = 1
        GROUP BY b.UserId
    ) g ON g.UserId = p.OwnerUserId
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
)
SELECT
    pwl.Id,
    pwl.Title,
    pwl.CreationDate,
    pss.Tags,
    pss.Score,
    pss.ViewCount,
    pss.CommentCount,
    u.DisplayName AS OwnerName,
    u.Reputation,
    pss.RecentUpVotes,
    pss.RecentDownVotes,
    CASE WHEN pwl.CloseReasonId IS NULL THEN 'Open' ELSE 'Closed' END AS PostStatus,
    pwl.LastEditTypeId,
    pwl.FirstEditTypeId,
    pwl.FirstBadges,
    EXISTS (
        SELECT 1 FROM Badges b2
        WHERE b2.UserId = pwl.OwnerUserId AND b2.Class = 1
    ) AS IsGoldBadgeHolder,
    (SELECT ARRAY_AGG(rv.UserId) FROM RecentVotes rv WHERE rv.PostId = pss.PostId AND rv.VoteTypeName = 'UpMod') AS RecentUpVoters,
    (SELECT ARRAY_AGG(rv2.UserId) FROM RecentVotes rv2 WHERE rv2.PostId = pss.PostId AND rv2.VoteTypeName = 'DownMod') AS RecentDownVoters
FROM PostTagSummary pss
JOIN PostsWithLifecycle pwl ON pwl.Id = pss.PostId
LEFT JOIN Users u ON u.Id = pwl.OwnerUserId
WHERE pwl.PostTypeId = 1
ORDER BY pwl.CreationDate DESC
LIMIT 100;