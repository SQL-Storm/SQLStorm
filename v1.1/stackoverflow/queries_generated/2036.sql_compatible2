WITH RecentActivity AS (
    SELECT 
        PostId, 
        MAX(CreationDate) AS LastActivityDate
    FROM 
        (
         SELECT PostId, CreationDate FROM Comments
         UNION ALL
         SELECT PostId, CreationDate FROM Votes
         UNION ALL
         SELECT Id AS PostId, LastEditDate AS CreationDate FROM Posts
         UNION ALL
         SELECT Id AS PostId, LastActivityDate AS CreationDate FROM Posts
         UNION ALL
         SELECT PostId, CreationDate FROM PostHistory
        ) AS CombinedActivity
    GROUP BY PostId
),
UserBadges AS (
    SELECT 
        u.Id AS UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges
    FROM 
        Users u
    LEFT JOIN 
        Badges b ON u.Id = b.UserId
    GROUP BY u.Id
),
HighReputationPosts AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS PostRank,
        p.OwnerUserId
    FROM 
        Posts p
    WHERE 
        p.Score >= 10
),
-- Helper to split tag string into rows in standard SQL using a recursive CTE
PostTags AS (
    SELECT Id AS PostId, Tags, 
           SUBSTR(Tags, 2, LENGTH(Tags) - 2) AS inner_tags
    FROM Posts
),
SplitTags AS (
    SELECT
        PostId,
        CASE 
            WHEN POSITION('><' IN inner_tags) = 0 THEN inner_tags
            ELSE SUBSTR(inner_tags, 1, CASE WHEN POSITION('><' IN inner_tags)=0 THEN LENGTH(inner_tags) ELSE POSITION('><' IN inner_tags)-1 END)
        END AS tag,
        CASE 
            WHEN POSITION('><' IN inner_tags) = 0 THEN ''
            ELSE SUBSTR(inner_tags, POSITION('><' IN inner_tags) + 2)
        END AS rest
    FROM PostTags
    WHERE inner_tags IS NOT NULL AND inner_tags <> ''
    UNION ALL
    SELECT
        PostId,
        CASE 
            WHEN POSITION('><' IN rest) = 0 THEN rest
            ELSE SUBSTR(rest, 1, POSITION('><' IN rest)-1)
        END AS tag,
        CASE 
            WHEN POSITION('><' IN rest) = 0 THEN ''
            ELSE SUBSTR(rest, POSITION('><' IN rest) + 2)
        END AS rest
    FROM SplitTags
    WHERE rest IS NOT NULL AND rest <> ''
),
TrimmedTags AS (
    SELECT PostId, TRIM(tag) AS TagName
    FROM SplitTags
    WHERE tag IS NOT NULL AND tag <> ''
),
TagStats AS (
    SELECT 
        t.Id AS TagId,
        t.TagName,
        COUNT(DISTINCT tt.PostId) AS TaggedPostsCount
    FROM 
        Tags t
    LEFT JOIN TrimmedTags tt
      ON tt.TagName = t.TagName
    GROUP BY 
        t.Id, t.TagName
)
SELECT 
    ua.DisplayName,
    ua.Reputation,
    COALESCE(ub.GoldBadges, 0) AS GoldBadges,
    COALESCE(ub.SilverBadges, 0) AS SilverBadges,
    COALESCE(ub.BronzeBadges, 0) AS BronzeBadges,
    ha.Title AS TopTitle,
    ha.Score AS TopScore,
    ra.LastActivityDate,
    ts.TagName AS MostUsedTag
FROM 
    Users ua
LEFT JOIN LATERAL (
    SELECT ra2.PostId, ra2.LastActivityDate
    FROM RecentActivity ra2
    JOIN Posts p2 ON p2.Id = ra2.PostId
    WHERE p2.OwnerUserId = ua.Id
    ORDER BY ra2.LastActivityDate DESC
    LIMIT 1
) ra ON TRUE
LEFT JOIN 
    UserBadges ub ON ub.UserId = ua.Id
LEFT JOIN LATERAL (
    SELECT hp.PostId, hp.Title, hp.Score
    FROM HighReputationPosts hp
    WHERE hp.OwnerUserId = ua.Id AND hp.PostRank = 1
    LIMIT 1
) ha ON TRUE
LEFT JOIN LATERAL (
    SELECT t.Id AS TagId, t.TagName
    FROM Tags t
    JOIN (
        SELECT p.Id AS Id
        FROM Posts p
        WHERE p.OwnerUserId = ua.Id
    ) p ON 1=1
    JOIN TrimmedTags tt ON tt.PostId = p.Id AND tt.TagName = t.TagName
    GROUP BY t.Id, t.TagName
    ORDER BY COUNT(p.Id) DESC
    LIMIT 1
) ts ON TRUE
WHERE 
    ua.Reputation > 1000
ORDER BY 
    ua.Reputation DESC
LIMIT 100;