WITH TopTags AS (
    SELECT t.TagName, COUNT(p.Id) AS PostCount, AVG(p.Score) AS AvgScore
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    WHERE p.PostTypeId = 1 AND p.CreationDate >= CAST('2010-01-01' AS TIMESTAMP)
    GROUP BY t.TagName
    HAVING COUNT(p.Id) > 1000
    ORDER BY PostCount DESC
    LIMIT 50
),
TagUsers AS (
    SELECT tt.TagName, u.Id AS UserId, u.Reputation, COUNT(DISTINCT p.Id) AS UserPostCount,
           SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvotesReceived,
           SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvotesReceived,
           COUNT(DISTINCT c.Id) AS CommentCount,
           COUNT(DISTINCT b.Id) AS BadgeCount,
           AVG(p.Score) AS AvgUserPostScore
    FROM TopTags tt
    JOIN Posts p ON p.Tags LIKE '%' || tt.TagName || '%'
    JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId IN (2, 3)
    LEFT JOIN Comments c ON c.PostId = p.Id
    LEFT JOIN Badges b ON b.UserId = u.Id AND b.Class <= 2
    WHERE p.PostTypeId = 1 AND p.CreationDate >= CAST('2010-01-01' AS TIMESTAMP)
    GROUP BY tt.TagName, u.Id, u.Reputation
),
RankedUsers AS (
    SELECT TagName, UserId, Reputation, UserPostCount, UpvotesReceived, DownvotesReceived,
           CommentCount, BadgeCount, AvgUserPostScore,
           RANK() OVER (PARTITION BY TagName ORDER BY (UpvotesReceived - DownvotesReceived) DESC, UserPostCount DESC) AS RankInTag
    FROM TagUsers
),
ClosedQuestions AS (
    SELECT p.Id AS PostId, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount,
           ph.CreationDate AS ClosedDate, ph.Comment AS CloseReasonId
    FROM Posts p
    JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId = 10
    WHERE p.ClosedDate IS NOT NULL
),
Duplicates AS (
    SELECT pl.PostId, COUNT(pl.RelatedPostId) AS DuplicateCount,
           STRING_AGG(CAST(pl.RelatedPostId AS VARCHAR), ',') AS DuplicateIds
    FROM PostLinks pl
    WHERE pl.LinkTypeId = 3
    GROUP BY pl.PostId
),
ActivitySummary AS (
    SELECT ru.TagName, ru.UserId, u.DisplayName, ru.Reputation, ru.UserPostCount,
           ru.UpvotesReceived, ru.DownvotesReceived, ru.CommentCount, ru.BadgeCount,
           ru.AvgUserPostScore, ru.RankInTag,
           COUNT(DISTINCT cq.PostId) AS ClosedQuestionsByUser,
           AVG(cq.Score) AS AvgClosedQuestionScore,
           SUM(cq.ViewCount) AS TotalClosedViews,
           COUNT(DISTINCT d.PostId) AS DuplicatesHandled,
           SUM(d.DuplicateCount) AS TotalDuplicates,
           EXTRACT(YEAR FROM p.CreationDate) AS Year,
           COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsByYear,
           COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersByYear
    FROM RankedUsers ru
    JOIN Users u ON ru.UserId = u.Id
    LEFT JOIN Posts p ON p.OwnerUserId = ru.UserId AND p.CreationDate >= CAST('2010-01-01' AS TIMESTAMP)
    LEFT JOIN ClosedQuestions cq ON cq.OwnerUserId = ru.UserId
    LEFT JOIN Duplicates d ON d.PostId IN (
        SELECT cq2.PostId FROM ClosedQuestions cq2 WHERE cq2.OwnerUserId = ru.UserId
    )
    WHERE ru.RankInTag <= 10
    GROUP BY ru.TagName, ru.UserId, u.DisplayName, ru.Reputation, ru.UserPostCount,
             ru.UpvotesReceived, ru.DownvotesReceived, ru.CommentCount, ru.BadgeCount,
             ru.AvgUserPostScore, ru.RankInTag, EXTRACT(YEAR FROM p.CreationDate)
)
SELECT TagName, UserId, DisplayName, Reputation, UserPostCount,
       UpvotesReceived, DownvotesReceived, CommentCount, BadgeCount,
       AvgUserPostScore, RankInTag, ClosedQuestionsByUser,
       AvgClosedQuestionScore, TotalClosedViews, DuplicatesHandled,
       TotalDuplicates, Year, QuestionsByYear, AnswersByYear,
       (UpvotesReceived * 10 + BadgeCount * 50 + ClosedQuestionsByUser * 5) AS ComputedScore
FROM ActivitySummary
WHERE Year BETWEEN 2010 AND 2023
ORDER BY TagName, RankInTag, ComputedScore DESC;