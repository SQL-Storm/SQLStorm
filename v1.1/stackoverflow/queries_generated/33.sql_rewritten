WITH UserReputations AS (
    SELECT UserId, SUM(Reputation) AS TotalReputation
    FROM Users
    GROUP BY UserId
), TopUsers AS (
    SELECT UserId, DisplayName, TotalReputation,
        ROW_NUMBER() OVER (ORDER BY TotalReputation DESC) AS Rank
    FROM UserReputations
)
SELECT t.UserId, t.DisplayName, t.TotalReputation, t.Rank
FROM TopUsers t
WHERE t.Rank <= 10
ORDER BY t.Rank;