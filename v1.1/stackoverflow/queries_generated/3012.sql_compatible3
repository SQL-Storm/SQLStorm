WITH TagUsageStats AS (
    SELECT
        t.TagName,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT q.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionPosts,
        COUNT(DISTINCT a.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerPosts,
        AVG(p.Score) AS AvgScore,
        MAX(p.Score) AS MaxScore,
        SUM(p.ViewCount) AS TotalViews,
        STRING_AGG(DISTINCT p.Tags, ',') AS AllTags
    FROM
        Tags t
        LEFT JOIN Posts p ON (',' || TRIM(BOTH '{}' FROM p.Tags) || ',') LIKE ('%,' || t.TagName || ',%') AND p.PostTypeId IN (1, 2)
        LEFT JOIN Posts q ON q.PostTypeId = 1 AND q.Id = t.ExcerptPostId
        LEFT JOIN Posts a ON a.PostTypeId = 2 AND a.ParentId = q.Id
    GROUP BY
        t.TagName, t.ExcerptPostId, t.WikiPostId, t.IsModeratorOnly, t.IsRequired
),
RecentPostHistory AS (
    SELECT
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ph.UserId,
        ph.Comment,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM
        PostHistory ph
    WHERE
        ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId IN (2,3)) AS VoteCount,
        MAX(p.LastActivityDate) AS LastActive
    FROM
        Users u
        LEFT JOIN Posts p ON p.OwnerUserId = u.Id
        LEFT JOIN Comments c ON c.UserId = u.Id
        LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY
        u.Id, u.DisplayName, u.Reputation
),
FlaggedPosts AS (
    SELECT
        p.Id AS PostId,
        COUNT(DISTINCT c.Id) AS FlagCount,
        STRING_AGG(DISTINCT c.UserDisplayName, ',') AS FlagUsers
    FROM
        Posts p
        LEFT JOIN Comments c ON c.PostId = p.Id AND LOWER(c.Text) LIKE '%flag%'
    GROUP BY
        p.Id
),
CombinedData AS (
    SELECT
        ts.TagName,
        ts.TotalPosts,
        ts.QuestionPosts,
        ts.AnswerPosts,
        ts.AvgScore,
        ts.MaxScore,
        ts.TotalViews,
        ts.AllTags,
        rh.PostId,
        rh.PostHistoryTypeId,
        rh.CreationDate,
        rh.UserId AS EditorUserId,
        u.DisplayName AS EditorName,
        rh.Comment AS RevisionComment,
        ua.Id AS LastEditorId,
        ua.DisplayName AS LastEditorName,
        ua.Reputation,
        ua.PostCount,
        ua.CommentCount,
        ua.VoteCount,
        ua.LastActive,
        fp.FlagCount,
        fp.FlagUsers
    FROM
        TagUsageStats ts
        LEFT JOIN RecentPostHistory rh ON rh.PostId = ts.ExcerptPostId AND rh.rn = 1
        LEFT JOIN Users u ON u.Id = rh.UserId
        LEFT JOIN Users ua ON ua.Id = rh.UserId
        LEFT JOIN FlaggedPosts fp ON fp.PostId = ts.ExcerptPostId
)
SELECT
    TagName,
    TotalPosts,
    QuestionPosts,
    AnswerPosts,
    AvgScore,
    MaxScore,
    TotalViews,
    AllTags,
    PostId,
    PostHistoryTypeId,
    CreationDate,
    EditorUserId,
    EditorName,
    RevisionComment,
    LastEditorId,
    LastEditorName,
    Reputation,
    PostCount,
    CommentCount,
    VoteCount,
    LastActive,
    FlagCount,
    FlagUsers,
    CASE
        WHEN TotalPosts > 10 AND AvgScore > 0 THEN 'High activity and positive ratings'
        WHEN TotalViews BETWEEN 100 AND 1000 THEN 'Moderately viewed'
        WHEN COALESCE(FlagCount, 0) > 0 THEN 'Flagged for review'
        ELSE 'Other'
    END AS TagAnalysis,
    CAST('2024-10-01 12:34:56' AS TIMESTAMP) AS BenchmarkTimestamp
FROM
    CombinedData
ORDER BY
    TotalPosts DESC, MaxScore DESC, LastActive DESC
LIMIT 100;