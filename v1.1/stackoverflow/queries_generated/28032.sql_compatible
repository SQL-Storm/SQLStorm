WITH UserStats AS (
    SELECT 
        u.Id,
        u.Reputation,
        u.Location,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank,
        AVG(p.Score) OVER (PARTITION BY u.Location) AS AvgLocationScore
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    GROUP BY u.Id, u.Reputation, u.Location
),
PostAnalysis AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.Tags,
        COALESCE(NULLIF(p.ClosedDate, TIMESTAMP '1970-01-01'), TIMESTAMP '2024-10-01 12:34:56') AS EffectiveClosedDate,
        -- replace STRING_TO_ARRAY with a more portable split: here we keep original function but also provide a fallback using regexp_split_to_array when available
        CASE
          WHEN POSITION('><' IN p.Tags) > 0 OR (p.Tags LIKE '<%>') THEN regexp_split_to_array(TRIM(BOTH '<>' FROM p.Tags), '><')
          ELSE ARRAY[]::text[]
        END AS TagArray,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes
    FROM Posts p
    WHERE p.PostTypeId = 1
),
CombinedData AS (
    SELECT 
        us.Id AS UserId,
        us.Reputation,
        us.Location,
        us.GoldBadges,
        us.TotalPosts,
        pa.Id AS PostId,
        pa.Score AS PostScore,
        pa.Upvotes,
        (CASE WHEN array_length(pa.TagArray, 1) >= 1 THEN pa.TagArray[1] ELSE NULL END) AS PrimaryTag,
        CASE 
            WHEN us.Reputation > 100000 THEN 'Legendary'
            WHEN us.GoldBadges > 10 AND us.TotalPosts > 100 THEN 'PowerUser'
            ELSE 'Regular'
        END AS UserClass,
        ROUND(EXTRACT(EPOCH FROM (pa.EffectiveClosedDate - p.CreationDate)) / 86400.0, 2) AS DaysOpen,
        DENSE_RANK() OVER (PARTITION BY us.Location ORDER BY us.Reputation DESC) AS LocationRank
    FROM UserStats us
    LEFT JOIN PostAnalysis pa ON us.Id = pa.OwnerUserId
    LEFT JOIN Posts p ON pa.Id = p.Id
    WHERE us.Location IS NOT NULL
      AND pa.Score > (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.PostTypeId = 1)
    GROUP BY
        us.Id, us.Reputation, us.Location, us.GoldBadges, us.TotalPosts,
        pa.Id, pa.Score, pa.Upvotes, pa.TagArray, p.CreationDate
),
CombinedAgg AS (
    SELECT *
    FROM CombinedData
)
SELECT 
    cd.UserId,
    cd.UserClass,
    cd.PrimaryTag,
    SUM(cd.Upvotes) OVER (PARTITION BY cd.PrimaryTag ORDER BY cd.PostScore DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CumulativeUpvotes,
    (SELECT COUNT(*) FROM Comments c WHERE c.UserId = cd.UserId AND c.CreationDate BETWEEN DATE '2022-01-01' AND DATE '2023-01-01') AS AnnualComments,
    COALESCE((
        SELECT STRING_AGG(ph.Text, ' | ') 
        FROM PostHistory ph 
        WHERE ph.PostId = cd.UserId 
          AND ph.PostHistoryTypeId IN (2,5)
        ORDER BY ph.Id
        LIMIT 3
    ), 'No Edits') AS RecentEdits,
    cd.LocationRank
FROM CombinedAgg cd
WHERE cd.DaysOpen < (SELECT AVG(c2.DaysOpen) FROM CombinedAgg c2 WHERE c2.UserClass = cd.UserClass)
UNION ALL
SELECT 
    u.Id AS UserId,
    'Inactive' AS UserClass,
    NULL AS PrimaryTag,
    0 AS CumulativeUpvotes,
    0 AS AnnualComments,
    'No Activity' AS RecentEdits,
    NULL AS LocationRank
FROM Users u
WHERE u.Id NOT IN (SELECT UserId FROM CombinedAgg)
ORDER BY CumulativeUpvotes DESC NULLS LAST, LocationRank NULLS LAST;