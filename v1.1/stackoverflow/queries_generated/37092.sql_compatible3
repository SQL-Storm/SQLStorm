WITH
QuestionTags AS (
  SELECT
    p.Id AS QuestionId,
    CAST(p.CreationDate AS date) AS QDate,
    lower(tag) AS Tag
  FROM Posts p,
  LATERAL (
    SELECT unnest(string_to_array(substring(p.Tags FROM 2 FOR char_length(p.Tags)-2), '><')) AS tag
  ) t
  WHERE p.PostTypeId = 1
),
MonthlyQuestions AS (
  SELECT
    CAST(date_trunc('month', QDate) AS date) AS Month,
    Tag,
    COUNT(*) AS QuestionsInMonth,
    MIN(QuestionId) AS SampleQuestionId
  FROM QuestionTags
  GROUP BY CAST(date_trunc('month', QDate) AS date), Tag
),
QuestionMetrics AS (
  SELECT
    q.Id AS QuestionId,
    q.Title,
    q.CreationDate,
    q.Score,
    COALESCE(q.ViewCount,0) AS ViewCount,
    COALESCE(q.AnswerCount,0) AS AnswerCount,
    CASE WHEN q.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAccepted,
    u.Id AS OwnerUserId,
    COALESCE(u.Reputation,0) AS OwnerReputation,
    COALESCE(c.CommentCount,0) AS CommentCount,
    COALESCE(ph.EditCount,0) AS EditCount,
    COALESCE(outlinks.OutgoingLinks,0) AS OutgoingLinks,
    COALESCE(inlinks.IncomingLinks,0) AS IncomingLinks
  FROM Posts q
  LEFT JOIN Users u ON q.OwnerUserId = u.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) AS CommentCount FROM Comments GROUP BY PostId
  ) c ON c.PostId = q.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) FILTER (WHERE PostHistoryTypeId IN (4,5,6,24)) AS EditCount
    FROM PostHistory
    GROUP BY PostId
  ) ph ON ph.PostId = q.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) FILTER (WHERE LinkTypeId = 1) AS OutgoingLinks FROM PostLinks GROUP BY PostId
  ) outlinks ON outlinks.PostId = q.Id
  LEFT JOIN (
    SELECT RelatedPostId AS PostId, COUNT(*) FILTER (WHERE LinkTypeId = 1) AS IncomingLinks FROM PostLinks GROUP BY RelatedPostId
  ) inlinks ON inlinks.PostId = q.Id
  WHERE q.PostTypeId = 1
),
TagMonthStats AS (
  SELECT
    mq.Month,
    qt.Tag,
    COUNT(*) AS Questions,
    AVG(qm.Score) AS AvgScore,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY qm.ViewCount) AS MedianViews,
    MAX(qm.ViewCount) AS MaxViews,
    SUM(qm.HasAccepted) AS AcceptedCount,
    AVG(qm.AnswerCount) AS AvgAnswerCount,
    AVG(qm.OwnerReputation) AS AvgOwnerReputation,
    SUM(qm.CommentCount) AS TotalComments,
    SUM(qm.EditCount) AS TotalEdits,
    SUM(qm.OutgoingLinks) AS TotalOutgoingLinks,
    SUM(qm.IncomingLinks) AS TotalIncomingLinks
  FROM MonthlyQuestions mq
  JOIN QuestionTags qt ON qt.QDate >= mq.Month AND CAST(date_trunc('month', qt.QDate) AS date) = mq.Month AND qt.Tag = mq.Tag
  JOIN QuestionMetrics qm ON qm.QuestionId = qt.QuestionId
  GROUP BY mq.Month, qt.Tag
),
UserTagMonth AS (
  SELECT
    mt.Month,
    mt.Tag,
    u.Id AS UserId,
    u.DisplayName,
    COUNT(*) AS PostsByUser,
    SUM(COALESCE(p.Score,0)) AS TotalScoreByUser,
    0 AS UpVotesCastPlaceholder
  FROM MonthlyQuestions mt
  JOIN QuestionTags qt ON qt.Tag = mt.Tag AND CAST(date_trunc('month', qt.QDate) AS date) = mt.Month
  JOIN Posts p ON p.Id = qt.QuestionId
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  GROUP BY mt.Month, mt.Tag, u.Id, u.DisplayName
),
TagGrowth AS (
  SELECT
    tms.Month,
    tms.Tag,
    tms.Questions,
    tms.AvgScore,
    tms.MedianViews,
    tms.MaxViews,
    tms.AcceptedCount,
    tms.AvgAnswerCount,
    tms.AvgOwnerReputation,
    tms.TotalComments,
    tms.TotalEdits,
    tms.TotalOutgoingLinks,
    tms.TotalIncomingLinks,
    LAG(tms.Questions) OVER (PARTITION BY tms.Tag ORDER BY tms.Month) AS PrevMonthQuestions,
    CASE WHEN LAG(tms.Questions) OVER (PARTITION BY tms.Tag ORDER BY tms.Month) IS NULL THEN NULL
         WHEN LAG(tms.Questions) OVER (PARTITION BY tms.Tag ORDER BY tms.Month) = 0 THEN NULL
         ELSE (CAST(tms.Questions AS numeric) - LAG(tms.Questions) OVER (PARTITION BY tms.Tag ORDER BY tms.Month)) / NULLIF(LAG(tms.Questions) OVER (PARTITION BY tms.Tag ORDER BY tms.Month),0)
    END AS QoMQGrowth,
    ROW_NUMBER() OVER (PARTITION BY tms.Month ORDER BY tms.Questions DESC, tms.AvgScore DESC) AS TagRankInMonth
  FROM TagMonthStats tms
),
TopTagsRecent AS (
  SELECT
    Month,
    Tag,
    Questions,
    AvgScore,
    MedianViews,
    MaxViews,
    AcceptedCount,
    AvgOwnerReputation,
    TotalComments,
    TotalEdits,
    TotalOutgoingLinks,
    TotalIncomingLinks,
    QoMQGrowth,
    TagRankInMonth
  FROM TagGrowth
  WHERE Month >= date_trunc('month', CAST('2024-10-01' AS date)) - INTERVAL '5 months'
    AND TagRankInMonth <= 10
),
DeepDive AS (
  SELECT
    tt.Month,
    tt.Tag,
    tt.Questions,
    tt.AvgScore,
    tt.MedianViews,
    tt.MaxViews,
    tt.AcceptedCount,
    tt.AvgOwnerReputation,
    tt.TotalComments,
    tt.TotalEdits,
    tt.TotalOutgoingLinks,
    tt.TotalIncomingLinks,
    tt.QoMQGrowth,
    AVG(tt.Questions) OVER (PARTITION BY tt.Tag ORDER BY tt.Month ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS MA3_Questions,
    (tt.AvgScore - AVG(tt.AvgScore) OVER (PARTITION BY tt.Month)) / NULLIF(STDDEV_POP(tt.AvgScore) OVER (PARTITION BY tt.Month),0) AS Z_AvgScore,
    (SELECT to_json(uinfo) FROM (
       SELECT utm.UserId, utm.DisplayName, utm.PostsByUser, utm.TotalScoreByUser
       FROM UserTagMonth utm
       WHERE utm.Tag = tt.Tag AND utm.Month = tt.Month
       ORDER BY utm.PostsByUser DESC NULLS LAST, utm.TotalScoreByUser DESC NULLS LAST
       LIMIT 1
    ) uinfo) AS TopUser,
    (SELECT json_agg(qs) FROM (
       SELECT qm.QuestionId AS Id, qm.Title, qm.Score, qm.ViewCount, qm.AnswerCount, qm.CreationDate, COALESCE(u.DisplayName,'[deleted]') AS Owner
       FROM QuestionMetrics qm
       LEFT JOIN Users u ON qm.OwnerUserId = u.Id
       JOIN QuestionTags qt ON qt.QuestionId = qm.QuestionId
       WHERE qt.Tag = tt.Tag AND CAST(date_trunc('month', qm.CreationDate) AS date) = tt.Month
       ORDER BY qm.ViewCount DESC NULLS LAST, qm.Score DESC NULLS LAST
       LIMIT 5
    ) qs) AS TopQuestionsSample
  FROM TopTagsRecent tt
)
SELECT
  dd.Month,
  dd.Tag,
  dd.Questions,
  dd.MA3_Questions,
  dd.QoMQGrowth,
  dd.AvgScore,
  ROUND(CAST(dd.Z_AvgScore AS numeric),3) AS Z_AvgScore,
  dd.MedianViews,
  dd.MaxViews,
  dd.AcceptedCount,
  dd.AvgOwnerReputation,
  dd.TotalComments,
  dd.TotalEdits,
  dd.TotalOutgoingLinks,
  dd.TotalIncomingLinks,
  dd.TopUser,
  dd.TopQuestionsSample
FROM DeepDive dd
ORDER BY dd.Month DESC, dd.Questions DESC;