WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpvotesGiven,
        COALESCE(SUM(p.Score) FILTER (WHERE p.PostTypeId IN (1,2)), 0) AS PostScoreSum,
        AVG(LENGTH(p.Body)) FILTER (WHERE p.PostTypeId = 1) AS AvgQuestionLength
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    GROUP BY u.Id
),
ClosedPosts AS (
    SELECT 
        ph.UserId,
        COUNT(DISTINCT ph.PostId) FILTER (WHERE cht.Name = 'Duplicate') AS DuplicateClosures,
        COUNT(DISTINCT ph.PostId) FILTER (WHERE cht.Name = 'Off-topic') AS OfftopicClosures
    FROM PostHistory ph
    JOIN CloseReasonTypes cht ON CAST(ph.Comment AS INTEGER) = cht.Id
    WHERE ph.PostHistoryTypeId = 10
    GROUP BY ph.UserId
),
TagPairs AS (
    /* Standardized tag-splitting without "::" casts and fixing reference to generated series alias */
    SELECT
        p.OwnerUserId AS UserId,
        TRIM(SUBSTR(p.Tags, start_pos, end_pos - start_pos)) AS TagName
    FROM Posts p
    CROSS JOIN LATERAL (
        SELECT
            idx,
            (CASE WHEN idx = 1 THEN 2 ELSE strpos_prev + 2 END) AS start_pos,
            (CASE WHEN strpos_curr = 0 THEN LENGTH(p.Tags) + 1 ELSE strpos_curr END) AS end_pos
        FROM (
            SELECT gs AS idx,
                   /* position of the (idx-1)th occurrence of '><' */
                   (SELECT CASE WHEN idx-1 = 0 THEN 0 ELSE (
                        -- find nth occurrence of substring '><' by scanning using generate_series of positions
                        (SELECT MIN(pos) FROM (
                            SELECT generate_series(1, LENGTH(p.Tags)) AS pos
                        ) s WHERE SUBSTR(p.Tags, pos, 2) = '><' AND
                                  (SELECT COUNT(*) FROM (
                                      SELECT generate_series(1, pos) AS rk
                                  ) rr WHERE SUBSTR(p.Tags, rk, 2) = '><') = idx-1
                   ) END) AS strpos_prev,
                   /* position of the idx-th occurrence of '><' */
                   (SELECT CASE WHEN idx = 0 THEN 0 ELSE (
                        (SELECT MIN(pos) FROM (
                            SELECT generate_series(1, LENGTH(p.Tags)) AS pos
                        ) s2 WHERE SUBSTR(p.Tags, pos, 2) = '><' AND
                                  (SELECT COUNT(*) FROM (
                                      SELECT generate_series(1, pos) AS rk2
                                  ) rr2 WHERE SUBSTR(p.Tags, rk2, 2) = '><') = idx
                       ) END) AS strpos_curr
            FROM (
                SELECT generate_series(1, GREATEST(1, LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', '')) + 1)) AS gs
            ) gs_table(gs)
        ) calc
    ) pos
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
),
TagExperts AS (
    SELECT
        tp.UserId,
        tp.TagName,
        COUNT(*) AS TagUseCount,
        RANK() OVER (PARTITION BY tp.UserId ORDER BY COUNT(*) DESC) AS TagRank
    FROM TagPairs tp
    GROUP BY tp.UserId, tp.TagName
)
SELECT 
    u.Id,
    u.DisplayName,
    us.BadgeCount,
    us.QuestionCount,
    us.AnswerCount,
    (us.PostScoreSum * 0.5 + us.UpvotesGiven * 0.3 + us.CommentCount * 0.2) AS ActivityScore,
    COALESCE(cp.DuplicateClosures, 0) + COALESCE(cp.OfftopicClosures, 0) AS TotalClosures,
    (SELECT AVG(p2.AnswerCount) FROM Posts p2 WHERE p2.OwnerUserId = u.Id AND p2.PostTypeId = 1) AS AvgAnswersPerQuestion,
    (SELECT STRING_AGG(te.TagName, ', ' ORDER BY te.TagUseCount DESC) 
     FROM TagExperts te 
     WHERE te.UserId = u.Id AND te.TagRank <= 3) AS TopTags,
    ROW_NUMBER() OVER (ORDER BY us.PostScoreSum DESC) AS GlobalRank,
    NTILE(4) OVER (ORDER BY u.Reputation) AS ReputationQuartile,
    CASE 
        WHEN EXISTS (SELECT 1 FROM Posts p3 WHERE p3.OwnerUserId = u.Id AND p3.AcceptedAnswerId IS NOT NULL)
        THEN LEAST(us.AvgQuestionLength * 0.1, 100)
        ELSE 0
    END AS QuestionQualityIndex
FROM Users u
JOIN UserStats us ON u.Id = us.UserId
LEFT JOIN ClosedPosts cp ON u.Id = cp.UserId
WHERE u.Reputation > 1000
    AND u.CreationDate BETWEEN '2010-01-01' AND '2020-01-01'
    AND (us.QuestionCount > 10 OR us.AnswerCount > 50)
ORDER BY ActivityScore DESC
LIMIT 100;