-- {"query": "20026.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-pro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1207} 
WITH UserQuestionDetails AS (
    -- Step 1: Select all questions and enrich them with window functions and tag parsing
    SELECT
        p.Id,
        p.OwnerUserId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.FavoriteCount,
        p.AcceptedAnswerId,
        -- Use ROW_NUMBER to find the most recent question for each user
        ROW_NUMBER() OVER(PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as QuestionRank,
        -- Calculate the average score of all questions by the same user
        AVG(p.Score) OVER(PARTITION BY p.OwnerUserId) as UserAvgQuestionScore,
        -- Find the date of the user's previous question
        LAG(p.CreationDate, 1) OVER(PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PreviousQuestionDate,
        -- Extract the primary tag from the tag string, handling potential NULL or empty tags
        CASE
            WHEN p.Tags IS NOT NULL AND p.Tags != '' THEN split_part(substring(p.Tags, 2, length(p.Tags) - 2), '><', 1)
            ELSE 'untagged'
        END as PrimaryTag
    FROM Posts p
    WHERE p.PostTypeId = 1 -- Questions only
),
GlobalTagStats AS (
    -- Step 2: Calculate global average statistics for each primary tag
    SELECT
        uqd.PrimaryTag,
        AVG(uqd.Score) as AvgGlobalScore,
        AVG(uqd.ViewCount) as AvgGlobalViewCount,
        COUNT(*) as TotalQuestionsWithTag
    FROM UserQuestionDetails uqd
    GROUP BY uqd.PrimaryTag
    HAVING COUNT(*) > 50 -- Only consider tags with a reasonable number of questions
),
ActiveOrVeteranUsers AS (
    -- Step 3: Define a set of interesting users using a UNION of two distinct groups
    SELECT Id, DisplayName, Reputation, Location FROM Users
    WHERE LastAccessDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') AND Reputation > 10000
    UNION
    SELECT Id, DisplayName, Reputation, Location FROM Users
    WHERE CreationDate < '2012-01-01' AND Reputation > 50000
)
-- Final SELECT: Combine all the data to generate a comprehensive report
SELECT
    u.DisplayName AS UserName,
    u.Reputation,
    -- Rank users within their location based on reputation
    DENSE_RANK() OVER (PARTITION BY COALESCE(u.Location, 'N/A') ORDER BY u.Reputation DESC) AS LocationRank,
    uqd.Title AS LastQuestionTitle,
    uqd.Score AS LastQuestionScore,
    -- Use a correlated subquery to get the number of "Close" votes for the user's last question
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = uqd.Id AND ph.PostHistoryTypeId = 10) AS CloseVotes,
    gts.AvgGlobalScore AS TagAvgScore,
    -- Complex calculation: Performance score relative to tag average and user's own average
    (uqd.Score - gts.AvgGlobalScore) / NULLIF(uqd.UserAvgQuestionScore, 0) AS RelativePerformance,
    -- Use a CASE statement for categorical analysis
    CASE
        WHEN uqd.Score > gts.AvgGlobalScore THEN 'Above Average'
        WHEN uqd.Score < gts.AvgGlobalScore THEN 'Below Average'
        ELSE 'Average'
    END AS PerformanceCategory,
    -- String manipulation and date arithmetic
    CONCAT('Asked on: ', TO_CHAR(uqd.CreationDate, 'YYYY-MM-DD'), '. Days since previous: ',
        EXTRACT(DAY FROM uqd.CreationDate - COALESCE(uqd.PreviousQuestionDate, uqd.CreationDate))
    ) AS QuestionTiming,
    aa.Body AS AcceptedAnswerBodySample,
    -- NULL logic: Show accepted answerer's name or 'No Accepted Answer'
    COALESCE(ans_user.DisplayName, 'No Accepted Answer') AS Answerer,
    -- Nested subquery to get the count of gold badges for the answerer
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = ans_user.Id AND b.Class = 1) AS AnswererGoldBadges
FROM
    ActiveOrVeteranUsers u
JOIN
    UserQuestionDetails uqd ON u.Id = uqd.OwnerUserId
LEFT JOIN
    GlobalTagStats gts ON uqd.PrimaryTag = gts.PrimaryTag
LEFT JOIN
    Posts aa ON uqd.AcceptedAnswerId = aa.Id -- Outer join to include questions without accepted answers
LEFT JOIN
    Users ans_user ON aa.OwnerUserId = ans_user.Id
WHERE
    uqd.QuestionRank = 1 -- Filter for only the most recent question of each user
    AND u.Location IS NOT NULL
    AND u.Location != ''
    AND uqd.FavoriteCount > (SELECT AVG(FavoriteCount) FROM Posts WHERE PostTypeId = 1 AND FavoriteCount > 0) -- Filter for questions with higher-than-average favorite counts
ORDER BY
    u.Location, LocationRank, u.Reputation DESC
LIMIT 500;