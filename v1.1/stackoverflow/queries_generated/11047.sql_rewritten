-- {"query": "11047.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 839} 
WITH RecentPosts AS (
    SELECT 
        p.Id, 
        p.Title, 
        p.CreationDate, 
        p.Score, 
        p.ViewCount, 
        p.AnswerCount, 
        u.DisplayName AS OwnerDisplayName, 
        u.Reputation,
        COUNT(DISTINCT v.Id) AS VoteCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvoteCount,
        MAX(c.CreationDate) AS LastCommentDate,
        COUNT(DISTINCT c.Id) AS CommentCount
    FROM 
        Posts p
    JOIN 
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    LEFT JOIN 
        Comments c ON p.Id = c.PostId
    WHERE 
        p.CreationDate > cast('2024-10-01' as date) - INTERVAL '30 days'
    GROUP BY 
        p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, u.DisplayName, u.Reputation
),
UserActivity AS (
    SELECT 
        UserId, 
        COUNT(DISTINCT PostId) AS PostsCreated, 
        SUM(Score) AS TotalScore, 
        COUNT(DISTINCT CASE WHEN VoteTypeId = 2 THEN Id END) AS UpvotesGiven, 
        COUNT(DISTINCT CASE WHEN VoteTypeId = 3 THEN Id END) AS DownvotesGiven
    FROM 
        Posts p
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    GROUP BY 
        UserId
),
TopUsers AS (
    SELECT 
        UserId, 
        PostsCreated, 
        TotalScore, 
        UpvotesGiven, 
        DownvotesGiven,
        ROW_NUMBER() OVER (ORDER BY TotalScore DESC) AS Rank
    FROM 
        UserActivity
    WHERE 
        PostsCreated > 0
),
PostTags AS (
    SELECT 
        p.Id, 
        t.TagName
    FROM 
        Posts p
    JOIN 
        Tags t ON p.Id = t.ExcerptPostId
)
SELECT 
    rp.Id AS PostId, 
    rp.Title, 
    rp.CreationDate, 
    rp.Score, 
    rp.ViewCount, 
    rp.AnswerCount, 
    rp.OwnerDisplayName, 
    rp.Reputation, 
    rp.VoteCount, 
    rp.UpvoteCount, 
    rp.DownvoteCount, 
    rp.LastCommentDate, 
    rp.CommentCount, 
    STRING_AGG(pt.TagName, ', ') AS Tags, 
    tu.PostsCreated, 
    tu.TotalScore, 
    tu.UpvotesGiven, 
    tu.DownvotesGiven, 
    tu.Rank
FROM 
    RecentPosts rp
LEFT JOIN 
    PostTags pt ON rp.Id = pt.Id
LEFT JOIN 
    TopUsers tu ON rp.OwnerUserId = tu.UserId
GROUP BY 
    rp.Id, rp.Title, rp.CreationDate, rp.Score, rp.ViewCount, rp.AnswerCount, rp.OwnerDisplayName, rp.Reputation, rp.VoteCount, rp.UpvoteCount, rp.DownvoteCount, rp.LastCommentDate, rp.CommentCount, tu.PostsCreated, tu.TotalScore, tu.UpvotesGiven, tu.DownvotesGiven, tu.Rank
ORDER BY 
    rp.Score DESC, 
    rp.ViewCount DESC, 
    tu.TotalScore DESC, 
    tu.Rank
LIMIT 100;