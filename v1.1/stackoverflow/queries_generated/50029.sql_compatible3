WITH TaggedQuestions AS (
  SELECT
    p.Id,
    p.OwnerUserId,
    p.CreationDate AS QuestionDate,
    p.Score AS QuestionScore,
    p.ViewCount,
    p.AnswerCount,
    p.FavoriteCount,
    tag.TagName
  FROM Posts p,
    unnest(string_to_array(substring(p.Tags FROM 2 FOR (char_length(p.Tags) - 2)), '><')) AS tag(TagName)
  WHERE
    p.PostTypeId = 1
    AND p.ClosedDate IS NULL
    AND p.DeletionDate IS NULL
    AND p.AnswerCount > 2
),
AnswerStats AS (
  SELECT
    p.ParentId,
    a.OwnerUserId,
    COUNT(*) AS TotalAnswers,
    SUM(a.Score) AS TotalAnswerScore,
    AVG(a.Score) AS AvgAnswerScore,
    MAX(a.CreationDate) AS LastAnswerDate,
    MIN(a.CreationDate) AS FirstAnswerDate,
    SUM(a.CommentCount) AS TotalAnswerComments
  FROM Posts p
    JOIN Posts a ON p.Id = a.ParentId
  WHERE
    a.PostTypeId = 2
    AND a.DeletionDate IS NULL
  GROUP BY
    p.ParentId,
    a.OwnerUserId
),
UserEngagement AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.UpVotes,
    u.DownVotes,
    (
      SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1
    ) AS GoldBadges,
    (
      SELECT COUNT(*) FROM Comments c WHERE c.UserId = u.Id
    ) AS TotalCommentsMade,
    AVG(EXTRACT(EPOCH FROM (ph.CreationDate - p.CreationDate))) AS AvgEditTime
  FROM Users u
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId
      AND ph.PostHistoryTypeId IN (4, 5, 6)
    LEFT JOIN Posts p ON ph.PostId = p.Id
  WHERE
    u.Reputation > 1000
    AND u.CreationDate < DATE '2022-01-01'
  GROUP BY
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.UpVotes,
    u.DownVotes
),
RankedAnswers AS (
  SELECT
    tq.TagName,
    ue.DisplayName AS AnswererDisplayName,
    ue.Reputation,
    ans.TotalAnswerScore,
    tq.QuestionScore,
    ans.TotalAnswers,
    ue.GoldBadges,
    tq.ViewCount,
    (EXTRACT(EPOCH FROM ans.LastAnswerDate) - EXTRACT(EPOCH FROM tq.QuestionDate)) AS TimeToLastAnswer,
    DENSE_RANK() OVER (PARTITION BY tq.TagName ORDER BY ans.TotalAnswerScore DESC, ue.Reputation DESC) AS Rank
  FROM TaggedQuestions tq
    JOIN AnswerStats ans ON tq.Id = ans.ParentId
    JOIN UserEngagement ue ON ans.OwnerUserId = ue.UserId
  WHERE
    (tq.OwnerUserId IS DISTINCT FROM ans.OwnerUserId)
    AND ans.TotalAnswerScore > tq.QuestionScore
)
SELECT
  ra.TagName,
  ra.Rank,
  ra.AnswererDisplayName,
  ra.Reputation,
  ra.TotalAnswerScore,
  ra.QuestionScore,
  ra.TotalAnswers,
  ra.GoldBadges,
  ra.ViewCount,
  ra.TimeToLastAnswer
FROM RankedAnswers ra
  JOIN Tags t ON ra.TagName = t.TagName
WHERE
  ra.Rank <= 5
  AND t.Count > 1000
ORDER BY
  ra.TagName,
  ra.Rank;