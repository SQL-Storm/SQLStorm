-- {"query": "5085.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 954} 
with 
-- Identify top users based on combination of answer acceptance and badge diversity
TopContributors as (
  select 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    count(distinct case when p.PostTypeId = 2 and exists (
      select 1 from Posts q where q.AcceptedAnswerId = p.Id
    ) then p.Id end) as AcceptedAnswers,
    count(distinct b.Name) as DistinctBadges,
    row_number() over (order by count(distinct case when p.PostTypeId = 2 and exists (
      select 1 from Posts q where q.AcceptedAnswerId = p.Id
    ) then p.Id end) desc, count(distinct b.Name) desc, u.Reputation desc) as Rank
  from 
    Users u
    left join Posts p on u.Id = p.OwnerUserId
    left join Badges b on u.Id = b.UserId
  group by u.Id, u.DisplayName, u.Reputation
),
-- Compute average post edit lag and comment score for each question
QuestionStats as (
  select
    q.Id as QuestionId,
    q.Title,
    q.OwnerUserId,
    coalesce(avg(extract(epoch from (ph.CreationDate - q.CreationDate))/3600), 0) as AvgEditLagHours,
    coalesce(avg(c.Score), 0) as AvgCommentScore,
    count(distinct c.Id) as TotalComments,
    max(q.Score) as MaxQuestionScore
  from 
    Posts q
    left join PostHistory ph on ph.PostId = q.Id and ph.PostHistoryTypeId in (4,5,6) -- title/body/tag edits
    left join Comments c on c.PostId = q.Id
  where 
    q.PostTypeId = 1
  group by q.Id, q.Title, q.OwnerUserId
),
-- Get recent duplicate relationships and closure reasons
RecentDuplicates as (
  select 
    pl.PostId,
    pl.RelatedPostId,
    pl.CreationDate as LinkCreated,
    lt.Name as LinkType,
    ph.Comment as CloseReasonComment,
    cr.Name as CloseReason
  from 
    PostLinks pl
    inner join LinkTypes lt on pl.LinkTypeId = lt.Id
    left join PostHistory ph 
      on ph.PostId = pl.PostId 
      and ph.PostHistoryTypeId = 10
      and date_trunc('day', ph.CreationDate) = date_trunc('day', pl.CreationDate)
    left join CloseReasonTypes cr on ph.Comment::int = cr.Id
  where 
    pl.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '180 days'
    and pl.LinkTypeId = 3
)
-- Combine everything for performance benchmarking
select 
  tc.Rank,
  tc.UserId,
  tc.DisplayName,
  tc.Reputation,
  tc.AcceptedAnswers,
  tc.DistinctBadges,
  qs.QuestionId,
  qs.Title,
  qs.AvgEditLagHours,
  qs.AvgCommentScore,
  qs.TotalComments,
  qs.MaxQuestionScore,
  rd.LinkCreated as DuplicateLinkedAt,
  rd.CloseReason as DuplicateCloseReason,
  (case 
     when qs.MaxQuestionScore > 100 then 'Legendary'
     when qs.MaxQuestionScore between 50 and 100 then 'Great'
     when qs.MaxQuestionScore between 10 and 49 then 'Good'
     else 'Average'
   end) as QuestionScoreLevel,
  (select string_agg(t.TagName, ', ') 
     from unnest(string_to_array(substring(qs.Title from '<(.*?)>'), '><')) x(tag)
     join Tags t on t.TagName = x.tag
  ) as AssociatedTags,
  -- Use windowed count over users' recent posts
  count(*) over (partition by tc.UserId order by qs.MaxQuestionScore desc rows between 0 preceding and 3 following) as TopPostWindow
from 
  TopContributors tc
  join QuestionStats qs on qs.OwnerUserId = tc.UserId
  left join RecentDuplicates rd on rd.PostId = qs.QuestionId
where 
  tc.Rank <= 100
  and (qs.AvgEditLagHours is not null or qs.AvgCommentScore > 0)
  and (qs.MaxQuestionScore is not null and qs.MaxQuestionScore > 0)
order by 
  tc.Rank, qs.MaxQuestionScore desc, qs.AvgEditLagHours
limit 200;