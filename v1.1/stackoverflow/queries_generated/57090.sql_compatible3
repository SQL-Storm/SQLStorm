WITH TopUsers AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpVotes,
        COUNT(b.Id) AS BadgeCount
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    GROUP BY
        u.Id, u.DisplayName, u.Reputation
    ORDER BY
        u.Reputation DESC
    LIMIT 100
),

UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(p.Id) AS TotalPosts,
        SUM(p.Score) AS TotalPostScore,
        COUNT(c.Id) AS TotalComments,
        COUNT(v.Id) AS TotalVotes,
        COUNT(ph.Id) AS TotalPostHistory,
        MAX(p.LastActivityDate) AS LastActivityDate
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    LEFT JOIN
        PostHistory ph ON u.Id = ph.UserId
    GROUP BY
        u.Id, u.DisplayName
),

-- Standard SQL compatible extraction of tags: split Tags string like '<tag1><tag2>' into rows
-- Implemented using a recursive CTE to avoid DB-specific regexp_split_to_table
PostTags AS (
    SELECT
        p.Id AS PostId,
        1 AS idx,
        CASE
            WHEN p.Tags IS NULL OR p.Tags = '' THEN NULL
            ELSE SUBSTR(p.Tags, 2,
                CASE
                    WHEN INSTR(SUBSTR(p.Tags, 2), '><') = 0 THEN LENGTH(p.Tags) - 2
                    ELSE INSTR(SUBSTR(p.Tags, 2), '><') - 1
                END
            )
        END AS TagName,
        CASE
            WHEN p.Tags IS NULL THEN ''
            ELSE p.Tags
        END AS Remaining
    FROM Posts p
    WHERE p.Tags IS NOT NULL AND p.Tags <> ''
    UNION ALL
    SELECT
        pt.PostId,
        pt.idx + 1,
        CASE
            WHEN INSTR(pt.Remaining, '><') = 0 THEN
                CASE WHEN LENGTH(pt.Remaining) > 2 THEN SUBSTR(pt.Remaining, 2, LENGTH(pt.Remaining)-2) ELSE NULL END
            ELSE
                SUBSTR(pt.Remaining, INSTR(pt.Remaining, '><') + 2,
                    CASE
                        WHEN INSTR(SUBSTR(pt.Remaining, INSTR(pt.Remaining, '><') + 2), '><') = 0 THEN LENGTH(pt.Remaining) - (INSTR(pt.Remaining, '><') + 1) - 1
                        ELSE INSTR(SUBSTR(pt.Remaining, INSTR(pt.Remaining, '><') + 2), '><') - 1
                    END
                )
        END AS TagName,
        CASE
            WHEN INSTR(pt.Remaining, '><') = 0 THEN ''
            ELSE SUBSTR(pt.Remaining, INSTR(pt.Remaining, '><') + 2)
        END AS Remaining
    FROM PostTags pt
    WHERE pt.Remaining IS NOT NULL AND pt.Remaining <> ''
),

TagStatistics AS (
    SELECT
        t.Id AS TagId,
        t.TagName,
        t.Count,
        COUNT(DISTINCT p.Id) AS PostsUsingTag,
        SUM(p.ViewCount) AS TotalViewCount,
        AVG(p.Score) AS AverageScore,
        COUNT(v.Id) AS TotalVotes
    FROM
        Tags t
    LEFT JOIN
        PostTags pt ON pt.TagName = t.TagName
    LEFT JOIN
        Posts p ON p.Id = pt.PostId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    GROUP BY
        t.Id, t.TagName, t.Count
    ORDER BY
        TotalViewCount
)

SELECT
    tu.UserId,
    tu.DisplayName,
    tu.Reputation,
    tu.PostCount,
    tu.TotalScore,
    tu.QuestionCount,
    tu.AnswerCount,
    ua.LastActivityDate,
    ua.TotalPosts,
    ua.TotalPostScore,
    ua.TotalComments,
    ua.TotalVotes,
    ua.TotalPostHistory,
    ts.TagName,
    ts.TotalVotes,
    ts.TotalViewCount,
    ts.Count,
    ts.PostsUsingTag
FROM
    TopUsers tu
JOIN
    UserActivity ua ON tu.UserId = ua.UserId
LEFT JOIN
    TagStatistics ts ON ts.TagId IN (
        SELECT t2.Id
        FROM Tags t2
        WHERE EXISTS (
            SELECT 1
            FROM PostTags pt2
            WHERE pt2.TagName = t2.TagName
        )
    )
WHERE
    tu.Reputation > 1000
ORDER BY
    tu.Reputation DESC,
    ts.TotalViewCount DESC;