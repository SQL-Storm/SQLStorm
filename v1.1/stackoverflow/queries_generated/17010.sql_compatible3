WITH user_activity_metrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS post_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS question_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answer_count,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) AS avg_post_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) FILTER (WHERE p.Score IS NOT NULL) AS median_post_score,
        SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS accepted_answers,
        EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - u.CreationDate))/86400 AS days_since_joined,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS reputation_rank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS activity_rank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Reputation > 100
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
tag_expertise AS (
    SELECT 
        p.OwnerUserId,
        unnest(string_to_array(substring(p.Tags FROM 2 FOR char_length(p.Tags)-2), '><')) AS tag_name,
        COUNT(*) AS tag_usage_count,
        SUM(p.Score) AS total_tag_score,
        MAX(p.Score) AS max_tag_score,
        STRING_AGG(CAST(p.Id AS VARCHAR), ',') AS top_post_ids
    FROM Posts p
    WHERE p.Tags IS NOT NULL 
        AND p.OwnerUserId IS NOT NULL
        AND p.PostTypeId IN (1, 2)
        AND p.Score > 0
    GROUP BY p.OwnerUserId, tag_name
),
badge_achievements AS (
    SELECT 
        b.UserId,
        COUNT(DISTINCT b.Name) AS unique_badges,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS gold_badges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS silver_badges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS bronze_badges,
        MAX(b.Date) AS last_badge_date,
        STRING_AGG(CASE WHEN b.Class = 1 THEN b.Name END, ', ') AS gold_badge_names,
        COALESCE(prev_month_badges, 0) AS prev_month_badges
    FROM Badges b
    LEFT JOIN LATERAL (
        SELECT COALESCE(LAG(month_count) OVER (ORDER BY mon), 0) AS prev_month_badges
        FROM (
            SELECT DATE_TRUNC('month', b2.Date) AS mon, COUNT(*) AS month_count
            FROM Badges b2
            WHERE b2.UserId = b.UserId
            GROUP BY DATE_TRUNC('month', b2.Date)
        ) months
        ORDER BY mon
        LIMIT 1
    ) pm ON true
    GROUP BY b.UserId, pm.prev_month_badges
),
recursive_comment_chains AS (
    WITH RECURSIVE comment_thread AS (
        SELECT 
            c.Id AS root_comment_id,
            c.PostId,
            c.UserId,
            c.CreationDate,
            1 AS depth,
            CAST(c.Id AS VARCHAR) AS path
        FROM Comments c
        WHERE c.UserId IS NOT NULL
        
        UNION ALL
        
        SELECT 
            ct.root_comment_id,
            c2.PostId,
            c2.UserId,
            c2.CreationDate,
            ct.depth + 1,
            ct.path || '->' || CAST(c2.Id AS VARCHAR)
        FROM comment_thread ct
        JOIN Comments c2 ON c2.PostId = ct.PostId 
            AND c2.CreationDate > ct.CreationDate
            AND c2.CreationDate < ct.CreationDate + INTERVAL '1 hour'
        WHERE ct.depth < 5
    )
    SELECT 
        UserId,
        COUNT(DISTINCT root_comment_id) AS comment_threads_started,
        MAX(depth) AS max_conversation_depth,
        AVG(depth) AS avg_conversation_depth
    FROM comment_thread
    GROUP BY UserId
)
SELECT 
    COALESCE(uam.DisplayName, 'Anonymous User #' || CAST(uam.Id AS VARCHAR)) AS user_display,
    uam.Reputation,
    uam.reputation_rank,
    uam.post_count,
    ROUND(uam.post_count / NULLIF(uam.days_since_joined, 0), 3) AS posts_per_day,
    uam.question_count || '/' || uam.answer_count AS Q_A_ratio,
    COALESCE(ROUND(CAST(uam.avg_post_score AS NUMERIC), 2), 0) AS avg_score,
    COALESCE(uam.median_post_score, 0) AS median_score,
    
    CASE 
        WHEN uam.accepted_answers > 10 THEN 'Expert Answerer'
        WHEN uam.question_count > uam.answer_count * 2 THEN 'Curious Questioner'
        WHEN uam.answer_count > uam.question_count * 3 THEN 'Helpful Responder'
        WHEN COALESCE(ba.gold_badges,0) > 5 THEN 'Gold Collector'
        WHEN uam.days_since_joined < 30 AND uam.Reputation > 1000 THEN 'Rising Star'
        ELSE 'Regular Contributor'
    END AS user_classification,
    
    COALESCE(ba.unique_badges, 0) || ' (' ||
    COALESCE(ba.gold_badges, 0) || 'G/' ||
    COALESCE(ba.silver_badges, 0) || 'S/' ||
    COALESCE(ba.bronze_badges, 0) || 'B)' AS badge_summary,
    
    LEFT(COALESCE(ba.gold_badge_names, 'None'), 100) AS gold_badges_earned,
    
    (
        SELECT STRING_AGG(te_sub.tag_name || ':' || CAST(te_sub.total_tag_score AS VARCHAR), ', ')
        FROM (
            SELECT te2.tag_name, te2.total_tag_score
            FROM tag_expertise te2
            WHERE te2.OwnerUserId = uam.Id
            ORDER BY te2.total_tag_score DESC, te2.tag_name
            LIMIT 5
        ) te_sub
    ) AS top_5_tags,
    
    COALESCE(rcc.max_conversation_depth, 0) AS deepest_conversation,
    ROUND(COALESCE(CAST(rcc.avg_conversation_depth AS NUMERIC), 1), 2) AS avg_conversation_depth,
    
    EXISTS (
        SELECT 1 
        FROM Posts p_check
        WHERE p_check.OwnerUserId = uam.Id
            AND p_check.Score >= 100
    ) AS has_century_post,
    
    (
        SELECT COUNT(DISTINCT v.PostId)
        FROM Votes v
        JOIN Posts vp ON v.PostId = vp.Id
        WHERE v.VoteTypeId = 2
            AND vp.OwnerUserId = uam.Id
            AND v.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
    ) AS recent_upvotes_received,
    
    CASE
        WHEN EXTRACT(DOW FROM CAST('2024-10-01 12:34:56' AS timestamp)) IN (0, 6) 
            AND uam.post_count > 100 
        THEN POWER(uam.Reputation, 0.5) * LN(GREATEST(uam.post_count, 1))
        ELSE NULL
    END AS weekend_impact_score,
    
    TRIM(BOTH ' ' FROM 
        REGEXP_REPLACE(
            COALESCE(
                SUBSTRING(u_location.Location FROM 1 FOR POSITION(',' IN u_location.Location || ',') - 1),
                u_location.Location,
                'Unknown'
            ),
            '[^A-Za-z0-9 ,\-]',
            '',
            'g'
        )
    ) AS cleaned_location

FROM user_activity_metrics uam
LEFT JOIN badge_achievements ba ON uam.Id = ba.UserId
LEFT JOIN recursive_comment_chains rcc ON uam.Id = rcc.UserId
LEFT JOIN LATERAL (
    SELECT u.Location
    FROM Users u
    WHERE u.Id = uam.Id
) u_location ON true
WHERE uam.reputation_rank <= 1000
    AND (
        uam.post_count > 10 
        OR COALESCE(ba.gold_badges,0) > 0
        OR uam.Reputation > 5000
    )
    AND NOT (
        uam.DisplayName IS NULL 
        AND uam.post_count = 0
    )
ORDER BY 
    CASE 
        WHEN COALESCE(ba.gold_badges,0) > 10 THEN 1
        WHEN uam.avg_post_score > 50 THEN 2
        WHEN uam.reputation_rank <= 100 THEN 3
        ELSE 4
    END,
    uam.Reputation DESC,
    COALESCE(ba.unique_badges, 0) DESC
LIMIT 100;