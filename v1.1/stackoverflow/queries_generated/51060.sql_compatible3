WITH 
user_activity AS (
    SELECT 
        u.Id AS user_id,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        u.Views,
        u.CreationDate AS user_creation_date,
        COUNT(DISTINCT p.Id) AS total_posts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS questions_asked,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS answers_given,
        SUM(p.Score) AS total_score,
        AVG(p.Score) AS avg_score,
        COUNT(DISTINCT ph.Id) AS total_edits,
        COUNT(DISTINCT v.Id) AS total_votes_received,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze_badges,
        MAX(p.LastActivityDate) AS last_activity_date,
        COUNT(DISTINCT c.Id) AS total_comments
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId IN (1, 2) AND p.DeletedDate IS NULL
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (4, 5, 6, 24)
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id, u.Reputation, u.UpVotes, u.DownVotes, u.Views, u.CreationDate
    HAVING COUNT(DISTINCT p.Id) > 0
),
question_answer_relations AS (
    SELECT 
        q.Id AS question_id,
        q.Title,
        q.Tags,
        q.CreationDate AS question_date,
        q.Score AS question_score,
        q.ViewCount,
        q.AnswerCount,
        q.FavoriteCount,
        (CASE WHEN q.ClosedDate IS NOT NULL THEN TRUE ELSE FALSE END) AS is_closed,
        COALESCE(aa.Id, 0) AS accepted_answer_id,
        aa.Score AS accepted_answer_score,
        a_count.total_answers,
        AVG(a.Score) AS avg_answer_score,
        MAX(a.LastActivityDate) AS last_answer_date,
        pl.duplicate_count,
        bounties.total_bounties AS bounty_amount_sum,
        ROW_NUMBER() OVER (PARTITION BY q.Id ORDER BY COALESCE(aa.Score, 0) DESC, a.Score DESC) AS rn
    FROM Posts q
    LEFT JOIN Posts aa ON q.AcceptedAnswerId = aa.Id AND aa.PostTypeId = 2
    LEFT JOIN (
        SELECT 
            ParentId,
            COUNT(*) AS total_answers,
            AVG(Score) AS avg_score,
            MAX(LastActivityDate) AS max_activity
        FROM Posts 
        WHERE PostTypeId = 2 AND DeletedDate IS NULL
        GROUP BY ParentId
    ) a_count ON q.Id = a_count.ParentId
    LEFT JOIN (
        SELECT 
            p1.PostId,
            COUNT(DISTINCT p2.Id) AS duplicate_count
        FROM PostLinks pl
        JOIN Posts p1 ON pl.PostId = p1.Id AND p1.PostTypeId = 1
        JOIN Posts p2 ON pl.RelatedPostId = p2.Id AND p2.PostTypeId = 1
        WHERE pl.LinkTypeId = 3
        GROUP BY p1.PostId
    ) pl ON q.Id = pl.PostId
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2 AND a.DeletedDate IS NULL
    LEFT JOIN (
        SELECT 
            PostId,
            SUM(BountyAmount) AS total_bounties
        FROM Votes 
        WHERE VoteTypeId IN (8, 9)
        GROUP BY PostId
    ) bounties ON q.Id = bounties.PostId
    WHERE q.PostTypeId = 1 
        AND q.DeletedDate IS NULL 
        AND q.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '1 year')
    GROUP BY q.Id, q.Title, q.Tags, q.CreationDate, q.Score, q.ViewCount, q.AnswerCount, 
             q.FavoriteCount, q.ClosedDate, aa.Id, aa.Score, a_count.total_answers, pl.duplicate_count, bounties.total_bounties
),
tag_analytics AS (
    SELECT 
        t.Id AS tag_id,
        t.TagName AS tag_name,
        t.Count AS tag_usage_count,
        COALESCE(tp.excerpt_count, 0) AS excerpt_posts,
        COALESCE(tp.wiki_count, 0) AS wiki_posts,
        AVG(qar.question_score) AS avg_question_score_for_tag,
        SUM(qar.total_answers) AS total_answers_for_tag,
        COUNT(DISTINCT qar.question_id) AS questions_with_tag,
        SUM(CASE WHEN qar.is_closed THEN 1 ELSE 0 END) AS closed_questions_with_tag,
        SUM(qar.bounty_amount_sum) AS total_bounties_for_tag,
        STRING_AGG(DISTINCT SUBSTRING(qar.Tags FROM 2 FOR CHAR_LENGTH(qar.Tags) - 2), ', ') AS associated_tags
    FROM Tags t
    LEFT JOIN (
        SELECT 
            p.Id,
            SUM(CASE WHEN p.PostTypeId = 4 THEN 1 ELSE 0 END) AS excerpt_count,
            SUM(CASE WHEN p.PostTypeId = 5 THEN 1 ELSE 0 END) AS wiki_count
        FROM Posts p 
        WHERE p.PostTypeId IN (4, 5)
        GROUP BY p.Id
    ) tp ON t.ExcerptPostId = tp.Id OR t.WikiPostId = tp.Id
    LEFT JOIN question_answer_relations qar ON qar.Tags LIKE '%' || t.TagName || '%'
    WHERE t.Count > 10
    GROUP BY t.Id, t.TagName, t.Count, tp.excerpt_count, tp.wiki_count
    HAVING COUNT(DISTINCT qar.question_id) > 5
)
SELECT 
    ua.user_id,
    ua.user_creation_date,
    ua.total_posts,
    ua.questions_asked,
    ua.answers_given,
    ua.total_score,
    ua.avg_score,
    ua.total_edits,
    ua.total_votes_received,
    (ua.gold_badges + ua.silver_badges + ua.bronze_badges) AS total_badges,
    ta.tag_name AS primary_tag,
    ta.avg_question_score_for_tag,
    qar.question_id,
    qar.Title AS top_question_title,
    qar.question_score,
    qar.total_answers,
    qar.avg_answer_score,
    qar.is_closed,
    qar.bounty_amount_sum AS question_bounty,
    RANK() OVER (PARTITION BY ta.tag_id ORDER BY ua.total_score DESC, ua.total_posts DESC) AS user_rank_in_tag,
    (ua.total_score * 1.5 + ua.total_posts * 2 + ua.total_comments * 0.5 + ua.gold_badges * 10 + ua.silver_badges * 5 + ua.bronze_badges * 2) AS engagement_score,
    (SELECT MAX(pc.CreationDate) 
     FROM PostHistory pc 
     WHERE pc.UserId = ua.user_id 
       AND pc.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '30 days')) AS recent_activity,
    (SELECT COUNT(*) * 1.0 / NULLIF(SUM(CASE WHEN v2.VoteTypeId = 3 THEN 1 ELSE 0 END), 0)
     FROM Votes v1
     LEFT JOIN Votes v2 ON v1.PostId = v2.PostId AND v2.VoteTypeId = 3
     WHERE v1.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = ua.user_id) 
       AND v1.VoteTypeId = 2) AS upvote_to_downvote_ratio,
    ARRAY_AGG(DISTINCT SUBSTRING(qar.Tags FROM 1 FOR 20)) OVER (PARTITION BY ua.user_id ORDER BY qar.question_date DESC ROWS BETWEEN 5 PRECEDING AND CURRENT ROW) AS recent_tags
FROM user_activity ua
JOIN Posts p_user ON ua.user_id = p_user.OwnerUserId AND p_user.PostTypeId = 1 AND p_user.Id = (
    SELECT Id FROM Posts 
    WHERE OwnerUserId = ua.user_id AND PostTypeId = 1 
    ORDER BY CreationDate DESC LIMIT 1
)
JOIN question_answer_relations qar ON p_user.Id = qar.question_id
JOIN (
    SELECT 
        SUBSTRING(p.Tags FROM 1 FOR POSITION('><' IN p.Tags) - 1) AS primary_tag,
        p.Id
    FROM Posts p 
    WHERE p.PostTypeId = 1 AND p.Tags LIKE '%><%'
) p ON p.Id = qar.question_id
JOIN tag_analytics ta ON p.primary_tag = ta.tag_name
LEFT JOIN Comments recent_comments ON qar.question_id = recent_comments.PostId 
    AND recent_comments.CreationDate = (
        SELECT MAX(CreationDate) FROM Comments WHERE PostId = qar.question_id
    )
WHERE ua.Reputation > 1000 
    AND qar.question_date >= (CAST('2024-10-01' AS date) - INTERVAL '6 months')
    AND ta.questions_with_tag > 50
    AND ua.answers_given > 10
GROUP BY ua.user_id, ua.user_creation_date, ua.total_posts, ua.questions_asked, 
         ua.answers_given, ua.total_score, ua.avg_score, ua.total_edits, ua.total_votes_received,
         ua.gold_badges, ua.silver_badges, ua.bronze_badges, ta.tag_name, ta.avg_question_score_for_tag,
         ta.tag_id, qar.question_id, qar.Title, qar.question_score, qar.total_answers, qar.avg_answer_score, 
         qar.is_closed, qar.bounty_amount_sum, qar.Tags, ua.total_comments
HAVING COUNT(DISTINCT qar.question_id) >= 3
ORDER BY engagement_score DESC, user_rank_in_tag ASC, qar.question_date DESC
LIMIT 1000;