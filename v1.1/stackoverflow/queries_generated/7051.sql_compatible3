WITH
Q AS (
  SELECT
    p.Id AS QuestionId,
    p.Title,
    p.CreationDate,
    p.Score,
    COALESCE(p.ViewCount,0) AS Views,
    COALESCE(p.AnswerCount,0) AS AnswerCount,
    COALESCE(p.FavoriteCount,0) AS Favorites,
    p.OwnerUserId,
    CASE WHEN p.Tags IS NULL OR p.Tags = '' THEN ARRAY[]::text[] -- leave array literal cast where needed (standard SQL lacks a direct replacement)
         ELSE string_to_array(substring(p.Tags FROM 2 FOR char_length(p.Tags)-2), '><')
    END AS TagArray
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '2 years'
),
U AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreated,
    COALESCE(u.Views,0) AS ProfileViews,
    COALESCE(u.UpVotes,0) AS UpVotes,
    COALESCE(u.DownVotes,0) AS DownVotes,
    (SELECT AVG(COALESCE(p.Score,0)) FROM Posts p WHERE p.OwnerUserId = u.Id ORDER BY p.CreationDate DESC LIMIT 3) AS AvgScoreLast3,
    SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
    SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
    SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
  FROM Users u
  LEFT JOIN Badges b ON b.UserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Views, u.UpVotes, u.DownVotes
),
A AS (
  SELECT
    a.Id AS AnswerId,
    a.ParentId AS QuestionId,
    a.OwnerUserId AS AnswererId,
    a.CreationDate AS AnswerDate,
    a.Score AS AnswerScore,
    a.CommentCount AS AnswerComments,
    row_number() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRankByScore,
    EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate)) AS SecondsToAnswer
  FROM Posts a
  LEFT JOIN Posts q ON q.Id = a.ParentId
  WHERE a.PostTypeId = 2
),
L AS (
  SELECT
    pl.PostId,
    SUM(CASE WHEN lt.Name = 'Linked' THEN 1 ELSE 0 END) AS NumLinked,
    SUM(CASE WHEN lt.Name = 'Duplicate' THEN 1 ELSE 0 END) AS NumDuplicates,
    MAX(pl.CreationDate) AS LastLinkDate
  FROM PostLinks pl
  LEFT JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
  GROUP BY pl.PostId
),
TagStats AS (
  SELECT
    t.TagName,
    t.Id AS TagId,
    SUM(q.Views) AS TotalViews,
    AVG(q.Score) AS AvgScore,
    COUNT(*) AS QuestionCount,
    MAX(q.CreationDate) AS MostRecentQuestion
  FROM Tags t
  JOIN Posts p ON p.Tags IS NOT NULL AND position('<' || t.TagName || '>' IN p.Tags) > 0 AND p.PostTypeId = 1
  JOIN Q q ON q.QuestionId = p.Id
  GROUP BY t.TagName, t.Id
  HAVING COUNT(*) > 5
),
V AS (
  SELECT
    q.QuestionId,
    COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END),0) AS UpVotes,
    COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END),0) AS DownVotes,
    COALESCE(SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END),0) AS Favorites,
    COALESCE(SUM(CASE WHEN v.VoteTypeId IN (8,9) THEN COALESCE(v.BountyAmount,0) ELSE 0 END),0) AS TotalBounty
  FROM Q q
  LEFT JOIN Votes v ON v.PostId = q.QuestionId
  GROUP BY q.QuestionId
),
Scored AS (
  SELECT
    q.QuestionId,
    q.Title,
    q.CreationDate,
    q.Score,
    q.Views,
    q.AnswerCount,
    q.Favorites,
    q.OwnerUserId,
    q.TagArray,
    COALESCE(v.UpVotes,0) AS VUp,
    COALESCE(v.DownVotes,0) AS VDown,
    COALESCE(l.NumLinked,0) AS NumLinked,
    COALESCE(l.NumDuplicates,0) AS NumDuplicates,
    COALESCE(u.Reputation, 0) AS OwnerReputation,
    COALESCE(u.AvgScoreLast3, 0) AS OwnerAvgScore3,
    (SELECT COUNT(DISTINCT tg) FROM unnest(q.TagArray) AS tg) AS TagCount,
    (SELECT SUM(ts.TotalViews) FROM TagStats ts WHERE ts.TagName = ANY(q.TagArray)) AS SumTagViews,
    (
      GREATEST(1, LOG(GREATEST(1,q.Views)) * 1.2 + q.Score * 3)
      * (1 + LEAST(2, COALESCE(u.Reputation,0) / NULLIF(GREATEST(100, u.Reputation),0) * 0.01))
      + (q.AnswerCount * 5)
      + (COALESCE(v.Favorites,0) * 4)
      + COALESCE(LOG(GREATEST(1, (SELECT COALESCE(SUM(ts.TotalViews),0) FROM TagStats ts WHERE ts.TagName = ANY(q.TagArray))), 10), 0) * 2
      - GREATEST(0, COALESCE(l.NumDuplicates,0) * 10)
    ) AS CompositeScore
  FROM Q q
  LEFT JOIN V v ON v.QuestionId = q.QuestionId
  LEFT JOIN L l ON l.PostId = q.QuestionId
  LEFT JOIN Users u ON u.Id = q.OwnerUserId
),
TopPerTag AS (
  SELECT
    ts.TagName,
    s.QuestionId,
    s.Title,
    s.CreationDate,
    s.Views,
    s.Score,
    s.AnswerCount,
    s.CompositeScore,
    s.TagCount,
    s.SumTagViews,
    u.DisplayName AS OwnerName,
    a_top.AnswerId,
    a_top.AnswerScore,
    a_top.SecondsToAnswer,
    COALESCE(
      (SELECT substring(c.Text FROM 1 FOR 200) FROM Comments c WHERE c.PostId = s.QuestionId ORDER BY c.CreationDate DESC LIMIT 1),
      '<<no comments>>'
    ) AS LatestCommentSnippet,
    row_number() OVER (PARTITION BY ts.TagName ORDER BY s.CompositeScore DESC, s.CreationDate DESC) AS RankInTag
  FROM TagStats ts
  JOIN Scored s ON EXISTS (
    SELECT 1 FROM unnest(s.TagArray) AS tt WHERE tt = ts.TagName
  )
  LEFT JOIN Users u ON u.Id = s.OwnerUserId
  LEFT JOIN LATERAL (
    SELECT a.AnswerId, a.AnswerScore, a.SecondsToAnswer, a.AnswerDate
    FROM A a
    WHERE a.QuestionId = s.QuestionId
    ORDER BY a.AnswerScore DESC, a.AnswerDate ASC
    LIMIT 1
  ) a_top ON TRUE
),
GlobalHighBounty AS (
  SELECT
    '(GlobalHighBounty)' AS TagName,
    0 AS RankInTag,
    q2.QuestionId,
    q2.Title,
    q2.CreationDate,
    q2.Views,
    q2.Score,
    q2.AnswerCount,
    q2.CompositeScore,
    q2.TagCount,
    q2.SumTagViews,
    u2.DisplayName AS OwnerName,
    at.AnswerId,
    at.AnswerScore,
    at.SecondsToAnswer,
    COALESCE((SELECT substring(c.Text FROM 1 FOR 120) FROM Comments c WHERE c.PostId = q2.QuestionId ORDER BY c.CreationDate DESC LIMIT 1), '<<no comments>>') AS LatestCommentSnippet
  FROM Scored q2
  LEFT JOIN Users u2 ON u2.Id = q2.OwnerUserId
  LEFT JOIN LATERAL (
    SELECT a.AnswerId, a.AnswerScore, a.SecondsToAnswer, a.AnswerDate
    FROM A a
    WHERE a.QuestionId = q2.QuestionId
    ORDER BY a.AnswerScore DESC, a.AnswerDate ASC
    LIMIT 1
  ) at ON TRUE
  WHERE q2.QuestionId IN (
    SELECT v.PostId FROM Votes v WHERE v.VoteTypeId IN (8,9) AND v.BountyAmount IS NOT NULL
  )
  ORDER BY q2.CompositeScore DESC
  LIMIT 10
),
RecentDuplicates AS (
  SELECT
    '(RecentDuplicates)' AS TagName,
    0 AS RankInTag,
    ph.PostId AS QuestionId,
    p.Title,
    p.CreationDate,
    COALESCE(p.ViewCount,0) AS Views,
    p.Score,
    p.AnswerCount,
    0.0 AS CompositeScore,
    0 AS TagCount,
    0 AS SumTagViews,
    u3.DisplayName AS OwnerName,
    CAST(NULL AS bigint) AS AnswerId,
    CAST(NULL AS numeric) AS AnswerScore,
    CAST(NULL AS numeric) AS SecondsToAnswer,
    COALESCE(ph.Comment, 'duplicate') AS LatestCommentSnippet,
    ph.CreationDate AS phCreationDate
  FROM PostHistory ph
  JOIN PostHistoryTypes pht ON pht.Id = ph.PostHistoryTypeId
  JOIN Posts p ON p.Id = ph.PostId
  LEFT JOIN Users u3 ON u3.Id = ph.UserId
  WHERE ph.PostHistoryTypeId = 10
    AND ph.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
    AND EXISTS (
      SELECT 1 FROM PostLinks pl WHERE pl.PostId = ph.PostId AND pl.LinkTypeId = (SELECT Id FROM LinkTypes WHERE Name = 'Duplicate' LIMIT 1)
    )
  ORDER BY ph.CreationDate DESC
  LIMIT 5
)

SELECT
  t.TagName,
  t.RankInTag,
  t.QuestionId,
  t.Title,
  t.CreationDate,
  t.Views,
  t.Score,
  t.AnswerCount,
  t.CompositeScore,
  t.TagCount,
  t.SumTagViews,
  t.OwnerName,
  t.AnswerId,
  t.AnswerScore,
  t.SecondsToAnswer,
  t.LatestCommentSnippet
FROM TopPerTag t
WHERE t.RankInTag <= 3

UNION ALL

SELECT
  g.TagName,
  g.RankInTag,
  g.QuestionId,
  g.Title,
  g.CreationDate,
  g.Views,
  g.Score,
  g.AnswerCount,
  g.CompositeScore,
  g.TagCount,
  g.SumTagViews,
  g.OwnerName,
  g.AnswerId,
  g.AnswerScore,
  g.SecondsToAnswer,
  g.LatestCommentSnippet
FROM GlobalHighBounty g

UNION ALL

SELECT
  r.TagName,
  r.RankInTag,
  r.QuestionId,
  r.Title,
  r.CreationDate,
  r.Views,
  r.Score,
  r.AnswerCount,
  r.CompositeScore,
  r.TagCount,
  r.SumTagViews,
  r.OwnerName,
  r.AnswerId,
  r.AnswerScore,
  r.SecondsToAnswer,
  r.LatestCommentSnippet
FROM RecentDuplicates r

ORDER BY TagName NULLS LAST, RankInTag, CompositeScore DESC, Views DESC;