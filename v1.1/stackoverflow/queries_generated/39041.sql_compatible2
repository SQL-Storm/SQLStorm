WITH user_stats AS (
    SELECT
        u.Id                      AS user_id,
        u.DisplayName             AS display_name,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS questions_count,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS answers_count,
        AVG(p.Score)              AS average_post_score,
        COALESCE(v.total_votes, 0) AS total_votes_received
    FROM Users u
    LEFT JOIN Posts p
        ON p.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT
            p.OwnerUserId AS uid,
            COUNT(*)       AS total_votes
        FROM Votes v
        JOIN VoteTypes vt
          ON v.VoteTypeId = vt.Id
        JOIN Posts p
          ON p.Id = v.PostId
        WHERE vt.Name IN ('UpMod','DownMod')
        GROUP BY p.OwnerUserId
    ) v
      ON v.uid = u.Id
    GROUP BY u.Id, u.DisplayName, v.total_votes
),
top_tags AS (
    SELECT
        tagname           AS TagName,
        COUNT(*)          AS question_count,
        AVG(p.Score)      AS avg_score,
        ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS rn
    FROM Posts p
    JOIN LATERAL (
        SELECT unnest(
            string_to_array(
                substring(p.Tags, 2, length(p.Tags) - 2),
                '><'
            )
        ) AS tagname
    ) split_tags ON TRUE
    WHERE p.PostTypeId = 1
    GROUP BY tagname
),
badge_summary AS (
    SELECT
        UserId,
        SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS gold_badges,
        SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS silver_badges,
        SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS bronze_badges
    FROM Badges
    GROUP BY UserId
),
top_five_tags AS (
    SELECT TagName, question_count, avg_score, rn
    FROM top_tags
    WHERE rn <= 5
)
SELECT
    us.user_id,
    us.display_name,
    us.questions_count,
    us.answers_count,
    us.average_post_score,
    us.total_votes_received,
    COALESCE(bs.gold_badges,0)   AS gold_badges,
    COALESCE(bs.silver_badges,0) AS silver_badges,
    COALESCE(bs.bronze_badges,0) AS bronze_badges,
    JSON_AGG(
      JSON_BUILD_OBJECT(
        'tag', tf.TagName,
        'questions', tf.question_count,
        'avg_score', tf.avg_score
      )
      ORDER BY tf.question_count DESC
    ) AS top_five_tags,
    COUNT(c.Id) FILTER (WHERE c.Score >= 5) AS high_score_comments
FROM user_stats us
LEFT JOIN badge_summary bs
  ON bs.UserId = us.user_id
LEFT JOIN Comments c
  ON c.UserId = us.user_id
CROSS JOIN top_five_tags tf
WHERE us.answers_count > 100
GROUP BY
    us.user_id,
    us.display_name,
    us.questions_count,
    us.answers_count,
    us.average_post_score,
    us.total_votes_received,
    bs.gold_badges,
    bs.silver_badges,
    bs.bronze_badges,
    tf.TagName,
    tf.question_count,
    tf.avg_score,
    tf.rn
ORDER BY us.average_post_score DESC
LIMIT 50;