-- {"query": "37014.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-5-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 1985, "output_tokens": 1924} 
WITH
-- recent active questions with tag arrays and derived metrics
Questions AS (
  SELECT
    p.Id,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.OwnerUserId,
    p.Tags,
    -- normalize tags into one row per tag (Postgres syntax assumed)
    regexp_split_to_table(substring(p.Tags, 2, char_length(p.Tags)-2), '><') AS Tag
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
),
-- compute per-question aggregates: top answer score, accepted answer age, distinct voters count, comment sentiment proxy (length)
QuestionAgg AS (
  SELECT
    q.*,
    COALESCE(MAX(a.Score) FILTER (WHERE a.PostTypeId = 2), 0) AS TopAnswerScore,
    CASE WHEN q.AcceptedAnswerId IS NOT NULL THEN EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate)) END AS AcceptedAnswerSeconds,
    COALESCE(SUM(v_count.voters), 0) AS DistinctVoterCount,
    COALESCE(SUM(char_length(coalesce(c.Text, ''))),0) AS CommentsTextLengthSum
  FROM
    (SELECT DISTINCT ON (Id) * FROM Questions) q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN (
      SELECT PostId, COUNT(DISTINCT UserId) AS voters
      FROM Votes
      WHERE UserId IS NOT NULL
      GROUP BY PostId
    ) v_count ON v_count.PostId = q.Id
    LEFT JOIN Comments c ON c.PostId = q.Id
  GROUP BY q.Id, q.Title, q.CreationDate, q.Score, q.ViewCount, q.AnswerCount, q.CommentCount, q.FavoriteCount, q.OwnerUserId, q.Tags, q.Tag, q.AcceptedAnswerId
),
-- user-level features for owners
OwnerFeatures AS (
  SELECT
    u.Id AS OwnerUserId,
    u.Reputation,
    u.CreationDate AS UserSince,
    u.Views AS UserViews,
    u.UpVotes,
    u.DownVotes,
    COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
    COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
    COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
    MAX(b.Date) AS LastBadgeDate
  FROM Users u
  LEFT JOIN Badges b ON b.UserId = u.Id
  GROUP BY u.Id, u.Reputation, u.CreationDate, u.Views, u.UpVotes, u.DownVotes
),
-- tag popularity/time trends: for each tag, rolling 30-day counts and median score of questions
TagTrends AS (
  SELECT
    Tag,
    date_trunc('day', q.CreationDate) AS Day,
    COUNT(*) AS QuestionsPerDay,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY q.Score) AS MedianScorePerDay
  FROM Questions q
  GROUP BY Tag, date_trunc('day', q.CreationDate)
),
-- tag-level summary over the 2-year window
TagSummary AS (
  SELECT
    Tag,
    COUNT(*) AS TotalQuestions,
    SUM(ViewCount) AS TotalViews,
    AVG(Score) AS AvgScore,
    MAX(QuestionsPerDay) FILTER (WHERE Day >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days') AS MaxDailyQ_90d,
    (SELECT AVG(QuestionsPerDay) FROM TagTrends tt WHERE tt.Tag = ts.Tag AND tt.Day >= date_trunc('day', cast('2024-10-01 12:34:56' as timestamp) - interval '30 days')) AS AvgDaily_30d
  FROM Questions q
  LEFT JOIN TagTrends ts ON ts.Tag = q.Tag
  GROUP BY Tag
  HAVING COUNT(*) >= 50
),
-- compute post link graph centrality proxies (in-degree and out-degree, duplicate link ratio)
LinkGraph AS (
  SELECT
    p.Id AS QuestionId,
    COALESCE(inlinks.in_deg,0) AS InLinks,
    COALESCE(outlinks.out_deg,0) AS OutLinks,
    COALESCE(dup_links.dup_count,0) AS DuplicateLinks
  FROM Posts p
  LEFT JOIN (
    SELECT RelatedPostId, COUNT(*) AS in_deg
    FROM PostLinks
    GROUP BY RelatedPostId
  ) inlinks ON inlinks.RelatedPostId = p.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) AS out_deg
    FROM PostLinks
    GROUP BY PostId
  ) outlinks ON outlinks.PostId = p.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) FILTER (WHERE LinkTypeId = 3) AS dup_count
    FROM PostLinks
    GROUP BY PostId
  ) dup_links ON dup_links.PostId = p.Id
  WHERE p.PostTypeId = 1
),
-- heavy join combining question aggregates, owner features, link graph and tag summary for benchmarking complex joins and window functions
Combined AS (
  SELECT
    qa.Id AS QuestionId,
    qa.Title,
    qa.CreationDate,
    qa.Score,
    qa.ViewCount,
    qa.AnswerCount,
    qa.CommentCount,
    qa.FavoriteCount,
    qa.Tag,
    qa.TopAnswerScore,
    qa.AcceptedAnswerSeconds,
    qa.DistinctVoterCount,
    qa.CommentsTextLengthSum,
    ofe.Reputation AS OwnerReputation,
    ofe.GoldBadges, ofe.SilverBadges, ofe.BronzeBadges,
    lg.InLinks, lg.OutLinks, lg.DuplicateLinks,
    ts.TotalQuestions AS TagTotalQuestions,
    ts.TotalViews AS TagTotalViews,
    ts.AvgScore AS TagAvgScore,
    ts.AvgDaily_30d AS TagAvgDaily30d,
    -- recency-weighted popularity score
    (qa.Score * 1.0) * LOG(GREATEST(qa.ViewCount,1) + 10) / GREATEST(EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - qa.CreationDate))/86400 + 1, 1) AS RecencyPopularity,
    -- windowed rank per tag by recency-popularity
    RANK() OVER (PARTITION BY qa.Tag ORDER BY (qa.Score * 1.0) * LOG(GREATEST(qa.ViewCount,1) + 10) / GREATEST(EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - qa.CreationDate))/86400 + 1, 1) DESC) AS TagRankByRecencyPop
  FROM QuestionAgg qa
  LEFT JOIN OwnerFeatures ofe ON ofe.OwnerUserId = qa.OwnerUserId
  LEFT JOIN LinkGraph lg ON lg.QuestionId = qa.Id
  LEFT JOIN TagSummary ts ON ts.Tag = qa.Tag
),
-- select a complex sample: top N per tag with derived percentiles and correlated subqueries
FinalSelection AS (
  SELECT
    c.*,
    -- percentile of top answer score within tag
    (SELECT PERCENT_RANK() OVER (ORDER BY sub.TopAnswerScore) FROM Combined sub WHERE sub.Tag = c.Tag AND sub.QuestionId = c.QuestionId) AS TopAnswerScorePercentRank,
    -- correlate tag growth: change in avg daily questions 30d vs overall average per tag
    CASE WHEN c.TagAvgDaily30d IS NOT NULL AND c.TagTotalQuestions IS NOT NULL THEN c.TagAvgDaily30d / GREATEST(c.TagTotalQuestions::numeric / 730.0, 1e-6) ELSE NULL END AS TagGrowthRatio,
    -- estimated engagement index
    (c.RecencyPopularity * (1 + LEAST(c.DistinctVoterCount::numeric / GREATEST(c.CommentCount,1), 5))) + (COALESCE(c.TopAnswerScore,0) * 2) + (COALESCE(c.OwnerReputation,0) / 1000.0) AS EngagementIndex
  FROM Combined c
)
SELECT
  QuestionId,
  Title,
  Tag,
  CreationDate,
  Score,
  ViewCount,
  AnswerCount,
  CommentCount,
  FavoriteCount,
  TopAnswerScore,
  AcceptedAnswerSeconds,
  DistinctVoterCount,
  CommentsTextLengthSum,
  OwnerReputation,
  GoldBadges, SilverBadges, BronzeBadges,
  InLinks, OutLinks, DuplicateLinks,
  TagTotalQuestions, TagTotalViews, TagAvgScore, TagAvgDaily30d,
  RecencyPopularity,
  TagRankByRecencyPop,
  TopAnswerScorePercentRank,
  TagGrowthRatio,
  EngagementIndex
FROM FinalSelection
WHERE TagRankByRecencyPop <= 5
  AND TagTotalQuestions IS NOT NULL
ORDER BY Tag, EngagementIndex DESC NULLS LAST
LIMIT 100;