WITH UserQuestionStats AS (
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(p.Id) AS QuestionCount,
        SUM(p.Score) AS TotalQuestionScore,
        AVG(p.Score) AS AvgQuestionScore,
        SUM(p.ViewCount) AS TotalQuestionViews,
        COUNT(DISTINCT ph_closed.PostId) AS UniqueClosedQuestions,
        COUNT(DISTINCT ph_reopened.PostId) AS UniqueReopenedQuestions,
        COUNT(DISTINCT pl_linked.RelatedPostId) AS QuestionsReferencedAsLinked,
        COUNT(DISTINCT pl_duplicate.RelatedPostId) AS QuestionsReferencedAsDuplicate
    FROM Posts p
    LEFT JOIN PostHistory ph_closed ON p.Id = ph_closed.PostId AND ph_closed.PostHistoryTypeId = 10
    LEFT JOIN PostHistory ph_reopened ON p.Id = ph_reopened.PostId AND ph_reopened.PostHistoryTypeId = 11
    LEFT JOIN PostLinks pl_linked ON p.Id = pl_linked.PostId AND pl_linked.LinkTypeId = 1
    LEFT JOIN PostLinks pl_duplicate ON p.Id = pl_duplicate.PostId AND pl_duplicate.LinkTypeId = 3
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= DATE '2024-10-01' - INTERVAL '3' YEAR
      AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
    HAVING COUNT(p.Id) >= 5
),
UserAnswerStats AS (
    SELECT
        a.OwnerUserId AS UserId,
        COUNT(a.Id) AS AnswerCount,
        SUM(a.Score) AS TotalAnswerScore,
        AVG(a.Score) AS AvgAnswerScore,
        COUNT(CASE WHEN a.Id = q.AcceptedAnswerId THEN 1 ELSE NULL END) AS AcceptedAnswerCount
    FROM Posts a
    JOIN Posts q ON a.ParentId = q.Id
    WHERE a.PostTypeId = 2
      AND a.CreationDate >= DATE '2024-10-01' - INTERVAL '3' YEAR
      AND a.OwnerUserId IS NOT NULL
    GROUP BY a.OwnerUserId
    HAVING COUNT(a.Id) >= 10
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 ELSE NULL END) AS GoldBadgeCount,
        COUNT(CASE WHEN b.Class = 2 THEN 1 ELSE NULL END) AS SilverBadgeCount,
        COUNT(b.Id) AS TotalBadges
    FROM Badges b
    WHERE b.Date >= DATE '2024-10-01' - INTERVAL '3' YEAR
    GROUP BY b.UserId
),
UserCommentActivity AS (
    SELECT
        c.UserId,
        COUNT(c.Id) AS TotalCommentsMade,
        SUM(c.Score) AS TotalCommentScore
    FROM Comments c
    WHERE c.CreationDate >= DATE '2024-10-01' - INTERVAL '3' YEAR
      AND c.UserId IS NOT NULL
    GROUP BY c.UserId
),
UserHistoryEngagement AS (
    SELECT
        ph.UserId,
        COUNT(ph.Id) AS TotalHistoryEntries,
        COUNT(CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9, 24, 33, 34) THEN 1 ELSE NULL END) AS SignificantEditOrModerationCount,
        COUNT(DISTINCT ph.PostId) AS UniquePostsEdited
    FROM PostHistory ph
    WHERE ph.CreationDate >= DATE '2024-10-01' - INTERVAL '3' YEAR
      AND ph.UserId IS NOT NULL
      AND ph.PostHistoryTypeId NOT IN (1, 2, 3, 16, 50, 52, 53, 66)
    GROUP BY ph.UserId
),
UserTagContributions AS (
    SELECT
        u.Id AS UserId,
        STRING_AGG(DISTINCT tag_name, ',') AS TopQuestionTags
    FROM Users u
    JOIN Posts p ON u.Id = p.OwnerUserId
    CROSS JOIN LATERAL (
        SELECT TRIM(value) AS tag_name
        FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS t(value)
        WHERE p.Tags IS NOT NULL AND CHAR_LENGTH(p.Tags) > 2
    ) AS parsed_tags
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= DATE '2024-10-01' - INTERVAL '3' YEAR
    GROUP BY u.Id
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    COALESCE(uqs.QuestionCount, 0) AS TotalQuestionsAsked,
    COALESCE(uqs.TotalQuestionScore, 0) AS TotalQuestionScore,
    COALESCE(uqs.AvgQuestionScore, 0.0) AS AverageQuestionScore,
    COALESCE(uas.AnswerCount, 0) AS TotalAnswersGiven,
    COALESCE(uas.TotalAnswerScore, 0) AS TotalAnswerScore,
    COALESCE(uas.AvgAnswerScore, 0.0) AS AverageAnswerScore,
    COALESCE(uas.AcceptedAnswerCount, 0) AS AcceptedAnswersCount,
    COALESCE(ubs.GoldBadgeCount, 0) AS GoldBadges,
    COALESCE(ubs.SilverBadgeCount, 0) AS SilverBadges,
    COALESCE(uca.TotalCommentsMade, 0) AS TotalCommentsMade,
    COALESCE(uca.TotalCommentScore, 0) AS TotalCommentScore,
    COALESCE(uhe.SignificantEditOrModerationCount, 0) AS TotalSignificantEdits,
    COALESCE(uhe.UniquePostsEdited, 0) AS UniquePostsWithEdits,
    COALESCE(uqs.UniqueClosedQuestions, 0) AS QuestionsClosed,
    COALESCE(uqs.UniqueReopenedQuestions, 0) AS QuestionsReopened,
    COALESCE(uqs.QuestionsReferencedAsLinked, 0) AS QuestionsLinkedByOthers,
    COALESCE(uqs.QuestionsReferencedAsDuplicate, 0) AS QuestionsMarkedAsDuplicateSource,
    utc.TopQuestionTags,
    (
        u.Reputation * 0.05 +
        COALESCE(uqs.AvgQuestionScore * 2.0, 0) +
        COALESCE(uas.AvgAnswerScore * 1.5, 0) +
        COALESCE(uas.AcceptedAnswerCount * 10.0, 0) +
        COALESCE(ubs.GoldBadgeCount * 100.0, 0) +
        COALESCE(ubs.SilverBadgeCount * 50.0, 0) +
        COALESCE(uca.TotalCommentsMade * 0.1, 0) +
        COALESCE(uhe.SignificantEditOrModerationCount * 0.2, 0) +
        COALESCE(uqs.UniqueReopenedQuestions * 20.0, 0) -
        COALESCE(uqs.UniqueClosedQuestions * 5.0, 0) +
        COALESCE(uqs.QuestionsReferencedAsLinked * 3.0, 0) -
        COALESCE(uqs.QuestionsReferencedAsDuplicate * 7.0, 0)
    ) AS UserInfluenceScore,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.CreationDate) AS ReputationRank
FROM Users u
INNER JOIN UserQuestionStats uqs ON u.Id = uqs.UserId
INNER JOIN UserAnswerStats uas ON u.Id = uas.UserId
LEFT JOIN UserBadgeSummary ubs ON u.Id = ubs.UserId
LEFT JOIN UserCommentActivity uca ON u.Id = uca.UserId
LEFT JOIN UserHistoryEngagement uhe ON u.Id = uhe.UserId
LEFT JOIN UserTagContributions utc ON u.Id = utc.UserId
WHERE u.Reputation > 5000
  AND u.LastAccessDate >= DATE '2024-10-01' - INTERVAL '3' YEAR
  AND (COALESCE(ubs.GoldBadgeCount, 0) > 0 OR COALESCE(ubs.SilverBadgeCount, 0) > 0)
ORDER BY UserInfluenceScore DESC, u.Reputation DESC
FETCH FIRST 100 ROWS ONLY;