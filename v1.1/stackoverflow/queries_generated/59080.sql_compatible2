SELECT 
    p.Id as PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    u.DisplayName as OwnerDisplayName,
    u.Reputation,
    COUNT(c.Id) as CommentCount,
    COUNT(v.Id) as VoteCount,
    COUNT(ph.Id) as HistoryCount,
    STRING_AGG(DISTINCT t.TagName, ', ') as Tags,
    CASE 
        WHEN p.PostTypeId = 1 THEN 'Question'
        WHEN p.PostTypeId = 2 THEN 'Answer'
        WHEN p.PostTypeId = 3 THEN 'Wiki'
        ELSE 'Other'
    END as PostType,
    CASE 
        WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
        WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
        WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Answer Accepted'
        ELSE 'Open'
    END as PostStatus,
    DATE_PART('day', CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate) as DaysSinceCreation,
    COALESCE(p.AnswerCount, 0) as AnswerCount,
    COALESCE(p.FavoriteCount, 0) as FavoriteCount,
    (SELECT COUNT(*) FROM Posts pp WHERE pp.ParentId = p.Id AND pp.PostTypeId = 2 AND pp.Score > 0) as PositiveAnswersCount,
    (SELECT COUNT(*) FROM Posts pp WHERE pp.ParentId = p.Id AND pp.PostTypeId = 2 AND pp.Score < 0) as NegativeAnswersCount,
    (SELECT AVG(pp.Score) FROM Posts pp WHERE pp.ParentId = p.Id AND pp.PostTypeId = 2) as AvgAnswerScore,
    (SELECT MAX(pp.Score) FROM Posts pp WHERE pp.ParentId = p.Id AND pp.PostTypeId = 2) as MaxAnswerScore,
    (SELECT MIN(pp.Score) FROM Posts pp WHERE pp.ParentId = p.Id AND pp.PostTypeId = 2) as MinAnswerScore,
    (SELECT COUNT(*) FROM Votes vv WHERE vv.PostId = p.Id AND vv.VoteTypeId IN (2,3)) as UpDownVotes,
    (SELECT COUNT(*) FROM Votes vv WHERE vv.PostId = p.Id AND vv.VoteTypeId = 5) as FavoriteCount,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Date >= p.CreationDate) as BadgesSincePost,
    (SELECT COUNT(*) FROM Posts pp WHERE pp.OwnerUserId = u.Id) as TotalPostsByUser,
    (SELECT COUNT(*) FROM Posts pp WHERE pp.OwnerUserId = u.Id AND pp.PostTypeId = 1) as QuestionsByUser,
    (SELECT COUNT(*) FROM Posts pp WHERE pp.OwnerUserId = u.Id AND pp.PostTypeId = 2) as AnswersByUser,
    (SELECT AVG(pp.Score) FROM Posts pp WHERE pp.OwnerUserId = u.Id AND pp.PostTypeId = 1) as AvgQuestionScore,
    (SELECT AVG(pp.Score) FROM Posts pp WHERE pp.OwnerUserId = u.Id AND pp.PostTypeId = 2) as AvgAnswerScore,
    (SELECT COUNT(*) FROM Comments cc WHERE cc.UserId = u.Id) as TotalCommentsByUser,
    (SELECT COUNT(*) FROM Comments cc WHERE cc.UserId = u.Id AND cc.PostId IN (SELECT ppp.Id FROM Posts ppp WHERE ppp.OwnerUserId = u.Id)) as CommentsOnOwnPosts,
    (SELECT COUNT(*) FROM PostHistory ph2 WHERE ph2.UserId = u.Id AND ph2.PostId = p.Id) as UserPostEdits,
    (SELECT COUNT(*) FROM PostHistory ph3 WHERE ph3.PostId = p.Id AND ph3.PostHistoryTypeId IN (1,2,3,4,5,6)) as PostEdits,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id OR pl.RelatedPostId = p.Id) as RelatedLinks,
    (SELECT COUNT(*) FROM PostLinks pl2 WHERE pl2.PostId = p.Id AND pl2.LinkTypeId = 3) as DuplicateLinks,
    (SELECT COUNT(*) FROM PostLinks pl3 WHERE pl3.PostId = p.Id AND pl3.LinkTypeId = 1) as LinkedPosts,
    (SELECT STRING_AGG(sub.Name, ', ') FROM (
        SELECT b2.Name as Name, b2.Date FROM Badges b2
        WHERE b2.UserId = u.Id 
          AND b2.Date >= p.CreationDate 
          AND b2.Date <= (p.CreationDate + INTERVAL '30 day')
        ORDER BY b2.Date
    ) sub) as BadgesInFirstMonth,
    (SELECT COUNT(*) FROM Votes vv2 WHERE vv2.PostId = p.Id AND vv2.VoteTypeId IN (8,9)) as BountyVotes,
    (SELECT COUNT(*) FROM Votes vv3 WHERE vv3.PostId = p.Id AND vv3.VoteTypeId = 8) as BountyStarts,
    (SELECT COUNT(*) FROM Votes vv4 WHERE vv4.PostId = p.Id AND vv4.VoteTypeId = 9) as BountyCloses,
    (SELECT COUNT(*) FROM Votes vv5 WHERE vv5.PostId = p.Id AND vv5.VoteTypeId = 10) as Deletions,
    (SELECT COUNT(*) FROM Votes vv6 WHERE vv6.PostId = p.Id AND vv6.VoteTypeId = 11) as Undeletions,
    (SELECT COUNT(*) FROM Votes vv7 WHERE vv7.PostId = p.Id AND vv7.VoteTypeId = 12) as SpamVotes
FROM Posts p
INNER JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Comments c ON p.Id = c.PostId
LEFT JOIN Votes v ON p.Id = v.PostId
LEFT JOIN PostHistory ph ON p.Id = ph.PostId
LEFT JOIN (
    SELECT p2.Id AS PostId, tagvals.tag AS TagName
    FROM Posts p2,
    LATERAL (
        SELECT UNNEST(string_to_array(SUBSTRING(p2.Tags FROM 2 FOR (CHAR_LENGTH(p2.Tags)-2)), '><')) AS tag
    ) AS tagvals
) t ON p.Id = t.PostId
WHERE p.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '5 year')
    AND p.PostTypeId IN (1,2)
    AND p.Score >= 0
    AND u.Reputation > 1000
GROUP BY 
    p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, 
    u.DisplayName, u.Reputation, p.PostTypeId,
    p.ClosedDate, p.CommunityOwnedDate, p.AcceptedAnswerId,
    p.AnswerCount, p.FavoriteCount
HAVING 
    COUNT(c.Id) >= 0
    AND COUNT(v.Id) >= 0
    AND COUNT(ph.Id) >= 0
ORDER BY 
    p.Score DESC,
    p.ViewCount DESC,
    p.CreationDate DESC
FETCH FIRST 1000 ROWS ONLY;