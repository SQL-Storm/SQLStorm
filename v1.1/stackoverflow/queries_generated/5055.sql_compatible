WITH
    RecentHighRepUsers AS (
        SELECT
            u.Id AS UserId,
            u.DisplayName,
            u.Reputation,
            u.CreationDate
        FROM Users u
        WHERE u.Reputation > (
            SELECT AVG(Reputation) FROM Users
        ) AND u.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '2 years'
    ),
    PostsWithMostComments AS (
        SELECT
            p.Id AS PostId,
            p.OwnerUserId,
            COUNT(c.Id) AS CommentCount
        FROM Posts p
        LEFT JOIN Comments c ON c.PostId = p.Id
        WHERE p.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
        GROUP BY p.Id, p.OwnerUserId
        HAVING COUNT(c.Id) > 5
    ),
    RecentBadges AS (
        SELECT
            b.UserId,
            MIN(b.Date) AS FirstBadgeDate,
            COUNT(DISTINCT b.Name) AS NumDistinctBadges
        FROM Badges b
        WHERE b.Date > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '6 months'
        GROUP BY b.UserId
    ),
    UserPostActivity AS (
        SELECT
            u.Id AS UserId,
            COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS NumQuestions,
            COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS NumAnswers,
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS NumUpVotes,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS NumDownVotes
        FROM Users u
        LEFT JOIN Posts p ON p.OwnerUserId = u.Id
        LEFT JOIN Votes v ON v.PostId = p.Id
        GROUP BY u.Id
    ),
    QuestionClosureReasons AS (
        SELECT
            ph.PostId,
            cr.Name AS CloseReason,
            COUNT(*) AS NumClosedEvents
        FROM PostHistory ph
        JOIN CloseReasonTypes cr ON CAST(ph.Comment AS INTEGER) = cr.Id
        WHERE ph.PostHistoryTypeId = 10
          AND ph.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
        GROUP BY ph.PostId, cr.Name
    )
SELECT
    u.UserId,
    u.DisplayName,
    u.Reputation,
    upa.NumQuestions,
    upa.NumAnswers,
    upa.NumUpVotes,
    upa.NumDownVotes,
    COALESCE(rb.NumDistinctBadges, 0) AS RecentBadgeTypes,
    COALESCE(CAST(rb.FirstBadgeDate AS date)::text, 'Never') AS FirstRecentBadgeDate,
    pwc.PostId AS MostCommentedPostId,
    pwc.CommentCount,
    STRING_AGG(DISTINCT qc.CloseReason, ', ') AS RecentCloseReasons,
    MAX(qc.NumClosedEvents) AS MaxClosureCount,
    CASE
        WHEN (array_length(string_to_array(u.DisplayName, ' '), 1) > 1) THEN
            (upper(substr(split_part(u.DisplayName, ' ', 1),1,1)) || lower(substr(split_part(u.DisplayName, ' ', 1),2))) || ' - ' ||
            (upper(substr(split_part(u.DisplayName, ' ', 2),1,1)) || lower(substr(split_part(u.DisplayName, ' ', 2),2)))
        ELSE (upper(substr(u.DisplayName,1,1)) || lower(substr(u.DisplayName,2)))
    END AS StandardizedDisplayName,
    CASE
        WHEN upa.NumQuestions = 0 AND upa.NumAnswers = 0 THEN 'No Activity'
        WHEN upa.NumQuestions > upa.NumAnswers THEN 'More Questions'
        WHEN upa.NumAnswers > upa.NumQuestions THEN 'More Answers'
        ELSE 'Equal'
    END AS PostBalance,
    CASE
        WHEN u.Reputation IS NULL OR u.Reputation = 0 THEN 'Inactive'
        WHEN u.Reputation >= 10000 THEN 'Legend'
        WHEN u.Reputation >= 1000 THEN 'Expert'
        ELSE 'Rookie'
    END AS ReputationTier
FROM RecentHighRepUsers u
LEFT JOIN RecentBadges rb ON rb.UserId = u.UserId
LEFT JOIN UserPostActivity upa ON upa.UserId = u.UserId
LEFT JOIN LATERAL (
    SELECT pwc.PostId, pwc.CommentCount
    FROM PostsWithMostComments pwc
    WHERE pwc.OwnerUserId = u.UserId
    ORDER BY pwc.CommentCount DESC, pwc.PostId ASC
    LIMIT 1
) pwc ON TRUE
LEFT JOIN LATERAL (
    SELECT qc.CloseReason, qc.NumClosedEvents
    FROM QuestionClosureReasons qc
    JOIN Posts p ON p.Id = qc.PostId AND p.OwnerUserId = u.UserId
    ORDER BY qc.NumClosedEvents DESC
    LIMIT 3
) qc ON TRUE
GROUP BY
    u.UserId, u.DisplayName, u.Reputation,
    upa.NumQuestions, upa.NumAnswers, upa.NumUpVotes, upa.NumDownVotes,
    rb.NumDistinctBadges, rb.FirstBadgeDate,
    pwc.PostId, pwc.CommentCount
ORDER BY
    u.Reputation DESC,
    RecentBadgeTypes DESC,
    FirstRecentBadgeDate ASC
LIMIT 25;