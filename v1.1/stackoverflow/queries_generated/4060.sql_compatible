with recursive UserBadgeSummary as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        b.Class,
        count(*) as BadgeCount,
        row_number() over(partition by u.Id order by count(*) desc) as rn
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, b.Class
),
LatestPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.Title,
        p.CreationDate,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.Tags,
        row_number() over(partition by p.OwnerUserId order by p.CreationDate desc) as rn_latest
    from Posts p
    where p.PostTypeId in (1, 2)
),
PostVotes as (
    select
        v.PostId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes,
        sum(case when vt.Name = 'Favorite' then 1 else 0 end) as Favorites
    from Votes v
    left join VoteTypes vt on vt.Id = v.VoteTypeId
    group by v.PostId
),
PostHistoryAggregated as (
    select
        ph.PostId,
        ph.PostHistoryTypeId,
        min(ph.CreationDate) as FirstChangeDate,
        max(ph.CreationDate) as LastChangeDate,
        count(*) as HistoryCount
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6)
    group by ph.PostId, ph.PostHistoryTypeId
),
QuestionAnswerPairs as (
    select
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.CreationDate as QuestionCreationDate,
        a.Id as AnswerId,
        a.CreationDate as AnswerCreationDate,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerOwnerUserId,
        coalesce(pv.UpVotes,0) as AnswerUpVotes,
        coalesce(pv.DownVotes,0) as AnswerDownVotes,
        coalesce(pv.Favorites,0) as AnswerFavorites,
        abs(cast(extract(epoch from(a.CreationDate - q.CreationDate)) as numeric)) as AnswerTimeDiffSec
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join PostVotes pv on pv.PostId = a.Id
    where q.PostTypeId = 1
),
DuplicateQuestions as (
    select
        pl.PostId as DuplicateQuestionId,
        pl.RelatedPostId as OriginalQuestionId,
        pl.CreationDate as LinkCreationDate
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId and lt.Name = 'Duplicate'
),
UserActivityWindow as (
    select
        OwnerUserId,
        CreationDate,
        sum(case when PostTypeId = 1 then 1 else 0 end) over (partition by OwnerUserId order by CreationDate rows between 30 preceding and current row) as QuestionsLast30,
        sum(case when PostTypeId = 2 then 1 else 0 end) over (partition by OwnerUserId order by CreationDate rows between 30 preceding and current row) as AnswersLast30
    from Posts
    where OwnerUserId is not null
),
TopTags as (
    select
        unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags)-2), '><')) as Tag,
        count(*) as TagCount
    from Posts p
    where p.PostTypeId = 1 and p.Tags is not null
    group by Tag
    having count(*) > 100
),
UsersFiltered as (
    select u.Id, u.DisplayName, u.Reputation
    from Users u
    where u.Reputation >= 1000 and u.Location is not null
),
QWithBadgeRanking as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        u.Reputation,
        u.DisplayName,
        coalesce(ubs.BadgeCount, 0) as BadgeCount,
        rank() over(partition by q.OwnerUserId order by q.CreationDate desc) as QuestionRankDesc
    from Posts q
    join UsersFiltered u on u.Id = q.OwnerUserId
    left join (
        select UserId, sum(BadgeCount) as BadgeCount
        from UserBadgeSummary
        where Class = 1
        group by UserId
    ) ubs on ubs.UserId = q.OwnerUserId
    where q.PostTypeId = 1
)
select distinct
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    ubs.BadgeCount as GoldBadgeCount,
    coalesce(latest.Title, '(no recent question)') as LatestQuestionTitle,
    coalesce(latest.Score, 0) as LatestQuestionScore,
    coalesce(pv.UpVotes, 0) as LatestQuestionUpVotes,
    coalesce(pv.DownVotes, 0) as LatestQuestionDownVotes,
    sum(case when qap.AnswerUpVotes > qap.AnswerDownVotes then 1 else 0 end) as AnswersWithPositiveVotes,
    count(qap.AnswerId) as TotalAnswers,
    max(qap.AnswerScore) as MaxAnswerScore,
    min(qap.AnswerTimeDiffSec) as FastestAnswerSeconds,
    dup.OriginalQuestionId,
    dup.LinkCreationDate as DuplicateLinkDate,
    (select count(*) from TopTags t where t.Tag in (
        select unnest(string_to_array(substring(latest.Tags from 2 for char_length(latest.Tags)-2), '><'))
    )) as PopularTagCountInLatestQuestion,
    uwa.QuestionsLast30,
    uwa.AnswersLast30,
    (case
        when latest.Score > 10 then 'Hot Question'
        when latest.Score between 1 and 10 then 'Trending'
        else 'Normal'
    end) as QuestionStatus,
    ph.FirstChangeDate as FirstEditDate,
    ph.LastChangeDate as LastEditDate,
    ph.HistoryCount as EditHistoryCount,
    concat(
        substring(coalesce(latest.Title, '') from 1 for 30),
        ' | ',
        to_char(coalesce(latest.CreationDate, cast('2024-10-01 12:34:56' as timestamp without time zone)), 'YYYY-MM-DD'),
        ' | Score:', coalesce(latest.Score,0),
        ' | Votes: ', coalesce(pv.UpVotes,0), '-', coalesce(pv.DownVotes,0)
    ) as SummaryString
from Users u
left join UserBadgeSummary ubs on u.Id = ubs.UserId and ubs.Class = 1
left join LatestPosts latest on latest.OwnerUserId = u.Id and latest.rn_latest = 1
left join PostVotes pv on pv.PostId = latest.Id
left join QuestionAnswerPairs qap on qap.AnswerOwnerUserId = u.Id
left join DuplicateQuestions dup on dup.DuplicateQuestionId = latest.Id
left join UserActivityWindow uwa on uwa.OwnerUserId = u.Id and uwa.CreationDate = (select max(CreationDate) from Posts where OwnerUserId = u.Id)
left join PostHistoryAggregated ph on ph.PostId = latest.Id and ph.PostHistoryTypeId = 4
where u.Reputation > (select avg(Reputation) from Users)
group by
    u.Id, u.DisplayName, u.Reputation, ubs.BadgeCount, latest.Id, latest.Title, latest.Score,
    pv.UpVotes, pv.DownVotes, dup.OriginalQuestionId, dup.LinkCreationDate, uwa.QuestionsLast30, uwa.AnswersLast30,
    ph.FirstChangeDate, ph.LastChangeDate, ph.HistoryCount, latest.Tags, latest.CreationDate
order by AnswersWithPositiveVotes desc, MaxAnswerScore desc
limit 100;