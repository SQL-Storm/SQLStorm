WITH
UserActivity AS (
    SELECT
        u.Id             AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        SUM(
            CASE
               WHEN v.VoteTypeId = 2 THEN  1
               WHEN v.VoteTypeId = 3 THEN -1
               ELSE 0
            END
        ) AS VoteBalance,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RepRank
    FROM Users u
    LEFT JOIN Posts  p ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON v.PostId       = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopQuestions AS (
    SELECT
        p.Id,
        p.OwnerUserId,
        p.Title,
        p.Score,
        p.ViewCount,
        (LENGTH(p.Body) - LENGTH(REPLACE(p.Body, '<code>', ''))) AS CodeSnippets,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS OwnerBestRank
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.Score > (
          SELECT AVG(score)
          FROM Posts
          WHERE PostTypeId = 1
      )
),
TagStats AS (
    SELECT
        t.TagName,
        COUNT(p.Id)     AS QCount,
        AVG(p.Score)    AS AvgScore
    FROM Tags t
    JOIN Posts p
      ON p.PostTypeId = 1
     AND p.Tags LIKE ('%' || '<' || t.TagName || '>' || '%')
    GROUP BY t.TagName
    HAVING COUNT(p.Id) > 50
),
Combined AS (
    SELECT
        ua.UserId,
        ua.DisplayName,
        ts.TagName,
        ua.QuestionCount,
        ua.AnswerCount,
        ua.VoteBalance,
        ts.QCount,
        ts.AvgScore,
        ua.Reputation + ts.QCount * COALESCE(ua.VoteBalance, 0) AS WeightedMetric
    FROM UserActivity ua
    CROSS JOIN TagStats ts
    WHERE ua.RepRank < 100
),
AggregatedImpact AS (
    SELECT
        c.UserId,
        c.DisplayName,
        STRING_AGG(DISTINCT c.TagName, ', ' ORDER BY c.TagName)       AS TagsEngaged,
        SUM(c.WeightedMetric)                                          AS TotalImpact,
        COUNT(*)                                                       AS TagCount,
        AVG(c.WeightedMetric) OVER ()                                  AS GlobalAvgWeightedMetric
    FROM Combined c
    GROUP BY c.UserId, c.DisplayName
    HAVING COUNT(*) > 3
),
FilteredImpact AS (
    SELECT
        a.UserId,
        a.DisplayName,
        a.TagsEngaged,
        a.TotalImpact,
        RANK() OVER (ORDER BY a.TotalImpact DESC) AS ImpactRank
    FROM AggregatedImpact a
    WHERE EXISTS (
        SELECT 1
        FROM Combined c
        WHERE c.UserId = a.UserId
          AND c.WeightedMetric > (
              SELECT AVG(cc.WeightedMetric)
              FROM Combined cc
              WHERE cc.TagName = c.TagName
          )
    )
)
(
    SELECT
        f.UserId,
        f.DisplayName,
        f.TagsEngaged,
        f.TotalImpact,
        f.ImpactRank
    FROM FilteredImpact f
)
INTERSECT
(
    SELECT
        u.Id,
        u.DisplayName,
        NULL::text AS TagsEngaged,
        0        AS TotalImpact,
        NULL::int AS ImpactRank
    FROM Users u
    WHERE u.Views > 10000
)
EXCEPT
(
    SELECT
        u.UserId,
        u.DisplayName,
        NULL::text,
        0,
        NULL::int
    FROM Combined u
    WHERE u.DisplayName IS NULL
)
ORDER BY ImpactRank;