-- {"query": "25018.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2388} 
WITH
    -- 1️⃣ User aggregates with correlated sub‑queries
    UserStats AS (
        SELECT
            u.Id,
            u.DisplayName,
            u.Reputation,
            COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0)                 AS VoteDiff,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
            (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionsPosted,
            (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswersPosted,
            (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id
                 AND p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL)      AS QuestionsWithAccepted
        FROM Users u
        WHERE u.Reputation > 1000
    ),

    -- 2️⃣ Post‑level statistics (window‑style aggregation)
    PostScoreStats AS (
        SELECT
            p.OwnerUserId,
            AVG(p.Score) FILTER (WHERE p.PostTypeId = 1)                     AS AvgQuestionScore,
            AVG(p.Score) FILTER (WHERE p.PostTypeId = 2)                     AS AvgAnswerScore,
            MAX(p.CreationDate)                                             AS LastPostDate
        FROM Posts p
        GROUP BY p.OwnerUserId
    ),

    -- 3️⃣ Explode tag strings (lateral + unnest) for tag‑level metrics
    TagExplode AS (
        SELECT
            p.Id                                 AS PostId,
            p.OwnerUserId,
            TRIM(BOTH '<>' FROM unnest(string_to_array(p.Tags, '><'))) AS Tag
        FROM Posts p
        WHERE p.PostTypeId = 1
          AND p.Tags IS NOT NULL
    ),

    TagStats AS (
        SELECT
            te.Tag,
            COUNT(*)                                    AS QuestionCount,
            COUNT(DISTINCT te.OwnerUserId)              AS DistinctAuthors,
            STRING_AGG(DISTINCT u.DisplayName, ', ')   FILTER (WHERE u.DisplayName IS NOT NULL) AS SampleAuthors
        FROM TagExplode te
        LEFT JOIN Users u ON u.Id = te.OwnerUserId
        GROUP BY te.Tag
    ),

    -- 4️⃣ Rank users by reputation (window function) and compute a derived ratio
    RankedUsers AS (
        SELECT
            us.*,
            COALESCE(ps.AvgQuestionScore,0)                AS AvgQuestionScore,
            COALESCE(ps.AvgAnswerScore,0)                 AS AvgAnswerScore,
            ps.LastPostDate,
            RANK() OVER (ORDER BY us.Reputation DESC)     AS ReputationRank,
            CASE
                WHEN us.QuestionsWithAccepted = 0 THEN NULL
                ELSE ROUND( us.AnswersPosted::numeric / us.QuestionsWithAccepted, 2 )
            END                                          AS AnswerPerAcceptedRatio
        FROM UserStats us
        LEFT JOIN PostScoreStats ps ON ps.OwnerUserId = us.Id
        WHERE us.Reputation > 2000
    )

-- 5️⃣ Final result set: union of top users + a synthetic row summarising tag stats
SELECT
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.VoteDiff,
    ru.GoldBadges,
    ru.SilverBadges,
    ru.BronzeBadges,
    ru.QuestionsPosted,
    ru.AnswersPosted,
    ru.QuestionsWithAccepted,
    ru.AvgQuestionScore,
    ru.AvgAnswerScore,
    ru.LastPostDate,
    ru.ReputationRank,
    ru.AnswerPerAcceptedRatio,
    NULL::text                                          AS TagName,
    NULL::int                                           AS QuestionCount,
    NULL::int                                           AS DistinctAuthors,
    NULL::text                                          AS SampleAuthors
FROM RankedUsers ru
ORDER BY ru.ReputationRank
LIMIT 100

UNION ALL

SELECT
    -1                                            AS Id,
    'Tag Summary'                                 AS DisplayName,
    NULL                                           AS Reputation,
    NULL                                           AS VoteDiff,
    NULL                                           AS GoldBadges,
    NULL                                           AS SilverBadges,
    NULL                                           AS BronzeBadges,
    NULL                                           AS QuestionsPosted,
    NULL                                           AS AnswersPosted,
    NULL                                           AS QuestionsWithAccepted,
    NULL                                           AS AvgQuestionScore,
    NULL                                           AS AvgAnswerScore,
    NULL                                           AS LastPostDate,
    NULL                                           AS ReputationRank,
    NULL                                           AS AnswerPerAcceptedRatio,
    ts.Tag                                         AS TagName,
    ts.QuestionCount,
    ts.DistinctAuthors,
    ts.SampleAuthors
FROM TagStats ts
ORDER BY ts.QuestionCount DESC
LIMIT 20;