WITH
tagged_questions AS (
  SELECT
    p.Id AS QuestionId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.AcceptedAnswerId,
    p.Tags,
    UNNEST(regexp_split_to_array(substring(p.Tags FROM 2 FOR length(p.Tags)-2), '><')) AS Tag
  FROM Posts p
  WHERE p.PostTypeId = 1
),
tag_summary AS (
  SELECT
    QuestionId,
    STRING_AGG(DISTINCT Tag, ', ') AS TagList,
    COUNT(DISTINCT Tag) AS NumTags
  FROM tagged_questions
  GROUP BY QuestionId
),
vote_counts AS (
  SELECT
    v.PostId,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCnt,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCnt
  FROM Votes v
  GROUP BY v.PostId
),
dup_info AS (
  SELECT
    dl.PostId,
    dl.RelatedPostId
  FROM PostLinks dl
  WHERE dl.LinkTypeId = 3
),
question_stats AS (
  SELECT
    q.QuestionId,
    q.Title,
    q.CreationDate,
    q.Score,
    q.ViewCount,
    q.AnswerCount,
    q.AcceptedAnswerId,
    ts.TagList,
    ts.NumTags,
    COALESCE(vc.UpVoteCnt,0) AS Ups,
    COALESCE(vc.DownVoteCnt,0) AS Downs,
    (SELECT AVG(EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate)))
     FROM Posts a
     WHERE a.ParentId = q.QuestionId AND a.PostTypeId = 2) AS AvgAnswerAgeSeconds,
    (SELECT COUNT(*) FROM dup_info d WHERE d.RelatedPostId = q.QuestionId) AS BannedDuplicates,
    (SELECT COUNT(*) FROM dup_info d WHERE d.PostId = q.QuestionId) AS IsDuplicate
  FROM tag_summary ts
  JOIN tagged_questions q ON q.QuestionId = ts.QuestionId
  LEFT JOIN vote_counts vc ON vc.PostId = q.QuestionId
  WHERE q.Score > 0
    AND q.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '365 days'
    AND ts.TagList ILIKE '%sql%'
)
SELECT
  question_stats.QuestionId,
  question_stats.Title,
  question_stats.CreationDate,
  question_stats.Score,
  question_stats.ViewCount,
  question_stats.AnswerCount,
  question_stats.AcceptedAnswerId,
  question_stats.TagList,
  question_stats.NumTags,
  question_stats.Ups,
  question_stats.Downs,
  question_stats.AvgAnswerAgeSeconds,
  question_stats.BannedDuplicates,
  question_stats.IsDuplicate,
  RANK() OVER (ORDER BY question_stats.Score DESC, question_stats.ViewCount DESC) AS RankByScoreView,
  CASE WHEN question_stats.IsDuplicate > 0 THEN 'YES' ELSE 'NO' END AS IsDuplicateFlag
FROM question_stats
WHERE question_stats.BannedDuplicates = 0
ORDER BY RankByScoreView
LIMIT 2000;