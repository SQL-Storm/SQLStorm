WITH top_tags AS (
  SELECT t.tagname,
         COUNT(p.id) AS post_count,
         AVG(p.score) AS avg_score
  FROM tags t
  JOIN posts p ON POSITION('<' || t.tagname || '>' IN p.tags) > 0
  WHERE p.posttypeid = 1
    AND p.creationdate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
  GROUP BY t.tagname
  HAVING COUNT(p.id) > 100
  ORDER BY post_count DESC
  LIMIT 10
),
user_activity AS (
  SELECT u.id AS userid,
         u.displayname,
         COUNT(DISTINCT CASE WHEN ph.posthistorytypeid IN (4,5,6) THEN ph.postid END) AS edits_made,
         COUNT(DISTINCT CASE WHEN v.votetypeid = 2 AND v.userid = u.id THEN v.postid END) AS upvotes_given,
         SUM(CASE WHEN ph.posthistorytypeid IN (10,11) THEN 1 ELSE 0 END) AS moderation_actions,
         AVG(EXTRACT(EPOCH FROM (ph.creationdate - u.creationdate)) / 86400.0) AS avg_days_active
  FROM users u
  LEFT JOIN posthistory ph ON ph.userid = u.id AND ph.creationdate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '6 months'
  LEFT JOIN votes v ON v.userid = u.id AND v.creationdate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '3 months'
  WHERE u.reputation >= 1000
    AND u.creationdate < CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
  GROUP BY u.id, u.displayname
  HAVING COUNT(ph.postid) > 5 OR COUNT(v.postid) > 10
),
answer_avg AS (
  -- compute average answer score per question
  SELECT a.parentid AS postid,
         AVG(a.score) AS avg_answer_score
  FROM posts a
  WHERE a.posttypeid = 2
  GROUP BY a.parentid
),
question_engagement AS (
  SELECT p.id AS postid,
         p.title,
         p.score,
         p.viewcount,
         p.answercount,
         p.favoritecount,
         p.commentcount,
         COALESCE(aa.avg_answer_score, 0) AS avg_answer_score,
         COUNT(DISTINCT pl.relatedpostid) AS external_links,
         COUNT(DISTINCT c.id) AS total_comments,
         STRING_AGG(DISTINCT tt.tagname, ', ') AS top_tags
  FROM posts p
  LEFT JOIN answer_avg aa ON aa.postid = p.id
  LEFT JOIN votes va ON va.postid = p.id AND va.votetypeid = 2
  LEFT JOIN postlinks pl ON pl.postid = p.id
  LEFT JOIN comments c ON c.postid = p.id
  LEFT JOIN top_tags tt ON POSITION('<' || tt.tagname || '>' IN p.tags) > 0
  WHERE p.posttypeid = 1
    AND p.creationdate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
    AND (p.deleteddate IS NULL OR p.deleteddate = CAST('0001-01-01' AS timestamp) OR p.deleteddate = '')
    AND p.viewcount > 100
  GROUP BY p.id, p.title, p.score, p.viewcount, p.answercount, p.favoritecount, p.commentcount, aa.avg_answer_score
  HAVING p.answercount > 0
)
SELECT 
  q.title,
  q.score AS question_score,
  q.viewcount,
  q.answercount,
  q.avg_answer_score,
  q.total_comments,
  q.top_tags,
  COALESCE(ua.displayname, 'Anonymous') AS top_contributor,
  ua.edits_made,
  ua.upvotes_given,
  ua.moderation_actions,
  CASE 
    WHEN q.avg_answer_score > q.score * 0.8 THEN 'High Quality'
    WHEN q.total_comments > q.answercount * 2 THEN 'Discussion Heavy'
    WHEN q.external_links > 5 THEN 'Well Linked'
    ELSE 'Standard'
  END AS engagement_category,
  ROW_NUMBER() OVER (PARTITION BY q.top_tags ORDER BY q.viewcount DESC) AS rank_in_tags,
  PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY q.viewcount) OVER () AS q75_views,
  COUNT(*) OVER () AS total_high_engagement_questions
FROM question_engagement q
LEFT JOIN (
  SELECT ph.postid,
         ph.userid,
         ROW_NUMBER() OVER (PARTITION BY ph.postid ORDER BY cnt DESC, ph.creationdate DESC) AS contributor_rank
  FROM (
    SELECT ph_inner.postid, ph_inner.userid, COUNT(ph_inner.id) AS cnt, MAX(ph_inner.creationdate) AS creationdate
    FROM posthistory ph_inner
    WHERE ph_inner.posthistorytypeid IN (4,5,6,24)
      AND ph_inner.creationdate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
    GROUP BY ph_inner.postid, ph_inner.userid
  ) ph
  GROUP BY ph.postid, ph.userid, cnt, ph.creationdate
) contrib ON contrib.postid = q.postid AND contrib.contributor_rank = 1
LEFT JOIN user_activity ua ON ua.userid = contrib.userid
WHERE q.score >= 5
ORDER BY q.viewcount DESC, q.avg_answer_score DESC
LIMIT 50;