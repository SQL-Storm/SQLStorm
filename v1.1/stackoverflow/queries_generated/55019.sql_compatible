WITH user_stats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)               AS question_count,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)               AS answer_count,
        AVG(p.Score) FILTER (WHERE p.PostTypeId = 1)              AS avg_question_score,
        AVG(p.Score) FILTER (WHERE p.PostTypeId = 2)              AS avg_answer_score,
        SUM(v.up_votes)                                           AS upvotes,
        SUM(v.down_votes)                                         AS downvotes,
        MAX(p.LastActivityDate)                                   AS recent_activity
    FROM Users u
    LEFT JOIN Posts p
        ON p.OwnerUserId = u.Id
    LEFT JOIN LATERAL (
        SELECT 
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END)   AS up_votes,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END)   AS down_votes
        FROM Votes v
        WHERE v.PostId = p.Id
    ) v ON true
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
badge_counts AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END)   AS gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END)   AS silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END)   AS bronze_badges
    FROM Badges b
    GROUP BY b.UserId
),
user_tag_counts AS (
    /* Split Tags string like '<tag1><tag2>' into rows using standard SQL: UNNEST + string functions.
       This approach assumes Tags is a string of tags wrapped in <> with no nested <> inside tags. */
    SELECT 
        u.Id                                   AS UserId,
        t.TagName,
        COUNT(*)                               AS tag_use_cnt
    FROM Users u
    JOIN Posts p
        ON p.OwnerUserId = u.Id
        AND p.PostTypeId = 1                     -- only questions
    JOIN (
        SELECT
            p2.Id AS PostId,
            TRIM(tag) AS tag_raw
        FROM Posts p2
        CROSS JOIN LATERAL (
            SELECT regexp_matches(p2.Tags, '[^><]+', 'g') AS m
        ) rm
        CROSS JOIN LATERAL (
            SELECT m[1] AS tag
        ) s
    ) split
        ON split.PostId = p.Id
    JOIN Tags t
        ON t.TagName = split.tag_raw
    GROUP BY u.Id, t.TagName
),
top_three_tags AS (
    SELECT 
        UserId,
        STRING_AGG(TagName, ', ') FILTER (WHERE rn <= 3) AS top_3_tags
    FROM (
        SELECT 
            UserId,
            TagName,
            tag_use_cnt,
            ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY tag_use_cnt DESC) AS rn
        FROM user_tag_counts
    ) ranked
    GROUP BY UserId
)
SELECT 
    us.Id,
    us.DisplayName,
    us.Reputation,
    us.question_count,
    us.answer_count,
    ROUND(CAST(us.avg_question_score AS NUMERIC), 2)    AS avg_question_score,
    ROUND(CAST(us.avg_answer_score AS NUMERIC), 2)     AS avg_answer_score,
    us.upvotes,
    us.downvotes,
    bc.gold_badges,
    bc.silver_badges,
    bc.bronze_badges,
    us.recent_activity,
    t.top_3_tags
FROM user_stats us
LEFT JOIN badge_counts bc
    ON bc.UserId = us.Id
LEFT JOIN top_three_tags t
    ON t.UserId = us.Id
GROUP BY
    us.Id,
    us.DisplayName,
    us.Reputation,
    us.question_count,
    us.answer_count,
    ROUND(CAST(us.avg_question_score AS NUMERIC), 2),
    ROUND(CAST(us.avg_answer_score AS NUMERIC), 2),
    us.upvotes,
    us.downvotes,
    bc.gold_badges,
    bc.silver_badges,
    bc.bronze_badges,
    us.recent_activity,
    t.top_3_tags
ORDER BY us.Reputation DESC
LIMIT 100;