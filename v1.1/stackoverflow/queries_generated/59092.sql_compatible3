SELECT 
    p.Id, 
    p.Title, 
    p.Score, 
    p.ViewCount, 
    p.CreationDate, 
    u.DisplayName AS OwnerDisplayName, 
    u.Reputation, 
    COUNT(DISTINCT c.Id) AS CommentCount, 
    COUNT(DISTINCT v.Id) AS VoteCount, 
    COUNT(DISTINCT ph.Id) AS HistoryCount, 
    STRING_AGG(DISTINCT t.TagName, ', ') AS Tags,
    CASE 
        WHEN p.PostTypeId = 1 THEN 'Question'
        WHEN p.PostTypeId = 2 THEN 'Answer'
        WHEN p.PostTypeId = 3 THEN 'Wiki'
        ELSE 'Other'
    END AS PostType,
    CASE 
        WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
        WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
        WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Answer Accepted'
        ELSE 'Open'
    END AS PostStatus,
    (SELECT COUNT(*) FROM Posts px WHERE px.ParentId = p.Id AND px.PostTypeId = 2) AS AnswerCount,
    (SELECT COUNT(*) FROM Votes vx WHERE vx.PostId = p.Id AND vx.VoteTypeId IN (2,3)) AS UpDownVoteDifference,
    (SELECT AVG(px.Score) FROM Posts px WHERE px.OwnerUserId = p.OwnerUserId AND px.PostTypeId IN (1,2)) AS UserAvgScore,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 1) AS GoldBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 2) AS SilverBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 3) AS BronzeBadges,
    (SELECT MIN(phx.CreationDate) FROM PostHistory phx WHERE phx.PostId = p.Id AND phx.PostHistoryTypeId IN (1,2,3)) AS FirstEditDate,
    (SELECT MAX(phx.CreationDate) FROM PostHistory phx WHERE phx.PostId = p.Id AND phx.PostHistoryTypeId IN (10,11,12,13)) AS LastStatusChangeDate
FROM Posts p
JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Comments c ON p.Id = c.PostId
LEFT JOIN Votes v ON p.Id = v.PostId
LEFT JOIN PostHistory ph ON p.Id = ph.PostId
LEFT JOIN (
    SELECT Id, TagName FROM Tags
    WHERE Count > 100
) t ON EXISTS (
    SELECT 1
    FROM (
        -- portable split of tags string '<tag1><tag2>' into rows using a recursive CTE
        WITH RECURSIVE tag_parts(remaining, tagname) AS (
            SELECT
                p.Tags AS remaining,
                NULL::text AS tagname
            UNION ALL
            SELECT
                CASE
                    WHEN position('>' IN remaining) = 0 THEN ''
                    ELSE substring(remaining FROM position('>' IN remaining) + 1)
                END,
                CASE
                    WHEN position('<' IN remaining) = 0 OR position('>' IN remaining) = 0 THEN NULL
                    ELSE trim(both '<>' FROM substring(remaining FROM position('<' IN remaining) FOR (position('>' IN remaining) - position('<' IN remaining) + 1)))
                END
            FROM tag_parts
            WHERE remaining <> '' AND position('<' IN remaining) > 0 AND position('>' IN remaining) > 0
        )
        SELECT tagname AS value FROM tag_parts WHERE tagname IS NOT NULL
    ) tag
    WHERE tag.value = t.TagName
)
WHERE p.PostTypeId IN (1,2)
    AND p.CreationDate >= DATE '2010-01-01'
    AND p.Score > 0
    AND (p.ViewCount > 100 OR p.Score > 100)
GROUP BY 
    p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, 
    u.DisplayName, u.Reputation, 
    p.PostTypeId, p.ClosedDate, p.CommunityOwnedDate, p.AcceptedAnswerId, p.OwnerUserId
HAVING COUNT(DISTINCT v.Id) > 5
    AND COUNT(DISTINCT ph.Id) > 3
    AND STRING_AGG(DISTINCT t.TagName, ', ') IS NOT NULL
ORDER BY p.Score DESC, p.ViewCount DESC, p.CreationDate DESC
LIMIT 1000;