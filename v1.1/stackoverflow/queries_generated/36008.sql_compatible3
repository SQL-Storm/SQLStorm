SELECT
  u.Id AS UserId,
  u.DisplayName,
  COUNT(DISTINCT p.Id) AS PostCount,
  AVG(p.Score) AS AvgScore,
  SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvotesReceived,
  SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvotesReceived,
  SUM(CASE WHEN v.VoteTypeId = 6 THEN 1 ELSE 0 END) AS CloseVotesCast,
  MIN(p.CreationDate) AS FirstPostDate,
  MAX(p.LastActivityDate) AS LastActivityDate,
  STRING_AGG(DISTINCT COALESCE(t.tag, ''), ',') AS TagsUsed
FROM
  Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
  LEFT JOIN (
    SELECT p2.Id AS post_id,
           CASE
             WHEN ptag LIKE '<%' AND ptag LIKE '%>' THEN SUBSTRING(ptag FROM 2 FOR (CHARACTER_LENGTH(ptag) - 2))
             ELSE ptag
           END AS tag
    FROM Posts p2,
    LATERAL (
      SELECT TRIM(token) AS ptag
      FROM (
        SELECT
          -- split into tokens; use a regexp split that returns rows across dialects if available
          -- fallback: split by '|' after replacing '><' with '>|<'
          UNNEST(
            CASE
              WHEN p2.Tags IS NULL THEN ARRAY[]::VARCHAR[]
              ELSE REGEXP_SPLIT_TO_ARRAY(REPLACE(p2.Tags, '><', '>|<'), '\|')
            END
          )
      ) AS t(token)
    ) s
  ) t ON t.post_id = p.Id
WHERE
  u.Id IS NOT NULL
  AND p.Id IS NOT NULL
  AND p.PostTypeId IN (1, 2)
GROUP BY
  u.Id,
  u.DisplayName
HAVING
  COUNT(DISTINCT p.Id) > 10
ORDER BY
  PostCount DESC,
  AvgScore DESC
LIMIT 100;