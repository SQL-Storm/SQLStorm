SELECT
    p.Id AS QuestionId,
    p.Title,
    u.DisplayName AS QuestionOwner,
    AVG(v."Score") AS AverageVoteScore,
    COUNT(DISTINCT a.Id) AS AnswerCount,
    COUNT(DISTINCT c.Id) AS CommentCount,
    MAX(a."Score") AS HighestAnswerScore,
    STRING_AGG(DISTINCT t.TagName, ', ') AS TopTags,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY a."Score") AS MedianAnswerScore
FROM 
    Posts p
JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
LEFT JOIN Comments c ON c.PostId = p.Id
LEFT JOIN (
    SELECT pt.PostId, pt.TagName
    FROM (
        SELECT p_inner.Id AS PostId, TRIM(tag) AS TagName
        FROM Posts p_inner,
             UNNEST(STRING_TO_ARRAY(REPLACE(REPLACE(p_inner.Tags, '<', ''), '>', ''), ',')) AS tag
        WHERE p_inner.PostTypeId = 1
    ) pt
    JOIN Tags t ON t.TagName = pt.TagName
) t ON t.PostId = p.Id
LEFT JOIN Votes v ON v.PostId = p.Id
WHERE 
    p.PostTypeId = 1
    AND p.CreationDate > DATE '2015-01-01'
    AND u.Reputation > 1000
GROUP BY 
    p.Id, p.Title, u.DisplayName
ORDER BY 
    AverageVoteScore DESC, AnswerCount DESC
LIMIT 100;