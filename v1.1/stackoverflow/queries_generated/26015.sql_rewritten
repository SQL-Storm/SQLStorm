WITH UserRankings AS (
  SELECT 
    UserId, 
    ROW_NUMBER() OVER (ORDER BY Reputation DESC) AS ReputationRank,
    ROW_NUMBER() OVER (ORDER BY UpVotes DESC) AS UpVoteRank
  FROM Users
),
PostScores AS (
  SELECT 
    p.Id, 
    p.Score, 
    p.ViewCount, 
    p.AnswerCount, 
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
  FROM Posts p
  LEFT JOIN Votes v ON p.Id = v.PostId
  GROUP BY p.Id, p.Score, p.ViewCount, p.AnswerCount
),
TopPosts AS (
  SELECT 
    ps.Id, 
    ps.Score, 
    ps.ViewCount, 
    ps.AnswerCount, 
    ps.UpVotes, 
    ps.DownVotes,
    ROW_NUMBER() OVER (ORDER BY ps.Score DESC) AS ScoreRank,
    ROW_NUMBER() OVER (ORDER BY ps.ViewCount DESC) AS ViewCountRank
  FROM PostScores ps
),
CommentCounts AS (
  SELECT 
    p.Id, 
    COUNT(c.Id) AS CommentCount
  FROM Posts p
  LEFT JOIN Comments c ON p.Id = c.PostId
  GROUP BY p.Id
)
SELECT 
  u.DisplayName, 
  u.Reputation, 
  ur.ReputationRank, 
  ur.UpVoteRank, 
  p.Id, 
  p.Title, 
  p.Score, 
  p.ViewCount, 
  p.AnswerCount, 
  tp.UpVotes, 
  tp.DownVotes, 
  tp.ScoreRank, 
  tp.ViewCountRank, 
  cc.CommentCount,
  SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseVotes,
  SUM(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS ReopenVotes,
  COUNT(DISTINCT t.TagName) AS TagCount,
  COUNT(DISTINCT pl.RelatedPostId) AS RelatedPostCount
FROM Users u
JOIN UserRankings ur ON u.Id = ur.UserId
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
LEFT JOIN TopPosts tp ON p.Id = tp.Id
LEFT JOIN CommentCounts cc ON p.Id = cc.Id
LEFT JOIN PostHistory ph ON p.Id = ph.PostId
LEFT JOIN PostLinks pl ON p.Id = pl.PostId
LEFT JOIN Tags t ON p.Id = t.ExcerptPostId OR p.Id = t.WikiPostId
GROUP BY 
  u.DisplayName, 
  u.Reputation, 
  ur.ReputationRank, 
  ur.UpVoteRank, 
  p.Id, 
  p.Title, 
  p.Score, 
  p.ViewCount, 
  p.AnswerCount, 
  tp.UpVotes, 
  tp.DownVotes, 
  tp.ScoreRank, 
  tp.ViewCountRank, 
  cc.CommentCount
ORDER BY u.Reputation DESC, p.Score DESC;