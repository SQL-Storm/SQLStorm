-- {"query": "27031.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "pixtral-large", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2337, "output_tokens": 1754} 
WITH ActiveUsers AS (
    SELECT
        UserId,
        Reputation,
        CreationDate,
        LastAccessDate,
        Views,
        UpVotes,
        DownVotes,
        COALESCE(ProfileImageUrl, '') AS ProfileImageUrl,
        CASE
            WHEN LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days' THEN 'Active'
            ELSE 'Inactive'
        END AS ActivityStatus
    FROM
        Users
    WHERE
        LastAccessDate IS NOT NULL
),

TaggedPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        p.LastEditorUserId,
        p.LastEditDate,
        p.Tags,
        STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags) - 2), ''><'') AS TagArray,
        LENGTH(REGEXP_REPLACE(p.Body, '[^\w\s]', '', 'g')) AS BodyWordCount,
       (p.ViewCount * 0.75 +
        p.Score * 0.2 +
        p.CommentCount * 0.05) *
        CASE
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 1.5
            ELSE 1
        END AS EngagementScore
    FROM
        Posts p
    WHERE
        p.PostTypeId = 1
        AND p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
),

BadgeAnalysis AS (
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        SUM(CASE
            WHEN b.Class = 1 THEN 1
            ELSE 0
        END) AS GoldBadges,
        SUM(CASE
            WHEN b.Class = 2 THEN 1
            ELSE 0
        END) AS SilverBadges,
        SUM(CASE
            WHEN b.Class = 3 THEN 1
            ELSE 0
        END) AS BronzeBadges,
        COUNT(DISTINCT CASE
            WHEN b.TagBased THEN b.Name
            ELSE NULL
        END) AS UniqueTagBadges
    FROM
        Badges b
    GROUP BY
        b.UserId
),

PostHistoryAnalysis AS (
    SELECT
        ph.PostId,
        COUNT(ph.Id) AS HistoryCount,
        CASE
            WHEN SUM(CASE
                    WHEN ph.PostHistoryTypeId IN (10, 17, 35, 36) THEN 1
                    ELSE 0
                END) > 0 THEN 'ClosedOrMigrated'
            ELSE 'Open'
        END AS PostStatus,
        MAX(CASE
             WHEN ph.PostHistoryTypeId = 13 THEN ph.CreationDate
                ELSE NULL
            END) AS LastDeletedDate,
        MAX(CASE
             WHEN ph.CreationDate = (SELECT MIN (CreationDate)  FROM PostHistory WHERE PostHistory.PostId=ph.PostId) THEN ph.UserId
            END) AS InitialPosterId
    FROM
        PostHistory ph
    JOIN
       Posts p ON ph.PostId = p.Id
    GROUP BY
        ph.PostId
),
HighEngagementPosts AS (
    SELECT
        p.Id AS PostId,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        u.DisplayName AS OwnerDisplayName,
        pha.HistoryCount,
        pha.PostStatus,
        pha.LastDeletedDate,
        pha.InitialPosterId,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY EngagementScore DESC) AS Rank
    FROM
        TaggedPosts p
    LEFT JOIN
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN
        PostHistoryAnalysis pha ON p.Id = pha.PostId
    WHERE
        (p.ViewCount > 1000 OR p.Score > 50)
        AND p.LastActivityDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
        AND p.OwnerUserId IS NOT NULL
    )
 SELECT
    hep.PostId,
    hep.Title,
    hep.OwnerUserId,
    hep.OwnerDisplayName,
    hep.Score,
    hep.ViewCount,
    hep.CommentCount,
    hep.AnswerCount,
    hep.Rank,
    hep.HistoryCount,
    hep.PostStatus,
    hep.LastDeletedDate,
    hep.InitialPosterId,
    uph.UserId,
    u.ProfileImageUrl,
    COALESCE(heb.TotalBadges, 0) AS TotalBadges,
    COALESCE(heb.GoldBadges, 0) AS GoldBadges,
    COALESCE(heb.SilverBadges, 0) AS SilverBadges,
    COALESCE(heb.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(heb.UniqueTagBadges, 0) AS UniqueTagBadges,
    uph.ActivityStatus
FROM
    HighEngagementPosts hep
LEFT JOIN
    ActiveUsers u ON hep.OwnerUserId = u.UserId
LEFT JOIN
   (Select distinct UserId,CreationDate,PostId from posthistory where CreationDate= (Select MIN (CreationDate) From PostHistory Where PostHistory.PostId=PostHistory.PostId and PostHistory.UserId is not null and PostHistory.UserId<>-1)  ) uph ON hep.PostId= uph.PostId
LEFT JOIN
    BadgeAnalysis heb ON hep.OwnerUserId = heb.UserId
LEFT OUTER JOIN
    Posts p ON hep.InitialPosterId = p.AcceptedAnswerId
WHERE
    hep.Rank <= 10
ORDER BY
    hep.EngagementScore DESC,
    hep.ViewCount DESC
;