WITH
RecentQuestions AS (
    SELECT
        p.OwnerUserId,
        p.Id AS QuestionId,
        p.CreationDate,
        p.Score,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
),

TopActiveUsers AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(rq.QuestionId) AS NumRecentQuestions,
        SUM(rq.Score) AS SumRecentScores
    FROM Users u
    JOIN RecentQuestions rq
      ON rq.OwnerUserId = u.Id
     AND rq.rn <= 5
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(rq.QuestionId) >= 3
),

TagPerformance AS (
    SELECT
        tag,
        COUNT(*) AS QuestionCount,
        AVG(p_score) AS AvgScore,
        SUM(vote_count) AS TotalVotes
    FROM (
        SELECT
            unnest(string_to_array(substring(p.Tags FROM 2 FOR (char_length(p.Tags) - 2)), '><')) AS tag,
            p.Score AS p_score,
            (SELECT COUNT(*) 
             FROM Votes v 
             WHERE v.PostId = p.Id 
               AND v.VoteTypeId IN (2,3)
            ) AS vote_count
        FROM Posts p
        WHERE p.PostTypeId = 1
          AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
    ) AS x
    GROUP BY tag
),

BadgeCounts AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges
    FROM Badges b
    WHERE b.Date >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months'
    GROUP BY b.UserId
),

FinalReport AS (
    SELECT
        u.DisplayName,
        u.Reputation,
        t.NumRecentQuestions,
        t.SumRecentScores,
        COALESCE(b.GoldBadges, 0) AS GoldBadges,
        COALESCE(b.SilverBadges, 0) AS SilverBadges,
        COALESCE(b.BronzeBadges, 0) AS BronzeBadges,
        (
          SELECT array_agg(tp.tag)
          FROM (
            SELECT tag
            FROM TagPerformance
            ORDER BY QuestionCount DESC
            LIMIT 3
          ) AS tp
        ) AS TopGlobalTags,
        CAST(TO_CHAR(CAST(u.CreationDate AS TIMESTAMP), 'YYYY-MM-DD') AS TEXT) AS MemberSince
    FROM TopActiveUsers t
    JOIN Users u
      ON u.Id = t.UserId
    LEFT JOIN BadgeCounts b
      ON b.UserId = t.UserId
    GROUP BY
      u.DisplayName,
      u.Reputation,
      t.NumRecentQuestions,
      t.SumRecentScores,
      b.GoldBadges,
      b.SilverBadges,
      b.BronzeBadges,
      u.CreationDate
)

SELECT *
FROM FinalReport
ORDER BY SumRecentScores DESC
LIMIT 10;