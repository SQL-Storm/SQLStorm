-- {"query": "9082.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "codex-mini-latest", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2013, "output_tokens": 3005} 
WITH
    -- Rank users by their overall posting activity (questions + answers)
    user_activity AS (
        SELECT
            u.Id                                    AS user_id,
            u.DisplayName                           AS display_name,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS question_count,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS answer_count,
            ROW_NUMBER() OVER (ORDER BY COUNT(p.Id) DESC) AS activity_rank
        FROM Users u
        LEFT JOIN Posts p
            ON p.OwnerUserId = u.Id
        GROUP BY u.Id, u.DisplayName
    ),

    -- Pick the top 3 highest‑scoring posts per user (questions or answers)
    top_posts AS (
        SELECT
            p.Id                                       AS post_id,
            p.OwnerUserId                              AS user_id,
            p.Title,
            p.Score,
            ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS post_rank
        FROM Posts p
        WHERE p.PostTypeId IN (1, 2)
    ),

    -- Compute average comment score and total bounty spent on those top posts
    post_metrics AS (
        SELECT
            tp.post_id,
            AVG(c.Score)           AS avg_comment_score,
            SUM(v.BountyAmount)    AS total_bounty
        FROM top_posts tp
        LEFT JOIN Comments c
            ON c.PostId = tp.post_id
        LEFT JOIN Votes v
            ON v.PostId = tp.post_id
           AND v.VoteTypeId IN (8, 9)      -- bounty start/close
        GROUP BY tp.post_id
    ),

    -- Find tags that appear more than 100 times on questions
    frequent_tags AS (
        SELECT
            tag,
            COUNT(*)             AS tag_usage
        FROM (
            SELECT
                UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<>' FROM p.Tags), '><')) AS tag
            FROM Posts p
            WHERE p.PostTypeId = 1
              AND p.Tags IS NOT NULL
        ) t
        GROUP BY tag
        HAVING COUNT(*) > 100
    ),

    -- Summarize gold badges per user
    gold_badges AS (
        SELECT
            b.UserId,
            COUNT(*)                  AS gold_count,
            STRING_AGG(b.Name, ', ')  AS gold_badge_names
        FROM Badges b
        WHERE b.Class = 1
        GROUP BY b.UserId
    )

SELECT
    ua.display_name,
    ua.activity_rank,
    ua.question_count,
    ua.answer_count,
    tp.post_id,
    tp.Title,
    tp.Score,
    pm.avg_comment_score,
    COALESCE(pm.total_bounty, 0) AS total_bounty,
    fb.tag            AS frequent_tag,
    fb.tag_usage,
    gb.gold_count,
    gb.gold_badge_names,
    CASE
        WHEN ua.question_count = 0 THEN NULL
        ELSE ROUND(tp.Score::NUMERIC / ua.question_count, 2)
    END                   AS score_per_question
FROM user_activity ua
JOIN top_posts tp
    ON tp.user_id = ua.user_id
   AND tp.post_rank <= 3
LEFT JOIN post_metrics pm
    ON pm.post_id = tp.post_id
LEFT JOIN LATERAL (
    SELECT
        f.tag,
        f.tag_usage
    FROM frequent_tags f
    WHERE f.tag = ANY (
        STRING_TO_ARRAY(
            TRIM(BOTH '<>' FROM (
                SELECT Tags
                FROM Posts
                WHERE Id = tp.post_id
            )),
            '><'
        )
    )
    LIMIT 1
) fb ON TRUE
LEFT JOIN gold_badges gb
    ON gb.UserId = ua.user_id
WHERE ua.activity_rank <= 50

UNION ALL

-- Include users who have never posted
SELECT
    u.DisplayName,
    NULL, NULL, NULL,
    NULL, NULL, NULL, NULL,
    NULL, NULL, NULL, NULL,
    NULL
FROM Users u
WHERE NOT EXISTS (
    SELECT 1
      FROM Posts p
     WHERE p.OwnerUserId = u.Id
)

EXCEPT

-- Exclude the top 5 most active users entirely
SELECT
    display_name,
    NULL, NULL, NULL,
    NULL, NULL, NULL, NULL,
    NULL, NULL, NULL, NULL,
    NULL
FROM user_activity
WHERE activity_rank <= 5

ORDER BY
    activity_rank NULLS LAST,
    display_name;