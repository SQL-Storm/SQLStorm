WITH q_tags AS (
    SELECT 
        p.Id                           AS question_id,
        string_to_array(
            SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2),
            '"><'
        )                               AS tags
    FROM Posts p
    WHERE p.PostTypeId = 1
),
vote_sums AS (
    SELECT
        PostId,
        SUM(CASE WHEN VoteTypeId = 2 THEN 1
                 WHEN VoteTypeId = 3 THEN -1
                 ELSE 0 END)            AS vote_score
    FROM Votes
    GROUP BY PostId
),
best_answer AS (
    SELECT
        ParentId,
        MAX(Score)                       AS best_score
    FROM Posts
    WHERE PostTypeId = 2
    GROUP BY ParentId
),
tag_rank AS (
    SELECT 
        tag,
        COUNT(DISTINCT question_id)      AS tag_questions,
        AVG(v.vote_score)                AS avg_vote_score
    FROM q_tags qt
    JOIN LATERAL UNNEST(qt.tags) AS tag
    LEFT JOIN vote_sums v ON v.PostId = qt.question_id
    GROUP BY tag
)
SELECT
    p.Id                            AS question_id,
    p.Title,
    p.CreationDate,
    p.Tags,
    p.AnswerCount,
    COALESCE(v.vote_score,0)        AS total_vote_score,
    COALESCE(ba.best_score,0)       AS best_answer_score,
    u.Reputation                    AS owner_reputation,
    ARRAY_AGG(DISTINCT tr.tag)      AS tag_list,
    ARRAY_AGG(DISTINCT tr.tag_questions) AS tag_question_counts,
    ARRAY_AGG(DISTINCT tr.avg_vote_score) AS tag_avg_votes
FROM Posts p
LEFT JOIN vote_sums v ON v.PostId = p.Id
LEFT JOIN best_answer ba ON ba.ParentId = p.Id
LEFT JOIN Users u ON u.Id = p.OwnerUserId
LEFT JOIN q_tags qt ON qt.question_id = p.Id
LEFT JOIN LATERAL UNNEST(qt.tags) AS tag ON true
LEFT JOIN tag_rank tr ON tr.tag = tag
WHERE p.PostTypeId = 1
GROUP BY
    p.Id, p.Title, p.CreationDate, p.Tags,
    p.AnswerCount, v.vote_score, ba.best_score, u.Reputation
ORDER BY p.CreationDate DESC, v.vote_score DESC
LIMIT 200;