WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        U.DisplayName,
        U.Reputation,
        P.OwnerUserId AS UserId,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank,
        P.Tags
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    GROUP BY 
        U.Id
)
SELECT 
    RP.Id,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.DisplayName,
    RP.Reputation,
    COALESCE(BC.BadgeCount, 0) AS BadgeCount,
    CASE 
        WHEN RP.rank <= 3 THEN 'Top'
        WHEN RP.rank <= 10 THEN 'High'
        ELSE 'Low'
    END AS RankLevel,
    COALESCE((
        SELECT STRING_AGG(t, ', ')
        FROM (
            SELECT TRIM(tag) AS t
            FROM (
                SELECT UNNEST(
                    CASE
                        WHEN RP.Tags IS NULL THEN ARRAY[]::text[]
                        WHEN TRIM(BOTH '<>' FROM RP.Tags) = '' THEN ARRAY[]::text[]
                        ELSE string_to_array(TRIM(BOTH '<>' FROM RP.Tags), '><')
                    END
                ) AS tag
            ) s
            WHERE TRIM(tag) <> ''
        ) x
    ), '') AS Tags
FROM 
    RankedPosts RP
LEFT JOIN 
    BadgeCounts BC ON RP.UserId = BC.UserId
WHERE 
    EXISTS (
        SELECT 1 
        FROM 
            Votes V
        WHERE 
            V.PostId = RP.Id AND V.VoteTypeId = 2
    )
ORDER BY 
    RP.Score DESC, RP.ViewCount DESC
LIMIT 100;