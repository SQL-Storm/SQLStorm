WITH UserMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, 'Unknown') AS Location,
        EXTRACT(YEAR FROM AGE(CAST('2024-10-01' AS date), u.CreationDate)) AS YearsOnPlatform,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        AVG(CASE WHEN p.Score IS NOT NULL THEN p.Score ELSE 0 END) AS AvgPostScore,
        STRING_AGG(DISTINCT b.Name, ', ' ORDER BY b.Name) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1) AS GoldBadgeCount
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '5 years'
        AND u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location, u.CreationDate
),
TopQuestions AS (
    SELECT 
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.Tags,
        COALESCE(q.AnswerCount, 0) AS AnswerCount,
        MAX(a.Score) AS BestAnswerScore,
        ROW_NUMBER() OVER (PARTITION BY q.OwnerUserId ORDER BY q.Score DESC) AS UserQuestionRank,
        DENSE_RANK() OVER (ORDER BY q.ViewCount DESC) AS ViewRank,
        -- replace ordered-set percentile with per-question median using percentile_disc in a subaggregate
        (
            SELECT PERCENTILE_DISC(0.5) WITHIN GROUP (ORDER BY a2.Score)
            FROM Posts a2
            WHERE a2.ParentId = q.Id AND a2.PostTypeId = 2
        ) AS MedianAnswerScore,
        LAG(q.CreationDate, 1) OVER (PARTITION BY q.OwnerUserId ORDER BY q.CreationDate) AS PreviousQuestionDate,
        LEAD(q.Title, 1) OVER (PARTITION BY q.OwnerUserId ORDER BY q.CreationDate) AS NextQuestionTitle,
        q.CreationDate
    FROM Posts q
    LEFT JOIN Posts a ON q.Id = a.ParentId AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1
        AND q.ClosedDate IS NULL
        AND q.Score >= 10
        AND LENGTH(COALESCE(q.Title, '')) > 20
        AND (q.Tags LIKE '%<sql>%' OR q.Tags LIKE '%<python>%' OR q.Tags LIKE '%<javascript>%')
    GROUP BY q.Id, q.Title, q.OwnerUserId, q.Score, q.ViewCount, q.Tags, q.AnswerCount, q.CreationDate
),
UserActivityPattern AS (
    SELECT 
        ph.UserId,
        EXTRACT(DOW FROM ph.CreationDate) AS DayOfWeek,
        EXTRACT(HOUR FROM ph.CreationDate) AS HourOfDay,
        COUNT(*) AS EditCount,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4, 5, 6)) AS ContentEdits,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (10, 11)) AS OpenCloseActions,
        CASE 
            WHEN EXTRACT(HOUR FROM ph.CreationDate) BETWEEN 6 AND 11 THEN 'Morning'
            WHEN EXTRACT(HOUR FROM ph.CreationDate) BETWEEN 12 AND 17 THEN 'Afternoon'
            WHEN EXTRACT(HOUR FROM ph.CreationDate) BETWEEN 18 AND 23 THEN 'Evening'
            ELSE 'Night'
        END AS TimeOfDay
    FROM PostHistory ph
    WHERE ph.UserId IS NOT NULL
        AND ph.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '1 year'
    GROUP BY ph.UserId, EXTRACT(DOW FROM ph.CreationDate), EXTRACT(HOUR FROM ph.CreationDate)
),
RecursiveCommentChain AS (
    SELECT 
        c.Id,
        c.PostId,
        c.UserId,
        c.Text,
        c.CreationDate,
        1 AS ChainDepth,
        CAST(c.Id AS TEXT) AS ChainPath
    FROM Comments c
    WHERE c.Text LIKE '@%'
        AND c.Score > 0
    
    UNION ALL
    
    SELECT 
        c2.Id,
        c2.PostId,
        c2.UserId,
        c2.Text,
        c2.CreationDate,
        rcc.ChainDepth + 1,
        rcc.ChainPath || '->' || CAST(c2.Id AS TEXT)
    FROM Comments c2
    INNER JOIN RecursiveCommentChain rcc ON c2.PostId = rcc.PostId
        AND c2.CreationDate > rcc.CreationDate
        AND c2.CreationDate < rcc.CreationDate + INTERVAL '1 hour'
    WHERE rcc.ChainDepth < 5
        AND c2.Text LIKE '%' || '@' || 
            (SELECT u.DisplayName FROM Users u WHERE u.Id = rcc.UserId) || '%'
)
SELECT 
    um.DisplayName,
    um.Reputation,
    um.Location,
    um.YearsOnPlatform,
    um.PostCount,
    um.AvgPostScore,
    COALESCE(um.GoldBadges, 'None') AS GoldBadges,
    um.GoldBadgeCount,
    tq.Title AS TopQuestionTitle,
    tq.QuestionScore,
    tq.ViewCount,
    SUBSTRING(tq.Tags FROM 2 FOR (CHAR_LENGTH(tq.Tags) - 2)) AS CleanTags,
    tq.BestAnswerScore,
    tq.MedianAnswerScore,
    EXTRACT(DAY FROM (tq.CreationDate - tq.PreviousQuestionDate)) AS DaysSincePreviousQuestion,
    COALESCE(tq.NextQuestionTitle, 'No subsequent question') AS NextQuestion,
    (
        SELECT COUNT(DISTINCT v.Id)
        FROM Votes v
        WHERE v.PostId IN (
            SELECT p.Id 
            FROM Posts p 
            WHERE p.OwnerUserId = um.Id
        )
        AND v.VoteTypeId = 2
    ) AS TotalUpvotesReceived,
    (
        SELECT STRING_AGG(t.TagName, ', ' ORDER BY SUM(t.Count) DESC)
        FROM Tags t
        WHERE EXISTS (
            SELECT 1 
            FROM Posts p
            WHERE p.OwnerUserId = um.Id
                AND p.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
        )
    ) AS TopUserTags,
    COALESCE(
        (
            SELECT AVG(uap.EditCount)
            FROM UserActivityPattern uap
            WHERE uap.UserId = um.Id
                AND uap.TimeOfDay = 'Morning'
        ), 0
    ) AS AvgMorningEdits,
    CASE 
        WHEN um.Reputation > 50000 THEN 'Expert'
        WHEN um.Reputation > 10000 THEN 'Advanced'
        WHEN um.Reputation > 5000 THEN 'Intermediate'
        ELSE 'Regular'
    END AS UserTier,
    (
        SELECT MAX(rcc.ChainDepth)
        FROM RecursiveCommentChain rcc
        WHERE rcc.UserId = um.Id
    ) AS MaxCommentChainDepth,
    GREATEST(
        um.PostCount * 10 + um.Reputation / 100,
        COALESCE(tq.QuestionScore, 0) * 50
    ) AS ComputedInfluenceScore,
    NULLIF(
        TRIM(
            REGEXP_REPLACE(
                LOWER(COALESCE(um.Location, 'nowhere')),
                '[^a-z0-9 ]',
                '',
                'g'
            )
        ),
        ''
    ) AS NormalizedLocation
FROM UserMetrics um
LEFT JOIN TopQuestions tq ON um.Id = tq.OwnerUserId AND tq.UserQuestionRank = 1
WHERE um.PostCount > 5
    AND (um.QuestionCount > 0 OR um.AnswerCount > 10)
    AND NOT EXISTS (
        SELECT 1
        FROM PostHistory ph
        WHERE ph.UserId = um.Id
            AND ph.PostHistoryTypeId IN (12, 13)
            AND ph.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '6 months'
    )

UNION ALL

SELECT 
    'Anonymous Users' AS DisplayName,
    0 AS Reputation,
    'Global' AS Location,
    NULL AS YearsOnPlatform,
    COUNT(*) AS PostCount,
    AVG(p.Score) AS AvgPostScore,
    NULL AS GoldBadges,
    0 AS GoldBadgeCount,
    NULL AS TopQuestionTitle,
    NULL AS QuestionScore,
    SUM(p.ViewCount) AS ViewCount,
    NULL AS CleanTags,
    NULL AS BestAnswerScore,
    NULL AS MedianAnswerScore,
    NULL AS DaysSincePreviousQuestion,
    NULL AS NextQuestion,
    0 AS TotalUpvotesReceived,
    NULL AS TopUserTags,
    0 AS AvgMorningEdits,
    'Anonymous' AS UserTier,
    NULL AS MaxCommentChainDepth,
    0 AS ComputedInfluenceScore,
    NULL AS NormalizedLocation
FROM Posts p
WHERE p.OwnerUserId IS NULL
    OR p.OwnerUserId = -1
GROUP BY 'Anonymous Users'

ORDER BY ComputedInfluenceScore DESC NULLS LAST, Reputation DESC
LIMIT 100;