-- {"query": "58067.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "deepseek-r1", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2033, "output_tokens": 1405} 
WITH ActiveUsers AS (
    SELECT 
        u.Id, 
        u.DisplayName, 
        u.Reputation, 
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsAsked,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersProvided,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS UpvotesReceived,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS DownvotesReceived,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges
    FROM 
        Users u
    LEFT JOIN 
        Posts p ON p.OwnerUserId = u.Id AND p.CreationDate BETWEEN '2022-01-01' AND '2023-01-01'
    LEFT JOIN 
        Comments c ON c.UserId = u.Id AND c.CreationDate BETWEEN '2022-01-01' AND '2023-01-01'
    LEFT JOIN 
        Votes v ON v.UserId = u.Id AND v.CreationDate BETWEEN '2022-01-01' AND '2023-01-01'
    WHERE 
        u.Reputation > 1000
    GROUP BY 
        u.Id, u.DisplayName, u.Reputation
    HAVING 
        COUNT(p.Id) > 50 OR COUNT(c.Id) > 100
),
PostStats AS (
    SELECT 
        p.OwnerUserId,
        AVG(p.Score) AS AvgPostScore,
        MAX(p.AnswerCount) AS MaxAnswersPerQuestion,
        COUNT(DISTINCT ph.Id) FILTER (WHERE ph.PostHistoryTypeId = 5) AS PostEdits,
        COUNT(DISTINCT pl.RelatedPostId) AS LinkedPosts
    FROM 
        Posts p
    LEFT JOIN 
        PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId IN (5, 6, 7)
    LEFT JOIN 
        PostLinks pl ON pl.PostId = p.Id AND pl.LinkTypeId = 1
    WHERE 
        p.PostTypeId IN (1, 2)
    GROUP BY 
        p.OwnerUserId
),
TagEngagement AS (
    SELECT 
        pt.UserId,
        STRING_AGG(t.TagName, ', ' ORDER BY t.Count DESC) AS TopTags,
        COUNT(DISTINCT t.Id) AS UniqueTagsUsed
    FROM 
        Posts p
    JOIN 
        PostTypes pt ON p.PostTypeId = pt.Id
    JOIN 
        Tags t ON t.TagName = ANY(STRING_TO_ARRAY(REPLACE(REPLACE(p.Tags, '><', ','), '<>', ''), ','))
    WHERE 
        p.PostTypeId = 1
    GROUP BY 
        pt.UserId
)
SELECT 
    au.*,
    ps.AvgPostScore,
    ps.MaxAnswersPerQuestion,
    ps.PostEdits,
    ps.LinkedPosts,
    te.TopTags,
    te.UniqueTagsUsed,
    RANK() OVER (ORDER BY (au.UpvotesReceived - au.DownvotesReceived) DESC) AS EngagementRank
FROM 
    ActiveUsers au
JOIN 
    PostStats ps ON ps.OwnerUserId = au.Id
LEFT JOIN 
    TagEngagement te ON te.UserId = au.Id
ORDER BY 
    EngagementRank
LIMIT 100;