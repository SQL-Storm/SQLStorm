WITH UserPostStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Location,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN pt.Name = 'Question' THEN p.ViewCount ELSE 0 END) AS TotalViewsOnQuestions,
        SUM(CASE WHEN pt.Name = 'Answer' THEN v.VoteCount ELSE 0 END) AS TotalUpvotesOnAnswers,
        AVG(CASE WHEN pt.Name = 'Question' THEN p.Score ELSE NULL END) AS AvgQuestionScore,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6) THEN p.Id END) AS EditedPosts,
        STRING_AGG(DISTINCT t.TagName, ', ') AS AssociatedTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId = 2
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId
    LEFT JOIN (
        SELECT p2.Id AS PostId, s.tag AS TagName
        FROM Posts p2,
             LATERAL (
               SELECT UNNEST(string_to_array(substring(p2.Tags FROM 2 FOR (CHAR_LENGTH(p2.Tags)-2)), '><')) AS tag
             ) s
        WHERE p2.PostTypeId = 1
    ) t ON p.Id = t.PostId
    WHERE u.CreationDate >= CAST('2008-01-01' AS TIMESTAMP)
      AND p.CreationDate >= CAST('2008-01-01' AS TIMESTAMP)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
),
BadgeStats AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        COUNT(CASE WHEN b.Date >= (CAST('2024-10-01' AS DATE) - INTERVAL '1 year') THEN 1 END) AS RecentBadges
    FROM Badges b
    GROUP BY b.UserId
),
CommentStats AS (
    SELECT
        c.UserId,
        COUNT(*) AS TotalComments,
        SUM(c.Score) AS TotalCommentScore
    FROM Comments c
    WHERE c.CreationDate >= CAST('2008-01-01' AS TIMESTAMP)
    GROUP BY c.UserId
),
TopUsers AS (
    SELECT
        ups.UserId,
        ups.DisplayName,
        ups.Reputation,
        ups.Location,
        ups.TotalPosts,
        ups.TotalViewsOnQuestions,
        ups.TotalUpvotesOnAnswers,
        ups.AvgQuestionScore,
        ups.EditedPosts,
        ups.AssociatedTags,
        COALESCE(bs.GoldBadges, 0) AS GoldBadges,
        COALESCE(bs.SilverBadges, 0) AS SilverBadges,
        COALESCE(bs.BronzeBadges, 0) AS BronzeBadges,
        COALESCE(bs.RecentBadges, 0) AS RecentBadges,
        COALESCE(cs.TotalComments, 0) AS TotalComments,
        COALESCE(cs.TotalCommentScore, 0) AS TotalCommentScore,
        ROW_NUMBER() OVER (ORDER BY (ups.TotalUpvotesOnAnswers + ups.TotalViewsOnQuestions * 0.01 + COALESCE(ups.AvgQuestionScore,0) * 100 + COALESCE(bs.GoldBadges,0) * 1000 + COALESCE(bs.SilverBadges,0) * 100 + COALESCE(bs.BronzeBadges,0) * 10 + COALESCE(cs.TotalCommentScore,0)) DESC) AS Rank
    FROM UserPostStats ups
    LEFT JOIN BadgeStats bs ON ups.UserId = bs.UserId
    LEFT JOIN CommentStats cs ON ups.UserId = cs.UserId
    WHERE ups.TotalPosts > 10
      AND ups.TotalViewsOnQuestions > 10000
      AND ups.TotalUpvotesOnAnswers > 100
    GROUP BY
        ups.UserId,
        ups.DisplayName,
        ups.Reputation,
        ups.Location,
        ups.TotalPosts,
        ups.TotalViewsOnQuestions,
        ups.TotalUpvotesOnAnswers,
        ups.AvgQuestionScore,
        ups.EditedPosts,
        ups.AssociatedTags,
        bs.GoldBadges,
        bs.SilverBadges,
        bs.BronzeBadges,
        bs.RecentBadges,
        cs.TotalComments,
        cs.TotalCommentScore
)
SELECT *
FROM TopUsers
WHERE Rank <= 10
ORDER BY Rank;