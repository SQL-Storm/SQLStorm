WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.ParentId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as rn,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_score,
        NTILE(10) OVER (ORDER BY p.Score DESC) as score_percentile,
        CASE 
            WHEN p.PostTypeId = 1 THEN COALESCE(p.Title, '') 
            ELSE COALESCE(p.Tags, '') 
        END as title_or_tags,
        LEN(COALESCE(p.Body, '')) as body_length,
        DATEDIFF(day, p.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) as days_since_creation,
        IIF(p.Score > 0, 1, 0) as has_positive_score
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
UserActivity AS (
    SELECT 
        u.Id as UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate,
        COUNT(DISTINCT p.Id) as post_count,
        SUM(p.Score) as total_score,
        AVG(p.Score) as avg_score,
        MAX(p.CreationDate) as last_post_date,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as question_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as answer_count,
        COUNT(DISTINCT CASE WHEN p.Score > 100 THEN p.Id END) as high_score_posts,
        STRING_AGG(CASE WHEN p.PostTypeId = 1 THEN p.Title ELSE NULL END, '; ') as question_titles
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.CreationDate
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count as tag_count,
        t.ExcerptPostId,
        t.WikiPostId,
        COALESCE(p1.ViewCount, 0) as excerpt_views,
        COALESCE(p2.ViewCount, 0) as wiki_views,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 100 THEN 'Moderate'
            ELSE 'Niche'
        END as tag_popularity,
        DENSE_RANK() OVER (ORDER BY t.Count DESC) as popularity_rank,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as rank_by_count
    FROM Tags t
    LEFT JOIN Posts p1 ON t.ExcerptPostId = p1.Id
    LEFT JOIN Posts p2 ON t.WikiPostId = p2.Id
),
RecentComments AS (
    SELECT 
        c.Id,
        c.PostId,
        c.UserId,
        c.Score,
        c.Text,
        c.CreationDate,
        c.UserDisplayName,
        LEN(c.Text) as text_length,
        SUBSTRING(c.Text, 1, 50) as text_preview,
        DATEDIFF(minute, c.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) as minutes_since_comment,
        CASE 
            WHEN c.Score > 5 THEN 'Highly Valued'
            WHEN c.Score > 0 THEN 'Valued'
            ELSE 'Neutral'
        END as comment_quality,
        ROW_NUMBER() OVER (PARTITION BY c.PostId ORDER BY c.CreationDate DESC) as comment_rank
    FROM Comments c
    WHERE c.CreationDate >= DATEADD(day, -30, cast('2024-10-01 12:34:56' as timestamp))
),
ComplexPostAnalysis AS (
    SELECT 
        rp.Id as PostId,
        rp.PostTypeId,
        rp.ParentId,
        rp.OwnerUserId,
        rp.Score,
        rp.ViewCount,
        rp.CreationDate,
        rp.Title,
        rp.Tags,
        rp.AnswerCount,
        rp.CommentCount,
        rp.FavoriteCount,
        rp.rn,
        rp.prev_score,
        rp.score_percentile,
        rp.title_or_tags,
        rp.body_length,
        rp.days_since_creation,
        rp.has_positive_score,
        CASE 
            WHEN rp.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = rp.PostTypeId) THEN 'Above Average'
            WHEN rp.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = rp.PostTypeId) * 0.8 THEN 'Average'
            ELSE 'Below Average'
        END as score_category,
        CASE 
            WHEN rp.Score = 0 THEN 'No Score'
            WHEN rp.Score > 10 THEN 'High Score'
            WHEN rp.Score > 5 THEN 'Medium Score'
            ELSE 'Low Score'
        END as score_level,
        COALESCE(ua.post_count, 0) as user_post_count,
        COALESCE(ua.total_score, 0) as user_total_score,
        COALESCE(ua.avg_score, 0) as user_avg_score,
        COALESCE(ta.tag_count, 0) as related_tag_count,
        COALESCE(ta.tag_popularity, 'Unknown') as tag_popularity,
        COALESCE(rc.text_preview, 'No Comments') as latest_comment_preview,
        IIF(rp.days_since_creation < 30, 'Recent', 'Old') as post_age_category,
        IIF(rp.AnswerCount > 5, 'Well Answered', 'Few Answers') as answer_level,
        IIF(rp.CommentCount > 10, 'Highly Commented', 'Low Commented') as comment_level,
        CASE 
            WHEN rp.OwnerUserId IS NOT NULL AND rp.OwnerUserId != 0 THEN 'User Post'
            WHEN rp.OwnerUserId = 0 OR rp.OwnerUserId IS NULL THEN 'Community Post'
            ELSE 'Mixed'
        END as post_origin,
        ISNULL(rp.title_or_tags, '') + ' - ' + ISNULL(rp.Tags, '') as combined_metadata
    FROM RankedPosts rp
    LEFT JOIN UserActivity ua ON rp.OwnerUserId = ua.UserId
    LEFT JOIN (
        SELECT TagName, COUNT(*) as tag_count
        FROM Posts p
        CROSS APPLY STRING_SPLIT(ISNULL(p.Tags, ''), '<')
        WHERE LEN(TRIM(value)) > 0
        GROUP BY TagName
    ) AS tag_counts ON rp.Title LIKE '%' + tag_counts.TagName + '%'
    LEFT JOIN TagAnalysis ta ON ta.TagName = SUBSTRING(rp.Tags, 2, LEN(rp.Tags) - 2)
    LEFT JOIN (
        SELECT PostId, Text, ROW_NUMBER() OVER (PARTITION BY PostId ORDER BY CreationDate DESC) as rn
        FROM Comments 
        WHERE CreationDate >= DATEADD(day, -30, cast('2024-10-01 12:34:56' as timestamp))
    ) rc ON rp.Id = rc.PostId AND rc.rn = 1
    WHERE rp.PostTypeId IN (1, 2)
),
FinalAggregatedData AS (
    SELECT 
        *,
        COUNT(*) OVER () as total_posts,
        SUM(CASE WHEN Score > 0 THEN 1 ELSE 0 END) OVER () as positive_score_posts,
        AVG(Score) OVER () as overall_avg_score,
        MAX(Score) OVER () as max_score,
        MIN(Score) OVER () as min_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY Score) OVER () as median_score,
        COUNT(DISTINCT OwnerUserId) OVER () as active_users,
        COUNT(DISTINCT CASE WHEN ParentId IS NOT NULL THEN ParentId END) OVER () as parent_post_count,
        COUNT(DISTINCT CASE WHEN AnswerCount > 0 THEN Id END) OVER () as answered_questions,
        COUNT(DISTINCT CASE WHEN CommentCount > 0 THEN Id END) OVER () as commented_questions,
        STRING_AGG(DISTINCT PostId::VARCHAR, ', ') OVER () as all_post_ids,
        STRING_AGG(DISTINCT Title, ' | ') OVER () as all_titles
    FROM ComplexPostAnalysis
),
RankedUsers AS (
    SELECT 
        ua.UserId,
        ua.Reputation,
        ua.DisplayName,
        ua.post_count,
        ua.total_score,
        ua.avg_score,
        ua.last_post_date,
        ua.question_count,
        ua.answer_count,
        ua.high_score_posts,
        ua.question_titles,
        ROW_NUMBER() OVER (ORDER BY ua.total_score DESC) as rep_rank,
        RANK() OVER (ORDER BY ua.Reputation DESC) as rep_rank2,
        DENSE_RANK() OVER (ORDER BY ua.Reputation DESC) as rep_rank3,
        PERCENT_RANK() OVER (ORDER BY ua.Reputation) as rep_percentile
    FROM UserActivity ua
)
