WITH RankedUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        u.Location,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        ROW_NUMBER() OVER (PARTITION BY COALESCE(u.Location, 'Unknown') ORDER BY u.Reputation DESC) AS LocationRank,
        LAG(u.Reputation) OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS PrevReputation,
        AVG(u.Reputation) OVER (PARTITION BY LEFT(COALESCE(u.Location, 'Unknown'), 10)) AS LocationAvgRep
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId AND b.Class = 1
    WHERE u.Reputation > 1000 OR u.UpVotes > 500
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.UpVotes, u.DownVotes, u.Location
),
ActivePosts AS (
    SELECT 
        p.Id,
        p.Title,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.AcceptedAnswerId,
        p.AnswerCount,
        p.OwnerUserId,
        COALESCE(p.Tags, '') AS Tags,
        CASE 
            WHEN p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community'
            ELSE 'Open'
        END AS PostStatus,
        LENGTH(COALESCE(p.Body, '')) AS BodyLength,
        (p.Score * 1.0 / NULLIF(p.ViewCount, 0)) AS ScorePerView
    FROM Posts p
    WHERE (p.PostTypeId = 1 OR p.PostTypeId = 2) 
      AND p.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '1 year')
      AND (p.Score > 0 OR p.ViewCount > 1000)
),
UserContributions AS (
    SELECT 
        ru.Id AS UserId,
        ru.DisplayName,
        ru.Reputation,
        COUNT(ap.Id) AS TotalPosts,
        SUM(CASE WHEN ap.PostTypeId = 1 THEN 1 ELSE 0 END) AS Questions,
        SUM(CASE WHEN ap.PostTypeId = 2 THEN 1 ELSE 0 END) AS Answers,
        SUM(ap.Score) AS TotalScore,
        AVG(ap.ScorePerView) AS AvgScorePerView,
        STRING_AGG(DISTINCT SUBSTRING(ap.Tags FROM 2 FOR POSITION('><' IN ap.Tags) - 2), ', ') AS TopTags,
        MAX(CASE WHEN ap.PostStatus = 'Closed' THEN 1 ELSE 0 END) AS HasClosedPosts
    FROM RankedUsers ru
    LEFT JOIN ActivePosts ap ON ru.Id = ap.OwnerUserId
    GROUP BY ru.Id, ru.DisplayName, ru.Reputation
    HAVING COUNT(ap.Id) > 0
),
VoteSummary AS (
    SELECT 
        v.PostId,
        COUNT(CASE WHEN vt.Name = 'UpMod' THEN 1 END) AS UpVotesCount,
        COUNT(CASE WHEN vt.Name = 'DownMod' THEN 1 END) AS DownVotesCount,
        SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE -1 END) AS NetVotes
    FROM Votes v
    INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    INNER JOIN ActivePosts ap ON v.PostId = ap.Id
    WHERE v.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '6 months')
      AND vt.Name IN ('UpMod', 'DownMod')
    GROUP BY v.PostId
    HAVING SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE -1 END) > 5
),
MainResults AS (
    SELECT 
        uc.UserId,
        uc.DisplayName,
        uc.Reputation,
        uc.TotalPosts,
        uc.Questions,
        uc.Answers,
        uc.TotalScore,
        uc.AvgScorePerView,
        uc.TopTags,
        ru.BadgeCount,
        ru.LocationRank,
        ru.LocationAvgRep,
        uc.HasClosedPosts,
        CASE 
            WHEN uc.TotalScore > ru.LocationAvgRep * 2 THEN 'High Performer'
            WHEN uc.Questions > uc.Answers * 2 THEN 'Question Focused'
            WHEN uc.Answers > 10 AND uc.AvgScorePerView > 0.01 THEN 'Top Answerer'
            ELSE 'Standard'
        END AS PerformanceCategory,
        CONCAT(
            COALESCE(uc.DisplayName, 'Anonymous'),
            ' (',
            COALESCE(ru.Location, 'Unknown'),
            ') - ',
            CASE WHEN ru.LocationRank = 1 THEN 'Top' ELSE CAST(ru.LocationRank AS VARCHAR) END,
            ' in ',
            COALESCE(ru.Location, 'Unknown')
        ) AS UserSummary
    FROM UserContributions uc
    INNER JOIN RankedUsers ru ON uc.UserId = ru.Id
    LEFT JOIN VoteSummary vote_summary ON EXISTS (
        SELECT 1 FROM ActivePosts ap2 WHERE ap2.OwnerUserId = uc.UserId AND ap2.Id = vote_summary.PostId
    )
    WHERE uc.TotalPosts >= 5
      AND (uc.AvgScorePerView IS NULL OR uc.AvgScorePerView > 0.001)
      AND ru.LocationRank <= 10
),
CommunityAggregate AS (
    SELECT 
        CAST(NULL AS BIGINT) AS UserId,
        'Community Aggregate' AS DisplayName,
        SUM(uc.Reputation) AS Reputation,
        SUM(uc.TotalPosts) AS TotalPosts,
        SUM(uc.Questions) AS Questions,
        SUM(uc.Answers) AS Answers,
        SUM(uc.TotalScore) AS TotalScore,
        AVG(uc.AvgScorePerView) AS AvgScorePerView,
        STRING_AGG(DISTINCT uc.TopTags, ' | ') AS TopTags,
        SUM(ru.BadgeCount) AS BadgeCount,
        CAST(NULL AS INTEGER) AS LocationRank,
        AVG(ru.LocationAvgRep) AS LocationAvgRep,
        MAX(uc.HasClosedPosts) AS HasClosedPosts,
        'Overall Community' AS PerformanceCategory,
        'Community Summary Across All Locations' AS UserSummary
    FROM UserContributions uc
    INNER JOIN RankedUsers ru ON uc.UserId = ru.Id
)
SELECT 
    UserId,
    DisplayName,
    Reputation,
    TotalPosts,
    Questions,
    Answers,
    TotalScore,
    AvgScorePerView,
    TopTags,
    BadgeCount,
    LocationRank,
    LocationAvgRep,
    HasClosedPosts,
    PerformanceCategory,
    UserSummary
FROM (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        TotalPosts,
        Questions,
        Answers,
        TotalScore,
        AvgScorePerView,
        TopTags,
        BadgeCount,
        LocationRank,
        LocationAvgRep,
        HasClosedPosts,
        PerformanceCategory,
        UserSummary
    FROM MainResults
    UNION ALL
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        TotalPosts,
        Questions,
        Answers,
        TotalScore,
        AvgScorePerView,
        TopTags,
        BadgeCount,
        LocationRank,
        LocationAvgRep,
        HasClosedPosts,
        PerformanceCategory,
        UserSummary
    FROM CommunityAggregate
) combined
ORDER BY 
    CASE PerformanceCategory 
        WHEN 'High Performer' THEN 1 
        WHEN 'Top Answerer' THEN 2 
        ELSE 3 
    END,
    TotalScore DESC NULLS LAST,
    UserId;