WITH UserActivity AS (
    SELECT 
        u.Id,
        u.Reputation,
        u.CreationDate,
        EXTRACT(YEAR FROM u.CreationDate) AS JoinYear,
        COALESCE(COUNT(DISTINCT p.Id), 0) AS TotalPosts,
        COALESCE(COUNT(DISTINCT c.Id), 0) AS TotalComments,
        COALESCE(COUNT(DISTINCT b.Id), 0) AS TotalBadges,
        RANK() OVER (PARTITION BY EXTRACT(YEAR FROM u.CreationDate) ORDER BY u.Reputation DESC) AS ReputationRank
    FROM 
        Users u
    LEFT JOIN 
        Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
    LEFT JOIN 
        Comments c ON u.Id = c.UserId
    LEFT JOIN 
        Badges b ON u.Id = b.UserId AND b.Class = 1
    GROUP BY 
        u.Id, u.Reputation, u.CreationDate
),
PostMetrics AS (
    SELECT 
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        AVG(p.Score) OVER (PARTITION BY p.PostTypeId) AS AvgPostScoreByType,
        SUM(CASE WHEN ph.PostHistoryTypeId = 2 THEN 1 ELSE 0 END) AS BodyEdits,
        MAX((LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', '')))/NULLIF(LENGTH('><'),0)) AS MaxTagCount
    FROM 
        Posts p
    LEFT JOIN 
        PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (2,5,8)
    WHERE 
        p.PostTypeId IS NOT NULL
    GROUP BY
        p.OwnerUserId, p.PostTypeId, p.Tags
)
SELECT 
    ua.Id,
    ua.Reputation,
    ua.JoinYear,
    ua.TotalPosts,
    ua.TotalComments,
    ua.TotalBadges,
    ua.ReputationRank,
    pm.AvgPostScoreByType,
    pm.BodyEdits,
    pm.MaxTagCount,
    (SELECT AVG(CAST(TotalComments AS NUMERIC)) FROM UserActivity) AS GlobalAvgComments,
    CASE 
        WHEN ua.TotalComments > (SELECT AVG(CAST(TotalComments AS NUMERIC)) FROM UserActivity) 
        THEN 'AboveAvg' 
        ELSE 'BelowAvg' 
    END AS CommentPerformance,
    COALESCE(
      CASE 
        WHEN u.Location IS NOT NULL AND POSITION(',' IN u.Location) > 0 THEN SUBSTRING(u.Location FROM 1 FOR POSITION(',' IN u.Location)-1)
        WHEN u.Location IS NOT NULL THEN u.Location
        ELSE NULL
      END, 'Unknown') AS PrimaryLocation,
    (SELECT COUNT(*) 
     FROM Votes v 
     WHERE v.UserId = ua.Id 
       AND v.VoteTypeId = 2 
       AND v.CreationDate BETWEEN DATE '2015-01-01' AND DATE '2020-01-01') AS UpvotesLast5Years,
    (SELECT COUNT(*) 
     FROM Posts p2 
     WHERE p2.OwnerUserId = ua.Id 
       AND p2.Id IN (SELECT RelatedPostId FROM PostLinks WHERE LinkTypeId = 3)
    ) AS DuplicatePosts
FROM 
    UserActivity ua
LEFT JOIN 
    PostMetrics pm ON ua.Id = pm.OwnerUserId
LEFT JOIN
    Users u ON u.Id = ua.Id
WHERE 
    ua.Reputation > (
        SELECT PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY Reputation) FROM Users
    )
    AND EXISTS (
        SELECT 1 
        FROM (
          SELECT b2.UserId FROM Badges b2 WHERE b2.UserId = ua.Id AND b2.Name IN ('Legendary', 'Epic', 'Scholar')
          INTERSECT
          SELECT p3.OwnerUserId FROM Posts p3 WHERE p3.OwnerUserId = ua.Id AND p3.Score > 100
        ) t
    )
ORDER BY 
    ua.ReputationRank,
    pm.AvgPostScoreByType DESC NULLS LAST;