WITH ranked_users AS (
    SELECT Id, Reputation, ROW_NUMBER() OVER (ORDER BY Reputation DESC) AS rn
    FROM Users
),
top_users AS (
    SELECT Id, Reputation
    FROM ranked_users
    WHERE rn <= 100
)
SELECT u.Id, u.DisplayName, u.Reputation, COUNT(DISTINCT p.Id) AS num_posts
FROM (
    SELECT Id, Reputation, NULL::text AS DisplayName
    FROM top_users
) tu
LEFT JOIN Users u ON u.Id = tu.Id
LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.Score >= 10
GROUP BY u.Id, u.DisplayName, u.Reputation
ORDER BY num_posts DESC;