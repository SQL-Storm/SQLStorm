SELECT
  p.Id AS PostId,
  p.Title,
  p.PostTypeId,
  p.ViewCount,
  p.Score,
  p.CreationDate,
  p.OwnerUserId,
  u.DisplayName AS OwnerDisplayName,
  COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpVotes,
  COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownVotes,
  COUNT(DISTINCT cl.Id) AS CommentCount,
  -- aggregate tags as a comma-separated string for portability
  STRING_AGG(DISTINCT t.TagName, ',') FILTER (WHERE p.PostTypeId = 1) AS Tags,
  MAX(CASE WHEN ph.PostHistoryTypeId = 50 THEN ph.CreationDate END) AS CommunityBumpDate,
  MAX(p.LastActivityDate) AS LastActivityDate
FROM
  Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN Comments cl ON cl.PostId = p.Id
  -- replace lateral unnest with cross apply style derived table emulation using a correlated subquery aggregated into rows
  LEFT JOIN (
    SELECT
      p2.Id AS PostId,
      tag AS TagName
    FROM (
      SELECT
        p3.Id,
        TRIM(BOTH '>' FROM TRIM(BOTH '<' FROM split_tag)) AS tag
      FROM Posts p3,
      LATERAL (
        SELECT value AS split_tag
        FROM (SELECT regexp_split_to_table(TRIM(BOTH '><' FROM p3.Tags), '><') AS value) s
      ) st
    ) sub
  ) t ON t.PostId = p.Id AND p.PostTypeId = 1
  LEFT JOIN PostHistory ph ON ph.PostId = p.Id
WHERE
  p.PostTypeId IN (1, 2)
  AND p.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '365 days')
GROUP BY
  p.Id,
  p.Title,
  p.PostTypeId,
  p.ViewCount,
  p.Score,
  p.CreationDate,
  p.OwnerUserId,
  u.DisplayName
ORDER BY
  p.Score DESC,
  p.ViewCount DESC
LIMIT 100;