WITH
recent_posts AS (
  SELECT
    p.Id,
    p.OwnerUserId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
  FROM Posts p
  WHERE p.PostTypeId = 1
),
vote_summary AS (
  SELECT
    PostId,
    SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
    SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
  FROM Votes
  GROUP BY PostId
),
post_vote_join AS (
  SELECT
    COALESCE(rp.Id, vs.PostId) AS PostId,
    rp.OwnerUserId,
    rp.Score,
    rp.ViewCount,
    vs.UpVotes,
    vs.DownVotes
  FROM recent_posts rp
  FULL OUTER JOIN vote_summary vs
    ON vs.PostId = rp.Id
),
tag_expansion AS (
  SELECT
    p.Id       AS PostId,
    UNNEST(
      string_to_array(
        substring(p.Tags, 2, length(p.Tags) - 2),
        '><'
      )
    ) AS TagName
  FROM Posts p
  WHERE p.Tags IS NOT NULL
),
tag_popularity AS (
  SELECT
    te.TagName,
    COUNT(*)            AS TagCount,
    RANK() OVER (ORDER BY COUNT(*) DESC) AS TagRank
  FROM tag_expansion te
  GROUP BY te.TagName
),
user_stats AS (
  SELECT
    u.Id                       AS UserId,
    u.DisplayName,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS Questions,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS Answers,
    COALESCE(AVG(c.Score), 0)   AS AvgCommentScore,
    COALESCE(SUM(vs.UpVotes), 0) AS TotalUpVotes,
    COALESCE(SUM(vs.DownVotes), 0) AS TotalDownVotes,
    COALESCE(
      STRING_AGG(DISTINCT te.TagName, ',' ORDER BY te.TagName),
      ''
    )                         AS InterestedTags
  FROM Users u
  LEFT JOIN Posts p
    ON p.OwnerUserId = u.Id
  LEFT JOIN Comments c
    ON c.UserId = u.Id
  LEFT JOIN vote_summary vs
    ON vs.PostId = p.Id
  LEFT JOIN tag_expansion te
    ON te.PostId = p.Id
  GROUP BY u.Id, u.DisplayName
),
candidates AS (
  SELECT
    us.*,
    NULLIF(us.TotalUpVotes, us.TotalDownVotes) AS VoteDiff,
    CASE
      WHEN us.Questions > us.Answers THEN 'Asker'
      ELSE 'Responder'
    END                                       AS Role,
    tp.TagName                               AS TopTag
  FROM user_stats us
  LEFT JOIN LATERAL (
    SELECT tp.TagName
    FROM tag_popularity tp
    WHERE tp.TagName = ANY(string_to_array(us.InterestedTags, ','))
    ORDER BY tp.TagRank
    LIMIT 1
  ) tp ON true
),
benchmark_set AS (
  SELECT
    UserId, DisplayName, Questions, Answers, AvgCommentScore,
    TotalUpVotes, TotalDownVotes, VoteDiff, Role, TopTag
  FROM candidates
  WHERE AvgCommentScore > (SELECT AVG(AvgCommentScore) FROM user_stats)
  
  UNION ALL
  
  SELECT
    u.Id, u.DisplayName, 0, 0, 0, 0, 0, 0, 'Dormant', NULL
  FROM Users u
  WHERE NOT EXISTS (
    SELECT 1
      FROM Posts p
     WHERE p.OwnerUserId = u.Id
  )
)
SELECT
  bs.UserId,
  bs.DisplayName,
  bs.Questions,
  bs.Answers,
  bs.AvgCommentScore,
  bs.TotalUpVotes,
  bs.TotalDownVotes,
  bs.VoteDiff,
  bs.Role,
  bs.TopTag,
  CASE
    WHEN bs.VoteDiff > 0 THEN bs.VoteDiff
    ELSE 0
  END                                         AS PositiveDiff,
  CAST((bs.TotalUpVotes * 100.0 /
     NULLIF(bs.TotalUpVotes + bs.TotalDownVotes, 0)
  ) AS NUMERIC(5,2))                           AS UpPercentage
FROM benchmark_set bs
EXCEPT
SELECT
  c.UserId,
  c.DisplayName,
  c.Questions,
  c.Answers,
  c.AvgCommentScore,
  c.TotalUpVotes,
  c.TotalDownVotes,
  c.VoteDiff,
  c.Role,
  c.TopTag,
  CASE WHEN c.VoteDiff > 0 THEN c.VoteDiff ELSE 0 END,
  CAST((c.TotalUpVotes * 100.0 / NULLIF(c.TotalUpVotes + c.TotalDownVotes, 0)) AS NUMERIC(5,2))
FROM candidates c
WHERE c.Role = 'Asker';