SELECT 
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN p.Id END) AS AcceptedQuestions,
    COUNT(DISTINCT b.Id) AS BadgesEarned,
    COUNT(DISTINCT v.Id) AS VotesCast,
    COUNT(DISTINCT c.Id) AS CommentsMade,
    COUNT(DISTINCT ph.Id) AS PostHistoryEntries,
    COUNT(DISTINCT pl.Id) AS PostLinksCreated,
    STRING_AGG(DISTINCT t.TagName, ', ') AS TagsUsed,
    MAX(p.CreationDate) AS LastPostDate,
    MIN(p.CreationDate) AS FirstPostDate,
    AVG(p.Score) AS AvgPostScore,
    MAX(p.Score) AS MaxPostScore,
    SUM(p.ViewCount) AS TotalViews,
    SUM(p.FavoriteCount) AS TotalFavorites,
    COUNT(DISTINCT CASE WHEN p.ClosedDate IS NOT NULL THEN p.Id END) AS ClosedPosts,
    COUNT(DISTINCT CASE WHEN p.CommunityOwnedDate IS NOT NULL THEN p.Id END) AS CommunityOwnedPosts,
    COUNT(DISTINCT CASE WHEN p.AnswerCount > 0 THEN p.Id END) AS QuestionsWithAnswers,
    COUNT(DISTINCT CASE WHEN p.CommentCount > 0 THEN p.Id END) AS PostsWithComments,
    COUNT(DISTINCT CASE WHEN p.Title IS NOT NULL AND LENGTH(p.Title) > 0 THEN p.Id END) AS PostsHavingTitle,
    COUNT(DISTINCT CASE WHEN p.Body IS NOT NULL AND LENGTH(p.Body) > 0 THEN p.Id END) AS PostsHavingBody,
    COUNT(DISTINCT CASE WHEN p.Tags IS NOT NULL AND LENGTH(p.Tags) > 0 THEN p.Id END) AS PostsHavingTags,
    AVG(EXTRACT(EPOCH FROM (p.LastActivityDate - p.CreationDate)) / 86400.0) AS AvgDaysSinceCreation,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13) THEN ph.Id END) AS ModerationActions,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (35, 36) THEN ph.Id END) AS MigrationEvents,
    AVG(p.ViewCount) AS AvgViewsPerPost,
    AVG(p.FavoriteCount) AS AvgFavoritesPerPost,
    AVG(p.AnswerCount) AS AvgAnswersPerQuestion,
    AVG(p.CommentCount) AS AvgCommentsPerPost,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS UpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS DownVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 5 THEN v.Id END) AS Bookmarks,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 8 THEN v.Id END) AS BountyStarts,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 9 THEN v.Id END) AS BountyCloses,
    COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id END) AS SilverBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id END) AS BronzeBadges
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId OR u.Id = p.LastEditorUserId OR u.Id = p.UserId
LEFT JOIN Badges b ON u.Id = b.UserId
LEFT JOIN Votes v ON u.Id = v.UserId
LEFT JOIN Comments c ON u.Id = c.UserId
LEFT JOIN PostHistory ph ON u.Id = ph.UserId OR u.Id = ph.LastEditorUserId
LEFT JOIN PostLinks pl ON u.Id = pl.CreationUserId OR u.Id = pl.LinkTypeId OR u.Id = pl.Id /* best-effort; original JOIN appeared incorrect, keep pl.Id join removed if not appropriate */
LEFT JOIN (
    SELECT PostId,
           -- normalize tags: remove empty elements produced by splitting on '><'
           REGEXP_REPLACE(tag, '^>+|>+$', '') AS TagName
    FROM (
        SELECT PostId, unnest(string_to_array(Tags, '><')) AS tag
        FROM Posts
        WHERE Tags IS NOT NULL AND Tags <> ''
    ) s
) t ON p.Id = t.PostId
WHERE u.CreationDate >= DATE '2008-01-01' AND u.CreationDate < DATE '2023-01-01'
GROUP BY u.Id, u.DisplayName, u.Reputation, u.LastAccessDate
HAVING COUNT(DISTINCT p.Id) > 0
ORDER BY TotalPosts DESC, u.Reputation DESC, u.LastAccessDate DESC
LIMIT 10000;