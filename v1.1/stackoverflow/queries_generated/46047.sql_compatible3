WITH RECURSIVE UserEngagementMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COUNT(DISTINCT p.Id) AS QuestionCount,
        COUNT(DISTINCT a.Id) AS AnswerCount,
        COALESCE(SUM(p.Score), 0) AS TotalQuestionScore,
        COALESCE(SUM(a.Score), 0) AS TotalAnswerScore,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) AS VotesCast
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    LEFT JOIN Posts a ON a.OwnerUserId = u.Id AND a.PostTypeId = 2
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    WHERE u.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '3' YEAR)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
    HAVING COUNT(DISTINCT p.Id) > 5 OR COUNT(DISTINCT a.Id) > 10
),
TagExpertise AS (
    SELECT 
        u.Id AS UserId,
        t.TagName,
        COUNT(DISTINCT p.Id) AS PostsInTag,
        AVG(p.Score) AS AvgScore,
        SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS AcceptedAnswers,
        RANK() OVER (PARTITION BY u.Id ORDER BY COUNT(DISTINCT p.Id) DESC) AS TagRank
    FROM Users u
    INNER JOIN Posts p ON p.OwnerUserId = u.Id
    CROSS JOIN LATERAL (
        SELECT value AS tag_name
        FROM UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), '><')) AS t(value)
    ) tn
    INNER JOIN Tags t ON t.TagName = tn.tag_name
    WHERE p.PostTypeId = 2
      AND p.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '2' YEAR)
    GROUP BY u.Id, t.TagName
    HAVING COUNT(DISTINCT p.Id) >= 3
),
QuestionQualityMetrics AS (
    SELECT 
        q.Id AS QuestionId,
        q.OwnerUserId,
        q.Score,
        q.ViewCount,
        q.AnswerCount,
        q.FavoriteCount,
        q.CommentCount,
        CASE WHEN q.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAcceptedAnswer,
        COUNT(DISTINCT pl.RelatedPostId) AS LinkedQuestions,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpVotes,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownVotes,
        EXTRACT(EPOCH FROM (COALESCE(q.ClosedDate, CAST('2024-10-01 12:34:56' AS timestamp)) - q.CreationDate)) / 3600 AS HoursUntilClosed,
        COUNT(DISTINCT ph.Id) AS EditCount,
        DENSE_RANK() OVER (PARTITION BY q.OwnerUserId ORDER BY q.Score DESC) AS UserQuestionRank
    FROM Posts q
    LEFT JOIN PostLinks pl ON pl.PostId = q.Id AND pl.LinkTypeId = 1
    LEFT JOIN Votes v ON v.PostId = q.Id
    LEFT JOIN PostHistory ph ON ph.PostId = q.Id AND ph.PostHistoryTypeId IN (4, 5, 6)
    WHERE q.PostTypeId = 1
      AND q.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '2' YEAR)
    GROUP BY q.Id, q.OwnerUserId, q.Score, q.ViewCount, q.AnswerCount, 
             q.FavoriteCount, q.CommentCount, q.AcceptedAnswerId, q.ClosedDate, q.CreationDate
),
AnswerPerformance AS (
    SELECT 
        a.Id AS AnswerId,
        a.OwnerUserId,
        a.ParentId AS QuestionId,
        a.Score AS AnswerScore,
        q.Score AS QuestionScore,
        CASE WHEN q.AcceptedAnswerId = a.Id THEN 1 ELSE 0 END AS IsAccepted,
        EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate)) / 60 AS MinutesToAnswer,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.CreationDate) AS AnswerPosition,
        COUNT(DISTINCT c.Id) AS AnswerCommentCount,
        a.CommentCount AS TotalComments
    FROM Posts a
    INNER JOIN Posts q ON q.Id = a.ParentId
    LEFT JOIN Comments c ON c.PostId = a.Id
    WHERE a.PostTypeId = 2
      AND a.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '2' YEAR)
      AND q.PostTypeId = 1
    GROUP BY a.Id, a.OwnerUserId, a.ParentId, a.Score, q.Score, 
             q.AcceptedAnswerId, a.CreationDate, q.CreationDate, a.CommentCount
),
BadgeProgression AS (
    SELECT 
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COUNT(*) FILTER (WHERE b.TagBased = TRUE) AS TagBasedBadges,
        ARRAY_AGG(DISTINCT b.Name ORDER BY b.Name) FILTER (WHERE b.Class = 1) AS GoldBadgeNames
    FROM Badges b
    WHERE b.Date >= (CAST('2024-10-01' AS date) - INTERVAL '3' YEAR)
    GROUP BY b.UserId
)
SELECT 
    uem.DisplayName,
    uem.Reputation,
    EXTRACT(YEAR FROM AGE(CAST('2024-10-01 12:34:56' AS timestamp), uem.CreationDate)) AS YearsActive,
    uem.QuestionCount,
    uem.AnswerCount,
    uem.TotalQuestionScore,
    uem.TotalAnswerScore,
    ROUND(CAST(uem.TotalQuestionScore AS NUMERIC) / NULLIF(uem.QuestionCount, 0), 2) AS AvgQuestionScore,
    ROUND(CAST(uem.TotalAnswerScore AS NUMERIC) / NULLIF(uem.AnswerCount, 0), 2) AS AvgAnswerScore,
    te.TagName AS TopTag,
    te.PostsInTag AS TopTagPosts,
    ROUND(te.AvgScore, 2) AS TopTagAvgScore,
    bp.GoldBadges,
    bp.SilverBadges,
    bp.BronzeBadges,
    bp.TagBasedBadges,
    COALESCE(AVG(qqm.ViewCount), 0) AS AvgQuestionViews,
    COALESCE(AVG(qqm.AnswerCount), 0) AS AvgAnswersReceived,
    COALESCE(SUM(qqm.HasAcceptedAnswer), 0) AS QuestionsWithAcceptedAnswers,
    COALESCE(COUNT(DISTINCT ap.AnswerId) FILTER (WHERE ap.IsAccepted = 1), 0) AS AcceptedAnswers,
    COALESCE(AVG(ap.MinutesToAnswer) FILTER (WHERE ap.IsAccepted = 1), 0) AS AvgMinutesToAcceptedAnswer,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY ap.AnswerScore) AS MedianAnswerScore,
    uem.CommentCount,
    uem.VotesCast,
    ROUND(CAST(uem.Reputation AS NUMERIC) / NULLIF(EXTRACT(EPOCH FROM AGE(CAST('2024-10-01 12:34:56' AS timestamp), uem.CreationDate)) / 86400, 0), 2) AS ReputationPerDay
FROM UserEngagementMetrics uem
LEFT JOIN TagExpertise te ON te.UserId = uem.Id AND te.TagRank = 1
LEFT JOIN BadgeProgression bp ON bp.UserId = uem.Id
LEFT JOIN QuestionQualityMetrics qqm ON qqm.OwnerUserId = uem.Id
LEFT JOIN AnswerPerformance ap ON ap.OwnerUserId = uem.Id
WHERE uem.Reputation > 1000
GROUP BY uem.Id, uem.DisplayName, uem.Reputation, uem.CreationDate, uem.QuestionCount,
         uem.AnswerCount, uem.TotalQuestionScore, uem.TotalAnswerScore,
         te.TagName, te.PostsInTag, te.AvgScore, bp.GoldBadges, bp.SilverBadges,
         bp.BronzeBadges, bp.TagBasedBadges, uem.CommentCount, uem.VotesCast
HAVING COUNT(DISTINCT ap.AnswerId) > 5
ORDER BY uem.Reputation DESC, uem.TotalAnswerScore DESC
LIMIT 500;