WITH active_users AS (
    SELECT u.Id         AS UserId,
           u.Reputation,
           u.CreationDate,
           COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCnt,
           COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCnt,
           COALESCE(SUM(p.Score),0)                  AS TotalScore,
           COALESCE(cnt.badges,0)                    AS BadgeCnt,
           STRING_AGG(DISTINCT tt.TagName, '|')      AS TagStr
    FROM  Users u
      LEFT JOIN Posts      p ON p.OwnerUserId = u.Id
      LEFT JOIN Badges     b ON b.UserId        = u.Id
      LEFT JOIN Tags       t ON t.Id            = p.Id
      LEFT JOIN LATERAL (
            SELECT unnest(regexp_split_to_array(p.Tags,'><')) AS TagVal
        ) dt ON p.PostTypeId = 1
      LEFT JOIN Tags tt  ON tt.TagName = dt.TagVal
      LEFT JOIN (SELECT UserId, COUNT(*) AS badges
                 FROM Badges GROUP BY UserId) cnt
        ON cnt.UserId = u.Id
    WHERE u.Reputation >= 500
    GROUP BY u.Id, u.Reputation, u.CreationDate, cnt.badges
    HAVING COUNT(p.Id) > 50
),

inactive_users AS (
    SELECT u.Id         AS UserId,
           u.Reputation,
           u.CreationDate,
           COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCnt,
           COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCnt,
           COALESCE(SUM(p.Score),0)                  AS TotalScore,
           COALESCE(cnt.badges,0)                    AS BadgeCnt,
           STRING_AGG(DISTINCT tt.TagName, '|')      AS TagStr
    FROM  Users u
      LEFT JOIN Posts      p ON p.OwnerUserId = u.Id
      LEFT JOIN Badges     b ON b.UserId        = u.Id
      LEFT JOIN Tags       t ON t.Id            = p.Id
      LEFT JOIN LATERAL (
            SELECT unnest(regexp_split_to_array(p.Tags,'><')) AS TagVal
        ) dt ON p.PostTypeId = 1
      LEFT JOIN Tags tt  ON tt.TagName = dt.TagVal
      LEFT JOIN (SELECT UserId, COUNT(*) AS badges
                 FROM Badges GROUP BY UserId) cnt
        ON cnt.UserId = u.Id
    WHERE u.Reputation >= 2000
      AND u.LastAccessDate < (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 DAY')
    GROUP BY u.Id, u.Reputation, u.CreationDate, cnt.badges
    HAVING COUNT(p.Id) < 10
),

all_users AS (
    SELECT * FROM active_users
    UNION ALL
    SELECT * FROM inactive_users
),

tag_rank AS (
    SELECT au.UserId,
           au.Reputation,
           au.CreationDate,
           au.QuestionCnt,
           au.AnswerCnt,
           au.TotalScore,
           au.BadgeCnt,
           au.TagStr,
           ROW_NUMBER() OVER (PARTITION BY au.TagStr ORDER BY au.Reputation DESC) AS TagRank,
           RANK()       OVER (ORDER BY au.Reputation DESC)                        AS GlobalRank
    FROM   all_users au
),

last_vote AS (
    SELECT tr.UserId,
           tr.Reputation,
           tr.CreationDate,
           tr.QuestionCnt,
           tr.AnswerCnt,
           tr.TotalScore,
           tr.BadgeCnt,
           tr.TagStr,
           tr.TagRank,
           tr.GlobalRank,
           (SELECT MAX(v.CreationDate)
              FROM Votes v
             WHERE v.PostId IN (
                   SELECT p.Id
                     FROM Posts p
                    WHERE p.OwnerUserId = tr.UserId
                      AND p.PostTypeId = 2
                )
           ) AS LastVoteDate
    FROM tag_rank tr
)

SELECT lv.UserId,
       lv.Reputation,
       lv.QuestionCnt,
       lv.AnswerCnt,
       lv.TotalScore,
       lv.BadgeCnt,
       lv.TagStr,
       lv.TagRank,
       lv.GlobalRank,
       CASE
           WHEN lv.Reputation > 10000 THEN 'Elite'
           WHEN lv.Reputation BETWEEN 5000 AND 9999 THEN 'Pro'
           ELSE 'Regular'
       END                           AS RankTier,
       COALESCE(TO_CHAR(lv.LastVoteDate, 'YYYY-MM-DD'), 'Never') AS LatestVote,
       CASE
           WHEN lv.AnswerCnt = 0 THEN NULL
           ELSE 'Answered ' || lv.AnswerCnt || ' posts'
       END                           AS AnswerSummary
FROM last_vote lv
WHERE lv.GlobalRank <= 200
ORDER BY lv.GlobalRank, lv.Reputation DESC;