WITH RECURSIVE tag_hierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        COUNT(DISTINCT pt.Id) AS direct_questions,
        CAST(t.TagName AS TEXT) AS tag_path,
        1 AS level
    FROM Tags t
    JOIN Posts pt ON pt.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE pt.PostTypeId = 1
      AND t.Count > 1000
    GROUP BY t.Id, t.TagName

    UNION ALL

    SELECT 
        t2.Id,
        t2.TagName,
        agg.child_questions,
        th.tag_path || ' -> ' || t2.TagName AS tag_path,
        th.level + 1 AS level
    FROM tag_hierarchy th
    JOIN Posts p1 ON p1.Tags LIKE '%' || '<' || th.TagName || '>' || '%'
    JOIN Posts p2 ON p2.Tags LIKE '%' || '<' || th.TagName || '>' || '%'
      AND p2.Tags <> p1.Tags
      AND p2.PostTypeId = 1
    JOIN Tags t2 ON p2.Tags LIKE '%' || '<' || t2.TagName || '>' || '%'
      AND t2.TagName <> th.TagName
    JOIN (
      SELECT p2_inner.Tags AS tags_key, COUNT(DISTINCT p2_inner.Id) AS child_questions
      FROM Posts p2_inner
      JOIN Tags t2_inner ON p2_inner.Tags LIKE '%' || '<' || t2_inner.TagName || '>' || '%'
      GROUP BY p2_inner.Tags
    ) agg ON agg.tags_key = p2.Tags
    WHERE th.level < 3
    GROUP BY t2.Id, t2.TagName, th.tag_path, th.level, agg.child_questions
),
expert_users AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        t.TagName,
        COUNT(DISTINCT p.Id) AS answers_in_tag,
        SUM(p.Score) AS total_score,
        AVG(p.Score) AS avg_score,
        COUNT(DISTINCT CASE WHEN p.Id = q.AcceptedAnswerId THEN p.Id END) AS accepted_answers,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS median_score,
        DENSE_RANK() OVER (PARTITION BY t.TagName ORDER BY SUM(p.Score) DESC) AS tag_rank
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 2
    JOIN Posts q ON q.Id = p.ParentId
    JOIN Tags t ON q.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE u.Reputation > 10000
      AND p.Score > 0
      AND t.Count > 500
    GROUP BY u.Id, u.DisplayName, u.Reputation, t.TagName
    HAVING COUNT(DISTINCT p.Id) >= 10
),
question_lifecycle AS (
    SELECT 
        p.Id AS QuestionId,
        p.CreationDate AS question_created,
        p.Score AS question_score,
        p.ViewCount,
        MIN(a.CreationDate) AS first_answer_time,
        MAX(a.CreationDate) AS last_answer_time,
        MIN(CASE WHEN a.Score > 0 THEN a.CreationDate END) AS first_upvoted_answer,
        MIN(CASE WHEN a.Id = p.AcceptedAnswerId THEN a.CreationDate END) AS accepted_answer_time,
        COUNT(DISTINCT a.Id) AS total_answers,
        COUNT(DISTINCT CASE WHEN a.Score > 0 THEN a.Id END) AS upvoted_answers,
        MAX(a.Score) AS best_answer_score,
        EXTRACT(EPOCH FROM (MIN(a.CreationDate) - p.CreationDate))/3600 AS hours_to_first_answer,
        EXTRACT(EPOCH FROM (MIN(CASE WHEN a.Id = p.AcceptedAnswerId THEN a.CreationDate END) - p.CreationDate))/86400 AS days_to_acceptance
    FROM Posts p
    LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '2 years'
      AND p.Score >= 5
    GROUP BY p.Id, p.CreationDate, p.Score, p.ViewCount
),
badge_progression AS (
    SELECT 
        b.UserId,
        b.Name AS badge_name,
        b.Class,
        b.Date AS earned_date,
        LAG(b.Date) OVER (PARTITION BY b.UserId, b.Class ORDER BY b.Date) AS previous_badge_date,
        LEAD(b.Date) OVER (PARTITION BY b.UserId, b.Class ORDER BY b.Date) AS next_badge_date,
        ROW_NUMBER() OVER (PARTITION BY b.UserId, b.Class ORDER BY b.Date) AS badge_sequence,
        COUNT(*) OVER (PARTITION BY b.UserId, b.Class ORDER BY b.Date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cumulative_badges
    FROM Badges b
    WHERE b.TagBased = 0
)
SELECT 
    th.tag_path,
    th.level AS hierarchy_depth,
    eu.DisplayName AS expert_name,
    eu.Reputation,
    eu.answers_in_tag,
    eu.avg_score,
    eu.accepted_answers,
    eu.tag_rank,
    ql.QuestionId,
    ql.question_score,
    ql.ViewCount,
    ql.hours_to_first_answer,
    ql.days_to_acceptance,
    ql.total_answers,
    ql.upvoted_answers,
    ql.best_answer_score,
    bp.badge_name,
    bp.Class AS badge_class,
    bp.badge_sequence,
    bp.cumulative_badges,
    EXTRACT(DAY FROM (bp.earned_date - bp.previous_badge_date)) AS days_between_badges,
    COUNT(DISTINCT c.Id) OVER (PARTITION BY eu.UserId ORDER BY c.CreationDate ROWS BETWEEN 30 PRECEDING AND CURRENT ROW) AS recent_comments,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) OVER (PARTITION BY ql.QuestionId) AS question_upvotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) OVER (PARTITION BY ql.QuestionId) AS question_downvotes,
    COALESCE(ph.edit_count, 0) AS question_edits,
    DENSE_RANK() OVER (ORDER BY ql.ViewCount DESC) AS view_rank,
    NTILE(100) OVER (ORDER BY eu.Reputation) AS reputation_percentile,
    CASE 
        WHEN ql.days_to_acceptance < 1 THEN 'Quick'
        WHEN ql.days_to_acceptance < 7 THEN 'Normal'
        WHEN ql.days_to_acceptance < 30 THEN 'Slow'
        ELSE 'Very Slow'
    END AS acceptance_speed,
    CASE
        WHEN eu.avg_score > 10 AND eu.accepted_answers > 20 THEN 'Elite'
        WHEN eu.avg_score > 5 AND eu.accepted_answers > 10 THEN 'Advanced'
        WHEN eu.avg_score > 2 AND eu.accepted_answers > 5 THEN 'Intermediate'
        ELSE 'Regular'
    END AS expert_tier
FROM tag_hierarchy th
CROSS JOIN expert_users eu
JOIN question_lifecycle ql ON ql.hours_to_first_answer < 24
JOIN badge_progression bp ON bp.UserId = eu.UserId
LEFT JOIN Comments c ON c.UserId = eu.UserId
LEFT JOIN Votes v ON v.PostId = ql.QuestionId
LEFT JOIN (
    SELECT PostId, COUNT(*) AS edit_count
    FROM PostHistory
    WHERE PostHistoryTypeId IN (4, 5, 6)
    GROUP BY PostId
) ph ON ph.PostId = ql.QuestionId
WHERE eu.tag_rank <= 10
  AND bp.badge_sequence <= 50
  AND ql.question_score > 10
GROUP BY
    th.tag_path,
    th.level,
    eu.DisplayName,
    eu.Reputation,
    eu.answers_in_tag,
    eu.avg_score,
    eu.accepted_answers,
    eu.tag_rank,
    ql.QuestionId,
    ql.question_score,
    ql.ViewCount,
    ql.hours_to_first_answer,
    ql.days_to_acceptance,
    ql.total_answers,
    ql.upvoted_answers,
    ql.best_answer_score,
    bp.badge_name,
    bp.Class,
    bp.badge_sequence,
    bp.cumulative_badges,
    bp.earned_date,
    bp.previous_badge_date,
    eu.UserId,
    ph.edit_count
ORDER BY 
    th.level DESC,
    eu.tag_rank,
    ql.ViewCount DESC,
    bp.cumulative_badges DESC
LIMIT 10000;