WITH RankedUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.Location,
        COUNT(p.Id) AS PostCount,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
        AVG(p.Score) AS AvgScore,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 WHEN v.VoteTypeId = 3 THEN -1 ELSE 0 END) AS NetVotes,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, COUNT(p.Id) DESC) AS UserRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.CreationDate >= TIMESTAMP '2010-01-01'
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
),
TopBadges AS (
    SELECT 
        b.UserId,
        STRING_AGG(CASE WHEN b.Class = 1 THEN b.Name || ' (Gold)' WHEN b.Class = 2 THEN b.Name || ' (Silver)' ELSE b.Name || ' (Bronze)' END, ', ') AS BadgeList,
        COUNT(*) AS BadgeCount
    FROM Badges b
    WHERE b.Date >= TIMESTAMP '2010-01-01'
    GROUP BY b.UserId
),
ActiveComments AS (
    SELECT 
        c.UserId,
        COUNT(*) AS CommentCount,
        AVG(CASE WHEN c.Score IS NOT NULL THEN c.Score ELSE 0 END) AS AvgCommentScore
    FROM Comments c
    WHERE c.CreationDate >= TIMESTAMP '2010-01-01'
    GROUP BY c.UserId
),
PostStats AS (
    SELECT 
        p.OwnerUserId,
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        COALESCE(p.AnswerCount, 0) AS AnswerCount,
        CASE 
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Accepted'
            ELSE 'Open'
        END AS Status,
        (SELECT ARRAY_AGG(tag) FROM (
             SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><')) AS tag
        ) x) AS TagArray
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.CreationDate >= TIMESTAMP '2010-01-01'
)
SELECT 
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.Location,
    ru.PostCount,
    ru.QuestionCount,
    ru.AnswerCount,
    ROUND(CAST(ru.AvgScore AS numeric), 2) AS AvgScore,
    ru.NetVotes,
    ru.UserRank,
    COALESCE(tb.BadgeList, 'None') AS TopBadges,
    COALESCE(tb.BadgeCount, 0) AS BadgeCount,
    COALESCE(ac.CommentCount, 0) AS CommentCount,
    ROUND(CAST(COALESCE(ac.AvgCommentScore, 0) AS numeric), 2) AS AvgCommentScore,
    (SELECT COUNT(*) FROM PostStats ps WHERE ps.OwnerUserId = ru.Id AND ps.Status = 'Accepted') AS AcceptedQuestions,
    (SELECT AVG(ps.ViewCount) FROM PostStats ps WHERE ps.OwnerUserId = ru.Id) AS AvgViews,
    CASE 
        WHEN ru.Location LIKE '%United States%' THEN 'US'
        WHEN ru.Location LIKE '%United Kingdom%' THEN 'UK'
        ELSE 'Other'
    END AS LocationGroup,
    STRING_AGG(DISTINCT t.TagName, ', ') AS CommonTags
FROM RankedUsers ru
LEFT JOIN TopBadges tb ON ru.Id = tb.UserId
LEFT JOIN ActiveComments ac ON ru.Id = ac.UserId
LEFT JOIN PostStats ps ON ru.Id = ps.OwnerUserId
LEFT JOIN LATERAL (
    SELECT UNNEST(ps.TagArray) AS tag
) tag ON TRUE
LEFT JOIN Tags t ON tag.tag = t.TagName
WHERE ru.UserRank <= 100
    AND (ru.Reputation > 1000 OR ru.PostCount > 50)
    AND ru.AvgScore IS NOT NULL
GROUP BY ru.Id, ru.DisplayName, ru.Reputation, ru.Location, ru.PostCount, ru.QuestionCount, ru.AnswerCount, ru.AvgScore, ru.NetVotes, ru.UserRank, tb.BadgeList, tb.BadgeCount, ac.CommentCount, ac.AvgCommentScore
HAVING COUNT(DISTINCT ps.PostId) > 5
ORDER BY ru.UserRank, ru.Reputation DESC

UNION ALL

SELECT 
    CAST(NULL AS bigint) AS Id,
    'Summary' AS DisplayName,
    SUM(ru.Reputation) AS Reputation,
    NULL AS Location,
    SUM(ru.PostCount) AS PostCount,
    SUM(ru.QuestionCount) AS QuestionCount,
    SUM(ru.AnswerCount) AS AnswerCount,
    ROUND(AVG(CAST(ru.AvgScore AS numeric)), 2) AS AvgScore,
    SUM(ru.NetVotes) AS NetVotes,
    CAST(NULL AS integer) AS UserRank,
    CAST(NULL AS text) AS TopBadges,
    SUM(COALESCE(tb.BadgeCount, 0)) AS BadgeCount,
    SUM(COALESCE(ac.CommentCount, 0)) AS CommentCount,
    ROUND(AVG(CAST(COALESCE(ac.AvgCommentScore, 0) AS numeric)), 2) AS AvgCommentScore,
    SUM((SELECT COUNT(*) FROM PostStats ps WHERE ps.OwnerUserId = ru.Id AND ps.Status = 'Accepted')) AS AcceptedQuestions,
    ROUND(AVG((SELECT AVG(ps.ViewCount) FROM PostStats ps WHERE ps.OwnerUserId = ru.Id)), 2) AS AvgViews,
    CAST(NULL AS text) AS LocationGroup,
    CAST(NULL AS text) AS CommonTags
FROM RankedUsers ru
LEFT JOIN TopBadges tb ON ru.Id = tb.UserId
LEFT JOIN ActiveComments ac ON ru.Id = ac.UserId
WHERE ru.UserRank <= 100;