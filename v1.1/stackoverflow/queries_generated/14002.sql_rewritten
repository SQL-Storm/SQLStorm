-- {"query": "14002.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "claude-3-haiku", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 7005, "output_tokens": 3175} 
WITH cte AS (
  SELECT p.Id, p.PostTypeId, p.CreationDate, p.Score, p.OwnerUserId, u.Reputation, u.CreationDate AS UserCreationDate, u.DownVotes, u.UpVotes,
         CASE WHEN p.PostTypeId = 1 THEN p.AnswerCount ELSE NULL END AS AnswerCount,
         CASE WHEN p.PostTypeId = 1 THEN p.FavoriteCount ELSE NULL END AS FavoriteCount,
         CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE NULL END AS ViewCount,
         CASE WHEN p.PostTypeId = 2 THEN p.ParentId ELSE NULL END AS ParentId,
         COALESCE(DATEDIFF(p.CreationDate, u.CreationDate), 0) AS UserPostCreationDiff,
         COALESCE(DATEDIFF(p.LastEditDate, p.CreationDate), 0) AS PostEditDiff,
         COALESCE(DATEDIFF(p.LastActivityDate, p.CreationDate), 0) AS PostActivityDiff,
         COALESCE(DATEDIFF(COALESCE(p.ClosedDate, p.LastActivityDate), p.CreationDate), 0) AS PostClosureDiff,
         COALESCE(DATEDIFF(COALESCE(p.CommunityOwnedDate, p.LastActivityDate), p.CreationDate), 0) AS PostCommunityDiff,
         CASE WHEN p.Tags LIKE '%<java>%' THEN 1 ELSE 0 END AS IsJavaTag,
         CASE WHEN p.Tags LIKE '%<python>%' THEN 1 ELSE 0 END AS IsPythonTag,
         CASE WHEN p.Tags LIKE '%<c#>%' THEN 1 ELSE 0 END AS IsCSharpTag,
         CASE WHEN p.Tags LIKE '%<javascript>%' THEN 1 ELSE 0 END AS IsJavaScriptTag,
         CASE WHEN p.Tags LIKE '%<sql>%' THEN 1 ELSE 0 END AS IsSqlTag,
         CASE WHEN p.Tags LIKE '%<php>%' THEN 1 ELSE 0 END AS IsPhpTag,
         CASE WHEN p.Tags LIKE '%<r>%' THEN 1 ELSE 0 END AS IsRTag,
         CASE WHEN p.Tags LIKE '%<swift>%' THEN 1 ELSE 0 END AS IsSwiftTag,
         CASE WHEN p.Tags LIKE '%<scala>%' THEN 1 ELSE 0 END AS IsScalaTag,
         CASE WHEN p.Tags LIKE '%<go>%' THEN 1 ELSE 0 END AS IsGoTag
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
)
SELECT 
  SUM(CASE WHEN AnswerCount IS NOT NULL THEN 1 ELSE 0 END) AS TotalQuestions,
  SUM(CASE WHEN AnswerCount > 0 THEN 1 ELSE 0 END) AS QuestionsWithAnswers,
  AVG(AnswerCount) AS AvgAnswersPerQuestion,
  AVG(FavoriteCount) AS AvgFavoritesPerQuestion,
  AVG(ViewCount) AS AvgViewsPerQuestion,
  AVG(UserPostCreationDiff) AS AvgDaysBetweenUserAndPostCreation,
  AVG(PostEditDiff) AS AvgDaysBetweenPostCreationAndLastEdit,
  AVG(PostActivityDiff) AS AvgDaysBetweenPostCreationAndLastActivity,
  AVG(PostClosureDiff) AS AvgDaysBetweenPostCreationAndClosure,
  AVG(PostCommunityDiff) AS AvgDaysBetweenPostCreationAndCommunityOwnership,
  SUM(IsJavaTag) AS NumJavaPosts,
  SUM(IsPythonTag) AS NumPythonPosts,
  SUM(IsCSharpTag) AS NumCSharpPosts,
  SUM(IsJavaScriptTag) AS NumJavaScriptPosts,
  SUM(IsSqlTag) AS NumSqlPosts,
  SUM(IsPhpTag) AS NumPhpPosts,
  SUM(IsRTag) AS NumRPosts,
  SUM(IsSwiftTag) AS NumSwiftPosts,
  SUM(IsScalaTag) AS NumScalaPosts,
  SUM(IsGoTag) AS NumGoPosts,
  AVG(Reputation) AS AvgReputation,
  AVG(UpVotes) AS AvgUpVotes,
  AVG(DownVotes) AS AvgDownVotes,
  (SELECT COUNT(*) FROM Badges b WHERE b.TagBased = 0) AS NumNamedBadges,
  (SELECT COUNT(*) FROM Badges b WHERE b.TagBased = 1) AS NumTagBadges,
  (SELECT COUNT(*) FROM Votes v WHERE v.VoteTypeId = 2) AS NumUpVotes,
  (SELECT COUNT(*) FROM Votes v WHERE v.VoteTypeId = 3) AS NumDownVotes,
  (SELECT COUNT(*) FROM Votes v WHERE v.VoteTypeId = 5) AS NumFavorites,
  (SELECT COUNT(*) FROM Votes v WHERE v.VoteTypeId = 6) AS NumClosedVotes,
  (SELECT COUNT(*) FROM Votes v WHERE v.VoteTypeId = 7) AS NumReopenVotes,
  (SELECT COUNT(*) FROM Votes v WHERE v.VoteTypeId = 10) AS NumDeletionVotes,
  (SELECT COUNT(*) FROM Votes v WHERE v.VoteTypeId = 11) AS NumUndeletionVotes
FROM cte;