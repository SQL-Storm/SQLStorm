    ua.UserCreationDate,
    ua.TotalPosts,
    ua.TotalComments,
    ua.TotalUpVotesReceived,
    ua.TotalDownVotesReceived,
    ua.ReputationRank,
    ua.YearlyReputationRank,
    pq.PostTypeName,
    pq.Score,
    pq.CommentCount,
    pq.FavoriteCount,
    pq.PostCreationDate,
    pq.AnswerCountForQuestions,
    pq.IsClosed,
    pq.PostRankByUser,
    pq.WeightedScore,
    ts.TagName,
    ts.PostsWithTag,
    ts.DuplicateLinks,
    ts.AvgPostScoreForTag,
    ts.MaxPostViewCountForTag,
    ua.TotalPosts,
    ua.TotalComments,
