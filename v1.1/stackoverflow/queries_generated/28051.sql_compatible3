WITH UserStats AS (
    SELECT 
        u.Id,
        u.Location,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        ROW_NUMBER() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS RankInLocation,
        AVG(u.Reputation) OVER (PARTITION BY u.Location) AS AvgLocationReputation,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END), 0) AS TotalQuestionScore
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.Location, u.Reputation, u.UpVotes, u.DownVotes
), PostActivity AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        p.CreationDate,
        p.LastActivityDate,
        EXTRACT(DAY FROM (p.LastActivityDate - p.CreationDate)) AS ActivityDays,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), '; ') AS CleanedTags,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 5 THEN ph.Id END) AS EditCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes
    FROM Posts p
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId IN (5, 8)
    LEFT JOIN Comments c ON c.PostId = p.Id
    WHERE p.PostTypeId = 1 AND p.ClosedDate IS NULL
    GROUP BY p.Id, p.OwnerUserId, p.CreationDate, p.LastActivityDate, p.Tags
)
SELECT 
    us.Location,
    us.RankInLocation,
    us.GoldBadges,
    pa.CleanedTags,
    AVG(CAST(pa.Upvotes AS NUMERIC) / NULLIF(CAST(pa.CommentCount AS NUMERIC), 0)) AS EngagementRatio,
    MAX(us.TotalQuestionScore) OVER (PARTITION BY us.Location) AS MaxLocationScore,
    CASE 
        WHEN us.Reputation > 100000 THEN 'Legendary' 
        WHEN us.Reputation > 50000 THEN 'Epic' 
        WHEN us.Reputation > 10000 THEN 'Veteran' 
        ELSE 'Regular' 
    END AS ReputationClass,
    SUM(pa.ActivityDays) OVER (ORDER BY pa.CreationDate ROWS UNBOUNDED PRECEDING) AS CumulativeActivityDays
FROM UserStats us
INNER JOIN PostActivity pa ON pa.OwnerUserId = us.Id
WHERE us.Location IS NOT NULL
  AND us.GoldBadges > (SELECT AVG(us2.GoldBadges) FROM UserStats us2)
  AND EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = us.Id AND b.Name LIKE '%Legendary%')
  AND pa.CleanedTags LIKE '%sql%'
UNION ALL
SELECT 
    'META' AS Location,
    NULL AS RankInLocation,
    COUNT(*) AS GoldBadges,
    NULL AS CleanedTags,
    NULL::numeric AS EngagementRatio,
    NULL::numeric AS MaxLocationScore,
    'Community' AS ReputationClass,
    NULL::bigint AS CumulativeActivityDays
FROM Badges b
WHERE b.TagBased = 1
  AND NOT EXISTS (SELECT 1 FROM Users u WHERE u.Id = b.UserId)
ORDER BY EngagementRatio DESC NULLS LAST, ReputationClass;