WITH RecursiveUserBadges AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        b.Class AS BadgeClass,
        COUNT(*) OVER (PARTITION BY u.Id, b.Class) AS BadgeCount,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY b.Class) AS BadgeRank
    FROM Users u
    JOIN Badges b ON u.Id = b.UserId
),
UserTopBadges AS (
    SELECT 
        UserId, 
        DisplayName,
        BadgeClass,
        BadgeCount
    FROM RecursiveUserBadges
    WHERE BadgeRank = 1
),
PopularTags AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        p.ViewCount,
        p.Score,
        p.AnswerCount
    FROM Tags t
    JOIN Posts p ON p.Id = t.ExcerptPostId
    WHERE p.PostTypeId = 1
      AND p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1' YEAR)
      AND t.Count > 1000
),
TopActiveUsers AS (
    SELECT
        u.Id,
        u.DisplayName,
        COUNT(p.Id) AS PostsCount,
        SUM(COALESCE(p.Score,0)) AS TotalScore,
        AVG(COALESCE(p.Score,0)) AS AvgScore
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id
    WHERE p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6' MONTH)
    GROUP BY u.Id, u.DisplayName
    HAVING COUNT(p.Id) > 10
),
HighActivityQuestions AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        q.AnswerCount,
        u.DisplayName AS OwnerName,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = q.Id) AS CommentCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = q.Id AND v.VoteTypeId = 2) AS UpVotes,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = q.Id AND v.VoteTypeId = 3) AS DownVotes
    FROM Posts q
    LEFT JOIN Users u ON u.Id = q.OwnerUserId
    WHERE q.PostTypeId = 1
      AND q.ViewCount > 10000
      AND q.AnswerCount > 5
      AND q.Score > 10
      AND q.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1' YEAR)
),
AnswerStats AS (
    SELECT 
        a.ParentId AS QuestionId,
        COUNT(*) AS AnswerCount,
        AVG(a.Score) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore,
        MIN(a.Score) AS MinAnswerScore
    FROM Posts a
    WHERE a.PostTypeId = 2
    GROUP BY a.ParentId
),
QuestionAnswerCollection AS (
    SELECT
        q.QuestionId,
        q.Title,
        q.OwnerName,
        q.ViewCount,
        q.Score AS QuestionScore,
        q.AnswerCount AS NumAnswers,
        q.CommentCount,
        q.UpVotes,
        q.DownVotes,
        COALESCE(a.AnswerCount, 0) AS TotalAnswers,
        COALESCE(a.AvgAnswerScore, 0) AS AverageAnswerScore,
        COALESCE(a.MaxAnswerScore, 0) AS MaxAnswerScore,
        COALESCE(a.MinAnswerScore, 0) AS MinAnswerScore
    FROM HighActivityQuestions q
    LEFT JOIN AnswerStats a ON q.QuestionId = a.QuestionId
),
UserActivityAndTags AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COUNT(p.Id) AS TotalPosts,
        SUM(COALESCE(p.Score,0)) AS TotalPostScore,
        STRING_AGG(tg.TagName, ', ' ORDER BY tg.TagName) AS TagsUsed
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    LEFT JOIN (
        SELECT
            p2.Id AS PostId,
            DISTINCT_TAGS.TagName
        FROM Posts p2
        CROSS JOIN LATERAL (
            SELECT TRIM(x) AS TagName
            FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(p2.Tags FROM 2 FOR CHAR_LENGTH(p2.Tags)-2), '><')) AS x
        ) DISTINCT_TAGS
    ) tg ON tg.PostId = p.Id
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
UserBadgeAggregates AS (
    SELECT
        UserId,
        SUM(CASE WHEN Class=1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN Class=2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN Class=3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges
    GROUP BY UserId
)
SELECT 
    qac.QuestionId,
    qac.Title AS QuestionTitle,
    qac.OwnerName,
    qac.ViewCount,
    qac.QuestionScore,
    qac.NumAnswers,
    qac.CommentCount,
    qac.UpVotes,
    qac.DownVotes,
    qac.TotalAnswers,
    qac.AverageAnswerScore,
    qac.MaxAnswerScore,
    qac.MinAnswerScore,
    ua.TagsUsed,
    ua.Reputation AS UserReputation,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ua.TotalPosts,
    ua.TotalPostScore,
    ua.CreationDate AS UserCreationDate,
    ua.LastAccessDate
FROM QuestionAnswerCollection qac
LEFT JOIN Users u ON u.DisplayName = qac.OwnerName
LEFT JOIN UserActivityAndTags ua ON ua.UserId = u.Id
LEFT JOIN UserBadgeAggregates ub ON ub.UserId = u.Id
WHERE ua.Reputation IS NOT NULL
GROUP BY
    qac.QuestionId,
    qac.Title,
    qac.OwnerName,
    qac.ViewCount,
    qac.QuestionScore,
    qac.NumAnswers,
    qac.CommentCount,
    qac.UpVotes,
    qac.DownVotes,
    qac.TotalAnswers,
    qac.AverageAnswerScore,
    qac.MaxAnswerScore,
    qac.MinAnswerScore,
    ua.TagsUsed,
    ua.Reputation,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ua.TotalPosts,
    ua.TotalPostScore,
    ua.CreationDate,
    ua.LastAccessDate
ORDER BY qac.ViewCount DESC, qac.QuestionScore DESC
LIMIT 100;