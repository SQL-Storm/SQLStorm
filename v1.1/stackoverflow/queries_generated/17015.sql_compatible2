WITH user_activity AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS post_count,
        COUNT(DISTINCT c.Id) AS comment_count,
        COALESCE(AVG(p.Score), 0) AS avg_post_score,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS reputation_rank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS posting_rank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    WHERE u.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '2 years'
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
question_metrics AS (
    SELECT 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.OwnerUserId,
        STRING_AGG(DISTINCT CAST(t.value AS text), ', ' ORDER BY t.value) AS tag_list,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 1
            ELSE 0
        END AS has_accepted,
        FIRST_VALUE(ph.CreationDate) OVER (
            PARTITION BY p.Id 
            ORDER BY ph.CreationDate DESC
        ) AS last_edit_date,
        LAG(p.Score, 1, 0) OVER (
            PARTITION BY p.OwnerUserId 
            ORDER BY p.CreationDate
        ) AS prev_question_score
    FROM Posts p
    CROSS JOIN LATERAL (
        SELECT unnest(string_to_array(
            CASE 
                WHEN p.Tags IS NOT NULL AND LENGTH(p.Tags) > 2 
                THEN substring(p.Tags FROM 2 FOR length(p.Tags)-2)
                ELSE NULL
            END, '><'
        )) AS value
    ) t
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId 
        AND ph.PostHistoryTypeId IN (4, 5, 6)
    WHERE p.PostTypeId = 1
        AND p.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '1 year'
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.AnswerCount, p.OwnerUserId, p.AcceptedAnswerId, ph.CreationDate
),
top_answerers AS (
    SELECT 
        a.OwnerUserId,
        COUNT(*) AS answer_count,
        SUM(CASE WHEN a.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) AS accepted_count,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY a.Score) AS median_answer_score
    FROM Posts a
    INNER JOIN Posts q ON a.ParentId = q.Id
    WHERE a.PostTypeId = 2
        AND a.OwnerUserId IS NOT NULL
    GROUP BY a.OwnerUserId
    HAVING COUNT(*) >= 10
),
badge_patterns AS (
    SELECT 
        b.UserId,
        b.Name,
        b.Date,
        COUNT(*) OVER (
            PARTITION BY b.UserId, b.Name 
            ORDER BY b.Date 
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS cumulative_badge_count,
        EXTRACT(EPOCH FROM (
            b.Date - LAG(b.Date, 1) OVER (
                PARTITION BY b.UserId, b.Name 
                ORDER BY b.Date
            )
        )) / 86400.0 AS days_since_last_same_badge
    FROM Badges b
    WHERE b.Class IN (1, 2)
)
SELECT DISTINCT
    ua.DisplayName,
    ua.Reputation,
    ua.reputation_rank,
    COALESCE(ua.post_count, 0) AS total_posts,
    COALESCE(ta.answer_count, 0) AS answer_count,
    ROUND(
        CASE 
            WHEN COALESCE(ta.answer_count, 0) > 0 
            THEN (COALESCE(ta.accepted_count, 0) * 1.0 / ta.answer_count) * 100 
            ELSE 0 
        END, 2
    ) AS acceptance_rate,
    COALESCE(ta.median_answer_score, 0) AS median_answer_score,
    SUBSTRING(
        COALESCE(qm.tag_list, 'no-tags'), 
        1, 
        POSITION(',' IN COALESCE(qm.tag_list || ',', ',')) - 1
    ) AS primary_tag,
    COUNT(DISTINCT qm.Id) FILTER (
        WHERE qm.Score > 10 AND qm.ViewCount > 1000
    ) AS high_impact_questions,
    MAX(qm.Score - COALESCE(qm.prev_question_score, 0)) AS max_score_improvement,
    (
        SELECT COUNT(DISTINCT bp.Name)
        FROM badge_patterns bp
        WHERE bp.UserId = ua.Id
            AND bp.days_since_last_same_badge IS NOT NULL
            AND bp.days_since_last_same_badge < 30
    ) AS rapid_badge_acquisitions,
    CASE
        WHEN EXISTS (
            SELECT 1 
            FROM Votes v 
            WHERE v.UserId = ua.Id 
                AND v.VoteTypeId = 8
                AND v.BountyAmount >= 100
        ) THEN 'Generous'
        WHEN ua.avg_post_score > 20 THEN 'High-Quality'
        WHEN ua.posting_rank <= 10 THEN 'Prolific'
        WHEN COALESCE(ta.accepted_count, 0) > 50 THEN 'Helpful'
        ELSE 'Regular'
    END AS user_category,
    COALESCE(
        (
            SELECT STRING_AGG(CAST(pl.LinkTypeId AS text) || ':' || CAST(pl.RelatedPostId AS text), '; ' ORDER BY pl.CreationDate DESC)
            FROM PostLinks pl
            WHERE pl.PostId IN (
                SELECT p2.Id 
                FROM Posts p2 
                WHERE p2.OwnerUserId = ua.Id
                LIMIT 5
            )
        ), 
        'no-links'
    ) AS recent_post_links
FROM user_activity ua
LEFT JOIN top_answerers ta ON ua.Id = ta.OwnerUserId
LEFT JOIN question_metrics qm ON ua.Id = qm.OwnerUserId
WHERE ua.Reputation > 100
    AND (
        ua.post_count > 5 
        OR COALESCE(ta.answer_count, 0) > 5 
        OR ua.comment_count > 20
    )
    AND NOT EXISTS (
        SELECT 1
        FROM PostHistory ph
        WHERE ph.UserId = ua.Id
            AND ph.PostHistoryTypeId IN (12, 13)
            AND ph.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '30 days'
    )
GROUP BY 
    ua.Id, ua.DisplayName, ua.Reputation, ua.reputation_rank,
    ua.post_count, ua.avg_post_score, ua.posting_rank,
    ua.comment_count, ta.answer_count, ta.accepted_count,
    ta.median_answer_score, qm.Id, qm.Score, qm.ViewCount, qm.prev_question_score, qm.tag_list
HAVING 
    COUNT(DISTINCT qm.Id) > 0 
    OR COALESCE(ta.answer_count, 0) > 0
ORDER BY 
    ua.Reputation DESC,
    COALESCE(ta.accepted_count, 0) DESC,
    ua.post_count DESC
LIMIT 100;