WITH recent_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    u.Views,
    p.OwnerUserId,
    u.DisplayName AS OwnerName,
    pc.Count AS CommentCount
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN (
    SELECT PostId, COUNT(*) AS Count
    FROM Comments
    GROUP BY PostId
  ) pc ON p.Id = pc.PostId
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY
),
tag_burst AS (
  SELECT
    t.TagName,
    t.Count,
    t2.PostId
  FROM Tags t
  JOIN (
    SELECT p2.Id AS PostId, p2.Tags
    FROM Posts p2
  ) t2 ON POSITION(t.TagName IN COALESCE(t2.Tags, '')) > 0
  WHERE t.IsModeratorOnly = 0
),
activity AS (
  SELECT
    r.PostId,
    r.Title,
    r.OwnerName,
    r.CreationDate,
    r.CommentCount,
    r.Score,
    r.Views
  FROM recent_questions r
  LEFT JOIN PostHistory ph
    ON ph.PostId = r.PostId
  LEFT JOIN PostLinks pl
    ON pl.PostId = r.PostId
  WHERE ph.Id IS NULL
    OR ph.CreationDate = (
      SELECT MAX(ph2.CreationDate) FROM PostHistory ph2 WHERE ph2.PostId = r.PostId
    )
),
complex AS (
  SELECT
    a.PostId,
    a.Title,
    a.OwnerName,
    a.CreationDate,
    a.CommentCount,
    a.Score,
    a.Views,
    ROW_NUMBER() OVER (PARTITION BY a.OwnerName ORDER BY a.Views DESC, a.Score DESC) AS rn,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) OVER (PARTITION BY a.PostId) AS UpVotesForPost,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) OVER (PARTITION BY a.PostId) AS DownVotesForPost
  FROM activity a
  LEFT JOIN Votes v ON v.PostId = a.PostId
  LEFT JOIN PostLinks pl ON pl.PostId = a.PostId
)
SELECT
  c.PostId,
  c.Title,
  c.OwnerName,
  c.CreationDate,
  c.CommentCount,
  c.Score,
  c.Views,
  c.UpVotesForPost,
  c.DownVotesForPost,
  CASE
    WHEN c.Score > 50 THEN 'Hot'
    WHEN c.Views > 10000 THEN 'Popular'
    ELSE 'New/Medium'
  END AS TrendBucket,
  STRING_AGG(DISTINCT t.TagName, ',') AS TagsOnPost,
  COUNT(*) OVER () AS TotalPostsInBenchmark
FROM complex c
LEFT JOIN Tags t ON t.ExcerptPostId = c.PostId OR t.WikiPostId = c.PostId
WHERE c.rn = 1
GROUP BY
  c.PostId,
  c.Title,
  c.OwnerName,
  c.CreationDate,
  c.CommentCount,
  c.Score,
  c.Views,
  c.UpVotesForPost,
  c.DownVotesForPost
ORDER BY c.Views DESC, c.Score DESC
LIMIT 100;