WITH ActiveUsers AS (
    SELECT u.Id, u.DisplayName, u.Reputation, u.Location,
           COUNT(b.Id) AS BadgeCount,
           RANK() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS LocationRank
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId AND b.Date >= (CAST('2024-10-01' AS DATE) - INTERVAL '1' YEAR)
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
    HAVING COUNT(b.Id) > 5
)
SELECT au.DisplayName, au.Reputation, au.Location, au.Id,
       COUNT(DISTINCT p.Id) AS QuestionCount,
       COUNT(DISTINCT c.Id) AS CommentCount,
       SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvotesGiven,
       SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS ClosedPosts,
       AVG(p.Score) AS AvgQuestionScore,
       SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS AcceptedAnswers,
       -- emulate STRING_AGG(DISTINCT ...) where not supported by using LISTAGG over aggregated distinct tag names if possible;
       -- here we use a correlated subquery to produce a comma-separated distinct tag list in standard SQL
       (SELECT LISTAGG(t2.TagName, ', ') WITHIN GROUP (ORDER BY t2.TagName)
        FROM (
            SELECT DISTINCT t3.TagName
            FROM Posts pt2
            JOIN Tags t3 ON pt2.Tags LIKE '%' || '<' || t3.TagName || '>' || '%'
            WHERE pt2.PostTypeId = 1
              AND pt2.OwnerUserId = au.Id
              AND pt2.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '1' YEAR)
        ) t2
       ) AS TopTags
FROM ActiveUsers au
LEFT JOIN Posts p ON au.Id = p.OwnerUserId
     AND p.PostTypeId = 1
     AND p.Score > 5
     AND p.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '1' YEAR)
LEFT JOIN Comments c ON au.Id = c.UserId AND c.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '1' YEAR)
LEFT JOIN Votes v ON au.Id = v.UserId AND v.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '1' YEAR)
LEFT JOIN PostHistory ph ON au.Id = ph.UserId
LEFT JOIN Posts pt ON ph.PostId = pt.Id AND pt.PostTypeId = 1
-- removed direct join to Tags here because TopTags is produced by a subquery
GROUP BY au.DisplayName, au.Reputation, au.Location, au.Id
ORDER BY (COUNT(DISTINCT p.Id) + COUNT(DISTINCT c.Id) + SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END)) DESC,
         AVG(p.Score) DESC
LIMIT 100;