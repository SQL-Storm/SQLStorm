WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.Reputation, u.UpVotes, u.DownVotes
),
PostMetrics AS (
    SELECT 
        p.OwnerUserId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) AS TotalVotes,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS Upvotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS Downvotes
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1' YEAR)
    GROUP BY p.OwnerUserId
),
ClosedPosts AS (
    SELECT 
        ph.PostId,
        FIRST_VALUE(ph.Comment) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate) AS FirstCloseReason,
        CAST(REGEXP_SUBSTR(ph.Comment, '[0-9]+') AS SMALLINT) AS CloseReasonId
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10
),
PostTags AS (
    -- normalize post tags into rows: support different SQL dialects by using REPLACE and string splitting where available
    SELECT
        p.Id AS PostId,
        TRIM(tag) AS TagText
    FROM Posts p
    CROSS APPLY (
        -- convert '<tag1><tag2>' to 'tag1,tag2' then split; replace functions may differ by dialect
        SELECT VALUE AS tag FROM (
            SELECT
                -- for dialects without STRING_SPLIT, this will need to be adapted; here we use a generic split mechanism placeholder
                -- assume a function STRING_SPLIT exists; if not, replace CROSS APPLY/STRING_SPLIT with the appropriate table-valued function.
                STRING_SPLIT(REPLACE(REPLACE(p.Tags, '><', ','), '<>', ''), ',') 
            ) ss(VALUE)
    ) split_tags
),
TagCounts AS (
    SELECT
        pt.TagText AS TagName,
        COUNT(DISTINCT pt.PostId) AS Count
    FROM PostTags pt
    GROUP BY pt.TagText
),
TopTagsPerPostOwner AS (
    SELECT
        p.OwnerUserId,
        tc.TagName,
        tc.Count,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY tc.Count DESC, tc.TagName) AS rn
    FROM Posts p
    JOIN PostTags pt ON p.Id = pt.PostId
    JOIN TagCounts tc ON pt.TagText = tc.TagName
    WHERE p.PostTypeId = 1
)
SELECT 
    u.Id,
    u.DisplayName,
    us.Reputation,
    COALESCE(pm.TotalPosts, 0) AS TotalPosts,
    (us.UpVotes + us.DownVotes) * 1.0 / NULLIF(us.Reputation, 0) AS VoteToRepRatio,
    RANK() OVER (ORDER BY us.Reputation DESC) AS GlobalRank,
    DENSE_RANK() OVER (PARTITION BY u.Location ORDER BY us.Reputation DESC) AS LocalRank,
    (SELECT b2.Name FROM Badges b2 WHERE b2.UserId = u.Id ORDER BY b2.Date DESC FETCH FIRST 1 ROWS ONLY) AS LatestBadge,
    STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 1 FOR 20), '; ') AS TagSnippets,
    -- aggregate top 3 tags per user using collected TopTagsPerPostOwner entries
    (SELECT STRING_AGG(t2.TagName, ', ')
     FROM (
         SELECT TagName FROM TopTagsPerPostOwner ttp
         JOIN Posts p2 ON p2.OwnerUserId = ttp.OwnerUserId
         WHERE ttp.OwnerUserId = u.Id AND ttp.rn <= 3
         GROUP BY ttp.TagName, ttp.rn
         ORDER BY ttp.rn
     ) t2
    ) AS TopTags,
    COALESCE(cp.CloseReasonId, -1) AS CloseReason,
    CASE 
        WHEN EXISTS (SELECT 1 FROM Posts p2 WHERE p2.OwnerUserId = u.Id AND p2.PostTypeId = 2 AND p2.Score > 10)
        THEN (SELECT MAX(p2.Score) FROM Posts p2 WHERE p2.OwnerUserId = u.Id AND p2.PostTypeId = 2)
        ELSE NULL 
    END AS MaxAnswerScore,
    (SELECT COUNT(*) FROM PostLinks pl 
     WHERE pl.LinkTypeId = 3 AND pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id)) AS DupeLinksCreated
FROM Users u
LEFT JOIN UserStats us ON u.Id = us.UserId
LEFT JOIN PostMetrics pm ON u.Id = pm.OwnerUserId
LEFT JOIN (
    -- pick one CloseReason per user: earliest per post owned by user
    SELECT DISTINCT ON (owner.OwnerUserId, cp2.PostId) owner.OwnerUserId, cp2.PostId, cp2.CloseReasonId
    FROM (
        SELECT OwnerUserId, Id AS PostId FROM Posts
    ) owner
    JOIN ClosedPosts cp2 ON cp2.PostId = owner.PostId
) cp ON cp.OwnerUserId = u.Id
LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
LEFT JOIN Tags t ON t.TagName = (
    -- join is retained for TagSnippets computation; placeholder equality to satisfy SQL; actual tag parsing is in PostTags
    NULL
)
WHERE u.Reputation BETWEEN 1000 AND 100000
  AND u.WebsiteUrl IS NOT NULL
  AND (u.Location LIKE 'New York%' OR u.Location LIKE 'London%' OR u.Location LIKE 'Paris%')
  AND (us.GoldBadges > 0 OR us.SilverBadges > 5)
GROUP BY u.Id, u.DisplayName, us.Reputation, pm.TotalPosts, us.UpVotes, us.DownVotes, cp.CloseReasonId, u.Location
HAVING COUNT(DISTINCT p.Id) > 10 OR COUNT(DISTINCT cp.PostId) > 2
ORDER BY us.Reputation DESC
FETCH FIRST 100 ROWS ONLY;