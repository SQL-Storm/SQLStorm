-- {"query": "16041.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "claude-4.5-sonnet", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 98070, "output_tokens": 91951} 
WITH user_activity_metrics AS (
  SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetVotes,
    EXTRACT(YEAR FROM u.CreationDate) AS JoinYear,
    CASE 
      WHEN u.Reputation >= 10000 THEN 'Elite'
      WHEN u.Reputation >= 1000 THEN 'Advanced'
      WHEN u.Reputation >= 100 THEN 'Intermediate'
      ELSE 'Beginner'
    END AS ReputationTier,
    ROW_NUMBER() OVER (PARTITION BY EXTRACT(YEAR FROM u.CreationDate) ORDER BY u.Reputation DESC) AS YearRank
  FROM Users u
  WHERE u.Reputation > 0
),
post_statistics AS (
  SELECT 
    p.OwnerUserId,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
    AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
    AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS AvgAnswerScore,
    MAX(p.ViewCount) AS MaxViews,
    SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL AND p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsWithAcceptedAnswer,
    STRING_AGG(DISTINCT SUBSTRING(COALESCE(p.Tags, ''), 1, 50), ', ') AS TopTags
  FROM Posts p
  WHERE p.OwnerUserId IS NOT NULL 
    AND p.CreationDate >= TIMESTAMP '2020-01-01'
  GROUP BY p.OwnerUserId
),
badge_analysis AS (
  SELECT 
    b.UserId,
    COUNT(*) AS TotalBadges,
    COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
    COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
    COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
    COUNT(CASE WHEN b.TagBased = 1 THEN 1 END) AS TagBasedBadges,
    MAX(b.Date) AS LastBadgeDate,
    PERCENT_RANK() OVER (ORDER BY COUNT(*)) AS BadgePercentile
  FROM Badges b
  GROUP BY b.UserId
),
engagement_scores AS (
  SELECT 
    v.UserId,
    COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpvotesGiven,
    COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownvotesGiven,
    COUNT(CASE WHEN v.VoteTypeId = 5 THEN 1 END) AS FavoritesMarked,
    SUM(CASE WHEN v.VoteTypeId = 8 THEN COALESCE(v.BountyAmount, 0) ELSE 0 END) AS TotalBountiesOffered,
    DENSE_RANK() OVER (ORDER BY COUNT(*) DESC) AS EngagementRank
  FROM Votes v
  WHERE v.UserId IS NOT NULL
  GROUP BY v.UserId
),
answer_acceptance_rate AS (
  SELECT 
    ans.OwnerUserId,
    COUNT(*) AS TotalAnswers,
    SUM(CASE WHEN q.AcceptedAnswerId = ans.Id THEN 1 ELSE 0 END) AS AcceptedAnswers,
    CASE 
      WHEN COUNT(*) > 0 THEN 
        ROUND(100.0 * SUM(CASE WHEN q.AcceptedAnswerId = ans.Id THEN 1 ELSE 0 END) / COUNT(*), 2)
      ELSE NULL
    END AS AcceptanceRate
  FROM Posts ans
  INNER JOIN Posts q ON ans.ParentId = q.Id
  WHERE ans.PostTypeId = 2 
    AND ans.OwnerUserId IS NOT NULL
  GROUP BY ans.OwnerUserId
  HAVING COUNT(*) >= 5
)
SELECT 
  uam.DisplayName,
  uam.ReputationTier,
  uam.Reputation,
  COALESCE(ps.QuestionCount, 0) AS Questions,
  COALESCE(ps.AnswerCount, 0) AS Answers,
  ROUND(COALESCE(ps.AvgQuestionScore, 0)::numeric, 2) AS AvgQScore,
  ROUND(COALESCE(ps.AvgAnswerScore, 0)::numeric, 2) AS AvgAScore,
  COALESCE(ba.TotalBadges, 0) AS Badges,
  CONCAT(COALESCE(ba.GoldBadges, 0), 'G/', COALESCE(ba.SilverBadges, 0), 'S/', COALESCE(ba.BronzeBadges, 0), 'B') AS BadgeBreakdown,
  ROUND(COALESCE(aar.AcceptanceRate, 0)::numeric, 2) AS AcceptRate,
  COALESCE(es.UpvotesGiven, 0) AS UpvotesGiven,
  COALESCE(es.TotalBountiesOffered, 0) AS BountiesOffered,
  uam.NetVotes,
  (SELECT COUNT(*) 
   FROM Comments c 
   WHERE c.UserId = uam.Id 
     AND c.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '365 days') AS RecentComments,
  (SELECT STRING_AGG(pt.Name, ', ') 
   FROM Posts p2
   INNER JOIN PostTypes pt ON p2.PostTypeId = pt.Id
   WHERE p2.OwnerUserId = uam.Id
   GROUP BY p2.OwnerUserId) AS PostTypes,
  CASE 
    WHEN ba.BadgePercentile >= 0.9 AND uam.Reputation >= 5000 THEN 'Highly Active Contributor'
    WHEN ps.QuestionCount > ps.AnswerCount * 2 THEN 'Question Focused'
    WHEN ps.AnswerCount > ps.QuestionCount * 2 THEN 'Answer Focused'
    WHEN COALESCE(aar.AcceptanceRate, 0) >= 50 THEN 'Solution Provider'
    ELSE 'Balanced Contributor'
  END AS UserProfile,
  NTILE(10) OVER (ORDER BY uam.Reputation DESC) AS ReputationDecile
FROM user_activity_metrics uam
LEFT OUTER JOIN post_statistics ps ON uam.Id = ps.OwnerUserId
LEFT OUTER JOIN badge_analysis ba ON uam.Id = ba.UserId
LEFT OUTER JOIN engagement_scores es ON uam.Id = es.UserId
LEFT OUTER JOIN answer_acceptance_rate aar ON uam.Id = aar.OwnerUserId
WHERE uam.YearRank <= 100
  AND (ps.QuestionCount IS NOT NULL OR ps.AnswerCount IS NOT NULL)
  AND NOT EXISTS (
    SELECT 1 
    FROM Votes v2 
    WHERE v2.UserId = uam.Id 
      AND v2.VoteTypeId IN (4, 12)
      AND v2.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '180 days'
  )
ORDER BY 
  CASE 
    WHEN ba.TotalBadges IS NULL THEN 1 
    ELSE 0 
  END,
  (COALESCE(ps.QuestionCount, 0) + COALESCE(ps.AnswerCount, 0) * 1.5 + COALESCE(ba.TotalBadges, 0) * 0.5) DESC,
  uam.Reputation DESC
LIMIT 500;