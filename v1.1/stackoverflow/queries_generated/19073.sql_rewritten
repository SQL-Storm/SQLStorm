-- {"query": "19073.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3392} 
WITH UserEngagement AS (
    -- CTE 1: Calculates advanced engagement metrics for users, including posting activity, badge distribution, and weighted average scores.
    -- Filters for users with a reputation above a certain threshold to focus on established contributors.
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.Views AS UserProfileViews,
        U.UpVotes AS UserUpVotesGiven,
        U.DownVotes AS UserDownVotesGiven,
        COUNT(DISTINCT P.Id) AS TotalPostsCreated,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COUNT(CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestionsAsked,
        COUNT(CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswersProvided,
        SUM(P.Score) AS TotalPostsScore,
        -- Weighted average score, giving more weight to recent posts (decay factor for older posts)
        SUM(P.Score * (1 + EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - P.CreationDate)) / 86400.0 / 365.25 * -0.1)) / NULLIF(COUNT(P.Id), 0) AS WeightedAvgPostScore,
        MAX(P.CreationDate) AS LatestPostDate,
        COUNT(DISTINCT B.Id) AS TotalBadgesEarned,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN B.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN B.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        MAX(U.LastAccessDate) AS UserLastAccessDate
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.Views, U.UpVotes, U.DownVotes
    HAVING U.Reputation > 5000 AND U.LastAccessDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 years') -- Filter for active, influential users
),
PostLifeCycleEvents AS (
    -- CTE 2: Captures a chronological sequence of significant post history events, identifying patterns like edits, closure, and reopening.
    -- Uses window functions to look at previous and next events.
    SELECT
        PH.PostId,
        PH.CreationDate AS EventTimestamp,
        PHT.Name AS EventType,
        PH.UserId AS EventInitiatorUserId,
        PH.Comment AS EventComment,
        LEAD(PHT.Name, 1) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS NextEventType,
        LAG(PHT.Name, 1) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PreviousEventType,
        ROW_NUMBER() OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate DESC) AS rn_latest_event,
        COUNT(PH.Id) OVER (PARTITION BY PH.PostId) AS TotalHistoryEvents
    FROM PostHistory PH
    JOIN PostHistoryTypes PHT ON PH.PostHistoryTypeId = PHT.Id
    WHERE PHT.Id IN (1, 2, 5, 6, 10, 11, 12, 13, 14, 15, 19, 20, 24, 35, 36) -- Various types: initial, edits, close/reopen, delete/undelete, lock/unlock, protect/unprotect, suggested edit applied, migration.
),
FrequentPostEventSummary AS (
    -- CTE 3: Summarizes the frequency of different history events for each post and detects specific event sequences.
    SELECT
        PLE.PostId,
        COUNT(CASE WHEN PLE.EventType LIKE '%Edit%' THEN 1 END) AS TotalEditEvents,
        COUNT(CASE WHEN PLE.EventType = 'Post Closed' THEN 1 END) AS ClosureCount,
        COUNT(CASE WHEN PLE.EventType = 'Post Reopened' THEN 1 END) AS ReopenCount,
        COUNT(DISTINCT PLE.EventInitiatorUserId) AS DistinctEditorsCount,
        MAX(CASE WHEN PLE.EventType = 'Post Closed' AND PLE.NextEventType = 'Post Reopened' THEN 1 ELSE 0 END) AS HadCloseReopenCycle,
        MAX(CASE WHEN PLE.EventType = 'Post Locked' THEN PLE.EventTimestamp END) AS LastLockedDate,
        MIN(CASE WHEN PLE.EventType = 'Initial Body' THEN PLE.EventTimestamp END) AS FirstCreationDate
    FROM PostLifeCycleEvents PLE
    GROUP BY PLE.PostId
),
TagDominanceMetrics AS (
    -- CTE 4: Calculates tag-specific performance metrics, considering posts where the tag is likely the primary one (first in the 'Tags' string).
    SELECT
        T.Id AS TagId,
        T.TagName,
        T.Count AS TagUseCount,
        AVG(P.Score) AS AvgTagScore,
        AVG(P.ViewCount) AS AvgTagViewCount,
        COUNT(P.Id) AS PostsWithThisTag,
        AVG(P.AnswerCount) AS AvgAnswersPerTagPost
    FROM Tags T
    JOIN Posts P ON P.Tags LIKE '%<' || T.TagName || '>%' -- Indirect join using string matching
    WHERE P.PostTypeId = 1 -- Only questions contribute to tag dominance
    GROUP BY T.Id, T.TagName, T.Count
),
CommentSentimentAnalysis AS (
    -- CTE 5: A simplified "sentiment" analysis on comments, looking for positive/negative keywords.
    -- This is a placeholder for a more complex text analysis, useful for benchmarking string functions.
    SELECT
        C.PostId,
        SUM(CASE
                WHEN C.Text ILIKE '%great%' OR C.Text ILIKE '%helpful%' OR C.Text ILIKE '%thanks%' THEN 1
                WHEN C.Text ILIKE '%bug%' OR C.Text ILIKE '%issue%' OR C.Text ILIKE '%wrong%' THEN -1
                ELSE 0
            END) AS NetCommentSentimentScore,
        COUNT(C.Id) AS TotalCommentsOnPost,
        MAX(C.CreationDate) AS LatestCommentDate
    FROM Comments C
    GROUP BY C.PostId
)
SELECT
    P.Id AS PostIdentifier,
    PT.Name AS PostCategory,
    P.Title,
    P.CreationDate AS OriginalPostDate,
    P.LastActivityDate AS LastInteractionDate,
    P.Score AS CurrentPostScore,
    P.ViewCount AS TotalViews,
    P.AnswerCount AS NumberOfAnswers,
    P.CommentCount AS NumberOfComments,
    P.FavoriteCount AS BookmarkedCount,
    UE.DisplayName AS PostOwnerName,
    UE.Reputation AS PostOwnerReputation,
    UE.TotalQuestionsAsked AS OwnerQuestions,
    UE.TotalAnswersProvided AS OwnerAnswers,
    FPE.TotalEditEvents,
    FPE.ClosureCount,
    FPE.ReopenCount,
    FPE.HadCloseReopenCycle,
    FPE.DistinctEditorsCount,
    TD.TagName AS PrimaryTag,
    TD.AvgTagScore AS PrimaryTagAvgScore,
    TD.AvgTagViewCount AS PrimaryTagAvgViews,
    CSA.NetCommentSentimentScore,
    CSA.TotalCommentsOnPost,
    COALESCE(PL_Linked.LinkedPostCount, 0) AS OutboundLinks,
    COALESCE(PL_Duplicate.InboundDuplicateLinks, 0) AS InboundDuplicateOfOtherPosts,
    (
        -- Correlated subquery: Fetches the most recent `PostHistory` comment if available, excluding initial creation types.
        SELECT PH.Comment
        FROM PostHistory PH
        WHERE PH.PostId = P.Id
          AND PH.PostHistoryTypeId NOT IN (1, 2, 3) -- Exclude initial title/body/tags
        ORDER BY PH.CreationDate DESC
        LIMIT 1
    ) AS LatestHistoryComment,
    -- Advanced calculated metric: Post "Quality Score" combining various factors
    (
        CAST(P.Score AS NUMERIC) * 0.4 +
        CAST(P.FavoriteCount AS NUMERIC) * 0.3 +
        CAST(P.AnswerCount AS NUMERIC) * 0.2 +
        CAST(P.CommentCount AS NUMERIC) * 0.1
    ) * (1 + COALESCE(CSA.NetCommentSentimentScore, 0) / NULLIF(CSA.TotalCommentsOnPost, 0)::NUMERIC * 0.2)
    AS WeightedQualityScore,
    -- Conditional Post Status based on multiple criteria including history and user engagement
    CASE
        WHEN FPE.HadCloseReopenCycle = 1 AND FPE.ClosureCount >= 2 THEN 'Volatile & Repeatedly Closed'
        WHEN P.ClosedDate IS NOT NULL AND P.CommunityOwnedDate IS NULL THEN 'Closed by Community/Mods'
        WHEN P.AnswerCount >= 10 AND P.FavoriteCount >= 20 AND UE.Reputation > 10000 THEN 'Highly Valued & Influential'
        WHEN FPE.TotalEditEvents >= 5 AND FPE.DistinctEditorsCount >= 3 THEN 'Heavily Edited & Collaborative'
        WHEN P.ViewCount > 5000 AND P.Score > 100 THEN 'Viral & Top Rated'
        ELSE 'Standard Activity'
    END AS PostLifecycleStatus,
    -- String manipulation and NULL-aware extraction
    UPPER(SUBSTRING(P.Title, 1, 1)) || '...' || LOWER(REVERSE(SUBSTRING(REVERSE(P.Title), 1, 1))) AS TitleStartEndChars,
    LENGTH(P.Body) AS BodyCharacterCount,
    LENGTH(P.Tags) AS TagsStringLength,
    COALESCE(P.OwnerDisplayName, 'Community') AS ActualOwnerDisplayName,
    -- Window function: Rank posts by their 'WeightedQualityScore' within the primary tag they belong to
    RANK() OVER (PARTITION BY TD.TagName ORDER BY (
        CAST(P.Score AS NUMERIC) * 0.4 + CAST(P.FavoriteCount AS NUMERIC) * 0.3 + CAST(P.AnswerCount AS NUMERIC) * 0.2 + CAST(P.CommentCount AS NUMERIC) * 0.1
    ) DESC, P.CreationDate ASC) AS RankWithinPrimaryTag,
    -- Window function: Calculate average `WeightedQualityScore` for posts by the same owner in the last 6 months
    AVG((
        CAST(P_OwnerRecent.Score AS NUMERIC) * 0.4 + CAST(P_OwnerRecent.FavoriteCount AS NUMERIC) * 0.3 + CAST(P_OwnerRecent.AnswerCount AS NUMERIC) * 0.2 + CAST(P_OwnerRecent.CommentCount AS NUMERIC) * 0.1
    )) OVER (PARTITION BY P.OwnerUserId ORDER BY P.CreationDate RANGE BETWEEN INTERVAL '6 months' PRECEDING AND CURRENT ROW) AS OwnerRecentAvgQualityScore,
    -- Window function: Difference in score from the previous post by the same owner
    P.Score - LAG(P.Score, 1, 0) OVER (PARTITION BY P.OwnerUserId ORDER BY P.CreationDate) AS ScoreDeltaFromPreviousPost
FROM Posts P
JOIN PostTypes PT ON P.PostTypeId = PT.Id
LEFT JOIN UserEngagement UE ON P.OwnerUserId = UE.UserId
LEFT JOIN FrequentPostEventSummary FPE ON P.Id = FPE.PostId
LEFT JOIN CommentSentimentAnalysis CSA ON P.Id = CSA.PostId
LEFT JOIN (
    -- Subquery for outbound linked posts
    SELECT PostId, COUNT(RelatedPostId) AS LinkedPostCount
    FROM PostLinks
    WHERE LinkTypeId = 1 -- Linked
    GROUP BY PostId
) PL_Linked ON P.Id = PL_Linked.PostId
LEFT JOIN (
    -- Subquery for inbound duplicate links
    SELECT RelatedPostId, COUNT(PostId) AS InboundDuplicateLinks
    FROM PostLinks
    WHERE LinkTypeId = 3 -- Duplicate
    GROUP BY RelatedPostId
) PL_Duplicate ON P.Id = PL_Duplicate.RelatedPostId
LEFT JOIN (
    -- Lateral join to find the *first* tag for a post and its associated TagDominanceMetrics
    SELECT DISTINCT ON (P_Inner.Id) P_Inner.Id AS PostId, TDM.TagName, TDM.AvgTagScore, TDM.AvgTagViewCount
    FROM Posts P_Inner
    CROSS JOIN LATERAL (
        SELECT TRIM(REPLACE(REPLACE(UNNEST(string_to_array(SUBSTRING(P_Inner.Tags, 2, LENGTH(P_Inner.Tags)-2), '><')), '<', ''), '>', '')) AS primary_tag_name
        WHERE P_Inner.Tags IS NOT NULL AND P_Inner.Tags != ''
        LIMIT 1 -- Assuming the first tag listed is the primary one
    ) AS PrimaryTagAlias(primary_tag_name)
    JOIN TagDominanceMetrics TDM ON PrimaryTagAlias.primary_tag_name = TDM.TagName
) TD ON P.Id = TD.PostId
LEFT JOIN Posts P_OwnerRecent ON P.OwnerUserId = P_OwnerRecent.OwnerUserId
    AND P_OwnerRecent.CreationDate BETWEEN (P.CreationDate - INTERVAL '6 months') AND P.CreationDate
    AND P_OwnerRecent.PostTypeId = P.PostTypeId
WHERE
    P.PostTypeId IN (1, 2) -- Focus on Questions and Answers
    AND P.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years') -- Consider relatively recent posts
    AND P.Score >= 10 -- Only posts with meaningful engagement
    AND (P.ViewCount > 1000 OR P.FavoriteCount > 5 OR FPE.HadCloseReopenCycle = 1) -- Criteria for active posts
    AND P.OwnerUserId IS NOT NULL -- Exclude posts without a recorded owner (e.g., deleted users or community posts in some contexts)
    AND P.Id NOT IN (SELECT PostId FROM FrequentPostEventSummary WHERE TotalHistoryEvents = 0 AND CreationDate < (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year')) -- Exclude very old inactive posts
    AND (
        P.Body ILIKE '%database performance%' OR P.Title ILIKE '%sql optimization%' OR P.Tags ILIKE '%<benchmark>%' OR P.Tags ILIKE '%<performance-testing>%'
    ) -- Content-specific filtering
ORDER BY WeightedQualityScore DESC, P.LastActivityDate DESC, RankWithinPrimaryTag ASC
LIMIT 5000;