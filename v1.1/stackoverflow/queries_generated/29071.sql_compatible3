WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT v.Id) AS VoteCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        MAX(v.CreationDate) AS LastVoteDate,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - MAX(p.CreationDate))) / 86400
            ELSE NULL 
        END AS DaysSinceLastPost,
        CASE 
            WHEN COUNT(DISTINCT c.Id) > 0 THEN EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - MAX(c.CreationDate))) / 86400
            ELSE NULL 
        END AS DaysSinceLastComment,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT b.Id) DESC) AS BadgeRank,
        RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT v.Id) DESC) AS VoteRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopPosts AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostType,
        CASE 
            WHEN p.Score >= 100 THEN 'HighlyVoted'
            WHEN p.Score >= 50 THEN 'ModeratelyVoted'
            WHEN p.Score >= 10 THEN 'LowVoted'
            ELSE 'Unvoted'
        END AS VoteCategory,
        STRING_AGG(SUBSTRING(t.TagName FROM 1 FOR 10), ', ') AS TagsList
    FROM Posts p
    LEFT JOIN (
        SELECT 
            Id,
            TRIM(BOTH '<>' FROM Tags) AS TagsList
        FROM Posts 
        WHERE PostTypeId = 1 AND Tags IS NOT NULL
    ) tag_extract ON p.Id = tag_extract.Id
    LEFT JOIN (
        SELECT 
            Id,
            TRIM(BOTH '<>' FROM Tags) AS TagsList,
            Tags AS TagName,
            Id AS t_Id
        FROM Posts 
        WHERE PostTypeId = 1 AND Tags IS NOT NULL
    ) t ON p.Id = t.t_Id
    WHERE p.PostTypeId IN (1, 2) AND p.Score IS NOT NULL
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, p.OwnerUserId, p.PostTypeId, p.Tags, p.AnswerCount, p.CommentCount, p.FavoriteCount, p.ParentId
),
ComplexUserAnalysis AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.PostCount,
        uas.CommentCount,
        uas.BadgeCount,
        uas.VoteCount,
        uas.LastPostDate,
        uas.LastCommentDate,
        uas.LastVoteDate,
        uas.DaysSinceLastPost,
        uas.DaysSinceLastComment,
        uas.PostRank,
        uas.BadgeRank,
        uas.ReputationRank,
        uas.VoteRank,
        CASE 
            WHEN uas.PostCount > 100 THEN 'Veteran'
            WHEN uas.PostCount > 50 THEN 'Experienced'
            WHEN uas.PostCount > 10 THEN 'Active'
            ELSE 'New'
        END AS UserCategory,
        CASE 
            WHEN uas.Reputation >= 10000 THEN 'Expert'
            WHEN uas.Reputation >= 5000 THEN 'Advanced'
            WHEN uas.Reputation >= 1000 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS ReputationTier,
        CASE 
            WHEN uas.BadgeCount >= 20 THEN 'Awarded'
            WHEN uas.BadgeCount >= 10 THEN 'Recognized'
            WHEN uas.BadgeCount >= 5 THEN 'Contributor'
            ELSE 'Observer'
        END AS RecognitionStatus,
        CASE 
            WHEN uas.VoteCount > 1000 THEN 'Influential'
            WHEN uas.VoteCount > 500 THEN 'ActiveVoter'
            WHEN uas.VoteCount > 100 THEN 'RegularVoter'
            ELSE 'OccasionalVoter'
        END AS VotingPattern
    FROM UserActivityStats uas
    WHERE uas.Reputation > 1000
),
PostAnalysis AS (
    SELECT 
        tp.PostId,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        tp.CreationDate,
        tp.OwnerUserId,
        tp.PostType,
        tp.VoteCategory,
        tp.TagsList,
        tp.AnswerCount,
        tp.CommentCount,
        tp.FavoriteCount,
        tp.ParentId,
        CASE 
            WHEN tp.ViewCount > 1000 THEN 'Popular'
            WHEN tp.ViewCount > 500 THEN 'ModeratelyPopular'
            WHEN tp.ViewCount > 100 THEN 'UnderViewed'
            ELSE 'RarelyViewed'
        END AS PopularityLevel,
        CASE 
            WHEN tp.AnswerCount > 5 THEN 'WellAnswered'
            WHEN tp.AnswerCount > 2 THEN 'Answered'
            WHEN tp.AnswerCount = 1 THEN 'SingleAnswered'
            ELSE 'Unanswered'
        END AS AnswerStatus,
        CASE 
            WHEN tp.CommentCount > 10 THEN 'HeavilyCommented'
            WHEN tp.CommentCount > 5 THEN 'ModeratelyCommented'
            WHEN tp.CommentCount > 0 THEN 'LightlyCommented'
            ELSE 'NoComments'
        END AS CommentStatus,
        CASE 
            WHEN tp.FavoriteCount > 50 THEN 'HighlyBookmarked'
            WHEN tp.FavoriteCount > 25 THEN 'ModeratelyBookmarked'
            WHEN tp.FavoriteCount > 5 THEN 'Bookmarkable'
            ELSE 'NotBookmarked'
        END AS BookmarkStatus,
        EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - tp.CreationDate)) / 86400 AS DaysSinceCreation,
        ROW_NUMBER() OVER (PARTITION BY tp.OwnerUserId ORDER BY tp.CreationDate DESC) AS PostSequence,
        DENSE_RANK() OVER (ORDER BY tp.Score DESC) AS ScoreRank,
        RANK() OVER (ORDER BY tp.ViewCount DESC) AS ViewRank,
        AVG(tp.Score) OVER (PARTITION BY tp.OwnerUserId) AS UserAvgScore,
        PERCENT_RANK() OVER (ORDER BY tp.Score) AS ScorePercentile,
        NTILE(4) OVER (ORDER BY tp.ViewCount) AS ViewQuartile
    FROM TopPosts tp
),
EnhancedUserPostAnalysis AS (
    SELECT 
        cua.UserId,
        cua.DisplayName,
        cua.Reputation,
        cua.PostCount,
        cua.CommentCount,
        cua.BadgeCount,
        cua.VoteCount,
        cua.LastPostDate,
        cua.LastCommentDate,
        cua.LastVoteDate,
        cua.DaysSinceLastPost,
        cua.DaysSinceLastComment,
        cua.PostRank,
        cua.BadgeRank,
        cua.ReputationRank,
        cua.VoteRank,
        cua.UserCategory,
        cua.ReputationTier,
        cua.RecognitionStatus,
        cua.VotingPattern,
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.CreationDate,
        pa.PostType,
        pa.VoteCategory,
        pa.TagsList,
        pa.AnswerCount,
        pa.CommentCount,
        pa.FavoriteCount,
        pa.ParentId,
        pa.PopularityLevel,
        pa.AnswerStatus,
        pa.CommentStatus,
        pa.BookmarkStatus,
        pa.DaysSinceCreation,
        pa.PostSequence,
        pa.ScoreRank,
        pa.ViewRank,
        pa.UserAvgScore,
        pa.ScorePercentile,
        pa.ViewQuartile,
        CASE 
            WHEN pa.Score > pa.UserAvgScore THEN 'AboveAverage'
            WHEN pa.Score < pa.UserAvgScore THEN 'BelowAverage'
            ELSE 'Average'
        END AS PerformanceRelativeToUser,
        CASE 
            WHEN pa.AnswerCount = 0 AND pa.PostType = 'Question' THEN 1
            ELSE 0
        END AS IsUnansweredQuestion,
        ROW_NUMBER() OVER (PARTITION BY cua.UserId, pa.PostType ORDER BY pa.Score DESC) AS TopPostByType,
        ROW_NUMBER() OVER (PARTITION BY cua.UserId ORDER BY pa.ViewCount DESC) AS TopViewedPost,
        ROW_NUMBER() OVER (PARTITION BY cua.UserId ORDER BY pa.CreationDate ASC) AS EarliestPostForUser,
        CASE 
            WHEN pa.Score > 100 AND pa.ViewCount > 1000 THEN 1
            WHEN pa.Score > 50 AND pa.ViewCount > 500 THEN 1
            ELSE 0
        END AS QualityPostIndicator,
        CASE 
            WHEN pa.PostType = 'Question' AND pa.AnswerCount = 0 THEN 'NeedAnswer'
            WHEN pa.PostType = 'Question' AND pa.AnswerCount > 0 THEN 'Answered'
            WHEN pa.PostType = 'Answer' AND pa.Score > 50 THEN 'HighValueAnswer'
            ELSE 'RegularPost'
        END AS PostStatusIndicator
    FROM ComplexUserAnalysis cua
    LEFT JOIN PostAnalysis pa ON cua.UserId = pa.OwnerUserId
    WHERE pa.PostId IS NOT NULL
),
FinalAggregatedAnalysis AS (
    SELECT 
        eupa.UserId,
        eupa.DisplayName,
        eupa.Reputation,
        eupa.PostCount,
        eupa.CommentCount,
        eupa.BadgeCount,
        eupa.VoteCount,
        eupa.UserCategory,
        eupa.ReputationTier,
        eupa.RecognitionStatus,
        eupa.VotingPattern,
        eupa.PostId,
        eupa.Title,
        eupa.Score,
        eupa.ViewCount,
        eupa.PostType,
        eupa.VoteCategory,
        eupa.AnswerStatus,
        eupa.CommentStatus,
        eupa.BookmarkStatus,
        eupa.PopularityLevel,
        eupa.DaysSinceCreation,
        eupa.PostSequence,
        eupa.ScoreRank,
        eupa.ViewRank,
        eupa.UserAvgScore,
        eupa.ScorePercentile,
        eupa.ViewQuartile,
        eupa.PerformanceRelativeToUser,
        eupa.IsUnansweredQuestion,
        eupa.TopPostByType,
        eupa.TopViewedPost,
        eupa.EarliestPostForUser,
        eupa.QualityPostIndicator,
        eupa.PostStatusIndicator,
        CASE 
            WHEN eupa.VoteCount > 0 AND eupa.PostCount > 0 THEN CAST(eupa.VoteCount AS DOUBLE PRECISION) / eupa.PostCount
            ELSE 0 
        END AS VotesPerPost,
        CASE 
            WHEN eupa.ViewCount > 0 AND eupa.PostCount > 0 THEN CAST(eupa.ViewCount AS DOUBLE PRECISION) / eupa.PostCount
            ELSE 0 
        END AS ViewsPerPost,
        CASE 
            WHEN eupa.BadgeCount > 0 AND eupa.PostCount > 0 AND eupa.Reputation > 0 THEN CAST(eupa.BadgeCount AS DOUBLE PRECISION) / (eupa.PostCount * eupa.Reputation / 1000.0)
            ELSE 0 
        END AS BadgeEfficiencyRatio,
        CASE 
            WHEN eupa.PostCount > 0 AND eupa.VoteCount > 0 THEN CAST(eupa.VoteCount AS DOUBLE PRECISION) / eupa.PostCount
            ELSE 0 
        END AS VotingEfficiency,
        CASE 
            WHEN eupa.VoteCount > eupa.BadgeCount THEN 'VoterFirst' 
            WHEN eupa.BadgeCount > eupa.VoteCount THEN 'BadgeFirst' 
            ELSE 'Balanced'
        END AS EngagementStyle,
        LAG(eupa.Title) OVER (PARTITION BY eupa.UserId ORDER BY eupa.CreationDate) AS PreviousPostTitle,
        LAG(eupa.Score) OVER (PARTITION BY eupa.UserId ORDER BY eupa.CreationDate) AS PreviousPostScore,
        LAG(eupa.ViewCount) OVER (PARTITION BY eupa.UserId ORDER BY eupa.CreationDate) AS PreviousPostViews
    FROM EnhancedUserPostAnalysis eupa
    WHERE eupa.DaysSinceCreation < 365
)
SELECT 
    faa.UserId,
    faa.DisplayName,
    faa.Reputation,
    faa.PostCount,
    faa.CommentCount,
    faa.BadgeCount,
    faa.VoteCount,
    faa.UserCategory,
    faa.ReputationTier,
    faa.RecognitionStatus,
    faa.VotingPattern,
    faa.PostId,
    faa.Title,
    faa.Score,
    faa.ViewCount,
    faa.PostType,
    faa.VoteCategory,
    faa.AnswerStatus,
    faa.CommentStatus,
    faa.BookmarkStatus,
    faa.PopularityLevel,
    faa.DaysSinceCreation,
    faa.PostSequence,
    faa.ScoreRank,
    faa.ViewRank,
    faa.UserAvgScore,
    faa.ScorePercentile,
    faa.ViewQuartile,
    faa.PerformanceRelativeToUser,
    faa.IsUnansweredQuestion,
    faa.TopPostByType,
    faa.TopViewedPost,
    faa.EarliestPostForUser,
    faa.QualityPostIndicator,
    faa.PostStatusIndicator,
    faa.VotesPerPost,
    faa.ViewsPerPost,
    faa.BadgeEfficiencyRatio,
    faa.VotingEfficiency,
    faa.EngagementStyle,
    faa.PreviousPostTitle,
    faa.PreviousPostScore,
    faa.PreviousPostViews,
    CASE 
        WHEN faa.Score > 50 AND faa.ViewCount > 500 AND faa.BadgeCount > 0 THEN 'PowerUser'
        WHEN faa.PostCount > 50 AND faa.BadgeCount > 10 THEN 'VeteranContributor'
        WHEN faa.VoteCount > 500 AND faa.ViewCount > 2000 THEN 'InfluentialUser'
        ELSE 'RegularUser'
    END AS UserClassification,
    CASE 
        WHEN faa.PostType = 'Question' AND faa.AnswerStatus = 'Unanswered' THEN 'NeedsAttention'
        WHEN faa.PostType = 'Question' AND faa.AnswerStatus IN ('WellAnswered', 'Answered') THEN 'Processed'
        WHEN faa.PostType = 'Answer' AND faa.Score > 100 THEN 'HighImpactAnswer'
        ELSE 'RegularActivity'
    END AS ActivityClassification
FROM FinalAggregatedAnalysis faa
WHERE 
    faa.PostCount > 0 
    AND faa.Score IS NOT NULL
    AND faa.Reputation > 1000
    AND (
        (faa.PostType = 'Question' AND faa.AnswerStatus IN ('Unanswered', 'Answered'))
        OR (faa.PostType = 'Answer' AND faa.Score > 20)
        OR (faa.PostType = 'Other')
    )
    AND (
        faa.VotesPerPost > 0.5 
        OR faa.ViewsPerPost > 50 
        OR faa.BadgeEfficiencyRatio > 0.01
    )
    AND faa.DaysSinceCreation < 365
    AND (
        faa.Score >= 20 
        OR faa.ViewCount >= 100
        OR faa.FavoriteCount >= 10
    )
ORDER BY 
    faa.Reputation DESC,
    faa.Score DESC,
    faa.ViewCount DESC,
    faa.DaysSinceCreation ASC
LIMIT 10000;