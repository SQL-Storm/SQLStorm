WITH TopUsers AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.CreationDate ASC) AS Rank
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    WHERE
        u.Reputation > 1000
    GROUP BY
        u.Id, u.DisplayName, u.Reputation
),
ActivePosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        p.LastActivityDate,
        COUNT(c.Id) AS CommentCount,
        MAX(ph.CreationDate) AS LastEditDate
    FROM
        Posts p
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    LEFT JOIN
        PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (5, 6, 14, 15)
    WHERE
        p.PostTypeId IN (1, 2)
        AND p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days')
    GROUP BY
        p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.Title, p.Tags, p.OwnerUserId, p.LastActivityDate
    HAVING COUNT(c.Id) > 5  AND MAX(p.LastActivityDate) > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '7 days')
),
RecentBadges AS (
    SELECT
        b.UserId,
        u.DisplayName,
        COUNT(b.Id) AS BadgeCount,
        MAX(b.Date) AS LastBadgeDate
    FROM
        Badges b
    JOIN
        Users u ON b.UserId = u.Id
    WHERE
        b.Date > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days')
    GROUP BY
        b.UserId, u.DisplayName
),
HighVotePosts AS (
    SELECT
        p.Id AS PostId,
        p.Title,
        p.OwnerUserId,
        p.Score,
        v.VoteTypeId,
        u.DisplayName AS VoterName,
        COUNT(v.Id) AS VoteCount
    FROM
        Posts p
    JOIN
        Votes v ON p.Id = v.PostId
    JOIN
        Users u ON v.UserId = u.Id
    WHERE
        p.PostTypeId = 1
        AND v.VoteTypeId IN (2, 3)
    GROUP BY
        p.Id, p.Title, p.OwnerUserId, u.DisplayName, v.VoteTypeId
    HAVING COUNT(v.Id) > 10
),
PostBounties AS (
    SELECT
        v.PostId,
        MAX(v.BountyAmount) AS HighestBounty
    FROM
        Votes v
    WHERE
        v.VoteTypeId = 8
    GROUP BY
        v.PostId
)
SELECT
    tu.UserId,
    tu.DisplayName AS TopUser,
    tu.Reputation,
    tu.PostCount,
    tu.TotalScore,
    tu.Rank,
    ap.PostId,
    ap.Title AS PostTitle,
    ap.PostTypeId,
    ap.Score AS PostScore,
    ap.ViewCount,
    ap.CommentCount,
    ap.LastActivityDate,
    rb.BadgeCount,
    rb.LastBadgeDate,
    hvp.VoteCount,
    CASE
        WHEN pht.Comment IS NOT NULL THEN pht.Comment
        ELSE '[]'
    END AS CloseReasonIds,
    pb.HighestBounty
FROM
    TopUsers tu
LEFT JOIN
    ActivePosts ap ON tu.UserId = ap.OwnerUserId
LEFT JOIN
    RecentBadges rb ON tu.UserId = rb.UserId
LEFT JOIN
    HighVotePosts hvp ON tu.UserId = hvp.OwnerUserId
LEFT JOIN
    PostHistory pht ON ap.PostId = pht.PostId AND pht.PostHistoryTypeId = 10
LEFT JOIN
    PostBounties pb ON ap.PostId = pb.PostId
WHERE
    tu.Rank <= 10
    AND ap.PostId IS NOT NULL
    AND (hvp.VoteCount IS NOT NULL OR rb.BadgeCount IS NOT NULL)
GROUP BY
    tu.UserId, tu.DisplayName, tu.Reputation, tu.PostCount, tu.TotalScore, tu.Rank,
    ap.PostId, ap.Title, ap.PostTypeId, ap.Score, ap.ViewCount, ap.CommentCount, ap.LastActivityDate,
    rb.BadgeCount, rb.LastBadgeDate, hvp.VoteCount, pht.Comment, pb.HighestBounty
ORDER BY
    tu.Rank ASC, ap.Score DESC, rb.LastBadgeDate DESC, hvp.VoteCount DESC;