WITH UserMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COALESCE(AVG(p.Score), 0) AS AvgPostScore,
        -- replace STRING_AGG DISTINCT with array_agg + string_agg workaround for ordering by score in standard SQL
        (SELECT STRING_AGG(tag, ',') FROM (
            SELECT DISTINCT SUBSTRING(p2.Tags FROM 2 FOR CHAR_LENGTH(p2.Tags)-2) AS tag
            FROM Posts p2
            WHERE p2.OwnerUserId = u.Id AND p2.Tags IS NOT NULL
            ORDER BY MAX(p2.Score) OVER (PARTITION BY SUBSTRING(p2.Tags FROM 2 FOR CHAR_LENGTH(p2.Tags)-2)) DESC NULLS LAST
        ) sub) AS TopTags,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS MedianScore
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '365 days')
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
BadgeAnalysis AS (
    SELECT 
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        -- ARRAY_AGG with ORDER BY is not supported in all dialects; use subselect to preserve ordering if needed
        (SELECT STRING_AGG(name, ',') FROM (
            SELECT DISTINCT b2.Name AS name
            FROM Badges b2
            WHERE b2.UserId = b.UserId AND b2.TagBased = 1
            ORDER BY b2.Class, b2.Date DESC
        ) tb) AS TagBadges,
        MAX(b.Date) AS LastBadgeDate,
        -- LAG over counts per month: compute monthly counts then lag them
        (SELECT COALESCE(lag_count, 0) FROM (
            SELECT b3.UserId,
                   COUNT(*) AS month_count,
                   LAG(COUNT(*), 1, 0) OVER (PARTITION BY b3.UserId ORDER BY DATE_TRUNC('month', b3.Date)) AS lag_count,
                   ROW_NUMBER() OVER (PARTITION BY b3.UserId ORDER BY DATE_TRUNC('month', b3.Date) DESC) AS rn
            FROM Badges b3
            WHERE b3.UserId = b.UserId
            GROUP BY b3.UserId, DATE_TRUNC('month', b3.Date)
        ) sub WHERE rn = 1) AS PrevMonthBadges
    FROM Badges b
    GROUP BY b.UserId
),
PostEngagement AS (
    SELECT 
        p.Id AS PostId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpvoteCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownvoteCount,
        CASE 
            WHEN p.ViewCount > 0 THEN CAST(p.Score AS DOUBLE PRECISION) / NULLIF(p.ViewCount, 0)
            ELSE NULL 
        END AS EngagementRatio,
        FIRST_VALUE(c.Text) OVER (PARTITION BY p.Id ORDER BY c.Score DESC, c.CreationDate) AS TopComment,
        EXISTS (
            SELECT 1 FROM PostHistory ph 
            WHERE ph.PostId = p.Id 
            AND ph.PostHistoryTypeId IN (10, 12)
        ) AS WasClosedOrDeleted
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '180 days')
    GROUP BY p.Id, p.OwnerUserId, p.Score, p.ViewCount
),
LinkedQuestions AS (
    SELECT 
        pl.PostId,
        pl.RelatedPostId,
        p1.Title AS SourceTitle,
        p2.Title AS LinkedTitle,
        SIMILARITY(COALESCE(p1.Title, ''), COALESCE(p2.Title, '')) AS TitleSimilarity,
        ROW_NUMBER() OVER (PARTITION BY pl.PostId ORDER BY p2.Score DESC) AS LinkRank
    FROM PostLinks pl
    INNER JOIN Posts p1 ON pl.PostId = p1.Id
    INNER JOIN Posts p2 ON pl.RelatedPostId = p2.Id
    WHERE pl.LinkTypeId = 1
)
SELECT 
    um.DisplayName,
    um.Reputation,
    um.ReputationRank,
    COALESCE(um.QuestionCount, 0) + COALESCE(um.AnswerCount, 0) AS TotalPosts,
    ROUND(CAST(um.AvgPostScore AS NUMERIC), 2) AS AvgPostScore,
    um.MedianScore,
    CASE 
        WHEN um.QuestionCount > 0 AND um.AnswerCount > 0 
        THEN ROUND(CAST(CAST(um.AnswerCount AS DOUBLE PRECISION) / NULLIF(um.QuestionCount, 0) AS NUMERIC), 2)
        ELSE NULL 
    END AS AnswerToQuestionRatio,
    SUBSTRING(um.TopTags FROM 1 FOR 100) AS TopTags,
    COALESCE(ba.GoldBadges, 0) || '/' || COALESCE(ba.SilverBadges, 0) || '/' || COALESCE(ba.BronzeBadges, 0) AS BadgeCount,
    -- extract first 5 from comma list of TagBadges
    (CASE WHEN ba.TagBadges IS NOT NULL THEN
        (SELECT STRING_AGG(part, ', ') FROM (
            SELECT part FROM UNNEST(string_to_array(ba.TagBadges, ',')) WITH ORDINALITY AS t(part, ord)
            WHERE ord <= 5
            ORDER BY ord
        ) s)
    ELSE NULL END) AS TopTagBadges,
    EXTRACT(DAY FROM (CAST('2024-10-01' AS DATE) - COALESCE(ba.LastBadgeDate, CAST('2024-10-01' AS DATE)))) AS DaysSinceLastBadge,
    COUNT(DISTINCT pe.PostId) AS EngagedPosts,
    AVG(pe.EngagementRatio) FILTER (WHERE pe.EngagementRatio IS NOT NULL) AS AvgEngagementRatio,
    SUM(pe.UpvoteCount) - SUM(pe.DownvoteCount) AS NetVotes,
    COUNT(DISTINCT lq.RelatedPostId) AS LinkedPostCount,
    AVG(lq.TitleSimilarity) FILTER (WHERE lq.LinkRank <= 3) AS AvgTitleSimilarity,
    BOOL_OR(pe.WasClosedOrDeleted) AS HasClosedOrDeletedPosts,
    -- replace STRING_AGG DISTINCT with array aggregation then limit and join since ORDER BY aggregate with DISTINCT is nonstandard
    (SELECT STRING_AGG(comment, ' | ') FROM (
        SELECT DISTINCT LEFT(pe2.TopComment, 50) AS comment
        FROM PostEngagement pe2
        WHERE pe2.OwnerUserId = um.Id AND pe2.TopComment IS NOT NULL
        ORDER BY MAX(pe2.Score) OVER (PARTITION BY LEFT(pe2.TopComment,50)) DESC NULLS LAST
        LIMIT 10
    ) sub) AS SampleTopComments
FROM UserMetrics um
LEFT JOIN BadgeAnalysis ba ON um.Id = ba.UserId
LEFT JOIN PostEngagement pe ON um.Id = pe.OwnerUserId
LEFT JOIN LinkedQuestions lq ON pe.PostId = lq.PostId
WHERE um.Reputation > 100
    AND (um.QuestionCount > 0 OR um.AnswerCount > 0)
    AND NOT EXISTS (
        SELECT 1 FROM PostHistory ph2 
        WHERE ph2.UserId = um.Id 
        AND ph2.PostHistoryTypeId = 12 
        AND ph2.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '30 days')
    )
GROUP BY 
    um.Id, um.DisplayName, um.Reputation, um.ReputationRank, 
    um.QuestionCount, um.AnswerCount, um.AvgPostScore, um.MedianScore,
    um.TopTags, ba.GoldBadges, ba.SilverBadges, ba.BronzeBadges,
    ba.TagBadges, ba.LastBadgeDate
HAVING COUNT(DISTINCT pe.PostId) > 0
    OR COALESCE(ba.GoldBadges, 0) + COALESCE(ba.SilverBadges, 0) + COALESCE(ba.BronzeBadges, 0) > 5
ORDER BY 
    um.Reputation DESC,
    COALESCE(ba.GoldBadges, 0) * 3 + COALESCE(ba.SilverBadges, 0) * 2 + COALESCE(ba.BronzeBadges, 0) DESC,
    AVG(pe.EngagementRatio) DESC NULLS LAST
LIMIT 100;