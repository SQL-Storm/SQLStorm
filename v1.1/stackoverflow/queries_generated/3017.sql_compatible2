WITH RecentUserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) FILTER (WHERE p.LastActivityDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days') AS RecentPosts,
        COUNT(c.Id) AS TotalComments,
        MAX(p.LastActivityDate) AS LastActive
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
BadgeSummary AS (
    SELECT
        u.Id AS UserId,
        COUNT(b.Id) AS BadgeCount,
        STRING_AGG(b.Name, ', ' ORDER BY b.Date DESC) AS BadgeNames
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id
),
VoteAnalysis AS (
    SELECT
        v.PostId,
        COUNT(*) AS TotalVotes,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 2) AS UpVotes,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 3) AS DownVotes
    FROM Votes v
    GROUP BY v.PostId
),
PostQuestionDetails AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.Tags,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        aw.AcceptedAnswerId,
        aw.Score AS AcceptedAnswerScore,
        aw.CreationDate AS AnswerCreationDate,
        STRING_AGG(DISTINCT t.TagName, ', ') AS TagNames
    FROM Posts p
    LEFT JOIN Posts aw ON p.Id = aw.ParentId AND aw.PostTypeId = 2
    LEFT JOIN Tags t ON p.Tags IS NOT NULL AND t.TagName = ANY(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><'))
    WHERE p.PostTypeId = 1
    GROUP BY p.Id, p.Title, p.Tags, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount, aw.AcceptedAnswerId, aw.Score, aw.CreationDate
),
ActivityScore AS (
    SELECT
        p.Id AS PostId,
        p.Title,
        p.Tags,
        p.CreationDate,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.Score + COALESCE(v.TotalVotes, 0) + COALESCE(ac_votes.UpVotes, 0) AS CalculatedScore,
        ROW_NUMBER() OVER (ORDER BY p.CreationDate DESC) AS RecencyRank
    FROM Posts p
    LEFT JOIN VoteAnalysis v ON p.Id = v.PostId
    LEFT JOIN (
        SELECT PostId, COUNT(*) FILTER (WHERE VoteTypeId = 1) AS UpVotes
        FROM Votes
        GROUP BY PostId
    ) ac_votes ON p.Id = ac_votes.PostId
),
TopPosts AS (
    SELECT
        ps.QuestionId AS PostId,
        ps.Title,
        ps.Tags,
        ps.CreationDate,
        ps.AnswerCount,
        ps.CommentCount,
        ps.FavoriteCount,
        COALESCE(v.UpVotes, 0) AS UpVotes,
        COALESCE(v.DownVotes, 0) AS DownVotes,
        COALESCE(v.TotalVotes, 0) AS TotalVotes,
        COALESCE(a.CalculatedScore, ps.Score) AS CalculatedScore,
        ROW_NUMBER() OVER (ORDER BY COALESCE(a.CalculatedScore, ps.Score) DESC, ps.CreationDate ASC) AS Rank,
        ps.TagNames,
        ps.AcceptedAnswerId,
        ps.AcceptedAnswerScore,
        ps.AnswerCreationDate
    FROM PostQuestionDetails ps
    LEFT JOIN VoteAnalysis v ON ps.QuestionId = v.PostId
    LEFT JOIN ActivityScore a ON ps.QuestionId = a.PostId
),
UserPostVoteSummary AS (
    SELECT
        p.OwnerUserId,
        SUM(COALESCE(v.TotalVotes, 0)) AS TotalPostVotes,
        SUM(COALESCE(v.UpVotes, 0)) AS UpVotes,
        SUM(COALESCE(v.DownVotes, 0)) AS DownVotes
    FROM Posts p
    LEFT JOIN VoteAnalysis v ON p.Id = v.PostId
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId
)
SELECT
    ru.UserId,
    ru.DisplayName,
    ru.Reputation,
    ru.RecentPosts,
    ru.TotalComments,
    ru.LastActive,
    bs.BadgeCount,
    bs.BadgeNames,
    ta.TotalPostVotes AS TotalPostVotes,
    ta.UpVotes,
    ta.DownVotes,
    tp.Title AS TopPostTitle,
    tp.CreationDate AS PostCreationDate,
    tp.AnswerCount,
    tp.CommentCount,
    tp.FavoriteCount,
    tp.Tags AS PostTags,
    tp.TagNames,
    tp.AcceptedAnswerId,
    tp.AcceptedAnswerScore,
    tp.AnswerCreationDate
FROM RecentUserActivity ru
LEFT JOIN BadgeSummary bs ON ru.UserId = bs.UserId
LEFT JOIN UserPostVoteSummary ta ON ru.UserId = ta.OwnerUserId
LEFT JOIN LATERAL (
    SELECT t.*
    FROM TopPosts t
    JOIN Posts p ON p.Id = t.PostId
    WHERE p.OwnerUserId = ru.UserId
    ORDER BY t.Rank
    LIMIT 1
) tp ON TRUE
WHERE ru.Reputation > 1000
ORDER BY ru.Reputation DESC, ru.LastActive DESC
LIMIT 50;