WITH TopUsers AS (
    SELECT 
        U.Id,
        U.DisplayName,
        U.Reputation,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestions,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswers,
        SUM(CASE WHEN P.PostTypeId = 1 THEN COALESCE(P.ViewCount,0) ELSE 0 END) AS TotalQuestionViews,
        SUM(CASE WHEN P.PostTypeId = 2 THEN COALESCE(P.Score,0) ELSE 0 END) AS TotalAnswerScores,
        RANK() OVER (ORDER BY U.Reputation DESC) AS ReputationRank
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    WHERE U.LastAccessDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months')
    GROUP BY U.Id, U.DisplayName, U.Reputation
    HAVING COUNT(DISTINCT P.Id) > 10
),
UserBadges AS (
    SELECT 
        UserId,
        COUNT(*) AS TotalBadges,
        COUNT(CASE WHEN Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN Class = 3 THEN 1 END) AS BronzeBadges
    FROM Badges
    GROUP BY UserId
),
UserTags AS (
    SELECT
        P.OwnerUserId,
        t.tag AS TagName,
        COUNT(DISTINCT P.Id) AS PostsInTag
    FROM Posts P
    CROSS JOIN LATERAL (
        SELECT unnest(
            regexp_split_to_array(
                CASE
                    WHEN substring(P.Tags FROM 1 FOR 1) = '<' AND substring(P.Tags FROM char_length(P.Tags) FOR 1) = '>' 
                    THEN substring(P.Tags FROM 2 FOR char_length(P.Tags) - 2)
                    ELSE P.Tags
                END,
                '><'
            )
        ) AS tag
    ) t
    JOIN Tags T ON T.TagName = t.tag
    WHERE P.PostTypeId = 1
    GROUP BY P.OwnerUserId, t.tag
)
SELECT 
    TU.Id,
    TU.DisplayName,
    TU.Reputation,
    TU.TotalPosts,
    TU.TotalQuestions,
    TU.TotalAnswers,
    TU.TotalQuestionViews,
    TU.TotalAnswerScores,
    COALESCE(UB.TotalBadges, 0) AS TotalBadges,
    COALESCE(UB.GoldBadges, 0) AS GoldBadges,
    COALESCE(UB.SilverBadges, 0) AS SilverBadges,
    COALESCE(UB.BronzeBadges, 0) AS BronzeBadges,
    JSON_AGG(DISTINCT jsonb_build_object('TagName', UT.TagName, 'PostsInTag', UT.PostsInTag)) AS TagExpertise,
    TU.ReputationRank
FROM TopUsers TU
LEFT JOIN UserBadges UB ON TU.Id = UB.UserId
LEFT JOIN UserTags UT ON TU.Id = UT.OwnerUserId
WHERE TU.ReputationRank <= 100
GROUP BY TU.Id, TU.DisplayName, TU.Reputation, TU.TotalPosts, TU.TotalQuestions, TU.TotalAnswers, TU.TotalQuestionViews, TU.TotalAnswerScores, UB.TotalBadges, UB.GoldBadges, UB.SilverBadges, UB.BronzeBadges, TU.ReputationRank
ORDER BY TU.Reputation DESC, UB.TotalBadges DESC
LIMIT 10;