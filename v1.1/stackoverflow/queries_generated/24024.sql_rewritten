-- {"query": "24024.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "gpt-oss-20b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 3464} 
WITH 
/* Question core data */
Q AS (
    SELECT
        p.Id           AS QuestionId,
        p.Title,
        p.Tags,
        p.Score        AS QuestionScore,
        p.AnswerCount,
        p.AcceptedAnswerId,
        p.ViewCount,
        u.Reputation   AS OwnerReputation,
        u.DisplayName  AS OwnerDisplayName
    FROM Posts p
    JOIN Users u ON u.Id = p.OwnerUserId
    WHERE p.PostTypeId = 1
),

/* Votes – split into two sets, then UNION ALL */
V2 AS (
    SELECT PostId FROM Votes WHERE VoteTypeId = 2
),
V3 AS (
    SELECT PostId FROM Votes WHERE VoteTypeId = 3
),
VAll AS (
    SELECT PostId FROM V2
    UNION ALL
    SELECT PostId FROM V3
),
V AS (
    SELECT
        PostId,
        COUNT(*) AS VoteCount
    FROM VAll
    GROUP BY PostId
),

/* Comment counts */
C AS (
    SELECT
        PostId,
        COUNT(*) AS CommentCnt
    FROM Comments
    GROUP BY PostId
),

/* Tag split – STRING_SPLIT yields a table with column 'value' */
TagList AS (
    SELECT
        q.QuestionId,
        TRIM(t.value) AS TagName
    FROM Q q
    CROSS APPLY STRING_SPLIT(q.Tags, '><') t
    WHERE t.value IS NOT NULL
),

/* Rank questions within each tag */
TagRank AS (
    SELECT
        tl.TagName,
        tl.QuestionId,
        q.QuestionScore,
        ROW_NUMBER() OVER (
            PARTITION BY tl.TagName 
            ORDER BY q.QuestionScore DESC, q.ViewCount DESC
        ) AS Rank
    FROM TagList tl
    JOIN Q q ON q.QuestionId = tl.QuestionId
)

/* ---------------------------------------------------------- */

SELECT
    /* Core question fields */
    q.QuestionId,
    q.Title,
    q.Tags,
    q.QuestionScore,
    q.AnswerCount,

    /* Aggregated metrics with NULL handling */
    COALESCE(v.VoteCount,0)     AS TotalVoteCount,
    COALESCE(c.CommentCnt,0)    AS CommentCount,

    /* Correlated subquery: high‑score answers */
    (
        SELECT COUNT(*) 
        FROM Posts a 
        WHERE a.ParentId = q.QuestionId
          AND a.Score > 10
    ) AS HighScoreAnswerCount,

    /* Conditional label */
    CASE 
        WHEN q.AnswerCount > 5 THEN 'Extensive'
        WHEN q.AnswerCount > 0 THEN 'Answered'
        ELSE 'NoAnswer'
    END AS AnswerMeta,

    /* Accepted flag */
    CASE WHEN q.AcceptedAnswerId IS NOT NULL THEN '✅' ELSE '' END AS Accepted,

    /* Tag info and per‑tag ranking */
    tl.TagName,
    tr.Rank AS TagRank,

    /* Owner reputation – NULL logic for safety */
    COALESCE(q.OwnerReputation,0) AS OwnerReputation
FROM 
    Q q
LEFT JOIN V v ON v.PostId = q.QuestionId
LEFT JOIN C c ON c.PostId = q.QuestionId
LEFT JOIN TagList tl ON tl.QuestionId = q.QuestionId
LEFT JOIN TagRank tr ON tr.QuestionId = q.QuestionId
    AND tr.TagName = tl.TagName
LEFT JOIN Users u ON u.Id = q.OwnerUserId

/* Complicated multi‑condition predicate */
WHERE (q.Tags LIKE '%<c%>' AND q.Tags LIKE '%<sql%>') 
  AND (q.AnswerCount 
       + COALESCE(v.VoteCount,0) 
       + COALESCE(c.CommentCnt,0)) > 20

/* Final ordering & limiting – using set operations internally */
ORDER BY q.QuestionScore DESC, tr.Rank, q.ViewCount DESC
OFFSET 0 ROWS FETCH NEXT 20 ROWS ONLY;