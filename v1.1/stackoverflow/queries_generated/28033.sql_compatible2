WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        AVG(p.Score) AS AvgPostScore,
        RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        u.Reputation
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id, u.Reputation
), PostAnalysis AS (
    SELECT
        p.Id AS PostId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        (LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', '')) + 1) AS TagCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes,
        (SELECT COUNT(*) FROM PostHistory ph 
         WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10 
         AND CAST(ph.Comment AS INTEGER) IN (SELECT Id FROM CloseReasonTypes WHERE Name LIKE '%duplicate%')
        ) AS DuplicateCloseEvents
    FROM Posts p
    WHERE p.PostTypeId = 1
)
SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    pa.TagCount,
    ua.BadgeCount,
    ua.QuestionCount + ua.AnswerCount AS TotalPosts,
    (SELECT STRING_AGG(t.TagName, '; ') 
     FROM Tags t 
     WHERE t.Id IN (
         SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><'))
         FROM Posts p2
         WHERE p2.Id = pa.PostId
     )
    ) AS CommonTags,
    COALESCE(ph.RevisionCount, 0) AS EditHistoryCount,
    RANK() OVER (ORDER BY (ua.QuestionCount * 2 + ua.AnswerCount) DESC) AS ActivityRank,
    CASE 
        WHEN ua.AvgPostScore > 50 THEN 'High Quality' 
        WHEN ua.AvgPostScore BETWEEN 20 AND 50 THEN 'Medium Quality' 
        ELSE 'Low Quality' 
    END AS QualityCategory,
    ua.CommentCount,
    ua.ReputationRank,
    ph.RevisionPercentile,
    pa.Upvotes,
    pa.DuplicateCloseEvents,
    pa.PostId
FROM Users u
JOIN UserActivity ua ON u.Id = ua.UserId
LEFT JOIN PostAnalysis pa ON u.Id = (SELECT OwnerUserId FROM Posts WHERE Id = pa.PostId)
LEFT JOIN (
    SELECT 
        UserId, 
        COUNT(*) AS RevisionCount,
        PERCENT_RANK() OVER (ORDER BY COUNT(*) DESC) AS RevisionPercentile
    FROM PostHistory
    GROUP BY UserId
) ph ON u.Id = ph.UserId
WHERE u.Reputation > 1000
  AND ua.CommentCount > (SELECT AVG(CommentCount) FROM UserActivity)
  AND EXISTS (
      SELECT 1 
      FROM Votes v 
      WHERE v.UserId = u.Id 
        AND v.VoteTypeId IN (2, 8)
        AND v.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '1 year')
  )
GROUP BY
    u.Id,
    u.DisplayName,
    u.Reputation,
    pa.TagCount,
    ua.BadgeCount,
    ua.QuestionCount,
    ua.AnswerCount,
    ua.AvgPostScore,
    ua.CommentCount,
    ua.ReputationRank,
    ph.RevisionCount,
    ph.RevisionPercentile,
    pa.PostId,
    pa.Upvotes,
    pa.DuplicateCloseEvents
HAVING MAX(pa.Upvotes) > 10 OR MAX(pa.DuplicateCloseEvents) > 0
ORDER BY 
    ua.ReputationRank, 
    ActivityRank, 
    ph.RevisionPercentile DESC
LIMIT 100;