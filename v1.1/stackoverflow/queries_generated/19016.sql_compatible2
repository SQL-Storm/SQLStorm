WITH UserEngagementSummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.UpVotes AS UserTotalUpvotesGiven,
        U.DownVotes AS UserTotalDownvotesGiven,
        U.Views AS UserProfileViews,
        COUNT(DISTINCT P.Id) AS TotalPostsCreated,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestionsAsked,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswersWritten,
        SUM(P.Score) AS SumOfPostScoresOwned,
        SUM(C.Score) AS SumOfCommentScoresOwned,
        COUNT(DISTINCT CASE WHEN B.Class = 1 THEN B.Id END) AS GoldBadges,
        COUNT(DISTINCT CASE WHEN B.Class = 2 THEN B.Id END) AS SilverBadges,
        COUNT(DISTINCT CASE WHEN B.Class = 3 THEN B.Id END) AS BronzeBadges,
        COALESCE(AVG(P.Score) FILTER (WHERE P.Score IS NOT NULL), 0) AS AvgPostScoreOwned
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.UpVotes, U.DownVotes, U.Views
),
QuestionPerformanceMetrics AS (
    SELECT
        Q.Id AS QuestionId,
        Q.OwnerUserId,
        Q.Title,
        Q.CreationDate AS QuestionCreationDate,
        Q.Score AS QuestionScore,
        Q.ViewCount,
        Q.AnswerCount,
        Q.FavoriteCount,
        Q.ClosedDate,
        Q.CommunityOwnedDate,
        COALESCE(Q.LastActivityDate, Q.CreationDate) AS EffectiveLastActivityDate,
        (CHAR_LENGTH(Q.Tags) - CHAR_LENGTH(REPLACE(Q.Tags, '><', '')) + 1) / 2 AS NormalizedTagCount,
        (SELECT MAX(A.Score) FROM Posts A WHERE A.ParentId = Q.Id AND A.PostTypeId = 2) AS TopAnswerScore,
        (SELECT AVG(A.Score) FROM Posts A WHERE A.ParentId = Q.Id AND A.PostTypeId = 2) AS AverageAnswerScore,
        (SELECT COUNT(DISTINCT A_inner.OwnerUserId) FROM Posts A_inner WHERE A_inner.ParentId = Q.Id AND A_inner.PostTypeId = 2 AND A_inner.OwnerUserId IS NOT NULL) AS UniqueAnswererCount,
        CASE WHEN Q.AcceptedAnswerId IS NOT NULL THEN TRUE ELSE FALSE END AS HasAcceptedAnswer,
        CASE WHEN EXISTS (SELECT 1 FROM Posts A_check WHERE A_check.ParentId = Q.Id AND A_check.PostTypeId = 2 AND A_check.Score > 50) THEN TRUE ELSE FALSE END AS HasHighScoringAnswer
    FROM Posts Q
    WHERE Q.PostTypeId = 1
),
PostHistoryAnalysis AS (
    SELECT
        PH.PostId AS QuestionId,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN PH.Id END) AS MajorEditCount,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId = 10 THEN PH.Id END) AS CloseEventCount,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId = 11 THEN PH.Id END) AS ReopenEventCount,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (12, 13) THEN PH.CreationDate ELSE NULL END) AS LastDeletionUndeletionDate,
        CASE WHEN COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId = 10 THEN PH.Id END) > 0 AND COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId = 11 THEN PH.Id END) > 0 THEN TRUE ELSE FALSE END AS WasClosedAndReopened
    FROM PostHistory PH
    WHERE PH.PostId IN (SELECT Id FROM Posts WHERE PostTypeId = 1)
    GROUP BY PH.PostId
),
TagUsageFrequency AS (
    SELECT
        Q.Id AS QuestionId,
        unnest(string_to_array(substring(Q.Tags FROM 2 FOR (CHAR_LENGTH(Q.Tags)-2)), '><')) AS TagName
    FROM Posts Q
    WHERE Q.PostTypeId = 1 AND Q.Tags IS NOT NULL
),
QuestionComplexityMetrics AS (
    SELECT
        Q.Id AS QuestionId,
        CHAR_LENGTH(Q.Body) AS BodyLength,
        (CHAR_LENGTH(REPLACE(Q.Body, '<code>', '')) - CHAR_LENGTH(REPLACE(REPLACE(Q.Body, '<code>', ''), '</code>', ''))) / NULLIF(CHAR_LENGTH('<code>'), 0) AS CodeBlockCount,
        COUNT(PL.RelatedPostId) AS LinkedQuestionsCount,
        COUNT(CASE WHEN PL.LinkTypeId = 3 THEN PL.RelatedPostId END) AS DuplicateLinksCount,
        CASE WHEN Q.Body ILIKE '%http%' OR Q.Body ILIKE '%www%' THEN TRUE ELSE FALSE END AS HasExternalLinksInBody
    FROM Posts Q
    LEFT JOIN PostLinks PL ON Q.Id = PL.PostId
    WHERE Q.PostTypeId = 1
    GROUP BY Q.Id, Q.Body
)
SELECT
    UES.UserId,
    UES.DisplayName,
    UES.Reputation,
    QPM.QuestionId,
    QPM.Title AS QuestionTitle,
    QPM.QuestionScore,
    QPM.ViewCount,
    QPM.AnswerCount,
    QPM.FavoriteCount,
    QPM.HasAcceptedAnswer,
    PH.MajorEditCount,
    PH.CloseEventCount,
    PH.ReopenEventCount,
    QCM.BodyLength,
    QCM.CodeBlockCount,
    QCM.LinkedQuestionsCount,
    QCM.DuplicateLinksCount,
    UES.GoldBadges,
    UES.SilverBadges,
    UES.BronzeBadges,
    (
        (QPM.QuestionScore * 0.7)
        + (QPM.ViewCount * 0.05)
        + (COALESCE(QPM.AverageAnswerScore, 0) * 2.0)
        + (QPM.FavoriteCount * 1.5)
        - (PH.CloseEventCount * 10)
        + (PH.ReopenEventCount * 5)
        + (CASE WHEN QPM.HasAcceptedAnswer THEN 25 ELSE 0 END)
        + (CASE WHEN QPM.CommunityOwnedDate IS NOT NULL THEN -10 ELSE 0 END)
        + (QCM.CodeBlockCount * 2)
        + (CASE WHEN QPM.HasHighScoringAnswer THEN 15 ELSE 0 END)
        - (CASE WHEN QCM.HasExternalLinksInBody THEN 5 ELSE 0 END)
    ) AS QuestionQualityScore,
    RANK() OVER (
        ORDER BY
            UES.Reputation DESC,
            UES.GoldBadges DESC,
            (UES.SumOfPostScoresOwned + UES.SumOfCommentScoresOwned) DESC
    ) AS UserInfluenceRank,
    COALESCE(CAST(PH.MajorEditCount AS numeric) / NULLIF(
        EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - QPM.QuestionCreationDate)) / (3600 * 24 * 30)
    , 0), 0) AS EditsPerMonth,
    CASE
        WHEN UES.Reputation > 10000 AND UES.UserCreationDate < (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '5 year') AND UES.LastAccessDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '6 month')
        THEN 'Veteran Active'
        WHEN UES.Reputation > 5000 AND UES.UserCreationDate < (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '3 year')
        THEN 'Veteran'
        ELSE 'Contributor'
    END AS UserContributionTier,
    UPPER(SUBSTRING(QPM.Title FROM 1 FOR 30)) || '...' AS AbbreviatedTitle,
    'Question created ' || EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS timestamp) - QPM.QuestionCreationDate)) || ' days ago.' AS CreationAgeDescription,
    EXISTS (
        SELECT 1 FROM TagUsageFrequency TUF
        WHERE TUF.QuestionId = QPM.QuestionId
          AND TUF.TagName IN ('sql', 'performance', 'database-design', 'optimization')
    ) AS IsRelevantTechQuestion,
    COALESCE(CAST(QPM.UniqueAnswererCount AS numeric) / NULLIF(QPM.AnswerCount, 0), 0) AS AnswererDiversityRatio,
    NTILE(5) OVER (ORDER BY
        (
            (QPM.QuestionScore * 0.7)
            + (QPM.ViewCount * 0.05)
            + (COALESCE(QPM.AverageAnswerScore, 0) * 2.0)
            + (QPM.FavoriteCount * 1.5)
            - (PH.CloseEventCount * 10)
            + (PH.ReopenEventCount * 5)
            + (CASE WHEN QPM.HasAcceptedAnswer THEN 25 ELSE 0 END)
            + (CASE WHEN QPM.CommunityOwnedDate IS NOT NULL THEN -10 ELSE 0 END)
            + (QCM.CodeBlockCount * 2)
            + (CASE WHEN QPM.HasHighScoringAnswer THEN 15 ELSE 0 END)
            - (CASE WHEN QCM.HasExternalLinksInBody THEN 5 ELSE 0 END)
        ) DESC,
        QPM.ViewCount DESC
    ) AS QualityQuintile
FROM UserEngagementSummary UES
INNER JOIN QuestionPerformanceMetrics QPM ON UES.UserId = QPM.OwnerUserId
LEFT JOIN PostHistoryAnalysis PH ON QPM.QuestionId = PH.QuestionId
LEFT JOIN QuestionComplexityMetrics QCM ON QPM.QuestionId = QCM.QuestionId
WHERE
    UES.Reputation > 2000
    AND QPM.QuestionScore >= 5
    AND QPM.ViewCount >= 500
    AND QPM.AnswerCount > 0
    AND QPM.QuestionCreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '3 year')
    AND (
        (QPM.Title ILIKE '%query%' OR QPM.Title ILIKE '%benchmark%' OR QPM.Title ILIKE '%index%')
        AND QPM.EffectiveLastActivityDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year')
        AND (PH.WasClosedAndReopened IS FALSE OR PH.WasClosedAndReopened IS NULL)
        AND QCM.BodyLength > 100
        AND (UES.GoldBadges >= 1 OR UES.SilverBadges >= 3)
        AND (
            EXISTS (SELECT 1 FROM Tags T WHERE T.TagName = 'sql' AND T.Id IN (SELECT QuestionId FROM TagUsageFrequency WHERE TagName = 'sql' AND QuestionId = QPM.QuestionId))
            OR EXISTS (SELECT 1 FROM Tags T WHERE T.TagName = 'performance' AND T.Id IN (SELECT QuestionId FROM TagUsageFrequency WHERE TagName = 'performance' AND QuestionId = QPM.QuestionId))
        )
    )
ORDER BY
    UserInfluenceRank ASC,
    QuestionQualityScore DESC,
    QPM.EffectiveLastActivityDate DESC
LIMIT 500;