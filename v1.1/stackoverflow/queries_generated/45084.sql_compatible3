WITH TopUserTags AS (
    SELECT 
        u.Id AS UserId, 
        u.DisplayName,
        tags.TagName AS TagName,
        COUNT(*) AS TagPostCount,
        DENSE_RANK() OVER (PARTITION BY u.Id ORDER BY COUNT(*) DESC) AS TagRank
    FROM Posts p
    JOIN Users u ON p.OwnerUserId = u.Id
    CROSS JOIN LATERAL (
        SELECT TRIM(tag) AS TagName
        FROM (
            -- split tags like '<tag1><tag2>' into rows without relying on STRING_SPLIT
            SELECT REGEXP_MATCHES(sub, '[^><]+', 'g') AS arr
            FROM (VALUES (SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)))) AS s(sub)
        ) t1,
        LATERAL (
            SELECT a[1] AS tag FROM UNNEST(t1.arr) AS a
        ) t2
    ) AS tags
    JOIN Tags t ON t.TagName = tags.TagName
    WHERE p.PostTypeId = 1
    GROUP BY u.Id, u.DisplayName, tags.TagName
),
UserTagExpertise AS (
    SELECT 
        UserId, 
        DisplayName,
        STRING_AGG(TagName || '(' || TagPostCount || ')', ', ' ORDER BY TagPostCount DESC) AS TopTags
    FROM TopUserTags
    WHERE TagRank <= 3
    GROUP BY UserId, DisplayName
)
SELECT 
    ute.UserId,
    ute.DisplayName,
    ute.TopTags,
    u.Reputation,
    q.QuestionCount,
    v.UpVotesCast,
    b.GoldBadges
FROM UserTagExpertise ute
JOIN Users u ON ute.UserId = u.Id
LEFT JOIN (
    SELECT p.OwnerUserId AS UserId, COUNT(*) AS QuestionCount
    FROM Posts p
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId
) q ON q.UserId = u.Id
LEFT JOIN (
    SELECT v.UserId, COUNT(*) AS UpVotesCast
    FROM Votes v
    WHERE v.VoteTypeId = 2
    GROUP BY v.UserId
) v ON v.UserId = u.Id
LEFT JOIN (
    SELECT b.UserId, COUNT(*) AS GoldBadges
    FROM Badges b
    WHERE b.Class = 1
    GROUP BY b.UserId
) b ON b.UserId = u.Id
ORDER BY u.Reputation DESC, q.QuestionCount DESC
LIMIT 100;