-- {"query": "5065.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1398} 
with active_users as (
    select u.Id as UserId, u.DisplayName, u.Reputation, u.CreationDate, 
           u.LastAccessDate, u.Location,
           count(distinct p.Id) as PostsCount,
           count(distinct c.Id) as CommentsCount,
           count(distinct b.Id) as BadgesCount,
           dense_rank() over (order by u.Reputation desc) as ReputationRank,
           sum(p.Score) as PostScoreSum
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Badges b on b.UserId = u.Id
    where u.LastAccessDate >= date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) - interval '6 month'
    group by u.Id
),
tag_stats as (
    select 
        t.TagName, t.Count as TagCount,
        coalesce(sum(p.ViewCount),0) as TagViewCount,
        count(distinct p.Id) as QuestionsWithTag,
        avg(p.Score) as AvgScore,
        avg(p.AnswerCount) as AvgAnswers,
        dense_rank() over (order by t.Count desc) as PopRank
    from Tags t
    left join Posts p 
        on p.PostTypeId = 1
        and ('<'||t.TagName||'>' = any(string_to_array(tags, '><')))
    group by t.Id
),
recent_closures as (
    select
        ph.PostId,
        max(ph.CreationDate) as ClosedDate,
        crt.Name as CloseReason,
        p.OwnerUserId,
        p.Title
    from PostHistory ph
    join PostHistoryTypes pht on ph.PostHistoryTypeId = pht.Id and pht.Name = 'Post Closed'
    left join CloseReasonTypes crt on try_cast(ph.Comment as integer) = crt.Id
    join Posts p on p.Id = ph.PostId
    where ph.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '3 month'
    group by ph.PostId, crt.Name, p.OwnerUserId, p.Title
),
question_activity as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        q.ViewCount,
        count(a.Id) as Answers,
        sum(a.Score) as TotalAnswerScore,
        max(a.CreationDate) as LastAnswerDate,
        bool_or(a.Score > 0) as HasPositiveAnswer
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id
),
user_vote_summary as (
    select
        v.UserId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotesGiven,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotesGiven,
        count(*) as TotalVotesGiven
    from Votes v
    where v.UserId is not null
    group by v.UserId
)
select 
    au.UserId,
    au.DisplayName,
    au.Reputation,
    au.Location,
    au.PostsCount,
    au.CommentsCount,
    au.BadgesCount,
    au.ReputationRank,
    au.PostScoreSum,
    us.UpVotesGiven,
    us.DownVotesGiven,
    us.TotalVotesGiven,
    coalesce(q.CountQuestions,0) as QuestionsPosted,
    coalesce(a.CountAnswers,0) as AnswersPosted,
    round(coalesce(pvs.AvgViews,0),2) as AvgQuestionViews,
    ts.TagName as MostUsedTag,
    ts.TagCount as MostUsedTagCount,
    ts.PopRank as MostUsedTagRank,
    qc.ClosedQuestionsLast3mo,
    qc.ClosedDupesLast3mo,
    ids.TopImprovedQuestion,
    ids.EditCount as TopQuestionEditCount
from active_users au
left join user_vote_summary us on us.UserId = au.UserId
left join (
    select OwnerUserId, count(*) as CountQuestions, avg(ViewCount) as AvgViews
    from Posts where PostTypeId = 1 and OwnerUserId is not null
    group by OwnerUserId
) q on q.OwnerUserId = au.UserId
left join (
    select OwnerUserId, count(*) as CountAnswers 
    from Posts where PostTypeId = 2 and OwnerUserId is not null
    group by OwnerUserId
) a on a.OwnerUserId = au.UserId
left join lateral (
    select t.TagName, t.Count, ts.PopRank
    from Tags t
    join tag_stats ts on ts.TagName = t.TagName
    join Posts p on p.OwnerUserId = au.UserId 
                 and p.PostTypeId = 1
                 and ('<'||t.TagName||'>' = any(string_to_array(p.Tags, '><')))
    group by t.TagName, t.Count, ts.PopRank
    order by count(*) desc, t.Count desc, ts.PopRank
    limit 1
) ts on true
left join (
    select p.OwnerUserId, 
        count(*) filter (where rc.CloseReason = 'Duplicate') as ClosedDupesLast3mo,
        count(*) as ClosedQuestionsLast3mo
    from recent_closures rc
    join Posts p on p.Id = rc.PostId
    group by p.OwnerUserId
) qc on qc.OwnerUserId = au.UserId
left join lateral (
    select p.Id as TopImprovedQuestion, count(ph.Id) as EditCount
    from Posts p 
    join PostHistory ph on ph.PostId = p.Id 
        and ph.PostHistoryTypeId in (4, 5, 6)
    where p.PostTypeId = 1 
      and p.OwnerUserId = au.UserId
    group by p.Id
    order by count(ph.Id) desc, p.CreationDate
    limit 1
) ids on true
where
    -- Only users with at least 5 posts in the last 6 months,
    -- at least 1 question and 1 answer, and in top half by reputation
    au.PostsCount >= 5
    and coalesce(q.CountQuestions,0) >= 1
    and coalesce(a.CountAnswers,0) >= 1
    and au.ReputationRank <= (select ceil(count(*) / 2.0) from active_users)
order by au.Reputation desc, au.PostsCount desc
limit 50;