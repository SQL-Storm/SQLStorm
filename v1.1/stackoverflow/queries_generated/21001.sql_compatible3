WITH ActiveUsers AS (
    SELECT 
        u.Id,
        u.Reputation,
        u.CreationDate,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RepRank,
        u.LastAccessDate
    FROM Users u
    WHERE u.Reputation > 1000
      AND u.LastAccessDate > CAST('2024-10-01' AS DATE) - INTERVAL '365 days'
),
HighActivityPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.Title,
        p.Tags,
        COALESCE(p.ClosedDate, p.LastActivityDate) AS LastEventDate,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostCategory
    FROM Posts p
    WHERE p.Score > 5
      AND (p.ViewCount > 1000 OR p.CommentCount > 10)
      AND p.CreationDate > CAST('2024-10-01' AS DATE) - INTERVAL '2 years'
),
UserPostTags AS (
    -- explode tags into individual tag values per post (assumes tags like '<tag1><tag2>')
    SELECT
        hap.OwnerUserId AS UserId,
        hap.Id AS PostId,
        TRIM(tag) AS Tag,
        hap.CreationDate
    FROM HighActivityPosts hap,
    LATERAL (
        SELECT regexp_split_to_table(
            regexp_replace(hap.Tags, '^<|>$', ''),   -- remove leading/trailing angle brackets
            '><'
        ) AS tag
    ) t
),
UserPostStats AS (
    SELECT 
        au.Id AS UserId,
        au.Reputation,
        au.RepRank,
        COUNT(hap.Id) AS PostCount,
        AVG(hap.Score) AS AvgPostScore,
        SUM(hap.ViewCount) AS TotalViews,
        MAX(hap.CreationDate) AS MostRecentPost,
        -- aggregate top tags by most recent post date per tag for the user
        STRING_AGG(t.Tag, ', ' ORDER BY MAX(t.CreationDate) DESC) AS TopTags
    FROM ActiveUsers au
    LEFT JOIN HighActivityPosts hap ON au.Id = hap.OwnerUserId
    LEFT JOIN UserPostTags t ON au.Id = t.UserId
    GROUP BY au.Id, au.Reputation, au.RepRank
    HAVING COUNT(hap.Id) > 0
),
BadgeAnalysis AS (
    SELECT 
        b.UserId,
        b.Class,
        COUNT(*) AS BadgeCount,
        STRING_AGG(b.Name, '; ') AS BadgeNames
    FROM Badges b
    WHERE b.Date > CAST('2024-10-01' AS DATE) - INTERVAL '1 year'
    GROUP BY b.UserId, b.Class
),
VotePatterns AS (
    SELECT 
        v.PostId,
        v.VoteTypeId,
        COUNT(*) AS VoteCount,
        AVG(v.BountyAmount) AS AvgBounty
    FROM Votes v
    WHERE v.CreationDate > CAST('2024-10-01' AS DATE) - INTERVAL '6 months'
      AND v.VoteTypeId IN (2, 3, 8, 9)
    GROUP BY v.PostId, v.VoteTypeId
),
PostVoteSums AS (
    SELECT
        vp.PostId,
        SUM(vp.VoteCount) AS TotalVotesForPost
    FROM VotePatterns vp
    GROUP BY vp.PostId
)
SELECT 
    ups.UserId,
    ups.Reputation,
    ups.RepRank,
    ups.PostCount,
    ROUND(CAST(ups.AvgPostScore AS NUMERIC), 2) AS AvgPostScore,
    ups.TotalViews,
    (ups.PostCount * ups.Reputation) AS InfluenceScore,
    COALESCE(ba.BadgeCount, 0) AS RecentBadges,
    CASE 
        WHEN ups.PostCount > 50 AND ups.RepRank <= 100 THEN 'Power User'
        WHEN ups.PostCount > 10 AND ups.Reputation > 5000 THEN 'Expert'
        ELSE 'Active'
    END AS UserTier,
    (CASE WHEN ups.TopTags IS NULL THEN '' ELSE SUBSTRING(ups.TopTags FROM 1 FOR 100) END) || CASE WHEN COALESCE(LENGTH(ups.TopTags),0) > 100 THEN '...' ELSE '' END AS TagSummary,
    COALESCE(vp.VoteCount, 0) AS TotalPostVotes,
    (ups.TotalViews / NULLIF(ups.PostCount, 0)) AS ViewsPerPost,
    GREATEST(
        EXTRACT(EPOCH FROM (CAST('2024-10-01' AS DATE) - ups.MostRecentPost)) / 86400,
        1
    ) AS DaysSinceLastPost,
    COALESCE(
        ba.BadgeNames,
        CASE 
            WHEN ups.PostCount = 0 THEN 'No recent badges or posts'
            ELSE 'Active without badges'
        END,
        'Unknown'
    ) AS BadgeInfo,
    RANK() OVER (
        PARTITION BY 
            CASE 
                WHEN ups.PostCount > 50 AND ups.RepRank <= 100 THEN 'Power User'
                WHEN ups.PostCount > 10 AND ups.Reputation > 5000 THEN 'Expert'
                ELSE 'Active'
            END 
        ORDER BY (ups.PostCount * ups.Reputation) DESC
    ) AS TierRank
FROM UserPostStats ups
LEFT JOIN BadgeAnalysis ba ON ups.UserId = ba.UserId
LEFT JOIN (
    SELECT 
        hap.OwnerUserId,
        SUM(COALESCE(pvs.TotalVotesForPost, 0)) AS VoteCount,
        MAX(vp.PostId) AS SamplePostId
    FROM HighActivityPosts hap
    LEFT JOIN VotePatterns vp ON hap.Id = vp.PostId
    LEFT JOIN PostVoteSums pvs ON hap.Id = pvs.PostId
    GROUP BY hap.OwnerUserId
) vp ON ups.UserId = vp.OwnerUserId
WHERE ups.RepRank <= 500
  AND (ups.TotalViews > 10000 OR ups.PostCount > 20)
  AND NOT EXISTS (
      SELECT 1 
      FROM PostHistory ph 
      WHERE ph.UserId = ups.UserId 
        AND ph.PostHistoryTypeId = 12
        AND ph.CreationDate > CAST('2024-10-01' AS DATE) - INTERVAL '30 days'
  )
  AND ups.MostRecentPost > CAST('2024-10-01' AS DATE) - INTERVAL '90 days'
ORDER BY (ups.PostCount * ups.Reputation) DESC, ups.RepRank ASC
LIMIT 100;