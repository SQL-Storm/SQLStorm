WITH user_stats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)               AS question_count,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)               AS answer_count,
        AVG(p.Score) FILTER (WHERE p.PostTypeId = 1)              AS avg_question_score,
        AVG(p.Score) FILTER (WHERE p.PostTypeId = 2)              AS avg_answer_score,
        SUM(v.up_votes)                                           AS upvotes,
        SUM(v.down_votes)                                         AS downvotes,
        MAX(p.LastActivityDate)                                   AS recent_activity
    FROM Users u
    LEFT JOIN Posts p
        ON p.OwnerUserId = u.Id
    LEFT JOIN LATERAL (
        SELECT 
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END)   AS up_votes,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END)   AS down_votes
        FROM Votes v
        WHERE v.PostId = p.Id
    ) v ON true
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
badge_counts AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END)   AS gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END)   AS silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END)   AS bronze_badges
    FROM Badges b
    GROUP BY b.UserId
),
user_tag_counts AS (
    -- Split Tags string like '<tag1><tag2>' into rows using a numbers table approach and standard string functions
    SELECT 
        u.Id                                   AS UserId,
        TRIM(SUBSTR(p.Tags, start_pos, end_pos - start_pos)) AS TagName,
        COUNT(*)                               AS tag_use_cnt
    FROM Users u
    JOIN Posts p
        ON p.OwnerUserId = u.Id
        AND p.PostTypeId = 1
    JOIN (
        -- generate positions of tags by finding '<' and '>' pairs up to a reasonable max (e.g., 50 tags)
        SELECT
            p2.Id AS PostId,
            pos1.pos + 1 AS start_pos,
            pos2.pos AS end_pos
        FROM Posts p2
        CROSS JOIN (
            -- generate numbers 1..50 (adjust if needed)
            SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5
            UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10
            UNION ALL SELECT 11 UNION ALL SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15
            UNION ALL SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19 UNION ALL SELECT 20
            UNION ALL SELECT 21 UNION ALL SELECT 22 UNION ALL SELECT 23 UNION ALL SELECT 24 UNION ALL SELECT 25
            UNION ALL SELECT 26 UNION ALL SELECT 27 UNION ALL SELECT 28 UNION ALL SELECT 29 UNION ALL SELECT 30
            UNION ALL SELECT 31 UNION ALL SELECT 32 UNION ALL SELECT 33 UNION ALL SELECT 34 UNION ALL SELECT 35
            UNION ALL SELECT 36 UNION ALL SELECT 37 UNION ALL SELECT 38 UNION ALL SELECT 39 UNION ALL SELECT 40
            UNION ALL SELECT 41 UNION ALL SELECT 42 UNION ALL SELECT 43 UNION ALL SELECT 44 UNION ALL SELECT 45
            UNION ALL SELECT 46 UNION ALL SELECT 47 UNION ALL SELECT 48 UNION ALL SELECT 49 UNION ALL SELECT 50
        ) nums
        CROSS JOIN LATERAL (
            -- find nth '<' position
            SELECT INSTR(p2.Tags, '<', 1, nums.n) AS pos
        ) pos1
        CROSS JOIN LATERAL (
            -- find nth '>' position after the nth '<'
            SELECT INSTR(p2.Tags, '>', pos1.pos + 1, 1) AS pos
        ) pos2
        WHERE pos1.pos > 0 AND pos2.pos > pos1.pos
    ) split
        ON split.PostId = p.Id
    JOIN Tags t
        ON t.TagName = TRIM(SUBSTR(p.Tags, split.start_pos, split.end_pos - split.start_pos))
    GROUP BY u.Id, TRIM(SUBSTR(p.Tags, split.start_pos, split.end_pos - split.start_pos))
),
top_three_tags AS (
    SELECT 
        UserId,
        LISTAGG(TagName, ', ') WITHIN GROUP (ORDER BY tag_use_cnt DESC) FILTER (WHERE rn <= 3) AS top_3_tags
    FROM (
        SELECT 
            UserId,
            TagName,
            tag_use_cnt,
            ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY tag_use_cnt DESC) AS rn
        FROM user_tag_counts
    ) ranked
    GROUP BY UserId
)
SELECT 
    us.Id,
    us.DisplayName,
    us.Reputation,
    us.question_count,
    us.answer_count,
    ROUND(CAST(us.avg_question_score AS NUMERIC), 2)    AS avg_question_score,
    ROUND(CAST(us.avg_answer_score AS NUMERIC), 2)     AS avg_answer_score,
    us.upvotes,
    us.downvotes,
    bc.gold_badges,
    bc.silver_badges,
    bc.bronze_badges,
    us.recent_activity,
    t.top_3_tags
FROM user_stats us
LEFT JOIN badge_counts bc
    ON bc.UserId = us.Id
LEFT JOIN top_three_tags t
    ON t.UserId = us.Id
GROUP BY
    us.Id,
    us.DisplayName,
    us.Reputation,
    us.question_count,
    us.answer_count,
    ROUND(CAST(us.avg_question_score AS NUMERIC), 2),
    ROUND(CAST(us.avg_answer_score AS NUMERIC), 2),
    us.upvotes,
    us.downvotes,
    bc.gold_badges,
    bc.silver_badges,
    bc.bronze_badges,
    us.recent_activity,
    t.top_3_tags
ORDER BY us.Reputation DESC
LIMIT 100;