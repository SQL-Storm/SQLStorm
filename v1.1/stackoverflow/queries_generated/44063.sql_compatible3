WITH posts_by_month AS (
  SELECT 
    DATE_TRUNC('month', CreationDate) AS month_date,
    COUNT(*) AS post_count
  FROM Posts
  WHERE CreationDate >= DATE '2020-01-01'
  GROUP BY DATE_TRUNC('month', CreationDate)
),
user_rep_changes AS (
  SELECT
    UserId AS UserId,
    MAX(Reputation) AS max_reputation,
    MIN(Reputation) AS min_reputation,
    MAX(Reputation) - MIN(Reputation) AS reputation_change
  FROM Users
  GROUP BY UserId
),
popular_tags AS (
  SELECT
    t.tag AS TagName,
    COUNT(*) AS post_count
  FROM Posts,
       UNNEST(STRING_TO_ARRAY(SUBSTRING(Tags FROM 2 FOR CHAR_LENGTH(Tags) - 2), '><')) AS t(tag)
  WHERE CreationDate >= DATE '2020-01-01'
  GROUP BY t.tag
  ORDER BY COUNT(*) DESC
  LIMIT 10
),
active_users AS (
  SELECT
    OwnerUserId AS OwnerUserId,
    COUNT(*) AS post_count
  FROM Posts
  WHERE CreationDate >= DATE '2020-01-01'
  GROUP BY OwnerUserId
  ORDER BY COUNT(*) DESC
  LIMIT 10
)
SELECT
  p.month_date,
  p.post_count AS new_posts_per_month,
  r.UserId,
  r.max_reputation,
  r.min_reputation,
  r.reputation_change,
  t.TagName,
  t.post_count AS posts_with_popular_tag,
  u.OwnerUserId,
  u.post_count AS posts_by_active_users
FROM posts_by_month p
CROSS JOIN user_rep_changes r
CROSS JOIN popular_tags t
CROSS JOIN active_users u
ORDER BY p.month_date;