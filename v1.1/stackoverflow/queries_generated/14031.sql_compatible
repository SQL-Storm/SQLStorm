WITH cte AS (
  SELECT 
    p.Id, 
    p.PostTypeId, 
    p.OwnerUserId, 
    p.CreationDate, 
    p.LastEditDate, 
    p.LastActivityDate, 
    p.ClosedDate, 
    p.CommunityOwnedDate, 
    p.AnswerCount, 
    p.CommentCount, 
    p.FavoriteCount, 
    p.Score, 
    p.ViewCount, 
    CASE WHEN p.PostTypeId = 1 THEN p.AcceptedAnswerId ELSE NULL END AS AcceptedAnswerId,
    CASE WHEN p.PostTypeId = 2 THEN p.ParentId ELSE NULL END AS ParentId,
    CASE WHEN p.PostTypeId IN (4, 5) THEN p.Title ELSE NULL END AS TagTitle,
    CASE WHEN p.PostTypeId IN (4, 5) THEN p.Tags ELSE NULL END AS TagTags,
    CASE WHEN p.PostTypeId = 1 THEN p.Title ELSE NULL END AS QuestionTitle,
    CASE WHEN p.PostTypeId = 1 THEN p.Tags ELSE NULL END AS QuestionTags,
    CASE WHEN p.PostTypeId = 2 THEN p.Body ELSE NULL END AS AnswerBody,
    CASE WHEN p.PostTypeId = 1 THEN p.Body ELSE NULL END AS QuestionBody,
    u.Reputation, 
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate, 
    u.DisplayName, 
    u.WebsiteUrl, 
    u.Location, 
    u.AboutMe, 
    u.Views, 
    u.UpVotes, 
    u.DownVotes, 
    u.ProfileImageUrl, 
    u.emailhash AS EmailHash, 
    u.AccountId
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
),
badges_cte AS (
  SELECT 
    b.Id, 
    b.UserId, 
    b.Name, 
    b.Date, 
    b.Class, 
    b.TagBased
  FROM Badges b
)
SELECT 
  cte.Id, 
  cte.PostTypeId, 
  cte.OwnerUserId, 
  cte.CreationDate, 
  cte.LastEditDate, 
  cte.LastActivityDate, 
  cte.ClosedDate, 
  cte.CommunityOwnedDate, 
  cte.AnswerCount, 
  cte.CommentCount, 
  cte.FavoriteCount, 
  cte.Score, 
  cte.ViewCount, 
  cte.AcceptedAnswerId, 
  cte.ParentId, 
  cte.TagTitle, 
  cte.TagTags, 
  cte.QuestionTitle, 
  cte.QuestionTags, 
  cte.AnswerBody, 
  cte.QuestionBody, 
  cte.Reputation, 
  cte.UserCreationDate, 
  cte.LastAccessDate, 
  cte.DisplayName, 
  cte.WebsiteUrl, 
  cte.Location, 
  cte.AboutMe, 
  cte.Views, 
  cte.UpVotes, 
  cte.DownVotes, 
  cte.ProfileImageUrl, 
  cte.EmailHash, 
  cte.AccountId, 
  badges_cte.Id AS BadgeId, 
  badges_cte.Name AS BadgeName, 
  badges_cte.Date AS BadgeDate, 
  badges_cte.Class AS BadgeClass, 
  badges_cte.TagBased AS BadgeTagBased
FROM cte
LEFT JOIN badges_cte ON cte.OwnerUserId = badges_cte.UserId
ORDER BY cte.Id, badges_cte.Id;