WITH UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate AS UserCreationDate,
        COUNT(p.Id) AS TotalPosts,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS TotalQuestions,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS TotalAnswers,
        SUM(p.Score) AS TotalPostScore,
        MAX(p.LastActivityDate) AS LastPostActivityDate,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotesReceived,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownvotesReceived
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    GROUP BY
        u.Id, u.Reputation, u.DisplayName, u.CreationDate
),
PostMetrics AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate AS PostCreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        COALESCE(p.AcceptedAnswerId, -1) AS AcceptedAnswerId,
        COALESCE(p.ParentId, -1) AS ParentId,
        p.OwnerUserId,
        COALESCE(p.LastEditorUserId, -1) AS LastEditorUserId,
        p.LastEditDate,
        p.LastActivityDate,
        p.Title,
        p.Body,
        p.Tags,
        COALESCE(p.ClosedDate, '1970-01-01') AS ClosedDate,
        COALESCE(p.CommunityOwnedDate, '1970-01-01') AS CommunityOwnedDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS PostRank
    FROM
        Posts p
),
BadgeDistribution AS (
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        SUM(CASE WHEN b.TagBased = 1 THEN 1 ELSE 0 END) AS TagBasedBadges
    FROM
        Badges b
    GROUP BY
        b.UserId
)
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.UserCreationDate,
    ua.TotalPosts,
    ua.TotalQuestions,
    ua.TotalAnswers,
    ua.TotalPostScore,
    ua.LastPostActivityDate,
    ua.TotalBadges,
    ua.TotalUpvotesReceived,
    ua.TotalDownvotesReceived,
    pm.PostId,
    pm.PostTypeId,
    pm.PostCreationDate,
    pm.Score,
    pm.ViewCount,
    pm.AnswerCount,
    pm.CommentCount,
    pm.FavoriteCount,
    pm.AcceptedAnswerId,
    pm.ParentId,
    pm.OwnerUserId,
    pm.LastEditorUserId,
    pm.LastEditDate,
    pm.LastActivityDate,
    pm.Title,
    pm.Body,
    pm.Tags,
    pm.ClosedDate,
    pm.CommunityOwnedDate,
    pm.PostRank,
    bd.TotalBadges AS BadgeDistributionTotalBadges,
    bd.GoldBadges,
    bd.SilverBadges,
    bd.BronzeBadges,
    bd.TagBasedBadges,
    CASE
        WHEN pm.PostTypeId = 1 THEN 'Question'
        WHEN pm.PostTypeId = 2 THEN 'Answer'
        WHEN pm.PostTypeId = 3 THEN 'Wiki'
        ELSE 'Other'
    END AS PostTypeName,
    CASE
        WHEN pm.ClosedDate > '1970-01-01' THEN 'Closed'
        ELSE 'Open'
    END AS PostStatus,
    CASE
        WHEN pm.CommunityOwnedDate > '1970-01-01' THEN 'Community Owned'
        ELSE 'User Owned'
    END AS OwnershipStatus
FROM
    UserActivity ua
LEFT JOIN
    PostMetrics pm ON ua.UserId = pm.OwnerUserId AND pm.PostRank <= 5
LEFT JOIN
    BadgeDistribution bd ON ua.UserId = bd.UserId
WHERE
    ua.TotalPosts > 0
ORDER BY
    ua.UserId, pm.PostRank;