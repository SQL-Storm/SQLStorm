WITH UserActivity AS (
  SELECT 
    u.Id AS UserId,
    u.Reputation,
    u.DisplayName,
    u.CreationDate AS UserCreationDate,
    COUNT(DISTINCT p.Id) AS PostCount,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
    AVG(p.Score) AS AvgPostScore,
    MAX(p.CreationDate) AS LastPostDate
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.DeletionDate IS NULL
  GROUP BY u.Id, u.Reputation, u.DisplayName, u.CreationDate
  HAVING COUNT(DISTINCT p.Id) > 0
),
TopContributors AS (
  SELECT 
    ua.*,
    ROW_NUMBER() OVER (ORDER BY ua.PostCount DESC, ua.Reputation DESC) AS ActivityRank,
    LAG(ua.PostCount) OVER (ORDER BY ua.Reputation DESC) AS PrevReputationPostCount
  FROM UserActivity ua
),
TagStats AS (
  SELECT 
    t.TagName,
    t.Count AS TagUsageCount,
    COUNT(DISTINCT p.OwnerUserId) AS UniqueUsers,
    AVG(p.Score) AS AvgQuestionScore,
    PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY p.ViewCount) AS P90ViewCount
  FROM Tags t
  INNER JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    AND p.PostTypeId = 1 
    AND p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '1 year'
  GROUP BY t.Id, t.TagName, t.Count
  HAVING t.Count > 100
),
UserTagEngagement AS (
  SELECT 
    tc.UserId,
    tc.DisplayName,
    ts.TagName,
    COUNT(DISTINCT p.Id) AS UserTagPostCount,
    SUM(p.ViewCount) AS TotalTagViews,
    FIRST_VALUE(ts.TagName) OVER (
      PARTITION BY tc.UserId 
      ORDER BY COUNT(DISTINCT p.Id) DESC 
      ROWS UNBOUNDED PRECEDING
    ) AS TopTagForUser
  FROM TopContributors tc
  INNER JOIN Posts p ON tc.UserId = p.OwnerUserId 
    AND p.PostTypeId = 1 
    AND p.DeletionDate IS NULL
  INNER JOIN TagStats ts ON p.Tags LIKE '%' || ts.TagName || '%'
  WHERE tc.ActivityRank <= 1000
  GROUP BY tc.UserId, tc.DisplayName, ts.TagName
)
SELECT 
  tc.DisplayName,
  tc.Reputation,
  tc.PostCount,
  tc.QuestionCount,
  tc.AnswerCount,
  tc.ActivityRank,
  ute.TopTagForUser,
  COALESCE(ute.UserTagPostCount, 0) AS PrimaryTagPosts,
  COALESCE(ute.TotalTagViews, 0) AS PrimaryTagViews,
  ts.P90ViewCount AS TagPopularity,
  CASE 
    WHEN tc.LastPostDate > cast('2024-10-01' as date) - INTERVAL '30 days' THEN 'Active'
    WHEN tc.LastPostDate > cast('2024-10-01' as date) - INTERVAL '90 days' THEN 'Moderately Active'
    ELSE 'Inactive'
  END AS RecentActivityStatus,
  CONCAT(
    UPPER(SUBSTRING(tc.DisplayName FROM 1 FOR 1)),
    LOWER(SUBSTRING(tc.DisplayName FROM 2)),
    ' has ',
    tc.PostCount,
    ' posts'
  ) AS UserSummary,
  GREATEST(
    COALESCE(tc.PrevReputationPostCount, 0),
    COALESCE(ute.UserTagPostCount, 0)
  ) AS EngagementMetric,
  (tc.Reputation * 1.0 / NULLIF(tc.PostCount, 0)) AS RepPerPost,
  NULLIF(tc.Reputation, 0) IS NOT NULL AND tc.PostCount > 50 AS HighValueContributor
FROM TopContributors tc
LEFT JOIN UserTagEngagement ute ON tc.UserId = ute.UserId 
  AND ute.TagName = ute.TopTagForUser
LEFT JOIN TagStats ts ON ute.TopTagForUser = ts.TagName
WHERE tc.ActivityRank <= 500
  AND (tc.QuestionCount > 10 OR tc.AnswerCount > 20)
  AND tc.UserCreationDate < cast('2024-10-01' as date) - INTERVAL '6 months'
  AND COALESCE(ute.TotalTagViews, 0) > 1000
ORDER BY tc.Reputation DESC NULLS LAST, tc.PostCount DESC, ts.P90ViewCount DESC NULLS LAST
LIMIT 100;