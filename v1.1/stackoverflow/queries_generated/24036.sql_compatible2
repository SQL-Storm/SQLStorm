WITH answers_union AS (
    SELECT p.Id AS QuestionId
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND EXISTS (SELECT 1
                  FROM Posts a
                  WHERE a.ParentId = p.Id
                    AND a.PostTypeId = 2)
    UNION ALL
    SELECT p.Id AS QuestionId
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND NOT EXISTS (SELECT 1
                      FROM Posts a
                      WHERE a.ParentId = p.Id
                        AND a.PostTypeId = 2)
),
tag_counts AS (
    SELECT q.Id AS QuestionId,
           COUNT(DISTINCT t.TagName) AS TagCount
    FROM Posts q
    JOIN answers_union au ON au.QuestionId = q.Id
    JOIN Tags t ON POSITION(t.TagName IN q.Tags) > 0
    GROUP BY q.Id
),
recent_activity AS (
    SELECT p.Id AS PostId,
           p.CreationDate,
           p.Score,
           p.AnswerCount,
           COALESCE((SELECT MIN(a.CreationDate)
                     FROM Posts a
                     WHERE a.ParentId = p.Id
                       AND a.PostTypeId = 2),
                    p.CreationDate) AS FirstAnswerDate,
           p.OwnerUserId
    FROM Posts p
    WHERE p.PostTypeId = 1
),
user_info AS (
    SELECT u.Id   AS UserId,
           u.Reputation
    FROM Users u
),
duplicate_chain AS (
    SELECT pl.PostId,
           pl.RelatedPostId,
           0 AS depth
    FROM PostLinks pl
    WHERE pl.LinkTypeId = 3
    UNION ALL
    SELECT d.PostId,
           pl.RelatedPostId,
           d.depth + 1
    FROM duplicate_chain d
    JOIN PostLinks pl ON pl.PostId = d.RelatedPostId
                      AND pl.LinkTypeId = 3
)
SELECT
    ra.PostId                    AS QuestionId,
    ra.Score                     AS QuestionScore,
    ra.AnswerCount,
    rc.TagCount,
    EXTRACT(EPOCH FROM (ra.FirstAnswerDate - ra.CreationDate)) / 3600
                                   AS HoursToFirstAnswer,
    u.Reputation                 AS OwnerReputation,
    (ra.AnswerCount + COALESCE(rc.TagCount, 0)) * 3 + COALESCE(u.Reputation, 0) / 10
                                   AS CompositeMetric,
    d.RelatedPostId,
    d.depth,
    ROW_NUMBER() OVER(ORDER BY
        (ra.AnswerCount + COALESCE(rc.TagCount, 0)) * 3 + COALESCE(u.Reputation, 0) / 10 DESC) AS RowNum
FROM recent_activity ra
LEFT JOIN tag_counts rc ON rc.QuestionId = ra.PostId
LEFT JOIN duplicate_chain d ON d.PostId = ra.PostId
LEFT JOIN user_info u ON u.UserId = ra.OwnerUserId
WHERE (ra.AnswerCount > 0 AND ra.Score > 0)
   OR (ra.AnswerCount = 0 AND ra.Score > 10)
GROUP BY
    ra.PostId,
    ra.Score,
    ra.AnswerCount,
    rc.TagCount,
    ra.FirstAnswerDate,
    ra.CreationDate,
    u.Reputation,
    d.RelatedPostId,
    d.depth
ORDER BY CompositeMetric DESC
LIMIT 200;