with
user_activity as (
  select
    u.id,
    u.displayname,
    u.reputation,
    count(distinct case when p.posttypeid = 2 and exists (select 1 from posts q where q.id = p.parentid and q.acceptedanswerid = p.id) then p.id end) as accepted_answers,
    count(distinct p.id) filter (where p.posttypeid in (1,2)) as posts_count,
    max(p.creationdate) as last_post,
    extract(epoch from (timestamp '2024-10-01 12:34:56' - coalesce(max(p.creationdate), u.creationdate))) / 86400.0 as days_since_last_post,
    (count(distinct p.id) * 1.0) / (1 + extract(epoch from (timestamp '2024-10-01 12:34:56' - coalesce(max(p.creationdate), u.creationdate))) / 86400.0) as recency_score
  from users u
  left join posts p on p.owneruserid = u.id
  group by u.id, u.displayname, u.reputation, u.creationdate
),
question_tags as (
  select
    q.id as question_id,
    q.owneruserid,
    trim(both '<>' from unnest(string_to_array(substring(q.tags from 2 for char_length(q.tags) - 2), '><'))) as tag
  from posts q
  where q.posttypeid = 1 and q.tags is not null and q.tags <> ''
),
tag_stats as (
  select
    t.tag,
    count(*) as q_count,
    avg(s.qp_score) as avg_question_score,
    sum(case when exists (select 1 from posts a where a.parentid = t.question_id and a.score >= 5) then 1 else 0 end) as questions_with_high_scoring_answer_dummy
  from question_tags t
  join lateral (
    select p.score as qp_score from posts p where p.id = t.question_id
  ) s on true
  group by t.tag
),
tag_ranked as (
  select
    tag,
    q_count,
    avg_question_score,
    row_number() over (order by q_count desc, avg_question_score desc) as tag_rank,
    dense_rank() over (order by avg_question_score desc) as avg_score_rank
  from tag_stats
),
user_ranked as (
  select
    ua.id,
    ua.displayname,
    ua.reputation,
    ua.accepted_answers,
    ua.posts_count,
    ua.last_post,
    ua.days_since_last_post,
    ua.recency_score,
    row_number() over (order by accepted_answers desc nulls last, recency_score desc, reputation desc) as user_rank,
    -- median manually computed to avoid ordered-set WITHIN GROUP OVER()
    (select percentile_cont(0.5) within group (order by accepted_answers)
     from user_activity ua2) as median_accepted_answers
  from user_activity ua
),
user_tag_aggregate as (
  select
    ur.id as user_id,
    ur.displayname,
    tt.tag,
    count(a.id) as answers_in_tag,
    avg(a.score) filter (where a.score is not null) as avg_answer_score,
    sum(case when a.creationdate >= timestamp '2024-10-01 12:34:56' - interval '365 days' then 1 else 0 end) as answers_last_year,
    max(a.creationdate) as last_answer_date
  from user_ranked ur
  join posts a on a.owneruserid = ur.id and a.posttypeid = 2
  left join posts q on q.id = a.parentid and q.posttypeid = 1
  left join lateral (
    select trim(both '<>' from unnest(string_to_array(substring(coalesce(q.tags, '') from 2 for char_length(coalesce(q.tags, '')) - 2), '><'))) as tag
  ) tt on q.tags is not null and q.tags <> ''
  group by ur.id, ur.displayname, tt.tag
),
user_best_worst_tag as (
  select
    uta.user_id,
    uta.displayname,
    first_value(uta.tag) over (partition by uta.user_id order by answers_in_tag desc nulls last, avg_answer_score desc nulls last) as best_tag,
    first_value(uta.avg_answer_score) over (partition by uta.user_id order by avg_answer_score desc nulls last) as best_tag_avg_score,
    first_value(uta.tag) over (partition by uta.user_id order by answers_in_tag asc nulls last, avg_answer_score asc nulls last) as worst_tag,
    first_value(uta.avg_answer_score) over (partition by uta.user_id order by avg_answer_score asc nulls last) as worst_tag_avg_score,
    sum(answers_in_tag) over (partition by uta.user_id) as total_tagged_answers
  from user_tag_aggregate uta
),
interesting_posts as (
  select p.id as post_id,
    p.title,
    p.creationdate,
    p.score,
    p.viewcount,
    p.owneruserid,
    u.displayname as owner_name,
    coalesce(p.tags, '') as raw_tags,
    (select trim(both '<>' from unnest(string_to_array(substring(p.tags from 2 for char_length(coalesce(p.tags, '')) - 2), '><'))) limit 1) as first_tag,
    (select count(*) from posts a where a.parentid = p.id and a.posttypeid = 2 and a.creationdate >= timestamp '2024-10-01 12:34:56' - interval '30 days')::numeric as answers_30d_numeric,
    (select count(*) from posts a where a.parentid = p.id and a.posttypeid = 2 and a.creationdate >= timestamp '2024-10-01 12:34:56' - interval '365 days' and a.creationdate < timestamp '2024-10-01 12:34:56' - interval '30 days')::numeric as answers_prev_year_numeric,
    case
      when p.viewcount is null then -1
      when p.viewcount = 0 then 0
      else ceil(ln(1 + p.viewcount))
    end as view_log,
    (coalesce(p.score, 0) * greatest(1, least(5, sqrt(coalesce(p.viewcount, 1)) / 10)) + coalesce((select sum(v.bountyamount) from votes v where v.postid = p.id and v.votetypeid in (8,9)), 0)) as adjusted_score
  from posts p
  left join users u on u.id = p.owneruserid
  where p.posttypeid = 1
    and p.creationdate between timestamp '2024-10-01 12:34:56' - interval '3 years' and timestamp '2024-10-01 12:34:56'
),
comment_and_link as (
  select c.id * 1 as obj_id, c.postid as related_post_id, 'comment' as obj_type, c.creationdate, c.score, c.text as body
  from comments c
  where c.creationdate >= timestamp '2024-10-01 12:34:56' - interval '90 days'
  union
  select pl.id as obj_id, pl.relatedpostid as related_post_id, 'link' as obj_type, pl.creationdate, cast(null as integer) as score, cast(null as varchar) as body
  from postlinks pl
  where pl.creationdate >= timestamp '2024-10-01 12:34:56' - interval '365 days' and pl.linktypeid = 1
),
final as (
  select
    up.user_rank,
    up.id as user_id,
    up.displayname as user_name,
    up.reputation,
    up.accepted_answers,
    up.posts_count,
    ubt.best_tag,
    ubt.best_tag_avg_score,
    ubt.worst_tag,
    ubt.total_tagged_answers,
    ip.post_id,
    ip.title,
    ip.first_tag,
    ip.creationdate as question_date,
    ip.score as question_score,
    ip.answers_30d_numeric as answers_30d,
    ip.answers_prev_year_numeric as answers_prev_year,
    ip.view_log,
    ip.adjusted_score,
    (select count(*) from votes v where v.postid = ip.post_id and v.votetypeid = 2) as upvotes_count,
    (select count(*) from votes v where v.postid = ip.post_id and v.votetypeid = 3) as downvotes_count,
    (select string_agg(distinct tt.tag, ',') from question_tags tt where tt.question_id = ip.post_id) as tags_agg,
    exists (
      select 1 from posts a
      where a.parentid = ip.post_id and a.owneruserid = up.id and a.id = (select q.acceptedanswerid from posts q where q.id = ip.post_id)
    ) as user_has_accepted_answer,
    (select count(*) from badges b where b.userid = up.id and b.name ilike '%favorite%') as favorite_badges,
    coalesce(
      (select cl.obj_type || ':' || cast(cl.obj_id as text) || ':' || coalesce(substr(cl.body,1,60), '') from comment_and_link cl where cl.related_post_id = ip.post_id order by cl.creationdate desc limit 1),
      'none'
    ) as recent_related_activity
  from user_ranked up
  left join user_best_worst_tag ubt on ubt.user_id = up.id
  left join lateral (
    select * from interesting_posts ip where ip.first_tag = ubt.best_tag order by ip.adjusted_score desc limit 5
  ) ip on true
  where up.user_rank <= 100
)
select
  f.user_rank,
  f.user_id,
  f.user_name,
  f.reputation,
  f.accepted_answers,
  f.posts_count,
  f.best_tag,
  f.best_tag_avg_score,
  f.worst_tag,
  f.total_tagged_answers,
  f.post_id,
  f.title,
  f.first_tag,
  f.question_date,
  f.question_score,
  f.answers_30d,
  f.answers_prev_year,
  f.view_log,
  f.adjusted_score,
  f.upvotes_count,
  f.downvotes_count,
  f.tags_agg,
  f.user_has_accepted_answer,
  f.favorite_badges,
  f.recent_related_activity,
  ntile(10) over (order by f.adjusted_score desc nulls last) as decile_by_adjusted_score,
  rank() over (partition by coalesce(f.first_tag, '<none>') order by f.adjusted_score desc nulls last) as per_tag_rank,
  case
    when f.user_has_accepted_answer then
      (coalesce(f.adjusted_score, 0) * 1.25) + (coalesce(f.upvotes_count, 0) - coalesce(f.downvotes_count, 0)) * 0.5
    when f.answers_30d > 5 then
      (coalesce(f.adjusted_score, 0) * 1.1) + greatest(f.answers_30d - f.answers_prev_year, 0) * 2
    else
      coalesce(f.adjusted_score, 0)
  end as final_rank_score
from final f
order by final_rank_score desc nulls last, f.user_rank, f.post_id
limit 500;