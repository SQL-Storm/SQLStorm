WITH UserActivityMetrics AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        MAX(U.LastAccessDate) AS UserLastAccessDate,
        COUNT(DISTINCT P.Id) AS TotalPostsCreated,
        COUNT(CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS QuestionsCount,
        COUNT(CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS AnswersCount,
        SUM(COALESCE(P.Score, 0)) AS TotalPostScore,
        AVG(P.Score) FILTER (WHERE P.PostTypeId = 1) AS AvgQuestionScore,
        AVG(P.Score) FILTER (WHERE P.PostTypeId = 2) AS AvgAnswerScore,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        SUM(COALESCE(C.Score, 0)) AS TotalCommentScore,
        COUNT(DISTINCT V.PostId) AS PostsVotedOnCount,
        COUNT(V.Id) FILTER (WHERE V.VoteTypeId = 2) AS TotalUpVotesGiven,
        COUNT(V.Id) FILTER (WHERE V.VoteTypeId = 3) AS TotalDownVotesGiven,
        SUM(CASE WHEN V.VoteTypeId = 8 THEN COALESCE(V.BountyAmount, 0) ELSE 0 END) AS TotalBountyGiven
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate
),
PostEngagementDetails AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.CreationDate AS PostCreationDate,
        P.LastActivityDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.CommentCount,
        P.FavoriteCount,
        P.OwnerUserId,
        P.AcceptedAnswerId,
        COALESCE(P.Title, 'No Title Provided') AS PostTitle,
        CASE
            WHEN P.Tags IS NOT NULL AND LENGTH(TRIM(P.Tags)) > 2
            THEN string_to_array(SUBSTRING(P.Tags FROM 2 FOR CHAR_LENGTH(P.Tags)-2), '><')
            ELSE NULL
        END AS TagsArray,
        (SELECT AVG(C_sub.Score) FROM Comments C_sub WHERE C_sub.PostId = P.Id) AS AvgCommentScore,
        (SELECT COUNT(DISTINCT C_sub.UserId) FROM Comments C_sub WHERE C_sub.PostId = P.Id AND C_sub.UserId IS NOT NULL) AS DistinctCommentersCount,
        (SELECT COUNT(PL.Id) FROM PostLinks PL WHERE PL.PostId = P.Id OR PL.RelatedPostId = P.Id) AS TotalLinksCount,
        P.ClosedDate,
        CASE
            WHEN P.ClosedDate IS NOT NULL THEN
                (SELECT CRT.Name
                 FROM PostHistory PH_close
                 JOIN CloseReasonTypes CRT ON PH_close.CloseReasonTypeId = CRT.Id
                 WHERE PH_close.PostId = P.Id
                   AND PH_close.PostHistoryTypeId IN (10, 11)
                 ORDER BY PH_close.CreationDate DESC
                 LIMIT 1)
            ELSE NULL
        END AS CloseReasonName,
        (SELECT COUNT(*) FROM Posts PA WHERE PA.ParentId = P.Id) AS AnswerCount,
        (SELECT SUM(COALESCE(PA.Score,0)) FROM Posts PA WHERE PA.ParentId = P.Id) AS AnswersTotalScore,
        (SELECT AVG(COALESCE(PA.Score,0)) FROM Posts PA WHERE PA.ParentId = P.Id) AS AnswersAvgScore
    FROM Posts P
),
PostTagExploded AS (
    SELECT
        PED.PostId,
        unnest(PED.TagsArray) AS Tag
    FROM PostEngagementDetails PED
    WHERE PED.TagsArray IS NOT NULL
),
PostScoreWindow AS (
    SELECT
        P.PostId,
        P.PostTypeId,
        P.PostCreationDate,
        P.LastActivityDate,
        P.PostScore,
        P.ViewCount,
        P.CommentCount,
        P.FavoriteCount,
        P.OwnerUserId,
        P.AcceptedAnswerId,
        P.PostTitle,
        P.TagsArray,
        P.AvgCommentScore,
        P.DistinctCommentersCount,
        P.TotalLinksCount,
        P.ClosedDate,
        P.CloseReasonName,
        P.AnswerCount,
        P.AnswersTotalScore,
        P.AnswersAvgScore,
        ROW_NUMBER() OVER (PARTITION BY P.OwnerUserId ORDER BY P.PostCreationDate DESC NULLS LAST) AS OwnerRecentPostRank,
        AVG(P.PostScore) OVER (PARTITION BY P.OwnerUserId) AS OwnerAvgPostScore,
        COUNT(P.PostId) OVER (PARTITION BY P.OwnerUserId) AS OwnerPostCount
    FROM PostEngagementDetails P
)
SELECT
    UAM.UserId,
    UAM.DisplayName,
    UAM.Reputation,
    UAM.UserCreationDate,
    UAM.UserLastAccessDate,
    UAM.TotalPostsCreated,
    UAM.QuestionsCount,
    UAM.AnswersCount,
    UAM.TotalPostScore,
    UAM.AvgQuestionScore,
    UAM.AvgAnswerScore,
    UAM.TotalCommentsMade,
    UAM.TotalCommentScore,
    UAM.PostsVotedOnCount,
    UAM.TotalUpVotesGiven,
    UAM.TotalDownVotesGiven,
    UAM.TotalBountyGiven,
    PSD.PostId,
    PSD.PostTypeId,
    PSD.PostCreationDate,
    PSD.LastActivityDate,
    PSD.PostScore,
    PSD.ViewCount,
    PSD.CommentCount,
    PSD.FavoriteCount,
    PSD.OwnerUserId,
    PSD.AcceptedAnswerId,
    PSD.PostTitle,
    PSD.TagsArray,
    PTE.Tag,
    PSD.AvgCommentScore,
    PSD.DistinctCommentersCount,
    PSD.TotalLinksCount,
    PSD.ClosedDate,
    PSD.CloseReasonName,
    PSD.AnswerCount,
    PSD.AnswersTotalScore,
    PSD.AnswersAvgScore,
    PSD.OwnerRecentPostRank,
    PSD.OwnerAvgPostScore,
    PSD.OwnerPostCount
FROM UserActivityMetrics UAM
LEFT JOIN PostScoreWindow PSD ON UAM.UserId = PSD.OwnerUserId
LEFT JOIN PostTagExploded PTE ON PSD.PostId = PTE.PostId
GROUP BY
    UAM.UserId,
    UAM.DisplayName,
    UAM.Reputation,
    UAM.UserCreationDate,
    UAM.UserLastAccessDate,
    UAM.TotalPostsCreated,
    UAM.QuestionsCount,
    UAM.AnswersCount,
    UAM.TotalPostScore,
    UAM.AvgQuestionScore,
    UAM.AvgAnswerScore,
    UAM.TotalCommentsMade,
    UAM.TotalCommentScore,
    UAM.PostsVotedOnCount,
    UAM.TotalUpVotesGiven,
    UAM.TotalDownVotesGiven,
    UAM.TotalBountyGiven,
    PSD.PostId,
    PSD.PostTypeId,
    PSD.PostCreationDate,
    PSD.LastActivityDate,
    PSD.PostScore,
    PSD.ViewCount,
    PSD.CommentCount,
    PSD.FavoriteCount,
    PSD.OwnerUserId,
    PSD.AcceptedAnswerId,
    PSD.PostTitle,
    PSD.TagsArray,
    PTE.Tag,
    PSD.AvgCommentScore,
    PSD.DistinctCommentersCount,
    PSD.TotalLinksCount,
    PSD.ClosedDate,
    PSD.CloseReasonName,
    PSD.AnswerCount,
    PSD.AnswersTotalScore,
    PSD.AnswersAvgScore,
    PSD.OwnerRecentPostRank,
    PSD.OwnerAvgPostScore,
    PSD.OwnerPostCount;