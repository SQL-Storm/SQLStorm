SELECT 
    p.Id as PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    u.DisplayName as OwnerName,
    u.Reputation,
    COUNT(DISTINCT c.Id) as CommentCount,
    COUNT(DISTINCT v.Id) as VoteCount,
    COUNT(DISTINCT ph.Id) as HistoryCount,
    STRING_AGG(DISTINCT t.TagName, ', ') as Tags,
    CASE 
        WHEN p.PostTypeId = 1 THEN 'Question'
        WHEN p.PostTypeId = 2 THEN 'Answer'
        WHEN p.PostTypeId = 3 THEN 'Wiki'
        WHEN p.PostTypeId = 4 THEN 'TagWikiExcerpt'
        WHEN p.PostTypeId = 5 THEN 'TagWiki'
        WHEN p.PostTypeId = 6 THEN 'ModeratorNomination'
        WHEN p.PostTypeId = 7 THEN 'WikiPlaceholder'
        WHEN p.PostTypeId = 8 THEN 'PrivilegeWiki'
    END as PostType,
    CASE 
        WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN 'Answered'
        WHEN p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL THEN 'Closed'
        WHEN p.PostTypeId = 1 AND p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
        ELSE 'Open'
    END as Status,
    CAST(EXTRACT(EPOCH FROM (COALESCE(p.ClosedDate, TIMESTAMP '2024-10-01 12:34:56') - p.CreationDate)) / 86400 AS INTEGER) as AgeInDays,
    (SELECT COUNT(*) FROM Posts p2 WHERE p2.ParentId = p.Id AND p2.PostTypeId = 2) as AnswerCount,
    (SELECT COUNT(*) FROM Votes v2 WHERE v2.PostId = p.Id AND v2.VoteTypeId IN (2,3)) as NetVotes,
    (SELECT AVG(CAST(v3.BountyAmount AS DOUBLE PRECISION)) FROM Votes v3 WHERE v3.PostId = p.Id AND v3.VoteTypeId = 8) as AvgBounty,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 1) as GoldBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 2) as SilverBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = p.OwnerUserId AND b.Class = 3) as BronzeBadges,
    (SELECT COUNT(*) FROM Posts p3 WHERE p3.OwnerUserId = p.OwnerUserId AND p3.PostTypeId = 1 AND p3.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')) as QuestionsLast6Months,
    (SELECT COUNT(*) FROM Posts p4 WHERE p4.OwnerUserId = p.OwnerUserId AND p4.PostTypeId = 2 AND p4.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')) as AnswersLast6Months,
    (SELECT COUNT(*) FROM Comments c2 WHERE c2.UserId = p.OwnerUserId AND c2.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')) as CommentsLast6Months,
    (SELECT COUNT(*) FROM Votes v4 WHERE v4.UserId = p.OwnerUserId AND v4.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')) as VotesLast6Months,
    (SELECT COUNT(*) FROM PostHistory ph2 WHERE ph2.UserId = p.OwnerUserId AND ph2.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')) as EditsLast6Months,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id OR pl.RelatedPostId = p.Id) as LinkCount,
    (SELECT ph3.Text FROM PostHistory ph3 WHERE ph3.PostId = p.Id AND ph3.PostHistoryTypeId IN (1,4) ORDER BY ph3.CreationDate DESC LIMIT 1) as LatestTitle,
    (SELECT ph4.Text FROM PostHistory ph4 WHERE ph4.PostId = p.Id AND ph4.PostHistoryTypeId IN (2,5) ORDER BY ph4.CreationDate DESC LIMIT 1) as LatestBody,
    (SELECT ph5.Comment FROM PostHistory ph5 WHERE ph5.PostId = p.Id AND ph5.PostHistoryTypeId = 10 ORDER BY ph5.CreationDate DESC LIMIT 1) as CloseReason,
    (SELECT ph6.Comment FROM PostHistory ph6 WHERE ph6.PostId = p.Id AND ph6.PostHistoryTypeId = 11 ORDER BY ph6.CreationDate DESC LIMIT 1) as ReopenReason
FROM Posts p
INNER JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Comments c ON p.Id = c.PostId
LEFT JOIN Votes v ON p.Id = v.PostId
LEFT JOIN PostHistory ph ON p.Id = ph.PostId
LEFT JOIN Posts p5 ON p5.ParentId = p.Id AND p5.PostTypeId = 2
LEFT JOIN Tags t ON t.TagName = ANY(string_to_array(p.Tags, '>'))
WHERE p.PostTypeId IN (1,2) 
    AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')
    AND p.ViewCount > 100
    AND p.Score >= -10
GROUP BY 
    p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, u.DisplayName, 
    u.Reputation, p.PostTypeId, p.AcceptedAnswerId, p.ClosedDate, 
    p.CommunityOwnedDate, p.OwnerUserId, p.Tags, p.Id
HAVING 
    COUNT(DISTINCT c.Id) >= 5 
    OR COUNT(DISTINCT v.Id) >= 10 
    OR COUNT(DISTINCT ph.Id) >= 3
ORDER BY 
    p.ViewCount DESC, 
    p.Score DESC, 
    p.CreationDate DESC,
    (SELECT COUNT(*) FROM PostHistory ph7 WHERE ph7.PostId = p.Id AND ph7.PostHistoryTypeId = 10) DESC
OFFSET 1000
FETCH NEXT 1000 ROWS ONLY;