WITH PostMetrics AS (
  SELECT P.Id, P.Title, P.Score, P.CreationDate, P.OwnerUserId, P.ClosedDate,
         COUNT(C.Id) AS CommentCount,
         COUNT(PL.Id) AS LinkCount,
         COUNT(CASE WHEN V.VoteTypeId = 2 THEN 1 END) AS UpvoteCount,
         COUNT(CASE WHEN V.VoteTypeId = 3 THEN 1 END) AS DownvoteCount,
         ROW_NUMBER() OVER (PARTITION BY P.OwnerUserId ORDER BY P.Score DESC) AS PostRank,
         AVG(CASE WHEN V.VoteTypeId = 8 THEN V.BountyAmount END) AS AvgBountyGiven
  FROM Posts P
  LEFT JOIN Comments C ON P.Id = C.PostId
  LEFT JOIN PostLinks PL ON P.Id = PL.PostId OR P.Id = PL.RelatedPostId
  LEFT JOIN Votes V ON P.Id = V.PostId
  WHERE P.PostTypeId = 1 AND P.Score IS NOT NULL
  GROUP BY P.Id, P.Title, P.Score, P.CreationDate, P.OwnerUserId, P.ClosedDate
),
UserAggregates AS (
  SELECT PM.OwnerUserId,
         COALESCE(SUM(PM.Score), 0) AS TotalScore,
         COALESCE(AVG(PM.CommentCount), 0) AS AvgComments,
         COALESCE(SUM(PM.LinkCount), 0) AS TotalLinks,
         COUNT(CASE WHEN PM.PostRank <= 3 THEN 1 END) AS Top3Posts,
         COUNT(CASE WHEN PM.ClosedDate IS NOT NULL THEN 1 END) AS ClosedQuestions
  FROM PostMetrics PM
  GROUP BY PM.OwnerUserId
),
ActiveUsers AS (
  SELECT U.Id, U.DisplayName, U.Reputation, U.CreationDate,
         UA.TotalScore, UA.AvgComments, UA.TotalLinks, UA.Top3Posts, UA.ClosedQuestions,
         (SELECT COUNT(*) FROM Badges B WHERE B.UserId = U.Id AND B.Class = 1) AS GoldBadges,
         COALESCE(UPPER(SUBSTRING(U.DisplayName FROM 1 FOR 1)), 'X') AS FirstLetter,
         CASE WHEN U.WebsiteUrl IS NULL THEN 'No Website' ELSE 'Has Website' END AS WebsiteStatus
  FROM Users U
  LEFT JOIN UserAggregates UA ON U.Id = UA.OwnerUserId
  WHERE U.Reputation > 50
),
RankedUsers AS (
  SELECT AU.Id, AU.DisplayName, AU.Reputation, AU.CreationDate,
         AU.TotalScore, AU.AvgComments, AU.TotalLinks, AU.Top3Posts, AU.ClosedQuestions,
         AU.GoldBadges, AU.FirstLetter, AU.WebsiteStatus,
         ROW_NUMBER() OVER (ORDER BY AU.TotalScore DESC, AU.GoldBadges DESC, AU.Reputation DESC) AS GlobalRank,
         DENSE_RANK() OVER (PARTITION BY AU.FirstLetter ORDER BY AU.TotalScore DESC) AS LetterRank
  FROM ActiveUsers AU
  WHERE COALESCE(AU.TotalScore,0) > 10
),
TopUsers AS (
  SELECT * FROM RankedUsers WHERE GlobalRank <= 100
  UNION
  SELECT * FROM RankedUsers WHERE LetterRank <= 5 AND GoldBadges > 0
),
FinalUsers AS (
  SELECT DISTINCT Id, DisplayName, Reputation, CreationDate, TotalScore, AvgComments, TotalLinks, Top3Posts, ClosedQuestions, GoldBadges, FirstLetter, WebsiteStatus, GlobalRank, LetterRank
  FROM TopUsers
)
SELECT FU.Id, FU.DisplayName, FU.Reputation, FU.CreationDate, FU.TotalScore, FU.AvgComments, FU.TotalLinks, FU.Top3Posts, FU.ClosedQuestions, FU.GoldBadges, FU.FirstLetter, FU.WebsiteStatus, FU.GlobalRank, FU.LetterRank,
       (SELECT STRING_AGG(DISTINCT tagname, '; ')
        FROM (
          SELECT T.TagName AS tagname, T.Count AS tagcount
          FROM Posts P2
          CROSS JOIN LATERAL (
            SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(P2.Tags FROM 2 FOR (CHAR_LENGTH(P2.Tags)-2)), '><')) AS tag
          ) AS unnested(tag)
          JOIN Tags T ON T.TagName = unnested.tag
          WHERE P2.OwnerUserId = FU.Id AND P2.PostTypeId = 1 AND T.Count > 100
          GROUP BY T.TagName, T.Count
          ORDER BY T.Count DESC
          LIMIT 5
        ) AS taglist
       ) AS PopularTags,
       (FU.GlobalRank + FU.LetterRank) AS CombinedRank
FROM FinalUsers FU
WHERE FU.Reputation IS NOT NULL AND COALESCE(FU.TotalScore,0) > COALESCE(FU.ClosedQuestions,0) * 5
ORDER BY CombinedRank, TotalScore DESC
LIMIT 200;