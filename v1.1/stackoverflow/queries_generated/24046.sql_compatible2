WITH 
question_posts AS (
    SELECT p.Id,
           p.Title,
           p.Score,
           p.ViewCount,
           p.AnswerCount,
           p.CreationDate,
           p.LastActivityDate,
           p.OwnerUserId,
           p.Tags
    FROM   Posts p
    WHERE  p.PostTypeId = 1
),
-- Split tags by parsing the string like '<tag1><tag2>' into rows using standard SQL
tag_extracted AS (
    SELECT qp.Id,
           TRIM(tag) AS Tag
    FROM   question_posts qp,
           LATERAL (
             SELECT regexp_split_to_table(
                      -- remove surrounding angle brackets and split on '><'
                      regexp_replace(qp.Tags, '^<|>$', '', 'g'),
                      E'><'
                    ) AS tag
           ) s
),
vote_sums AS (
    SELECT v.PostId,
           SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS upvotes,
           SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS downvotes,
           SUM(CASE WHEN v.VoteTypeId = 1 THEN 1 ELSE 0 END) AS accepted,
           COUNT(*)                                         AS total_votes
    FROM   Votes v
    GROUP  BY v.PostId
),
recent_act AS (
    SELECT qp.Id,
           CASE WHEN qp.LastActivityDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 day')
                THEN 1 ELSE 0 END AS active_30
    FROM   question_posts qp
),
accepted_comments AS (
    SELECT p.Id,
           COALESCE(
                ( SELECT COUNT(*)
                  FROM   Comments c
                  WHERE  c.PostId = p.Id
                  AND    c.UserId = (
                            SELECT va.UserId
                            FROM   Votes va
                            WHERE  va.PostId = p.Id
                               AND va.VoteTypeId = 1
                            ORDER BY va.CreationDate DESC
                            LIMIT 1
                        )
                ), 0
           ) AS comment_cnt
    FROM   Posts p
    WHERE  p.AcceptedAnswerId IS NOT NULL
),
user_info AS (
    SELECT u.Id,
           u.Reputation,
           u.DisplayName
    FROM   Users u
),
question_metrics AS (
    SELECT qp.Id,
           qp.Title,
           qp.Score,
           qp.ViewCount,
           qp.AnswerCount,
           vs.upvotes,
           vs.downvotes,
           vs.accepted,
           vs.total_votes,
           ra.active_30,
           ui.Reputation     AS owner_rep,
           ui.DisplayName    AS owner_name,
           MAX(CASE WHEN te.Tag = 'sql' THEN 1 ELSE 0 END) AS has_sql_tag,
           AVG(qp.Score)      OVER () AS avg_score,
           STDDEV_POP(qp.Score)  OVER () AS stddev_score,
           PERCENT_RANK() OVER (ORDER BY qp.Score DESC) AS score_pct,
           DENSE_RANK()  OVER (ORDER BY qp.Score DESC) AS score_rank,
           SUBSTRING(qp.Title FROM 1 FOR 20) AS title_preview
    FROM   question_posts qp
    LEFT JOIN vote_sums vs       ON qp.Id = vs.PostId
    LEFT JOIN recent_act ra      ON qp.Id = ra.Id
    LEFT JOIN user_info ui       ON qp.OwnerUserId = ui.Id
    LEFT JOIN tag_extracted te   ON qp.Id = te.Id
    LEFT JOIN accepted_comments ac ON qp.Id = ac.Id
    GROUP BY qp.Id,
             qp.Title,
             qp.Score,
             qp.ViewCount,
             qp.AnswerCount,
             vs.upvotes,
             vs.downvotes,
             vs.accepted,
             vs.total_votes,
             ra.active_30,
             ui.Reputation,
             ui.DisplayName,
             AVG(qp.Score) OVER (),
             STDDEV_POP(qp.Score) OVER (),
             PERCENT_RANK() OVER (ORDER BY qp.Score DESC),
             DENSE_RANK() OVER (ORDER BY qp.Score DESC),
             SUBSTRING(qp.Title FROM 1 FOR 20)
)

SELECT qm.Id,
       qm.Title,
       qm.Score,
       qm.ViewCount,
       qm.AnswerCount,
       qm.upvotes,
       qm.downvotes,
       qm.accepted,
       qm.total_votes,
       qm.active_30,
       qm.owner_rep,
       qm.owner_name,
       qm.has_sql_tag,
       qm.avg_score,
       qm.stddev_score,
       qm.score_pct,
       qm.score_rank,
       qm.title_preview
FROM   question_metrics qm
WHERE  qm.has_sql_tag = 1
  AND  qm.Score > 0
  AND  qm.total_votes > 10
ORDER  BY qm.Score DESC;