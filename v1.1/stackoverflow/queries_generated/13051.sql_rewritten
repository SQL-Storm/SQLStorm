WITH ActiveUsers AS (
  SELECT u.Id,
         u.DisplayName,
         COUNT(DISTINCT p.Id) AS PostsCount,
         SUM(p.Score) AS TotalScore,
         ROW_NUMBER() OVER (ORDER BY SUM(p.Score) DESC) AS Rank
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId
  WHERE u.LastAccessDate > cast('2024-10-01' as date) - INTERVAL '90 days'
  GROUP BY u.Id
  HAVING SUM(p.Score) > 100
),
TopPosts AS (
  SELECT p.Id,
         p.Title,
         p.Score,
         u.DisplayName AS Owner,
         COALESCE(COUNT(c.Id), 0) AS CommentCount,
         STRING_AGG(DISTINCT t.TagName, ', ') AS Tags
  FROM Posts p
  JOIN ActiveUsers u ON p.OwnerUserId = u.Id
  LEFT JOIN Comments c ON p.Id = c.PostId
  LEFT JOIN Tags t ON POSITION(CONCAT('<', t.TagName, '>') IN p.Tags) > 0
  WHERE p.PostTypeId = 1 AND p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '30 days'
  GROUP BY p.Id, u.DisplayName
),
EditorContribution AS (
  SELECT ph.PostId,
         ph.UserId,
         COUNT(*) AS EditsMade
  FROM PostHistory ph
  WHERE ph.PostHistoryTypeId IN (4, 5, 6)
  GROUP BY ph.PostId, ph.UserId
)
SELECT tp.Title,
       tp.Owner,
       tp.Score,
       tp.CommentCount,
       tp.Tags,
       COALESCE(SUM(ec.EditsMade), 0) AS TotalEdits,
       RANK() OVER (PARTITION BY tp.Owner ORDER BY tp.Score DESC) AS OwnerPostRank,
       CASE 
         WHEN LENGTH(tp.Title) > 50 THEN LEFT(tp.Title, 47) || '...'
         ELSE tp.Title
       END AS ShortTitle
FROM TopPosts tp
LEFT JOIN EditorContribution ec ON tp.Id = ec.PostId
WHERE tp.Rank <= 10
GROUP BY tp.Id, tp.Title, tp.Owner, tp.Score, tp.CommentCount, tp.Tags
ORDER BY tp.Score DESC, TotalEdits DESC;