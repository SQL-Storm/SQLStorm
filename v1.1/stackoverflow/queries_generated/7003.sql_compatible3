with
user_metrics as (
  select
    u.id,
    u.displayname,
    u.reputation,
    case
      when u.reputation >= 100000 then '>=100k'
      when u.reputation >= 10000 then '10k-99k'
      when u.reputation >= 1000 then '1k-9k'
      when u.reputation >= 100 then '100-999'
      when u.reputation >= 1 then '1-99'
      else '0'
    end as rep_band,
    coalesce(u.views,0) as profile_views,
    u.creationdate,
    u.lastaccessdate,
    greatest(0, date_part('day', cast('2024-10-01 12:34:56' as timestamp) - u.lastaccessdate)) as days_since_last_access,
    case when date_part('year', age(cast('2024-10-01 12:34:56' as timestamp), u.creationdate)) < 1
      then (select count(*) from posts p where p.owneruserid = u.id) * 365.0 / nullif(date_part('day', cast('2024-10-01 12:34:56' as timestamp) - u.creationdate),0)
      else (select count(*) from posts p where p.owneruserid = u.id) / nullif(date_part('year', age(cast('2024-10-01 12:34:56' as timestamp), u.creationdate)),0)
    end as posts_per_year
  from users u
),
question_base as (
  select
    p.id,
    p.owneruserid,
    p.title,
    p.creationdate,
    p.score,
    p.viewcount,
    p.answercount,
    p.commentcount,
    p.favoritecount,
    p.tags,
    case when p.tags is null then cast(array[] as varchar[]) else string_to_array(substring(p.tags from 2 for char_length(p.tags)-2), '><') end as tag_array,
    char_length(coalesce(p.title,'')) as title_len,
    cardinality(regexp_split_to_array(coalesce(p.title,''), '\s+')) as title_word_count
  from posts p
  where p.posttypeid = 1
),
question_enriched as (
  select
    q.*,
    (select a.id from posts a where a.parentid = q.id order by a.score desc nulls last, a.creationdate asc nulls last limit 1) as top_answer_id,
    (select a.score from posts a where a.parentid = q.id order by a.score desc nulls last, a.creationdate asc nulls last limit 1) as top_answer_score,
    (select count(distinct a.owneruserid) from posts a where a.parentid = q.id and a.owneruserid is not null) as distinct_answerers,
    exists(select 1 from postlinks pl where pl.relatedpostid = q.id and pl.linktypeid = 3) as has_duplicates_pointing_here,
    exists(select 1 from postlinks pl where pl.postid = q.id and pl.linktypeid = 1) as has_outgoing_links,
    (select ph.creationdate from posthistory ph where ph.postid = q.id order by ph.creationdate desc limit 1) as last_revision_date,
    (select ph.posthistorytypeid from posthistory ph where ph.postid = q.id order by ph.creationdate desc limit 1) as last_revision_type
  from question_base q
),
tag_question_exploded as (
  select
    qe.*,
    t.tag,
    row_number() over (partition by t.tag order by qe.viewcount desc nulls last, qe.score desc nulls last, qe.creationdate desc nulls last) as tag_rank_by_views,
    dense_rank() over (partition by t.tag order by qe.score desc nulls last) as tag_rank_by_score
  from question_enriched qe
  cross join lateral unnest(qe.tag_array) as t(tag)
),
post_votes_agg as (
  select
    p.id as postid,
    count(*) filter (where v.votetypeid = 2) as upvotes,
    count(*) filter (where v.votetypeid = 3) as downvotes,
    count(*) filter (where v.votetypeid = 5) as favorites,
    count(*) filter (where v.votetypeid = 8) as bounty_starts,
    sum(v.bountyamount) filter (where v.bountyamount is not null) as total_bounty_amount,
    count(*) as total_votes
  from posts p
  left join votes v on v.postid = p.id
  group by p.id
),
user_badge_summary as (
  select
    b.userid,
    count(*) as total_badges,
    count(*) filter (where b.tagbased = true) as tag_badges,
    count(*) filter (where b.class = 1) as gold_count,
    count(*) filter (where b.class = 2) as silver_count,
    count(*) filter (where b.class = 3) as bronze_count,
    max(b.date) as last_badge_date,
    string_agg(b.name, ', ' order by b.date desc) filter (where b.name is not null) as recent_badges_list
  from badges b
  group by b.userid
),
question_final as (
  select
    tq.id,
    tq.owneruserid,
    tq.title,
    tq.creationdate,
    tq.score,
    tq.viewcount,
    tq.answercount,
    tq.commentcount,
    tq.favoritecount,
    tq.tags,
    tq.tag_array,
    tq.title_len,
    tq.title_word_count,
    tq.top_answer_id,
    tq.top_answer_score,
    tq.distinct_answerers,
    tq.has_duplicates_pointing_here,
    tq.has_outgoing_links,
    tq.last_revision_date,
    tq.last_revision_type,
    tq.tag,
    tq.tag_rank_by_views,
    tq.tag_rank_by_score,
    pva.upvotes,
    pva.downvotes,
    pva.favorites,
    pva.total_bounty_amount,
    um.displayname as owner_name,
    um.reputation as owner_reputation,
    ub.total_badges,
    ub.tag_badges,
    case when pva.upvotes >= 10 and pva.downvotes >= 5 and abs(pva.upvotes - pva.downvotes) < greatest(1, pva.total_votes/5) then true else false end as controversial,
    (
      coalesce( (extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - coalesce(p.lastactivitydate, tq.creationdate)))/86400), 365000) * -0.5
      + coalesce( (extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - tq.last_revision_date))/86400), 365000) * -0.3
      + coalesce( (select min(extract(epoch from cast('2024-10-01 12:34:56' as timestamp) - a.creationdate))/86400 from posts a where a.parentid = tq.id), 365000) * -0.2
    ) * -1 as freshness_index,
    (tq.title_len + coalesce(tq.answercount,0)*10 + coalesce(cardinality(tq.tag_array),0)*5 + coalesce(tq.commentcount,0)*2) as complexity_score,
    u.displayname as _owner_display_for_groupby,
    p.lastactivitydate,
    ub.recent_badges_list,
    u.reputation as _owner_reputation_for_groupby,
    u.id as _owner_id_for_groupby,
    -- include fields referenced later in outer queries
    coalesce(u.reputation,0) as owner_reputation_for_join,
    coalesce(u.displayname,'') as owner_display_for_join
  from tag_question_exploded tq
  left join post_votes_agg pva on pva.postid = tq.id
  left join users um on um.id = tq.owneruserid
  left join user_badge_summary ub on ub.userid = tq.owneruserid
  left join posts p on p.id = tq.id
  left join users u on u.id = tq.owneruserid
),
problem_signals as (
  select
    qf.*,
    phc.count_close_votes,
    phd.count_deletions
  from question_final qf
  left join lateral (
    select count(*) filter (where ph.posthistorytypeid in (10,35)) as count_close_votes
    from posthistory ph
    where ph.postid = qf.id and ph.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '180 days'
  ) phc on true
  left join lateral (
    select count(*) filter (where ph.posthistorytypeid in (12,13)) as count_deletions
    from posthistory ph
    where ph.postid = qf.id and ph.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '365 days'
  ) phd on true
)
select
  ps.tag,
  ps.id as question_id,
  ps.title,
  ps.owner_name,
  ps.owner_reputation,
  um_rep.rep_band,
  ps.viewcount,
  ps.score,
  ps.upvotes,
  ps.downvotes,
  ps.favorites,
  ps.total_bounty_amount,
  ps.answercount,
  ps.distinct_answerers,
  ps.top_answer_id,
  ps.top_answer_score,
  ps.tag_rank_by_views,
  ps.tag_rank_by_score,
  ps.has_duplicates_pointing_here,
  ps.has_outgoing_links,
  ps.controversial,
  ps.complexity_score,
  round(ps.freshness_index,3) as freshness_index,
  ps.total_badges,
  ps.tag_badges,
  ps.recent_badges_list as phrase_recent_badges,
  ps.recent_badges_list,
  ps.days_since_last_access,
  ps.posts_per_year,
  ps.count_close_votes,
  ps.count_deletions,
  (
    case
      when ps.upvotes is null and ps.downvotes is null then 'no votes'
      when ps.upvotes is null then 'downvoted-only'
      when ps.downvotes is null then 'upvoted-only'
      when ps.upvotes >= ps.downvotes * 3 then 'mostly-positive'
      when ps.downvotes >= ps.upvotes * 2 then 'mostly-negative'
      else 'mixed'
    end
    || ' | tags: ' || coalesce(array_to_string(array_agg(distinct ps.tag) over (partition by ps.id order by ps.tag), ','), '(none)')
    || ' | last_badge: ' || coalesce(ps.recent_badges_list,'(none)')
  ) as human_label,
  (select percentile_disc(0.5) within group (order by a.score) from posts a where a.parentid = ps.id) as median_answer_score,
  (
    select json_agg(row_to_json(t))
    from (
      select q2.id,q2.title,q2.viewcount,q2.score
      from question_final q2
      where q2.tag = ps.tag and q2.id != ps.id and abs(q2.complexity_score - ps.complexity_score) <= 20
      order by q2.viewcount desc
      limit 3
    ) t
  ) as similar_questions_preview
from problem_signals ps
left join users um_rep on um_rep.id = ps.owneruserid
where
  (
    (ps.viewcount >= 1000 and ps.score >= 5)
    or (ps.upvotes >= 50)
    or (ps.answercount >= 5 and ps.distinct_answerers >= 3)
  )
  and (ps.freshness_index > -120 or ps.count_close_votes > 0 or ps.count_deletions > 0)
  and (ps.tag_rank_by_views <= 100 or ps.tag_rank_by_score <= 50)
group by
  ps.tag,
  ps.id,
  ps.title,
  ps.owner_name,
  ps.owner_reputation,
  um_rep.rep_band,
  ps.viewcount,
  ps.score,
  ps.upvotes,
  ps.downvotes,
  ps.favorites,
  ps.total_bounty_amount,
  ps.answercount,
  ps.distinct_answerers,
  ps.top_answer_id,
  ps.top_answer_score,
  ps.tag_rank_by_views,
  ps.tag_rank_by_score,
  ps.has_duplicates_pointing_here,
  ps.has_outgoing_links,
  ps.controversial,
  ps.complexity_score,
  round(ps.freshness_index,3),
  ps.total_badges,
  ps.tag_badges,
  ps.recent_badges_list,
  ps.days_since_last_access,
  ps.posts_per_year,
  ps.count_close_votes,
  ps.count_deletions,
  ps.owneruserid,
  ps.owner_name,
  ps.owner_reputation,
  ps.recent_badges_list,
  ps.freshness_index,
  ps.complexity_score
order by ps.tag, ps.tag_rank_by_views, ps.freshness_index desc
limit 200;