WITH user_stats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END)                                   AS question_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END)                                   AS answer_count,
        COALESCE(SUM(p.Score),0)                                                                   AS total_score,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END)                                           AS avg_question_score,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END)                                           AS avg_answer_score,
        COUNT(CASE WHEN v.Id IS NOT NULL AND v.VoteTypeId = 2 THEN v.Id END)                       AS upvote_given,
        COUNT(CASE WHEN v.Id IS NOT NULL AND v.VoteTypeId = 3 THEN v.Id END)                       AS downvote_given,
        COUNT(b.Id)                                                                                 AS badge_count,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END)                                                     AS gold_badge,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END)                                                     AS silver_badge,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END)                                                     AS bronze_badge,
        MAX(p.CreationDate)                                                                         AS last_post_date,
        MAX(CASE WHEN v.VoteTypeId IN (1,2,3,5,10,11) THEN v.CreationDate END)                      AS last_vote_date
    FROM Users u
    LEFT JOIN Posts      p ON p.OwnerUserId = u.Id
    LEFT JOIN Votes      v ON v.UserId      = u.Id
    LEFT JOIN Badges     b ON b.UserId      = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
ranked_users AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.question_count,
        u.answer_count,
        u.total_score,
        u.avg_question_score,
        u.avg_answer_score,
        u.upvote_given,
        u.downvote_given,
        u.badge_count,
        u.gold_badge,
        u.silver_badge,
        u.bronze_badge,
        u.last_post_date,
        u.last_vote_date,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.total_score DESC)                      AS rep_rank,
        RANK()       OVER (ORDER BY u.badge_count DESC)                                         AS badge_rank
    FROM user_stats u
)
SELECT
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.rep_rank,
    ru.badge_rank,
    ru.question_count,
    ru.answer_count,
    ru.total_score,
    ru.avg_question_score,
    ru.avg_answer_score,
    ru.upvote_given,
    ru.downvote_given,
    ru.gold_badge,
    ru.silver_badge,
    ru.bronze_badge,
    CAST(ru.last_post_date AS DATE)                                                            AS last_post_date,
    CAST(ru.last_vote_date AS DATE)                                                            AS last_vote_date,
    COALESCE(tag_stats.top_tag, 'None')                                                        AS top_tag
FROM ranked_users ru
LEFT JOIN LATERAL (
    SELECT
        t.TagName AS top_tag,
        COUNT(*)  AS tag_usage
    FROM Posts p
    CROSS JOIN LATERAL (
        -- split Tags string into rows by extracting substrings between '<' and '>'
        SELECT TRIM(regexp_match(value, '<([^>]*)>')[1]) AS tag_raw
        FROM UNNEST(string_to_array(
            -- normalize: ensure tags are in the form <tag><tag2>...
            REPLACE(REPLACE(p.Tags, '><', '>|<'), '><', '>|<')
        , '|')) AS value
    ) split
    JOIN Tags t ON t.TagName = split.tag_raw
    WHERE p.OwnerUserId = ru.Id
      AND p.PostTypeId = 1
    GROUP BY t.TagName
    ORDER BY tag_usage DESC
    LIMIT 1
) tag_stats ON TRUE
WHERE ru.rep_rank <= 100
ORDER BY ru.rep_rank
LIMIT 100;