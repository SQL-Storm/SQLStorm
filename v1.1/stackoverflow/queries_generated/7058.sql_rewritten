-- {"query": "7058.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 2032} 
with
-- recent active questions with parsed tags and tag counts
RecentQuestions as (
  select p.id,
         p.title,
         p.owneruserid,
         p.creationdate,
         p.score,
         p.viewcount,
         p.answercount,
         p.favouritecount,
         coalesce(p.tags,'') as raw_tags,
         -- split tags from '<tag1><tag2>' to one string per tag (Postgres syntax assumed)
         regexp_split_to_table(substring(coalesce(p.tags,''),2, greatest(char_length(coalesce(p.tags,''))-2,0)), '><') as tag
  from posts p
  where p.posttypeid = 1
    and p.creationdate >= (cast('2024-10-01 12:34:56' as timestamp) - interval '180 days')
),
-- tag popularity summary for those recent questions (aggregate over tag occurrences)
TagAgg as (
  select r.tag,
         count(*) as question_count,
         avg(r.score) as avg_score,
         sum(coalesce(r.viewcount,0)) as total_views,
         max(r.creationdate) as last_seen
  from RecentQuestions r
  group by r.tag
),
-- users activity summary: counts, recency, reputation, badge-weighted score
UserActivity as (
  select u.id as user_id,
         u.displayname,
         u.reputation,
         u.creationdate as user_created,
         u.views as profile_views,
         count(distinct p.id) filter (where p.posttypeid=1) as questions_count,
         count(distinct p.id) filter (where p.posttypeid=2) as answers_count,
         max(p.lastactivitydate) as last_post_activity,
         sum(coalesce(v.vote_weight,0)) as vote_impact,
         -- badge weight: gold=5, silver=2, bronze=1
         coalesce(sum(case b.class when 1 then 5 when 2 then 2 when 3 then 1 else 0 end),0) as badge_score
  from users u
  left join posts p on p.owneruserid = u.id
  left join (
    select v.postid,
           sum(case v.votetypeid when 2 then 1 when 3 then -1 else 0 end) as vote_weight
    from votes v
    group by v.postid
  ) v on v.postid = p.id
  left join badges b on b.userid = u.id
  group by u.id, u.displayname, u.reputation, u.creationdate, u.views
),
-- for each question, find accepted answer and a top non-accepted answer, with windowing
QuestionAnswers as (
  select q.id as question_id,
         q.title,
         q.creationdate as q_creation,
         q.score as q_score,
         a.id as answer_id,
         a.score as answer_score,
         a.owneruserid as answer_owner,
         a.creationdate as answer_creation,
         a.body,
         a.parentid,
         -- rank answers by score desc then recent
         row_number() over (partition by q.id order by a.score desc nulls last, a.creationdate desc) as rank_by_score,
         -- find if accepted
         case when q.acceptedanswerid = a.id then 1 else 0 end as is_accepted
  from posts q
  left join posts a on a.parentid = q.id and a.posttypeid = 2
  where q.posttypeid = 1
    and q.creationdate >= (cast('2024-10-01 12:34:56' as timestamp) - interval '365 days')
),
TopAnswers as (
  select qa.*
  from QuestionAnswers qa
  where qa.rank_by_score = 1
),
AcceptedInfo as (
  select q.id as question_id,
         q.acceptedanswerid,
         a.score as accepted_score,
         a.owneruserid as accepted_owner,
         a.creationdate as accepted_created
  from posts q
  left join posts a on a.id = q.acceptedanswerid
  where q.posttypeid = 1
),
-- derive a set of "interesting" questions based on combined metrics and string search
InterestingQuestions as (
  select rq.id,
         rq.title,
         rq.owneruserid,
         rq.creationdate,
         rq.score,
         rq.viewcount,
         rq.answercount,
         rq.favouritecount,
         rq.raw_tags,
         ta.question_count,
         ta.avg_score as tag_avg_score,
         ua.reputation as owner_reputation,
         ua.badge_score as owner_badge_score,
         ai.acceptedanswerid,
         ai.accepted_score,
         ta.total_views as tag_total_views,
         -- heuristic score mixing multiple signals (nullable-safe)
         (coalesce(rq.score,0) * 2
          + coalesce(rq.viewcount,0)/100
          + coalesce(rq.answercount,0)*3
          + coalesce(rq.favouritecount,0)*5
          + coalesce(ta.question_count,0)
          + coalesce(ua.reputation,0)/100
          + coalesce(ua.badge_score,0)
          + coalesce(ai.accepted_score,0)
         )::numeric as heuristic_score
  from RecentQuestions rq
  left join TagAgg ta on ta.tag = rq.tag
  left join UserActivity ua on ua.user_id = rq.owneruserid
  left join AcceptedInfo ai on ai.question_id = rq.id
),
-- compute complex join between posts and links to find duplicates and hot-linked posts
LinkedDuplicates as (
  select pl.postid,
         pl.relatedpostid,
         pl.linktypeid,
         lt.name as linkname,
         p1.title as post_title,
         p2.title as related_title,
         row_number() over (partition by pl.postid order by pl.creationdate desc) as rn
  from postlinks pl
  join linktypes lt on lt.id = pl.linktypeid
  left join posts p1 on p1.id = pl.postid
  left join posts p2 on p2.id = pl.relatedpostid
  where pl.linktypeid in (1,3) -- linked or duplicate
    and pl.creationdate >= (cast('2024-10-01 12:34:56' as timestamp) - interval '730 days')
),
FilteredLinked as (
  select *
  from LinkedDuplicates ld
  where rn = 1
),
-- correlated subquery example: per-tag recent high-scoring question count
TagHighScorers as (
  select t.tag,
         (select count(*) from RecentQuestions rq2 where rq2.tag = t.tag and coalesce(rq2.score,0) >= 5) as high_score_q_count,
         (select avg(coalesce(rq2.viewcount,0)) from RecentQuestions rq2 where rq2.tag = t.tag) as avg_views_per_q
  from (select distinct tag from RecentQuestions) t
),
-- final combined result: rank interesting questions, attach top answer, owner metrics, link info, and tag aggregates
FinalRanked as (
  select iq.*,
         ta.rank as tag_rank,
         ta_high.high_score_q_count,
         ta_high.avg_views_per_q,
         ua.questions_count,
         ua.answers_count,
         ua.last_post_activity,
         fa.answer_id as top_answer_id,
         fa.answer_score as top_answer_score,
         fa.answer_owner as top_answer_owner,
         fa.answer_creation as top_answer_creation,
         fd.relatedpostid as linked_related_post,
         fd.linkname as linked_type,
         -- string mashups and null-safe formatting
         concat(
           coalesce(iq.title,'<no title>'),
           ' [', coalesce(iq.raw_tags,'<>'), '] ',
           'owner=', coalesce(iq.owneruserid::text,'-'),
           ' rep=', coalesce(iq.owner_reputation::text,'0')
         ) as compact_summary
  from InterestingQuestions iq
  left join (
    select tag, dense_rank() over (order by sum(question_count) desc) as rank
    from TagAgg
    group by tag
  ) ta on ta.tag = regexp_split_to_table(substring(coalesce(iq.raw_tags,''),2, greatest(char_length(coalesce(iq.raw_tags,''))-2,0)), '><')
  left join TagHighScorers ta_high on ta_high.tag = ta.tag
  left join UserActivity ua on ua.user_id = iq.owneruserid
  left join TopAnswers fa on fa.question_id = iq.id
  left join FilteredLinked fd on fd.postid = iq.id
)
select *
from (
  select fr.*,
         rank() over (order by fr.heuristic_score desc nulls last, fr.tag_total_views desc nulls last) as global_rank,
         dense_rank() over (partition by substr(fr.raw_tags,2,5) order by fr.heuristic_score desc) as per_tag_rank,
         -- compute moving average of heuristic_score over owner reputation groups
         avg(fr.heuristic_score) over (partition by case when fr.owner_reputation >= 10000 then 'elite' when fr.owner_reputation >= 1000 then 'pro' when fr.owner_reputation >= 100 then 'regular' else 'new' end order by fr.heuristic_score rows between 3 preceding and 3 following) as local_moving_avg,
         -- complex predicate as boolean marker
         (fr.answercount = 0 and fr.heuristic_score > 50 and (fr.owner_reputation < 100 or fr.owner_badge_score < 3)) as unanswered_hot_by_newbie
  from FinalRanked fr
) x
where (x.global_rank <= 250)
   or (x.unanswered_hot_by_newbie = true)
order by x.global_rank, x.per_tag_rank, x.heuristic_score desc;