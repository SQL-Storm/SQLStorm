with
questions as (
  select
    p.id,
    p.creationdate,
    p.title,
    coalesce(nullif(p.tags, ''), '') as raw_tags,
    regexp_split_to_array(substring(coalesce(p.tags, ''), 2, greatest(length(coalesce(p.tags, ''))-2,0)), '><') as tag_array,
    p.score,
    p.viewcount,
    p.answercount,
    p.owneruserid
  from posts p
  where p.posttypeid = 1
    and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
),
answers as (
  select
    a.id,
    a.parentid as questionid,
    a.creationdate,
    a.owneruserid,
    a.score,
    a.body,
    case when q.acceptedanswerid = a.id then true else false end as is_accepted
  from posts a
  join posts q on q.id = a.parentid and q.posttypeid = 1
  where a.posttypeid = 2
),
votes_summary as (
  select
    v.postid,
    count(case when v.votetypeid = 2 then 1 end) as upvotes,
    count(case when v.votetypeid = 3 then 1 end) as downvotes,
    count(case when v.votetypeid = 1 then 1 end) as accepted_votes,
    count(case when v.votetypeid in (8,9) then 1 end) as bounty_votes,
    sum(coalesce(v.bountyamount,0)) as total_bounty
  from votes v
  group by v.postid
),
answer_rank as (
  select
    a.*,
    row_number() over (
      partition by a.questionid
      order by
        (coalesce(a.score,0) * 1000 + (case when a.is_accepted then 100000 else 0 end)
          - extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - a.creationdate))/86400 * 10
        ) desc,
        a.creationdate asc
    ) as answer_rank
  from answers a
),
tag_popularity as (
  select
    t.tag,
    count(case when q.viewcount > 100 then 1 end) as popular_views_cnt,
    count(*) as total_questions,
    avg(q.score) as avg_score,
    avg_med.median_answercount as median_answers
  from (
    select q.*, unnest(tag_array) as tag
    from questions q
  ) t
  left join lateral (
    select tag_key, avg(answercount_val) as median_answercount from (
      select
        tag_key,
        answercount as answercount_val,
        row_number() over (partition by tag_key order by answercount) as rn,
        count(*) over (partition by tag_key) as cnt
      from (
        select unnest(tag_array) as tag_key, answercount
        from questions
      ) s
    ) t2
    where rn in (floor((cnt+1)/2.0)::int, ceil((cnt+1)/2.0)::int)
    group by tag_key
  ) avg_med on avg_med.tag_key = t.tag
  group by t.tag, avg_med.median_answercount
),
user_metrics as (
  select
    u.id,
    u.displayname,
    u.reputation,
    u.creationdate,
    u.views,
    u.upvotes,
    u.downvotes,
    coalesce(b.badge_count,0) as badge_count,
    (u.reputation * ln(1 + coalesce(u.views,0)) + coalesce(b.badge_count,0) * 500 - coalesce(u.downvotes,0) * 10) as quality_score
  from users u
  left join (
    select "userId", count(*) as badge_count
    from badges
    group by "userId"
  ) b on b."userId" = u.id
),
question_top_answers as (
  select
    q.id as questionid,
    q.title,
    q.creationdate as question_created,
    q.score as question_score,
    q.viewcount as question_views,
    qa_top.top_answer_id,
    qa_top.top_score,
    qa_top.top_is_accepted,
    qa_top.top_owneruserid
  from questions q
  left join lateral (
    select a.id as top_answer_id, a.score as top_score, a.is_accepted as top_is_accepted, a.owneruserid as top_owneruserid
    from answer_rank a
    where a.questionid = q.id
    order by a.answer_rank asc
    limit 1
  ) qa_top on true
),
post_history_signals as (
  select
    ph.postid,
    count(case when ph.posthistorytypeid in (10,12,35,36) then 1 end) as close_or_migration_events,
    count(case when ph.posthistorytypeid in (24,52) then 1 end) as suggested_edits_or_hot_events,
    max(ph.creationdate) as last_history_date,
    bool_or(ph.text is null) as any_text_null
  from posthistory ph
  group by ph.postid
),
candidates as (
  select
    qt.questionid,
    qt.title,
    qt.question_created,
    qt.question_score,
    qt.question_views,
    qt.top_answer_id,
    qt.top_score,
    qt.top_is_accepted,
    qt.top_owneruserid,
    vs.upvotes,
    vs.downvotes,
    vs.total_bounty,
    phs.close_or_migration_events,
    (length(lower(coalesce(qt.title,''))) - length(replace(lower(coalesce(qt.title,'')), 'duplicate', ''))) as duplicate_word_chars,
    case
      when qt.question_views / greatest(1, extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - qt.question_created))/86400) > 100 then 'hot_views'
      when qt.question_score > 50 and qt.top_score > 20 then 'hot_score_combo'
      else 'normal'
    end as hotness_bucket
  from question_top_answers qt
  left join votes_summary vs on vs.postid = qt.questionid
  left join post_history_signals phs on phs.postid = qt.questionid
  where qt.question_created >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
),
ranked_candidates as (
  select
    c.questionid,
    c.title,
    c.question_created,
    c.question_score,
    c.question_views,
    c.top_answer_id,
    c.top_score,
    c.top_is_accepted,
    c.top_owneruserid,
    c.upvotes,
    c.downvotes,
    c.total_bounty,
    c.close_or_migration_events,
    c.duplicate_word_chars,
    c.hotness_bucket,
    (
      coalesce(c.question_score,0) * 50
      + coalesce(c.top_score,0) * 200
      + coalesce(c.upvotes,0) * 30
      - coalesce(c.downvotes,0) * 40
      + coalesce(c.total_bounty,0) * 10
      - coalesce(c.close_or_migration_events,0) * 1000
      + (case when c.top_is_accepted then 5000 else 0 end)
    ) as raw_rank_score
  from candidates c
),
top_and_sample as (
  select * from (
    select rc.*, row_number() over (order by raw_rank_score desc, question_views desc) rn
    from ranked_candidates rc
  ) t
  where t.rn <= 100

  union

  select * from (
    select rc2.*, row_number() over (order by raw_rank_score asc, question_created desc) rn2
    from ranked_candidates rc2
  ) low_sample
  where low_sample.rn2 <= 25
),
p75_calc as (
  select
    tas.*,
    percentiles.p75
  from top_and_sample tas
  join (
    select
      max(case when pos = target_pos then raw_rank_score end) over () as p75
    from (
      select raw_rank_score,
        row_number() over (order by raw_rank_score) as pos,
        count(*) over () as total_count,
        ceil(0.75 * count(*) over ()) as target_pos
      from top_and_sample
    ) s
  ) percentiles on 1=1
)
select
  p75_calc.questionid,
  left(nullif(p75_calc.title,''), 200) as title_snippet,
  p75_calc.question_created,
  p75_calc.question_score,
  p75_calc.question_views,
  p75_calc.top_answer_id,
  p75_calc.top_score,
  p75_calc.top_is_accepted,
  p75_calc.upvotes,
  p75_calc.downvotes,
  p75_calc.total_bounty,
  p75_calc.close_or_migration_events,
  p75_calc.hotness_bucket,
  p75_calc.raw_rank_score,
  percentiles.p75 as p75_score,
  um.displayname as top_owner_name,
  um.quality_score as top_owner_quality
from (
  select distinct questionid, title, question_created, question_score, question_views, top_answer_id, top_score, top_is_accepted, top_owneruserid, upvotes, downvotes, total_bounty, close_or_migration_events, hotness_bucket, raw_rank_score
  from p75_calc
) p75_calc
cross join lateral (
  select max(p75) as p75 from p75_calc
) percentiles
left join user_metrics um on um.id = p75_calc.top_owneruserid
order by p75_calc.raw_rank_score desc, p75_calc.question_views desc
limit 200;