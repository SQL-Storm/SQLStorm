WITH
    user_posts AS (
        SELECT
            u.Id AS user_id,
            COUNT(p.Id) AS post_cnt,
            COALESCE(SUM(p.Score), 0) AS total_score,
            ROUND(AVG(p.Score), 2) AS avg_score,
            COALESCE(SUM(p.ViewCount), 0) AS total_views,
            MAX(p.CreationDate) AS last_post_dt,
            COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.Comment END) AS close_vote_cnt
        FROM Users u
        LEFT JOIN Posts p ON p.OwnerUserId = u.Id
        LEFT JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId = 10
        GROUP BY u.Id
    ),
    user_badges AS (
        SELECT
            b.UserId AS user_id,
            COUNT(*) AS badge_cnt,
            SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold_cnt,
            SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver_cnt,
            SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze_cnt,
            MAX(CASE WHEN b.TagBased = 1 THEN 1 ELSE 0 END) AS has_tag_badge
        FROM Badges b
        GROUP BY b.UserId
    ),
    user_votes AS (
        SELECT
            v.UserId AS user_id,
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS up_votes_given,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS down_votes_given,
            SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS favorites_given
        FROM Votes v
        GROUP BY v.UserId
    ),
    user_comments AS (
        SELECT
            c.UserId AS user_id,
            MAX(c.CreationDate) AS last_comment_dt,
            STRING_AGG(SUBSTRING(c.Text FROM 1 FOR 30), '; ') AS sample_comments
        FROM Comments c
        WHERE c.UserId IS NOT NULL
        GROUP BY c.UserId
    ),
    base_rows AS (
        SELECT
            u.Id AS user_id,
            u.DisplayName AS display_name,
            u.Reputation AS reputation,
            COALESCE(up.post_cnt, 0) AS post_cnt,
            COALESCE(up.total_score, 0) AS total_score,
            COALESCE(up.avg_score, 0) AS avg_score,
            COALESCE(up.total_views, 0) AS total_views,
            up.last_post_dt AS last_post_dt,
            COALESCE(ub.badge_cnt, 0) AS badge_cnt,
            COALESCE(ub.gold_cnt, 0) AS gold_badge_cnt,
            COALESCE(ub.silver_cnt, 0) AS silver_badge_cnt,
            COALESCE(ub.bronze_cnt, 0) AS bronze_badge_cnt,
            CASE WHEN COALESCE(ub.has_tag_badge, 0) = 1 THEN 'Yes' ELSE 'No' END AS has_tag_badge,
            COALESCE(uv.up_votes_given, 0) AS up_votes_given,
            COALESCE(uv.down_votes_given, 0) AS down_votes_given,
            COALESCE(uv.favorites_given, 0) AS favorites_given,
            uc.last_comment_dt AS last_comment_dt,
            uc.sample_comments AS sample_comments
        FROM Users u
        LEFT JOIN user_posts up ON up.user_id = u.Id
        LEFT JOIN user_badges ub ON ub.user_id = u.Id
        LEFT JOIN user_votes uv ON uv.user_id = u.Id
        LEFT JOIN user_comments uc ON uc.user_id = u.Id
        WHERE
            (u.CreationDate < (CAST('2024-10-01' AS DATE) - INTERVAL '1 year') OR u.CreationDate IS NULL)
            AND (u.Location IS NOT NULL AND u.Location <> '')
            AND (COALESCE(up.post_cnt, 0) > 0 OR COALESCE(ub.badge_cnt, 0) > 0)
    ),
    ranked_rows AS (
        SELECT
            user_id,
            display_name,
            reputation,
            post_cnt,
            total_score,
            avg_score,
            total_views,
            last_post_dt,
            badge_cnt,
            gold_badge_cnt,
            silver_badge_cnt,
            bronze_badge_cnt,
            has_tag_badge,
            up_votes_given,
            down_votes_given,
            favorites_given,
            last_comment_dt,
            sample_comments,
            RANK() OVER (ORDER BY reputation DESC, total_score DESC) AS reputation_score_rank,
            ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY last_post_dt DESC NULLS LAST) AS recent_post_rownum
        FROM base_rows
    )

SELECT
    user_id,
    display_name,
    reputation,
    post_cnt,
    total_score,
    avg_score,
    total_views,
    last_post_dt,
    badge_cnt,
    gold_badge_cnt,
    silver_badge_cnt,
    bronze_badge_cnt,
    has_tag_badge,
    up_votes_given,
    down_votes_given,
    favorites_given,
    last_comment_dt,
    sample_comments,
    reputation_score_rank,
    recent_post_rownum
FROM ranked_rows
ORDER BY reputation_score_rank
LIMIT 100

UNION ALL

SELECT
    NULL AS user_id,
    'TOTAL' AS display_name,
    SUM(reputation) AS reputation,
    SUM(post_cnt) AS post_cnt,
    SUM(COALESCE(total_score, 0)) AS total_score,
    ROUND(AVG(COALESCE(avg_score, 0)), 2) AS avg_score,
    SUM(COALESCE(total_views, 0)) AS total_views,
    NULL AS last_post_dt,
    SUM(COALESCE(badge_cnt, 0)) AS badge_cnt,
    SUM(COALESCE(gold_badge_cnt, 0)) AS gold_badge_cnt,
    SUM(COALESCE(silver_badge_cnt, 0)) AS silver_badge_cnt,
    SUM(COALESCE(bronze_badge_cnt, 0)) AS bronze_badge_cnt,
    NULL AS has_tag_badge,
    SUM(COALESCE(up_votes_given, 0)) AS up_votes_given,
    SUM(COALESCE(down_votes_given, 0)) AS down_votes_given,
    SUM(COALESCE(favorites_given, 0)) AS favorites_given,
    NULL AS last_comment_dt,
    NULL AS sample_comments,
    NULL AS reputation_score_rank,
    NULL AS recent_post_rownum
FROM ranked_rows;