WITH
RecentAnswers AS (
    SELECT
        a.Id,
        a.ParentId       AS QuestionId,
        a.OwnerUserId,
        a.Score,
        ROW_NUMBER() OVER (
            PARTITION BY a.ParentId
            ORDER BY a.Score DESC, a.CreationDate DESC
        ) AS rn
    FROM Posts a
    WHERE a.PostTypeId = 2
      AND a.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY
),
TopAnswers AS (
    SELECT * 
    FROM RecentAnswers
    WHERE rn <= 3
),
BadgedUsers AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadgeCount,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadgeCount,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadgeCount
    FROM Badges b
    WHERE b.Date >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1' YEAR
    GROUP BY b.UserId
),
QuestionTags AS (
    SELECT
        q.Id AS QuestionId,
        unnest(string_to_array(substring(q.Tags FROM 2 FOR (length(q.Tags) - 2)), '><')) AS Tag
    FROM Posts q
    WHERE q.PostTypeId = 1
      AND q.Tags IS NOT NULL
),
PopularTags AS (
    SELECT
        Tag,
        COUNT(*) AS TagUse
    FROM QuestionTags
    GROUP BY Tag
    HAVING COUNT(*) > 1000
),
TagStats AS (
    SELECT
        COALESCE(qt.Tag, pt.Tag) AS Tag,
        COALESCE(pt.TagUse, 0) AS GlobalUse,
        COUNT(qt.QuestionId) FILTER (WHERE COALESCE(pt.TagUse, 0) > 500) AS QuestionSpecificUse
    FROM QuestionTags qt
    FULL OUTER JOIN PopularTags pt
        ON qt.Tag = pt.Tag
    GROUP BY COALESCE(qt.Tag, pt.Tag), pt.TagUse
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        COALESCE(MAX(p.CreationDate), u.CreationDate) AS LastActivity,
        COUNT(DISTINCT p.Id) AS TotalPosts
    FROM Users u
    LEFT JOIN Posts p
        ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.CreationDate
),
FinalMain AS (
    SELECT
        u.Id,
        u.DisplayName,
        ua.TotalPosts,
        ua.LastActivity,
        COALESCE(bu.GoldBadgeCount, 0)   AS GoldBadgeCount,
        COALESCE(bu.SilverBadgeCount, 0) AS SilverBadgeCount,
        COALESCE(bu.BronzeBadgeCount, 0) AS BronzeBadgeCount,
        ta.QuestionId,
        ta.Score                      AS TopAnswerScore,
        CASE
            WHEN u.Reputation > 10000 THEN 'Veteran'
            WHEN u.Reputation > 1000  THEN 'Experienced'
            ELSE 'Novice'
        END                           AS UserTier,
        COALESCE(c.CommentCount, 0)    AS CommentCount,
        NTILE(100) OVER (ORDER BY u.Reputation) AS ReputationPercentile,
        LENGTH(u.AboutMe)              AS AboutLength,
        TRIM(BOTH ' ' FROM COALESCE(u.Location, '')) AS CleanLocation,
        COALESCE(ptag.GlobalUse, 0)    AS GlobalTagUse,
        COALESCE(ptag.QuestionSpecificUse, 0) AS QuestionSpecificTagUse,
        u.Reputation,
        u.AboutMe,
        u.Location,
        u.Views,
        u.EmailHash
    FROM Users u
    JOIN UserActivity ua
        ON ua.UserId = u.Id
    LEFT JOIN BadgedUsers bu
        ON bu.UserId = u.Id
    LEFT JOIN TopAnswers ta
        ON ta.OwnerUserId = u.Id
    LEFT JOIN LATERAL (
        SELECT SUM(c2.Score) AS CommentCount
        FROM Posts q2
        JOIN Comments c2
          ON c2.PostId = q2.Id
        WHERE q2.PostTypeId = 1
          AND q2.Id = ta.QuestionId
    ) c ON true
    LEFT JOIN LATERAL (
        SELECT ts.Tag AS Tag, ts.GlobalUse AS GlobalUse, ts.QuestionSpecificUse AS QuestionSpecificUse
        FROM TagStats ts
        WHERE ts.Tag IN (
            SELECT unnest(
                string_to_array(
                    substring(p2.Tags FROM 2 FOR (length(p2.Tags) - 2)),
                    '><'
                )
            )
            FROM Posts p2
            WHERE p2.Id = ta.QuestionId
        )
        LIMIT 1
    ) ptag ON true
    WHERE (u.Views > COALESCE(
               (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1), 0
           )
           OR EXISTS (
               SELECT 1
               FROM Votes v
               WHERE v.PostId = ta.QuestionId
                 AND v.VoteTypeId = 2
           ))
      AND u.EmailHash IS NOT NULL
),
FinalGold AS (
    SELECT *
    FROM FinalMain
    WHERE GoldBadgeCount >= 1
)
SELECT *
FROM FinalMain

UNION ALL

SELECT *
FROM FinalGold

ORDER BY TotalPosts DESC, GoldBadgeCount DESC
LIMIT 200;