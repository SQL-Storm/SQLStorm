WITH TopActiveUsers AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE 0 END),0) AS TotalQuestionViews,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC, COALESCE(SUM(p.Score),0) DESC) AS UserRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName
    HAVING COUNT(DISTINCT p.Id) > 10
),
RecentEdits AS (
    SELECT
        ph.PostId,
        MAX(ph.CreationDate) AS LastEditDate
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4, 5, 6)
    GROUP BY ph.PostId
),
ClosedPosts AS (
    SELECT 
        p.Id AS PostId,
        p.OwnerUserId,
        p.Title,
        p.ClosedDate,
        cr.Name AS CloseReason,
        CASE 
            WHEN cr.Name = 'Duplicate' THEN 
                (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3)
            ELSE NULL
        END AS DuplicateCount
    FROM Posts p
    JOIN PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId = 10
    LEFT JOIN CloseReasonTypes cr 
        ON NULLIF(ph.Comment, '')::INTEGER = cr.Id
    WHERE p.ClosedDate IS NOT NULL 
      AND p.PostTypeId = 1
),
TagSummary AS (
    SELECT
        t.TagName,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        MAX(p.Score) AS MaxScore,
        SUM(CASE WHEN p.Score > 0 THEN 1 ELSE 0 END) AS PositiveScorePosts,
        CAST(AVG(LENGTH(p.Body)) AS INTEGER) AS AvgBodyLength
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE p.PostTypeId = 1
    GROUP BY t.TagName
),
DuplicateQuestionDetails AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.Score,
        c.PostId AS CommentedPostId,
        c.Text AS CommentText,
        LEAST(COALESCE(p.ViewCount,0), 10000) AS AdjustedViewCount
    FROM Posts p
    LEFT JOIN Comments c ON c.PostId = p.Id AND LOWER(c.Text) LIKE '%duplicate%'
    WHERE p.PostTypeId = 1
      AND EXISTS (
           SELECT 1 FROM PostLinks pl
           WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3
      )
)
SELECT 
    u.UserRank,
    u.DisplayName,
    u.PostCount,
    u.CommentCount,
    u.BadgeCount,
    u.TotalQuestionViews,
    ROUND(u.TotalQuestionViews::numeric / NULLIF(u.PostCount,0),2) AS AvgViewsPerPost,
    cp.Title AS ClosedPostTitle,
    cp.CloseReason,
    cp.DuplicateCount,
    re.LastEditDate,
    ts.TagName AS TopTag,
    ts.MaxScore AS TagMaxScore,
    ts.AvgBodyLength,
    dq.QuestionId AS SampleDuplicateId,
    dq.AdjustedViewCount AS SampleDupAdjustedViewCount,
    dq.CommentText AS SampleDuplicateComment
FROM TopActiveUsers u
LEFT JOIN LATERAL (
    SELECT cp.*
    FROM ClosedPosts cp
    WHERE cp.OwnerUserId = u.UserId
    ORDER BY cp.ClosedDate DESC
    LIMIT 1
) cp ON true
LEFT JOIN LATERAL (
    SELECT re.*
    FROM RecentEdits re
    WHERE re.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.UserId)
    ORDER BY re.LastEditDate DESC
    LIMIT 1
) re ON true
LEFT JOIN LATERAL (
    SELECT ts.*
    FROM TagSummary ts
    JOIN Posts p ON p.Tags LIKE '%' || '<' || ts.TagName || '>' || '%' AND p.OwnerUserId = u.UserId
    ORDER BY ts.TotalPosts DESC, ts.MaxScore DESC
    LIMIT 1
) ts ON true
LEFT JOIN LATERAL (
    SELECT dq.*
    FROM DuplicateQuestionDetails dq
    JOIN Posts p ON p.Id = dq.QuestionId AND p.OwnerUserId = u.UserId
    ORDER BY dq.AdjustedViewCount DESC, dq.Score DESC
    LIMIT 1
) dq ON true
WHERE u.UserRank <= 10
ORDER BY u.UserRank;