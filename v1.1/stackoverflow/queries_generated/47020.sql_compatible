WITH RECURSIVE tag_hierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        COUNT(DISTINCT pt.Id) as direct_questions,
        t.Count as total_posts
    FROM Tags t
    INNER JOIN Posts pt ON pt.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE pt.PostTypeId = 1
    GROUP BY t.Id, t.TagName, t.Count
),
user_expertise AS (
    SELECT 
        u.Id as user_id,
        u.DisplayName,
        u.Reputation,
        t.TagName,
        COUNT(DISTINCT p.Id) as answers_in_tag,
        AVG(p.Score) as avg_answer_score,
        SUM(CASE WHEN p.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) as accepted_answers,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) as median_score,
        STDDEV(p.Score) as score_deviation,
        MIN(p.CreationDate) as first_answer_date,
        MAX(p.CreationDate) as last_answer_date
    FROM Users u
    INNER JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 2
    INNER JOIN Posts q ON q.Id = p.ParentId
    INNER JOIN Tags t ON q.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE u.Reputation > 1000
        AND p.Score >= 0
        AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '3 years'
    GROUP BY u.Id, u.DisplayName, u.Reputation, t.TagName
    HAVING COUNT(DISTINCT p.Id) >= 5
),
badge_statistics AS (
    SELECT 
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) as gold_badges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) as silver_badges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) as bronze_badges,
        COUNT(CASE WHEN b.TagBased = TRUE THEN 1 END) as tag_badges,
        STRING_AGG(CASE WHEN b.Class = 1 THEN b.Name END, ', ' ORDER BY b.Date DESC) as gold_badge_names
    FROM Badges b
    GROUP BY b.UserId
),
post_evolution AS (
    SELECT 
        ph.PostId,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (4,5,6) THEN ph.Id END) as edit_count,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (7,8,9) THEN ph.Id END) as rollback_count,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) as was_closed,
        MAX(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) as was_reopened,
        MIN(ph.CreationDate) as first_activity,
        MAX(ph.CreationDate) as last_activity,
        COUNT(DISTINCT ph.UserId) as unique_editors
    FROM PostHistory ph
    GROUP BY ph.PostId
),
comment_analysis AS (
    SELECT 
        c.PostId,
        COUNT(*) as total_comments,
        AVG(c.Score) as avg_comment_score,
        COUNT(DISTINCT c.UserId) as unique_commenters,
        MAX(c.Score) as max_comment_score,
        EXTRACT(EPOCH FROM (MAX(c.CreationDate) - MIN(c.CreationDate)))/3600 as discussion_duration_hours
    FROM Comments c
    GROUP BY c.PostId
    HAVING COUNT(*) >= 3
)
SELECT 
    ue.DisplayName,
    ue.TagName,
    ue.Reputation,
    ue.answers_in_tag,
    ue.avg_answer_score,
    ue.accepted_answers,
    ROUND(CAST(ue.accepted_answers AS numeric) / NULLIF(ue.answers_in_tag, 0) * 100, 2) as acceptance_rate,
    ue.median_score,
    ROUND(CAST(ue.score_deviation AS numeric), 2) as score_deviation,
    bs.gold_badges,
    bs.silver_badges,
    bs.bronze_badges,
    bs.tag_badges,
    bs.gold_badge_names,
    th.direct_questions as tag_question_count,
    th.total_posts as tag_total_posts,
    ROUND(CAST(ue.answers_in_tag AS numeric) / NULLIF(th.direct_questions, 0) * 100, 4) as tag_coverage_percentage,
    COUNT(DISTINCT pe.PostId) as edited_answers,
    AVG(pe.edit_count) as avg_edits_per_answer,
    SUM(pe.was_closed) as closed_questions_answered,
    SUM(pe.was_reopened) as reopened_questions_answered,
    AVG(ca.total_comments) as avg_comments_on_answers,
    AVG(ca.avg_comment_score) as avg_comment_score_on_answers,
    AVG(ca.discussion_duration_hours) as avg_discussion_hours,
    EXTRACT(DAY FROM (ue.last_answer_date - ue.first_answer_date)) as days_active_in_tag,
    ROUND(CAST(ue.answers_in_tag AS numeric) / NULLIF(EXTRACT(DAY FROM (ue.last_answer_date - ue.first_answer_date)), 0), 4) as answers_per_day,
    DENSE_RANK() OVER (PARTITION BY ue.TagName ORDER BY ue.avg_answer_score DESC, ue.accepted_answers DESC) as tag_rank,
    DENSE_RANK() OVER (ORDER BY ue.Reputation DESC) as overall_reputation_rank,
    PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY ue.avg_answer_score) OVER (PARTITION BY ue.TagName) as tag_90th_percentile_score,
    LAG(ue.avg_answer_score, 1) OVER (PARTITION BY ue.TagName ORDER BY ue.avg_answer_score DESC) as next_best_avg_score,
    LEAD(ue.avg_answer_score, 1) OVER (PARTITION BY ue.TagName ORDER BY ue.avg_answer_score DESC) as prev_best_avg_score
FROM user_expertise ue
LEFT JOIN badge_statistics bs ON bs.UserId = ue.user_id
LEFT JOIN tag_hierarchy th ON th.TagName = ue.TagName
LEFT JOIN Posts p ON p.OwnerUserId = ue.user_id AND p.PostTypeId = 2
LEFT JOIN Posts q ON q.Id = p.ParentId AND q.Tags LIKE '%' || '<' || ue.TagName || '>' || '%'
LEFT JOIN post_evolution pe ON pe.PostId = p.Id
LEFT JOIN comment_analysis ca ON ca.PostId = p.Id
WHERE ue.avg_answer_score >= 5
    AND ue.answers_in_tag >= 10
    AND th.direct_questions >= 100
GROUP BY 
    ue.DisplayName, ue.TagName, ue.Reputation, ue.answers_in_tag, 
    ue.avg_answer_score, ue.accepted_answers, ue.median_score, 
    ue.score_deviation, bs.gold_badges, bs.silver_badges, 
    bs.bronze_badges, bs.tag_badges, bs.gold_badge_names,
    th.direct_questions, th.total_posts, ue.first_answer_date,
    ue.last_answer_date, ue.user_id
HAVING COUNT(DISTINCT pe.PostId) > 0
ORDER BY 
    ue.TagName ASC, 
    tag_rank ASC,
    ue.avg_answer_score DESC,
    ue.accepted_answers DESC
LIMIT 500;