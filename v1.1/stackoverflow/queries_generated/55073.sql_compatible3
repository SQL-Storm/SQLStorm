WITH user_stats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)               AS question_count,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)               AS answer_count,
        COALESCE(SUM(p.Score) FILTER (WHERE p.PostTypeId = 1),0)  AS question_score_sum,
        COALESCE(SUM(p.Score) FILTER (WHERE p.PostTypeId = 2),0)  AS answer_score_sum,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 2)               AS upvotes_given,
        COUNT(v.Id) FILTER (WHERE v.VoteTypeId = 3)               AS downvotes_given,
        COUNT(DISTINCT t.TagName)                                 AS distinct_tags_used,
        COUNT(b.Id)                                               AS badge_count,
        MAX(p.CreationDate)                                       AS last_post_date
    FROM Users u
    LEFT JOIN Posts      p ON p.OwnerUserId = u.Id
    LEFT JOIN Tags       t ON t.Id = ANY (
        -- replace '<tag1><tag2>' style with array of ids: split tags string into tag names then join to Tags by name
        -- many dialects don't support STRING_TO_ARRAY(... )::int[], so parse by removing angle brackets and splitting by '><'
        -- Here we derive tag names by trimming leading/trailing '<' '>' and splitting on '><' then match by TagName
        -- Implemented by joining Posts -> Tags via LIKE pattern as alternative
        ARRAY(SELECT NULL)  -- placeholder to satisfy syntax in dialects that require an expression; actual join condition handled below
    )
    LEFT JOIN Badges     b ON b.UserId = u.Id
    LEFT JOIN Votes      v ON v.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
), -- replace the Tags join above with a separate derived mapping to count distinct tag names per user's posts
post_tags AS (
    SELECT DISTINCT p.Id AS PostId, t.TagName
    FROM Posts p
    JOIN Tags t ON p.Tags LIKE CONCAT('%', t.TagName, '%')
), user_stats_fixed AS (
    SELECT
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.question_count,
        us.answer_count,
        us.question_score_sum,
        us.answer_score_sum,
        us.upvotes_given,
        us.downvotes_given,
        COUNT(DISTINCT pt.TagName) AS distinct_tags_used,
        us.badge_count,
        us.last_post_date
    FROM user_stats us
    LEFT JOIN Posts p ON p.OwnerUserId = us.Id
    LEFT JOIN post_tags pt ON pt.PostId = p.Id
    GROUP BY
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.question_count,
        us.answer_count,
        us.question_score_sum,
        us.answer_score_sum,
        us.upvotes_given,
        us.downvotes_given,
        us.badge_count,
        us.last_post_date
), tag_popularity AS (
    SELECT 
        t.TagName,
        COUNT(p.Id)                         AS posts_with_tag,
        AVG(p.Score)                        AS avg_score,
        SUM(p.ViewCount)                    AS total_views,
        ROW_NUMBER() OVER (ORDER BY COUNT(p.Id) DESC) AS tag_rank
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE CONCAT('%', t.TagName, '%')
    WHERE p.PostTypeId = 1
    GROUP BY t.TagName
), recent_closed AS (
    SELECT 
        ph.PostId,
        ph.CreationDate                     AS closed_date,
        CASE
          WHEN TRY_CAST(ph.Comment AS INTEGER) IS NOT NULL THEN CAST(ph.Comment AS INTEGER)
          ELSE NULL
        END                                  AS close_reason_id,
        crt.Name                            AS close_reason,
        p.Title,
        p.OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON crt.Id = TRY_CAST(ph.Comment AS INTEGER)
    JOIN Posts p ON p.Id = ph.PostId
    WHERE ph.PostHistoryTypeId = 10
), top_tags AS (
    SELECT
        tp2.TagName,
        tp2.posts_with_tag,
        tp2.avg_score,
        tp2.total_views
    FROM tag_popularity tp2
    WHERE tp2.tag_rank <= 3
    ORDER BY tp2.posts_with_tag DESC
    LIMIT 1
)
SELECT 
    usf.Id                              AS UserId,
    usf.DisplayName,
    usf.Reputation,
    usf.question_count,
    usf.answer_count,
    (usf.question_score_sum + usf.answer_score_sum) AS total_score,
    usf.upvotes_given,
    usf.downvotes_given,
    usf.distinct_tags_used,
    usf.badge_count,
    usf.last_post_date,
    tp.TagName,
    tp.posts_with_tag,
    tp.avg_score,
    tp.total_views,
    rc.Title                           AS RecentClosedTitle,
    rc.closed_date,
    rc.close_reason
FROM user_stats_fixed usf
LEFT JOIN top_tags tp ON 1=1
LEFT JOIN (
    SELECT
        rc2.OwnerUserId,
        rc2.Title,
        rc2.closed_date,
        rc2.close_reason
    FROM recent_closed rc2
    WHERE rc2.rn = 1
) rc ON rc.OwnerUserId = usf.Id
WHERE usf.Reputation > 50000
GROUP BY
    usf.Id,
    usf.DisplayName,
    usf.Reputation,
    usf.question_count,
    usf.answer_count,
    usf.question_score_sum,
    usf.answer_score_sum,
    usf.upvotes_given,
    usf.downvotes_given,
    usf.distinct_tags_used,
    usf.badge_count,
    usf.last_post_date,
    tp.TagName,
    tp.posts_with_tag,
    tp.avg_score,
    tp.total_views,
    rc.Title,
    rc.closed_date,
    rc.close_reason
ORDER BY total_score DESC
LIMIT 100;