WITH TopUsers AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        SUM(p.ViewCount) AS TotalViews,
        COUNT(DISTINCT a.Id) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, COUNT(p.Id) DESC, SUM(p.Score) DESC) AS Rank
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Posts a ON p.Id = a.ParentId AND a.PostTypeId = 2
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    WHERE
        u.Reputation > 1000
    GROUP BY
        u.Id, u.DisplayName, u.Reputation
),
TopPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        u.DisplayName AS OwnerDisplayName,
        ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC, p.AnswerCount DESC) AS Rank
    FROM
        Posts p
    LEFT JOIN
        Users u ON p.OwnerUserId = u.Id
    WHERE
        p.PostTypeId = 1
        AND p.Score > 50
        AND p.ViewCount > 1000
),
TopTags AS (
    SELECT
        t.TagName,
        t.Count,
        COUNT(p.Id) AS PostCount,
        SUM(p.Score) AS TotalScore,
        SUM(p.ViewCount) AS TotalViews,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC, COUNT(p.Id) DESC, SUM(p.Score) DESC) AS Rank
    FROM
        Tags t
    LEFT JOIN
        Posts p ON p.Tags LIKE '%' || '<' || t.TagName || '>' || '%' -- keep concatenation operator for dialects that support it
    WHERE
        p.PostTypeId = 1
    GROUP BY
        t.Id, t.TagName, t.Count
)
SELECT
    tu.UserId,
    tu.DisplayName AS UserName,
    tu.Reputation,
    tu.PostCount,
    tu.TotalScore AS UserTotalScore,
    tu.TotalViews AS UserTotalViews,
    tu.AnswerCount,
    tu.CommentCount,
    tu.BadgeCount,
    tp.PostId,
    tp.Title AS PostTitle,
    tp.Score AS PostScore,
    tp.ViewCount AS PostViewCount,
    tp.AnswerCount AS PostAnswerCount,
    tp.CommentCount AS PostCommentCount,
    tp.CreationDate AS PostCreationDate,
    tp.OwnerDisplayName,
    tt.TagName,
    tt.Count AS TagCount,
    tt.PostCount AS TagPostCount,
    tt.TotalScore AS TagTotalScore,
    tt.TotalViews AS TagTotalViews,
    tu.Rank AS UserRank,
    tp.Rank AS PostRank,
    tt.Rank AS TagRank
FROM
    TopUsers tu
LEFT JOIN
    TopPosts tp ON tu.UserId = tp.OwnerUserId
LEFT JOIN
    TopTags tt ON tp.PostId IS NOT NULL AND EXISTS (
        SELECT 1 FROM Posts p2 WHERE p2.Id = tp.PostId AND p2.Tags LIKE '%' || '<' || tt.TagName || '>' || '%'
    )
WHERE
    tu.Rank <= 100
    AND (tp.Rank IS NULL OR tp.Rank <= 100)
    AND (tt.Rank IS NULL OR tt.Rank <= 100)
GROUP BY
    tu.UserId,
    tu.DisplayName,
    tu.Reputation,
    tu.PostCount,
    tu.TotalScore,
    tu.TotalViews,
    tu.AnswerCount,
    tu.CommentCount,
    tu.BadgeCount,
    tp.PostId,
    tp.Title,
    tp.Score,
    tp.ViewCount,
    tp.AnswerCount,
    tp.CommentCount,
    tp.CreationDate,
    tp.OwnerDisplayName,
    tt.TagName,
    tt.Count,
    tt.PostCount,
    tt.TotalScore,
    tt.TotalViews,
    tu.Rank,
    tp.Rank,
    tt.Rank
ORDER BY
    tu.Reputation DESC, tu.PostCount DESC, tp.Score DESC, tt.Count DESC;