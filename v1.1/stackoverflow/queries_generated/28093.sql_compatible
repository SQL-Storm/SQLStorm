WITH UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Location,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) AS VoteCount,
        ROW_NUMBER() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS ReputationRank
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    GROUP BY u.Id, u.DisplayName, u.Location
), PostDetails AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.LastActivityDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        (SELECT COUNT(*) FROM Posts a WHERE a.ParentId = p.Id AND a.PostTypeId = 2) AS CalculatedAnswers,
        (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4,5,6)) AS EditCount,
        -- replace PostgreSQL specific string_to_array/substr with standard functions where possible; keep behavior similar
        -- Convert tags like '<tag1><tag2>' into an array using standard SQL: here we keep as text and parse in main query
        p.Tags AS TagsRaw,
        COALESCE(ph.Comment, 'No close reason') AS CloseReason,
        CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAcceptedAnswer
    FROM Posts p
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId = 10
    WHERE p.PostTypeId = 1
)
SELECT 
    pd.Title,
    CONCAT(COALESCE(us.DisplayName, ''), ' - ', COALESCE(us.Location, 'Unknown')) AS AuthorInfo,
    pd.Score * 1.0 / NULLIF(pd.ViewCount, 0) AS ScorePerView,
    pd.EditCount,
    (pd.CalculatedAnswers - pd.AnswerCount) AS AnswerDiscrepancy,
    -- count tags containing 'sql' by splitting TagsRaw on '><' after trimming leading '<' and trailing '>'
    (SELECT COUNT(*) FROM (
         SELECT TRIM(BOTH '<>' FROM split_val) AS tag FROM (
             SELECT regexp_split_to_table(
                 CASE 
                     WHEN pd.TagsRaw LIKE '<%>' THEN SUBSTRING(pd.TagsRaw FROM 2 FOR CHAR_LENGTH(pd.TagsRaw) - 2)
                     ELSE pd.TagsRaw
                 END,
                 '><'
             ) AS split_val
         ) s WHERE split_val ILIKE '%sql%'
     ) t) AS SQLTagCount,
    us.BadgeCount,
    us.ReputationRank,
    pd.CloseReason,
    AVG(pd.Score) OVER (PARTITION BY us.Location) AS AvgLocationScore,
    SUM(us.VoteCount) OVER (ORDER BY us.ReputationRank) AS CumulativeVotes
FROM PostDetails pd
INNER JOIN UserStats us ON pd.Id IN (SELECT Id FROM Posts WHERE OwnerUserId = us.Id)
WHERE pd.Score > 100
    AND pd.CreationDate BETWEEN DATE '2010-01-01' AND DATE '2020-01-01'
    AND (us.BadgeCount > 10 OR us.ReputationRank <= 5)
    AND pd.HasAcceptedAnswer = 1
    AND (pd.CalculatedAnswers - pd.AnswerCount) BETWEEN -2 AND 2
ORDER BY ScorePerView DESC
LIMIT 100;