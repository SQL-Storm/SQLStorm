SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    SUM(CASE WHEN p.Score > 0 THEN 1 ELSE 0 END) AS TotalPositiveScorePosts,
    MAX(p.LastActivityDate) AS LastActivityDate,
    b.Name AS TopBadge,
    AVG(v.BountyAmount) AS AvgBounty,
    COALESCE(SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END), 0) AS TotalClosedPosts,
    STRING_AGG(DISTINCT t.TagName, ', ') AS Tags
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    (
      SELECT UserId, MAX(Date) AS MaxDate 
      FROM Badges 
      GROUP BY UserId
    ) bb ON u.Id = bb.UserId AND b.Date = bb.MaxDate
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId AND v.VoteTypeId = 8
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    (
      SELECT Id, 
             -- extract tags between < and > and split by '><' in a SQL-dialect-neutral way
             -- produce a single text with separators to later split using a derived table approach
             substring(Tags FROM 2 FOR (char_length(Tags) - 2)) AS TagString
      FROM Posts 
      WHERE PostTypeId = 1
    ) pt ON p.Id = pt.Id
LEFT JOIN 
    (
      -- split TagString into rows; different databases have different functions.
      -- Using a standard approach via recursive CTE to split on the delimiter '><'
      SELECT
        Id,
        CASE WHEN pos = 0 THEN tag ELSE substring(tag FROM 1) END AS TagName
      FROM (
        SELECT
          s.Id,
          trim(both '<>' FROM seg) AS tag,
          row_number() OVER (PARTITION BY s.Id ORDER BY (SELECT 1)) AS rn,
          0 AS pos
        FROM (
          SELECT
            Id,
            -- replace the delimiter '><' with a standard separator '|||' to ease splitting
            replace(TagString, '><', '|||') AS TagStringRepl,
            TagString
          FROM
            (SELECT Id, TagString FROM (SELECT Id, TagString FROM (SELECT Id, TagString FROM (SELECT Id, TagString FROM pt) AS ptt) AS ptt2) AS ptt3) AS innerpt
        ) inner1
        CROSS JOIN LATERAL (
          -- split by '|||'. For dialects without string_split, emulate via regexp or similar.
          -- Here we attempt to use regexp_split_to_table if available; otherwise most DBs need their own method.
          SELECT regexp_split_to_table(inner1.TagStringRepl, '\|\|\|') AS seg
        ) AS split(seg)
        CROSS JOIN (SELECT inner1.Id) s(Id)
      ) sub
    ) t ON p.Id = t.Id
LEFT JOIN 
    Tags tag ON t.TagName = tag.TagName
WHERE 
    u.Reputation > 1000
    AND p.CreationDate >= (date_trunc('month', CAST('2024-10-01' AS date)) - INTERVAL '1 year')
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, b.Name
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    u.Reputation DESC, TotalPositiveScorePosts DESC;