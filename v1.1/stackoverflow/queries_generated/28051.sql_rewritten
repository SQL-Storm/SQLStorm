-- {"query": "28051.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "deepseek-r1", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2074, "output_tokens": 1560} 
WITH UserStats AS (
    SELECT 
        u.Id,
        u.Location,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        ROW_NUMBER() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS RankInLocation,
        AVG(u.Reputation) OVER (PARTITION BY u.Location) AS AvgLocationReputation,
        COALESCE(SUM(p.Score) FILTER (WHERE p.PostTypeId = 1), 0) AS TotalQuestionScore
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.Location
), PostActivity AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        p.CreationDate,
        p.LastActivityDate,
        EXTRACT(DAY FROM (p.LastActivityDate - p.CreationDate)) AS ActivityDays,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), '; ') AS CleanedTags,
        COUNT(DISTINCT ph.Id) FILTER (WHERE ph.PostHistoryTypeId = 5) AS EditCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes
    FROM Posts p
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId IN (5, 8)
    LEFT JOIN Comments c ON c.PostId = p.Id
    WHERE p.PostTypeId = 1 AND p.ClosedDate IS NULL
    GROUP BY p.Id
)
SELECT 
    us.Location,
    us.RankInLocation,
    us.GoldBadges,
    pa.CleanedTags,
    AVG(pa.Upvotes * 1.0 / NULLIF(pa.CommentCount, 0)) AS EngagementRatio,
    MAX(us.TotalQuestionScore) OVER (PARTITION BY us.Location) AS MaxLocationScore,
    CASE 
        WHEN us.Reputation > 100000 THEN 'Legendary' 
        WHEN us.Reputation > 50000 THEN 'Epic' 
        WHEN us.Reputation > 10000 THEN 'Veteran' 
        ELSE 'Regular' 
    END AS ReputationClass,
    SUM(pa.ActivityDays) OVER (ORDER BY pa.CreationDate) AS CumulativeActivityDays
FROM UserStats us
INNER JOIN PostActivity pa ON pa.OwnerUserId = us.Id
WHERE us.Location IS NOT NULL
  AND us.GoldBadges > (SELECT AVG(GoldBadges) FROM UserStats)
  AND EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = us.Id AND b.Name LIKE '%Legendary%')
  AND pa.CleanedTags LIKE '%sql%'
UNION ALL
SELECT 
    'META' AS Location,
    NULL AS RankInLocation,
    COUNT(*) AS GoldBadges,
    NULL AS CleanedTags,
    NULL AS EngagementRatio,
    NULL AS MaxLocationScore,
    'Community' AS ReputationClass,
    NULL AS CumulativeActivityDays
FROM Badges b
WHERE b.TagBased = 1
  AND NOT EXISTS (SELECT 1 FROM Users u WHERE u.Id = b.UserId)
ORDER BY EngagementRatio DESC NULLS LAST, ReputationClass;