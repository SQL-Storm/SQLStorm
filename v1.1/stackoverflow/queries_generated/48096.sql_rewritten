-- {"query": "48096.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2074, "output_tokens": 672} 
SELECT
    p.Id AS PostId,
    p.Title,
    p.CreationDate AS PostCreationDate,
    pt.Name AS PostTypeName,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation AS OwnerReputation,
    p.Score AS PostScore,
    p.ViewCount AS PostViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    (
        SELECT COUNT(*)
        FROM Comments c
        WHERE c.PostId = p.Id
    ) AS ActualCommentCount,
    (
        SELECT COUNT(*)
        FROM PostHistory ph
        WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4, 5, 6) -- Edits
    ) AS EditCount,
    (
        SELECT COUNT(*)
        FROM PostLinks pl
        WHERE pl.PostId = p.Id AND pl.LinkTypeId = 1 -- Linked
    ) AS OutgoingLinkCount,
    (
        SELECT COUNT(*)
        FROM PostLinks pl
        WHERE pl.RelatedPostId = p.Id AND pl.LinkTypeId = 1 -- Linked
    ) AS IncomingLinkCount,
    (
        SELECT COUNT(*)
        FROM Votes v
        WHERE v.PostId = p.Id AND v.VoteTypeId = 2 -- UpVotes
    ) AS UpVoteCount,
    (
        SELECT COUNT(*)
        FROM Votes v
        WHERE v.PostId = p.Id AND v.VoteTypeId = 3 -- DownVotes
    ) AS DownVoteCount,
    (
        SELECT COUNT(*)
        FROM Badges b
        WHERE b.UserId = p.OwnerUserId AND b.Class = 1 -- Gold Badges
    ) AS OwnerGoldBadges,
    (
        SELECT COUNT(*)
        FROM Badges b
        WHERE b.UserId = p.OwnerUserId AND b.Class = 2 -- Silver Badges
    ) AS OwnerSilverBadges,
    (
        SELECT COUNT(*)
        FROM Badges b
        WHERE b.UserId = p.OwnerUserId AND b.Class = 3 -- Bronze Badges
    ) AS OwnerBronzeBadges,
    p.ClosedDate,
    p.CommunityOwnedDate,
    p.ContentLicense
FROM
    Posts p
JOIN
    PostTypes pt ON p.PostTypeId = pt.Id
JOIN
    Users u ON p.OwnerUserId = u.Id
WHERE
    pt.Name = 'Question' -- Focus on questions for this benchmark
    AND p.CreationDate >= DATE('now', '-1 year') -- Posts created in the last year
    AND p.Score > 10 -- Posts with a significant score
    AND p.ViewCount > 1000 -- Posts with a significant view count
    AND p.AnswerCount > 5 -- Posts with multiple answers
ORDER BY
    p.Score DESC, p.ViewCount DESC, p.CreationDate ASC
LIMIT 100;