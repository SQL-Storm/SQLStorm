WITH UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetVotes,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
        (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS AvgQuestionScore,
        (SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score)
         FROM Posts p
         WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS MedianAnswerScore
    FROM Users u
),

TagPopularity AS (
    SELECT
        t.TagName,
        t.Count AS TotalTagUse,
        COALESCE(SUM(p.ViewCount), 0) AS TotalTagViews,
        COUNT(DISTINCT p.OwnerUserId) AS DistinctAuthors
    FROM Tags t
    LEFT JOIN PostLinks pl
        ON pl.PostId = t.ExcerptPostId OR pl.PostId = t.WikiPostId
    LEFT JOIN Posts p
        ON p.Id = pl.PostId AND p.PostTypeId = 1
    GROUP BY t.TagName, t.Count
),

-- Replace Post tag-splitting function with a standard approach using string functions.
-- This version assumes tags are stored like '<tag1><tag2>' and extracts tags by splitting on '><'
UserTagActivity AS (
    SELECT
        us.Id      AS UserId,
        tag AS TagName,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionsWithTag,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswersWithTag,
        SUM(p.Score) AS TagScoreSum
    FROM UserStats us
    JOIN Posts p
        ON p.OwnerUserId = us.Id
    -- split tags using a recursive CTE to be more dialect-compatible
    JOIN (
        WITH RECURSIVE split(tagstr, rest) AS (
            SELECT
                NULL::text AS tag,
                COALESCE(p.Tags, '') AS rest
            UNION ALL
            SELECT
                -- extract next tag between optional '<' '>' delimiters
                CASE
                    WHEN rest = '' THEN NULL
                    WHEN rest LIKE '<%>%'
                        THEN SUBSTR(rest, 2, INSTR(rest, '>', 2) - 2)
                    WHEN rest LIKE '%><%' -- fallback if no leading '<'
                        THEN SUBSTR(rest, 1, INSTR(rest, '><') - 1)
                    ELSE rest
                END AS tag,
                -- compute remaining string after removing the extracted tag and delimiters
                CASE
                    WHEN rest = '' THEN ''
                    WHEN rest LIKE '<%>%'
                        THEN
                            CASE
                                WHEN INSTR(rest, '><') > 0 THEN SUBSTR(rest, INSTR(rest, '><') + 2)
                                ELSE ''
                            END
                    WHEN rest LIKE '%><%'
                        THEN SUBSTR(rest, INSTR(rest, '><') + 2)
                    ELSE ''
                END AS rest
            FROM (SELECT COALESCE(p.Tags, '') AS rest) init
            WHERE
                -- continue recursion while rest is not empty and not just delimiters
                rest <> ''
        )
        SELECT DISTINCT tag FROM split WHERE tag IS NOT NULL
    ) AS tag_table(tag) ON TRUE
    JOIN Tags t
        ON t.TagName = tag_table.tag
    GROUP BY us.Id, tag
),

RankedUsers AS (
    SELECT
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.NetVotes,
        us.GoldBadges,
        us.SilverBadges,
        us.BronzeBadges,
        us.QuestionCount,
        us.AnswerCount,
        us.AvgQuestionScore,
        us.MedianAnswerScore,
        ROW_NUMBER() OVER (ORDER BY (us.Reputation * 1.5 + us.NetVotes) DESC) AS ReputationRank,
        RANK()      OVER (ORDER BY us.MedianAnswerScore DESC NULLS LAST) AS MedianAnswerRank
    FROM UserStats us
)

SELECT
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.NetVotes,
    ru.GoldBadges,
    ru.SilverBadges,
    ru.BronzeBadges,
    ru.QuestionCount,
    ru.AnswerCount,
    ROUND(CAST(ru.AvgQuestionScore AS numeric), 2)   AS AvgQuestionScore,
    ROUND(CAST(ru.MedianAnswerScore AS numeric), 2)  AS MedianAnswerScore,
    ru.ReputationRank,
    ru.MedianAnswerRank,
    COALESCE(uta.QuestionsWithTag, 0) AS QuestionsWithTopTag,
    COALESCE(uta.AnswersWithTag,   0) AS AnswersWithTopTag,
    COALESCE(uta.TagScoreSum,      0) AS TagScoreSum,
    tp.TotalTagUse,
    tp.TotalTagViews,
    tp.DistinctAuthors
FROM RankedUsers ru
LEFT JOIN (
    SELECT
        uta.UserId,
        uta.TagName,
        uta.QuestionsWithTag,
        uta.AnswersWithTag,
        uta.TagScoreSum
    FROM UserTagActivity uta
    ORDER BY uta.TagScoreSum DESC
    LIMIT 1
) uta
    ON uta.UserId = ru.Id
LEFT JOIN TagPopularity tp
    ON tp.TagName = uta.TagName
WHERE ru.ReputationRank <= 10
ORDER BY ru.ReputationRank;