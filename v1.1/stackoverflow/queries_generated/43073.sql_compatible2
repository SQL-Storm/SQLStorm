WITH UserBadgeCounts AS (
    SELECT 
        UserId,
        COUNT(CASE WHEN badges."Class" = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN badges."Class" = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN badges."Class" = 3 THEN 1 END) AS BronzeBadges
    FROM Badges AS badges
    GROUP BY UserId
),
PostActivity AS (
    SELECT 
        p.OwnerUserId,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsAsked,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersProvided,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE 0 END) AS TotalQuestionViews,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.AnswerCount ELSE NULL END) AS AvgAnswersPerQuestion
    FROM Posts AS p
    WHERE p.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year')
    GROUP BY p.OwnerUserId
),
TopQuestions AS (
    SELECT 
        p.OwnerUserId,
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.ViewCount DESC) AS rn
    FROM Posts AS p
    WHERE p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL
)
SELECT 
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COALESCE(ubc.GoldBadges, 0) AS GoldBadges,
    COALESCE(ubc.SilverBadges, 0) AS SilverBadges,
    COALESCE(ubc.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(pa.QuestionsAsked, 0) AS QuestionsAsked,
    COALESCE(pa.AnswersProvided, 0) AS AnswersProvided,
    COALESCE(pa.TotalQuestionViews, 0) AS TotalQuestionViews,
    COALESCE(pa.AvgAnswersPerQuestion, 0) AS AvgAnswersPerQuestion,
    tq.Title AS TopQuestionTitle,
    tq.Score AS TopQuestionScore
FROM Users AS u
LEFT JOIN UserBadgeCounts AS ubc ON u.Id = ubc.UserId
LEFT JOIN PostActivity AS pa ON u.Id = pa.OwnerUserId
LEFT JOIN TopQuestions AS tq ON u.Id = tq.OwnerUserId AND tq.rn = 1
WHERE u.Reputation > 1000
GROUP BY
    u.Id,
    u.DisplayName,
    u.Reputation,
    ubc.GoldBadges,
    ubc.SilverBadges,
    ubc.BronzeBadges,
    pa.QuestionsAsked,
    pa.AnswersProvided,
    pa.TotalQuestionViews,
    pa.AvgAnswersPerQuestion,
    tq.Title,
    tq.Score
ORDER BY u.Reputation DESC, COALESCE(ubc.GoldBadges,0) DESC, COALESCE(ubc.SilverBadges,0) DESC, COALESCE(ubc.BronzeBadges,0) DESC;