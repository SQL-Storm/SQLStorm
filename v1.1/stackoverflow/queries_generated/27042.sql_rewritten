    PA.AvgScore,
    STRING_CONCAT(AOP.Title, ',')AS listOfQuestions,
    RA.PostId,
    PA.QuestionCount
    RA.EditDate,
    AOP.TotalScore,
    AvHor.TagName,
    OPP.BountyUserName
FROM
     ActiveUsers AU
JOIN
    RecentActivity RA ON AU.UserId = RA. userId
LEFT JOIN
    Posts PT ON AU.UserId = PT.OwnerUserId
LEFT JOIN
    PopularTags PA ON PT.Id = Unnest(string_to_array(substring(Tags, 2, length(Tags)-2), ''><'')) = PA.TagId
LEFT JOIN
