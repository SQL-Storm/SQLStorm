WITH UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        COUNT(p.Id) AS PostCount,
        COUNT(c.Id) AS CommentCount,
        COUNT(v.Id) AS VoteCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.LastActivityDate) AS LastActivityDate
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    GROUP BY
        u.Id, u.Reputation, u.DisplayName
),

PostStats AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        p.LastActivityDate,
        p.Title,
        p.Tags,
        COUNT(c.Id) AS CommentCount,
        COUNT(v.Id) AS VoteCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
        COUNT(DISTINCT ph.Id) AS HistoryCount
    FROM
        Posts p
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN
        PostHistory ph ON p.Id = ph.PostId
    GROUP BY
        p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.OwnerUserId, p.LastActivityDate, p.Title, p.Tags
),

TagStats AS (
    SELECT
        t.Id AS TagId,
        t.TagName,
        t.Count,
        COUNT(DISTINCT p.Id) AS PostCount,
        SUM(p.ViewCount) AS TotalViewCount,
        SUM(p.Score) AS TotalScore,
        COALESCE(MAX(p.LastActivityDate), '1970-01-01') AS LastActivityDate
    FROM
        Tags t
    LEFT JOIN
        Posts p ON t.TagName = ANY(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), ''><''))
    GROUP BY
        t.Id, t.TagName, t.Count
)

SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.PostCount,
    ua.CommentCount,
    ua.VoteCount,
    ua.BadgeCount,
    ua.LastActivityDate,
    ps.PostId,
    ps.PostTypeId,
    ps.CreationDate,
    ps.Score,
    ps.ViewCount,
    ps.OwnerUserId,
    ps.CommentCount AS PostCommentCount,
    ps.VoteCount AS PostVoteCount,
    ps.UpVoteCount,
    ps.DownVoteCount,
    ps.HistoryCount,
    ps.Title,
    ps.Tags,
    ts.TagId,
    ts.TagName,
    ts.Count,
    ts.PostCount AS TagPostCount,
    ts.TotalViewCount,
    ts.TotalScore,
    ts.LastActivityDate AS TagLastActivityDate,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = ps.PostId) AS LinkCount,
    (SELECT STRING_AGG(DISTINCT lt.Name, ', ') FROM PostLinks pl JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id WHERE pl.PostId = ps.PostId) AS LinkTypes,   (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = ps.PostId AND ph.PostHistoryTypeId IN (10, 11, 12, 35, 36)) AS MigrationCount,
    (SELECT COUNT(*) FROM Votes vt WHERE vt.PostId = ps.PostId AND vt.VoteTypeId IN (12, 1, 4, 8)) AS SpecialVoteCount
FROM
    UserActivity ua
JOIN
    PostStats ps ON ua.UserId = ps.OwnerUserId
LEFT JOIN
    TagStats ts ON ts.TagName = ANY(STRING_TO_ARRAY(SUBSTRING(ps.Tags FROM 2 FOR LENGTH(ps.Tags)-2), ''><''))
WHERE
    ua.Reputation > 1000
    AND ps.PostTypeId = 1
    AND ps.CreationDate > '2023-01-01'
    AND ps.ViewCount > 1000
    AND (ps.Title LIKE '%SQL%' OR ps.Tags LIKE '%<SQL>%')
ORDER BY
    ua.Reputation DESC,
    ps.Score DESC,
    ps.ViewCount DESC
LIMIT 100;