WITH HighReputationUsers AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgPostScore
    FROM Users u
    JOIN Posts p ON u.Id = p.OwnerUserId
    JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 100000
      AND p.PostTypeId IN (1, 2)
      AND u.UpVotes > (u.DownVotes * 5)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
    HAVING COUNT(b.Id) FILTER (WHERE b.Class = 1) > 5
       AND AVG(p.Score) > 10
),
UserAnswerStats AS (
    SELECT
        hru.UserId,
        q.Id AS QuestionId,
        q.Tags,
        a.Id AS AnswerId,
        a.Score AS AnswerScore,
        q.ViewCount AS QuestionViewCount,
        a.CreationDate AS AnswerCreationDate,
        q.CreationDate AS QuestionCreationDate,
        EXTRACT(EPOCH FROM (a.CreationDate - q.CreationDate)) / 3600 AS HoursToAnswer,
        ROW_NUMBER() OVER(PARTITION BY hru.UserId ORDER BY a.Score DESC, q.ViewCount DESC) AS AnswerRank
    FROM HighReputationUsers hru
    JOIN Posts a ON hru.UserId = a.OwnerUserId AND a.PostTypeId = 2
    JOIN Posts q ON a.ParentId = q.Id
    WHERE q.ClosedDate IS NULL AND q.DeletionDate IS NULL
    GROUP BY
        hru.UserId,
        q.Id,
        q.Tags,
        a.Id,
        a.Score,
        q.ViewCount,
        a.CreationDate,
        q.CreationDate
),
AnswerCommentsAnalysis AS (
    SELECT
        uas.UserId,
        uas.AnswerId,
        COUNT(c.Id) AS TotalComments,
        SUM(c.Score) AS TotalCommentScore,
        FIRST_VALUE(c.UserId) OVER (PARTITION BY uas.AnswerId ORDER BY c.Score DESC, c.CreationDate DESC) AS TopCommenterUserId
    FROM UserAnswerStats uas
    JOIN Comments c ON uas.AnswerId = c.PostId
    WHERE uas.AnswerRank <= 10
    GROUP BY uas.UserId, uas.AnswerId
)
SELECT
    hru.DisplayName,
    hru.Reputation,
    hru.GoldBadges,
    uas.AnswerRank,
    p.Title AS QuestionTitle,
    uas.AnswerScore,
    uas.QuestionViewCount,
    uas.HoursToAnswer,
    COALESCE(aca.TotalComments, 0) AS CommentsOnAnswer,
    COALESCE(aca.TotalCommentScore, 0) AS CommentScoreOnAnswer,
    TopCommenter.DisplayName AS TopCommenterName,
    (uas.AnswerScore * 10) + (uas.QuestionViewCount / 1000.0) + (COALESCE(aca.TotalCommentScore, 0) * 5) AS AnswerImpactScore,
    (
        SELECT MAX(ph.CreationDate) - MIN(ph.CreationDate)
        FROM PostHistory ph
        WHERE ph.UserId = hru.UserId
    ) AS UserActivitySpan,
    hru.UserId
FROM HighReputationUsers hru
JOIN UserAnswerStats uas ON hru.UserId = uas.UserId
JOIN Posts p ON uas.QuestionId = p.Id
LEFT JOIN AnswerCommentsAnalysis aca ON uas.AnswerId = aca.AnswerId AND uas.UserId = aca.UserId
LEFT JOIN Users TopCommenter ON aca.TopCommenterUserId = TopCommenter.Id
WHERE uas.AnswerRank <= 5
GROUP BY
    hru.DisplayName,
    hru.Reputation,
    hru.GoldBadges,
    uas.AnswerRank,
    p.Title,
    uas.AnswerScore,
    uas.QuestionViewCount,
    uas.HoursToAnswer,
    aca.TotalComments,
    aca.TotalCommentScore,
    TopCommenter.DisplayName,
    hru.UserId
ORDER BY hru.Reputation DESC, hru.UserId, uas.AnswerRank;