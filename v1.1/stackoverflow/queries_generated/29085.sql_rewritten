WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                ROUND(CAST(SUM(p.Score) AS FLOAT) / COUNT(DISTINCT p.Id), 2)
            ELSE 0 
        END AS AvgPostScore,
        CASE 
            WHEN MAX(p.CreationDate) IS NOT NULL AND u.CreationDate IS NOT NULL THEN 
                DATEDIFF(day, u.CreationDate, MAX(p.CreationDate))
            ELSE 0 
        END AS DaysSinceFirstPost,
        STRING_AGG(
            CASE 
                WHEN p.PostTypeId = 1 THEN 'Q'
                WHEN p.PostTypeId = 2 THEN 'A'
                ELSE 'O'
            END, 
            ',' ORDER BY p.CreationDate
        ) AS PostTypeHistory,
        NULLIF(
            (SELECT TOP 1 Title 
             FROM Posts p2 
             WHERE p2.OwnerUserId = u.Id 
             AND p2.PostTypeId = 1 
             AND p2.CreationDate = (
                 SELECT MAX(CreationDate) 
                 FROM Posts 
                 WHERE OwnerUserId = u.Id AND PostTypeId = 1
             )
            ), 
            ''
        ) AS RecentQuestionTitle,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                CAST(SUM(CAST(p.ViewCount AS FLOAT)) / COUNT(DISTINCT p.Id) AS INT)
            ELSE 0 
        END AS AvgViewsPerPost
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation >= 1000
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.CreationDate
),
TopTags AS (
    SELECT TOP 100
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        STRING_AGG(
            CASE 
                WHEN p.PostTypeId = 1 THEN 
                    LEFT(p.Title, 50) + '...' 
                ELSE 
                    p.Body 
            END, 
            ' | ' ORDER BY p.CreationDate DESC
        ) AS RecentTagPosts,
        COUNT(DISTINCT p.Id) AS PostCount,
        AVG(p.Score) AS AvgScore,
        MIN(p.CreationDate) AS FirstPostDate,
        MAX(p.CreationDate) AS LastPostDate
    FROM Tags t
    INNER JOIN Posts p ON p.Tags LIKE '%' + t.TagName + '%'
    WHERE p.PostTypeId = 1
    GROUP BY t.TagName, t.Count, t.ExcerptPostId
    HAVING COUNT(DISTINCT p.Id) > 100
    ORDER BY t.Count DESC
),
PostComplexityAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CommentCount,
        p.AnswerCount,
        p.CreationDate,
        p.OwnerUserId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 
                'Question'
            WHEN p.PostTypeId = 2 THEN 
                'Answer'
            ELSE 
                'Other'
        END AS PostType,
        CASE 
            WHEN p.Tags IS NOT NULL AND LEN(p.Tags) > 0 THEN 
                LEN(p.Tags) - LEN(REPLACE(p.Tags, '>', '')) + 1
            ELSE 0 
        END AS TagCount,
        CASE 
            WHEN p.Body IS NOT NULL AND LEN(p.Body) > 0 THEN 
                CASE 
                    WHEN LEN(p.Body) > 1000 THEN 'Long'
                    WHEN LEN(p.Body) > 500 THEN 'Medium'
                    ELSE 'Short'
                END
            ELSE 'NoBody'
        END AS BodyLengthCategory,
        p.ViewCount * 0.001 + p.AnswerCount * 0.1 + p.CommentCount * 0.05 + p.Score * 0.01 AS EngagementScore
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
      AND p.OwnerUserId IS NOT NULL
      AND p.Body IS NOT NULL
      AND p.Body != ''
),
UserContributionMetrics AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.ViewCount,
        u.UpVotes,
        u.DownVotes,
        u.CreationDate,
        COALESCE(pa.AvgPostScore, 0) AS AvgPostScore,
        COALESCE(ua.TotalPosts, 0) AS TotalPosts,
        COALESCE(ua.QuestionCount, 0) AS QuestionCount,
        COALESCE(ua.AnswerCount, 0) AS AnswerCount,
        COALESCE(ua.CommentCount, 0) AS CommentCount,
        COALESCE(ua.BadgeCount, 0) AS BadgeCount,
        COALESCE(pa.EnemyCount, 0) AS EnemyCount,
        COALESCE(pa.FriendCount, 0) AS FriendCount,
        CASE 
            WHEN ua.TotalPosts > 0 THEN 100 * ua.AnswerCount / ua.TotalPosts
            ELSE 0 
        END AS AnswerPercentage,
        CASE 
            WHEN ua.QuestionCount > 0 THEN 100 * ua.AnswerCount / ua.QuestionCount
            ELSE 0 
        END AS AnswerToQuestionRatio,
        CASE 
            WHEN u.Reputation > 10000 THEN 'Expert'
            WHEN u.Reputation > 5000 THEN 'Advanced'
            WHEN u.Reputation > 1000 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS ReputationTier,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RankByReputation,
        ROW_NUMBER() OVER (ORDER BY ua.TotalPosts DESC) AS RankByPosts,
        RANK() OVER (ORDER BY u.Reputation DESC, ua.TotalPosts DESC) AS CombinedRank
    FROM Users u
    LEFT JOIN UserActivityStats ua ON u.Id = ua.UserId
    LEFT JOIN (
        SELECT 
            p.OwnerUserId,
            AVG(p.Score) AS AvgPostScore,
            COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.UserId END) AS EnemyCount,
            COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.UserId END) AS FriendCount
        FROM Posts p
        LEFT JOIN Votes v ON p.Id = v.PostId
        WHERE p.OwnerUserId IS NOT NULL
        GROUP BY p.OwnerUserId
    ) pa ON u.Id = pa.OwnerUserId
    WHERE u.Reputation >= 500
),
CombinedAnalysis AS (
    SELECT 
        ucm.UserId,
        ucm.DisplayName,
        ucm.Reputation,
        ucm.TotalPosts,
        ucm.QuestionCount,
        ucm.AnswerCount,
        ucm.AnswerPercentage,
        ucm.AnswerToQuestionRatio,
        ucm.ReputationTier,
        ucm.RankByReputation,
        ucm.RankByPosts,
        ucm.CombinedRank,
        MAX(ca.Score) AS PeakScore,
        MAX(ca.ViewCount) AS PeakViews,
        MAX(ca.AnswerCount) AS PeakAnswers,
        NULLIF(COUNT(DISTINCT CASE WHEN ca.PostType = 'Question' THEN ca.PostId END), 0) AS QuestionCount2,
        NULLIF(COUNT(DISTINCT CASE WHEN ca.PostType = 'Answer' THEN ca.PostId END), 0) AS AnswerCount2,
        STRING_AGG(
            CASE 
                WHEN ca.PostType = 'Question' THEN 
                    STRING_AGG(ca.Title, ' | ') 
                    OVER (ORDER BY ca.CreationDate ROWS BETWEEN 10 PRECEDING AND CURRENT ROW)
                ELSE 
                    ''
            END, 
            '|'
        ) AS RecentQuestions,
        STRING_AGG(
            CASE 
                WHEN ca.PostType = 'Answer' THEN 
                    CAST(SUM(CAST(ca.Score AS FLOAT)) OVER (ORDER BY ca.CreationDate ROWS BETWEEN 10 PRECEDING AND CURRENT ROW) AS VARCHAR(10))
                ELSE 
                    ''
            END, 
            '|'
        ) AS RecentScoreSum,
        COUNT(DISTINCT CASE WHEN ca.BodyLengthCategory = 'Long' THEN ca.PostId END) AS LongPostCount,
        DATEDIFF(day, ucm.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS DaysSinceRegistration,
        ucm.ViewCount,
        ucm.UpVotes,
        ucm.DownVotes,
        ucm.BadgeCount,
        ucm.CombinedRank * (ucm.AnswerCount + ucm.QuestionCount) AS PerformanceFactor,
        CASE 
            WHEN ucm.AnswerCount > 0 THEN 
                CAST(ucm.QuestionCount * 100.0 / ucm.AnswerCount AS VARCHAR(10)) + '%'
            ELSE '0%'
        END AS AnswerQualityRatio,
        (
            CAST(ucm.AnswerCount AS FLOAT) / 
            NULLIF(CAST(ucm.QuestionCount AS FLOAT), 0)
        ) AS AnswerEfficiency,
        COALESCE(
            (SELECT TOP 1 p2.Title 
             FROM Posts p2 
             WHERE p2.OwnerUserId = ucm.UserId 
             AND p2.PostTypeId = 1 
             ORDER BY p2.CreationDate DESC
            ), 
            'No Recent Questions'
        ) AS LatestQuestion,
        COALESCE(
            (SELECT TOP 1 p3.Title 
             FROM Posts p3 
             WHERE p3.OwnerUserId = ucm.UserId 
             AND p3.PostTypeId = 2 
             ORDER BY p3.CreationDate DESC
            ), 
            'No Recent Answers'
        ) AS LatestAnswer
    FROM UserContributionMetrics ucm
    LEFT JOIN PostComplexityAnalysis ca ON ucm.UserId = ca.OwnerUserId
    WHERE ucm.CombinedRank <= 5000
    GROUP BY 
        ucm.UserId, ucm.DisplayName, ucm.Reputation, ucm.TotalPosts, ucm.QuestionCount, 
        ucm.AnswerCount, ucm.AnswerPercentage, ucm.AnswerToQuestionRatio, ucm.ReputationTier,
        ucm.RankByReputation, ucm.RankByPosts, ucm.CombinedRank, ucm.CreationDate,
        ucm.ViewCount, ucm.UpVotes, ucm.DownVotes, ucm.BadgeCount
)
SELECT 
    c.UserId,
    c.DisplayName,
    c.Reputation,
    c.TotalPosts,
    c.QuestionCount,
    c.AnswerCount,
    c.AnswerPercentage,
    c.AnswerToQuestionRatio,
    c.ReputationTier,
    c.PerformanceFactor,
    c.AnswerEfficiency,
    COALESCE(t1.TagName, 'No Popular Tags') AS PopularTag,
    COALESCE(t1.Count, 0) AS TagCount,
    CASE 
        WHEN c.DaySinceRegistration > 365 THEN 'Veteran'
        WHEN c.DaySinceRegistration > 180 THEN 'Experienced'
        ELSE 'New'
    END AS MembershipStatus,
    CASE 
        WHEN c.Reputation > 50000 THEN 'Elite'
        WHEN c.Reputation > 10000 THEN 'Master'
        WHEN c.Reputation > 5000 THEN 'Expert'
        ELSE 'Regular'
    END AS RecognitionLevel,
    c.CombinedRank,
    CASE 
        WHEN c.QuestionCount > 0 THEN 
            ROUND(c.QuestionCount * 100.0 / (c.QuestionCount + c.AnswerCount), 2)
        ELSE 0
    END AS QuestionPercentage,
    CASE 
        WHEN c.AnswerCount > 0 THEN 
            ROUND(c.AnswerCount * 100.0 / (c.QuestionCount + c.AnswerCount), 2)
        ELSE 0
    END AS AnswerPercentage2,
    COALESCE(c.LatestQuestion, 'No Recent Questions') AS LatestQuestion,
    COALESCE(c.LatestAnswer, 'No Recent Answers') AS LatestAnswer,
    (
        SELECT TOP 1 TagName 
        FROM Tags t 
        WHERE t.Id IN (
            SELECT TOP 5 p1.Id 
            FROM Posts p1 
            WHERE p1.OwnerUserId = c.UserId 
            AND p1.PostTypeId = 1
            ORDER BY p1.CreationDate DESC
        )
    ) AS SampleQuestionTag,
    (
        SELECT STRING_AGG(
            CASE 
                WHEN p1.PostTypeId = 1 THEN 
                    p1.Title 
                ELSE 
                    'Answer Title'
            END, 
            ' | '
        )
        FROM Posts p1 
        WHERE p1.OwnerUserId = c.UserId 
        ORDER BY p1.CreationDate DESC
        LIMIT 5
    ) AS RecentActivitySummary,
    (
        SELECT COUNT(DISTINCT p2.Id) 
        FROM Posts p2 
        WHERE p2.OwnerUserId = c.UserId 
        AND p2.Score > 1000
    ) AS ElitePostCount,
    (
        SELECT MAX(p3.Score) 
        FROM Posts p3 
        WHERE p3.OwnerUserId = c.UserId
    ) AS MaxScoreAchieved,
    (
        SELECT STRING_AGG(b1.Name, ', ') 
        FROM Badges b1 
        WHERE b1.UserId = c.UserId
    ) AS RecentBadges,
    (
        SELECT COUNT(DISTINCT p4.Id) 
        FROM Posts p4 
        WHERE p4.OwnerUserId = c.UserId 
        AND p4.PostTypeId = 2
        AND p4.CreationDate > DATEADD(month, -3, cast('2024-10-01 12:34:56' as timestamp))
    ) AS RecentAnswers,
    COALESCE(
        (SELECT AVG(pa2.Score) 
         FROM Posts pa2 
         WHERE pa2.OwnerUserId = c.UserId 
         AND pa2.PostTypeId = 2
        ), 
        0
    ) AS AvgAnswerScore,
    (
        SELECT COUNT(DISTINCT p5.Id) 
        FROM Posts p5 
        WHERE p5.OwnerUserId = c.UserId 
        AND p5.PostTypeId = 1
        AND p5.CreationDate > DATEADD(month, -6, cast('2024-10-01 12:34:56' as timestamp))
    ) AS RecentQuestions,
    (
        SELECT STRING_AGG(p6.Title, ' | ') 
        FROM Posts p6 
        WHERE p6.OwnerUserId = c.UserId 
        AND p6.PostTypeId = 1
        AND p6.CreationDate > DATEADD(month, -1, cast('2024-10-01 12:34:56' as timestamp))
        ORDER BY p6.CreationDate DESC
        OFFSET 0 ROWS FETCH NEXT 3 ROWS ONLY
    ) AS RecentQuestionTitles,
    (
        SELECT STRING_AGG(p7.Title, ' | ') 
        FROM Posts p7 
        WHERE p7.OwnerUserId = c.UserId 
        AND p7.PostTypeId = 2
        AND p7.CreationDate > DATEADD(month, -1, cast('2024-10-01 12:34:56' as timestamp))
        ORDER BY p7.CreationDate DESC
        OFFSET 0 ROWS FETCH NEXT 3 ROWS ONLY
    ) AS RecentAnswerTitles
FROM CombinedAnalysis c
LEFT JOIN TopTags t1 ON t1.PostCount > 500
WHERE c.TotalPosts > 0
ORDER BY c.Reputation DESC, c.CombinedRank ASC
OFFSET 0 ROWS FETCH NEXT 1000 ROWS ONLY;