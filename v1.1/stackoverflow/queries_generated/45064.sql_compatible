SELECT
    p.Id AS PostId,
    p.Title,
    p.CreationDate,
    t.TagName,
    u.DisplayName AS AuthorName,
    COUNT(DISTINCT v.Id) AS VoteCount,
    COUNT(DISTINCT c.Id) AS CommentCount,
    MAX(u.Reputation) AS AuthorReputation,
    AVG(v2.Score) AS AverageRelatedPostScore
FROM
    Posts p
JOIN Tags t ON t.Id = (
    -- match tag name extracted from p.Tags; pick any matching tag name per post
    -- use the first element of the split array to compare with t.TagName
    -- split p.Tags like '<tag1><tag2>' into array ['tag1','tag2']
    (SELECT elem FROM unnest(string_to_array(substring(p.Tags FROM 2 FOR (char_length(p.Tags) - 2)), '><')) AS elem LIMIT 1)
)
JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Votes v ON p.Id = v.PostId
LEFT JOIN Comments c ON p.Id = c.PostId
LEFT JOIN PostLinks pl ON p.Id = pl.PostId
LEFT JOIN Posts v2 ON pl.RelatedPostId = v2.Id
WHERE
    p.PostTypeId = 1
    AND p.CreationDate > DATE '2015-01-01'
    AND u.Reputation > 1000
GROUP BY
    p.Id, p.Title, p.CreationDate, t.TagName, u.DisplayName, u.Reputation
HAVING
    COUNT(DISTINCT v.Id) > 10
ORDER BY
    VoteCount DESC, AuthorReputation DESC
LIMIT 500;