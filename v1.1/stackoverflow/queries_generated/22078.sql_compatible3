WITH UserTags AS (
    SELECT
        p.Id AS PostId,
        u.Id AS UserId,
        TRIM(tag) AS Tag
    FROM Users u
    JOIN Posts p ON u.Id = p.OwnerUserId
    CROSS JOIN LATERAL (
        SELECT regexp_split_to_table(substring(p.Tags FROM 2 FOR (char_length(p.Tags) - 2)), '><') AS tag
    ) t
    WHERE p.Tags IS NOT NULL AND p.Tags <> ''
),
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS Questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS Answers,
        AVG(NULLIF(p.Score, 0)) AS AvgScore,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        STRING_AGG(DISTINCT ut.Tag, ',') AS TagsUsed
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Votes v ON u.Id = v.UserId AND v.VoteTypeId IN (2,3)
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN UserTags ut ON u.Id = ut.UserId
    WHERE u.CreationDate < DATE '2020-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
RankedUsers AS (
    SELECT 
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.TotalPosts,
        us.Questions,
        us.Answers,
        us.AvgScore,
        us.UpVotes,
        us.DownVotes,
        us.TotalComments,
        us.TotalBadges,
        us.TagsUsed,
        RANK() OVER (ORDER BY (us.Reputation + COALESCE(us.UpVotes,0) * 10 - COALESCE(us.DownVotes,0) * 5 + COALESCE(us.TotalBadges,0) * 100) DESC) AS GlobalRank
    FROM UserStats us
),
ActiveUsers AS (
    SELECT 
        ru.Id,
        ru.DisplayName,
        ru.Reputation,
        ru.TotalPosts,
        ru.Questions,
        ru.Answers,
        ru.AvgScore,
        ru.UpVotes,
        ru.DownVotes,
        ru.TotalComments,
        ru.TotalBadges,
        ru.TagsUsed,
        ru.GlobalRank,
        (SELECT COUNT(*) FROM Posts p2 WHERE p2.OwnerUserId = ru.Id AND p2.LastActivityDate > (DATE '2024-10-01' - INTERVAL '30' DAY')) AS RecentPosts
    FROM RankedUsers ru
    WHERE ru.TotalPosts > 0 OR ru.TotalComments > 0
),
FinalRanks AS (
    SELECT 
        au.Id,
        au.DisplayName,
        au.Reputation,
        au.TotalPosts,
        au.Questions,
        au.Answers,
        au.AvgScore,
        au.UpVotes,
        au.DownVotes,
        au.TotalComments,
        au.TotalBadges,
        au.TagsUsed,
        au.GlobalRank,
        au.RecentPosts,
        CASE 
            WHEN au.TagsUsed IS NULL OR POSITION(',' IN au.TagsUsed) = 0 THEN au.TagsUsed
            ELSE SUBSTRING(au.TagsUsed FROM 1 FOR (POSITION(',' IN au.TagsUsed) - 1))
        END AS FirstTag,
        RANK() OVER (
            PARTITION BY CASE 
                WHEN au.TagsUsed IS NULL OR POSITION(',' IN au.TagsUsed) = 0 THEN au.TagsUsed
                ELSE SUBSTRING(au.TagsUsed FROM 1 FOR (POSITION(',' IN au.TagsUsed) - 1))
            END
            ORDER BY au.GlobalRank
        ) AS TagRank,
        CASE 
            WHEN au.AvgScore IS NULL THEN 'No Score'
            WHEN au.AvgScore > 10 THEN 'High Scorer'
            ELSE 'Normal'
        END AS ScoreCategory
    FROM ActiveUsers au
)
SELECT 
    fr.Id,
    fr.DisplayName,
    fr.Reputation,
    fr.TotalPosts,
    fr.Questions,
    fr.Answers,
    fr.AvgScore,
    fr.UpVotes,
    fr.DownVotes,
    fr.TotalComments,
    fr.TotalBadges,
    fr.TagsUsed,
    fr.GlobalRank,
    fr.RecentPosts,
    fr.TagRank,
    fr.ScoreCategory,
    CASE WHEN fr.TagsUsed IS NOT NULL AND CHAR_LENGTH(fr.TagsUsed) > 0 THEN UPPER(SPLIT_PART(fr.TagsUsed, ',', 1)) ELSE 'NONE' END AS TopTag
FROM FinalRanks fr
WHERE fr.GlobalRank <= 100
  AND (fr.Questions > fr.Answers OR fr.Answers IS NULL)
UNION ALL
SELECT 
    fr.Id,
    fr.DisplayName,
    fr.Reputation,
    fr.TotalPosts,
    fr.Questions,
    fr.Answers,
    fr.AvgScore,
    fr.UpVotes,
    fr.DownVotes,
    fr.TotalComments,
    fr.TotalBadges,
    fr.TagsUsed,
    fr.GlobalRank,
    fr.RecentPosts,
    fr.TagRank,
    fr.ScoreCategory,
    'AVERAGE' AS TopTag
FROM FinalRanks fr
WHERE fr.AvgScore > (
    SELECT AVG(ru.AvgScore) 
    FROM RankedUsers ru 
    WHERE ru.AvgScore IS NOT NULL
)
ORDER BY GlobalRank, TagRank;