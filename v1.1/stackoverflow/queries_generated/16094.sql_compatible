WITH user_activity_metrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.Location,
        COUNT(DISTINCT p.Id) AS post_count,
        COUNT(DISTINCT b.Id) AS badge_count,
        COALESCE(AVG(p.Score), 0) AS avg_post_score,
        MAX(p.CreationDate) AS last_post_date,
        ROW_NUMBER() OVER (PARTITION BY SUBSTRING(COALESCE(u.Location, 'Unknown'), 1, 20) ORDER BY u.Reputation DESC) AS location_rank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT b.Id) DESC) AS badge_rank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId IN (1, 2)
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= TIMESTAMP '2015-01-01'
      AND (u.Reputation > 1000 OR u.UpVotes > 100)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
    HAVING COUNT(DISTINCT p.Id) > 5
),
post_engagement_analysis AS (
    SELECT 
        p.Id AS post_id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Accepted'
            WHEN p.AnswerCount > 0 THEN 'Answered'
            ELSE 'Unanswered'
        END AS answer_status,
        -- convert tag string like '<tag1><tag2>' into array by removing leading/trailing <> and splitting on '><'
        CASE 
          WHEN p.Tags IS NULL OR p.Tags = '' THEN ARRAY[]::text[]
          ELSE regexp_split_to_array(substr(p.Tags, 2, char_length(p.Tags) - 2), '><')
        END AS tag_array,
        (SELECT COUNT(*) 
         FROM Comments c 
         WHERE c.PostId = p.Id 
           AND c.Score > 0) AS positive_comments,
        (SELECT string_agg(DISTINCT vt.Name, ', ')
         FROM Votes v
         INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
         WHERE v.PostId = p.Id) AS vote_types,
        EXTRACT(EPOCH FROM (p.LastActivityDate - p.CreationDate)) / 86400.0 AS activity_duration_days,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS prev_post_score,
        LEAD(p.ViewCount) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS next_post_views,
        p.OwnerUserId,
        p.CreationDate
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= TIMESTAMP '2018-01-01'
      AND p.Score IS NOT NULL
),
tag_performance AS (
    SELECT 
        t.TagName,
        t.Count AS tag_usage_count,
        AVG(p.Score) AS avg_score,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.ViewCount) AS median_views,
        CAST(COUNT(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 END) AS DOUBLE PRECISION) / NULLIF(COUNT(*), 0) AS acceptance_rate
    FROM Tags t
    INNER JOIN Posts p ON POSITION('<' || t.TagName || '>' IN p.Tags) > 0
    WHERE p.PostTypeId = 1
      AND t.Count > 100
    GROUP BY t.TagName, t.Count
),
correlated_user_stats AS (
    SELECT 
        uam.Id,
        uam.DisplayName,
        uam.post_count,
        uam.badge_count,
        uam.avg_post_score,
        uam.location_rank,
        (SELECT COUNT(*)
         FROM PostHistory ph
         WHERE ph.UserId = uam.Id
           AND ph.PostHistoryTypeId IN (4, 5, 6)
           AND ph.CreationDate > uam.last_post_date - INTERVAL '90 days') AS recent_edits,
        (SELECT COALESCE(SUM(v.BountyAmount), 0)
         FROM Votes v
         WHERE v.UserId = uam.Id
           AND v.VoteTypeId = 8) AS total_bounties_offered,
        CASE 
            WHEN uam.Reputation > 10000 THEN 'Elite'
            WHEN uam.Reputation > 5000 THEN 'Expert'
            WHEN uam.Reputation > 1000 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS user_tier,
        uam.Reputation,
        uam.last_post_date
    FROM user_activity_metrics uam
    WHERE uam.location_rank <= 3
)
SELECT 
    cus.DisplayName,
    cus.user_tier,
    cus.post_count,
    cus.badge_count,
    ROUND(cus.avg_post_score::numeric, 2) AS avg_score,
    cus.recent_edits,
    cus.total_bounties_offered,
    pea.answer_status,
    pea.positive_comments,
    pea.activity_duration_days,
    COALESCE(NULLIF(TRIM(BOTH FROM SUBSTRING(pea.Title, 1, 50)), ''), 'No Title') AS truncated_title,
    tp.avg_score AS tag_avg_score,
    ROUND(tp.acceptance_rate * 100, 2) AS tag_acceptance_pct,
    CASE 
        WHEN pea.prev_post_score IS NULL THEN 'First Post'
        WHEN pea.Score > pea.prev_post_score THEN 'Improving'
        WHEN pea.Score < pea.prev_post_score THEN 'Declining'
        ELSE 'Stable'
    END AS performance_trend,
    COALESCE(pea.ViewCount, 0) * 0.1 + COALESCE(pea.Score, 0) * 5 AS engagement_metric
FROM correlated_user_stats cus
INNER JOIN user_activity_metrics uam ON cus.Id = uam.Id
-- replace non-inner join on subquery with lateral join that selects recent posts per user
LEFT JOIN LATERAL (
    SELECT p2.Id AS post_id,
           p2.Title,
           p2.Score,
           p2.ViewCount,
           p2.AnswerCount,
           p2.AcceptedAnswerId,
           p2.Tags,
           p2.LastActivityDate,
           p2.CreationDate,
           p2.OwnerUserId
    FROM Posts p2
    WHERE p2.OwnerUserId = cus.Id
    ORDER BY p2.CreationDate DESC
    LIMIT 5
) pea ON TRUE
LEFT JOIN LATERAL (
    SELECT tp2.* 
    FROM tag_performance tp2
    WHERE EXISTS (
        SELECT 1 
        FROM unnest(
            CASE WHEN pea.Tags IS NULL OR pea.Tags = '' THEN ARRAY[]::text[]
                 ELSE regexp_split_to_array(substr(pea.Tags, 2, char_length(pea.Tags) - 2), '><')
            END
        ) AS tag_elem(tag)
        WHERE tag_elem.tag = tp2.TagName
    )
    ORDER BY tp2.avg_score DESC
    LIMIT 1
) tp ON TRUE
WHERE cus.post_count > 10
  AND (pea.ViewCount > 500 OR pea.Score > 5 OR pea.ViewCount IS NULL)
  AND (cus.total_bounties_offered > 0 OR cus.recent_edits > 2)
ORDER BY 
    CASE cus.user_tier
        WHEN 'Elite' THEN 1
        WHEN 'Expert' THEN 2
        WHEN 'Intermediate' THEN 3
        ELSE 4
    END,
    engagement_metric DESC NULLS LAST,
    cus.badge_count DESC
LIMIT 100;