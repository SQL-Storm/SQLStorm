WITH RECURSIVE UserHierarchy AS (
  SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    0 AS Level
  FROM Users u
  WHERE u.Reputation > 10000
    AND u.UpVotes > 1000
  FETCH FIRST 100 ROWS ONLY
),
QuestionMetrics AS (
  SELECT 
    p.Id AS QuestionId,
    p.OwnerUserId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.FavoriteCount,
    COUNT(DISTINCT c.Id) AS CommentCount,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
    AVG((CAST(STRFTIME('%s', a.CreationDate) AS DOUBLE) - CAST(STRFTIME('%s', p.CreationDate) AS DOUBLE))/3600.0) AS AvgTimeToAnswerHours,
    LISTAGG(DISTINCT t.TagName, ', ') WITHIN GROUP (ORDER BY t.TagName) AS Tags
  FROM Posts p
  LEFT JOIN Comments c ON p.Id = c.PostId
  LEFT JOIN Votes v ON p.Id = v.PostId
  LEFT JOIN Posts a ON p.Id = a.ParentId AND a.PostTypeId = 2
  LEFT JOIN (
    SELECT p2.Id AS PostId, TRIM(tag) AS tag
    FROM Posts p2
    CROSS APPLY (
      SELECT value AS tag
      FROM UNNEST(string_split(SUBSTRING(p2.Tags FROM 2 FOR CHAR_LENGTH(p2.Tags)-2), '><')) AS value
    ) AS split
  ) tag_split ON p.Id = tag_split.PostId
  LEFT JOIN Tags t ON t.TagName = tag_split.tag
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= DATE(CAST('2024-10-01' AS DATE), '-2 years')
    AND p.Score >= 5
  GROUP BY p.Id, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, p.FavoriteCount
),
AnswerQuality AS (
  SELECT 
    a.Id AS AnswerId,
    a.ParentId AS QuestionId,
    a.OwnerUserId,
    a.Score AS AnswerScore,
    a.CreationDate,
    CASE WHEN q.AcceptedAnswerId = a.Id THEN 1 ELSE 0 END AS IsAccepted,
    COUNT(DISTINCT ph.Id) AS EditCount,
    COUNT(DISTINCT c.Id) AS AnswerComments,
    RANK() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS AnswerRank
  FROM Posts a
  INNER JOIN Posts q ON a.ParentId = q.Id
  LEFT JOIN PostHistory ph ON a.Id = ph.PostId AND ph.PostHistoryTypeId IN (5, 8)
  LEFT JOIN Comments c ON a.Id = c.PostId
  WHERE a.PostTypeId = 2
    AND a.CreationDate >= DATE(CAST('2024-10-01' AS DATE), '-2 years')
  GROUP BY a.Id, a.ParentId, a.OwnerUserId, a.Score, a.CreationDate, q.AcceptedAnswerId
),
UserEngagement AS (
  SELECT 
    uh.Id AS UserId,
    uh.DisplayName,
    uh.Reputation,
    COUNT(DISTINCT qm.QuestionId) AS QuestionsAsked,
    AVG(qm.Score) AS AvgQuestionScore,
    COUNT(DISTINCT aq.AnswerId) AS AnswersGiven,
    AVG(aq.AnswerScore) AS AvgAnswerScore,
    SUM(aq.IsAccepted) AS AcceptedAnswers,
    COUNT(DISTINCT b.Id) AS TotalBadges,
    SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
    SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
    SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
    SUM(CASE WHEN v.VoteTypeId = 8 THEN 1 ELSE 0 END) AS BountiesStarted,
    SUM(CASE WHEN v.VoteTypeId = 8 THEN COALESCE(v.BountyAmount,0) ELSE 0 END) AS TotalBountyAmount
  FROM UserHierarchy uh
  LEFT JOIN QuestionMetrics qm ON uh.Id = qm.OwnerUserId
  LEFT JOIN AnswerQuality aq ON uh.Id = aq.OwnerUserId
  LEFT JOIN Badges b ON uh.Id = b.UserId
  LEFT JOIN Votes v ON uh.Id = v.UserId
  GROUP BY uh.Id, uh.DisplayName, uh.Reputation
),
TagAnalysis AS (
  SELECT 
    t.TagName,
    t.Count AS TagUsageCount,
    COUNT(DISTINCT qm.QuestionId) AS RecentQuestions,
    AVG(qm.Score) AS AvgScore,
    AVG(qm.ViewCount) AS AvgViews,
    AVG(qm.AnswerCount) AS AvgAnswers,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY qm.Score) AS MedianScore
  FROM Tags t
  INNER JOIN (
    SELECT p.Id, TRIM(tag) AS tag
    FROM Posts p
    CROSS APPLY (
      SELECT value AS tag
      FROM UNNEST(string_split(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS value
    ) AS split
    WHERE p.PostTypeId = 1 AND p.CreationDate >= DATE(CAST('2024-10-01' AS DATE), '-2 years')
  ) post_tags ON t.TagName = post_tags.tag
  INNER JOIN QuestionMetrics qm ON qm.QuestionId = post_tags.Id
  WHERE t.Count > 100
  GROUP BY t.TagName, t.Count
  HAVING COUNT(DISTINCT qm.QuestionId) > 10
)
SELECT 
  ue.UserId,
  ue.DisplayName,
  ue.Reputation,
  ue.QuestionsAsked,
  ROUND(CAST(ue.AvgQuestionScore AS DECIMAL(18,4)), 2) AS AvgQuestionScore,
  ue.AnswersGiven,
  ROUND(CAST(ue.AvgAnswerScore AS DECIMAL(18,4)), 2) AS AvgAnswerScore,
  ue.AcceptedAnswers,
  ROUND(100.0 * CAST(ue.AcceptedAnswers AS DECIMAL(18,4)) / NULLIF(CAST(ue.AnswersGiven AS DECIMAL(18,4)), 0), 2) AS AcceptanceRate,
  ue.GoldBadges,
  ue.SilverBadges,
  ue.BronzeBadges,
  ue.TotalBadges,
  COALESCE(ue.BountiesStarted, 0) AS BountiesStarted,
  COALESCE(ue.TotalBountyAmount, 0) AS TotalBountyAmount,
  ta.TagName AS MostActiveTag,
  ta.RecentQuestions AS TagQuestions,
  ROUND(CAST(ta.AvgScore AS DECIMAL(18,4)), 2) AS TagAvgScore,
  DENSE_RANK() OVER (ORDER BY ue.Reputation DESC) AS ReputationRank,
  DENSE_RANK() OVER (ORDER BY ue.AnswersGiven DESC) AS AnswersRank,
  DENSE_RANK() OVER (ORDER BY ue.TotalBadges DESC) AS BadgesRank
FROM UserEngagement ue
CROSS JOIN LATERAL (
  SELECT ta.*
  FROM TagAnalysis ta
  ORDER BY ta.RecentQuestions DESC
  FETCH FIRST 1 ROW ONLY
) ta
WHERE ue.QuestionsAsked > 0 OR ue.AnswersGiven > 0
ORDER BY 
  (ue.Reputation * 0.3 + 
   COALESCE(ue.AnswersGiven, 0) * 10 * 0.3 + 
   COALESCE(ue.AcceptedAnswers, 0) * 15 * 0.2 + 
   ue.TotalBadges * 5 * 0.2) DESC
FETCH FIRST 50 ROWS ONLY;