WITH UserActivityMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, 'Unknown') AS Location,
        DATE_PART('year', AGE(CAST('2024-10-01' AS date), u.CreationDate)) AS YearsActive,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COALESCE(AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL), 0) AS AvgPostScore,
        STRING_AGG(b.Name, ', ') FILTER (WHERE b.Class = 1) AS GoldBadges,
        ROW_NUMBER() OVER (
            PARTITION BY SUBSTRING(COALESCE(u.Location, 'Unknown'), 1, 
                CASE WHEN POSITION(',' IN COALESCE(u.Location, 'Unknown')) > 0 
                     THEN POSITION(',' IN COALESCE(u.Location, 'Unknown')) - 1 
                     ELSE LENGTH(COALESCE(u.Location, 'Unknown')) END)
            ORDER BY u.Reputation DESC
        ) AS LocationRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate < CAST('2024-10-01' AS date) - INTERVAL '1 year'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location, u.CreationDate
),
TagExpertise AS (
    SELECT 
        p.OwnerUserId,
        SUBSTRING(tag_element, 1, LENGTH(tag_element)) AS TagName,
        COUNT(*) AS TagPostCount,
        SUM(p.Score) AS TagTotalScore,
        MAX(p.Score) AS TagMaxScore,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) AS TagMedianScore
    FROM Posts p,
         LATERAL unnest(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) AS tag_element
    WHERE p.Tags IS NOT NULL 
        AND p.PostTypeId = 1
        AND p.Score > 0
    GROUP BY p.OwnerUserId, tag_element
),
EditPatterns AS (
    SELECT 
        ph.UserId,
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        LAG(ph.CreationDate) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate) AS PrevEditTime,
        LEAD(ph.PostHistoryTypeId) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate) AS NextHistoryType,
        CASE 
            WHEN ph.Text LIKE '%code%' OR ph.Text LIKE '%```%' THEN 'code_edit'
            WHEN LENGTH(ph.Text) - LENGTH(COALESCE(LAG(ph.Text) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate), '')) > 500 THEN 'major_expansion'
            WHEN LENGTH(ph.Text) - LENGTH(COALESCE(LAG(ph.Text) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate), '')) < -100 THEN 'content_removal'
            ELSE 'minor_edit'
        END AS EditType
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (2, 5, 8)
        AND ph.UserId IS NOT NULL
),
VoteAnalysis AS (
    SELECT 
        v.PostId,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 2) AS UpvoteCount,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 3) AS DownvoteCount,
        COUNT(*) FILTER (WHERE v.VoteTypeId IN (10, 12)) AS NegativeActionCount,
        COALESCE(
            STDDEV(EXTRACT(EPOCH FROM (v.CreationDate - p.CreationDate)) / 3600) 
            FILTER (WHERE v.VoteTypeId = 2),
            0
        ) AS UpvoteTimeStdDev
    FROM Votes v
    INNER JOIN Posts p ON v.PostId = p.Id
    GROUP BY v.PostId
),
LinkedPostNetwork AS (
    SELECT 
        pl.PostId,
        pl.RelatedPostId,
        p1.Score AS PostScore,
        p2.Score AS RelatedScore,
        CASE 
            WHEN p1.Score > 0 AND p2.Score > 0 THEN CAST(p2.Score AS NUMERIC) / NULLIF(p1.Score, 0)
            ELSE NULL 
        END AS ScoreRatio
    FROM PostLinks pl
    INNER JOIN Posts p1 ON pl.PostId = p1.Id
    INNER JOIN Posts p2 ON pl.RelatedPostId = p2.Id
    WHERE pl.LinkTypeId = 3
)
SELECT 
    uam.DisplayName,
    uam.Reputation,
    UPPER(SUBSTRING(uam.Location, 1, 3)) || REPEAT('*', LEAST(LENGTH(uam.Location) - 3, 10)) AS MaskedLocation,
    uam.LocationRank,
    uam.YearsActive,
    uam.QuestionCount + uam.AnswerCount AS TotalPosts,
    ROUND(CAST(uam.AvgPostScore AS NUMERIC), 2) AS AvgPostScore,
    COALESCE(uam.GoldBadges, 'None') AS GoldBadges,
    te.TagName AS TopTag,
    te.TagTotalScore AS TopTagScore,
    ROUND(CAST(te.TagMedianScore AS NUMERIC), 1) AS TopTagMedianScore,
    (SELECT COUNT(DISTINCT ep.PostId) 
     FROM EditPatterns ep 
     WHERE ep.UserId = uam.Id 
        AND ep.EditType = 'major_expansion'
        AND EXISTS (
            SELECT 1 FROM EditPatterns ep2 
            WHERE ep2.PostId = ep.PostId 
                AND ep2.UserId != ep.UserId
                AND ep2.CreationDate BETWEEN ep.CreationDate AND ep.CreationDate + INTERVAL '1 hour'
        )) AS CollaborativeEdits,
    COALESCE((
        SELECT AVG(CAST(va.UpvoteCount AS NUMERIC) / NULLIF(va.DownvoteCount, 0))
        FROM VoteAnalysis va
        INNER JOIN Posts p ON va.PostId = p.Id
        WHERE p.OwnerUserId = uam.Id
            AND va.DownvoteCount > 0
    ), 0) AS AvgUpDownRatio,
    (SELECT COUNT(*) 
     FROM LinkedPostNetwork lpn
     INNER JOIN Posts p ON lpn.PostId = p.Id
     WHERE p.OwnerUserId = uam.Id
        AND lpn.ScoreRatio < 0.5) AS WeakDuplicates,
    CASE 
        WHEN uam.Reputation > 10000 AND uam.YearsActive > 5 THEN 'Veteran Expert'
        WHEN uam.Reputation > 5000 OR uam.QuestionCount + uam.AnswerCount > 100 THEN 'Active Contributor'
        WHEN uam.CommentCount > (uam.QuestionCount + uam.AnswerCount) * 2 THEN 'Commenter'
        WHEN uam.AnswerCount > uam.QuestionCount * 3 THEN 'Answer Specialist'
        WHEN uam.QuestionCount > uam.AnswerCount * 2 THEN 'Question Asker'
        ELSE 'Casual User'
    END AS UserProfile,
    uam.Id
FROM UserActivityMetrics uam
LEFT JOIN LATERAL (
    SELECT te2.OwnerUserId, te2.TagName, te2.TagPostCount, te2.TagTotalScore, te2.TagMaxScore, te2.TagMedianScore
    FROM TagExpertise te2
    WHERE te2.OwnerUserId = uam.Id
    ORDER BY te2.TagTotalScore DESC NULLS LAST
    LIMIT 1
) te ON TRUE
WHERE uam.Reputation > 100
    AND (uam.QuestionCount > 0 OR uam.AnswerCount > 0)
    AND NOT EXISTS (
        SELECT 1 FROM PostHistory ph
        WHERE ph.UserId = uam.Id
            AND ph.PostHistoryTypeId = 12
            AND ph.CreationDate > CAST('2024-10-01' AS date) - INTERVAL '6 months'
    )
ORDER BY 
    CASE WHEN te.TagTotalScore IS NULL THEN 1 ELSE 0 END,
    uam.Reputation * LOG(GREATEST(uam.YearsActive, 1) + 1) * 
        COALESCE(1.0 + (uam.AvgPostScore / NULLIF(ABS(uam.AvgPostScore), 0)) * 0.1, 1) DESC,
    uam.DisplayName ASC
LIMIT 100;