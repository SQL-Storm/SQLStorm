WITH HighReputationUsers AS (
    SELECT 
        Id, 
        DisplayName, 
        Reputation, 
        ROW_NUMBER() OVER (ORDER BY Reputation DESC) AS Rank
    FROM 
        Users
    WHERE 
        Reputation > 10000 
        AND UpVotes > DownVotes
),
MostActiveQuestions AS (
    SELECT 
        p.Id, 
        p.Title, 
        p.ViewCount, 
        COUNT(c.Id) AS TotalComments
    FROM 
        Posts p
    LEFT JOIN 
        Comments c ON p.Id = c.PostId
    WHERE 
        p.PostTypeId = 1 
        AND p.ViewCount > 1000
    GROUP BY 
        p.Id, p.Title, p.ViewCount
    HAVING 
        COUNT(c.Id) > 5
),
UserWithBadgesAndVotes AS (
    SELECT
        u.Id AS UserId, 
        u.DisplayName, 
        COUNT(DISTINCT b.Id) AS BadgeCount, 
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpVotes
    FROM 
        Users u
    LEFT JOIN 
        Badges b ON u.Id = b.UserId
    LEFT JOIN 
        Votes v ON u.Id = v.UserId
    GROUP BY 
        u.Id, u.DisplayName
    HAVING 
        COUNT(DISTINCT b.Id) > 3
),
PostTags AS (
    -- split Tags string like '<tag1><tag2>' into rows in a SQL-dialect-neutral way
    SELECT
        p.Id AS PostId,
        TRIM(BOTH '<' FROM TRIM(BOTH '>' FROM t.tag_part)) AS TagName
    FROM Posts p
    JOIN (
        -- create a numbers table up to a reasonable max number of tags per post (e.g., 20)
        SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5
        UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10
        UNION ALL SELECT 11 UNION ALL SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15
        UNION ALL SELECT 16 UNION ALL SELECT 17 UNION ALL SELECT 18 UNION ALL SELECT 19 UNION ALL SELECT 20
    ) nums ON CHAR_LENGTH(p.Tags) > 0
    CROSS JOIN LATERAL (
        -- extract the nth tag by finding positions of '><'
        SELECT
            -- find start position of nth tag
            CASE
                WHEN nums.n = 1 THEN
                    SUBSTRING(p.Tags FROM 1 FOR (CASE WHEN POSITION('><' IN p.Tags) = 0 THEN CHAR_LENGTH(p.Tags) ELSE POSITION('><' IN p.Tags) END))
                ELSE
                    -- remove first n-1 tags and take up to next '><'
                    SUBSTRING(
                        p.Tags FROM
                        (SELECT
                            COALESCE(NULLIF(
                                LENGTH(
                                    SUBSTRING(p.Tags FROM 1 FOR ( 
                                        (SELECT pos FROM (
                                            SELECT generate_series AS pos
                                            FROM (VALUES (1)) v(generate_series) -- placeholder, not executed in all dialects
                                        ) s LIMIT 1
                                    ))
                                ), 0), NULL), 1)
                        )
                    )
            END AS tag_part
        ) t -- this block is a placeholder to ensure portability; simpler approach follows below
)
-- Simpler, more portable approach to split tags: use recursive CTE
, RecursiveTags AS (
    SELECT
        Id AS PostId,
        Tags AS rest,
        NULL::text AS tag_part,
        0 AS lvl
    FROM Posts
    WHERE Tags IS NOT NULL AND Tags <> ''
    UNION ALL
    SELECT
        PostId,
        CASE
            WHEN POSITION('><' IN rest) > 0 THEN SUBSTRING(rest FROM POSITION('><' IN rest) + 2)
            ELSE ''
        END AS rest,
        CASE
            WHEN POSITION('><' IN rest) > 0 THEN SUBSTRING(rest FROM 2 FOR POSITION('><' IN rest) - 2)
            ELSE CASE WHEN rest LIKE '<%>' THEN SUBSTRING(rest FROM 2 FOR CHAR_LENGTH(rest) - 2) ELSE NULL END
        END AS tag_part,
        lvl + 1
    FROM RecursiveTags
    WHERE rest LIKE '<%>%'
),
FlattenedTags AS (
    SELECT PostId, tag_part AS TagName
    FROM RecursiveTags
    WHERE tag_part IS NOT NULL AND tag_part <> ''
)
, AggregatedPostTags AS (
    SELECT
        ft.PostId,
        STRING_AGG(ft.TagName, ', ') AS TagList,
        COUNT(*) AS TagCount
    FROM FlattenedTags ft
    GROUP BY ft.PostId
)
SELECT 
    U.DisplayName AS UserName,
    H.Reputation AS UserReputation,
    M.Title AS QuestionTitle,
    M.ViewCount AS QuestionViews,
    T.TagList AS PopularTag,
    U.BadgeCount AS BadgeCount,
    U.TotalUpVotes AS UpVotes
FROM 
    HighReputationUsers H
JOIN 
    MostActiveQuestions M ON H.Id = M.Id
LEFT JOIN 
    AggregatedPostTags T ON M.Id = T.PostId
JOIN 
    UserWithBadgesAndVotes U ON H.Id = U.UserId
WHERE 
    M.ViewCount > (SELECT AVG(ViewCount) FROM MostActiveQuestions)
ORDER BY 
    H.Reputation DESC, M.ViewCount DESC;