SELECT
  p.Id AS PostId,
  p.Title,
  p.PostTypeId,
  p.CreationDate,
  p.ViewCount,
  p.Score,
  p.CommentCount,
  p.OwnerUserId,
  u.DisplayName AS OwnerDisplayName,
  COUNT(DISTINCT v.Id) AS TotalVotes,
  SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
  SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
  COUNT(DISTINCT c.Id) AS CommentCountTotal,
  MAX(p.LastActivityDate) AS LastActivity,
  -- aggregate of tag names for posts (only valid for questions)
  STRING_AGG(DISTINCT t.Name, ',' ORDER BY t.Name) FILTER (WHERE pt.Id = 1) AS TagsUsed,
  SUM(CASE WHEN (SELECT COUNT(*) FROM Votes v2 WHERE v2.PostId = p.Id AND v2.VoteTypeId = 16) > 0 THEN 1 ELSE 0 END) AS ModeratorVotes,
  (SELECT COUNT(*) FROM Posts AS q WHERE q.ParentId = p.Id AND q.PostTypeId = 2) AS AnswerCount
FROM Posts p
LEFT JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Votes v ON v.PostId = p.Id
LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
LEFT JOIN LATERAL (
  -- normalize XML-like tag string '<tag1><tag2>' into rows of tag ids if present
  SELECT NULLIF(trim(both '<>' FROM part), '')::text AS raw_tag
  FROM (
    SELECT regexp_split_to_table(p.Tags, '><') AS part
  ) s
) tagparts ON p.PostTypeId = 1 AND p.Tags IS NOT NULL AND p.Tags <> ''
LEFT JOIN Tags t ON t.Name = tagparts.raw_tag
LEFT JOIN Comments c ON c.PostId = p.Id
WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 days'
  AND p.PostTypeId IN (1, 2)
GROUP BY
  p.Id,
  p.Title,
  p.PostTypeId,
  p.CreationDate,
  p.ViewCount,
  p.Score,
  p.CommentCount,
  p.OwnerUserId,
  u.DisplayName,
  p.LastActivityDate
HAVING COUNT(DISTINCT v.Id) > 0
ORDER BY
  p.Score DESC,
  LastActivity DESC
LIMIT 100;