WITH
RecentPosts AS (
    SELECT
        p.Id,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.CreationDate,
        ROW_NUMBER() OVER (
            PARTITION BY p.OwnerUserId
            ORDER BY p.CreationDate DESC
        ) AS rn
    FROM Posts p
    WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30 days'
),
TopContributors AS (
    SELECT
        u.Id            AS UserId,
        u.DisplayName,
        SUM(CASE WHEN rp.PostTypeId = 1 THEN 1 ELSE 0 END) AS RecentQuestions,
        SUM(CASE WHEN rp.PostTypeId = 2 THEN 1 ELSE 0 END) AS RecentAnswers,
        COUNT(rp.Id)    AS RecentPostsCount,
        RANK() OVER (ORDER BY COUNT(rp.Id) DESC) AS RecentRank
    FROM Users u
    LEFT JOIN RecentPosts rp
        ON u.Id = rp.OwnerUserId
    GROUP BY u.Id, u.DisplayName
),
BadgeCounts AS (
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
),
TagExploder AS (
    SELECT
        p.Id    AS PostId,
        tag     AS Tag
    FROM Posts p,
    LATERAL (
        SELECT unnest(
            string_to_array(
                substring(p.Tags, 2, length(p.Tags) - 2),
                '><'
            )
        ) AS tag
    ) t
    WHERE p.Tags IS NOT NULL
),
PopularTags AS (
    SELECT TagName
    FROM Tags
    WHERE Count > 1000
),
ExcludedTags AS (
    SELECT TagName
    FROM Tags
    WHERE Count < 10
),
FilteredTags AS (
    SELECT TagName AS Tag
    FROM PopularTags
    EXCEPT
    SELECT TagName
    FROM ExcludedTags
),
TagUsage AS (
    SELECT
        ft.Tag,
        COUNT(te.PostId) AS UsageCount
    FROM FilteredTags ft
    LEFT JOIN TagExploder te
        ON te.Tag = ft.Tag
    GROUP BY ft.Tag
),
UserActivity AS (
    SELECT
        tc.UserId,
        tc.DisplayName,
        COALESCE(bc.GoldBadges, 0)   AS GoldBadges,
        COALESCE(bc.SilverBadges, 0) AS SilverBadges,
        COALESCE(bc.BronzeBadges, 0) AS BronzeBadges,
        (COALESCE(bc.GoldBadges,0)+COALESCE(bc.SilverBadges,0)+COALESCE(bc.BronzeBadges,0)) AS TotalBadges,
        COALESCE(u.Reputation, 0)    AS Reputation,
        tc.RecentQuestions,
        tc.RecentAnswers,
        tc.RecentPostsCount,
        tc.RecentRank,
        CASE
            WHEN u.LastAccessDate < CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '90 days' THEN 'Inactive'
            ELSE 'Active'
        END AS ActivityStatus
    FROM TopContributors tc
    LEFT JOIN BadgeCounts bc
        ON tc.UserId = bc.UserId
    JOIN Users u
        ON tc.UserId = u.Id
),
QuestionStats AS (
    SELECT
        q.Id               AS QuestionId,
        q.OwnerUserId      AS AuthorId,
        q.Title,
        q.Tags,
        (SELECT COUNT(1)
         FROM Posts a
         WHERE a.ParentId = q.Id AND a.PostTypeId = 2
        )                   AS AnswerCount,
        (SELECT AVG(v.Score)
         FROM Votes v
         WHERE v.PostId = q.Id AND v.VoteTypeId = 2
        )                   AS AvgUpvoteScore,
        COUNT(CASE WHEN c.Score > 0 THEN 1 END)  AS PosComments,
        COUNT(CASE WHEN c.Score <= 0 THEN 1 END) AS NonPosComments,
        MIN(ph.CreationDate) OVER (PARTITION BY q.Id) AS FirstEditDate
    FROM Posts q
    LEFT JOIN Comments c
        ON c.PostId = q.Id
    LEFT JOIN PostHistory ph
        ON ph.PostId = q.Id
       AND ph.PostHistoryTypeId IN (4,5,6)
    WHERE q.PostTypeId = 1
      AND q.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '90 days'
    GROUP BY q.Id, q.OwnerUserId, q.Title, q.Tags
),
FinalResult AS (
    SELECT
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.TotalBadges,
        ua.GoldBadges,
        ua.SilverBadges,
        ua.BronzeBadges,
        ua.RecentQuestions,
        ua.RecentAnswers,
        ua.RecentPostsCount,
        ua.RecentRank,
        ua.ActivityStatus,
        qs.QuestionId,
        qs.Title,
        qs.Tags,
        qs.AnswerCount,
        qs.AvgUpvoteScore,
        qs.PosComments,
        qs.NonPosComments,
        qs.FirstEditDate,
        row_number() OVER (
            PARTITION BY ua.UserId
            ORDER BY qs.AvgUpvoteScore DESC NULLS LAST
        ) AS QRankByAvgUpvotes
    FROM UserActivity ua
    JOIN QuestionStats qs
        ON qs.AuthorId = ua.UserId
)
SELECT
    fr.UserId,
    fr.DisplayName,
    fr.Reputation,
    fr.TotalBadges,
    fr.RecentPostsCount,
    fr.QRankByAvgUpvotes,
    fr.Title           AS TopQuestionTitle,
    fr.AnswerCount,
    fr.AvgUpvoteScore,
    fr.PosComments,
    fr.NonPosComments,
    fr.FirstEditDate,
    ft.Tag,
    tu.UsageCount
FROM FinalResult fr
LEFT JOIN FilteredTags ft
    ON ft.Tag = ANY(string_to_array(substring(fr.Tags,2,length(fr.Tags)-2),'><'))
LEFT JOIN TagUsage tu
    ON tu.Tag = ft.Tag
WHERE (fr.QRankByAvgUpvotes <= 3 AND fr.ActivityStatus = 'Active')
   OR fr.ActivityStatus = 'Inactive'

UNION ALL

SELECT
    CAST(NULL AS INTEGER)            AS UserId,
    '--SYSTEM--'      AS DisplayName,
    CAST(NULL AS INTEGER)       AS Reputation,
    CAST(NULL AS INTEGER)       AS TotalBadges,
    CAST(NULL AS INTEGER)       AS RecentPostsCount,
    CAST(NULL AS INTEGER)       AS QRankByAvgUpvotes,
    'Popular Tag'   AS TopQuestionTitle,
    CAST(NULL AS INTEGER)       AS AnswerCount,
    CAST(NULL AS NUMERIC)   AS AvgUpvoteScore,
    CAST(NULL AS INTEGER)       AS PosComments,
    CAST(NULL AS INTEGER)       AS NonPosComments,
    CAST(NULL AS TIMESTAMP) AS FirstEditDate,
    pt.TagName      AS Tag,
    tu.UsageCount
FROM PopularTags pt
JOIN TagUsage tu
    ON tu.Tag = pt.TagName
INTERSECT
SELECT
    CAST(NULL AS INTEGER),
    '--SYSTEM--',
    CAST(NULL AS INTEGER),
    CAST(NULL AS INTEGER),
    CAST(NULL AS INTEGER),
    CAST(NULL AS INTEGER),
    'Overlooked Tag',
    CAST(NULL AS INTEGER),
    CAST(NULL AS NUMERIC),
    CAST(NULL AS INTEGER),
    CAST(NULL AS INTEGER),
    CAST(NULL AS TIMESTAMP),
    ex.TagName,
    0
FROM ExcludedTags ex

ORDER BY
    RecentPostsCount DESC NULLS LAST,
    AvgUpvoteScore   DESC NULLS LAST,
    UsageCount       DESC NULLS LAST
LIMIT 100;