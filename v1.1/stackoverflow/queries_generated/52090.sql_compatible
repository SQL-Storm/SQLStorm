SELECT 
    t.tag_name,
    u.DisplayName,
    u.Location,
    u.Reputation,
    SUM(p.Score) AS total_score,
    COUNT(*) AS post_count,
    AVG(p.Score) AS avg_score,
    RANK() OVER (PARTITION BY t.tag_name ORDER BY SUM(p.Score) DESC) AS rank_within_tag
FROM 
    Posts p
JOIN 
    Users u ON p.OwnerUserId = u.Id,
    -- split tags like '<tag1><tag2>' into rows; compatible standard SQL using regexp or string functions varies by dialect.
    -- Here using a generic approach with a derived table using a recursive CTE is one portable option.
    LATERAL (
        SELECT tag AS tag_name
        FROM (
            SELECT
                TRIM(regexp_split_to_table(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), '><')) AS tag
        ) s
    ) t
WHERE 
    p.PostTypeId = 2  -- Answers
    AND p.CreationDate >= CAST('2023-01-01' AS timestamp)
    AND p.CreationDate < CAST('2024-01-01' AS timestamp)
    AND p.Score > 0
    AND u.Reputation > 100
GROUP BY 
    t.tag_name, u.Id, u.DisplayName, u.Location, u.Reputation
HAVING 
    COUNT(*) >= 5
    AND SUM(p.Score) >= 100
ORDER BY 
    t.tag_name, rank_within_tag
LIMIT 10000;