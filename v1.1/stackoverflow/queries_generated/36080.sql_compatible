SELECT
  p.Id AS PostId,
  p.Title,
  p.PostTypeId,
  p.CreationDate,
  p.Score,
  p.ViewCount,
  p.OwnerUserId,
  u.DisplayName AS OwnerDisplayName,
  p.LastActivityDate,
  p.Tags,
  pc.CommentCount,
  COALESCE(vs.UpVotes, 0) AS UpVotes,
  COALESCE(vs.DownVotes, 0) AS DownVotes,
  COALESCE(a.AnswerCount, 0) AS AnswerCount,
  s.TotalScore AS RollingScore
FROM Posts p
JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN (
  SELECT PostId, SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
                 SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
  FROM Votes
  GROUP BY PostId
) vs ON p.Id = vs.PostId
LEFT JOIN LATERAL (
  SELECT COUNT(*) AS AnswerCount
  FROM Posts subp
  WHERE subp.ParentId = p.Id AND subp.PostTypeId = 2
) a ON true
LEFT JOIN (
  SELECT PostId, SUM(Score) AS TotalScore
  FROM Votes
  WHERE VoteTypeId IN (2, 3)
  GROUP BY PostId
) s ON p.Id = s.PostId
LEFT JOIN (
  SELECT PostId, COUNT(*) AS CommentCount
  FROM Comments
  GROUP BY PostId
) pc ON p.Id = pc.PostId
WHERE
  p.PostTypeId IN (1, 2)
  AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 days'
ORDER BY s.TotalScore DESC NULLS LAST, p.ViewCount DESC
LIMIT 100;