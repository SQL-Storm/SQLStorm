with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        b.Name as BadgeName,
        b.Class as BadgeClass,
        b.TagBased,
        row_number() over (partition by u.Id order by b.Date desc, b.Name) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    where u.Reputation > 1000
), LatestPostEdits as (
    select
        ph.PostId,
        ph.UserId as EditorUserId,
        ph.UserDisplayName as EditorName,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        row_number() over (partition by ph.PostId order by ph.CreationDate desc) as rn
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6)
), RankedPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        p.AnswerCount,
        p.ClosedDate,
        coalesce(lp.EditorUserId, -1) as LastEditorUserId,
        coalesce(lp.EditorName, '') as LastEditorName,
        p.FavoriteCount,
        dense_rank() over (partition by p.PostTypeId order by p.Score desc) as ScoreRank
    from Posts p
    left join LatestPostEdits lp on p.Id = lp.PostId and lp.rn = 1
    where p.PostTypeId in (1, 2)
), TopScoringQuestions as (
    select
        Id,
        Title,
        OwnerUserId,
        Score,
        ViewCount,
        Tags,
        AnswerCount,
        FavoriteCount,
        ClosedDate
    from RankedPosts
    where PostTypeId = 1 and ScoreRank <= 100
), AnswerStats as (
    select
        p.ParentId as QuestionId,
        count(*) as TotalAnswers,
        max(p.Score) as MaxAnswerScore,
        avg(p.Score) as AvgAnswerScore,
        sum(case when p.OwnerUserId is null then 0 else 1 end) as AnswersWithOwners
    from Posts p
    where p.PostTypeId = 2
    group by p.ParentId
), DuplicateLinks as (
    select
        pl.PostId,
        array_agg(pl.RelatedPostId) as DuplicateOfIds
    from PostLinks pl
    where pl.LinkTypeId = 3
    group by pl.PostId
), UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        v.PostId,
        v.CreationDate,
        count(*) over (partition by u.Id order by v.CreationDate rows between 30 preceding and current row) as CountVotes,
        sum(coalesce(v.BountyAmount,0)) over (partition by u.Id order by v.CreationDate rows between 90 preceding and current row) as SumBounty
    from Users u
    join Votes v on u.Id = v.UserId
    where v.CreationDate >= cast('2024-10-01' as date) - interval '1 year'
), ComplexUserStats as (
    select
        u.Id,
        u.DisplayName,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as NumQuestions,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as NumAnswers,
        coalesce(sum(p.Score),0) as TotalPostScore,
        max(p.Score) as MaxPostScore,
        count(distinct b.Id) as BadgeCount,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        count(distinct case when ph.PostHistoryTypeId in (10,12,35) then ph.Id end) as SignificantHistoryEvents,
        max(p.CreationDate) as LastPostDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Badges b on b.UserId = u.Id
    left join PostHistory ph on ph.UserId = u.Id
    group by u.Id, u.DisplayName
)
select
    q.Id as QuestionId,
    q.Title as QuestionTitle,
    u.DisplayName as QuestionOwner,
    q.Score as QuestionScore,
    q.ViewCount as QuestionViews,
    q.AnswerCount as AnswerCount,
    ds.TotalAnswers,
    ds.MaxAnswerScore,
    ds.AvgAnswerScore,
    ds.AnswersWithOwners,
    coalesce(dl.DuplicateOfIds, array[]::integer[]) as DuplicatePosts,
    cu.NumQuestions,
    cu.NumAnswers,
    cu.TotalPostScore,
    cu.GoldBadges,
    cu.SilverBadges,
    cu.BronzeBadges,
    cu.SignificantHistoryEvents,
    cu.LastPostDate,
    case when q.ClosedDate is not null then 'Closed' else 'Open' end as QuestionStatus,
    substr(coalesce(q.Tags, ''), 1, 100) as TagsPreview,
    length(coalesce(q.Title,'')) as TitleLength,
    case when q.FavoriteCount > 5 and q.Score > 10 then true else false end as IsPopular,
    regexp_replace(q.Title, '[^A-Za-z0-9 ]', '', 'g') as CleanTitle
from TopScoringQuestions q
left join Users u on u.Id = q.OwnerUserId
left join AnswerStats ds on ds.QuestionId = q.Id
left join DuplicateLinks dl on dl.PostId = q.Id
left join ComplexUserStats cu on cu.Id = q.OwnerUserId
where 
    (q.Score > 50 or q.FavoriteCount > 10) 
    and (q.ViewCount > (select avg(ViewCount) from Posts where PostTypeId = 1))
    and exists (
        select 1 from Votes v
        where v.PostId = q.Id 
        and v.VoteTypeId = 2
        and v.CreationDate > cast('2024-10-01' as date) - interval '6 months'
    )
union
select
    a.Id,
    coalesce(p.Title, '(No title, answer)'),
    u.DisplayName,
    a.Score,
    a.ViewCount,
    0,
    null,
    null,
    null,
    null,
    0,
    0,
    0,
    0,
    0,
    0,
    null,
    'Answer',
    '',
    0,
    false,
    ''
from RankedPosts a
left join Posts p on p.Id = a.Id_parent -- corrected below with proper reference
left join Posts p2 on p2.Id = a.ParentId
left join Users u on u.Id = a.OwnerUserId
where a.PostTypeId = 2 and a.Score > 100
order by QuestionScore desc, QuestionId asc
limit 200;