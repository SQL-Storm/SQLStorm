WITH question_posts AS (
    SELECT Id, Tags, Score, OwnerUserId
    FROM Posts
    WHERE PostTypeId = 1
),
exploded_tags AS (
    -- split tags like '<tag1><tag2>' into rows using standard SQL methods
    SELECT qp.Id AS question_id,
           qp.OwnerUserId,
           trim(t.tag) AS tag,
           qp.Score
    FROM question_posts qp,
    LATERAL (
      SELECT value AS tag
      FROM (
        -- replace angle brackets with a delimiter and split on that delimiter
        SELECT regexp_split(value, '><') AS parts
        FROM (
          SELECT replace(substring(qp.Tags FROM 2 FOR char_length(qp.Tags)-2), '><', '><') AS value
        ) s1
      ) s2,
      LATERAL (SELECT parts[i] AS value FROM (SELECT parts) p, (SELECT generate_series(1, array_length(parts,1)) AS i) g) t_raw,
      LATERAL (SELECT t_raw.value) t
    )
),
answer_stats AS (
    SELECT ParentId AS qid,
           COUNT(*)  AS answer_cnt,
           AVG(Score) AS avg_ans_score
    FROM Posts
    WHERE PostTypeId = 2
    GROUP BY ParentId
),
comment_stats AS (
    SELECT PostId AS qid,
           COUNT(*) AS comment_cnt
    FROM Comments
    GROUP BY PostId
),
vote_stats AS (
    SELECT PostId,
           SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS upvotes,
           COUNT(*) AS total_votes
    FROM Votes
    GROUP BY PostId
)
SELECT
    et.tag,
    COUNT(DISTINCT et.question_id)      AS question_count,
    SUM(answer_stats.answer_cnt)        AS total_answers,
    AVG(answer_stats.avg_ans_score)     AS avg_answer_score,
    SUM(comment_stats.comment_cnt)      AS total_comments,
    AVG(comment_stats.comment_cnt)      AS avg_comments_per_question,
    AVG(u.Reputation)                   AS avg_user_rep,
    MAX(u.Reputation)                   AS max_user_rep,
    MIN(u.Reputation)                   AS min_user_rep,
    ROUND(100.0 * SUM(vote_stats.upvotes) / NULLIF(SUM(vote_stats.total_votes),0), 2) AS upvote_pct
FROM exploded_tags AS et
JOIN answer_stats  ON answer_stats.qid = et.question_id
JOIN comment_stats ON comment_stats.qid = et.question_id
JOIN vote_stats    ON vote_stats.PostId = et.question_id
JOIN Users         AS u  ON u.Id = et.OwnerUserId
GROUP BY et.tag, u.Reputation
ORDER BY question_count DESC
LIMIT 20;