WITH RECURSIVE RecursiveUserTree AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate AS UserCreationDate,
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        COALESCE(p.AcceptedAnswerId, 0) AS AcceptedAnswerId,
        p.OwnerUserId,
        COALESCE(p.LastEditorUserId, 0) AS LastEditorUserId,
        COALESCE(pv.BountyAmount, 0) AS BountyAmount,
        COALESCE(pv.VoteTypeId, 0) AS VoteTypeId,
        COALESCE(v.UserId, 0) AS VoterUserId,
        EXTRACT(YEAR FROM p.CreationDate) AS Year,
        EXTRACT(MONTH FROM p.CreationDate) AS Month
    FROM
        Users u
    JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN LATERAL
    (
        SELECT v2.VoteTypeId, v2.Id, v2.BountyAmount FROM Votes v2 WHERE v2.PostId = p.Id LIMIT 1
    ) pv ON TRUE
    WHERE
        u.Reputation > 1000
        AND p.PostTypeId IN (1, 2)
        AND p.CreationDate > DATE '2022-01-01'

    UNION ALL

    SELECT
        u.Id,
        u.Reputation,
        u.DisplayName,
        u.CreationDate,
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        COALESCE(p.AcceptedAnswerId, 0),
        p.OwnerUserId,
        COALESCE(p.LastEditorUserId, 0),
        COALESCE(pv.BountyAmount, 0),
        COALESCE(pv.VoteTypeId, 0),
        COALESCE(v.UserId, 0) AS VoterUserId,
        EXTRACT(YEAR FROM p.CreationDate),
        EXTRACT(MONTH FROM p.CreationDate)
    FROM
        Users u
    JOIN
        Posts p ON u.Id = p.OwnerUserId
    JOIN
        RecursiveUserTree rut ON rut.UserId = p.OwnerUserId
    JOIN
        Votes v ON p.Id = v.PostId
    JOIN LATERAL
    (
        SELECT v2.VoteTypeId, v2.Id, v2.BountyAmount FROM Votes v2 WHERE v2.PostId = p.Id LIMIT 1
    ) pv ON TRUE
), TopUsers AS (
    SELECT
        UserId,
        DisplayName,
        COUNT(PostId) AS TotalPosts,
        SUM(PostScore) AS TotalScore,
        AVG(PostScore) AS AverageScore,
        SUM(ViewCount) AS TotalViews,
        AVG(ViewCount) AS AverageViews,
        SUM(AnswerCount) AS TotalAnswers,
        AVG(AnswerCount) AS AverageAnswers,
        SUM(CommentCount) AS TotalComments,
        AVG(CommentCount) AS AverageComments,
        SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotes,
        SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownvotes,
        SUM(BountyAmount) AS TotalBountyAmount
    FROM
        RecursiveUserTree
    GROUP BY
        UserId,
        DisplayName
    ORDER BY
        TotalScore DESC
    LIMIT 50
), TopPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        u.DisplayName AS OwnerDisplayName,
        p.LastEditorUserId,
        COALESCE(e.DisplayName, 'Unknown') AS LastEditorDisplayName,
        p.LastEditDate,
        p.AnswerCount,
        p.CommentCount,
        p.AcceptedAnswerId,
        COALESCE(a.Title, 'No Accepted Answer') AS AcceptedAnswerTitle,
        COALESCE(CASE WHEN accepthist.UserId IS NULL THEN 0 ELSE accepthist.UserId END, 0) AS AcceptedAnswerUserId,
        COALESCE(accepthist.UserDisplayName, 'Unknown') AS AcceptedAnswerDisplayName,
        COALESCE(accepthist.CreationDate, p.CreationDate) AS acceptedAnswerDate,
        COALESCE(accepthist.Comment, 'Not folded into the question') AS acceptedAnswerComment,
        pv.VoteTypeId,
        STRING_AGG(DISTINCT t.TagName, '|||') AS condensedTags
    FROM
        Posts p
    LEFT JOIN
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN Users e ON p.LastEditorUserId = e.Id
    LEFT JOIN
        -- corrected join: look for posthistory row for the accepted answer id (if any)
        PostHistory accepthist ON a.Id = accepthist.PostId
    LEFT JOIN
        PostHistory ph ON ph.PostId = p.Id AND ph.UserId = p.OwnerUserId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    LEFT JOIN LATERAL
    (
        SELECT v2.VoteTypeId, v2.Id, v2.BountyAmount FROM Votes v2 WHERE v2.PostId = p.Id LIMIT 1
    ) pv ON TRUE
    LEFT JOIN
        Posts a ON p.AcceptedAnswerId = a.Id
    LEFT JOIN LATERAL
    (
        SELECT t2.TagName, t2.Id FROM Tags t2 WHERE (POSITION('<' IN p.Tags) - 1) / 3 = t2.Id
    ) t ON TRUE
    WHERE
        p.PostTypeId IN (1,2)
    GROUP BY
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        u.DisplayName,
        p.LastEditorUserId,
        e.DisplayName,
        p.LastEditDate,
        p.AnswerCount,
        p.CommentCount,
        p.AcceptedAnswerId,
        a.Title,
        accepthist.UserId,
        accepthist.UserDisplayName,
        accepthist.CreationDate,
        accepthist.Comment,
        a.Id,
        pv.VoteTypeId
), MonthlyMetrics AS (
    SELECT
        Year,
        Month,
        COUNT(PostId) AS PostsCount,
        COUNT(DISTINCT p.OwnerUserId) AS ActiveUsers,
        AVG(p.Score) AS AveragePostScore,
        SUM(p.Score) AS TotalPostScore,
        SUM(p.ViewCount) AS TotalViews,
        AVG(p.ViewCount) AS AverageViews,
        SUM(p.AnswerCount) AS TotalAnswers,
        AVG(p.AnswerCount) AS AverageAnswers,
        SUM(p.CommentCount) AS TotalComments,
        AVG(p.CommentCount) AS AverageComments,
        SUM(COALESCE(pv.VoteTypeId,0)) AS TotalVotes,
        SUM(COALESCE(pv.BountyAmount,0)) AS totalPostBountyAmount,
        SUM(CASE WHEN COALESCE(pv.BountyAmount,0) > 0 THEN COALESCE(ph.UserId,0) ELSE 0 END) AS totalCommentBountyAmount
    FROM
        RecursiveUserTree p
    LEFT JOIN LATERAL
    (
        SELECT p2.VoteTypeId, p2.Id, p2.BountyAmount FROM Votes p2 WHERE p2.PostId = p.PostId LIMIT 1
    ) pv ON TRUE
    LEFT JOIN LATERAL
    (
       SELECT ph2.UserId, ph2.CreationDate, ph2.Comment FROM PostHistory ph2 WHERE ph2.PostId = p.PostId LIMIT 1
    ) ph ON TRUE
    GROUP BY
        Year,
        Month
    ORDER BY
        Year DESC,
        Month DESC
)
SELECT
    t1.UserId,
    t1.DisplayName,
    t1.TotalPosts,
    t1.TotalScore,
    t1.AverageScore,
    t1.TotalViews,
    t1.AverageViews,
    t1.TotalAnswers,
    t1.AverageAnswers,
    t1.TotalComments,
    t1.AverageComments,
    t1.TotalUpvotes,
    t1.TotalDownvotes,
    t1.TotalBountyAmount,
    t3.Year,
    t3.Month,
    t3.totalPostBountyAmount
FROM
    TopUsers t1
JOIN
    TopPosts t2 ON t1.UserId = t2.OwnerUserId
LEFT JOIN
    (SELECT Year, Month, totalPostBountyAmount FROM MonthlyMetrics GROUP BY Year, Month, totalPostBountyAmount) t3
    ON EXTRACT(MONTH FROM t2.CreationDate) = t3.Month AND EXTRACT(YEAR FROM t2.CreationDate) = t3.Year;