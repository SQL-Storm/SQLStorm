-- {"query": "5080.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1094} 
WITH RecentUsers AS (
  SELECT
    Id AS UserId,
    DisplayName,
    Reputation,
    CreationDate,
    ROW_NUMBER() OVER (ORDER BY CreationDate DESC) AS RecentRank
  FROM Users
  WHERE Reputation > (
    SELECT AVG(Reputation) FROM Users WHERE CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
  )
),
ActivePosts AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.PostTypeId,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.Title,
    p.Tags,
    string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><') AS TagArray,
    COUNT(DISTINCT a.Id) AS NumAnswers,
    MAX(co.CreationDate) AS LastCommentDate
  FROM Posts p
  LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
  LEFT JOIN Comments co ON co.PostId = p.Id
  WHERE p.PostTypeId = 1
    AND p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
    AND (p.ViewCount > 100 OR p.Score > 5)
  GROUP BY p.Id, p.OwnerUserId, p.PostTypeId, p.Score, p.ViewCount, p.CreationDate, p.Title, p.Tags
),
TopBadges AS (
  SELECT
    b.UserId,
    COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
    COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
    COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges,
    MAX(b.Date) AS LastBadgeDate
  FROM Badges b
  GROUP BY b.UserId
),
UserActivityStats AS (
  SELECT
    u.Id AS UserId,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsAsked,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersGiven,
    COALESCE(SUM(p.Score), 0) AS TotalScore,
    AVG(p.Score) FILTER (WHERE p.PostTypeId IN (1,2)) AS AvgQnA_Score,
    MAX(p.CreationDate) AS LastPostDate
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  GROUP BY u.Id
)
SELECT
  ru.UserId,
  ru.DisplayName,
  ru.Reputation,
  ru.CreationDate,
  ru.RecentRank,
  uas.QuestionsAsked,
  uas.AnswersGiven,
  uas.TotalScore,
  uas.AvgQnA_Score,
  tb.GoldBadges,
  tb.SilverBadges,
  tb.BronzeBadges,
  tb.LastBadgeDate,
  COUNT(DISTINCT ap.PostId) AS RecentActiveQuestions,
  SUM(ap.NumAnswers) AS AnswersToTheirRecentQuestions,
  STRING_AGG(DISTINCT unnest(ap.TagArray), ',' ORDER BY unnest(ap.TagArray)) AS DistinctTagsOnRecentQuestions,
  MAX(ap.LastCommentDate) AS LastQuestionCommentDate,
  CASE 
    WHEN tb.GoldBadges > 5 OR uas.TotalScore > 1000 THEN 'High Achiever'
    WHEN uas.AvgQnA_Score IS NULL THEN 'Inactive'
    ELSE 'Active'
  END AS Status
FROM RecentUsers ru
LEFT JOIN UserActivityStats uas ON uas.UserId = ru.UserId
LEFT JOIN TopBadges tb ON tb.UserId = ru.UserId
LEFT JOIN ActivePosts ap ON ap.OwnerUserId = ru.UserId
-- Outer join with their questions closed for a duplicate reason in last 3 months
LEFT JOIN LATERAL (
    SELECT DISTINCT ph.PostId
    FROM PostHistory ph
    WHERE ph.UserId = ru.UserId
      AND ph.PostHistoryTypeId = 10
      AND (
          ph.Comment::int = 1   -- 1 = Exact Duplicate (old)
          OR ph.Comment::int = 101  -- 101 = Duplicate (current)
      )
      AND ph.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
) dup_closed ON TRUE
WHERE ru.RecentRank <= 100
  AND (COALESCE(tb.GoldBadges,0) + COALESCE(tb.SilverBadges,0) + COALESCE(tb.BronzeBadges,0)) > 0
GROUP BY
  ru.UserId, ru.DisplayName, ru.Reputation, ru.CreationDate, ru.RecentRank,
  uas.QuestionsAsked, uas.AnswersGiven, uas.TotalScore, uas.AvgQnA_Score, uas.LastPostDate,
  tb.GoldBadges, tb.SilverBadges, tb.BronzeBadges, tb.LastBadgeDate
HAVING COUNT(dup_closed.PostId) < 3
ORDER BY
  Status DESC,
  COALESCE(tb.GoldBadges,0) DESC,
  COALESCE(uas.TotalScore,0) DESC,
  ru.RecentRank ASC
LIMIT 50;