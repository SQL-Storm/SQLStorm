WITH UserBadgeStats AS (
    SELECT 
        u.Id AS UserId,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        COALESCE(STRING_AGG(DISTINCT b.Name, ', ' ORDER BY b.Name), 'None') AS BadgeNames
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id
), PostActivity AS (
    SELECT 
        p.OwnerUserId,
        p.PostTypeId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT c.Id) AS TotalComments,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) AS AvgScore,
        RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    WHERE p.CreationDate BETWEEN DATE '2010-01-01' AND DATE '2023-12-31'
    GROUP BY p.OwnerUserId, p.PostTypeId
), TagExplosion AS (
    SELECT 
        p.Id AS PostId,
        TRIM(t) AS Tag,
        p.OwnerUserId
    FROM Posts p
    CROSS JOIN LATERAL (
        SELECT TRIM(x) AS t
        FROM UNNEST(STRING_TO_ARRAY(REPLACE(REPLACE(p.Tags, '<', ''), '>', ','), ',')) AS x
    ) AS exploded
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
)
SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    COALESCE(ubs.TotalBadges, 0) AS TotalBadges,
    pa.TotalPosts,
    te.Tag AS MostActiveTag,
    (SELECT MAX(p2.CreationDate) FROM Posts p2 WHERE p2.OwnerUserId = u.Id) AS LastPostDate,
    COALESCE(SUM(v.BountyAmount), 0) AS TotalBounty,
    CASE 
        WHEN EXISTS (
            SELECT 1 
            FROM PostHistory ph 
            WHERE ph.PostId IN (SELECT p3.Id FROM Posts p3 WHERE p3.OwnerUserId = u.Id) 
            AND ph.PostHistoryTypeId = 10 
            AND TRY_CAST(ph.Comment AS INTEGER) IN (
                SELECT crt.Id FROM CloseReasonTypes crt WHERE crt.Name LIKE '%Duplicate%'
            )
        ) THEN 1 
        ELSE 0 
    END AS HasDuplicateClosures
FROM Users u
LEFT JOIN UserBadgeStats ubs ON u.Id = ubs.UserId
LEFT JOIN PostActivity pa ON u.Id = pa.OwnerUserId
LEFT JOIN (
    SELECT 
        OwnerUserId, 
        Tag, 
        COUNT(*) AS TagCount,
        ROW_NUMBER() OVER (PARTITION BY OwnerUserId ORDER BY COUNT(*) DESC) AS TagRank
    FROM TagExplosion
    GROUP BY OwnerUserId, Tag
) te ON u.Id = te.OwnerUserId AND te.TagRank = 1
LEFT JOIN Votes v ON u.Id = v.UserId AND v.VoteTypeId = 8
WHERE u.Reputation > 1000
    AND (pa.AvgScore > 5 OR pa.AvgScore IS NULL)
    AND u.Id IN (
        SELECT UserId FROM Badges WHERE Class = 1
        UNION
        SELECT UserId FROM Votes WHERE VoteTypeId = 2
    )
GROUP BY u.Id, u.DisplayName, u.Reputation, ubs.TotalBadges, pa.TotalPosts, te.Tag
HAVING COUNT(DISTINCT pa.PostTypeId) > 1 OR COUNT(DISTINCT v.Id) > 3
ORDER BY TotalBounty DESC, u.Reputation DESC
LIMIT 100;