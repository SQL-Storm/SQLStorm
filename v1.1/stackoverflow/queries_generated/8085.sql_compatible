with recent_users as (
  select u.id as user_id,
         u.displayname,
         u.reputation,
         u.creationdate,
         coalesce(nullif(trim(split_part(coalesce(u.location,''), ',', 1)), ''), 'Unknown') as country_guess,
         row_number() over (order by u.creationdate desc, u.id desc) as rn_newest
  from users u
  where u.creationdate >= (select max(creationdate) - interval '365 days' from users)
),
user_activity as (
  select u.id as user_id,
         count(distinct p.id) filter (where p.posttypeid in (1,2)) as total_posts,
         count(distinct p.id) filter (where p.posttypeid = 1) as questions,
         count(distinct p.id) filter (where p.posttypeid = 2) as answers,
         sum(greatest(p.score, 0)) as nonneg_post_score,
         sum(coalesce(p.viewcount,0)) as views,
         sum(coalesce(p.commentcount,0)) as comments_made_on_posts,
         count(distinct c.id) as comments_authored
  from users u
  left join posts p on p.owneruserid = u.id
  left join comments c on c.userid = u.id
  group by u.id
),
user_votes as (
  select u.id as user_id,
         count(*) filter (where v.votetypeid = 2) as upvotes_cast,
         count(*) filter (where v.votetypeid = 3) as downvotes_cast,
         count(*) filter (where v.votetypeid in (8,9)) as bounties_touch,
         sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounty_amount_total
  from users u
  left join votes v on v.userid = u.id
  group by u.id
),
user_badges as (
  select b.userid as user_id,
         count(*) as badges_total,
         count(*) filter (where b.class = 1) as gold_badges,
         count(*) filter (where b.class = 2) as silver_badges,
         count(*) filter (where b.class = 3) as bronze_badges,
         count(*) filter (where b.tagbased = true) as tag_badges
  from badges b
  group by b.userid
),
question_metrics as (
  select p.owneruserid as user_id,
         count(*) as q_count,
         avg(coalesce(p.viewcount,0)) as avg_q_views,
         avg(coalesce(p.score,0)) as avg_q_score,
         sum(case when p.acceptedanswerid is not null then 1 else 0 end) as q_with_accepted,
         sum(coalesce(p.favoritecount,0)) as favorites_sum
  from posts p
  where p.posttypeid = 1
  group by p.owneruserid
),
answer_metrics as (
  select p.owneruserid as user_id,
         count(*) as a_count,
         avg(coalesce(p.score,0)) as avg_a_score,
         sum(case when p.score > 0 then 1 else 0 end) as pos_a_count,
         sum(case when p.score < 0 then 1 else 0 end) as neg_a_count
  from posts p
  where p.posttypeid = 2
  group by p.owneruserid
),
post_linkage as (
  select p.owneruserid as user_id,
         count(*) filter (where pl.linktypeid = 3) as dup_links_out,
         count(*) filter (where pl.linktypeid = 1) as links_out,
         count(distinct pl.relatedpostid) filter (where pl.linktypeid = 3) as distinct_dups,
         count(distinct case when pl.linktypeid = 3 then pl.postid end) as questions_marked_dup
  from posts p
  left join postlinks pl on pl.postid = p.id
  where p.posttypeid = 1
  group by p.owneruserid
),
close_events as (
  select ph.postid,
         min(ph.creationdate) filter (where ph.posthistorytypeid = 10) as first_close_date,
         max(ph.creationdate) filter (where ph.posthistorytypeid = 11) as last_reopen_date,
         count(*) filter (where ph.posthistorytypeid = 10) as close_votes_events
  from posthistory ph
  group by ph.postid
),
question_lifecycle as (
  select p.owneruserid as user_id,
         count(*) filter (where ce.first_close_date is not null) as closed_q,
         avg(extract(epoch from (ce.first_close_date - p.creationdate))) filter (where ce.first_close_date is not null) as avg_secs_to_close,
         avg(extract(epoch from (p.lastactivitydate - p.creationdate))) as avg_secs_to_last_activity
  from posts p
  left join close_events ce on ce.postid = p.id
  where p.posttypeid = 1
  group by p.owneruserid
),
tag_extracted as (
  select p.id as post_id,
         p.owneruserid as user_id,
         unnest(string_to_array(substring(coalesce(p.tags,''), 2, greatest(length(coalesce(p.tags,'')) - 2, 0)), '><')) as tagname
  from posts p
  where p.posttypeid = 1
),
user_top_tags as (
  select t.user_id,
         t.tagname,
         count(*) as tag_q_count,
         row_number() over (partition by t.user_id order by count(*) desc, t.tagname) as rn_tag
  from tag_extracted t
  group by t.user_id, t.tagname
),
accepted_answerers as (
  select a.owneruserid as user_id,
         count(*) as accepted_answers_given
  from posts q
  join posts a on a.id = q.acceptedanswerid and a.posttypeid = 2
  group by a.owneruserid
),
hot_history as (
  select ph.postid,
         min(ph.creationdate) as first_hot_date,
         count(*) as hot_events
  from posthistory ph
  where ph.posthistorytypeid in (52,53)
  group by ph.postid
),
user_hotness as (
  select p.owneruserid as user_id,
         count(distinct h.postid) as hot_posts_touched,
         sum(h.hot_events) as hot_events_total,
         avg(extract(epoch from (h.first_hot_date - p.creationdate))) as avg_secs_to_first_hot
  from hot_history h
  join posts p on p.id = h.postid
  group by p.owneruserid
),
activity_rank as (
  select u.id as user_id,
         dense_rank() over (order by coalesce(ua.total_posts,0) desc, coalesce(ua.comments_authored,0) desc, u.reputation desc) as activity_rank_desc
  from users u
  left join user_activity ua on ua.user_id = u.id
),
score_trend as (
  select p.owneruserid as user_id,
         date_trunc('month', p.creationdate) as ymon,
         sum(coalesce(p.score,0)) as month_score,
         avg(sum(coalesce(p.score,0))) over (partition by p.owneruserid order by date_trunc('month', p.creationdate) rows between 2 preceding and current row) as moving_avg_3m
  from posts p
  where p.posttypeid in (1,2)
  group by p.owneruserid, date_trunc('month', p.creationdate)
),
score_trend_pivot as (
  select st.user_id,
         max(case when st.ymon >= (select date_trunc('month', max(creationdate)) - interval '1 month' from posts) then st.month_score end) as last_month_score,
         max(st.moving_avg_3m) filter (where st.ymon = (select date_trunc('month', max(creationdate)) from posts)) as current_mavg3
  from score_trend st
  group by st.user_id
),
null_safety as (
  select u.id as user_id
  from users u
  where coalesce(u.displayname,'') <> ''
     or u.websiteurl is not null
     or u.location is not null
)
select
  u.id as user_id,
  u.displayname,
  ru.country_guess,
  u.reputation,
  ua.total_posts,
  ua.questions,
  ua.answers,
  ua.nonneg_post_score,
  ua.views,
  uv.upvotes_cast,
  uv.downvotes_cast,
  uv.bounty_amount_total,
  ub.badges_total,
  ub.gold_badges,
  ub.silver_badges,
  ub.bronze_badges,
  qm.q_count,
  qm.avg_q_views,
  qm.avg_q_score,
  qm.q_with_accepted,
  am.a_count,
  am.avg_a_score,
  am.pos_a_count,
  am.neg_a_count,
  pl.dup_links_out,
  pl.links_out,
  ql.closed_q,
  ql.avg_secs_to_close,
  ql.avg_secs_to_last_activity,
  att.accepted_answers_given,
  uh.hot_posts_touched,
  uh.hot_events_total,
  uh.avg_secs_to_first_hot,
  stp.last_month_score,
  stp.current_mavg3,
  string_agg(case when utt.rn_tag <= 3 then utt.tagname else null end, ', ' order by utt.rn_tag) as top3_tags,
  case
    when coalesce(am.a_count,0) > 0 then round(coalesce(att.accepted_answers_given,0) * 1.0 / am.a_count, 4)
    else null
  end as answer_accept_rate,
  case
    when coalesce(ua.total_posts,0) > 0 then round((coalesce(ua.nonneg_post_score,0) * 1.0) / ua.total_posts, 4)
    else 0
  end as avg_score_per_post_nonneg,
  ar.activity_rank_desc as activity_rank,
  ru.rn_newest as recency_rank,
  coalesce(nullif(trim(u.websiteurl),''), 'n/a') as website_clean,
  case when position('stack' in lower(coalesce(u.aboutme,''))) > 0 then 1 else 0 end as mentions_stack_in_aboutme_flag
from users u
join null_safety ns on ns.user_id = u.id
left join recent_users ru on ru.user_id = u.id
left join user_activity ua on ua.user_id = u.id
left join user_votes uv on uv.user_id = u.id
left join user_badges ub on ub.user_id = u.id
left join question_metrics qm on qm.user_id = u.id
left join answer_metrics am on am.user_id = u.id
left join post_linkage pl on pl.user_id = u.id
left join question_lifecycle ql on ql.user_id = u.id
left join accepted_answerers att on att.user_id = u.id
left join user_hotness uh on uh.user_id = u.id
left join score_trend_pivot stp on stp.user_id = u.id
left join activity_rank ar on ar.user_id = u.id
left join user_top_tags utt on utt.user_id = u.id and utt.rn_tag <= 3
where (u.reputation > 100 or coalesce(ua.total_posts,0) >= 10)
  and not exists (
    select 1
    from posts pz
    where pz.owneruserid = u.id
      and pz.posttypeid = 1
      and pz.closeddate is not null
      and pz.score < 0
  )
group by
  u.id, u.displayname, ru.country_guess, u.reputation,
  ua.total_posts, ua.questions, ua.answers, ua.nonneg_post_score, ua.views,
  uv.upvotes_cast, uv.downvotes_cast, uv.bounty_amount_total,
  ub.badges_total, ub.gold_badges, ub.silver_badges, ub.bronze_badges,
  qm.q_count, qm.avg_q_views, qm.avg_q_score, qm.q_with_accepted,
  am.a_count, am.avg_a_score, am.pos_a_count, am.neg_a_count,
  pl.dup_links_out, pl.links_out,
  ql.closed_q, ql.avg_secs_to_close, ql.avg_secs_to_last_activity,
  att.accepted_answers_given, uh.hot_posts_touched, uh.hot_events_total, uh.avg_secs_to_first_hot,
  stp.last_month_score, stp.current_mavg3,
  ar.activity_rank_desc, ru.rn_newest,
  u.websiteurl, u.aboutme
having coalesce(ua.total_posts,0) + coalesce(ua.comments_authored,0) > 0
order by
  activity_rank asc,
  coalesce(ua.total_posts,0) desc,
  u.reputation desc
limit 500;