WITH UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate AS UserCreationDate,
        COUNT(p.Id) AS TotalPosts,
        COUNT(DISTINCT a.Id) AS TotalAnswers,
        MAX(p.LastActivityDate) AS LastPostActivity,
        MAX(c.CreationDate) AS LastCommentDate,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownvotes
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Posts a ON p.Id = a.ParentId AND a.PostTypeId = 2
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    GROUP BY
        u.Id, u.Reputation, u.DisplayName, u.CreationDate
), ActiveUsers AS (
    SELECT
        UserId,
        Reputation,
        DisplayName,
        UserCreationDate,
        TotalPosts,
        TotalAnswers,
        LastPostActivity,
        LastCommentDate,
        TotalUpvotes,
        TotalDownvotes,
        ROW_NUMBER() OVER (PARTITION BY Reputation ORDER BY TotalUpvotes DESC) AS ReputationRank,
        ROW_NUMBER() OVER (ORDER BY TotalPosts DESC) AS PostRank,
        ROW_NUMBER() OVER (ORDER BY TotalAnswers DESC) AS AnswerRank
    FROM
        UserActivity
    WHERE
        LastPostActivity > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days' OR LastCommentDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
), HighReputationUsers AS (
    SELECT
        UserId,
        Reputation,
        DisplayName,
        UserCreationDate,
        TotalPosts,
        TotalAnswers,
        LastPostActivity,
        LastCommentDate,
        TotalUpvotes,
        TotalDownvotes,
        ReputationRank,
        PostRank,
        AnswerRank
    FROM
        ActiveUsers
    WHERE
        Reputation > 1000
), TopPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate AS PostCreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        u.DisplayName AS OwnerDisplayName,
        COUNT(c.Id) AS CommentCount,
        COUNT(v.Id) AS VoteCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpvoteCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownvoteCount,
        RANK() OVER (ORDER BY p.Score DESC) AS ScoreRank,
        RANK() OVER (ORDER BY p.ViewCount DESC) AS ViewRank,
        RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) AS TypeScoreRank
    FROM
        Posts p
    LEFT JOIN
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    LEFT JOIN
        Votes v ON p.Id = v.PostId
    WHERE
        p.PostTypeId IN (1, 2)
    GROUP BY
        p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.Title, p.Tags, p.OwnerUserId, u.DisplayName
), HighEngagementPosts AS (
    SELECT
        PostId,
        PostTypeId,
        PostCreationDate,
        Score,
        ViewCount,
        Title,
        Tags,
        OwnerUserId,
        OwnerDisplayName,
        CommentCount,
        VoteCount,
        UpvoteCount,
        DownvoteCount,
        ScoreRank,
        ViewRank,
        TypeScoreRank
    FROM
        TopPosts
    WHERE
        ScoreRank <= 100 AND ViewRank <= 100
), UserBadgeStats AS (
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id ELSE NULL END) AS GoldBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id ELSE NULL END) AS SilverBadges,
        COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id ELSE NULL END) AS BronzeBadges,
        COUNT(DISTINCT CASE WHEN b.TagBased = 1 THEN b.Id ELSE NULL END) AS TagBasedBadges
    FROM
        Badges b
    GROUP BY
        b.UserId
), ComprehensiveUserStats AS (
    SELECT
        h.UserId,
        h.Reputation,
        h.DisplayName,
        h.UserCreationDate,
        h.TotalPosts,
        h.TotalAnswers,
        h.LastPostActivity,
        h.LastCommentDate,
        h.TotalUpvotes,
        h.TotalDownvotes,
        h.ReputationRank,
        h.PostRank,
        h.AnswerRank,
        s.TotalBadges,
        s.GoldBadges,
        s.SilverBadges,
        s.BronzeBadges,
        s.TagBasedBadges
    FROM
        HighReputationUsers h
    LEFT JOIN
        UserBadgeStats s ON h.UserId = s.UserId
), PostEngagementMetrics AS (
    SELECT
        hep.PostId,
