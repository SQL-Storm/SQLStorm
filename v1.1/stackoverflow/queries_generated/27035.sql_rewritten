        CASE
		    WHEN coalesce(cuba.TotalPosts, -1) + coalesce( cuba.TotalAnswers,-1) = -2 THEN coalesce(cuba.TotalUpvotes, -1) + coalesce( cuba.TotalDownvotes, -1)
		    Else  coalesce(cuba.TotalUpvotes, -1)
		END AS UserUpAction,
        0 AS TRESHOLD,
        1 AS UDEFINED,
         CASE
		    WHEN coalesce(cuba.TotalPosts, -1) + coalesce(cuba.TotalAnswers, -1) = -2
		    THEN coalesce(cuba.TotalUpvotes, -1) + coalesce(cuba.TotalDownvotes, -1)
		    ELSE coalesce(cuba.TotalUpvotes, -1)
		END AS PROFILEUPVOTES,
		CASE
