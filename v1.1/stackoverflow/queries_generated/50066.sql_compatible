WITH TagEditors AS (
  SELECT
    ph.UserId,
    COUNT(DISTINCT ph.PostId) AS TagEditCount
  FROM PostHistory ph
  WHERE
    ph.PostHistoryTypeId = 6
    AND ph.Text LIKE '%<performance>%'
    AND ph.UserId IS NOT NULL
  GROUP BY
    ph.UserId
), CanonicalQuestions AS (
  SELECT
    p.OwnerUserId AS UserId,
    COUNT(*) AS CanonicalCount
  FROM PostLinks pl
  JOIN Posts p
    ON pl.RelatedPostId = p.Id
  WHERE
    pl.LinkTypeId = 3
    AND p.Tags LIKE '%<performance>%'
    AND p.OwnerUserId IS NOT NULL
  GROUP BY
    p.OwnerUserId
), AnswerStats AS (
  SELECT
    ans.OwnerUserId,
    SUM(ans.Score) AS TotalAnswerScore,
    AVG(ans.Score) AS AverageAnswerScore,
    COUNT(*) AS AnswerCount,
    SUM(ans.CommentCount) AS TotalAnswerCommentCount
  FROM Posts q
  JOIN Posts ans
    ON q.Id = ans.ParentId
  WHERE
    q.Tags LIKE '%<performance>%'
    AND ans.PostTypeId = 2
    AND ans.OwnerUserId IS NOT NULL
  GROUP BY
    ans.OwnerUserId
  HAVING
    COUNT(*) >= 5
)
SELECT
  u.Id AS UserId,
  u.DisplayName,
  u.Reputation,
  u.CreationDate AS UserCreationDate,
  als.TotalAnswerScore,
  als.AnswerCount,
  als.AverageAnswerScore,
  COALESCE(te.TagEditCount, 0) AS PerformanceTagEdits,
  COALESCE(cq.CanonicalCount, 0) AS TimesAsCanonical,
  (
    SELECT
      AVG(JULIANDAY(p_ans.CreationDate) - JULIANDAY(p_q.CreationDate))
    FROM Posts p_q
    JOIN Posts p_ans
      ON p_q.AcceptedAnswerId = p_ans.Id
    WHERE
      p_q.Tags LIKE '%<performance>%'
      AND p_ans.OwnerUserId = u.Id
  ) AS AvgTimeToAccept,
  DENSE_RANK() OVER (ORDER BY (
    (als.TotalAnswerScore * 0.4) + (als.AverageAnswerScore * 0.2) + (COALESCE(cq.CanonicalCount, 0) * 25) + (COALESCE(te.TagEditCount, 0) * 10)
  ) DESC) AS GuardianRank
FROM AnswerStats als
JOIN Users u
  ON als.OwnerUserId = u.Id
LEFT JOIN TagEditors te
  ON als.OwnerUserId = te.UserId
LEFT JOIN CanonicalQuestions cq
  ON als.OwnerUserId = cq.UserId
WHERE
  u.Reputation > 1000
GROUP BY
  u.Id,
  u.DisplayName,
  u.Reputation,
  u.CreationDate,
  als.TotalAnswerScore,
  als.AnswerCount,
  als.AverageAnswerScore,
  te.TagEditCount,
  cq.CanonicalCount,
  u.Id -- included to ensure correlated subquery reference is covered
ORDER BY
  GuardianRank,
  als.TotalAnswerScore DESC
LIMIT 100;