WITH user_reputation AS (
    SELECT "UserId", SUM("Reputation") AS TotalReputation
    FROM "Users"
    GROUP BY "UserId"
),
top_users AS (
    SELECT u."Id", u."DisplayName", ur.TotalReputation
    FROM "Users" u
    JOIN user_reputation ur ON u."Id" = ur."UserId"
    ORDER BY ur.TotalReputation DESC
    LIMIT 10
)
SELECT tu."DisplayName", COUNT(p."Id") AS TotalPosts
FROM top_users tu
JOIN "Posts" p ON tu."Id" = p."OwnerUserId"
WHERE p."PostTypeId" = 1
GROUP BY tu."DisplayName", tu."Id", tu."TotalReputation"
ORDER BY TotalPosts DESC;