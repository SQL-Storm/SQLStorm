WITH ActiveUsers AS (
    SELECT 
        u.Id, 
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) AS VoteCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        RANK() OVER (PARTITION BY b.Class ORDER BY u.Reputation DESC) AS BadgeClassRank,
        u.Location,
        u.UpVotes,
        u.DownVotes
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId AND v.VoteTypeId IN (2, 3, 5)
    LEFT JOIN Badges b ON u.Id = b.UserId AND b.Class IN (1, 2, 3)
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation, b.Class, u.Location, u.UpVotes, u.DownVotes
),
PostStats AS (
    SELECT 
        OwnerUserId,
        AVG(AnswerCount) AS AvgAnswers,
        MAX(ViewCount) AS MaxViews,
        SUM(CASE WHEN ClosedDate IS NOT NULL THEN 1 ELSE 0 END) AS ClosedPosts,
        ROW_NUMBER() OVER (ORDER BY MAX(Score) DESC) AS TopPostRank
    FROM Posts
    WHERE PostTypeId = 1
    GROUP BY OwnerUserId
),
GlobalAvgAnswersCTE AS (
    SELECT AVG(AnswerCount) AS GlobalAvgAnswers FROM Posts WHERE PostTypeId = 1
)
SELECT 
    au.DisplayName || ' (' || COALESCE(au.Location, 'Unknown') || ')' AS UserLabel,
    au.Reputation,
    au.PostCount,
    au.CommentCount,
    au.VoteCount,
    au.BadgeCount,
    ps.AvgAnswers,
    ps.MaxViews,
    ps.ClosedPosts,
    g.GlobalAvgAnswers AS GlobalAvgAnswers,
    CASE 
        WHEN au.BadgeCount > 0 THEN 'HasBadges' 
        ELSE 'NoBadges' 
    END AS BadgeStatus,
    (au.UpVotes * 100.0 / NULLIF(au.UpVotes + au.DownVotes, 0)) AS UpvoteRatio
FROM ActiveUsers au
JOIN Users u ON au.Id = u.Id
LEFT JOIN PostStats ps ON au.Id = ps.OwnerUserId
CROSS JOIN GlobalAvgAnswersCTE g
WHERE ps.AvgAnswers > g.GlobalAvgAnswers
    AND EXISTS (
        SELECT 1 
        FROM Posts p 
        WHERE p.OwnerUserId = au.Id 
          AND p.ClosedDate IS NOT NULL
          AND p.Id IN (
            SELECT ph.PostId 
            FROM PostHistory ph
            WHERE ph.PostHistoryTypeId = 10
              -- parse JSON in a dialect-neutral way: extract numeric CloseReasonId by removing non-digits and casting
              AND (
                    -- If the Text column is JSON stored as text containing "CloseReasonId":101, try to extract digits after the key.
                    -- Use POSITION/substring functions to be portable
                    CAST(
                      NULLIF(
                        REGEXP_REPLACE(
                          SUBSTRING(ph.Text FROM POSITION('"CloseReasonId"' IN ph.Text) FOR 50),
                          '[^0-9]+', '', 'g'
                        ),
                        ''
                      ) AS INTEGER
                    ) = 101
                  )
        )
    )
    AND au.BadgeClassRank <= 10
UNION ALL
SELECT 
    'SystemEvent: ' || CAST(ph.CreationDate AS VARCHAR) || ' - ' || pht.Name AS UserLabel,
    NULL AS Reputation,
    COUNT(DISTINCT ph.PostId) AS PostCount,
    NULL AS CommentCount,
    NULL AS VoteCount,
    NULL AS BadgeCount,
    NULL AS AvgAnswers,
    NULL AS MaxViews,
    NULL AS ClosedPosts,
    NULL AS GlobalAvgAnswers,
    NULL AS BadgeStatus,
    NULL AS UpvoteRatio
FROM PostHistory ph
JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
WHERE ph.PostHistoryTypeId IN (10, 11, 12, 13)
    AND ph.CreationDate > DATE '2020-01-01'
GROUP BY pht.Name, ph.CreationDate
ORDER BY Reputation DESC NULLS LAST,
         -- deterministic ordering expression kept; selects NULL safely
         (SELECT TopPostRank FROM PostStats WHERE OwnerUserId = NULL) NULLS LAST
LIMIT 100;