WITH recent_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.ViewCount,
    p.Score,
    p.OwnerUserId,
    p.OwnerDisplayName,
    p.LastActivityDate,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
),
tag_bench AS (
  SELECT
    t.TagName,
    t.Count AS TagCount
  FROM Tags t
  WHERE t.IsModeratorOnly = FALSE
),
top_users AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.ProfileImageUrl,
    u.Location,
    u.AccountId,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.LastAccessDate DESC) AS rn
  FROM Users u
  WHERE u.Reputation IS NOT NULL
),
pledged_votes AS (
  SELECT
    v.PostId,
    v.VoteTypeId,
    v.UserId,
    v.CreationDate,
    v.BountyAmount,
    v.Comment
  FROM Votes v
  WHERE v.VoteTypeId IN (2,3,14,16)
),
complex_dump AS (
  SELECT
    rp.PostId,
    rp.RelatedPostId,
    lt.Name AS LinkType,
    rp.CreationDate AS LinkCreationDate
  FROM PostLinks rp
  JOIN LinkTypes lt ON rp.LinkTypeId = lt.Id
  WHERE lt.Name IN ('Linked','Duplicate')
)
SELECT
  q.PostId,
  q.Title,
  q.Tags,
  q.CreationDate AS QuestionCreated,
  q.LastActivityDate,
  q.ViewCount,
  q.Score AS QuestionScore,
  q.AnswerCount,
  q.CommentCount,
  q.FavoriteCount,
  u.Id AS OwnerId,
  u.DisplayName AS OwnerDisplayName,
  u.Reputation,
  u.Location,
  u.ProfileImageUrl,
  u.AccountId,
  CASE
    WHEN q.OwnerUserId IS NULL THEN 'Unknown'
    ELSE 'Registered'
  END AS OwnerStatus,
  t.TagName,
  t.TagCount,
  b.Name AS BadgeName,
  b.Date AS BadgeDate,
  b.Class AS BadgeClass,
  b.TagBased AS IsTagBased,
  pv.CreationDate AS VotedOnDate,
  pv.VoteTypeId,
  pv.BountyAmount,
  clr.Name AS CloseReason,
  c.C AS CommentCountAggregate
FROM recent_questions q
LEFT JOIN Users u ON q.OwnerUserId = u.Id
LEFT JOIN (
  SELECT TagName, Count AS TagCount
  FROM Tags
  WHERE IsModeratorOnly = FALSE
  LIMIT 50
) t ON 1=1
LEFT JOIN Badges b ON b.UserId = q.OwnerUserId
LEFT JOIN pledged_votes pv ON pv.PostId = q.PostId
LEFT JOIN CloseReasonTypes clr ON SUBSTRING(COALESCE(pv.Comment, ''), 1, 3) = CAST(clr.Id AS varchar)
LEFT JOIN (
  SELECT PostId, COUNT(*) AS C
  FROM Comments
  GROUP BY PostId
) c ON c.PostId = q.PostId
GROUP BY
  q.PostId,
  q.Title,
  q.Tags,
  q.CreationDate,
  q.LastActivityDate,
  q.ViewCount,
  q.Score,
  q.AnswerCount,
  q.CommentCount,
  q.FavoriteCount,
  u.Id,
  u.DisplayName,
  u.Reputation,
  u.Location,
  u.ProfileImageUrl,
  u.AccountId,
  q.OwnerUserId,
  t.TagName,
  t.TagCount,
  b.Name,
  b.Date,
  b.Class,
  b.TagBased,
  pv.CreationDate,
  pv.VoteTypeId,
  pv.BountyAmount,
  clr.Name,
  c.C
ORDER BY q.LastActivityDate DESC
LIMIT 200;