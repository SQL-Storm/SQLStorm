WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS Questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS Answers,
        AVG(p.Score) AS AvgScore,
        SUM(p.ViewCount) AS TotalViews,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) AS TotalVotesReceived
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    WHERE u.Reputation > 1000
    GROUP BY u.Id
),
BadgeSummary AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        SUM(CASE WHEN COALESCE(b.TagBased, FALSE) = TRUE THEN 1 ELSE 0 END) AS TagBasedBadges
    FROM Badges b
    GROUP BY b.UserId
),
TagEngagement AS (
    SELECT 
        p.OwnerUserId AS UserId,
        t.TagName,
        COUNT(p.Id) AS PostsInTag,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY COUNT(p.Id) DESC) AS TagRank
    FROM Posts p
    CROSS JOIN LATERAL (
        SELECT unnest(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) AS tag_name
    ) ta
    JOIN Tags t ON t.TagName = ta.tag_name
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId, t.TagName
),
TopTags AS (
    SELECT 
        UserId,
        MAX(CASE WHEN TagRank = 1 THEN TagName END) AS TopTag,
        MAX(CASE WHEN TagRank = 1 THEN PostsInTag END) AS TopTagPosts
    FROM TagEngagement
    GROUP BY UserId
),
PostHistoryMetrics AS (
    SELECT 
        ph.PostId,
        COUNT(ph.Id) AS EditCount,
        MAX(ph.CreationDate) AS LastEditDate
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4,5,6,7,8,9)
    GROUP BY ph.PostId
),
UserPostEdits AS (
    SELECT 
        p.OwnerUserId AS UserId,
        SUM(h.EditCount) AS TotalEdits,
        AVG(h.EditCount) AS AvgEditsPerPost
    FROM Posts p
    JOIN PostHistoryMetrics h ON p.Id = h.PostId
    GROUP BY p.OwnerUserId
),
LinkAnalysis AS (
    SELECT 
        pl.PostId,
        COUNT(DISTINCT pl.RelatedPostId) AS LinkedPosts,
        SUM(CASE WHEN pl.LinkTypeId = 3 THEN 1 ELSE 0 END) AS DuplicateLinks
    FROM PostLinks pl
    GROUP BY pl.PostId
),
UserLinks AS (
    SELECT 
        p.OwnerUserId AS UserId,
        SUM(l.LinkedPosts) AS TotalLinkedPosts,
        SUM(l.DuplicateLinks) AS TotalDuplicates
    FROM Posts p
    JOIN LinkAnalysis l ON p.Id = l.PostId
    GROUP BY p.OwnerUserId
)
SELECT 
    u.DisplayName,
    u.Reputation,
    u.Location,
    ua.TotalPosts,
    ua.Questions,
    ua.Answers,
    ua.AvgScore,
    ua.TotalViews,
    ua.TotalComments,
    ua.TotalVotesReceived,
    COALESCE(bs.GoldBadges, 0) AS GoldBadges,
    COALESCE(bs.SilverBadges, 0) AS SilverBadges,
    COALESCE(bs.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(bs.TagBasedBadges, 0) AS TagBasedBadges,
    tt.TopTag,
    tt.TopTagPosts,
    ue.TotalEdits,
    ue.AvgEditsPerPost,
    ul.TotalLinkedPosts,
    ul.TotalDuplicates,
    RANK() OVER (ORDER BY ua.TotalPosts DESC) AS ActivityRank,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY ua.AvgScore) OVER (PARTITION BY u.Location) AS MedianScoreByLocation
FROM Users u
JOIN UserActivity ua ON u.Id = ua.UserId
LEFT JOIN BadgeSummary bs ON u.Id = bs.UserId
LEFT JOIN TopTags tt ON u.Id = tt.UserId
LEFT JOIN UserPostEdits ue ON u.Id = ue.UserId
LEFT JOIN UserLinks ul ON u.Id = ul.UserId
WHERE ua.TotalPosts > 50
  AND u.CreationDate >= DATE '2010-01-01'
ORDER BY ua.TotalPosts DESC, u.Reputation DESC
FETCH FIRST 1000 ROWS ONLY;