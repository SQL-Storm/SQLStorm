-- {"query": "33073.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "gpt-4.1-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 1986, "output_tokens": 195} 
SELECT
    p.PostTypeId,
    COUNT(*) AS TotalPosts,
    AVG(p.Score) AS AverageScore,
    AVG(p.ViewCount) AS AverageViews,
    NULLIF(AVG(CASE WHEN p.PostTypeId = 1 THEN p.AnswerCount END), 0) AS AvgAnswersPerQuestion,
    AVG(DATEDIFF(second, p.CreationDate, p.LastActivityDate)) AS AvgSecondsToLastActivity,
    COUNT(DISTINCT u.Id) AS UniqueAuthors,
    COUNT(c.Id) AS TotalComments,
    AVG(c.Score) AS AverageCommentScore
FROM
    Posts p
LEFT JOIN
    Users u ON p.OwnerUserId = u.Id
LEFT JOIN
    Comments c ON c.PostId = p.Id
WHERE
    p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
GROUP BY
    p.PostTypeId
ORDER BY
    TotalPosts DESC
LIMIT 10;