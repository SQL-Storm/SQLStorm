WITH UserStats AS (
    SELECT
        u.Id                     AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END)                              AS QCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END)                              AS ACount,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END)                   AS TotalScore,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END)                         AS TotalUpOrds,
        COUNT(c.Id)                                                               AS TotalComm,
        COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN pl.Id END)                AS Duplicates,
        ROW_NUMBER() OVER (ORDER BY SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) DESC) AS Rnk
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId = 2
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN PostLinks pl ON pl.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
BadgeCounts AS (
    SELECT
        UserId,
        SUM(CASE WHEN "Class" = 1 THEN 1 ELSE 0 END) AS Gold,
        SUM(CASE WHEN "Class" = 2 THEN 1 ELSE 0 END) AS Silver
    FROM Badges
    GROUP BY UserId
)
SELECT
    us.UserId,
    'user-' || LPAD(CAST(us.UserId AS VARCHAR), 8, '0')                         AS Slug,
    COALESCE(us.DisplayName, '<anon>')                                         AS Name,
    us.Reputation,
    us.TotalScore,
    us.QCount             AS Questions,
    us.ACount             AS Answers,
    us.TotalUpOrds        AS Upvotes,
    bc.Gold,
    bc.Silver,
    us.Duplicates,
    us.TotalComm          AS Comments,
    (SELECT COUNT(*) FROM Comments c WHERE c.UserId = us.UserId
     AND c.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '7' DAY)) AS WeeklyComments,
    CASE WHEN us.Rnk <= 5 THEN 'Elite'
         WHEN us.Rnk <= 20 THEN 'Top'
         ELSE 'Other' END                                                    AS Tier,
    STRING_AGG(DISTINCT p.Tags, ',') FILTER (WHERE p.PostTypeId = 1)          AS UsedTags,
    TO_CHAR(CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY, 'YYYY-MM-DD') AS BenchDate
FROM UserStats us
LEFT JOIN BadgeCounts bc  ON bc.UserId = us.UserId
LEFT JOIN Posts p          ON p.OwnerUserId = us.UserId AND p.PostTypeId = 1
WHERE us.Reputation > 3000
  AND (us.Reputation - us.TotalScore) / CAST(us.Reputation AS NUMERIC) > 0.2
  AND (us.TotalComm IS NULL OR us.TotalComm > 3)
GROUP BY us.UserId, us.DisplayName, us.Reputation, us.TotalScore,
         us.QCount, us.ACount, us.TotalUpOrds, bc.Gold, bc.Silver,
         us.Duplicates, us.TotalComm, us.Rnk
ORDER BY us.TotalScore DESC
LIMIT 50

UNION ALL

SELECT
    0 AS UserId,
    'summary' AS Slug,
    NULL AS Name,
    CAST(NULL AS NUMERIC) AS Reputation,
    CAST(NULL AS NUMERIC) AS TotalScore,
    CAST(NULL AS INTEGER) AS Questions,
    CAST(NULL AS INTEGER) AS Answers,
    CAST(NULL AS INTEGER) AS Upvotes,
    CAST(NULL AS INTEGER) AS Gold,
    CAST(NULL AS INTEGER) AS Silver,
    CAST(NULL AS INTEGER) AS Duplicates,
    CAST(NULL AS INTEGER) AS Comments,
    CAST(NULL AS INTEGER) AS WeeklyComments,
    CAST(NULL AS VARCHAR) AS Tier,
    CAST(NULL AS VARCHAR) AS UsedTags,
    CAST(NULL AS VARCHAR) AS BenchDate
FROM (SELECT 1) d;