WITH RecentPosts AS (
    SELECT p.Id, p.Title, p.CreationDate, p.OwnerUserId
    FROM Posts p
    WHERE p.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
      AND p.PostTypeId = 1
),
ActiveUsers AS (
    SELECT u.Id, u.DisplayName, u.Reputation,
           ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS Rank
    FROM Users u
    WHERE u.LastAccessDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
),
UserBadges AS (
    SELECT ub.UserId, COUNT(ub.Id) AS BadgeCount
    FROM Badges ub
    GROUP BY ub.UserId
),
TopTags AS (
    SELECT t.TagName, COUNT(pt.Id) AS TagUsage
    FROM Tags t
    LEFT JOIN (
        SELECT (regexp_split_to_table(substring(p.Tags FROM 2 FOR char_length(p.Tags)-2), '><')) AS TagName, p.Id
        FROM Posts p
    ) pt ON t.TagName = pt.TagName
    GROUP BY t.TagName
    ORDER BY TagUsage DESC
    LIMIT 5
),
QuestionDetails AS (
    SELECT rp.Id AS QuestionId, rp.Title, au.DisplayName, au.Reputation, COALESCE(ub.BadgeCount, 0) AS BadgeCount, pt.TagName
    FROM RecentPosts rp
    JOIN ActiveUsers au ON rp.OwnerUserId = au.Id
    LEFT JOIN UserBadges ub ON au.Id = ub.UserId
    LEFT JOIN (
        SELECT rp_inner.Id AS PostId,
               (regexp_split_to_table(substring(rp_inner.Tags FROM 2 FOR char_length(rp_inner.Tags)-2), '><')) AS TagName
        FROM RecentPosts rp_inner
    ) pt ON pt.PostId = rp.Id AND pt.TagName IN (SELECT TagName FROM TopTags)
)
SELECT qd.QuestionId, qd.Title, qd.DisplayName, qd.Reputation,
       qd.BadgeCount AS BadgeCount, STRING_AGG(qd.TagName, ', ') AS Tags
FROM QuestionDetails qd
GROUP BY qd.QuestionId, qd.Title, qd.DisplayName, qd.Reputation, qd.BadgeCount
ORDER BY qd.Reputation DESC, qd.BadgeCount DESC;