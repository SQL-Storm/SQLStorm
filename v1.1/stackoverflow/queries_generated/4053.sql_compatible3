WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        1 AS Level,
        t.ExcerptPostId,
        t.WikiPostId
    FROM Tags t
    WHERE t.Count > 1000
  UNION ALL
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        rh.Level + 1 AS Level,
        t.ExcerptPostId,
        t.WikiPostId
    FROM Tags t
    INNER JOIN RecursiveTagHierarchy rh ON t.ExcerptPostId = rh.WikiPostId
    WHERE rh.Level < 3
),
QuestionStats AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        COUNT(a.Id) FILTER (WHERE a.PostTypeId = 2) AS AnswerCount,
        COALESCE(vb.UpVoteCount, 0) AS TotalUpVotes,
        COALESCE(vd.DownVoteCount, 0) AS TotalDownVotes,
        AVG(p.Score) OVER (PARTITION BY regexp_replace(p.Tags, '^.*<([^>]+)>.*$', '\1')) AS AvgScoreByTag,
        ROW_NUMBER() OVER (PARTITION BY regexp_replace(p.Tags, '^.*<([^>]+)>.*$', '\1') ORDER BY p.Score DESC) AS RankWithinTag
    FROM Posts p
    LEFT JOIN Posts a ON a.ParentId = p.Id AND a.PostTypeId = 2
    LEFT JOIN (
        SELECT
            PostId,
            SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount
        FROM Votes
        GROUP BY PostId
    ) vb ON vb.PostId = p.Id
    LEFT JOIN (
        SELECT
            PostId,
            SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount
        FROM Votes
        GROUP BY PostId
    ) vd ON vd.PostId = p.Id
    WHERE p.PostTypeId = 1
    GROUP BY p.Id, p.Title, p.CreationDate, p.Score, p.ViewCount, p.Tags, vb.UpVoteCount, vd.DownVoteCount
),
LatestEdits AS (
    SELECT
        ph.PostId,
        ph.CreationDate AS LastEditDate,
        ph.UserId AS LastEditorUserId,
        ph.UserDisplayName AS LastEditorDisplayName,
        ph.PostHistoryTypeId,
        ph.Comment,
        ph.Text
    FROM (
        SELECT ph.*,
               ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
        FROM PostHistory ph
        WHERE ph.PostHistoryTypeId IN (4,5,6,10,11,14)
    ) ph
    WHERE ph.rn = 1
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersPosted,
        COUNT(b.Id) AS BadgeCount,
        COUNT(DISTINCT c.Id) AS CommentsMade,
        AVG(p.Score) FILTER (WHERE p.OwnerUserId = u.Id) AS AvgPostScore,
        RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
ClosedQuestions AS (
    SELECT
        ph.PostId,
        ph.CreationDate AS CloseDate,
        crt.Name AS CloseReason
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON CAST(crt.Id AS varchar) = ph.Comment
    WHERE ph.PostHistoryTypeId = 10
),
QuestionAnswerVotes AS (
    SELECT
        q.Id AS QuestionId,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) AS QuestionUpVotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) AS QuestionDownVotes,
        COUNT(DISTINCT CASE WHEN v_answer.VoteTypeId = 2 THEN v_answer.Id END) AS AnswersUpVotes,
        COUNT(DISTINCT CASE WHEN v_answer.VoteTypeId = 3 THEN v_answer.Id END) AS AnswersDownVotes
    FROM Posts q
    LEFT JOIN Votes v ON v.PostId = q.Id
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN Votes v_answer ON v_answer.PostId = a.Id
    WHERE q.PostTypeId = 1
    GROUP BY q.Id
),
MainQuery AS (
SELECT
    qs.QuestionId,
    qs.Title,
    qs.CreationDate,
    qs.Score,
    qs.ViewCount,
    COALESCE(NULLIF(qs.Tags, ''), '<no_tag>') AS TagList,
    qs.AnswerCount,
    qa.QuestionUpVotes,
    qa.QuestionDownVotes,
    qa.AnswersUpVotes,
    qa.AnswersDownVotes,
    us.DisplayName AS QuestionOwner,
    us.Reputation AS OwnerReputation,
    us.BadgeCount AS OwnerBadgeCount,
    us.QuestionsPosted AS OwnerQuestions,
    us.AnswersPosted AS OwnerAnswers,
    ce.CloseDate,
    ce.CloseReason,
    le.LastEditDate,
    le.LastEditorUserId,
    le.LastEditorDisplayName,
    ROW_NUMBER() OVER (PARTITION BY regexp_replace(qs.Tags, '^.*<([^>]+)>.*$', '\1') ORDER BY qs.Score DESC, qs.ViewCount DESC) AS TagRank,
    regexp_replace(qs.Title, '[^a-zA-Z0-9 ]', '', 'g') AS NormalizedTitle,
    (char_length(qs.Tags) - char_length(replace(qs.Tags, '><', '')) + 1) AS TagCount,
    (CASE WHEN qs.AnswerCount > 0 THEN CAST(qs.Score AS numeric) / qs.AnswerCount ELSE NULL END) AS ScorePerAnswer,
    (CASE WHEN us.Reputation > 10000 THEN 'HighRep' ELSE 'LowRep' END) AS ReputationClass
FROM QuestionStats qs
LEFT JOIN UserActivity us ON us.UserId = (SELECT p2.OwnerUserId FROM Posts p2 WHERE p2.Id = qs.QuestionId)
LEFT JOIN ClosedQuestions ce ON ce.PostId = qs.QuestionId
LEFT JOIN LatestEdits le ON le.PostId = qs.QuestionId
LEFT JOIN QuestionAnswerVotes qa ON qa.QuestionId = qs.QuestionId
WHERE qs.RankWithinTag <= 10
  AND (qs.Score > (SELECT AVG(p3.Score) FROM Posts p3 WHERE p3.PostTypeId = 1) OR qa.QuestionUpVotes > 5)
)
SELECT *
FROM (
  SELECT *
  FROM MainQuery
  ORDER BY Score DESC, ViewCount DESC
  OFFSET 10 ROWS FETCH NEXT 20 ROWS ONLY

  UNION ALL

  SELECT
    p.Id AS QuestionId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    '<union_only>' AS TagList,
    0 AS AnswerCount,
    0 AS QuestionUpVotes,
    0 AS QuestionDownVotes,
    0 AS AnswersUpVotes,
    0 AS AnswersDownVotes,
    NULL::text AS QuestionOwner,
    NULL::integer AS OwnerReputation,
    NULL::integer AS OwnerBadgeCount,
    NULL::integer AS OwnerQuestions,
    NULL::integer AS OwnerAnswers,
    NULL::timestamp AS CloseDate,
    NULL::text AS CloseReason,
    NULL::timestamp AS LastEditDate,
    NULL::integer AS LastEditorUserId,
    NULL::text AS LastEditorDisplayName,
    NULL::integer AS TagRank,
    NULL::text AS NormalizedTitle,
    NULL::integer AS TagCount,
    NULL::numeric AS ScorePerAnswer,
    NULL::text AS ReputationClass
  FROM Posts p
  WHERE p.PostTypeId = 1 AND p.Score < 0
  ORDER BY p.CreationDate DESC
  LIMIT 5
) t
ORDER BY Score DESC, ViewCount DESC;