WITH UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT c.Id) AS TotalComments,
        SUM(p.Score) AS TotalPostScore,
        COALESCE(SUM(b.Class), 0) AS TotalBadgeWeight,
        MAX(p.CreationDate) AS LastPostDate,
        MIN(p.CreationDate) AS FirstPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
TopTags AS (
    SELECT
        p.OwnerUserId,
        tag AS TagName,
        COUNT(*) AS TagCount
    FROM Posts p,
    LATERAL (
      SELECT TRIM(BOTH '<>' FROM t) AS tag
      FROM UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><')) AS t
    ) tt
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId, tag
),
MaxTagPerUser AS (
    SELECT
        OwnerUserId,
        TagName,
        TagCount,
        ROW_NUMBER() OVER (PARTITION BY OwnerUserId ORDER BY TagCount DESC) AS rn
    FROM TopTags
)
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.TotalPosts,
    ua.TotalComments,
    ua.TotalPostScore,
    ua.TotalBadgeWeight,
    ua.FirstPostDate,
    ua.LastPostDate,
    EXTRACT(EPOCH FROM (ua.LastPostDate - ua.FirstPostDate))/86400 AS DaysActive,
    mt.TagName AS MostUsedTag,
    mt.TagCount AS TagFrequency,
    RANK() OVER (ORDER BY ua.TotalPostScore DESC) AS UserRankByScore,
    RANK() OVER (ORDER BY ua.TotalPosts DESC) AS UserRankByPostCount
FROM UserActivity ua
LEFT JOIN MaxTagPerUser mt ON mt.OwnerUserId = ua.UserId AND mt.rn = 1
WHERE ua.TotalPosts >= 10
ORDER BY ua.TotalPostScore DESC, ua.TotalPosts DESC
LIMIT 100;