WITH RecentPosts AS (
    SELECT 
        p.Id, 
        p.Title, 
        p.CreationDate, 
        p.Score, 
        p.ViewCount, 
        u.DisplayName AS OwnerDisplayName, 
        u.Reputation,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostType,
        COUNT(v.Id) OVER (PARTITION BY p.Id) AS VoteCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) OVER (PARTITION BY p.Id) AS UpvoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) OVER (PARTITION BY p.Id) AS DownvoteCount
    FROM 
        Posts p
    JOIN 
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    WHERE 
        p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
),
PostTags AS (
    SELECT 
        p.Id AS PostId, 
        string_to_array(substring(p.Tags, 2, length(p.Tags)-2), ''><'') AS Tags
    FROM 
        Posts p
),
TaggedPosts AS (
    SELECT 
        pt.PostId, 
        t.TagName
    FROM 
        PostTags pt
    CROSS JOIN 
        unnest(pt.Tags) AS TagName
    JOIN 
        Tags t ON TagName = t.TagName
),
BadgeCounts AS (
    SELECT 
        u.Id AS UserId, 
        COUNT(b.Id) AS BadgeCount
    FROM 
        Users u
    JOIN 
        Badges b ON u.Id = b.UserId
    GROUP BY 
        u.Id
)
SELECT 
    rp.Id, 
    rp.Title, 
    rp.CreationDate, 
    rp.Score, 
    rp.ViewCount, 
    rp.OwnerDisplayName, 
    rp.Reputation, 
    rp.PostType, 
    rp.VoteCount, 
    rp.UpvoteCount, 
    rp.DownvoteCount, 
    COALESCE(bc.BadgeCount, 0) AS BadgeCount,
    ARRAY_AGG(tp.TagName) AS Tags
FROM 
    RecentPosts rp
LEFT JOIN 
    TaggedPosts tp ON rp.Id = tp.PostId
LEFT JOIN 
    BadgeCounts bc ON rp.OwnerUserId = bc.UserId
GROUP BY 
    rp.Id, rp.Title, rp.CreationDate, rp.Score, rp.ViewCount, rp.OwnerDisplayName, rp.Reputation, rp.PostType, rp.VoteCount, rp.UpvoteCount, rp.DownvoteCount, bc.BadgeCount
ORDER BY 
    rp.CreationDate DESC, 
    rp.Score DESC, 
    rp.ViewCount DESC
LIMIT 100;