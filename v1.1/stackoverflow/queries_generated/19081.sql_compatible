WITH QuestionBase AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.OwnerUserId,
        p.CreationDate AS QuestionCreationDate,
        p.ViewCount AS QuestionViewCount,
        p.Score AS QuestionScore,
        p.Tags,
        p.AcceptedAnswerId,
        p.AnswerCount,
        p.CommentCount AS QuestionCommentCount,
        p.FavoriteCount AS QuestionFavoriteCount,
        ((LOWER(p.Title) LIKE '%sql%' OR LOWER(p.Title) LIKE '%database%' OR LOWER(p.Body) LIKE '%transaction%')
        AND LOWER(p.Title) NOT LIKE '%nosql%'
        AND LOWER(p.Body) NOT LIKE '%mongodb%') AS IsSqlRelated,
        CASE
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Accepted'
            WHEN p.AnswerCount > 0 AND p.AcceptedAnswerId IS NULL THEN 'Unaccepted (Has Answers)'
            ELSE 'No Answer Yet'
        END AS AcceptanceStatus
    FROM
        Posts p
    WHERE
        p.PostTypeId = 1
        AND p.CreationDate >= DATE '2021-01-01'
        AND p.ViewCount > 750
        AND p.OwnerUserId IS NOT NULL
),
UserActivitySummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views AS UserProfileViews,
        u.UpVotes AS UserUpVotes,
        u.DownVotes AS UserDownVotes,
        u.Location,
        u.CreationDate AS UserCreationDate,
        CASE WHEN (u.UpVotes + u.DownVotes) = 0 THEN NULL ELSE CAST(u.UpVotes AS NUMERIC) / (u.UpVotes + u.DownVotes) END AS UpVoteRatio,
        (SELECT COUNT(b.Id) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadgeCount
    FROM
        Users u
    WHERE u.Reputation > 500
),
AnswerAndCommentAnalysis AS (
    SELECT
        qb.QuestionId,
        qb.AcceptedAnswerId,
        qb.QuestionScore,
        a.Id AS AcceptedAnswerPostId,
        a.Score AS AcceptedAnswerScore,
        a.CreationDate AS AcceptedAnswerCreationDate,
        LENGTH(a.Body) AS AcceptedAnswerBodyLength,
        -- For ranking, we need to compute per-question values; use sub-aggregation for counts and max score/creation for ordering deterministically in window.
        COUNT(DISTINCT a_all.Id) AS TotalAnswersForQuestion,
        SUM(COALESCE(qc.Score, 0)) AS TotalQuestionCommentScore,
        SUBSTRING(STRING_AGG(qc.Text, ' || ' ORDER BY qc.Score DESC), 1, 500) AS TopQuestionCommentsExcerpt,
        -- Provide values needed for window ranking by computing max score and earliest creation for top answer tie-breaker per question.
        MAX(a_all.Score) AS MaxAnswerScoreForQuestion,
        MIN(a_all.CreationDate) FILTER (WHERE a_all.Score = MAX(a_all.Score) OVER (PARTITION BY qb.QuestionId)) AS EarliestTopAnswerCreationDate
    FROM
        QuestionBase qb
    LEFT JOIN Posts a ON qb.AcceptedAnswerId = a.Id AND a.PostTypeId = 2
    LEFT JOIN Posts a_all ON qb.QuestionId = a_all.ParentId AND a_all.PostTypeId = 2
    LEFT JOIN Comments qc ON qb.QuestionId = qc.PostId
    GROUP BY
        qb.QuestionId, qb.AcceptedAnswerId, qb.QuestionScore, a.Id, a.Score, a.CreationDate, LENGTH(a.Body)
),
-- Separate CTE to compute AnswerRankByScore per question using a deterministic ordering, referencing Posts directly.
AnswerRanks AS (
    SELECT
        pa.ParentId AS QuestionId,
        pa.Id AS AnswerId,
        pa.Score,
        pa.CreationDate,
        RANK() OVER (PARTITION BY pa.ParentId ORDER BY pa.Score DESC, pa.CreationDate ASC) AS AnswerRankByScore
    FROM Posts pa
    WHERE pa.PostTypeId = 2
),
PostHistoryTimeline AS (
    SELECT
        qb.QuestionId,
        COUNT(ph.Id) AS TotalHistoryEvents,
        COUNT(DISTINCT ph.UserId) AS DistinctHistoryEditors,
        MAX(ph.CreationDate) AS LastHistoryEditDate,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS WasEverClosed,
        MAX(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS WasEverReopened,
        DATE_PART('day', MAX(ph.CreationDate) - MIN(ph.CreationDate)) AS DaysBetweenFirstAndLastEdit
    FROM
        QuestionBase qb
    JOIN PostHistory ph ON qb.QuestionId = ph.PostId
    WHERE
        ph.PostHistoryTypeId IN (1,2,3,4,5,6,10,11,12,13)
    GROUP BY
        qb.QuestionId
),
TagPerformance AS (
    SELECT
        tag AS TagName,
        COUNT(DISTINCT qb.QuestionId) AS QuestionsWithTag,
        AVG(qb.QuestionScore) AS AvgQuestionScoreForTag,
        AVG(qb.QuestionViewCount) AS AvgQuestionViewCountForTag,
        MAX(CASE WHEN t.IsModeratorOnly = TRUE THEN 1 ELSE 0 END) AS IsModeratorOnlyTag,
        MAX(CASE WHEN t.IsRequired = TRUE THEN 1 ELSE 0 END) AS IsRequiredTag
    FROM
        QuestionBase qb,
        LATERAL (
            SELECT UNNEST(string_to_array(SUBSTRING(qb.Tags, 2, LENGTH(qb.Tags) - 2), '><')) AS tag
        ) tag_tbl
    LEFT JOIN Tags t ON tag_tbl.tag = t.TagName
    WHERE qb.Tags IS NOT NULL AND LENGTH(qb.Tags) > 2
    GROUP BY tag
),
ClassifiedQuestions AS (
    SELECT
        qb.QuestionId,
        qb.Title,
        qb.QuestionCreationDate,
        qb.QuestionScore,
        qb.QuestionViewCount,
        qb.Tags,
        qb.AcceptanceStatus,
        qb.IsSqlRelated,
        uas.DisplayName AS OwnerDisplayName,
        uas.Reputation AS OwnerReputation,
        uas.UpVoteRatio AS OwnerUpVoteRatio,
        uas.GoldBadgeCount AS OwnerGoldBadges,
        aca.AcceptedAnswerScore,
        aca.AcceptedAnswerBodyLength,
        aca.TotalAnswersForQuestion,
        ar.AnswerRankByScore,
        aca.TotalQuestionCommentScore,
        ph.TotalHistoryEvents,
        ph.DistinctHistoryEditors,
        ph.WasEverClosed,
        ph.WasEverReopened,
        ph.DaysBetweenFirstAndLastEdit,
        tp_primary.QuestionsWithTag AS PrimaryTagQuestionCount,
        tp_primary.AvgQuestionScoreForTag AS PrimaryTagAvgScore,
        tp_primary.IsModeratorOnlyTag AS PrimaryTagIsModeratorOnly,
        (qb.QuestionScore * 0.6 + qb.QuestionViewCount * 0.05 + COALESCE(qb.QuestionFavoriteCount, 0) * 2 + aca.TotalQuestionCommentScore * 0.4)
        * (1 + COALESCE(uas.UpVoteRatio, 0.5)) AS CombinedEngagementScore,
        'High Engagement & SQL-Related' AS ClassificationType,
        NULLIF(SUBSTRING(qb.Tags, 2, LENGTH(qb.Tags) - 2), '') AS FormattedTags,
        qb.QuestionCommentCount
    FROM
        QuestionBase qb
    LEFT JOIN UserActivitySummary uas ON qb.OwnerUserId = uas.UserId
    LEFT JOIN AnswerAndCommentAnalysis aca ON qb.QuestionId = aca.QuestionId
    LEFT JOIN PostHistoryTimeline ph ON qb.QuestionId = ph.QuestionId
    LEFT JOIN TagPerformance tp_primary ON (string_to_array(SUBSTRING(qb.Tags, 2, LENGTH(qb.Tags) - 2), '><'))[1] = tp_primary.TagName
    LEFT JOIN AnswerRanks ar ON qb.QuestionId = ar.QuestionId AND ar.AnswerId = coa_sub.accepted_or_top_answer_id
    LEFT JOIN LATERAL (
        -- determine a representative answer id for the AcceptedAnswerId if exists, else top-ranked answer id for linking the rank value
        SELECT
            CASE WHEN qb.AcceptedAnswerId IS NOT NULL THEN qb.AcceptedAnswerId
                 ELSE (SELECT id FROM Posts p2 WHERE p2.ParentId = qb.QuestionId AND p2.PostTypeId = 2 ORDER BY p2.Score DESC, p2.CreationDate ASC LIMIT 1)
            END AS accepted_or_top_answer_id
    ) coa_sub ON TRUE
    WHERE
        qb.IsSqlRelated = TRUE
        AND qb.QuestionScore > 15
        AND qb.AnswerCount > 0
        AND (uas.Reputation IS NULL OR uas.Reputation > 2000)
        AND (ph.WasEverClosed = 0 OR ph.WasEverReopened = 1)
        AND aca.AcceptedAnswerScore IS NOT NULL AND aca.AcceptedAnswerScore > qb.QuestionScore * 0.7
        AND tp_primary.IsModeratorOnlyTag = 0
        AND ph.DaysBetweenFirstAndLastEdit IS NOT NULL AND ph.DaysBetweenFirstAndLastEdit < 365

    UNION ALL

    SELECT
        qb.QuestionId,
        qb.Title,
        qb.QuestionCreationDate,
        qb.QuestionScore,
        qb.QuestionViewCount,
        qb.Tags,
        qb.AcceptanceStatus,
        qb.IsSqlRelated,
        uas.DisplayName AS OwnerDisplayName,
        uas.Reputation AS OwnerReputation,
        uas.UpVoteRatio AS OwnerUpVoteRatio,
        uas.GoldBadgeCount AS OwnerGoldBadges,
        aca.AcceptedAnswerScore,
        aca.AcceptedAnswerBodyLength,
        aca.TotalAnswersForQuestion,
        ar.AnswerRankByScore,
        aca.TotalQuestionCommentScore,
        ph.TotalHistoryEvents,
        ph.DistinctHistoryEditors,
        ph.WasEverClosed,
        ph.WasEverReopened,
        ph.DaysBetweenFirstAndLastEdit,
        tp_primary.QuestionsWithTag AS PrimaryTagQuestionCount,
        tp_primary.AvgQuestionScoreForTag AS PrimaryTagAvgScore,
        tp_primary.IsModeratorOnlyTag AS PrimaryTagIsModeratorOnly,
        (qb.QuestionScore * 0.6 + qb.QuestionViewCount * 0.05 + COALESCE(qb.QuestionFavoriteCount, 0) * 2 + aca.TotalQuestionCommentScore * 0.4)
        * (1 + COALESCE(uas.UpVoteRatio, 0.5)) AS CombinedEngagementScore,
        'Emerging Potential' AS ClassificationType,
        NULLIF(SUBSTRING(qb.Tags, 2, LENGTH(qb.Tags) - 2), '') AS FormattedTags,
        qb.QuestionCommentCount
    FROM
        QuestionBase qb
    LEFT JOIN UserActivitySummary uas ON qb.OwnerUserId = uas.UserId
    LEFT JOIN AnswerAndCommentAnalysis aca ON qb.QuestionId = aca.QuestionId
    LEFT JOIN PostHistoryTimeline ph ON qb.QuestionId = ph.QuestionId
    LEFT JOIN TagPerformance tp_primary ON (string_to_array(SUBSTRING(qb.Tags, 2, LENGTH(qb.Tags) - 2), '><'))[1] = tp_primary.TagName
    LEFT JOIN LATERAL (
        SELECT UNNEST(string_to_array(SUBSTRING(qb.Tags, 2, LENGTH(qb.Tags) - 2), '><')) AS primary_tag
    ) first_tag ON TRUE
    LEFT JOIN AnswerRanks ar ON qb.QuestionId = ar.QuestionId AND ar.AnswerId = coa_sub2.accepted_or_top_answer_id
    LEFT JOIN LATERAL (
        SELECT
            CASE WHEN qb.AcceptedAnswerId IS NOT NULL THEN qb.AcceptedAnswerId
                 ELSE (SELECT id FROM Posts p2 WHERE p2.ParentId = qb.QuestionId AND p2.PostTypeId = 2 ORDER BY p2.Score DESC, p2.CreationDate ASC LIMIT 1)
            END AS accepted_or_top_answer_id
    ) coa_sub2 ON TRUE
    WHERE
        qb.IsSqlRelated = TRUE
        AND qb.QuestionScore <= 15
        AND qb.AcceptedAnswerId IS NULL
        AND qb.QuestionViewCount > 3000
        AND qb.QuestionCommentCount > 7
        AND NOT EXISTS (SELECT 1 FROM Posts a WHERE a.ParentId = qb.QuestionId AND a.PostTypeId = 2 AND a.Score > 75)
)
SELECT
    cq.QuestionId,
    cq.Title,
    cq.QuestionCreationDate,
    cq.QuestionScore,
    cq.QuestionViewCount,
    cq.FormattedTags,
    cq.AcceptanceStatus,
    cq.IsSqlRelated,
    cq.OwnerDisplayName,
    cq.OwnerReputation,
    cq.OwnerUpVoteRatio,
    cq.OwnerGoldBadges,
    cq.AcceptedAnswerScore,
    cq.AcceptedAnswerBodyLength,
    cq.TotalAnswersForQuestion,
    cq.AnswerRankByScore,
    cq.TotalQuestionCommentScore,
    cq.TotalHistoryEvents,
    cq.DistinctHistoryEditors,
    cq.WasEverClosed,
    cq.WasEverReopened,
    cq.DaysBetweenFirstAndLastEdit,
    cq.PrimaryTagQuestionCount,
    cq.PrimaryTagAvgScore,
    cq.PrimaryTagIsModeratorOnly,
    cq.CombinedEngagementScore,
    cq.ClassificationType,
    (COALESCE(cq.ClassificationType, 'Unclassified') || ' Question: "' || COALESCE(cq.Title, 'N/A Question') || '" by ' || COALESCE(cq.OwnerDisplayName, 'Community User')
    || ' (Score: ' || COALESCE(CAST(cq.QuestionScore AS VARCHAR), '0') || ', Views: ' || COALESCE(CAST(cq.QuestionViewCount AS VARCHAR), '0') || ')'
    || CASE WHEN cq.WasEverClosed = 1 AND cq.WasEverReopened = 0 THEN ' [CLOSED PERMANENTLY]'
            WHEN cq.WasEverClosed = 1 AND cq.WasEverReopened = 1 THEN ' [CLOSED & REOPENED]'
            ELSE '' END
    || CASE WHEN cq.AcceptedAnswerScore IS NOT NULL THEN ' [HAS ACCEPTED ANSWER (Score: ' || COALESCE(CAST(cq.AcceptedAnswerScore AS VARCHAR), 'N/A') || ')]' ELSE '' END) AS QuestionDetailedSummary,
    DENSE_RANK() OVER (ORDER BY cq.CombinedEngagementScore DESC, cq.QuestionCreationDate DESC) AS OverallRanking
FROM
    ClassifiedQuestions cq
WHERE
    cq.CombinedEngagementScore > 0
    AND (cq.OwnerReputation IS NULL OR cq.OwnerReputation > 500)
    AND cq.QuestionCommentCount >= 2
ORDER BY
    OverallRanking ASC, cq.QuestionCreationDate DESC
LIMIT 100;