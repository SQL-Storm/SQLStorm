-- {"query": "51066.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p2", "model": "grok-4-fast-non-reasoning", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2129, "output_tokens": 1451} 
WITH active_users AS (
  SELECT 
    u.Id AS user_id,
    u.Reputation,
    u.CreationDate AS user_creation_date,
    COUNT(DISTINCT p.Id) AS total_posts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS questions_asked,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS answers_given,
    AVG(p.Score) AS avg_post_score,
    SUM(COALESCE(v.BountyAmount, 0)) AS total_bounties_offered
  FROM Users u
  INNER JOIN Posts p ON p.OwnerUserId = u.Id 
    AND p.CreationDate >= u.CreationDate 
    AND p.CreationDate <= cast('2024-10-01 12:34:56' as timestamp)
  LEFT JOIN Votes v ON v.UserId = u.Id 
    AND v.VoteTypeId = 8 
    AND v.CreationDate >= u.CreationDate
  WHERE u.Reputation >= 100 
    AND u.CreationDate >= '2020-01-01'
  GROUP BY u.Id, u.Reputation, u.CreationDate
  HAVING COUNT(DISTINCT p.Id) >= 5
),
top_answerers AS (
  SELECT 
    au.user_id,
    au.questions_asked,
    SUM(p.Score) AS total_answer_score,
    COUNT(DISTINCT p.Id) AS accepted_answers,
    AVG(p.ViewCount) AS avg_answer_views
  FROM active_users au
  INNER JOIN Posts p ON p.OwnerUserId = au.user_id 
    AND p.PostTypeId = 2
    AND p.CreationDate >= au.user_creation_date
  LEFT JOIN Posts q ON p.ParentId = q.Id
  WHERE q.AcceptedAnswerId = p.Id OR p.Score > 5
  GROUP BY au.user_id, au.questions_asked
  HAVING SUM(p.Score) > 100
),
tag_performance AS (
  SELECT 
    t.TagName,
    COUNT(DISTINCT p.Id) AS question_count,
    AVG(p.Score) AS avg_question_score,
    SUM(p.AnswerCount) AS total_answers,
    AVG(p.ViewCount) AS avg_views,
    COUNT(DISTINCT CASE WHEN p.ClosedDate IS NOT NULL THEN p.Id END) AS closed_questions
  FROM Tags t
  INNER JOIN Posts p ON position(t.TagName IN p.Tags) > 0
    AND p.PostTypeId = 1
    AND p.CreationDate >= '2022-01-01'
  WHERE t.Count >= 100
  GROUP BY t.TagName
  HAVING COUNT(DISTINCT p.Id) >= 50
),
user_tag_expertise AS (
  SELECT 
    au.user_id,
    tp.TagName,
    COUNT(DISTINCT p.Id) AS questions_answered_in_tag,
    AVG(p.Score) AS avg_score_in_tag,
    SUM(CASE WHEN q.AcceptedAnswerId = p.Id THEN 1 ELSE 0 END) AS accepted_in_tag
  FROM active_users au
  INNER JOIN Posts p ON p.OwnerUserId = au.user_id 
    AND p.PostTypeId = 2
    AND p.CreationDate >= au.user_creation_date
  INNER JOIN Posts q ON p.ParentId = q.Id
  INNER JOIN tag_performance tp ON position(tp.TagName IN q.Tags) > 0
  WHERE p.Score > 0
  GROUP BY au.user_id, tp.TagName
  HAVING COUNT(DISTINCT p.Id) >= 3
),
recent_activity AS (
  SELECT 
    p.Id AS post_id,
    p.OwnerUserId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.CommentCount,
    ph.PostHistoryTypeId,
    ph.CreationDate AS history_date,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY ph.CreationDate DESC) AS activity_rank
  FROM Posts p
  INNER JOIN PostHistory ph ON ph.PostId = p.Id
    AND ph.PostHistoryTypeId IN (4, 5, 6, 10, 11, 24) -- Edits, Close/Reopen, Suggested Edits
  WHERE p.CreationDate >= '2023-01-01'
    AND p.PostTypeId IN (1, 2)
)
SELECT 
  au.user_id,
  u.DisplayName,
  au.Reputation,
  au.questions_asked,
  au.answers_given,
  ta.total_answer_score,
  ta.accepted_answers,
  ute.TagName AS top_expertise_tag,
  ute.avg_score_in_tag AS expertise_score,
  ute.accepted_in_tag,
  tp.avg_question_score AS tag_avg_score,
  ra.activity_rank,
  ra.comment_count AS recent_comments,
  CASE 
    WHEN au.total_bounties_offered > 0 THEN 'Bounty Hunter'
    WHEN ta.total_answer_score > 1000 THEN 'Power Answerer'
    WHEN au.reputation > 5000 THEN 'High Rep Contributor'
    ELSE 'Active User'
  END AS user_category,
  COUNT(DISTINCT pl.RelatedPostId) AS linked_posts,
  AVG(v.BountyAmount) AS avg_bounty_amount
FROM active_users au
INNER JOIN Users u ON u.Id = au.user_id
LEFT JOIN top_answerers ta ON ta.user_id = au.user_id
LEFT JOIN user_tag_expertise ute ON ute.user_id = au.user_id 
  AND ute.questions_answered_in_tag = (
    SELECT MAX(questions_answered_in_tag) 
    FROM user_tag_expertise sub_ute 
    WHERE sub_ute.user_id = au.user_id
  )
LEFT JOIN tag_performance tp ON tp.TagName = ute.TagName
LEFT JOIN recent_activity ra ON ra.OwnerUserId = au.user_id 
  AND ra.activity_rank <= 5
LEFT JOIN PostLinks pl ON pl.PostId = au.user_id OR pl.RelatedPostId IN (
  SELECT Id FROM Posts WHERE OwnerUserId = au.user_id
)
LEFT JOIN Votes v ON v.UserId = au.user_id 
  AND v.VoteTypeId = 8 
  AND v.CreationDate >= '2023-01-01'
WHERE au.user_creation_date >= '2021-01-01'
  AND (ta.total_answer_score > 50 OR au.reputation > 1000)
GROUP BY 
  au.user_id, u.DisplayName, au.Reputation, au.questions_asked, 
  au.answers_given, ta.total_answer_score, ta.accepted_answers,
  ute.TagName, ute.avg_score_in_tag, ute.accepted_in_tag,
  tp.avg_question_score, ra.activity_rank, ra.comment_count,
  au.total_bounties_offered, v.BountyAmount
HAVING AVG(v.BountyAmount) IS NULL OR AVG(v.BountyAmount) > 0
ORDER BY ta.total_answer_score DESC, au.reputation DESC
LIMIT 1000;