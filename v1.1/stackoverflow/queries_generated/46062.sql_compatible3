WITH TopQuestionAuthors AS (
    SELECT 
        p.OwnerUserId,
        COUNT(DISTINCT p.Id) AS question_count,
        AVG(p.Score) AS avg_score,
        SUM(p.ViewCount) AS total_views
    FROM Posts p
    WHERE p.PostTypeId = 1 
      AND p.CreationDate >= TIMESTAMP '2020-01-01'
      AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
    HAVING COUNT(DISTINCT p.Id) >= 10
),
AnswerMetrics AS (
    SELECT 
        a.ParentId AS question_id,
        a.OwnerUserId AS answerer_id,
        a.Id AS answer_id,
        a.Score AS answer_score,
        a.CreationDate AS answer_date,
        COUNT(DISTINCT c.Id) AS comment_count,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS answer_rank
    FROM Posts a
    LEFT JOIN Comments c ON c.PostId = a.Id
    WHERE a.PostTypeId = 2
      AND a.CreationDate >= TIMESTAMP '2020-01-01'
    GROUP BY a.ParentId, a.OwnerUserId, a.Id, a.Score, a.CreationDate
),
UserBadgeStats AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze_badges,
        COUNT(DISTINCT CASE WHEN b.TagBased = 1 THEN b.Name ELSE NULL END) AS unique_tag_badges
    FROM Badges b
    WHERE b.Date >= TIMESTAMP '2019-01-01'
    GROUP BY b.UserId
),
QuestionEngagement AS (
    SELECT 
        p.Id AS question_id,
        p.OwnerUserId,
        p.Score AS question_score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        CASE
          WHEN p.Tags IS NULL OR p.Tags = '' THEN NULL
          ELSE regexp_split_to_array(trim(BOTH '<>' FROM p.Tags), '><')
        END AS tag_array,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id ELSE NULL END) AS upvotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id ELSE NULL END) AS downvotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 5 THEN v.Id ELSE NULL END) AS favorites,
        COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 1 THEN pl.Id ELSE NULL END) AS linked_count,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 5 THEN ph.Id ELSE NULL END) AS edit_count,
        MAX(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS has_accepted_answer
    FROM Posts p
    LEFT JOIN Votes v ON v.PostId = p.Id
    LEFT JOIN PostLinks pl ON pl.PostId = p.Id
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= TIMESTAMP '2020-01-01'
    GROUP BY p.Id, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount, p.Tags, p.AcceptedAnswerId
)
SELECT 
    u.Id AS user_id,
    u.DisplayName,
    u.Reputation,
    u.Location,
    tqa.question_count,
    tqa.avg_score AS avg_question_score,
    tqa.total_views,
    COALESCE(ubs.gold_badges, 0) AS gold_badges,
    COALESCE(ubs.silver_badges, 0) AS silver_badges,
    COALESCE(ubs.bronze_badges, 0) AS bronze_badges,
    COALESCE(ubs.unique_tag_badges, 0) AS unique_tag_badges,
    COUNT(DISTINCT qe.question_id) AS detailed_questions,
    AVG(qe.question_score) AS avg_detailed_score,
    SUM(qe.ViewCount) AS sum_views,
    AVG(qe.AnswerCount) AS avg_answers_per_question,
    SUM(qe.upvotes) AS total_upvotes,
    SUM(qe.downvotes) AS total_downvotes,
    SUM(qe.linked_count) AS total_links,
    SUM(qe.edit_count) AS total_edits,
    SUM(qe.has_accepted_answer) AS questions_with_accepted_answers,
    COUNT(DISTINCT CASE WHEN am.answer_rank = 1 THEN am.answer_id ELSE NULL END) AS top_ranked_answers,
    AVG(CASE WHEN am.answer_rank <= 3 THEN am.answer_score ELSE NULL END) AS avg_top3_answer_score,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY qe.ViewCount) AS median_view_count,
    STRING_AGG(DISTINCT t.TagName, ', ' ORDER BY t.TagName) FILTER (WHERE t.Count > 1000) AS popular_tags_used
FROM TopQuestionAuthors tqa
JOIN Users u ON u.Id = tqa.OwnerUserId
LEFT JOIN UserBadgeStats ubs ON ubs.UserId = u.Id
LEFT JOIN QuestionEngagement qe ON qe.OwnerUserId = u.Id
LEFT JOIN AnswerMetrics am ON am.answerer_id = u.Id
LEFT JOIN LATERAL (
    SELECT DISTINCT unnest(qe.tag_array) AS tag_name
) tag_unnest ON TRUE
LEFT JOIN Tags t ON t.TagName = tag_unnest.tag_name
WHERE u.Reputation >= 1000
  AND tqa.question_count >= 10
GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location, tqa.question_count, tqa.avg_score, tqa.total_views, ubs.gold_badges, ubs.silver_badges, ubs.bronze_badges, ubs.unique_tag_badges
HAVING COUNT(DISTINCT qe.question_id) >= 5
ORDER BY u.Reputation DESC, tqa.total_views DESC
LIMIT 100;