WITH ActiveUsers AS (
    SELECT 
        u.Id, 
        u.DisplayName, 
        COUNT(p.Id) AS PostCount, 
        SUM(COALESCE(v.score, 0)) AS TotalScore
    FROM 
        Users u
    LEFT JOIN 
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN 
        Votes v ON p.Id = v.PostId
    WHERE 
        u.CreationDate BETWEEN DATE '2022-01-01' AND DATE '2023-01-01'
    GROUP BY 
        u.Id, u.DisplayName
    HAVING 
        COUNT(p.Id) > 10 AND SUM(COALESCE(v.score, 0)) > 50
),
PostActivity AS (
    SELECT 
        p.Id AS PostId, 
        p.Title, 
        p.ViewCount, 
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question' 
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostType,
        -- parse tags like '<tag1><tag2>' into rows and re-aggregate with prefix '#'
        '#' || STRING_AGG(DISTINCT t.TagName, ', #') AS TagsUsed,
        p.CreationDate,
        p.OwnerUserId
    FROM 
        Posts p
    LEFT JOIN LATERAL (
        -- split tags string '<a><b>' into rows: tag
        SELECT TRIM(tag) AS TagName
        FROM (
            SELECT UNNEST(STRING_TO_ARRAY(
                SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><'
            )) AS tag
        ) s
    ) t ON TRUE
    WHERE 
        p.CreationDate >= (SELECT MIN(CreationDate) FROM ActiveUsers)
    GROUP BY 
        p.Id, p.Title, p.PostTypeId, p.ViewCount, p.CreationDate, p.OwnerUserId
    HAVING 
        p.ViewCount > 1000
)
SELECT 
    u.DisplayName, 
    SUM(ap.ViewCount) AS TotalViews,
    STRING_AGG(ap.Title, '; ') AS PopularPosts
FROM 
    ActiveUsers u
JOIN 
    PostActivity ap ON u.Id = ap.OwnerUserId
GROUP BY 
    u.Id, u.DisplayName
ORDER BY 
    TotalViews DESC;