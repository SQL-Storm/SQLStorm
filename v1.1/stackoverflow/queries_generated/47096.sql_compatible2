WITH RECURSIVE tag_hierarchy AS (
    SELECT 
        t.Id,
        t.TagName,
        COUNT(DISTINCT pt.PostId) as direct_posts,
        0 as level
    FROM Tags t
    INNER JOIN (
        SELECT p.Id as PostId, unnest(string_to_array(substring(Tags, 2, length(Tags)-2), '><')) as tag
        FROM Posts p
        WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    ) pt ON pt.tag = t.TagName
    GROUP BY t.Id, t.TagName
    HAVING COUNT(DISTINCT pt.PostId) > 100
),
user_expertise AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        th.TagName,
        COUNT(DISTINCT p.Id) as answers_in_tag,
        SUM(p.Score) as total_score_in_tag,
        AVG(p.Score) as avg_score_in_tag,
        COUNT(DISTINCT CASE WHEN p.Id = q.AcceptedAnswerId THEN p.Id END) as accepted_answers,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY p.Score) as median_score,
        DENSE_RANK() OVER (PARTITION BY th.TagName ORDER BY SUM(p.Score) DESC) as rank_in_tag
    FROM Users u
    INNER JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 2
    INNER JOIN Posts q ON p.ParentId = q.Id
    INNER JOIN tag_hierarchy th ON q.Tags LIKE '%' || '<' || th.TagName || '>' || '%'
    WHERE u.Reputation > 1000
        AND p.Score > 0
        AND p.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '2 years'
    GROUP BY u.Id, u.DisplayName, u.Reputation, th.TagName
    HAVING COUNT(DISTINCT p.Id) >= 5
),
post_quality_metrics AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.ClosedDate,
        COUNT(DISTINCT c.Id) as comment_count,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) as upvotes,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) as downvotes,
        COUNT(DISTINCT ph.Id) FILTER (WHERE ph.PostHistoryTypeId IN (4,5,6)) as edit_count,
        MAX(CASE WHEN ph.PostHistoryTypeId = 52 THEN 1 ELSE 0 END) as was_hot_question,
        EXTRACT(EPOCH FROM (COALESCE(p.ClosedDate, CAST('2024-10-01 12:34:56' AS timestamp)) - p.CreationDate))/3600 as hours_until_closed,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_post_score,
        LEAD(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as next_post_score
    FROM Posts p
    LEFT JOIN Comments c ON c.PostId = p.Id
    LEFT JOIN Votes v ON v.PostId = p.Id
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id
    WHERE p.PostTypeId = 1
        AND p.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '1 year'
    GROUP BY p.Id, p.OwnerUserId, p.Score, p.ViewCount, p.CreationDate, p.ClosedDate
),
badge_velocity AS (
    SELECT 
        b.UserId,
        DATE_TRUNC('month', b.Date) as badge_month,
        COUNT(*) FILTER (WHERE b.Class = 1) as gold_badges,
        COUNT(*) FILTER (WHERE b.Class = 2) as silver_badges,
        COUNT(*) FILTER (WHERE b.Class = 3) as bronze_badges,
        COUNT(*) FILTER (WHERE CAST(b.TagBased AS integer) = 1) as tag_badges,
        SUM(COUNT(*)) OVER (PARTITION BY b.UserId ORDER BY DATE_TRUNC('month', b.Date) 
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as cumulative_badges,
        ROW_NUMBER() OVER (PARTITION BY b.UserId ORDER BY DATE_TRUNC('month', b.Date)) as month_number
    FROM Badges b
    WHERE b.Date >= CAST('2024-10-01' AS date) - INTERVAL '2 years'
    GROUP BY b.UserId, DATE_TRUNC('month', b.Date)
)
SELECT 
    ue.TagName,
    ue.DisplayName,
    ue.Reputation,
    ue.answers_in_tag,
    ue.total_score_in_tag,
    ue.avg_score_in_tag,
    ue.accepted_answers,
    ue.median_score,
    ue.rank_in_tag,
    COALESCE(AVG(pqm.Score), 0) as avg_question_score,
    COALESCE(AVG(pqm.ViewCount), 0) as avg_question_views,
    COALESCE(AVG(pqm.comment_count), 0) as avg_comments_per_question,
    COALESCE(SUM(pqm.was_hot_question), 0) as hot_questions_count,
    COALESCE(AVG(pqm.hours_until_closed) FILTER (WHERE pqm.hours_until_closed IS NOT NULL), 0) as avg_hours_until_closed,
    COALESCE(AVG(bv.cumulative_badges), 0) as avg_cumulative_badges,
    COALESCE(SUM(bv.gold_badges), 0) as total_gold_badges,
    COALESCE(SUM(bv.tag_badges), 0) as total_tag_badges,
    STRING_AGG(
        CASE WHEN ue.rank_in_tag <= 3 
             THEN ue.TagName || ':' || CAST(ue.rank_in_tag AS text)
             ELSE NULL
        END, ', ' ORDER BY ue.rank_in_tag
    ) as top_3_expertise_tags,
    PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY ue.total_score_in_tag) OVER (PARTITION BY ue.TagName) as p90_score_in_tag,
    STDDEV(pqm.Score) OVER (PARTITION BY ue.UserId) as score_variance,
    CASE 
        WHEN ue.avg_score_in_tag > 10 AND ue.accepted_answers > 5 THEN 'Expert'
        WHEN ue.avg_score_in_tag > 5 AND ue.accepted_answers > 2 THEN 'Advanced'
        WHEN ue.avg_score_in_tag > 2 THEN 'Intermediate'
        ELSE 'Beginner'
    END as expertise_level,
    ue.UserId
FROM user_expertise ue
LEFT JOIN post_quality_metrics pqm ON pqm.OwnerUserId = ue.UserId
LEFT JOIN badge_velocity bv ON bv.UserId = ue.UserId
WHERE ue.rank_in_tag <= 10
GROUP BY 
    ue.TagName, ue.UserId, ue.DisplayName, ue.Reputation, 
    ue.answers_in_tag, ue.total_score_in_tag, ue.avg_score_in_tag,
    ue.accepted_answers, ue.median_score, ue.rank_in_tag
HAVING COUNT(DISTINCT pqm.Id) > 0
ORDER BY 
    ue.TagName, 
    ue.rank_in_tag,
    ue.total_score_in_tag DESC
LIMIT 500;