WITH TopUsers AS (
    SELECT u.Id, u.DisplayName, u.Reputation, u.CreationDate,
           ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.CreationDate ASC) AS rn
    FROM Users u
    WHERE u.Reputation > 10000
),
UserBadgesSummary AS (
    SELECT b.UserId,
           SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
           SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
           SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
           COUNT(*) AS TotalBadges,
           MAX(b.Date) AS LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
UserPosts AS (
    SELECT p.OwnerUserId AS UserId,
           SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsCount,
           SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersCount,
           AVG(p.Score) AS AvgPostScore,
           MAX(p.CreationDate) AS LastPostDate,
           COUNT(DISTINCT p.Id) AS TotalPosts
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL AND p.OwnerUserId != -1
    GROUP BY p.OwnerUserId
),
TagUsage AS (
    SELECT tag AS TagName,
           COUNT(*) AS TagCount
    FROM (
        SELECT TRIM(t) AS tag
        FROM Posts p,
             UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR (LENGTH(p.Tags) - 2)), '><')) AS t
        WHERE p.PostTypeId = 1
    ) x
    GROUP BY tag
),
UserTopTags AS (
    SELECT p.OwnerUserId AS UserId,
           tag AS TagName
    FROM Posts p,
         UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR (LENGTH(p.Tags) - 2)), '><')) AS tag
    WHERE p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL AND p.OwnerUserId != -1
),
UserTagCounts AS (
    SELECT ut.UserId, ut.TagName, COUNT(*) AS TagUsageCount,
           ROW_NUMBER() OVER (PARTITION BY ut.UserId ORDER BY COUNT(*) DESC, ut.TagName) AS TagRank
    FROM UserTopTags ut
    GROUP BY ut.UserId, ut.TagName
),
AnswersWithAcceptedInfo AS (
    SELECT a.Id AS AnswerId, a.ParentId AS QuestionId, a.Score AS AnswerScore,
           q.Score AS QuestionScore, q.ViewCount AS QuestionViews,
           CASE WHEN q.AcceptedAnswerId = a.Id THEN 1 ELSE 0 END AS IsAccepted
    FROM Posts a
    JOIN Posts q ON a.ParentId = q.Id
    WHERE a.PostTypeId = 2 AND q.PostTypeId = 1
),
UserAnswerStats AS (
    SELECT p.OwnerUserId AS UserId,
           COUNT(*) AS TotalAnswers,
           SUM(CASE WHEN aw.IsAccepted = 1 THEN 1 ELSE 0 END) AS AcceptedAnswers,
           AVG(aw.AnswerScore) AS AvgAnswerScore,
           AVG(aw.QuestionScore) AS AvgQuestionScoreForAnswers,
           AVG(aw.QuestionViews) AS AvgQuestionViewsForAnswers
    FROM Posts p
    JOIN AnswersWithAcceptedInfo aw ON p.Id = aw.AnswerId
    WHERE p.PostTypeId = 2 AND p.OwnerUserId IS NOT NULL AND p.OwnerUserId != -1
    GROUP BY p.OwnerUserId
),
UserVoteStats AS (
    SELECT p.OwnerUserId AS UserId,
           SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesReceived,
           SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesReceived,
           SUM(CASE WHEN v.VoteTypeId = 1 THEN 1 ELSE 0 END) AS AcceptedByOriginatorVotes,
           COUNT(DISTINCT v.UserId) AS UniqueVoters
    FROM Votes v
    JOIN Posts p ON v.PostId = p.Id
    WHERE p.OwnerUserId IS NOT NULL AND p.OwnerUserId != -1
    GROUP BY p.OwnerUserId
),
Top3TagsPerUser AS (
    SELECT utc.UserId,
           MAX(CASE WHEN utc.TagRank = 1 THEN utc.TagName END) AS TopTag1,
           MAX(CASE WHEN utc.TagRank = 2 THEN utc.TagName END) AS TopTag2,
           MAX(CASE WHEN utc.TagRank = 3 THEN utc.TagName END) AS TopTag3
    FROM UserTagCounts utc
    WHERE utc.TagRank <= 3
    GROUP BY utc.UserId
)
SELECT
    tu.Id AS UserId,
    tu.DisplayName,
    tu.Reputation,
    COALESCE(ubs.GoldBadges, 0) AS GoldBadges,
    COALESCE(ubs.SilverBadges, 0) AS SilverBadges,
    COALESCE(ubs.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(ubs.TotalBadges, 0) AS TotalBadges,
    COALESCE(ups.QuestionsCount, 0) AS QuestionsCount,
    COALESCE(ups.AnswersCount, 0) AS AnswersCount,
    COALESCE(ups.AvgPostScore, 0) AS AvgPostScore,
    COALESCE(ans.TotalAnswers, 0) AS TotalAnswers,
    COALESCE(ans.AcceptedAnswers, 0) AS AcceptedAnswers,
    COALESCE(ans.AvgAnswerScore, 0) AS AvgAnswerScore,
    COALESCE(ans.AvgQuestionScoreForAnswers, 0) AS AvgQuestionScoreForAnswers,
    COALESCE(ans.AvgQuestionViewsForAnswers, 0) AS AvgQuestionViewsForAnswers,
    COALESCE(uvs.UpVotesReceived, 0) AS UpVotesReceived,
    COALESCE(uvs.DownVotesReceived, 0) AS DownVotesReceived,
    COALESCE(uvs.AcceptedByOriginatorVotes, 0) AS AcceptedByOriginatorVotes,
    COALESCE(uvs.UniqueVoters, 0) AS UniqueVoters,
    (CASE
       WHEN t3.TopTag1 IS NULL AND t3.TopTag2 IS NULL AND t3.TopTag3 IS NULL THEN ARRAY[]::TEXT[]
       ELSE ( -- build array and filter out nulls using standard SQL/portable approach
         (SELECT ARRAY_AGG(tag) FROM (
             SELECT t FROM (VALUES (t3.TopTag1), (t3.TopTag2), (t3.TopTag3)) AS v(t)
             WHERE t IS NOT NULL
         ) sub)
       )
     END) AS Top3Tags
FROM TopUsers tu
LEFT JOIN UserBadgesSummary ubs ON tu.Id = ubs.UserId
LEFT JOIN UserPosts ups ON tu.Id = ups.UserId
LEFT JOIN UserAnswerStats ans ON tu.Id = ans.UserId
LEFT JOIN UserVoteStats uvs ON tu.Id = uvs.UserId
LEFT JOIN Top3TagsPerUser t3 ON tu.Id = t3.UserId
ORDER BY tu.Reputation DESC, tu.DisplayName
LIMIT 50;