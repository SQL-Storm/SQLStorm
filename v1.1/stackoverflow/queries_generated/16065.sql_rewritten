-- {"query": "16065.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "claude-4.5-sonnet", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 154110, "output_tokens": 142428} 
WITH RECURSIVE user_influence_metrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COALESCE(SUM(p.Score), 0) AS total_post_score,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS question_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answer_count,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS rep_rank,
        PERCENT_RANK() OVER (ORDER BY u.Reputation) AS rep_percentile
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= '2020-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
tag_expertise AS (
    SELECT 
        p.OwnerUserId,
        UNNEST(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) AS tag_name,
        COUNT(*) AS tag_post_count,
        AVG(p.Score) AS avg_tag_score,
        SUM(CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS accepted_questions
    FROM Posts p
    WHERE p.PostTypeId = 1 
        AND p.Tags IS NOT NULL 
        AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId, tag_name
    HAVING COUNT(*) >= 5
),
ranked_expertise AS (
    SELECT 
        te.*,
        DENSE_RANK() OVER (PARTITION BY te.OwnerUserId ORDER BY te.avg_tag_score DESC, te.tag_post_count DESC) AS expertise_rank,
        LAG(te.avg_tag_score, 1) OVER (PARTITION BY te.OwnerUserId ORDER BY te.avg_tag_score DESC) AS prev_tag_score,
        LEAD(te.tag_post_count, 1) OVER (PARTITION BY te.OwnerUserId ORDER BY te.tag_post_count DESC) AS next_tag_count
    FROM tag_expertise te
),
badge_achievements AS (
    SELECT 
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS gold_badges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS silver_badges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS bronze_badges,
        STRING_AGG(DISTINCT CASE WHEN b.Class = 1 THEN b.Name END, ', ' ORDER BY CASE WHEN b.Class = 1 THEN b.Name END) AS gold_badge_names,
        MAX(b.Date) - MIN(b.Date) AS badge_earning_span
    FROM Badges b
    GROUP BY b.UserId
),
interaction_patterns AS (
    SELECT 
        c.UserId,
        COUNT(DISTINCT c.PostId) AS commented_posts,
        AVG(c.Score) AS avg_comment_score,
        COUNT(*) FILTER (WHERE c.Text ILIKE '%thank%' OR c.Text ILIKE '%thanks%') AS grateful_comments,
        MAX(LENGTH(c.Text)) AS longest_comment_length,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY c.Score) AS median_comment_score
    FROM Comments c
    WHERE c.UserId IS NOT NULL
        AND c.CreationDate >= '2019-01-01'
    GROUP BY c.UserId
),
post_evolution AS (
    SELECT 
        ph.PostId,
        ph.UserId AS editor_id,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (4, 5, 6)) AS edit_count,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (7, 8, 9)) AS rollback_count,
        MAX(ph.CreationDate) AS last_edit_date,
        STRING_AGG(DISTINCT NULLIF(ph.Comment, ''), ' | ' ORDER BY NULLIF(ph.Comment, '')) AS edit_summary
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)
    GROUP BY ph.PostId, ph.UserId
)
SELECT 
    uim.DisplayName,
    COALESCE(uim.Reputation, 0) AS reputation,
    uim.question_count,
    uim.answer_count,
    ROUND(uim.total_post_score::numeric / NULLIF(uim.question_count + uim.answer_count, 0), 2) AS avg_post_score,
    uim.rep_rank,
    ROUND(uim.rep_percentile::numeric, 4) AS reputation_percentile,
    COALESCE(ba.gold_badges, 0) + COALESCE(ba.silver_badges, 0) * 0.5 + COALESCE(ba.bronze_badges, 0) * 0.25 AS weighted_badge_score,
    COALESCE(ba.gold_badge_names, 'None') AS top_achievements,
    EXTRACT(DAY FROM COALESCE(ba.badge_earning_span, INTERVAL '0 days')) AS badge_span_days,
    re.tag_name AS primary_expertise_tag,
    re.tag_post_count AS expertise_post_count,
    ROUND(re.avg_tag_score::numeric, 2) AS expertise_avg_score,
    COALESCE(re.prev_tag_score - re.avg_tag_score, 0) AS score_diff_from_prev,
    ip.commented_posts,
    COALESCE(ip.avg_comment_score, 0) AS avg_comment_score,
    ip.grateful_comments,
    ROUND(ip.grateful_comments::numeric / NULLIF(ip.commented_posts, 0) * 100, 2) AS gratitude_percentage,
    pe.edit_count,
    pe.rollback_count,
    CASE 
        WHEN pe.rollback_count > pe.edit_count * 0.3 THEN 'High Controversy'
        WHEN pe.edit_count > 10 THEN 'Active Editor'
        WHEN pe.edit_count IS NULL THEN 'No Edits'
        ELSE 'Normal'
    END AS editor_profile,
    (SELECT COUNT(*) 
     FROM Posts p2 
     WHERE p2.OwnerUserId = uim.Id 
       AND p2.PostTypeId = 2 
       AND EXISTS (
           SELECT 1 FROM Posts q 
           WHERE q.Id = p2.ParentId 
             AND q.AcceptedAnswerId = p2.Id
       )) AS accepted_answer_count,
    (SELECT AVG(v.BountyAmount) 
     FROM Votes v 
     WHERE v.UserId = uim.Id 
       AND v.VoteTypeId = 8 
       AND v.BountyAmount IS NOT NULL) AS avg_bounty_offered,
    EXTRACT(YEAR FROM AGE(cast('2024-10-01 12:34:56' as timestamp), uim.CreationDate)) * 12 + 
    EXTRACT(MONTH FROM AGE(cast('2024-10-01 12:34:56' as timestamp), uim.CreationDate)) AS account_age_months,
    CASE 
        WHEN uim.rep_percentile > 0.95 AND ba.gold_badges > 5 THEN 'Elite Contributor'
        WHEN uim.rep_percentile > 0.80 AND re.avg_tag_score > 10 THEN 'Domain Expert'
        WHEN ip.commented_posts > 100 AND ip.avg_comment_score > 2 THEN 'Community Engager'
        WHEN pe.edit_count > 20 THEN 'Content Curator'
        ELSE 'Regular Member'
    END AS contributor_archetype
FROM user_influence_metrics uim
LEFT JOIN badge_achievements ba ON uim.Id = ba.UserId
LEFT JOIN ranked_expertise re ON uim.Id = re.OwnerUserId AND re.expertise_rank = 1
LEFT JOIN interaction_patterns ip ON uim.Id = ip.UserId
LEFT JOIN post_evolution pe ON uim.Id = pe.editor_id
WHERE uim.question_count + uim.answer_count >= 10
    AND (ba.gold_badges > 0 OR ba.silver_badges > 2 OR uim.Reputation > 5000)
    AND NOT EXISTS (
        SELECT 1 FROM Votes v 
        WHERE v.UserId = uim.Id 
          AND v.VoteTypeId IN (4, 12)
        HAVING COUNT(*) > 5
    )
ORDER BY 
    CASE 
        WHEN uim.rep_percentile > 0.9 THEN 1
        WHEN ba.gold_badges > 3 THEN 2
        WHEN re.avg_tag_score > 15 THEN 3
        ELSE 4
    END,
    uim.Reputation DESC,
    uim.total_post_score DESC
LIMIT 500;