-- {"query": "25004.sql", "dataset": "stackoverflow", "version": "v1.1", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 1827} 
WITH UserPostStats AS (
    SELECT 
        u.Id                                 AS UserId,
        u.DisplayName,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        SUM(p.Score) FILTER (WHERE p.PostTypeId = 1) AS QuestionScoreSum,
        SUM(p.Score) FILTER (WHERE p.PostTypeId = 2) AS AnswerScoreSum,
        MAX(p.CreationDate)                  AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
BadgeAgg AS (
    SELECT 
        b.UserId,
        COUNT(*)                                   AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        STRING_AGG(DISTINCT b.Name, ',')           AS BadgeList
    FROM Badges b
    GROUP BY b.UserId
),
TopVotes AS (
    SELECT 
        v.PostId,
        ROW_NUMBER() OVER (PARTITION BY v.PostId ORDER BY v.CreationDate DESC) AS rn,
        v.VoteTypeId,
        v.UserId                                   AS VoterId,
        v.CreationDate
    FROM Votes v
    WHERE v.VoteTypeId IN (2,3)          -- up-mod / down-mod
),
PostTagInfo AS (
    SELECT 
        p.Id                                      AS PostId,
        COALESCE(string_agg(t.TagName, '><'), '') AS TagConcat
    FROM Posts p
    LEFT JOIN LATERAL (
        SELECT trim(both '><' FROM unnest(string_to_array(p.Tags, '><'))) AS TagRaw
    ) AS tg ON TRUE
    LEFT JOIN Tags t ON t.TagName = tg.TagRaw
    GROUP BY p.Id
)
SELECT
    ups.UserId,
    ups.DisplayName,
    ups.QuestionCount,
    ups.AnswerCount,
    ups.QuestionScoreSum,
    ups.AnswerScoreSum,
    COALESCE(b.TotalBadges,0)          AS TotalBadges,
    COALESCE(b.GoldBadges,0)           AS GoldBadges,
    b.BadgeList,
    tv.PostId,
    tv.VoteTypeId,
    tv.VoterId,
    tv.CreationDate                    AS VoteDate,
    pti.TagConcat,
    CASE
        WHEN ups.LastPostDate IS NULL THEN NULL
        ELSE DATE_PART('day', cast('2024-10-01 12:34:56' as timestamp) - ups.LastPostDate)
    END                                 AS DaysSinceLastPost,
    CASE
        WHEN ups.QuestionCount = 0 THEN NULL
        ELSE round(ups.QuestionScoreSum::numeric / ups.QuestionCount,2)
    END                                 AS AvgQuestionScore,
    CASE
        WHEN ups.AnswerCount = 0 THEN NULL
        ELSE round(ups.AnswerScoreSum::numeric / ups.AnswerCount,2)
    END                                 AS AvgAnswerScore
FROM UserPostStats ups
LEFT JOIN BadgeAgg b      ON b.UserId = ups.UserId
LEFT JOIN TopVotes tv    ON tv.rn = 1 
                           AND tv.PostId IN (
                               SELECT p.Id FROM Posts p WHERE p.OwnerUserId = ups.UserId
                           )
LEFT JOIN PostTagInfo pti ON pti.PostId = tv.PostId
WHERE (ups.QuestionCount > 10 OR ups.AnswerCount > 20)
  AND (b.TotalBadges IS NULL OR b.TotalBadges < 5)
  AND COALESCE(pti.TagConcat,'') <> ''
UNION ALL
SELECT
    u.Id,
    u.DisplayName,
    NULL,NULL,NULL,NULL,
    NULL,NULL,NULL,
    NULL,NULL,NULL,NULL,
    NULL,NULL,NULL,NULL,NULL
FROM Users u
WHERE NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id)
ORDER BY AvgAnswerScore DESC NULLS LAST
LIMIT 100;