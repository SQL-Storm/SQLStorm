WITH ActiveUsers AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        COUNT(p.Id) AS PostCount,
        COUNT(c.Id) AS CommentCount,
        COUNT(v.Id) AS VoteCount,
        COUNT(b.Id) AS BadgeCount
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    WHERE
        u.LastAccessDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days')
    GROUP BY
        u.Id, u.Reputation
),

TopTags AS (
    SELECT
        t.TagName,
        t.Count,
        COUNT(p.Id) AS QuestionCount,
        AVG(p.Score) AS AvgScore,
        AVG(p.ViewCount) AS AvgViewCount
    FROM
        Tags t
    JOIN
        Posts p ON EXISTS (
            SELECT 1
            FROM (
                SELECT trim(tag) AS tag
                FROM regexp_split_to_table( substring(p.Tags FROM 2 FOR (char_length(p.Tags) - 2)) , '><') AS tag
            ) s
            WHERE s.tag = t.TagName
        )
    WHERE
        p.PostTypeId = 1
    GROUP BY
        t.TagName, t.Count
    ORDER BY
        QuestionCount DESC, AvgScore DESC
    LIMIT 10
),

HighActivityPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        u.DisplayName AS OwnerDisplayName,
        COALESCE(au.DisplayName, 'Deleted') AS AcceptedAnswerOwner,
        p.Tags
    FROM
        Posts p
    LEFT JOIN
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN
        Posts a ON p.AcceptedAnswerId = a.Id
    LEFT JOIN
        Users au ON a.OwnerUserId = au.Id
    WHERE
        p.PostTypeId = 1
        AND p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year')
        AND (p.Score > 10 OR p.ViewCount > 1000)
    ORDER BY
        p.Score DESC, p.ViewCount DESC
    LIMIT 50
)

SELECT
    au.UserId,
    au.Reputation,
    au.PostCount,
    au.CommentCount,
    au.VoteCount,
    au.BadgeCount,
    tt.TagName,
    tt.QuestionCount,
    tt.AvgScore,
    tt.AvgViewCount,
    hap.PostId,
    hap.PostTypeId,
    hap.CreationDate,
    hap.Score,
    hap.ViewCount,
    hap.AnswerCount,
    hap.CommentCount,
    hap.FavoriteCount,
    hap.OwnerDisplayName,
    hap.AcceptedAnswerOwner
FROM
    ActiveUsers au
CROSS JOIN
    TopTags tt
LEFT JOIN
    HighActivityPosts hap ON EXISTS (
        SELECT 1
        FROM (
            SELECT trim(tag) AS tag
            FROM regexp_split_to_table( substring(hap.Tags FROM 2 FOR (char_length(hap.Tags) - 2)) , '><') AS tag
        ) s
        WHERE s.tag = tt.TagName
    )
ORDER BY
    au.Reputation DESC, tt.QuestionCount DESC, hap.Score DESC;