with RankedPosts as (
    select 
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.FavoriteCount,
        p.Tags,
        p.Title,
        (extract(year from p.CreationDate)::int / 10) * 10 as Decade,
        case when p.ViewCount > 0 then cast(p.FavoriteCount as float) / p.ViewCount else null end as FavsToViewsRatio,
        (select count(distinct c.UserId) from Comments c where c.PostId = p.Id) as DistinctCommenters,
        p.LastEditDate,
        rank() over (partition by (extract(year from p.CreationDate)::int / 10) * 10 order by p.Score desc) as DecadeScoreRank
    from Posts p
    where p.PostTypeId = 1
),
UserBadgeCounts as (
    select 
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges
    from Badges b
    group by b.UserId
),
UserActivitySummary as (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        coalesce(ub.GoldBadges,0) as GoldBadges,
        coalesce(ub.SilverBadges,0) as SilverBadges,
        coalesce(ub.BronzeBadges,0) as BronzeBadges,
        (select count(*) from Posts p where p.OwnerUserId = u.Id) as PostsCount,
        (select avg(p.Score) from Posts p where p.OwnerUserId = u.Id) as AvgPostScore,
        greatest(
            coalesce((select max(p.LastActivityDate) from Posts p where p.OwnerUserId = u.Id), timestamp '1970-01-01'),
            coalesce((select max(c.CreationDate) from Comments c where c.UserId = u.Id), timestamp '1970-01-01')
        ) as LastKnownActivity
    from Users u
    left join UserBadgeCounts ub on ub.UserId = u.Id
),
TopQuestionsWithDuplicates as (
    select 
        rp.Id as QuestionId,
        rp.Title,
        rp.OwnerUserId,
        ua.DisplayName as OwnerName,
        rp.Score,
        rp.ViewCount,
        rp.AnswerCount,
        rp.FavoriteCount,
        rp.Tags,
        rp.Decade,
        rp.DecadeScoreRank,
        rp.DistinctCommenters,
        rp.FavsToViewsRatio,
        exists (
            select 1 from PostLinks pl
            join Posts dup on dup.Id = pl.PostId
            where pl.RelatedPostId = rp.Id 
              and pl.LinkTypeId = 3
              and dup.PostTypeId = 1
        ) as IsDuplicated,
        rp.LastEditDate
    from RankedPosts rp
    join UserActivitySummary ua on ua.Id = rp.OwnerUserId
    where rp.DecadeScoreRank <= 50
),
UserTopAnswers as (
    select 
        u.Id as UserId,
        p.Id as AnswerId,
        p.ParentId as QuestionId,
        p.Score,
        dense_rank() over (partition by u.Id order by p.Score desc) as ScoreRank
    from Users u
    join Posts p on p.OwnerUserId = u.Id
    where p.PostTypeId = 2
),
UserHighScoreAnswerUsers as (
    select distinct UserId
    from UserTopAnswers
    where ScoreRank = 1 and Score > 100
),
QuestionsWithUserAnswerInfo as (
    select 
        tq.QuestionId,
        tq.Title,
        tq.OwnerUserId,
        tq.OwnerName,
        tq.Score,
        tq.ViewCount,
        tq.AnswerCount,
        tq.FavoriteCount,
        tq.Tags,
        tq.Decade,
        tq.DecadeScoreRank,
        tq.DistinctCommenters,
        tq.FavsToViewsRatio,
        tq.IsDuplicated,
        tq.LastEditDate,
        ua.Score as UserTopAnswerScore,
        ua.AnswerId
    from TopQuestionsWithDuplicates tq
    left join UserTopAnswers ua on ua.QuestionId = tq.QuestionId and ua.ScoreRank = 1
),
FinalFilteredQuestions as (
    select *
    from QuestionsWithUserAnswerInfo
    where (FavsToViewsRatio is not null and FavsToViewsRatio > 0.01)
      and DistinctCommenters >= 3
      and Score > 10
      and (IsDuplicated = false or IsDuplicated is null)
)

select 
    ffq.QuestionId,
    ffq.Title,
    substring(ffq.Tags from 1 for 100) as SampleTags,
    ffq.Score,
    ffq.ViewCount,
    ffq.AnswerCount,
    ffq.FavoriteCount,
    round(cast(ffq.FavsToViewsRatio as numeric),4) as FavsToViewsRatio,
    ffq.DistinctCommenters,
    ffq.Decade,
    ffq.DecadeScoreRank,
    ffq.OwnerUserId,
    ffq.OwnerName,
    ffq.UserTopAnswerScore,
    ffq.AnswerId,
    ua.GoldBadges,
    ua.SilverBadges,
    ua.BronzeBadges,
    ua.Reputation,
    ua.PostsCount,
    ua.AvgPostScore,
    ua.LastKnownActivity,
    case when ffq.LastEditDate is not null then
        (cast('2024-10-01' as date) - cast(ffq.LastEditDate as date))
    else null end as DaysSinceLastEdit
from FinalFilteredQuestions ffq
left join UserActivitySummary ua on ua.Id = ffq.OwnerUserId
group by
    ffq.QuestionId,
    ffq.Title,
    substring(ffq.Tags from 1 for 100),
    ffq.Score,
    ffq.ViewCount,
    ffq.AnswerCount,
    ffq.FavoriteCount,
    ffq.FavsToViewsRatio,
    ffq.DistinctCommenters,
    ffq.Decade,
    ffq.DecadeScoreRank,
    ffq.OwnerUserId,
    ffq.OwnerName,
    ffq.UserTopAnswerScore,
    ffq.AnswerId,
    ua.GoldBadges,
    ua.SilverBadges,
    ua.BronzeBadges,
    ua.Reputation,
    ua.PostsCount,
    ua.AvgPostScore,
    ua.LastKnownActivity,
    ffq.LastEditDate
order by ffq.Decade desc, ffq.Score desc
limit 100;