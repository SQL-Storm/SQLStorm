WITH
  UserActivity AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      u.Reputation,
      COUNT(DISTINCT p.Id) AS PostCount,
      COUNT(DISTINCT c.Id) AS CommentCount,
      SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
      SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
      MAX(p.CreationDate) AS LastPostDate,
      u.CreationDate AS UserCreationDate,
      (
        SELECT
          COUNT(*)
        FROM
          Badges b
        WHERE
          b.UserId = u.Id
      ) AS BadgeCount,
      ROW_NUMBER() OVER (
        ORDER BY
          u.Reputation DESC
      ) AS ReputationRank
    FROM
      Users u
      LEFT JOIN Posts p ON u.Id = p.OwnerUserId
      LEFT JOIN Comments c ON u.Id = c.UserId
      LEFT JOIN Votes v ON u.Id = v.UserId
    WHERE
      u.Id BETWEEN 1 AND 10000
    GROUP BY
      u.Id,
      u.DisplayName,
      u.CreationDate,
      u.Reputation
  ),
  PostEngagement AS (
    SELECT
      p.Id AS PostId,
      p.OwnerUserId,
      pt.Name AS PostType,
      p.Title,
      p.Score,
      p.AnswerCount,
      p.CommentCount,
      p.FavoriteCount,
      (
        SELECT
          COUNT(*)
        FROM
          PostHistory ph
        WHERE
          ph.PostId = p.Id
          AND ph.PostHistoryTypeId IN (4, 5, 6)
      ) AS EditCount,
      DENSE_RANK() OVER (
        ORDER BY
          p.Score DESC
      ) AS ScoreRank,
      p.CreationDate
    FROM
      Posts p
      JOIN PostTypes pt ON p.PostTypeId = pt.Id
    WHERE
      p.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '1 year')
      AND p.PostTypeId IN (1, 2)
    GROUP BY
      p.Id,
      p.OwnerUserId,
      pt.Name,
      p.Title,
      p.Score,
      p.AnswerCount,
      p.CommentCount,
      p.FavoriteCount,
      p.CreationDate
  ),
  TagPopularity AS (
    SELECT
      t.TagName,
      COUNT(pl.PostId) AS LinkedPostCount,
      AVG(p.Score) AS AveragePostScore,
      SUM(CASE WHEN pl.LinkTypeId = 3 THEN 1 ELSE 0 END) AS DuplicateLinkCount
    FROM
      Tags t
      LEFT JOIN PostTags ptg ON t.Id = ptg.TagId
      LEFT JOIN Posts p ON ptg.PostId = p.Id
      LEFT JOIN PostLinks pl ON p.Id = pl.PostId
    WHERE
      t.TagName NOT LIKE '#%'
    GROUP BY
      t.TagName
    HAVING
      COUNT(pl.PostId) > 10
  )
SELECT
  ua.DisplayName,
  ua.Reputation,
  ua.BadgeCount,
  ua.UserCreationDate,
  ua.PostCount,
  ua.CommentCount,
  ua.UpVoteCount,
  ua.DownVoteCount,
  pe.PostType,
  pe.Title,
  pe.Score,
  pe.ScoreRank,
  pe.AnswerCount,
  pe.FavoriteCount,
  pe.EditCount,
  tp.TagName,
  tp.LinkedPostCount,
  tp.AveragePostScore,
  tp.DuplicateLinkCount,
  CASE
    WHEN ua.LastPostDate IS NULL THEN 'Never Posted'
    WHEN ua.LastPostDate < (CAST('2024-10-01' AS date) - INTERVAL '30 day') THEN 'Inactive'
    ELSE 'Active'
  END AS UserActivityStatus,
  (ua.DisplayName || ' - ' || tp.TagName || ' (Score: ' || COALESCE(CAST(pe.Score AS text), '0') || ')') AS CompositeIdentifier,
  COALESCE(ua.DisplayName, 'Anonymous') AS DisplayNameOrAnonymous
FROM
  UserActivity ua
  JOIN PostEngagement pe ON ua.UserId = pe.OwnerUserId
  JOIN TagPopularity tp ON tp.TagName IN (
    SELECT
      regexp_split_part(tags_row.tag, '><', n.n) AS TagName
    FROM
      (
        SELECT p.Id, p.Tags AS tag
        FROM Posts p
        WHERE p.Id = pe.PostId
      ) AS tags_row,
      (SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10) n
    WHERE
      n.n <= (char_length(tags_row.tag) - char_length(replace(tags_row.tag, '><', '')) + 1)
  )
WHERE
  ua.ReputationRank <= 100
  AND pe.ScoreRank <= 50
  AND tp.DuplicateLinkCount > 5
  AND ua.DisplayName IS NOT NULL
  AND pe.Title IS NOT NULL
  AND tp.TagName IS NOT NULL
ORDER BY
  ua.Reputation DESC,
  pe.Score DESC,
  tp.LinkedPostCount DESC;