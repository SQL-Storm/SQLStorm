WITH
RecentActivePosts AS (
  SELECT
    p.Id,
    p.Title,
    p.PostTypeId,
    p.OwnerUserId,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.Tags,
    p.FavoriteCount,
    p.ContentLicense
  FROM Posts p
  WHERE p.LastActivityDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY
),
TopAuthors AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.WebsiteUrl,
    u.Location,
    u.AboutMe,
    u.ProfileImageUrl,
    u.EmailHash,
    u.AccountId,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.UpVotes DESC, u.LastAccessDate DESC) AS rn
  FROM Users u
  WHERE u.Reputation > 1000
),
TagHotness AS (
  SELECT
    t.TagName,
    t.Count,
    t.ExcerptPostId,
    ps.Id AS PostId,
    ps.Title AS PostTitle,
    ps.OwnerUserId AS PostOwner,
    ps.CreationDate AS PostCreation,
    ps.LastActivityDate AS PostLastActivity
  FROM Tags t
  JOIN Posts ps ON t.ExcerptPostId = ps.Id
  WHERE COALESCE(t.IsModeratorOnly, 0) = 0
),
Combined AS (
  SELECT
    rap.Id AS PostId,
    rap.Title AS PostTitle,
    rap.PostTypeId,
    rap.OwnerUserId AS AuthorId,
    rap.CreationDate,
    rap.LastActivityDate,
    rap.Score,
    rap.ViewCount,
    rap.AnswerCount,
    rap.CommentCount,
    rap.Tags,
    rap.FavoriteCount,
    rap.ContentLicense,
    ba.UserId AS AuthorUserId,
    ba.DisplayName AS AuthorDisplayName,
    ba.Reputation AS AuthorReputation,
    ba.LastAccessDate AS AuthorLastAccess
  FROM RecentActivePosts rap
  LEFT JOIN TopAuthors ba ON rap.OwnerUserId = ba.UserId
  UNION ALL
  SELECT
    p.Id AS PostId,
    p.Title AS PostTitle,
    p.PostTypeId,
    p.OwnerUserId AS AuthorId,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.Tags,
    p.FavoriteCount,
    p.ContentLicense,
    NULL AS AuthorUserId,
    NULL AS AuthorDisplayName,
    NULL AS AuthorReputation,
    NULL AS AuthorLastAccess
  FROM Posts p
  WHERE p.Id IN (SELECT PostId FROM TagHotness)
)
SELECT
  c.PostId,
  c.PostTitle,
  c.PostTypeId,
  c.AuthorId,
  c.AuthorDisplayName,
  c.AuthorReputation,
  c.AuthorLastAccess,
  c.CreationDate,
  c.LastActivityDate,
  c.Score,
  c.ViewCount,
  c.AnswerCount,
  c.CommentCount,
  c.Tags,
  c.FavoriteCount,
  c.ContentLicense,
  ARRAY_AGG(DISTINCT vl.TagName) FILTER (WHERE vl.TagName IS NOT NULL) AS RankedTags,
  (SELECT COUNT(*) FROM Votes v WHERE v.PostId = c.PostId AND v.VoteTypeId = 2) AS UpVotesGivenToPost,
  (SELECT COUNT(*) FROM Votes v WHERE v.PostId = c.PostId AND v.VoteTypeId = 3) AS DownVotesGivenToPost,
  (SELECT COUNT(*) FROM Comments cm WHERE cm.PostId = c.PostId) AS CommentCountTotal
FROM (
  SELECT
    p.PostId,
    p.PostTitle,
    p.PostTypeId,
    p.AuthorId,
    p.AuthorDisplayName,
    p.AuthorReputation,
    p.AuthorLastAccess,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.Tags,
    p.FavoriteCount,
    p.ContentLicense
  FROM Combined p
  LEFT JOIN Tags t ON t.ExcerptPostId = p.PostId
  LEFT JOIN LATERAL (
    SELECT TRIM(tag) AS TagName
    FROM UNNEST(
      string_to_array(
        CASE
          WHEN p.Tags LIKE '<%>' THEN SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2)
          ELSE p.Tags
        END
      , '><')
    ) AS tag
  ) AS vl ON TRUE
  WHERE p.PostTypeId IN (1,2)
) AS c
GROUP BY
  c.PostId, c.PostTitle, c.PostTypeId, c.AuthorId, c.AuthorDisplayName, c.AuthorReputation, c.AuthorLastAccess,
  c.CreationDate, c.LastActivityDate, c.Score, c.ViewCount, c.AnswerCount, c.CommentCount, c.Tags, c.FavoriteCount,
  c.ContentLicense
ORDER BY c.LastActivityDate DESC, c.Score DESC
LIMIT 100;