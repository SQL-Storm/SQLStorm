WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.AccountId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
        COUNT(DISTINCT b.Id) AS Badges,
        COUNT(DISTINCT c.Id) AS Comments,
        COUNT(DISTINCT v.Id) AS Votes,
        MAX(p.CreationDate) AS LatestPostDate,
        MAX(v.CreationDate) AS LatestVoteDate,
        DATEDIFF(cast('2024-10-01 12:34:56' as timestamp), u.CreationDate) AS AccountAgeDays,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                ROUND(CAST(SUM(CASE WHEN p.Score > 0 THEN p.Score ELSE 0 END) AS FLOAT) / 
                      CAST(COUNT(DISTINCT p.Id) AS FLOAT), 2)
            ELSE 0 
        END AS AvgScorePerPost,
        STRING_AGG(DISTINCT t.TagName, ', ') AS PostTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    LEFT JOIN (
        SELECT DISTINCT PostId, TagName
        FROM Posts p
        CROSS JOIN UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2), '><')) AS t(TagName)
        WHERE p.Tags IS NOT NULL AND p.Tags != ''
    ) t ON p.Id = t.PostId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.Views, u.UpVotes, u.DownVotes, u.AccountId, u.CreationDate
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.PostTypeId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.CreationDate,
        p.OwnerUserId,
        p.ParentId,
        p.Tags,
        CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAcceptedAnswer,
        ROUND(CAST(p.Score AS FLOAT) / NULLIF(p.ViewCount, 0), 4) AS ScoreToViewRatio,
        DATEDIFF(cast('2024-10-01 12:34:56' as timestamp), p.CreationDate) AS DaysSinceCreation,
        CASE 
            WHEN p.Score > 100 THEN 'HighlyVoted'
            WHEN p.Score > 50 THEN 'ModeratelyVoted'
            WHEN p.Score > 0 THEN 'SlightlyVoted'
            ELSE 'NotVoted'
        END AS VotingLevel,
        CASE 
            WHEN p.Tags LIKE '%<java>%' THEN 'Java'
            WHEN p.Tags LIKE '%<python>%' THEN 'Python'
            WHEN p.Tags LIKE '%<javascript>%' THEN 'JavaScript'
            ELSE 'Other'
        END AS PrimaryLanguage,
        (SELECT COUNT(*) 
         FROM PostHistory ph 
         WHERE ph.PostId = p.Id 
           AND ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6)
           AND ph.CreationDate > p.CreationDate) AS EditCount,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PreviousScore,
        LEAD(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS NextScore,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PostSequence,
        NTILE(4) OVER (ORDER BY p.Score DESC) AS ScoreQuartile
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL
),
EngagementMetrics AS (
    SELECT 
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount,
        pa.CommentCount,
        pa.FavoriteCount,
        pa.HasAcceptedAnswer,
        pa.ScoreToViewRatio,
        pa.DaysSinceCreation,
        pa.VotingLevel,
        pa.PrimaryLanguage,
        pa.EditCount,
        pa.PreviousScore,
        pa.NextScore,
        pa.PostSequence,
        pa.ScoreQuartile,
        DENSE_RANK() OVER (ORDER BY pa.Score DESC) AS GlobalRank,
        RANK() OVER (PARTITION BY pa.OwnerUserId ORDER BY pa.Score DESC) AS UserRank,
        AVG(pa.Score) OVER (PARTITION BY pa.OwnerUserId) AS AvgUserScore,
        MAX(pa.Score) OVER (PARTITION BY pa.OwnerUserId) AS MaxUserScore,
        MIN(pa.Score) OVER (PARTITION BY pa.OwnerUserId) AS MinUserScore,
        STDDEV(pa.Score) OVER (PARTITION BY pa.OwnerUserId) AS StdDevScore,
        CASE 
            WHEN pa.PostTypeId = 1 AND pa.AnswerCount > 0 THEN 
                ROUND(CAST(pa.AnswerCount AS FLOAT) / NULLIF(pa.ViewCount, 0), 4)
            ELSE 0 
        END AS AnswerToViewRatio,
        CASE 
            WHEN pa.PostTypeId = 2 AND pa.ParentId IS NOT NULL THEN
                (SELECT COUNT(*) FROM Posts p2 WHERE p2.ParentId = pa.ParentId)
            ELSE 0 
        END AS ParentAnswerCount,
        CASE 
            WHEN pa.PostTypeId = 1 THEN 
                (SELECT COUNT(*) FROM Posts p3 WHERE p3.ParentId = pa.PostId AND p3.PostTypeId = 2)
            ELSE 0 
        END AS MyAnswerCount,
        CASE 
            WHEN pa.PostTypeId = 1 AND pa.CommentCount > 0 THEN
                ROUND(CAST(pa.CommentCount AS FLOAT) / NULLIF(pa.AnswerCount + 1, 0), 2)
            ELSE 0 
        END AS CommentPerAnswer,
        CASE 
            WHEN pa.PostTypeId = 1 THEN
                (SELECT COUNT(*) FROM Votes v WHERE v.PostId = pa.PostId AND v.VoteTypeId = 2)
            ELSE 0 
        END AS Upvotes,
        CASE 
            WHEN pa.PostTypeId = 1 THEN
                (SELECT COUNT(*) FROM Votes v WHERE v.PostId = pa.PostId AND v.VoteTypeId = 3)
            ELSE 0 
        END AS Downvotes
    FROM PostAnalysis pa
)
SELECT 
    us.UserId,
    us.DisplayName,
    us.Reputation,
    us.Views,
    us.UpVotes,
    us.DownVotes,
    us.AccountAgeDays,
    us.TotalPosts,
    us.Questions,
    us.Answers,
    us.Badges,
    us.Comments,
    us.Votes,
    us.LatestPostDate,
    us.LatestVoteDate,
    us.AvgScorePerPost,
    us.PostTags,
    em.PostId,
    em.Title,
    em.Score,
    em.ViewCount,
    em.AnswerCount,
    em.CommentCount,
    em.FavoriteCount,
    em.HasAcceptedAnswer,
    em.ScoreToViewRatio,
    em.DaysSinceCreation,
    em.VotingLevel,
    em.PrimaryLanguage,
    em.EditCount,
    em.PreviousScore,
    em.NextScore,
    em.PostSequence,
    em.ScoreQuartile,
    em.GlobalRank,
    em.UserRank,
    em.AvgUserScore,
    em.MaxUserScore,
    em.MinUserScore,
    em.StdDevScore,
    em.AnswerToViewRatio,
    em.ParentAnswerCount,
    em.MyAnswerCount,
    em.CommentPerAnswer,
    em.Upvotes,
    em.Downvotes,
    CASE 
        WHEN (em.ViewCount > 1000 AND em.Score > 50) THEN 'HighlyEngaged'
        WHEN (em.ViewCount > 500 AND em.Score > 25) THEN 'MidEngaged'
        WHEN (em.ViewCount > 100 AND em.Score > 10) THEN 'LowEngaged'
        ELSE 'Inactive'
    END AS EngagementLevel,
    CASE 
        WHEN em.GlobalRank <= 10 THEN 'Top10'
        WHEN em.GlobalRank <= 50 THEN 'Top50'
        WHEN em.GlobalRank <= 100 THEN 'Top100'
        ELSE 'Below100'
    END AS RankingTier,
    CASE 
        WHEN em.Score > em.AvgUserScore THEN 'AboveAverage'
        WHEN em.Score = em.AvgUserScore THEN 'Average'
        ELSE 'BelowAverage'
    END AS PerformanceAgainstUserAvg,
    IIF(em.EditCount > 0, 'Edited', 'NotEdited') AS EditStatus,
    COALESCE(NULLIF(em.PrimaryLanguage, 'Other'), 'Unknown') AS LanguageCategory,
    CASE 
        WHEN us.Badges > 100 THEN 'Elite'
        WHEN us.Badges > 50 THEN 'Veteran'
        WHEN us.Badges > 10 THEN 'Contributor'
        ELSE 'Regular'
    END AS BadgeLevel,
    CASE 
        WHEN us.TotalPosts > 1000 THEN 'Legendary'
        WHEN us.TotalPosts > 500 THEN 'Veteran'
        WHEN us.TotalPosts > 100 THEN 'Active'
        ELSE 'Starter'
    END AS PostingLevel,
    CASE 
        WHEN em.ScoreQuartile = 1 THEN 'TopQuarter'
        WHEN em.ScoreQuartile = 2 THEN 'SecondQuarter'
        WHEN em.ScoreQuartile = 3 THEN 'ThirdQuarter'
        ELSE 'BottomQuarter'
    END AS ScoreDistribution,
    ABS(em.Score - em.AvgUserScore) AS ScoreDeviationFromUserAvg,
    (em.Score * em.ViewCount) AS ScoreViewProduct,
    (em.ViewCount / NULLIF(em.CommentCount, 0)) AS ViewsPerComment,
    ((em.AnswerCount * 100.0) / NULLIF(em.ViewCount, 0)) AS AnswerRatePerView,
    100.0 * (em.Upvotes * 1.0) / NULLIF(em.Upvotes + em.Downvotes, 0) AS UpvotePercentage
FROM UserStats us
INNER JOIN EngagementMetrics em ON em.OwnerUserId = us.UserId
WHERE us.AccountAgeDays > 30 
  AND (em.DaysSinceCreation <= 365 OR em.DaysSinceCreation IS NULL)
  AND em.Score > 0
  AND us.TotalPosts > 0
  AND (em.HasAcceptedAnswer = 1 OR em.AnswerCount > 0 OR em.CommentCount > 10)
ORDER BY em.GlobalRank, em.Score DESC, em.ViewCount DESC
LIMIT 1000;