WITH 
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetVotes,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadgeCount,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadgeCount,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadgeCount
    FROM Users u
),
TopTags AS (
    SELECT 
        t.TagName,
        COUNT(ph.Id) AS UseCount,
        ROW_NUMBER() OVER (ORDER BY COUNT(ph.Id) DESC) AS rn
    FROM Tags t
    JOIN PostHistory ph ON ph.PostId = t.ExcerptPostId OR ph.PostId = t.WikiPostId
    WHERE ph.PostHistoryTypeId IN (2, 5)
    GROUP BY t.TagName
),
UserTagActivity AS (
    SELECT 
        us.Id AS UserId,
        STRING_AGG(DISTINCT tt.TagName, ', ') FILTER (WHERE tt.rn <= 5) AS Top5Tags,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS Qs,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS As,
        MAX(p.Score) AS MaxPostScore
    FROM UserStats us
    LEFT JOIN Posts p ON p.OwnerUserId = us.Id
    LEFT JOIN PostTags pt ON pt.PostId = p.Id
    LEFT JOIN Tags t ON t.Id = pt.TagId
    LEFT JOIN TopTags tt ON tt.TagName = t.TagName
    GROUP BY us.Id
),
RecentVotes AS (
    SELECT 
        v.PostId,
        SUM(CASE WHEN vt.Id = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN vt.Id = 3 THEN 1 ELSE 0 END) AS DownVotes,
        MAX(v.CreationDate) AS LastVoteDate
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE v.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '30 days')
    GROUP BY v.PostId
),
UserRecentVotes AS (
    SELECT 
        p.OwnerUserId AS UserId,
        SUM(rv.UpVotes) AS UpVotes,
        SUM(rv.DownVotes) AS DownVotes,
        MAX(rv.LastVoteDate) AS LastVoteDate
    FROM RecentVotes rv
    JOIN Posts p ON p.Id = rv.PostId
    GROUP BY p.OwnerUserId
)

SELECT 
    us.Id,
    us.DisplayName,
    us.Reputation,
    us.NetVotes,
    us.QuestionCount,
    us.AnswerCount,
    us.GoldBadgeCount,
    us.SilverBadgeCount,
    us.BronzeBadgeCount,
    uta.Top5Tags,
    uta.Qs,
    uta.As,
    uta.MaxPostScore,
    COALESCE(urv.UpVotes, 0) AS RecentUpVotes,
    COALESCE(urv.DownVotes, 0) AS RecentDownVotes,
    urv.LastVoteDate,
    CASE 
        WHEN us.Reputation > 20000 THEN 'Elite'
        WHEN us.Reputation > 10000 THEN 'Veteran'
        WHEN us.Reputation > 5000 THEN 'Experienced'
        ELSE 'Novice'
    END AS ReputationTier,
    CONCAT('User_', us.Id) AS UserKey,
    NULLIF(us.DisplayName, '') AS CleanDisplayName
FROM UserStats us
LEFT JOIN UserTagActivity uta ON uta.UserId = us.Id
LEFT JOIN UserRecentVotes urv ON urv.UserId = us.Id
WHERE (us.QuestionCount + us.AnswerCount) > 0

UNION ALL

SELECT 
    -1 AS Id,
    'Summary' AS DisplayName,
    NULL AS Reputation,
    NULL AS NetVotes,
    SUM(us.QuestionCount) AS QuestionCount,
    SUM(us.AnswerCount) AS AnswerCount,
    SUM(us.GoldBadgeCount) AS GoldBadgeCount,
    SUM(us.SilverBadgeCount) AS SilverBadgeCount,
    SUM(us.BronzeBadgeCount) AS BronzeBadgeCount,
    NULL AS Top5Tags,
    NULL AS Qs,
    NULL AS As,
    MAX(uta.MaxPostScore) AS MaxPostScore,
    SUM(COALESCE(urv.UpVotes, 0)) AS RecentUpVotes,
    SUM(COALESCE(urv.DownVotes, 0)) AS RecentDownVotes,
    MAX(urv.LastVoteDate) AS LastVoteDate,
    NULL AS ReputationTier,
    NULL AS UserKey,
    NULL AS CleanDisplayName
FROM UserStats us
LEFT JOIN UserTagActivity uta ON uta.UserId = us.Id
LEFT JOIN UserRecentVotes urv ON urv.UserId = us.Id
WHERE us.Reputation > 0

ORDER BY Reputation DESC
OFFSET 0 ROWS FETCH NEXT 100 ROWS ONLY;