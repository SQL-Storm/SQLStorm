-- {"query": "6080.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 491} 
SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class,
    t.TagName,
    ph.RevisionGUID,
    ph.Comment,
    v.VoteTypeId
FROM 
    (SELECT 
        ph.PostId,
        ph.RevisionGUID,
        ph.Comment,
        ph.CreationDate
     FROM 
        PostHistory ph
     WHERE 
        ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 13, 14, 15, 19, 20, 35)
    ) AS ph_filtered
RIGHT JOIN 
    Posts p ON p.Id = ph_filtered.PostId
LEFT JOIN 
    Users u ON p.OwnerUserId = u.Id
LEFT JOIN 
    Badges b ON u.Id = b.UserId AND b.Date = (SELECT MAX(Date) FROM Badges WHERE UserId = u.Id)
LEFT JOIN 
    Tags t ON p.Id = t.ExcerptPostId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
WHERE 
    u.Reputation > 10000
    AND (u.LastAccessDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') OR u.LastAccessDate IS NULL)
    AND (v.VoteTypeId = 2 OR v.VoteTypeId = 3)
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, b.Class, t.TagName, ph_filtered.RevisionGUID, ph_filtered.Comment
HAVING 
    COUNT(v.Id) > 10
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;