WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        MAX(p.CreationDate) as LastPostDate,
        MAX(c.CreationDate) as LastCommentDate,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        NTILE(10) OVER (ORDER BY u.Reputation DESC) as RepDecile
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= TIMESTAMP '2010-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
RankedPosts AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.AnswerCount,
        COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) as EngagementCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) as UserPostRank,
        RANK() OVER (ORDER BY p.Score DESC) as GlobalScoreRank,
        PERCENT_RANK() OVER (ORDER BY p.Score) as ScorePercentile,
        CASE 
            WHEN p.PostTypeId = 1 AND p.Score > 10 THEN 'HighValueQuestion'
            WHEN p.PostTypeId = 2 AND p.Score > 5 THEN 'HighValueAnswer'
            WHEN p.PostTypeId = 1 AND p.Score <= 0 THEN 'LowValueQuestion'
            ELSE 'Normal'
        END as PostCategory
    FROM Posts p
    WHERE p.CreationDate >= TIMESTAMP '2015-01-01'
    AND p.Score IS NOT NULL
),
UserPostMetrics AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        COUNT(p.Id) as TotalPosts,
        AVG(p.Score) as AvgScore,
        SUM(p.ViewCount) as TotalViews,
        MAX(p.Score) as MaxScore,
        STRING_AGG(p.Title, '; ') as AllTitles,
        ARRAY_AGG(p.PostTypeId) as PostTypeArray,
        (SELECT COUNT(*) FROM Posts p2 WHERE p2.OwnerUserId = u.Id AND p2.PostTypeId = 1) as QuestionCount,
        (SELECT COUNT(*) FROM Posts p3 WHERE p3.OwnerUserId = u.Id AND p3.PostTypeId = 2) as AnswerCount
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName
),
ComplexAnalysis AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.PostCount,
        uas.CommentCount,
        uas.BadgeCount,
        uas.PostRank,
        uas.RepDecile,
        upm.TotalPosts,
        upm.AvgScore,
        upm.TotalViews,
        upm.MaxScore,
        upm.QuestionCount,
        upm.AnswerCount,
        CASE 
            WHEN uas.PostCount > 100 AND uas.Reputation > 5000 THEN 'Elite'
            WHEN uas.PostCount > 50 AND uas.Reputation > 2000 THEN 'Active'
            WHEN uas.PostCount > 10 AND uas.Reputation > 500 THEN 'Regular'
            ELSE 'Casual'
        END as UserTier,
        (CASE 
            WHEN upm.AvgScore > 15 THEN 'HighlyEngaged'
            WHEN upm.AvgScore > 5 THEN 'ModeratelyEngaged'
            ELSE 'LowEngagement'
        END) as EngagementLevel
    FROM UserActivityStats uas
    INNER JOIN UserPostMetrics upm ON uas.UserId = upm.UserId
    WHERE uas.Reputation > 500
),
AnswerQuality AS (
    SELECT 
        a.PostId,
        a.Title,
        a.Score,
        a.OwnerUserId,
        a.AnswerCount,
        (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.ParentId = a.PostId) as AvgAnswerScore,
        (SELECT COUNT(*) FROM Posts p2 WHERE p2.ParentId = a.PostId AND p2.Score > 10) as HighScoreAnswers,
        CASE 
            WHEN a.AnswerCount = 0 THEN 'NoAnswers'
            WHEN a.AnswerCount < 5 THEN 'FewAnswers'
            WHEN a.AnswerCount < 20 THEN 'ModerateAnswers'
            ELSE 'ManyAnswers'
        END as AnswerDensity,
        ROW_NUMBER() OVER (PARTITION BY a.OwnerUserId ORDER BY a.CreationDate) as QuestionOrder,
        (TIMESTAMP '2024-10-01 12:34:56' - a.CreationDate) AS TimeSinceCreation,
        EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - a.CreationDate)) / 86400 AS DaysSinceCreation
    FROM RankedPosts a
    WHERE a.PostCategory = 'HighValueQuestion'
)
SELECT 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.PostCount,
    ca.CommentCount,
    ca.BadgeCount,
    ca.UserTier,
    ca.EngagementLevel,
    ca.TotalPosts,
    ca.AvgScore,
    ca.TotalViews,
    ca.MaxScore,
    ca.QuestionCount,
    ca.AnswerCount,
    COALESCE(COUNT(rp.PostId), 0) as ActivePosts,
    STRING_AGG(CASE WHEN rp.PostCategory = 'HighValueQuestion' THEN rp.Title END, '; ') as HighValueQuestions,
    STRING_AGG(CASE WHEN rp.PostCategory = 'HighValueAnswer' THEN rp.Title END, '; ') as HighValueAnswers,
    MAX(CASE WHEN rp.PostCategory = 'HighValueQuestion' THEN rp.Score END) as MaxHighValueQuestionScore,
    MAX(CASE WHEN rp.PostCategory = 'HighValueAnswer' THEN rp.Score END) as MaxHighValueAnswerScore,
    COUNT(CASE WHEN rp.GlobalScoreRank <= 10 THEN 1 END) as Top10Posts,
    COUNT(CASE WHEN rp.Score > 100 THEN 1 END) as HighScorePosts,
    MIN(CASE WHEN rp.PostCategory = 'HighValueQuestion' THEN rp.CreationDate END) as MinQuestionCreationDate,
    MIN(CASE WHEN rp.PostCategory = 'HighValueQuestion' THEN aq.DaysSinceCreation END) as MinDaysSinceQuestion,
    AVG(CASE WHEN rp.PostCategory = 'HighValueQuestion' THEN rp.AnswerCount END) as AvgAnswersToQuestions,
    SUM(CASE WHEN rp.PostCategory = 'HighValueQuestion' AND rp.AnswerCount > 0 THEN 1 ELSE 0 END) as QuestionsWithAnswers,
    AVG(CASE WHEN rp.PostCategory = 'HighValueAnswer' THEN rp.Score END) as AvgAnswerScore,
    STRING_AGG(CASE WHEN rp.Score > 50 THEN rp.Title END, ', ') as PopularTitles,
    JSON_BUILD_OBJECT(
        'userTier', ca.UserTier,
        'engagementLevel', ca.EngagementLevel,
        'postCount', ca.PostCount,
        'avgScore', ca.AvgScore,
        'reputation', ca.Reputation,
        'topPosts', COUNT(CASE WHEN rp.GlobalScoreRank <= 10 THEN 1 END),
        'highValueQuestions', COUNT(CASE WHEN rp.PostCategory = 'HighValueQuestion' THEN 1 END)
    ) as UserAnalyticsSummary
FROM ComplexAnalysis ca
LEFT JOIN RankedPosts rp ON ca.UserId = rp.OwnerUserId
LEFT JOIN AnswerQuality aq ON rp.PostId = aq.PostId
WHERE (ca.RepDecile = 1 OR ca.PostRank <= 50)
GROUP BY 
    ca.UserId, 
    ca.DisplayName, 
    ca.Reputation, 
    ca.PostCount, 
    ca.CommentCount, 
    ca.BadgeCount, 
    ca.UserTier, 
    ca.EngagementLevel, 
    ca.TotalPosts, 
    ca.AvgScore, 
    ca.TotalViews, 
    ca.MaxScore, 
    ca.QuestionCount, 
    ca.AnswerCount
HAVING 
    COUNT(rp.PostId) > 0
    AND (COUNT(CASE WHEN rp.PostCategory = 'HighValueQuestion' THEN 1 END) > 0 
         OR COUNT(CASE WHEN rp.PostCategory = 'HighValueAnswer' THEN 1 END) > 0)
ORDER BY 
    ca.Reputation DESC, 
    ca.PostCount DESC
LIMIT 1000;