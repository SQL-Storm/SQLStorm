  NULL,
  COUNT(ph.Id),
  MAX(ph.CreationDate),
  AVG(
    EXTRACT(
      EPOCH
      FROM
        (
          ph.CreationDate - LAG(ph.CreationDate, 1, ph.CreationDate) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate)
        )
    )
  ),
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL
FROM
  PostHistory AS ph
WHERE
  ph.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15, 19, 20, 35, 36) -- Moderation actions
GROUP BY
  ph.PostId
HAVING
  COUNT(ph.Id) > 10 -- More than 10 moderation actions on a single post
ORDER BY
  COALESCE(pes.LastEditDate, ph.CreationDate) DESC;