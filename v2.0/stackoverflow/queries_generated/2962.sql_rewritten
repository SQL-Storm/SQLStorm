-- {"query": "2962.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1396} 
with RecursiveUserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(distinct c.Id) as CommentCount,
        count(distinct b.Id) filter (where b.Class = 1) as GoldBadges,
        count(distinct b.Id) filter (where b.Class = 2) as SilverBadges,
        count(distinct b.Id) filter (where b.Class = 3) as BronzeBadges,
        row_number() over (partition by u.Location order by u.Reputation desc) as RankInLocation,
        case
            when u.Location is null then 'Unknown'
            when lower(u.Location) like '%united states%' then 'USA'
            when lower(u.Location) like '%india%' then 'India'
            else 'Other'
        end as RegionCategory
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Badges b on b.UserId = u.Id
    where u.Reputation > 1000 or u.Location is not null
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Location
),
TopQuestions as (
    select 
        q.Id as QuestionId,
        q.Title,
        q.CreationDate,
        q.OwnerUserId,
        q.Score,
        q.ViewCount,
        q.CommentCount,
        coalesce(q.AnswerCount, 0) as AnswerCount,
        q.FavoriteCount,
        u.DisplayName as OwnerName,
        array_agg(distinct tag.TagName) filter (where tag.TagName is not null) as Tags,
        (select max(v.CreationDate) from Votes v where v.PostId = q.Id and v.VoteTypeId = 2) as LastUpvoteDate,
        sum(v.BountyAmount) filter (where v.VoteTypeId in (8,9)) as TotalBounty
    from Posts q
    left join Tags tag on tag.Id in (
        select distinct UNNEST(string_to_array(substring(q.Tags, 2, length(q.Tags) - 2), '><')::int[])
        )
    left join Users u on u.Id = q.OwnerUserId
    left join Votes v on v.PostId = q.Id
    where q.PostTypeId = 1 and q.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
    group by q.Id, q.Title, q.CreationDate, q.OwnerUserId, q.Score, q.ViewCount, q.CommentCount, q.AnswerCount, q.FavoriteCount, u.DisplayName
),
DuplicateQuestionLinks as (
    select 
        pl.PostId as DuplicateQuestionId,
        pl.RelatedPostId as OriginalQuestionId,
        q1.Title as DuplicateTitle,
        q2.Title as OriginalTitle,
        lt.Name as LinkTypeName
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId and lt.Name = 'Duplicate'
    join Posts q1 on q1.Id = pl.PostId and q1.PostTypeId = 1
    join Posts q2 on q2.Id = pl.RelatedPostId and q2.PostTypeId = 1
),
UserCloseVotes as (
    select
        ph.UserId,
        ph.PostId,
        ph.CreationDate,
        crt.Name as CloseReason,
        count(*) over (partition by ph.UserId) as TotalCloseVotes
    from PostHistory ph
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as int)
    where ph.PostHistoryTypeId = 10
),
TopActiveUsersWithCloseVotes as (
    select
        rua.UserId,
        rua.DisplayName,
        rua.Reputation,
        rua.QuestionCount,
        rua.AnswerCount,
        rua.CommentCount,
        rua.GoldBadges,
        rua.SilverBadges,
        rua.BronzeBadges,
        rua.RegionCategory,
        coalesce(sum(ucv.TotalCloseVotes),0) as CloseVotesCount
    from RecursiveUserActivity rua
    left join UserCloseVotes ucv on ucv.UserId = rua.UserId
    group by rua.UserId, rua.DisplayName, rua.Reputation, rua.QuestionCount, rua.AnswerCount, rua.CommentCount, rua.GoldBadges, rua.SilverBadges, rua.BronzeBadges, rua.RegionCategory
),
QuestionAnswerScores as (
    select
        a.ParentId as QuestionId,
        count(a.Id) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore
    from Posts a
    where a.PostTypeId = 2 and a.ParentId is not null
    group by a.ParentId
)
select distinct 
    tqu.UserId,
    tqu.DisplayName,
    tqu.Reputation,
    tqu.QuestionCount,
    tqu.AnswerCount,
    tqu.CommentCount,
    tqu.GoldBadges,
    tqu.SilverBadges,
    tqu.BronzeBadges,
    tqu.RegionCategory,
    dq.OriginalQuestionId,
    dq.OriginalTitle,
    dq.DuplicateQuestionId,
    dq.DuplicateTitle,
    dq.LinkTypeName,
    tq.QuestionId,
    tq.Title,
    tq.Score,
    tq.ViewCount,
    tq.CommentCount,
    tq.AnswerCount as QuestionAnswerCount,
    tq.FavoriteCount,
    tq.Tags,
    tq.LastUpvoteDate,
    tq.TotalBounty,
    qa.AvgAnswerScore,
    qa.MaxAnswerScore,
    qa.AnswerCount as RealAnswerCount,
    tqu.CloseVotesCount,
    case when tqu.CloseVotesCount > 100 then 'Close vote power user' else 'Regular user' end as UserCloseVoteCategory
from TopActiveUsersWithCloseVotes tqu
left join Posts p on p.OwnerUserId = tqu.UserId and p.PostTypeId = 1
left join TopQuestions tq on tq.OwnerUserId = tqu.UserId
left join DuplicateQuestionLinks dq on dq.DuplicateQuestionId = tq.QuestionId
left join QuestionAnswerScores qa on qa.QuestionId = tq.QuestionId
where tqu.Reputation > 5000
order by tqu.Reputation desc, tq.Score desc
limit 100;