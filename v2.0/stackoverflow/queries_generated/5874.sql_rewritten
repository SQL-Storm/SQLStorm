-- {"query": "5874.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 1018} 
WITH
RecentActivePosts AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.Title,
    p.CreationDate,
    p.LastActivityDate,
    p.OwnerUserId,
    p.ViewCount,
    p.Score,
    p.Tags,
    p.AcceptedAnswerId,
    p.ParentId,
    p.CommentCount,
    p.AnswerCount
  FROM Posts p
  WHERE p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
),
UserActivity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.AccountId,
    u.LastAccessDate,
    u.CreationDate,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.Location,
    u.WebsiteUrl,
    -- compute a derived engagement metric
    (COALESCE(u.Views,0) * 1.0 + COALESCE(u.UpVotes,0) * 2.0 - COALESCE(u.DownVotes,0) * 3.0) AS EngagementScore
  FROM Users u
),
TopTags AS (
  SELECT
    t.TagName,
    t.Count,
    t.ExcerptPostId,
    t.WikiPostId,
    ROW_NUMBER() OVER (ORDER BY t.Count DESC, t.TagName) AS rn
  FROM Tags t
  WHERE t.IsModeratorOnly = 0
),
PostTagScores AS (
  SELECT
    pr.PostId,
    t.TagName,
    -- rough score combining post score, view count, and tag popularity
    (p.Score * 1.5) + (p.ViewCount * 0.75) + (COALESCE(t.Count,0) * 0.25) AS CompositeScore
  FROM RecentActivePosts p
  LEFT JOIN Tags t ON t.ExcerptPostId = p.Id OR t.WikiPostId = p.Id
),
Links AS (
  SELECT
    pl.PostId,
    pl.RelatedPostId,
    lt.Name AS LinkTypeName
  FROM PostLinks pl
  LEFT JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
  WHERE lt.Name IN ('Linked','Duplicate')
),
RecentVotes AS (
  SELECT
    v.PostId,
    v.VoteTypeId,
    v.UserId,
    v.CreationDate,
    v.BountyAmount,
    vt.Name AS VoteTypeName
  FROM Votes v
  JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
  WHERE v.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '60 days'
),
UserBadges AS (
  SELECT
    b.UserId,
    b.Name,
    b.Date,
    b.Class,
    b.TagBased
  FROM Badges b
  WHERE b.Date > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '180 days'
)
SELECT
  rp.PostId,
  rp.TagName,
  rp.CompositeScore,
  u.UserId AS AuthorId,
  u.DisplayName AS AuthorDisplayName,
  u.Reputation AS AuthorReputation,
  ua.EngagementScore,
  p.CreationDate AS PostCreationDate,
  p.LastActivityDate AS PostLastActivityDate,
  p.Title,
  p.Tags,
  p.ViewCount,
  p.Score AS PostScore,
  p.CommentCount,
  p.AnswerCount,
  STRING_AGG(DISTINCT vt.Name, ',') AS RecentVoteTypes,
  ARRAY_AGG(DISTINCT lb.Name) FILTER (WHERE lb.Name IS NOT NULL) AS RecentBadges,
  (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = rp.PostId) AS LinkedPostsCount
FROM
  (SELECT p.* FROM RecentActivePosts p) p
  LEFT JOIN UserActivity ua ON p.OwnerUserId = ua.UserId
  LEFT JOIN TopTags tt ON tt.TagName ILIKE ANY (ARRAY[REPLACE(p.Tags, '><','|'), p.Title])
  LEFT JOIN PostTagScores rp ON rp.PostId = p.Id
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN RecentVotes rv ON rv.PostId = p.Id
  LEFT JOIN UserBadges ub ON ub.UserId = u.Id
  LEFT JOIN (SELECT * FROM Badges WHERE 1=0) lb ON 1=0
GROUP BY
  rp.PostId,
  rp.TagName,
  rp.CompositeScore,
  u.UserId,
  u.DisplayName,
  u.Reputation,
  ua.EngagementScore,
  p.CreationDate,
  p.LastActivityDate,
  p.Title,
  p.Tags,
  p.ViewCount,
  p.Score,
  p.CommentCount,
  p.AnswerCount
ORDER BY
  rp.CompositeScore DESC
LIMIT 100;