WITH UserBaseStats AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.UpVotes,
        U.DownVotes,
        U.Views AS UserProfileViews,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        (U.Reputation * 0.5) + (U.UpVotes * 0.1) - (U.DownVotes * 0.05) + (COUNT(DISTINCT P.Id) * 2) + (COUNT(DISTINCT C.Id) * 0.75) AS WeightedUserScore
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.UpVotes, U.DownVotes, U.Views
    HAVING COUNT(DISTINCT P.Id) > 0 OR COUNT(DISTINCT C.Id) > 0 OR COUNT(DISTINCT B.Id) > 0
),
PostActivityMetrics AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.CreationDate AS PostCreationDate,
        P.Score,
        P.ViewCount,
        P.AnswerCount,
        P.CommentCount,
        P.FavoriteCount,
        P.AcceptedAnswerId,
        P.ParentId,
        P.Title,
        P.Tags,
        P.ClosedDate,
        COALESCE((SELECT SUM(CASE WHEN V.VoteTypeId IN (2,5) THEN 1 ELSE -1 END) FROM Votes V WHERE V.PostId = P.Id), 0) AS NetVotes,
        (SELECT COUNT(DISTINCT V.Id) FROM Votes V WHERE V.PostId = P.Id AND V.VoteTypeId IN (2, 3, 5)) AS TotalVotesCast,
        (SELECT COUNT(DISTINCT PH.Id) FROM PostHistory PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId IN (4, 5, 6)) AS EditCount,
        (SELECT COUNT(DISTINCT PH.Id) FROM PostHistory PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId = 10) AS CloseCount,
        (SELECT COUNT(DISTINCT PH.Id) FROM PostHistory PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId = 11) AS ReopenCount,
        CASE
            WHEN P.PostTypeId = 1 AND P.ViewCount > 0
            THEN (P.Score + COALESCE(P.FavoriteCount, 0) + (P.CommentCount * 0.5) + (COALESCE(P.AnswerCount,0) * 1.5))::double precision / P.ViewCount
            ELSE 0.0
        END AS QuestionEngagementRatio,
        CASE
            WHEN P.PostTypeId = 2 AND P.ParentId IS NOT NULL AND P.Score > 0
            THEN (P.Score + (P.CommentCount * 0.5))::double precision / (
                SELECT GREATEST(COALESCE(SUM(V_Parent.BountyAmount), 0), 1)
                FROM Votes V_Parent
                WHERE V_Parent.PostId = P.ParentId AND V_Parent.VoteTypeId = 8 AND V_Parent.BountyAmount IS NOT NULL
            )
            ELSE 0.0
        END AS AnswerPerformanceMetric,
        COALESCE(P.OwnerUserId, -1) AS OwnerUserId_NotNull,
        -- convert tags like '<tag1><tag2>' to array ['tag1','tag2'] in a dialect-agnostic way using substring + replace where available
        -- keep original approach but avoid PostgreSQL-only STRING_TO_ARRAY syntax in other dialects; still use standard functions where possible
        -- For portability, keep as expression that most systems with string functions support:
        (CASE WHEN P.Tags IS NOT NULL AND LENGTH(P.Tags) >= 2 THEN
            -- remove leading '<' and trailing '>' and split on '><' — many systems don't have UNNEST from expressions; this is for later CROSS JOIN UNNEST usage which may be adapted by the engine
            P.Tags
         ELSE NULL END) AS TagArrayString
    FROM Posts P
    WHERE P.PostTypeId IN (1, 2)
      AND P.CreationDate >= TIMESTAMP '2022-01-01'
      AND P.Body IS NOT NULL AND LENGTH(P.Body) > 50
),
TagUsageAndPerformance AS (
    SELECT
        T.TagName,
        COUNT(DISTINCT PAM.PostId) AS TagPostCount,
        AVG(PAM.Score) AS AvgTagScore,
        SUM(PAM.NetVotes) AS TotalTagNetVotes,
        SUM(PAM.EditCount) AS TotalTagEdits,
        SUM(PAM.CloseCount) AS TotalTagCloseCount,
        SUM(PAM.ReopenCount) AS TotalTagReopenCount
    FROM PostActivityMetrics PAM,
    -- emulate UNNEST by splitting TagArrayString on '><' after trimming leading '<' and trailing '>'
    LATERAL (
        SELECT REGEXP_SUBSTR(value, '[^><]+', 1, level) AS TagName
        FROM (SELECT PAM.TagArrayString AS s) sub
        -- the following generate-series-like construct is PostgreSQL-specific; many systems will need an equivalent approach.
        -- Keep a portable-looking lateral that extracts tags by regexp if supported.
        WHERE PAM.TagArrayString IS NOT NULL
    ) T
    WHERE PAM.Tags IS NOT NULL AND LENGTH(PAM.Tags) > 2
    GROUP BY T.TagName
    HAVING COUNT(DISTINCT PAM.PostId) > 50
),
ControversialPosts AS (
    SELECT
        PAM.PostId,
        PAM.Title,
        COALESCE(PAM.OwnerUserId_NotNull, -1) AS OwnerUserId,
        PAM.Score,
        PAM.CommentCount,
        PAM.CloseCount,
        PAM.ReopenCount,
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvoteCount,
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvoteCount,
        SUM(CASE WHEN V.VoteTypeId = 4 THEN 1 ELSE 0 END) AS OffensiveVotes,
        (CAST(SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS double precision) / NULLIF(SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) + SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END), 0)) AS DownvoteRatio,
        MAX(CASE WHEN PH.PostHistoryTypeId = 10 THEN PH.CreationDate ELSE NULL END) AS LastClosedDate,
        PAM.EditCount
    FROM PostActivityMetrics PAM
    JOIN Votes V ON PAM.PostId = V.PostId
    LEFT JOIN PostHistory PH ON PAM.PostId = PH.PostId AND PH.PostHistoryTypeId IN (10, 11)
    WHERE PAM.PostTypeId = 1
    GROUP BY PAM.PostId, PAM.Title, COALESCE(PAM.OwnerUserId_NotNull, -1), PAM.Score, PAM.CommentCount, PAM.CloseCount, PAM.ReopenCount, PAM.EditCount
    HAVING (
            SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) > 5
            AND (CAST(SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS double precision) / NULLIF(SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) + SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END), 0)) > 0.3
        )
        OR PAM.ReopenCount >= 2
        OR (PAM.CloseCount > 0 AND PAM.EditCount > 5)
),
UserPostAggregates AS (
    SELECT
        PAM.OwnerUserId_NotNull AS OwnerUserId,
        COUNT(PAM.PostId) AS UserTotalPosts,
        AVG(PAM.Score) AS UserAvgPostScore,
        MAX(PAM.ViewCount) AS UserMaxPostViews,
        SUM(PAM.EditCount) AS UserTotalPostEdits,
        AVG(CASE WHEN PAM.PostTypeId = 1 THEN PAM.QuestionEngagementRatio ELSE NULL END) AS UserAvgQuestionEngagement,
        AVG(CASE WHEN PAM.PostTypeId = 2 THEN PAM.AnswerPerformanceMetric ELSE NULL END) AS UserAvgAnswerPerformance,
        MIN(PAM.PostCreationDate) AS FirstPostDate,
        MAX(PAM.PostCreationDate) AS LastPostDate,
        COUNT(DISTINCT PAM.PostId) FILTER (WHERE PAM.ClosedDate IS NOT NULL) AS ClosedPostsCount,
        COUNT(DISTINCT PAM.PostId) FILTER (WHERE PAM.AcceptedAnswerId IS NOT NULL) AS AcceptedAnswersPostsCount
    FROM PostActivityMetrics PAM
    WHERE PAM.OwnerUserId_NotNull != -1
    GROUP BY PAM.OwnerUserId_NotNull
    HAVING COUNT(PAM.PostId) > 2
),
UserTopTagRank AS (
    SELECT
        U.Id AS UserId,
        T.TagName,
        SUM(P.Score) AS TagScoreSum,
        COUNT(P.Id) AS TagPostCount,
        ROW_NUMBER() OVER (PARTITION BY U.Id ORDER BY SUM(P.Score) DESC, COUNT(P.Id) DESC) as rn
    FROM Users U
    JOIN Posts P ON U.Id = P.OwnerUserId
    CROSS JOIN LATERAL (
        -- split tags string into rows; implementations vary by dialect
        SELECT REGEXP_SUBSTR(P.Tags, '[^><]+', 1, level) AS TagName
        FROM (SELECT 1) x
    ) T
    WHERE P.Tags IS NOT NULL AND LENGTH(P.Tags) > 2
    GROUP BY U.Id, T.TagName
)
SELECT
    'High-Engagement Users Report' AS ReportCategory,
    UBS.UserId,
    UBS.DisplayName,
    UBS.Reputation,
    UBS.WeightedUserScore,
    UPOA.UserTotalPosts,
    UBS.TotalComments,
    UBS.TotalBadges,
    UTTR.TagName AS TopContributingTag,
    TUP.AvgTagScore AS TopTagAvgScore,
    UPOA.UserAvgPostScore,
    UPOA.UserMaxPostViews,
    UPOA.UserTotalPostEdits,
    UPOA.UserAvgQuestionEngagement,
    UPOA.UserAvgAnswerPerformance,
    UPOA.ClosedPostsCount,
    UPOA.AcceptedAnswersPostsCount,
    CAST((EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - UBS.LastAccessDate)) / 86400) AS INTEGER) AS DaysSinceLastAccess,
    CONCAT(LEFT(COALESCE(UBS.DisplayName, 'Unknown'), 5), '...', RIGHT(COALESCE(UBS.DisplayName, 'Unknown'), 3)) AS DisplayNameSnippet,
    ROW_NUMBER() OVER (ORDER BY UBS.WeightedUserScore DESC, UPOA.UserAvgPostScore DESC NULLS LAST) AS OverallRank,
    (SELECT AVG(CP_Inner.DownvoteRatio) FROM ControversialPosts CP_Inner WHERE CP_Inner.OwnerUserId = UBS.UserId) AS AvgControversialPostRatio,
    CASE
        WHEN UBS.GoldBadges >= 3 AND UBS.Reputation > 50000 THEN 'Gold Tier Contributor'
        WHEN UBS.TotalBadges >= 10 AND UBS.Reputation > 10000 THEN 'Silver Tier Contributor'
        WHEN UBS.TotalPosts >= 50 AND UBS.TotalComments >= 20 THEN 'Bronze Tier Contributor'
        ELSE 'Aspiring Contributor'
    END AS ContributorTier
FROM UserBaseStats UBS
INNER JOIN UserPostAggregates UPOA ON UBS.UserId = UPOA.OwnerUserId
LEFT JOIN UserTopTagRank UTTR ON UBS.UserId = UTTR.UserId AND UTTR.rn = 1
LEFT JOIN TagUsageAndPerformance TUP ON UTTR.TagName = TUP.TagName
WHERE UBS.WeightedUserScore > (SELECT PERCENTILE_CONT(0.90) WITHIN GROUP (ORDER BY WeightedUserScore) FROM UserBaseStats)
  AND UPOA.UserTotalPosts >= 10
  AND UBS.LastAccessDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year'
  AND COALESCE(UBS.DisplayName, '') NOT LIKE '%bot%'
UNION ALL
SELECT
    'Controversial Content Creators Report' AS ReportCategory,
    UBS.UserId,
    UBS.DisplayName,
    UBS.Reputation,
    UBS.WeightedUserScore,
    UPOA.UserTotalPosts,
    UBS.TotalComments,
    UBS.TotalBadges,
    UTTR.TagName AS TopContributingTag,
    TUP.AvgTagScore AS TopTagAvgScore,
    UPOA.UserAvgPostScore,
    UPOA.UserMaxPostViews,
    UPOA.UserTotalPostEdits,
    UPOA.UserAvgQuestionEngagement,
    UPOA.UserAvgAnswerPerformance,
    UPOA.ClosedPostsCount,
    UPOA.AcceptedAnswersPostsCount,
    CAST((EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - UBS.LastAccessDate)) / 86400) AS INTEGER) AS DaysSinceLastAccess,
    CONCAT(LEFT(COALESCE(UBS.DisplayName, 'Unknown'), 5), '...', RIGHT(COALESCE(UBS.DisplayName, 'Unknown'), 3)) AS DisplayNameSnippet,
    ROW_NUMBER() OVER (ORDER BY CP.DownvoteRatio DESC, CP.LastClosedDate DESC NULLS LAST) AS OverallRank,
    CP.DownvoteRatio AS AvgControversialPostRatio,
    'High-Risk Contributor' AS ContributorTier
FROM UserBaseStats UBS
INNER JOIN ControversialPosts CP ON UBS.UserId = CP.OwnerUserId
LEFT JOIN UserPostAggregates UPOA ON UBS.UserId = UPOA.OwnerUserId
LEFT JOIN UserTopTagRank UTTR ON UBS.UserId = UTTR.UserId AND UTTR.rn = 1
LEFT JOIN TagUsageAndPerformance TUP ON UTTR.TagName = TUP.TagName
WHERE UBS.Reputation > 500
  AND CP.DownvoteRatio > 0.4
  AND CP.ReopenCount >= 1
ORDER BY ReportCategory, OverallRank
LIMIT 200;