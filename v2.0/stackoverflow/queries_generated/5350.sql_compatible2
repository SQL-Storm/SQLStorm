WITH
recent_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.OwnerUserId,
    p.Score,
    p.ViewCount,
    p.LastActivityDate,
    p.CommentCount,
    p.FavoriteCount,
    p.AcceptedAnswerId,
    p.ParentId
  FROM Posts p
  WHERE p.PostTypeId = 1
),
-- split tags into rows using standard SQL: replace leading/trailing <> then split by '><' using recursive CTE
all_tags AS (
  SELECT
    Id,
    TRIM(BOTH '<>' FROM Tags) AS tags_clean
  FROM Posts
  WHERE PostTypeId = 1
),
tag_rows AS (
  SELECT Id, 
         CASE WHEN tags_clean = '' THEN NULL ELSE tags_clean END AS rest,
         NULL::VARCHAR AS tag,  -- dialect-agnostic cast replaced below where supported; keep as text-compatible
         1 AS pos
  FROM all_tags
  UNION ALL
  SELECT
    Id,
    CASE 
      WHEN instr(rest, '><') > 0 THEN substr(rest, instr(rest, '><') + 2)
      ELSE NULL
    END AS rest,
    CASE 
      WHEN instr(rest, '><') > 0 THEN substr(rest, 1, instr(rest, '><') - 1)
      ELSE rest
    END AS tag,
    pos + 1
  FROM tag_rows
  WHERE rest IS NOT NULL
),
normalized_tags AS (
  SELECT DISTINCT tag
  FROM tag_rows
  WHERE tag IS NOT NULL AND tag <> ''
),
tag_activity AS (
  SELECT
    tr.tag,
    COUNT(*) AS qcount,
    SUM(p.Score) AS total_score,
    SUM(p.ViewCount) AS total_views
  FROM tag_rows tr
  JOIN Posts p ON p.Id = tr.Id
  WHERE tr.tag IS NOT NULL AND p.PostTypeId = 1
  GROUP BY tr.tag
),
per_user_activity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT r.Id) AS recent_questions,
    SUM(r.Score) AS recent_score,
    AVG(r.ViewCount) AS avg_views
  FROM Users u
  LEFT JOIN Posts r ON r.OwnerUserId = u.Id AND r.PostTypeId = 1
  WHERE u.AccountId IS NOT NULL
  GROUP BY u.Id, u.DisplayName, u.Reputation
),
av_scores AS (
  SELECT
    nt.tag,
    SUM(p.Score) AS total_score
  FROM normalized_tags nt
  JOIN tag_rows tr ON tr.tag = nt.tag
  JOIN Posts p ON p.Id = tr.Id AND p.PostTypeId = 1
  GROUP BY nt.tag
),
complex_metrics AS (
  SELECT
    q.PostId,
    q.Title,
    q.CreationDate,
    q.OwnerUserId,
    q.Score AS question_score,
    q.ViewCount AS question_views,
    COALESCE(av.total_score, 0) AS avg_tag_score,
    COALESCE(ta.total_views, 0) AS tag_total_views,
    CASE WHEN q.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS has_accepted,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = q.PostId AND v.VoteTypeId = 2) AS upvotes,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = q.PostId AND v.VoteTypeId = 3) AS downvotes,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = q.PostId) AS comment_count,
    q.Tags
  FROM recent_questions q
  LEFT JOIN tag_activity ta ON ta.tag IN (
    SELECT tag FROM tag_rows tr2 WHERE tr2.Id = q.PostId AND tr2.tag IS NOT NULL
  )
  LEFT JOIN av_scores av ON av.tag IN (
    SELECT tag FROM tag_rows tr3 WHERE tr3.Id = q.PostId AND tr3.tag IS NOT NULL
  )
  GROUP BY
    q.PostId,
    q.Title,
    q.CreationDate,
    q.OwnerUserId,
    q.Score,
    q.ViewCount,
    q.AcceptedAnswerId,
    q.Tags,
    av.total_score,
    ta.total_views
),
latest_commenters AS (
  SELECT
    c.PostId,
    c.UserId,
    u.DisplayName,
    u.Reputation,
    ROW_NUMBER() OVER (PARTITION BY c.PostId ORDER BY c.CreationDate DESC) AS rn
  FROM Comments c
  JOIN Users u ON u.Id = c.UserId
)
SELECT
  cm.PostId,
  cm.Title,
  cm.CreationDate,
  cm.OwnerUserId,
  cm.question_score,
  cm.question_views,
  cm.avg_tag_score,
  cm.tag_total_views,
  cm.has_accepted,
  cm.upvotes,
  cm.downvotes,
  cm.comment_count,
  lc.UserId AS commenter_userid,
  lc.DisplayName AS commenter_name,
  lc.Reputation AS commenter_reputation
FROM complex_metrics cm
LEFT JOIN Posts p2 ON p2.Id = cm.PostId
LEFT JOIN latest_commenters lc ON lc.PostId = cm.PostId AND lc.rn = 1
GROUP BY
  cm.PostId,
  cm.Title,
  cm.CreationDate,
  cm.OwnerUserId,
  cm.question_score,
  cm.question_views,
  cm.avg_tag_score,
  cm.tag_total_views,
  cm.has_accepted,
  cm.upvotes,
  cm.downvotes,
  cm.comment_count,
  lc.UserId,
  lc.DisplayName,
  lc.Reputation,
  p2.Id
ORDER BY cm.question_views DESC, cm.question_score DESC
LIMIT 100;