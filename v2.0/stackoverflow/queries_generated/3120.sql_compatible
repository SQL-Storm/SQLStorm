WITH 
UserPostAgg AS (
    SELECT 
        u.Id                                          AS UserId,
        COUNT(p.Id)                                   AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS Questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS Answers,
        AVG(p.Score)                                  AS AvgScore,
        MAX(p.CreationDate)                           AS LastPostDate,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.Id END) AS CloseVotesReceived
    FROM Users u
    LEFT JOIN Posts p        ON p.OwnerUserId = u.Id
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId = 10
    GROUP BY u.Id
),
UserBadgeAgg AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(*)                                      AS TotalBadges,
        MAX(b.Date)                                   AS LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
UserVoteAgg AS (
    SELECT 
        v.UserId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS FavoritesGiven,
        COUNT(*)                                         AS TotalVotesGiven
    FROM Votes v
    WHERE v.UserId IS NOT NULL
    GROUP BY v.UserId
),
UserRankings AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COALESCE(p.TotalPosts,0)           AS TotalPosts,
        COALESCE(b.TotalBadges,0)          AS TotalBadges,
        COALESCE(p.LastPostDate, u.CreationDate) AS LastActivityDate,
        RANK() OVER (ORDER BY u.Reputation DESC)           AS ReputationRank,
        ROW_NUMBER() OVER (
            PARTITION BY CASE WHEN COALESCE(p.TotalPosts,0) = 0 THEN 1 ELSE 0 END 
            ORDER BY u.CreationDate
        )                                 AS NewUserSeq
    FROM Users u
    LEFT JOIN UserPostAgg p ON p.UserId = u.Id
    LEFT JOIN UserBadgeAgg b ON b.UserId = u.Id
),
TagPopularity AS (
    SELECT 
        t.TagName,
        t.Count                      AS TagUseCount,
        p.Id                         AS ExcerptPostId,
        p.Score                      AS ExcerptScore,
        ROW_NUMBER() OVER (PARTITION BY t.TagName ORDER BY p.Score DESC) AS ExcerptRank
    FROM Tags t
    LEFT JOIN Posts p ON p.Id = t.ExcerptPostId
    WHERE t.IsModeratorOnly = 0
)
SELECT
    ur.Id                         AS UserId,
    ur.DisplayName,
    ur.TotalPosts,
    ur.TotalBadges,
    ur.Reputation,
    ur.ReputationRank,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    uv.UpVotesGiven,
    uv.DownVotesGiven,
    uv.FavoritesGiven,
    CASE
        WHEN ur.TotalPosts = 0                     THEN 'NoPosts'
        WHEN ur.TotalPosts < 5                     THEN 'LowActivity'
        WHEN ur.TotalPosts BETWEEN 5 AND 20        THEN 'MediumActivity'
        ELSE                                          'HighActivity'
    END                                          AS ActivityTier,
    ur.LastActivityDate,
    COALESCE(ub.LastBadgeDate, TIMESTAMP '1970-01-01') AS LastBadgeEarned,
    tp.TagName,
    tp.TagUseCount,
    tp.ExcerptPostId,
    tp.ExcerptScore
FROM UserRankings ur
LEFT JOIN UserBadgeAgg ub ON ub.UserId = ur.Id
LEFT JOIN UserVoteAgg  uv ON uv.UserId = ur.Id
LEFT JOIN LATERAL (
    SELECT 
        tp.TagName,
        tp.TagUseCount,
        tp.ExcerptPostId,
        tp.ExcerptScore
    FROM TagPopularity tp
    WHERE tp.TagUseCount > 1000
    ORDER BY tp.TagUseCount DESC
    LIMIT 1
) tp ON TRUE
WHERE ur.ReputationRank <= 1000

UNION ALL

SELECT
    u.Id                         AS UserId,
    u.DisplayName,
    0                            AS TotalPosts,
    0                            AS TotalBadges,
    u.Reputation,
    NULL                         AS ReputationRank,
    0                            AS GoldBadges,
    0                            AS SilverBadges,
    0                            AS BronzeBadges,
    0                            AS UpVotesGiven,
    0                            AS DownVotesGiven,
    0                            AS FavoritesGiven,
    'NeverPosted'                AS ActivityTier,
    u.CreationDate               AS LastActivityDate,
    NULL                         AS LastBadgeEarned,
    NULL                         AS TagName,
    NULL                         AS TagUseCount,
    NULL                         AS ExcerptPostId,
    NULL                         AS ExcerptScore
FROM Users u
WHERE NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id)
  AND u.Reputation > 0

ORDER BY Reputation DESC
LIMIT 2000;