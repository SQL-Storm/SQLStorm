WITH UserPostStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS TotalAnswerScore,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS AvgAnswerScore,
        MAX(p.CreationDate) AS LastPostDate,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        STRING_AGG(DISTINCT b.Name, ', ') AS Badges,
        COUNT(DISTINCT c.Id) AS CommentCount,
        MAX(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount END) AS MaxQuestionViews,
        MAX(CASE WHEN p.PostTypeId = 2 THEN p.ViewCount END) AS MaxAnswerViews,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank,
        ROW_NUMBER() OVER (ORDER BY SUM(p.Score) DESC) AS ScoreRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        TotalPosts,
        QuestionCount,
        AnswerCount,
        TotalQuestionScore,
        TotalAnswerScore,
        AvgQuestionScore,
        AvgAnswerScore,
        LastPostDate,
        BadgeCount,
        Badges,
        CommentCount,
        MaxQuestionViews,
        MaxAnswerViews,
        PostRank,
        ScoreRank,
        CASE 
            WHEN TotalPosts > 0 THEN (AnswerCount * 100.0 / TotalPosts)
            ELSE 0 
        END AS AnswerPercentage,
        CASE 
            WHEN QuestionCount > 0 THEN (TotalQuestionScore * 1.0 / QuestionCount)
            ELSE 0 
        END AS AvgScorePerQuestion,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - COALESCE(LastPostDate, TIMESTAMP '1970-01-01'))) / 86400 AS INTEGER) AS DaysSinceLastPost,
        CASE 
            WHEN Reputation > 10000 THEN 'Elite'
            WHEN Reputation > 5000 THEN 'Veteran'
            WHEN Reputation > 1000 THEN 'Contributor'
            ELSE 'Member'
        END AS ReputationTier,
        CASE 
            WHEN TotalPosts > 100 THEN 'Active'
            WHEN TotalPosts > 50 THEN 'Regular'
            WHEN TotalPosts > 10 THEN 'Occasional'
            ELSE 'New'
        END AS PostingFrequency
    FROM UserPostStats
    WHERE TotalPosts > 0
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.PostTypeId,
        CASE 
            WHEN p.PostTypeId = 1 THEN p.AnswerCount 
            ELSE NULL 
        END AS AnswerCount,
        CASE 
            WHEN p.PostTypeId = 1 THEN p.CommentCount 
            ELSE NULL 
        END AS CommentCount,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId IN (2,3)) AS NetVotes,
        CASE 
            WHEN p.PostTypeId = 1 THEN (SELECT COUNT(*) FROM Posts a WHERE a.ParentId = p.Id AND a.PostTypeId = 2)
            ELSE NULL 
        END AS ActualAnswerCount,
        (SELECT u.DisplayName FROM Users u WHERE u.Id = p.OwnerUserId) AS OwnerName,
        (SELECT STRING_AGG(tagname, ', ') FROM (
            SELECT TRIM(regexp_split_to_table(TRIM(BOTH '<>' FROM p.Tags), '><')) AS tagname
        ) t) AS TagsList,
        (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3) AS DuplicateLinkCount,
        (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10) AS CloseCount,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400 AS INTEGER) AS AgeInDays,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id AND c.UserId IS NOT NULL) AS CommentedByUsers,
        CASE 
            WHEN (p.Score > 0 OR p.ViewCount > 1000 OR p.CommentCount > 10 OR p.AnswerCount > 5)
            THEN 'HighImpact'
            WHEN (p.Score > -5 OR p.ViewCount > 100 OR p.CommentCount > 2)
            THEN 'MediumImpact'
            ELSE 'LowImpact'
        END AS ImpactLevel,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PreviousScore,
        LAG(p.CreationDate, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PreviousPostDate,
        (p.Score - LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate)) AS ScoreChange,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PostSequence,
        PERCENT_RANK() OVER (ORDER BY p.Score DESC) AS ScorePercentile
    FROM Posts p
    WHERE p.Id IS NOT NULL
),
UserAggregatedStats AS (
    SELECT 
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.TotalPosts,
        tu.QuestionCount,
        tu.AnswerCount,
        tu.TotalQuestionScore,
        tu.TotalAnswerScore,
        tu.AvgQuestionScore,
        tu.AvgAnswerScore,
        tu.LastPostDate,
        tu.BadgeCount,
        tu.Badges,
        tu.CommentCount,
        tu.MaxQuestionViews,
        tu.MaxAnswerViews,
        tu.PostRank,
        tu.ScoreRank,
        tu.AnswerPercentage,
        tu.AvgScorePerQuestion,
        tu.DaysSinceLastPost,
        tu.ReputationTier,
        tu.PostingFrequency,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = tu.UserId AND p.PostTypeId = 1 AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')) AS RecentQuestions,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = tu.UserId AND p.PostTypeId = 2 AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')) AS RecentAnswers,
        (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = tu.UserId AND p.PostTypeId = 1 AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')) AS AvgRecentQuestionScore,
        (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = tu.UserId AND p.PostTypeId = 2 AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')) AS AvgRecentAnswerScore,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = tu.UserId AND p.PostTypeId = 1 AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')) AS QuestionsLast6Months,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = tu.UserId AND p.PostTypeId = 2 AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')) AS AnswersLast6Months,
        (SELECT STRING_AGG(DISTINCT p.Title, '; ') FROM Posts p WHERE p.OwnerUserId = tu.UserId AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '3 months')) AS RecentTitles,
        (SELECT COUNT(*) FROM Comments c WHERE c.UserId = tu.UserId AND c.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 month')) AS RecentComments,
        (SELECT COUNT(*) FROM Votes v WHERE v.UserId = tu.UserId AND v.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 month')) AS RecentVotes,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = tu.UserId AND b.Date >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 month')) AS RecentBadges,
        CASE 
            WHEN tu.PostingFrequency = 'Active' AND EXISTS (
                SELECT 1 FROM Posts p WHERE p.OwnerUserId = tu.UserId AND CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400 AS INTEGER) <= 7
            ) THEN 'VeryActive'
            WHEN tu.PostingFrequency = 'Active' THEN 'Active'
            WHEN tu.PostingFrequency = 'Regular' AND EXISTS (
                SELECT 1 FROM Posts p WHERE p.OwnerUserId = tu.UserId AND CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400 AS INTEGER) <= 30
            ) THEN 'RegularActive'
            ELSE 'Inactive'
        END AS UserActivityLevel
    FROM TopUsers tu
),
FinalAnalysis AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.TotalPosts,
        uas.QuestionCount,
        uas.AnswerCount,
        uas.TotalQuestionScore,
        uas.TotalAnswerScore,
        uas.AvgQuestionScore,
        uas.AvgAnswerScore,
        uas.LastPostDate,
        uas.BadgeCount,
        uas.Badges,
        uas.CommentCount,
        uas.MaxQuestionViews,
        uas.MaxAnswerViews,
        uas.PostRank,
        uas.ScoreRank,
        uas.AnswerPercentage,
        uas.AvgScorePerQuestion,
        uas.DaysSinceLastPost,
        uas.ReputationTier,
        uas.PostingFrequency,
        uas.RecentQuestions,
        uas.RecentAnswers,
        uas.AvgRecentQuestionScore,
        uas.AvgRecentAnswerScore,
        uas.QuestionsLast6Months,
        uas.AnswersLast6Months,
        uas.RecentTitles,
        uas.RecentComments,
        uas.RecentVotes,
        uas.RecentBadges,
        uas.UserActivityLevel,
        (SELECT STRING_AGG(pa.Title, '; ') FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName AND pa.ScorePercentile > 0.9) AS HighScoringTitles,
        (SELECT COUNT(*) FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName AND pa.Score > 100) AS HighScorePosts,
        (SELECT AVG(pa.Score) FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName AND pa.PostTypeId = 1) AS AvgQuestionScoreAllTime,
        (SELECT MAX(pa.ViewCount) FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName) AS MaxPostViews,
        (SELECT COUNT(*) FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName AND pa.PostTypeId = 1 AND pa.AgeInDays <= 30) AS FreshQuestions,
        (SELECT SUM(pa.Score) FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName AND pa.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 month')) AS MonthlyScore,
        (SELECT COUNT(*) FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName AND pa.DuplicateLinkCount > 0) AS PostsWithDuplicates,
        (SELECT COUNT(*) FROM PostAnalysis pa WHERE pa.OwnerName = uas.DisplayName AND pa.CloseCount > 0) AS ClosedPosts
    FROM UserAggregatedStats uas
)
SELECT 
    f.UserId,
    f.DisplayName,
    f.Reputation,
    f.TotalPosts,
    f.QuestionCount,
    f.AnswerCount,
    f.TotalQuestionScore,
    f.TotalAnswerScore,
    f.AvgQuestionScore,
    f.AvgAnswerScore,
    f.LastPostDate,
    f.BadgeCount,
    f.Badges,
    f.CommentCount,
    f.MaxQuestionViews,
    f.MaxAnswerViews,
    f.PostRank,
    f.ScoreRank,
    f.AnswerPercentage,
    f.AvgScorePerQuestion,
    f.DaysSinceLastPost,
    f.ReputationTier,
    f.PostingFrequency,
    f.RecentQuestions,
    f.RecentAnswers,
    f.AvgRecentQuestionScore,
    f.AvgRecentAnswerScore,
    f.QuestionsLast6Months,
    f.AnswersLast6Months,
    f.RecentTitles,
    f.RecentComments,
    f.RecentVotes,
    f.RecentBadges,
    f.UserActivityLevel,
    f.HighScoringTitles,
    f.HighScorePosts,
    f.AvgQuestionScoreAllTime,
    f.MaxPostViews,
    f.FreshQuestions,
    f.MonthlyScore,
    f.PostsWithDuplicates,
    f.ClosedPosts,
    CASE 
        WHEN f.ReputationTier = 'Elite' AND f.UserActivityLevel = 'VeryActive' THEN 'TopContributor'
        WHEN f.ReputationTier = 'Veteran' AND f.UserActivityLevel = 'Active' THEN 'Veteran'
        WHEN f.ReputationTier IN ('Contributor', 'Member') AND f.UserActivityLevel IN ('RegularActive', 'Active') THEN 'RegularContributor'
        ELSE 'Standard'
    END AS UserClassification,
    ROUND((f.Reputation * f.ScoreRank * f.PostRank) / (f.TotalPosts + 1), 2) AS PerformanceScore,
    (f.TotalPosts * f.Reputation) / (f.DaysSinceLastPost + 1) AS PostEfficiency,
    (f.BadgeCount * f.Reputation) / (f.TotalPosts + f.AnswerCount + 1) AS BadgeInfluence,
    (f.QuestionCount * f.AvgQuestionScore) / (f.AnswerCount + 1) AS QuestionImpact,
    (f.AnswersLast6Months * f.AvgRecentAnswerScore) / (f.RecentComments + 1) AS AnswerProductivity,
    CASE 
        WHEN f.PostRank <= 10 THEN 'Top10'
        WHEN f.PostRank <= 50 THEN 'Top50'
        WHEN f.PostRank <= 100 THEN 'Top100'
        ELSE 'Other'
    END AS RankingTier,
    CASE 
        WHEN f.AvgRecentAnswerScore > 50 AND f.AvgRecentQuestionScore > 50 THEN 'HighPerforming'
        WHEN f.AvgRecentAnswerScore > 10 OR f.AvgRecentQuestionScore > 10 THEN 'Moderate'
        ELSE 'Low'
    END AS PerformanceLevel,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = f.UserId AND p.PostTypeId = 1 AND (p.ViewCount > f.MaxQuestionViews OR p.Score > f.TotalQuestionScore)) AS HighPerformingPosts,
    CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - COALESCE(f.LastPostDate, TIMESTAMP '1970-01-01'))) / 86400 AS INTEGER) - 
    (SELECT AVG(CAST(EXTRACT(EPOCH FROM (p2.CreationDate - p1.CreationDate)) / 86400 AS INTEGER)) 
     FROM Posts p1 
     JOIN Posts p2 ON p1.OwnerUserId = p2.OwnerUserId AND p1.CreationDate < p2.CreationDate
     WHERE p1.OwnerUserId = f.UserId AND p1.PostTypeId = 1 AND p2.PostTypeId = 1) AS PostingIntervalVariance,
    (SELECT COUNT(DISTINCT pa.TagsList) FROM PostAnalysis pa WHERE pa.OwnerName = f.DisplayName) AS UniqueTagCount,
    CASE 
        WHEN (f.TotalPosts > 200 AND f.BadgeCount > 50) OR (f.Reputation > 50000 AND f.TotalPosts > 100) THEN 'Experienced'
        WHEN f.TotalPosts > 100 AND f.Reputation > 5000 THEN 'Veteran'
        WHEN f.TotalPosts > 50 AND f.Reputation > 1000 THEN 'Contributor'
        ELSE 'Beginner'
    END AS ExperienceLevel
FROM FinalAnalysis f
WHERE f.Reputation > 0
ORDER BY f.Reputation DESC
LIMIT 1000;