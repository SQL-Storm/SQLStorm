with RecursiveUserActivity as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionsPosted,
        count(distinct p2.Id) filter (where p2.PostTypeId = 2) as AnswersPosted,
        sum(coalesce(p.Score,0)) filter (where p.PostTypeId in (1,2)) as TotalPostScore,
        row_number() over (partition by u.Id order by max(p.CreationDate) desc) as LastPostRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Posts p2 on p2.OwnerUserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
UserBadgeScores as (
    select 
        b.UserId,
        count(*) as BadgeCount,
        sum(case when b.Class = 1 then 3 when b.Class = 2 then 2 else 1 end) as BadgeScore,
        bool_or(b.TagBased) as HasTagBasedBadges
    from Badges b
    group by b.UserId
),
UserPostAggregates as (
    select
        u.Id as UserId,
        avg(p.Score) filter (where p.PostTypeId in (1,2)) as AvgPostScore,
        max(p.Score) filter (where p.PostTypeId in (1,2)) as MaxPostScore,
        min(p.Score) filter (where p.PostTypeId in (1,2)) as MinPostScore,
        sum(p.ViewCount) filter (where p.PostTypeId = 1) as TotalQuestionViews,
        sum(p.AnswerCount) filter (where p.PostTypeId = 1) as TotalAnswersReceived
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    group by u.Id
),
QuestionAnswerDetails as (
    select 
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount,
        a.Id as AnswerId,
        a.CreationDate as AnswerCreation,
        a.Score as AnswerScore,
        u.DisplayName as Answerer,
        row_number() over (partition by q.Id order by a.Score desc, a.CreationDate) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Users u on a.OwnerUserId = u.Id
    where q.PostTypeId = 1
),
TopQuestionsWithAcceptedAnswers AS (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        a.Id as AcceptedAnswerId,
        a.Score as AcceptedAnswerScore,
        u.DisplayName as AcceptedAnswerer,
        count(distinct pl.Id) filter (where pl.LinkTypeId = 3) as DuplicateCount,
        count(distinct c.Id) as CommentCount,
        bool_or(ph.PostHistoryTypeId = 10 AND cr.Name = 'Duplicate') as HasDuplicateCloseReason
    from Posts q
    left join Posts a on a.Id = q.AcceptedAnswerId
    left join Users u on a.OwnerUserId = u.Id
    left join PostLinks pl on pl.PostId = q.Id
    left join Comments c on c.PostId = q.Id
    left join PostHistory ph on ph.PostId = q.Id and ph.PostHistoryTypeId = 10
    left join CloseReasonTypes cr on cast(ph.Comment as integer) = cr.Id
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.CreationDate, q.Score, q.ViewCount, a.Id, a.Score, u.DisplayName
),
UserEngagementRankings AS (
    select 
        u.Id,
        u.DisplayName,
        coalesce(ups.AvgPostScore,0) as AvgPostScore,
        coalesce(ups.MaxPostScore,0) as MaxPostScore,
        coalesce(ups.MinPostScore,0) as MinPostScore,
        coalesce(uba.BadgeScore,0) as BadgeScore,
        coalesce(rua.QuestionsPosted,0) as QuestionsPosted,
        coalesce(rua.AnswersPosted,0) as AnswersPosted,
        rank() over(order by coalesce(ups.AvgPostScore,0) desc) as AvgScoreRank,
        rank() over(order by coalesce(uba.BadgeScore,0) desc) as BadgeScoreRank,
        rank() over(order by coalesce(rua.AnswersPosted,0) desc) as AnswersPostedRank,
        rank() over(order by coalesce(rua.QuestionsPosted,0) desc) as QuestionsPostedRank
    from Users u
    left join UserPostAggregates ups on ups.UserId = u.Id
    left join UserBadgeScores uba on uba.UserId = u.Id
    left join RecursiveUserActivity rua on rua.UserId = u.Id
    group by u.Id, u.DisplayName, ups.AvgPostScore, ups.MaxPostScore, ups.MinPostScore, uba.BadgeScore, rua.QuestionsPosted, rua.AnswersPosted
),
TopEngagedUsers AS (
    select *
    from UserEngagementRankings
    where (AvgScoreRank <= 10 or BadgeScoreRank <= 10 or AnswersPostedRank <= 10 or QuestionsPostedRank <= 10)
),
RecentHotQuestions as (
    select distinct q.Id, q.Title, q.CreationDate, q.Score, q.ViewCount
    from Posts q
    join Votes v on v.PostId = q.Id and v.VoteTypeId = 52
    where q.PostTypeId = 1 and q.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
),
StringManipulationAndNullLogic AS (
    select
        p.Id,
        p.Title,
        p.Tags,
        case 
            when p.Tags is null then 'No Tags' 
            else array_to_string(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><'), ', ') 
        end as CleanedTags,
        coalesce(p.OwnerDisplayName, u.DisplayName, 'Community') as OwnerName,
        length(p.Body) as BodyLength,
        case 
            when p.ClosedDate is not null then 'Closed'
            when p.AcceptedAnswerId is not null then 'Answered'
            else 'Open'
        end as PostStatus
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId = 1
)
select 
    teu.Id as UserId,
    teu.DisplayName,
    teu.AvgPostScore,
    teu.BadgeScore,
    teu.QuestionsPosted,
    teu.AnswersPosted,
    tq.Title as TopQuestionTitle,
    tq.Score as TopQuestionScore,
    tq.ViewCount as TopQuestionViews,
    dq.DuplicateCount,
    dqs.HasDuplicateCloseReason,
    raq.CleanedTags,
    raq.OwnerName,
    raq.BodyLength,
    raq.PostStatus,
    rq.Score as RecentHotQuestionScore,
    rq.ViewCount as RecentHotQuestionViews
from TopEngagedUsers teu
left join lateral (
    select q.QuestionId, q.Title, q.Score, q.ViewCount, tld.DuplicateCount, q.AcceptedAnswerer
    from TopQuestionsWithAcceptedAnswers q
    left join (
        select QuestionId, count(*) as DuplicateCount
        from PostLinks
        where LinkTypeId = 3
        group by QuestionId
    ) tld on tld.QuestionId = q.QuestionId
    where q.AcceptedAnswerer = teu.DisplayName
    order by q.Score desc
    limit 1
) tq on true
left join TopQuestionsWithAcceptedAnswers dqs on dqs.QuestionId = tq.QuestionId
left join lateral (
    select raq.*
    from StringManipulationAndNullLogic raq
    where raq.Id = (
        select Id from Posts 
        where OwnerUserId = teu.Id and PostTypeId = 1 
        order by CreationDate desc
        limit 1
    )
) raq on true
left join lateral (
    select rq.*
    from RecentHotQuestions rq
    join Posts p on p.Id = rq.Id
    where p.OwnerUserId = teu.Id
    order by rq.Score desc
    limit 1
) rq on true
left join (
    select tld.QuestionId, tld.DuplicateCount as DuplicateCount
    from (
        select QuestionId, count(*) as DuplicateCount
        from PostLinks
        where LinkTypeId = 3
        group by QuestionId
    ) tld
) dq on dq.QuestionId = tq.QuestionId
order by teu.AvgPostScore desc, teu.BadgeScore desc
limit 25;