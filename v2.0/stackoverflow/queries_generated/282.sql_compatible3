with recent_users as (
  select u.id,
         u.displayname,
         u.reputation,
         u.creationdate,
         u.location,
         coalesce(nullif(trim(u.websiteurl), ''), 'n/a') as websiteurl_norm
  from users u
  where u.creationdate >= (select date_trunc('month', max(creationdate)) - interval '12 months' from users)
),
questions as (
  select p.id,
         p.owneruserid,
         p.creationdate,
         p.score,
         p.viewcount,
         p.title,
         p.tags,
         p.acceptedanswerid,
         date_trunc('month', p.creationdate) as q_month
  from posts p
  where p.posttypeid = 1
),
answers as (
  select a.id,
         a.parentid as questionid,
         a.owneruserid,
         a.creationdate,
         a.score,
         date_trunc('month', a.creationdate) as a_month
  from posts a
  where a.posttypeid = 2
),
user_activity as (
  select ru.id as userid,
         count(distinct q.id) filter (where q.id is not null) as q_count,
         count(distinct a.id) filter (where a.id is not null) as a_count,
         sum(greatest(q.score,0)) filter (where q.id is not null) as q_pos_score,
         sum(greatest(a.score,0)) filter (where a.id is not null) as a_pos_score,
         sum(least(q.score,0)) filter (where q.id is not null) as q_neg_score,
         sum(least(a.score,0)) filter (where a.id is not null) as a_neg_score,
         min(least(coalesce(q.creationdate, a.creationdate), coalesce(a.creationdate, q.creationdate))) as first_post_ts,
         max(greatest(coalesce(q.creationdate, a.creationdate), coalesce(a.creationdate, q.creationdate))) as last_post_ts
  from recent_users ru
  left join questions q on q.owneruserid = ru.id
  left join answers a on a.owneruserid = ru.id
  group by ru.id
),
comment_stats as (
  select c.userid as userid,
         count(*) as comments,
         sum(c.score) as comment_score,
         avg(nullif(c.score,0)) as avg_nonzero_comment_score,
         max(c.creationdate) as last_comment_ts
  from comments c
  where c.creationdate >= (select min(creationdate) from recent_users)
  group by c.userid
),
vote_agg as (
  select v.userid as userid,
         count(*) filter (where v.votetypeid = 2) as upvotes_cast,
         count(*) filter (where v.votetypeid = 3) as downvotes_cast,
         count(*) filter (where v.votetypeid in (8,9)) as bounty_events,
         sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounty_amount_total,
         min(v.creationdate) as first_vote_ts,
         max(v.creationdate) as last_vote_ts
  from votes v
  where v.userid is not null
    and v.creationdate >= (select min(creationdate) from recent_users)
  group by v.userid
),
badge_agg as (
  select b.userid,
         count(*) as badges_total,
         count(*) filter (where b.class = 1) as gold,
         count(*) filter (where b.class = 2) as silver,
         count(*) filter (where b.class = 3) as bronze,
         count(*) filter (where b.tagbased = true) as tag_badges,
         min(b.date) as first_badge_ts,
         max(b.date) as last_badge_ts
  from badges b
  where b.date >= (select min(creationdate) from recent_users)
  group by b.userid
),
q_monthly as (
  select q.owneruserid as userid,
         q.q_month,
         count(*) as q_cnt,
         sum(q.viewcount) as q_views,
         avg(q.score) as q_avg_score
  from questions q
  group by q.owneruserid, q.q_month
),
a_monthly as (
  select a.owneruserid as userid,
         a.a_month,
         count(*) as a_cnt,
         avg(a.score) as a_avg_score
  from answers a
  group by a.owneruserid, a.a_month
),
monthly_union as (
  select userid,
         q_month as month_bucket,
         q_cnt,
         q_views,
         q_avg_score,
         cast(null as integer) as a_cnt,
         cast(null as numeric) as a_avg_score
  from q_monthly
  union all
  select userid,
         a_month as month_bucket,
         cast(null as integer) as q_cnt,
         cast(null as bigint) as q_views,
         cast(null as numeric) as q_avg_score,
         a_cnt,
         a_avg_score
  from a_monthly
),
monthly_rollup as (
  select mu.userid,
         mu.month_bucket,
         sum(coalesce(mu.q_cnt,0)) as q_cnt,
         sum(coalesce(mu.q_views,0)) as q_views,
         avg(mu.q_avg_score) as q_avg_score,
         sum(coalesce(mu.a_cnt,0)) as a_cnt,
         avg(mu.a_avg_score) as a_avg_score,
         row_number() over (partition by mu.userid order by mu.month_bucket desc) as rn_desc,
         sum(coalesce(mu.q_cnt,0) + coalesce(mu.a_cnt,0)) over (partition by mu.userid order by mu.month_bucket rows between unbounded preceding and current row) as running_posts
  from monthly_union mu
  group by mu.userid, mu.month_bucket
),
accepted_answer_lag as (
  select q.id as questionid,
         q.owneruserid as askerid,
         q.acceptedanswerid,
         min(a.creationdate) filter (where a.id = q.acceptedanswerid) as accepted_ts,
         q.creationdate as question_ts,
         cast(extract(epoch from (min(a.creationdate) filter (where a.id = q.acceptedanswerid) - q.creationdate)) as bigint) as seconds_to_accept
  from questions q
  left join answers a on a.parentid = q.id
  group by q.id, q.owneruserid, q.acceptedanswerid, q.creationdate
),
dup_links as (
  select pl.postid as dup_postid,
         pl.relatedpostid as master_postid,
         count(*) as dup_edges
  from postlinks pl
  where pl.linktypeid = 3
  group by pl.postid, pl.relatedpostid
),
close_events as (
  select ph.postid,
         min(ph.creationdate) as first_close_ts,
         max(ph.creationdate) as last_close_ts,
         count(*) filter (where ph.posthistorytypeid = 10) as close_votes_events,
         count(*) filter (where ph.posthistorytypeid = 11) as reopen_events,
         count(*) filter (where ph.posthistorytypeid in (10,11)) as volatility
  from posthistory ph
  where ph.posthistorytypeid in (10,11)
  group by ph.postid
),
tag_explode as (
  select p.id as postid,
         lower(trim(both '<>' from t.tag)) as tag
  from posts p
  cross join lateral unnest(string_to_array(substring(coalesce(p.tags,''), 2, greatest(length(coalesce(p.tags,''))-2,0)), '><')) as t(tag)
  where p.posttypeid = 1
),
top_tags as (
  select te.tag,
         count(*) as tag_q_count
  from tag_explode te
  group by te.tag
  having count(*) >= (
    select percentile_disc(0.95) within group (order by cnt)
    from (
      select count(*) as cnt
      from tag_explode
      group by tag
    ) s
  )
),
user_top_tag_hits as (
  select q.owneruserid as userid,
         count(distinct q.id) filter (where tt.tag is not null) as questions_in_top_tags
  from questions q
  left join tag_explode te on te.postid = q.id
  left join top_tags tt on tt.tag = te.tag
  group by q.owneruserid
),
string_complexity as (
  select q.id as postid,
         length(coalesce(q.title,'')) as title_len,
         length(regexp_replace(coalesce(q.title,''), '[^aeiouAEIOU]', '', 'g')) as title_vowels,
         length(coalesce(q.tags,'')) as tags_len,
         (case when position('python' in lower(coalesce(q.title,''))) > 0 then 1 else 0 end) as has_python_in_title
  from questions q
),
final_users as (
  select ru.*,
         ua.q_count,
         ua.a_count,
         coalesce(ua.q_pos_score,0) + coalesce(ua.a_pos_score,0) as pos_score_total,
         coalesce(ua.q_neg_score,0) + coalesce(ua.a_neg_score,0) as neg_score_total,
         ua.first_post_ts,
         ua.last_post_ts,
         cs.comments,
         cs.comment_score,
         cs.avg_nonzero_comment_score,
         cs.last_comment_ts,
         va.upvotes_cast,
         va.downvotes_cast,
         va.bounty_events,
         va.bounty_amount_total,
         va.first_vote_ts,
         va.last_vote_ts,
         ba.badges_total,
         ba.gold, ba.silver, ba.bronze, ba.tag_badges,
         ba.first_badge_ts, ba.last_badge_ts,
         utt.questions_in_top_tags
  from recent_users ru
  left join user_activity ua on ua.userid = ru.id
  left join comment_stats cs on cs.userid = ru.id
  left join vote_agg va on va.userid = ru.id
  left join badge_agg ba on ba.userid = ru.id
  left join user_top_tag_hits utt on utt.userid = ru.id
),
question_enriched as (
  select q.*,
         aal.seconds_to_accept,
         ce.first_close_ts,
         ce.last_close_ts,
         ce.close_votes_events,
         ce.reopen_events,
         dl.master_postid,
         sc.title_len,
         sc.title_vowels,
         sc.tags_len,
         sc.has_python_in_title
  from questions q
  left join accepted_answer_lag aal on aal.questionid = q.id
  left join close_events ce on ce.postid = q.id
  left join dup_links dl on dl.dup_postid = q.id
  left join string_complexity sc on sc.postid = q.id
),
user_post_window as (
  select qe.owneruserid as userid,
         qe.id as postid,
         qe.creationdate,
         qe.score,
         sum(qe.score) over (partition by qe.owneruserid order by qe.creationdate rows between unbounded preceding and current row) as running_user_score,
         avg(qe.score) over (partition by qe.owneruserid order by qe.creationdate rows between unbounded preceding and current row) as running_user_avg_score,
         lag(qe.creationdate) over (partition by qe.owneruserid order by qe.creationdate) as prev_post_ts,
         lead(qe.creationdate) over (partition by qe.owneruserid order by qe.creationdate) as next_post_ts
  from question_enriched qe
),
dense_activity_users as (
  select f.*,
         (coalesce(f.q_count,0) + coalesce(f.a_count,0) + coalesce(f.comments,0)) as activity_sum,
         case when coalesce(f.downvotes_cast,0) > coalesce(f.upvotes_cast,0) then 1 else 0 end as net_negative_voter
  from final_users f
  where (coalesce(f.q_count,0) + coalesce(f.a_count,0)) > 0
),
ranked_users as (
  select dau.*,
         dense_rank() over (
           order by
             coalesce(dau.pos_score_total,0) - abs(coalesce(dau.neg_score_total,0)) desc,
             coalesce(dau.badges_total,0) desc,
             coalesce(dau.activity_sum,0) desc
         ) as perf_rank
  from dense_activity_users dau
),
recent_months as (
  select distinct month_bucket
  from monthly_rollup
  where month_bucket >= (select date_trunc('month', max(creationdate)) - interval '6 months' from posts)
),
user_recent_pivot as (
  select mr.userid,
         sum(case when mr.month_bucket = rm.month_bucket then coalesce(mr.q_cnt,0) else 0 end) as q_cnt_m,
         sum(case when mr.month_bucket = rm.month_bucket then coalesce(mr.a_cnt,0) else 0 end) as a_cnt_m
  from monthly_rollup mr
  join recent_months rm on mr.month_bucket = rm.month_bucket
  group by mr.userid
),
post_joined as (
  select qe.*,
         upw.running_user_score,
         upw.running_user_avg_score,
         cast(extract(epoch from (qe.creationdate - upw.prev_post_ts)) as bigint) as secs_since_prev,
         cast(extract(epoch from (upw.next_post_ts - qe.creationdate)) as bigint) as secs_to_next
  from question_enriched qe
  left join user_post_window upw on upw.postid = qe.id
),
heavy_calc as (
  select pj.id as postid,
         pj.owneruserid as userid,
         coalesce(pj.seconds_to_accept, 0) as seconds_to_accept,
         coalesce(pj.close_votes_events, 0) * 1.0 / greatest(pj.viewcount,1) as close_rate_per_view,
         case when pj.title_vowels > 0 then cast(pj.title_len as numeric) / pj.title_vowels else null end as title_vowel_ratio,
         case when pj.tags_len > 0 then cast(pj.tags_len as numeric) / greatest(pj.score + pj.viewcount,1) else 0 end as tag_density_norm,
         (coalesce(pj.score,0) + coalesce(pj.viewcount,0)) * case when pj.has_python_in_title = 1 then 1.1 else 1 end as weighted_popularity,
         coalesce(pj.secs_since_prev,0) as secs_since_prev,
         coalesce(pj.secs_to_next,0) as secs_to_next
  from post_joined pj
),
final as (
  select ru.id as userid,
         ru.displayname,
         ru.reputation,
         ru.location,
         ru.websiteurl_norm,
         ru.creationdate as user_created,
         ru.q_count,
         ru.a_count,
         ru.pos_score_total,
         ru.neg_score_total,
         ru.comments,
         ru.comment_score,
         ru.avg_nonzero_comment_score,
         ru.upvotes_cast,
         ru.downvotes_cast,
         ru.bounty_events,
         ru.bounty_amount_total,
         ru.badges_total,
         ru.gold,
         ru.silver,
         ru.bronze,
         ru.questions_in_top_tags,
         urp.q_cnt_m as recent_q_cnt,
         urp.a_cnt_m as recent_a_cnt,
         ml.month_bucket,
         ml.q_cnt as month_q_cnt,
         ml.a_cnt as month_a_cnt,
         ml.running_posts,
         ru.first_post_ts,
         ru.last_post_ts,
         ru.first_vote_ts,
         ru.last_vote_ts,
         ru.first_badge_ts,
         ru.last_badge_ts,
         ru.last_comment_ts,
         ru.net_negative_voter,
         ru.perf_rank,
         avg(hc.seconds_to_accept) filter (where hc.seconds_to_accept > 0) as avg_seconds_to_accept,
         avg(nullif(hc.close_rate_per_view,0)) as avg_close_rate_per_view,
         avg(hc.title_vowel_ratio) as avg_title_vowel_ratio,
         avg(hc.tag_density_norm) as avg_tag_density_norm,
         avg(hc.weighted_popularity) as avg_weighted_popularity,
         percentile_cont(0.5) within group (order by hc.weighted_popularity) as median_weighted_popularity
  from ranked_users ru
  left join user_recent_pivot urp on urp.userid = ru.id
  left join monthly_rollup ml on ml.userid = ru.id
  left join heavy_calc hc on hc.userid = ru.id
  group by ru.id, ru.displayname, ru.reputation, ru.location, ru.websiteurl_norm, ru.creationdate,
           ru.q_count, ru.a_count, ru.pos_score_total, ru.neg_score_total, ru.comments, ru.comment_score,
           ru.avg_nonzero_comment_score, ru.upvotes_cast, ru.downvotes_cast, ru.bounty_events, ru.bounty_amount_total,
           ru.badges_total, ru.gold, ru.silver, ru.bronze, ru.questions_in_top_tags, urp.q_cnt_m, urp.a_cnt_m,
           ml.month_bucket, ml.q_cnt, ml.a_cnt, ml.running_posts, ru.first_post_ts, ru.last_post_ts,
           ru.first_vote_ts, ru.last_vote_ts, ru.first_badge_ts, ru.last_badge_ts, ru.last_comment_ts,
           ru.net_negative_voter, ru.perf_rank
)
select *
from final
where coalesce(pos_score_total,0) - abs(coalesce(neg_score_total,0)) + coalesce(bounty_amount_total,0) >= (
  select percentile_disc(0.8) within group (order by coalesce(pos_score_total,0) - abs(coalesce(neg_score_total,0)) + coalesce(bounty_amount_total,0))
  from final
)
order by perf_rank, userid, month_bucket nulls last
limit 500;