-- {"query": "3581.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 1696} 
WITH
-- 1. Recent activity (last 90 days) on posts and votes
recent_activity AS (
    SELECT
        p.Id                     AS PostId,
        p.PostTypeId,
        p.OwnerUserId            AS OwnerUserId,
        p.CreationDate           AS PostCreated,
        COALESCE(v.VoteTypeId, 0) AS VoteTypeId,
        COALESCE(v.CreationDate, p.CreationDate) AS EventDate,
        CASE
            WHEN v.VoteTypeId = 2 THEN 1      -- UpMod
            WHEN v.VoteTypeId = 3 THEN -1     -- DownMod
            ELSE 0
        END                            AS VoteScoreDelta
    FROM Posts p
    LEFT JOIN Votes v
        ON v.PostId = p.Id
       AND v.CreationDate >= cast('2024-10-01' as date) - INTERVAL '90 days'
    WHERE p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '90 days'
),

-- 2. Aggregate per post the net vote delta and activity count
post_agg AS (
    SELECT
        ra.PostId,
        ra.PostTypeId,
        ra.OwnerUserId,
        MIN(ra.PostCreated)                AS FirstSeen,
        MAX(ra.EventDate)                  AS LastActivity,
        SUM(ra.VoteScoreDelta)             AS NetVoteScore,
        COUNT(*)                           AS ActivityEvents,
        ROW_NUMBER() OVER (PARTITION BY ra.PostId
                           ORDER BY ra.EventDate DESC) AS RecencyRank
    FROM recent_activity ra
    GROUP BY ra.PostId, ra.PostTypeId, ra.OwnerUserId
),

-- 3. Users enriched with badge counts and reputation tier
user_enriched AS (
    SELECT
        u.Id                                    AS UserId,
        u.DisplayName,
        u.Reputation,
        CASE
            WHEN u.Reputation >= 20000 THEN 'Legendary'
            WHEN u.Reputation >= 10000 THEN 'Epic'
            WHEN u.Reputation >= 5000  THEN 'Advanced'
            WHEN u.Reputation >= 1000  THEN 'Intermediate'
            ELSE 'Novice'
        END                                      AS ReputationTier,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),

-- 4. Tag usage stats derived from Posts.Tags (question posts only)
tag_stats AS (
    SELECT
        trim(t)                             AS TagName,
        COUNT(*)                            AS QuestionCount,
        SUM(p.Score)                        AS TotalScore,
        AVG(p.ViewCount)                    AS AvgViews,
        MAX(p.CreationDate)                 AS LatestQuestion
    FROM Posts p,
         LATERAL regexp_split_to_table(
             COALESCE(p.Tags, ''),
             '[><]' -- split on angle brackets used in stored tag format
         ) AS t
    WHERE p.PostTypeId = 1                     -- questions only
      AND p.Tags IS NOT NULL
    GROUP BY trim(t)
),

-- 5. Correlated subquery to fetch the most recent close reason (if any) per post
post_close_reason AS (
    SELECT
        ph.PostId,
        ph.Comment::int AS CloseReasonId,
        (SELECT Name FROM CloseReasonTypes crt WHERE crt.Id = ph.Comment::int) AS CloseReasonName,
        ph.CreationDate AS ClosedOn
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10            -- Post Closed
      AND ph.Comment IS NOT NULL
      AND ph.Comment ~ '^\d+$'                 -- ensure numeric close reason
      AND ph.CreationDate = (
            SELECT MAX(ph2.CreationDate)
            FROM PostHistory ph2
            WHERE ph2.PostId = ph.PostId
              AND ph2.PostHistoryTypeId = 10
          )
),

-- 6. Union of duplicate and linked post relationships
post_relations AS (
    SELECT
        pl.PostId,
        pl.RelatedPostId,
        lt.Name AS LinkType,
        pl.CreationDate
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    WHERE lt.Name IN ('Linked', 'Duplicate')
),

-- 7. Combine everything for a final benchmark view
benchmark_view AS (
    SELECT
        pa.PostId,
        pa.PostTypeId,
        pt.Title,
        pa.OwnerUserId,
        ue.DisplayName,
        ue.ReputationTier,
        pa.FirstSeen,
        pa.LastActivity,
        pa.NetVoteScore,
        pa.ActivityEvents,
        COALESCE(pcr.CloseReasonName, 'Open')              AS CurrentStatus,
        COALESCE(pcr.ClosedOn, NULL)                       AS ClosedOn,
        STRING_AGG(DISTINCT pr.LinkType, ', ') WITHIN GROUP (ORDER BY pr.CreationDate DESC) AS LinkTypes,
        -- Extract top 3 tags and compute a tag‑popularity score
        (
            SELECT STRING_AGG(t.TagName, '; ') FROM (
                SELECT ts.TagName,
                       (ts.QuestionCount * 0.6 + ts.TotalScore * 0.4) AS TagScore
                FROM tag_stats ts
                WHERE pt.Tags LIKE '%' || ts.TagName || '%'
                ORDER BY TagScore DESC
                LIMIT 3
            ) t
        ) AS TopTags
    FROM post_agg pa
    LEFT JOIN Posts pt ON pt.Id = pa.PostId
    LEFT JOIN user_enriched ue ON ue.UserId = pa.OwnerUserId
    LEFT JOIN post_close_reason pcr ON pcr.PostId = pa.PostId
    LEFT JOIN post_relations pr ON pr.PostId = pa.PostId OR pr.RelatedPostId = pa.PostId
    GROUP BY
        pa.PostId, pa.PostTypeId, pt.Title, pa.OwnerUserId,
        ue.DisplayName, ue.ReputationTier,
        pa.FirstSeen, pa.LastActivity, pa.NetVoteScore,
        pa.ActivityEvents, pcr.CloseReasonName, pcr.ClosedOn
)

SELECT
    bv.PostId,
    bv.Title,
    bv.CurrentStatus,
    bv.ClosedOn,
    bv.DisplayName,
    bv.ReputationTier,
    bv.FirstSeen,
    bv.LastActivity,
    bv.NetVoteScore,
    bv.ActivityEvents,
    bv.LinkTypes,
    bv.TopTags,
    RANK() OVER (ORDER BY bv.NetVoteScore DESC, bv.ActivityEvents DESC) AS ScoreRank,
    NTILE(10) OVER (ORDER BY bv.NetVoteScore DESC) AS Decile
FROM benchmark_view bv
WHERE bv.PostTypeId = 1               -- only questions
ORDER BY bv.ScoreRank
LIMIT 200;