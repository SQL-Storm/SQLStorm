-- {"query": "6933.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 695} 
SELECT 
    u.DisplayName,
    u.Reputation,
    u.Location,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) AS TotalQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id ELSE NULL END) AS TotalAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 3 THEN p.Id ELSE NULL END) AS TotalWikis,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.PostId ELSE NULL END) AS TotalUpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.PostId ELSE NULL END) AS TotalDownVotes,
    MAX(p.Score) AS HighestScoredPost,
    CASE 
        WHEN p.ViewCount IS NULL THEN 0
        ELSE p.ViewCount
    END AS ViewCount,
    MAX(ph.CreationDate) AS LastEdited,
    MIN(p.CreationDate) AS FirstPost,
    MAX(p.LastActivityDate) AS LastActivity,
    b.Name AS LatestBadge,
    b.Date AS BadgeDate,
    t.TagName AS MostFrequentTag,
    t.Count AS TagCount
FROM 
    Users u
LEFT JOIN 
    (SELECT 
         ph.PostId,
         ph.CreationDate,
         ph.UserId,
         ph.Comment
     FROM 
         PostHistory ph
     WHERE 
         ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 13, 14, 15, 19, 20, 35)
     ) ph ON u.Id = ph.UserId
LEFT JOIN 
    Posts p ON ph.PostId = p.Id
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    (SELECT 
         Id, 
         Name, 
         Date,
         Class
     FROM 
         Badges
     WHERE 
         Class = 1
     ORDER BY 
         Date DESC
     LIMIT 1
    ) b ON u.Id = b.UserId
LEFT JOIN 
    (SELECT 
         t.Id,
         t.TagName,
         t.Count,
         p.Id
     FROM 
         Tags t
     JOIN 
         PostTagMapping ptm ON t.Id = ptm.TagId
     JOIN 
         Posts p ON ptm.PostId = p.Id
     GROUP BY 
         t.Id, t.TagName, t.Count, p.Id
     ORDER BY 
         COUNT(p.Id) DESC
     LIMIT 1
    ) t ON u.Id = t.Id
LEFT JOIN 
    Votes v ON p.Id = v.PostId
GROUP BY 
    u.Id
HAVING 
    u.Reputation > 1000
ORDER BY 
    TotalPosts DESC, 
    HighestScoredPost DESC;