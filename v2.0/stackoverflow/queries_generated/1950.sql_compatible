WITH HighValueEntities AS (
    SELECT
        P.Id AS EntityId,
        'Post' AS EntityType,
        P.OwnerUserId AS EntityOwnerId,
        P.CreationDate AS EntityCreationDate,
        P.Score AS EntityScore,
        P.Body AS EntityContent,
        CAST(NULL AS integer) AS ParentEntityId,
        P.ContentLicense
    FROM Posts P
    WHERE P.Score >= 50 AND P.PostTypeId IN (1, 2)
    UNION ALL
    SELECT
        C.Id AS EntityId,
        'Comment' AS EntityType,
        C.UserId AS EntityOwnerId,
        C.CreationDate AS EntityCreationDate,
        C.Score AS EntityScore,
        C.Text AS EntityContent,
        C.PostId AS ParentEntityId,
        C.ContentLicense
    FROM Comments C
    WHERE C.Score >= 20
),
UserActivityMetrics AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.UpVotes AS TotalGivenUpVotes,
        U.DownVotes AS TotalGivenDownVotes,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestions,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswers,
        SUM(COALESCE(P.Score, 0)) AS TotalPostScoreReceived,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        SUM(COALESCE(C.Score, 0)) AS TotalCommentScoreReceived,
        MAX(P.LastActivityDate) AS LastPostActivity,
        MAX(C.CreationDate) AS LastCommentActivity
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate,
        U.UpVotes, U.DownVotes
),
PostTaggingAnalysis AS (
    SELECT
        P.Id AS PostId,
        P.OwnerUserId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.AnswerCount,
        P.FavoriteCount,
        P.ClosedDate,
        STRING_TO_ARRAY(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><') AS TagArray,
        (SELECT COUNT(DISTINCT V.UserId) FROM Votes V WHERE V.PostId = P.Id AND V.VoteTypeId = 5) AS BookmarkCount,
        (SELECT MAX(CH.CreationDate) FROM Comments CH WHERE CH.PostId = P.Id) AS LatestCommentDate,
        (SELECT COALESCE(MAX(CASE WHEN PH.PostHistoryTypeId = 10 THEN CRT.Name END), 'N/A')
         FROM PostHistory PH
         LEFT JOIN CloseReasonTypes CRT ON PH.Comment = CAST(CRT.Id AS varchar)
         WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId = 10
        ) AS CloseReasonName,
        P.ContentLicense,
        P.PostTypeId
    FROM Posts P
    WHERE P.PostTypeId = 1
      AND P.Tags IS NOT NULL
      AND P.Tags != ''
),
PostEditHistory AS (
    SELECT
        PH.PostId,
        PH.UserId AS EditorUserId,
        PH.CreationDate AS EditDate,
        LAG(PH.CreationDate, 1, PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PreviousEditDate,
        CASE
            WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN 'Edit'
            WHEN PH.PostHistoryTypeId IN (1, 2, 3) THEN 'Initial'
            ELSE 'Other'
        END AS HistoryType,
        RANK() OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate DESC) AS LatestEditRank
    FROM PostHistory PH
    WHERE PH.PostHistoryTypeId IN (1,2,3,4,5,6)
),
AggregatedPostEdits AS (
    SELECT
        PostId,
        COUNT(DISTINCT EditorUserId) AS UniqueEditors,
        COUNT(*) FILTER (WHERE HistoryType = 'Edit') AS TotalEditEvents,
        SUM(EXTRACT(EPOCH FROM (EditDate - PreviousEditDate))) AS TotalEditTimeSpanSeconds
    FROM PostEditHistory
    GROUP BY PostId
),
UserBadgeAwards AS (
    SELECT
        B.UserId,
        COUNT(B.Id) AS TotalBadges,
        COUNT(CASE WHEN B.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN B.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN B.Class = 3 THEN 1 END) AS BronzeBadges,
        MAX(B.Date) AS LatestBadgeAwardDate
    FROM Badges B
    GROUP BY B.UserId
)
SELECT
    UAM.UserId,
    UAM.DisplayName,
    UAM.Reputation,
    UAM.TotalPosts,
    UAM.TotalQuestions,
    UAM.TotalAnswers,
    UAM.TotalPostScoreReceived,
    UAM.TotalCommentsMade,
    UAM.TotalGivenUpVotes,
    UAM.TotalGivenDownVotes,
    UBA.TotalBadges,
    UBA.GoldBadges,
    UBA.SilverBadges,
    UBA.BronzeBadges,
    (SELECT COUNT(DISTINCT P.Id) FROM Posts P WHERE P.OwnerUserId = UAM.UserId AND P.AcceptedAnswerId IS NOT NULL) AS QuestionsWithAcceptedAnswers,
    CAST(UAM.TotalAnswers AS DECIMAL) / COALESCE(NULLIF(UAM.TotalQuestions, 0), 1) AS AnswerToQuestionRatio,
    CAST(UAM.TotalPostScoreReceived AS DECIMAL) / (COALESCE(NULLIF(UAM.TotalPosts, 0), 1)) AS AvgScorePerPost,
    CASE
        WHEN UAM.Reputation >= 10000 AND UBA.GoldBadges >= 1 THEN 'Veteran_Elite'
        WHEN UAM.Reputation >= 5000 AND UAM.TotalAnswers >= 100 AND UAM.TotalCommentsMade < 50 THEN 'Pro_Answerer_Focused'
        WHEN UAM.TotalCommentsMade > UAM.TotalPosts * 2 THEN 'Chatty_User_Verbose'
        WHEN EXISTS (
            SELECT 1
            FROM PostTaggingAnalysis PTA_sub
            WHERE PTA_sub.OwnerUserId = UAM.UserId AND LOWER(COALESCE(PTA_sub.ContentLicense, 'N/A')) LIKE '%cc by-sa 4.0%'
        ) THEN 'CC_BY_SA_4_User'
        ELSE 'Active_Participant_General'
    END AS UserCategory,
    MIN(PATA.PostCreationDate) OVER (PARTITION BY UAM.UserId) AS FirstQuestionDate,
    MAX(PATA.PostCreationDate) OVER (PARTITION BY UAM.UserId) AS LastQuestionDate,
    AVG(PATA.PostScore) OVER (PARTITION BY UAM.UserId) AS AvgQuestionScore,
    SUM(PATA.BookmarkCount) OVER (PARTITION BY UAM.UserId) AS TotalBookmarkedQuestions,
    MAX(CASE WHEN PATA.CloseReasonName != 'N/A' THEN PATA.CloseReasonName ELSE NULL END) OVER (PARTITION BY UAM.UserId) AS LatestCloseReasonForUserQuestion,
    COUNT(DISTINCT CASE WHEN PATA.ViewCount > 1000 AND PATA.AnswerCount > 5 AND PATA.ClosedDate IS NULL THEN PATA.PostId END) OVER (PARTITION BY UAM.UserId) AS HighTrafficOpenQuestions,
    ROW_NUMBER() OVER (ORDER BY UAM.Reputation DESC, UAM.TotalPosts DESC, UAM.TotalPostScoreReceived DESC) AS GlobalReputationRank,
    DENSE_RANK() OVER (ORDER BY UBA.GoldBadges DESC, UBA.SilverBadges DESC) AS BadgeEliteRank,
    SUM(COALESCE(APE.TotalEditEvents, 0)) AS TotalUserEditEvents,
    AVG(COALESCE(APE.TotalEditTimeSpanSeconds, 0)) AS AvgPostEditTimeSpan,
    (
        SELECT AVG(link_counts.NumLinks)
        FROM (
            SELECT COUNT(PL.Id) AS NumLinks
            FROM Posts P_sub
            LEFT JOIN PostLinks PL ON P_sub.Id = PL.PostId OR P_sub.Id = PL.RelatedPostId
            WHERE P_sub.OwnerUserId = UAM.UserId
            GROUP BY P_sub.Id
        ) AS link_counts
    ) AS AvgPostLinkCount,
    COUNT(DISTINCT HVE.EntityId) FILTER (WHERE HVE.EntityOwnerId = UAM.UserId) AS TotalHighValueEntitiesContributed,
    COUNT(DISTINCT PATA.PostId) FILTER (
        WHERE PATA.PostScore > (UAM.TotalPostScoreReceived / COALESCE(NULLIF(UAM.TotalPosts, 0), 1)) * 1.5
          AND PATA.FavoriteCount > 0
          AND PATA.ViewCount > 5000
          AND (PATA.ClosedDate IS NOT NULL OR PATA.LatestCommentDate > UAM.LastAccessDate)
          AND EXISTS (
              SELECT 1 FROM UNNEST(PATA.TagArray) AS tag WHERE LOWER(tag) LIKE '%javascript%' OR LOWER(tag) LIKE '%python%'
          )
          AND PATA.ContentLicense IS NOT NULL AND PATA.ContentLicense != 'CC BY-SA 2.5'
    ) AS HighValueTargetedQuestions,
    (
        SELECT ARRAY_AGG(tn.TagName ORDER BY tn.TagName) FROM (
            SELECT DISTINCT T.TagName
            FROM UNNEST(P_TAG.TagArray) AS tag_name
            JOIN Tags T ON LOWER(T.TagName) = LOWER(tag_name)
            WHERE P_TAG.OwnerUserId = UAM.UserId
        ) tn LIMIT 5
    ) AS Top5FrequentTagsByUser
FROM UserActivityMetrics UAM
LEFT JOIN UserBadgeAwards UBA ON UAM.UserId = UBA.UserId
LEFT JOIN PostTaggingAnalysis PATA ON UAM.UserId = PATA.OwnerUserId
LEFT JOIN AggregatedPostEdits APE ON PATA.PostId = APE.PostId
LEFT JOIN HighValueEntities HVE ON UAM.UserId = HVE.EntityOwnerId
WHERE UAM.Reputation >= 1000
  AND UAM.LastAccessDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year')
  AND (UAM.TotalPosts > 10 OR UAM.TotalCommentsMade > 20)
  AND (UAM.TotalGivenUpVotes > UAM.TotalGivenDownVotes * 1.5 OR UBA.GoldBadges > 0)
  AND UAM.DisplayName IS NOT NULL
GROUP BY
    UAM.UserId, UAM.DisplayName, UAM.Reputation, UAM.TotalPosts, UAM.TotalQuestions,
    UAM.TotalAnswers, UAM.TotalPostScoreReceived, UAM.TotalCommentsMade,
    UAM.TotalGivenUpVotes, UAM.TotalGivenDownVotes,
    UBA.TotalBadges, UBA.GoldBadges, UBA.SilverBadges, UBA.BronzeBadges,
    UAM.LastAccessDate
ORDER BY
    GlobalReputationRank ASC, HighValueTargetedQuestions DESC
LIMIT 100;