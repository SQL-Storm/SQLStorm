with RecursiveUserBadgeCounts as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(b.Id) filter (where b.Class = 1) as GoldBadges,
        count(b.Id) filter (where b.Class = 2) as SilverBadges,
        count(b.Id) filter (where b.Class = 3) as BronzeBadges,
        row_number() over (partition by u.Id order by b.Date desc NULLS LAST) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    group by u.Id, u.DisplayName
),
TopActiveUsers as (
    select
        u.Id as UserId,
        u.DisplayName,
        coalesce(pq.PostCount,0) as QuestionCount,
        coalesce(pa.PostCount,0) as AnswerCount,
        coalesce(vu.UpVotes,0) as UpVotes,
        coalesce(vd.DownVotes,0) as DownVotes,
        u.Reputation,
        u.CreationDate,
        u.Location
    from Users u
    left join (
        select OwnerUserId, count(*) as PostCount
        from Posts
        where PostTypeId = 1
        group by OwnerUserId
    ) pq on pq.OwnerUserId = u.Id
    left join (
        select OwnerUserId, count(*) as PostCount
        from Posts
        where PostTypeId = 2
        group by OwnerUserId
    ) pa on pa.OwnerUserId = u.Id
    left join (
        select UserId, sum(case when VoteTypeId = 2 then 1 else 0 end) as UpVotes
        from Votes
        where UserId is not null
        group by UserId
    ) vu on vu.UserId = u.Id
    left join (
        select UserId, sum(case when VoteTypeId = 3 then 1 else 0 end) as DownVotes
        from Votes
        where UserId is not null
        group by UserId
    ) vd on vd.UserId = u.Id
    where (coalesce(pq.PostCount,0) + coalesce(pa.PostCount,0)) > 10
),
PostScoreStats as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.Tags,
        rank() over (partition by p.PostTypeId order by p.Score desc) as ScoreRank,
        first_value(p.CreationDate) over (partition by p.OwnerUserId order by p.CreationDate) as FirstPostDate,
        lag(p.Score) over (partition by p.OwnerUserId order by p.CreationDate) as PrevScore,
        lead(p.Score) over (partition by p.OwnerUserId order by p.CreationDate) as NextScore
    from Posts p
    where p.PostTypeId in (1, 2)
),
TopTags as (
    select 
        unnest(string_to_array(substring(p.Tags from 2 for char_length(p.Tags)-2), '><')) as TagName, 
        count(*) as TagUsage,
        avg(p.Score) as AvgScore
    from Posts p 
    where p.PostTypeId = 1 and p.Tags is not null
    group by TagName
    having count(*) > 50
),
DuplicatePosts as (
    select pl.PostId, pl.RelatedPostId, pl.CreationDate, lt.Name as LinkTypeName
    from PostLinks pl
    inner join LinkTypes lt on lt.Id = pl.LinkTypeId
    where lt.Name = 'Duplicate'
),
CloseReasonsCount as (
    select cht.Name as CloseReason, count(ph.Id) as CloseCount
    from PostHistory ph
    inner join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId
    inner join CloseReasonTypes cht on cast(cht.Id as text) = ph.Comment
    where ph.PostHistoryTypeId = 10 and ph.Comment ~ '^\d+$'
    group by cht.Name
),
ComplexUserActivity as (
    select 
        t.UserId,
        u.DisplayName,
        count(distinct p.Id) as ActivePosts,
        count(distinct c.Id) as CommentCount,
        count(distinct ph.Id) filter (where ph.PostHistoryTypeId in (4,5)) as Edits,
        sum(v.BountyAmount) filter (where v.BountyAmount is not null) as TotalBountyGiven,
        max(p.Score) filter (where p.PostTypeId = 1) as MaxQuestionScore,
        max(p.Score) filter (where p.PostTypeId = 2) as MaxAnswerScore,
        count(distinct case when v.VoteTypeId = 2 then v.Id end) as UpVotesReceived,
        count(distinct case when v.VoteTypeId = 3 then v.Id end) as DownVotesReceived
    from Votes v
    left join Posts p on p.Id = v.PostId
    left join Comments c on c.UserId = v.UserId
    left join PostHistory ph on ph.UserId = v.UserId
    inner join Users u on u.Id = v.UserId
    cross join lateral (select v.UserId) as t(UserId)
    where v.UserId is not null
    group by t.UserId, u.DisplayName
),
FinalSummary as (
    select 
        ta.UserId,
        ta.DisplayName,
        ta.QuestionCount,
        ta.AnswerCount,
        ta.UpVotes,
        ta.DownVotes,
        coalesce(cua.ActivePosts,0) as ActivePosts,
        coalesce(cua.CommentCount,0) as CommentsMade,
        coalesce(cua.Edits,0) as EditsMade,
        coalesce(cua.TotalBountyGiven,0) as BountyGiven,
        coalesce(cua.MaxQuestionScore,0) as HighestQuestionScore,
        coalesce(cua.MaxAnswerScore,0) as HighestAnswerScore,
        (ta.Reputation + coalesce(cua.UpVotesReceived,0) - coalesce(cua.DownVotesReceived,0)) as AdjustedReputation,
        concat_ws(' | ',
            coalesce(ta.Location,''), 
            to_char(ta.CreationDate,'YYYY-MM-DD')) as LocationAndCreated,
        row_number() over (order by (ta.Reputation + coalesce(cua.UpVotesReceived,0) - coalesce(cua.DownVotesReceived,0)) desc) as ReputationRank,
        case 
            when ta.AnswerCount > ta.QuestionCount then 'Answerer'
            when ta.QuestionCount > ta.AnswerCount then 'Asker'
            else 'Balanced'
        end as UserType
    from TopActiveUsers ta
    left join ComplexUserActivity cua on cua.UserId = ta.UserId
)
select 
    f.ReputationRank,
    f.DisplayName,
    f.UserType,
    f.QuestionCount,
    f.AnswerCount,
    f.UpVotes,
    f.DownVotes,
    f.ActivePosts,
    f.CommentsMade,
    f.EditsMade,
    f.BountyGiven,
    f.HighestQuestionScore,
    f.HighestAnswerScore,
    f.AdjustedReputation,
    f.LocationAndCreated,
    coalesce(tc.CloseCount,0) as TotalCloseVotes,
    ts.ScoreRank as TopPostRank,
    concat('#', tt.TagName, ':', cast(tt.TagUsage as varchar)) as PopularTagUsage,
    dup.PostId as DuplicateOfPost,
    dup.CreationDate as DuplicationDate
from FinalSummary f
left join PostScoreStats ts on ts.OwnerUserId = f.UserId and ts.ScoreRank = 1 and ts.PostTypeId = 1
left join TopTags tt on tt.TagName = (
    select TagName
    from TopTags
    order by AvgScore desc NULLS LAST
    limit 1
)
left join DuplicatePosts dup on dup.PostId = ts.Id
left join CloseReasonsCount tc on true
order by f.ReputationRank
limit 100;