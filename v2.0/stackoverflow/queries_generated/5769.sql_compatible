SELECT
  u.Id AS UserId,
  u.DisplayName AS UserName,
  u.Reputation,
  COUNT(DISTINCT p_main.Id) AS TotalPosts,
  SUM(CASE WHEN p_main.PostTypeId = 1 THEN 1 ELSE 0 END) AS Questions,
  SUM(CASE WHEN p_main.PostTypeId = 2 THEN 1 ELSE 0 END) AS Answers,
  MAX(p_main.CreationDate) AS LastPostDate,
  STRING_AGG(DISTINCT tt.Name, ',') AS PostTypesMentioned,
  AVG(p_main.Score) AS AvgPostScore,
  SUM(CASE WHEN v.VoteTypeId IN (2, 14, 16) THEN 1 ELSE 0 END) AS UpvoteEvents,
  SUM(CASE WHEN v.VoteTypeId = 10 THEN 1 ELSE 0 END) AS DeletionEvents,
  COUNT(DISTINCT b.Id) AS BadgesEarned,
  MAX(b.Date) AS LastBadgeDate
FROM
  Users u
LEFT JOIN Posts p ON p.OwnerUserId = u.Id
LEFT JOIN Votes v ON v.UserId = u.Id
  AND v.CreationDate = (
    SELECT MAX(CreationDate)
    FROM Votes v2
    WHERE v2.UserId = u.Id
  )
LEFT JOIN Badges b ON b.UserId = u.Id
LEFT JOIN PostTypes pt ON pt.Id = p.PostTypeId
LEFT JOIN PostHistoryTypes h ON 1=1
LEFT JOIN (
  SELECT
    p1.OwnerUserId,
    p1.Id,
    p1.Title,
    p1.PostTypeId,
    p1.CreationDate,
    p1.Score
  FROM Posts p1
) AS p_main ON p_main.OwnerUserId = u.Id
LEFT JOIN (
  SELECT
    p2.Id AS PostId,
    COUNT(*) AS TagCount
  FROM Posts p2
  WHERE p2.PostTypeId = 1
  GROUP BY p2.Id
) AS t ON t.PostId = p_main.Id
LEFT JOIN (
  -- Post types mentioned per user via the user's posts (if intended)
  SELECT DISTINCT p3.OwnerUserId, pt2.Name
  FROM Posts p3
  LEFT JOIN PostTypes pt2 ON pt2.Id = p3.PostTypeId
) AS tt ON tt.OwnerUserId = u.Id
WHERE
  u.AccountId IS NOT NULL
  OR u.Id IS NOT NULL
GROUP BY
  u.Id, u.DisplayName, u.Reputation, tt.Name
HAVING
  COUNT(DISTINCT p_main.Id) > 0
ORDER BY
  LastPostDate DESC
LIMIT 100;