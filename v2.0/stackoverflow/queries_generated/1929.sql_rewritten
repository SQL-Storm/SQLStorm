WITH UserContributionSummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestions,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswers,
        SUM(COALESCE(P.Score, 0)) AS TotalPostScore,
        AVG(COALESCE(P.Score, 0)) FILTER (WHERE P.PostTypeId IN (1, 2)) AS AvgPostScore,
        MAX(P.LastActivityDate) AS LastPostActivityDate,
        DENSE_RANK() OVER (ORDER BY U.Reputation DESC, U.CreationDate ASC) AS ReputationRank
    FROM Users AS U
    LEFT JOIN Posts AS P ON U.Id = P.OwnerUserId
    WHERE U.Reputation > 1000 -- Filter out very low rep users
      AND U.CreationDate >= '2010-01-01' -- Focus on users created after a certain date
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate
),
PostDetailsAndActivity AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.ParentId, -- Include ParentId for answers
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.Title,
        P.Tags,
        P.AnswerCount,
        P.CommentCount AS InitialCommentCount,
        P.LastEditDate,
        P.LastActivityDate,
        P.ClosedDate,
        COALESCE(P.AcceptedAnswerId, -1) AS AcceptedAnswerId, -- Use -1 as a placeholder for NULL
        (SELECT COUNT(PH.Id) FROM PostHistory AS PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId IN (4, 5, 6)) AS EditCount, -- Correlated subquery for edit count
        (SELECT MAX(PH.CreationDate) FROM PostHistory AS PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId IN (4, 5, 6)) AS LastSignificantEditDate, -- Correlated subquery for last edit
        ROW_NUMBER() OVER (PARTITION BY P.OwnerUserId, P.PostTypeId ORDER BY P.Score DESC, P.CreationDate DESC) AS PostRankByUserType
    FROM Posts AS P
    WHERE P.PostTypeId IN (1, 2) -- Focus on Questions and Answers
      AND P.CreationDate >= '2015-01-01' -- Recent posts
),
CommentEngagement AS (
    SELECT
        C.PostId,
        COUNT(C.Id) AS TotalComments,
        SUM(COALESCE(C.Score, 0)) AS TotalCommentScore,
        MAX(C.CreationDate) AS LastCommentDate,
        MAX(CASE WHEN C.UserId IS NULL THEN 1 ELSE 0 END) AS HasAnonymousComments,
        STRING_AGG(SUBSTRING(REPLACE(C.Text, '''', ''), 1, 50), ' | ' ORDER BY C.CreationDate DESC) AS RecentCommentSnippets -- Max 50 chars per snippet
    FROM Comments AS C
    GROUP BY C.PostId
),
BadgeAchievement AS (
    SELECT
        B.UserId,
        COUNT(B.Id) AS TotalBadges,
        COUNT(CASE WHEN B.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN B.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN B.Class = 3 THEN 1 END) AS BronzeBadges,
        MAX(CASE WHEN B.Class = 1 AND B.Date >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year' THEN 1 ELSE 0 END) AS HasRecentGoldBadge
    FROM Badges AS B
    GROUP BY B.UserId
),
InterestingPosts AS (
    -- High Scoring Questions
    SELECT
        PD.PostId,
        PD.OwnerUserId,
        PD.PostTypeId,
        PD.PostCreationDate AS CreationDate,
        PD.Title AS MainTitle,
        PD.PostScore,
        PD.ViewCount,
        PD.Tags,
        PD.AnswerCount,
        CE.TotalComments,
        PD.LastActivityDate,
        PD.ClosedDate,
        PD.AcceptedAnswerId,
        NULL AS ParentPostId, -- Questions don't have a parent in this context
        NULL AS ParentPostTitle,
        PD.EditCount,
        PD.LastEditDate,
        CASE
            WHEN PD.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN PD.AnswerCount > 0 AND PD.AcceptedAnswerId != -1 THEN 'Accepted'
            WHEN PD.AnswerCount = 0 THEN 'NoAnswer'
            ELSE 'Open'
        END AS PostStatus,
        LAG(PD.PostCreationDate, 1, PD.PostCreationDate) OVER (PARTITION BY PD.OwnerUserId ORDER BY PD.PostCreationDate) AS PreviousPostCreationDate, -- Window function
        'HighScoringQuestion' AS PostCategory
    FROM PostDetailsAndActivity AS PD
    LEFT JOIN CommentEngagement AS CE ON PD.PostId = CE.PostId
    WHERE PD.PostTypeId = 1
      AND PD.PostScore >= 50 -- Only high-score questions
      AND PD.PostRankByUserType <= 5 -- Top 5 questions by score for a user
    UNION ALL -- Set operator
    -- Highly Edited Answers
    SELECT
        PD.PostId,
        PD.OwnerUserId,
        PD.PostTypeId,
        PD.PostCreationDate AS CreationDate,
        PD.Title AS MainTitle, -- Title of the answer itself
        PD.PostScore,
        NULL AS ViewCount, -- Answers don't have view counts directly
        NULL AS Tags, -- Answers don't have tags directly
        NULL AS AnswerCount, -- Not applicable for answers
        CE.TotalComments,
        PD.LastActivityDate,
        NULL AS ClosedDate, -- Not applicable for answers
        NULL AS AcceptedAnswerId, -- Not applicable for answers
        PD.ParentId AS ParentPostId,
        P_Parent.Title AS ParentPostTitle,
        PD.EditCount,
        PD.LastEditDate,
        'Answer' AS PostStatus,
        LAG(PD.PostCreationDate, 1, PD.PostCreationDate) OVER (PARTITION BY PD.OwnerUserId ORDER BY PD.PostCreationDate) AS PreviousPostCreationDate, -- Window function
        'HighlyEditedAnswer' AS PostCategory
    FROM PostDetailsAndActivity AS PD
    LEFT JOIN CommentEngagement AS CE ON PD.PostId = CE.PostId
    INNER JOIN Posts AS P_Parent ON PD.ParentId = P_Parent.Id -- Join to get parent question title
    WHERE PD.PostTypeId = 2
      AND PD.EditCount >= 3 -- At least 3 significant edits
      AND PD.PostScore >= 20 -- Decent score for an answer
)
SELECT
    UCS.UserId,
    UCS.DisplayName,
    UCS.Reputation,
    UCS.TotalPosts,
    UCS.TotalQuestions,
    UCS.TotalAnswers,
    UCS.AvgPostScore,
    UCS.ReputationRank,
    BA.TotalBadges,
    BA.GoldBadges,
    BA.SilverBadges,
    BA.BronzeBadges,
    COALESCE(BA.HasRecentGoldBadge, 0) AS HasRecentGoldBadge, -- Ensure non-null for boolean logic
    IP.PostId,
    IP.PostCategory,
    IP.PostTypeId,
    IP.MainTitle,
    IP.PostScore,
    IP.ViewCount,
    IP.Tags,
    IP.AnswerCount,
    IP.TotalComments AS PostCommentCount,
    IP.LastActivityDate AS PostLastActivity,
    IP.PostStatus,
    IP.ParentPostId,
    IP.ParentPostTitle,
    IP.EditCount AS PostEditCount,
    IP.LastEditDate AS PostLastEditDate,
    EXTRACT(EPOCH FROM (IP.CreationDate - IP.PreviousPostCreationDate)) / 3600 AS TimeSincePreviousPostHours, -- Complicated calculation
    (
        SELECT SUBSTRING(C.Text, 1, 100)
        FROM Comments AS C
        WHERE C.PostId = IP.PostId
          AND C.UserId = UCS.UserId -- Correlated subquery: owner's comment on their own post
        ORDER BY C.CreationDate DESC
        LIMIT 1
    ) AS OwnersMostRecentCommentSnippet,
    (
        SELECT EXISTS (SELECT 1 FROM PostLinks AS PL JOIN LinkTypes AS LT ON PL.LinkTypeId = LT.Id WHERE PL.PostId = IP.PostId AND LT.Name IN ('Linked', 'Duplicate'))
    ) AS IsLinkedOrDuplicate, -- Correlated subquery for existence check
    COALESCE( -- Nested NULL logic and CASE for categorization
        (SELECT 'Has Recent Gold Badge' WHERE COALESCE(BA.HasRecentGoldBadge, 0) = 1),
        (SELECT 'Has Silver or Bronze Badge' WHERE COALESCE(BA.SilverBadges, 0) > 0 OR COALESCE(BA.BronzeBadges, 0) > 0),
        'No Significant Badges'
    ) AS BadgeCategorization,
    CASE -- Complex conditional logic
        WHEN UCS.TotalQuestions > 0 AND UCS.TotalAnswers = 0 THEN 'Questioner Only'
        WHEN UCS.TotalAnswers > 0 AND UCS.TotalQuestions = 0 THEN 'Answerer Only'
        WHEN UCS.TotalQuestions > 0 AND UCS.TotalAnswers > 0 THEN 'Contributor'
        ELSE 'Passive'
    END AS UserRoleType,
    CASE -- String expressions and NULL logic
        WHEN IP.PostTypeId = 1 AND IP.Tags IS NOT NULL THEN
            UPPER(LEFT(IP.MainTitle, 1)) || LPAD(REPLACE(SUBSTRING(IP.Tags FROM 2 FOR LENGTH(IP.Tags) - 2), '><', ','), 50, '_')
        ELSE
            UPPER(LEFT(IP.MainTitle, 1)) || LPAD('N_A', 50, '_') -- Handle answers or null tags
    END AS ProcessedTagsAndTitleInitial,
    CASE -- Detailed post classification
        WHEN IP.PostTypeId = 1 AND IP.ClosedDate IS NOT NULL AND IP.AcceptedAnswerId != -1 THEN 'Closed with Accepted'
        WHEN IP.PostTypeId = 1 AND IP.ClosedDate IS NOT NULL AND IP.AcceptedAnswerId = -1 THEN 'Closed No Accepted'
        WHEN IP.PostTypeId = 1 AND IP.ClosedDate IS NULL AND IP.AcceptedAnswerId != -1 THEN 'Open with Accepted'
        WHEN IP.PostTypeId = 1 AND IP.ClosedDate IS NULL AND IP.AcceptedAnswerId = -1 AND IP.AnswerCount > 0 THEN 'Open No Accepted but Answered'
        WHEN IP.PostTypeId = 1 AND IP.ClosedDate IS NULL AND IP.AcceptedAnswerId = -1 AND IP.AnswerCount = 0 THEN 'Open Unanswered'
        WHEN IP.PostTypeId = 2 AND IP.PostScore >= 100 THEN 'Highly Voted Answer'
        WHEN IP.PostTypeId = 2 AND IP.EditCount >= 5 THEN 'Heavily Edited Answer'
        ELSE 'Other'
    END AS DetailedPostCategory
FROM UserContributionSummary AS UCS
LEFT JOIN BadgeAchievement AS BA ON UCS.UserId = BA.UserId -- Outer join
INNER JOIN InterestingPosts AS IP ON UCS.UserId = IP.OwnerUserId -- Only consider users with "interesting" posts
WHERE UCS.ReputationRank <= 5000 -- Top N reputation users
ORDER BY UCS.Reputation DESC, IP.PostScore DESC NULLS LAST, IP.PostLastActivity DESC
LIMIT 10000;