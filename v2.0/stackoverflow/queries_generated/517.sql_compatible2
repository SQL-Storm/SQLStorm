with
-- recent active users with rank by activity and badge density
active_users as (
  select
    u.id,
    u.displayname,
    u.reputation,
    u.creationdate,
    u.location,
    coalesce(nullif(trim(u.websiteurl), ''), 'n/a') as websiteurl,
    count(b.id) filter (where b.class = 1) as gold_badges,
    count(b.id) filter (where b.class = 2) as silver_badges,
    count(b.id) filter (where b.class = 3) as bronze_badges,
    count(b.id) as total_badges,
    greatest(date_part('day', cast('2024-10-01 12:34:56' as timestamp) - u.creationdate), 1) as account_age_days,
    dense_rank() over (order by u.reputation desc, u.id) as rep_rank
  from users u
  left join badges b on b.userid = u.id
  where u.reputation > 0
  group by u.id, u.displayname, u.reputation, u.creationdate, u.location, coalesce(nullif(trim(u.websiteurl), ''), 'n/a')
),
-- questions and answers in a time window with normalized tags and various aggregates
posts_expanded as (
  select
    p.id,
    p.posttypeid,
    p.owneruserid,
    p.creationdate,
    p.score,
    p.viewcount,
    p.title,
    p.tags,
    p.parentid,
    p.acceptedanswerid,
    string_to_array(substring(p.tags, 2, greatest(length(p.tags)-2,0)), '><') as tag_array
  from posts p
  where p.creationdate >= (select coalesce(max(creationdate), cast('1900-01-01' as timestamp)) - interval '365 days' from posts)
),
-- engagement metrics per post including votes and comments
post_engagement as (
  select
    p.id as post_id,
    count(v.id) filter (where v.votetypeid = 2) as upvotes,
    count(v.id) filter (where v.votetypeid = 3) as downvotes,
    count(v.id) filter (where v.votetypeid in (8,9)) as bounty_events,
    sum(coalesce(v.bountyamount,0)) filter (where v.votetypeid in (8,9)) as bounty_total,
    count(distinct c.id) as comment_count,
    max(c.creationdate) as last_comment_at
  from posts_expanded p
  left join votes v on v.postid = p.id
  left join comments c on c.postid = p.id
  group by p.id
),
-- link relationships (duplicates and general links)
post_links_agg as (
  select
    pl.postid,
    count(*) filter (where pl.linktypeid = 3) as duplicate_links,
    count(*) filter (where pl.linktypeid = 1) as related_links,
    count(*) as total_links,
    json_agg(json_build_object('relatedPostId', pl.relatedpostid, 'type', pl.linktypeid) order by pl.creationdate) as links_json
  from postlinks pl
  group by pl.postid
),
-- closure information from posthistory
post_closure as (
  select
    ph.postid,
    min(ph.creationdate) filter (where ph.posthistorytypeid = 10) as first_closed_at,
    max(ph.creationdate) filter (where ph.posthistorytypeid = 11) as last_reopened_at,
    count(*) filter (where ph.posthistorytypeid = 10) as close_events,
    count(*) filter (where ph.posthistorytypeid = 11) as reopen_events,
    count(*) filter (where ph.posthistorytypeid in (35,36)) as migration_events,
    max(ph.comment) filter (where ph.posthistorytypeid = 10 and ph.comment ~ '^[0-9]+$') as last_close_reason_id_raw
  from posthistory ph
  group by ph.postid
),
-- accepted answer resolution time
answer_resolution as (
  select
    q.id as question_id,
    a.id as accepted_answer_id,
    a.creationdate as accepted_created,
    q.creationdate as question_created,
    cast(extract(epoch from (a.creationdate - q.creationdate)) as bigint) as seconds_to_accept
  from posts q
  join posts a on a.id = q.acceptedanswerid
  where q.posttypeid = 1
),
-- aggregate tag popularity for the recent window
recent_tag_usage as (
  select
    lower(t.tagname) as tagname,
    sum(t.count) as total_tag_count
  from tags t
  group by lower(t.tagname)
),
-- explode tags for questions and map to popularity
question_tags as (
  select
    p.id as question_id,
    unnest(p.tag_array) as tagname
  from posts_expanded p
  where p.posttypeid = 1 and p.tags is not null
),
question_tag_stats as (
  select
    qt.question_id,
    count(*) as tag_count,
    avg(cast(rt.total_tag_count as numeric)) as avg_tag_global_count,
    max(rt.total_tag_count) as max_tag_global_count,
    min(rt.total_tag_count) as min_tag_global_count
  from question_tags qt
  left join recent_tag_usage rt on lower(qt.tagname) = rt.tagname
  group by qt.question_id
),
-- per-user rolling metrics on their posts
user_post_metrics as (
  select
    p.owneruserid as user_id,
    p.id as post_id,
    p.posttypeid,
    p.creationdate,
    p.score,
    p.viewcount,
    sum(p.score) over (partition by p.owneruserid order by p.creationdate rows between unbounded preceding and current row) as cum_user_score,
    avg(p.score) over (partition by p.owneruserid order by p.creationdate rows between 10 preceding and current row) as mov_avg_score_last_10,
    row_number() over (partition by p.owneruserid order by p.creationdate) as post_seq_num
  from posts_expanded p
  where p.owneruserid is not null
),
-- correlate comments sentiment-ish and length stats per post
comment_stats as (
  select
    p.id as post_id,
    cast(avg(length(c.text)) as integer) as avg_comment_len,
    cast(max(length(c.text)) as integer) as max_comment_len,
    sum(case when c.text ilike any (array['%thanks%','%great%','%helpful%']) then 1 else 0 end) as pos_markers,
    sum(case when c.text ilike any (array['%bad%','%wrong%','%downvote%']) then 1 else 0 end) as neg_markers
  from posts_expanded p
  left join comments c on c.postid = p.id
  group by p.id
),
-- heavy join assembling everything per question
question_dashboard as (
  select
    q.id as question_id,
    q.owneruserid as owner_user_id,
    q.title,
    q.score,
    q.viewcount,
    coalesce(pe.upvotes,0) as upvotes,
    coalesce(pe.downvotes,0) as downvotes,
    coalesce(pe.comment_count,0) as comment_count,
    pe.last_comment_at,
    coalesce(pl.duplicate_links,0) as duplicate_links,
    coalesce(pl.related_links,0) as related_links,
    coalesce(pc.close_events,0) as close_events,
    coalesce(pc.reopen_events,0) as reopen_events,
    pc.first_closed_at,
    pc.last_reopened_at,
    ars.seconds_to_accept,
    qts.tag_count,
    qts.avg_tag_global_count,
    qts.max_tag_global_count,
    qts.min_tag_global_count,
    cs.avg_comment_len,
    cs.max_comment_len,
    cs.pos_markers,
    cs.neg_markers
  from posts_expanded q
  left join post_engagement pe on pe.post_id = q.id
  left join post_links_agg pl on pl.postid = q.id
  left join post_closure pc on pc.postid = q.id
  left join answer_resolution ars on ars.question_id = q.id
  left join question_tag_stats qts on qts.question_id = q.id
  left join comment_stats cs on cs.post_id = q.id
  where q.posttypeid = 1
),
-- derive per-owner aggregates to join back
owner_agg as (
  select
    a.user_id,
    avg(case when a.posttypeid = 1 then a.score end) as avg_q_score,
    avg(case when a.posttypeid = 2 then a.score end) as avg_a_score,
    sum(case when a.posttypeid = 2 then 1 else 0 end) as answer_count,
    max(a.cum_user_score) as final_cum_score,
    max(a.mov_avg_score_last_10) as last_mov_avg_score
  from user_post_metrics a
  group by a.user_id
),
-- compute activity deciles per user based on cum score and reputation
user_activity_rank as (
  select
    au.id as user_id,
    au.displayname,
    au.reputation,
    au.account_age_days,
    au.total_badges,
    au.gold_badges,
    au.silver_badges,
    au.bronze_badges,
    au.rep_rank,
    ntile(10) over (order by (au.reputation + 10*au.gold_badges + 5*au.silver_badges + 2*au.bronze_badges) desc) as activity_decile
  from active_users au
),
-- filter interesting questions with complex predicates
interesting_questions as (
  select
    qd.*,
    case
      when qd.duplicate_links > 0 and qd.close_events > 0 then 'controversial'
      when qd.upvotes - qd.downvotes >= 10 and coalesce(qd.seconds_to_accept, 0) <= 7200 then 'fast-accepted'
      when qd.viewcount >= 10000 and coalesce(qd.comment_count,0) >= 10 then 'high-discussion'
      when qd.neg_markers > qd.pos_markers and qd.close_events > 0 then 'contentious'
      else 'other'
    end as category
  from question_dashboard qd
  where
    (qd.score >= 5 or (qd.upvotes >= 8 and qd.downvotes <= 1))
    and coalesce(qd.tag_count, 0) between 1 and 5
    and not (qd.close_events > 0 and qd.reopen_events = 0 and coalesce(qd.seconds_to_accept,0) = 0)
)
select
  iq.question_id,
  iq.title,
  u.displayname as owner_displayname,
  ua.activity_decile,
  oa.avg_q_score,
  oa.avg_a_score,
  oa.answer_count,
  oa.final_cum_score,
  iq.score,
  iq.viewcount,
  iq.upvotes,
  iq.downvotes,
  iq.comment_count,
  iq.duplicate_links,
  iq.related_links,
  iq.close_events,
  iq.reopen_events,
  iq.seconds_to_accept,
  iq.tag_count,
  round(coalesce(iq.avg_tag_global_count,0), 2) as avg_tag_global_count,
  coalesce(iq.max_tag_global_count,0) as max_tag_global_count,
  coalesce(iq.min_tag_global_count,0) as min_tag_global_count,
  iq.avg_comment_len,
  iq.max_comment_len,
  iq.pos_markers,
  iq.neg_markers,
  iq.category,
  coalesce(nullif(trim(u.location), ''), 'Unknown') as owner_location,
  case when u.websiteurl ~* 'https?://' then u.websiteurl else null end as owner_website_normalized,
  row_number() over (partition by ua.activity_decile order by iq.viewcount desc, iq.score desc, iq.question_id) as row_in_decile
from interesting_questions iq
left join users u on u.id = iq.owner_user_id
left join owner_agg oa on oa.user_id = iq.owner_user_id
left join user_activity_rank ua on ua.user_id = iq.owner_user_id
where
  (exists (
    select 1
    from badges b
    where b.userid = iq.owner_user_id
      and b.class = 1
  )
  or (select coalesce(reputation,0) from users ux where ux.id = iq.owner_user_id) >= 20000)
order by
  ua.activity_decile nulls last,
  row_in_decile
fetch first 250 rows only;