WITH UserEngagement AS (
    SELECT
        u.Id AS UserId,
        u.CreationDate AS UserCreationDate,
        u.Reputation,
        u.UpVotes AS UserTotalUpVotesGiven,
        u.DownVotes AS UserTotalDownVotesGiven,
        COUNT(DISTINCT p.Id) AS TotalPostsOwned,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS TotalQuestionsOwned,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS TotalAnswersOwned,
        SUM(COALESCE(p.Score, 0)) AS TotalPostScoreReceived,
        AVG(CAST(COALESCE(p.Score, 0) AS NUMERIC)) AS AvgPostScoreReceived,
        COUNT(DISTINCT c.Id) AS TotalCommentsMade,
        (SELECT COUNT(v_inner.Id)
         FROM Votes v_inner
         JOIN Posts p_inner ON v_inner.PostId = p_inner.Id
         WHERE p_inner.OwnerUserId = u.Id
           AND v_inner.VoteTypeId IN (2,3)
           AND p_inner.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '90 days'
        ) AS RecentVotesReceivedOnOwnedPosts,
        MAX(p.LastActivityDate) AS LastOwnedPostActivity,
        COALESCE((SELECT AVG(p_qa.ViewCount) FROM Posts p_qa WHERE p_qa.OwnerUserId = u.Id AND p_qa.PostTypeId = 1 AND p_qa.ViewCount IS NOT NULL), 0) AS AvgQuestionViewCount
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id, u.CreationDate, u.Reputation, u.UpVotes, u.DownVotes
    HAVING COUNT(p.Id) > 0 OR u.Reputation > 1000
),
PostHistoryAggregated AS (
    SELECT
        ph.PostId,
        COUNT(ph.Id) AS TotalHistoryEntries,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (4,5,6) THEN 1 ELSE 0 END) AS TotalEdits,
        SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS TotalClosures,
        SUM(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS TotalReopens,
        MAX(ph.CreationDate) AS LastHistoryDate,
        MIN(ph.CreationDate) AS FirstHistoryDate,
        AVG(EXTRACT(EPOCH FROM (ph.CreationDate - LAG(ph.CreationDate, 1, ph.CreationDate) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate)))) FILTER (WHERE ph.PostHistoryTypeId = 5) AS AvgSecondsBetweenBodyEdits
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4,5,6,10,11)
    GROUP BY ph.PostId
    HAVING COUNT(ph.Id) > 1
),
UserPostEditStats AS (
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(DISTINCT pha.PostId) AS PostsWithHistory,
        SUM(pha.TotalEdits) AS TotalUserEditsAcrossPosts,
        AVG(pha.AvgSecondsBetweenBodyEdits) AS AvgEditDelayAcrossUserPosts,
        SUM(CASE WHEN pha.TotalClosures > 0 AND pha.TotalReopens > 0 THEN 1 ELSE 0 END) AS PostsClosedThenReopenedCount
    FROM Posts p
    JOIN PostHistoryAggregated pha ON p.Id = pha.PostId
    GROUP BY p.OwnerUserId
),
UserTagInterest AS (
    SELECT
        p.OwnerUserId AS UserId,
        LOWER(TRIM(tag)) AS TagName,
        COUNT(p.Id) AS TaggedPostCount
    FROM Posts p,
    LATERAL (
      SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), '><')) AS tag
    ) t
    WHERE p.Tags IS NOT NULL AND p.PostTypeId = 1
    GROUP BY p.OwnerUserId, LOWER(TRIM(tag))
    HAVING COUNT(p.Id) > 2
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        MAX(b.Date) AS LastBadgeDate,
        MIN(b.Date) AS FirstBadgeDate
    FROM Badges b
    GROUP BY b.UserId
)
SELECT
    ue.UserId,
    u.DisplayName,
    u.Location,
    ue.Reputation,
    ue.TotalPostsOwned,
    ue.TotalQuestionsOwned,
    ue.TotalAnswersOwned,
    ue.TotalCommentsMade,
    ubs.TotalBadges,
    ubs.GoldBadges,
    ROUND(ue.AvgPostScoreReceived, 2) AS CalculatedAvgPostScore,
    NULLIF(ROUND(CAST(ue.UserTotalUpVotesGiven AS NUMERIC) / NULLIF(ue.UserTotalDownVotesGiven, 0), 2), 0) AS UpDownVoteGivenRatio,
    COALESCE(upes.TotalUserEditsAcrossPosts, 0) AS TotalEditsOnUserPosts,
    COALESCE(upes.PostsClosedThenReopenedCount, 0) AS UserPostsClosedReopened,
    ue.RecentVotesReceivedOnOwnedPosts,
    CASE
        WHEN u.Location ILIKE '%london%' OR u.Location ILIKE '%paris%' THEN 'EU_HUB'
        WHEN u.Location ILIKE '%new york%' OR u.Location ILIKE '%san francisco%' THEN 'US_TECH_HUB'
        WHEN u.Location IS NULL OR TRIM(u.Location) = '' THEN 'UNKNOWN'
        ELSE 'OTHER_LOCATION'
    END AS UserLocationCategory,
    (SELECT COUNT(pl_in.Id) FROM PostLinks pl_in JOIN Posts p_link_in ON pl_in.RelatedPostId = p_link_in.Id WHERE p_link_in.OwnerUserId = ue.UserId AND pl_in.LinkTypeId = 1 AND p_link_in.PostTypeId = 1) AS InboundLinksToQuestions,
    (SELECT COUNT(pl_out.Id) FROM PostLinks pl_out JOIN Posts p_link_out ON pl_out.PostId = p_link_out.Id WHERE p_link_out.OwnerUserId = ue.UserId AND pl_out.LinkTypeId = 1 AND p_link_out.PostTypeId = 1) AS OutboundLinksFromQuestions,
    COALESCE(MAX(CASE WHEN uti.TagName = 'sql' THEN uti.TaggedPostCount ELSE 0 END), 0) AS SqlTaggedPosts,
    COALESCE(MAX(CASE WHEN uti.TagName = 'performance' THEN uti.TaggedPostCount ELSE 0 END), 0) AS PerformanceTaggedPosts,
    COALESCE(MAX(CASE WHEN uti.TagName = 'json' THEN uti.TaggedPostCount ELSE 0 END), 0) AS JsonTaggedPosts,
    RANK() OVER (PARTITION BY
        CASE
            WHEN u.Location ILIKE '%london%' OR u.Location ILIKE '%paris%' THEN 'EU_HUB'
            WHEN u.Location ILIKE '%new york%' OR u.Location ILIKE '%san francisco%' THEN 'US_TECH_HUB'
            ELSE 'OTHER'
        END
        ORDER BY ue.Reputation DESC, ue.TotalQuestionsOwned DESC, ue.AvgPostScoreReceived DESC
    ) AS LocationCategoryRank,
    SUM(ubs.GoldBadges) OVER (PARTITION BY EXTRACT(YEAR FROM ue.UserCreationDate) ORDER BY ue.Reputation DESC) AS AnnualCumulativeGoldBadges,
    ROUND(
        (ue.Reputation * 0.05)
        + (COALESCE(ue.AvgPostScoreReceived, 0) * 1.5)
        + (COALESCE(ubs.GoldBadges, 0) * 20)
        + (COALESCE(upes.TotalUserEditsAcrossPosts, 0) * 0.2)
        + (ue.TotalQuestionsOwned * 0.5)
        + (ue.TotalAnswersOwned * 0.3)
        + (ue.TotalCommentsMade * 0.1)
        + (ue.RecentVotesReceivedOnOwnedPosts * 0.01)
        + (COALESCE(MAX(CASE WHEN uti.TagName = 'sql' THEN uti.TaggedPostCount ELSE 0 END) FILTER (WHERE uti.UserId = ue.UserId), 0) * 0.8)
        + (COALESCE(MAX(CASE WHEN uti.TagName = 'performance' THEN uti.TaggedPostCount ELSE 0 END) FILTER (WHERE uti.UserId = ue.UserId), 0) * 1.2)
        + (CASE WHEN u.AboutMe IS NOT NULL AND LENGTH(u.AboutMe) > 100 THEN 10 ELSE 0 END)
        + (COALESCE(ue.AvgQuestionViewCount, 0) * 0.001)
        , 2) AS ComprehensiveUserScore
FROM UserEngagement ue
JOIN Users u ON ue.UserId = u.Id
LEFT JOIN UserBadgeSummary ubs ON ue.UserId = ubs.UserId
LEFT JOIN UserPostEditStats upes ON ue.UserId = upes.UserId
LEFT JOIN UserTagInterest uti ON ue.UserId = uti.UserId
WHERE
    u.CreationDate BETWEEN DATE '2015-01-01' AND DATE '2020-12-31'
    AND ue.Reputation > 2000
    AND (u.Location IS NULL OR (u.Location NOT ILIKE '%india%' AND u.Location NOT ILIKE '%china%'))
    AND NOT EXISTS (
        SELECT 1 FROM Posts p_closed
        WHERE p_closed.OwnerUserId = ue.UserId
        AND p_closed.PostTypeId = 1
        AND p_closed.ClosedDate IS NOT NULL
        AND p_closed.FavoriteCount > 100
    )
GROUP BY
    ue.UserId, u.DisplayName, u.Location, ue.Reputation, ue.TotalPostsOwned, ue.TotalQuestionsOwned,
    ue.TotalAnswersOwned, ue.TotalCommentsMade, ubs.TotalBadges, ubs.GoldBadges, ue.AvgPostScoreReceived,
    ue.UserTotalUpVotesGiven, ue.UserTotalDownVotesGiven, upes.TotalUserEditsAcrossPosts,
    upes.PostsClosedThenReopenedCount, ue.RecentVotesReceivedOnOwnedPosts, u.CreationDate,
    u.AboutMe, ue.AvgQuestionViewCount, u.Id
HAVING
    COUNT(uti.TagName) FILTER (WHERE uti.TagName IN ('sql', 'database')) >= 1
    AND ue.TotalQuestionsOwned > 2
ORDER BY ComprehensiveUserScore DESC, u.CreationDate ASC
LIMIT 100

UNION ALL

SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Location,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPostsOwned,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS TotalQuestionsOwned,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS TotalAnswersOwned,
    COUNT(DISTINCT c_all.Id) AS TotalCommentsMade,
    COUNT(DISTINCT b.Id) AS TotalBadges,
    SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
    ROUND(AVG(CAST(COALESCE(p.Score, 0) AS NUMERIC)), 2) AS CalculatedAvgPostScore,
    NULLIF(ROUND(CAST(u.UpVotes AS NUMERIC) / NULLIF(u.DownVotes, 0), 2), 0) AS UpDownVoteGivenRatio,
    0 AS TotalEditsOnUserPosts,
    0 AS UserPostsClosedReopened,
    COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId IN (2,3) AND v.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '180 days') AS RecentVotesMadeByMe,
    'ALTERNATIVE_SEGMENT' AS UserLocationCategory,
    0 AS InboundLinksToQuestions,
    0 AS OutboundLinksFromQuestions,
    0 AS SqlTaggedPosts,
    0 AS PerformanceTaggedPosts,
    0 AS JsonTaggedPosts,
    RANK() OVER (ORDER BY COUNT(DISTINCT v.Id) DESC, u.Reputation DESC) AS LocationCategoryRank,
    0 AS AnnualCumulativeGoldBadges,
    ROUND(
        (u.Reputation * 0.02)
        + (COUNT(DISTINCT v.Id) * 0.5)
        + (COUNT(DISTINCT p.Id) * 0.1)
        + (SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) * 5)
        + (CASE WHEN u.WebsiteUrl IS NOT NULL THEN 5 ELSE 0 END)
        , 2) AS ComprehensiveUserScore
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
LEFT JOIN Comments c_all ON u.Id = c_all.UserId
LEFT JOIN Badges b ON u.Id = b.UserId
JOIN Votes v ON u.Id = v.UserId
LEFT JOIN Posts p_voted ON v.PostId = p_voted.Id
WHERE
    u.CreationDate < DATE '2015-01-01'
    AND u.Reputation BETWEEN 500 AND 10000
    AND v.VoteTypeId IN (2,3)
    AND EXISTS (
        SELECT 1
        FROM Tags t_sub
        WHERE (t_sub.TagName ILIKE 'obscure%' OR t_sub.TagName ILIKE 'niche%')
          AND p_voted.Tags IS NOT NULL
          AND LOWER(TRIM(tag)) = t_sub.TagName
        AND EXISTS (
          SELECT 1 FROM LATERAL (
            SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p_voted.Tags, 2, LENGTH(p_voted.Tags)-2), '><')) AS tag
          ) t2
        )
    )
GROUP BY
    u.Id, u.DisplayName, u.Location, u.Reputation, u.UpVotes, u.DownVotes, u.WebsiteUrl
HAVING
    COUNT(DISTINCT v.Id) > 50
    AND COUNT(DISTINCT p.Id) < 10
ORDER BY ComprehensiveUserScore DESC
LIMIT 50;