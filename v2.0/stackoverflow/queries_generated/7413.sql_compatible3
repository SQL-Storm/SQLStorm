WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
        COUNT(DISTINCT c.Id) AS Comments,
        COUNT(DISTINCT b.Id) AS Badges,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RankByReputation
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= TIMESTAMP '2010-01-01 00:00:00'
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
PostComplexityAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.CreationDate,
        CASE 
            WHEN p.Tags IS NOT NULL AND LENGTH(p.Tags) > 0 THEN 
                -- convert tags like '<tag1><tag2>' into count by removing leading/trailing <> and splitting on '><'
                -- Standard SQL: count occurrences of '><' + 1
                (CASE WHEN LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', '')) = 0 THEN 1
                      ELSE (LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', '')))/LENGTH('><') + 1
                 END)
            ELSE 0 
        END AS TagCount,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END AS PostType,
        -- compute interval/age in a dialect-neutral way: use timestamp arithmetic
        (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate) AS AgeInterval,
        EXTRACT(DAY FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) AS AgeInDays,
        CASE 
            WHEN p.Score > 100 THEN 'High'
            WHEN p.Score > 50 THEN 'Medium'
            ELSE 'Low'
        END AS PopularityLevel,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PreviousScore,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS MovingAvgScore,
        NTH_VALUE(p.Score, 3) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS ThirdHighestScore,
        (p.CreationDate - LAG(p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate)) AS TimeBetweenPosts
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
UserEngagementScores AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.TotalPosts,
        uas.Questions,
        uas.Answers,
        uas.Comments,
        uas.Badges,
        uas.LastPostDate,
        (uas.TotalPosts * 0.3 + uas.Questions * 0.4 + uas.Answers * 0.3) AS ActivityScore,
        (uas.Reputation / 1000.0 + uas.Badges * 10.0 + uas.Comments * 2.0) AS ReputationScore,
        CASE 
            WHEN uas.TotalPosts > 100 THEN 'Elite'
            WHEN uas.TotalPosts > 50 THEN 'Advanced'
            WHEN uas.TotalPosts > 10 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS UserLevel,
        CASE 
            WHEN uas.Questions > uas.Answers THEN 'QuestionFocus'
            WHEN uas.Answers > uas.Questions THEN 'AnswerFocus'
            ELSE 'Balanced'
        END AS ContributionFocus
    FROM UserActivityStats uas
),
TopQuestionsWithVotes AS (
    SELECT 
        pca.PostId,
        pca.Title,
        pca.Score,
        pca.ViewCount,
        pca.TagCount,
        pca.AgeInDays,
        pca.PopularityLevel,
        pca.MovingAvgScore,
        pca.TimeBetweenPosts,
        ROW_NUMBER() OVER (ORDER BY pca.Score DESC, pca.ViewCount DESC) AS RankByScore,
        DENSE_RANK() OVER (ORDER BY pca.TagCount DESC) AS RankByTagCount
    FROM PostComplexityAnalysis pca
    WHERE pca.PostType = 'Question'
),
PostWithDetailedHistory AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.LastEditDate,
        p.LastActivityDate,
        COUNT(ph.Id) AS HistoryCount,
        COUNT(CASE WHEN ph.PostHistoryTypeId IN (1, 4, 6) THEN 1 END) AS TitleEditCount,
        COUNT(CASE WHEN ph.PostHistoryTypeId IN (2, 5) THEN 1 END) AS BodyEditCount,
        MAX(ph.CreationDate) AS LatestHistoryDate,
        STRING_AGG(ph.Comment, ' | ') AS AllComments,
        STRING_AGG(ph.Text, ' | ') AS AllTextHistory,
        -- ARRAY_AGG may not be supported in all dialects; keep for those that do
        ARRAY_AGG(ph.PostHistoryTypeId) AS AllHistoryTypes,
        STRING_AGG(CASE WHEN ph.UserId IS NOT NULL THEN CAST(ph.UserId AS VARCHAR) ELSE 'System' END, ', ') AS EditorsList
    FROM Posts p
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId
    WHERE p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, p.LastEditDate, p.LastActivityDate
),
FinalAnalysis AS (
    SELECT 
        ue.UserId,
        ue.DisplayName,
        ue.Reputation,
        ue.TotalPosts,
        ue.Questions,
        ue.Answers,
        ue.Comments,
        ue.Badges,
        ue.LastPostDate,
        ue.ActivityScore,
        ue.ReputationScore,
        ue.UserLevel,
        ue.ContributionFocus,
        COALESCE(tq.PostId, 0) AS TopQuestionId,
        COALESCE(tq.Title, 'None') AS TopQuestionTitle,
        COALESCE(tq.Score, 0) AS TopQuestionScore,
        COALESCE(tq.ViewCount, 0) AS TopQuestionViews,
        COALESCE(tq.TagCount, 0) AS TopQuestionTagCount,
        COALESCE(ph.PostId, 0) AS PostWithHistoryId,
        COALESCE(ph.Title, 'No History Post') AS HistoryPostTitle,
        COALESCE(ph.Score, 0) AS HistoryPostScore,
        COALESCE(ph.HistoryCount, 0) AS HistoryRecordCount,
        COALESCE(ph.TitleEditCount, 0) AS TitleEditTotal,
        COALESCE(ph.BodyEditCount, 0) AS BodyEditTotal,
        CASE 
            WHEN ue.Reputation > 10000 THEN 'HighlyReputable'
            WHEN ue.Reputation > 5000 THEN 'WellReputable'
            WHEN ue.Reputation > 1000 THEN 'ModeratelyReputable'
            ELSE 'NewReputable'
        END AS ReputationCategory,
        CASE 
            WHEN ue.Badges > 50 THEN 'BadgeMaster'
            WHEN ue.Badges > 20 THEN 'BadgeEnthusiast'
            WHEN ue.Badges > 5 THEN 'BadgeFan'
            ELSE 'BadgeBeginner'
        END AS BadgeAchievementLevel,
        CASE 
            WHEN ue.ActivityScore > 200 THEN 'HighlyActive'
            WHEN ue.ActivityScore > 100 THEN 'ModeratelyActive'
            WHEN ue.ActivityScore > 50 THEN 'LowActive'
            ELSE 'Inactive'
        END AS ActivityStatus,
        EXTRACT(DAY FROM (TIMESTAMP '2024-10-01 12:34:56' - ue.LastPostDate)) AS DaysSinceLastPost,
        COALESCE(ue.Badges * 100000.0 / NULLIF(ue.Reputation, 0), 0) AS BadgeEfficiencyRatio,
        CASE 
            WHEN ue.Answers > ue.Questions * 2 THEN 'AnswerPro'
            WHEN ue.Answers > ue.Questions THEN 'AnswerSupporter'
            WHEN ue.Questions > ue.Answers THEN 'QuestionSeeker'
            ELSE 'BalancedContributor'
        END AS ContributionStyle,
        ROW_NUMBER() OVER (ORDER BY ue.Reputation DESC, ue.TotalPosts DESC) AS OverallRank
    FROM UserEngagementScores ue
    LEFT JOIN TopQuestionsWithVotes tq ON tq.RankByScore = 1
    LEFT JOIN PostWithDetailedHistory ph ON ph.HistoryCount > 0
    WHERE ue.Reputation > 100
)
SELECT 
    f.UserId,
    f.DisplayName,
    f.Reputation,
    f.TotalPosts,
    f.Questions,
    f.Answers,
    f.Comments,
    f.Badges,
    f.ActivityScore,
    f.ReputationScore,
    f.UserLevel,
    f.ContributionFocus,
    f.TopQuestionId,
    f.TopQuestionTitle,
    f.TopQuestionScore,
    f.TopQuestionViews,
    f.TopQuestionTagCount,
    f.PostWithHistoryId,
    f.HistoryPostTitle,
    f.HistoryPostScore,
    f.HistoryRecordCount,
    f.TitleEditTotal,
    f.BodyEditTotal,
    f.ReputationCategory,
    f.BadgeAchievementLevel,
    f.ActivityStatus,
    f.DaysSinceLastPost,
    f.BadgeEfficiencyRatio,
    f.ContributionStyle,
    f.OverallRank,
    CASE 
        WHEN f.TotalPosts > 50 AND f.Questions > 10 AND f.Answers > 10 THEN 'ActiveContributor'
        WHEN f.TotalPosts > 25 AND (f.Questions > 5 OR f.Answers > 5) THEN 'ModerateContributor'
        WHEN f.TotalPosts < 10 THEN 'NewUser'
        ELSE 'Participant'
    END AS ContributionStatus
FROM FinalAnalysis f
WHERE f.BadgeEfficiencyRatio > 0
  AND f.ActivityScore > 50
  AND f.ReputationScore > 100
  AND (f.TopQuestionScore > 100 OR f.HistoryRecordCount > 5)
ORDER BY f.Reputation DESC, f.TotalPosts DESC, f.ActivityScore DESC
LIMIT 100;