WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        AVG(p.Score) as AvgPostScore,
        MAX(p.CreationDate) as LastPostDate,
        CASE 
            WHEN COUNT(DISTINCT p.Id) = 0 THEN 'No Posts'
            WHEN COUNT(DISTINCT p.Id) > 100 THEN 'Veteran'
            WHEN COUNT(DISTINCT p.Id) > 50 THEN 'Experienced'
            WHEN COUNT(DISTINCT p.Id) > 10 THEN 'Active'
            ELSE 'Newbie'
        END as UserLevel,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
        NTILE(10) OVER (ORDER BY u.Reputation DESC) as ReputationDecile
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN 'Question with Answer'
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END as PostCategory,
        COALESCE(
            CASE WHEN p.ViewCount > 0 THEN 
                CAST(p.Score AS DOUBLE PRECISION) / CAST(p.ViewCount AS DOUBLE PRECISION) 
            ELSE 0 END,
            0
        ) as ScorePerView,
        CASE 
            WHEN p.Score >= 100 THEN 'Popular'
            WHEN p.Score >= 10 THEN 'Moderate'
            WHEN p.Score >= 0 THEN 'Low'
            ELSE 'Negative'
        END as PopularityLevel,
        COUNT(DISTINCT v.Id) as VoteCount,
        COUNT(DISTINCT c.Id) as CommentCountActual,
        COALESCE(p.AnswerCount, 0) - COALESCE(SUM(CASE WHEN a.Id IS NOT NULL THEN 1 ELSE 0 END) OVER (PARTITION BY p.Id), 0) as UnansweredCount,
        RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) as ScoreRank,
        DENSE_RANK() OVER (ORDER BY p.Score DESC) as ScoreDenseRank
    FROM Posts p
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Posts a ON p.Id = a.ParentId AND a.PostTypeId = 2
    WHERE p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.FavoriteCount, p.CreationDate, p.OwnerUserId, p.PostTypeId, p.Tags, p.ParentId
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count as TagCount,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsRequired,
        t.IsModeratorOnly,
        LAG(t.Count) OVER (ORDER BY t.Count DESC) - t.Count as CountDifference,
        PERCENT_RANK() OVER (ORDER BY t.Count DESC) as TagPercentile,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as TagRank
    FROM Tags t
    WHERE t.TagName IS NOT NULL AND t.TagName != ''
),
PostTagMapping AS (
    SELECT 
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ScorePerView,
        pa.PopularityLevel,
        pa.PostCategory,
        pa.ScoreRank,
        pa.ScoreDenseRank,
        ta.TagName,
        ta.TagCount,
        ta.TagPercentile,
        ta.TagRank,
        CASE 
            WHEN ta.TagCount > (SELECT AVG("Count") FROM Tags) THEN 'High Usage'
            WHEN ta.TagCount > (SELECT AVG("Count") * 0.5 FROM Tags) THEN 'Medium Usage'
            ELSE 'Low Usage'
        END as UsageLevel,
        DENSE_RANK() OVER (PARTITION BY ta.TagName ORDER BY pa.Score DESC) as TagScoreRank
    FROM PostAnalysis pa,
    LATERAL (
        SELECT * FROM Tags t 
        WHERE pa.Tags LIKE '%' || t.TagName || '%'
    ) ta
),
AggregatedData AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Reputation,
        us.PostCount,
        us.CommentCount,
        us.BadgeCount,
        us.AvgPostScore,
        us.UserLevel,
        us.ReputationRank,
        us.ReputationDecile,
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.ScorePerView,
        pa.PopularityLevel,
        pa.PostCategory,
        pa.ScoreRank,
        pa.ScoreDenseRank,
        ptm.TagName,
        ptm.TagCount,
        ptm.UsageLevel,
        ptm.TagScoreRank,
        CASE 
            WHEN ptm.UsageLevel = 'High Usage' AND NOT EXISTS (
                SELECT 1 FROM PostTagMapping ptm2 
                WHERE ptm2.PostId = pa.PostId AND ptm2.UsageLevel = 'High Usage'
            ) THEN 'Most Popular Tag'
            WHEN ptm.UsageLevel = 'High Usage' AND EXISTS (
                SELECT 1 FROM PostTagMapping ptm3 
                WHERE ptm3.PostId = pa.PostId AND ptm3.UsageLevel <> 'High Usage'
            ) THEN 'Mixed Tags'
            ELSE 'Standard Tags'
        END as TagComposition,
        (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - us.LastPostDate) / INTERVAL '1 day' as DaysSinceLastPost,
        CASE 
            WHEN us.CommentCount > 0 AND us.BadgeCount > 0 THEN 'Engaged'
            WHEN us.CommentCount > 0 OR us.BadgeCount > 0 THEN 'Participating'
            ELSE 'Passive'
        END as EngagementLevel,
        pa.PostTypeId
    FROM UserStats us
    INNER JOIN PostAnalysis pa ON us.UserId = pa.OwnerUserId
    LEFT JOIN PostTagMapping ptm ON pa.PostId = ptm.PostId
    WHERE pa.PostTypeId = 1 AND pa.Score > 0
)
SELECT 
    ad.UserId,
    ad.DisplayName,
    ad.Reputation,
    ad.PostCount,
    ad.CommentCount,
    ad.BadgeCount,
    ad.AvgPostScore,
    ad.UserLevel,
    ad.ReputationRank,
    ad.ReputationDecile,
    ad.PostId,
    ad.Title,
    ad.Score,
    ad.ViewCount,
    ad.ScorePerView,
    ad.PopularityLevel,
    ad.PostCategory,
    ad.ScoreRank,
    ad.ScoreDenseRank,
    ad.TagName,
    ad.TagCount,
    ad.UsageLevel,
    ad.TagScoreRank,
    ad.TagComposition,
    ad.DaysSinceLastPost,
    ad.EngagementLevel,
    CASE 
        WHEN ad.Reputation > 10000 AND ad.PostCount > 50 THEN 'Power User'
        WHEN ad.Reputation > 5000 AND ad.PostCount > 25 THEN 'Active User'
        WHEN ad.Reputation > 1000 AND ad.PostCount > 10 THEN 'Contributor'
        ELSE 'Regular User'
    END as UserStatus,
    COALESCE(
        CASE 
            WHEN ad.Reputation > 10000 THEN 'Elite'
            WHEN ad.Reputation > 5000 THEN 'Expert'
            WHEN ad.Reputation > 1000 THEN 'Advanced'
            ELSE 'Beginner'
        END,
        'Unknown'
    ) as SkillLevel,
    ROW_NUMBER() OVER (ORDER BY ad.Score DESC, ad.Reputation DESC, ad.TagCount DESC) as PriorityIndex,
    COUNT(*) OVER (PARTITION BY ad.TagName) as TagPopularity,
    (SELECT COUNT(*) FROM AggregatedData) as TotalRecords,
    CASE 
        WHEN ad.DaysSinceLastPost > 30 THEN 'Inactive'
        WHEN ad.DaysSinceLastPost > 7 THEN 'Occasional'
        ELSE 'Active'
    END as ActivityLevel,
    ROUND(
        (ad.Score * 0.5 + 
         ad.ViewCount * 0.3 + 
         ad.CommentCount * 0.2 + 
         COALESCE(ad.TagCount,0) * 0.1) / 
        NULLIF(
            (SELECT AVG(Score * 0.5 + ViewCount * 0.3 + CommentCount * 0.2 + COALESCE(TagCount,0) * 0.1) 
             FROM AggregatedData ad2 
             WHERE ad2.UserId = ad.UserId), 0
        ), 2
    ) as PerformanceScore
FROM AggregatedData ad
WHERE ad.PostCategory = 'Question with Answer'
    AND ad.TagName IS NOT NULL
    AND ad.TagCount >= 5
    AND ad.Score > (SELECT AVG(Score) FROM AggregatedData)
    AND ad.ViewCount > (SELECT AVG(ViewCount) FROM AggregatedData)
    AND (ad.EngagementLevel = 'Engaged' OR ad.EngagementLevel = 'Participating')
UNION ALL
