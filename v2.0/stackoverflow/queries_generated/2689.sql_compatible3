with recursive RecursivePostCounts as (
  select p.Id,
         p.PostTypeId,
         p.CreationDate,
         p.OwnerUserId,
         p.Score,
         p.ViewCount,
         1 as Depth
    from Posts p
   where p.PostTypeId = 1

  union all

  select c.Id,
         c.PostTypeId,
         c.CreationDate,
         c.OwnerUserId,
         c.Score,
         c.ViewCount,
         rpc.Depth + 1
    from Posts c
    join RecursivePostCounts rpc on c.ParentId = rpc.Id
), TaggedQuestions as (
  select Id,
         OwnerUserId,
         Score,
         ViewCount,
         CreationDate,
         regexp_split_to_table(substring(Tags, 2, length(Tags)-2), '><') as Tag
    from Posts
   where PostTypeId = 1
), UserBadgesSummary as (
  select UserId,
         count(case when Class = 1 then 1 end) as GoldBadges,
         count(case when Class = 2 then 1 end) as SilverBadges,
         count(case when Class = 3 then 1 end) as BronzeBadges,
         bool_or(TagBased) as HasTagBasedBadges
    from Badges
   group by UserId
), UserActivityWindows as (
  select u.Id,
         u.DisplayName,
         u.Reputation,
         count(case when p.PostTypeId = 1 then p.Id end) as QuestionCount,
         count(case when p.PostTypeId = 2 then p.Id end) as AnswerCount,
         count(c.Id) as CommentCount,
         count(case when v.VoteTypeId = 2 then v.Id end) as UpVotesReceived,
         count(case when v.VoteTypeId = 3 then v.Id end) as DownVotesReceived,
         min(p.CreationDate) as FirstPostDate,
         max(p.LastActivityDate) as LastPostActivity,
         rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Votes v on v.UserId = u.Id
   group by u.Id, u.DisplayName, u.Reputation
), QuestionAnswerVotes as (
  select q.Id as QuestionId,
         a.Id as AnswerId,
         a.Score as AnswerScore,
         v.VoteTypeId,
         count(*) as VoteCount
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Votes v on v.PostId = a.Id
   where q.PostTypeId = 1
   group by q.Id, a.Id, a.Score, v.VoteTypeId
), CloseReasonSummary as (
  select cht.Id,
         cht.Name,
         count(ph.Id) as ClosedPostsCount
    from CloseReasonTypes cht
    left join PostHistory ph on ph.PostHistoryTypeId = 10 and ph.Comment = cast(cht.Id as varchar)
   group by cht.Id, cht.Name
), UserTopTags as (
  select ub.UserId,
         t.TagName,
         sum(p.Score) as TotalScore
    from Badges b
    join Users ub on ub.Id = b.UserId
    join Posts p on p.OwnerUserId = ub.Id
    join Tags t on t.TagName = any(regexp_split_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><'))
   where b.TagBased = 1
   group by ub.UserId, t.TagName
), LastEditInfo as (
  select ph.PostId,
         max(ph.CreationDate) as LastEditDate,
         max(ph.UserId) as LastEditorUserId,
         max(ph.UserDisplayName) as LastEditorDisplayName
    from PostHistory ph
   where ph.PostHistoryTypeId in (4,5,6,7,8,9,14)
   group by ph.PostId
)
select distinct
       p.Id as PostId,
       p.Title,
       p.Tags,
       p.Score,
       p.ViewCount,
       p.CreationDate,
       p.OwnerUserId,
       u.DisplayName as OwnerDisplayName,
       ub.GoldBadges,
       ub.SilverBadges,
       ub.BronzeBadges,
       ub.HasTagBasedBadges,
       wa.QuestionCount,
       wa.AnswerCount,
       wa.CommentCount,
       wa.UpVotesReceived,
       wa.DownVotesReceived,
       wa.ReputationRank,
       lvi.LastEditDate,
       lvi.LastEditorUserId,
       lvi.LastEditorDisplayName,
       cr.Name as CloseReason,
       case 
         when p.Score > 100 and p.ViewCount > 10000 and coalesce(ub.GoldBadges,0) > 0 then 'High Impact'
         when p.Score between 10 and 100 and coalesce(ub.SilverBadges,0) > 5 then 'Moderate Impact'
         else 'Low Impact'
       end as ImpactCategory,
       regexp_replace(p.Body, '<[^>]*>', '') as PlainTextBody,
       length(regexp_replace(p.Body, '\s+', '', 'g')) as BodyCharCount,
       case when p.Tags is null then array[]::varchar[] else regexp_split_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><') end as TagArray
  from Posts p
  left join Users u on u.Id = p.OwnerUserId
  left join UserBadgesSummary ub on ub.UserId = p.OwnerUserId
  left join UserActivityWindows wa on wa.Id = p.OwnerUserId
  left join LastEditInfo lvi on lvi.PostId = p.Id
  left join PostHistory ph on ph.PostId = p.Id and ph.PostHistoryTypeId = 10
  left join CloseReasonSummary cr on cr.Id = cast(ph.Comment as integer)
 where p.PostTypeId = 1
   and (
         p.CreationDate > '2019-01-01'
         or p.Score > 50
         or exists (select 1 from Comments c2 where c2.PostId = p.Id and c2.Score > 5)
       )
 order by ImpactCategory desc, p.Score desc, p.ViewCount desc
 limit 100;