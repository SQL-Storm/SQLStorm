-- {"query": "1702.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3557} 
WITH UserActivitySummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        u.Views AS UserViews,
        u.UpVotes AS UserUpVotes,
        u.DownVotes AS UserDownVotes,
        CASE
            WHEN u.Reputation >= 50000 THEN 'Legendary'
            WHEN u.Reputation >= 10000 THEN 'Expert'
            WHEN u.Reputation >= 1000 THEN 'Advanced'
            WHEN u.Reputation >= 200 THEN 'Intermediate'
            ELSE 'Novice'
        END AS ReputationTier,
        COUNT(b.Id) AS TotalBadges,
        MAX(b.Date) AS LastBadgeDate,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        AVG(EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - b.Date)) / (3600 * 24 * 365.25)) FILTER (WHERE b.Date IS NOT NULL) AS AvgBadgeAgeYears
    FROM Users AS u
    LEFT JOIN Badges AS b ON u.Id = b.UserId
    WHERE u.LastAccessDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') -- Consider active users in the last year
      AND u.Views > 0 -- Users with some profile views
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.Views, u.UpVotes, u.DownVotes
),
PostEngagementMetrics AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        pt.Name AS PostTypeName,
        p.OwnerUserId,
        COALESCE(p.OwnerDisplayName, uas.DisplayName, 'Community User') AS PostOwnerDisplayName,
        p.CreationDate AS PostCreationDate,
        p.LastActivityDate,
        p.Score,
        p.ViewCount,
        p.Body, -- Include Body for later processing
        p.AnswerCount,
        p.CommentCount,
        COALESCE(p.FavoriteCount, 0) AS FavoriteCount, -- Handle NULL FavoriteCount
        p.Title,
        -- Extract the first tag, handling NULL or malformed tags
        NULLIF(TRIM(string_to_array(SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2), '><')[1]), '') AS PrimaryTag,
        -- Calculate the age of the post in days
        EXTRACT(DAY FROM (cast('2024-10-01 12:34:56' as timestamp) - p.CreationDate)) AS PostAgeDays,
        -- Determine post "hotness"
        CASE
            WHEN p.ViewCount > 50000 AND COALESCE(p.FavoriteCount, 0) >= (p.ViewCount * 0.01) THEN 'Viral'
            WHEN p.ViewCount > 10000 AND COALESCE(p.FavoriteCount, 0) >= (p.ViewCount * 0.005) THEN 'Hot Topic'
            WHEN p.ViewCount > 1000 AND COALESCE(p.FavoriteCount, 0) >= (p.ViewCount * 0.001) THEN 'Trending'
            ELSE 'Standard'
        END AS PostTrendStatus,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpVotes, -- UpMod
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownVotes, -- DownMod
        SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS TotalFavoritesFromVotes -- Favorite (legacy)
    FROM Posts AS p
    LEFT JOIN PostTypes AS pt ON p.PostTypeId = pt.Id
    LEFT JOIN UserActivitySummary AS uas ON p.OwnerUserId = uas.UserId
    LEFT JOIN Votes AS v ON p.Id = v.PostId
    WHERE p.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years') -- Focus on somewhat recent posts
      AND p.PostTypeId IN (1, 2) -- Only Questions (1) and Answers (2)
      AND p.Body IS NOT NULL -- Exclude posts without body
    GROUP BY
        p.Id, p.PostTypeId, pt.Name, p.OwnerUserId, p.OwnerDisplayName, uas.DisplayName,
        p.CreationDate, p.LastActivityDate, p.Score, p.ViewCount, p.Body, p.AnswerCount,
        p.CommentCount, p.FavoriteCount, p.Title, p.Tags
),
PostHistorySummary AS (
    SELECT
        ph.PostId,
        COUNT(ph.Id) AS TotalHistoryEvents,
        COUNT(DISTINCT ph.UserId) AS UniqueEditors,
        MAX(ph.CreationDate) AS LastHistoryEditDate,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (4,5,6) THEN 1 ELSE 0 END) AS EditCount, -- Title, Body, Tags edits
        SUM(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseCount,
        SUM(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS ReopenCount,
        -- Get the name of the last close reason if applicable
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN COALESCE(crt.Name, 'Unknown Reason') ELSE NULL END) AS LastCloseReasonName,
        -- Calculate average time between edits for a post, ignoring the initial creation
        AVG(EXTRACT(EPOCH FROM (ph.CreationDate - LAG(ph.CreationDate) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate)))) FILTER (WHERE ph.PostHistoryTypeId IN (4,5,6)) AS AvgTimeBetweenEditsSeconds
    FROM PostHistory AS ph
    LEFT JOIN CloseReasonTypes AS crt ON ph.PostHistoryTypeId = 10 AND ph.Comment = crt.Id::varchar(50)
    WHERE ph.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years')
    GROUP BY ph.PostId
),
LinkedPostAnalysis AS (
    SELECT
        pl.PostId,
        COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 1 THEN pl.RelatedPostId ELSE NULL END) AS LinkedPostsCount,
        COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN pl.RelatedPostId ELSE NULL END) AS DuplicatePostsCount,
        MAX(CASE WHEN pl.LinkTypeId = 3 THEN 'True' ELSE 'False' END) AS IsDuplicateSource -- This post links TO a duplicate
    FROM PostLinks AS pl
    WHERE pl.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years')
    GROUP BY pl.PostId
),
CommentSentimentSummary AS (
    SELECT
        c.PostId,
        COUNT(c.Id) AS TotalComments,
        SUM(c.Score) AS TotalCommentScore,
        COUNT(DISTINCT c.UserId) AS UniqueCommenters,
        MAX(c.CreationDate) AS LastCommentDate,
        SUM(CASE WHEN LOWER(c.Text) LIKE '%thank%' OR LOWER(c.Text) LIKE '%helpful%' OR LOWER(c.Text) LIKE '%appreciate%' THEN 1 ELSE 0 END) AS PositiveComments,
        SUM(CASE WHEN LOWER(c.Text) LIKE '%bug%' OR LOWER(c.Text) LIKE '%error%' OR LOWER(c.Text) LIKE '%problem%' THEN 1 ELSE 0 END) AS ProblemComments
    FROM Comments AS c
    WHERE c.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years')
    GROUP BY c.PostId
),
TagPerformance AS (
    SELECT
        pem.PrimaryTag,
        COUNT(DISTINCT pem.PostId) AS TaggedPostsCount,
        AVG(pem.Score) AS AverageTagScore,
        SUM(pem.ViewCount) AS TotalTagViews,
        SUM(pem.FavoriteCount) AS TotalTagFavorites,
        -- Calculate a comprehensive tag popularity score
        (SUM(pem.ViewCount) * 0.3 + SUM(pem.FavoriteCount) * 1.5 + COUNT(DISTINCT pem.PostId) * 5 + AVG(pem.TotalUpVotes) * 0.5) AS TagPopularityScore
    FROM PostEngagementMetrics AS pem
    WHERE pem.PrimaryTag IS NOT NULL
    GROUP BY pem.PrimaryTag
)
-- Final Select Statement to combine all insights and apply advanced analytics
SELECT
    pem.PostId,
    pem.PostTypeName,
    pem.Title,
    pem.PostOwnerDisplayName,
    uas.ReputationTier,
    pem.PostCreationDate,
    pem.LastActivityDate,
    pem.PostAgeDays,
    pem.PostTrendStatus,
    pem.Score AS PostScore,
    pem.ViewCount,
    pem.TotalUpVotes,
    pem.TotalDownVotes,
    pem.TotalFavoritesFromVotes + pem.FavoriteCount AS CombinedFavoriteCount, -- sum direct favorite_count and vote_type=5
    COALESCE(pem.AnswerCount, 0) AS AnswerCount,
    COALESCE(css.TotalComments, 0) AS TotalComments,
    COALESCE(css.TotalCommentScore, 0) AS TotalCommentScore,
    COALESCE(css.UniqueCommenters, 0) AS UniqueCommenters,
    COALESCE(css.PositiveComments, 0) AS PositiveComments,
    COALESCE(css.ProblemComments, 0) AS ProblemComments,
    COALESCE(phs.TotalHistoryEvents, 0) AS TotalHistoryEvents,
    COALESCE(phs.EditCount, 0) AS TotalEdits,
    COALESCE(phs.CloseCount, 0) AS TotalCloses,
    COALESCE(phs.ReopenCount, 0) AS TotalReopens,
    phs.LastCloseReasonName,
    COALESCE(phs.AvgTimeBetweenEditsSeconds, 0) AS AvgTimeBetweenEditsSeconds,
    COALESCE(lpa.LinkedPostsCount, 0) AS LinkedPostsCount,
    COALESCE(lpa.DuplicatePostsCount, 0) AS DuplicatePostsCount,
    COALESCE(lpa.IsDuplicateSource, 'False') AS IsDuplicateSource,
    pem.PrimaryTag,
    tp.TagPopularityScore,
    -- Window function: Rank posts by a composite score (Score + FavoriteCount*2) within their PostType and PrimaryTag
    RANK() OVER (PARTITION BY pem.PostTypeId, pem.PrimaryTag ORDER BY (pem.Score + pem.FavoriteCount * 2) DESC, pem.CreationDate DESC) AS RankWithinTagType,
    -- Window function: Calculate the cumulative sum of upvotes for a user's posts over time
    SUM(pem.TotalUpVotes) OVER (PARTITION BY pem.OwnerUserId ORDER BY pem.CreationDate) AS CumulativeUpvotesByOwner,
    -- Window function: Calculate a moving average of view counts for posts of the same type
    AVG(pem.ViewCount) OVER (PARTITION BY pem.PostTypeId ORDER BY pem.CreationDate ROWS BETWEEN 10 PRECEDING AND CURRENT ROW) AS MovingAvgViewCount,
    -- Correlated subquery: Check if the owner has recently (last 6 months) received any gold badges
    EXISTS (
        SELECT 1
        FROM Badges AS b
        WHERE b.UserId = pem.OwnerUserId AND b.Class = 1 AND b.Date >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months')
    ) AS OwnerHasRecentGoldBadge,
    -- Correlated subquery: Count how many related posts (duplicates or links) also have a high score (>= 10)
    (
        SELECT COUNT(pl_inner.RelatedPostId)
        FROM PostLinks AS pl_inner
        JOIN Posts AS p_inner ON pl_inner.RelatedPostId = p_inner.Id
        WHERE pl_inner.PostId = pem.PostId
          AND pl_inner.LinkTypeId IN (1, 3) -- Linked or Duplicate
          AND p_inner.Score >= 10
    ) AS HighScoreRelatedPostsCount,
    -- Complex string expression: Truncate body for preview, attempt to strip simple HTML tags
    COALESCE(
        SUBSTRING(REGEXP_REPLACE(pem.Body, '<[^>]+>', '', 'g'), 1, 150) || CASE WHEN LENGTH(REGEXP_REPLACE(pem.Body, '<[^>]+>', '', 'g')) > 150 THEN '...' ELSE '' END,
        'No body preview available'
    ) AS BodyPreviewText,
    -- Null logic for identifying posts that are old but have no history events (possibly neglected)
    CASE
        WHEN pem.PostAgeDays > 365 AND COALESCE(phs.TotalHistoryEvents, 0) = 0 THEN 'Neglected Old Post'
        WHEN pem.PostAgeDays > 365 AND COALESCE(phs.EditCount, 0) = 0 AND COALESCE(css.TotalComments, 0) = 0 THEN 'Forgotten Content'
        ELSE 'Active/Normal'
    END AS PostLifecycleStatus,
    -- Set operator used in a subquery to categorize posts based on combined criteria:
    -- Posts that are 'Viral' OR posts that have >= 5 edits AND >= 10 comments AND at least one Gold badge owner
    (
        SELECT COUNT(sq.PostId)
        FROM (
            SELECT pem_inner.PostId
            FROM PostEngagementMetrics AS pem_inner
            WHERE pem_inner.PostTrendStatus = 'Viral'
            UNION
            SELECT pem_inner.PostId
            FROM PostEngagementMetrics AS pem_inner
            JOIN PostHistorySummary AS phs_inner ON pem_inner.PostId = phs_inner.PostId
            JOIN CommentSentimentSummary AS css_inner ON pem_inner.PostId = css_inner.PostId
            JOIN UserActivitySummary AS uas_inner ON pem_inner.OwnerUserId = uas_inner.UserId
            WHERE phs_inner.EditCount >= 5
              AND css_inner.TotalComments >= 10
              AND uas_inner.GoldBadges >= 1
        ) AS sq
        WHERE sq.PostId = pem.PostId
    ) > 0 AS IsHighlyEngagedOrViral
FROM PostEngagementMetrics AS pem
LEFT JOIN UserActivitySummary AS uas ON pem.OwnerUserId = uas.UserId
LEFT JOIN PostHistorySummary AS phs ON pem.PostId = phs.PostId
LEFT JOIN LinkedPostAnalysis AS lpa ON pem.PostId = lpa.PostId
LEFT JOIN CommentSentimentSummary AS css ON pem.PostId = css.PostId
LEFT JOIN TagPerformance AS tp ON pem.PrimaryTag = tp.PrimaryTag
WHERE pem.OwnerUserId IS NOT NULL -- Exclude posts without a valid owner (e.g., community-owned or deleted users for this analysis)
  AND pem.PostAgeDays > 30 -- Focus on posts older than 30 days
  AND pem.Score >= 0 -- Exclude extremely low-scored content
ORDER BY pem.LastActivityDate DESC, pem.Score DESC, pem.ViewCount DESC
LIMIT 5000;