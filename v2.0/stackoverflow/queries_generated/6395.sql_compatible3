SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id) AS TotalBadges,
    (SELECT SUM(v2.Score) FROM Votes v2 WHERE v2.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id)) AS TotalOwnerScore,
    (SELECT STRING_AGG(t.TagName, ', ') FROM Tags t WHERE t.ExcerptPostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id)) AS PopularTags,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id) AND pl.LinkTypeId = 3) AS TotalDuplicatePosts,
    (SELECT AVG(v3.Score) FROM Votes v3 WHERE v3.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = u.Id)) AS AverageScore
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
WHERE 
    u.Reputation > 1000
    AND p.LastActivityDate > (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '12 months')
GROUP BY 
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.Id
HAVING 
    COUNT(DISTINCT p.Id) > 100
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;