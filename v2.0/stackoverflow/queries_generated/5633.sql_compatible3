WITH TaggedActivity AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.Title,
    p.Tags,
    u.Id AS UserId,
    u.DisplayName AS UserName,
    p.OwnerUserId,
    p.LastEditDate,
    CASE WHEN p.Tags IS NULL OR p.Tags = '' THEN 0
         ELSE (CHAR_LENGTH(p.Tags) - CHAR_LENGTH(REPLACE(p.Tags, '<', '')))
    END AS TagCount,
    COUNT(*) OVER () AS TotalPosts
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.PostTypeId IN (1,2)
),
CorrelatedStats AS (
  SELECT
    t1.PostId,
    t1.PostTypeId,
    t1.CreationDate,
    t1.Score,
    t1.ViewCount,
    t1.Title,
    t1.Tags,
    t1.UserId,
    t1.UserName,
    t1.OwnerUserId,
    t1.LastEditDate,
    t1.TagCount,
    t2.Id AS RelatedPostId,
    t2.Title AS RelatedTitle,
    t2.CreationDate AS RelatedCreationDate,
    t2.Score AS RelatedScore,
    t2.ViewCount AS RelatedViewCount,
    t2.Tags AS RelatedTags,
    t2.OwnerUserId AS RelatedOwnerUserId
  FROM TaggedActivity t1
  LEFT JOIN Posts t2
    ON t1.PostId <> t2.Id
   AND t2.PostTypeId = 1
   AND t2.CreationDate > t1.CreationDate
   AND (
     t1.Tags IS NOT NULL
     AND t2.Tags IS NOT NULL
     AND EXISTS (
       SELECT 1
       WHERE (
         -- simple dialect-neutral heuristic: check if any tag-like token from t1 appears in t2
         -- extract first tag token from t1 between '<' and '>'
         -- use POSITION and SUBSTRING which are standard SQL
         t2.Tags LIKE '%' || COALESCE(
           NULLIF(
             SUBSTRING(
               t1.Tags FROM POSITION('<' IN t1.Tags) + 1
               FOR 
                 CASE
                   WHEN POSITION('>' IN SUBSTRING(t1.Tags FROM POSITION('<' IN t1.Tags) + 1)) > 0
                   THEN POSITION('>' IN SUBSTRING(t1.Tags FROM POSITION('<' IN t1.Tags) + 1)) - 1
                   ELSE 0
                 END
             ),
             ''
           ),
           ''
         ) || '%'
       )
     )
   )
  GROUP BY
    t1.PostId, t1.PostTypeId, t1.CreationDate, t1.Score, t1.ViewCount, t1.Title, t1.Tags,
    t1.UserId, t1.UserName, t1.OwnerUserId, t1.LastEditDate, t1.TagCount,
    t2.Id, t2.Title, t2.CreationDate, t2.Score, t2.ViewCount, t2.Tags, t2.OwnerUserId
),
WindowAgg AS (
  SELECT
    PostId,
    PostTypeId,
    CreationDate,
    Score,
    ViewCount,
    Title,
    Tags,
    UserId,
    UserName,
    OwnerUserId,
    LastEditDate,
    TagCount,
    RelatedPostId,
    RelatedTitle,
    RelatedCreationDate,
    RelatedScore,
    RelatedViewCount,
    RelatedTags,
    RelatedOwnerUserId,
    ROW_NUMBER() OVER (
      PARTITION BY PostId
      ORDER BY RelatedScore DESC, RelatedViewCount DESC, RelatedCreationDate ASC
    ) AS rn
  FROM CorrelatedStats
)
SELECT
  PostId,
  PostTypeId,
  CreationDate,
  Score,
  ViewCount,
  Title,
  Tags,
  UserId,
  UserName,
  OwnerUserId,
  LastEditDate,
  TagCount,
  RelatedPostId,
  RelatedTitle,
  RelatedCreationDate,
  RelatedScore,
  RelatedViewCount,
  RelatedTags,
  RelatedOwnerUserId,
  rn
FROM WindowAgg
WHERE rn = 1
ORDER BY PostId, rn;