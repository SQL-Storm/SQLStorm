SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.Location,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT v.PostId) AS TotalVotes,
    COUNT(DISTINCT c.PostId) AS TotalComments,
    MAX(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE NULL END) AS HighestScoredQuestion,
    MIN(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE NULL END) AS LowestViewedQuestion,
    MAX(ph.CreationDate) AS LastActivity,
    b.Name AS LatestBadge,
    b.Date AS BadgeDate,
    ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY MAX(ph.CreationDate) DESC) AS RecentActivityRank
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    Comments c ON p.Id = c.PostId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
WHERE 
    u.Reputation > 10000
    AND u.LastAccessDate > (CAST('2024-10-01' AS DATE) - INTERVAL '1' YEAR)
    AND (p.PostTypeId IS NULL OR p.PostTypeId IN (1, 2))
    AND (
        p.Id IS NULL
        OR (SELECT COUNT(*) FROM Votes vx WHERE vx.PostId = p.Id AND vx.VoteTypeId = 2) > 5
    )
    AND (
        p.Id IS NULL
        OR (SELECT COUNT(*) FROM Votes vx2 WHERE vx2.PostId = p.Id AND vx2.VoteTypeId = 3) < 2
    )
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, u.Location, b.Id, b.Name, b.Date
HAVING 
    SUM(CASE WHEN p.PostTypeId = 1 THEN COALESCE(p.Score,0) ELSE 0 END) > 1000
ORDER BY 
    RecentActivityRank ASC, u.Reputation DESC;