    cr.TagRanking,
    cr.TagTotalCount,
    cr.TagPopularityGroup,
    cr.EngagementIndicator,
    CASE 
        WHEN cr.ScorePercentile > 0.9 THEN 'Top 10% Score'
        WHEN cr.ScorePercentile > 0.75 THEN 'Top 25% Score'
        WHEN cr.ScorePercentile > 0.5 THEN 'Top 50% Score'
        ELSE 'Below Average Score'
    END AS ScorePerformanceTier,
    CASE 
        WHEN cr.TagPopularityRank <= 10 THEN 'Top 10 Tags'
        WHEN cr.TagPopularityRank <= 50 THEN 'Top 50 Tags'
        WHEN cr.TagPopularityRank <= 100 THEN 'Top 100 Tags'
        ELSE 'Other Tags'
    END AS TagRankingTier
FROM CombinedResult cr
WHERE cr.PostId IS NOT NULL
  AND cr.Score IS NOT NULL
  AND cr.OwnerName IS NOT NULL
  AND (
    cr.TagPopularityLevel IN ('Popular', 'Moderate')
    OR cr.PostCategory = 'Question'
    OR cr.PostStatus = 'Active'
  )
ORDER BY 
    cr.Score DESC,
    cr.EngagementScore DESC,
    cr.ReputationRank ASC
LIMIT 10000;