WITH
RecentPopularQuestions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.ViewCount,
    p.Score,
    p.AnswerCount,
    p.CommentCount,
    p.OwnerUserId,
    p.LastActivityDate,
    ROW_NUMBER() OVER (
      PARTITION BY p.OwnerUserId
      ORDER BY
        p.ViewCount * 0.6 + p.Score * 1.4 + COALESCE(p.AnswerCount, 0) * 2 + COALESCE(p.CommentCount, 0) * 0.5 DESC
    ) AS rn
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.ClosedDate IS NULL
),
TopTags AS (
  SELECT
    t.tag AS TagName,
    SUM(rp.ViewCount) AS TagViews,
    SUM(rp.Score) AS TagScore
  FROM RecentPopularQuestions rp,
       UNNEST(
         STRING_TO_ARRAY(
           SUBSTRING(rp.Tags FROM 2 FOR (CHAR_LENGTH(rp.Tags) - 2)),
           '><'
         )
       ) AS t(tag)
  GROUP BY t.tag
),
CorrelatedUserStats AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.AccountId,
    u.Location,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.ProfileImageUrl,
    u.EmailHash,
    u.WebsiteUrl,
    u.AboutMe,
    COUNT(DISTINCT b.Id) AS BadgeCount,
    MAX(b.Date) AS MostRecentBadge
  FROM Users u
  LEFT JOIN Badges b ON b.UserId = u.Id
  GROUP BY
    u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate,
    u.AccountId, u.Location, u.Views, u.UpVotes, u.DownVotes,
    u.ProfileImageUrl, u.EmailHash, u.WebsiteUrl, u.AboutMe
),
ActivitySummary AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.LastActivityDate,
    ARRAY_AGG(DISTINCT v.VoteTypeId) AS VoteTypesOnPost,
    COUNT(DISTINCT c.Id) AS CommentCountOnPost
  FROM Posts p
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN Comments c ON c.PostId = p.Id
  GROUP BY p.Id, p.OwnerUserId, p.LastActivityDate
),
Final AS (
  SELECT
    rp.PostId,
    rp.Title,
    rp.Tags,
    rp.CreationDate,
    rp.ViewCount,
    rp.Score,
    rp.AnswerCount,
    rp.CommentCount,
    cu.UserId AS OwnerUserId,
    cu.DisplayName AS OwnerDisplayName,
    cu.Reputation,
    cu.MostRecentBadge,
    asy.LastActivityDate,
    asy.VoteTypesOnPost,
    asy.CommentCountOnPost,
    rp.rn
  FROM RecentPopularQuestions rp
  LEFT JOIN CorrelatedUserStats cu ON cu.UserId = rp.OwnerUserId
  LEFT JOIN ActivitySummary asy ON asy.PostId = rp.PostId
  WHERE rp.rn <= 3
)
SELECT
  json_build_object(
    'summary', json_build_object(
      'generated_at', CAST('2024-10-01 12:34:56' AS TIMESTAMP),
      'description', 'Benchmark snapshot: top few questions per user with rich attributes'
    ),
    'data', json_agg(
      json_build_object(
        'post_id', f.PostId,
        'title', f.Title,
        'tags', f.Tags,
        'creation_date', f.CreationDate,
        'views', f.ViewCount,
        'score', f.Score,
        'answers', COALESCE(f.AnswerCount, 0),
        'comments', COALESCE(f.CommentCount, 0),
        'owner', json_build_object(
          'user_id', f.OwnerUserId,
          'display_name', f.OwnerDisplayName,
          'reputation', f.Reputation,
          'most_recent_badge', f.MostRecentBadge
        ),
        'last_activity', f.LastActivityDate,
        'vote_kinds', f.VoteTypesOnPost,
        'comments_on_post', f.CommentCountOnPost,
        'top_tags', (SELECT json_agg(t.TagName) FROM TopTags t WHERE t.TagName IS NOT NULL)
      )
    )
  ) AS benchmark_result
FROM Final f
GROUP BY
  json_build_object(
    'summary', json_build_object(
      'generated_at', CAST('2024-10-01 12:34:56' AS TIMESTAMP),
      'description', 'Benchmark snapshot: top few questions per user with rich attributes'
    )
  );