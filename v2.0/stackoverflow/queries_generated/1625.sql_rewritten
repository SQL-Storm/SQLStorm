-- {"query": "1625.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 2400} 
WITH UserEngagement AS (
    -- CTE 1: Summarize user engagement metrics for active and reputable users
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.Views AS UserViews,
        U.UpVotes,
        U.DownVotes,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT C.Id) AS TotalComments,
        MAX(P.CreationDate) AS LatestPostDate,
        MAX(C.CreationDate) AS LatestCommentDate,
        -- Window function: Rank users by reputation within their creation year
        RANK() OVER (PARTITION BY EXTRACT(YEAR FROM U.CreationDate) ORDER BY U.Reputation DESC) AS RankInCreationYear
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    WHERE U.LastAccessDate >= cast('2024-10-01' as date) - INTERVAL '1 year' -- Active in the last year
      AND U.Reputation > 5000 -- Reputable users
      AND U.AboutMe IS NOT NULL -- User has provided "About Me" information
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.Views, U.UpVotes, U.DownVotes, U.CreationDate, U.LastAccessDate
),
QuestionPerformance AS (
    -- CTE 2: Analyze performance of 'Question' posts with various metrics
    SELECT
        Q.Id AS QuestionId,
        Q.Title,
        Q.OwnerUserId,
        Q.CreationDate AS QuestionCreationDate,
        Q.Score AS QuestionScore,
        Q.ViewCount,
        Q.AnswerCount,
        Q.CommentCount,
        Q.FavoriteCount,
        Q.Tags,
        Q.AcceptedAnswerId,
        AVG(A.Score) OVER (PARTITION BY Q.Id) AS AvgAnswerScore, -- Window function: average score of all answers for this question
        MIN(A.CreationDate) OVER (PARTITION BY Q.Id) AS FirstAnswerDate, -- Window function: date of the first answer
        -- Correlated Subquery: Count significant edits (title, body, tags)
        (SELECT COUNT(DISTINCT PH.Id) FROM PostHistory PH WHERE PH.PostId = Q.Id AND PH.PostHistoryTypeId IN (4,5,6)) AS EditCount,
        (SELECT SUM(V.BountyAmount) FROM Votes V WHERE V.PostId = Q.Id AND V.VoteTypeId = 8) AS TotalBountyAmount,
        COALESCE(Q.FavoriteCount, 0) + COALESCE(Q.AnswerCount, 0) * 2 + Q.Score AS BaseEngagementMetric
    FROM Posts Q
    LEFT JOIN Posts A ON Q.Id = A.ParentId AND A.PostTypeId = 2 -- Answers linked to the question
    WHERE Q.PostTypeId = 1 -- Questions only
      AND Q.CreationDate >= cast('2024-10-01' as date) - INTERVAL '2 years' -- Questions from the last two years
      AND Q.Score >= 5
      AND Q.ViewCount >= 1000
),
DuplicateAndClosedStatus AS (
    -- CTE 3: Identify duplicate and closed status, and complex badge-related logic for linked posts
    SELECT
        Q.QuestionId,
        Q.QuestionCreationDate,
        STRING_AGG(DISTINCT PL.RelatedPostId::text, ',') AS DuplicatesLinked, -- String aggregation of linked duplicate IDs
        MAX(CASE WHEN PH_Close.PostHistoryTypeId = 10 THEN 'Closed' ELSE 'Open' END) AS CurrentCloseStatus, -- NULL logic, CASE statement for close status
        -- Correlated subquery to check if any of the question's answers were later merged into another post (PostHistoryTypeId = 37, PostMergeSource) by a high-reputation user
        EXISTS (
            SELECT 1
            FROM Posts AS LinkedAnswer
            JOIN PostHistory AS PH_Merge ON LinkedAnswer.Id = PH_Merge.PostId
            JOIN Users AS MergeUser ON PH_Merge.UserId = MergeUser.Id
            WHERE LinkedAnswer.ParentId = Q.QuestionId -- This answer belongs to our question
              AND PH_Merge.PostHistoryTypeId = 37 -- PostMergeSource event
              AND MergeUser.Reputation > 10000 -- High reputation user performed the merge
              AND LinkedAnswer.PostTypeId = 2 -- Ensure it's an answer post type
        ) AS HasHighRepMergedAnswer
    FROM QuestionPerformance Q
    LEFT JOIN PostLinks PL ON Q.QuestionId = PL.PostId AND PL.LinkTypeId = 3 -- Duplicate links
    LEFT JOIN PostHistory PH_Close ON Q.QuestionId = PH_Close.PostId AND PH_Close.PostHistoryTypeId = 10 -- Post Closed event
    GROUP BY Q.QuestionId, Q.QuestionCreationDate
),
BadgeSummary AS (
    -- CTE 4: Summarize badge counts per user, categorizing by class and identifying unique badges
    SELECT
        UserId,
        COUNT(CASE WHEN Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN Class = 3 THEN 1 END) AS BronzeBadges,
        COUNT(DISTINCT Name) AS UniqueBadges
    FROM Badges
    GROUP BY UserId
)
-- Main query: Join all CTEs and apply final filters, calculations, and NULL handling for comprehensive analysis
SELECT
    UE.UserId,
    UE.DisplayName,
    UE.Reputation,
    QP.QuestionId,
    QP.Title,
    QP.QuestionCreationDate,
    QP.QuestionScore,
    QP.ViewCount,
    QP.AnswerCount,
    QP.BaseEngagementMetric,
    QP.AvgAnswerScore,
    QP.FirstAnswerDate,
    QP.EditCount,
    QP.TotalBountyAmount,
    DCS.CurrentCloseStatus,
    DCS.DuplicatesLinked,
    DCS.HasHighRepMergedAnswer,
    COALESCE(BS.GoldBadges, 0) AS UserGoldBadges,
    COALESCE(BS.SilverBadges, 0) AS UserSilverBadges,
    (UE.UpVotes - UE.DownVotes) AS NetUserVotes,
    -- Correlated subquery in SELECT: Retrieve the name of the user's latest Gold badge
    (SELECT B.Name FROM Badges B WHERE B.UserId = UE.UserId AND B.Class = 1 ORDER BY B.Date DESC LIMIT 1) AS LatestGoldBadgeName,
    -- Complicated calculation/expression with NULLIF and CASE for question categorization
    CASE
        WHEN QP.ViewCount > 50000 AND QP.AnswerCount > 10 AND QP.EditCount > 5 THEN 'High Traffic, Engaged & Evolving'
        WHEN QP.ViewCount > 10000 AND QP.BaseEngagementMetric > 50 THEN 'Popular & Interactive'
        WHEN QP.ViewCount < 5000 AND QP.EditCount > 3 AND COALESCE(BS.BronzeBadges, 0) > 0 THEN 'Niche, Evolving & Experienced User'
        ELSE 'Standard'
    END AS QuestionCategory,
    -- String expression: extract dominant tag, handling cases where there's only one or no tags
    COALESCE(TRIM(SUBSTRING(QP.Tags, 2, POSITION('><' IN QP.Tags) - 2)), 'No_Dominant_Tag') AS DominantTag,
    -- Another complex calculation using NULLIF to prevent division by zero
    (QP.BaseEngagementMetric * 1.0 / NULLIF(QP.ViewCount, 0)) AS EngagementRatioPerView,
    -- Window function: Rank questions by score within each user's contributions
    ROW_NUMBER() OVER (PARTITION BY UE.UserId ORDER BY QP.QuestionScore DESC, QP.ViewCount DESC) AS UserQuestionRank,
    -- Window function (LAG): Days since the previous question posted by the same user
    EXTRACT(DAY FROM (QP.QuestionCreationDate - LAG(QP.QuestionCreationDate, 1) OVER (PARTITION BY UE.UserId ORDER BY QP.QuestionCreationDate))) AS DaysSincePreviousQuestion,
    -- Window function (LEAD): Days until the next question posted by the same user
    EXTRACT(DAY FROM (LEAD(QP.QuestionCreationDate, 1) OVER (PARTITION BY UE.UserId ORDER BY QP.QuestionCreationDate) - QP.QuestionCreationDate)) AS DaysUntilNextQuestion
FROM UserEngagement UE
JOIN QuestionPerformance QP ON UE.UserId = QP.OwnerUserId
LEFT JOIN DuplicateAndClosedStatus DCS ON QP.QuestionId = DCS.QuestionId
LEFT JOIN BadgeSummary BS ON UE.UserId = BS.UserId
WHERE UE.Reputation > 10000 -- Filter for highly reputable users
  AND (QP.FirstAnswerDate IS NOT NULL AND QP.FirstAnswerDate < QP.QuestionCreationDate + INTERVAL '1 day') -- First answer arrived within 1 day of question
  AND (QP.TotalBountyAmount IS NULL OR QP.TotalBountyAmount > 0) -- Either no bounty was set, or a positive bounty was set
  AND (QP.AcceptedAnswerId IS NOT NULL OR QP.CommentCount > 5) -- Question has an accepted answer OR many comments
  AND (QP.Tags LIKE '%<sql>%' OR QP.Tags LIKE '%<database>%' OR QP.Tags LIKE '%<performance>%') -- Tags related to SQL, database or performance
  AND QP.EditCount >= 1 -- Ensure questions have been edited at least once
  AND UE.LatestPostDate IS NOT NULL -- Ensure user has at least one post
  -- Final complex predicate: User has a silver badge AND their last access date is recent, AND question has a high engagement ratio
  AND (COALESCE(BS.SilverBadges, 0) > 0 AND UE.LastAccessDate >= cast('2024-10-01' as date) - INTERVAL '3 months' AND (QP.BaseEngagementMetric * 1.0 / NULLIF(QP.ViewCount, 0)) > 0.01)
  -- Exclude questions that were closed as duplicates and have no accepted answer
  AND NOT (DCS.CurrentCloseStatus = 'Closed' AND DCS.DuplicatesLinked IS NOT NULL AND QP.AcceptedAnswerId IS NULL)
ORDER BY UE.Reputation DESC, QP.BaseEngagementMetric DESC, QP.QuestionCreationDate DESC
LIMIT 500;