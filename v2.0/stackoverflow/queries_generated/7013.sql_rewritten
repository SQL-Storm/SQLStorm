WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.Reputation,
        u.DisplayName,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as AnswerCount,
        COALESCE(SUM(p.Score), 0) as TotalScore,
        COALESCE(SUM(p.ViewCount), 0) as TotalViews,
        MAX(p.CreationDate) as LatestPostDate,
        RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        RANK() OVER (ORDER BY SUM(p.Score) DESC) as ScoreRank,
        RANK() OVER (ORDER BY u.Reputation DESC) as RepRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.Views, u.UpVotes, u.DownVotes
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        PostCount,
        QuestionCount,
        AnswerCount,
        TotalScore,
        TotalViews,
        LatestPostDate,
        PostRank,
        ScoreRank,
        RepRank,
        CASE 
            WHEN RepRank <= 100 THEN 'Elite'
            WHEN RepRank <= 1000 THEN 'Veteran'
            WHEN RepRank <= 10000 THEN 'Regular'
            ELSE 'Newbie'
        END as UserTier,
        CASE 
            WHEN PostCount > 100 AND TotalScore > 10000 THEN 'HighlyActive'
            WHEN PostCount > 50 AND TotalScore > 5000 THEN 'Active'
            WHEN PostCount > 10 THEN 'Contributor'
            ELSE 'Casual'
        END as ActivityLevel
    FROM UserStats
    WHERE PostCount > 0
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        DATEDIFF(DAY, p.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) as AgeInDays,
        p.Score * (p.ViewCount + 1) as ScoreViewRatio,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            WHEN p.PostTypeId = 5 THEN 'TagWiki'
            ELSE 'Other'
        END as PostType,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PreviousScore,
        LEAD(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as NextScore,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) as AvgScorePerUser,
        NTILE(4) OVER (ORDER BY p.Score DESC) as ScoreQuartile,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PostNumberPerUser
    FROM Posts p
    WHERE p.CreationDate >= DATEADD(YEAR, -2, cast('2024-10-01 12:34:56' as timestamp))
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count as TagCount,
        t.ExcerptPostId,
        t.WikiPostId,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as RankByPopularity,
        LAG(t.Count, 1) OVER (ORDER BY t.Count DESC) - t.Count as PopularityChange,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 100 THEN 'Common'
            WHEN t.Count > 10 THEN 'Moderate'
            ELSE 'Niche'
        END as TagCategory
    FROM Tags t
    WHERE t.Count > 0
),
CombinedAnalysis AS (
    SELECT 
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.PostCount,
        tu.QuestionCount,
        tu.AnswerCount,
        tu.TotalScore,
        tu.TotalViews,
        tu.UserTier,
        tu.ActivityLevel,
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount as PostAnswerCount,
        pa.CommentCount,
        pa.CreationDate as PostCreationDate,
        pa.PostType,
        pa.AgeInDays,
        pa.ScoreViewRatio,
        pa.ScoreQuartile,
        ta.TagName,
        ta.TagCount,
        ta.RankByPopularity,
        ta.TagCategory,
        CASE 
            WHEN pa.Score > 100 THEN 'HighlyVoted'
            WHEN pa.Score > 50 THEN 'WellVoted'
            WHEN pa.Score > 10 THEN 'ModeratelyVoted'
            ELSE 'LowVoted'
        END as VoteClassification,
        CASE 
            WHEN pa.ViewCount > 10000 THEN 'Viral'
            WHEN pa.ViewCount > 5000 THEN 'Popular'
            WHEN pa.ViewCount > 1000 THEN 'Notable'
            ELSE 'Regular'
        END as ViewClassification,
        CASE 
            WHEN pa.AgeInDays < 7 THEN 'Fresh'
            WHEN pa.AgeInDays < 30 THEN 'Recent'
            WHEN pa.AgeInDays < 365 THEN 'Old'
            ELSE 'Ancient'
        END as AgeClassification,
        CASE 
            WHEN pa.PostNumberPerUser <= 3 THEN 'Early'
            WHEN pa.PostNumberPerUser <= 10 THEN 'Middle'
            ELSE 'Late'
        END as PostingPhase
    FROM TopUsers tu
    INNER JOIN PostAnalysis pa ON tu.UserId = pa.OwnerUserId
    LEFT JOIN TagAnalysis ta ON pa.Tags LIKE '%' + ta.TagName + '%'
    WHERE EXISTS (
        SELECT 1 
        FROM Posts p 
        WHERE p.OwnerUserId = tu.UserId 
        AND p.CreationDate >= DATEADD(MONTH, -6, cast('2024-10-01 12:34:56' as timestamp))
    )
)
SELECT 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.PostCount,
    ca.QuestionCount,
    ca.AnswerCount,
    ca.TotalScore,
    ca.TotalViews,
    ca.UserTier,
    ca.ActivityLevel,
    ca.PostId,
    ca.Title,
    ca.Score,
    ca.ViewCount,
    ca.PostAnswerCount,
    ca.CommentCount,
    ca.PostCreationDate,
    ca.PostType,
    ca.AgeInDays,
    ca.ScoreViewRatio,
    ca.ScoreQuartile,
    ca.TagName,
    ca.TagCount,
    ca.RankByPopularity,
    ca.TagCategory,
    ca.VoteClassification,
    ca.ViewClassification,
    ca.AgeClassification,
    ca.PostingPhase,
    CASE 
        WHEN ca.Reputation > 10000 AND ca.TotalScore > 5000 THEN 'HallOfFame'
        WHEN ca.Reputation > 5000 AND ca.TotalScore > 2000 THEN 'Respected'
        WHEN ca.Reputation > 1000 AND ca.TotalScore > 500 THEN 'Respectable'
        ELSE 'Standard'
    END as RecognitionLevel,
    DATEDIFF(DAY, ca.PostCreationDate, cast('2024-10-01 12:34:56' as timestamp)) as DaysSincePosting,
    CASE 
        WHEN ca.PostType = 'Question' AND ca.AnswerCount > 5 THEN 'WellAnswered'
        WHEN ca.PostType = 'Question' AND ca.AnswerCount = 0 THEN 'Unanswered'
        WHEN ca.PostType = 'Answer' AND ca.Score > 50 THEN 'HighQualityAnswer'
        ELSE 'Standard'
    END as PostQuality,
    CASE 
        WHEN ca.ScoreQuartile = 1 AND ca.ViewClassification = 'Viral' THEN 'EliteViral'
        WHEN ca.ScoreQuartile <= 2 AND ca.ViewClassification IN ('Popular', 'Viral') THEN 'HighProfile'
        WHEN ca.ScoreQuartile <= 3 AND ca.ViewClassification = 'Notable' THEN 'Notable'
        ELSE 'Ordinary'
    END as PerformanceCategory,
    COALESCE(STRING_AGG(DISTINCT ca.TagName, ', '), 'No Tags') as AllTags,
    COUNT(*) OVER () as TotalRecords,
    ROW_NUMBER() OVER (ORDER BY ca.Score DESC, ca.ViewCount DESC) as GlobalRank,
    PERCENT_RANK() OVER (ORDER BY ca.Score DESC) as ScorePercentile,
    RANK() OVER (PARTITION BY ca.UserTier ORDER BY ca.Score DESC) as TierRank,
    DENSE_RANK() OVER (ORDER BY ca.Reputation DESC) as ReputationRank,
    CASE 
        WHEN ca.PostingPhase = 'Early' AND ca.ScoreQuartile <= 2 THEN 'EarlyRisingStar'
        WHEN ca.PostingPhase = 'Middle' AND ca.ScoreQuartile = 1 THEN 'MidTierElite'
        WHEN ca.PostingPhase = 'Late' AND ca.ScoreQuartile <= 3 THEN 'LateButGreat'
        ELSE 'StandardContributor'
    END as ContributionStyle,
    CASE 
        WHEN ca.Reputation > 10000 AND ca.PostCount >= 50 THEN 'VeteranContributor'
        WHEN ca.Reputation > 5000 AND ca.PostCount >= 20 THEN 'ExperiencedContributor'
        WHEN ca.Reputation > 1000 AND ca.PostCount >= 5 THEN 'ActiveContributor'
        ELSE 'NewContributor'
    END as ContributorStatus,
    IIF(ca.Reputation > 10000 AND ca.PostCount > 100, 1, 0) as EliteContributorFlag,
    IIF(ca.ViewClassification IN ('Viral', 'Popular') AND ca.Score > 20, 1, 0) as HighImpactFlag,
    IIF(ca.AgeClassification = 'Fresh', 1, 0) as RecentPostFlag,
    IIF(ca.TagCategory = 'Popular', 1, 0) as PopularTagFlag,
    CASE 
        WHEN ca.PostType = 'Question' AND ca.AnswerCount = 0 THEN 'NeedsAttention'
        WHEN ca.PostType = 'Question' AND ca.Score < 0 THEN 'QuestionInTrouble'
        ELSE 'Healthy'
    END as PostStatus
FROM CombinedAnalysis ca
WHERE ca.Reputation > 5000
    AND ca.PostId IS NOT NULL
    AND ca.PostType IN ('Question', 'Answer')
    AND (
        ca.TagName IS NOT NULL 
        OR ca.VoteClassification IN ('HighlyVoted', 'WellVoted')
        OR ca.ViewClassification IN ('Viral', 'Popular')
    )
    AND NOT (ca.PostType = 'Question' AND ca.AnswerCount = 0 AND ca.Score <= 0)
GROUP BY 
    ca.UserId, ca.DisplayName, ca.Reputation, ca.PostCount, ca.QuestionCount, 
    ca.AnswerCount, ca.TotalScore, ca.TotalViews, ca.UserTier, ca.ActivityLevel,
    ca.PostId, ca.Title, ca.Score, ca.ViewCount, ca.PostAnswerCount, ca.CommentCount,
    ca.PostCreationDate, ca.PostType, ca.AgeInDays, ca.ScoreViewRatio, ca.ScoreQuartile,
    ca.TagName, ca.TagCount, ca.RankByPopularity, ca.TagCategory, ca.VoteClassification,
    ca.ViewClassification, ca.AgeClassification, ca.PostingPhase
HAVING 
    COUNT(*) > 0
    AND MAX(ca.Score) > 0
    AND (SUM(ca.ViewCount) > 0 OR SUM(ca.Score) > 0)
ORDER BY 
    ca.Score DESC,
    ca.ViewCount DESC,
    ca.Reputation DESC,
    ca.PostCreationDate DESC
OPTION (MAXDOP 4);