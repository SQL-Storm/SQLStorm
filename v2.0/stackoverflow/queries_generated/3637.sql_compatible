WITH 
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0) AS NetVotes,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount
    FROM Users u
),
TagQuestions AS (
    SELECT 
        p.Id                                   AS QuestionId,
        unnest(string_to_array(trim(both '<>' FROM p.Tags), '><')) AS Tag,
        p.Score,
        p.CreationDate,
        p.OwnerUserId
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.Tags IS NOT NULL
),
UserTagStats AS (
    SELECT 
        us.Id                               AS UserId,
        us.DisplayName,
        us.Reputation,
        us.GoldBadges,
        us.SilverBadges,
        us.BronzeBadges,
        t.Tag,
        COUNT(DISTINCT tq.QuestionId) 
            FILTER (WHERE tq.OwnerUserId = us.Id)                     AS OwnQuestions,
        COUNT(DISTINCT a.Id) 
            FILTER (WHERE a.OwnerUserId = us.Id)                     AS AnsweredQuestions,
        COALESCE(SUM(tq.Score) 
            FILTER (WHERE a.OwnerUserId = us.Id),0)                  AS AnsweredScore,
        ROW_NUMBER() OVER (PARTITION BY t.Tag 
                           ORDER BY us.Reputation DESC,
                                    us.GoldBadges DESC,
                                    us.SilverBadges DESC)      AS TagRank
    FROM UserStats us
    LEFT JOIN TagQuestions t      ON TRUE
    LEFT JOIN TagQuestions tq    ON tq.Tag = t.Tag
    LEFT JOIN Posts a            ON a.ParentId = tq.QuestionId 
                                    AND a.PostTypeId = 2
    WHERE (tq.OwnerUserId = us.Id)
       OR (a.OwnerUserId = us.Id)
    GROUP BY us.Id, us.DisplayName, us.Reputation,
             us.GoldBadges, us.SilverBadges, us.BronzeBadges,
             t.Tag
),
TopTagUsers AS (
    SELECT *
    FROM UserTagStats
    WHERE TagRank <= 5
),
InactiveUsers AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        0 AS GoldBadges,
        0 AS SilverBadges,
        0 AS BronzeBadges,
        CAST(NULL AS VARCHAR(35)) AS Tag,
        0 AS OwnQuestions,
        0 AS AnsweredQuestions,
        0 AS AnsweredScore,
        CAST(NULL AS INTEGER) AS TagRank
    FROM Users u
    WHERE NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id)
      AND NOT EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = u.Id)
)
SELECT *
FROM TopTagUsers
UNION ALL
SELECT *
FROM InactiveUsers
ORDER BY 
    Tag NULLS FIRST,
    TagRank NULLS LAST,
    Reputation DESC;