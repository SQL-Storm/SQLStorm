WITH RECURSIVE UserEngagement AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN pt.Name = 'Question' THEN 1 ELSE 0 END) AS QuestionCount,
    SUM(CASE WHEN pt.Name = 'Answer' THEN 1 ELSE 0 END) AS AnswerCount,
    COUNT(DISTINCT c.Id) AS CommentCount,
    COUNT(DISTINCT v.Id) FILTER (WHERE vt.Name = 'UpMod') AS UpVoteCount,
    COUNT(DISTINCT v.Id) FILTER (WHERE vt.Name = 'DownMod') AS DownVoteCount,
    COUNT(DISTINCT b.Id) AS BadgeCount,
    MAX(p.LastActivityDate) AS LastActivePostDate,
    MAX(u.LastAccessDate) AS LastSiteAccessDate
  FROM Users AS u
  LEFT JOIN Posts AS p
    ON u.Id = p.OwnerUserId
  LEFT JOIN PostTypes AS pt
    ON p.PostTypeId = pt.Id
  LEFT JOIN Comments AS c
    ON u.Id = c.UserId
  LEFT JOIN Votes AS v
    ON u.Id = v.UserId
  LEFT JOIN VoteTypes AS vt
    ON v.VoteTypeId = vt.Id
  LEFT JOIN Badges AS b
    ON u.Id = b.UserId
  GROUP BY
    u.Id,
    u.DisplayName,
    u.Reputation
), PostMetrics AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    pt.Name AS PostType,
    p.OwnerUserId,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS PostRankForUser,
    LEAD(p.Score, 1, 0) OVER (ORDER BY p.CreationDate) AS NextPostScore,
    LAG(p.Score, 1, 0) OVER (ORDER BY p.CreationDate) AS PreviousPostScore,
    CASE
      WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
      WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
      ELSE 'Active'
    END AS PostStatus
  FROM Posts AS p
  JOIN PostTypes AS pt
    ON p.PostTypeId = pt.Id
  WHERE
    p.OwnerUserId IS NOT NULL AND p.OwnerUserId <> -1
), UserPostPerformance AS (
  SELECT
    ue.UserId,
    ue.DisplayName,
    ue.Reputation,
    ue.TotalPosts,
    ue.QuestionCount,
    ue.AnswerCount,
    ue.CommentCount,
    ue.UpVoteCount,
    ue.DownVoteCount,
    ue.BadgeCount,
    ue.LastActivePostDate,
    ue.LastSiteAccessDate,
    AVG(pm.Score) AS AveragePostScore,
    SUM(pm.ViewCount) AS TotalPostViews,
    COUNT(CASE WHEN pm.PostRankForUser <= 5 THEN 1 END) AS Top5PostCount,
    SUM(CASE WHEN pm.PostStatus = 'Closed' THEN 1 ELSE 0 END) AS ClosedPostCount,
    COUNT(pl.PostId) AS LinkedPosts
  FROM UserEngagement AS ue
  LEFT JOIN PostMetrics AS pm
    ON ue.UserId = pm.OwnerUserId
  LEFT JOIN PostLinks AS pl
    ON pl.PostId = pm.PostId
  GROUP BY
    ue.UserId,
    ue.DisplayName,
    ue.Reputation,
    ue.TotalPosts,
    ue.QuestionCount,
    ue.AnswerCount,
    ue.CommentCount,
    ue.UpVoteCount,
    ue.DownVoteCount,
    ue.BadgeCount,
    ue.LastActivePostDate,
    ue.LastSiteAccessDate
), UserActivitySummary AS (
  SELECT
    upp.UserId,
    upp.DisplayName,
    upp.Reputation,
    upp.TotalPosts,
    upp.QuestionCount,
    upp.AnswerCount,
    upp.CommentCount,
    upp.UpVoteCount,
    upp.DownVoteCount,
    upp.BadgeCount,
    upp.AveragePostScore,
    upp.TotalPostViews,
    upp.Top5PostCount,
    upp.ClosedPostCount,
    upp.LinkedPosts,
    CASE
      WHEN upp.Reputation > 100000 THEN 'Legendary'
      WHEN upp.Reputation > 50000 THEN 'High'
      WHEN upp.Reputation > 10000 THEN 'Medium'
      ELSE 'Low'
    END AS ReputationTier,
    CAST(
      (EXTRACT(EPOCH FROM TIMESTAMP '2024-10-01 12:34:56') - EXTRACT(EPOCH FROM COALESCE(upp.LastSiteAccessDate::timestamp, TIMESTAMP '1970-01-01 00:00:00')))/86400
      AS INTEGER
    ) AS DaysSinceLastAccess,
    CASE WHEN upp.TotalPosts > 0 THEN CAST(upp.UpVoteCount AS DOUBLE PRECISION) / upp.TotalPosts ELSE 0 END AS UpvotePerPostRatio,
    CASE
      WHEN upp.LastActivePostDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year') THEN 'Active'
      ELSE 'Inactive'
    END AS ActivityStatus,
    (SELECT COUNT(*) FROM Badges AS b WHERE b.UserId = upp.UserId AND b.Class = 1) AS GoldBadgeCount,
    (SELECT COUNT(*) FROM Badges AS b WHERE b.UserId = upp.UserId AND b.Class = 2) AS SilverBadgeCount,
    (SELECT COUNT(*) FROM Badges AS b WHERE b.UserId = upp.UserId AND b.Class = 3) AS BronzeBadgeCount
  FROM UserPostPerformance AS upp
  WHERE
    upp.TotalPosts > 10
), QuestionPerformance AS (
  SELECT
    p.Id AS QuestionId,
    p.Title AS QuestionTitle,
    p.OwnerUserId,
    COUNT(CASE WHEN c.CreationDate > p.CreationDate THEN 1 END) AS CommentCountAfterCreation,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownvotes,
    AVG(a.Score) AS AverageAnswerScore,
    COUNT(a.Id) AS AnswerCount,
    MAX(a.CreationDate) AS LastAnswerDate,
    p.Score AS QuestionScore
  FROM Posts AS p
  LEFT JOIN Comments AS c
    ON p.Id = c.PostId
  LEFT JOIN Votes AS v
    ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
  LEFT JOIN Posts AS a
    ON p.Id = a.ParentId
  WHERE
    p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL AND p.OwnerUserId <> -1
  GROUP BY
    p.Id,
    p.Title,
    p.OwnerUserId,
    p.Score
), TagPopularity AS (
  SELECT
    t.TagName,
    t.Count AS TagPostCount,
    (SELECT COUNT(*) FROM Posts AS p WHERE p.Tags LIKE '%' || t.TagName || '%') AS TotalOccurrences,
    SUM(CASE WHEN ue.Reputation > 50000 THEN 1 ELSE 0 END) AS HighReputationUsersTagging,
    AVG(ue.Reputation) AS AverageTaggingUserReputation
  FROM Tags AS t
  LEFT JOIN Posts AS p
    ON p.Tags LIKE '%' || t.TagName || '%'
  LEFT JOIN UserEngagement AS ue
    ON p.OwnerUserId = ue.UserId
  WHERE
    t.TagName IS NOT NULL
  GROUP BY
    t.TagName,
    t.Count
), PerformanceSummary AS (
  SELECT
    uas.UserId,
    uas.DisplayName,
    uas.Reputation,
    uas.ReputationTier,
    uas.DaysSinceLastAccess,
    uas.ActivityStatus,
    uas.GoldBadgeCount,
    uas.SilverBadgeCount,
    uas.BronzeBadgeCount,
    qp.QuestionScore AS TopQuestionScore,
    qp.AverageAnswerScore AS AvgAnswerScoreForTopQuestion,
    tp.TagName AS MostPopularTag,
    tp.TagPostCount AS MostPopularTagCount,
    CASE
      WHEN uas.AveragePostScore > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Above Average Question Score'
      ELSE 'Below Average Question Score'
    END AS QuestionScoreComparison,
    (uas.DisplayName || ' has ' || CAST(uas.TotalPosts AS VARCHAR) || ' posts and ' || CAST(uas.BadgeCount AS VARCHAR) || ' badges.') AS UserSummaryString,
    COALESCE(uas.UpVoteCount, 0) + COALESCE(uas.DownVoteCount, 0) AS TotalVotesReceived,
    CASE
      WHEN uas.TotalPosts BETWEEN 10 AND 100 THEN 'Moderate Activity'
      WHEN uas.TotalPosts > 100 THEN 'High Activity'
      ELSE 'Low Activity'
    END AS ActivityLevel
  FROM UserActivitySummary AS uas
  LEFT JOIN QuestionPerformance AS qp
    ON uas.UserId = qp.OwnerUserId
  LEFT JOIN TagPopularity AS tp
    ON tp.TagName = (
      SELECT TagName
      FROM TagPopularity
      ORDER BY TagPostCount DESC
      LIMIT 1
    )
  WHERE
    uas.TotalPosts > 5
  ORDER BY
    uas.Reputation DESC,
    uas.TotalPosts DESC
)
SELECT
  ps.UserId,
  ps.DisplayName,
  ps.Reputation,
  ps.ReputationTier,
  ps.DaysSinceLastAccess,
  ps.ActivityStatus,
  ps.GoldBadgeCount,
  ps.SilverBadgeCount,
  ps.BronzeBadgeCount,
  ps.TopQuestionScore,
  ps.AvgAnswerScoreForTopQuestion,
  ps.MostPopularTag,
  ps.MostPopularTagCount,
  ps.QuestionScoreComparison,
  ps.UserSummaryString,
  ps.TotalVotesReceived,
  ps.ActivityLevel,
  (
    SELECT
      COUNT(DISTINCT p.Id)
    FROM Posts AS p
    WHERE
      p.OwnerUserId = ps.UserId AND p.ClosedDate IS NOT NULL
  ) AS UserClosedPostCount,
  UPPER(SUBSTR(ps.DisplayName, 1, 3)) AS DisplayNamePrefix,
  CASE
    WHEN ps.AvgAnswerScoreForTopQuestion IS NULL THEN 0
    WHEN ps.AvgAnswerScoreForTopQuestion > 50 THEN 100
    WHEN ps.AvgAnswerScoreForTopQuestion > 20 THEN 75
    WHEN ps.AvgAnswerScoreForTopQuestion > 5 THEN 50
    ELSE 25
  END AS AnswerQualityScore,
  (ps.UserId % 10) AS UserIdModulo10
FROM PerformanceSummary AS ps
WHERE
  ps.DaysSinceLastAccess < 365
  AND ps.TotalVotesReceived > 100
UNION ALL
SELECT
  -1 AS UserId,
  'Aggregate' AS DisplayName,
  AVG(Reputation) AS Reputation,
  'Overall' AS ReputationTier,
  AVG(DaysSinceLastAccess) AS DaysSinceLastAccess,
  'Mixed' AS ActivityStatus,
  AVG(GoldBadgeCount) AS GoldBadgeCount,
  AVG(SilverBadgeCount) AS SilverBadgeCount,
  AVG(BronzeBadgeCount) AS BronzeBadgeCount,
  AVG(TopQuestionScore) AS TopQuestionScore,
  AVG(AvgAnswerScoreForTopQuestion) AS AvgAnswerScoreForTopQuestion,
  NULL AS MostPopularTag,
  AVG(MostPopularTagCount) AS MostPopularTagCount,
  'N/A' AS QuestionScoreComparison,
  'Aggregated Performance Metrics' AS UserSummaryString,
  AVG(TotalVotesReceived) AS TotalVotesReceived,
  'Overall' AS ActivityLevel,
  (
    SELECT
      COUNT(*)
    FROM Posts
    WHERE
      ClosedDate IS NOT NULL
  ) AS UserClosedPostCount,
  'AGG' AS DisplayNamePrefix,
  AVG(CASE
    WHEN AvgAnswerScoreForTopQuestion IS NULL THEN 0
    WHEN AvgAnswerScoreForTopQuestion > 50 THEN 100
    WHEN AvgAnswerScoreForTopQuestion > 20 THEN 75
    WHEN AvgAnswerScoreForTopQuestion > 5 THEN 50
    ELSE 25
  END) AS AnswerQualityScore,
  NULL AS UserIdModulo10
FROM PerformanceSummary
WHERE
  DaysSinceLastAccess < 365 AND TotalVotesReceived > 100;