-- {"query": "2276.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1276} 
with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        t.ExcerptPostId,
        t.WikiPostId,
        1 as Level,
        array[t.Id] as Path
    from Tags t
    where t.IsModeratorOnly = 0 and t.IsRequired = 0

    union all

    select
        t.Id,
        t.TagName,
        t.ExcerptPostId,
        t.WikiPostId,
        r.Level + 1,
        r.Path || t.Id
    from Tags t
    join RecursiveTagHierarchy r on array_position(r.Path, t.Id) is null and t.Id > r.Id
    where t.IsModeratorOnly = 0 and t.IsRequired = 0 and r.Level < 3
),
UserActivitySummary as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(distinct c.Id) as CommentCount,
        count(distinct b.Id) as BadgeCount,
        coalesce(sum(vb.VoteCount),0) as TotalVotesReceived,
        coalesce(sum(v.TotalVotesGiven),0) as TotalVotesGiven
    from Users u
    left join Posts p on p.OwnerUserId = u.Id and p.CreationDate > date_trunc('year', cast('2024-10-01 12:34:56' as timestamp)) - interval '3 years'
    left join Comments c on c.UserId = u.Id
    left join Badges b on b.UserId = u.Id
    left join (
        select
            p.OwnerUserId,
            count(*) as VoteCount
        from Votes v
        join Posts p on v.PostId = p.Id
        group by p.OwnerUserId
    ) vb on vb.OwnerUserId = u.Id
    left join (
        select UserId, count(*) as TotalVotesGiven
        from Votes 
        where UserId is not null
        group by UserId
    ) v on v.UserId = u.Id
    group by u.Id, u.DisplayName
),
TopPostsAndComments as (
    select
        p.Id,
        p.PostTypeId,
        p.Title,
        p.Body,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        u.DisplayName as OwnerName,
        p.AcceptedAnswerId,
        p.Tags,
        string_agg(c.Text, ' | ' order by c.CreationDate) as CommentTexts,
        count(c.Id) as CommentCount,
        first_value(v.VoteTypeId) over (partition by p.Id order by v.CreationDate desc nulls last) as LastVoteTypeId
    from Posts p
    left join Comments c on c.PostId = p.Id
    left join Votes v on v.PostId = p.Id
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId in (1,2)
    group by p.Id, p.PostTypeId, p.Title, p.Body, p.CreationDate, p.Score, p.ViewCount, p.OwnerUserId, u.DisplayName, p.AcceptedAnswerId, p.Tags
),
PostLinkDuplicates as (
    select 
        pl.PostId,
        pl.RelatedPostId,
        pl.LinkTypeId,
        p1.Score as PostScore,
        p2.Score as RelatedPostScore
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where pl.LinkTypeId = 3 -- duplicates
),
CloseReasonCounts as (
    select
        p.Id as PostId,
        crt.Name as CloseReason,
        count(ph.Id) as CloseVotesCount
    from Posts p
    left join PostHistory ph on ph.PostId = p.Id and ph.PostHistoryTypeId = 10
    left join CloseReasonTypes crt on crt.Id = ph.Comment::int
    group by p.Id, crt.Name
),
UserReputationCase as (
    select 
        Id,
        DisplayName,
        Reputation,
        case 
            when Reputation >= 100000 then 'Legendary'
            when Reputation >= 25000 then 'Expert'
            when Reputation >= 5000 then 'Proficient'
            when Reputation >= 1000 then 'Intermediate'
            else 'Newbie'
        end as ReputationLevel
    from Users
)
select distinct
    u.DisplayName,
    u.ReputationLevel,
    u.Reputation,
    ua.QuestionCount,
    ua.AnswerCount,
    ua.CommentCount,
    ua.BadgeCount,
    ua.TotalVotesReceived,
    ua.TotalVotesGiven,
    p.Id as PostId,
    p.PostTypeId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CommentCount,
    p.CommentTexts,
    p.LastVoteTypeId,
    cr.CloseReason,
    cr.CloseVotesCount,
    pl.RelatedPostId as DuplicateOfPostId,
    pl.RelatedPostScore,
    th.Level as TagDepth,
    th.TagName as RelatedTag
from UserReputationCase u
join UserActivitySummary ua on ua.UserId = u.Id
left join TopPostsAndComments p on p.OwnerUserId = u.Id
left join CloseReasonCounts cr on cr.PostId = p.Id
left join PostLinkDuplicates pl on pl.PostId = p.Id
left join RecursiveTagHierarchy th on th.TagName = any(string_to_array(coalesce(p.Tags,''), '><'))
where
    (ua.QuestionCount > 10 or ua.AnswerCount > 20)
    and (p.Score > 50 or p.ViewCount > 1000 or cr.CloseVotesCount > 2)
    and (u.ReputationLevel in ('Legendary','Expert','Proficient'))
order by u.Reputation desc, p.Score desc, p.ViewCount desc
limit 100;