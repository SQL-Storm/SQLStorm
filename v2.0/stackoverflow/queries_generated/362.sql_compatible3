with recent_users as (
    select
        u.id as user_id,
        u.displayname,
        u.reputation,
        u.creationdate,
        u.location,
        coalesce(nullif(trim(split_part(coalesce(u.websiteurl, ''), '//', 2)), ''), 'n/a') as website_host,
        row_number() over (order by u.creationdate desc, u.id) as rn
    from users u
    where u.creationdate >= (select date_trunc('month', max(creationdate)) - interval '18 months' from users)
),
user_activity as (
    select
        p.owneruserid as user_id,
        count(case when p.posttypeid = 1 then 1 end) as q_count,
        count(case when p.posttypeid = 2 then 1 end) as a_count,
        sum(coalesce(p.score,0)) as total_post_score,
        sum(case when p.posttypeid = 1 then coalesce(p.viewcount,0) else 0 end) as total_views,
        max(p.lastactivitydate) as last_post_activity,
        count(case when p.closeddate is not null then 1 end) as closed_posts
    from posts p
    where p.owneruserid is not null
    group by p.owneruserid
),
user_comments as (
    select
        c.userid as user_id,
        count(*) as comment_count,
        sum(coalesce(c.score,0)) as comment_score,
        max(c.creationdate) as last_comment_date
    from comments c
    where c.userid is not null
    group by c.userid
),
user_badges as (
    select
        b.userid as user_id,
        count(*) as badge_count,
        count(case when b.class = 1 then 1 end) as gold_badges,
        count(case when b.class = 2 then 1 end) as silver_badges,
        count(case when b.class = 3 then 1 end) as bronze_badges,
        max(b.date) as last_badge_date
    from badges b
    group by b.userid
),
accept_rate as (
    select
        a.owneruserid as user_id,
        avg(case when q.acceptedanswerid = a.id then 1.0 else 0.0 end) as answer_accept_rate
    from posts a
    join posts q on q.id = a.parentid and a.posttypeid = 2 and q.posttypeid = 1
    group by a.owneruserid
),
vote_summary as (
    select
        v.userid as user_id,
        count(case when v.votetypeid = 2 then 1 end) as upvotes_cast,
        count(case when v.votetypeid = 3 then 1 end) as downvotes_cast,
        count(case when v.votetypeid in (8,9) then 1 end) as bounties_involved,
        sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounty_amount_total,
        max(v.creationdate) as last_vote_date
    from votes v
    where v.userid is not null
    group by v.userid
),
question_metrics as (
    select
        p.owneruserid as user_id,
        count(*) as questions_total,
        avg(coalesce(p.score,0)) as avg_q_score,
        percentile_cont(0.5) within group (order by coalesce(p.viewcount,0)) as median_q_views,
        count(case when p.answercount > 0 then 1 end) as questions_with_answers,
        count(case when p.closeddate is not null then 1 end) as questions_closed,
        sum(case when p.tags ilike '%<sql>%' then 1 else 0 end) as sql_tagged_q
    from posts p
    where p.posttypeid = 1 and p.owneruserid is not null
    group by p.owneruserid
),
answer_metrics as (
    select
        p.owneruserid as user_id,
        count(*) as answers_total,
        avg(coalesce(p.score,0)) as avg_a_score,
        percentile_cont(0.9) within group (order by coalesce(p.score,0)) as p90_a_score,
        count(case when p.score > 0 then 1 end) as positive_answers
    from posts p
    where p.posttypeid = 2 and p.owneruserid is not null
    group by p.owneruserid
),
link_dupes as (
    select
        pl.postid as post_id,
        max(case when pl.linktypeid = 3 then 1 else 0 end) as is_marked_duplicate
    from postlinks pl
    group by pl.postid
),
post_edit_stats as (
    select
        ph.postid,
        count(case when ph.posthistorytypeid in (4,5,6) then 1 end) as edit_count,
        max(ph.creationdate) as last_edit_date
    from posthistory ph
    group by ph.postid
),
user_post_rollup as (
    select
        p.owneruserid as user_id,
        count(*) as total_posts,
        sum(case when coalesce(l.is_marked_duplicate,0) = 1 then 1 else 0 end) as dup_flagged_posts,
        avg(coalesce(ps.edit_count,0)) as avg_edits_per_post,
        max(ps.last_edit_date) as last_edit_date_any
    from posts p
    left join link_dupes l on l.post_id = p.id
    left join post_edit_stats ps on ps.postid = p.id
    where p.owneruserid is not null
    group by p.owneruserid
),
activity_windows as (
    select
        p.owneruserid as user_id,
        p.id as post_id,
        p.posttypeid,
        p.creationdate,
        coalesce(p.score,0) as score,
        row_number() over (partition by p.owneruserid order by p.creationdate desc, p.id desc) as rn_desc,
        sum(coalesce(p.score,0)) over (partition by p.owneruserid order by p.creationdate
            rows between unbounded preceding and current row) as cum_score,
        avg(coalesce(p.score,0)) over (partition by p.owneruserid
            rows between 10 preceding and current row) as mov_avg_score_11
    from posts p
    where p.owneruserid is not null
),
latest_activities as (
    select
        aw.user_id,
        max(aw.creationdate) as latest_post_date,
        max(case when aw.rn_desc = 1 then aw.score else null end) as latest_post_score,
        count(case when aw.posttypeid = 1 and aw.creationdate >= (timestamp '2024-10-01 12:34:56' - interval '30 days') then 1 end) as q_30d,
        count(case when aw.posttypeid = 2 and aw.creationdate >= (timestamp '2024-10-01 12:34:56' - interval '30 days') then 1 end) as a_30d
    from activity_windows aw
    group by aw.user_id
),
tag_preference as (
    select
        p.owneruserid as user_id,
        array_agg(distinct t.tag) as distinct_tags,
        count(case when p.tags ilike '%<performance>%' then 1 end) as perf_tag_hits
    from posts p
    left join lateral (
        select unnest(string_to_array(substring(p.tags, 2, greatest(length(p.tags)-2,0)), '><')) as tag
    ) t on true
    where p.posttypeid = 1 and p.owneruserid is not null and p.tags is not null
    group by p.owneruserid
),
ranked_users as (
    select
        ru.user_id,
        ru.displayname,
        ru.reputation,
        ru.creationdate,
        ru.location,
        ru.website_host,
        ua.q_count, ua.a_count, ua.total_post_score, ua.total_views, ua.last_post_activity, ua.closed_posts,
        uc.comment_count, uc.comment_score, uc.last_comment_date,
        ub.badge_count, ub.gold_badges, ub.silver_badges, ub.bronze_badges, ub.last_badge_date,
        coalesce(ar.answer_accept_rate,0.0) as answer_accept_rate,
        vs.upvotes_cast, vs.downvotes_cast, vs.bounties_involved, vs.bounty_amount_total, vs.last_vote_date,
        qm.questions_total, qm.avg_q_score, qm.median_q_views, qm.questions_with_answers, qm.questions_closed, qm.sql_tagged_q,
        am.answers_total, am.avg_a_score, am.p90_a_score, am.positive_answers,
        upr.total_posts, upr.dup_flagged_posts, upr.avg_edits_per_post, upr.last_edit_date_any,
        la.latest_post_date, la.latest_post_score, la.q_30d, la.a_30d,
        tp.distinct_tags, tp.perf_tag_hits,
        case when coalesce(ua.total_post_score,0) + coalesce(uc.comment_score,0) > 0 then 1 else 0 end as has_positive_impact,
        row_number() over (
            order by
                coalesce(ua.total_post_score,0) + coalesce(uc.comment_score,0) desc,
                coalesce(ub.badge_count,0) desc,
                coalesce(vs.upvotes_cast,0) desc,
                ru.reputation desc,
                ru.user_id
        ) as activity_rank
    from recent_users ru
    left join user_activity ua on ua.user_id = ru.user_id
    left join user_comments uc on uc.user_id = ru.user_id
    left join user_badges ub on ub.user_id = ru.user_id
    left join accept_rate ar on ar.user_id = ru.user_id
    left join vote_summary vs on vs.user_id = ru.user_id
    left join question_metrics qm on qm.user_id = ru.user_id
    left join answer_metrics am on am.user_id = ru.user_id
    left join user_post_rollup upr on upr.user_id = ru.user_id
    left join latest_activities la on la.user_id = ru.user_id
    left join tag_preference tp on tp.user_id = ru.user_id
),
bench as (
    select
        r.*,
        coalesce(questions_total,0) + coalesce(answers_total,0) as qa_total,
        case
            when coalesce(answers_total,0) = 0 then null
            else round(100.0 * coalesce(positive_answers,0) / nullif(answers_total,0), 2)
        end as pct_positive_answers,
        case
            when coalesce(questions_total,0) = 0 then null
            else round(100.0 * coalesce(questions_with_answers,0) / nullif(questions_total,0), 2)
        end as pct_questions_answered,
        case
            when coalesce(total_posts,0) = 0 then 0
            else round(100.0 * coalesce(dup_flagged_posts,0) / nullif(total_posts,0), 2)
        end as pct_dup_flagged,
        greatest(
            coalesce(ub.gold_badges,0),
            coalesce(ub.silver_badges,0),
            coalesce(ub.bronze_badges,0)
        ) as max_badge_tier_count
    from ranked_users r
    left join user_badges ub on ub.user_id = r.user_id
),
norm as (
    select
        b.*,
        (coalesce(total_post_score,0) - avg(coalesce(total_post_score,0)) over ()) /
            nullif(stddev_pop(coalesce(total_post_score,0)) over (),0) as z_total_post_score,
        (coalesce(comment_score,0) - avg(coalesce(comment_score,0)) over ()) /
            nullif(stddev_pop(coalesce(comment_score,0)) over (),0) as z_comment_score,
        (coalesce(reputation,0) - avg(coalesce(reputation,0)) over ()) /
            nullif(stddev_pop(coalesce(reputation,0)) over (),0) as z_reputation
    from bench b
),
topk as (
    select
        n.*,
        dense_rank() over (order by
            coalesce(z_total_post_score,0) + coalesce(z_comment_score,0) + 0.5 * coalesce(z_reputation,0) desc
        ) as impact_rank
    from norm n
)
select
    t.user_id,
    coalesce(nullif(t.displayname,''), '(unknown)') as displayname,
    t.location,
    t.website_host,
    t.reputation,
    t.activity_rank,
    t.impact_rank,
    t.qa_total,
    t.q_count, t.a_count,
    t.avg_q_score, t.avg_a_score, t.p90_a_score,
    t.median_q_views,
    t.pct_questions_answered,
    t.pct_positive_answers,
    t.answer_accept_rate,
    t.perf_tag_hits,
    t.sql_tagged_q,
    t.dup_flagged_posts,
    t.pct_dup_flagged,
    t.badge_count, t.gold_badges, t.silver_badges, t.bronze_badges,
    t.upvotes_cast, t.downvotes_cast, t.bounties_involved, t.bounty_amount_total,
    t.total_views,
    t.latest_post_date,
    t.last_post_activity,
    greatest(coalesce(t.last_post_activity, timestamp '1970-01-01 00:00:00'), coalesce(t.last_comment_date, timestamp '1970-01-01 00:00:00'), coalesce(t.last_vote_date, timestamp '1970-01-01 00:00:00'), coalesce(t.last_badge_date, timestamp '1970-01-01 00:00:00')) as last_any_activity,
    case
        when t.has_positive_impact = 1 and coalesce(t.q_30d,0) + coalesce(t.a_30d,0) > 0 then 'ActivePositive'
        when t.has_positive_impact = 1 then 'DormantPositive'
        when coalesce(t.q_30d,0) + coalesce(t.a_30d,0) > 0 then 'ActiveNeutral'
        else 'DormantNeutral'
    end as engagement_bucket,
    coalesce(array_length(t.distinct_tags, 1),0) as distinct_tag_count,
    left(array_to_string(t.distinct_tags, ','), 200) as tags_sample
from topk t
where (
        t.activity_rank <= 200
        or t.impact_rank <= 200
        or (t.qa_total >= all (select coalesce(qa_total,0) from topk where coalesce(location,'') = coalesce(t.location,'')))
      )
  and coalesce(t.reputation,0) >= coalesce((
        select percentile_cont(0.25) within group (order by reputation) from topk
      ),0)
order by t.impact_rank nulls last, t.activity_rank, t.user_id
limit 500;