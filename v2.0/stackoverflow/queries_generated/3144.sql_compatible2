WITH UserAgg AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetVotes,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        MAX(u.LastAccessDate) AS LastSeen,
        ROW_NUMBER() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC) AS LocRank
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.UpVotes, u.DownVotes, u.LastAccessDate, u.Location
),

PostAgg AS (
    -- This version avoids DISTINCT WITHIN GROUP and :: casts, and provides a portable way to aggregate tags.
    -- It builds distinct tags per user in a derived table, then aggregates with LISTAGG (or STRING_AGG) without DISTINCT.
    -- Replace LISTAGG with STRING_AGG(tag, ',') or equivalent if needed for the target dialect.
    SELECT
        t.OwnerUserId AS UserId,
        COUNT(CASE WHEN t.PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN t.PostTypeId = 2 THEN 1 END) AS AnswerCount,
        SUM(CASE WHEN t.PostTypeId = 1 THEN t.Score ELSE 0 END) AS QuestionScoreSum,
        SUM(CASE WHEN t.PostTypeId = 2 THEN t.Score ELSE 0 END) AS AnswerScoreSum,
        MAX(t.CreationDate) AS MostRecentPost,
        LISTAGG(t.Tag, ', ') WITHIN GROUP (ORDER BY t.Tag) AS TagList
    FROM (
        -- expand posts into rows per tag
        SELECT
            p.OwnerUserId,
            p.PostTypeId,
            p.Score,
            p.CreationDate,
            TRIM(tag) AS Tag
        FROM Posts p
        CROSS JOIN LATERAL (
            -- generic regexp_substr sequence generator rewritten for portability.
            -- For databases without CONNECT BY / LEVEL / dual, replace the sequence generator with the appropriate table of numbers.
            SELECT REGEXP_SUBSTR(p.Tags, '[^><]+', 1, seq) AS tag
            FROM (
                SELECT LEVEL AS seq
                FROM (SELECT 1 FROM dual)
                CONNECT BY LEVEL <= 100
            ) seqs
            WHERE REGEXP_SUBSTR(p.Tags, '[^><]+', 1, seqs.seq) IS NOT NULL
        ) s
    ) t
    WHERE t.OwnerUserId IS NOT NULL
    GROUP BY t.OwnerUserId
),

-- To ensure distinct tag counts and avoid DISTINCT inside LISTAGG, build per-tag stats separately if needed.
TagStats AS (
    SELECT
        t.TagName,
        t.Count AS TagUseCount,
        COALESCE(e.ExcerptLength, 0) + COALESCE(w.WikiLength, 0) AS ContentSize,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS TagRank
    FROM Tags t
    LEFT JOIN LATERAL (
        SELECT LENGTH(p.Body) AS ExcerptLength
        FROM Posts p
        WHERE p.Id = t.ExcerptPostId
        FETCH FIRST 1 ROWS ONLY
    ) e ON TRUE
    LEFT JOIN LATERAL (
        SELECT LENGTH(p.Body) AS WikiLength
        FROM Posts p
        WHERE p.Id = t.WikiPostId
        FETCH FIRST 1 ROWS ONLY
    ) w ON TRUE
    WHERE t.IsModeratorOnly = 0
),

RecentVotes AS (
    SELECT
        v.PostId,
        v.VoteTypeId,
        v.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY v.PostId ORDER BY v.CreationDate DESC) AS VoteRank
    FROM Votes v
    WHERE v.VoteTypeId IN (2, 3)
),

UsersWithPosts AS (
    SELECT
        ua.Id AS UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.NetVotes,
        ua.GoldBadges,
        ua.SilverBadges,
        ua.BronzeBadges,
        COALESCE(pa.QuestionCount, 0) AS Questions,
        COALESCE(pa.AnswerCount, 0) AS Answers,
        COALESCE(pa.QuestionScoreSum, 0) AS QScore,
        COALESCE(pa.AnswerScoreSum, 0) AS AScore,
        pa.MostRecentPost,
        pa.TagList,
        CASE
            WHEN ua.LocRank = 1 THEN 'TopInLocation'
            WHEN ua.Reputation > 50000 THEN 'HighRep'
            ELSE 'Regular'
        END AS UserSegment,
        EXISTS (
            SELECT 1
            FROM Posts p
            WHERE p.OwnerUserId = ua.Id
              AND p.CreationDate > ua.LastSeen - INTERVAL '30' DAY
        ) AS RecentActivityFlag
    FROM UserAgg ua
    LEFT JOIN PostAgg pa ON pa.UserId = ua.Id
    WHERE ua.Reputation IS NOT NULL
),

UsersNoPosts AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        0 AS NetVotes,
        0 AS GoldBadges,
        0 AS SilverBadges,
        0 AS BronzeBadges,
        0 AS Questions,
        0 AS Answers,
        0 AS QScore,
        0 AS AScore,
        CAST(NULL AS TIMESTAMP) AS MostRecentPost,
        CAST(NULL AS VARCHAR(1000)) AS TagList,
        'NoPosts' AS UserSegment,
        FALSE AS RecentActivityFlag
    FROM Users u
    WHERE NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id)
      AND u.Reputation IS NOT NULL
)

SELECT *
FROM (
    SELECT *
    FROM UsersWithPosts
    ORDER BY Reputation DESC
    FETCH FIRST 100 ROWS ONLY
) a
UNION ALL
SELECT *
FROM (
    SELECT *
    FROM UsersNoPosts
    ORDER BY Reputation DESC
    FETCH FIRST 50 ROWS ONLY
) b
ORDER BY Reputation DESC;