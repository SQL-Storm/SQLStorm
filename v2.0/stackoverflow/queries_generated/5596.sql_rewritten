WITH
-- 1) Recent activity per post with windowing
RecentActivity AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.CreationDate,
    p.LastActivityDate,
    p.ViewCount,
    p.Score,
    p.OwnerUserId,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.LastActivityDate DESC) AS rn_by_user,
    COUNT(*) OVER () AS total_posts
  FROM Posts p
  WHERE p.PostTypeId = 1 -- questions
    AND p.LastActivityDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '180 days'
),
-- 2) Tag-based engagement: join tag names from Tags (assuming Tag wiki/excerpt points to tag name in Title or Tags)
TagNames AS (
  SELECT
    t.Id AS TagId,
    t.TagName,
    t.Count AS TagCount,
    t.WikiPostId,
    t.ExcerptPostId
  FROM Tags t
  WHERE t.IsModeratorOnly = 0
),
-- 3) Correlated subquery: top recent comments per post by the post owner
TopComments AS (
  SELECT
    c.PostId,
    c.Id AS CommentId,
    c.UserDisplayName,
    c.Text,
    c.CreationDate
  FROM Comments c
  JOIN (
    SELECT PostId, MAX(CreationDate) AS MaxCommentDate
    FROM Comments
    GROUP BY PostId
  ) m ON m.PostId = c.PostId AND m.MaxCommentDate = c.CreationDate
),
-- 4) Complex predicate: compute a derived "activity_score" with NULL-safe logic
PostScores AS (
  SELECT
    p.Id,
    p.Title,
    p.ViewCount,
    p.Score,
    COALESCE(p.ViewCount * 2, 0) + COALESCE(p.Score, 0) +
    COALESCE((SELECT AVG(v.BountyAmount) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 8), 0) AS activity_score
  FROM Posts p
  WHERE p.PostTypeId = 1
),
-- 5) Set operation: union of high-activity posts with posts having high comment count
HighActivity AS (
  SELECT PostId FROM PostScores WHERE activity_score > 1000
  UNION
  SELECT pc.PostId FROM TopComments tc
  JOIN Posts pc ON pc.Id = tc.PostId
  WHERE tc.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
)
SELECT
  rp.PostId,
  rp.Title,
  rp.CreationDate AS PostCreationDate,
  rp.LastActivityDate,
  rp.ViewCount,
  rp.Score,
  rp.OwnerUserId,
  u.DisplayName,
  u.Reputation,
  u.Location,
  u.CreationDate AS UserCreationDate,
  (CASE WHEN u.Reputation IS NULL THEN 0 ELSE u.Reputation END) AS ReputationSafe,
  COALESCE(tc.CommentId, NULL) AS TopCommentId,
  tc.UserDisplayName AS CommentAuthor,
  tc.Text AS CommentText,
  pa.Title AS ParentQuestionTitle,
  ha.TagName AS TagName,
  hact.total_posts
FROM
  Posts rp
  LEFT JOIN Users u ON rp.OwnerUserId = u.Id
  LEFT JOIN TopComments tc ON tc.PostId = rp.Id
  LEFT JOIN Posts pa ON rp.ParentId = pa.Id
  LEFT JOIN TagNames ha ON rp.Tags LIKE CONCAT('%>', ha.TagName, '<%') -- approximate tag match
  LEFT JOIN (SELECT * FROM RecentActivity) hact ON hact.PostId = rp.Id
WHERE
  rp.PostTypeId = 1 -- questions
  AND rp.Id IN (SELECT PostId FROM HighActivity)
ORDER BY
  rp.LastActivityDate DESC
LIMIT 100;