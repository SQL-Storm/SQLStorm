-- {"query": "5473.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 1003} 
WITH top_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.OwnerUserId,
    p.LastActivityDate,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.ContentLicense,
    ASQ.Cnt AS UndeletedAnswers
  FROM Posts p
  LEFT JOIN (
    SELECT ParentId, COUNT(*) AS Cnt
    FROM Posts
    WHERE PostTypeId = 2 -- answers
      AND ClosedDate IS NULL
    GROUP BY ParentId
  ) AS ASQ ON ASQ.ParentId = p.Id
  WHERE p.PostTypeId = 1 -- questions
    AND p.ClosedDate IS NULL
),
recent_comments AS (
  SELECT
    c.PostId,
    c.Id AS CommentId,
    c.Text,
    c.CreationDate,
    c.UserDisplayName,
    c.UserId,
    c.Score
  FROM Comments c
  WHERE c.CreationDate > (cast('2024-10-01' as date) - INTERVAL '30 days')
),
tag_expansion AS (
  SELECT
    t.TagName,
    t.Count,
    t.ExcerptPostId,
    t.WikiPostId,
    t.IsModeratorOnly,
    t.IsRequired
  FROM Tags t
),
activity_per_post AS (
  SELECT
    tq.PostId,
    tq.Title,
    tq.Tags,
    tq.Score,
    tq.ViewCount,
    tq.CreationDate,
    tq.OwnerUserId,
    tq.LastActivityDate,
    tq.AnswerCount,
    tq.CommentCount,
    tq.FavoriteCount,
    COALESCE(ch.CommentId, 0) AS DraftCommentId,
    COALESCE(ch.Text, '') AS DraftCommentText,
    ARRAY_AGG(DISTINCT vl.VoteTypeId) FILTER (WHERE vl.PostId = tq.PostId) AS VoteTypes
  FROM (
    SELECT
      p.Id AS PostId,
      p.Title,
      p.Tags,
      p.Score,
      p.ViewCount,
      p.CreationDate,
      p.OwnerUserId,
      p.LastActivityDate,
      p.AnswerCount,
      p.CommentCount,
      p.FavoriteCount
    FROM Posts p
    LEFT JOIN Votes v ON v.PostId = p.Id
    WHERE p.PostTypeId = 1
      AND p.ClosedDate IS NULL
  ) AS tq
  LEFT JOIN recent_comments ch ON ch.PostId = tq.PostId
  LEFT JOIN Votes vl ON vl.PostId = tq.PostId
  GROUP BY
    tq.PostId, tq.Title, tq.Tags, tq.Score, tq.ViewCount, tq.CreationDate,
    tq.OwnerUserId, tq.LastActivityDate, tq.AnswerCount, tq.CommentCount, tq.FavoriteCount, ch.CommentId, ch.Text
),
complex_benchmark AS (
  SELECT
    a.PostId,
    a.Title,
    a.Tags,
    a.Score,
    a.ViewCount,
    a.CreationDate,
    a.OwnerUserId,
    a.LastActivityDate,
    a.AnswerCount,
    a.CommentCount,
    a.FavoriteCount,
    a.DraftCommentId,
    a.DraftCommentText,
    a.VoteTypes,
    -- window function to compute cumulative sum over 30-day window per user
    SUM(COALESCE(vl.BountyAmount,0)) OVER (PARTITION BY a.OwnerUserId ORDER BY a.CreationDate ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS CumulativeBounty
  FROM activity_per_post a
  LEFT JOIN Votes vl ON vl.PostId = a.PostId
),
final_output AS (
  SELECT
    cb.PostId,
    cb.Title,
    (string_to_array(replace(cb.Tags, '><', ','), ',')[1:least(array_length(string_to_array(replace(cb.Tags, '><', ','), ','), 6))]::text[]) AS TopTags,
    cb.Score,
    cb.ViewCount,
    cb.CreationDate,
    cb.OwnerUserId,
    (SELECT DisplayName FROM Users u WHERE u.Id = cb.OwnerUserId) AS OwnerDisplayName,
    cb.LastActivityDate,
    cb.AnswerCount,
    cb.CommentCount,
    cb.FavoriteCount,
    cb.DraftCommentId,
    cb.DraftCommentText,
    cb.VoteTypes,
    cb.CumulativeBounty
  FROM complex_benchmark cb
  LEFT JOIN Posts p ON p.Id = cb.PostId
  LEFT JOIN Tags t ON t.ExcerptPostId = p.Id OR t.WikiPostId = p.Id
)
SELECT *
FROM final_output
ORDER BY CreationDate DESC
LIMIT 100;