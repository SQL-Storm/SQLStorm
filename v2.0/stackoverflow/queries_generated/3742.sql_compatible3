WITH
    q AS (
        SELECT
            p.Id                         AS QuestionId,
            p.OwnerUserId                AS OwnerUserId,
            p.Score                      AS QuestionScore,
            p.CreationDate,
            p.Title,
            p.Tags,
            COALESCE(p.FavoriteCount, 0)  AS FavCnt,
            ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS rn_q
        FROM Posts p
        WHERE p.PostTypeId = 1
    ),
    a AS (
        SELECT
            p.Id                         AS AnswerId,
            p.OwnerUserId                AS OwnerUserId,
            p.ParentId                   AS QuestionId,
            p.Score                      AS AnswerScore,
            p.CreationDate,
            ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS rn_a
        FROM Posts p
        WHERE p.PostTypeId = 2
    ),
    u AS (
        SELECT
            usr.Id,
            usr.DisplayName,
            usr.Reputation,
            usr.CreationDate               AS UserCreation,
            COALESCE(usr.UpVotes, 0) - COALESCE(usr.DownVotes, 0)               AS NetVotes,
            COALESCE(b.BadgeCount, 0)    AS BadgeCount,
            COALESCE(v.VoteCount, 0)     AS TotalVotes,
            COALESCE(c.CommentCount, 0)  AS CommentCount
        FROM Users usr
        LEFT JOIN (SELECT UserId, COUNT(*) AS BadgeCount FROM Badges GROUP BY UserId) b   ON b.UserId = usr.Id
        LEFT JOIN (SELECT UserId, COUNT(*) AS VoteCount   FROM Votes   GROUP BY UserId) v   ON v.UserId = usr.Id
        LEFT JOIN (SELECT UserId, COUNT(*) AS CommentCount FROM Comments GROUP BY UserId) c ON c.UserId = usr.Id
    ),
    tag_stats AS (
        SELECT
            t.TagName,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
            SUM(p.Score) FILTER (WHERE p.PostTypeId = 1) AS QuestionScoreSum,
            SUM(p.Score) FILTER (WHERE p.PostTypeId = 2) AS AnswerScoreSum
        FROM Tags t
        LEFT JOIN LATERAL (
            SELECT Id, PostTypeId, Score, Tags
            FROM Posts
            WHERE Tags IS NOT NULL
              AND POSITION('<' || t.TagName || '>' IN Tags) > 0
        ) p ON true
        GROUP BY t.TagName
    ),
    q_tags_first AS (
        SELECT
            q.QuestionId,
            CASE
                WHEN q.Tags IS NULL THEN NULL
                ELSE
                    (SELECT REPLACE(REPLACE(tag, '<', ''), '>', '')
                     FROM (
                         SELECT UNNEST(string_to_array(SUBSTR(q.Tags, 2, LENGTH(q.Tags) - 2), '><')) AS tag
                     ) t2
                     LIMIT 1)
            END AS FirstTag
        FROM q
    )
SELECT
    u.Id                                     AS UserId,
    u.DisplayName,
    u.Reputation,
    u.NetVotes,
    u.BadgeCount,
    u.TotalVotes,
    u.CommentCount,
    q.QuestionId,
    q.Title,
    q.QuestionScore,
    q.FavCnt,
    a.AnswerId,
    a.AnswerScore,
    COALESCE(ts.QuestionCount, 0)             AS TagQuestionCount,
    COALESCE(ts.AnswerCount, 0)               AS TagAnswerCount,
    CASE
        WHEN q.Tags IS NULL THEN NULL
        ELSE (
            SELECT STRING_AGG(REPLACE(REPLACE(tag, '<', ''), '>', ''), ',')
            FROM (
                SELECT UNNEST(string_to_array(SUBSTR(q.Tags, 2, LENGTH(q.Tags) - 2), '><')) AS tag
            ) t_tags
        )
    END                                      AS CleanTagList,
    EXISTS (
        SELECT 1
        FROM PostHistory ph
        WHERE ph.PostId = q.QuestionId
          AND ph.PostHistoryTypeId = 10
          AND ph.Comment = '101'
    )                                        AS IsDuplicateClosed
FROM u
LEFT JOIN q ON q.OwnerUserId = u.Id AND q.rn_q = 1
LEFT JOIN a ON a.OwnerUserId = u.Id AND a.rn_a = 1
LEFT JOIN q_tags_first qtf ON qtf.QuestionId = q.QuestionId
LEFT JOIN tag_stats ts ON ts.TagName = qtf.FirstTag
WHERE u.Reputation > 1000
  AND (u.BadgeCount > 5 OR u.TotalVotes > 20)
  AND (q.QuestionId IS NOT NULL OR a.AnswerId IS NOT NULL)
  AND NOT EXISTS (SELECT 1 FROM Users du WHERE du.Id = u.Id AND du.EmailHash IS NULL)

UNION ALL

SELECT
    u2.Id,
    u2.DisplayName,
    u2.Reputation,
    COALESCE(u2.UpVotes, 0) - COALESCE(u2.DownVotes, 0) AS NetVotes,
    COALESCE(b2.BadgeCount, 0) AS BadgeCount,
    COALESCE(v2.VoteCount, 0)  AS TotalVotes,
    COALESCE(c2.CommentCount, 0) AS CommentCount,
    CAST(NULL AS bigint) AS QuestionId,
    CAST(NULL AS text) AS Title,
    CAST(NULL AS integer) AS QuestionScore,
    CAST(NULL AS integer) AS FavCnt,
    CAST(NULL AS integer) AS AnswerId,
    CAST(NULL AS integer) AS AnswerScore,
    CAST(NULL AS text) AS CleanTagList,
    CAST(NULL AS boolean) AS IsDuplicateClosed
FROM Users u2
LEFT JOIN (SELECT UserId, COUNT(*) AS BadgeCount FROM Badges GROUP BY UserId) b2 ON b2.UserId = u2.Id
LEFT JOIN (SELECT UserId, COUNT(*) AS VoteCount FROM Votes GROUP BY UserId) v2 ON v2.UserId = u2.Id
LEFT JOIN (SELECT UserId, COUNT(*) AS CommentCount FROM Comments GROUP BY UserId) c2 ON c2.UserId = u2.Id
WHERE u2.Reputation BETWEEN 500 AND 999
  AND NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u2.Id AND p.PostTypeId = 1)

ORDER BY Reputation DESC NULLS LAST, UserId ASC
LIMIT 100;