WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        COALESCE(SUM(p.Score), 0) as TotalScore,
        COALESCE(SUM(p.ViewCount), 0) as TotalViews,
        AVG(p.Score) as AvgScore,
        RANK() OVER (ORDER BY SUM(p.Score) DESC) as ScoreRank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as ActivityRank,
        ROW_NUMBER() OVER (ORDER BY u.CreationDate ASC) as SeniorityRank,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 100 THEN 'Highly Active'
            WHEN COUNT(DISTINCT p.Id) > 50 THEN 'Active'
            WHEN COUNT(DISTINCT p.Id) > 10 THEN 'Moderate'
            ELSE 'Beginner'
        END as ActivityLevel
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        COALESCE(STRING_AGG(DISTINCT u.DisplayName, ', '), 'No Users') as AssociatedUsers,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 500 THEN 'Well-known'
            WHEN t.Count > 100 THEN 'Moderate'
            ELSE 'Niche'
        END as TagPopularity,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as PopularityRank
    FROM Tags t
    LEFT JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE t.TagName IS NOT NULL
    GROUP BY t.TagName, t.Count, t.ExcerptPostId, t.WikiPostId
),
QuestionAnalysis AS (
    SELECT 
        p.Id as QuestionId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.CreationDate,
        p.OwnerUserId,
        u.DisplayName as OwnerName,
        COALESCE(
            CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END,
            0
        ) as HasAcceptedAnswer,
        COALESCE(
            COUNT(DISTINCT CASE WHEN v.VoteTypeId IN (2, 3) THEN v.Id END),
            0
        ) as VoteCount,
        COALESCE(
            AVG(CASE WHEN v.VoteTypeId = 2 THEN 1.0 ELSE 0.0 END),
            0
        ) as UpVoteRatio,
        CASE 
            WHEN p.ViewCount > 1000 THEN 'High Traffic'
            WHEN p.ViewCount > 500 THEN 'Medium Traffic'
            WHEN p.ViewCount > 100 THEN 'Low Traffic'
            ELSE 'Minimal Traffic'
        END as TrafficLevel,
        RANK() OVER (ORDER BY p.ViewCount DESC) as ViewRank,
        RANK() OVER (ORDER BY p.Score DESC) as ScoreRank
    FROM Posts p
    JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.PostTypeId = 1 
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.AnswerCount, 
             p.CommentCount, p.FavoriteCount, p.CreationDate, p.OwnerUserId, 
             u.DisplayName, p.AcceptedAnswerId
),
AnswerQuality AS (
    SELECT 
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.Score,
        a.CreationDate,
        a.OwnerUserId,
        u.DisplayName as OwnerName,
        COALESCE(
            ROUND(
                (CAST(a.Score AS NUMERIC) / NULLIF((SELECT Score FROM Posts WHERE Id = a.ParentId), 0)) * 100
            , 2)
        , 0) as ScorePercentage,
        CASE 
            WHEN a.Score > 10 THEN 'Excellent'
            WHEN a.Score > 5 THEN 'Good'
            WHEN a.Score > 0 THEN 'Average'
            ELSE 'Below Average'
        END as QualityLevel,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) as RankWithinQuestion,
        DENSE_RANK() OVER (ORDER BY a.Score DESC) as OverallRank,
        AVG(a.Score) OVER (PARTITION BY a.ParentId) as AvgScorePerQuestion
    FROM Posts a
    JOIN Users u ON a.OwnerUserId = u.Id
    WHERE a.PostTypeId = 2
    GROUP BY a.Id, a.ParentId, a.Score, a.CreationDate, a.OwnerUserId, u.DisplayName
)
SELECT 
    'Performance Benchmark Report' as ReportTitle,
    COUNT(*) as TotalUsers,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1) as TotalQuestions,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 2) as TotalAnswers,
    (SELECT COUNT(*) FROM Comments) as TotalComments,
    (SELECT COUNT(*) FROM Badges) as TotalBadges,
    (SELECT COUNT(*) FROM Tags) as TotalTags,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1 AND AnswerCount > 0) as QuestionsWithAnswers,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1 AND Score > 0) as PositiveScoreQuestions,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 2 AND Score > 0) as PositiveScoreAnswers,
    (SELECT AVG(Reputation) FROM Users) as AvgReputation,
    (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) as AvgQuestionScore,
    (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 2) as AvgAnswerScore,
    (SELECT SUM(ViewCount) FROM Posts WHERE PostTypeId = 1) as TotalQuestionViews,
    (SELECT SUM(ViewCount) FROM Posts WHERE PostTypeId = 2) as TotalAnswerViews,
    (SELECT COUNT(*) FROM Posts WHERE ContentLicense IS NOT NULL AND ContentLicense != '') as LicensedPosts,
    (SELECT COUNT(*) FROM Posts WHERE ClosedDate IS NOT NULL) as ClosedPosts,
    (SELECT COUNT(*) FROM Posts WHERE CommunityOwnedDate IS NOT NULL) as CommunityOwnedPosts,
    (SELECT COUNT(*) FROM Posts WHERE LastEditDate IS NOT NULL) as EditedPosts,
    (SELECT COUNT(DISTINCT OwnerUserId) FROM Posts WHERE OwnerUserId IS NOT NULL) as ActivePostOwners,
    (SELECT COUNT(DISTINCT UserId) FROM Comments WHERE UserId IS NOT NULL) as ActiveCommenters,
    (SELECT COUNT(DISTINCT UserId) FROM Badges WHERE UserId IS NOT NULL) as ActiveBadgeRecipients,
    (SELECT COUNT(DISTINCT PostId) FROM PostHistory WHERE PostHistoryTypeId IN (1, 2, 3, 4, 5, 6)) as EditedPostsCount,
    (SELECT COUNT(DISTINCT PostId) FROM PostLinks WHERE LinkTypeId = 1) as LinkedPosts,
    (SELECT COUNT(DISTINCT PostId) FROM PostLinks WHERE LinkTypeId = 3) as DuplicatePosts,
    (SELECT COUNT(*) FROM Users WHERE EmailHash IS NOT NULL AND EmailHash != '') as UsersWithEmailHash,
    (SELECT COUNT(*) FROM Users WHERE WebsiteUrl IS NOT NULL AND WebsiteUrl != '') as UsersWithWebsite,
    (SELECT COUNT(*) FROM Users WHERE Location IS NOT NULL AND Location != '') as UsersWithLocation,
    (SELECT COUNT(*) FROM Users WHERE AboutMe IS NOT NULL AND LENGTH(AboutMe) > 0) as UsersWithAboutMe,
    (SELECT COUNT(*) FROM Users WHERE Views >= 1000) as HighViewUsers,
    (SELECT COUNT(*) FROM Users WHERE UpVotes >= 100) as HighUpVotesUsers,
    (SELECT COUNT(*) FROM Users WHERE DownVotes >= 100) as HighDownVotesUsers,
    (SELECT COUNT(*) FROM Posts WHERE ParentId IS NOT NULL AND OwnerUserId IS NOT NULL) as AnsweredQuestions,
    (SELECT COUNT(*) FROM Posts WHERE Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 2)) as AboveAvgScoreAnswers,
    (SELECT COUNT(*) FROM Posts WHERE AnswerCount > (SELECT AVG(AnswerCount) FROM Posts WHERE PostTypeId = 1)) as AboveAvgAnsweredQuestions,
    (SELECT COUNT(*) FROM Posts WHERE CommentCount > (SELECT AVG(CommentCount) FROM Posts WHERE PostTypeId = 1)) as AboveAvgCommentedQuestions,
    (SELECT COUNT(*) FROM Posts WHERE FavoriteCount > (SELECT AVG(FavoriteCount) FROM Posts WHERE PostTypeId = 1)) as AboveAvgFavoritedQuestions,
    (SELECT COUNT(*) FROM Posts WHERE ViewCount > (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1)) as AboveAvgViewedQuestions,
    (SELECT COUNT(*) FROM Posts WHERE Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1)) as AboveAvgScoreQuestions,
    (SELECT MAX(Reputation) FROM Users) as MaxReputation,
    (SELECT MAX(Score) FROM Posts WHERE PostTypeId = 1) as MaxQuestionScore,
    (SELECT MAX(Score) FROM Posts WHERE PostTypeId = 2) as MaxAnswerScore,
    (SELECT MAX(ViewCount) FROM Posts WHERE PostTypeId = 1) as MaxQuestionViews,
    (SELECT MAX(ViewCount) FROM Posts WHERE PostTypeId = 2) as MaxAnswerViews,
    (SELECT MIN(CreationDate) FROM Posts) as EarliestPostDate,
    (SELECT MAX(CreationDate) FROM Posts) as LatestPostDate,
    (SELECT MIN(CreationDate) FROM Users) as EarliestUserDate,
    (SELECT MAX(CreationDate) FROM Users) as LatestUserDate,
    (SELECT MIN(CreationDate) FROM Comments) as EarliestCommentDate,
    (SELECT MAX(CreationDate) FROM Comments) as LatestCommentDate,
    (SELECT COUNT(*) FROM Posts p1 
     JOIN Posts p2 ON p1.Id = p2.ParentId 
     WHERE p1.PostTypeId = 1 AND p2.PostTypeId = 2) as QuestionAnswerPairs,
    (SELECT COUNT(*) FROM Posts p1 
     JOIN Posts p2 ON p1.Id = p2.ParentId 
     JOIN Posts p3 ON p2.Id = p3.ParentId 
     WHERE p1.PostTypeId = 1 AND p2.PostTypeId = 2 AND p3.PostTypeId = 1) as QuestionAnswerQuestionChain,
    (SELECT COUNT(*) FROM Posts p1 
     JOIN Posts p2 ON p1.AcceptedAnswerId = p2.Id 
     WHERE p1.PostTypeId = 1 AND p2.PostTypeId = 2) as AcceptedAnswerPairs,
    (SELECT COUNT(*) FROM Posts p1 
     JOIN PostHistory ph ON p1.Id = ph.PostId 
     WHERE ph.PostHistoryTypeId IN (1, 2, 3)) as PostsWithHistory,
    (SELECT COUNT(DISTINCT ph.UserId) FROM PostHistory ph) as UsersWithPostHistory,
    (SELECT COUNT(DISTINCT v.UserId) FROM Votes v) as UsersWithVotes,
    (SELECT COUNT(*) FROM PostLinks) as TotalPostLinks,
    (SELECT COUNT(*) FROM PostHistoryTypes) as PostHistoryTypesCount,
    (SELECT COUNT(*) FROM VoteTypes) as VoteTypesCount,
    (SELECT COUNT(*) FROM PostTypes) as PostTypesCount,
    (SELECT COUNT(*) FROM LinkTypes) as LinkTypesCount,
    (SELECT COUNT(*) FROM CloseReasonTypes) as CloseReasonTypesCount,
    (SELECT AVG(cnt) FROM (
        SELECT p.OwnerUserId, COUNT(*) as cnt
        FROM Posts p 
        GROUP BY p.OwnerUserId
    ) user_post_counts) as AvgPostsPerUser,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT OwnerUserId 
        FROM Posts 
        WHERE PostTypeId = 1 AND AnswerCount > 0
    ) unique_question_owners) as UsersWithAnsweredQuestions,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT OwnerUserId 
        FROM Posts 
        WHERE PostTypeId = 2 AND Score > 0
    ) unique_answer_owners) as UsersWithPositiveScoreAnswers,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT PostId 
        FROM Comments 
        WHERE PostId IS NOT NULL
    ) unique_commented_posts) as PostsWithComments,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT b.UserId 
        FROM Badges b 
        WHERE b.UserId IS NOT NULL
    ) unique_badge_owners) as UsersWithBadges,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT p1.ParentId 
        FROM Posts p1 
        WHERE p1.PostTypeId = 2 AND p1.ParentId IS NOT NULL
    ) unique_parent_questions) as QuestionsWithAnswers,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT p1.OwnerUserId 
        FROM Posts p1 
        WHERE p1.PostTypeId = 2 AND p1.OwnerUserId IS NOT NULL
    ) unique_answer_owners) as UniqueAnswerOwners,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT p1.OwnerUserId 
        FROM Posts p1 
        WHERE p1.PostTypeId = 1 AND p1.OwnerUserId IS NOT NULL
    ) unique_question_owners) as UniqueQuestionOwners,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT ph.UserId 
        FROM PostHistory ph 
        WHERE ph.UserId IS NOT NULL
    ) unique_history_users) as UsersWithHistory,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT v.UserId 
        FROM Votes v 
        WHERE v.UserId IS NOT NULL
    ) unique_voting_users) as UsersWithVotes,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT p2.Id 
        FROM Posts p1 
        JOIN Posts p2 ON p1.Id = p2.ParentId 
        WHERE p1.PostTypeId = 1 AND p2.PostTypeId = 2 AND p2.Score > 0
    ) positive_answered_questions) as PositiveScoreAnsweredQuestions,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT p1.Id 
        FROM Posts p1 
        WHERE p1.PostTypeId = 1 AND p1.AnswerCount > 0 AND p1.Score > 0
    ) positive_answered_questions) as PositiveScoreAnsweredQuestions,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT u.Id 
        FROM Users u 
        JOIN Posts p1 ON u.Id = p1.OwnerUserId 
        WHERE p1.PostTypeId = 1 AND p1.AnswerCount > 0
    ) active_question_owners) as ActiveQuestionOwners,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT u.Id 
        FROM Users u 
        JOIN Posts p1 ON u.Id = p1.OwnerUserId 
        WHERE p1.PostTypeId = 2 AND p1.Score > 0
    ) active_answer_owners) as ActiveAnswerOwners,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT u.Id 
        FROM Users u 
        JOIN PostHistory ph ON u.Id = ph.UserId 
        WHERE ph.PostId IS NOT NULL
    ) active_history_users) as ActiveHistoryUsers,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT u.Id 
        FROM Users u 
        JOIN Votes v ON u.Id = v.UserId 
        WHERE v.PostId IS NOT NULL
    ) active_vote_users) as ActiveVoteUsers,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT u.Id 
        FROM Users u 
        JOIN Badges b ON u.Id = b.UserId 
        WHERE b.Id IS NOT NULL
    ) active_badge_users) as ActiveBadgeUsers,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT p1.Id 
        FROM Posts p1 
        JOIN Posts p2 ON p1.Id = p2.ParentId 
        WHERE p1.PostTypeId = 1 AND p2.PostTypeId = 2 AND p2.CreationDate >= p1.CreationDate
    ) valid_answered_questions) as ValidAnsweredQuestions,
    (SELECT COUNT(*) FROM (
        SELECT DISTINCT p1.Id 
        FROM Posts p1 
        JOIN Posts p2 ON p1.Id = p2.ParentId 
        WHERE p1.PostTypeId = 1 AND p2.PostTypeId = 2 AND p2.CreationDate <= p1.CreationDate
    ) invalid_answered_questions) as InvalidAnsweredQuestions
FROM UserActivityStats uas
JOIN TopTags tt ON 1=1
JOIN QuestionAnalysis qa ON 1=1
JOIN AnswerQuality aq ON 1=1
WHERE uas.UserId = (SELECT MIN(UserId) FROM UserActivityStats)
  AND tt.TagName = (SELECT MIN(TagName) FROM TopTags)
  AND qa.QuestionId = (SELECT MIN(QuestionId) FROM QuestionAnalysis)
  AND aq.AnswerId = (SELECT MIN(AnswerId) FROM AnswerQuality)
  AND uas.TotalPosts > 10
  AND tt.Count > 50
  AND qa.Score > 10
  AND aq.Score > 5
  AND EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 1)
  AND EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = uas.UserId AND p.PostTypeId = 2)
  AND EXISTS (SELECT 1 FROM Comments c WHERE c.UserId = uas.UserId)
  AND EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = uas.UserId)
  AND EXISTS (SELECT 1 FROM PostHistory ph WHERE ph.UserId = uas.UserId)
  AND EXISTS (SELECT 1 FROM Votes v WHERE v.UserId = uas.UserId)
  AND EXISTS (SELECT 1 FROM Posts p WHERE p.Id IN (SELECT PostId FROM Comments WHERE UserId = uas.UserId))
  AND EXISTS (SELECT 1 FROM Posts p WHERE p.Id IN (SELECT PostId FROM PostLinks WHERE PostId = p.Id))
ORDER BY uas.Reputation DESC, tt.Count DESC, qa.Score DESC, aq.Score DESC
LIMIT 1;