WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        MAX(b.Date) AS LastBadgeDate,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                CAST('2024-10-01 12:34:56' AS timestamp) - MAX(p.CreationDate)
            ELSE NULL 
        END AS DaysSinceLastPost,
        CASE 
            WHEN COUNT(DISTINCT b.Id) > 0 THEN 
                CAST('2024-10-01 12:34:56' AS timestamp) - MAX(b.Date)
            ELSE NULL 
        END AS DaysSinceLastBadge
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.CreationDate
),
RankedUsers AS (
    SELECT 
        ua.UserId,
        ua.Reputation,
        ua.DisplayName,
        ua.CreationDate,
        ua.PostCount,
        ua.CommentCount,
        ua.BadgeCount,
        ua.LastPostDate,
        ua.LastCommentDate,
        ua.LastBadgeDate,
        ua.DaysSinceLastPost,
        ua.DaysSinceLastBadge,
        ROW_NUMBER() OVER (ORDER BY ua.Reputation DESC, ua.PostCount DESC) AS RankByRepAndPosts,
        DENSE_RANK() OVER (ORDER BY ua.Reputation DESC) AS RankByRep,
        NTILE(100) OVER (ORDER BY ua.Reputation) AS PercentileRank
    FROM UserActivity ua
),
PostStats AS (
    SELECT 
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 
                (SELECT COUNT(*) FROM Posts WHERE ParentId = p.Id AND PostTypeId = 2 AND Score > 0)
            ELSE NULL 
        END AS PositiveAnswerCount,
        CASE 
            WHEN p.PostTypeId = 1 THEN 
                (SELECT COUNT(*) FROM Posts WHERE ParentId = p.Id AND PostTypeId = 2) 
            ELSE NULL 
        END AS TotalAnswerCount,
        CASE 
            WHEN p.PostTypeId = 1 THEN 
                (SELECT AVG(Score) FROM Posts WHERE ParentId = p.Id AND PostTypeId = 2)
            ELSE NULL 
        END AS AvgAnswerScore,
        CASE 
            WHEN p.PostTypeId = 1 THEN 
                (SELECT COUNT(*) FROM Comments WHERE PostId = p.Id)
            ELSE NULL 
        END AS CommentCountOnQuestion,
        EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate))/86400.0 AS AgeDays,
        CASE 
            WHEN p.Score > 10 THEN 'HighlyVoted'
            WHEN p.Score > 5 THEN 'ModeratelyVoted'
            WHEN p.Score > 0 THEN 'LowVoted'
            ELSE 'NoVotes'
        END AS VoteCategory
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
CombinedAnalysis AS (
    SELECT 
        ru.UserId,
        ru.DisplayName,
        ru.Reputation,
        ru.PostCount,
        ru.CommentCount,
        ru.BadgeCount,
        ru.DaysSinceLastPost,
        ru.DaysSinceLastBadge,
        ru.RankByRep,
        ru.RankByRepAndPosts,
        ru.PercentileRank,
        ps.PostId,
        ps.PostTypeId,
        ps.Score,
        ps.ViewCount,
        ps.Title,
        ps.Tags,
        ps.AnswerCount,
        ps.CommentCountOnQuestion,
        ps.PositiveAnswerCount,
        ps.TotalAnswerCount,
        ps.AvgAnswerScore,
        ps.AgeDays,
        ps.VoteCategory,
        ps.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY ru.UserId ORDER BY ps.CreationDate DESC) AS RecentPostRank,
        CASE 
            WHEN ps.PostTypeId = 1 AND ps.AnswerCount > 0 THEN 
                (ps.Score * 1.0) / (ps.AnswerCount + 1)
            ELSE NULL 
        END AS ScorePerAnswer,
        CASE 
            WHEN ps.PostTypeId = 1 AND ps.CommentCountOnQuestion > 0 THEN 
                (ps.Score * 1.0) / (ps.CommentCountOnQuestion + 1)
            ELSE NULL 
        END AS ScorePerComment
    FROM RankedUsers ru
    INNER JOIN PostStats ps ON ru.UserId = ps.OwnerUserId
    WHERE ps.AgeDays <= 365
),
ComplexAggregations AS (
    SELECT 
        ca.UserId,
        ca.DisplayName,
        ca.Reputation,
        ca.PostCount,
        ca.CommentCount,
        ca.BadgeCount,
        ca.DaysSinceLastPost,
        ca.DaysSinceLastBadge,
        ca.RankByRep,
        ca.RankByRepAndPosts,
        ca.PercentileRank,
        AVG(ca.Score) AS AvgPostScore,
        AVG(ca.ViewCount) AS AvgViewCount,
        AVG(ca.AgeDays) AS AvgPostAge,
        SUM(ca.PostCount) OVER (ORDER BY ca.Reputation DESC) AS CumulativePostCount,
        COUNT(*) OVER () AS TotalUsers,
        COUNT(DISTINCT ca.PostId) AS DistinctPosts,
        MAX(ca.Score) AS MaxScore,
        MIN(ca.ViewCount) AS MinViews,
        COUNT(CASE WHEN ca.VoteCategory = 'HighlyVoted' THEN 1 END) AS HighlyVotedPosts,
        COUNT(CASE WHEN ca.VoteCategory = 'ModeratelyVoted' THEN 1 END) AS ModeratelyVotedPosts,
        COUNT(CASE WHEN ca.VoteCategory = 'LowVoted' THEN 1 END) AS LowVotedPosts,
        COUNT(CASE WHEN ca.VoteCategory = 'NoVotes' THEN 1 END) AS NoVotedPosts,
        COUNT(CASE WHEN ca.PositiveAnswerCount IS NOT NULL AND ca.PositiveAnswerCount > 0 THEN 1 END) AS QuestionsWithPositiveAnswers,
        AVG(ca.AvgAnswerScore) AS AvgAnswerScoreAcrossQuestions,
        COUNT(CASE WHEN ca.ScorePerAnswer > 10 THEN 1 END) AS HighScorePerAnswerQuestions,
        COUNT(CASE WHEN ca.ScorePerComment > 5 THEN 1 END) AS HighScorePerCommentQuestions
    FROM CombinedAnalysis ca
    WHERE ca.PostTypeId IN (1, 2)
    GROUP BY ca.UserId, ca.DisplayName, ca.Reputation, ca.PostCount, ca.CommentCount, ca.BadgeCount, ca.DaysSinceLastPost, ca.DaysSinceLastBadge,
             ca.RankByRep, ca.RankByRepAndPosts, ca.PercentileRank
),
UserWithPosts AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        p.Id AS PostId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate AS PostCreationDate,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        CASE 
            WHEN p.PostTypeId = 1 THEN 
                (SELECT COUNT(*) FROM Posts WHERE ParentId = p.Id)
            ELSE 0 
        END AS TotalAnswersToPost,
        DENSE_RANK() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS RecentPostNumber
    FROM Users u
    INNER JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Id IN (SELECT UserId FROM ComplexAggregations WHERE Reputation > 5000)
),
FinalResults AS (
    SELECT 
        ca.UserId,
        ca.DisplayName,
        ca.Reputation,
        ca.PostCount,
        ca.CommentCount,
        ca.BadgeCount,
        ca.DaysSinceLastPost,
        ca.DaysSinceLastBadge,
        ca.RankByRep,
        ca.RankByRepAndPosts,
        ca.PercentileRank,
        ca.PostId,
        ca.PostTypeId,
        ca.Score,
        ca.ViewCount,
        ca.Title,
        ca.Tags,
        ca.AnswerCount,
        ca.CommentCountOnQuestion,
        ca.PositiveAnswerCount,
        ca.TotalAnswerCount,
        ca.AvgAnswerScore,
        ca.AgeDays,
        ca.VoteCategory,
        ca.ScorePerAnswer,
        ca.ScorePerComment,
        (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.OwnerUserId = ca.UserId) AS UserAvgScore,
        (SELECT AVG(p2.ViewCount) FROM Posts p2 WHERE p2.OwnerUserId = ca.UserId) AS UserAvgViews,
        CASE 
            WHEN ca.Score > (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.OwnerUserId = ca.UserId) * 1.5 THEN 'AboveAverage'
            WHEN ca.Score > (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.OwnerUserId = ca.UserId) THEN 'Average'
            ELSE 'BelowAverage'
        END AS ScoreTier,
        LAG(ca.Score, 1) OVER (PARTITION BY ca.UserId ORDER BY ca.CreationDate) AS PreviousPostScore,
        LAG(ca.Title, 1) OVER (PARTITION BY ca.UserId ORDER BY ca.CreationDate) AS PreviousPostTitle,
        (
            SELECT COUNT(*) FROM Posts p2 
            WHERE p2.OwnerUserId = ca.UserId 
            AND p2.CreationDate BETWEEN ca.CreationDate AND (ca.CreationDate + INTERVAL '30' DAY)
        ) AS PostsInPeriod,
        CASE 
            WHEN ca.CommentCountOnQuestion IS NOT NULL AND ca.CommentCountOnQuestion > 0 THEN 
                ca.CommentCountOnQuestion * 1.0 / NULLIF(ca.ViewCount, 0)
            ELSE NULL 
        END AS CommentToViewRatio,
        ca.CreationDate
    FROM CombinedAnalysis ca
    WHERE ca.PostTypeId = 1
)
SELECT 
    fr.UserId,
    fr.DisplayName,
    fr.Reputation,
    fr.PostCount,
    fr.CommentCount,
    fr.BadgeCount,
    fr.DaysSinceLastPost,
    fr.DaysSinceLastBadge,
    fr.RankByRep,
    fr.RankByRepAndPosts,
    fr.PercentileRank,
    AVG(fr.Score) AS AvgPostScore,
    AVG(fr.ViewCount) AS AvgViewCount,
    AVG(fr.AgeDays) AS AvgPostAge,
    SUM(fr.PostCount) OVER (ORDER BY fr.Reputation DESC) AS CumulativePostCount,
    COUNT(*) OVER () AS TotalUsers,
    COUNT(DISTINCT fr.PostId) AS DistinctPosts,
    MAX(fr.Score) AS MaxScore,
    MIN(fr.ViewCount) AS MinViews,
    COUNT(CASE WHEN fr.VoteCategory = 'HighlyVoted' THEN 1 END) AS HighlyVotedPosts,
    COUNT(CASE WHEN fr.VoteCategory = 'ModeratelyVoted' THEN 1 END) AS ModeratelyVotedPosts,
    COUNT(CASE WHEN fr.VoteCategory = 'LowVoted' THEN 1 END) AS LowVotedPosts,
    COUNT(CASE WHEN fr.VoteCategory = 'NoVotes' THEN 1 END) AS NoVotedPosts,
    COUNT(CASE WHEN fr.PositiveAnswerCount IS NOT NULL AND fr.PositiveAnswerCount > 0 THEN 1 END) AS QuestionsWithPositiveAnswers,
    AVG(fr.AvgAnswerScore) AS AvgAnswerScoreAcrossQuestions,
    COUNT(CASE WHEN fr.ScorePerAnswer > 10 THEN 1 END) AS HighScorePerAnswerQuestions,
    COUNT(CASE WHEN fr.ScorePerComment > 5 THEN 1 END) AS HighScorePerCommentQuestions
FROM FinalResults fr
GROUP BY 
    fr.UserId, fr.DisplayName, fr.Reputation, fr.PostCount, fr.CommentCount, fr.BadgeCount, fr.DaysSinceLastPost, fr.DaysSinceLastBadge,
    fr.RankByRep, fr.RankByRepAndPosts, fr.PercentileRank
HAVING 
    COUNT(DISTINCT fr.PostId) > 0
    AND fr.Reputation BETWEEN 1000 AND 100000
ORDER BY 
    fr.Reputation DESC, fr.PostCount DESC
LIMIT 1000;