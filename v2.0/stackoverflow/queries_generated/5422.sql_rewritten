-- {"query": "5422.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 760} 
WITH q AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.CreationDate,
    p.OwnerUserId,
    p.ViewCount,
    p.Score,
    p.Tags,
    p.Body,
    p.LastActivityDate,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.PostTypeId,
    COALESCE(p.AcceptedAnswerId, -1) AS AcceptedAnswerId,
    u.Reputation,
    u.DisplayName AS UserDisplayName,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate AS UserLastAccessDate,
    u.Location,
    u.WebsiteUrl,
    w.LastEditorUserId AS LastEditorUserId,
    w.LastEditorDisplayName AS LastEditorDisplayName,
    w.LastEditDate AS LastEditDate,
    w.Title AS LastTitle,
    w.Comment AS LastComment,
    -- window function: rank posts per day by score
    ROW_NUMBER() OVER (PARTITION BY DATE(p.CreationDate) ORDER BY p.Score DESC, p.ViewCount DESC) AS rn_per_day,
    -- total posts per day for the same user
    SUM(p.Score) OVER (PARTITION BY p.OwnerUserId, DATE(p.CreationDate)) AS sum_score_per_user_day
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN PostHistory w ON w.PostId = p.Id AND w.PostHistoryTypeId = 5 -- Edit Body (example)
  WHERE p.PostTypeId IN (1, 2) -- questions and answers
    AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
),
counts AS (
  SELECT
    p.OwnerUserId,
    COUNT(*) AS total_posts,
    SUM(p.ViewCount) AS total_views,
    AVG(p.Score) AS avg_score,
    MAX(p.CreationDate) AS last_post_date
  FROM Posts p
  GROUP BY p.OwnerUserId
),
tag_summary AS (
  SELECT
    t.TagName,
    COUNT(*) AS post_with_tag,
    AVG(p.Score) AS avg_score_tag
  FROM Tags t
  JOIN Posts p ON p.Id = t.Id
  WHERE t.IsModeratorOnly = 0
  GROUP BY t.TagName
),
recent_hot AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.Tags,
    p.CreationDate,
    ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS hot_rank
  FROM Posts p
  WHERE p.LastActivityDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '7 days'
  LIMIT 50
)
SELECT
  q.PostId,
  q.Title,
  q.CreationDate,
  q.OwnerUserId,
  q.DisplayName AS OwnerDisplayName,
  q.Reputation,
  q.Sum_Score_Per_User_Day
FROM (
  SELECT
    q.*,
    q.sum_score_per_user_day AS Sum_Score_Per_User_Day
  FROM q
) AS sub
WHERE sub.rn_per_day = 1
  AND sub.total_posts > 5
UNION ALL
SELECT
  NULL AS PostId,
  CONCAT('Tag summary: ', ts.TagName) AS Title,
  NULL AS CreationDate,
  NULL AS OwnerUserId,
  NULL AS OwnerDisplayName,
  NULL AS Reputation,
  ts.avg_score_tag AS Sum_Score_Per_User_Day
FROM tag_summary ts
ORDER BY 1 NULLS LAST, 7 DESC;