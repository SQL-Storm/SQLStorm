WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        MAX(p.CreationDate) as LastPostDate,
        MAX(c.CreationDate) as LastCommentDate,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as AnswerCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Score > 0 THEN p.Id END) as HighScoreQuestions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 AND p.Score > 0 THEN p.Id END) as HighScoreAnswers,
        SUM(COALESCE(p.ViewCount, 0)) as TotalViews,
        SUM(COALESCE(p.Score, 0)) as TotalScore,
        AVG(COALESCE(p.Score, 0)) as AvgPostScore,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN p.Id END) as AcceptedQuestions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 AND p.ParentId IS NOT NULL THEN p.Id END) as AnsweredQuestions
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id > 0
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
RankedUsers AS (
    SELECT 
        *,
        ROW_NUMBER() OVER (ORDER BY TotalScore DESC, PostCount DESC) as RankByScore,
        DENSE_RANK() OVER (ORDER BY Reputation DESC) as RankByReputation,
        NTILE(100) OVER (ORDER BY TotalViews DESC) as ViewsPercentile
    FROM UserActivityStats
),
TopPosts AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        u.DisplayName as OwnerDisplayName,
        p.PostTypeId,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.ParentId,
        p.AcceptedAnswerId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END as PostTypeDesc,
        CASE 
            WHEN p.Score >= 100 THEN 'Highly Rated'
            WHEN p.Score >= 50 THEN 'Well Rated'
            WHEN p.Score >= 10 THEN 'Moderate'
            ELSE 'Low'
        END as ScoreCategory
    FROM Posts p
    JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId IN (1, 2)
        AND p.CreationDate >= DATEADD(YEAR, -1, cast('2024-10-01 12:34:56' as timestamp))
        AND p.Score IS NOT NULL
),
PostWithTags AS (
    SELECT 
        tp.*,
        CASE 
            WHEN tp.Tags IS NOT NULL AND LEN(tp.Tags) > 4 THEN 
                (SELECT STRING_AGG(tag, ', ') 
                 FROM STRING_SPLIT(SUBSTRING(tp.Tags, 2, LEN(tp.Tags) - 2), '><') as tag
                 WHERE tag IS NOT NULL AND LEN(tag) > 0)
            ELSE NULL 
        END as ExtractedTags,
        ROW_NUMBER() OVER (PARTITION BY tp.OwnerUserId ORDER BY tp.Score DESC) as UserTopPostRank,
        RANK() OVER (ORDER BY tp.Score DESC) as GlobalPostRank
    FROM TopPosts tp
),
FinalAnalysis AS (
    SELECT 
        ru.UserId,
        ru.DisplayName,
        ru.Reputation,
        ru.PostCount,
        ru.CommentCount,
        ru.BadgeCount,
        ru.QuestionCount,
        ru.AnswerCount,
        ru.HighScoreQuestions,
        ru.HighScoreAnswers,
        ru.TotalViews,
        ru.TotalScore,
        ru.AvgPostScore,
        ru.AcceptedQuestions,
        ru.AnsweredQuestions,
        ru.RankByScore,
        ru.RankByReputation,
        ru.ViewsPercentile,
        COALESCE(
            (SELECT STRING_AGG(CONCAT('Tag:', pt.ExtractedTags, ' Score:', pt.Score), '; ')
             FROM PostWithTags pt 
             WHERE pt.OwnerUserId = ru.UserId 
             AND pt.Score >= 10
             LIMIT 5), 
            'No High Score Posts'
        ) as TopTaggedPosts,
        CASE 
            WHEN ru.TotalScore > 0 THEN 
                (SELECT TOP 1 pt.Title 
                 FROM PostWithTags pt 
                 WHERE pt.OwnerUserId = ru.UserId 
                 AND pt.Score = (
                     SELECT MAX(pt2.Score) 
                     FROM PostWithTags pt2 
                     WHERE pt2.OwnerUserId = ru.UserId
                 )
                )
            ELSE NULL
        END as BestPostTitle,
        (SELECT COUNT(*) FROM PostsWithTags pt WHERE pt.OwnerUserId = ru.UserId AND pt.PostTypeId = 1) as QuestionCountActual,
        (SELECT COUNT(*) FROM PostsWithTags pt WHERE pt.OwnerUserId = ru.UserId AND pt.PostTypeId = 2 AND pt.AnswerCount > 0) as AnsweredQuestionCount,
        (SELECT COALESCE(SUM(pt.ViewCount), 0) FROM PostsWithTags pt WHERE pt.OwnerUserId = ru.UserId AND pt.PostTypeId = 1) as TotalQuestionViews,
        (SELECT MAX(pt.CreationDate) FROM PostsWithTags pt WHERE pt.OwnerUserId = ru.UserId) as LastActivityDate,
        CASE 
            WHEN ru.PostCount > 5 AND ru.CommentCount > 10 THEN 'Active Contributor'
            WHEN ru.PostCount > 0 THEN 'Regular User'
            WHEN ru.CommentCount > 0 THEN 'Commentator'
            ELSE 'Passive User'
        END as UserStatus,
        ISNULL((SELECT AVG(pt.Score) FROM PostsWithTags pt WHERE pt.OwnerUserId = ru.UserId AND pt.PostTypeId = 1), 0) as AvgQuestionScore,
        ISNULL((SELECT AVG(pt.Score) FROM PostsWithTags pt WHERE pt.OwnerUserId = ru.UserId AND pt.PostTypeId = 2), 0) as AvgAnswerScore,
        CASE 
            WHEN ru.TotalScore > 1000 THEN 'Elite Contributor'
            WHEN ru.TotalScore > 500 THEN 'Experienced Contributor'
            WHEN ru.TotalScore > 100 THEN 'Contributor'
            ELSE 'Newbie'
        END as ContributorTier,
        CASE 
            WHEN EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = ru.UserId AND b.Class = 1) THEN 'Gold Badge Holder'
            WHEN EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = ru.UserId AND b.Class = 2) THEN 'Silver Badge Holder'
            WHEN EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = ru.UserId AND b.Class = 3) THEN 'Bronze Badge Holder'
            ELSE 'No Badges'
        END as BadgeStatus,
        (SELECT COUNT(DISTINCT ph.PostId) FROM PostHistory ph WHERE ph.UserId = ru.UserId AND ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6, 10, 11, 12, 13, 14, 15, 24)) as EditActions,
        (SELECT COUNT(DISTINCT v.PostId) FROM Votes v WHERE v.UserId = ru.UserId AND v.VoteTypeId IN (2, 3)) as VotingActions,
        CASE 
            WHEN ru.QuestionCount > 0 THEN 
                (100.0 * ru.AcceptedQuestions) / ru.QuestionCount
            ELSE 0 
        END as AcceptanceRate,
        CASE 
            WHEN ru.AnswerCount > 0 THEN 
                CAST(ru.AnsweredQuestions AS FLOAT) * 100.0 / ru.AnswerCount
            ELSE 0 
        END as AnswerEfficiencyRate,
        ((ru.Reputation - 1000) * 1.0 / 1000.0) as ReputationMultiplier,
        NULLIF(ru.PostCount, 0) * ru.AvgPostScore as ScoreProductivity,
        NULLIF(ru.TotalViews, 0) / NULLIF(ru.PostCount, 0) as ViewsPerPost,
        DATEDIFF(DAY, ru.LastPostDate, cast('2024-10-01 12:34:56' as timestamp)) as DaysSinceLastPost,
        CASE 
            WHEN DATEDIFF(DAY, ru.LastPostDate, cast('2024-10-01 12:34:56' as timestamp)) <= 7 THEN 'Recently Active'
            WHEN DATEDIFF(DAY, ru.LastPostDate, cast('2024-10-01 12:34:56' as timestamp)) <= 30 THEN 'Active'
            WHEN DATEDIFF(DAY, ru.LastPostDate, cast('2024-10-01 12:34:56' as timestamp)) <= 90 THEN 'Inactive'
            ELSE 'Very Inactive'
        END as ActivityStatus
    FROM RankedUsers ru
    WHERE ru.PostCount >= 0
)
SELECT 
    UserId,
    DisplayName,
    Reputation,
    PostCount,
    CommentCount,
    BadgeCount,
    QuestionCount,
    AnswerCount,
    HighScoreQuestions,
    HighScoreAnswers,
    TotalViews,
    TotalScore,
    AvgPostScore,
    AcceptedQuestions,
    AnsweredQuestions,
    RankByScore,
    RankByReputation,
    ViewsPercentile,
    TopTaggedPosts,
    BestPostTitle,
    QuestionCountActual,
    AnsweredQuestionCount,
    TotalQuestionViews,
    LastActivityDate,
    UserStatus,
    AvgQuestionScore,
    AvgAnswerScore,
    ContributorTier,
    BadgeStatus,
    EditActions,
    VotingActions,
    AcceptanceRate,
    AnswerEfficiencyRate,
    ReputationMultiplier,
    ScoreProductivity,
    ViewsPerPost,
    DaysSinceLastPost,
    ActivityStatus,
    CASE 
        WHEN TotalScore >= 5000 THEN 'Top Contributor'
        WHEN TotalScore >= 1000 THEN 'Good Contributor'
        WHEN TotalScore >= 100 THEN 'Moderate Contributor'
        ELSE 'New Contributor'
    END AS ContributorCategory,
    CASE 
        WHEN AVG(AnswerCount) OVER (PARTITION BY RankByReputation < 10) > 10 THEN 'High Engager'
        WHEN AVG(PostCount) OVER (PARTITION BY RankByReputation < 10) > 5 THEN 'Medium Engager'
        ELSE 'Low Engager'
    END AS EngagementLevel,
    (SELECT COUNT(*) FROM PostsWithTags WHERE OwnerUserId = UserId AND Score > 100) as HighValuePosts,
    (SELECT COUNT(*) FROM PostsWithTags pt JOIN PostHistory ph ON pt.Id = ph.PostId WHERE pt.OwnerUserId = UserId AND ph.PostHistoryTypeId = 24) as EditCount,
    (SELECT COUNT(DISTINCT pt.Tags) FROM PostsWithTags pt WHERE pt.OwnerUserId = UserId AND pt.Tags IS NOT NULL) as TagDiversity,
    (SELECT AVG(CAST(ph.CreationDate AS DATE) - CAST(ph.CreationDate AS DATE)) FROM PostHistory ph WHERE ph.UserId = UserId) as AverageEditInterval,
    NULLIF(TotalScore, 0) * NULLIF(ViewsPerPost, 0) AS ScoreViewIndex
FROM FinalAnalysis
WHERE PostCount > 0
    AND (Reputation >= 100 OR TotalViews >= 100)
    AND COALESCE(EditActions, 0) >= 0
    AND DaysSinceLastPost BETWEEN 0 AND 365
ORDER BY RankByScore, TotalScore DESC, LastActivityDate DESC
OFFSET 0 ROWS
FETCH NEXT 1000 ROWS ONLY;