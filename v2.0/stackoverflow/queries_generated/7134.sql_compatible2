WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.ClosedDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS prev_score,
        LAG(p.ViewCount) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS prev_views,
        CASE WHEN p.Score > COALESCE(LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate), 0) THEN 1 ELSE 0 END AS score_improved,
        CASE WHEN p.ViewCount > COALESCE(LAG(p.ViewCount) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate), 0) THEN 1 ELSE 0 END AS views_improved
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.ViewCount AS UserViews,
        u.UpVotes,
        u.DownVotes,
        u.AccountId,
        COUNT(DISTINCT r.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN r.PostTypeId = 1 THEN r.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN r.PostTypeId = 2 THEN r.Id END) AS Answers,
        AVG(r.Score) AS AvgScore,
        SUM(r.ViewCount) AS TotalViews,
        MAX(r.CreationDate) AS LastPostDate,
        STRING_AGG(COALESCE(r.Title, ''), ' | ') AS UserPostTitles
    FROM Users u
    LEFT JOIN RankedPosts r ON u.Id = r.OwnerUserId
    GROUP BY u.Id, u.Reputation, u.ViewCount, u.UpVotes, u.DownVotes, u.AccountId
),
PostAnalysis AS (
    SELECT 
        rp.Id,
        rp.PostTypeId,
        rp.Score,
        rp.ViewCount,
        rp.CreationDate,
        rp.OwnerUserId,
        rp.Title,
        rp.Tags,
        rp.AnswerCount,
        rp.CommentCount,
        rp.FavoriteCount,
        rp.ClosedDate,
        rp.rn,
        rp.prev_score,
        rp.prev_views,
        rp.score_improved,
        rp.views_improved,
        CASE 
            WHEN rp.Score >= 100 THEN 'High'
            WHEN rp.Score >= 50 THEN 'Medium'
            WHEN rp.Score >= 10 THEN 'Low'
            ELSE 'Very Low'
        END AS ScoreCategory,
        CASE 
            WHEN rp.ViewCount >= 1000 THEN 'Popular'
            WHEN rp.ViewCount >= 100 THEN 'Moderate'
            WHEN rp.ViewCount >= 10 THEN 'Low'
            ELSE 'Very Low'
        END AS ViewCategory,
        CAST(
          (JULIANDAY(COALESCE(rp.ClosedDate, TIMESTAMP '2024-10-01 12:34:56')) - JULIANDAY(rp.CreationDate))
          AS INTEGER
        ) AS DaysToCloseOrCurrent,
        COALESCE(rp.AnswerCount, 0) + COALESCE(rp.CommentCount, 0) AS EngagementCount,
        CASE 
            WHEN rp.Tags IS NOT NULL AND LENGTH(rp.Tags) > 0 THEN 
                CARDINALITY(STRING_TO_ARRAY(SUBSTR(rp.Tags, 2, LENGTH(rp.Tags) - 2), '><'))
            ELSE 0 
        END AS TagCount,
        CASE 
            WHEN rp.ViewCount > 0 THEN CAST(rp.Score AS DOUBLE PRECISION) / CAST(rp.ViewCount AS DOUBLE PRECISION) 
            ELSE 0 
        END AS ScoreEfficiency
    FROM RankedPosts rp
),
TopPosts AS (
    SELECT 
        pa.Id,
        pa.PostTypeId,
        pa.Score,
        pa.ViewCount,
        pa.CreationDate,
        pa.OwnerUserId,
        pa.Title,
        pa.Tags,
        pa.AnswerCount,
        pa.CommentCount,
        pa.FavoriteCount,
        pa.ClosedDate,
        pa.rn,
        pa.prev_score,
        pa.prev_views,
        pa.score_improved,
        pa.views_improved,
        pa.ScoreCategory,
        pa.ViewCategory,
        pa.DaysToCloseOrCurrent,
        pa.EngagementCount,
        pa.TagCount,
        pa.ScoreEfficiency,
        (SELECT AVG(ps.Score) FROM PostAnalysis ps WHERE ps.OwnerUserId = pa.OwnerUserId) AS UserAvgScore,
        (SELECT MAX(ps.Score) FROM PostAnalysis ps WHERE ps.OwnerUserId = pa.OwnerUserId) AS UserBestScore,
        CASE 
            WHEN pa.Score >= 50 AND pa.ViewCount >= 100 AND pa.EngagementCount >= 5 THEN 'High Impact'
            WHEN pa.Score >= 25 AND pa.ViewCount >= 50 THEN 'Medium Impact'
            WHEN pa.Score >= 10 AND pa.ViewCount >= 10 THEN 'Low Impact'
            ELSE 'Minimal Impact'
        END AS ImpactCategory
    FROM PostAnalysis pa
),
UserPostSummary AS (
    SELECT 
        us.UserId,
        us.Reputation,
        us.UserViews,
        us.UpVotes,
        us.DownVotes,
        us.AccountId,
        us.TotalPosts,
        us.Questions,
        us.Answers,
        us.AvgScore,
        us.TotalViews,
        us.LastPostDate,
        us.UserPostTitles,
        SUM(CASE WHEN tp.PostTypeId = 1 THEN 1 ELSE 0 END) AS UserQuestions,
        SUM(CASE WHEN tp.PostTypeId = 2 THEN 1 ELSE 0 END) AS UserAnswers,
        AVG(tp.ScoreEfficiency) AS AvgScoreEfficiency,
        MAX(tp.Score) AS MaxPostScore,
        MIN(tp.Score) AS MinPostScore,
        ROW_NUMBER() OVER (ORDER BY us.AvgScore DESC, us.Reputation DESC) AS UserPerformanceRank,
        CASE 
            WHEN us.TotalPosts > 0 THEN CAST(us.TotalViews AS DOUBLE PRECISION) / CAST(us.TotalPosts AS DOUBLE PRECISION)
            ELSE 0 
        END AS AvgViewsPerPost
    FROM UserStats us
    LEFT JOIN TopPosts tp ON us.UserId = tp.OwnerUserId
    GROUP BY 
        us.UserId, us.Reputation, us.UserViews, us.UpVotes, us.DownVotes, 
        us.AccountId, us.TotalPosts, us.Questions, us.Answers, us.AvgScore, 
        us.TotalViews, us.LastPostDate, us.UserPostTitles
)
SELECT 
    ups.UserId,
    ups.Reputation,
    ups.UserViews,
    ups.UpVotes,
    ups.DownVotes,
    ups.AccountId,
    ups.TotalPosts,
    ups.Questions,
    ups.Answers,
    ups.AvgScore,
    ups.TotalViews,
    ups.LastPostDate,
    ups.UserPerformanceRank,
    ups.AvgViewsPerPost,
    'User ' || ups.UserId || ' (Reputation: ' || ups.Reputation || ')' AS UserSummary,
    CASE 
        WHEN ups.UserPerformanceRank <= 10 THEN 'Top Performs'
        WHEN ups.UserPerformanceRank <= 50 THEN 'Mid Tier'
        ELSE 'Lower Tier'
    END AS PerformanceTier,
    SUM(ups.AvgScore) OVER (ORDER BY ups.Reputation DESC ROWS UNBOUNDED PRECEDING) AS RunningAvgScoreSum,
    (SELECT COUNT(*) FROM TopPosts tp WHERE tp.OwnerUserId = ups.UserId AND tp.Score >= 100) AS HighScorePosts,
    COALESCE(ups.UserPostTitles, 'No titles available') AS PostTitles,
    CASE 
        WHEN ups.TotalPosts > 0 THEN 
            (ups.AvgScore - (SELECT AVG(AvgScore) FROM UserPostSummary)) / NULLIF((SELECT STDDEV(AvgScore) FROM UserPostSummary),0)
        ELSE 0 
    END AS ZScoreFromAvg,
    CASE 
        WHEN LENGTH(COALESCE(ups.UserPostTitles, '')) > 500 THEN SUBSTR(ups.UserPostTitles, 1, 500) || '...' 
        ELSE ups.UserPostTitles
    END AS BriefTitles,
    (SELECT COUNT(*) FROM Posts p JOIN PostHistory ph ON p.Id = ph.PostId WHERE p.OwnerUserId = ups.UserId AND ph.PostHistoryTypeId = 10 AND p.PostTypeId = 1) AS ClosedQuestions,
    CASE 
        WHEN ups.Reputation >= 10000 AND ups.TotalPosts >= 100 THEN 'Veteran'
        WHEN ups.Reputation >= 5000 AND ups.TotalPosts >= 50 THEN 'Experienced'
        WHEN ups.Reputation >= 1000 THEN 'Active'
        ELSE 'New' 
    END AS UserStatus,
    CAST(
      (JULIANDAY(TIMESTAMP '2024-10-01 12:34:56') - JULIANDAY(ups.LastPostDate))
      AS INTEGER
    ) AS DaysSinceLastPost
FROM UserPostSummary ups
WHERE ups.TotalPosts > 0
  AND ups.Reputation > 0
ORDER BY ups.Reputation DESC, ups.AvgScore DESC
LIMIT 100;