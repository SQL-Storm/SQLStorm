WITH RankedPosts AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.ParentId,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.ViewCount AS PostViewCount,
        pt.Name AS PostTypeName,
        ROW_NUMBER() OVER(PARTITION BY p.PostTypeId ORDER BY p.CreationDate DESC) AS rn
    FROM Posts p
    JOIN PostTypes pt ON p.PostTypeId = pt.Id
    WHERE p.PostTypeId IN (1, 2)
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName AS UserDisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.Views AS UserViews,
        u.UpVotes AS UserUpVotes,
        u.DownVotes AS UserDownVotes,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        LAG(u.LastAccessDate, 1, u.CreationDate) OVER (PARTITION BY u.Id ORDER BY u.LastAccessDate) AS PreviousAccessDate
    FROM Users u
),
PostVoteSummary AS (
    SELECT
        v.PostId,
        COUNT(CASE WHEN vt.Name = 'UpMod' THEN 1 END) AS UpVoteCount,
        COUNT(CASE WHEN vt.Name = 'DownMod' THEN 1 END) AS DownVoteCount,
        COUNT(CASE WHEN vt.Name = 'Favorite' THEN 1 END) AS FavoriteVoteCount
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    WHERE vt.Name IN ('UpMod', 'DownMod', 'Favorite')
    GROUP BY v.PostId
),
PostCommentSentiment AS (
    SELECT
        c.PostId,
        AVG(CASE
            WHEN c.Text LIKE '%great%' OR c.Text LIKE '%excellent%' OR c.Text LIKE '%awesome%' THEN 2.0
            WHEN c.Text LIKE '%good%' OR c.Text LIKE '%nice%' OR c.Text LIKE '%helpful%' THEN 1.0
            WHEN c.Text LIKE '%bad%' OR c.Text LIKE '%terrible%' OR c.Text LIKE '%poor%' THEN -1.0
            WHEN c.Text LIKE '%confusing%' OR c.Text LIKE '%unclear%' THEN -2.0
            ELSE 0.0
        END) AS AverageSentimentScore
    FROM Comments c
    GROUP BY c.PostId
)
SELECT
    rp_q.PostId AS QuestionId,
    rp_q.PostTypeName AS QuestionType,
    rp_q.PostCreationDate AS QuestionCreationDate,
    rp_q.PostScore AS QuestionScore,
    rp_q.AnswerCount AS QuestionAnswerCount,
    rp_q.FavoriteCount AS QuestionFavoriteCount,
    rp_q.PostViewCount AS QuestionViewCount,
    ua_q.UserDisplayName AS QuestionOwnerDisplayName,
    ua_q.Reputation AS QuestionOwnerReputation,
    ua_q.UserCreationDate AS QuestionOwnerCreationDate,
    ua_q.GoldBadges AS QuestionOwnerGoldBadges,
    COALESCE(pvs_q.UpVoteCount, 0) AS QuestionUpVotes,
    COALESCE(pvs_q.DownVoteCount, 0) AS QuestionDownVotes,
    rp_a.PostId AS AnswerId,
    rp_a.PostTypeName AS AnswerType,
    rp_a.PostCreationDate AS AnswerCreationDate,
    rp_a.PostScore AS AnswerScore,
    ua_a.UserDisplayName AS AnswerOwnerDisplayName,
    ua_a.Reputation AS AnswerOwnerReputation,
    ua_a.UserCreationDate AS AnswerOwnerCreationDate,
    COALESCE(pcs_a.AverageSentimentScore, 0.0) AS AnswerAverageCommentSentiment,
    CASE
        WHEN rp_q.PostCreationDate < ua_q.UserCreationDate THEN 'User Created Post After User'
        WHEN rp_q.PostCreationDate > ua_q.UserCreationDate THEN 'User Created Post Before User'
        ELSE 'Same Day'
    END AS UserPostDateComparison,
    CAST((strftime('%s', rp_q.PostCreationDate) - strftime('%s', ua_q.PreviousAccessDate)) / 86400 AS INTEGER) AS DaysSinceLastUserAccessBeforePost
FROM RankedPosts rp_q
LEFT JOIN RankedPosts rp_a ON rp_q.PostId = rp_a.ParentId AND rp_a.PostTypeId = 2
LEFT JOIN UserActivity ua_q ON rp_q.OwnerUserId = ua_q.UserId
LEFT JOIN UserActivity ua_a ON rp_a.OwnerUserId = ua_a.UserId
LEFT JOIN PostVoteSummary pvs_q ON rp_q.PostId = pvs_q.PostId
LEFT JOIN PostCommentSentiment pcs_a ON rp_a.PostId = pcs_a.PostId
WHERE rp_q.rn <= 10
  AND rp_q.PostTypeId = 1
  AND (rp_a.rn IS NULL OR rp_a.rn <= 5)
  AND ua_q.Reputation > 1000
  AND (ua_a.Reputation IS NULL OR ua_a.Reputation > 500)
  AND rp_q.PostScore > 0
  AND rp_a.PostScore IS NOT NULL
  AND rp_q.PostCreationDate BETWEEN DATE '2023-01-01' AND DATE '2023-12-31'
  AND (rp_a.PostCreationDate IS NULL OR rp_a.PostCreationDate >= rp_q.PostCreationDate)
  AND EXISTS (SELECT 1 FROM PostLinks pl WHERE pl.PostId = rp_q.PostId AND pl.LinkTypeId = 3)
UNION
SELECT
    NULL AS QuestionId,
    NULL AS QuestionType,
    NULL AS QuestionCreationDate,
    NULL AS QuestionScore,
    NULL AS QuestionAnswerCount,
    NULL AS QuestionFavoriteCount,
    NULL AS QuestionViewCount,
    NULL AS QuestionOwnerDisplayName,
    NULL AS QuestionOwnerReputation,
    NULL AS QuestionOwnerCreationDate,
    NULL AS QuestionOwnerGoldBadges,
    NULL AS QuestionUpVotes,
    NULL AS QuestionDownVotes,
    rp.PostId AS AnswerId,
    rp.PostTypeName AS AnswerType,
    rp.PostCreationDate AS AnswerCreationDate,
    rp.PostScore AS AnswerScore,
    ua.UserDisplayName AS AnswerOwnerDisplayName,
    ua.Reputation AS AnswerOwnerReputation,
    ua.UserCreationDate AS AnswerOwnerCreationDate,
    COALESCE(pcs.AverageSentimentScore, 0.0) AS AnswerAverageCommentSentiment,
    NULL AS UserPostDateComparison,
    NULL AS DaysSinceLastUserAccessBeforePost
FROM RankedPosts rp
JOIN UserActivity ua ON rp.OwnerUserId = ua.UserId
LEFT JOIN PostCommentSentiment pcs ON rp.PostId = pcs.PostId
WHERE rp.PostTypeId = 2
  AND rp.ParentId IS NULL
  AND ua.Reputation > 100
  AND rp.PostScore < 0
  AND rp.PostCreationDate BETWEEN DATE '2023-01-01' AND DATE '2023-12-31';