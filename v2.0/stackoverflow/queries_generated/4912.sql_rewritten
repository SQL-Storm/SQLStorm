-- {"query": "4912.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1653} 
WITH
  RankedUserPosts AS (
    SELECT
      p.OwnerUserId,
      p.Id AS PostId,
      p.PostTypeId,
      p.CreationDate AS PostCreationDate,
      p.Score AS PostScore,
      ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn,
      LEAD(p.CreationDate, 1, p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS NextPostCreationDate,
      LAG(p.CreationDate, 1, p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS PreviousPostCreationDate
    FROM Posts AS p
    WHERE
      p.OwnerUserId IS NOT NULL AND p.OwnerUserId != -1
  ),
  UserPostIntervals AS (
    SELECT
      OwnerUserId,
      PostId,
      PostTypeId,
      PostCreationDate,
      PostScore,
      NextPostCreationDate,
      PreviousPostCreationDate,
      CASE
        WHEN NextPostCreationDate = PostCreationDate THEN 0
        ELSE JULIANDAY(PostCreationDate) - JULIANDAY(NextPostCreationDate)
      END AS TimeSinceLastPost,
      CASE
        WHEN PreviousPostCreationDate = PostCreationDate THEN 0
        ELSE JULIANDAY(PreviousPostCreationDate) - JULIANDAY(PostCreationDate)
      END AS TimeUntilNextPost
    FROM RankedUserPosts
    WHERE
      rn <= 5
  ),
  QuestionAnswers AS (
    SELECT
      q.Id AS QuestionId,
      COUNT(a.Id) AS AnswerCount,
      SUM(CASE WHEN a.IsAccepted = 1 THEN 1 ELSE 0 END) AS AcceptedAnswerCount
    FROM Posts AS q
    JOIN Posts AS a
      ON q.Id = a.ParentId
    WHERE
      q.PostTypeId = 1 AND a.PostTypeId = 2
    GROUP BY
      q.Id
  ),
  UserContributions AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (2, 5) THEN ph.PostId ELSE NULL END) AS EditedPostCount,
      COUNT(DISTINCT c.Id) AS CommentCount,
      COUNT(DISTINCT b.Id) AS BadgeCount,
      SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
      SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount
    FROM Users AS u
    LEFT JOIN PostHistory AS ph
      ON u.Id = ph.UserId
    LEFT JOIN Comments AS c
      ON u.Id = c.UserId
    LEFT JOIN Badges AS b
      ON u.Id = b.UserId
    LEFT JOIN Votes AS v
      ON u.Id = v.UserId
    GROUP BY
      u.Id,
      u.DisplayName
  )
SELECT
  upi.OwnerUserId,
  u.DisplayName,
  upi.PostId,
  pt.Name AS PostType,
  upi.PostCreationDate,
  upi.PostScore,
  upi.TimeSinceLastPost,
  upi.TimeUntilNextPost,
  COALESCE(qa.AnswerCount, 0) AS TotalAnswers,
  COALESCE(qa.AcceptedAnswerCount, 0) AS TotalAcceptedAnswers,
  uc.EditedPostCount,
  uc.CommentCount,
  uc.BadgeCount,
  uc.UpVoteCount,
  uc.DownVoteCount,
  CASE
    WHEN u.DownVotes > 0 THEN CAST(u.UpVotes AS REAL) / u.DownVotes
    WHEN u.UpVotes > 0 THEN NULL
    ELSE 0
  END AS UpDownVoteRatio,
  CASE
    WHEN u.CreationDate < DATE('now', '-1 year') AND u.LastAccessDate < DATE('now', '-3 months') THEN 'Inactive'
    WHEN u.Reputation > 10000 THEN 'High Reputation'
    ELSE 'Regular'
  END AS UserStatus,
  UPPER(SUBSTR(u.DisplayName, 1, 3)) AS DisplayNamePrefix,
  CASE
    WHEN u.WebsiteUrl IS NOT NULL AND u.WebsiteUrl LIKE '%stack%overflow%' THEN 'SO User'
    WHEN u.WebsiteUrl IS NOT NULL THEN 'External User'
    ELSE 'No Website'
  END AS WebsiteCategory,
  CASE
    WHEN CAST(STRFTIME('%w', u.CreationDate) AS INTEGER) BETWEEN 1 AND 5 THEN 'Weekday'
    ELSE 'Weekend'
  END AS CreationDayOfWeek,
  CASE
    WHEN upi.TimeSinceLastPost BETWEEN 0 AND 1 THEN 'Immediate'
    WHEN upi.TimeSinceLastPost BETWEEN 1 AND 7 THEN 'Within a Week'
    ELSE 'Longer Interval'
  END AS PostingIntervalCategory
FROM UserPostIntervals AS upi
JOIN Users AS u
  ON upi.OwnerUserId = u.Id
JOIN PostTypes AS pt
  ON upi.PostTypeId = pt.Id
LEFT JOIN QuestionAnswers AS qa
  ON upi.PostId = qa.QuestionId AND upi.PostTypeId = 1
LEFT JOIN UserContributions AS uc
  ON upi.OwnerUserId = uc.UserId
WHERE
  upi.PostScore > 5 AND u.DisplayName IS NOT NULL AND u.DisplayName != ''
UNION ALL
SELECT
  NULL AS OwnerUserId,
  'Community' AS DisplayName,
  p.Id AS PostId,
  pt.Name AS PostType,
  p.CreationDate AS PostCreationDate,
  p.Score AS PostScore,
  NULL AS TimeSinceLastPost,
  NULL AS TimeUntilNextPost,
  NULL AS TotalAnswers,
  NULL AS TotalAcceptedAnswers,
  COUNT(DISTINCT ph.PostId) AS EditedPostCount,
  COUNT(DISTINCT c.Id) AS CommentCount,
  0 AS BadgeCount,
  0 AS UpVoteCount,
  0 AS DownVoteCount,
  NULL AS UpDownVoteRatio,
  'Community Owned' AS UserStatus,
  'COM' AS DisplayNamePrefix,
  'No Website' AS WebsiteCategory,
  CASE
    WHEN CAST(STRFTIME('%w', p.CreationDate) AS INTEGER) BETWEEN 1 AND 5 THEN 'Weekday'
    ELSE 'Weekend'
  END AS CreationDayOfWeek,
  NULL AS PostingIntervalCategory
FROM Posts AS p
LEFT JOIN PostHistory AS ph
  ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (2, 5)
LEFT JOIN Comments AS c
  ON p.Id = c.PostId
LEFT JOIN PostHistoryTypes AS pht
  ON ph.PostHistoryTypeId = pht.Id
LEFT JOIN PostTypes AS pt
  ON p.PostTypeId = pt.Id
WHERE
  p.CommunityOwnedDate IS NOT NULL
GROUP BY
  p.Id,
  pt.Name,
  p.CreationDate,
  p.Score
ORDER BY
  PostCreationDate DESC
LIMIT 100;