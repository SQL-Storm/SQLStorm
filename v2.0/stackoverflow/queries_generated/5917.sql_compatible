WITH RecentTopPosts AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.AcceptedAnswerId,
    p.LastActivityDate,
    p.PostTypeId,
    COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpVotes,
    COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownVotes,
    AVG(NULLIF(v.BountyAmount, 0)) AS AvgBounty
  FROM Posts p
  LEFT JOIN Votes v ON v.PostId = p.Id
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY
  GROUP BY
    p.Id,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.AcceptedAnswerId,
    p.LastActivityDate,
    p.PostTypeId
),
TopInfluentialAuthors AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    SUM(p.UpVotes - p.DownVotes) AS NetScore,
    SUM(p.ViewCount) AS TotalViews,
    COUNT(*) AS PostCount
  FROM RecentTopPosts p
  JOIN Users u ON u.Id = p.OwnerUserId
  GROUP BY u.Id, u.DisplayName, u.Reputation
  HAVING SUM(p.UpVotes - p.DownVotes) > 0
),
TagUsage AS (
  SELECT
    unnest(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><')) AS TagName,
    COUNT(*) AS TagPosts
  FROM Posts p
  WHERE p.PostTypeId = 1
  GROUP BY unnest(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><'))
),
Competition AS (
  SELECT
    t.TagName,
    t.TagPosts AS PostsWithTag,
    COALESCE(u.TotalViews, 0) AS UserViews
  FROM TagUsage t
  LEFT JOIN (
    SELECT
      unnest(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><')) AS TagName,
      SUM(p.ViewCount) AS TotalViews
    FROM Posts p
    WHERE p.PostTypeId = 1
    GROUP BY unnest(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><'))
  ) u ON u.TagName = t.TagName
)
SELECT
  rp.PostId,
  rp.Title,
  rp.Tags,
  rp.CreationDate,
  rp.Score,
  rp.ViewCount,
  rp.OwnerUserId,
  ru.DisplayName AS OwnerName,
  ru.Reputation AS OwnerReputation,
  rp.LastActivityDate,
  rp.UpVotes,
  rp.DownVotes,
  rp.AvgBounty,
  tai.UserId AS TopAuthorId,
  tai.DisplayName AS TopAuthorName,
  tai.NetScore AS TopAuthorNetScore,
  tai.TotalViews AS TopAuthorTotalViews,
  tai.PostCount AS TopAuthorPostCount,
  comp.TagName,
  comp.PostsWithTag,
  comp.UserViews
FROM RecentTopPosts rp
LEFT JOIN TopInfluentialAuthors tai ON tai.UserId = rp.OwnerUserId
LEFT JOIN Users ru ON rp.OwnerUserId = ru.Id
LEFT JOIN Competition comp ON comp.TagName = ANY(string_to_array(substr(rp.Tags, 2, length(rp.Tags) - 2), '><'))
WHERE rp.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1)
  AND rp.ViewCount >= 100
ORDER BY rp.LastActivityDate DESC
LIMIT 100;