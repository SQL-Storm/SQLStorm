WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.Views AS UserViews,
        U.UpVotes AS UserUpVotes,
        U.DownVotes AS UserDownVotes,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COALESCE(LENGTH(U.AboutMe), 0) AS AboutMeLength,
        NTILE(4) OVER (ORDER BY U.Reputation DESC, U.CreationDate ASC) AS ReputationQuartile,
        (U.UpVotes + U.DownVotes) AS TotalUserVotes,
        U.Location,
        U.WebsiteUrl,
        U.ProfileImageUrl
    FROM
        Users U
    WHERE
        U.Reputation >= 1000 -- Focus on more established users
        AND U.LastAccessDate >= '2020-01-01' -- Active in recent years
),
PostEngagementMetrics AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.CreationDate AS PostCreationDate,
        P.Score,
        P.ViewCount,
        P.AnswerCount,
        P.CommentCount,
        P.FavoriteCount,
        P.Title,
        P.Tags,
        P.LastActivityDate,
        P.ClosedDate,
        P.CommunityOwnedDate,
        P.AcceptedAnswerId,
        -- Elaborate engagement score calculation
        COALESCE(P.Score, 0) * 1.5 + (COALESCE(P.ViewCount, 0) / 20.0) + (COALESCE(P.AnswerCount, 0) * 3.0) + COALESCE(P.CommentCount, 0) + COALESCE(P.FavoriteCount, 0) * 5.0 AS EngagementScore,
        -- Rolling average score by post type
        AVG(P.Score) OVER (PARTITION BY P.PostTypeId ORDER BY P.CreationDate ROWS BETWEEN 1000 PRECEDING AND CURRENT ROW) AS AvgScorePerPostTypeRolling,
        -- String processing for tags
        STRING_TO_ARRAY(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><') AS TagArray
    FROM
        Posts P
    WHERE
        P.PostTypeId IN (1, 2) -- Questions or Answers
        AND P.CreationDate BETWEEN '2019-01-01' AND '2023-12-31'
        AND P.Score >= 0 -- Exclude negatively scored posts for primary analysis
),
PostEditEventSeries AS (
    SELECT
        PH.PostId,
        PH.UserId,
        PH.CreationDate AS EditDate,
        -- LAG function to find previous edit date for the same post, by any user
        LAG(PH.CreationDate, 1, PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PreviousEditDate,
        PH.PostHistoryTypeId
    FROM
        PostHistory PH
    WHERE
        PH.PostHistoryTypeId IN (4, 5, 6) -- Edit Title, Edit Body, Edit Tags
),
PostEditMetrics AS (
    SELECT
        PostId,
        COUNT(DISTINCT UserId) AS DistinctEditors,
        COUNT(EditDate) AS TotalEdits,
        -- Average time difference between consecutive edits in seconds
        AVG(EXTRACT(EPOCH FROM (EditDate - PreviousEditDate))) FILTER (WHERE EditDate != PreviousEditDate) AS AvgSecondsBetweenConsecutiveEdits,
        MAX(EditDate) AS LastEditDate,
        MIN(EditDate) AS FirstEditDate
    FROM
        PostEditEventSeries
    GROUP BY
        PostId
    HAVING COUNT(EditDate) > 1 -- Only consider posts with multiple edits for time difference
),
TagPerformance AS (
    SELECT
        unnest(PEM.TagArray) AS TagName,
        PEM.PostId,
        PEM.Score,
        PEM.ViewCount
    FROM
        PostEngagementMetrics PEM
    WHERE
        PEM.PostTypeId = 1 -- Only consider question tags for this analysis
        AND PEM.TagArray IS NOT NULL
        AND array_length(PEM.TagArray, 1) > 0
),
TopTagsByAvgScore AS (
    SELECT
        TP.TagName,
        AVG(TP.Score) AS AvgTagScore,
        SUM(TP.ViewCount) AS TotalTagViews,
        COUNT(DISTINCT TP.PostId) AS PostCountForTag,
        ROW_NUMBER() OVER (ORDER BY AVG(TP.Score) DESC, SUM(TP.ViewCount) DESC, COUNT(DISTINCT TP.PostId) DESC) AS RankByScore
    FROM
        TagPerformance TP
    GROUP BY
        TP.TagName
    HAVING
        COUNT(DISTINCT TP.PostId) > 50 -- Require a significant number of posts for tag analysis
        AND AVG(TP.Score) > 1
),
ModeratorBadges AS (
    SELECT
        B.UserId,
        COUNT(B.Id) AS GoldBadgeCount,
        MAX(B.Date) AS LatestGoldBadgeDate
    FROM
        Badges B
    WHERE
        B.Class = 1 -- Gold badges
        AND B.TagBased = FALSE -- Non-tag based badges (often indicate moderation or significant platform contribution)
    GROUP BY
        B.UserId
),
MainContributorAnalysis AS (
    SELECT
        UAS.UserId,
        UAS.DisplayName,
        UAS.Reputation,
        UAS.ReputationQuartile,
        UAS.TotalUserVotes,
        SUM(COALESCE(PEM.EngagementScore, 0)) AS TotalEngagementScore,
        AVG(COALESCE(PEM.AvgScorePerPostTypeRolling, 0)) AS AvgRollingScoreForPosts,
        COUNT(DISTINCT PEM.PostId) AS TotalPostsOwned,
        SUM(CASE WHEN PEM.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsOwned,
        SUM(CASE WHEN PEM.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersOwned,
        MAX(PEM.PostCreationDate) AS LatestPostDate,
        SUM(COALESCE(PEM.FavoriteCount, 0)) AS TotalFavoriteCounts,
        SUM(COALESCE(PEM.CommentCount, 0)) AS TotalCommentsOnPostsOwned,
        SUM(COALESCE(PEM.ViewCount, 0)) AS TotalPostViews,
        -- Conditional aggregate with FILTER
        COALESCE(MAX(PEM.PostId) FILTER (WHERE PEM.AcceptedAnswerId IS NOT NULL), -1) AS HasAcceptedAnswerOnOwnPost,
        -- Edit Metrics
        COALESCE(SUM(PEMET.TotalEdits), 0) AS TotalEditsMadeOnPosts,
        COALESCE(AVG(PEMET.DistinctEditors), 0) AS AvgDistinctEditorsPerPost,
        COALESCE(AVG(PEMET.AvgSecondsBetweenConsecutiveEdits), 0) AS AvgPostEditTimeDiffSeconds,
        -- Badges
        COALESCE(MB.GoldBadgeCount, 0) AS UserGoldBadges,
        -- Correlated subquery: count of recent up/down votes given by user
        (SELECT COUNT(V.Id) FROM Votes V WHERE V.UserId = UAS.UserId AND V.VoteTypeId IN (2,3) AND V.CreationDate >= UAS.LastAccessDate - INTERVAL '3 months') AS RecentVotesGivenCount,
        -- PostLinks
        COUNT(DISTINCT TL.RelatedPostId) AS LinkedPostsCount,
        COUNT(DISTINCT TD.RelatedPostId) AS DuplicatePostsCount,
        -- Complex window function for overall ranking
        RANK() OVER (ORDER BY SUM(COALESCE(PEM.EngagementScore, 0)) DESC, UAS.Reputation DESC, SUM(COALESCE(PEMET.TotalEdits, 0)) DESC) AS OverallContributorRank,
        -- String aggregation with subquery for top global tags
        (SELECT STRING_AGG(TTBAS.TagName, ', ') FROM TopTagsByAvgScore TTBAS WHERE TTBAS.RankByScore <= 5) AS TopGlobalTagsString,
        -- Complex string expression and boolean logic for specific post types
        MAX(CASE WHEN PEM.Title ILIKE '%SQL%' OR EXISTS (SELECT 1 FROM UNNEST(PEM.TagArray) AS T WHERE T ILIKE '%sql%' OR T ILIKE '%database%') THEN 1 ELSE 0 END) AS HasSQLRelatedPost,
        SUM(CASE WHEN PEM.ClosedDate IS NOT NULL AND PEM.CommunityOwnedDate IS NULL AND PEM.PostTypeId = 1 THEN 1 ELSE 0 END) AS ClosedQuestionsNotCommunityOwned,
        SUM(CASE WHEN PEM.CommunityOwnedDate IS NOT NULL AND PEM.PostTypeId = 1 THEN 1 ELSE 0 END) AS CommunityOwnedQuestions,
        COALESCE(UAS.AboutMeLength, 0) / 100.0 AS AboutMeLengthRatio, -- Calculation with NULL handling
        'Main Contributor' AS ContributorType,
        UAS.Location,
        UAS.WebsiteUrl,
        UAS.ProfileImageUrl
    FROM
        UserActivitySummary UAS
    LEFT JOIN
        PostEngagementMetrics PEM ON UAS.UserId = PEM.OwnerUserId
    LEFT JOIN
        PostEditMetrics PEMET ON PEM.PostId = PEMET.PostId
    LEFT JOIN
        ModeratorBadges MB ON UAS.UserId = MB.UserId
    LEFT JOIN
        PostLinks TL ON PEM.PostId = TL.PostId AND TL.LinkTypeId = 1 -- Linked posts
    LEFT JOIN
        PostLinks TD ON PEM.PostId = TD.PostId AND TD.LinkTypeId = 3 -- Duplicate posts
    WHERE
        UAS.ReputationQuartile = 1 -- Focus on top 25% by reputation
        AND UAS.LastAccessDate > UAS.UserCreationDate + INTERVAL '1 year' -- User must be active for at least a year
        AND (
                PEM.PostId IS NOT NULL -- At least one post
                OR UAS.TotalUserVotes > 1000 -- Or just very active in voting
            )
        AND (
            -- Complex predicate involving string matching and correlated subquery
            PEM.Title ILIKE '%performance%'
            OR EXISTS (SELECT 1 FROM UNNEST(PEM.TagArray) AS T WHERE T ILIKE '%<optimization>%' OR T ILIKE '%<benchmark>%')
            OR EXISTS (SELECT 1 FROM TopTagsByAvgScore TTBAS WHERE TTBAS.TagName = ANY(PEM.TagArray) AND TTBAS.RankByScore <= 10)
        )
    GROUP BY
        UAS.UserId,
        UAS.DisplayName,
        UAS.Reputation,
        UAS.ReputationQuartile,
        UAS.TotalUserVotes,
        UAS.LastAccessDate,
        UAS.UserCreationDate,
        UAS.AboutMeLength,
        COALESCE(MB.GoldBadgeCount, 0),
        UAS.Location,
        UAS.WebsiteUrl,
        UAS.ProfileImageUrl
    HAVING
        SUM(COALESCE(PEM.Score, 0)) > 200 -- Users whose posts collectively have a high score
        AND (SUM(COALESCE(PEMET.TotalEdits, 0)) >= 10 OR COUNT(DISTINCT TL.RelatedPostId) + COUNT(DISTINCT TD.RelatedPostId) >= 3) -- Significant editing or linking activity
),
CommentatorActivity AS (
    SELECT
        UAS.UserId,
        UAS.DisplayName,
        UAS.Reputation,
        UAS.ReputationQuartile,
        UAS.TotalUserVotes,
        SUM(COALESCE(C.Score, 0)) * 0.75 AS TotalEngagementScore, -- Weighted by comment score
        0.0 AS AvgRollingScoreForPosts, -- Placeholder
        COUNT(DISTINCT P.Id) AS TotalPostsOwned, -- Represents posts commented on, not necessarily owned
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsOwned,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersOwned,
        MAX(C.CreationDate) AS LatestPostDate, -- Latest comment date
        0 AS TotalFavoriteCounts, -- Placeholder
        COUNT(C.Id) AS TotalCommentsOnPostsOwned, -- Actual comment count
        SUM(P.ViewCount) AS TotalPostViews, -- Sum of views of posts they commented on
        -- Check if user has an accepted answer on a post they commented on
        MAX(CASE WHEN P.AcceptedAnswerId IS NOT NULL AND P.OwnerUserId = UAS.UserId THEN P.Id ELSE -1 END) AS HasAcceptedAnswerOnOwnPost,
        0 AS TotalEditsMadeOnPosts, -- Placeholder
        0 AS AvgDistinctEditorsPerPost, -- Placeholder
        0.0 AS AvgPostEditTimeDiffSeconds, -- Placeholder
        COALESCE(MB.GoldBadgeCount, 0) AS UserGoldBadges,
        (SELECT COUNT(V.Id) FROM Votes V WHERE V.UserId = UAS.UserId AND V.VoteTypeId IN (2,3) AND V.CreationDate >= UAS.LastAccessDate - INTERVAL '3 months') AS RecentVotesGivenCount,
        0 AS LinkedPostsCount, -- Placeholder
        0 AS DuplicatePostsCount, -- Placeholder
        -- Rank by comments on popular posts within their reputation quartile
        RANK() OVER (PARTITION BY UAS.ReputationQuartile ORDER BY COUNT(C.Id) DESC, SUM(P.ViewCount) DESC) AS OverallContributorRank,
        (SELECT STRING_AGG(TTBAS.TagName, ', ') FROM TopTagsByAvgScore TTBAS WHERE TTBAS.RankByScore <= 5) AS TopGlobalTagsString,
        MAX(CASE WHEN P.Title ILIKE '%SQL%' OR EXISTS (SELECT 1 FROM UNNEST(STRING_TO_ARRAY(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><')) AS T WHERE T ILIKE '%sql%' OR T ILIKE '%database%') THEN 1 ELSE 0 END) AS HasSQLRelatedPost,
        SUM(CASE WHEN P.ClosedDate IS NOT NULL AND P.CommunityOwnedDate IS NULL AND P.PostTypeId = 1 THEN 1 ELSE 0 END) AS ClosedQuestionsNotCommunityOwned,
        SUM(CASE WHEN P.CommunityOwnedDate IS NOT NULL AND P.PostTypeId = 1 THEN 1 ELSE 0 END) AS CommunityOwnedQuestions,
        COALESCE(UAS.AboutMeLength, 0) / 100.0 AS AboutMeLengthRatio,
        'Comment Contributor' AS ContributorType,
        UAS.Location,
        UAS.WebsiteUrl,
        UAS.ProfileImageUrl
    FROM
        UserActivitySummary UAS
    INNER JOIN -- Inner join to ensure user has comments
        Comments C ON UAS.UserId = C.UserId
    INNER JOIN
        Posts P ON C.PostId = P.Id
    LEFT JOIN
        ModeratorBadges MB ON UAS.UserId = MB.UserId
    WHERE
        UAS.Reputation < 10000 -- Focus on users not already in the 'top' tier of main contributors
        AND P.ViewCount > 5000 -- Comments on highly viewed posts
        AND C.CreationDate BETWEEN '2021-01-01' AND '2023-12-31'
        AND P.PostTypeId IN (1, 2)
        AND LENGTH(C.Text) > 75 -- Only substantial comments
        AND (UAS.Location IS NOT NULL OR UAS.WebsiteUrl IS NOT NULL OR UAS.ProfileImageUrl IS NOT NULL) -- More complex predicate
        AND C.Score >= 0
    GROUP BY
        UAS.UserId,
        UAS.DisplayName,
        UAS.Reputation,
        UAS.ReputationQuartile,
        UAS.TotalUserVotes,
        UAS.LastAccessDate,
        UAS.UserCreationDate,
        UAS.AboutMeLength,
        COALESCE(MB.GoldBadgeCount, 0),
        UAS.Location,
        UAS.WebsiteUrl,
        UAS.ProfileImageUrl
    HAVING
        COUNT(C.Id) >= 25 -- At least 25 substantial comments
        AND SUM(COALESCE(C.Score, 0)) > 10 -- Total comment score must be significant
        AND MAX(P.ViewCount) > 20000 -- Commented on at least one very popular post
)
SELECT
    UserId,
    DisplayName,
    Reputation,
    ReputationQuartile,
    TotalUserVotes,
    TotalEngagementScore,
    AvgRollingScoreForPosts,
    TotalPostsOwned,
    QuestionsOwned,
    AnswersOwned,
    LatestPostDate,
    TotalFavoriteCounts,
    TotalCommentsOnPostsOwned,
    TotalPostViews,
    HasAcceptedAnswerOnOwnPost,
    TotalEditsMadeOnPosts,
    AvgDistinctEditorsPerPost,
    AvgPostEditTimeDiffSeconds,
    UserGoldBadges,
    RecentVotesGivenCount,
    LinkedPostsCount,
    DuplicatePostsCount,
    OverallContributorRank,
    TopGlobalTagsString,
    HasSQLRelatedPost,
    ClosedQuestionsNotCommunityOwned,
    CommunityOwnedQuestions,
    AboutMeLengthRatio,
    ContributorType,
    Location,
    WebsiteUrl,
    ProfileImageUrl
FROM MainContributorAnalysis
WHERE OverallContributorRank <= 100
UNION ALL
