        p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '2 year') 
        AND p.CreationDate <= TIMESTAMP '2024-10-01 12:34:56'
    )
    AND p.Score BETWEEN 5 AND 200
