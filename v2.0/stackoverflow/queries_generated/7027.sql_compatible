    COUNT(v.Id) > 5
    AND (
        (SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) >= 5)
        OR (SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) <= 2)
    )
