    p.Id, 
    p.Title, 
    p.Score, 
    p.ViewCount, 
    p.CreationDate, 
    u.DisplayName, 
    p.PostTypeId, 
    p.Tags, 
    p.AcceptedAnswerId, 
    p.AnswerCount, 
    p.CommentCount, 
    p.FavoriteCount,
    p.ClosedDate, 
    p.OwnerUserId, 
    p.ContentLicense
