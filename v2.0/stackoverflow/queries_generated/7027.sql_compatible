LEFT JOIN Users u ON p.OwnerUserId = u.Id
LEFT JOIN Votes v ON p.Id = v.PostId
WHERE 
    p.PostTypeId = 1 
    AND p.Tags IS NOT NULL
    AND EXISTS (
        SELECT 1 
        FROM PostHistory ph 
        WHERE ph.PostId = p.Id 
        AND ph.PostHistoryTypeId IN (25, 52, 53)
