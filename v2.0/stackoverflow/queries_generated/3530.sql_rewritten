-- {"query": "3530.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2469} 
WITH
/* ------------------------------------------------------------------
   1. Base list of tags (excluding moderator‑only tags)
   ------------------------------------------------------------------ */
TagList AS (
    SELECT
        t.Id                         AS TagId,
        t.TagName,
        t.Count                      AS TagUseCount,
        NULLIF(SUBSTRING(t.TagName FROM 1 FOR 5), '') AS TagPrefix
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
),

/* ------------------------------------------------------------------
   2. Explode each question into one row per tag it carries
   ------------------------------------------------------------------ */
QuestionAgg AS (
    SELECT
        p.Id                         AS QuestionId,
        p.Score,
        p.CreationDate,
        p.OwnerUserId,
        p.FavoriteCount,
        p.ViewCount,
        p.AnswerCount,
        p.ClosedDate,
        UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<>' FROM p.Tags), '><')) AS SingleTag
    FROM Posts p
    WHERE p.PostTypeId = 1                -- Question
),

/* ------------------------------------------------------------------
   3. Aggregate per‑tag statistics from the exploded questions
   ------------------------------------------------------------------ */
TagQuestionStats AS (
    SELECT
        tl.TagId,
        tl.TagName,
        COUNT(q.QuestionId)                         AS QuestionCount,
        AVG(q.Score)::NUMERIC(10,2)                  AS AvgScore,
        SUM(q.ViewCount)                             AS TotalViews,
        SUM(q.FavoriteCount)                         AS TotalFavorites,
        MAX(q.CreationDate)                          AS LatestQuestionDate,
        COUNT(CASE WHEN q.ClosedDate IS NOT NULL THEN 1 END) AS ClosedCount
    FROM TagList tl
    LEFT JOIN QuestionAgg q
           ON q.SingleTag = tl.TagName
    GROUP BY tl.TagId, tl.TagName
),

/* ------------------------------------------------------------------
   4. Bring in answers and a few correlated sub‑queries
   ------------------------------------------------------------------ */
AnswerAgg AS (
    SELECT
        p.Id                         AS AnswerId,
        p.ParentId                   AS QuestionId,
        p.Score,
        p.CreationDate,
        p.OwnerUserId,
        p.CommentCount,
        (SELECT COUNT(*) FROM Votes v
            WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS UpVoteCount,
        (SELECT MAX(ph.CreationDate) FROM PostHistory ph
            WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4,5,6)) AS LastEditDate
    FROM Posts p
    WHERE p.PostTypeId = 2                -- Answer
),

/* ------------------------------------------------------------------
   5. Badge counts per user (gold / silver / bronze)
   ------------------------------------------------------------------ */
UserBadgeCounts AS (
    SELECT
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
),

/* ------------------------------------------------------------------
   6. Rank top contributors (by reputation) for each tag
   ------------------------------------------------------------------ */
TopContributors AS (
    SELECT
        u.Id                         AS UserId,
        u.DisplayName,
        u.Reputation,
        COALESCE(ub.GoldBadges,   0) AS GoldBadges,
        COALESCE(ub.SilverBadges, 0) AS SilverBadges,
        COALESCE(ub.BronzeBadges, 0) AS BronzeBadges,
        q.SingleTag                  AS TagName,
        ROW_NUMBER() OVER (PARTITION BY q.SingleTag
                           ORDER BY u.Reputation DESC) AS RankPerTag
    FROM Users u
    JOIN AnswerAgg a      ON a.OwnerUserId = u.Id
    JOIN QuestionAgg q    ON q.QuestionId = a.QuestionId
    JOIN TagList tl       ON tl.TagName = q.SingleTag
    LEFT JOIN UserBadgeCounts ub ON ub.UserId = u.Id
),

/* ------------------------------------------------------------------
   7. Ensure every tag appears even if it has zero questions
   ------------------------------------------------------------------ */
AllTagStats AS (
    SELECT * FROM TagQuestionStats
    UNION ALL
    SELECT
        tl.TagId,
        tl.TagName,
        0 AS QuestionCount,
        0 AS AvgScore,
        0 AS TotalViews,
        0 AS TotalFavorites,
        NULL AS LatestQuestionDate,
        0 AS ClosedCount
    FROM TagList tl
    WHERE NOT EXISTS (SELECT 1 FROM TagQuestionStats s WHERE s.TagId = tl.TagId)
)

/* ------------------------------------------------------------------
   8. Final result set: tag info, aggregated metrics, and top 3 users
   ------------------------------------------------------------------ */
SELECT
    t.TagId,
    t.TagName,
    t.TagUseCount,
    s.QuestionCount,
    s.AvgScore,
    s.TotalViews,
    s.TotalFavorites,
    s.ClosedCount,
    tc.UserId,
    tc.DisplayName,
    tc.Reputation,
    tc.GoldBadges,
    tc.SilverBadges,
    tc.BronzeBadges,
    tc.RankPerTag
FROM TagList t
LEFT JOIN AllTagStats s
       ON s.TagId = t.TagId
LEFT JOIN (
    SELECT *
    FROM TopContributors
    WHERE RankPerTag <= 3
) tc
       ON tc.TagName = t.TagName
WHERE t.TagUseCount > 1000
ORDER BY t.TagUseCount DESC,
         s.QuestionCount DESC,
         tc.RankPerTag;