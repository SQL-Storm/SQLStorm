WITH
  RankedPostEdits AS (
    SELECT
      ph.PostId,
      ph.PostHistoryTypeId,
      ph.UserId,
      ph.CreationDate,
      ROW_NUMBER() OVER (PARTITION BY ph.PostId, ph.PostHistoryTypeId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory ph
    WHERE
      ph.PostHistoryTypeId IN (4, 5, 6) AND ph.UserId IS NOT NULL
  ),
  PostEditSummaries AS (
    SELECT
      rpe.PostId,
      COUNT(rpe.UserId) AS TotalEdits,
      MAX(rpe.CreationDate) AS LastEditDate
    FROM RankedPostEdits rpe
    GROUP BY
      rpe.PostId
  ),
  UserPostActivity AS (
    SELECT
      p.OwnerUserId,
      COUNT(p.Id) AS QuestionCount,
      SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
      SUM(p.ViewCount) AS TotalViews
    FROM Posts p
    WHERE
      p.OwnerUserId IS NOT NULL
    GROUP BY
      p.OwnerUserId
  ),
  UserBadgeCounts AS (
    SELECT
      b.UserId,
      SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
      SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
      SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges b
    GROUP BY
      b.UserId
  ),
  ComplexPostMetrics AS (
    SELECT
      p.Id AS PostId,
      p.Title,
      p.CreationDate,
      pt.Name AS PostTypeName,
      u.DisplayName AS OwnerDisplayName,
      p.Score,
      p.ViewCount,
      p.CommentCount,
      p.FavoriteCount,
      COALESCE(pes.TotalEdits, 0) AS TotalEdits,
      COALESCE(pes.LastEditDate, p.CreationDate) AS LastActivityTimestamp,
      CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END AS IsClosed,
      p.Score + (p.CommentCount * 0.5) + (p.FavoriteCount * 1.2) - (COALESCE(pes.TotalEdits, 0) * 0.1) AS QualityScore,
      CASE
        WHEN p.Tags LIKE '%<sql>%' THEN 'SQL Related'
        ELSE 'Other'
      END AS TagCategory,
      -- use standard SQL: extract epoch day difference by casting dates to DATE and using julianday-like difference if not supported.
      -- Standard SQL way: DATE '2024-10-01' - DATE(p.CreationDate) may produce an INTERVAL; instead compute days via DATE subtraction expressed as (CAST(... AS DATE) - CAST(... AS DATE)) and then extract day using EXTRACT(day FROM ...).
      -- To be broadly compatible, compute difference using JULIANDAY function if available, otherwise use DATE difference via CAST to DATE and subtract yielding integer in many DBs. Here use a portable approach using Julian day via (strftime) for SQLite or julianday for others is dialect-specific; use generic: (CAST('2024-10-01' AS DATE) - CAST(p.CreationDate AS DATE)) as DaysDiff and then EXTRACT(day FROM ...). To maximize compatibility, compute days via (CAST('2024-10-01' AS DATE) - CAST(p.CreationDate AS DATE)) and wrap with EXTRACT(DAY FROM ...).
      EXTRACT(DAY FROM (CAST('2024-10-01' AS DATE) - CAST(p.CreationDate AS DATE))) AS DaysSinceCreation,
      COALESCE(p.Title, 'Untitled Post') AS DisplayTitle,
      p.OwnerUserId
    FROM Posts p
    JOIN PostTypes pt
      ON p.PostTypeId = pt.Id
    LEFT JOIN Users u
      ON p.OwnerUserId = u.Id
    LEFT JOIN PostEditSummaries pes
      ON p.Id = pes.PostId
    WHERE
      p.PostTypeId = 1
  ),
  UserEngagement AS (
    SELECT
      upa.OwnerUserId,
      upa.QuestionCount,
      upa.AnswerCount,
      upa.TotalViews,
      COALESCE(ubc.GoldBadges, 0) AS GoldBadges,
      COALESCE(ubc.SilverBadges, 0) AS SilverBadges,
      COALESCE(ubc.BronzeBadges, 0) AS BronzeBadges,
      SUM(cpm.QualityScore) AS TotalQualityScoreContribution
    FROM UserPostActivity upa
    LEFT JOIN UserBadgeCounts ubc
      ON upa.OwnerUserId = ubc.UserId
    LEFT JOIN Posts p
      ON upa.OwnerUserId = p.OwnerUserId
    LEFT JOIN ComplexPostMetrics cpm
      ON p.Id = cpm.PostId
    GROUP BY
      upa.OwnerUserId,
      upa.QuestionCount,
      upa.AnswerCount,
      upa.TotalViews,
      ubc.GoldBadges,
      ubc.SilverBadges,
      ubc.BronzeBadges
  )
SELECT
  cpm.PostId,
  cpm.Title AS QuestionTitle,
  cpm.PostTypeName,
  cpm.OwnerDisplayName,
  cpm.Score,
  cpm.ViewCount,
  cpm.CommentCount,
  cpm.FavoriteCount,
  cpm.TotalEdits,
  cpm.QualityScore,
  cpm.TagCategory,
  cpm.DaysSinceCreation,
  cpm.DisplayTitle,
  ue.QuestionCount AS OwnerQuestionCount,
  ue.AnswerCount AS OwnerAnswerCount,
  ue.TotalViews AS OwnerTotalViews,
  ue.GoldBadges AS OwnerGoldBadges,
  ue.SilverBadges AS OwnerSilverBadges,
  ue.BronzeBadges AS OwnerBronzeBadges,
  ue.TotalQualityScoreContribution AS OwnerTotalQualityScoreContribution,
  (
    SELECT
      AVG(p2.Score)
    FROM Posts p2
    WHERE
      p2.OwnerUserId = cpm.OwnerUserId
      AND p2.PostTypeId = 2
  ) AS OwnerAvgAnswerScore,
  CASE
    WHEN EXISTS (
      SELECT
        1
      FROM PostLinks pl
      WHERE
        pl.PostId = cpm.PostId AND pl.LinkTypeId = 3
    ) THEN 'Is Duplicate'
    ELSE 'Not a Duplicate'
  END AS DuplicateStatus,
  CASE
    WHEN u.Reputation > 10000 THEN 'High Reputation'
    WHEN u.Reputation > 1000 THEN 'Medium Reputation'
    ELSE 'Low Reputation'
  END AS ReputationLevel,
  (u.DisplayName || ' (' || u.Reputation || ')') AS UserIdentifier
FROM ComplexPostMetrics cpm
LEFT JOIN UserEngagement ue
  ON cpm.OwnerUserId = ue.OwnerUserId
LEFT JOIN Users u
  ON cpm.OwnerUserId = u.Id
WHERE
  cpm.DaysSinceCreation > 30 AND cpm.IsClosed = 0
ORDER BY
  cpm.QualityScore DESC,
  cpm.ViewCount DESC
LIMIT 100;