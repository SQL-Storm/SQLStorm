WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY u.Views DESC) AS ViewRank,
        NTILE(10) OVER (ORDER BY u.Reputation DESC) AS ReputationDecile
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.Views, u.UpVotes, u.DownVotes
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.PostTypeId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN 'Question with Accepted Answer'
            WHEN p.PostTypeId = 1 THEN 'Question without Accepted Answer'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostCategory,
        COALESCE(p.Tags, '') AS Tags,
        CHAR_LENGTH(COALESCE(p.Tags, '')) AS TagLength,
        CASE 
            WHEN p.Tags IS NOT NULL AND CHAR_LENGTH(p.Tags) > 0 THEN SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2)
            ELSE ''
        END AS CleanTags,
        -- Best-effort generic tag split/agg; exact behavior varies by dialect
        (SELECT STRING_AGG(tag, ', ')
         FROM (
           SELECT TRIM(BOTH '>' FROM part) AS tag
           FROM (
             SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(COALESCE(p.Tags, '') FROM 2 FOR GREATEST(CHAR_LENGTH(COALESCE(p.Tags, ''))-2,0)), '><')) AS part
           ) s1
         ) s2
        ) AS TagList,
        DENSE_RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) AS ScoreRank,
        AVG(p.Score) OVER (PARTITION BY p.PostTypeId) AS AvgScoreByType,
        ROW_NUMBER() OVER (ORDER BY p.CreationDate DESC) AS RecentPostRank,
        CASE 
            WHEN p.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = p.PostTypeId) 
            THEN 'Above_Avg' 
            ELSE 'Below_Avg' 
        END AS ScoreComparison,
        CASE 
            WHEN ABS(p.Score) > 100 THEN 'Highly_Voted'
            WHEN ABS(p.Score) > 50 THEN 'Moderately_Voted'
            WHEN ABS(p.Score) > 0 THEN 'Low_Voted'
            ELSE 'Unvoted'
        END AS VotingLevel,
        CASE WHEN p.ClosedDate IS NOT NULL THEN 'Closed' ELSE 'Open' END AS PostStatus,
        CASE WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community_Owned' ELSE 'Not_Community_Owned' END AS OwnershipStatus,
        DATE_PART('day', (TIMESTAMP '2024-10-01 12:34:56') - p.CreationDate) AS DaysOld,
        CASE 
            WHEN DATE_PART('day', (TIMESTAMP '2024-10-01 12:34:56') - p.CreationDate) > 30 THEN 'Old'
            WHEN DATE_PART('day', (TIMESTAMP '2024-10-01 12:34:56') - p.CreationDate) > 7 THEN 'Medium'
            ELSE 'New'
        END AS AgeCategory
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
TagAnalysis AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 100 THEN 'Moderate'
            WHEN t.Count > 10 THEN 'Niche'
            ELSE 'Rare'
        END AS PopularityLevel,
        RANK() OVER (ORDER BY t.Count DESC) AS PopularityRank,
        PERCENT_RANK() OVER (ORDER BY t.Count) AS PopularityPercentile
    FROM Tags t
),
UserActivityByMonth AS (
    SELECT 
        u.Id AS UserId,
        EXTRACT(YEAR FROM p.CreationDate)::int AS Year,
        EXTRACT(MONTH FROM p.CreationDate)::int AS Month,
        COUNT(p.Id) AS PostsThisMonth,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgScore,
        MAX(p.CreationDate) AS LastActivity,
        DATE_PART('day', MAX(p.CreationDate) - MIN(p.CreationDate))::int AS ActivitySpanDays
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE p.CreationDate IS NOT NULL
    GROUP BY u.Id, EXTRACT(YEAR FROM p.CreationDate), EXTRACT(MONTH FROM p.CreationDate)
),
ComplexMetrics AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        us.TotalPosts,
        us.QuestionCount,
        us.AnswerCount,
        us.BadgeCount,
        us.ReputationRank,
        us.ReputationDecile,
        us.ViewRank,
        DENSE_RANK() OVER (ORDER BY (us.UpVotes - us.DownVotes)) AS NetVoteRank,
        CASE WHEN us.QuestionCount > 0 AND us.AnswerCount > 0 THEN CAST(us.AnswerCount AS DOUBLE PRECISION) / us.QuestionCount ELSE 0 END AS AnswersPerQuestion,
        CASE WHEN us.TotalPosts > 0 THEN CAST(us.BadgeCount AS DOUBLE PRECISION) / us.TotalPosts ELSE 0 END AS BadgesPerPost,
        CASE WHEN us.QuestionCount > 0 THEN CAST(us.QuestionCount AS DOUBLE PRECISION) / GREATEST(DATE_PART('day', (TIMESTAMP '2024-10-01 12:34:56') - u.CreationDate),1) ELSE 0 END AS QuestionsPerDay,
        CASE WHEN us.AnswerCount > 0 THEN CAST(us.AnswerCount AS DOUBLE PRECISION) / GREATEST(DATE_PART('day', (TIMESTAMP '2024-10-01 12:34:56') - u.CreationDate),1) ELSE 0 END AS AnswersPerDay,
        CASE 
            WHEN us.ViewRank <= 100 THEN 'Top_Viewed' 
            WHEN us.ReputationRank <= 100 THEN 'Top_Reputed' 
            WHEN us.ReputationRank <= 500 THEN 'High_Participant' 
            ELSE 'Regular'
        END AS ParticipantTier,
        CASE 
            WHEN us.BadgeCount > 50 THEN 'Badge_Addict'
            WHEN us.BadgeCount > 20 THEN 'Badge_Hunter'
            WHEN us.BadgeCount > 5 THEN 'Badge_Enthusiast'
            ELSE 'Regular'
        END AS BadgeEngagement,
        CASE 
            WHEN us.Reputation > 10000 THEN 'Expert'
            WHEN us.Reputation > 1000 THEN 'Advanced'
            ELSE 'Beginner'
        END AS ReputationLevel,
        CASE 
            WHEN us.BadgeCount > 0 AND us.QuestionCount > 0 THEN 
                CASE WHEN us.QuestionCount > us.BadgeCount THEN 'Question_Oriented' ELSE 'Badge_Oriented' END
            ELSE 'Neutral'
        END AS ActivityFocus
    FROM Users u
    JOIN UserStats us ON u.Id = us.UserId
    WHERE u.Reputation > 0
),
PostComplexityMetrics AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Body,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.PostTypeId,
        CHAR_LENGTH(COALESCE(p.Body, '')) AS BodyLength,
        CHAR_LENGTH(COALESCE(p.Title, '')) AS TitleLength,
        CHAR_LENGTH(COALESCE(p.Title, '')) + CHAR_LENGTH(COALESCE(p.Body, '')) AS ContentLength,
        CASE 
            WHEN CHAR_LENGTH(COALESCE(p.Body, '')) > 1000 THEN 'Long'
            WHEN CHAR_LENGTH(COALESCE(p.Body, '')) > 500 THEN 'Medium'
            WHEN CHAR_LENGTH(COALESCE(p.Body, '')) > 100 THEN 'Short'
            ELSE 'Very_Short'
        END AS BodySizeCategory,
        CASE 
            WHEN CHAR_LENGTH(COALESCE(p.Title, '')) > 50 THEN 'Long_Title'
            WHEN CHAR_LENGTH(COALESCE(p.Title, '')) > 25 THEN 'Medium_Title'
            ELSE 'Short_Title'
        END AS TitleCategory,
        CASE WHEN CHAR_LENGTH(COALESCE(p.Tags, '')) > 0 THEN 1 ELSE 0 END AS HasTags,
        CASE WHEN p.Score > 0 THEN 1 ELSE 0 END AS HasPositiveScore,
        CASE WHEN p.CommentCount > 0 THEN 1 ELSE 0 END AS HasComments,
        CASE WHEN p.AnswerCount > 0 THEN 1 ELSE 0 END AS HasAnswers,
        CASE 
            WHEN p.ViewCount > 1000 THEN 'Viral'
            WHEN p.ViewCount > 500 THEN 'Popular'
            WHEN p.ViewCount > 100 THEN 'Notable'
            ELSE 'Underground'
        END AS PopularityTier,
        CASE WHEN p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56') - INTERVAL '6 months' THEN 'Recent' ELSE 'Archived' END AS TemporalStatus,
        CASE WHEN p.PostTypeId = 1 AND p.AnswerCount > 0 AND p.Score > 5 THEN 'High_Quality_Question' ELSE 'Standard_Question' END AS QuestionQualityMetric,
        CASE WHEN p.PostTypeId = 2 AND p.Score > 2 THEN 'Useful_Answer' ELSE 'Standard_Answer' END AS AnswerQualityMetric
    FROM Posts p
    WHERE p.Body IS NOT NULL
),
FinalUserPostAnalysis AS (
    SELECT 
        cm.UserId,
        cm.DisplayName,
        cm.Reputation,
        cm.Views,
        cm.UpVotes,
        cm.DownVotes,
        cm.TotalPosts,
        cm.QuestionCount,
        cm.AnswerCount,
        cm.BadgeCount,
        cm.ReputationRank,
        cm.ReputationDecile,
        cm.ViewRank,
        cm.NetVoteRank,
        ROUND(cm.AnswersPerQuestion::numeric, 2) AS AnswersPerQuestion,
        ROUND(cm.BadgesPerPost::numeric, 2) AS BadgesPerPost,
        ROUND(cm.QuestionsPerDay::numeric, 4) AS QuestionsPerDay,
        ROUND(cm.AnswersPerDay::numeric, 4) AS AnswersPerDay,
        cm.ActivityFocus,
        cm.ReputationLevel,
        cm.BadgeEngagement,
        NULL::text AS IF_Restored,
        CASE 
            WHEN cm.TotalPosts > 100 THEN 'Highly_Active'
            WHEN cm.TotalPosts > 50 THEN 'Active'
            WHEN cm.TotalPosts > 10 THEN 'Moderate'
            ELSE 'Low'
        END AS ActivityLevel,
        CASE 
            WHEN cm.Reputation > 500 AND cm.BadgeCount > 20 THEN 'Elite'
            WHEN cm.Reputation > 200 AND cm.BadgeCount > 10 THEN 'Veteran'
            WHEN cm.Reputation > 100 THEN 'Experienced'
            ELSE 'Novice'
        END AS ExpertiseLevel,
        CASE 
            WHEN cm.Reputation > 10000 THEN (
                SELECT t.TagName 
                FROM Tags t 
                WHERE t.Count = (SELECT MAX(tt.Count) FROM Tags tt)
                LIMIT 1
            )
            ELSE 'No_Top_Tag'
        END AS TopTag,
        CASE WHEN cm.Reputation > 5000 THEN 'Senior_Member' ELSE 'Regular_Member' END AS MembershipTier
    FROM ComplexMetrics cm
)
SELECT 
    fp.UserId,
    fp.DisplayName,
    fp.Reputation,
    fp.Views,
    fp.UpVotes,
    fp.DownVotes,
    fp.TotalPosts,
    fp.QuestionCount,
    fp.AnswerCount,
    fp.BadgeCount,
    fp.ReputationRank,
    fp.ReputationDecile,
    fp.ViewRank,
    fp.NetVoteRank,
    fp.AnswersPerQuestion,
    fp.BadgesPerPost,
    fp.QuestionsPerDay,
    fp.AnswersPerDay,
    fp.ActivityFocus,
    fp.ReputationLevel,
    fp.BadgeEngagement,
    fp.ActivityLevel,
    fp.ExpertiseLevel,
    fp.TopTag,
    fp.MembershipTier,
    CASE 
        WHEN fp.NetVoteRank <= 10 THEN 'Top_Voter'
        WHEN fp.NetVoteRank <= 25 THEN 'High_Voter'
        WHEN fp.NetVoteRank <= 50 THEN 'Moderate_Voter'
        ELSE 'Low_Voter'
    END AS VotingCategory,
    CASE 
      WHEN fp.Reputation > 5000 AND fp.BadgeCount > 25 THEN (
        SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = fp.UserId AND p.PostTypeId = 1 AND p.Score > 10
      )
      ELSE 0
    END AS High_Voted_Questions,
    CASE 
      WHEN fp.AnswerCount > 0 THEN (
        SELECT AVG(AnswerCount)::numeric FROM Posts WHERE OwnerUserId = fp.UserId
      )
      ELSE 0
    END AS Avg_Question_Ans,
    CASE 
      WHEN fp.QuestionCount > 0 THEN (
        SELECT SUM(AnswerCount) FROM Posts WHERE OwnerUserId = fp.UserId AND PostTypeId = 1
      )
      ELSE 0
    END AS Total_Answers_to_Questions,
    CASE 
      WHEN fp.QuestionCount > 20 THEN (
        SELECT COUNT(*) FROM Comments c JOIN Posts p ON c.PostId = p.Id WHERE p.OwnerUserId = fp.UserId AND c.UserId = fp.UserId
      )
      ELSE 0
    END AS Self_Comment_History,
    CASE 
      WHEN fp.ViewRank <= 50 THEN (
        SELECT COUNT(*) FROM Badges b WHERE b.UserId = fp.UserId AND b.Class = 1
      )
      ELSE 0
    END AS Gold_Badge_Count,
    CASE 
      WHEN fp.ReputationRank <= 100 THEN (
        SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = fp.UserId AND p.PostTypeId = 1 AND p.Score = (
            SELECT MAX(p2.Score) FROM Posts p2 WHERE p2.OwnerUserId = fp.UserId AND p2.PostTypeId = 1
        )
      )
      ELSE 0
    END AS Max_Score_Questions
FROM FinalUserPostAnalysis fp
WHERE fp.Reputation > 100
ORDER BY fp.Reputation DESC, fp.TotalPosts DESC
OFFSET 0 LIMIT 500;