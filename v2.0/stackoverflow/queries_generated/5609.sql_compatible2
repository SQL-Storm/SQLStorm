WITH
RecentActivePosts AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.Title,
    p.OwnerUserId,
    p.CreationDate,
    p.LastActivityDate,
    p.LastEditorUserId,
    p.Tags,
    p.ViewCount,
    p.Score,
    p.CommentCount,
    p.AnswerCount,
    p.FavoriteCount,
    p.ContentLicense,
    u.Reputation,
    u.DisplayName AS OwnerDisplayName
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.LastActivityDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY
),
TaggedActivity AS (
  SELECT
    ra.PostId,
    ra.Title,
    ra.LastActivityDate,
    unnest(string_to_array(substring(ra.Tags FROM 2 FOR char_length(ra.Tags)-2), '><')) AS TagName,
    ra.Reputation,
    ra.OwnerDisplayName,
    CASE
      WHEN ra.ViewCount > 1000 THEN 'high-traffic'
      WHEN ra.ViewCount > 100 THEN 'mid-traffic'
      ELSE 'low-traffic'
    END AS TrafficBracket,
    ra.Score,
    ra.ViewCount
  FROM RecentActivePosts ra
  WHERE ra.Tags IS NOT NULL
),
TagBench AS (
  SELECT
    t.TagName,
    COUNT(*) AS PostCount,
    AVG(t.Score) AS AvgScore,
    MAX(t.Score) AS MaxScore,
    SUM(t.ViewCount) AS TotalViews
  FROM TaggedActivity t
  GROUP BY t.TagName
),
TopTags AS (
  SELECT
    tb.TagName,
    tb.PostCount,
    tb.AvgScore,
    tb.MaxScore,
    tb.TotalViews,
    ROW_NUMBER() OVER (ORDER BY tb.TotalViews DESC, tb.PostCount DESC) AS rn
  FROM TagBench tb
),
-- aggregate bounties per post (Votes may have multiple rows; sum value or BountyAmount column if exists)
PostBounties AS (
  SELECT
    v.PostId,
    SUM(COALESCE(v.BountyAmount, v.Amount, 0)) AS SumBounty
  FROM Votes v
  WHERE v.VoteTypeId IN (8,9)
  GROUP BY v.PostId
)
SELECT
  tt.TagName,
  tt.PostCount,
  tt.AvgScore,
  tt.MaxScore,
  tt.TotalViews,
  pp.PostId,
  pp.Title,
  pp.OwnerDisplayName,
  pp.CreationDate,
  pp.LastActivityDate,
  pp.Score AS PostScore,
  pp.ViewCount,
  COALESCE(pb.SumBounty, 0) AS BountySum,
  CASE
    WHEN pp.LastActivityDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '7' DAY THEN 'recent'
    ELSE 'stale'
  END AS ActivityBucket,
  STRING_AGG(DISTINCT cl.Name, ',') AS CloseReasons
FROM TopTags tt
JOIN TaggedActivity ta ON ta.TagName = tt.TagName
JOIN RecentActivePosts pp ON pp.PostId = ta.PostId
LEFT JOIN PostBounties pb ON pb.PostId = pp.PostId
LEFT JOIN PostHistory ph ON ph.PostId = pp.PostId AND ph.PostHistoryTypeId = 10
LEFT JOIN PostLinks pl ON pl.PostId = pp.PostId
LEFT JOIN CloseReasonTypes cl ON CAST(ph.Comment AS varchar) LIKE '%' || CAST(cl.Id AS varchar) || '%'
GROUP BY
  tt.TagName, tt.PostCount, tt.AvgScore, tt.MaxScore, tt.TotalViews,
  pp.PostId, pp.Title, pp.OwnerDisplayName, pp.CreationDate, pp.LastActivityDate,
  pp.Score, pp.ViewCount, pb.SumBounty, pp.LastEditorUserId, pp.Tags, pp.ContentLicense, pp.OwnerUserId
HAVING tt.PostCount > 5
ORDER BY tt.TotalViews DESC, tt.PostCount DESC
LIMIT 100;