-- {"query": "3015.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2241} 
WITH 
-- Aggregate badge counts per user
BadgeAgg AS (
    SELECT 
        UserId,
        SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges
    GROUP BY UserId
),
-- Basic user statistics
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(b.GoldBadges,0)   AS GoldBadges,
        COALESCE(b.SilverBadges,0) AS SilverBadges,
        COALESCE(b.BronzeBadges,0) AS BronzeBadges,
        qcnt.QCount,
        acnt.ACount,
        qcnt.QScoreAvg,
        acnt.AScoreAvg,
        u.CreationDate,
        u.LastAccessDate,
        (SELECT MAX(p.CreationDate) FROM Posts p WHERE p.OwnerUserId = u.Id) AS LastPostDate
    FROM Users u
    LEFT JOIN BadgeAgg b ON b.UserId = u.Id
    LEFT JOIN (
        SELECT 
            OwnerUserId,
            COUNT(*)                                   AS QCount,
            AVG(Score)::NUMERIC(10,2)                  AS QScoreAvg
        FROM Posts
        WHERE PostTypeId = 1
        GROUP BY OwnerUserId
    ) qcnt ON qcnt.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT 
            OwnerUserId,
            COUNT(*)                                   AS ACount,
            AVG(Score)::NUMERIC(10,2)                  AS AScoreAvg
        FROM Posts
        WHERE PostTypeId = 2
        GROUP BY OwnerUserId
    ) acnt ON acnt.OwnerUserId = u.Id
),
-- Recent community votes (last 30 days) per post
RecentVotes AS (
    SELECT 
        v.PostId,
        COUNT(*) FILTER (WHERE vt.Name = 'UpMod')       AS UpVotes,
        COUNT(*) FILTER (WHERE vt.Name = 'DownMod')     AS DownVotes,
        COUNT(*) FILTER (WHERE vt.Name = 'Favorite')    AS Favorites,
        MAX(v.CreationDate)                             AS LastVoteDate
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE v.CreationDate >= cast('2024-10-01' as date) - INTERVAL '30 days'
    GROUP BY v.PostId
),
-- Top tags per user (based on tag usage in questions)
TopUserTags AS (
    SELECT 
        p.OwnerUserId,
        t.TagName,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY t.Count DESC) AS rn
    FROM Posts p
    JOIN LATERAL regexp_split_to_table(p.Tags, '[><]') AS tag_raw ON true
    JOIN Tags t ON t.TagName = tag_raw
    WHERE p.PostTypeId = 1
),
-- Rank users by reputation and filter the high‑performers
RankedUsers AS (
    SELECT 
        us.*,
        ROW_NUMBER() OVER (ORDER BY us.Reputation DESC) AS RepRank
    FROM UserStats us
    WHERE us.Reputation > 10000
      AND us.LastPostDate IS NOT NULL
      AND us.LastPostDate >= cast('2024-10-01' as date) - INTERVAL '1 year'
)
-- Final result set with a UNION to inject a sentinel row
SELECT 
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.GoldBadges,
    ru.SilverBadges,
    ru.BronzeBadges,
    ru.QCount,
    ru.ACount,
    ru.QScoreAvg,
    ru.AScoreAvg,
    ru.LastPostDate,
    COALESCE(rv.UpVotes,0)      AS RecentUpVotes,
    COALESCE(rv.DownVotes,0)    AS RecentDownVotes,
    COALESCE(rv.Favorites,0)    AS RecentFavorites,
    STRING_AGG(t.TagName, ', ') FILTER (WHERE t.rn <= 5) AS Top5Tags
FROM RankedUsers ru
LEFT JOIN RecentVotes rv ON rv.PostId = (
    SELECT p.Id 
    FROM Posts p 
    WHERE p.OwnerUserId = ru.Id 
    ORDER BY p.CreationDate DESC 
    LIMIT 1
)
LEFT JOIN TopUserTags t ON t.OwnerUserId = ru.Id
GROUP BY 
    ru.Id, ru.DisplayName, ru.Reputation, ru.GoldBadges, ru.SilverBadges, ru.BronzeBadges,
    ru.QCount, ru.ACount, ru.QScoreAvg, ru.AScoreAvg, ru.LastPostDate, rv.UpVotes,
    rv.DownVotes, rv.Favorites
HAVING COUNT(*) FILTER (WHERE ru.ACount > 0) > 0
ORDER BY ru.Reputation DESC
LIMIT 50

UNION ALL

SELECT 
    NULL AS Id,
    '--- End of Report ---' AS DisplayName,
    NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL;