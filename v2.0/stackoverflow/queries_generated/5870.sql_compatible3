WITH RankedPosts AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.Title,
    p.OwnerUserId,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.Tags,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.Body,
    p.ParentId,
    p.AcceptedAnswerId,
    p.LastEditorUserId,
    p.LastEditDate,
    p.CommunityOwnedDate,
    p.ContentLicense,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation,
    u.CreationDate AS OwnerCreationDate,
    ROW_NUMBER() OVER (
      PARTITION BY p.PostTypeId
      ORDER BY
        COALESCE(p.ViewCount, 0) DESC,
        COALESCE(p.Score, 0) DESC,
        p.CreationDate ASC
    ) AS rn_by_type
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN PostLinks pl ON pl.PostId = p.Id
  LEFT JOIN Posts r ON p.ParentId = r.Id
  WHERE p.PostTypeId IN (1,2,4,5)
),
-- Replace the previous set-returning substring/generate_series approach with a pure SQL standard method:
-- Count tags by extracting substrings between '<' and '>' using a recursive CTE that is standard SQL compatible.
TagCounts AS (
  SELECT
    rp.PostId,
    COALESCE(rp.Tags, '') AS Tags
  FROM RankedPosts rp
),
SplitTags AS (
  -- iterative split: find first tag, then remainder
  SELECT
    PostId,
    Tags AS rest,
    NULL::VARCHAR AS tag,
    0 AS depth
  FROM TagCounts
  UNION ALL
  SELECT
    st.PostId,
    -- remainder after extracting first tag
    CASE
      WHEN position('>' IN st.rest) > 0 AND position('<' IN st.rest) > 0 AND position('<' IN st.rest) < position('>' IN st.rest)
      THEN substring(st.rest FROM position('>' IN st.rest) + 1)
      ELSE ''
    END AS rest,
    -- extracted tag without angle brackets and trimmed
    CASE
      WHEN position('<' IN st.rest) > 0 AND position('>' IN st.rest) > position('<' IN st.rest)
      THEN trim(both '<>' FROM substring(st.rest FROM position('<' IN st.rest) FOR position('>' IN st.rest) - position('<' IN st.rest) + 1))
      ELSE NULL
    END AS tag,
    depth + 1
  FROM SplitTags st
  WHERE st.rest <> '' AND depth < 1000
),
TagTokenCounts AS (
  SELECT
    PostId,
    COUNT(*) FILTER (WHERE tag IS NOT NULL AND tag <> '') AS TagTokenCount
  FROM SplitTags
  GROUP BY PostId
),
ComplexFilters AS (
  SELECT
    rp.PostId,
    rp.PostTypeId,
    rp.Title,
    rp.OwnerUserId,
    rp.OwnerDisplayName,
    rp.Reputation,
    rp.CreationDate,
    rp.LastActivityDate,
    rp.Score,
    rp.ViewCount,
    rp.Tags,
    rp.AnswerCount,
    rp.CommentCount,
    rp.FavoriteCount,
    rp.Body,
    rp.ParentId,
    rp.AcceptedAnswerId,
    rp.LastEditorUserId,
    rp.LastEditDate,
    rp.CommunityOwnedDate,
    rp.ContentLicense,
    CASE WHEN rp.LastEditorUserId IS NULL THEN 0 ELSE 1 END AS HasRecentEditor,
    EXISTS (
      SELECT 1
      FROM Votes v
      WHERE v.PostId = rp.PostId
        AND v.VoteTypeId = 2
        AND v.CreationDate > rp.LastActivityDate - INTERVAL '30 days'
    ) AS HasRecentUpvote,
    (SELECT COUNT(*) FROM Votes v2 WHERE v2.PostId = rp.PostId AND v2.VoteTypeId = 2) AS TotalUpvotes,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = rp.PostId) AS TotalComments,
    COALESCE(tc.TagTokenCount, 0) AS TagTokenCount,
    rp.rn_by_type
  FROM RankedPosts rp
  LEFT JOIN TagTokenCounts tc ON tc.PostId = rp.PostId
),
FilteredComplex AS (
  SELECT *
  FROM ComplexFilters
  WHERE rn_by_type = 1
    OR PostTypeId = 1
),
WindowAgg AS (
  SELECT
    cf.PostId,
    cf.PostTypeId,
    cf.Title,
    cf.OwnerUserId,
    cf.OwnerDisplayName,
    cf.Reputation,
    cf.CreationDate,
    cf.LastActivityDate,
    cf.Score,
    cf.ViewCount,
    cf.Tags,
    cf.AnswerCount,
    cf.CommentCount,
    cf.FavoriteCount,
    cf.Body,
    cf.ParentId,
    cf.AcceptedAnswerId,
    cf.LastEditorUserId,
    cf.LastEditDate,
    cf.CommunityOwnedDate,
    cf.ContentLicense,
    cf.HasRecentEditor,
    cf.HasRecentUpvote,
    cf.TotalUpvotes,
    cf.TotalComments,
    cf.TagTokenCount,
    MAX(cf.TotalUpvotes) OVER () AS MaxUpvotesAllPosts,
    MIN(cf.CreationDate) OVER () AS EarliestCreation,
    SUM(cf.TotalUpvotes) OVER () AS SumUpvotesAll
  FROM FilteredComplex cf
),
Final AS (
  SELECT
    wa.PostId,
    wa.PostTypeId,
    wa.Title,
    wa.OwnerUserId,
    wa.OwnerDisplayName,
    wa.Reputation,
    wa.CreationDate,
    wa.LastActivityDate,
    wa.Score,
    wa.ViewCount,
    wa.Tags,
    wa.AnswerCount,
    wa.CommentCount,
    wa.FavoriteCount,
    wa.Body,
    wa.ParentId,
    wa.AcceptedAnswerId,
    wa.LastEditorUserId,
    wa.LastEditDate,
    wa.CommunityOwnedDate,
    wa.ContentLicense,
    wa.HasRecentEditor,
    wa.HasRecentUpvote,
    wa.TotalUpvotes,
    wa.TotalComments,
    wa.TagTokenCount,
    wa.MaxUpvotesAllPosts,
    wa.EarliestCreation,
    wa.SumUpvotesAll,
    CASE
      WHEN wa.PostTypeId = 1 AND wa.AnswerCount IS NOT NULL THEN wa.AnswerCount * 2
      WHEN wa.PostTypeId = 2 THEN wa.Score * -1
      ELSE wa.ViewCount
    END AS EngagementScore,
    CASE
      WHEN wa.OwnerUserId IS NULL THEN NULL
      ELSE CAST(wa.OwnerUserId AS VARCHAR(20))
    END AS OwnerUserIdStr,
    CASE WHEN wa.LastEditorUserId IS NOT NULL THEN true ELSE false END AS HadLastEditor
  FROM WindowAgg wa
)
SELECT *
FROM Final
ORDER BY EngagementScore DESC NULLS LAST, LastActivityDate DESC
LIMIT 200;