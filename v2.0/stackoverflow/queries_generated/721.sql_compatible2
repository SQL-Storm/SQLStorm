with
active_users as (
  select
    u.id as user_id,
    u.displayname,
    u.reputation,
    u.creationdate,
    u.location,
    coalesce(u.websiteurl, '') as websiteurl,
    sum(case when p.posttypeid in (1,2) then greatest(1, least(5, coalesce(p.score,0))) else 0 end) as post_score_weight,
    sum(coalesce(c.score,0)) as comment_score_sum,
    count(distinct p.id) filter (where p.posttypeid in (1,2)) as authored_posts,
    count(distinct c.id) as authored_comments,
    count(distinct b.id) as badge_count
  from users u
  left join posts p
    on p.owneruserid = u.id
    and p.creationdate >= u.creationdate
  left join comments c
    on c.userid = u.id
    and c.creationdate >= u.creationdate
  left join badges b
    on b.userid = u.id
  where u.creationdate >= (select date_trunc('year', max(creationdate)) - interval '3 years' from users)
  group by u.id, u.displayname, u.reputation, u.creationdate, u.location, u.websiteurl
),
post_engagement as (
  select
    p.id,
    p.posttypeid,
    p.parentid,
    p.owneruserid,
    p.creationdate,
    p.score,
    p.viewcount,
    p.answercount,
    p.commentcount,
    p.favoritecount,
    p.tags,
    case
      when p.posttypeid = 1 and p.tags is not null and length(p.tags) >= 2
      then string_to_array(substring(p.tags, 2, length(p.tags)-2), '><')
      else null
    end as tag_arr
  from posts p
  where p.posttypeid in (1,2)
),
question_agg as (
  select
    q.id as question_id,
    q.owneruserid as asker_id,
    q.creationdate as question_date,
    q.score as question_score,
    q.viewcount as question_views,
    q.answercount as declared_answercount,
    coalesce(array_length(q.tag_arr, 1), 0) as tag_count,
    q.tag_arr,
    sum(a.score) filter (where a.id is not null) as answers_score_sum,
    avg(cast(a.score as numeric)) filter (where a.id is not null) as answers_score_avg,
    count(a.id) as answers_count_actual,
    max(case when a.id = q.acceptedanswerid then 1 else 0 end) as has_accepted_answer
  from posts q
  left join posts a
    on a.parentid = q.id and a.posttypeid = 2
  where q.posttypeid = 1
  group by q.id, q.owneruserid, q.creationdate, q.score, q.viewcount, q.answercount, q.tag_arr
),
post_activity as (
  select
    p.id as post_id,
    max(coalesce(c.creationdate, p.lastactivitydate)) as last_comment_or_activity,
    count(c.id) as comment_count,
    sum(case when v.votetypeid = 2 then 1 when v.votetypeid = 3 then -1 else 0 end) as net_votes,
    sum(case when v.votetypeid = 5 then 1 else 0 end) as favorites_count
  from posts p
  left join comments c on c.postid = p.id
  left join votes v on v.postid = p.id
  group by p.id
),
question_status as (
  select
    ph.postid as question_id,
    max(case when ph.posthistorytypeid = 10 then 1 else 0 end) as was_closed,
    max(case when ph.posthistorytypeid = 11 then 1 else 0 end) as was_reopened,
    max(case when ph.posthistorytypeid in (35,36) then 1 else 0 end) as was_migrated,
    max(ph.creationdate) filter (where ph.posthistorytypeid in (10,11,35,36)) as last_status_change,
    max(pl.relatedpostid) filter (where pl.linktypeid = 3) as duplicate_of_id
  from posthistory ph
  left join postlinks pl on pl.postid = ph.postid and pl.linktypeid = 3
  group by ph.postid
),
user_question_windows as (
  select
    qa.asker_id as user_id,
    qa.question_id,
    qa.question_date,
    sum(greatest(0, qa.question_score)) over (
      partition by qa.asker_id
      order by qa.question_date
      rows between 10 preceding and current row
    ) as rolling_pos_question_score_11,
    sum(coalesce(pa.net_votes,0)) over (
      partition by qa.asker_id
      order by qa.question_date
      range between interval '30 days' preceding and current row
    ) as rolling_net_votes_30d
  from question_agg qa
  left join post_activity pa on pa.post_id = qa.question_id
),
tag_popularity as (
  select
    lower(t.tagname) as tag,
    t.count as tag_usage_count
  from tags t
),
question_tags as (
  select
    qa.question_id,
    lower(tag) as tag
  from question_agg qa,
       lateral unnest(coalesce(qa.tag_arr, ARRAY[]::varchar[])) as tag
),
question_tag_stats as (
  select
    qt.question_id,
    avg(cast(tp.tag_usage_count as numeric)) as avg_tag_popularity,
    min(tp.tag_usage_count) as min_tag_popularity,
    max(tp.tag_usage_count) as max_tag_popularity
  from question_tags qt
  left join tag_popularity tp on tp.tag = qt.tag
  group by qt.question_id
),
user_flags as (
  select
    u.id as user_id,
    exists (
      select 1
      from posts pa
      where pa.owneruserid = u.id
        and pa.posttypeid = 2
        and pa.score < -5
      limit 1
    ) as has_controversial_answers,
    exists (
      select 1
      from posts pq
      where pq.owneruserid = u.id
        and pq.posttypeid = 1
        and pq.viewcount > 100000
      limit 1
    ) as has_viral_question
  from users u
),
question_signal as (
  select
    qa.question_id,
    qa.asker_id,
    qa.question_date,
    qa.question_score,
    qa.question_views,
    qa.declared_answercount,
    qa.answers_score_sum,
    qa.answers_score_avg,
    qa.answers_count_actual,
    qa.has_accepted_answer,
    qts.avg_tag_popularity,
    qts.min_tag_popularity,
    qts.max_tag_popularity,
    pa.comment_count as total_comments,
    pa.net_votes as net_votes_post,
    pa.favorites_count,
    qs.was_closed,
    qs.was_reopened,
    qs.was_migrated,
    qs.last_status_change,
    qs.duplicate_of_id,
    uqw.rolling_pos_question_score_11,
    uqw.rolling_net_votes_30d
  from question_agg qa
  left join question_tag_stats qts on qts.question_id = qa.question_id
  left join post_activity pa on pa.post_id = qa.question_id
  left join question_status qs on qs.question_id = qa.question_id
  left join user_question_windows uqw on uqw.question_id = qa.question_id
),
question_ranked as (
  select
    qs.question_id,
    qs.asker_id,
    qs.question_date,
    coalesce(qs.question_score,0) as question_score,
    coalesce(qs.question_views,0) as question_views,
    coalesce(qs.answers_count_actual,0) as answers_count,
    coalesce(qs.has_accepted_answer,0) as has_accepted_answer,
    coalesce(qs.net_votes_post,0) as net_votes_post,
    coalesce(qs.favorites_count,0) as favorites_count,
    coalesce(qs.avg_tag_popularity,0) as avg_tag_popularity,
    coalesce(qs.rolling_pos_question_score_11,0) as rolling_pos_question_score_11,
    coalesce(qs.rolling_net_votes_30d,0) as rolling_net_votes_30d,
    coalesce(qs.was_closed,0) as was_closed,
    coalesce(qs.was_reopened,0) as was_reopened,
    coalesce(qs.was_migrated,0) as was_migrated,
    (
      1.0 * coalesce(qs.question_score,0)
      + 0.5 * coalesce(qs.answers_count_actual,0)
      + 0.75 * coalesce(qs.has_accepted_answer,0)
      + 0.002 * coalesce(qs.question_views,0)
      + 0.3 * coalesce(qs.net_votes_post,0)
      + 0.2 * coalesce(qs.favorites_count,0)
      + 0.0001 * coalesce(qs.avg_tag_popularity,0)
      + 0.05 * coalesce(qs.rolling_pos_question_score_11,0)
      + 0.04 * coalesce(qs.rolling_net_votes_30d,0)
      - 1.5 * coalesce(qs.was_closed,0)
      + 0.5 * coalesce(qs.was_reopened,0)
      - 0.2 * coalesce(qs.was_migrated,0)
    ) as composite_score
  from question_signal qs
),
user_enriched as (
  select
    au.user_id,
    au.displayname,
    au.reputation,
    au.creationdate,
    au.location,
    au.websiteurl,
    au.post_score_weight,
    au.comment_score_sum,
    au.authored_posts,
    au.authored_comments,
    au.badge_count,
    uf.has_controversial_answers,
    uf.has_viral_question
  from active_users au
  left join user_flags uf on uf.user_id = au.user_id
),
user_question_ranks as (
  select
    qr.*,
    rank() over (partition by qr.asker_id order by qr.composite_score desc nulls last, qr.question_date desc) as rnk_desc,
    row_number() over (partition by qr.asker_id order by qr.composite_score desc nulls last, qr.question_date desc) as rn_desc,
    dense_rank() over (partition by qr.asker_id order by qr.composite_score asc nulls last, qr.question_date asc) as rnk_asc
  from question_ranked qr
),
extreme_questions as (
  (
    select asker_id, question_id, composite_score, 'TOP' as extremity
    from user_question_ranks
    where rn_desc <= 3
  )
  union all
  (
    select asker_id, question_id, composite_score, 'BOTTOM' as extremity
    from (
      select *,
             row_number() over (partition by asker_id order by composite_score asc nulls first, question_date asc) as rn_asc
      from user_question_ranks
    ) x
    where rn_asc = 1
  )
),
question_labels as (
  select
    p.id as question_id,
    coalesce(nullif(trim(p.title), ''), ('[untitled #' || cast(p.id as text) || ']')) as title_label,
    left(regexp_replace(coalesce(p.ownerdisplayname, ''), '\s+', ' ', 'g'), 40) as owner_display_sanitized
  from posts p
  where p.posttypeid = 1
),
final as (
  select
    ue.user_id,
    ue.displayname,
    ue.reputation,
    ue.location,
    ue.badge_count,
    ue.post_score_weight,
    ue.comment_score_sum,
    ue.has_controversial_answers,
    ue.has_viral_question,
    eq.extremity,
    eq.question_id,
    ql.title_label,
    ql.owner_display_sanitized,
    to_char(qr.question_date, 'YYYY-MM-DD') as question_date,
    qr.question_score,
    qr.question_views,
    qr.answers_count,
    qr.has_accepted_answer,
    qr.net_votes_post,
    qr.favorites_count,
    qr.avg_tag_popularity,
    qr.rolling_pos_question_score_11,
    qr.rolling_net_votes_30d,
    qr.was_closed,
    qr.was_reopened,
    qr.was_migrated,
    round(cast(qr.composite_score as numeric), 3) as composite_score_rounded,
    case
      when qr.composite_score is null then 'unknown'
      when qr.composite_score >= 50 then 'elite'
      when qr.composite_score >= 20 then 'strong'
      when qr.composite_score >= 5 then 'moderate'
      when qr.composite_score > 0 then 'light'
      else 'weak'
    end as performance_bucket
  from extreme_questions eq
  join question_ranked qr on qr.question_id = eq.question_id
  join user_enriched ue on ue.user_id = eq.asker_id
  left join question_labels ql on ql.question_id = eq.question_id
)
select *
from final
where
  (has_viral_question or composite_score_rounded >= 1 or extremity = 'BOTTOM')
  and not (was_migrated = 1 and performance_bucket in ('elite','strong'))
  and coalesce(location, '') not ilike '%test%'
  and (badge_count >= 1 or reputation > 1000)
order by
  performance_bucket desc,
  composite_score_rounded desc nulls last,
  reputation desc,
  user_id,
  extremity;