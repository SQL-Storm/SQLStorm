-- {"query": "7046.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 2876} 
WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        AVG(p.Score) as AvgPostScore,
        MAX(p.CreationDate) as LastPostDate,
        CASE 
            WHEN u.Reputation > 10000 THEN 'Elite'
            WHEN u.Reputation > 5000 THEN 'Veteran'
            WHEN u.Reputation > 1000 THEN 'Active'
            ELSE 'Newbie'
        END as ReputationTier,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END), 0) as QuestionCount,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END), 0) as AnswerCount
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        PostCount,
        CommentCount,
        BadgeCount,
        AvgPostScore,
        LastPostDate,
        ReputationTier,
        QuestionCount,
        AnswerCount,
        ROW_NUMBER() OVER (ORDER BY Reputation DESC, PostCount DESC) as RankByReputation,
        ROW_NUMBER() OVER (ORDER BY PostCount DESC, Reputation DESC) as RankByActivity
    FROM UserStats
),
QuestionAnalysis AS (
    SELECT 
        p.Id as QuestionId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        u.DisplayName as OwnerName,
        COUNT(DISTINCT v.Id) as VoteCount,
        COUNT(DISTINCT c.Id) as CommentCountActual,
        p.Tags,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ', ') FILTER (WHERE p.Tags IS NOT NULL) as TagList,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) as UpVotes,
        COALESCE(SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) as DownVotes,
        p.AcceptedAnswerId,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Answered'
            WHEN p.AnswerCount > 0 THEN 'Has Answers'
            ELSE 'Unanswered'
        END as Status
    FROM Posts p
    INNER JOIN Users u ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    LEFT JOIN Comments c ON p.Id = c.PostId
    WHERE p.PostTypeId = 1
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.CreationDate, p.OwnerUserId, u.DisplayName, p.Tags, p.AcceptedAnswerId
),
TopQuestions AS (
    SELECT 
        QuestionId,
        Title,
        Score,
        ViewCount,
        AnswerCount,
        CommentCountActual,
        CreationDate,
        OwnerUserId,
        OwnerName,
        VoteCount,
        TagList,
        UpVotes,
        DownVotes,
        Status,
        ROW_NUMBER() OVER (ORDER BY Score DESC, ViewCount DESC) as RankByScore,
        ROW_NUMBER() OVER (ORDER BY ViewCount DESC, Score DESC) as RankByPopularity
    FROM QuestionAnalysis
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Body,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.PostTypeId,
        pt.Name as PostTypeName,
        p.OwnerUserId,
        u.DisplayName as OwnerName,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            WHEN p.PostTypeId = 4 THEN 'Tag Wiki Excerpt'
            WHEN p.PostTypeId = 5 THEN 'Tag Wiki'
            ELSE 'Other'
        END as PostTypeDesc,
        p.ParentId,
        COALESCE(p.ParentId, 0) as EffectiveParentId,
        CASE 
            WHEN p.PostTypeId = 2 THEN 'Answer to Question ' + CAST(p.ParentId AS VARCHAR)
            ELSE 'Not an answer'
        END as AnswerTarget,
        LENGTH(p.Body) as BodyLength,
        CHARINDEX('[', p.Body) as FirstCodeBlockPos,
        CASE 
            WHEN p.Body LIKE '%<code>%' THEN 'Contains Code'
            WHEN p.Body LIKE '%`%`%' THEN 'Contains Inline Code'
            ELSE 'No Code'
        END as CodePresence,
        COALESCE(p.AcceptedAnswerId, 0) as AcceptedAnswer,
        COALESCE(p.ClosedDate, p.CommunityOwnedDate, NULL) as ClosureEvent,
        p.ContentLicense,
        1.0 * COALESCE(p.Score, 0) / NULLIF(COALESCE(p.ViewCount, 1), 0) as ScoreToViewRatio,
        DATEDIFF(DAY, p.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) as AgeInDays
    FROM Posts p
    LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId IN (1, 2, 3)
)
SELECT 
    'Performance Benchmark Report' as ReportTitle,
    COUNT(*) as TotalUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation > 10000 THEN u.Id END) as EliteUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation > 5000 THEN u.Id END) as VeteranUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation > 1000 THEN u.Id END) as ActiveUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation <= 1000 THEN u.Id END) as NewbieUsers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as TotalQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as TotalAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 3 THEN p.Id END) as TotalWikis,
    AVG(u.Reputation) as AvgReputation,
    AVG(p.Score) as AvgScore,
    AVG(p.ViewCount) as AvgViews,
    SUM(u.UpVotes) as TotalUpVotes,
    SUM(u.DownVotes) as TotalDownVotes,
    STRING_AGG(DISTINCT ta.DisplayName, ', ') FILTER (WHERE ta.UserId IS NOT NULL) as TopActiveUsers,
    STRING_AGG(DISTINCT tq.Title, ', ') FILTER (WHERE tq.Score > 100) as HighScoreQuestions,
    STRING_AGG(DISTINCT CASE WHEN pa.CodePresence = 'Contains Code' THEN pa.Title END, ', ') FILTER (WHERE pa.CodePresence = 'Contains Code') as CodeContainingPosts,
    MAX(tu.Reputation) as MaxReputation,
    MIN(tu.Reputation) as MinReputation,
    AVG(tu.PostCount) as AvgPostCountPerUser,
    AVG(tq.ViewCount) as AvgViewCount,
    AVG(tq.Score) as AvgQuestionScore,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY u.Reputation) as MedianReputation,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY p.Score) as Score75thPercentile,
    COUNT(DISTINCT CASE WHEN p.CreationDate >= DATEADD(MONTH, -6, cast('2024-10-01 12:34:56' as timestamp)) THEN p.Id END) as RecentActivity,
    COUNT(DISTINCT CASE WHEN p.LastActivityDate >= DATEADD(DAY, -1, cast('2024-10-01 12:34:56' as timestamp)) THEN p.Id END) as TodayActivity,
    (SELECT COUNT(*) FROM Posts p2 WHERE p2.PostTypeId = 1 AND p2.Score > 100 AND p2.ViewCount > 1000) as HighScoreHighViewQuestions,
    (SELECT COUNT(*) FROM Posts p3 WHERE p3.PostTypeId = 1 AND p3.AnswerCount = 0 AND p3.CreationDate >= DATEADD(WEEK, -1, cast('2024-10-01 12:34:56' as timestamp))) as RecentUnansweredQuestions,
    (SELECT COUNT(*) FROM Posts p4 WHERE p4.PostTypeId = 2 AND p4.Score > 50 AND p4.OwnerUserId IN (SELECT u5.Id FROM Users u5 WHERE u5.Reputation > 5000)) as HighQualityAnswersFromEliteUsers,
    (SELECT COUNT(*) FROM Votes v2 WHERE v2.VoteTypeId = 2 AND v2.CreationDate >= DATEADD(WEEK, -1, cast('2024-10-01 12:34:56' as timestamp))) as RecentUpVotes
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
LEFT JOIN TopUsers tu ON u.Id = tu.UserId
LEFT JOIN TopQuestions tq ON tq.QuestionId = p.Id
LEFT JOIN QuestionAnalysis qa ON qa.QuestionId = p.Id
LEFT JOIN PostAnalysis pa ON pa.PostId = p.Id
LEFT JOIN TopActive ta ON ta.UserId = u.Id
WHERE u.Id IS NOT NULL
HAVING COUNT(*) > 0
UNION ALL
SELECT 
    'Detailed Analysis Report' as ReportTitle,
    COUNT(*) as TotalUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation > 10000 THEN u.Id END) as EliteUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation > 5000 THEN u.Id END) as VeteranUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation > 1000 THEN u.Id END) as ActiveUsers,
    COUNT(DISTINCT CASE WHEN u.Reputation <= 1000 THEN u.Id END) as NewbieUsers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as TotalQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as TotalAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 3 THEN p.Id END) as TotalWikis,
    AVG(u.Reputation) as AvgReputation,
    AVG(p.Score) as AvgScore,
    AVG(p.ViewCount) as AvgViews,
    SUM(u.UpVotes) as TotalUpVotes,
    SUM(u.DownVotes) as TotalDownVotes,
    STRING_AGG(DISTINCT ta.DisplayName, ', ') FILTER (WHERE ta.UserId IS NOT NULL) as TopActiveUsers,
    STRING_AGG(DISTINCT tq.Title, ', ') FILTER (WHERE tq.Score > 100) as HighScoreQuestions,
    STRING_AGG(DISTINCT CASE WHEN pa.CodePresence = 'Contains Code' THEN pa.Title END, ', ') FILTER (WHERE pa.CodePresence = 'Contains Code') as CodeContainingPosts,
    MAX(tu.Reputation) as MaxReputation,
    MIN(tu.Reputation) as MinReputation,
    AVG(tu.PostCount) as AvgPostCountPerUser,
    AVG(tq.ViewCount) as AvgViewCount,
    AVG(tq.Score) as AvgQuestionScore,
    PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY u.Reputation) as MedianReputation,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY p.Score) as Score75thPercentile,
    COUNT(DISTINCT CASE WHEN p.CreationDate >= DATEADD(MONTH, -6, cast('2024-10-01 12:34:56' as timestamp)) THEN p.Id END) as RecentActivity,
    COUNT(DISTINCT CASE WHEN p.LastActivityDate >= DATEADD(DAY, -1, cast('2024-10-01 12:34:56' as timestamp)) THEN p.Id END) as TodayActivity,
    (SELECT COUNT(*) FROM Posts p2 WHERE p2.PostTypeId = 1 AND p2.Score > 100 AND p2.ViewCount > 1000) as HighScoreHighViewQuestions,
    (SELECT COUNT(*) FROM Posts p3 WHERE p3.PostTypeId = 1 AND p3.AnswerCount = 0 AND p3.CreationDate >= DATEADD(WEEK, -1, cast('2024-10-01 12:34:56' as timestamp))) as RecentUnansweredQuestions,
    (SELECT COUNT(*) FROM Posts p4 WHERE p4.PostTypeId = 2 AND p4.Score > 50 AND p4.OwnerUserId IN (SELECT u5.Id FROM Users u5 WHERE u5.Reputation > 5000)) as HighQualityAnswersFromEliteUsers,
    (SELECT COUNT(*) FROM Votes v2 WHERE v2.VoteTypeId = 2 AND v2.CreationDate >= DATEADD(WEEK, -1, cast('2024-10-01 12:34:56' as timestamp))) as RecentUpVotes
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
LEFT JOIN TopUsers tu ON u.Id = tu.UserId
LEFT JOIN TopQuestions tq ON tq.QuestionId = p.Id
LEFT JOIN QuestionAnalysis qa ON qa.QuestionId = p.Id
LEFT JOIN PostAnalysis pa ON pa.PostId = p.Id
LEFT JOIN TopActive ta ON ta.UserId = u.Id
WHERE u.Id IS NOT NULL AND u.Reputation > 1000
HAVING COUNT(*) > 0
ORDER BY ReportTitle;