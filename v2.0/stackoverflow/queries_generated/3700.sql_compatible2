WITH
    RecentPosts AS (
        SELECT
            p.Id,
            p.PostTypeId,
            p.CreationDate,
            p.OwnerUserId,
            p.Title,
            p.Tags,
            ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
        FROM Posts p
        WHERE p.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '30 days'
    ),
    UserStats AS (
        SELECT
            u.Id AS UserId,
            u.DisplayName,
            u.Reputation,
            COALESCE(b.GoldCnt, 0)   AS GoldBadges,
            COALESCE(b.SilverCnt, 0) AS SilverBadges,
            COALESCE(b.BronzeCnt, 0) AS BronzeBadges,
            COALESCE(p.PostCnt, 0)   AS PostCount,
            COALESCE(v.UpCnt, 0)     AS UpVotes,
            COALESCE(v.DownCnt, 0)   AS DownVotes
        FROM Users u
        LEFT JOIN (
            SELECT
                UserId,
                SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldCnt,
                SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverCnt,
                SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeCnt
            FROM Badges
            GROUP BY UserId
        ) b ON u.Id = b.UserId
        LEFT JOIN (
            SELECT OwnerUserId, COUNT(*) AS PostCnt
            FROM Posts
            GROUP BY OwnerUserId
        ) p ON u.Id = p.OwnerUserId
        LEFT JOIN (
            SELECT
                UserId,
                SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpCnt,
                SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownCnt
            FROM Votes
            GROUP BY UserId
        ) v ON u.Id = v.UserId
    ),
    TagStats AS (
        SELECT
            t.TagName,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
            SUM(p.Score)                                 AS TotalScore,
            MAX(p.CreationDate)                          AS LatestActivity
        FROM Tags t
        LEFT JOIN LATERAL (
            SELECT *
            FROM Posts p
            WHERE p.PostTypeId IN (1, 2)
              AND p.Tags IS NOT NULL
              AND POSITION('<' || t.TagName || '>' IN p.Tags) > 0
        ) p ON TRUE
        GROUP BY t.TagName
        HAVING COUNT(p.Id) > 0
    ),
    ClosedQuestions AS (
        SELECT
            p.Id,
            p.Title,
            p.OwnerUserId,
            ph.CreationDate                               AS ClosedDate,
            CASE
              WHEN ph.Comment ~ '^[0-9]+$' THEN CAST(ph.Comment AS INTEGER)
              ELSE NULL
            END AS CloseReasonId
        FROM Posts p
        LEFT JOIN PostHistory ph
            ON ph.PostId = p.Id
           AND ph.PostHistoryTypeId = 10
        WHERE p.PostTypeId = 1
          AND ph.Id IS NOT NULL
    )
SELECT
    us.UserId,
    us.DisplayName,
    us.Reputation,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.PostCount,
    us.UpVotes,
    us.DownVotes,
    rp.Title                     AS RecentPostTitle,
    rp.CreationDate              AS RecentPostDate,
    COALESCE(cq.CloseReasonId, 0) AS LastCloseReason,
    ts.TagName,
    ts.QuestionCount,
    ts.AnswerCount,
    ts.TotalScore,
    ROW_NUMBER() OVER (PARTITION BY us.UserId ORDER BY rp.CreationDate DESC NULLS LAST) AS RecentPostRank
FROM UserStats us
LEFT JOIN RecentPosts rp
    ON rp.OwnerUserId = us.UserId
   AND rp.rn = 1
LEFT JOIN LATERAL (
    SELECT
        cq2.CloseReasonId
    FROM ClosedQuestions cq2
    WHERE cq2.OwnerUserId = us.UserId
    ORDER BY cq2.ClosedDate DESC
    LIMIT 1
) cq ON TRUE
LEFT JOIN LATERAL (
    SELECT
        t.TagName,
        t.QuestionCount,
        t.AnswerCount,
        t.TotalScore
    FROM TagStats t
    WHERE t.TagName = ANY (string_to_array(TRIM(BOTH '><' FROM COALESCE(rp.Tags, '')), '><'))
    ORDER BY t.TotalScore DESC
    LIMIT 1
) ts ON TRUE
WHERE us.Reputation > 1000
  AND (us.PostCount >= 10 OR us.UpVotes - us.DownVotes > 0)
ORDER BY us.Reputation DESC, us.GoldBadges DESC
LIMIT 100

UNION ALL

SELECT CAST(NULL AS INTEGER)    AS UserId,
       CAST(NULL AS VARCHAR)    AS DisplayName,
       CAST(NULL AS INTEGER)    AS Reputation,
       CAST(NULL AS INTEGER)    AS GoldBadges,
       CAST(NULL AS INTEGER)    AS SilverBadges,
       CAST(NULL AS INTEGER)    AS BronzeBadges,
       CAST(NULL AS INTEGER)    AS PostCount,
       CAST(NULL AS INTEGER)    AS UpVotes,
       CAST(NULL AS INTEGER)    AS DownVotes,
       CAST(NULL AS VARCHAR)    AS RecentPostTitle,
       CAST(NULL AS TIMESTAMP)  AS RecentPostDate,
       CAST(NULL AS INTEGER)    AS LastCloseReason,
       CAST(NULL AS VARCHAR)    AS TagName,
       CAST(NULL AS BIGINT)     AS QuestionCount,
       CAST(NULL AS BIGINT)     AS AnswerCount,
       CAST(NULL AS BIGINT)     AS TotalScore,
       CAST(NULL AS BIGINT)     AS RecentPostRank
FROM (SELECT 1) dummy
WHERE FALSE;