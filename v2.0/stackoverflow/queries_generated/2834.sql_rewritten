-- {"query": "2834.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 2138} 
with RecursiveTagHierarchy as (
    select 
        t.Id,
        t.TagName,
        coalesce(t.Count,0) as Count,
        1 as Level,
        cast(t.TagName as varchar(1000)) as Path
    from Tags t
    where t.IsModeratorOnly = 0 and t.IsRequired = 0
    union all
    select 
        t2.Id,
        t2.TagName,
        coalesce(t2.Count,0),
        r.Level + 1,
        r.Path || '>' || t2.TagName
    from Tags t2
    join RecursiveTagHierarchy r on r.Id <> t2.Id and length(r.Path) < 100
    where t2.IsModeratorOnly = 0 and t2.IsRequired = 0
),
UserActivity as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionsPosted,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswersPosted,
        count(distinct v.Id) filter (where v.VoteTypeId = 2) as UpVotesReceived,
        count(distinct v2.Id) filter (where v2.VoteTypeId = 3) as DownVotesReceived,
        count(distinct b.Id) as BadgesEarned,
        max(p.Score) over(partition by u.Id) as MaxPostScore,
        avg(coalesce(p.Score,0)) filter (where p.OwnerUserId = u.Id) as AvgPostScore,
        min(u.CreationDate) as UserCreated,
        max(u.LastAccessDate) as LastAccess
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.PostId = p.Id and v.VoteTypeId = 2
    left join Votes v2 on v2.PostId = p.Id and v2.VoteTypeId = 3
    left join Badges b on b.UserId = u.Id
    where u.Reputation > 1000
    group by u.Id, u.DisplayName, u.Reputation
),
PostComplex as (
    select 
        p.Id as PostId,
        p.PostTypeId,
        pt.Name as PostTypeName,
        p.OwnerUserId,
        u.DisplayName as OwnerName,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.LastActivityDate,
        p.Tags,
        coalesce(p.AnswerCount,0) as AnswerCount,
        p.AcceptedAnswerId,
        lag(p.Score) over (partition by p.OwnerUserId order by p.CreationDate) as PrevScore,
        lead(p.Score) over (partition by p.OwnerUserId order by p.CreationDate) as NextScore,
        case 
            when p.AcceptedAnswerId is not null then 1
            else 0
        end as HasAcceptedAnswer,
        EXISTS (
            select 1 from Comments c 
            where c.PostId = p.Id and (c.Text ilike '%thanks%' or c.Text ilike '%thank you%')
        ) as HasThankfulComment,
        p.Body,
        length(p.Body) as BodyLength,
        (select count(distinct pl2.RelatedPostId) 
            from PostLinks pl2 where pl2.PostId = p.Id) as RelatedPostCount
    from Posts p
    join PostTypes pt on pt.Id = p.PostTypeId
    left join Users u on u.Id = p.OwnerUserId
    where p.CreationDate > (cast('2024-10-01' as date) - interval '1 year')
),
QuestionAndAnswers as (
    select 
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.OwnerUserId as QuestionOwner,
        q.Score as QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        q.AcceptedAnswerId,
        array_agg(a.Id) filter (where a.Id is not null) as AnswerIds,
        array_agg(a.Score) filter (where a.Id is not null) as AnswerScores,
        sum(a.Score) filter (where a.Id is not null) as TotalAnswerScore,
        max(a.Score) filter (where a.Id is not null) as MaxAnswerScore,
        min(a.Score) filter (where a.Id is not null) as MinAnswerScore,
        greatest(q.Score, coalesce(max(a.Score), 0)) as MaxScoreBetweenQandA
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1 and q.CreationDate > (cast('2024-10-01' as date) - interval '1 year')
    group by q.Id, q.Title, q.Tags, q.OwnerUserId, q.Score, q.ViewCount, q.AnswerCount, q.AcceptedAnswerId
),
ClosingReasonsCount as (
    select 
        cht.Name as CloseReason,
        count(distinct ph.PostId) as ClosedPostsCount
    from PostHistory ph
    join PostHistoryTypes chtp on ph.PostHistoryTypeId = chtp.Id
    join CloseReasonTypes cht on ph.Comment::int = cht.Id
    where ph.PostHistoryTypeId = 10 and ph.Comment ~ '^\d+$' -- only numeric comment for close reasons
    group by cht.Name
    order by ClosedPostsCount desc
),
UsersWithBadgeRanks as (
    select
        u.Id as UserId,
        u.DisplayName,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
RecentActiveUsers as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        ua.QuestionsPosted,
        ua.AnswersPosted,
        ua.BadgesEarned,
        ua.MaxPostScore,
        ua.AvgPostScore,
        row_number() over (order by u.Reputation desc, ua.QuestionsPosted desc) as RankByRepAndQuestions
    from Users u
    join UserActivity ua on ua.UserId = u.Id
    where u.LastAccessDate > (cast('2024-10-01' as date) - interval '3 months')
),
PostsWithVotes as (
    select 
        p.Id as PostId,
        p.Title,
        p.PostTypeId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as TotalUpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as TotalDownVotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as TotalFavorites,
        count(v.Id) as TotalVotes,
        coalesce(avg(case when v.VoteTypeId = 2 then 1 else 0 end)::float, 0) as AvgUpVotes,
        coalesce(avg(case when v.VoteTypeId = 3 then 1 else 0 end)::float, 0) as AvgDownVotes
    from Posts p
    left join Votes v on v.PostId = p.Id
    group by p.Id, p.Title, p.PostTypeId
),
UserCommentSentiment as (
    select 
        c.UserId,
        u.DisplayName,
        count(c.Id) as CommentCount,
        count(case when c.Text ilike '%error%' or c.Text ilike '%fail%' then 1 end) as NegativeComments,
        count(case when c.Text ilike '%thank%' or c.Text ilike '%thanks%' then 1 end) as PositiveComments,
        avg(length(c.Text)) filter (where c.Text is not null) as AvgCommentLength
    from Comments c
    join Users u on u.Id = c.UserId
    group by c.UserId, u.DisplayName
)
select
    rau.RankByRepAndQuestions,
    rau.DisplayName as UserName,
    rau.Reputation,
    rau.QuestionsPosted,
    rau.AnswersPosted,
    ubd.GoldBadges,
    ubd.SilverBadges,
    ubd.BronzeBadges,
    round(rau.MaxPostScore,2) as MaxPostScore,
    round(rau.AvgPostScore,2) as AvgPostScore,
    pq.QuestionId,
    pq.Title as QuestionTitle,
    pq.AnswerCount,
    pq.TotalAnswerScore,
    pq.MaxAnswerScore,
    c.CloseReason,
    c.ClosedPostsCount,
    pvw.PostId,
    pvw.TotalUpVotes,
    pvw.TotalDownVotes,
    pvw.TotalFavorites,
    ucs.CommentCount,
    ucs.NegativeComments,
    ucs.PositiveComments,
    ucs.AvgCommentLength,
    rth.Level as TagHierarchyLevel,
    rth.Path as TagPath
from RecentActiveUsers rau
left join UsersWithBadgeRanks ubd on ubd.UserId = rau.UserId
left join QuestionAndAnswers pq on pq.QuestionOwner = rau.UserId and pq.AnswerCount > 0
left join ClosingReasonsCount c on c.CloseReason in ('Duplicate', 'Off-topic')
left join PostsWithVotes pvw on pvw.PostTypeId = 1 and pvw.PostId = pq.QuestionId
left join UserCommentSentiment ucs on ucs.UserId = rau.UserId
left join RecursiveTagHierarchy rth on rth.TagName = substring(split_part(pq.Tags, '><', 1) from 2 for char_length(split_part(pq.Tags, '><', 1)) -1)
where rau.QuestionsPosted > 5 and rau.AnswersPosted > 5
order by rau.RankByRepAndQuestions, pq.TotalAnswerScore desc
limit 100;