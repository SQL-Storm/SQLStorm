WITH QuestionCounts AS (
    SELECT
        p.OwnerUserId,
        COUNT(p.Id) AS TotalQuestions,
        SUM(CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END) AS ClosedQuestions,
        AVG(p.AnswerCount) AS AvgAnswersPerQuestion,
        MAX(p.FavoriteCount) AS MaxFavorites
    FROM Posts p
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId
),
AnswerMetrics AS (
    SELECT
        a.OwnerUserId,
        COUNT(a.Id) AS TotalAnswers,
        AVG(a.Score) AS AvgAnswerScore,
        SUM(CASE WHEN a.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) AS AcceptedAnswerCount
    FROM Posts a
    JOIN Posts q ON a.ParentId = q.Id
    WHERE a.PostTypeId = 2
    GROUP BY a.OwnerUserId
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Views AS ProfileViews,
        COALESCE(qc.TotalQuestions, 0) AS NumQuestions,
        COALESCE(qc.ClosedQuestions, 0) AS NumClosedQuestions,
        qc.AvgAnswersPerQuestion,
        qc.MaxFavorites,
        COALESCE(am.TotalAnswers, 0) AS NumAnswers,
        am.AvgAnswerScore,
        am.AcceptedAnswerCount,
        (SELECT COUNT(*) FROM Comments c WHERE c.UserId = u.Id AND c.Score > 5) AS HighScoreComments,
        (SELECT COUNT(*) FROM Votes v WHERE v.UserId = u.Id AND v.VoteTypeId = 2 AND v.CreationDate > (CAST('2024-10-01' AS date) - INTERVAL '1 year')) AS RecentUpvotesGiven
    FROM Users u
    LEFT JOIN QuestionCounts qc ON u.Id = qc.OwnerUserId
    LEFT JOIN AnswerMetrics am ON u.Id = am.OwnerUserId
),
TagPopularity AS (
    SELECT
        t.TagName,
        t.Count AS TagCount,
        COUNT(DISTINCT pt.OwnerUserId) AS DistinctQuestioners,
        SUM(pt.AnswerCount) AS TotalAnswersForTag
    FROM Tags t
    JOIN Posts pt ON pt.Tags LIKE '%' || t.TagName || '%' AND pt.PostTypeId = 1
    GROUP BY t.TagName, t.Count
    HAVING t.Count > 1000
),
RecentClosedQuestions AS (
    SELECT
        PostId,
        Comment AS CloseReasonComment,
        CreationDate AS CloseDate,
        COALESCE(UserId, OwnerUserId) AS UserId
    FROM PostHistory
    WHERE PostHistoryTypeId = 10
      AND CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '30 days')
)
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.CreationDate,
    ua.ProfileViews,
    ua.NumQuestions,
    ua.NumClosedQuestions,
    ROUND(ua.AvgAnswersPerQuestion, 2) AS AvgAnswersPerQuestion,
    ua.MaxFavorites,
    ua.NumAnswers,
    ROUND(ua.AvgAnswerScore, 2) AS AvgAnswerScore,
    ua.AcceptedAnswerCount,
    ua.HighScoreComments,
    ua.RecentUpvotesGiven,
    tp.TagName AS MostPopularTagName,
    tp.TagCount AS MostPopularTagCount,
    tp.DistinctQuestioners AS DistinctUsersAskingTag,
    tp.TotalAnswersForTag AS TotalAnswersForPopularTag,
    CASE
        WHEN ua.Reputation > 10000 THEN 'High Reputation'
        WHEN ua.Reputation > 1000 THEN 'Medium Reputation'
        ELSE 'Low Reputation'
    END AS ReputationLevel,
    COALESCE(rcq.CloseReasonComment, 'No Recent Close Reason') AS RecentCloseReason,
    DENSE_RANK() OVER (ORDER BY ua.Reputation DESC) AS ReputationRank,
    ROW_NUMBER() OVER (PARTITION BY CASE WHEN ua.Reputation > 1000 THEN 'High' ELSE 'Low' END ORDER BY ua.CreationDate DESC) AS RecentUserNumber
FROM UserActivity ua
LEFT JOIN TagPopularity tp ON tp.TagName = (SELECT TagName FROM TagPopularity ORDER BY TagCount DESC LIMIT 1)
LEFT JOIN RecentClosedQuestions rcq ON ua.UserId = (SELECT UserId FROM RecentClosedQuestions ORDER BY CloseDate DESC LIMIT 1)
WHERE ua.NumQuestions > 5 OR ua.NumAnswers > 10

UNION ALL

SELECT
    NULL AS UserId,
    'System Aggregate' AS DisplayName,
    AVG(ua.Reputation) AS Reputation,
    MIN(ua.CreationDate) AS CreationDate,
    SUM(ua.ProfileViews) AS ProfileViews,
    SUM(ua.NumQuestions) AS NumQuestions,
    SUM(ua.NumClosedQuestions) AS NumClosedQuestions,
    AVG(ua.AvgAnswersPerQuestion) AS AvgAnswersPerQuestion,
    MAX(ua.MaxFavorites) AS MaxFavorites,
    SUM(ua.NumAnswers) AS NumAnswers,
    AVG(ua.AvgAnswerScore) AS AvgAnswerScore,
    SUM(ua.AcceptedAnswerCount) AS AcceptedAnswerCount,
    SUM(ua.HighScoreComments) AS HighScoreComments,
    SUM(ua.RecentUpvotesGiven) AS RecentUpvotesGiven,
    'Overall Average' AS MostPopularTagName,
    AVG(tp.TagCount) AS MostPopularTagCount,
    SUM(tp.DistinctQuestioners) AS DistinctUsersAskingTag,
    SUM(tp.TotalAnswersForTag) AS TotalAnswersForPopularTag,
    'Aggregate Level' AS ReputationLevel,
    'N/A' AS RecentCloseReason,
    CAST(NULL AS BIGINT) AS ReputationRank,
    CAST(NULL AS BIGINT) AS RecentUserNumber
FROM UserActivity ua
LEFT JOIN TagPopularity tp ON tp.TagName = (SELECT TagName FROM TagPopularity ORDER BY TagCount DESC LIMIT 1);