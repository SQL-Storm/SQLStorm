LEFT JOIN TagFrequency tf ON 1 = 1
LEFT JOIN UserBadges ub ON ru.UserId = ub.UserId
WHERE ru.UserId IS NOT NULL
AND qa.QuestionId IS NOT NULL
AND (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1 AND OwnerUserId = ru.UserId) > 0
