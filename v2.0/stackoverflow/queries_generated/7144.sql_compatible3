WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COALESCE(SUM(p.Score), 0) as TotalScore,
        MAX(p.CreationDate) as LastPostDate,
        EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - MAX(p.CreationDate))) / 86400.0 as DaysSinceLastPost,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                CASE 
                    WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 0 
                    THEN (COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) * 100.0 / COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END))
                    ELSE 0 
                END
            ELSE 0 
        END as AnswerToQuestionRatio
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    WHERE u.Id > 0
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
RankedUsers AS (
    SELECT 
        uas.*,
        ROW_NUMBER() OVER (ORDER BY TotalScore DESC) as ScoreRank,
        ROW_NUMBER() OVER (ORDER BY Reputation DESC) as RepRank,
        DENSE_RANK() OVER (ORDER BY TotalPosts DESC) as PostRank,
        NTILE(4) OVER (ORDER BY TotalScore DESC) as ScoreQuartile
    FROM UserActivityStats uas
),
QuestionAnalysis AS (
    SELECT 
        q.Id as QuestionId,
        q.Title,
        q.Score,
        q.ViewCount,
        q.AnswerCount,
        q.CommentCount,
        q.CreationDate,
        u.DisplayName as AuthorName,
        u.Reputation as AuthorReputation,
        CASE 
            WHEN q.AcceptedAnswerId IS NOT NULL THEN 'Yes' 
            ELSE 'No' 
        END as HasAcceptedAnswer,
        (SELECT COUNT(*) FROM Posts a WHERE a.ParentId = q.Id AND a.PostTypeId = 2) as TotalAnswers,
        (SELECT COUNT(*) FROM Posts a WHERE a.ParentId = q.Id AND a.PostTypeId = 2 AND a.Score > 0) as PositiveAnswers,
        COALESCE(q.Tags, '') as Tags,
        (SELECT array_agg(tag) FROM UNNEST(string_to_array(SUBSTRING(q.Tags FROM 2 FOR CHAR_LENGTH(q.Tags)-2), '><')) AS tag) as TagArray,
        CASE 
            WHEN q.ViewCount > 0 THEN (q.Score * 100.0 / q.ViewCount) 
            ELSE 0 
        END as ScorePerView,
        EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - q.CreationDate)) / 86400.0 as DaysOld
    FROM Posts q
    INNER JOIN Users u ON q.OwnerUserId = u.Id
    WHERE q.PostTypeId = 1 
    AND q.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '365 days')
),
TagFrequency AS (
    SELECT 
        tag,
        COUNT(*) as Frequency,
        AVG(1.0 * Score) as AvgScorePerTag,
        COUNT(DISTINCT QuestionId) as QuestionCount,
        AVG(ViewCount) as AvgViewsPerTag,
        COUNT(DISTINCT AuthorName) as AuthorCount,
        STRING_AGG(DISTINCT AuthorName, ', ') as TagAuthors
    FROM (
        SELECT 
            q.Id as QuestionId,
            q.Score,
            q.ViewCount,
            q.OwnerUserId,
            u.DisplayName as AuthorName,
            tag
        FROM Posts q
        INNER JOIN Users u ON q.OwnerUserId = u.Id
        CROSS JOIN LATERAL UNNEST(string_to_array(SUBSTRING(q.Tags FROM 2 FOR CHAR_LENGTH(q.Tags)-2), '><')) AS tag
        WHERE q.PostTypeId = 1 
        AND q.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '365 days')
    ) t
    GROUP BY tag
    HAVING COUNT(*) > 1
),
UserBadges AS (
    SELECT 
        b.UserId,
        COUNT(*) as TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) as GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) as SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) as BronzeBadges,
        STRING_AGG(b.Name, ', ') as BadgeList,
        MAX(b.Date) as LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
)
SELECT 
