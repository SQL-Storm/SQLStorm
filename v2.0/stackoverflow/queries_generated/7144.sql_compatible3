    (SELECT COUNT(DISTINCT QuestionId) FROM QuestionAnalysis WHERE DaysOld <= 7) as RecentQuestions,
    (SELECT COUNT(DISTINCT QuestionId) FROM QuestionAnalysis WHERE DaysOld > 7 AND DaysOld <= 30) as RecentMonthlyQuestions,
    (SELECT COUNT(DISTINCT QuestionId) FROM QuestionAnalysis WHERE DaysOld > 30) as OlderQuestions,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1 AND ParentId IS NOT NULL) as AnsweredQuestions,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 2 AND ParentId IS NOT NULL) as TotalAnswers,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1 AND AnswerCount = 0) as UnansweredQuestions,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 2 AND Score < 0) as NegativeScoreAnswers,
    (SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1 AND Score < 0) as NegativeScoreQuestions,
    (SELECT COUNT(DISTINCT OwnerUserId) FROM Posts WHERE PostTypeId = 1 AND OwnerUserId IS NOT NULL) as ActiveQuestionAuthors,
    (SELECT COUNT(DISTINCT OwnerUserId) FROM Posts WHERE PostTypeId = 2 AND OwnerUserId IS NOT NULL) as ActiveAnswerAuthors,
    (SELECT COUNT(DISTINCT UserId) FROM Votes WHERE VoteTypeId IN (1,2,3)) as ActiveVoters,
    (SELECT COUNT(DISTINCT PostId) FROM Comments) as CommentedPosts,
    (SELECT COUNT(*) FROM Comments WHERE Text LIKE '%help%') as HelpRequestComments,
    (SELECT COUNT(*) FROM Posts WHERE ContentLicense NOT IN ('CC BY-SA 2.5', 'CC BY-SA 3.0', 'CC BY-SA 4.0', 'Public Domain')) as NonStandardLicensePosts,
    (SELECT COUNT(*)
     FROM Posts p1
     INNER JOIN Posts p2 ON p1.ParentId = p2.Id
     WHERE p1.PostTypeId = 2 AND p2.PostTypeId = 1 AND p2.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days')
    ) as RecentAnsweredQuestions,
    (SELECT COUNT(DISTINCT (TagArray[1])) FROM QuestionAnalysis WHERE array_length(TagArray,1) > 0) as UniqueTags,
    (SELECT COUNT(DISTINCT u.Id) 
     FROM Users u 
     LEFT JOIN Posts p ON u.Id = p.OwnerUserId 
     WHERE p.Id IS NULL
    ) as NonActiveUsers,
    (SELECT AVG(AnswerToQuestionRatio) FROM RankedUsers) as AvgAnswerToQuestionRatio,
    (SELECT COUNT(*) 
     FROM Posts p1 
     INNER JOIN Posts p2 ON p1.Id = p2.AcceptedAnswerId 
     WHERE p2.PostTypeId = 2 AND p1.PostTypeId = 1
    ) as AcceptedAnswers,
    (SELECT COUNT(*) 
     FROM Posts p1 
     INNER JOIN Posts p2 ON p1.Id = p2.ParentId 
     WHERE p2.PostTypeId = 2 AND p1.PostTypeId = 1 AND p2.Score > 0
    ) as PositiveScoreAnswers,
    (SELECT COUNT(*) 
     FROM Posts p 
     WHERE p.PostTypeId = 1 AND p.AnswerCount > 0
    ) as QuestionsWithAnswersCount,
    (SELECT COUNT(*) 
     FROM Posts p 
     WHERE p.PostTypeId = 1 AND p.FavoriteCount > 0
