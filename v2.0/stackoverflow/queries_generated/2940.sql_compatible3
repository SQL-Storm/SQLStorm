with RecursiveTagAgg as (
    select
        p.Id as PostId,
        unnest(string_to_array(substring(coalesce(p.Tags, ''), 2, length(coalesce(p.Tags, '')) - 2), '><')) as TagName
    from Posts p
    where p.PostTypeId = 1 and p.Tags is not null
), UserBadgeCounts as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        count(distinct b.Name) as DistinctBadges
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
), PostCloseReasons as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        ph.CreationDate,
        ph.UserId,
        u.DisplayName as ClosedBy
    from PostHistory ph
    inner join CloseReasonTypes crt on crt.Id = CAST(ph.Comment AS INTEGER)
    left join Users u on u.Id = ph.UserId
    where ph.PostHistoryTypeId = 10
), PostAnswerRanks as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.Score,
        a.CreationDate,
        u.Id as OwnerUserId,
        u.DisplayName,
        rank() over (partition by a.ParentId order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts a
    left join Users u on u.Id = a.OwnerUserId
    where a.PostTypeId = 2
), HighRankedAnswers as (
    select * from PostAnswerRanks where AnswerRank <= 3
), QuestionStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate,
        q.Score as QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        coalesce(uca.UpVotes, 0) as OwnerUpVotes,
        coalesce(uca.DownVotes, 0) as OwnerDownVotes,
        coalesce(uba.GoldBadges, 0) as OwnerGoldBadges,
        coalesce(uba.SilverBadges, 0) as OwnerSilverBadges,
        coalesce(uba.BronzeBadges, 0) as OwnerBronzeBadges,
        pcr.CloseReasonName,
        pcr.ClosedBy,
        pcr.CreationDate as ClosedDate
    from Posts q
    left join Users u on u.Id = q.OwnerUserId
    left join Users uca on uca.Id = q.OwnerUserId
    left join UserBadgeCounts uba on uba.UserId = q.OwnerUserId
    left join PostCloseReasons pcr on pcr.PostId = q.Id
    where q.PostTypeId = 1
), AnswerCommentsStats as (
    select
        a.Id as AnswerId,
        count(c.Id) as TotalComments,
        sum(case when c.Score > 0 then 1 else 0 end) as PositiveComments,
        sum(case when c.Score <= 0 or c.Score is null then 1 else 0 end) as NonPositiveComments,
        max(c.CreationDate) as LastCommentDate
    from Posts a
    left join Comments c on c.PostId = a.Id
    where a.PostTypeId = 2
    group by a.Id
), ComplexAnswerAnalysis as (
    select
        a.AnswerId,
        a.QuestionId,
        a.Score,
        a.CreationDate,
        a.OwnerUserId,
        a.DisplayName,
        acs.TotalComments,
        acs.PositiveComments,
        acs.NonPositiveComments,
        acs.LastCommentDate,
        row_number() over (partition by a.QuestionId order by a.Score desc, acs.TotalComments desc) as AnswerPriority
    from HighRankedAnswers a
    left join AnswerCommentsStats acs on acs.AnswerId = a.AnswerId
), UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        ph.PostId,
        ph.CreationDate,
        ph.PostHistoryTypeId,
        count(*) over (
            partition by u.Id
            order by extract(epoch from ph.CreationDate)
            range between 30 * 24 * 60 * 60 preceding and current row
        ) as EditsLast30Days
    from Users u
    left join PostHistory ph on ph.UserId = u.Id
    where ph.PostHistoryTypeId in (4, 5, 6)
), TopTags as (
    select
        rta.TagName,
        count(distinct rta.PostId) as QuestionCount,
        sum(qs.QuestionScore) as TotalScore,
        avg(qs.ViewCount) as AvgViews,
        min(qs.CreationDate) as FirstQuestionDate,
        max(qs.CreationDate) as LastQuestionDate
    from RecursiveTagAgg rta
    inner join QuestionStats qs on qs.QuestionId = rta.PostId
    group by rta.TagName
    having count(distinct rta.PostId) > 50 and avg(qs.ViewCount) > 1000
), CombinedQuestions as (
    select
        qs.QuestionId,
        qs.Title,
        qs.CreationDate,
        qs.QuestionScore,
        qs.ViewCount,
        qs.AnswerCount,
        qs.OwnerUpVotes,
        qs.OwnerDownVotes,
        qs.OwnerGoldBadges,
        qs.OwnerSilverBadges,
        qs.OwnerBronzeBadges,
        qs.CloseReasonName,
        qs.ClosedBy,
        qs.ClosedDate,
        ca.AnswerId,
        ca.Score as AnswerScore,
        ca.CreationDate as AnswerCreationDate,
        ca.OwnerUserId as AnswerOwnerId,
        ca.DisplayName as AnswerOwnerName,
        ca.TotalComments,
        ca.PositiveComments,
        ca.NonPositiveComments,
        ca.LastCommentDate
    from QuestionStats qs
    left join ComplexAnswerAnalysis ca on ca.QuestionId = qs.QuestionId and ca.AnswerPriority = 1
), FinalUserSummary as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct p.Id) as TotalPosts,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as TotalQuestions,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as TotalAnswers,
        sum(case when vt2.VoteTypeId = 2 then vt2.VoteCount else 0 end) as UpVotesReceived,
        sum(case when vt2.VoteTypeId = 3 then vt2.VoteCount else 0 end) as DownVotesReceived,
        max(p.CreationDate) as LastPostDate,
        max(uaj.EditsLast30Days) as MaxEditsInAny30DayWindow
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join (
        select
            VoteTypeId,
            PostId,
            count(*) as VoteCount
        from Votes
        group by VoteTypeId, PostId
    ) vt2 on vt2.PostId = p.Id
    left join UserActivityWindow uaj on uaj.UserId = u.Id
    group by u.Id, u.DisplayName
)
select
    ct.TagName,
    ct.QuestionCount,
    ct.TotalScore,
    round(ct.AvgViews) as AvgViews,
    ct.FirstQuestionDate,
    ct.LastQuestionDate,
    cq.QuestionId,
    cq.Title,
    cq.CreationDate as QuestionCreationDate,
    cq.QuestionScore,
    cq.ViewCount,
    cq.AnswerCount,
    cq.OwnerUpVotes,
    cq.OwnerDownVotes,
    cq.OwnerGoldBadges,
    cq.OwnerSilverBadges,
    cq.OwnerBronzeBadges,
    cq.CloseReasonName,
    cq.ClosedBy,
    cq.ClosedDate,
    cq.AnswerId,
    cq.AnswerScore,
    cq.AnswerCreationDate,
    cq.AnswerOwnerId,
    cq.AnswerOwnerName,
    cq.TotalComments,
    cq.PositiveComments,
    cq.NonPositiveComments,
    cq.LastCommentDate,
    fus.TotalPosts,
    fus.TotalQuestions,
    fus.TotalAnswers,
    fus.UpVotesReceived,
    fus.DownVotesReceived,
    fus.LastPostDate,
    fus.MaxEditsInAny30DayWindow
from TopTags ct
inner join RecursiveTagAgg rta on rta.TagName = ct.TagName
inner join CombinedQuestions cq on cq.QuestionId = rta.PostId
left join FinalUserSummary fus 
    on (
        (CAST(fus.UserId AS TEXT) = CAST(cq.OwnerUpVotes AS TEXT) and cq.OwnerUpVotes > 0)
        or (CAST(fus.UserId AS TEXT) = CAST(cq.OwnerDownVotes AS TEXT) and cq.OwnerDownVotes > 0)
        or (fus.DisplayName = cq.AnswerOwnerName)
        or (CAST(fus.UserId AS TEXT) = CAST(cq.AnswerOwnerId AS TEXT))
    )
where cq.QuestionScore > 10 
  and (cq.CloseReasonName is null or cq.CloseReasonName not in ('Duplicate', 'Off-topic'))
order by ct.QuestionCount desc, cq.QuestionScore desc
limit 100;