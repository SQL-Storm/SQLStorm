WITH 
/* Users who have at least one badge */
BadgeUsers AS (
    SELECT DISTINCT b.UserId AS UserId
    FROM Badges b
    WHERE b.UserId IS NOT NULL
),

/* Users who have cast at least 50 votes */
ActiveVoters AS (
    SELECT v.UserId
    FROM Votes v
    GROUP BY v.UserId
    HAVING COUNT(*) >= 50
),

/* Union of the two sets (set operator demo) */
CombinedUsers AS (
    SELECT UserId FROM BadgeUsers
    UNION
    SELECT UserId FROM ActiveVoters
),

/* Base statistics per user */
UserStats AS (
    SELECT 
        u.Id,
        COALESCE(u.DisplayName, '<unknown>')               AS DisplayName,
        u.Reputation,
        COALESCE(u.Views,0)                               AS Views,
        COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0)   AS NetVotes,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1)   AS GoldBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 2)   AS SilverBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 3)   AS BronzeBadges,
        MAX(p.CreationDate)                              AS LastPostDate,
        MAX(v.CreationDate)                              AS LastVoteDate,
        STRING_AGG(DISTINCT pt.Name, ',')                AS PostTypesParticipated
    FROM Users u
    LEFT JOIN Badges b      ON b.UserId = u.Id
    LEFT JOIN Posts p       ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v       ON v.UserId = u.Id
    LEFT JOIN PostTypes pt  ON p.PostTypeId = pt.Id
    WHERE u.Id IN (SELECT UserId FROM CombinedUsers)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),

/* Determine the most recent activity (post or vote) per user */
RecentActivity AS (
    SELECT 
        us.Id,
        GREATEST(COALESCE(us.LastPostDate, '1970-01-01'), COALESCE(us.LastVoteDate, '1970-01-01')) AS LastActivity,
        ROW_NUMBER() OVER (PARTITION BY us.Id 
                           ORDER BY GREATEST(COALESCE(us.LastPostDate, '1970-01-01'), COALESCE(us.LastVoteDate, '1970-01-01')) DESC) AS rn
    FROM UserStats us
),

/* Global tag popularity (only tags used >100 times) */
TopTags AS (
    SELECT 
        t.TagName,
        COUNT(*)                                            AS TagUseCount,
        ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC)         AS TagRank
    FROM Posts p
    JOIN LATERAL regexp_split_to_table(p.Tags, '[><]+') AS tag(tag) ON true
    JOIN Tags t ON t.TagName = tag.tag
    WHERE p.PostTypeId = 1            -- only questions
    GROUP BY t.TagName
    HAVING COUNT(*) > 100
),

/* Per‑user tag affinity */
UserTagAffinity AS (
    SELECT 
        u.Id                                            AS UserId,
        t.TagName,
        COUNT(*)                                        AS UserTagPosts,
        RANK() OVER (PARTITION BY u.Id ORDER BY COUNT(*) DESC) AS TagRank
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id
    JOIN LATERAL regexp_split_to_table(p.Tags, '[><]+') AS tag(tag) ON true
    JOIN Tags t ON t.TagName = tag.tag
    WHERE p.PostTypeId = 1
    GROUP BY u.Id, t.TagName
    HAVING COUNT(*) >= 5
),

/* Correlated subquery: total comment count per user (demo of correlation) */
UserCommentCounts AS (
    SELECT 
        u.Id,
        (SELECT COUNT(*) 
         FROM Comments c 
         WHERE c.UserId = u.Id) AS CommentCount
    FROM Users u
    WHERE u.Id IN (SELECT UserId FROM CombinedUsers)
)

SELECT
    ra.Id,
    us.DisplayName,
    us.Reputation,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.NetVotes,
    us.PostTypesParticipated,
    ra.LastActivity,
    CASE
        WHEN us.Reputation > 20000 THEN 'Veteran'
        WHEN us.Reputation BETWEEN 10000 AND 20000 THEN 'Experienced'
        ELSE 'Rising'
    END                                          AS ReputationTier,
    ucc.CommentCount,
    STRING_AGG(DISTINCT uta.TagName, ',') FILTER (WHERE uta.TagRank <= 3) AS Top3UserTags,
    STRING_AGG(DISTINCT tt.TagName, ',')  FILTER (WHERE tt.TagRank <= 5) AS GlobalTop5Tags
FROM RecentActivity ra
JOIN UserStats us          ON us.Id = ra.Id
LEFT JOIN UserCommentCounts ucc ON ucc.Id = ra.Id
LEFT JOIN UserTagAffinity uta   ON uta.UserId = ra.Id AND uta.TagRank <= 3
LEFT JOIN TopTags tt            ON tt.TagRank <= 5
WHERE ra.rn = 1
GROUP BY 
    ra.Id, us.DisplayName, us.Reputation, us.GoldBadges, us.SilverBadges,
    us.BronzeBadges, us.NetVotes, us.PostTypesParticipated,
    ra.LastActivity, ReputationTier, ucc.CommentCount
ORDER BY us.Reputation DESC
LIMIT 100;