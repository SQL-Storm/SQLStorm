WITH TopTags AS (
    SELECT TagName, Count
    FROM Tags
    WHERE Count > 1000
    ORDER BY Count DESC
    FETCH FIRST 10 ROWS ONLY
),

TagQuestions AS (
    SELECT
        t.TagName,
        p.Id                                   AS QuestionId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        COALESCE(u.Reputation, 0)              AS OwnerReputation,
        (
            SELECT COUNT(*)
            FROM Posts a
            WHERE a.ParentId = p.Id
              AND a.PostTypeId = 2
        )                                      AS AnswerCount,
        (
            SELECT COALESCE(SUM(v_up),0) - COALESCE(SUM(v_down),0)
            FROM (
                SELECT COUNT(*) AS v_up
                FROM Votes v
                WHERE v.PostId = p.Id
                  AND v.VoteTypeId = 2
                UNION ALL
                SELECT COUNT(*) * -1 AS v_down
                FROM Votes v
                WHERE v.PostId = p.Id
                  AND v.VoteTypeId = 3
            ) sub
        )                                      AS NetVotes,
        (
            SELECT STRING_AGG(DISTINCT b.Name, ',')
            FROM Badges b
            WHERE b.UserId = p.OwnerUserId
              AND b.Class = 1
        )                                      AS GoldBadges
    FROM Tags t
    JOIN Posts p
      ON p.Tags LIKE CONCAT('%<', t.TagName, '>%')
      AND p.PostTypeId = 1               -- only questions
    LEFT JOIN Users u
      ON u.Id = p.OwnerUserId
    WHERE t.TagName IS NOT NULL
),

RankedQuestions AS (
    SELECT
        TagName,
        QuestionId,
        CreationDate,
        Score,
        ViewCount,
        OwnerReputation,
        AnswerCount,
        NetVotes,
        GoldBadges,
        ROW_NUMBER() OVER (PARTITION BY TagName ORDER BY Score DESC, ViewCount DESC) AS rn,
        AVG(Score)    OVER (PARTITION BY TagName)                               AS avg_score,
        PERCENT_RANK() OVER (PARTITION BY TagName ORDER BY CreationDate)        AS freshness_rank
    FROM TagQuestions
),

DuplicateInfo AS (
    SELECT
        ph.PostId                                            AS QuestionId,
        JSON_AGG(JSON_BUILD_OBJECT(
            'duplicate_of', (CAST(ph.Text AS JSON)) ->> 'duplicateId'
        )) FILTER (WHERE ph.PostHistoryTypeId = 10)        AS duplicate_of
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10          -- close reason = duplicate
    GROUP BY ph.PostId
),

UserActivity AS (
    SELECT
        u.Id                                          AS UserId,
        u.DisplayName,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END)   AS QuestionsAsked,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END)   AS AnswersGiven,
        COALESCE(SUM(
            CASE WHEN v.VoteTypeId = 2 THEN 1
                 WHEN v.VoteTypeId = 3 THEN -1
                 ELSE 0 END
        ),0)                                         AS TotalVoteScore,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadgeCount
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId IN (2,3)
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),

FinalSet AS (
    SELECT
        rq.TagName,
        rq.QuestionId,
        rq.CreationDate,
        rq.Score,
        rq.ViewCount,
        rq.OwnerReputation,
        rq.AnswerCount,
        rq.NetVotes,
        rq.GoldBadges,
        di.duplicate_of,
        ua.DisplayName,
        ua.QuestionsAsked,
        ua.AnswersGiven,
        ua.TotalVoteScore,
        ua.GoldBadgeCount,
        rq.rn,
        rq.avg_score,
        rq.freshness_rank
    FROM RankedQuestions rq
    LEFT JOIN DuplicateInfo di ON di.QuestionId = rq.QuestionId
    LEFT JOIN UserActivity ua ON ua.UserId = (
        SELECT p2.OwnerUserId
        FROM Posts p2
        WHERE p2.Id = rq.QuestionId
    )
    WHERE rq.rn <= 5
)

SELECT *
FROM FinalSet
WHERE (NetVotes IS NULL OR NetVotes > 0)
  AND (GoldBadgeCount IS NOT NULL AND GoldBadgeCount >= 1)
  AND (duplicate_of IS NULL OR JSON_ARRAY_LENGTH(duplicate_of) = 0)
ORDER BY TagName, Score DESC

UNION ALL

SELECT
    tt.TagName,
    NULL AS QuestionId,
    NULL AS CreationDate,
    NULL AS Score,
    NULL AS ViewCount,
    NULL AS OwnerReputation,
    NULL AS AnswerCount,
    NULL AS NetVotes,
    NULL AS GoldBadges,
    NULL AS duplicate_of,
    NULL AS DisplayName,
    NULL AS QuestionsAsked,
    NULL AS AnswersGiven,
    NULL AS TotalVoteScore,
    NULL AS GoldBadgeCount,
    NULL AS rn,
    NULL AS avg_score,
    NULL AS freshness_rank
FROM TopTags tt
WHERE NOT EXISTS (
    SELECT 1
    FROM FinalSet f
    WHERE f.TagName = tt.TagName
);