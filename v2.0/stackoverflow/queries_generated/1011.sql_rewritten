-- {"query": "1011.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3486} 
WITH UserActivitySummary AS (
    -- Summarizes key activities and attributes for highly reputable users.
    -- Filters users based on minimum post count and reputation.
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        SUM(COALESCE(P.Score, 0)) AS TotalPostScore,
        AVG(COALESCE(P.Score, 0)) AS AvgPostScore,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COUNT(DISTINCT CASE WHEN V.VoteTypeId = 2 THEN V.Id END) AS TotalUpvotesGiven,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        MAX(P.LastActivityDate) AS LastPostActivity
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate
    HAVING COUNT(P.Id) > 50 AND U.Reputation > 5000
),
PostEngagementMetrics AS (
    -- Calculates engagement metrics for questions and answers, and ranks them per user.
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.Title,
        P.Tags,
        P.ParentId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        COALESCE(P.AnswerCount, 0) AS AnswerCount,
        COALESCE(P.FavoriteCount, 0) AS FavoriteCount,
        -- Correlated subquery to count close/reopen events for a post
        (SELECT COUNT(*) FROM PostHistory PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId IN (10, 11)) AS CloseReopenEvents,
        -- Window function to rank posts by score and view count within each user and post type.
        ROW_NUMBER() OVER (PARTITION BY P.OwnerUserId, P.PostTypeId ORDER BY P.Score DESC, COALESCE(P.ViewCount, 0) DESC) AS RnPerUserPostScore
    FROM Posts P
    WHERE P.PostTypeId IN (1, 2) -- Focus on Questions (1) and Answers (2)
),
PostHistoryTrend AS (
    -- Identifies the latest significant history event for each post and calculates time difference to previous event.
    SELECT
        PH.PostId,
        PH.PostHistoryTypeId,
        PH.CreationDate AS HistoryDate,
        PH.UserId AS EditorUserId,
        PH.Text AS HistoryText,
        -- Window function to get the creation date of the immediately preceding history event for the same post.
        LAG(PH.CreationDate, 1, PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PrevHistoryDate,
        -- Window function to get the latest history entry for a post.
        ROW_NUMBER() OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate DESC) AS rn_latest_history
    FROM PostHistory PH
    WHERE PH.PostHistoryTypeId IN (5, 6, 10, 11) -- Edit Body, Edit Tags, Post Closed, Post Reopened
),
-- First branch of the UNION ALL: Focuses on high-impact questions from high-reputation users.
HighImpactQuestions AS (
    SELECT
        UAS.DisplayName AS AuthorDisplayName,
        UAS.Reputation,
        UAS.GoldBadges,
        PEM.PostId,
        PEM.Title AS PostTitle,
        PEM.Tags AS PostTags,
        'Question' AS PostType,
        PEM.PostCreationDate,
        PEM.PostScore,
        PEM.ViewCount,
        PEM.AnswerCount,
        NULL::INT AS ParentPostId, -- Not applicable for questions
        NULL::VARCHAR(300) AS ParentPostTitle, -- Not applicable for questions
        -- Correlated subquery to calculate average score of answers to this question.
        (SELECT AVG(A.Score) FROM Posts A WHERE A.ParentId = PEM.PostId AND A.PostTypeId = 2) AS AvgAnswerScore,
        -- Correlated subquery to get score of the accepted answer, if any.
        (SELECT MAX(A.Score) FROM Posts A INNER JOIN Posts Q_inner ON A.Id = Q_inner.AcceptedAnswerId WHERE Q_inner.Id = PEM.PostId) AS AcceptedAnswerScore,
        -- Correlated subquery to count comments for this post.
        (SELECT COUNT(C.Id) FROM Comments C WHERE C.PostId = PEM.PostId) AS PostCommentCount,
        PHT.HistoryDate AS LastEditOrCloseDate,
        PHT.PostHistoryTypeId AS LastHistoryEventType,
        -- Calculation for post age in days.
        EXTRACT(DAY FROM (cast('2024-10-01 12:34:56' as timestamp) - PEM.PostCreationDate)) AS PostAgeInDays,
        -- Complex CASE expression for categorizing question impact.
        CASE
            WHEN PEM.PostScore > 100 AND PEM.AnswerCount > 5 THEN 'High-Impact Question'
            WHEN PEM.ViewCount > 10000 AND PEM.FavoriteCount > 50 THEN 'Highly Viewed & Favorited'
            WHEN (SELECT MAX(A.Score) FROM Posts A INNER JOIN Posts Q_inner ON A.Id = Q_inner.AcceptedAnswerId WHERE Q_inner.Id = PEM.PostId) IS NOT NULL
                 AND (SELECT MAX(A.Score) FROM Posts A INNER JOIN Posts Q_inner ON A.Id = Q_inner.AcceptedAnswerId WHERE Q_inner.Id = PEM.PostId) >= 50
                THEN 'Question with Stellar Accepted Answer'
            ELSE 'Standard Question'
        END AS PostImpactCategory,
        COALESCE(P.Body, 'No body content available') AS PostBodySample, -- NULL logic with COALESCE
        CHAR_LENGTH(P.Body) AS BodyLength, -- String expression for body length
        -- Correlated subquery to get average upvote score for the post.
        (
            SELECT AVG(V.Score)
            FROM Votes V
            WHERE V.PostId = PEM.PostId AND V.VoteTypeId = 2
        ) AS AverageUpvoteScoreForPost,
        -- Correlated subquery to count gold badges related to the question's tags.
        (
            SELECT
                COUNT(DISTINCT B.Id)
            FROM Badges B
            WHERE B.UserId = UAS.UserId
              AND B.Class = 1
              AND EXISTS ( -- Checks if any of the post's tags match a tag-based gold badge name.
                    SELECT 1
                    FROM unnest(string_to_array(substring(PEM.Tags, 2, length(PEM.Tags)-2), '><')) AS PostTag (TagName)
                    WHERE B.Name = PostTag.TagName AND B.TagBased = TRUE
                )
        ) AS GoldTagBadgesRelatedToPost,
        -- Correlated subquery for the latest comment date on the post.
        (SELECT MAX(C.CreationDate) FROM Comments C WHERE C.PostId = PEM.PostId) AS LatestPostCommentDate,
        PEM.CloseReopenEvents,
        PHT.PrevHistoryDate,
        -- Calculation for hours since the previous history event.
        EXTRACT(HOUR FROM (PHT.HistoryDate - PHT.PrevHistoryDate)) AS HoursSincePrevHistoryEvent,
        -- Conditional check for rapid historical changes (e.g., multiple edits within 24 hours).
        CASE WHEN PHT.PrevHistoryDate IS NOT NULL AND PHT.HistoryDate - PHT.PrevHistoryDate < INTERVAL '24 hour' THEN TRUE ELSE FALSE END AS RapidHistoryChange,
        -- String aggregation for moderator-only tags associated with the question.
        (
            SELECT COALESCE(STRING_AGG(T.TagName, ', '), 'No Tags')
            FROM unnest(string_to_array(substring(PEM.Tags, 2, length(PEM.Tags)-2), '><')) AS Tag (TagName)
            JOIN Tags T ON T.TagName = Tag.TagName
            WHERE T.IsModeratorOnly = TRUE
        ) AS ModeratorOnlyTags
    FROM UserActivitySummary UAS
    INNER JOIN PostEngagementMetrics PEM ON UAS.UserId = PEM.OwnerUserId
    INNER JOIN Posts P ON PEM.PostId = P.Id AND PEM.PostTypeId = 1 -- Ensure it's a question
    LEFT JOIN PostHistoryTrend PHT ON PEM.PostId = PHT.PostId AND PHT.rn_latest_history = 1
    WHERE UAS.Reputation >= 10000 -- Further filter for higher reputation
      AND PEM.RnPerUserPostScore <= 3 -- Top 3 questions per user by score/views
      AND (
            (LOWER(PEM.Title) LIKE '%api%' OR LOWER(PEM.Title) LIKE '%web service%') -- String expressions in predicate
            OR (PEM.Tags LIKE '%<json>%' OR PEM.Tags LIKE '%<rest>%') -- String expressions in predicate
          )
      AND NOT EXISTS ( -- Correlated subquery for filtering out recently closed questions.
            SELECT 1
            FROM PostHistory PH_closed
            WHERE PH_closed.PostId = PEM.PostId
              AND PH_closed.PostHistoryTypeId = 10 -- Post Closed
              AND PH_closed.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months' -- Closed recently
              AND PH_closed.Comment IN ('101', '102') -- Duplicate or Off-topic close reasons
        )
),
-- Second branch of the UNION ALL: Focuses on high-scoring accepted answers from high-reputation users.
HighImpactAnswers AS (
    SELECT
        UAS.DisplayName AS AuthorDisplayName,
        UAS.Reputation,
        UAS.GoldBadges,
        PEM.PostId,
        NULL::VARCHAR(300) AS PostTitle, -- Answers do not have titles, using NULL for column alignment.
        NULL::VARCHAR(4000) AS PostTags, -- Answers do not have tags, using NULL for column alignment.
        'Answer' AS PostType,
        PEM.PostCreationDate,
        PEM.PostScore,
        PEM.ViewCount,
        NULL::INT AS AnswerCount, -- Not applicable for answers.
        PEM.ParentId AS ParentPostId,
        (SELECT Title FROM Posts WHERE Id = PEM.ParentId) AS ParentPostTitle, -- Correlated subquery for parent question's title.
        NULL::NUMERIC AS AvgAnswerScore, -- Not applicable for answers themselves.
        PEM.PostScore AS AcceptedAnswerScore, -- An accepted answer's score is its own score.
        (SELECT COUNT(C.Id) FROM Comments C WHERE C.PostId = PEM.PostId) AS PostCommentCount,
        PHT.HistoryDate AS LastEditOrCloseDate,
        PHT.PostHistoryTypeId AS LastHistoryEventType,
        EXTRACT(DAY FROM (cast('2024-10-01 12:34:56' as timestamp) - PEM.PostCreationDate)) AS PostAgeInDays,
        CASE -- Categorization for answer impact.
            WHEN PEM.PostScore >= 75 THEN 'Exceptional Answer'
            WHEN PEM.PostScore >= 25 THEN 'High-Value Answer'
            ELSE 'Standard Answer'
        END AS PostImpactCategory,
        COALESCE(P.Body, 'No body content available') AS PostBodySample,
        CHAR_LENGTH(P.Body) AS BodyLength,
        (
            SELECT AVG(V.Score)
            FROM Votes V
            WHERE V.PostId = PEM.PostId AND V.VoteTypeId = 2
        ) AS AverageUpvoteScoreForPost,
        -- Correlated subquery to count gold badges related to the PARENT QUESTION's tags for an answer.
        (
            SELECT
                COUNT(DISTINCT B.Id)
            FROM Badges B
            WHERE B.UserId = UAS.UserId
              AND B.Class = 1
              AND EXISTS (
                    SELECT 1
                    FROM Posts QP_inner
                    JOIN unnest(string_to_array(substring(QP_inner.Tags, 2, length(QP_inner.Tags)-2), '><')) AS PostTag (TagName) ON TRUE
                    WHERE QP_inner.Id = PEM.ParentId AND B.Name = PostTag.TagName AND B.TagBased = TRUE
                )
        ) AS GoldTagBadgesRelatedToPost,
        (SELECT MAX(C.CreationDate) FROM Comments C WHERE C.PostId = PEM.PostId) AS LatestPostCommentDate,
        PEM.CloseReopenEvents,
        PHT.PrevHistoryDate,
        EXTRACT(HOUR FROM (PHT.HistoryDate - PHT.PrevHistoryDate)) AS HoursSincePrevHistoryEvent,
        CASE WHEN PHT.PrevHistoryDate IS NOT NULL AND PHT.HistoryDate - PHT.PrevHistoryDate < INTERVAL '24 hour' THEN TRUE ELSE FALSE END AS RapidHistoryChange,
        -- String aggregation for moderator-only tags of the PARENT QUESTION.
        (
            SELECT COALESCE(STRING_AGG(T.TagName, ', '), 'No Tags')
            FROM Posts QP_inner
            JOIN unnest(string_to_array(substring(QP_inner.Tags, 2, length(QP_inner.Tags)-2), '><')) AS Tag (TagName) ON TRUE
            JOIN Tags T ON T.TagName = Tag.TagName
            WHERE QP_inner.Id = PEM.ParentId AND T.IsModeratorOnly = TRUE
        ) AS ModeratorOnlyTags
    FROM UserActivitySummary UAS
    INNER JOIN PostEngagementMetrics PEM ON UAS.UserId = PEM.OwnerUserId
    INNER JOIN Posts P ON PEM.PostId = P.Id AND PEM.PostTypeId = 2 -- Ensure it's an answer
    INNER JOIN Posts QP ON P.ParentId = QP.Id AND QP.AcceptedAnswerId = PEM.PostId -- Only consider accepted answers
    LEFT JOIN PostHistoryTrend PHT ON PEM.PostId = PHT.PostId AND PHT.rn_latest_history = 1
    WHERE UAS.Reputation >= 20000 -- Higher reputation threshold for exceptional answers
      AND PEM.RnPerUserPostScore <= 2 -- Top 2 answers per user by score
      AND PEM.PostScore >= 50
      AND (LOWER(P.Body) LIKE '%solution%' OR LOWER(P.Body) LIKE '%fixed%') -- String expressions for body content
)
-- Combines results from both high-impact questions and high-impact accepted answers.
SELECT * FROM HighImpactQuestions
UNION ALL
SELECT * FROM HighImpactAnswers
ORDER BY Reputation DESC, PostScore DESC, PostCreationDate DESC
LIMIT 1000;