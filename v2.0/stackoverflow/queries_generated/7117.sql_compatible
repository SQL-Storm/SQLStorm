    cpa.NextPostDate,
    cpa.AvgScorePerUser,
    cpa.TotalPostsPerUser,
    cpa.ScoreCategory,
    cpa.PreviewBody,
    cpa.HasTags,
    cpa.PostingPeriod,
    cpa.IsPositive,
    cpa.IsNegative,
    cpa.IsNeutral,
    cpa.AnswerStatus,
    cpa.CommentLevel,
    cpa.ViewStatus,
    cpa.ScoreViewProduct,
    cpa.ScoreViewPerAnswer,
    bws.BadgeId,
    bws.BadgeName,
    bws.BadgeDate,
    bws.BadgeClass,
    bws.BadgeTier,
    bws.UserBadgeRank,
    bws.GlobalBadgeRank,
    bws.UserBadgeCount
ORDER BY 
    uas.Reputation DESC,
    uas.TotalPosts DESC,
    cpa.CreationDate DESC,
    bws.BadgeDate DESC
LIMIT 10000;