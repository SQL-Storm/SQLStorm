WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        MAX(c.CreationDate) as LastCommentDate,
        COUNT(DISTINCT CASE WHEN p.Score > 0 THEN p.Id END) as PositiveScorePosts,
        COUNT(DISTINCT CASE WHEN p.Score < 0 THEN p.Id END) as NegativeScorePosts,
        AVG(CAST(p.Score as FLOAT)) as AvgPostScore,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)), ', ') as AllTags,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0) as QuestionPercentage,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) * 100.0 / NULLIF(COUNT(*), 0) as AnswerPercentage,
        RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Body,
        p.Score,
        p.ViewCount,
        COALESCE(p.AnswerCount, 0) as AnswerCount,
        COALESCE(p.CommentCount, 0) as CommentCount,
        p.CreationDate,
        p.LastActivityDate,
        p.Tags,
        p.OwnerUserId,
        p.PostTypeId,
        p.ParentId,
        CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END as HasAcceptedAnswer,
        CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END as IsClosed,
        CASE WHEN p.CommunityOwnedDate IS NOT NULL THEN 1 ELSE 0 END as IsCommunityOwned,
        p.LastEditDate,
        COALESCE(STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)), ' '), 'None') as TagList,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as UserPostRank,
        NTILE(10) OVER (ORDER BY p.Score DESC) as ScoreDecile,
        LAG(p.CreationDate) OVER (ORDER BY p.CreationDate) as PreviousPostDate,
        LEAD(p.CreationDate) OVER (ORDER BY p.CreationDate) as NextPostDate,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) as AvgScorePerUser,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) as TotalPostsPerUser,
        CASE 
            WHEN p.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'High'
            WHEN p.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Low'
            ELSE 'Average'
        END as ScoreCategory,
        COALESCE(SUBSTRING(p.Body FROM 1 FOR 100), '') as PreviewBody,
        CASE WHEN p.Tags IS NOT NULL AND CHAR_LENGTH(p.Tags) > 0 THEN 1 ELSE 0 END as HasTags
    FROM Posts p
    WHERE p.Id IS NOT NULL
),
BadgesWithUserStats AS (
    SELECT 
        b.Id as BadgeId,
        b.Name as BadgeName,
        b.Date as BadgeDate,
        b.Class as BadgeClass,
        b.UserId,
        u.Reputation,
        u.DisplayName,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        RANK() OVER (PARTITION BY b.UserId ORDER BY b.Date) as UserBadgeRank,
        DENSE_RANK() OVER (ORDER BY b.Class, b.Date) as GlobalBadgeRank,
        COUNT(*) OVER (PARTITION BY b.UserId) as UserBadgeCount,
        CASE 
            WHEN b.Class = 1 THEN 'Gold'
            WHEN b.Class = 2 THEN 'Silver'
            WHEN b.Class = 3 THEN 'Bronze'
            ELSE 'Unknown'
        END as BadgeTier
    FROM Badges b
    INNER JOIN Users u ON b.UserId = u.Id
),
ComplexPostAnalysis AS (
    SELECT 
        pa.PostId,
        pa.Title,
        pa.Body,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount,
        pa.CommentCount,
        pa.CreationDate,
        pa.LastActivityDate,
        pa.Tags,
        pa.OwnerUserId,
        pa.PostTypeId,
        pa.ParentId,
        pa.HasAcceptedAnswer,
        pa.IsClosed,
        pa.IsCommunityOwned,
        pa.LastEditDate,
        pa.TagList,
        pa.UserPostRank,
        pa.ScoreDecile,
        pa.PreviousPostDate,
        pa.NextPostDate,
        pa.AvgScorePerUser,
        pa.TotalPostsPerUser,
        pa.ScoreCategory,
        pa.PreviewBody,
        pa.HasTags,
        CASE 
            WHEN (CAST('2024-10-01 12:34:56' AS timestamp) - pa.CreationDate) > INTERVAL '365 days' THEN 'Veteran'
            WHEN (CAST('2024-10-01 12:34:56' AS timestamp) - pa.CreationDate) > INTERVAL '180 days' THEN 'Regular'
            WHEN (CAST('2024-10-01 12:34:56' AS timestamp) - pa.CreationDate) > INTERVAL '30 days' THEN 'New'
            ELSE 'Fresh'
        END as PostingPeriod,
        CASE WHEN pa.Score > 0 THEN 1 ELSE 0 END as IsPositive,
        CASE WHEN pa.Score < 0 THEN 1 ELSE 0 END as IsNegative,
        CASE WHEN pa.Score = 0 THEN 1 ELSE 0 END as IsNeutral,
        CASE WHEN pa.AnswerCount > 0 THEN 'Answered' ELSE 'Unanswered' END as AnswerStatus,
        CASE 
            WHEN pa.CommentCount > 10 THEN 'Highly Commented'
            WHEN pa.CommentCount > 5 THEN 'Moderately Commented'
            WHEN pa.CommentCount > 0 THEN 'Sparingly Commented'
            ELSE 'Uncommented'
        END as CommentLevel,
        CASE 
            WHEN pa.ViewCount > 1000 THEN 'Viral'
            WHEN pa.ViewCount > 500 THEN 'Popular'
            WHEN pa.ViewCount > 100 THEN 'Moderate'
            WHEN pa.ViewCount > 0 THEN 'Low'
            ELSE 'No Views'
        END as ViewStatus,
        COALESCE(pa.Score, 0) * COALESCE(pa.ViewCount, 0) as ScoreViewProduct,
        (COALESCE(pa.Score, 0) * COALESCE(pa.ViewCount, 0)) / NULLIF(COALESCE(pa.AnswerCount, 0) + 1, 0) as ScoreViewPerAnswer
    FROM PostAnalysis pa
)
SELECT 
    uas.UserId,
    uas.DisplayName,
    uas.Reputation,
    uas.Views,
    uas.UpVotes,
    uas.DownVotes,
    uas.TotalPosts,
