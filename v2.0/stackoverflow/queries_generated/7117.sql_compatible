    cpa.TotalPostsPerUser,
    cpa.ScoreCategory,
    cpa.PreviewBody,
    cpa.HasTags,
    cpa.PostingPeriod,
    cpa.IsPositive,
    cpa.IsNegative,
    cpa.IsNeutral,
    cpa.AnswerStatus,
    cpa.CommentLevel,
    cpa.ViewStatus,
    cpa.ScoreViewProduct,
    cpa.ScoreViewPerAnswer,
    bws.BadgeId,
    bws.BadgeName,
    bws.BadgeDate,
    bws.BadgeClass,
    bws.BadgeTier,
    bws.UserBadgeRank,
    bws.GlobalBadgeRank,
    bws.UserBadgeCount
FROM UserActivityStats uas
LEFT JOIN ComplexPostAnalysis cpa ON uas.UserId = cpa.OwnerUserId
LEFT JOIN BadgesWithUserStats bws ON uas.UserId = bws.UserId
WHERE 
    (uas.TotalPosts > 0 OR uas.Comments > 0 OR uas.Badges > 0)
    AND (uas.Reputation > 0 OR uas.Views > 0 OR uas.UpVotes > 0 OR uas.DownVotes > 0)
    AND (cpa.PostId IS NOT NULL OR bws.BadgeId IS NOT NULL)
    AND (cpa.Score > -50 OR cpa.Score IS NULL)
    AND uas.Reputation IS NOT NULL
GROUP BY
    uas.UserId,
    uas.DisplayName,
    uas.Reputation,
    uas.Views,
    uas.UpVotes,
    uas.DownVotes,
    uas.TotalPosts,
    uas.Questions,
    uas.Answers,
    uas.Comments,
    uas.Badges,
    uas.LastPostDate,
    uas.LastCommentDate,
    uas.PositiveScorePosts,
    uas.NegativeScorePosts,
    uas.AvgPostScore,
    uas.AllTags,
    uas.QuestionPercentage,
    uas.AnswerPercentage,
    uas.PostRank,
