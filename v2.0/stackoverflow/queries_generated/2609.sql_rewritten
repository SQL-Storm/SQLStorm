-- {"query": "2609.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1688} 
with RecursiveTagHierarchy as (
    select 
        t.Id,
        t.TagName,
        t.Count,
        0 as Level,
        array[t.Id] as Path
    from Tags t
    where t.IsModeratorOnly = 0 and t.IsRequired = 0
  union all
    select 
        t.Id,
        t.TagName,
        t.Count,
        r.Level + 1,
        r.Path || t.Id
    from Tags t
    join RecursiveTagHierarchy r on t.Id <> all(r.Path)
    where t.IsModeratorOnly = 0 and t.IsRequired = 0 and array_length(r.Path, 1) < 3
), RankedPosts as (
    select 
        p.Id,
        p.PostTypeId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        u.DisplayName as OwnerDisplayName,
        u.Reputation,
        row_number() over (
            partition by p.PostTypeId order by p.Score desc, p.ViewCount desc
        ) as RankWithinType,
        dense_rank() over (
            order by p.OwnerUserId
        ) as OwnerRank,
        coalesce(p.Tags, '') as Tags,
        case 
            when p.ClosedDate is not null then 'Closed'
            when p.AcceptedAnswerId is not null then 'AcceptedAnswer'
            else 'Open'
        end as PostStatus,
        -- Complex expression for length adjusted score
        (p.Score * (1 + ln(1 + p.ViewCount)) * case when p.AcceptedAnswerId is not null then 1.5 else 1 end
          - coalesce(u.DownVotes, 0) * 0.1) as AdjustedScore
    from Posts p
    left join Users u on p.OwnerUserId = u.Id
    where p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
), LatestComments as (
    select DISTINCT on (c.PostId)
        c.PostId,
        c.Text as LastComment,
        c.CreationDate as LastCommentDate,
        c.UserId as LastCommentUserId
    from Comments c
    where c.Score > 0
    order by c.PostId, c.CreationDate desc
), BadgeCounts as (
    select 
        b.UserId,
        count(*) filter (where b.Class = 1) as GoldBadges,
        count(*) filter (where b.Class = 2) as SilverBadges,
        count(*) filter (where b.Class = 3) as BronzeBadges
    from Badges b
    group by b.UserId
), UserActivityRanks as (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionCount,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswerCount,
        count(c.Id) as CommentCount,
        bc.GoldBadges,
        bc.SilverBadges,
        bc.BronzeBadges,
        row_number() over (order by u.Reputation desc) as UserRankByReputation,
        row_number() over (order by count(p.Id) filter (where p.PostTypeId = 2) desc) as UserRankByAnswers,
        row_number() over (order by count(c.Id) desc) as UserRankByComments
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join BadgeCounts bc on bc.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, bc.GoldBadges, bc.SilverBadges, bc.BronzeBadges
), PostRelations as (
    select 
        pl.PostId,
        pl.RelatedPostId,
        lt.Name as LinkTypeName,
        p1.PostTypeId as PostTypeId,
        p2.PostTypeId as RelatedPostTypeId
    from PostLinks pl
    inner join LinkTypes lt on pl.LinkTypeId = lt.Id
    inner join Posts p1 on pl.PostId = p1.Id
    inner join Posts p2 on pl.RelatedPostId = p2.Id
), ComplexUserScore as (
    select 
        u.Id,
        u.DisplayName,
        -- Composite score with weights on badges, posts and activity time span
        (coalesce(bc.GoldBadges,0) * 50 + coalesce(bc.SilverBadges,0) * 20 + coalesce(bc.BronzeBadges,0) * 5
            + coalesce(q.QuestionCount,0) * 3 + coalesce(a.AnswerCount,0) * 7 + coalesce(c.CommentCount,0) * 1
            + (extract(epoch from (u.LastAccessDate - u.CreationDate))/86400.0) * 0.1
          ) as CompositeScore
    from Users u
    left join (
        select UserId, count(*) as QuestionCount from Posts where PostTypeId = 1 group by UserId
    ) q on q.UserId = u.Id
    left join (
        select OwnerUserId, count(*) as AnswerCount from Posts where PostTypeId = 2 group by OwnerUserId
    ) a on a.OwnerUserId = u.Id
    left join (
        select UserId, count(*) as CommentCount from Comments group by UserId
    ) c on c.UserId = u.Id
    left join BadgeCounts bc on bc.UserId = u.Id
    where u.Reputation > 1000
), TopUsersWithPosts as (
    select 
        u.Id as UserId,
        u.DisplayName,
        cus.CompositeScore,
        rp.Id as PostId,
        rp.Title,
        rp.Score,
        rp.ViewCount,
        rp.PostStatus,
        rp.AdjustedScore,
        rc.LastComment,
        rc.LastCommentDate,
        row_number() over (partition by u.Id order by rp.AdjustedScore desc) as PostRankByUser
    from ComplexUserScore cus
    join Users u on u.Id = cus.Id
    join RankedPosts rp on rp.OwnerUserId = u.Id and rp.PostTypeId in (1, 2)
    left join LatestComments rc on rc.PostId = rp.Id
    where cus.CompositeScore > 200
), CTE_Unified as (
    select 
        t.Id as TagId,
        t.TagName,
        t.Count,
        t.Level,
        concat('Level-', t.Level, ': ', t.TagName) as TagDescription
    from RecursiveTagHierarchy t

    union all

    select 
        rp.Id as TagId,
        rp.Tags,
        rp.Score as Count,
        0 as Level,
        concat('Post Tags: ', coalesce(rp.Tags, '')) as TagDescription
    from RankedPosts rp
    where rp.Tags is not null and rp.Tags <> ''
)

select 
    t.TagId,
    t.TagName,
    t.Count,
    t.Level,
    t.TagDescription,
    p.Title,
    p.Score,
    p.ViewCount,
    p.PostStatus,
    p.AdjustedScore,
    u.DisplayName as Owner,
    u.Reputation as OwnerReputation,
    u.CompositeScore as OwnerCompositeScore,
    p.LastComment,
    p.LastCommentDate
from CTE_Unified t
left join TopUsersWithPosts p on p.PostId = t.TagId
left join ComplexUserScore u on u.Id = p.UserId
where t.Level <= 2
  and (p.AdjustedScore > 5 or p.AdjustedScore is null)
order by t.Level, t.Count desc, p.AdjustedScore desc nulls last
limit 100;