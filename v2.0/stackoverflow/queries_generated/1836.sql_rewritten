-- {"query": "1836.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3395} 
WITH UserEngagement AS (
    -- Summarize user activity including post counts, scores, comments, badges, and vote statistics.
    SELECT
        U.Id AS UserId,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COUNT(DISTINCT P.Id) AS TotalPostsOwned,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestionsOwned,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswersOwned,
        SUM(P.Score) AS TotalPostsScoreReceived,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COUNT(DISTINCT B.Id) AS TotalBadgesEarned,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadgesCount,
        MAX(B.Date) AS LastBadgeDate,
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotesGiven,
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownvotesGiven,
        SUM(CASE WHEN V.VoteTypeId = 8 THEN V.BountyAmount ELSE 0 END) AS TotalBountyGivenAmount
    FROM Users AS U
    LEFT JOIN Posts AS P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments AS C ON U.Id = C.UserId
    LEFT JOIN Votes AS V ON U.Id = V.UserId
    LEFT JOIN Badges AS B ON U.Id = B.UserId
    GROUP BY U.Id, U.Reputation, U.CreationDate, U.LastAccessDate
),
PostRevisionMetrics AS (
    -- Analyze post history for each post, including revision counts, editor details, and time between edits.
    SELECT
        PH.PostId,
        COUNT(PH.Id) AS TotalRevisions,
        MAX(CASE WHEN PHT.Name IN ('Edit Body', 'Edit Title', 'Edit Tags') THEN PH.CreationDate END) AS LastEditDateFromHistory,
        MIN(PH.CreationDate) AS FirstRevisionDate,
        MAX(CASE WHEN PHT.Name = 'Post Closed' THEN PH.CreationDate END) AS ClosedDateFromHistory,
        COUNT(DISTINCT CASE WHEN PHT.Name IN ('Edit Body', 'Edit Title', 'Edit Tags') THEN PH.UserId END) AS UniqueEditors,
        MAX(CASE WHEN PHT.Name = 'Community Owned' THEN TRUE ELSE FALSE END) AS WasCommunityOwnedEver,
        SUM(CASE WHEN PH.Comment IS NOT NULL AND LENGTH(TRIM(PH.Comment)) > 10 THEN 1 ELSE 0 END) AS HistoryCommentsCount,
        -- Window function to calculate the average time difference between consecutive revisions for a post.
        AVG(EXTRACT(EPOCH FROM (PH.CreationDate - LAG(PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate)))) AS AvgTimeBetweenRevisionsSeconds
    FROM PostHistory AS PH
    JOIN PostHistoryTypes AS PHT ON PH.PostHistoryTypeId = PHT.Id
    GROUP BY PH.PostId
),
QuestionDetails AS (
    -- Extract specific metrics for question posts.
    SELECT
        Q.Id AS QuestionId,
        Q.ViewCount,
        Q.AnswerCount,
        Q.FavoriteCount,
        Q.CreationDate AS QuestionCreationDate,
        COALESCE(Q.AcceptedAnswerId, -1) AS AcceptedAnswerId,
        -- Correlated subquery to find the average score of positive answers for a question.
        (SELECT AVG(A.Score) FROM Posts AS A WHERE A.ParentId = Q.Id AND A.PostTypeId = 2 AND A.Score > 0) AS AvgPositiveAnswerScore,
        -- Correlated subquery to count unique users who favorited this question.
        (SELECT COUNT(DISTINCT V.UserId) FROM Votes AS V WHERE V.PostId = Q.Id AND V.VoteTypeId = 5) AS UniqueFavoritedUsers,
        -- String function to parse tags into an array, as per schema notes.
        STRING_TO_ARRAY(SUBSTRING(Q.Tags, 2, LENGTH(Q.Tags)-2), '><') AS TagArray,
        -- Correlated subquery to get the name of the latest history event type for the question.
        (SELECT PHT_INNER.Name FROM PostHistory PH_INNER JOIN PostHistoryTypes PHT_INNER ON PH_INNER.PostHistoryTypeId = PHT_INNER.Id WHERE PH_INNER.PostId = Q.Id ORDER BY PH_INNER.CreationDate DESC LIMIT 1) AS LatestHistoryTypeName
    FROM Posts AS Q
    WHERE Q.PostTypeId = 1
),
AnswerDetails AS (
    -- Basic details for answer posts, primarily for linking accepted answers.
    SELECT
        A.Id AS AnswerId,
        A.ParentId AS QuestionId,
        A.Score AS AnswerScore,
        A.CreationDate AS AnswerCreationDate,
        A.OwnerUserId AS AnswerOwnerUserId
    FROM Posts AS A
    WHERE A.PostTypeId = 2
),
PostLinkAnalysis AS (
    -- Analyze linked and duplicate posts using PostLinks table.
    SELECT
        PL.PostId,
        COUNT(CASE WHEN LT.Name = 'Linked' THEN 1 END) AS LinkedPostsCount,
        COUNT(CASE WHEN LT.Name = 'Duplicate' THEN 1 END) AS DuplicatePostsCount,
        MAX(CASE WHEN LT.Name = 'Duplicate' THEN PL.CreationDate END) AS LastDuplicateLinkDate
    FROM PostLinks AS PL
    JOIN LinkTypes AS LT ON PL.LinkTypeId = LT.Id
    GROUP BY PL.PostId
),
InterestingPostsCandidates AS (
    -- Set 1: Questions with high view count AND high favorite count from recent activity.
    SELECT P.Id AS PostId, P.OwnerUserId, P.PostTypeId, P.CreationDate, P.Score, P.ViewCount
    FROM Posts AS P
    WHERE P.PostTypeId = 1
      AND P.ViewCount > 5000
      AND P.FavoriteCount > 50
      AND P.CreationDate >= '2023-01-01'
    UNION ALL
    -- Set 2: Answers with high score AND many comments from recent activity.
    SELECT P.Id AS PostId, P.OwnerUserId, P.PostTypeId, P.CreationDate, P.Score, P.ViewCount
    FROM Posts AS P
    WHERE P.PostTypeId = 2
      AND P.Score > 20
      AND P.CommentCount > 5
      AND P.CreationDate >= '2023-01-01'
),
ProblematicPosts AS (
    -- Identify posts that might indicate quality issues: many revisions but low score and eventually closed.
    SELECT P.Id AS PostId
    FROM Posts AS P
    JOIN PostRevisionMetrics AS PRM ON P.Id = PRM.PostId
    WHERE PRM.TotalRevisions > 5 -- Many revisions
      AND P.Score < 5 -- Low score
      AND P.CreationDate >= '2023-01-01'
      AND (P.ClosedDate IS NOT NULL OR PRM.ClosedDateFromHistory IS NOT NULL) -- And eventually closed
)
-- Main query: Combines all CTEs, applies complex filtering, calculations, and window functions.
SELECT
    U.DisplayName AS UserName,
    UE.Reputation,
    UE.TotalQuestionsOwned,
    UE.TotalAnswersOwned,
    UE.TotalCommentsMade,
    UE.TotalPostsScoreReceived,
    UE.GoldBadgesCount,
    UE.TotalBountyGivenAmount,
    P.Id AS PostId,
    P.Title AS PostTitle,
    PT.Name AS PostTypeName,
    P.Score AS PostScore,
    P.ViewCount AS PostViewCount,
    P.CreationDate AS PostCreationDate,
    P.LastActivityDate AS PostLastActivityDate,
    COALESCE(P.LastEditDate, PRM.LastEditDateFromHistory) AS PostLastEditDateEffective, -- NULL logic: prefer Post.LastEditDate, fall back to history
    PRM.TotalRevisions,
    PRM.UniqueEditors,
    PRM.WasCommunityOwnedEver,
    PRM.HistoryCommentsCount,
    PRM.AvgTimeBetweenRevisionsSeconds,
    QD.AvgPositiveAnswerScore,
    QD.UniqueFavoritedUsers,
    QD.LatestHistoryTypeName,
    PLA.LinkedPostsCount,
    PLA.DuplicatePostsCount,
    PLA.LastDuplicateLinkDate,
    COALESCE(P.ClosedDate, PRM.ClosedDateFromHistory) AS EffectiveClosedDate, -- NULL logic for post closed date
    (EXTRACT(EPOCH FROM (P.LastActivityDate - P.CreationDate)) / (60 * 60 * 24)) AS PostLifecycleDays, -- Calculation for post's active lifespan
    -- Correlated subquery for upvote count
    (SELECT COUNT(V.Id) FROM Votes AS V WHERE V.PostId = P.Id AND V.VoteTypeId = 2) AS UpvoteCount,
    -- Correlated subquery for downvote count
    (SELECT COUNT(V.Id) FROM Votes AS V WHERE V.PostId = P.Id AND V.VoteTypeId = 3) AS DownvoteCount,
    -- Correlated subquery for comment count on the post
    (SELECT COUNT(C.Id) FROM Comments AS C WHERE C.PostId = P.Id) AS CommentCountOnPost,
    -- Complex expression with NULL handling to prevent division by zero.
    NULLIF(P.Score, 0)::numeric / NULLIF(P.ViewCount, 0)::numeric AS ScorePerViewRatio,
    -- Conditional expression for post status based on multiple criteria.
    CASE
        WHEN P.PostTypeId = 1 AND QD.AcceptedAnswerId != -1 THEN 'Accepted'
        WHEN P.PostTypeId = 1 AND COALESCE(P.ClosedDate, PRM.ClosedDateFromHistory) IS NOT NULL THEN 'Closed'
        WHEN P.PostTypeId = 1 AND P.AnswerCount = 0 AND P.LastActivityDate < cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 months' THEN 'Unanswered & Stale'
        WHEN P.PostTypeId = 1 AND P.AnswerCount = 0 THEN 'No Answers'
        ELSE 'Active'
    END AS PostStatus,
    -- Window function: Rank posts within their type by score.
    RANK() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.CreationDate ASC) AS RankInPostTypeByScore,
    -- Window function: Divide posts into 10 groups based on view count.
    NTILE(10) OVER (ORDER BY P.ViewCount DESC) AS ViewCountDecile,
    -- Window function: Calculate the percentile rank of user reputation.
    PERCENT_RANK() OVER (ORDER BY UE.Reputation DESC) AS UserReputationPercentRank,
    -- Complex conditional logic to categorize posts by "hotness".
    CASE
        WHEN P.ViewCount > 10000 AND P.FavoriteCount > 100 AND P.Score > 50 THEN 'Very Hot'
        WHEN P.ViewCount > 1000 AND P.FavoriteCount > 10 AND P.Score > 10 THEN 'Hot'
        WHEN P.ViewCount < 100 AND P.Score < 0 AND P.LastActivityDate < cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months' THEN 'Cold & Unloved'
        ELSE 'Normal'
    END AS HotPostIndicator,
    COALESCE(AD.AnswerScore, 0) AS AcceptedAnswerScore,
    COALESCE(AU.DisplayName, 'Community') AS AcceptedAnswerOwnerDisplayName,
    -- String expression: Extract an excerpt, convert to uppercase, handle NULL, and trim.
    TRIM(UPPER(SUBSTRING(COALESCE(P.Title, P.Body, 'No Content'), 1, 100))) AS TitleOrBodyExcerptUpper,
    LENGTH(P.Body) AS BodyLength,
    -- NULL logic and boolean check for empty/whitespace-only body.
    NULLIF(LENGTH(TRIM(P.Body)), 0) IS NULL AS IsBodyEmptyOrWhitespace,
    QD.TagArray,
    -- Correlated subquery for unique answerers to a question.
    (
        SELECT COUNT(DISTINCT A.OwnerUserId)
        FROM Posts AS A
        WHERE A.ParentId = P.Id AND A.PostTypeId = 2
    ) AS UniqueAnswerersForQuestion,
    -- Correlated subquery for total score of all answers to a question.
    (
        SELECT SUM(A.Score)
        FROM Posts AS A
        WHERE A.ParentId = P.Id AND A.PostTypeId = 2
    ) AS TotalAnswerScoreForQuestion,
    -- Correlated subquery with STRING_AGG for top gold badges, ordered.
    (
        SELECT STRING_AGG(B.Name, ', ')
        FROM Badges AS B
        WHERE B.UserId = U.Id AND B.Class = 1
        ORDER BY B.Date DESC
        LIMIT 3
    ) AS Top3GoldBadges
FROM Posts AS P
LEFT JOIN PostTypes AS PT ON P.PostTypeId = PT.Id
LEFT JOIN Users AS U ON P.OwnerUserId = U.Id
LEFT JOIN UserEngagement AS UE ON U.Id = UE.UserId
LEFT JOIN PostRevisionMetrics AS PRM ON P.Id = PRM.PostId
LEFT JOIN QuestionDetails AS QD ON P.Id = QD.QuestionId AND P.PostTypeId = 1
LEFT JOIN AnswerDetails AS AD ON P.AcceptedAnswerId = AD.AnswerId AND P.PostTypeId = 1 -- Only relevant for questions
LEFT JOIN Users AS AU ON AD.AnswerOwnerUserId = AU.Id -- Owner of the accepted answer
LEFT JOIN PostLinkAnalysis AS PLA ON P.Id = PLA.PostId
WHERE
    P.Id IN (
        -- Set operator: Select interesting posts, then exclude problematic ones.
        SELECT PostId FROM InterestingPostsCandidates
        EXCEPT
        SELECT PostId FROM ProblematicPosts
    )
    AND P.CreationDate >= '2023-01-01' -- Filter for recent activity to limit data size
    AND P.PostTypeId IN (1, 2) -- Focus on Questions and Answers
    AND (U.Reputation IS NULL OR U.Reputation > 50) -- Filter out very low-rep users or users not found
    AND (P.ViewCount > 50 OR P.Score > 10 OR P.CommentCount > 2) -- Ensure some basic level of activity
ORDER BY
    P.LastActivityDate DESC,
    UE.Reputation DESC,
    P.Score DESC
LIMIT 10000;