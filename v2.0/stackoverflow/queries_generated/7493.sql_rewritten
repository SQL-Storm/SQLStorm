    ua.TotalPosts,
    ua.QuestionCount,
    ua.AnswerCount,
    ua.AvgScore,
    ua.LastPostDate,
    ua.UserAgeDays,
    ua.ReputationLevel,
    ta.TagRank,
    ta.TagName,
    ta.PopularityLevel,
    ta.PostsWithTag,
    ta.AvgScoreWithTag,
    CASE 
        WHEN ps.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 1 
        ELSE 0 
    END as AboveAvgScore,
    CASE 
        WHEN ps.ViewCount > (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1) THEN 1 
        ELSE 0 
    END as AboveAvgViews,
    CASE 
        WHEN ps.AnswerCount > 0 THEN 
            ps.Score * (1.0 + (ps.AnswerCount * 0.1))
        ELSE ps.Score
    END as AdjustedScore,
    ISNULL(ps.Score, 0) + ISNULL(ps.ViewCount, 0) - ISNULL(ps.CommentCount, 0) as ModifiedScore,
    CASE 
        WHEN ps.Score > 0 AND ps.Score < 10 THEN 'Low'
        WHEN ps.Score >= 10 AND ps.Score < 100 THEN 'Medium'
        WHEN ps.Score >= 100 THEN 'High'
        ELSE 'Unknown'
    END as ScoreRange,
    DATEADD(MONTH, 1, ps.CreationDate) as OneMonthLater,
    ABS(ps.Score - ps.PrevScore) as ScoreChange,
    CASE 
        WHEN ps.TagCount > 3 THEN 'ManyTags'
        WHEN ps.TagCount = 3 THEN 'ThreeTags'
        WHEN ps.TagCount < 3 THEN 'FewTags'
        ELSE 'NoTags'
    END as TagComplexity,
    ps.SafeTitle + ' ' + ps.SafeTags as TitleAndTags,
    'Post-' + CAST(ps.PostId AS VARCHAR(10)) + '-Owner-' + CAST(ps.OwnerUserId AS VARCHAR(10)) as PostIdentifier,
    CASE 
        WHEN ps.TotalVotes > 10 THEN 'HighlyVoted'
        WHEN ps.TotalVotes > 5 THEN 'ModeratelyVoted'
        ELSE 'LowVoted'
    END as VoteIntensity
FROM PostStats ps
FULL OUTER JOIN UserActivity ua ON ps.OwnerUserId = ua.UserId
LEFT JOIN TagAnalysis ta ON ps.SafeTags LIKE '%' + ta.TagName + '%'
WHERE ps.PostTypeId IS NOT NULL
AND (ps.Score IS NULL OR ps.Score > 0)
AND (ua.UserId IS NULL OR ua.Reputation > 100)
AND ps.ScorePercentile > 0.1
AND ps.ScorePercentile < 0.9
AND ps.ViewQuartile IN (1, 2, 3, 4)
