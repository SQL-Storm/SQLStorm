    CASE 
        WHEN ps.TotalVotes > 25 THEN 'HighlyVoted'
        WHEN ps.TotalVotes > 15 THEN 'ModeratelyVoted'
        ELSE 'LowVoted'
    END as VoteIntensity
FROM PostStats ps
INNER JOIN UserActivity ua ON ps.OwnerUserId = ua.UserId
LEFT JOIN TagAnalysis ta ON ps.SafeTags LIKE '%' + ta.TagName + '%'
