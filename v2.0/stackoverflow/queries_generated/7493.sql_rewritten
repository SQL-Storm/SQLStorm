AND ps.ScorePercentile BETWEEN 0.2 AND 0.8
 AND ps.ViewQuartile IN (2, 3, 4)
 AND ps.TotalPostsByUser > 1
ORDER BY ps.Score DESC, ps.ViewCount DESC, ua.UserRank ASC;