WITH UserEngagement AS (
    -- CTE 1: Aggregates user-level metrics including badges and account activity.
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate,
        U.LastAccessDate,
        U.UpVotes,
        U.DownVotes,
        U.Views AS UserProfileViews,
        -- Complicated calculation for account age in days up to last access, handling potential future dates as 0.
        GREATEST(0, EXTRACT(EPOCH FROM (U.LastAccessDate - U.CreationDate)) / (3600 * 24)) AS AccountAgeDays,
        COALESCE(SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END), 0) AS GoldBadges,
        COALESCE(SUM(CASE WHEN B.Class = 2 THEN 1 ELSE 0 END), 0) AS SilverBadges,
        COALESCE(SUM(CASE WHEN B.Class = 3 THEN 1 ELSE 0 END), 0) AS BronzeBadges,
        COUNT(B.Id) AS TotalBadges,
        COUNT(DISTINCT CASE WHEN B.TagBased = TRUE THEN B.Name ELSE NULL END) AS UniqueTagBadges,
        -- String expression and NULL logic for website URL validation.
        CASE
            WHEN U.WebsiteUrl IS NOT NULL AND U.WebsiteUrl LIKE 'http%' AND LENGTH(TRIM(U.WebsiteUrl)) > 20 THEN TRUE
            ELSE FALSE
        END AS HasDetailedWebsite,
        -- COALESCE for location NULL handling and a predicate using ILIKE for location patterns.
        COALESCE(U.Location, 'Unknown Location') AS UserLocation,
        (U.UpVotes + U.DownVotes) AS TotalUserVotes,
        -- Division calculation with NULLIF to prevent division by zero.
        (U.UpVotes * 1.0 / NULLIF(U.DownVotes + U.UpVotes, 0)) AS UpvoteRatio,
        -- Window function: Rank users by their total badges within a reputation bracket (e.g., >100k, >50k, etc.)
        RANK() OVER (PARTITION BY FLOOR(U.Reputation / 100000) ORDER BY COUNT(B.Id) DESC) AS BadgeRankInReputationTier
    FROM
        Users AS U
    LEFT JOIN Badges AS B ON U.Id = B.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.UpVotes, U.DownVotes, U.Views, U.WebsiteUrl, U.Location
),
PostAggregates AS (
    -- CTE 2: Aggregates post-level metrics including votes, comments, and history.
    SELECT
        P.OwnerUserId AS UserId,
        P.Id AS PostId,
        P.PostTypeId,
        PT.Name AS PostTypeName,
        P.Score AS PostScore,
        P.ViewCount,
        P.AnswerCount,
        P.CommentCount AS BuiltInCommentCount, -- Original CommentCount from Posts table
        P.FavoriteCount,
        P.CreationDate AS PostCreationDate,
        P.LastActivityDate,
        P.LastEditDate,
        P.ClosedDate,
        P.AcceptedAnswerId,
        P.ParentId,
        P.Title,
        P.Tags,
        LENGTH(P.Body) AS BodyLength,
        -- Complex calculation: Post lifespan in years until last activity, defaulting to current age if no activity.
        GREATEST(0, EXTRACT(EPOCH FROM (P.LastActivityDate - P.CreationDate)) / (3600 * 24 * 365.25)) AS PostActivityYears,
        -- Correlated subquery 1: Count of distinct editors other than the owner for body/title/tag edits.
        (SELECT COUNT(DISTINCT PH.UserId)
         FROM PostHistory AS PH
         WHERE PH.PostId = P.Id
           AND PH.UserId IS NOT NULL
           AND PH.UserId <> P.OwnerUserId
           AND PH.PostHistoryTypeId IN (4, 5, 6, 8, 9)) AS ExternalEditorCount,
        -- Correlated subquery 2: Check if a post was ever reopened using PostHistory.
        (SELECT MAX(CASE WHEN PH.PostHistoryTypeId = 11 THEN 1 ELSE 0 END)
         FROM PostHistory AS PH
         WHERE PH.PostId = P.Id) AS WasReopened,
        -- Net votes for the post, using aggregate functions and CASE WHEN.
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) - COALESCE(SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS NetPostVotes,
        -- Identify if post is a duplicate target (LinkTypeId = 3 and RelatedPostId is this post's ID).
        MAX(CASE WHEN PL.LinkTypeId = 3 AND PL.RelatedPostId = P.Id THEN 1 ELSE 0 END) AS IsDuplicateTarget,
        -- Identify if post is a duplicate source (LinkTypeId = 3 and PostId is this post's ID).
        MAX(CASE WHEN PL.LinkTypeId = 3 AND PL.PostId = P.Id THEN 1 ELSE 0 END) AS IsDuplicateSource,
        -- Aggregate comments data specifically for each post.
        COALESCE(SUM(C.Score), 0) AS TotalCommentScoreFromCommentsTable,
        COUNT(DISTINCT C.Id) AS ActualCommentCountFromCommentsTable
    FROM
        Posts AS P
    LEFT JOIN PostTypes AS PT ON P.PostTypeId = PT.Id
    LEFT JOIN Comments AS C ON P.Id = C.PostId
    LEFT JOIN Votes AS V ON P.Id = V.PostId
    LEFT JOIN PostLinks AS PL ON P.Id = PL.PostId OR P.Id = PL.RelatedPostId -- Join for both source and target links
    WHERE
        P.OwnerUserId IS NOT NULL
        AND P.CreationDate >= '2019-01-01' -- Filter for more recent posts for performance.
        AND P.Body IS NOT NULL
        AND P.PostTypeId IN (1, 2) -- Only questions and answers considered.
    GROUP BY
        P.OwnerUserId, P.Id, P.PostTypeId, PT.Name, P.Score, P.ViewCount, P.AnswerCount, P.BuiltInCommentCount, P.FavoriteCount,
        P.CreationDate, P.LastActivityDate, P.LastEditDate, P.ClosedDate, P.AcceptedAnswerId, P.ParentId, P.Title, P.Tags, P.Body
),
UserPostContributions AS (
    -- CTE 3: Aggregates post-related contributions per user.
    SELECT
        PA.UserId,
        COUNT(DISTINCT PA.PostId) AS TotalPostsContributed,
        SUM(CASE WHEN PA.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN PA.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        SUM(PA.PostScore) AS TotalPostScore,
        AVG(PA.PostScore) AS AvgPostScore,
        COALESCE(SUM(PA.ViewCount) FILTER (WHERE PA.PostTypeId = 1), 0) AS TotalQuestionViews, -- Aggregate with FILTER clause for specific post types.
        COALESCE(AVG(PA.ViewCount) FILTER (WHERE PA.PostTypeId = 1), 0) AS AvgQuestionViews,
        COALESCE(SUM(PA.AnswerCount) FILTER (WHERE PA.PostTypeId = 1), 0) AS TotalAnswersOnQuestions,
        COALESCE(SUM(PA.FavoriteCount) FILTER (WHERE PA.FavoriteCount IS NOT NULL), 0) AS TotalFavoriteCounts,
        COALESCE(SUM(PA.NetPostVotes), 0) AS TotalNetPostVotes,
        COALESCE(SUM(PA.ActualCommentCountFromCommentsTable), 0) AS TotalEffectiveComments,
        COALESCE(SUM(PA.TotalCommentScoreFromCommentsTable), 0) AS TotalEffectiveCommentScore,
        -- Calculation for proportion of accepted answers, using ParentId for context.
        (SUM(CASE WHEN PA.PostTypeId = 2 AND PA.PostId = QP.AcceptedAnswerId THEN 1 ELSE 0 END) * 1.0 /
         NULLIF(SUM(CASE WHEN PA.PostTypeId = 2 THEN 1 ELSE 0 END), 0)) AS AcceptedAnswerRatio,
        COALESCE(SUM(PA.ExternalEditorCount), 0) AS TotalExternalEditorCount,
        COALESCE(SUM(PA.WasReopened), 0) AS PostsReopenedCount,
        COALESCE(SUM(PA.IsDuplicateTarget), 0) AS PostsAsDuplicateTarget,
        COALESCE(SUM(PA.IsDuplicateSource), 0) AS PostsAsDuplicateSource,
        -- Window function: Row number within a user's posts, ordered by creation date for identifying "early" vs "late" posts.
        COUNT(DISTINCT T.tag) AS DistinctTagsUsed, -- Uses LATERAL UNNEST for tag extraction.
        SUM(CASE WHEN T.tag LIKE '%java%' OR T.tag LIKE '%python%' OR T.tag LIKE '%javascript%' THEN 1 ELSE 0 END) AS MajorLanguageTagsUsed,
        MAX(PA.BodyLength) AS MaxPostBodyLength
    FROM
        PostAggregates AS PA
    LEFT JOIN Posts AS QP ON PA.ParentId = QP.Id -- To link answers back to their parent questions for AcceptedAnswerId check.
    -- String processing with LATERAL UNNEST for tags, handling potential empty/null tags.
    LEFT JOIN LATERAL UNNEST(string_to_array(SUBSTRING(PA.Tags FROM 2 FOR LENGTH(PA.Tags) - 2), '><')) AS T(tag) ON PA.Tags IS NOT NULL AND LENGTH(PA.Tags) > 2
    GROUP BY
        PA.UserId
),
HighImpactUsers AS (
    -- CTE 4: Combines user engagement and post contributions to calculate an overall influence score.
    SELECT
        UE.UserId,
        UE.DisplayName,
        UE.Reputation,
        UE.AccountAgeDays,
        UE.GoldBadges,
        UE.SilverBadges,
        UE.BronzeBadges,
        UE.TotalBadges,
        UE.HasDetailedWebsite,
        UE.UserLocation,
        UE.UpvoteRatio,
        UPC.TotalPostsContributed,
        UPC.TotalQuestions,
        UPC.TotalAnswers,
        UPC.TotalPostScore,
        UPC.AvgPostScore,
        UPC.TotalQuestionViews,
        UPC.AvgQuestionViews,
        UPC.TotalAnswersOnQuestions,
        UPC.TotalFavoriteCounts,
        UPC.TotalNetPostVotes,
        UPC.TotalEffectiveComments,
        COALESCE(UPC.AcceptedAnswerRatio, 0.0) AS AcceptedAnswerRatio, -- COALESCE for ratio if no answers.
        UPC.TotalExternalEditorCount,
        UPC.PostsReopenedCount,
        UPC.PostsAsDuplicateTarget,
        UPC.PostsAsDuplicateSource,
        UPC.DistinctTagsUsed,
        UPC.MajorLanguageTagsUsed,
        UPC.MaxPostBodyLength,
        -- Complex Influence Score calculation using weighted factors and various metrics.
        (UE.Reputation * 0.05 + -- Base reputation
         UPC.TotalNetPostVotes * 0.4 + -- Net votes on posts
         UPC.TotalFavoriteCounts * 0.2 + -- Posts favorited
         UPC.AcceptedAnswerRatio * 1500 + -- High value for accepted answers
         UPC.TotalEffectiveComments * 0.1 + -- Active in comments
         UE.GoldBadges * 80 + UE.SilverBadges * 15 + -- Badge recognition
         UPC.TotalQuestions * 3 + UPC.TotalAnswers * 2 + -- Quantity of contributions
         (UPC.TotalQuestionViews / NULLIF(UPC.TotalQuestions, 0)) * 0.005 + -- View exposure
         (UPC.DistinctTagsUsed * 5) + (UPC.MajorLanguageTagsUsed * 10) - -- Tag diversity and specialization
         (UPC.PostsAsDuplicateSource * 40) - (UPC.PostsAsDuplicateTarget * 20) - -- Penalize for duplicates
         (UPC.TotalExternalEditorCount * 3) - -- Penalize for posts needing external edits
         (UPC.PostsReopenedCount * 10) -- Penalize for posts that needed reopening
        ) AS InfluenceScore,
        -- Conditional string expression for user tier based on multiple factors.
        CASE
            WHEN UE.Reputation > 100000 AND COALESCE(UPC.AcceptedAnswerRatio, 0) > 0.6 AND UPC.TotalNetPostVotes > 5000 AND UE.GoldBadges >= 5 THEN 'Legendary Contributor'
            WHEN UE.Reputation > 50000 AND COALESCE(UPC.AcceptedAnswerRatio, 0) > 0.4 AND UPC.TotalNetPostVotes > 2000 AND UE.GoldBadges >= 1 THEN 'Senior Expert'
            WHEN UE.Reputation > 10000 AND UPC.TotalPostsContributed > 100 AND UPC.AvgPostScore > 5 THEN 'Active Participant'
            ELSE 'Emerging Contributor'
        END AS UserTier
    FROM
        UserEngagement AS UE
    JOIN UserPostContributions AS UPC ON UE.UserId = UPC.UserId
    WHERE
        UE.AccountAgeDays > 365 -- Only users active for at least a year.
        AND UE.Reputation > 500 -- Minimum reputation.
        AND UPC.TotalPostsContributed > 5 -- Minimum number of posts.
        -- Complicated predicate combining string and NULL logic.
        AND (UE.UserLocation IS NOT NULL AND UE.UserLocation NOT ILIKE '%internet%' AND UE.UserLocation NOT ILIKE '%online%')
)
-- Final SELECT statement with more complex filtering and presentation logic.
SELECT
    HIU.UserId,
    HIU.DisplayName,
    HIU.Reputation,
    HIU.AccountAgeDays,
    HIU.TotalPostsContributed,
    HIU.TotalQuestions,
    HIU.TotalAnswers,
    HIU.TotalNetPostVotes,
    HIU.AcceptedAnswerRatio,
    HIU.TotalBadges,
    HIU.GoldBadges,
    HIU.DistinctTagsUsed,
    HIU.MajorLanguageTagsUsed,
    HIU.InfluenceScore,
    HIU.UserTier,
    -- NULL logic and complex arithmetic for combined views.
    COALESCE(HIU.UserProfileViews, 0) + HIU.TotalQuestionViews AS CombinedTotalViews,
    -- Final user classification based on previous tier and other metrics.
    CASE
        WHEN HIU.UserTier = 'Legendary Contributor' AND HIU.InfluenceScore > 50000 AND HIU.HasDetailedWebsite THEN 'Elite Verified Architect'
        WHEN HIU.UserTier = 'Senior Expert' AND HIU.InfluenceScore > 20000 AND HIU.MaxPostBodyLength > 1000 THEN 'Profound Senior Expert'
        WHEN HIU.UserTier = 'Active Participant' AND HIU.TotalExternalEditorCount = 0 THEN 'Independent Contributor'
        WHEN HIU.MaxPostBodyLength IS NULL OR HIU.MaxPostBodyLength < 200 THEN 'Concise Contributor'
        ELSE 'General Contributor'
    END AS FinalUserClassification,
    -- Elaborate string manipulation for a unique user hash.
    UPPER(LEFT(COALESCE(TRIM(HIU.DisplayName), 'ANON'), 4)) || '_' ||
    LPAD(REPLACE(REPLACE(TO_CHAR(HIU.UserId, 'FM9999999999'), ' ', ''), ',', ''), 10, '0') || '_' ||
    SUBSTRING(MD5(HIU.DisplayName || HIU.UserLocation || HIU.CreationDate::text), 1, 8) AS UserIdentifierHash
FROM
    HighImpactUsers AS HIU
WHERE
    HIU.InfluenceScore IS NOT NULL
    AND HIU.InfluenceScore > 500 -- Filter for genuinely influential users based on calculated score.
    -- Complex predicate combining multiple conditions for final selection.
    AND (HIU.TotalNetPostVotes > 200 OR (HIU.TotalQuestions > 20 AND HIU.AvgQuestionViews > 1000))
    -- Exclude users whose posts are often duplicates AND were reopened (potential problematic pattern).
    AND NOT (HIU.PostsAsDuplicateSource > 0 AND HIU.PostsReopenedCount > 0 AND HIU.AcceptedAnswerRatio < 0.2)
ORDER BY
    HIU.InfluenceScore DESC, HIU.Reputation DESC, HIU.AccountAgeDays ASC
LIMIT 100;