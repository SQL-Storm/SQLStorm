-- {"query": "7600.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 1794} 
WITH RankedPosts AS (
  SELECT 
    p.Id,
    p.PostTypeId,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.OwnerUserId,
    p.Title,
    p.Tags,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as rn,
    LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_score,
    LAG(p.ViewCount) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_views
  FROM Posts p
  WHERE p.PostTypeId IN (1, 2)
),
UserStats AS (
  SELECT 
    u.Id as UserId,
    u.Reputation,
    u.DisplayName,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    COUNT(DISTINCT p.Id) as TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
    SUM(p.Score) as TotalScore,
    AVG(p.Score) as AvgScore,
    MAX(p.CreationDate) as LastPostDate,
    STRING_AGG(DISTINCT p.Title, '; ') as PostTitles
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId
  WHERE u.Reputation > 1000
  GROUP BY u.Id, u.Reputation, u.DisplayName, u.Views, u.UpVotes, u.DownVotes
),
TagAnalysis AS (
  SELECT 
    t.TagName,
    t.Count,
    t.ExcerptPostId,
    t.WikiPostId,
    COALESCE(p1.ViewCount, 0) as ExcerptViews,
    COALESCE(p2.ViewCount, 0) as WikiViews,
    CASE 
      WHEN t.Count > 1000 THEN 'Popular'
      WHEN t.Count > 100 THEN 'Moderate'
      ELSE 'Niche'
    END as TagCategory
  FROM Tags t
  LEFT JOIN Posts p1 ON t.ExcerptPostId = p1.Id
  LEFT JOIN Posts p2 ON t.WikiPostId = p2.Id
),
PostAnalysis AS (
  SELECT 
    rp.Id,
    rp.PostTypeId,
    rp.Score,
    rp.ViewCount,
    rp.CreationDate,
    rp.OwnerUserId,
    rp.Title,
    rp.Tags,
    rp.AnswerCount,
    rp.CommentCount,
    rp.FavoriteCount,
    rp.rn,
    rp.prev_score,
    rp.prev_views,
    CASE 
      WHEN rp.Score > 0 THEN (rp.Score * 100.0 / NULLIF(rp.ViewCount, 0)) 
      ELSE 0 
    END as ScorePerView,
    CASE 
      WHEN rp.prev_score IS NOT NULL THEN (rp.Score - rp.prev_score) 
      ELSE 0 
    END as ScoreChange,
    CASE 
      WHEN rp.prev_views IS NOT NULL THEN (rp.ViewCount - rp.prev_views) 
      ELSE 0 
    END as ViewChange
  FROM RankedPosts rp
),
AnswerQuality AS (
  SELECT 
    a.Id as AnswerId,
    a.PostId as QuestionId,
    a.Score,
    a.CreationDate,
    u.DisplayName as AnswererName,
    u.Reputation as AnswererReputation,
    CASE 
      WHEN a.Score > 10 THEN 'High Quality'
      WHEN a.Score > 0 THEN 'Moderate Quality'
      ELSE 'Low Quality' 
    END as QualityLevel,
    DATEDIFF('day', a.CreationDate, (SELECT MAX(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = a.Id AND ph.PostHistoryTypeId = 12)) as DaysSinceLastEdit
  FROM Posts a
  JOIN Users u ON a.OwnerUserId = u.Id
  WHERE a.PostTypeId = 2 AND a.Score >= 0
),
UserActivity AS (
  SELECT 
    u.Id,
    u.DisplayName,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END), 0) as QuestionsAsked,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END), 0) as AnswersGiven,
    COUNT(DISTINCT c.Id) as CommentsMade,
    COUNT(DISTINCT b.Id) as BadgesEarned,
    COUNT(DISTINCT v.Id) as VotesGiven,
    CASE 
      WHEN COUNT(DISTINCT c.Id) > 100 THEN 'Active'
      WHEN COUNT(DISTINCT c.Id) > 10 THEN 'Moderate'
      ELSE 'Inactive'
    END as ActivityLevel
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId
  LEFT JOIN Comments c ON u.Id = c.UserId
  LEFT JOIN Badges b ON u.Id = b.UserId
  LEFT JOIN Votes v ON u.Id = v.UserId
  GROUP BY u.Id, u.DisplayName
)
SELECT 
  ua.Id as UserId,
  ua.DisplayName,
  ua.QuestionsAsked,
  ua.AnswersGiven,
  ua.CommentsMade,
  ua.BadgesEarned,
  ua.VotesGiven,
  ua.ActivityLevel,
  us.Reputation,
  us.Views,
  us.TotalPosts,
  us.Questions,
  us.Answers,
  us.TotalScore,
  us.AvgScore,
  us.PostTitles,
  COUNT(pa.Id) as RecentQuestions,
  AVG(pa.ScorePerView) as AvgScorePerView,
  AVG(pa.ScoreChange) as AvgScoreChange,
  AVG(pa.ViewChange) as AvgViewChange,
  STRING_AGG(CASE WHEN ta.TagCategory = 'Popular' THEN ta.TagName END, ', ') as PopularTags,
  STRING_AGG(CASE WHEN ta.TagCategory = 'Moderate' THEN ta.TagName END, ', ') as ModerateTags,
  STRING_AGG(CASE WHEN ta.TagCategory = 'Niche' THEN ta.TagName END, ', ') as NicheTags,
  SUM(CASE WHEN aq.QualityLevel = 'High Quality' THEN 1 ELSE 0 END) as HighQualityAnswers,
  AVG(aq.DaysSinceLastEdit) as AvgDaysSinceLastEdit,
  STRING_AGG(DISTINCT pa.Title, '; ') as RecentPostTitles,
  CASE 
    WHEN us.TotalPosts > 100 AND us.AvgScore >= 50 THEN 'Elite'
    WHEN us.TotalPosts > 50 AND us.AvgScore >= 25 THEN 'Experienced'
    WHEN us.TotalPosts > 10 AND us.AvgScore >= 5 THEN 'Regular'
    ELSE 'Beginner'
  END as UserRank,
  DATE_TRUNC('month', MAX(us.LastPostDate)) as MonthlyActivity,
  COUNT(DISTINCT CASE WHEN pa.CreationDate >= DATEADD('month', -3, cast('2024-10-01' as date)) THEN pa.Id END) as RecentPosts3Months
FROM UserActivity ua
JOIN UserStats us ON ua.Id = us.UserId
LEFT JOIN PostAnalysis pa ON us.UserId = pa.OwnerUserId AND pa.rn <= 10
LEFT JOIN TagAnalysis ta ON ta.TagName IN (
  SELECT TRIM(UNNEST(STRING_TO_ARRAY(pa.Tags, '>')))
  FROM PostAnalysis pa
  WHERE pa.OwnerUserId = us.UserId AND pa.Tags IS NOT NULL AND pa.Tags != ''
)
LEFT JOIN AnswerQuality aq ON us.UserId = aq.AnswererId
WHERE ua.ActivityLevel IN ('Active', 'Moderate')
GROUP BY 
  ua.Id, ua.DisplayName, ua.QuestionsAsked, ua.AnswersGiven, 
  ua.CommentsMade, ua.BadgesEarned, ua.VotesGiven, ua.ActivityLevel,
  us.Reputation, us.Views, us.TotalPosts, us.Questions, us.Answers,
  us.TotalScore, us.AvgScore, us.PostTitles, us.LastPostDate
HAVING 
  COUNT(pa.Id) >= 5 AND 
  AVG(pa.ScorePerView) > 0.01 AND
  COUNT(DISTINCT CASE WHEN pa.CreationDate >= DATEADD('month', -3, cast('2024-10-01' as date)) THEN pa.Id END) >= 2
ORDER BY 
  us.Reputation DESC, 
  us.TotalScore DESC,
  ua.QuestionsAsked DESC,
  ua.AnswersGiven DESC
LIMIT 1000;