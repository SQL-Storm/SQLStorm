WITH UserBadgeAgg AS (
    SELECT 
        UserId,
        COUNT(*) AS TotalBadges,
        COUNT(CASE WHEN Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN Class = 3 THEN 1 END) AS BronzeBadges
    FROM Badges
    GROUP BY UserId
),

RecentQuestions AS (
    SELECT
        p.Id,
        p.OwnerUserId,
        p.Score,
        p.Title,
        p.CreationDate,
        COALESCE(
            (SELECT COUNT(*) 
             FROM PostLinks pl 
             WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3),
            0
        ) AS DuplicateCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS RankByScore
    FROM Posts p
    WHERE p.PostTypeId = 1                           -- only questions
      AND p.CreationDate >= cast('2024-10-01' as date) - INTERVAL '90 days'
),

TopTags AS (
    SELECT
        p.OwnerUserId,
        (SELECT string_agg(t.TagName, ',' ORDER BY t.Count DESC)
         FROM unnest(string_to_array(trim(both '<>' FROM p.Tags), '><')) AS tg(tag)
         JOIN Tags t ON t.TagName = tg.tag
         LIMIT 3) AS TopTags
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId
)

SELECT
    u.Id                                   AS UserId,
    COALESCE(u.DisplayName, 'Anonymous')   AS DisplayName,
    u.Reputation,
    COALESCE(b.TotalBadges, 0)              AS TotalBadges,
    COALESCE(b.GoldBadges, 0)               AS GoldBadges,
    COALESCE(b.SilverBadges, 0)             AS SilverBadges,
    COALESCE(b.BronzeBadges, 0)             AS BronzeBadges,
    COALESCE(rq.Score, 0)                   AS RecentQuestionScore,
    COALESCE(rq.RankByScore, 0)             AS RankByScore,
    COALESCE(rq.DuplicateCount, 0)          AS DuplicateCount,
    COALESCE(tt.TopTags, '')                AS TopTags,
    LOWER(SUBSTRING(COALESCE(rq.Title, '') FROM 1 FOR 50)) AS TitleSnippet,
    CASE
        WHEN u.Reputation >= 20000 THEN 'Legendary'
        WHEN u.Reputation >= 10000 THEN 'Expert'
        WHEN u.Reputation >= 1000  THEN 'Seasoned'
        ELSE 'Newbie'
    END                                     AS ReputationTier
FROM Users u
LEFT JOIN UserBadgeAgg b   ON b.UserId = u.Id
LEFT JOIN RecentQuestions rq ON rq.OwnerUserId = u.Id AND rq.RankByScore = 1
LEFT JOIN TopTags tt       ON tt.OwnerUserId = u.Id
WHERE (u.Reputation IS NOT NULL AND u.Reputation > 0)
   OR (rq.Score > 0 AND rq.CreationDate > cast('2024-10-01' as date) - INTERVAL '30 days')
ORDER BY u.Reputation DESC, TotalBadges DESC
LIMIT 100

UNION ALL

SELECT
    -1           AS UserId,
    'Community'  AS DisplayName,
    0            AS Reputation,
    0            AS TotalBadges,
    0            AS GoldBadges,
    0            AS SilverBadges,
    0            AS BronzeBadges,
    0            AS RecentQuestionScore,
    0            AS RankByScore,
    0            AS DuplicateCount,
    ''           AS TopTags,
    ''           AS TitleSnippet,
    'Community'  AS ReputationTier
WHERE NOT EXISTS (SELECT 1 FROM Users WHERE Reputation > 0);