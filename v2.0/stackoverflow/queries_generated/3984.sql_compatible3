WITH
UserBadges AS (
    SELECT
        b.UserId,
        COUNT(*)                               AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        STRING_AGG(DISTINCT b.Name, '; ')       AS BadgeNames
    FROM Badges b
    GROUP BY b.UserId
),

UserVotes AS (
    SELECT
        v.UserId,
        COUNT(*)                                 AS TotalVotes,
        SUM(CASE WHEN vt.Id = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN vt.Id = 3 THEN 1 ELSE 0 END) AS DownVotes,
        AVG(CASE WHEN vt.Id = 2 THEN 1 ELSE -1 END) AS NetVoteScore
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    GROUP BY v.UserId
),

UserPosts AS (
    SELECT
        p.OwnerUserId                                        AS UserId,
        COUNT(CASE WHEN pt.Id = 1 THEN 1 END)                AS QuestionCount,
        COUNT(CASE WHEN pt.Id = 2 THEN 1 END)                AS AnswerCount,
        AVG(CASE WHEN pt.Id = 1 THEN p.Score END)            AS AvgQuestionScore,
        AVG(CASE WHEN pt.Id = 2 THEN p.Score END)            AS AvgAnswerScore,
        MAX(p.CreationDate)                                  AS LastPostDate,
        SUM(p.ViewCount)                                     AS TotalViews,
        COUNT(CASE WHEN pt.Id = 1 AND p.AcceptedAnswerId IS NOT NULL THEN 1 END) AS QuestionsWithAccepted
    FROM Posts p
    JOIN PostTypes pt ON pt.Id = p.PostTypeId
    GROUP BY p.OwnerUserId
),

RecentComments AS (
    SELECT
        u.Id                                              AS UserId,
        (SELECT MAX(c.CreationDate)
         FROM Comments c
         WHERE c.UserId = u.Id)                           AS LastCommentDate,
        (SELECT COUNT(*)
         FROM Comments c
         WHERE c.UserId = u.Id
           AND c.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30' DAY) AS CommentsLast30Days
    FROM Users u
),

NumberSeries AS (
    -- small numbers table sufficient for splitting tags (up to 100 parts). Adjust if needed.
    SELECT ROW_NUMBER() OVER () AS n
    FROM (SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1
          UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1) a,
         (SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1
          UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 1) b
),

UserTagMetrics AS (
    SELECT
        p.OwnerUserId                                 AS UserId,
        TRIM(
          CASE
            WHEN ns.n = 1 THEN SUBSTRING(alltags FROM 1 FOR (CASE WHEN POSITION('><' IN alltags)=0 THEN CHAR_LENGTH(alltags) ELSE POSITION('><' IN alltags)-1 END))
            ELSE
              -- get nth part by splitting using repeated substring logic: find start position of (n-1)th '><' then take until next '><'
              SUBSTRING(
                alltags
                FROM (CASE WHEN nth_start.pos IS NULL THEN 1 ELSE nth_start.pos + 2 END)
                FOR (CASE WHEN nth_end.pos IS NULL THEN CHAR_LENGTH(alltags) - (CASE WHEN nth_start.pos IS NULL THEN 0 ELSE nth_start.pos + 1 END)
                          ELSE nth_end.pos - (CASE WHEN nth_start.pos IS NULL THEN 1 ELSE nth_start.pos + 1 END) END)
              )
          END
        ) AS Tag,
        COUNT(*)                                      AS TagUseCount
    FROM Posts p
    CROSS JOIN LATERAL (
        SELECT REPLACE(REGEXP_REPLACE(p.Tags, '^<|>$', ''), '><', '><') AS alltags
    ) at
    JOIN NumberSeries ns ON ns.n <= (CASE WHEN at.alltags = '' THEN 0 ELSE (CHAR_LENGTH(at.alltags) - CHAR_LENGTH(REPLACE(at.alltags, '><', '')) ) + 1 END)
    LEFT JOIN LATERAL (
        -- position of the (n-1)th '><'
        SELECT MAX(pos) AS pos
        FROM (
          SELECT POSITION('><' IN at.alltags) AS pos, 1 AS idx
          UNION ALL
          SELECT POSITION('><' IN SUBSTRING(at.alltags FROM pos+2)) + pos + 1 AS pos, idx+1
          FROM (
            SELECT POSITION('><' IN at.alltags) AS pos, 1 AS idx
          ) init
          WHERE FALSE
        ) dummy
    ) nth_start ON TRUE
    LEFT JOIN LATERAL (
        -- position of the nth '><'
        SELECT (SELECT pos FROM (VALUES (NULL)) v) AS pos -- placeholder: many dialects lack easy nth position; handled via ns.n bounds
    ) nth_end ON TRUE
    WHERE p.PostTypeId = 1
      AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId, TRIM(
      CASE
        WHEN ns.n = 1 THEN SUBSTRING(at.alltags FROM 1 FOR (CASE WHEN POSITION('><' IN at.alltags)=0 THEN CHAR_LENGTH(at.alltags) ELSE POSITION('><' IN at.alltags)-1 END))
        ELSE
          SUBSTRING(
            at.alltags
            FROM (CASE WHEN NULL IS NULL THEN 1 ELSE 1 END)
            FOR 1
          )
      END
    )
),

UserRanks AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(ub.TotalBadges, 0)         AS TotalBadges,
        COALESCE(up.QuestionCount, 0)      AS QuestionCount,
        COALESCE(up.AnswerCount, 0)        AS AnswerCount,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, COALESCE(ub.TotalBadges,0) DESC) AS RepBadgeRank,
        RANK()       OVER (ORDER BY (COALESCE(up.QuestionCount,0)+COALESCE(up.AnswerCount,0)) DESC) AS ActivityRank
    FROM Users u
    LEFT JOIN UserBadges ub ON ub.UserId = u.Id
    LEFT JOIN UserPosts up  ON up.UserId = u.Id
)

SELECT
    ur.Id                                   AS UserId,
    ur.DisplayName,
    ur.Reputation,
    ur.TotalBadges,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ub.BadgeNames,
    uv.TotalVotes,
    uv.UpVotes,
    uv.DownVotes,
    ROUND(uv.NetVoteScore,2)               AS NetVoteScore,
    up.QuestionCount,
    up.AnswerCount,
    up.AvgQuestionScore,
    up.AvgAnswerScore,
    up.TotalViews,
    up.QuestionsWithAccepted,
    rc.LastCommentDate,
    rc.CommentsLast30Days,
    ur.RepBadgeRank,
    ur.ActivityRank,
    (SELECT STRING_AGG(t.Tag || ':' || CAST(t.TagUseCount AS VARCHAR), ', ')
     FROM (
         SELECT Tag, TagUseCount
         FROM UserTagMetrics utm
         WHERE utm.UserId = ur.Id
         ORDER BY TagUseCount DESC
         LIMIT 3
     ) t)                                   AS TopTags,
    CASE WHEN GREATEST(COALESCE(up.LastPostDate, TIMESTAMP '0001-01-01'), COALESCE(rc.LastCommentDate, TIMESTAMP '0001-01-01')) = TIMESTAMP '0001-01-01'
         THEN 'NeverActive'
         WHEN GREATEST(COALESCE(up.LastPostDate, TIMESTAMP '0001-01-01'), COALESCE(rc.LastCommentDate, TIMESTAMP '0001-01-01')) < TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '180' DAY
         THEN 'Dormant'
         ELSE 'Active'
    END                                    AS ActivityStatus
FROM UserRanks ur
LEFT JOIN UserBadges ub     ON ub.UserId = ur.Id
LEFT JOIN UserVotes uv      ON uv.UserId = ur.Id
LEFT JOIN UserPosts up      ON up.UserId = ur.Id
LEFT JOIN RecentComments rc ON rc.UserId = ur.Id
FULL OUTER JOIN (
    SELECT DISTINCT UserId FROM Badges
    EXCEPT SELECT DISTINCT OwnerUserId FROM Posts
) bonly ON bonly.UserId = ur.Id
WHERE ur.Reputation > 1000
   OR ub.TotalBadges IS NOT NULL
   OR (uv.TotalVotes IS NOT NULL AND uv.TotalVotes > 0)
ORDER BY ur.RepBadgeRank
LIMIT 200;