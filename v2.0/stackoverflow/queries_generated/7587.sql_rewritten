    pm.FavoriteCount,
    pm.PostCreationDate,
    pm.PostTypeDescription,
    pm.ScoreCategory,
    pm.PopularityTier,
    pm.AgeInDays,
    pm.DaysSinceLastActivity,
    pm.ActivityDurationDays,
    pm.ScoreToViewRatio,
    pm.ScoreToAnswerRatio,
    pm.ScoreToCommentRatio,
    pm.ScoreToFavoriteRatio,
    pm.UserPostRank,
    pm.UserTotalPosts,
    pm.UserAvgScore,
    pm.UserAvgViews,
    pm.UserBestScore,
    pm.UserWorstScore,
    pm.PreviousPostScore,
    pm.NextPostScore,
    pm.ScoreChangePercentage,
    pm.NextPostScoreChangePercentage,
    pm.CompositePerformanceScore,
    pm.SignalToNoiseCategory,
    pm.ActivityStatus,
    ROW_NUMBER() OVER (ORDER BY pm.CompositePerformanceScore DESC) as CompositeRank,
    RANK() OVER (ORDER BY pm.TotalScore DESC) as ScoreRank,
    DENSE_RANK() OVER (ORDER BY pm.PostCount DESC) as PostRank,
    PERCENT_RANK() OVER (ORDER BY pm.CompositePerformanceScore DESC) as CompositePercentile,
    NTILE(5) OVER (ORDER BY pm.CompositePerformanceScore DESC) as PerformanceQuintile
FROM PerformanceMetrics pm
WHERE pm.UserId IS NOT NULL 
    AND pm.PostId IS NOT NULL 
    AND pm.Score >= 0 
    AND pm.ViewCount >= 0
    AND pm.AnswerCount >= 0
    AND pm.CommentCount >= 0
    AND pm.FavoriteCount >= 0
    AND pm.AccountAgeDays >= 0
    AND pm.DaysSinceLastAccess >= 0
    AND pm.AgeInDays >= 0
    AND pm.DaysSinceLastActivity >= 0
    AND pm.ActivityDurationDays >= 0
    AND (pm.ScoreToViewRatio BETWEEN 0 AND 100) 
    AND (pm.ScoreChangePercentage BETWEEN -100 AND 100)
    AND pm.CompositePerformanceScore >= 0
    AND pm.CompositePerformanceScore <= 1000000000
ORDER BY pm.CompositePerformanceScore DESC
LIMIT 2500;