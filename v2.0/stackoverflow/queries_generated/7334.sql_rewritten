    NULL AS PostId,
    'Aggregate Summary' AS Title,
    'N/A' AS CleanTitle,
    SUM(Score) AS Score,
    SUM(ViewCount) AS ViewCount,
    SUM(AnswerCount) AS AnswerCount,
