WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT v.Id) AS VoteCount,
        AVG(p.Score) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostActivityRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    WHERE u.CreationDate >= '2010-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        PostCount,
        QuestionCount,
        AnswerCount,
        BadgeCount,
        VoteCount,
        AvgPostScore,
        LastPostDate,
        ReputationRank,
        PostActivityRank,
        CASE 
            WHEN Reputation > 100000 THEN 'Elite'
            WHEN Reputation > 50000 THEN 'Advanced'
            WHEN Reputation > 10000 THEN 'Intermediate'
            ELSE 'Novice'
        END AS ReputationTier,
        CASE 
            WHEN PostCount > 1000 THEN 'Legendary'
            WHEN PostCount > 500 THEN 'Veteran'
            WHEN PostCount > 100 THEN 'Experienced'
            ELSE 'Regular'
        END AS ActivityTier
    FROM UserStats
    WHERE PostCount > 10
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END AS PostTypeDesc,
        COALESCE(p.Title, 'No Title') AS CleanTitle,
        ISNULL(p.Tags, '') AS CleanTags,
        DATEDIFF(day, p.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS AgeInDays,
        CASE 
            WHEN p.Score > 100 THEN 'Highly Voted'
            WHEN p.Score > 50 THEN 'Moderately Voted'
            WHEN p.Score > 0 THEN 'Low Voted'
            ELSE 'Unvoted'
        END AS VoteCategory,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS UserPostRank,
        RANK() OVER (ORDER BY p.Score DESC) AS GlobalScoreRank,
        DENSE_RANK() OVER (ORDER BY p.CreationDate DESC) AS RecentRank,
        LAG(p.Score, 1) OVER (ORDER BY p.CreationDate) AS PrevScore,
        LEAD(p.Score, 1) OVER (ORDER BY p.CreationDate) AS NextScore
    FROM Posts p
    WHERE p.CreationDate >= '2015-01-01'
    AND p.Score IS NOT NULL
),
ComplexPostAnalysis AS (
    SELECT 
        pa.*,
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.ReputationTier,
        tu.ActivityTier,
        CASE 
            WHEN pa.AgeInDays < 30 THEN 'New'
            WHEN pa.AgeInDays < 365 THEN 'Recent'
            WHEN pa.AgeInDays < 1095 THEN 'Established'
            ELSE 'Legacy'
        END AS PostAgeCategory,
        CASE 
            WHEN pa.Score > (SELECT AVG(Score) FROM Posts WHERE CreationDate >= DATEADD(year, -1, cast('2024-10-01 12:34:56' as timestamp))) THEN 'Above Average'
            WHEN pa.Score > (SELECT AVG(Score) FROM Posts WHERE CreationDate >= DATEADD(year, -1, cast('2024-10-01 12:34:56' as timestamp))) * 0.75 THEN 'Average'
            ELSE 'Below Average'
        END AS ScorePerformance,
        CASE 
            WHEN pa.AnswerCount > 10 THEN 'Highly Answered'
            WHEN pa.AnswerCount > 5 THEN 'Moderately Answered'
            WHEN pa.AnswerCount > 0 THEN 'Answered'
            ELSE 'Unanswered'
        END AS AnswerStatus,
        COALESCE(
            (SELECT TOP 1 b.Name 
             FROM Badges b 
             WHERE b.UserId = pa.OwnerUserId 
             AND b.Date >= pa.CreationDate 
             ORDER BY b.Date DESC), 
            'No Recent Badges'
        ) AS RecentBadge,
        IIF(pa.ParentId IS NOT NULL, 
            (SELECT TOP 1 q.Title 
             FROM Posts q 
             WHERE q.Id = pa.ParentId 
             AND q.PostTypeId = 1), 
            'No Parent Question'
        ) AS ParentQuestionTitle,
        LEFT(pa.Tags, 10) AS TagPreview,
        LEN(ISNULL(pa.Tags, '')) AS TagLength,
        PARSENAME(REPLACE(ISNULL(pa.Tags, ''), '<', '.'), 1) AS FirstTag,
        PARSENAME(REPLACE(ISNULL(pa.Tags, ''), '<', '.'), 2) AS SecondTag,
        ISNULL(SUBSTRING(pa.Tags, PATINDEX('%<%', pa.Tags) + 1, 
                         PATINDEX('%>%%', pa.Tags) - PATINDEX('%<%', pa.Tags) - 1), 
               'No Tag') AS ExtractedTagName,
        ABS(pa.Score - COALESCE(pa.PrevScore, 0)) AS ScoreDeltaFromPrevious,
        ABS(pa.Score - COALESCE(pa.NextScore, 0)) AS ScoreDeltaToNext
    FROM PostAnalysis pa
    INNER JOIN TopUsers tu ON pa.OwnerUserId = tu.UserId
),
FilteredPostAnalysis AS (
    SELECT 
        *,
        ROW_NUMBER() OVER (ORDER BY Score DESC, CreationDate DESC) AS RowNum
    FROM ComplexPostAnalysis
    WHERE 
        Score > 0 
        AND ViewCount > 100 
        AND AnswerCount >= 0
        AND (COALESCE(FirstTag, '') LIKE '%sql%' OR COALESCE(SecondTag, '') LIKE '%sql%')
        AND ReputationTier IN ('Elite', 'Advanced')
        AND ScorePerformance IN ('Above Average', 'Average')
        AND AnswerStatus IN ('Highly Answered', 'Moderately Answered')
)

SELECT 
    fpa.PostId,
    fpa.Title,
    fpa.CleanTitle,
    fpa.Score,
    fpa.ViewCount,
    fpa.AnswerCount,
    fpa.CommentCount,
    fpa.OwnerUserId,
    fpa.DisplayName,
    fpa.Reputation,
    fpa.ReputationTier,
    fpa.ActivityTier,
    fpa.PostTypeDesc,
    fpa.AgeInDays,
    fpa.PostAgeCategory,
    fpa.VoteCategory,
    fpa.ScorePerformance,
    fpa.AnswerStatus,
    fpa.RecentBadge,
    fpa.ParentQuestionTitle,
    fpa.TagPreview,
    fpa.TagLength,
    fpa.FirstTag,
    fpa.SecondTag,
    fpa.ExtractedTagName,
    fpa.ScoreDeltaFromPrevious,
    fpa.ScoreDeltaToNext,
    fpa.GlobalScoreRank,
    fpa.RecentRank,
    CASE 
        WHEN fpa.AnswerCount > 0 AND fpa.AnswerCount < 5 THEN 'Few Answers'
        WHEN fpa.AnswerCount >= 5 AND fpa.AnswerCount < 10 THEN 'Some Answers'
        WHEN fpa.AnswerCount >= 10 THEN 'Many Answers'
        ELSE 'No Answers'
    END AS AnswerQuantity,
    CASE 
        WHEN fpa.ViewCount > 1000 THEN 'Viral'
        WHEN fpa.ViewCount > 500 THEN 'Popular'
        WHEN fpa.ViewCount > 100 THEN 'Noticeable'
        ELSE 'Obscure'
    END AS PopularityLevel,
    fpa.CreationDate,
    DATEDIFF(day, fpa.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS DaysSinceCreation,
    fpa.RowNum,
    CASE 
        WHEN fpa.GlobalScoreRank <= 10 THEN 'Top 10'
        WHEN fpa.GlobalScoreRank <= 50 THEN 'Top 50'
        WHEN fpa.GlobalScoreRank <= 100 THEN 'Top 100'
        ELSE 'Below Top 100'
    END AS ScoreRankingTier
FROM FilteredPostAnalysis fpa
WHERE 
    fpa.RowNum BETWEEN 1 AND 20000
    AND fpa.Score > (SELECT AVG(Score) FROM FilteredPostAnalysis WHERE RowNum BETWEEN 1 AND 10000)
    
UNION ALL

