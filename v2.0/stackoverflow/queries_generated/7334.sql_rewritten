    'N/A' AS ReputationTier,
    'N/A' AS ActivityTier,
    'Summary' AS PostTypeDesc,
    NULL AS AgeInDays,
    NULL AS PostAgeCategory,
    'N/A' AS VoteCategory,
    'N/A' AS ScorePerformance,
    'N/A' AS AnswerStatus,
    'N/A' AS RecentBadge,
    'N/A' AS ParentQuestionTitle,
    'N/A' AS TagPreview,
    NULL AS TagLength,
    NULL AS FirstTag,
    NULL AS SecondTag,
    'N/A' AS ExtractedTagName,
    NULL AS ScoreDeltaFromPrevious,
    NULL AS ScoreDeltaToNext,
    NULL AS GlobalScoreRank,
    NULL AS RecentRank,
    'Summary' AS AnswerQuantity,
    'Summary' AS PopularityLevel,
    NULL AS CreationDate,
    NULL AS DaysSinceCreation,
    0 AS RowNum,
    'Summary' AS ScoreRankingTier
FROM FilteredPostAnalysis

ORDER BY CASE WHEN PostId IS NULL THEN 1 ELSE 0 END, Score DESC, CreationDate DESC;