with recent_users as (
    select
        u.id as user_id,
        u.displayname,
        u.reputation,
        u.creationdate,
        u.location,
        coalesce(nullif(trim(u.websiteurl), ''), 'n/a') as websiteurl,
        sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
        sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
        sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
        count(b.id) as total_badges,
        max(b.date) as last_badge_date
    from users u
    left join badges b
      on b.userid = u.id
    where u.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by u.id, u.displayname, u.reputation, u.creationdate, u.location, u.websiteurl
),
questions as (
    select
        p.id as question_id,
        p.owneruserid as asker_id,
        p.creationdate as question_created,
        p.score as question_score,
        p.viewcount,
        p.title,
        p.tags,
        p.acceptedanswerid,
        p.closeddate,
        p.favoritecount,
        p.answercount
    from posts p
    where p.posttypeid = 1
),
answers as (
    select
        a.id as answer_id,
        a.parentid as question_id,
        a.owneruserid as answerer_id,
        a.creationdate as answer_created,
        a.score as answer_score
    from posts a
    where a.posttypeid = 2
),
first_answer_per_q as (
    select
        question_id,
        min(answer_created) as first_answer_time
    from answers
    group by question_id
),
activity_metrics as (
    select
        q.question_id,
        q.asker_id,
        q.question_created,
        q.question_score,
        q.viewcount,
        q.title,
        q.tags,
        q.acceptedanswerid,
        q.closeddate,
        q.favoritecount,
        q.answercount,
        fa.first_answer_time,
        extract(epoch from (fa.first_answer_time - q.question_created)) / 3600.0 as hours_to_first_answer,
        count(a.answer_id) as total_answers,
        sum(case when a.answer_id = q.acceptedanswerid then 1 else 0 end) as has_accepted_answer,
        avg(a.answer_score) as avg_answer_score
    from questions q
    left join answers a
      on a.question_id = q.question_id
    left join first_answer_per_q fa
      on fa.question_id = q.question_id
    group by
        q.question_id, q.asker_id, q.question_created, q.question_score, q.viewcount, q.title, q.tags, q.acceptedanswerid, q.closeddate, q.favoritecount, q.answercount, fa.first_answer_time
),
question_votes as (
    select
        v.postid as post_id,
        sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
        sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
        sum(case when v.votetypeid = 5 then 1 else 0 end) as favorites,
        sum(case when v.votetypeid = 8 then coalesce(v.bountyamount,0) else 0 end) as bounty_started,
        sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded
    from votes v
    group by v.postid
),
duplicate_links as (
    select
        pl.postid as dup_post_id,
        pl.relatedpostid as original_post_id,
        min(pl.creationdate) as first_dup_link_date
    from postlinks pl
    where pl.linktypeid = 3
    group by pl.postid, pl.relatedpostid
),
closure_events as (
    select
        ph.postid,
        min(case when ph.posthistorytypeid = 10 then ph.creationdate end) as first_close_date,
        max(case when ph.posthistorytypeid = 11 then ph.creationdate end) as last_reopen_date,
        max(case when ph.posthistorytypeid = 10 then
            case
                when ph.comment ~ '^[0-9]+$' then cast(ph.comment as integer)
                else null
            end
         end) as last_close_reason_id
    from posthistory ph
    where ph.posthistorytypeid in (10,11)
    group by ph.postid
),
tag_expansion as (
    select
        q.question_id,
        unnest(string_to_array(substring(q.tags, 2, greatest(length(q.tags)-2, 0)), '><')) as tagname
    from questions q
    where q.tags is not null
),
tag_rank as (
    select
        te.question_id,
        te.tagname,
        t.count as tag_usage_count,
        dense_rank() over (partition by te.question_id order by coalesce(t.count, 0) desc, te.tagname asc) as tag_pop_rank
    from tag_expansion te
    left join tags t
      on lower(t.tagname) = lower(te.tagname)
),
user_stats as (
    select
        ru.user_id,
        ru.displayname,
        ru.reputation,
        ru.creationdate,
        ru.location,
        ru.websiteurl,
        ru.gold_badges,
        ru.silver_badges,
        ru.bronze_badges,
        ru.total_badges,
        ru.last_badge_date,
        count(distinct q.question_id) as questions_count,
        count(distinct a.answer_id) as answers_count,
        sum(coalesce(qv.upvotes,0) - coalesce(qv.downvotes,0)) as net_question_votes,
        sum(coalesce(av.upvotes,0) - coalesce(av.downvotes,0)) as net_answer_votes
    from recent_users ru
    left join questions q
      on q.asker_id = ru.user_id
    left join answers a
      on a.answerer_id = ru.user_id
    left join question_votes qv
      on qv.post_id = q.question_id
    left join (
        select
            v.postid,
            sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
            sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes
        from votes v
        join posts p on p.id = v.postid and p.posttypeid = 2
        group by v.postid
    ) av on av.postid = a.answer_id
    group by
        ru.user_id, ru.displayname, ru.reputation, ru.creationdate, ru.location, ru.websiteurl,
        ru.gold_badges, ru.silver_badges, ru.bronze_badges, ru.total_badges, ru.last_badge_date
),
scored_questions as (
    select
        am.*,
        qv.upvotes,
        qv.downvotes,
        qv.favorites,
        qv.bounty_started,
        qv.bounty_awarded,
        ce.first_close_date,
        ce.last_reopen_date,
        ce.last_close_reason_id,
        sum(coalesce(qv.upvotes,0)) over (order by am.question_created rows between unbounded preceding and current row) as running_upvotes,
        sum(coalesce(qv.downvotes,0)) over (order by am.question_created rows between unbounded preceding and current row) as running_downvotes,
        row_number() over (partition by am.asker_id order by am.viewcount desc NULLS LAST, am.question_created desc) as rn_by_views
    from activity_metrics am
    left join question_votes qv on qv.post_id = am.question_id
    left join closure_events ce on ce.postid = am.question_id
),
labelled_questions as (
    select
        sq.*,
        case
            when sq.closeddate is not null and (sq.first_close_date is not null) then 'closed'
            when sq.has_accepted_answer > 0 then 'answered'
            when sq.total_answers = 0 and coalesce(sq.viewcount,0) > 0 then 'unanswered'
            else 'other'
        end as status_label,
        case when sq.hours_to_first_answer is null then 999999.0 else sq.hours_to_first_answer end as hours_to_first_answer_nz,
        coalesce(sq.upvotes, 0) - coalesce(sq.downvotes, 0) as net_votes,
        coalesce(nullif(trim(sq.title), ''), '[no title]') as safe_title
    from scored_questions sq
),
question_quality as (
    select
        lq.question_id,
        lq.asker_id,
        lq.safe_title,
        lq.viewcount,
        lq.favoritecount,
        lq.net_votes,
        lq.status_label,
        lq.hours_to_first_answer_nz,
        lq.rn_by_views,
        exp(least(10.0, greatest(-10.0,
            0.002 * coalesce(lq.viewcount,0) +
            0.5 * coalesce(lq.net_votes,0) +
            0.1 * coalesce(lq.favoritecount,0) -
            0.05 * coalesce(lq.total_answers,0) -
            case when lq.closeddate is not null then 5.0 else 0.0 end -
            case when lq.has_accepted_answer > 0 then 0.0 else 1.0 end -
            ln(1.0 + lq.hours_to_first_answer_nz)
        ))) as quality_score
    from labelled_questions lq
),
top_tags_per_q as (
    select
        tr.question_id,
        string_agg(tr.tagname, ', ' order by tr.tag_pop_rank) as top_tags
    from tag_rank tr
    where tr.tag_pop_rank <= 3
    group by tr.question_id
),
user_question_rollup as (
    select
        uq.user_id,
        uq.displayname,
        uq.reputation,
        uq.creationdate,
        uq.location,
        uq.websiteurl,
        uq.gold_badges, uq.silver_badges, uq.bronze_badges, uq.total_badges, uq.last_badge_date,
        count(qq.question_id) as total_questions,
        avg(qq.quality_score) as avg_quality_score,
        percentile_cont(0.9) within group (order by qq.quality_score) as p90_quality_score,
        sum(case when qq.status_label = 'answered' then 1 else 0 end) as answered_qs,
        sum(case when qq.status_label = 'unanswered' then 1 else 0 end) as unanswered_qs,
        max(qq.quality_score) as max_quality_score
    from user_stats uq
    left join question_quality qq
      on qq.asker_id = uq.user_id
    group by
        uq.user_id, uq.displayname, uq.reputation, uq.creationdate, uq.location, uq.websiteurl,
        uq.gold_badges, uq.silver_badges, uq.bronze_badges, uq.total_badges, uq.last_badge_date
),
dupe_network as (
    select
        q.question_id,
        count(distinct dl.original_post_id) as duplicates_of_count,
        min(dl.first_dup_link_date) as first_dup_link_date
    from questions q
    left join duplicate_links dl
      on dl.dup_post_id = q.question_id
    group by q.question_id
),
filtered_questions as (
    select
        qq.question_id,
        qq.asker_id,
        qq.quality_score,
        coalesce(tt.top_tags, '') as top_tags,
        dn.duplicates_of_count,
        qq.rn_by_views
    from question_quality qq
    left join top_tags_per_q tt on tt.question_id = qq.question_id
    left join dupe_network dn on dn.question_id = qq.question_id
    where qq.rn_by_views <= 50
),
ranked_questions as (
    select
        fq.*,
        dense_rank() over (partition by fq.asker_id order by fq.quality_score desc, fq.question_id asc) as rank_within_user
    from filtered_questions fq
)
select
    uqr.user_id,
    uqr.displayname,
    uqr.reputation,
    uqr.creationdate,
    coalesce(nullif(uqr.location, ''), 'unknown') as location,
    uqr.websiteurl,
    uqr.gold_badges, uqr.silver_badges, uqr.bronze_badges, uqr.total_badges,
    uqr.total_questions,
    uqr.answered_qs,
    uqr.unanswered_qs,
    round(coalesce(uqr.avg_quality_score, 0.0)::numeric, 4) as avg_quality_score,
    round(coalesce(uqr.p90_quality_score, 0.0)::numeric, 4) as p90_quality_score,
    round(coalesce(uqr.max_quality_score, 0.0)::numeric, 4) as max_quality_score,
    rq.question_id as sample_top_question_id,
    rq.quality_score as sample_top_quality_score,
    rq.top_tags as sample_top_tags,
    rq.duplicates_of_count as sample_dupe_refs
from user_question_rollup uqr
left join lateral (
    select question_id, quality_score, top_tags, duplicates_of_count
    from ranked_questions rq
    where rq.asker_id = uqr.user_id
    and rq.rank_within_user = 1
    order by rq.question_id
    limit 1
) rq on true
where
    (uqr.total_questions > 0 or uqr.answers_count > 0)
    and (uqr.net_question_votes + uqr.net_answer_votes) >= (
        select percentile_disc(0.5) within group (order by (us.net_question_votes + us.net_answer_votes))
        from user_stats us
    )
order by
    coalesce(uqr.p90_quality_score, 0.0) desc,
    uqr.total_questions desc,
    uqr.reputation desc
limit 200;