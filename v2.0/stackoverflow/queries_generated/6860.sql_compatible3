SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.UserId END) AS TotalUpVotes,
    COUNT(DISTINCT CASE WHEN bh.Id IS NOT NULL THEN bh.UserId END) AS TotalBadges,
    COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN pl.RelatedPostId END) AS TotalDuplicatePosts,
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.UserId END) AS TotalClosedPosts,
    MAX(u.CreationDate) AS LatestAccountActivity,
    COALESCE(
      -- standard SQL string aggregation, try STRING_AGG style first, otherwise fallback to LISTAGG
      STRING_AGG(DISTINCT t.TagName, ', ' ORDER BY t.TagName),
      LISTAGG(t.TagName, ', ') WITHIN GROUP (ORDER BY t.TagName),
      array_to_string(array_agg(DISTINCT t.TagName ORDER BY t.TagName), ', ')
    ) AS PopularTags
FROM 
    Users u
LEFT JOIN 
    Badges bh ON u.Id = bh.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    PostLinks pl ON p.Id = pl.PostId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    Tags t ON p.Id = t.ExcerptPostId
WHERE 
    u.Reputation > 1000
    AND u.Id NOT IN (SELECT DISTINCT OwnerUserId FROM Posts WHERE PostTypeId = 7)
    AND (u.LastAccessDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY) OR u.LastAccessDate IS NULL)
GROUP BY 
    u.Id, u.DisplayName, u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    u.Reputation DESC, TotalPosts DESC
LIMIT 100;