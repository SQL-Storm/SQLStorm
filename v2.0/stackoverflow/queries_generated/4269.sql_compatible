WITH RankedQuestions AS (
    SELECT
        p.Id AS QuestionId,
        p.Title AS QuestionTitle,
        p.CreationDate AS QuestionCreationDate,
        p.OwnerUserId AS QuestionOwnerUserId,
        p.Score AS QuestionScore,
        u.DisplayName AS QuestionOwnerDisplayName,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn_user_questions,
        COUNT(a.Id) OVER (PARTITION BY p.Id) AS AnswerCountForQuestion,
        SUM(a.Score) OVER (PARTITION BY p.Id) AS TotalAnswerScoreForQuestion,
        AVG(CAST(a.CommentCount AS numeric)) OVER (PARTITION BY p.Id) AS AvgAnswerCommentCountForQuestion
    FROM
        Posts p
    LEFT JOIN
        Users u ON p.OwnerUserId = u.Id
    LEFT JOIN
        Posts a ON p.Id = a.ParentId AND a.PostTypeId = 2
    WHERE
        p.PostTypeId = 1
        AND p.CreationDate >= DATE '2023-01-01'
    GROUP BY
        p.Id, p.Title, p.CreationDate, p.OwnerUserId, p.Score, u.DisplayName
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(u.Reputation) AS MaxReputation,
        MIN(u.CreationDate) AS UserFirstPostDate,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
        SUM(p.Score) AS TotalPostScore,
        COUNT(DISTINCT c.Id) AS CommentCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
        MAX(p.LastActivityDate) AS LatestActivityDate
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    LEFT JOIN
        Comments c ON u.Id = c.UserId
    LEFT JOIN
        Votes v ON u.Id = v.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY
        u.Id, u.DisplayName
),
HighValueAnswers AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.OwnerUserId AS AnswerOwnerUserId,
        a.Score AS AnswerScore,
        u.DisplayName AS AnswerOwnerDisplayName,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS rn_answer_score
    FROM
        Posts a
    JOIN
        Users u ON a.OwnerUserId = u.Id
    WHERE
        a.PostTypeId = 2
        AND a.Score > 10
)
SELECT
    rq.QuestionId,
    rq.QuestionTitle,
    rq.QuestionCreationDate,
    rq.QuestionOwnerDisplayName,
    rq.QuestionScore,
    rq.AnswerCountForQuestion,
    rq.TotalAnswerScoreForQuestion,
    rq.AvgAnswerCommentCountForQuestion,
    ua.BadgeCount,
    ua.MaxReputation,
    ua.UserFirstPostDate,
    ua.QuestionCount AS UserTotalQuestions,
    ua.AnswerCount AS UserTotalAnswers,
    ua.TotalPostScore AS UserTotalScore,
    ua.CommentCount AS UserTotalComments,
    ua.UpVoteCount AS UserTotalUpVotes,
    ua.DownVoteCount AS UserTotalDownVotes,
    COALESCE(hva.AnswerOwnerDisplayName, 'Community') AS BestAnswerOwner,
    COALESCE(hva.AnswerScore, 0) AS BestAnswerScore,
    CASE WHEN rq.QuestionOwnerUserId = ua.UserId THEN 'Same User' ELSE 'Different User' END AS OwnerRelationship,
    (rq.QuestionScore * 1.0 / NULLIF(rq.AnswerCountForQuestion, 0)) AS ScorePerAnswerRatio,
    CASE WHEN LENGTH(rq.QuestionTitle) > 50 THEN SUBSTRING(rq.QuestionTitle FROM 1 FOR 50) || '...' ELSE rq.QuestionTitle END AS TruncatedTitle,
    ua.LatestActivityDate
FROM
    RankedQuestions rq
LEFT JOIN
    UserActivity ua ON rq.QuestionOwnerUserId = ua.UserId
LEFT JOIN
    HighValueAnswers hva ON rq.QuestionId = hva.QuestionId AND hva.rn_answer_score = 1
WHERE
    (
      ua.MaxReputation > 10000
      AND rq.QuestionScore > 50
      AND EXISTS (SELECT 1 FROM PostLinks pl WHERE pl.PostId = rq.QuestionId AND pl.LinkTypeId = 3)
    )
    OR ua.BadgeCount >= 5
ORDER BY
    rq.QuestionCreationDate DESC, rq.QuestionScore DESC
LIMIT 100;