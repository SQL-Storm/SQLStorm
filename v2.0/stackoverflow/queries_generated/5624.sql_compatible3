SELECT
  u.Id AS UserId,
  u.DisplayName,
  u.Reputation,
  COUNT(p.Id) AS PostCount,
  AVG(p.Score) AS AvgPostScore,
  SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
  SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
  MAX(p.LastActivityDate) AS LastActive,
  COUNT(DISTINCT b.Id) AS BadgeCount,
  MAX(b.Date) AS MostRecentBadgeDate,
  STRING_AGG(DISTINCT t.Name, ',') AS TopTags
FROM
  Users u
LEFT JOIN
  Posts p ON p.OwnerUserId = u.Id
LEFT JOIN
  Badges b ON b.UserId = u.Id
LEFT JOIN
  Tags t ON EXISTS (
    SELECT 1
    FROM (
      SELECT UNNEST(string_to_array(REPLACE(p_sub.Tags, '><', '|'), '|')) AS tag
      FROM Posts p_sub
      WHERE p_sub.OwnerUserId = u.Id
      LIMIT 1
    ) AS derived_tags
    WHERE derived_tags.tag = t.Name
  )
WHERE
  u.Id IS NOT NULL
GROUP BY
  u.Id, u.DisplayName, u.Reputation, MAX(p.LastActivityDate)
HAVING
  COUNT(p.Id) > 5
ORDER BY
  u.Reputation DESC,
  MAX(p.LastActivityDate) DESC
LIMIT 100;