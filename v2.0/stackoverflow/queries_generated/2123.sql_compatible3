with recursive RecursiveTagHierarchy as (
    select 
        t.Id, 
        t.TagName, 
        t.Count,
        array[t.Id::text] as AncestorPath
    from Tags t
    where t.Id = t.Id
    union all
    select 
        t.Id, 
        t.TagName, 
        t.Count,
        (r.AncestorPath || t.Id::text) as AncestorPath
    from Tags t
    join RecursiveTagHierarchy r on t.ExcerptPostId = r.Id
    where not EXISTS (
      select 1 from unnest(r.AncestorPath) x where x = t.Id::text
    )
), 
UserBadgeStats as (
    select 
        u.Id as UserId,
        u.DisplayName,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        case when u.Reputation > 30000 then 'Elite'
             when u.Reputation > 10000 then 'Pro'
             else 'Regular' end as UserLevel,
        dense_rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
),
QuestionAnswerStats as (
    select 
        p.Id as QuestionId,
        p.Title,
        p.CreationDate as QuestionDate,
        p.OwnerUserId,
        p.Score as QuestionScore,
        p.ViewCount,
        p.Tags,
        count(a.Id) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore,
        min(a.Score) as MinAnswerScore,
        count(c.Id) as CommentCount
    from Posts p
    left join Posts a on a.ParentId = p.Id and a.PostTypeId = 2
    left join Comments c on c.PostId = p.Id
    where p.PostTypeId = 1
    group by p.Id, p.Title, p.CreationDate, p.OwnerUserId, p.Score, p.ViewCount, p.Tags
),
DuplicateLinkedQuestions as (
    select 
        pl.PostId,
        pl.RelatedPostId,
        p1.Title as QuestionTitle,
        p2.Title as DuplicatedQuestionTitle,
        pl.CreationDate as LinkCreated,
        pl.LinkTypeId
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId and p1.PostTypeId = 1
    join Posts p2 on p2.Id = pl.RelatedPostId and p2.PostTypeId = 1
    where pl.LinkTypeId = 3
),
UserActivityWindow as (
    select 
        u.Id as UserId,
        u.DisplayName,
        p.PostTypeId,
        count(p.Id) over (partition by u.Id, p.PostTypeId order by p.CreationDate 
                          rows between unbounded preceding and current row) as RunningPostCount,
        row_number() over (partition by u.Id order by p.CreationDate desc) as RecentPostRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
),
QuestionsWithCloseDetails as (
    select 
        p.Id,
        p.Title,
        p.ClosedDate,
        cht.Name as CloseReason,
        ph.UserDisplayName as ClosedByUser,
        ph.CreationDate as CloseVoteDate
    from Posts p
    left join PostHistory ph on ph.PostId = p.Id and ph.PostHistoryTypeId = 10
    left join CloseReasonTypes cht on cht.Id = cast(ph.Comment as smallint)
    where p.PostTypeId = 1 and p.ClosedDate is not null
),
HighEngagementUsers as (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as TotalUpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as TotalDownVotes,
        count(distinct b.Id) as BadgeCount
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.PostId = p.Id
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
    having sum(case when v.VoteTypeId = 2 then 1 else 0 end) > 1000
       and count(distinct b.Id) > 10
)
select 
    qas.QuestionId,
    qas.Title as QuestionTitle,
    qas.QuestionDate,
    qas.ViewCount,
    qas.AnswerCount,
    coalesce(qas.AvgAnswerScore,0) as AvgAnswerScore,
    qas.MaxAnswerScore,
    qas.MinAnswerScore,
    qas.CommentCount,
    ubs.DisplayName as QuestionOwner,
    ubs.UserLevel,
    ubs.ReputationRank,
    dql.DuplicatedQuestionTitle,
    dql.LinkCreated as DuplicateLinkDate,
    qcd.CloseReason,
    qcd.ClosedByUser,
    qcd.CloseVoteDate,
    heu.DisplayName as HighEngagementUser,
    heu.Reputation as HighEngagementReputation,
    heu.TotalUpVotes,
    heu.TotalDownVotes,
    heu.BadgeCount,
    (
        select coalesce(stddev_pop(a.Score),0) from Posts a 
        where a.ParentId = qas.QuestionId and a.PostTypeId = 2
    ) * 
    (
        select coalesce(sum(t.Count),1) from RecursiveTagHierarchy t 
        where t.TagName = any(string_to_array(replace(replace(qas.Tags,'<',''),'>',''),' '))
    ) as WeightedScoreVolatility
from QuestionAnswerStats qas
left join UserBadgeStats ubs on ubs.UserId = qas.OwnerUserId
left join DuplicateLinkedQuestions dql on dql.PostId = qas.QuestionId
left join QuestionsWithCloseDetails qcd on qcd.Id = qas.QuestionId
left join HighEngagementUsers heu on heu.Id = qas.OwnerUserId
where qas.AnswerCount > 3
  and qas.QuestionScore > 5
  and (qcd.CloseReason is null or qcd.CloseReason not in ('Exact Duplicate', 'Duplicate'))
  and ubs.UserLevel in ('Elite','Pro')
order by qas.AnswerCount desc, qas.ViewCount desc
limit 100;