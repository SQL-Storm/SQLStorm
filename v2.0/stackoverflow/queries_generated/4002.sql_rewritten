          AND rp2.PostTypeId = 2
      )
  ) AS ScoreOfAnswersAboveAverage,
  LOWER(SUBSTRING(tu.DisplayName FROM 1 FOR 3)) AS FirstThreeCharsOfDisplayName
FROM
  TopUsers AS tu
  JOIN Users AS u
  ON tu.OwnerUserId = u.Id
