-- {"query": "1338.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3002} 
WITH UserEngagement AS (
    -- Summarizes user contributions and activity metrics, including a look-back for reputation change.
    SELECT
        u.Id AS UserId,
        u.DisplayName AS UserName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        u.UpVotes AS UserUpVotesGiven,
        u.DownVotes AS UserDownVotesGiven,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END), 0) AS QuestionsAsked,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END), 0) AS AnswersProvided,
        COALESCE(SUM(CASE WHEN p.PostTypeId IN (1, 2) THEN p.Score ELSE 0 END), 0) AS TotalPostScore,
        COALESCE(COUNT(DISTINCT b.Id), 0) AS TotalBadges,
        COALESCE(COUNT(DISTINCT c.Id), 0) AS TotalCommentsMade,
        LAG(u.Reputation, 1, 0) OVER (ORDER BY u.CreationDate) AS PreviousUserReputationSnapshot -- Window function for historical comparison
    FROM Users AS u
    LEFT JOIN Posts AS p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges AS b ON u.Id = b.UserId
    LEFT JOIN Comments AS c ON u.Id = c.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.UpVotes, u.DownVotes
),
PostHistoricalMetrics AS (
    -- Tracks detailed post changes, moderation flags, and calculates derived metrics.
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate AS PostCreationDate,
        p.LastEditDate,
        p.Score AS CurrentScore,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.Title,
        p.Tags,
        p.AcceptedAnswerId,
        -- Non-correlated subquery for counting specific post history events
        COALESCE(
            (SELECT COUNT(DISTINCT ph.Id)
             FROM PostHistory AS ph
             WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4, 5, 6) -- Title, Body, Tags edits
            ), 0
        ) AS EditCount,
        COALESCE(
            (SELECT MAX(ph.CreationDate)
             FROM PostHistory AS ph
             WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4, 5, 6)
            ), p.LastEditDate
        ) AS LatestEditHistoryDate,
        (SELECT COUNT(ph.Id) FROM PostHistory AS ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10) AS CloseVotesCount,
        (SELECT COUNT(ph.Id) FROM PostHistory AS ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 11) AS ReopenVotesCount,
        DENSE_RANK() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS UserPostScoreRank,
        EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - p.CreationDate)) / (60 * 60 * 24) AS PostAgeDays, -- Complex date calculation
        -- Correlated subquery to fetch the reputation of the accepted answer's owner
        (SELECT u_ans.Reputation
         FROM Posts AS ans
         JOIN Users AS u_ans ON ans.OwnerUserId = u_ans.Id
         WHERE ans.Id = p.AcceptedAnswerId AND p.AcceptedAnswerId IS NOT NULL) AS AcceptedAnswerOwnerReputation
    FROM Posts AS p
),
TagPerformanceOverview AS (
    -- Aggregates performance statistics for individual tags, including a quartile ranking.
    SELECT
        LOWER(TRIM(UNNEST(string_to_array(SUBSTRING(phm.Tags, 2, LENGTH(phm.Tags)-2), '><')))) AS TagName, -- String manipulation for tags
        COUNT(DISTINCT phm.PostId) AS QuestionsWithTag,
        COALESCE(SUM(phm.CurrentScore), 0) AS TotalTagScore,
        COALESCE(SUM(phm.ViewCount), 0) AS TotalTagViews,
        AVG(CASE WHEN phm.PostTypeId = 1 THEN phm.CurrentScore ELSE NULL END) AS AvgQuestionScoreByTag,
        NTILE(4) OVER (ORDER BY COALESCE(SUM(phm.ViewCount), 0) DESC) AS ViewCountQuartile -- Window function for bucketing tags
    FROM PostHistoricalMetrics AS phm
    WHERE phm.PostTypeId = 1 AND phm.Tags IS NOT NULL AND LENGTH(TRIM(phm.Tags)) > 2
    GROUP BY LOWER(TRIM(UNNEST(string_to_array(SUBSTRING(phm.Tags, 2, LENGTH(phm.Tags)-2), '><'))))
),
UserAnswerQuality AS (
    -- Calculates average answer score and accepted answer count per user.
    SELECT
        p.OwnerUserId AS UserId,
        AVG(p.Score) AS AvgAnswerScore,
        COUNT(p.Id) AS TotalUserAnswers,
        SUM(CASE WHEN p.ParentId IS NOT NULL AND p.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) AS AcceptedAnswersCount
    FROM Posts AS p
    JOIN Posts AS q ON p.ParentId = q.Id
    WHERE p.PostTypeId = 2
    GROUP BY p.OwnerUserId
),
RecentModerationEvents AS (
    -- Identifies the latest moderation event for each post, including close reasons.
    SELECT
        me.PostId,
        me.EventDate AS LatestModerationEventDate,
        ph_type.Name AS EventTypeName,
        me.CloseReasonName,
        u.DisplayName AS ModeratorDisplayName
    FROM (
        SELECT
            ph.PostId,
            ph.CreationDate AS EventDate,
            ph.PostHistoryTypeId,
            ph.UserId AS ModeratorId,
            ph.Comment AS CloseReasonIdComment,
            CASE -- Complex logic to derive close reason name
                WHEN ph.PostHistoryTypeId = 10 AND ph.Comment IS NOT NULL AND ph.Comment ~ '^[0-9]+$' THEN
                    (SELECT crt.Name FROM CloseReasonTypes AS crt WHERE crt.Id = CAST(ph.Comment AS smallint))
                WHEN ph.PostHistoryTypeId = 10 AND ph.Comment IS NOT NULL AND NOT ph.Comment ~ '^[0-9]+$' THEN ph.Comment -- Handles old text-based close reasons
                ELSE NULL
            END AS CloseReasonName,
            ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn -- Window function to get latest
        FROM PostHistory AS ph
        WHERE ph.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15, 19, 20, 35, 36) -- Various moderation/lifecycle events
    ) AS me
    LEFT JOIN PostHistoryTypes AS ph_type ON me.PostHistoryTypeId = ph_type.Id
    LEFT JOIN Users AS u ON me.ModeratorId = u.Id
    WHERE me.rn = 1
),
HighlyEngagedUsers AS (
    -- Filters for users with substantial activity based on multiple quantitative criteria.
    SELECT ue.UserId, ue.UserName
    FROM UserEngagement AS ue
    WHERE ue.Reputation > 5000
      AND ue.QuestionsAsked >= 50
      AND ue.AnswersProvided >= 100
      AND ue.TotalCommentsMade >= 200
      -- Subquery for advanced NULL logic: users with several old posts that haven't been edited recently
      AND (
          SELECT COUNT(p.Id)
          FROM Posts p
          WHERE p.OwnerUserId = ue.UserId
            AND p.LastEditDate IS NOT NULL
            AND p.LastEditDate < (cast('2024-10-01' as date) - INTERVAL '1 year')
            AND p.ClosedDate IS NULL -- Exclude closed posts
      ) > 5
),
UsersWithHighImpactPosts AS (
    -- Identifies users who own posts with high views, scores, and edits within top-performing tags.
    SELECT DISTINCT ue.UserId, ue.UserName
    FROM UserEngagement AS ue
    JOIN PostHistoricalMetrics AS phm ON ue.UserId = phm.OwnerUserId
    -- Outer join to TagPerformanceOverview to potentially include posts from tags not in the top quartile
    LEFT JOIN TagPerformanceOverview AS tpo ON LOWER(TRIM(UNNEST(string_to_array(SUBSTRING(phm.Tags, 2, LENGTH(phm.Tags)-2), '><')))) = tpo.TagName
    WHERE phm.PostTypeId = 1
      AND phm.ViewCount > 10000
      AND phm.CurrentScore > 50
      AND COALESCE(tpo.ViewCountQuartile, 0) = 1 -- Include posts from top quartile tags, or if tag is not found (COALESCE to 0)
      AND phm.EditCount > 2
),
CombinedUserSet AS (
    -- Combines users from the two high-engagement criteria using a set operator.
    SELECT UserId, UserName FROM HighlyEngagedUsers
    UNION
    SELECT UserId, UserName FROM UsersWithHighImpactPosts
)
-- Final selection from the combined, filtered, and enriched datasets.
SELECT
    cu.UserId,
    cu.UserName,
    ue.Reputation,
    ue.QuestionsAsked,
    ue.AnswersProvided,
    ue.TotalCommentsMade,
    ue.TotalBadges,
    uaq.AvgAnswerScore,
    uaq.AcceptedAnswersCount,
    phm.PostId,
    phm.Title AS PostTitle,
    phm.CurrentScore AS PostScore,
    phm.ViewCount AS PostViewCount,
    phm.EditCount AS PostEditCount,
    phm.CloseVotesCount,
    phm.ReopenVotesCount,
    phm.PostCreationDate,
    phm.LastEditDate AS PostLastEditDate,
    phm.UserPostScoreRank,
    r_mod.LatestModerationEventDate,
    r_mod.EventTypeName AS LatestModerationEventType,
    r_mod.CloseReasonName,
    r_mod.ModeratorDisplayName,
    tpo.AvgQuestionScoreByTag AS AvgSiteQuestionScoreForTag,
    -- Complex calculation demonstrating NULLIF for division by zero and CAST for type conversion
    CAST(phm.CurrentScore AS decimal) / COALESCE(NULLIF(phm.ViewCount, 0), 1) AS PostViewScoreRatio,
    (ue.Reputation - ue.PreviousUserReputation) AS ReputationChangeSinceLastUser,
    phm.AcceptedAnswerOwnerReputation
FROM CombinedUserSet AS cu
JOIN UserEngagement AS ue ON cu.UserId = ue.UserId
LEFT JOIN UserAnswerQuality AS uaq ON cu.UserId = uaq.UserId
LEFT JOIN PostHistoricalMetrics AS phm ON cu.UserId = phm.OwnerUserId
LEFT JOIN RecentModerationEvents AS r_mod ON phm.Id = r_mod.PostId
-- Join to TagPerformanceOverview for tag-specific metrics. If a post has multiple tags, it will be duplicated.
LEFT JOIN TagPerformanceOverview AS tpo ON LOWER(TRIM(UNNEST(string_to_array(SUBSTRING(phm.Tags, 2, LENGTH(phm.Tags)-2), '><')))) = tpo.TagName
WHERE phm.PostTypeId = 1 -- Focusing on questions for these users
  AND phm.UserPostScoreRank <= 5 -- Selecting only the top 5 questions per user based on score
  AND phm.AcceptedAnswerId IS NOT NULL -- Only questions that have an accepted answer
  AND (phm.Title ILIKE '%sql%' OR phm.Title ILIKE '%performance%' OR phm.Tags ILIKE '%<database>%') -- Complex string pattern matching
  AND NOT EXISTS ( -- Correlated subquery to filter out posts that are duplicates
      SELECT 1
      FROM PostLinks pl
      WHERE pl.PostId = phm.PostId AND pl.LinkTypeId = 3
  )
  -- Advanced conditional logic involving post history and age
  AND (
      (phm.CloseVotesCount > 0 AND r_mod.EventTypeName = 'Post Reopened') -- Posts that were closed but later reopened
      OR
      (phm.CloseVotesCount = 0 AND phm.EditCount >= 3 AND phm.PostAgeDays > 365 AND phm.PostAgeDays < 1000) -- Old, heavily edited but never closed posts
  )
ORDER BY ue.Reputation DESC, PostViewScoreRatio DESC, phm.PostId
LIMIT 100;