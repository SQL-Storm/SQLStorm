WITH 
user_posts AS (
    SELECT 
        u.id                                 AS user_id,
        u.displayname                        AS display_name,
        u.reputation                         AS reputation,
        COUNT(p.id) FILTER (WHERE p.posttypeid = 1) AS question_cnt,
        COUNT(p.id) FILTER (WHERE p.posttypeid = 2) AS answer_cnt,
        COALESCE(SUM(p.score),0)              AS total_score,
        MAX(p.creationdate)                  AS last_post_date,
        (SELECT COUNT(DISTINCT unnest_tags.tag)
         FROM (
               SELECT 
                     regexp_split_to_table(trim(both '><' FROM p.tags), '><') AS tag
               FROM posts p
               WHERE p.owneruserid = u.id
                 AND p.posttypeid = 1
                 AND p.tags IS NOT NULL
         ) AS unnest_tags)                  AS distinct_tag_cnt
    FROM users u
    LEFT JOIN posts p
           ON p.owneruserid = u.id
    GROUP BY u.id, u.displayname, u.reputation
),
user_badges AS (
    SELECT 
        b.userid                               AS user_id,
        COUNT(*)                               AS badge_cnt,
        MAX(CASE WHEN b.class = 1 THEN 1 ELSE 0 END) AS has_gold,
        STRING_AGG(CASE WHEN b.class = 3 THEN b.name END, ',') FILTER (WHERE b.class = 3) AS bronze_badges
    FROM badges b
    GROUP BY b.userid
),
user_votes AS (
    SELECT 
        v.userid                               AS user_id,
        COUNT(*) FILTER (WHERE vt.name = 'UpMod')   AS up_votes_given,
        COUNT(*) FILTER (WHERE vt.name = 'DownMod') AS down_votes_given,
        MAX(v.creationdate)                    AS last_vote_date
    FROM votes v
    JOIN votetypes vt ON vt.id = v.votetypeid
    GROUP BY v.userid
),
combined AS (
    SELECT 
        up.user_id,
        up.display_name,
        up.reputation,
        up.question_cnt,
        up.answer_cnt,
        up.total_score,
        up.last_post_date,
        up.distinct_tag_cnt,
        ub.badge_cnt,
        ub.has_gold,
        ub.bronze_badges,
        uv.up_votes_given,
        uv.down_votes_given,
        uv.last_vote_date,
        RANK() OVER (ORDER BY up.reputation DESC)                     AS rep_rank,
        NTILE(4) OVER (ORDER BY up.total_score DESC)                 AS score_quartile,
        CASE 
            WHEN ub.bronze_badges IS NULL THEN NULL
            WHEN POSITION('sql' IN LOWER(ub.bronze_badges)) > 0 THEN 'SQL Lover'
            ELSE 'Other'
        END                                                          AS badge_category
    FROM user_posts up
    LEFT JOIN user_badges ub ON ub.user_id = up.user_id
    LEFT JOIN user_votes  uv ON uv.user_id = up.user_id
    WHERE up.reputation > 1000
)
SELECT *
FROM combined
WHERE (score_quartile = 1 AND has_gold = 1)
   OR (badge_category = 'SQL Lover')
ORDER BY rep_rank
LIMIT 100

UNION ALL

SELECT 
    CAST(NULL AS integer)         AS user_id,
    CAST(NULL AS varchar(40))     AS display_name,
    CAST(NULL AS integer)         AS reputation,
    CAST(NULL AS integer)         AS question_cnt,
    CAST(NULL AS integer)         AS answer_cnt,
    CAST(NULL AS integer)         AS total_score,
    CAST(NULL AS timestamp)       AS last_post_date,
    CAST(NULL AS integer)         AS distinct_tag_cnt,
    CAST(NULL AS integer)         AS badge_cnt,
    CAST(NULL AS integer)         AS has_gold,
    CAST(NULL AS varchar)         AS bronze_badges,
    CAST(NULL AS integer)         AS up_votes_given,
    CAST(NULL AS integer)         AS down_votes_given,
    CAST(NULL AS timestamp)       AS last_vote_date,
    CAST(NULL AS integer)         AS rep_rank,
    CAST(NULL AS integer)         AS score_quartile,
    CAST(NULL AS varchar)         AS badge_category
FROM (SELECT 1) AS single_row
WHERE NOT EXISTS (SELECT 1 FROM combined);