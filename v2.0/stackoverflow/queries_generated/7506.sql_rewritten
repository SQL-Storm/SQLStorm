WITH UserPostStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as AnswerCount,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) as TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) as TotalAnswerScore,
        MAX(p.CreationDate) as LastPostDate,
        AVG(p.Score) as AvgScore,
        STRING_AGG(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Tags END, '; ') as QuestionTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= '2010-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
RankedUsers AS (
    SELECT 
        *,
        ROW_NUMBER() OVER (ORDER BY TotalQuestionScore DESC) as RankByScore,
        RANK() OVER (ORDER BY Reputation DESC) as RankByReputation,
        DENSE_RANK() OVER (ORDER BY TotalPosts DESC) as RankByPostCount,
        NTILE(10) OVER (ORDER BY Reputation) as ReputationDecile
    FROM UserPostStats
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        p.Title as ExcerptTitle,
        p.Body as ExcerptBody,
        COALESCE(p.ViewCount, 0) as ViewCount,
        COALESCE(p.Score, 0) as Score,
        DENSE_RANK() OVER (ORDER BY t.Count DESC) as TagPopularityRank
    FROM Tags t
    LEFT JOIN Posts p ON t.ExcerptPostId = p.Id
    WHERE t.Count > 100
),
UserActivityPatterns AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(v.Id) as VoteCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.PostId END) as UpvoteCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.PostId END) as DownvoteCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 5 THEN v.PostId END) as FavoriteCount,
        STRING_AGG(v.PostId::text, ', ') as VotedPostIds,
        AVG(DATE_PART('day', v.CreationDate - u.CreationDate)) as AvgDaysBetweenRegistrationAndVote,
        MAX(v.CreationDate) as LastVoteDate
    FROM Users u
    LEFT JOIN Votes v ON u.Id = v.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
ComplexQueryResult AS (
    SELECT 
        ru.UserId,
        ru.DisplayName,
        ru.Reputation,
        ru.TotalPosts,
        ru.QuestionCount,
        ru.AnswerCount,
        ru.TotalQuestionScore,
        ru.TotalAnswerScore,
        ru.AvgScore,
        ru.LastPostDate,
        ru.RankByScore,
        ru.RankByReputation,
        ru.RankByPostCount,
        ru.ReputationDecile,
        COALESCE(ua.VoteCount, 0) as VoteCount,
        COALESCE(ua.UpvoteCount, 0) as UpvoteCount,
        COALESCE(ua.DownvoteCount, 0) as DownvoteCount,
        COALESCE(ua.FavoriteCount, 0) as FavoriteCount,
        ua.VotedPostIds,
        ua.AvgDaysBetweenRegistrationAndVote,
        ua.LastVoteDate,
        ta.TagName,
        ta.Count as TagCount,
        ta.ExcerptTitle,
        ta.ExcerptBody,
        ta.ViewCount,
        ta.Score as TagScore,
        ta.TagPopularityRank,
        CASE 
            WHEN ru.TotalPosts > 0 THEN (ru.QuestionCount * 100.0 / ru.TotalPosts)
            ELSE 0 
        END as QPercentage,
        CASE 
            WHEN ru.TotalPosts > 0 AND ru.QuestionCount > 0 THEN (ru.TotalAnswerScore * 1.0 / ru.QuestionCount)
            ELSE 0 
        END as AvgAnswerScorePerQuestion,
        CASE 
            WHEN ru.LastPostDate IS NOT NULL THEN DATE_PART('days', cast('2024-10-01' as date) - ru.LastPostDate)
            ELSE NULL 
        END as DaysSinceLastPost,
        CASE 
            WHEN ua.LastVoteDate IS NOT NULL THEN DATE_PART('days', cast('2024-10-01' as date) - ua.LastVoteDate)
            ELSE NULL 
        END as DaysSinceLastVote,
        CASE 
            WHEN ru.Reputation BETWEEN 1 AND 1000 THEN 'Beginner'
            WHEN ru.Reputation BETWEEN 1001 AND 10000 THEN 'Intermediate'
            WHEN ru.Reputation BETWEEN 10001 AND 100000 THEN 'Advanced'
            ELSE 'Expert'
        END as ReputationLevel,
        CASE 
            WHEN ru.TotalPosts > 100 THEN 'Active'
            WHEN ru.TotalPosts > 50 THEN 'ModeratelyActive'
            WHEN ru.TotalPosts > 10 THEN 'Occasional'
            ELSE 'New'
        END as ActivityLevel,
        CASE 
            WHEN ta.Count > 500 THEN 'Popular'
            WHEN ta.Count > 100 THEN 'Moderate'
            ELSE 'Niche'
        END as TagPopularity,
        CASE 
            WHEN LENGTH(ru.QuestionTags) > 50 THEN LEFT(ru.QuestionTags, 50) || '...'
            ELSE ru.QuestionTags
        END as ShortenedTags,
        COALESCE(LENGTH(ru.QuestionTags), 0) as TagsLength,
        CASE 
            WHEN LENGTH(ta.ExcerptBody) > 200 THEN LEFT(ta.ExcerptBody, 200) || '...'
            ELSE ta.ExcerptBody
        END as ShortenedExcerpt,
        CASE 
            WHEN ta.Score > 20 THEN 'HighlyRated'
            WHEN ta.Score > 10 THEN 'ModeratelyRated'
            WHEN ta.Score > 0 THEN 'LowRated'
            ELSE 'NotRated'
        END as TagQuality,
        ROUND((ru.Reputation * 1.0 / (COALESCE(ua.VoteCount, 1) + 1)), 2) as ReputationPerVote,
        ROW_NUMBER() OVER (PARTITION BY ta.TagName ORDER BY ru.TotalQuestionScore DESC) as UserScoreRankWithinTag,
        LAG(ru.DisplayName) OVER (ORDER BY ru.TotalQuestionScore DESC) as PreviousHighScorer
    FROM RankedUsers ru
    LEFT JOIN UserActivityPatterns ua ON ru.UserId = ua.UserId
    LEFT JOIN TagAnalysis ta ON ru.QuestionCount > 0
    WHERE ru.Reputation > 100 OR ru.TotalPosts > 5 OR COALESCE(ua.VoteCount, 0) > 10
    AND (ua.VoteCount IS NOT NULL OR ru.TotalPosts IS NOT NULL OR ta.Count IS NOT NULL)
    AND ru.UserId IN (
        SELECT DISTINCT u.Id 
        FROM Users u
        LEFT JOIN Posts p ON u.Id = p.OwnerUserId 
        LEFT JOIN Votes v ON u.Id = v.UserId
        WHERE u.CreationDate >= '2009-01-01'
        AND (p.PostTypeId = 1 OR v.VoteTypeId = 2 OR v.VoteTypeId = 3)
        GROUP BY u.Id
        HAVING COUNT(p.Id) + COUNT(v.Id) > 10
    )
)
SELECT 
    UserId,
    DisplayName,
    Reputation,
    TotalPosts,
    QuestionCount,
    AnswerCount,
    TotalQuestionScore,
    TotalAnswerScore,
    AvgScore,
    LastPostDate,
    RankByScore,
    RankByReputation,
    RankByPostCount,
    ReputationDecile,
    VoteCount,
    UpvoteCount,
    DownvoteCount,
    FavoriteCount,
    VotedPostIds,
    AvgDaysBetweenRegistrationAndVote,
    LastVoteDate,
    TagName,
    TagCount,
    ExcerptTitle,
    ExcerptBody,
    ViewCount,
    TagScore,
    TagPopularityRank,
    QPercentage,
    AvgAnswerScorePerQuestion,
    DaysSinceLastPost,
    DaysSinceLastVote,
    ReputationLevel,
    ActivityLevel,
    TagPopularity,
    ShortenedTags,
    TagsLength,
    ShortenedExcerpt,
    TagQuality,
    ReputationPerVote,
    UserScoreRankWithinTag,
    PreviousHighScorer,
    (CASE WHEN RankByScore <= 10 THEN 1 ELSE 0 END) as Top10Ranker,
    (CASE WHEN VoteCount > 1000 AND Reputation > 5000 THEN 1 ELSE 0 END) as HighEngagementUser,
    (CASE WHEN TagPopularityRank <= 5 THEN 1 ELSE 0 END) as TopTagRanker,
    (CASE WHEN TagCount > 1000 THEN 1 ELSE 0 END) as PopularTagUser,
    GREATEST(0, Reputation - 500) as AdjustedReputation,
    LEAST(100000, Reputation * 1.2) as ProjectedReputation,
    ROUND((QPercentage / 100.0) * 1000, 2) as QuestionRatioScore,
    ROUND((AvgScore * 0.5 + TagScore * 0.3 + ViewCount * 0.2), 2) as CombinedActivityScore,
    (CASE 
        WHEN DaysSinceLastPost IS NOT NULL AND DaysSinceLastPost < 30 THEN 'VeryActive'
        WHEN DaysSinceLastPost IS NOT NULL AND DaysSinceLastPost < 90 THEN 'Active'
        WHEN DaysSinceLastPost IS NOT NULL AND DaysSinceLastPost < 365 THEN 'Occasional'
        ELSE 'Inactive'
    END) as PostingActivity,
    (CASE 
        WHEN DaysSinceLastVote IS NOT NULL AND DaysSinceLastVote < 7 THEN 'VeryActive'
        WHEN DaysSinceLastVote IS NOT NULL AND DaysSinceLastVote < 30 THEN 'Active'
        WHEN DaysSinceLastVote IS NOT NULL AND DaysSinceLastVote < 90 THEN 'Occasional'
        ELSE 'Inactive'
    END) as VotingActivity,
    (CASE 
        WHEN (Reputation >= 1000 AND TotalPosts >= 20) THEN 'Veteran'
        WHEN (Reputation >= 500 AND TotalPosts >= 10) THEN 'Seasoned'
        WHEN (Reputation >= 100 AND TotalPosts >= 5) THEN 'Experienced'
        ELSE 'Novice'
    END) as UserExperienceLevel,
    ABS(Reputation - (SELECT AVG(Reputation) FROM Users)) as ReputationDeviationFromAverage,
    COUNT(*) OVER () as TotalUserCount,
    ROUND(AVG(Reputation) OVER (), 2) as AverageReputation,
    MIN(Reputation) OVER () as MinReputation,
    MAX(Reputation) OVER () as MaxReputation
FROM ComplexQueryResult
WHERE NOT (Reputation >= 100000 AND TotalPosts >= 1000 AND VoteCount >= 5000)
AND (DisplayName IS NULL OR LENGTH(DisplayName) > 0)
AND (LastPostDate IS NULL OR LastPostDate <= cast('2024-10-01 12:34:56' as timestamp))
AND (TagCount IS NULL OR TagCount >= 0)
AND (ReputationDecile IS NOT NULL AND ReputationDecile BETWEEN 1 AND 10)
ORDER BY 
    Reputation DESC,
    TotalQuestionScore DESC,
    UserScoreRankWithinTag ASC,
    TagPopularityRank ASC
LIMIT 5000;