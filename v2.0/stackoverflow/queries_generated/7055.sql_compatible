WITH 
  UserStats AS (
    SELECT 
      u.Id as UserId,
      u.Reputation,
      u.DisplayName,
      u.Views,
      u.UpVotes,
      u.DownVotes,
      COUNT(DISTINCT p.Id) as PostCount,
      COUNT(DISTINCT c.Id) as CommentCount,
      COUNT(DISTINCT b.Id) as BadgeCount,
      AVG(p.Score) as AvgPostScore,
      MAX(p.CreationDate) as LatestPostDate,
      STRING_AGG(DISTINCT CAST(p.PostTypeId AS TEXT), ',') as PostTypeIds,
      CASE WHEN COUNT(DISTINCT p.Id) > 0 THEN 
        COUNT(DISTINCT p.Id) * 100.0 / NULLIF(SUM(COUNT(DISTINCT p.Id)) OVER(), 0) 
      ELSE 0 END as PostPercentile
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= '2010-01-01'
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.Views, u.UpVotes, u.DownVotes
  ),
  PostSummary AS (
    SELECT 
      p.Id,
      p.PostTypeId,
      p.ParentId,
      p.OwnerUserId,
      p.Score,
      p.ViewCount,
      p.Title,
      p.Tags,
      p.CreationDate,
      ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as UserPostRank,
      DENSE_RANK() OVER (ORDER BY p.Score DESC) as ScoreRank,
      PERCENT_RANK() OVER (ORDER BY p.Score) as ScorePercentile,
      NTH_VALUE(p.Title, 1) OVER (ORDER BY p.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as HighestScoreTitle,
      LAG(p.Score, 1) OVER (ORDER BY p.CreationDate) as PrevScore,
      LEAD(p.Score, 1) OVER (ORDER BY p.CreationDate) as NextScore,
      ROUND(AVG(p.Score) OVER (ORDER BY p.CreationDate ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), 2) as MovingAvgScore,
      CASE 
        WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN 'Accepted' 
        WHEN p.PostTypeId = 2 AND p.ParentId IS NOT NULL THEN 'Answer'
        ELSE 'Other'
      END as PostCategory
    FROM Posts p
    WHERE p.CreationDate >= '2010-01-01'
  ),
  PostTagAnalysis AS (
    SELECT 
      ps.Id,
      ps.Title,
      ps.PostTypeId,
      ps.OwnerUserId,
      ps.Score,
      ps.Tags,
      CASE 
        WHEN ps.Tags IS NOT NULL AND ps.Tags != '' THEN
          ARRAY_LENGTH(STRING_TO_ARRAY(SUBSTRING(ps.Tags, 2, LENGTH(ps.Tags)-2), '><'), 1)
        ELSE 0 
      END as TagCount,
      CASE 
        WHEN ps.Tags IS NOT NULL AND ps.Tags != '' THEN
          STRING_TO_ARRAY(SUBSTRING(ps.Tags, 2, LENGTH(ps.Tags)-2), '><')
        ELSE ARRAY[]::TEXT[]
      END as TagArray,
      (SELECT STRING_AGG(UPPER(tag), ', ') 
        FROM UNNEST(
          CASE
            WHEN ps.Tags IS NOT NULL AND ps.Tags != '' 
            THEN STRING_TO_ARRAY(SUBSTRING(ps.Tags, 2, LENGTH(ps.Tags)-2), '><') 
            ELSE ARRAY[]::TEXT[]
          END
        ) AS tag
      ) AS FormattedTags,
      (SELECT COUNT(*) 
        FROM Votes v 
        WHERE v.PostId = ps.Id AND v.VoteTypeId = 2
      ) as UpvoteCount,
      (SELECT COUNT(*) 
        FROM Votes v 
        WHERE v.PostId = ps.Id AND v.VoteTypeId = 3
      ) as DownvoteCount
    FROM PostSummary ps
  ),
  CombinedData AS (
    SELECT 
      us.UserId,
      us.Reputation,
      us.DisplayName,
      us.PostCount,
      us.CommentCount,
      us.BadgeCount,
      us.AvgPostScore,
      ps.Id as PostId,
      ps.Title,
      ps.PostTypeId,
      ps.OwnerUserId,
      ps.Score,
      ps.ViewCount,
      ps.CreationDate,
      ps.UserPostRank,
      ps.ScoreRank,
      ps.ScorePercentile,
      ps.HighestScoreTitle,
      ps.MovingAvgScore,
      ps.PostCategory,
      pta.TagCount,
      pta.FormattedTags,
      pta.UpvoteCount,
      pta.DownvoteCount,
      CASE 
        WHEN ps.Score > 100 THEN 'High'
        WHEN ps.Score > 20 THEN 'Medium' 
        ELSE 'Low'
      END as ScoreCategory,
      RANK() OVER (PARTITION BY ps.PostTypeId ORDER BY ps.Score DESC) as TypeRank,
      CASE 
        WHEN ps.ParentId IS NOT NULL THEN 'Answer'
        WHEN ps.PostTypeId = 1 THEN 'Question'
        ELSE 'Other'
      END as ContentType,
      ROW_NUMBER() OVER (ORDER BY ps.CreationDate DESC) as GlobalRowNumber,
      LAG(us.Reputation, 1) OVER (ORDER BY us.Reputation DESC) as PrevReputation,
      LEAD(us.Reputation, 1) OVER (ORDER BY us.Reputation DESC) as NextReputation
    FROM UserStats us
    INNER JOIN PostSummary ps ON us.UserId = ps.OwnerUserId
    LEFT JOIN PostTagAnalysis pta ON ps.Id = pta.Id
    WHERE ps.CreationDate >= '2015-01-01'
  )
SELECT 
  cd.UserId,
  cd.Reputation,
  cd.DisplayName,
  cd.PostCount,
  cd.CommentCount,
  cd.BadgeCount,
  cd.AvgPostScore,
  cd.PostId,
  cd.Title,
  cd.PostTypeId,
  cd.Score,
  cd.ViewCount,
  cd.CreationDate,
  cd.UserPostRank,
  cd.ScoreRank,
  cd.ScorePercentile,
  cd.HighestScoreTitle,
  cd.MovingAvgScore,
  cd.PostCategory,
  cd.TagCount,
  cd.FormattedTags,
  cd.UpvoteCount,
  cd.DownvoteCount,
  cd.ScoreCategory,
  cd.TypeRank,
  cd.ContentType,
  cd.GlobalRowNumber,
  cd.PrevReputation,
  cd.NextReputation,
  CASE 
    WHEN cd.Reputation > 10000 THEN 'Elite'
    WHEN cd.Reputation > 5000 THEN 'Veteran'
    WHEN cd.Reputation > 1000 THEN 'Regular'
    ELSE 'Newbie'
  END as ReputationTier,
  CASE 
    WHEN cd.PostCount > 500 THEN 'High Volume'
    WHEN cd.PostCount > 100 THEN 'Medium Volume'
    WHEN cd.PostCount > 10 THEN 'Low Volume'
    ELSE 'Minimal Volume'
  END as ActivityLevel,
  CASE 
    WHEN cd.PostCount > 0 AND cd.Score > 0 
    THEN ROUND((CAST(cd.Score AS FLOAT) / cd.PostCount), 2) 
    ELSE 0 
  END as AvgScorePerPost,
  CASE 
    WHEN cd.Reputation > 0 
    THEN ROUND((CAST(cd.BadgeCount AS FLOAT) / cd.Reputation), 4) 
    ELSE 0 
  END as BadgesPerReputation,
  CASE 
    WHEN cd.ViewCount > 0 AND cd.Score > 0 
    THEN ROUND((CAST(cd.ViewCount AS FLOAT) / cd.Score), 2) 
    ELSE 0 
  END as ViewsPerScore,
  CASE 
    WHEN cd.UpvoteCount > cd.DownvoteCount THEN 'Upvoted'
    WHEN cd.DownvoteCount > cd.UpvoteCount THEN 'Downvoted'
    ELSE 'Neutral'
  END as VoteTrend,
  CASE 
    WHEN cd.CreationDate >= '2015-01-01' AND cd.CreationDate < '2016-01-01' THEN '2015'
    WHEN cd.CreationDate >= '2016-01-01' AND cd.CreationDate < '2017-01-01' THEN '2016'
    WHEN cd.CreationDate >= '2017-01-01' AND cd.CreationDate < '2018-01-01' THEN '2017'
    WHEN cd.CreationDate >= '2018-01-01' AND cd.CreationDate < '2019-01-01' THEN '2018'
    WHEN cd.CreationDate >= '2019-01-01' AND cd.CreationDate < '2020-01-01' THEN '2019'
    ELSE '2020+'
  END as PostingYear,
  'Query result set for performance benchmarking' as QueryDescription,
  COALESCE(cd.ContentType, 'Unknown') as FinalContentType,
  CASE 
    WHEN cd.PostTypeId IN (1, 2) THEN 'StackOverflow Content'
    ELSE 'Other Content'
  END as ContentCategory,
  COUNT(*) OVER() as TotalRowsProcessed,
  COUNT(*) OVER(PARTITION BY cd.UserId) as UserIdRecordCount
FROM CombinedData cd
WHERE cd.CreationDate < '2023-01-01'
  AND (cd.TagCount BETWEEN 1 AND 5 OR cd.TagCount IS NULL)
  AND (cd.Score BETWEEN -10 AND 1000 OR cd.Score IS NULL)
  AND cd.PostTypeId IN (1, 2, 3)
  AND (cd.Displayname LIKE '%User%' OR cd.Displayname IS NULL)
GROUP BY
  cd.UserId,
  cd.Reputation,
  cd.DisplayName,
  cd.PostCount,
  cd.CommentCount,
  cd.BadgeCount,
  cd.AvgPostScore,
  cd.PostId,
  cd.Title,
  cd.PostTypeId,
  cd.Score,
  cd.ViewCount,
  cd.CreationDate,
  cd.UserPostRank,
  cd.ScoreRank,
  cd.ScorePercentile,
  cd.HighestScoreTitle,
  cd.MovingAvgScore,
  cd.PostCategory,
  cd.TagCount,
  cd.FormattedTags,
  cd.UpvoteCount,
  cd.DownvoteCount,
  cd.ScoreCategory,
  cd.TypeRank,
  cd.ContentType,
  cd.GlobalRowNumber,
  cd.PrevReputation,
  cd.NextReputation
ORDER BY cd.CreationDate DESC, cd.Reputation DESC, cd.Score DESC
LIMIT 10000 OFFSET 1000;