-- {"query": "4236.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1084} 
WITH
  RankedUserPosts AS (
    SELECT
      p.OwnerUserId,
      p.Id AS PostId,
      p.CreationDate,
      p.PostTypeId,
      p.Score,
      ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
    FROM Posts AS p
    WHERE
      p.OwnerUserId IS NOT NULL
  ),
  RecentQuestions AS (
    SELECT
      p.OwnerUserId,
      p.Id AS QuestionId,
      p.Title AS QuestionTitle,
      p.CreationDate AS QuestionCreationDate,
      p.Score AS QuestionScore,
      p.AnswerCount,
      ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS q_rn
    FROM Posts AS p
    WHERE
      p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL
  ),
  TopAnswers AS (
    SELECT
      p.OwnerUserId,
      p.ParentId AS QuestionId,
      p.Id AS AnswerId,
      p.Score AS AnswerScore,
      ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId, p.ParentId ORDER BY p.Score DESC) AS ans_rn
    FROM Posts AS p
    WHERE
      p.PostTypeId = 2 AND p.OwnerUserId IS NOT NULL
  ),
  UserEngagement AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      COUNT(DISTINCT b.Id) AS BadgeCount,
      SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
      SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
      MAX(u.Reputation) AS MaxReputation,
      AVG(u.Views) AS AvgUserViews
    FROM Users AS u
    LEFT JOIN Badges AS b
      ON u.Id = b.UserId
    LEFT JOIN Votes AS v
      ON u.Id = v.UserId
    GROUP BY
      u.Id,
      u.DisplayName
  )
SELECT
  rq.QuestionId,
  rq.QuestionTitle,
  rq.QuestionCreationDate,
  ue.DisplayName AS QuestionOwnerDisplayName,
  ue.BadgeCount,
  ue.UpVoteCount,
  ue.DownVoteCount,
  (
    SELECT
      COUNT(*)
    FROM Comments AS c
    WHERE
      c.PostId = rq.QuestionId AND c.UserId = ue.UserId
  ) AS NumberOfCommentsByOwner,
  COALESCE(ta.AnswerCount, 0) AS TotalAnswers,
  CASE
    WHEN rq.AnswerCount > 5 THEN 'High Answer Rate'
    WHEN rq.AnswerCount BETWEEN 1 AND 5 THEN 'Moderate Answer Rate'
    ELSE 'Low Answer Rate'
  END AS AnswerRateCategory,
  CASE
    WHEN EXISTS (
      SELECT
        1
      FROM Posts AS p_child
      WHERE
        p_child.ParentId = rq.QuestionId AND p_child.OwnerUserId = rq.OwnerUserId
    ) THEN 'Answered Own Question'
    ELSE 'Did Not Answer Own Question'
  END AS SelfAnsweredStatus,
  SUM(COALESCE(ta.AnswerScore, 0)) OVER (PARTITION BY rq.OwnerUserId) AS TotalScoreOfAllAnswersByOwner,
  AVG(COALESCE(ta.AnswerScore, 0)) OVER (PARTITION BY rq.OwnerUserId) AS AvgScoreOfAllAnswersByOwner,
  STRING_AGG(DISTINCT UPPER(SUBSTRING(rq.QuestionTitle, 1, 3)), ', ') AS FirstThreeCharsOfTitles,
  ue.MaxReputation,
  ue.AvgUserViews
FROM RecentQuestions AS rq
JOIN UserEngagement AS ue
  ON rq.OwnerUserId = ue.UserId
LEFT JOIN TopAnswers AS ta
  ON rq.QuestionId = ta.QuestionId AND rq.OwnerUserId = ta.OwnerUserId
WHERE
  rq.q_rn <= 10 AND rq.QuestionScore > 0 AND ue.BadgeCount > 2
  AND (
    rq.QuestionTitle LIKE '%SQL%' OR rq.QuestionTitle LIKE '%Database%'
  )
GROUP BY
  rq.QuestionId,
  rq.QuestionTitle,
  rq.QuestionCreationDate,
  ue.DisplayName,
  ue.BadgeCount,
  ue.UpVoteCount,
  ue.DownVoteCount,
  ue.MaxReputation,
  ue.AvgUserViews,
  ta.AnswerCount
HAVING
  COUNT(ta.AnswerId) > 1
ORDER BY
  rq.QuestionCreationDate DESC
LIMIT 100;