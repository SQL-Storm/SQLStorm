-- {"query": "6741.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 538} 
SELECT 
    u.DisplayName, 
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(p.Score) AS HighestScoredPost,
    MIN(p.CreationDate) AS FirstPost,
    MAX(p.LastActivityDate) AS LastActivity,
    b.Name AS LatestBadge,
    ph.Comment AS LastEditComment,
    v.VoteTypeId AS LastVoteType
FROM 
    Users u
LEFT JOIN 
    (SELECT 
         ph.PostId, 
         ph.Comment, 
         MAX(ph.CreationDate) AS LastEditDate
     FROM 
         PostHistory ph
     WHERE 
         ph.PostHistoryTypeId IN (2, 5, 6, 8, 9, 10, 11, 12, 13, 14, 15, 19, 20, 35, 36)
     GROUP BY 
         ph.PostId) ph ON u.Id = ph.PostId 
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    (SELECT 
         UserId, 
         MAX(Date) AS LatestBadgeDate, 
         Name
     FROM 
         Badges
     GROUP BY 
         UserId, Name) b ON u.Id = b.UserId
LEFT JOIN 
    (SELECT 
         UserId, 
         VoteTypeId, 
         CreationDate
     FROM 
         Votes
     WHERE 
         VoteTypeId = 11
     GROUP BY 
         UserId, VoteTypeId, CreationDate) v ON u.Id = v.UserId
WHERE 
    u.Reputation > 10000
    AND u.Id IN 
        (SELECT 
             UserDisplayName 
         FROM 
             (SELECT 
                  UserDisplayName, 
                  COUNT(*) AS CommentCount 
              FROM 
                  Comments 
              GROUP BY 
                  UserDisplayName 
              HAVING 
                  COUNT(*) > 10) AS sub)
GROUP BY 
    u.Id, u.DisplayName, u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;