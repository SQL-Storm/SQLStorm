WITH UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, '[unknown]') AS Location,
        COUNT(b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS TotalAnswerScore,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        COUNT(c.Id) AS CommentCount
    FROM Users u
    LEFT JOIN Badges b   ON b.UserId = u.Id
    LEFT JOIN Posts p    ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
),
RankedUsers AS (
    SELECT 
        Id,
        DisplayName,
        Reputation,
        Location,
        GoldBadges,
        SilverBadges,
        BronzeBadges,
        TotalQuestionScore,
        TotalAnswerScore,
        QuestionCount,
        AnswerCount,
        CommentCount,
        ROW_NUMBER() OVER (ORDER BY Reputation DESC, GoldBadges DESC, SilverBadges DESC) AS ReputationRank
    FROM UserStats
)
SELECT
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.Location,
    ru.GoldBadges,
    ru.SilverBadges,
    ru.BronzeBadges,
    ru.QuestionCount,
    ru.AnswerCount,
    ru.TotalQuestionScore,
    ru.TotalAnswerScore,
    ru.CommentCount,
    ROUND(CASE WHEN ru.QuestionCount = 0 THEN NULL 
               ELSE CAST(ru.TotalQuestionScore AS numeric) / ru.QuestionCount END, 2) AS AvgQuestionScore,
    ROUND(CASE WHEN ru.AnswerCount = 0 THEN NULL 
               ELSE CAST(ru.TotalAnswerScore AS numeric) / ru.AnswerCount END, 2) AS AvgAnswerScore,
    COALESCE(vs.VoteScore, 0) AS RecentVoteScore,
    COALESCE(t.TagList, '') AS TagList
FROM RankedUsers ru
LEFT JOIN LATERAL (
    SELECT 
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) -
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS VoteScore
    FROM Votes v
    WHERE v.UserId = ru.Id
      AND v.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '30 days')
) vs ON TRUE
LEFT JOIN LATERAL (
    SELECT STRING_AGG(DISTINCT tg.TagName, ', ') AS TagList
    FROM Posts p
    CROSS JOIN LATERAL regexp_split_to_table(p.Tags, '><') AS tgname(tag)
    JOIN Tags tg ON tg.TagName = tgname.tag
    WHERE p.OwnerUserId = ru.Id
      AND p.PostTypeId = 1
) t ON TRUE
WHERE ru.ReputationRank <= 100
ORDER BY ru.ReputationRank

UNION ALL

SELECT 
    CAST(NULL AS bigint) AS Id,
    CAST(NULL AS text) AS DisplayName,
    CAST(NULL AS integer) AS Reputation,
    CAST(NULL AS text) AS Location,
    CAST(NULL AS integer) AS GoldBadges,
    CAST(NULL AS integer) AS SilverBadges,
    CAST(NULL AS integer) AS BronzeBadges,
    CAST(NULL AS bigint) AS QuestionCount,
    CAST(NULL AS bigint) AS AnswerCount,
    CAST(NULL AS numeric) AS TotalQuestionScore,
    CAST(NULL AS numeric) AS TotalAnswerScore,
    CAST(NULL AS bigint) AS CommentCount,
    CAST(NULL AS numeric) AS AvgQuestionScore,
    CAST(NULL AS numeric) AS AvgAnswerScore,
    CAST(NULL AS integer) AS RecentVoteScore,
    CAST(NULL AS text) AS TagList,
    CAST(NULL AS text) AS filler
FROM generate_series(1,5) g(i);