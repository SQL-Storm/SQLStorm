WITH UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetVotes,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadgeCount
    FROM Users u
    WHERE u.Reputation > 1000
),

RecentTopPosts AS (
    SELECT
        p.Id,
        p.Title,
        p.Score,
        p.CreationDate,
        p.OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY
),

TagStats AS (
    SELECT
        t.TagName,
        COUNT(p.Id)                                      AS TagQuestionCount,
        AVG(p.Score)                                      AS AvgScore,
        STRING_AGG(DISTINCT u.DisplayName, ', ')          AS TopContributors
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE ('%' || '<' || t.TagName || '>' || '%')
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
    GROUP BY t.TagName
    HAVING COUNT(p.Id) > 50
),

VoteAgg AS (
    SELECT
        v.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
        MAX(v.CreationDate)                              AS LastVoteDate
    FROM Votes v
    GROUP BY v.PostId
)

SELECT
    us.Id                        AS UserId,
    us.DisplayName,
    us.Reputation,
    us.NetVotes,
    us.QuestionCount,
    us.AnswerCount,
    us.GoldBadgeCount,
    rp.Title                     AS RecentTopQuestion,
    rp.Score                     AS RecentTopScore,
    COALESCE(va.UpVotes, 0)      AS TotalUpVotesOnTopQuestion,
    COALESCE(va.DownVotes, 0)    AS TotalDownVotesOnTopQuestion,
    ts.TagName,
    ts.TagQuestionCount,
    ROUND(ts.AvgScore, 2)        AS TagAvgScore,
    ts.TopContributors
FROM UserStats us
LEFT JOIN RecentTopPosts rp
       ON rp.OwnerUserId = us.Id AND rp.rn = 1
LEFT JOIN VoteAgg va
       ON va.PostId = rp.Id
LEFT JOIN LATERAL (
    SELECT
        t.TagName,
        t.TagQuestionCount,
        t.AvgScore,
        t.TopContributors
    FROM TagStats t
    WHERE EXISTS (
        SELECT 1
        FROM Posts p
        WHERE p.OwnerUserId = us.Id
          AND p.Tags LIKE ('%' || '<' || t.TagName || '>' || '%')
    )
    ORDER BY t.TagQuestionCount DESC
    LIMIT 1
) ts ON TRUE
WHERE (us.Reputation + us.NetVotes) > 2000

UNION ALL

SELECT
    CAST(NULL AS BIGINT)        AS UserId,
    'Aggregate Summary'         AS DisplayName,
    SUM(us.Reputation)          AS Reputation,
    SUM(us.NetVotes)            AS NetVotes,
    SUM(us.QuestionCount)       AS QuestionCount,
    SUM(us.AnswerCount)         AS AnswerCount,
    SUM(us.GoldBadgeCount)      AS GoldBadgeCount,
    CAST(NULL AS TEXT)          AS RecentTopQuestion,
    CAST(NULL AS INTEGER)       AS RecentTopScore,
    CAST(NULL AS INTEGER)       AS TotalUpVotesOnTopQuestion,
    CAST(NULL AS INTEGER)       AS TotalDownVotesOnTopQuestion,
    CAST(NULL AS TEXT)          AS TagName,
    CAST(NULL AS BIGINT)        AS TagQuestionCount,
    CAST(NULL AS NUMERIC)       AS TagAvgScore,
    CAST(NULL AS TEXT)          AS TopContributors
FROM UserStats us;