WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        p.CreationDate,
        p.LastActivityDate,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as rn,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_score,
        LAG(p.ViewCount) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_viewcount,
        DENSE_RANK() OVER (ORDER BY p.Score DESC) as score_rank,
        NTILE(100) OVER (ORDER BY p.Score DESC) as score_percentile
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) 
      AND p.CreationDate >= DATE '2019-01-01'
),
UserActivity AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as post_count,
        COUNT(DISTINCT c.Id) as comment_count,
        COUNT(DISTINCT b.Id) as badge_count,
        MAX(p.CreationDate) as latest_post_date,
        AVG(p.Score) as avg_score,
        SUM(p.Score) as total_score,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) as question_count,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) as answer_count,
        MAX(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE 0 END) as max_question_views
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= DATE '2018-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE 
            WHEN t.Count > 1000 THEN 'Very Popular'
            WHEN t.Count > 100 THEN 'Popular'
            WHEN t.Count > 10 THEN 'Moderate'
            ELSE 'Low'
        END as popularity_level,
        DENSE_RANK() OVER (ORDER BY t.Count DESC) as popularity_rank,
        COALESCE(
            (SELECT COUNT(*) FROM Posts p WHERE p.Tags LIKE '%' || t.TagName || '%'), 
            0
        ) as related_posts_count
    FROM Tags t
    WHERE t.TagName IS NOT NULL
),
ComplexMetrics AS (
    SELECT 
        r.Id,
        r.PostTypeId,
        r.Score,
        r.ViewCount,
        r.Title,
        r.OwnerUserId,
        r.CreationDate,
        r.LastActivityDate,
        r.AnswerCount,
        r.CommentCount,
        r.FavoriteCount,
        r.rn,
        r.prev_score,
        r.prev_viewcount,
        r.score_rank,
        r.score_percentile,
        CASE 
            WHEN r.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Above Average'
            WHEN r.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Below Average'
            ELSE 'Average'
        END as score_performance,
        COALESCE((r.Score - r.prev_score) * 1.0 / NULLIF(r.prev_score, 0) * 100, 0) as score_change_percent,
        COALESCE((r.ViewCount - r.prev_viewcount) * 1.0 / NULLIF(r.prev_viewcount, 0) * 100, 0) as view_change_percent,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = r.Id AND v.VoteTypeId IN (2, 3)) as vote_count,
        (SELECT MIN(v.CreationDate) FROM Votes v WHERE v.PostId = r.Id AND v.VoteTypeId = 1) as first_accepted_vote_date,
        (SELECT MAX(v.CreationDate) FROM Votes v WHERE v.PostId = r.Id AND v.VoteTypeId IN (2, 3)) as last_vote_date,
        CASE 
            WHEN r.AnswerCount = 0 THEN 'No Answers'
            WHEN r.AnswerCount > 0 AND r.AnswerCount < 5 THEN 'Few Answers'
            WHEN r.AnswerCount >= 5 AND r.AnswerCount < 10 THEN 'Moderate Answers'
            WHEN r.AnswerCount >= 10 THEN 'Many Answers'
        END as answer_quantity_category
    FROM RankedPosts r
    WHERE r.rn = 1
)
SELECT 
    cm.Id,
    cm.PostTypeId,
    cm.Score,
    cm.ViewCount,
    cm.Title,
    cm.OwnerUserId,
    cm.CreationDate,
    cm.LastActivityDate,
    cm.AnswerCount,
    cm.CommentCount,
    cm.FavoriteCount,
    cm.rn,
    cm.prev_score,
    cm.prev_viewcount,
    cm.score_rank,
    cm.score_percentile,
    cm.score_performance,
    cm.score_change_percent,
    cm.view_change_percent,
    cm.vote_count,
    cm.first_accepted_vote_date,
    cm.last_vote_date,
    cm.answer_quantity_category,
    ua.DisplayName,
    ua.Reputation,
    ua.Views as user_views,
    ua.UpVotes,
    ua.DownVotes,
    ua.post_count,
    ua.comment_count,
    ua.badge_count,
    ua.latest_post_date,
    ua.avg_score,
    ua.total_score,
    ua.question_count,
    ua.answer_count,
    ua.max_question_views,
    ta.TagName,
    ta.Count as tag_count,
    ta.popularity_level,
    ta.popularity_rank,
    ta.related_posts_count,
    CASE 
        WHEN cm.Score > 5 AND cm.ViewCount > 500 THEN 'High Performer'
        WHEN cm.Score < 0 AND cm.ViewCount < 100 THEN 'Low Performer'
        ELSE 'Regular Performer'
    END as post_category,
    CASE 
        WHEN cm.Score > 10 THEN 'Elite'
        WHEN cm.Score BETWEEN 5 AND 10 THEN 'Good'
        WHEN cm.Score BETWEEN 1 AND 4 THEN 'Average'
        ELSE 'Poor'
    END as score_category,
    CASE 
        WHEN cm.ViewCount > 1000 THEN 'Viral'
        WHEN cm.ViewCount > 100 THEN 'Popular'
        WHEN cm.ViewCount > 10 THEN 'Noticeable'
        ELSE 'Unknown'
    END as view_category,
    (SELECT COUNT(*) FROM Posts p WHERE p.ParentId = cm.Id AND p.PostTypeId = 2) as child_answer_count,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = cm.Id AND c.UserId IS NOT NULL) as comment_user_count,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = cm.Id AND ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6)) as edit_count,
    TRIM(SUBSTR(cm.Title || '...', 1, 50)) as truncated_title,
    EXTRACT(YEAR FROM cm.CreationDate) as creation_year,
    EXTRACT(MONTH FROM cm.CreationDate) as creation_month,
    EXTRACT(DAY FROM cm.CreationDate) as creation_day,
    CASE 
        WHEN cm.Score >= 10 THEN 
            'The answer by ' || COALESCE(ua.DisplayName, 'Unknown') || ' with score ' || CAST(cm.Score AS VARCHAR) || ' deserves recognition'
        WHEN cm.Score < 0 THEN 
            'The post by ' || COALESCE(ua.DisplayName, 'Unknown') || ' with score ' || CAST(cm.Score AS VARCHAR) || ' needs attention'
        ELSE 
            'The post by ' || COALESCE(ua.DisplayName, 'Unknown') || ' with score ' || CAST(cm.Score AS VARCHAR) || ' is regular'
    END as rating_comment,
    COALESCE(cm.Score, 0) + COALESCE(cm.ViewCount, 0) + 
        COALESCE(COALESCE(cm.AnswerCount, 0) * 10, 0) + 
        COALESCE(COALESCE(cm.CommentCount, 0) * 5, 0) + 
        COALESCE(COALESCE(cm.FavoriteCount, 0) * 20, 0) as combined_metric,
    CASE 
        WHEN cm.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) AND 
             cm.ViewCount > (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1) THEN 'Hot Topic'
        ELSE 'Standard Topic'
    END as topic_status
FROM ComplexMetrics cm
LEFT JOIN UserActivity ua ON cm.OwnerUserId = ua.UserId
LEFT JOIN Tags ta ON (
    cm.Tags IS NOT NULL
    AND ta.TagName IS NOT NULL
    AND (
        cm.Tags LIKE '%' || '<' || ta.TagName || '>' || '%'
        OR cm.Tags LIKE '%' || ta.TagName || '%'
    )
)
WHERE (cm.score_percentile BETWEEN 90 AND 100) 
   OR (cm.score_rank <= 50) 
   OR (cm.ViewCount > 5000)
   OR (cm.vote_count > 100)
ORDER BY cm.Score DESC, cm.ViewCount DESC, cm.LastActivityDate DESC
FETCH FIRST 1000 ROWS ONLY;