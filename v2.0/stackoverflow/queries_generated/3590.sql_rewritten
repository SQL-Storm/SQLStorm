-- {"query": "3590.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2541} 
WITH 
    /* Basic per‑user statistics */
    UserStats AS (
        SELECT 
            u.Id,
            u.DisplayName,
            u.Reputation,
            COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0)          AS NetVotes,
            (SELECT COUNT(*) FROM Posts p 
               WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1)    AS QuestionCount,
            (SELECT COUNT(*) FROM Posts p 
               WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2)    AS AnswerCount,
            (SELECT MAX(CreationDate) FROM Posts p 
               WHERE p.OwnerUserId = u.Id)                         AS LastPostDate
        FROM Users u
    ),

    /* Badge contribution per user */
    BadgeAgg AS (
        SELECT 
            b.UserId,
            SUM(CASE b.Class WHEN 1 THEN 1000 WHEN 2 THEN 500 ELSE 100 END) AS BadgeScore,
            COUNT(*) FILTER (WHERE b.TagBased = 1) AS TagBadgeCount,
            COUNT(*) FILTER (WHERE b.TagBased = 0) AS NamedBadgeCount
        FROM Badges b
        GROUP BY b.UserId
    ),

    /* Global tag popularity ranking */
    TagPopularity AS (
        SELECT 
            t.TagName,
            t.Count,
            ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS TagRank
        FROM Tags t
        WHERE t.TagName IS NOT NULL
    ),

    /* How many questions each user posted for each tag */
    UserTagActivity AS (
        SELECT 
            u.Id                         AS UserId,
            UNNEST(string_to_array(TRIM(BOTH '<>' FROM p.Tags), '><')) AS Tag,
            COUNT(*)                     AS PostsWithTag
        FROM Users u
        JOIN Posts p ON p.OwnerUserId = u.Id
        WHERE p.PostTypeId = 1                -- only questions
          AND p.Tags IS NOT NULL
        GROUP BY u.Id, Tag
    ),

    /* Rank users by a composite score */
    RankedUsers AS (
        SELECT 
            us.Id,
            us.DisplayName,
            us.Reputation,
            us.NetVotes,
            COALESCE(ba.BadgeScore,0)                AS BadgeScore,
            (COALESCE(us.QuestionCount,0)+COALESCE(us.AnswerCount,0)) AS TotalPosts,
            ROW_NUMBER() OVER (ORDER BY (us.Reputation + COALESCE(ba.BadgeScore,0) + us.NetVotes) DESC) AS OverallRank,
            us.LastPostDate
        FROM UserStats us
        LEFT JOIN BadgeAgg ba ON ba.UserId = us.Id
        WHERE us.Reputation > 1000
    )

SELECT
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.NetVotes,
    ru.BadgeScore,
    ru.TotalPosts,
    ru.OverallRank,
    COALESCE(ru.LastPostDate, TIMESTAMP '1970‑01‑01')            AS LastPostDate,
    COALESCE(uta.PostsWithTag,0)                               AS PostsWithTopTag,
    COALESCE(tp.TagName,'<no tag>')                            AS TopTag,
    CASE 
        WHEN ru.OverallRank <= 10  THEN 'Elite'
        WHEN ru.OverallRank <= 100 THEN 'Pro'
        ELSE 'Member' 
    END                                                       AS Tier,
    /* Up‑votes the user gave */
    (SELECT COUNT(*) FROM Votes v 
        WHERE v.UserId = ru.Id AND v.VoteTypeId = 2)           AS UpVoteGivenCount,
    /* Bookmarks (favorites) the user’s posts received */
    (SELECT COUNT(*) FROM Votes v 
        WHERE v.PostId IN (SELECT p.Id FROM Posts p WHERE p.OwnerUserId = ru.Id)
          AND v.VoteTypeId = 5)                               AS FavoritesReceived,
    /* Net vote score on the user’s posts (windowed) */
    vs.VoteScore
FROM RankedUsers ru
LEFT JOIN UserTagActivity uta 
       ON uta.UserId = ru.Id
LEFT JOIN TagPopularity tp 
       ON tp.TagName = uta.Tag AND tp.TagRank = 1
LEFT JOIN LATERAL (
    SELECT SUM(CASE v.VoteTypeId 
                 WHEN 2 THEN 1     -- upvote
                 WHEN 3 THEN -1    -- downvote
                 ELSE 0 
               END) AS VoteScore
    FROM Votes v
    WHERE v.PostId IN (SELECT p.Id FROM Posts p WHERE p.OwnerUserId = ru.Id)
) vs ON TRUE
WHERE (tp.TagRank IS NULL OR tp.TagRank <= 5)
ORDER BY ru.OverallRank
LIMIT 100

UNION ALL

/* Dummy separator row to allow set‑operator testing */
SELECT
    NULL::int          AS Id,
    '---'::varchar(40) AS DisplayName,
    NULL::int          AS Reputation,
    NULL::int          AS NetVotes,
    NULL::int          AS BadgeScore,
    NULL::int          AS TotalPosts,
    NULL::int          AS OverallRank,
    NULL::timestamp    AS LastPostDate,
    NULL::int          AS PostsWithTopTag,
    NULL::varchar(35)  AS TopTag,
    NULL::varchar(10)  AS Tier,
    NULL::int          AS UpVoteGivenCount,
    NULL::int          AS FavoritesReceived,
    NULL::int          AS VoteScore
WHERE FALSE;