WITH
UserStats AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.Location,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    COUNT(p.Id) AS PostCount,
    SUM(COALESCE(p.Score,0)) AS ScoreSum,
    AVG(EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate)) / 86400.0) AS AvgPostAgeDays
  FROM
    Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  GROUP BY
    u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate,
    u.Location, u.Views, u.UpVotes, u.DownVotes
),
RecentActivity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    p.Id AS PostId,
    p.PostTypeId,
    p.CreationDate AS PostCreationDate,
    p.LastActivityDate,
    p.Title,
    p.Tags,
    ROW_NUMBER() OVER (
      PARTITION BY u.Id
      ORDER BY p.LastActivityDate DESC NULLS LAST, p.CreationDate DESC
    ) AS rn
  FROM
    Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  WHERE
    p.Id IS NOT NULL
),
HotPosts AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.Title,
    p.ViewCount,
    p.Score,
    p.LastActivityDate,
    (COALESCE(p.Score,0) * 1.5
     + COALESCE(p.ViewCount,0) * 0.01
     + EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate)) * -0.0001
     + COALESCE(v.BountyAmount,0) * 0.7
    ) AS Hotness
  FROM
    Posts p
    LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId = 8
  WHERE
    p.PostTypeId IN (1,2)
),
RecentClosed AS (
  SELECT
    u.Id AS UserId,
    cr.Id AS PostId,
    cr.CloseReasonId,
    cr.ClosedDate
  FROM
    Users u
    JOIN Posts cr ON cr.OwnerUserId = u.Id
  WHERE
    cr.ClosedDate IS NOT NULL
  ORDER BY cr.ClosedDate DESC
  LIMIT 100
)
SELECT
  u.UserId,
  u.DisplayName,
  s.PostCount,
  s.ScoreSum,
  s.AvgPostAgeDays,
  ARRAY_AGG(DISTINCT ra.PostId ORDER BY ra.PostCreationDate DESC NULLS LAST) FILTER (WHERE ra.PostId IS NOT NULL) AS RecentPostIds,
  hp.PostId AS HotPostId,
  hp.Title AS HotPostTitle,
  hp.Score AS HotPostScore,
  hp.ViewCount AS HotPostViews,
  hp.Hotness,
  rc.PostId AS ClosedPostId,
  rc.CloseReasonId,
  rc.ClosedDate
FROM
  UserStats s
  JOIN RecentActivity ra ON ra.UserId = s.UserId
  LEFT JOIN HotPosts hp ON hp.OwnerUserId = s.UserId
  LEFT JOIN RecentClosed rc ON rc.UserId = s.UserId
  JOIN Users u ON u.Id = s.UserId
WHERE
  (s.PostCount > 0 OR hp.PostId IS NOT NULL)
  AND (rc.ClosedDate IS NULL OR rc.ClosedDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 days')
GROUP BY
  u.UserId, u.DisplayName, s.PostCount, s.ScoreSum, s.AvgPostAgeDays,
  hp.PostId, hp.Title, hp.Score, hp.ViewCount, hp.Hotness,
  rc.PostId, rc.CloseReasonId, rc.ClosedDate
ORDER BY
  hp.Hotness DESC NULLS LAST
LIMIT 200;