with RecursiveUserBadges AS (
    select
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        row_number() over(partition by u.Id order by b.Date desc) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    where u.Reputation > 10000
),
FilteredPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        coalesce(p.Title, '') as Title,
        p.Tags,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        p.ParentId
    from Posts p
    where p.CreationDate >= cast('2024-10-01' as date) - interval '1 year'
      and (p.PostTypeId = 1 or p.PostTypeId = 2)
),
PostWithAnswers as (
    select
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.CreationDate as QuestionDate,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        a.Id as AnswerId,
        a.CreationDate as AnswerDate,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerOwnerId,
        a.ParentId,
        u.DisplayName as AnswerOwnerName,
        r.BadgeName,
        r.Class as BadgeClass
    from FilteredPosts q
    left join FilteredPosts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Users u on u.Id = a.OwnerUserId
    left join RecursiveUserBadges r on r.UserId = a.OwnerUserId and r.BadgeRank = 1
    where q.PostTypeId = 1
),
RankedAnswers as (
    select
        QuestionId,
        Title,
        Tags,
        QuestionDate,
        QuestionScore,
        QuestionViews,
        AnswerId,
        AnswerDate,
        AnswerScore,
        AnswerOwnerId,
        ParentId,
        AnswerOwnerName,
        BadgeName,
        BadgeClass,
        rank() over(partition by QuestionId order by AnswerScore desc, AnswerDate asc) as AnswerRank
    from PostWithAnswers
),
AnswerCommentsCount as (
    select
        c.PostId,
        count(c.Id) as CommentCount
    from Comments c
    group by c.PostId
),
ComplexAnalysis as (
    select
        r.QuestionId,
        r.Title,
        r.Tags,
        r.QuestionDate,
        r.QuestionScore,
        r.QuestionViews,
        r.AnswerId,
        r.AnswerDate,
        r.AnswerScore,
        r.AnswerOwnerId,
        r.AnswerOwnerName,
        r.BadgeName,
        r.BadgeClass,
        coalesce(ac.CommentCount, 0) as AnswerCommentCount,
        (select count(*) from PostLinks pl where pl.PostId = r.QuestionId and pl.LinkTypeId = 3) as DuplicateCount,
        case
           when r.AnswerDate is not null then 
            extract(epoch from (r.AnswerDate - r.QuestionDate))/3600.0
           else null
        end as HoursToAnswer,
        length(r.Title) as TitleLength,
        case
          when r.Tags is not null then array_length(string_to_array(substring(r.Tags from 2 for char_length(r.Tags)-2), '><'), 1)
          else 0
        end as TagCount,
        (cast(r.AnswerScore as double precision) / nullif(r.QuestionScore,0)) as AnswerQuestionScoreRatio,
        rank() over (partition by r.QuestionId order by r.AnswerScore desc nulls last, ac.CommentCount desc nulls last) as CombinedRank
    from RankedAnswers r
    left join AnswerCommentsCount ac on ac.PostId = r.AnswerId
    where r.AnswerRank <= 5
),
TopComplex AS (
    select 
        QuestionId,
        Title,
        TagCount,
        QuestionScore,
        QuestionViews,
        DuplicateCount,
        AnswerId,
        AnswerOwnerName,
        coalesce(BadgeName, 'None') as TopBadge,
        BadgeClass,
        AnswerScore,
        AnswerCommentCount,
        HoursToAnswer,
        TitleLength,
        cast(round(cast(AnswerQuestionScoreRatio as numeric), 3) as double precision) as ScoreRatio,
        CombinedRank
    from ComplexAnalysis
    where CombinedRank <= 3
),
TopCommunityQuestions AS (
    select
        p.Id as QuestionId,
        coalesce(p.Title, 'N/A') as Title,
        0 as TagCount,
        p.Score as QuestionScore,
        p.ViewCount as QuestionViews,
        0 as DuplicateCount,
        null as AnswerId,
        'Community' as AnswerOwnerName,
        'None' as TopBadge,
        null as BadgeClass,
        null as AnswerScore,
        null as AnswerCommentCount,
        null as HoursToAnswer,
        length(coalesce(p.Title, '')) as TitleLength,
        null as ScoreRatio,
        0 as CombinedRank
    from Posts p
    where p.PostTypeId = 1
      and p.ViewCount > 100000
      and not exists (
        select 1 from Posts a where a.ParentId = p.Id
    )
)
select *
from (
    select * from TopComplex
    union
    select * from TopCommunityQuestions
) t
order by QuestionViews desc, QuestionScore desc, AnswerScore desc
limit 50;