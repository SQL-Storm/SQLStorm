SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    AVG(p.Score) AS AvgPostScore,
    MAX(ph.CreationDate) AS LatestPostHistoryEntry,
    (
        SELECT COUNT(*) 
        FROM Votes v 
        WHERE v.PostId = p.Id AND v.VoteTypeId = 2
    ) AS TotalUpVotes,
    (
        SELECT COUNT(*) 
        FROM Votes v 
        WHERE v.PostId = p.Id AND v.VoteTypeId = 3
    ) AS TotalDownVotes,
    (
        SELECT STRING_AGG(t.TagName, ', ')
        FROM Tags t
        WHERE t.Id IN (
            SELECT pt.TagId 
            FROM PostTags pt 
            WHERE pt.PostId = p.Id
        )
    ) AS TaggedWith,
    (
        SELECT COUNT(*) 
        FROM PostLinks pl 
        WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3
    ) AS DuplicateCount,
    (
        SELECT COUNT(*) 
        FROM Badges b2 
        WHERE b2.UserId = u.Id AND b2.Class = 1
    ) AS GoldBadgeCount,
    (
        SELECT COUNT(DISTINCT p2.PostTypeId) 
        FROM Posts p2 
        WHERE p2.AcceptedAnswerId = p.Id
    ) AS AcceptedAnswerCount
FROM 
    Users u 
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
WHERE 
    u.Reputation > 10000
GROUP BY 
    u.DisplayName, 
    u.Reputation,
    u.CreationDate,
    p.LastActivityDate,
    ph.CreationDate,
    p.Id,
    p.Score
HAVING 
    COUNT(DISTINCT p.Id) > 10 
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;