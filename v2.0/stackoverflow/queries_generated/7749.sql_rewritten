WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS PostRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END AS PostType,
        COALESCE(p.Tags, 'No Tags') AS Tags,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PreviousScore,
        LEAD(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS NextScore,
        RANK() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS ScoreRank,
        DENSE_RANK() OVER (ORDER BY p.Score DESC) AS GlobalScoreRank,
        NTILE(10) OVER (ORDER BY p.Score DESC) AS ScoreDecile,
        CASE 
            WHEN p.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Above Average'
            WHEN p.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Below Average'
            ELSE 'Average'
        END AS ScoreCategory,
        CASE 
            WHEN p.Score > 100 THEN 'High Impact'
            WHEN p.Score > 50 THEN 'Medium Impact'
            WHEN p.Score > 10 THEN 'Low Impact'
            ELSE 'Minimal Impact'
        END AS ImpactLevel
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
UserStats AS (
    SELECT 
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.Views,
        ua.PostCount,
        ua.CommentCount,
        ua.BadgeCount,
        CASE 
            WHEN ua.PostCount > 50 THEN 'Active'
            WHEN ua.PostCount > 10 THEN 'Moderate'
            WHEN ua.PostCount > 0 THEN 'Beginner'
            ELSE 'Inactive'
        END AS ActivityLevel,
        CASE 
            WHEN ua.Reputation > 10000 THEN 'Expert'
            WHEN ua.Reputation > 1000 THEN 'Intermediate'
            WHEN ua.Reputation > 100 THEN 'Beginner'
            ELSE 'Novice'
        END AS ReputationLevel,
        CASE 
            WHEN ua.Views > 1000 THEN 'Popular'
            WHEN ua.Views > 100 THEN 'Moderately Viewed'
            WHEN ua.Views > 0 THEN 'Viewed'
            ELSE 'Unviewed'
        END AS PopularityLevel,
        (ua.UpVotes - ua.DownVotes) AS NetVotes
    FROM UserActivity ua
),
CombinedAnalysis AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Reputation,
        us.Views,
        us.PostCount,
        us.CommentCount,
        us.BadgeCount,
        us.ActivityLevel,
        us.ReputationLevel,
        us.PopularityLevel,
        us.NetVotes,
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount,
        pa.CommentCount AS PostCommentCount,
        pa.CreationDate AS PostCreationDate,
        pa.PostType,
        pa.Tags,
        pa.PreviousScore,
        pa.NextScore,
        pa.ScoreRank,
        pa.GlobalScoreRank,
        pa.ScoreDecile,
        pa.ScoreCategory,
        pa.ImpactLevel,
        CASE 
            WHEN pa.PostType = 'Question' AND pa.AnswerCount = 0 THEN 'Unanswered'
            WHEN pa.PostType = 'Question' AND pa.AnswerCount > 0 THEN 'Answered'
            WHEN pa.PostType = 'Answer' AND pa.Score > 0 THEN 'Accepted'
            ELSE 'Pending'
        END AS Status,
        DATEDIFF(DAY, pa.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS DaysSinceCreation,
        DATEDIFF(DAY, pa.CreationDate, COALESCE(pa.LastActivityDate, pa.CreationDate)) AS DaysActive
    FROM UserStats us
    INNER JOIN PostAnalysis pa ON us.UserId = pa.OwnerUserId
),
FilteredResults AS (
    SELECT 
        ca.UserId,
        ca.DisplayName,
        ca.Reputation,
        ca.Views,
        ca.PostCount,
        ca.CommentCount,
        ca.BadgeCount,
        ca.ActivityLevel,
        ca.ReputationLevel,
        ca.PopularityLevel,
        ca.NetVotes,
        ca.PostId,
        ca.Title,
        ca.Score,
        ca.ViewCount,
        ca.AnswerCount,
        ca.PostCommentCount,
        ca.PostCreationDate,
        ca.PostType,
        ca.Tags,
        ca.PreviousScore,
        ca.NextScore,
        ca.ScoreRank,
        ca.GlobalScoreRank,
        ca.ScoreDecile,
        ca.ScoreCategory,
        ca.ImpactLevel,
        ca.Status,
        ca.DaysSinceCreation,
        ca.DaysActive,
        ROW_NUMBER() OVER (PARTITION BY ca.UserId ORDER BY ca.Score DESC) AS UserTopPost,
        RANK() OVER (ORDER BY ca.Score DESC) AS GlobalRank,
        DENSE_RANK() OVER (ORDER BY ca.PostType, ca.Score DESC) AS PostTypeRank
    FROM CombinedAnalysis ca
    WHERE ca.Score > 10
      AND ca.PostCount > 0
      AND ca.Reputation > 100
)
SELECT 
    fr.UserId,
    fr.DisplayName,
    fr.Reputation,
    fr.Views,
    fr.PostCount,
    fr.CommentCount,
    fr.BadgeCount,
    fr.ActivityLevel,
    fr.ReputationLevel,
    fr.PopularityLevel,
    fr.NetVotes,
    fr.PostId,
    fr.Title,
    fr.Score,
    fr.ViewCount,
    fr.AnswerCount,
    fr.PostCommentCount,
    fr.PostCreationDate,
    fr.PostType,
    fr.Tags,
    fr.PreviousScore,
    fr.NextScore,
    fr.ScoreRank,
    fr.GlobalScoreRank,
    fr.ScoreDecile,
    fr.ScoreCategory,
    fr.ImpactLevel,
    fr.Status,
    fr.DaysSinceCreation,
    fr.DaysActive,
    CASE 
        WHEN fr.Score > 50 AND fr.AnswerCount > 2 THEN 'Highly Engaging'
        WHEN fr.Score > 30 AND fr.AnswerCount > 1 THEN 'Moderately Engaging'
        WHEN fr.DaysActive < 30 THEN 'Recently Active'
        ELSE 'Stable'
    END AS EngagementLevel,
    CASE 
        WHEN fr.GlobalRank <= 100 THEN 'Top 100'
        WHEN fr.GlobalRank <= 500 THEN 'Top 500'
        WHEN fr.GlobalRank <= 1000 THEN 'Top 1000'
        ELSE 'Below Top 1000'
    END AS GlobalRankCategory,
    DENSE_RANK() OVER (PARTITION BY fr.PostType ORDER BY fr.Score DESC) AS TypeSpecificRank,
    AVG(fr.Score) OVER (PARTITION BY fr.UserId) AS UserAverageScore,
    STDDEV(fr.Score) OVER (PARTITION BY fr.UserId) AS UserScoreStdDev,
    CASE 
        WHEN fr.PostType = 'Question' THEN 
            CASE 
                WHEN fr.AnswerCount > 0 THEN 'Has Answers'
                ELSE 'No Answers'
            END
        ELSE 'N/A'
    END AS QuestionStatus,
    (fr.Views + fr.AnswerCount + fr.CommentCount + fr.PostCommentCount) AS TotalEngagement,
    CASE 
        WHEN fr.UserTopPost = 1 AND fr.GlobalRank <= 10 THEN 'User Champion'
        WHEN fr.UserTopPost = 1 THEN 'Top Post'
        WHEN fr.GlobalRank <= 10 THEN 'Global Top'
        ELSE 'Regular Post'
    END AS PostRecognition,
    CASE 
        WHEN fr.ImpactLevel = 'High Impact' AND fr.DaysActive < 60 THEN 'Recent High Impact'
        WHEN fr.ImpactLevel = 'High Impact' THEN 'Historical High Impact'
        WHEN fr.DaysActive > 365 THEN 'Vintage'
        ELSE 'Current'
    END AS TimeCategory
FROM FilteredResults fr
WHERE fr.DaysSinceCreation > 0
  AND fr.ReputationLevel IN ('Expert', 'Intermediate')
  AND fr.ActivityLevel IN ('Active', 'Moderate')
ORDER BY fr.Reputation DESC, fr.Score DESC, fr.PostCreationDate DESC
LIMIT 1000;