    END as CreatorTier,
    -- Performance measurement column
    cast('2024-10-01 12:34:56' as timestamp) as BenchmarkTimestamp
FROM UserAndPostCombined uap
WHERE 
    uap.UserId IS NOT NULL 
    AND (
        uap.PostId IS NOT NULL 
        OR uap.TotalPosts IS NOT NULL
    )
    AND uap.Score IS NOT NULL
    AND uap.Reputation >= 0
    AND (
        uap.TrendingCategory IN ('Trending', 'Popular') 
        OR uap.UserActivityLevel IN ('High Activity', 'Low Activity')
    )
    AND (
        uap.PostComplexityScore IS NOT NULL 
