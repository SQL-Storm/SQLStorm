        ELSE 0 
    END as AnswerViewRatioPercent,
    -- Complex expressions for performance testing
    TRIM(UPPER(uap.Title)) as UpperTitle,
    LEFT(LOWER(uap.AllPostTitles), 50) as ShortTitleList,
    CASE 
        WHEN uap.PostId IS NOT NULL THEN
            ARRAY_TO_STRING(
                ARRAY[
                    CAST(uap.Score AS VARCHAR),
                    CAST(uap.ViewCount AS VARCHAR),
                    CAST(uap.AnswerCount AS VARCHAR)]
                , ' | '
            )
        ELSE 'No Post Data'
    END as PostMetricsString,
    -- Set operators for performance benchmarking (UNION ALL - requires different columns)
    CASE 
