        COALESCE(fpa.CommentLevel, 'Unknown') as CommentLevel,
        COALESCE(fpa.FavoriteLevel, 'Unknown') as FavoriteLevel,
        COALESCE(fpa.TagCount, 0) as TagCount,
        COALESCE(fpa.PostComplexityScore, 0) as PostComplexityScore,
        COALESCE(fpa.ActivityDurationDays, 0) as ActivityDurationDays,
        COALESCE(fpa.ActivityStatus, 'Unknown') as ActivityStatus,
        COALESCE(fpa.AnswerPerViewRatio, 0) as AnswerPerViewRatio,
        COALESCE(fpa.HasAboveAverageScore, false) as HasAboveAverageScore,
        COALESCE(fpa.RelatedPostCount, 0) as RelatedPostCount,
        COALESCE(fpa.WeightedScore, 0) as WeightedScore,
        COALESCE(fpa.NormalizedScore, 0) as NormalizedScore,
        COALESCE(fpa.TrendingCategory, 'Unknown') as TrendingCategory,
        COALESCE(fpa.ComplexityLevel, 'Unknown') as ComplexityLevel,
        COALESCE(fpa.TagOverlapCount, 0) as TagOverlapCount,
        -- Advanced filtering for performance testing
        CASE 
            WHEN ups.TotalPosts > 0 AND ups.TotalScore > 0 AND ups.AvgScore > 0 THEN 
                'High Activity'
            WHEN ups.TotalPosts > 0 AND ups.TotalScore = 0 THEN 'Low Activity'
            WHEN ups.TotalPosts > 0 AND ups.TotalScore < 0 THEN 'Negative Activity'
            ELSE 'No Activity'
        END as UserActivityLevel
    FROM UserActivityStats ups
    LEFT JOIN FinalPostAnalysis fpa ON ups.UserId = fpa.OwnerUserId
)
