-- {"query": "3540.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 3070} 
WITH 
    TopTags AS (
        SELECT TagName, "Count"
        FROM Tags
        WHERE IsModeratorOnly = 0
        ORDER BY "Count" DESC
        LIMIT 10
    ),
    UserPostAgg AS (
        SELECT 
            u.Id                     AS UserId,
            u.DisplayName,
            u.Reputation,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)               AS QuestionCount,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)               AS AnswerCount,
            AVG(p.Score) FILTER (WHERE p.PostTypeId IN (1,2))         AS AvgScore,
            MAX(p.CreationDate)                                      AS LastPostDate
        FROM Users u
        LEFT JOIN Posts p ON p.OwnerUserId = u.Id
        GROUP BY u.Id, u.DisplayName, u.Reputation
    ),
    BadgeAgg AS (
        SELECT 
            b.UserId,
            SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
            SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
            SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
            MAX(b.Date)                                 AS LastBadgeDate
        FROM Badges b
        GROUP BY b.UserId
    ),
    RecentUserVotes AS (
        SELECT 
            v.UserId,
            v.PostId,
            vt.Name                     AS VoteType,
            v.CreationDate,
            ROW_NUMBER() OVER (PARTITION BY v.UserId ORDER BY v.CreationDate DESC) AS VoteRank
        FROM Votes v
        JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
        WHERE v.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
    )
SELECT 
    uua.UserId,
    CONCAT(uua.DisplayName, ' (', COALESCE(u.Location, 'Unknown'), ')') AS FullName,
    uua.Reputation,
    uua.QuestionCount,
    uua.AnswerCount,
    ROUND(uua.AvgScore::numeric, 2)                               AS AvgScore,
    COALESCE(bag.GoldBadges,   0)                                 AS GoldBadges,
    COALESCE(bag.SilverBadges, 0)                                 AS SilverBadges,
    COALESCE(bag.BronzeBadges, 0)                                 AS BronzeBadges,
    CASE 
        WHEN uua.Reputation > 20000 THEN 'Legendary'
        WHEN uua.Reputation > 10000 THEN 'Expert'
        WHEN uua.Reputation > 5000  THEN 'Contributor'
        ELSE 'Novice'
    END                                                          AS ReputationTier,
    (SELECT COUNT(*) 
     FROM Posts a 
     WHERE a.OwnerUserId = uua.UserId 
       AND a.PostTypeId = 2 
       AND EXISTS (SELECT 1 FROM Posts q WHERE q.Id = a.ParentId AND q.Score >= 10)
    )                                                            AS HighScoringAnswers,
    (SELECT COUNT(*) 
     FROM Comments c 
     WHERE c.UserId = uua.UserId AND c.Score > 0
    )                                                            AS PositiveComments,
    (SELECT STRING_AGG(DISTINCT tt.TagName, ', ') 
     FROM Posts p
     CROSS JOIN LATERAL regexp_split_to_table(p.Tags, '[><]') AS tag(tagtext)
     JOIN Tags tt ON tt.TagName = tag.tagtext
     WHERE p.OwnerUserId = uua.UserId AND p.PostTypeId = 1
     LIMIT 5
    )                                                            AS TopQuestionTags,
    ruv.VoteType,
    ruv.CreationDate                                            AS RecentVoteDate,
    ruv.VoteRank
FROM UserPostAgg uua
LEFT JOIN Users u ON u.Id = uua.UserId
LEFT JOIN BadgeAgg bag ON bag.UserId = uua.UserId
LEFT JOIN RecentUserVotes ruv 
       ON ruv.UserId = uua.UserId AND ruv.VoteRank = 1
WHERE 
    (uua.Reputation > 1000 AND (bag.GoldBadges > 0 OR bag.SilverBadges > 0))
    OR (u.Location IS NULL AND uua.QuestionCount > 20)
    
UNION ALL

SELECT 
    NULL                         AS UserId,
    'Aggregated Tag Summary'     AS FullName,
    NULL                         AS Reputation,
    NULL                         AS QuestionCount,
    NULL                         AS AnswerCount,
    NULL                         AS AvgScore,
    NULL                         AS GoldBadges,
    NULL                         AS SilverBadges,
    NULL                         AS BronzeBadges,
    'Tag'                        AS ReputationTier,
    NULL                         AS HighScoringAnswers,
    NULL                         AS PositiveComments,
    STRING_AGG(TagName, ', ')    AS TopQuestionTags,
    NULL                         AS VoteType,
    NULL                         AS RecentVoteDate,
    NULL                         AS VoteRank
FROM TopTags

ORDER BY 
    Reputation DESC NULLS LAST,
    UserId
LIMIT 150;