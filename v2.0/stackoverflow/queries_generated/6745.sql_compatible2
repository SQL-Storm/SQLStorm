WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        P.LastActivityDate,
        U.DisplayName AS OwnerDisplayName,
        U.Reputation,
        U.AccountId,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS Rank
    FROM 
        Posts P
    LEFT JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0 AND P.ViewCount > 100
),
BadgeCounts AS (
    SELECT 
        B.UserId,
        COUNT(B.Id) AS BadgeCount
    FROM 
        Badges B
    GROUP BY 
        B.UserId
),
CommentStats AS (
    SELECT 
        P.Id AS PostId,
        COUNT(C.Id) AS CommentCount,
        MAX(C.Score) AS MaxCommentScore
    FROM 
        Posts P
    LEFT JOIN 
        Comments C ON P.Id = C.PostId
    GROUP BY 
        P.Id
)
SELECT 
    RP.Id AS PostId,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.LastActivityDate,
    RP.Rank,
    COALESCE(BC.BadgeCount, 0) AS BadgeCount,
    COALESCE(CS.CommentCount, 0) AS CommentCount,
    COALESCE(CS.MaxCommentScore, 0) AS MaxCommentScore,
    CASE 
        WHEN RP.Score > 100 THEN 'High'
        WHEN RP.ViewCount > 1000 THEN 'Medium'
        ELSE 'Low'
    END AS ActivityLevel,
    CASE
        WHEN RP.Title IS NULL OR RP.Title = '' THEN NULL
        ELSE
            TRIM(
                SUBSTRING(
                    RP.Title FROM
                        -- start position: position after the (n-1)th whitespace (i.e. start of second-to-last word)
                        (CASE
                            WHEN (length(trim(RP.Title)) - length(replace(trim(RP.Title), ' ', ''))) >= 1
                            THEN
                                -- find position of (n-1)th space by iteratively locating spaces from left using a simple approach:
                                -- compute number of spaces, then locate the (spaces-1)th occurrence using reversed string functions
                                (
                                    -- position of (n-1)th space: use locate on reversed strings
                                    -- start = length(RP.Title) - position of first space in reversed prefix of title after trimming trailing spaces
                                    length(RP.Title) - (strpos(reverse(RP.Title), ' ' || substring(reverse(RP.Title) FROM strpos(reverse(RP.Title), ' ') + 1)) ) + 2
                                )
                            ELSE 1
                         END)
                    FOR
                    COALESCE(
                        NULLIF(
                            NULLIF(
                                -- length: distance from start position to next space, approximate by finding next space after start
                                (CASE
                                    WHEN strpos(substring(RP.Title FROM (CASE
                                            WHEN (length(trim(RP.Title)) - length(replace(trim(RP.Title), ' ', ''))) >= 1)
                                            THEN
                                                (CASE
                                                    WHEN strpos(reverse(RP.Title), ' ') > 0
                                                    THEN
                                                        -- compute start position as earlier: find position after (n-1)th space
                                                        (
                                                            length(RP.Title) - (strpos(reverse(RP.Title), ' ' || substring(reverse(RP.Title) FROM strpos(reverse(RP.Title), ' ') + 1)) ) + 2
                                                        )
                                                    ELSE 1
                                                 END)
                                            ELSE 1
                                         END)) = 0
                                    THEN 4000
                                    ELSE
                                        (CASE
                                            WHEN strpos(substring(RP.Title FROM (CASE
                                                    WHEN (length(trim(RP.Title)) - length(replace(trim(RP.Title), ' ', ''))) >= 1)
                                                    THEN
                                                        (CASE
                                                            WHEN strpos(reverse(RP.Title), ' ') > 0
                                                            THEN
                                                                (
                                                                    length(RP.Title) - (strpos(reverse(RP.Title), ' ' || substring(reverse(RP.Title) FROM strpos(reverse(RP.Title), ' ') + 1)) ) + 2
                                                                )
                                                            ELSE 1
                                                         END)
                                                    ELSE 1
                                                 END)) > 0
                                            THEN strpos(substring(RP.Title FROM (CASE
                                                    WHEN (length(trim(RP.Title)) - length(replace(trim(RP.Title), ' ', ''))) >= 1)
                                                    THEN
                                                        (CASE
                                                            WHEN strpos(reverse(RP.Title), ' ') > 0
                                                            THEN
                                                                (
                                                                    length(RP.Title) - (strpos(reverse(RP.Title), ' ' || substring(reverse(RP.Title) FROM strpos(reverse(RP.Title), ' ') + 1)) ) + 2
                                                                )
                                                            ELSE 1
                                                         END)
                                                    ELSE 1
                                                 END)), ' ')
                                            ELSE 4000
                                         END)
                                END)
                            , 0)
                        , 0)
                    , 4000)
                )
            )
    END AS ShortTitle
FROM 
    RankedPosts RP
LEFT JOIN 
    BadgeCounts BC ON RP.OwnerDisplayName = CAST(BC.UserId AS VARCHAR)
LEFT JOIN 
    CommentStats CS ON RP.Id = CS.PostId
GROUP BY
    RP.Id,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.LastActivityDate,
    RP.Rank,
    BC.BadgeCount,
    CS.CommentCount,
    CS.MaxCommentScore,
    RP.OwnerDisplayName
ORDER BY 
    RP.Rank, RP.Score DESC;