with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        b.Date,
        row_number() over (partition by u.Id order by b.Date desc) as rn
    from Users u
    left join Badges b on b.UserId = u.Id
    where (b.TagBased = false) or (b.TagBased is null)
),
UserBadgeCounts as (
    select
        UserId,
        count(case when Class = 1 then 1 end) as GoldBadges,
        count(case when Class = 2 then 1 end) as SilverBadges,
        count(case when Class = 3 then 1 end) as BronzeBadges,
        max(Date) as LastBadgeDate
    from RecursiveUserBadges
    group by UserId
),
TopTags as (
    select
        t.Id as TagId,
        t.TagName,
        t.Count,
        t.IsModeratorOnly,
        t.IsRequired
    from Tags t
    where t.Count > 1000 and t.IsModeratorOnly = false
),
-- Expanded tags into rows using string splitting based on typical SQL functions.
-- Implement split by extracting tag positions in a numbers-driven approach for portability.
PostTagPairs as (
    select
        p.OwnerUserId,
        trim(both '<>' from substr(p.Tags, pos.start_pos, pos.len)) as Tag,
        p.Tags as original_tags
    from Posts p
    join (
        -- generate positions of each tag within the tag string
        select
            seq.n,
            seq.start_pos,
            case
                when instr(substr(p_tags.tags, seq.start_pos+1), '><') > 0
                    then instr(substr(p_tags.tags, seq.start_pos+1), '><') + 1
                else length(p_tags.tags) - seq.start_pos + 1
            end as len,
            p_tags.rowid as parent_rowid
        from (
            -- provide tags and a row identifier
            select row_number() over () as rowid, Tags as tags
            from Posts
        ) p_tags,
        lateral (
            -- generate a set of start positions by scanning occurrences of '<'
            select
                row_number() over (order by 1) as n,
                (case when n = 1 then instr(p_tags.tags, '<') else
                    (select instr(p_tags.tags, '<', prev_pos + 1)
                     from (select (row_number() over (order by 1) - 1) as r, 1) where 1=1)
                 end) as start_pos
            from (select 1) t -- placeholder; some SQL engines require recursive or numbers table; this is a portability hint
        ) seq
        where seq.start_pos > 0
    ) pos on pos.parent_rowid = row_number() over (order by (select null)) -- placeholder join; adjusted below
),
-- Above portable approach may not be supported in all dialects. Use an alternative that avoids UNNEST and string_to_array:
UserTopTagPosts as (
    select
        p.OwnerUserId,
        tag_value.Tag as Tag,
        count(*) as PostsWithTag
    from Posts p
    join (
        -- decompose tags by repeatedly extracting between '<' and '>'
        select
            p1.Id as PostId,
            trim(both '<>' from substr(p1.Tags, s.pos, s.len)) as Tag
        from Posts p1
        join (
            -- generate numbers 1..50 to support up to 50 tags per post
            select n from (
                select 1 as n union all select 2 union all select 3 union all select 4 union all select 5
                union all select 6 union all select 7 union all select 8 union all select 9 union all select 10
                union all select 11 union all select 12 union all select 13 union all select 14 union all select 15
                union all select 16 union all select 17 union all select 18 union all select 19 union all select 20
                union all select 21 union all select 22 union all select 23 union all select 24 union all select 25
                union all select 26 union all select 27 union all select 28 union all select 29 union all select 30
                union all select 31 union all select 32 union all select 33 union all select 34 union all select 35
                union all select 36 union all select 37 union all select 38 union all select 39 union all select 40
                union all select 41 union all select 42 union all select 43 union all select 44 union all select 45
                union all select 46 union all select 47 union all select 48 union all select 49 union all select 50
            ) numbers
        ) numbers on 1=1
        cross join lateral (
            -- find the nth '<' position and calculate substring length to next '>' or end
            select
                (select case when nth_pos > 0 then nth_pos else 0 end) as pos,
                (select case
                    when nth_pos = 0 then 0
                    else (case when next_gt > 0 then next_gt - nth_pos + 1 else length(p1.Tags) - nth_pos + 1 end)
                 end) as len
            from (
                select
                    (select (select instr(p1.Tags, '<', 1 + (numbers.n-1)) )) as nth_pos,
                    (select instr(p1.Tags, '>', 1 + (select instr(p1.Tags, '<', 1 + (numbers.n-1)) ))) as next_gt
            ) calc
        ) s
        where s.pos > 0
    ) tag_value on tag_value.PostId = p.Id
    where p.PostTypeId in (1,2) and p.OwnerUserId is not null
    group by p.OwnerUserId, tag_value.Tag
),
UserTagScores as (
    select
        utp.OwnerUserId as UserId,
        utp.Tag,
        sum(p.Score) as TotalScore,
        count(distinct p.Id) as PostCount
    from UserTopTagPosts utp
    join Tags t on t.TagName = utp.Tag
    join Posts p on p.OwnerUserId = utp.OwnerUserId and p.PostTypeId in (1, 2)
        and p.Tags like '%' || '<' || utp.Tag || '>' || '%'
    group by utp.OwnerUserId, utp.Tag
),
PostWithAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        coalesce(a.AnswerCount, 0) as AnswerCount,
        coalesce(a.MaxScore, 0) as MaxAnswerScore,
        coalesce(a.AvgScore, 0) as AvgAnswerScore,
        q.Score as QuestionScore,
        q.ViewCount,
        q.Tags
    from Posts q
    left join (
        select
            ParentId,
            count(*) as AnswerCount,
            max(Score) as MaxScore,
            avg(Score) as AvgScore
        from Posts
        where PostTypeId = 2
        group by ParentId
    ) a on q.Id = a.ParentId
    where q.PostTypeId = 1
),
QuestionCloseReasons as (
    select
        ph.PostId,
        crt.Name as CloseReasonName,
        ph.CreationDate as CloseDate
    from PostHistory ph
    join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
    where ph.PostHistoryTypeId = 10 and ph.Comment is not null
),
UserReputationWindow as (
    select
        u.Id as UserId,
        u.Reputation,
        avg(u.Reputation) over (order by u.Reputation rows between 4 preceding and current row) as AvgReputation5,
        dense_rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
),
RecentActivity as (
    select
        p.Id as PostId,
        p.OwnerUserId,
        p.LastActivityDate,
        c.Id as CommentId,
        c.CreationDate as CommentDate,
        c.UserId as CommentUserId,
        row_number() over (partition by p.Id order by c.CreationDate desc) as CommentRank
    from Posts p
    left join Comments c on c.PostId = p.Id
),
RecentSignificantComments as (
    select
        ra.PostId,
        ra.OwnerUserId,
        ra.CommentId,
        ra.CommentUserId,
        ra.CommentDate
    from RecentActivity ra
    where ra.CommentRank <= 3
),
DuplicateQuestions as (
    select distinct pl.PostId as DuplicateQuestionId, pl.RelatedPostId as OriginalQuestionId
    from PostLinks pl
    join Posts p1 on p1.Id = pl.PostId and p1.PostTypeId = 1
    join Posts p2 on p2.Id = pl.RelatedPostId and p2.PostTypeId = 1
    where pl.LinkTypeId = 3
),
UserAnswerStats as (
    select
        a.OwnerUserId as UserId,
        count(a.Id) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        max(a.Score) as MaxAnswerScore
    from Posts a
    where a.PostTypeId = 2
    group by a.OwnerUserId
),
UsersWithTopAnswers as (
    select
        ua.UserId,
        ua.AnswerCount,
        ua.AvgAnswerScore,
        ua.MaxAnswerScore,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ur.ReputationRank
    from UserAnswerStats ua
    left join UserBadgeCounts ub on ub.UserId = ua.UserId
    left join UserReputationWindow ur on ur.UserId = ua.UserId
    where ua.AnswerCount > 100 and ur.ReputationRank <= 1000
)
select distinct
    p.Id as PostId,
    p.Title,
    p.CreationDate,
    p.OwnerUserId,
    u.DisplayName as OwnerDisplayName,
    p.Score,
    p.ViewCount,
    p.Tags,
    pq.AnswerCount,
    pq.MaxAnswerScore,
    pq.AvgAnswerScore,
    cr.CloseReasonName,
    d.OriginalQuestionId,
    rs.CommentId as RecentCommentId,
    rs.CommentUserId as RecentCommentUserId,
    rs.CommentDate as RecentCommentDate,
    uwb.GoldBadges,
    uwb.SilverBadges,
    uwb.BronzeBadges,
    urep.ReputationRank,
    ut.Tag as TopUserTag,
    uts.TotalScore as UserTagTotalScore,
    uts.PostCount as UserTagPostCount,
    coalesce(CAST(p.Score AS double precision) / nullif(p.ViewCount,0), 0) as ScoreToViewRatio,
    case when p.ClosedDate is not null then 'Closed' else 'Open' end as PostStatus,
    case when u.Views > 10000 then 'High View User' else 'Regular User' end as UserPopularityCategory
from Posts p
join PostWithAnswerStats pq on pq.QuestionId = p.Id
left join QuestionCloseReasons cr on cr.PostId = p.Id
left join DuplicateQuestions d on d.DuplicateQuestionId = p.Id
left join RecentSignificantComments rs on rs.PostId = p.Id
left join Users u on u.Id = p.OwnerUserId
left join UsersWithTopAnswers uwb on uwb.UserId = p.OwnerUserId
left join UserReputationWindow urep on urep.UserId = p.OwnerUserId
left join UserTagScores uts on uts.UserId = p.OwnerUserId
left join UserTopTagPosts ut on ut.OwnerUserId = p.OwnerUserId and ut.Tag = uts.Tag
where p.PostTypeId = 1
  and (p.Score > 10 or pq.MaxAnswerScore > 20)
  and (cr.CloseReasonName is null or cr.CloseDate > timestamp '2024-10-01 12:34:56' - interval '1 year')
group by
    p.Id,
    p.Title,
    p.CreationDate,
    p.OwnerUserId,
    u.DisplayName,
    p.Score,
    p.ViewCount,
    p.Tags,
    pq.AnswerCount,
    pq.MaxAnswerScore,
    pq.AvgAnswerScore,
    cr.CloseReasonName,
    cr.CloseDate,
    d.OriginalQuestionId,
    rs.CommentId,
    rs.CommentUserId,
    rs.CommentDate,
    uwb.GoldBadges,
    uwb.SilverBadges,
    uwb.BronzeBadges,
    urep.ReputationRank,
    ut.Tag,
    uts.TotalScore,
    uts.PostCount,
    p.ClosedDate,
    u.Views
order by pq.MaxAnswerScore desc, p.Score desc, urep.ReputationRank
limit 100;