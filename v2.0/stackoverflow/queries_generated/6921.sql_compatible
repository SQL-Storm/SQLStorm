SELECT 
    u.DisplayName,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.Reputation) AS MaxReputation,
    MIN(u.CreationDate) AS EarliestUser,
    AVG(p.Score) AS AvgPostScore,
    MAX(ph.RevisionGUID) AS LastRevisionGUID,
    COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN pl.RelatedPostId ELSE NULL END) AS TotalDuplicates,
    COUNT(DISTINCT CASE WHEN b.Id IS NOT NULL THEN b.UserId ELSE NULL END) AS TotalBadges,
    STRING_AGG(DISTINCT t.TagName, ', ') AS MostCommonTags
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId = 10
LEFT JOIN 
    PostLinks pl ON p.Id = pl.PostId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Tags t ON p.Id = ANY (STRING_TO_ARRAY(p.Tags, '/><')::text[]) -- replaced cast with standard form for compatibility
WHERE 
    p.PostTypeId IN (1, 2)
    AND u.Reputation > 100
    AND p.CreationDate BETWEEN DATE_TRUNC('month', CAST('2024-10-01' AS DATE)) - INTERVAL '1 year' AND DATE_TRUNC('month', CAST('2024-10-01' AS DATE))
GROUP BY 
    u.Id,
    u.DisplayName
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    TotalPosts DESC, 
    AvgPostScore DESC
LIMIT 10;