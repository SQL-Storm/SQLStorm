WITH
  RankedQuestions AS (
    SELECT
      p.Id AS QuestionId,
      p.Title AS QuestionTitle,
      p.Score AS QuestionScore,
      p.AnswerCount,
      p.CommentCount,
      p.FavoriteCount,
      p.CreationDate AS QuestionCreationDate,
      u.DisplayName AS OwnerDisplayName,
      u.Id AS OwnerUserId,
      ROW_NUMBER() OVER (
        ORDER BY
          p.Score DESC,
          p.FavoriteCount DESC,
          p.AnswerCount DESC
      ) AS RankNum
    FROM Posts p
    JOIN Users u
      ON p.OwnerUserId = u.Id
    WHERE
      p.PostTypeId = 1
      AND p.Score > 10
      AND p.FavoriteCount > 5
      AND p.CreationDate > '2020-01-01'
  ),
  AnswerAggregates AS (
    SELECT
      pr.Id AS QuestionId,
      COUNT(a.Id) AS TotalAnswers,
      SUM(a.Score) AS TotalAnswerScore,
      AVG(a.Score) AS AverageAnswerScore,
      MAX(a.CommentCount) AS MaxAnswerCommentCount,
      MIN(a.CreationDate) AS EarliestAnswerDate,
      MAX(a.CreationDate) AS LatestAnswerDate,
      COUNT(CASE WHEN a.OwnerUserId = pr.OwnerUserId THEN 1 ELSE NULL END) AS AnswersByQuestionOwner,
      COUNT(CASE WHEN u_a.Reputation > 10000 THEN 1 ELSE NULL END) AS HighReputationAnswerCount
    FROM Posts pr
    JOIN Posts a
      ON pr.Id = a.ParentId
    LEFT JOIN Users u_a
      ON a.OwnerUserId = u_a.Id
    WHERE
      pr.PostTypeId = 1
      AND a.PostTypeId = 2
    GROUP BY
      pr.Id
  ),
  CommentStats AS (
    SELECT
      p.Id AS QuestionId,
      COUNT(c.Id) AS TotalComments,
      SUM(c.Score) AS TotalCommentScore,
      AVG(c.Score) AS AverageCommentScore,
      COUNT(DISTINCT c.UserId) AS DistinctCommenters,
      MAX(c.CreationDate) AS LatestCommentDate
    FROM Posts p
    LEFT JOIN Comments c
      ON p.Id = c.PostId
    WHERE
      p.PostTypeId = 1
    GROUP BY
      p.Id
  ),
  TagAnalysis AS (
    -- split tags string into rows in a dialect-agnostic way using a derived table of indexes
    SELECT
      p.Id AS QuestionId,
      SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2) AS TagsString,
      SUM(CASE WHEN tag.TagName LIKE '%sql%' THEN 1 ELSE 0 END) AS SqlTagCount,
      SUM(CASE WHEN tag.TagName LIKE '%performance%' THEN 1 ELSE 0 END) AS PerformanceTagCount,
      COUNT(*) AS TotalTagCountForQuestion
    FROM Posts p
    LEFT JOIN (
      -- create tag rows by splitting on '><'
      SELECT
        post_id,
        TRIM(tag) AS TagName
      FROM (
        SELECT
          p2.Id AS post_id,
          REGEXP_SPLIT_TO_TABLE(SUBSTRING(p2.Tags FROM 2 FOR CHAR_LENGTH(p2.Tags) - 2), '><') AS tag
        FROM Posts p2
        WHERE p2.PostTypeId = 1
      ) s
    ) tag
      ON tag.post_id = p.Id
    WHERE
      p.PostTypeId = 1
    GROUP BY
      p.Id,
      SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2)
  ),
  PostHistorySummary AS (
    SELECT
      ph.PostId,
      MAX(CASE WHEN ph.PostHistoryTypeId = 1 THEN ph.CreationDate ELSE NULL END) AS InitialTitleDate,
      MAX(CASE WHEN ph.PostHistoryTypeId = 4 THEN ph.CreationDate ELSE NULL END) AS LastTitleEditDate,
      MAX(CASE WHEN ph.PostHistoryTypeId = 6 THEN ph.CreationDate ELSE NULL END) AS LastTagsEditDate,
      COUNT(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE NULL END) AS CloseVoteCount,
      COUNT(CASE WHEN ph.PostHistoryTypeId = 12 THEN 1 ELSE NULL END) AS DeleteVoteCount
    FROM PostHistory ph
    WHERE
      ph.PostHistoryTypeId IN (1, 4, 6, 10, 12)
    GROUP BY
      ph.PostId
  ),
  VoteSummary AS (
    SELECT
      v.PostId,
      COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE NULL END) AS UpVoteCount,
      COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE NULL END) AS DownVoteCount,
      COUNT(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE NULL END) AS FavoriteVoteCount,
      SUM(CASE WHEN v.VoteTypeId = 8 THEN COALESCE(v.BountyAmount,0) ELSE 0 END) AS TotalBountyAmount
    FROM Votes v
    WHERE
      v.VoteTypeId IN (2, 3, 5, 8)
    GROUP BY
      v.PostId
  ),
  UserEngagement AS (
    SELECT
      u.Id AS UserId,
      COUNT(p.Id) AS UserQuestionCount,
      SUM(p.Score) AS UserTotalQuestionScore,
      COUNT(a.Id) AS UserAnswerCount,
      SUM(a.Score) AS UserTotalAnswerScore,
      COUNT(b.Id) AS UserBadgeCount,
      MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Posts p
      ON u.Id = p.OwnerUserId AND p.PostTypeId = 1
    LEFT JOIN Posts a
      ON u.Id = a.OwnerUserId AND a.PostTypeId = 2
    LEFT JOIN Badges b
      ON u.Id = b.UserId
    WHERE
      u.Reputation > 5000
    GROUP BY
      u.Id
  )
SELECT
  rq.QuestionId,
  rq.QuestionTitle,
  rq.QuestionScore,
  rq.OwnerDisplayName,
  rq.QuestionCreationDate,
  rq.RankNum,
  COALESCE(aa.TotalAnswers, 0) AS TotalAnswers,
  COALESCE(aa.TotalAnswerScore, 0) AS TotalAnswerScore,
  COALESCE(aa.AverageAnswerScore, 0) AS AverageAnswerScore,
  COALESCE(cs.TotalComments, 0) AS TotalComments,
  COALESCE(cs.TotalCommentScore, 0) AS TotalCommentScore,
  COALESCE(ta.SqlTagCount, 0) AS SqlTagCount,
  COALESCE(ta.PerformanceTagCount, 0) AS PerformanceTagCount,
  COALESCE(vs.UpVoteCount, 0) AS UpVoteCount,
  COALESCE(vs.DownVoteCount, 0) AS DownVoteCount,
  COALESCE(vs.FavoriteVoteCount, 0) AS FavoriteVoteCount,
  COALESCE(vs.TotalBountyAmount, 0) AS TotalBountyAmount,
  COALESCE(phs.CloseVoteCount, 0) AS CloseVoteCount,
  COALESCE(phs.DeleteVoteCount, 0) AS DeleteVoteCount,
  ue.UserQuestionCount,
  ue.UserTotalQuestionScore,
  ue.UserAnswerCount,
  ue.UserTotalAnswerScore,
  ue.UserBadgeCount,
  ue.LastBadgeDate,
  CASE
    WHEN aa.LatestAnswerDate IS NOT NULL AND aa.EarliestAnswerDate IS NOT NULL THEN aa.LatestAnswerDate - aa.EarliestAnswerDate
    ELSE INTERVAL '0 seconds'
  END AS AnswerResponseTime,
  CASE
    WHEN rq.QuestionCreationDate IS NOT NULL AND cs.LatestCommentDate IS NOT NULL THEN cs.LatestCommentDate - rq.QuestionCreationDate
    ELSE INTERVAL '0 seconds'
  END AS FirstCommentAfterCreation,
  UPPER(SUBSTRING(rq.QuestionTitle FROM 1 FOR 3)) || '-' || RIGHT(CAST(rq.QuestionScore AS VARCHAR), 3) AS DerivedMetric
FROM RankedQuestions rq
LEFT JOIN AnswerAggregates aa
  ON rq.QuestionId = aa.QuestionId
LEFT JOIN CommentStats cs
  ON rq.QuestionId = cs.QuestionId
LEFT JOIN TagAnalysis ta
  ON rq.QuestionId = ta.QuestionId
LEFT JOIN PostHistorySummary phs
  ON rq.QuestionId = phs.PostId
LEFT JOIN VoteSummary vs
  ON rq.QuestionId = vs.PostId
LEFT JOIN UserEngagement ue
  ON rq.OwnerUserId = ue.UserId
WHERE
  rq.RankNum BETWEEN 1 AND 1000
ORDER BY
  rq.RankNum;