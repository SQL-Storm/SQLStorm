SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    AVG(p.Score) AS AvgPostScore,
    MAX(ph.CreationDate) AS LatestPostHistory,
    (
        SELECT 
            STRING_AGG(t.TagName, ', ')
        FROM 
            Tags t
        WHERE 
            t.Id IN (
                SELECT 
                    pt.TagId
                FROM 
                    Posts p2
                    JOIN PostTags pt ON p2.Id = pt.PostId
                WHERE 
                    p2.PostTypeId = 1
                    AND p2.OwnerUserId = u.Id
                    AND p2.CreationDate > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year'
            )
    ) AS MostActiveTags,
    (
        SELECT 
            COUNT(*)
        FROM 
            Votes v
        WHERE 
            v.PostId IN (
                SELECT p3.Id FROM Posts p3 WHERE p3.OwnerUserId = u.Id
            )
            AND v.VoteTypeId = 1
    ) AS AcceptedAnswerCount,
    (
        SELECT 
            COUNT(*)
        FROM 
            Badges b
        WHERE 
            b.UserId = u.Id
            AND b.Class = 1
    ) AS GoldBadgeCount
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
WHERE 
    u.Reputation > 100
    AND u.Id NOT IN (
        SELECT 
            DISTINCT c.UserId
        FROM 
            Comments c
        WHERE 
            c.Text LIKE '%spam%'
    )
GROUP BY 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate
HAVING 
    AVG(p.Score) > 10
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC
LIMIT 100;