-- {"query": "348.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 3164} 
with recent_activity as (
  select
    p.id as post_id,
    p.posttypeid,
    p.owneruserid,
    p.creationdate,
    p.score,
    p.viewcount,
    p.title,
    p.tags,
    coalesce(p.answercount, 0) as answercount,
    p.closeddate,
    p.lastactivitydate,
    u.reputation,
    u.displayname,
    date_trunc('month', p.creationdate) as create_month
  from posts p
  left join users u on u.id = p.owneruserid
  where p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
comment_shards as (
  select
    c.postid,
    count(*) filter (where c.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year') as comments_1y,
    count(*) as comments_all,
    sum(c.score) as comment_score_sum,
    max(c.creationdate) as last_comment_date
  from comments c
  group by c.postid
),
vote_agg as (
  select
    v.postid,
    count(*) filter (where v.votetypeid = 2) as upvotes,
    count(*) filter (where v.votetypeid = 3) as downvotes,
    sum(case when v.votetypeid = 8 then coalesce(v.bountyamount, 0) else 0 end) as bounty_started,
    sum(case when v.votetypeid = 9 then coalesce(v.bountyamount, 0) else 0 end) as bounty_awarded,
    max(v.creationdate) as last_vote_date
  from votes v
  group by v.postid
),
link_stats as (
  select
    pl.postid,
    count(*) filter (where pl.linktypeid = 1) as links_linked,
    count(*) filter (where pl.linktypeid = 3) as links_duplicate,
    count(distinct pl.relatedpostid) as related_distinct,
    min(pl.creationdate) as first_link_date
  from postlinks pl
  group by pl.postid
),
history_flags as (
  select
    ph.postid,
    bool_or(ph.posthistorytypeid in (10,35)) as ever_closed_or_migrated,
    bool_or(ph.posthistorytypeid in (11)) as ever_reopened,
    sum(case when ph.posthistorytypeid in (4,5,6,7,8,9,24) then 1 else 0 end) as edit_events,
    max(ph.creationdate) as last_history_date
  from posthistory ph
  group by ph.postid
),
badge_rollup as (
  select
    b.userid,
    sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
    sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
    sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
    count(*) as total_badges,
    count(*) filter (where b.tagbased = 1) as tag_badges
  from badges b
  group by b.userid
),
tag_explode as (
  select
    p.id as post_id,
    unnest(
      case
        when p.tags is null then array[]::varchar[]
        else string_to_array(substring(p.tags, 2, length(p.tags)-2), '><')
      end
    ) as tagname
  from posts p
  where p.posttypeid = 1
),
tag_quality as (
  select
    te.post_id,
    percentile_cont(0.5) within group (order by t.count) as tag_popularity_median,
    avg((t.count)::numeric) as tag_popularity_avg,
    sum(case when t.ismoderatoronly = 1 then 1 else 0 end) as mod_only_tag_count,
    count(*) as tag_count
  from tag_explode te
  left join tags t on lower(t.tagname) = lower(te.tagname)
  group by te.post_id
),
answers_cte as (
  select
    a.parentid as question_id,
    count(*) as answers_total,
    sum(case when a.score > 0 then 1 else 0 end) as answers_positive,
    max(a.score) as best_answer_score,
    min(a.creationdate) as first_answer_date,
    max(a.creationdate) as last_answer_date
  from posts a
  where a.posttypeid = 2
  group by a.parentid
),
question_core as (
  select
    ra.*,
    coalesce(ta.tag_popularity_median, 0) as tag_popularity_median,
    coalesce(ta.tag_popularity_avg, 0) as tag_popularity_avg,
    coalesce(ta.mod_only_tag_count, 0) as mod_only_tag_count,
    coalesce(ta.tag_count, 0) as tag_count,
    ac.answers_total,
    ac.answers_positive,
    ac.best_answer_score,
    ac.first_answer_date,
    ac.last_answer_date
  from recent_activity ra
  left join tag_quality ta on ta.post_id = ra.post_id
  left join answers_cte ac on ac.question_id = ra.post_id
  where ra.posttypeid = 1
),
engagement as (
  select
    qc.post_id,
    qc.title,
    qc.tags,
    qc.creationdate,
    coalesce(cs.comments_1y, 0) as comments_1y,
    coalesce(cs.comments_all, 0) as comments_all,
    coalesce(cs.comment_score_sum, 0) as comment_score_sum,
    coalesce(va.upvotes, 0) as upvotes,
    coalesce(va.downvotes, 0) as downvotes,
    coalesce(va.bounty_started, 0) as bounty_started,
    coalesce(va.bounty_awarded, 0) as bounty_awarded,
    coalesce(ls.links_linked, 0) as links_linked,
    coalesce(ls.links_duplicate, 0) as links_duplicate,
    coalesce(ls.related_distinct, 0) as related_distinct,
    qc.score,
    qc.viewcount,
    qc.answercount,
    qc.answers_total,
    qc.answers_positive,
    qc.best_answer_score,
    qc.first_answer_date,
    qc.last_answer_date,
    qc.tag_popularity_median,
    qc.tag_popularity_avg,
    qc.tag_count,
    qc.mod_only_tag_count,
    qc.closeddate,
    qc.lastactivitydate,
    qc.owneruserid,
    qc.reputation,
    qc.displayname,
    qc.create_month,
    coalesce(hf.ever_closed_or_migrated, false) as ever_closed_or_migrated,
    coalesce(hf.ever_reopened, false) as ever_reopened,
    coalesce(hf.edit_events, 0) as edit_events,
    greatest(coalesce(hf.last_history_date, qc.creationdate),
             coalesce(cs.last_comment_date, qc.creationdate),
             coalesce(va.last_vote_date, qc.creationdate),
             coalesce(ls.first_link_date, qc.creationdate)) as last_touch
  from question_core qc
  left join comment_shards cs on cs.postid = qc.post_id
  left join vote_agg va on va.postid = qc.post_id
  left join link_stats ls on ls.postid = qc.post_id
  left join history_flags hf on hf.postid = qc.post_id
),
user_enrichment as (
  select
    e.*,
    coalesce(br.gold_badges, 0) as gold_badges,
    coalesce(br.silver_badges, 0) as silver_badges,
    coalesce(br.bronze_badges, 0) as bronze_badges,
    coalesce(br.total_badges, 0) as total_badges,
    coalesce(br.tag_badges, 0) as tag_badges
  from engagement e
  left join badge_rollup br on br.userid = e.owneruserid
),
scored as (
  select
    ue.*,
    -- compute engagement score with mixed features, protect from divide-by-zero
    (
      0.30 * ln(1 + ue.viewcount)
      + 0.25 * greatest(ue.upvotes - ue.downvotes, 0)
      + 0.20 * coalesce(ue.comments_all, 0)
      + 0.10 * coalesce(ue.answers_positive, 0)
      + 0.05 * coalesce(ue.edit_events, 0)
      + 0.05 * case when ue.ever_closed_or_migrated then 0 else 5 end
      + 0.05 * least(coalesce(ue.tag_count, 0), 5)
    )::numeric(18,6) as engagement_score,
    (
      0.40 * ln(1 + coalesce(ue.reputation, 0))
      + 0.30 * ln(1 + coalesce(ue.total_badges, 0))
      + 0.20 * ln(1 + coalesce(ue.tag_badges, 0))
      + 0.10 * case when ue.mod_only_tag_count > 0 then 1 else 0 end
    )::numeric(18,6) as author_influence,
    case
      when ue.closeddate is not null then 'Closed'
      when ue.links_duplicate > 0 then 'DuplicateFlagged'
      when ue.score < 0 then 'Controversial'
      when ue.answers_total is null or ue.answers_total = 0 then 'Unanswered'
      else 'Active'
    end as status_bucket
  from user_enrichment ue
),
ranked as (
  select
    s.*,
    row_number() over (partition by date_trunc('month', s.creationdate) order by s.engagement_score desc, s.viewcount desc) as rn_month,
    dense_rank() over (order by s.engagement_score desc) as global_rank,
    percentile_disc(0.5) within group (order by s.engagement_score) over () as median_engagement,
    avg(s.engagement_score) over () as avg_engagement,
    sum(case when s.status_bucket = 'Unanswered' then 1 else 0 end) over (partition by s.create_month) as unanswered_in_month
  from scored s
),
anomalies as (
  select
    r.*,
    case
      when r.engagement_score > 2 * r.avg_engagement then 'HighOutlier'
      when r.engagement_score < 0.5 * r.median_engagement then 'LowOutlier'
      else 'Normal'
    end as engagement_outlier
  from ranked r
),
recent_dupes as (
  select distinct on (pl.postid)
    pl.postid,
    pl.relatedpostid,
    pl.creationdate as dup_date
  from postlinks pl
  where pl.linktypeid = 3
  order by pl.postid, pl.creationdate desc
),
final_set as (
  select
    a.post_id,
    a.title,
    a.tags,
    a.displayname as owner_displayname,
    a.reputation,
    a.total_badges,
    a.viewcount,
    a.upvotes,
    a.downvotes,
    a.answercount,
    a.answers_total,
    a.comments_all,
    a.score,
    a.engagement_score,
    a.author_influence,
    a.status_bucket,
    a.engagement_outlier,
    a.global_rank,
    a.rn_month,
    a.create_month,
    a.last_touch,
    rd.relatedpostid as dupe_of,
    rd.dup_date
  from anomalies a
  left join recent_dupes rd on rd.postid = a.post_id
  where
    -- complex predicate mixing string ops, null logic, date math
    (
      a.tags is not null
      and position('java' in lower(coalesce(a.tags, ''))) > 0
      or (a.tag_count >= 3 and a.tag_popularity_avg > 1000)
    )
    and coalesce(a.reputation, 0) >= 50
    and a.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '4 years'
    and (a.ever_reopened or not a.ever_closed_or_migrated)
    and (a.upvotes - a.downvotes) >= -2
),
augmented as (
  select
    f.*,
    -- correlated scalar subquery: compute median score of answers for this question
    (
      select percentile_cont(0.5) within group (order by p2.score)
      from posts p2
      where p2.parentid = f.post_id and p2.posttypeid = 2
    ) as median_answer_score,
    -- existence checks to stress planner
    exists (
      select 1 from comments c
      where c.postid = f.post_id and c.score > 10
    ) as has_hot_comment,
    exists (
      select 1 from posthistory ph
      where ph.postid = f.post_id and ph.posthistorytypeid in (24)
    ) as has_suggested_edit
  from final_set f
)
select
  a.post_id,
  coalesce(nullif(trim(a.title), ''), '[no title]') as title,
  a.tags,
  a.owner_displayname,
  a.reputation,
  a.total_badges,
  a.viewcount,
  a.upvotes,
  a.downvotes,
  a.answercount,
  a.answers_total,
  a.comments_all,
  a.score,
  a.engagement_score,
  a.author_influence,
  a.status_bucket,
  a.engagement_outlier,
  a.global_rank,
  a.rn_month,
  a.create_month,
  a.last_touch,
  a.dupe_of,
  a.dup_date,
  coalesce(a.median_answer_score, 0) as median_answer_score,
  a.has_hot_comment,
  a.has_suggested_edit,
  -- composite final score using set-operator idea via conditional bonuses
  (
    a.engagement_score
    + case when a.status_bucket = 'Active' then 1.5 else 0 end
    + case when a.has_hot_comment then 0.75 else 0 end
    + case when a.has_suggested_edit then 0.25 else 0 end
    + case when a.engagement_outlier = 'HighOutlier' then 0.5 when a.engagement_outlier = 'LowOutlier' then -0.5 else 0 end
  )::numeric(18,6) as composite_score
from augmented a
qualify
  -- final filtering using windowed rank semantics via qualify (PostgreSQL: wrap as subquery if not supported)
  a.global_rank <= 500
order by composite_score desc, a.viewcount desc, a.upvotes desc, a.post_id asc;