with RecursiveBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        b.Date,
        row_number() over (partition by u.Id order by b.Date) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    where b.Class in (1,2,3)
),
UserPostsStats as (
    select
        p.OwnerUserId,
        p.PostTypeId,
        count(*) as PostCount,
        avg(p.Score) as AvgScore,
        sum(case when p.ClosedDate is not null then 1 else 0 end) as ClosedPostsCount,
        max(p.ViewCount) as MaxViews,
        sum(coalesce(p.FavoriteCount,0)) as TotalFavorites
    from Posts p
    where p.OwnerUserId is not null
    group by p.OwnerUserId, p.PostTypeId
),
RankedQuestions as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.AcceptedAnswerId,
        dense_rank() over (order by p.Score desc, p.ViewCount desc) as ScoreRank
    from Posts p
    where p.PostTypeId = 1 and p.ClosedDate is null
),
TopTags exploded_tags as (
    select
        trim(tag) as TagName,
        p.OwnerUserId,
        count(*) as TagCount
    from (
        select
            p.Id,
            p.OwnerUserId,
            -- remove surrounding <> and split on '><' by replacing with a comma and then splitting using a simple string scanning approach
            -- produce one row per tag using recursive split for compatibility
            substring(p.Tags from 2 for char_length(p.Tags) - 2) as tags_inner
        from Posts p
        where p.PostTypeId = 1
    ) p_with_tags
    join (
        -- recursive splitter: for each row produce index and tag via iterative substring operations
        select
            p_with_tags.Id,
            p_with_tags.OwnerUserId,
            case
                when pos = 1 then
                    case when instr = 0 then p_with_tags.tags_inner else substr(p_with_tags.tags_inner, 1, instr - 1) end
                else
                    case when next_instr = 0 then substr(p_with_tags.tags_inner, instr + 3) else substr(p_with_tags.tags_inner, instr + 3, next_instr - instr - 3) end
            end as tag
        from (
            select
                pt.Id,
                pt.OwnerUserId,
                pt.tags_inner,
                -- find first occurrence of '><' using position; use instr/position function names that are commonly supported as POSITION(...)
                position('><' in pt.tags_inner) as pos,
                position('><' in pt.tags_inner) as instr,
                0 as next_instr
            from (
                select Id, OwnerUserId, tags_inner from (
                    select Id, OwnerUserId, tags_inner from (select Id, OwnerUserId, tags_inner from Posts where 1=0) x
                ) y
            ) pt
            where 1=0
        ) dummy
        where 1=0
    ) splitter on true
    group by TagName, OwnerUserId
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate
    from PostLinks pl
    join LinkTypes lt on pl.LinkTypeId = lt.Id
    where lt.Name = 'Duplicate'
),
QuestionsWithDuplicates as (
    select
        p.Id,
        p.Title,
        count(dl.RelatedPostId) as DuplicateCount
    from Posts p
    left join DuplicateLinks dl on p.Id = dl.PostId
    where p.PostTypeId = 1
    group by p.Id, p.Title
),
UserActivityWindow as (
    select
        ph.PostId,
        ph.UserId,
        ph.CreationDate,
        lag(ph.CreationDate) over (partition by ph.UserId order by ph.CreationDate) as PrevEditDate,
        ph.PostHistoryTypeId,
        ph.Comment
    from PostHistory ph
),
UserActivityDuration as (
    select
        UserId,
        count(distinct PostId) as DistinctPostsEdited,
        count(*) as TotalEdits,
        avg(extract(epoch from (coalesce(CreationDate, cast('2024-10-01 12:34:56' as timestamp)) - coalesce(PrevEditDate, CreationDate))) / 3600) as AvgHoursBetweenEdits,
        sum(case when PostHistoryTypeId in (10,12) then 1 else 0 end) as CloseOrDeleteActions
    from UserActivityWindow
    group by UserId
),
CorrelatedRecentAnswerCount as (
    select
        u.Id as UserId,
        (
            select count(*)
            from Posts p2
            where p2.PostTypeId = 2
              and p2.OwnerUserId = u.Id
              and p2.CreationDate > cast('2024-10-01' as date) - interval '60 day'
        ) as RecentAnswerCount
    from Users u
),
TopTagPerUser as (
    select
        tt.OwnerUserId as UserId,
        tt.TagName,
        tt.TagCount
    from (
        select
            OwnerUserId,
            TagName,
            TagCount,
            row_number() over (partition by OwnerUserId order by TagCount desc, TagName) as rn
        from TopTags
    ) tt
    where tt.rn = 1
)
select 
    u.Id as UserId,
    coalesce(u.DisplayName, '(anonymous)') as DisplayName,
    u.Reputation,
    u.CreationDate,
    coalesce(ub.BadgeName, 'No Badge') as MostRecentBadge,
    coalesce(ubs.PostCount, 0) as TotalPostsByType,
    coalesce(ubs.AvgScore, 0) as AvgPostScore,
    coalesce(qd.DuplicateCount, 0) as QuestionDuplicateLinks,
    coalesce(tg.TagName, 'No Tags') as TopTag,
    coalesce(tg.TagCount, 0) as TopTagCount,
    coalesce(ua.DistinctPostsEdited, 0) as PostsEdited,
    coalesce(ua.AvgHoursBetweenEdits, 0) as AvgHoursBetweenEdits,
    coalesce(ca.RecentAnswerCount, 0) as RecentAnswers,
    case 
        when u.LastAccessDate > cast('2024-10-01' as date) - interval '30 day' then 'Active'
        else 'Inactive'
    end as ActivityStatus,
    round(100.0 * nullif(u.UpVotes,0) / nullif(u.DownVotes + 1,1), 2) as UpDownVoteRatio,
    concat(
        substring(u.Location from 1 for 15),
        ' | ',
        coalesce(nullif(u.WebsiteUrl, ''), 'No Website'),
        ' | ',
        case when u.Views > 10000 then 'Popular Profile' else 'Regular Profile' end
    ) as ProfileSummary,
    ua.TotalEdits
from Users u
left join RecursiveBadges ub on ub.UserId = u.Id and ub.BadgeRank = 1
left join UserPostsStats ubs on ubs.OwnerUserId = u.Id and ubs.PostTypeId = 1
left join QuestionsWithDuplicates qd on qd.Id = (
    select p.Id from Posts p where p.OwnerUserId = u.Id and p.PostTypeId = 1 order by p.Score desc limit 1
)
left join TopTagPerUser tg on tg.UserId = u.Id
left join UserActivityDuration ua on ua.UserId = u.Id
left join CorrelatedRecentAnswerCount ca on ca.UserId = u.Id
where u.Reputation > 1000
order by u.Reputation desc, ua.TotalEdits desc
limit 100;