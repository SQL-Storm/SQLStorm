-- {"query": "6027.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 447} 
SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class AS BadgeClass,
    t.TagName,
    COUNT(vl.Id) AS TotalVotes,
    MAX(ph.CreationDate) AS LatestPostHistoryChange,
    ph.Comment AS LastPostHistoryComment
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    (SELECT 
        UserId, 
        COUNT(Id) AS TotalVotes
     FROM 
        Votes 
     GROUP BY 
        UserId) vl ON u.Id = vl.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    (SELECT 
        TagName, 
        Id, 
        COUNT(Id) AS TagCount
     FROM 
        Tags 
     GROUP BY 
        TagName, Id) t ON p.Tags LIKE '%' || t.TagName || '%'
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId = 10
WHERE 
    u.Reputation > 10000
    AND p.Score > 100
    AND p.LastActivityDate > DATE_SUB(cast('2024-10-01 12:34:56' as timestamp), INTERVAL 1 YEAR)
GROUP BY 
    u.DisplayName, u.Reputation, b.Class, t.TagName
HAVING 
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) > 10
ORDER BY 
    TotalPosts DESC, 
    TotalVotes DESC;