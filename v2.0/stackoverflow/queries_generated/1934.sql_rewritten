    REPLACE(LOWER(COALESCE(uam.Location, 'N/A')), ' ', '-'),
    pqh.TagArray[1],
    AVG(pqh.PostScore) OVER (PARTITION BY uam.ReputationQuartile),
    RANK() OVER (PARTITION BY uam.LocationCategory ORDER BY uam.TotalPostsOwned DESC, uam.Reputation DESC),
    LAG(uam.TotalPostsOwned, 1, 0) OVER (PARTITION BY uam.ReputationQuartile ORDER BY uam.Reputation DESC),
    (
        SELECT MAX(a_sub.Score)
        FROM Posts AS a_sub
        WHERE a_sub.ParentId = qae.QuestionId
              AND a_sub.OwnerUserId = uam.UserId
              AND a_sub.PostTypeId = 2
    ),
    (
        SELECT MAX(ph_sub.CreationDate)
        FROM PostHistory AS ph_sub
        WHERE ph_sub.UserId = uam.UserId
              AND ph_sub.PostHistoryTypeId IN (10, 11, 12, 13)
    ),
    LENGTH(pqh.Body),
    pqh.PostUpVotes,
    pqh.PostDownVotes,
    (pqh.PostUpVotes::NUMERIC / NULLIF(pqh.PostUpVotes + pqh.PostDownVotes, 0))
FROM
    UserActivityMetrics uam
LEFT JOIN
    PostHistoricalMetrics pqh ON uam.UserId = pqh.OwnerUserId AND pqh.UserPostSeqNumDesc = 1
LEFT JOIN
    QuestionAnswerEngagement qae ON uam.UserId = qae.QuestionOwnerId AND qae.TotalAnswers > 0
WHERE
    uam.UserDownVotes > uam.UserUpVotes * 3 -- Users with significantly more downvotes than upvotes
    AND uam.Reputation < 500
    AND pqh.PostTypeId IS NULL -- Users who haven't posted anything but have lots of downvotes
    AND uam.LocationCategory = 'Other_Location' -- And are not from primary known locations
