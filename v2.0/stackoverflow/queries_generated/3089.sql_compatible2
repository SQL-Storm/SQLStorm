WITH TopGoldUsers AS (
    SELECT u.Id,
           u.DisplayName,
           u.Reputation,
           ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS rn
    FROM Users u
    WHERE EXISTS (
        SELECT 1
        FROM Badges b
        WHERE b.UserId = u.Id
          AND b.Class = 1
    )
),
RecentPosts AS (
    SELECT p.Id,
           p.OwnerUserId,
           p.PostTypeId,
           p.Score,
           p.CreationDate,
           p.AcceptedAnswerId,
           p.Tags,
           v.UpVotes,
           v.DownVotes
    FROM Posts p
    LEFT JOIN (
        SELECT PostId,
               SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
               SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes
        WHERE CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '365' DAY)
        GROUP BY PostId
    ) v ON v.PostId = p.Id
    WHERE p.OwnerUserId IS NOT NULL
      AND p.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '365' DAY)
),
-- Split tags without using UNNEST/string_to_array which may be non-portable.
-- This uses a recursive CTE to split tag strings like '<tag1><tag2>' into rows.
UserTagStats AS (
    SELECT rp.OwnerUserId AS UserId,
           -- extract first tag (without angle brackets)
           CASE
             WHEN pos = 0 THEN NULL
             ELSE SUBSTR(tags_blob, pos + 1, next_pos - pos - 1)
           END AS Tag,
           1 AS cnt
    FROM (
        SELECT rp.OwnerUserId,
               rp.Tags AS tags_blob,
               0 AS pos,
               INSTR(rp.Tags || '>', '><') AS next_pos
        FROM RecentPosts rp
        WHERE rp.Tags IS NOT NULL
    ) first_tags
    WHERE tags_blob IS NOT NULL AND tags_blob <> ''
    UNION ALL
    SELECT ut.UserId,
           CASE
             WHEN pos = 0 THEN NULL
             ELSE SUBSTR(tags_blob, pos + 1, next_pos - pos - 1)
           END AS Tag,
           1 AS cnt
    FROM (
        -- recursive part: find subsequent positions
        SELECT rp.OwnerUserId AS UserId,
               rp.Tags AS tags_blob,
               INSTR(rp.Tags || '>', '><', occ) AS pos,
               INSTR(rp.Tags || '>', '><', INSTR(rp.Tags || '>', '><', occ) + 2) AS next_pos,
               occ + 1 AS occ
        FROM RecentPosts rp,
             (SELECT 1 AS occ) o
        WHERE rp.Tags IS NOT NULL
    ) ut
    WHERE tags_blob IS NOT NULL AND tags_blob <> ''
),
-- Aggregate tag counts. Because the recursive splitter above may produce duplicates, aggregate accordingly.
UserTagCounts AS (
    SELECT UserId,
           Tag,
           COUNT(*) AS TagUseCount
    FROM UserTagStats
    WHERE Tag IS NOT NULL AND Tag <> ''
    GROUP BY UserId, Tag
),
RankedUserTags AS (
    SELECT utc.UserId,
           utc.Tag,
           utc.TagUseCount,
           ROW_NUMBER() OVER (PARTITION BY utc.UserId ORDER BY utc.TagUseCount DESC) AS TagRank
    FROM UserTagCounts utc
),
UserPostAggregates AS (
    SELECT tg.Id AS UserId,
           COUNT(CASE WHEN rp.PostTypeId = 1 THEN 1 END)                       AS QuestionCount,
           COUNT(CASE WHEN rp.PostTypeId = 2 THEN 1 END)                       AS AnswerCount,
           AVG(CASE WHEN rp.PostTypeId = 1 THEN rp.Score END)                 AS AvgQuestionScore,
           -- Use median approximation via percentile_cont if supported; otherwise NULL
           PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY rp.Score)
               FILTER (WHERE rp.PostTypeId = 1)                               AS MedianQuestionScore,
           SUM(COALESCE(rp.UpVotes, 0))                                      AS TotalUpVotes,
           SUM(COALESCE(rp.DownVotes, 0))                                    AS TotalDownVotes,
           COUNT(CASE WHEN rp.PostTypeId = 1 AND rp.AcceptedAnswerId IS NOT NULL THEN 1 END)
                                                                          AS QuestionsWithAccepted,
           MAX(rp.CreationDate)                                              AS LastPostDate
    FROM TopGoldUsers tg
    LEFT JOIN RecentPosts rp ON rp.OwnerUserId = tg.Id
    GROUP BY tg.Id
),
FinalResult AS (
    SELECT tgu.Id,
           tgu.DisplayName,
           tgu.Reputation,
           upa.QuestionCount,
           upa.AnswerCount,
           upa.AvgQuestionScore,
           upa.MedianQuestionScore,
           upa.TotalUpVotes,
           upa.TotalDownVotes,
           upa.QuestionsWithAccepted,
           upa.LastPostDate,
           CASE 
               WHEN upa.QuestionCount = 0 THEN NULL
               ELSE ROUND(CAST(upa.QuestionsWithAccepted AS NUMERIC) / upa.QuestionCount, 2)
           END AS AcceptedAnswerRatio,
           STRING_AGG(rut.Tag, ', ') FILTER (WHERE rut.TagRank <= 3)         AS TopThreeTags,
           tgu.rn
    FROM TopGoldUsers tgu
    LEFT JOIN UserPostAggregates upa ON upa.UserId = tgu.Id
    LEFT JOIN RankedUserTags rut   ON rut.UserId = tgu.Id
    GROUP BY tgu.Id, tgu.DisplayName, tgu.Reputation, tgu.rn,
             upa.QuestionCount, upa.AnswerCount, upa.AvgQuestionScore,
             upa.MedianQuestionScore, upa.TotalUpVotes, upa.TotalDownVotes,
             upa.QuestionsWithAccepted, upa.LastPostDate
)
SELECT Id,
       DisplayName,
       Reputation,
       QuestionCount,
       AnswerCount,
       AvgQuestionScore,
       MedianQuestionScore,
       TotalUpVotes,
       TotalDownVotes,
       QuestionsWithAccepted,
       LastPostDate,
       AcceptedAnswerRatio,
       TopThreeTags
FROM FinalResult
WHERE rn <= 10

UNION ALL

SELECT u.Id,
       u.DisplayName,
       u.Reputation,
       0                                 AS QuestionCount,
       0                                 AS AnswerCount,
       NULL                              AS AvgQuestionScore,
       NULL                              AS MedianQuestionScore,
       0                                 AS TotalUpVotes,
       0                                 AS TotalDownVotes,
       0                                 AS QuestionsWithAccepted,
       NULL                              AS LastPostDate,
       NULL                              AS AcceptedAnswerRatio,
       NULL                              AS TopThreeTags
FROM Users u
WHERE NOT EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1)
  AND u.Reputation > (SELECT COALESCE(MAX(Reputation), 0) FROM TopGoldUsers)
ORDER BY Reputation DESC
LIMIT 10;