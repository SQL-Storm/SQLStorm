WITH UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT v.Id) AS VoteCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        MAX(b.Date) AS LastBadgeDate,
        MAX(v.CreationDate) AS LastVoteDate,
        CASE 
            WHEN u.Reputation >= 10000 THEN 'Elite'
            WHEN u.Reputation >= 1000 THEN 'Expert'
            WHEN u.Reputation >= 100 THEN 'Novice'
            ELSE 'Beginner'
        END AS UserTier,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRankDense,
        NTILE(10) OVER (ORDER BY u.Reputation DESC) AS ReputationDecile,
        LAG(u.Reputation, 1) OVER (ORDER BY u.Reputation DESC) AS PrevReputation,
        LEAD(u.Reputation, 1) OVER (ORDER BY u.Reputation DESC) AS NextReputation,
        AVG(u.Reputation) OVER (ORDER BY u.Reputation ROWS BETWEEN 5 PRECEDING AND 5 FOLLOWING) AS ReputationMovingAvg,
        u.Reputation - LAG(u.Reputation, 1) OVER (ORDER BY u.Reputation DESC) AS RepChangeFromPrev,
        (u.Reputation - LAG(u.Reputation, 1) OVER (ORDER BY u.Reputation DESC)) / NULLIF(LAG(u.Reputation, 1) OVER (ORDER BY u.Reputation DESC), 0) * 100 AS RepGrowthPercent,
        CASE WHEN u.Reputation > (SELECT AVG(Reputation) FROM Users) THEN 1 ELSE 0 END AS AboveAvgReputation,
        CASE WHEN u.Reputation < (SELECT AVG(Reputation) FROM Users) THEN 1 ELSE 0 END AS BelowAvgReputation
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    WHERE u.CreationDate >= TIMESTAMP '2010-01-01 00:00:00'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
UserStats AS (
    SELECT
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.CreationDate,
        ua.PostCount,
        ua.CommentCount,
        ua.BadgeCount,
        ua.VoteCount,
        ua.LastPostDate,
        ua.LastCommentDate,
        ua.LastBadgeDate,
        ua.LastVoteDate,
        ua.UserTier,
        ua.ReputationRank,
        ua.ReputationRankDense,
        ua.ReputationDecile,
        ua.RepChangeFromPrev,
        ua.RepGrowthPercent,
        ua.AboveAvgReputation,
        ua.BelowAvgReputation,
        CASE 
            WHEN ua.PostCount > 0 THEN ua.VoteCount * 1.0 / ua.PostCount 
            ELSE 0 
        END AS VotesPerPost,
        CASE 
            WHEN ua.CommentCount > 0 THEN ua.BadgeCount * 1.0 / ua.CommentCount 
            ELSE 0 
        END AS BadgesPerComment,
        CASE 
            WHEN ua.Reputation > 0 THEN (ua.PostCount + ua.CommentCount) * 1.0 / ua.Reputation 
            ELSE 0 
        END AS ActivityEfficiency,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.CreationDate)) / 86400 AS INTEGER) AS DaysSinceCreation,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastPostDate)) / 86400 AS INTEGER) AS DaysSinceLastPost,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastCommentDate)) / 86400 AS INTEGER) AS DaysSinceLastComment,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastBadgeDate)) / 86400 AS INTEGER) AS DaysSinceLastBadge,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastVoteDate)) / 86400 AS INTEGER) AS DaysSinceLastVote,
        (ua.PostCount * 3 + ua.CommentCount * 2 + ua.BadgeCount + ua.VoteCount) AS ActivityScore,
        CASE 
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastPostDate)) / 86400 AS INTEGER) <= 30 THEN 1.5
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastPostDate)) / 86400 AS INTEGER) <= 90 THEN 1.2
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastPostDate)) / 86400 AS INTEGER) <= 180 THEN 1.0
            ELSE 0.8
        END AS PostActivityFactor,
        CASE 
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastCommentDate)) / 86400 AS INTEGER) <= 30 THEN 1.5
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastCommentDate)) / 86400 AS INTEGER) <= 90 THEN 1.2
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastCommentDate)) / 86400 AS INTEGER) <= 180 THEN 1.0
            ELSE 0.8
        END AS CommentActivityFactor,
        CASE 
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastBadgeDate)) / 86400 AS INTEGER) <= 30 THEN 1.5
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastBadgeDate)) / 86400 AS INTEGER) <= 90 THEN 1.2
            WHEN CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastBadgeDate)) / 86400 AS INTEGER) <= 180 THEN 1.0
            ELSE 0.8
        END AS BadgeActivityFactor,
        CASE 
            WHEN ua.RepGrowthPercent > 50 THEN 'Rapid Growth'
            WHEN ua.RepGrowthPercent > 10 THEN 'Steady Growth'
            WHEN ua.RepGrowthPercent >= -10 THEN 'Stable'
            WHEN ua.RepGrowthPercent >= -50 THEN 'Minor Decline'
            ELSE 'Significant Decline'
        END AS RepGrowthTrend,
        CASE 
            WHEN (ua.PostCount + ua.CommentCount + ua.BadgeCount + ua.VoteCount) > 100 THEN 'Highly Active'
            WHEN (ua.PostCount + ua.CommentCount + ua.BadgeCount + ua.VoteCount) > 50 THEN 'Active'
            WHEN (ua.PostCount + ua.CommentCount + ua.BadgeCount + ua.VoteCount) > 10 THEN 'Moderate'
            ELSE 'Inactive'
        END AS UserStatus,
        CASE 
            WHEN ua.ReputationRank <= 10 THEN 'Top 10'
            WHEN ua.ReputationRank <= 100 THEN 'Top 100'
            WHEN ua.ReputationRank <= 1000 THEN 'Top 1000'
            ELSE 'Below Top 1000'
        END AS ReputationPlacement,
        CASE 
            WHEN ua.Reputation >= 25000 AND ua.PostCount >= 200 THEN 'Elite Contributor'
            WHEN ua.Reputation >= 15000 AND ua.PostCount >= 100 THEN 'Veteran Contributor'
            WHEN ua.Reputation <= 1000 AND ua.PostCount <= 10 THEN 'New Contributor'
            ELSE 'Regular Contributor'
        END AS ContributorStatus,
        GREATEST(
            NULLIF(CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastPostDate)) / 86400 AS INTEGER), -1),
            NULLIF(CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastCommentDate)) / 86400 AS INTEGER), -1),
            NULLIF(CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastBadgeDate)) / 86400 AS INTEGER), -1),
            NULLIF(CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ua.LastVoteDate)) / 86400 AS INTEGER), -1)
        ) AS DaysSinceLastActivity
    FROM UserActivity ua
    WHERE ua.PostCount + ua.CommentCount + ua.BadgeCount + ua.VoteCount > 0
),
TagAnalysis AS (
    SELECT 
        t.Id AS TagId,
        t.TagName,
        t.Count AS TagCount,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        CASE 
            WHEN t.TagName ILIKE 'c++' OR t.TagName ILIKE 'c#' OR t.TagName ILIKE 'javascript' THEN 'Popular Language'
            WHEN t.TagName LIKE '%-%' OR t.TagName LIKE '%.%' THEN 'Technical Concept'
            WHEN t.TagName ILIKE '%sql%' THEN 'Database Related'
            ELSE 'General'
        END AS TagCategory,
        LN(t.Count + 1) * CASE 
            WHEN t.IsRequired = 1 THEN 2 
            WHEN t.IsModeratorOnly = 1 THEN 1.5 
            ELSE 1 
        END AS TagWeight,
        CONCAT(UPPER(SUBSTRING(t.TagName FROM 1 FOR 1)), LOWER(SUBSTRING(t.TagName FROM 2))) AS FormattedTagName,
        CASE 
            WHEN t.Count > (SELECT AVG("Count") FROM Tags) * 2 THEN 'Featured'
            WHEN t.Count > (SELECT AVG("Count") FROM Tags) THEN 'Popular'
            ELSE 'Standard'
        END AS TagPopularity,
        t.Count * 1.0 / NULLIF((SELECT MAX("Count") FROM Tags), 0) AS CountRatioToTop,
        (SELECT COUNT(*) FROM Posts p WHERE p.Tags LIKE '%' || t.TagName || '%') AS TagActivityScore
    FROM Tags t
    WHERE t.TagName IS NOT NULL AND t.TagName <> ''
),
PostCategoryAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        (CASE WHEN POSITION('c++' IN p.Tags) > 0 THEN 1 ELSE 0 END) +
        (CASE WHEN POSITION('python' IN p.Tags) > 0 THEN 1 ELSE 0 END) +
        (CASE WHEN POSITION('java' IN p.Tags) > 0 THEN 1 ELSE 0 END) +
        (CASE WHEN POSITION('javascript' IN p.Tags) > 0 THEN 1 ELSE 0 END) +
        (CASE WHEN POSITION('sql' IN p.Tags) > 0 THEN 1 ELSE 0 END) AS LanguageTagCount,
        CASE 
            WHEN p.Score > 0 AND p.ViewCount > 1000 THEN 'High Engagement'
            WHEN p.Score > 0 AND p.ViewCount > 500 THEN 'Medium Engagement'
            WHEN p.Score <= 0 AND p.ViewCount > 1000 THEN 'High Views, Low Score'
            ELSE 'Low Engagement'
        END AS PostEngagementLevel,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400 AS INTEGER) AS PostAgeInDays,
        CASE 
            WHEN EXTRACT(YEAR FROM p.CreationDate) >= 2020 THEN 'Recent'
            WHEN EXTRACT(YEAR FROM p.CreationDate) >= 2015 THEN 'Mid'
            ELSE 'Old'
        END AS PostAgeCategory,
        (p.Score * 2 + p.ViewCount * 0.1 + COALESCE(p.CommentCount, 0) * 5) AS EngagementScore,
        CASE 
            WHEN CHAR_LENGTH(p.Tags) > 5 THEN CHAR_LENGTH(p.Tags) - 2 ELSE 0 END AS TagCountNormalized,
        CASE 
            WHEN p.Tags LIKE '%[c++]%' THEN 'c++'
            WHEN p.Tags LIKE '%[python]%' THEN 'python'
            WHEN p.Tags LIKE '%[java]%' THEN 'java'
            WHEN p.Tags LIKE '%[javascript]%' THEN 'javascript'
            WHEN p.Tags LIKE '%[sql]%' THEN 'sql'
            ELSE NULL
        END AS PrimaryLanguage,
        COALESCE(
            (SELECT COUNT(*) 
             FROM Comments c 
             WHERE c.PostId = p.Id 
               AND c.CreationDate > (p.CreationDate - INTERVAL '7 days')
            ), 
            0
        ) AS RecentCommentsInWeek
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
      AND p.CreationDate >= TIMESTAMP '2019-01-01 00:00:00'
      AND (p.Score IS NULL OR p.Score >= -5)
),
CombinedResults AS (
    SELECT 
        'User Metrics' AS Section,
        COUNT(*) AS RecordCount,
        NULL::integer AS UserId,
        NULL::text AS DisplayName,
        NULL::numeric AS Reputation,
        NULL::integer AS PostCount,
        NULL::integer AS CommentCount,
        NULL::integer AS BadgeCount,
        NULL::integer AS VoteCount,
        NULL::text AS UserTier,
        NULL::numeric AS ActivityScore,
        NULL::text AS UserStatus,
        NULL::text AS RepGrowthTrend,
        NULL::text AS ContributorStatus
    FROM UserStats
    UNION ALL
    SELECT 
        'Tag Metrics' AS Section,
        COUNT(*) AS RecordCount,
        NULL::integer,
        NULL::text,
        NULL::numeric,
        NULL::integer,
        NULL::integer,
        NULL::integer,
        NULL::integer,
        NULL::text,
        NULL::numeric,
        NULL::text,
        NULL::text,
        NULL::text
    FROM TagAnalysis
    UNION ALL
    SELECT 
        'Post Metrics' AS Section,
        COUNT(*) AS RecordCount,
        NULL::integer,
        NULL::text,
        NULL::numeric,
        NULL::integer,
        NULL::integer,
        NULL::integer,
        NULL::integer,
        NULL::text,
        NULL::numeric,
        NULL::text,
        NULL::text,
        NULL::text
    FROM PostCategoryAnalysis
),
PostWithTags AS (
    SELECT 
        pca.PostId,
        pca.PostTypeId,
        pca.OwnerUserId,
        pca.CreationDate,
        pca.Score,
        pca.ViewCount,
        pca.Title,
        pca.Tags,
        pca.LanguageTagCount,
        pca.PostEngagementLevel,
        pca.PostAgeInDays,
        pca.PostAgeCategory,
        pca.EngagementScore,
        pca.TagCountNormalized,
        pca.PrimaryLanguage,
        pca.RecentCommentsInWeek
    FROM PostCategoryAnalysis pca
    WHERE pca.PostTypeId = 1
),
ComplexUserSummary AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        CASE 
            WHEN (SELECT COUNT(*) FROM Votes v WHERE v.UserId = u.Id AND v.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')) > 100
                 THEN 1 ELSE 0 END AS ActiveInLastYear,
        (SELECT t.TagName FROM Tags t WHERE t.Count = (SELECT MAX("Count") FROM Tags) LIMIT 1) AS MostPopularTag,
        CASE 
            WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 50 THEN 'Question Expert'
            WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 10 THEN 'Question Contributor'
            ELSE 'Novice Questioner'
        END AS QuestioningStyle,
        AVG(CAST(p.Score AS DOUBLE PRECISION)) OVER (PARTITION BY p.OwnerUserId) AS AvgUserScore,
        FIRST_VALUE(p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS FirstPostDate,
        LAST_VALUE(p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS LatestPostDate,
        (SELECT COUNT(*) FROM Users u2 WHERE u2.Reputation > u.Reputation) + 1 AS RankAmongUsers,
        TRIM(CONCAT(u.DisplayName, ' (', 
            CASE WHEN u.AverageScore > 100 THEN 'Active' ELSE 'Regular' END, 
            ')')) AS UserDisplayNameWithStatus
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= TIMESTAMP '2015-01-01 00:00:00'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.AverageScore
),
FinalAggregation AS (
    SELECT 
        cs.UserId,
        cs.DisplayName,
        cs.Reputation,
        cs.CreationDate,
        cs.ActiveInLastYear,
        cs.MostPopularTag,
        cs.QuestioningStyle,
        cs.AvgUserScore,
        cs.FirstPostDate,
        cs.LatestPostDate,
        cs.RankAmongUsers,
        cs.UserDisplayNameWithStatus,
        ps.Id AS PostId,
        ps.PostTypeId,
        ps.CreationDate AS PostCreationDate,
        ps.Score,
        ps.ViewCount,
        ps.Title,
        ps.Tags,
        ps.LanguageTagCount,
        ps.PostEngagementLevel,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ps.CreationDate)) / 86400 AS INTEGER) AS PostAgeInDays,
        CASE 
            WHEN EXTRACT(YEAR FROM ps.CreationDate) >= 2020 THEN 'Recent'
            WHEN EXTRACT(YEAR FROM ps.CreationDate) >= 2015 THEN 'Mid'
            ELSE 'Old'
        END AS PostAgeCategory,
        (ps.Score * 2 + ps.ViewCount * 0.1 + COALESCE(ps.commentcount, 0) * 5) AS EngagementScore,
        CASE 
            WHEN CHAR_LENGTH(ps.Tags) > 5 THEN CHAR_LENGTH(ps.Tags) - 2 ELSE 0 END AS TagCountNormalized,
        CASE 
            WHEN ps.Tags LIKE '%[c++]%' THEN 'c++'
            WHEN ps.Tags LIKE '%[python]%' THEN 'python'
            WHEN ps.Tags LIKE '%[java]%' THEN 'java'
            WHEN ps.Tags LIKE '%[javascript]%' THEN 'javascript'
            WHEN ps.Tags LIKE '%[sql]%' THEN 'sql'
            ELSE NULL
        END AS PrimaryLanguage,
        COALESCE(
            (SELECT COUNT(*) 
             FROM Comments c 
             WHERE c.PostId = ps.Id 
               AND c.CreationDate > (ps.CreationDate - INTERVAL '7 days')
            ), 
            0
        ) AS RecentCommentsInWeek,
        (cs.Reputation / NULLIF(cs.AvgUserScore, 0)) * (ps.Score * 2 + ps.ViewCount * 0.1 + COALESCE(ps.commentcount, 0) * 5) AS ReputationAdjustedEngagementScore,
        CASE 
            WHEN ps.Title ILIKE '%problem%' OR ps.Title ILIKE '%issue%' OR ps.Title ILIKE '%question%' THEN 'Problem Focused'
            WHEN ps.Title ILIKE '%solution%' OR ps.Title ILIKE '%answer%' THEN 'Solution Focused'
            ELSE 'Neutral Focus'
        END AS TitleFocus,
        CASE 
            WHEN ps.PostTypeId = 1 AND ps.Score >= 10 AND CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ps.CreationDate)) / 86400 AS INTEGER) <= 30 THEN 1
            WHEN ps.PostTypeId = 1 AND ps.ViewCount >= 500 THEN 1
            ELSE 0
        END AS HighValueQuestion,
        CASE 
            WHEN ps.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days') THEN 'Newly Published'
            WHEN ps.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '90 days') THEN 'Recently Updated'
            WHEN ps.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '365 days') THEN 'Active Content'
            ELSE 'Historical Content'
        END AS PostPublishStatus,
        CASE 
            WHEN (ps.LanguageTagCount > 2 AND ps.Tags LIKE '%[c++]%') OR ps.Tags LIKE '%[python]%' THEN 'Multi-Language Code'
            WHEN ps.Tags LIKE '%[sql]%' AND ps.Score > 0 THEN 'SQL Focused'
            ELSE 'General Inquiry'
        END AS PostCategoryClassification,
        COUNT(*) OVER (PARTITION BY cs.UserId, 
            CASE 
                WHEN ps.Tags LIKE '%[c++]%' THEN 'c++'
                WHEN ps.Tags LIKE '%[python]%' THEN 'python'
                WHEN ps.Tags LIKE '%[java]%' THEN 'java'
                WHEN ps.Tags LIKE '%[javascript]%' THEN 'javascript'
                WHEN ps.Tags LIKE '%[sql]%' THEN 'sql'
                ELSE NULL
            END
        ) AS UserLanguagePostCount
    FROM ComplexUserSummary cs
    INNER JOIN Posts ps ON cs.UserId = ps.OwnerUserId
    WHERE ps.PostTypeId = 1 
      AND ps.CreationDate >= TIMESTAMP '2019-01-01 00:00:00'
      AND ps.Title IS NOT NULL
),
CombinedData AS (
    SELECT 
        f.UserId,
        f.DisplayName,
        f.Reputation,
        f.CreationDate,
        f.ActiveInLastYear,
        f.MostPopularTag,
        f.QuestioningStyle,
        f.AvgUserScore,
        f.FirstPostDate,
        f.LatestPostDate,
        f.RankAmongUsers,
        f.UserDisplayNameWithStatus,
        f.PostId,
        f.PostTypeId,
        f.PostCreationDate,
        f.Score,
        f.ViewCount,
        f.Title,
        f.Tags,
        f.LanguageTagCount,
        f.PostEngagementLevel,
        f.PostAgeInDays,
        f.PostAgeCategory,
        f.EngagementScore,
        f.TagCountNormalized,
        f.PrimaryLanguage,
        f.RecentCommentsInWeek,
        f.ReputationAdjustedEngagementScore,
        f.TitleFocus,
        f.HighValueQuestion,
        f.PostPublishStatus,
        f.PostCategoryClassification,
        f.UserLanguagePostCount
    FROM FinalAggregation f
    WHERE f.Reputation > 1000
      AND f.PostAgeInDays <= 365
),
AggregatedMetrics AS (
    SELECT 
        COUNT(*) AS TotalRecords,
        MAX(Reputation) AS MaxReputation,
        MIN(Reputation) AS MinReputation,
        AVG(Reputation) AS AvgReputation,
        SUM(Score) AS TotalScore,
        MAX(CreationDate) AS LatestUserCreationDate,
        MIN(LatestPostDate) AS EarliestLatestPost,
        COUNT(DISTINCT UserId) AS UniqueUsers,
        SUM(EngagementScore) AS TotalEngagementScore,
        COUNT(DISTINCT PostId) AS UniqueQuestions
    FROM CombinedData
)
SELECT 
    'Performance Benchmark Query Output' AS QueryType,
    (SELECT TotalRecords FROM AggregatedMetrics) AS TotalRecords,
    (SELECT MaxReputation FROM AggregatedMetrics) AS MaxReputation,
    (SELECT MinReputation FROM AggregatedMetrics) AS MinReputation,
    (SELECT AvgReputation FROM AggregatedMetrics) AS AvgReputation,
    (SELECT TotalScore FROM AggregatedMetrics) AS TotalScore,
    (SELECT LatestUserCreationDate FROM AggregatedMetrics) AS LatestUserCreationDate,
    (SELECT EarliestLatestPost FROM AggregatedMetrics) AS EarliestLatestPost,
    (SELECT UniqueUsers FROM AggregatedMetrics) AS UniqueUsers,
    (SELECT TotalEngagementScore FROM AggregatedMetrics) AS TotalEngagementScore,
    (SELECT UniqueQuestions FROM AggregatedMetrics) AS UniqueQuestions,
    (SELECT AVG(Reputation) FROM CombinedData WHERE Reputation > (SELECT AVG(Reputation) FROM CombinedData)) AS AboveAverageReputation,
    (SELECT COUNT(*) FROM (
        SELECT UserId FROM CombinedData WHERE HighValueQuestion = 1
        UNION 
        SELECT UserId FROM CombinedData WHERE PostCategoryClassification = 'Multi-Language Code'
        UNION 
        SELECT UserId FROM CombinedData WHERE ActiveInLastYear = 1
    ) AS MultiCriteriaResults) AS MultiCriteriaResultsCount,
    (SELECT Reputation FROM CombinedData ORDER BY Reputation DESC LIMIT 1) AS TopIndividualReputation,
    (SELECT STRING_AGG(DISTINCT PostCategoryClassification, ', ') 
     FROM CombinedData 
     WHERE PostTypeId = 1
    ) AS DistinctPostCategories,
    CASE 
        WHEN EXISTS (
            SELECT 1 FROM CombinedData cd 
            WHERE cd.Reputation > (SELECT AVG(Reputation) FROM Users) 
            AND cd.HighValueQuestion = 1
        ) THEN 'High Value Community Exists'
        ELSE 'No High Value Community'
    END AS CommunityQualityIndicator,
    (SELECT COUNT(*) FROM (
        SELECT cd.UserId, COUNT(cd.PostId) AS PostCount
        FROM CombinedData cd 
        WHERE cd.PostAgeInDays <= 30
        GROUP BY cd.UserId 
        HAVING COUNT(cd.PostId) > 5
    ) AS RecentActiveUsers) AS RecentHighlyActiveUsers
FROM CombinedData
WHERE 
    EXISTS (
        SELECT 1 FROM Posts p 
        WHERE p.Id = CombinedData.PostId 
        AND p.CreationDate >= TIMESTAMP '2019-01-01 00:00:00'
    )
    AND (CombinedData.Reputation > 500 OR CombinedData.Score > 20)
    AND CombinedData.PostAgeInDays <= 365
    AND CombinedData.PrimaryLanguage IS NOT NULL
ORDER BY 
    CombinedData.Reputation DESC,
    CombinedData.EngagementScore DESC
OFFSET 0 ROWS FETCH NEXT 1000 ROWS ONLY;