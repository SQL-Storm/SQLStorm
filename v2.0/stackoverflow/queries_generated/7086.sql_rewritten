        WHEN fa.Score > (SELECT AVG(Score) FROM FinalAnalysis) * 0.9 THEN 'Near Avg Score'
        WHEN fa.Score > (SELECT AVG(Score) FROM FinalAnalysis) * 0.8 THEN 'Below Avg Score'
        ELSE 'Significantly Below Avg'
    END as ScoreStatus,
    CASE 
        WHEN fa.Reputation > 10000 THEN 'Elite Contributor'
        WHEN fa.Reputation > 5000 THEN 'Veteran Contributor'
        WHEN fa.Reputation > 1000 THEN 'Active Contributor'
        ELSE 'Regular Contributor'
    END as ContributorType,
    DATEDIFF(day, fa.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) as DaysSincePost,
    CASE 
        WHEN fa.TagFocusArea LIKE '%Programming%' THEN 1
        WHEN fa.TagFocusArea LIKE '%Database%' THEN 1
        WHEN fa.TagFocusArea LIKE '%Web%' THEN 1
        ELSE 0
    END as TechFocus,
    ISNULL(
        (
            SELECT COUNT(*)
            FROM Posts p
            WHERE p.OwnerUserId = fa.UserId AND p.PostTypeId = 1
        ), 0
    ) as UserQuestions,
    ISNULL(
        (
            SELECT COUNT(*)
            FROM Posts p
            WHERE p.OwnerUserId = fa.UserId AND p.PostTypeId = 2
        ), 0
    ) as UserAnswers,
    (
        SELECT COUNT(*) 
        FROM Votes v
        INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
        WHERE v.PostId = fa.PostId AND vt.Name = 'UpMod'
    ) as UpvotesForPost,
    (
        SELECT COUNT(*) 
        FROM Votes v
        INNER JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
        WHERE v.PostId = fa.PostId AND vt.Name = 'DownMod'
    ) as DownvotesForPost
FROM FinalAnalysis fa
WHERE fa.Score > 0 
    AND fa.ViewCount > 50 
    AND fa.Answers > 0 
    AND fa.Comments > 0
ORDER BY fa.Score DESC, fa.Reputation DESC, fa.Views DESC
OFFSET 100 ROWS 
