WITH
-- recent top users by reputation and activity
TopUsers AS (
  SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.Location,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.LastAccessDate DESC) AS rn
  FROM Users u
  WHERE u.Reputation > 1000
),
-- aggregate post activity per user with computed fields
UserActivity AS (
  SELECT
    p.OwnerUserId AS UserId,
    COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
    COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
    SUM(p.ViewCount) AS TotalViews,
    SUM(p.Score) AS ScoreSum,
    MAX(p.LastActivityDate) AS LastActive
  FROM Posts p
  GROUP BY p.OwnerUserId
),
-- correlate with badges and tag-based influence
BadgeInfluence AS (
  SELECT
    b.UserId,
    COUNT(*) AS BadgeCount,
    SUM(CASE WHEN b.TagBased = TRUE OR b.TagBased = 1 THEN 1 ELSE 0 END) AS TagBadges
  FROM Badges b
  GROUP BY b.UserId
),
-- a correlated subquery to fetch latest 5 edits per user using PostHistory
LatestEdits AS (
  SELECT
    ph.UserId,
    ph.PostId,
    ph.CreationDate,
    ph.PostHistoryTypeId,
    ph.Comment,
    ROW_NUMBER() OVER (PARTITION BY ph.UserId ORDER BY ph.CreationDate DESC) AS rn
  FROM PostHistory ph
  WHERE ph.PostHistoryTypeId IN (4,5,6,10,11) -- edits and close/reopen events
)
SELECT
  tu.Id AS UserId,
  tu.DisplayName,
  tu.Reputation,
  tu.LastAccessDate,
  COALESCE(ua.QuestionCount, 0) AS QuestionCount,
  COALESCE(ua.AnswerCount, 0) AS AnswerCount,
  COALESCE(ua.TotalViews, 0) AS TotalViews,
  COALESCE(ua.ScoreSum, 0) AS ScoreSum,
  COALESCE(bu.BadgeCount, 0) AS BadgeCount,
  COALESCE(bu.TagBadges, 0) AS TagBadges,
  la.LastActive AS LastEditActiveDate,
  -- aggregate recent edited post ids (dialect-friendly: use ARRAY_AGG where supported)
  ARRAY_AGG(CASE WHEN le.PostHistoryTypeId IN (4,5) THEN le.PostId END) FILTER (WHERE le.rn = 1) AS RecentlyEditedPostIds,
  -- explicit NULL-safe string expression combining user data (use CONCAT_WS where supported)
  CONCAT_WS(' | ',
    COALESCE(tu.DisplayName, 'Unknown'),
    TO_CHAR(tu.LastAccessDate, 'YYYY-MM-DD"T"HH24:MI:SS"Z"'),
    COALESCE(NULLIF(tu.Location, ''), 'NoLocation')
  ) AS Hints
FROM TopUsers tu
LEFT JOIN UserActivity ua ON ua.UserId = tu.Id
LEFT JOIN BadgeInfluence bu ON bu.UserId = tu.Id
LEFT JOIN LatestEdits le ON le.UserId = tu.Id AND le.rn = 1
LEFT JOIN (
  SELECT ph.UserId, MAX(ph.CreationDate) AS LastActive
  FROM PostHistory ph
  WHERE ph.PostHistoryTypeId IN (10,11)
  GROUP BY ph.UserId
) la ON la.UserId = tu.Id
WHERE tu.rn <= 200
GROUP BY
  tu.Id,
  tu.DisplayName,
  tu.Reputation,
  tu.LastAccessDate,
  ua.QuestionCount,
  ua.AnswerCount,
  ua.TotalViews,
  ua.ScoreSum,
  bu.BadgeCount,
  bu.TagBadges,
  la.LastActive,
  tu.Location,
  tu.CreationDate,
  tu.rn
ORDER BY tu.Reputation DESC, tu.LastAccessDate DESC;