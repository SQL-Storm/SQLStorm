-- {"query": "7527.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 3111} 
WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        MAX(p.CreationDate) as LastPostDate,
        MAX(c.CreationDate) as LastCommentDate,
        MAX(b.Date) as LastBadgeDate,
        COALESCE(SUM(p.Score), 0) as TotalScore,
        COALESCE(SUM(p.ViewCount), 0) as TotalViews,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN COALESCE(SUM(p.Score), 0) / COUNT(DISTINCT p.Id)
            ELSE 0 
        END as AvgScorePerPost,
        STRING_AGG(DISTINCT t.TagName, ', ') as TagPreferences
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Posts p2 ON p.Id = p2.ParentId
    LEFT JOIN (
        SELECT DISTINCT PostId, TagName
        FROM Posts p3
        CROSS JOIN UNNEST(STRING_TO_ARRAY(p3.Tags, '>') FILTER (x -> x != '')) AS TagName 
        WHERE p3.PostTypeId = 1
    ) t ON p.Id = t.PostId
    WHERE u.Id > 0
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
TopUsers AS (
    SELECT 
        *,
        ROW_NUMBER() OVER (ORDER BY TotalScore DESC, Reputation DESC) as RankByScore,
        ROW_NUMBER() OVER (ORDER BY Reputation DESC, TotalScore DESC) as RankByReputation,
        RANK() OVER (ORDER BY AvgScorePerPost DESC) as RankByAvgScore,
        DENSE_RANK() OVER (ORDER BY PostCount DESC) as RankByPostCount
    FROM UserStats
),
UserActivity AS (
    SELECT 
        u.Id as UserId,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (1, 2, 3) THEN ph.Id END) as EditCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13) THEN ph.Id END) as ModerationCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (24, 35, 36) THEN ph.Id END) as SuggestedEditCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (52, 53) THEN ph.Id END) as HotQuestionCount,
        SUM(CASE 
            WHEN ph.PostHistoryTypeId = 10 THEN 1 
            WHEN ph.PostHistoryTypeId = 11 THEN 1 
            WHEN ph.PostHistoryTypeId = 12 THEN 1 
            WHEN ph.PostHistoryTypeId = 13 THEN 1 
            ELSE 0 
        END) as ClosedPostCount,
        COUNT(DISTINCT ph.PostId) as PostIdsEdited,
        STRING_AGG(DISTINCT CASE 
            WHEN ph.PostHistoryTypeId IN (1, 2, 3) THEN 'Edit'
            WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13) THEN 'Moderation'
            WHEN ph.PostHistoryTypeId IN (24, 35, 36) THEN 'Suggested Edit'
            WHEN ph.PostHistoryTypeId IN (52, 53) THEN 'Hot Question'
            ELSE 'Other'
        END, ', ') as ActivityTypes
    FROM Users u
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId
    WHERE u.Id > 0
    GROUP BY u.Id
),
QuestionStats AS (
    SELECT 
        p2.ParentId as QuestionId,
        COUNT(p3.Id) as AnswerCount,
        MAX(p3.Score) as MaxAnswerScore,
        AVG(p3.Score) as AvgAnswerScore,
        COUNT(DISTINCT p3.OwnerUserId) as Answerers,
        STRING_AGG(DISTINCT p3.OwnerUserId::text, ', ') as AnswerUserIds,
        MAX(p3.CreationDate) as LatestAnswerDate,
        COUNT(DISTINCT p3.ParentId) as AnswerCount2,
        COUNT(DISTINCT CASE WHEN p3.Score > 0 THEN p3.Id END) as PositiveScoreAnswers
    FROM Posts p2
    LEFT JOIN Posts p3 ON p2.Id = p3.ParentId AND p3.PostTypeId = 2
    WHERE p2.PostTypeId = 1 AND p2.ParentId IS NULL
    GROUP BY p2.ParentId
),
PostEngagement AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CommentCount,
        p.FavoriteCount,
        p.CreationDate,
        p.OwnerUserId,
        COALESCE(p2.AnswerCount, 0) as AnswerCount,
        COALESCE(p2.MaxAnswerScore, 0) as MaxAnswerScore,
        COALESCE(p2.AvgAnswerScore, 0) as AvgAnswerScore,
        CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END as HasAcceptedAnswer,
        COALESCE(p2.Answerers, 0) as Answerers,
        CASE WHEN p.Score > 0 THEN p.Score ELSE 0 END as PositiveScore,
        CASE WHEN p.ViewCount > 0 THEN (p.Score * 100.0 / p.ViewCount) ELSE 0 END as ScorePerView,
        CASE WHEN p.CommentCount > 0 THEN (p.Score * 100.0 / p.CommentCount) ELSE 0 END as ScorePerComment,
        DATEDIFF('day', p.CreationDate, COALESCE(p.LastActivityDate, p.CreationDate)) as DaysSinceCreation,
        CASE 
            WHEN DATEDIFF('day', p.CreationDate, COALESCE(p.LastActivityDate, p.CreationDate)) > 30 
            THEN 'Long-Lived' 
            WHEN DATEDIFF('day', p.CreationDate, COALESCE(p.LastActivityDate, p.CreationDate)) > 7 
            THEN 'Active' 
            ELSE 'Recent' 
        END as ActivityStatus
    FROM Posts p
    LEFT JOIN QuestionStats p2 ON p.Id = p2.QuestionId
    WHERE p.PostTypeId IN (1, 2)
),
RecentActivity AS (
    SELECT 
        p.Id,
        p.OwnerUserId as UserId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CommentCount,
        p.LastActivityDate,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END as PostType,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.LastActivityDate DESC) as RecentActivityRank
    FROM Posts p
    WHERE p.LastActivityDate >= DATEADD('day', -7, cast('2024-10-01 12:34:56' as timestamp)) 
),
TopAnswers AS (
    SELECT 
        p.Id,
        p.OwnerUserId,
        p.ParentId,
        p.Title,
        p.Score,
        p.CreationDate,
        p.Body,
        RANK() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC, p.CreationDate ASC) as RankByScore
    FROM Posts p
    WHERE p.PostTypeId = 2 AND p.Score > 0
),
QuestionTagStats AS (
    SELECT 
        p.Id as QuestionId,
        p.Title,
        p.Tags,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        STRING_TO_ARRAY(p.Tags, '>') FILTER (x -> x != '') as TagArray,
        LENGTH(p.Tags) as TagLength
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
),
CombinedStats AS (
    SELECT 
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.PostCount,
        tu.CommentCount,
        tu.BadgeCount,
        tu.TotalScore,
        tu.AvgScorePerPost,
        tu.LastPostDate,
        tu.LastCommentDate,
        tu.LastBadgeDate,
        ua.EditCount,
        ua.ModerationCount,
        ua.SuggestedEditCount,
        ua.HotQuestionCount,
        ua.ClosedPostCount,
        CASE 
            WHEN tu.PostCount > 0 AND tu.CommentCount > 0 
            THEN (tu.PostCount * 100.0 / (tu.PostCount + tu.CommentCount)) 
            ELSE 0 
        END as PostToCommentRatio,
        CASE 
            WHEN tu.BadgeCount > 0 AND tu.Reputation > 0 
            THEN ((tu.BadgeCount * 1.0) / tu.Reputation) 
            ELSE 0 
        END as BadgeToReputationRatio,
        CASE 
            WHEN tu.AvgScorePerPost > 0 
            THEN (tu.TotalScore * 100.0 / tu.AvgScorePerPost) 
            ELSE 0 
        END as ScoreEfficiency
    FROM TopUsers tu
    LEFT JOIN UserActivity ua ON tu.UserId = ua.UserId
    WHERE tu.PostCount > 0
),
TagAnalysis AS (
    SELECT 
        CAST(REGEXP_REPLACE(tag, '[^a-zA-Z0-9]', '') AS VARCHAR(35)) as CleanTag,
        COUNT(*) as TagCount,
        AVG(p.Score) as AvgScore,
        AVG(p.ViewCount) as AvgViews,
        MAX(p.ViewCount) as MaxViews,
        MIN(p.Score) as MinScore,
        STRING_AGG(DISTINCT u.DisplayName, ', ') as TagUsers,
        STRING_AGG(DISTINCT CASE WHEN p.OwnerUserId IS NOT NULL THEN p.OwnerUserId::VARCHAR ELSE 'N/A' END, ', ') as OwnerIds
    FROM QuestionTagStats qts
    CROSS JOIN UNNEST(qts.TagArray) as tag
    LEFT JOIN Posts p ON p.Id = qts.QuestionId
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE tag IS NOT NULL AND tag != ''
    GROUP BY REGEXP_REPLACE(tag, '[^a-zA-Z0-9]', '')
),
TagRankings AS (
    SELECT 
        *,
        RANK() OVER (ORDER BY AvgScore DESC) as ScoreRank,
        RANK() OVER (ORDER BY AvgViews DESC) as ViewsRank,
        ROW_NUMBER() OVER (ORDER BY TagCount DESC) as PopularityRank
    FROM TagAnalysis
)
SELECT 
    cs.UserId,
    cs.DisplayName,
    cs.Reputation,
    cs.PostCount,
    cs.CommentCount,
    cs.BadgeCount,
    cs.TotalScore,
    cs.AvgScorePerPost,
    cs.EditCount,
    cs.ModerationCount,
    cs.LastPostDate,
    cs.LastCommentDate,
    CASE 
        WHEN (cs.PostCount + cs.CommentCount) > 0 
        THEN ROUND(100.0 * cs.PostCount / (cs.PostCount + cs.CommentCount), 2) 
        ELSE 0 
    END as PostPercentage,
    CASE 
        WHEN cs.BadgeCount > 0 
        THEN ROUND(100.0 * cs.BadgeCount / cs.Reputation, 2) 
        ELSE 0 
    END as BadgeReputationRatio,
    CASE 
        WHEN cs.EditCount > 0 
        THEN ROUND(100.0 * cs.SuggestedEditCount / cs.EditCount, 2) 
        ELSE 0 
    END as SuggestedEditPercentage,
    CASE 
        WHEN cs.TotalScore > 0 
        THEN ROUND(100.0 * cs.HotQuestionCount / cs.TotalScore, 2) 
        ELSE 0 
    END as HotQuestionToScoreRatio,
    STRING_AGG(DISTINCT CASE 
        WHEN cs.EditCount > 0 THEN 'Editor'
        WHEN cs.ModerationCount > 0 THEN 'Moderator'
        WHEN cs.SuggestedEditCount > 0 THEN 'Suggested Editor'
        ELSE 'Standard'
    END, ', ') as UserType,
    STRING_AGG(DISTINCT CASE 
        WHEN cs.PostCount > 10 THEN 'High Poster'
        WHEN cs.PostCount > 5 THEN 'Medium Poster' 
        WHEN cs.PostCount > 0 THEN 'Low Poster'
        ELSE 'No Posts'
    END, ', ') as PostingLevel,
    (
        SELECT 
            STRING_AGG(
                CASE 
                    WHEN p.PostType = 'Question' THEN 'Q' 
                    WHEN p.PostType = 'Answer' THEN 'A'
                    ELSE '?'
                END, 
                ''
            )
        FROM RecentActivity p
        WHERE p.UserId = cs.UserId AND p.RecentActivityRank <= 5
    ) as RecentActivityPattern,
    (
        SELECT 
            COUNT(*) 
        FROM TopAnswers ta 
        WHERE ta.OwnerUserId = cs.UserId AND ta.RankByScore <= 5
    ) as TopAnswerCount,
    (
        SELECT 
            STRING_AGG(
                CASE 
                    WHEN qts.TagLength > 20 THEN 'Long'
                    WHEN qts.TagLength > 10 THEN 'Medium'
                    WHEN qts.TagLength > 0 THEN 'Short'
                    ELSE 'Empty'
                END, 
                ', '
            )
        FROM QuestionTagStats qts
        WHERE qts.QuestionId IN (
            SELECT Id 
            FROM Posts 
            WHERE OwnerUserId = cs.UserId 
            AND ParentId IS NULL
        )
    ) as TagLengthAnalysis
FROM CombinedStats cs
WHERE cs.PostCount >= 10
GROUP BY cs.UserId, cs.DisplayName, cs.Reputation, cs.PostCount, cs.CommentCount, cs.BadgeCount, 
         cs.TotalScore, cs.AvgScorePerPost, cs.EditCount, cs.ModerationCount, cs.LastPostDate, cs.LastCommentDate,
         cs.HotQuestionCount, cs.SuggestedEditCount, cs.ClosedPostCount
HAVING 
    SUM(CASE WHEN cs.EditCount > 0 THEN 1 ELSE 0 END) > 0
    OR SUM(CASE WHEN cs.ModerationCount > 0 THEN 1 ELSE 0 END) > 0
    OR SUM(CASE WHEN cs.HotQuestionCount > 0 THEN 1 ELSE 0 END) > 0
ORDER BY cs.TotalScore DESC, cs.Reputation DESC
LIMIT 100;