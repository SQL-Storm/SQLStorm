SELECT 
    u.DisplayName, 
    COUNT(DISTINCT p.Id) AS TotalPosts, 
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.Reputation) AS MaxReputation,
    MIN(u.CreationDate) AS EarliestUserCreationDate,
    STRING_AGG(DISTINCT b.Name, ', ' ORDER BY b.Date DESC) AS BadgesEarned,
    MAX(v.BountyAmount) AS MaxBountyOffered,
    u.Id,
    u.Reputation,
    u.CreationDate,
    b.Date,
    v.BountyAmount
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId AND v.VoteTypeId = 8
WHERE 
    p.PostTypeId IN (1, 2)
    AND u.Reputation > 100
    AND (u.LastAccessDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days' OR u.LastAccessDate IS NULL)
GROUP BY 
    u.DisplayName,
    u.Id,
    u.Reputation,
    u.CreationDate,
    b.Date,
    v.BountyAmount
HAVING 
    COUNT(DISTINCT p.Id) > 10
ORDER BY 
    MaxReputation DESC, 
    EarliestUserCreationDate ASC
LIMIT 50;