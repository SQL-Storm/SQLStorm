-- {"query": "6802.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 470} 
SELECT 
    u.DisplayName,
    u.Reputation,
    u.Location,
    u.AboutMe,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.PostId ELSE NULL END) AS TotalUpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.PostId ELSE NULL END) AS TotalDownVotes,
    MAX(u.CreationDate) AS LatestAccountActivity,
    AVG(p.Score) AS AvgPostScore,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    (
        SELECT STRING_AGG(TagName, ', ')
        FROM Tags
        WHERE Tags.Id IN (
            SELECT TagId FROM PostTags WHERE PostId IN (
                SELECT Id FROM Posts WHERE OwnerUserId = u.Id
            )
        )
    ) AS PopularTags,
    COUNT(DISTINCT p.PostTypeId) AS DifferentPostTypes,
    MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.CreationDate ELSE NULL END) AS LastClosedDate,
    (
        SELECT COUNT(*)
        FROM (
            SELECT DISTINCT PostId
            FROM PostLinks
            WHERE LinkTypeId = 1
        ) AS linked_posts
    ) AS TotalLinkedPosts
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
WHERE 
    u.Reputation > 1000
    AND u.LastAccessDate >= DATEADD(day, -30, cast('2024-10-01 12:34:56' as timestamp))
GROUP BY 
    u.Id
HAVING 
    COUNT(DISTINCT p.PostTypeId) > 5
ORDER BY 
    TotalPosts DESC, 
    AvgPostScore DESC;