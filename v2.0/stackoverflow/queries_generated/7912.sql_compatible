WITH UserPostStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) as TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) as TotalAnswerScore,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE NULL END) as AvgQuestionScore,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE NULL END) as AvgAnswerScore,
        MAX(p.CreationDate) as LastPostDate,
        COUNT(DISTINCT b.Id) as BadgeCount,
        STRING_AGG(DISTINCT b.Name, ', ') as BadgeNames,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId IN (2,3) THEN v.Id END) as TotalVotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.Id END) as Upvotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.Id END) as Downvotes
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    WHERE u.AccountId IS NOT NULL 
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
RankedUsers AS (
    SELECT UserId, DisplayName, Reputation, TotalPosts, Questions, Answers, TotalQuestionScore, TotalAnswerScore, AvgQuestionScore, AvgAnswerScore, LastPostDate, BadgeCount, BadgeNames, CommentCount, TotalVotes, Upvotes, Downvotes,
        ROW_NUMBER() OVER (ORDER BY TotalPosts DESC, Reputation DESC) as PostRank,
        RANK() OVER (ORDER BY TotalQuestionScore DESC) as QScoreRank,
        DENSE_RANK() OVER (ORDER BY BadgeCount DESC) as BadgeRank,
        NTILE(10) OVER (ORDER BY Reputation DESC) as RepQuartile,
        LAG(Reputation, 1) OVER (ORDER BY Reputation DESC) as PrevReputation,
        LEAD(Reputation, 1) OVER (ORDER BY Reputation DESC) as NextReputation
    FROM UserPostStats
),
TopUsers AS (
    SELECT * FROM RankedUsers WHERE PostRank <= 100
),
QuestionStats AS (
    SELECT 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        u.DisplayName as OwnerName,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Yes' 
            ELSE 'No' 
        END as HasAcceptedAnswer,
        CASE 
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed' 
            ELSE 'Open' 
        END as QuestionStatus,
        COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) as TotalEngagement,
        LAG(p.Score, 1) OVER (ORDER BY p.Score DESC) as PrevScore,
        LEAD(p.Score, 1) OVER (ORDER BY p.Score DESC) as NextScore,
        PERCENT_RANK() OVER (ORDER BY p.Score) * 100 as ScorePercentile,
        ROUND(AVG(p.Score) OVER (PARTITION BY p.OwnerUserId), 2) as OwnerAvgScore,
        CASE 
            WHEN p.ViewCount > 1000 THEN 'High Views'
            WHEN p.ViewCount > 100 THEN 'Medium Views'
            ELSE 'Low Views'
        END as ViewCategory
    FROM Posts p
    JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1
)
SELECT 
    'Performance Benchmark Report' as ReportTitle,
    COUNT(*) as TotalUsers,
    COUNT(DISTINCT CASE WHEN tu.PostRank <= 10 THEN tu.UserId END) as Top10Users,
    AVG(tu.TotalPosts) as AvgPostsPerUser,
    MAX(tu.Reputation) as MaxReputation,
    MIN(tu.Reputation) as MinReputation,
    AVG(tu.Reputation) as AvgReputation,
    COUNT(DISTINCT CASE WHEN p.QuestionStatus IS NOT NULL THEN p.Id END) as TotalQuestions,
    AVG(p.Score) as AvgQuestionScore,
    MAX(p.ViewCount) as MaxViews,
    MIN(p.ViewCount) as MinViews,
    AVG(p.ViewCount) as AvgViews,
    STRING_AGG(DISTINCT CASE WHEN tu.PostRank <= 10 THEN tu.DisplayName END, ', ') as TopUserNames,
    STRING_AGG(DISTINCT CASE WHEN p.Score > 100 THEN p.Title END, '; ') as HighScoredQuestions,
    STRING_AGG(DISTINCT CASE WHEN p.ViewCount > 1000 THEN p.Title END, '; ') as PopularQuestions,
    COUNT(DISTINCT CASE WHEN p.QuestionStatus = 'Open' THEN p.Id END) as OpenQuestions,
    COUNT(DISTINCT CASE WHEN p.QuestionStatus = 'Closed' THEN p.Id END) as ClosedQuestions,
    COUNT(DISTINCT CASE WHEN u.AccountId IS NOT NULL THEN u.Id END) as ActiveUsers,
    COUNT(DISTINCT CASE WHEN u.AccountId IS NULL THEN u.Id END) as InactiveUsers,
    COUNT(*) as TotalReportRows
FROM TopUsers tu
JOIN QuestionStats p ON tu.UserId = p.OwnerUserId
JOIN Users u ON tu.UserId = u.Id
WHERE tu.Reputation > 100 
    AND tu.TotalPosts > 0
    AND (p.Score > 50 OR p.ViewCount > 500 OR p.TotalEngagement > 10)
    AND (p.CreationDate >= CAST('2020-01-01' AS TIMESTAMP) OR p.CreationDate IS NULL)
    AND (tu.LastPostDate >= CAST('2020-01-01' AS TIMESTAMP) OR tu.LastPostDate IS NULL)
    AND (u.CreationDate >= CAST('2010-01-01' AS TIMESTAMP) OR u.CreationDate IS NULL)
    AND (u.LastAccessDate >= CAST('2020-01-01' AS TIMESTAMP) OR u.LastAccessDate IS NULL)
GROUP BY
    tu.UserId,
    tu.DisplayName,
    tu.Reputation,
    tu.TotalPosts,
    tu.Questions,
    tu.Answers,
    tu.TotalQuestionScore,
    tu.TotalAnswerScore,
    tu.AvgQuestionScore,
    tu.AvgAnswerScore,
    tu.LastPostDate,
    tu.BadgeCount,
    tu.BadgeNames,
    tu.CommentCount,
    tu.TotalVotes,
    tu.Upvotes,
    tu.Downvotes,
    tu.PostRank,
    tu.QScoreRank,
    tu.BadgeRank,
    tu.RepQuartile,
    tu.PrevReputation,
    tu.NextReputation,
    p.Id,
    p.Title,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.CreationDate,
    p.OwnerUserId,
    p.Tags,
    p.OwnerName,
    p.HasAcceptedAnswer,
    p.QuestionStatus,
    p.TotalEngagement,
    p.PrevScore,
    p.NextScore,
    p.ScorePercentile,
    p.OwnerAvgScore,
    p.ViewCategory,
    u.Id,
    u.AccountId,
    u.CreationDate,
    u.LastAccessDate;