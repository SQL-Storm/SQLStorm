WITH UserActivityMetrics AS (
    SELECT
        u.Id AS UserId,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        COUNT(DISTINCT c.Id) AS TotalComments,
        SUM(CASE WHEN v.VoteTypeId IN (2, 8, 9, 14, 15, 16) THEN 1 ELSE 0 END) AS TotalPositiveVotesGiven,
        SUM(CASE WHEN v.VoteTypeId IN (3, 4, 10, 12) THEN 1 ELSE 0 END) AS TotalNegativeVotesGiven,
        SUM(CASE WHEN p.PostTypeId IN (1,2) THEN p.Score ELSE 0 END) AS TotalPostScoreReceived,
        MIN(COALESCE(p.CreationDate, c.CreationDate, v.CreationDate)) AS FirstActivityDate,
        MAX(COALESCE(p.CreationDate, c.CreationDate, v.CreationDate)) AS LastActivityDate
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    GROUP BY u.Id
),
UserBadgeCounts AS (
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(b.Id) AS TotalBadges
    FROM Badges b
    GROUP BY b.UserId
),
QuestionEventSummary AS (
    SELECT
        ph.PostId,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS WasClosed,
        MAX(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS WasReopened,
        MIN(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.CreationDate ELSE NULL END) AS ClosedDate,
        MAX(CASE WHEN ph.PostHistoryTypeId = 11 THEN ph.CreationDate ELSE NULL END) AS ReopenedDate
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (10, 11)
    GROUP BY ph.PostId
),
QuestionDetailedMetrics AS (
    SELECT
        q.Id AS QuestionId,
        q.OwnerUserId,
        q.CreationDate AS QuestionCreationDate,
        q.Score AS QuestionScore,
        q.ViewCount AS QuestionViewCount,
        q.AnswerCount AS QuestionAnswerCount,
        q.FavoriteCount AS QuestionFavoriteCount,
        q.LastActivityDate AS QuestionLastActivityDate,
        q.AcceptedAnswerId,
        q.Tags,
        AVG(a.Score) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore,
        SUM(CASE WHEN a.Id IS NOT NULL THEN 1 ELSE 0 END) AS ActualAnswerCount,
        MAX(CASE WHEN qes.WasClosed = 1 AND qes.WasReopened = 1 AND qes.ReopenedDate > qes.ClosedDate THEN 1 ELSE 0 END) AS WasClosedAndReopened,
        (SELECT u2.Reputation FROM Users u2 WHERE u2.Id = (SELECT p2.OwnerUserId FROM Posts p2 WHERE p2.Id = q.AcceptedAnswerId)) AS AcceptedAnswerOwnerReputation
    FROM Posts q
    LEFT JOIN Posts a ON q.Id = a.ParentId AND a.PostTypeId = 2
    LEFT JOIN QuestionEventSummary qes ON q.Id = qes.PostId
    WHERE q.PostTypeId = 1
    GROUP BY q.Id, q.OwnerUserId, q.CreationDate, q.Score, q.ViewCount, q.AnswerCount, q.FavoriteCount, q.LastActivityDate, q.AcceptedAnswerId, q.Tags, qes.WasClosed, qes.WasReopened, qes.ClosedDate, qes.ReopenedDate
),
TagPerformance AS (
    SELECT
        LOWER(TRIM(UNNEST(string_to_array(SUBSTRING(q.Tags FROM 2 FOR LENGTH(q.Tags) - 2), '><')))) AS TagName,
        COUNT(DISTINCT q.Id) AS QuestionCount,
        AVG(q.Score) AS AverageQuestionScore,
        AVG(q.ViewCount) AS AverageQuestionViewCount,
        SUM(q.FavoriteCount) AS TotalTagFavorites
    FROM Posts q
    WHERE q.PostTypeId = 1 AND q.Tags IS NOT NULL AND LENGTH(q.Tags) > 2
    GROUP BY LOWER(TRIM(UNNEST(string_to_array(SUBSTRING(q.Tags FROM 2 FOR LENGTH(q.Tags) - 2), '><'))))
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    u.Location,
    COALESCE(u.WebsiteUrl, 'N/A') AS UserWebsite,
    LENGTH(COALESCE(u.AboutMe, '')) AS AboutMeLength,
    uam.TotalPosts,
    uam.TotalQuestions,
    uam.TotalAnswers,
    uam.TotalComments,
    uam.TotalPositiveVotesGiven,
    uam.TotalNegativeVotesGiven,
    COALESCE(uam.TotalPostScoreReceived, 0) AS TotalPostScoreReceived,
    COALESCE(ubc.GoldBadges, 0) AS GoldBadges,
    COALESCE(ubc.SilverBadges, 0) AS SilverBadges,
    COALESCE(ubc.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(ubc.TotalBadges, 0) AS TotalBadges,
    q.QuestionId,
    q.QuestionCreationDate,
    q.QuestionScore,
    q.QuestionViewCount,
    q.QuestionAnswerCount,
    q.QuestionFavoriteCount,
    q.QuestionLastActivityDate,
    q.AvgAnswerScore,
    q.MaxAnswerScore,
    q.ActualAnswerCount,
    q.AcceptedAnswerOwnerReputation,
    q.WasClosedAndReopened,
    ROW_NUMBER() OVER (PARTITION BY u.Location ORDER BY u.Reputation DESC, COALESCE(uam.TotalPosts, 0) DESC) AS UserRankInLocation,
    AVG(q.QuestionScore) OVER (PARTITION BY u.Id) AS UserAvgQuestionScore,
    LAG(q.QuestionCreationDate, 1, u.CreationDate) OVER (PARTITION BY u.Id ORDER BY q.QuestionCreationDate) AS PreviousQuestionCreationDate,
    (u.Reputation * COALESCE(ubc.TotalBadges, 0) * (COALESCE(uam.TotalQuestions, 0) + COALESCE(uam.TotalAnswers, 0)) / GREATEST(1.0, EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - u.CreationDate)) / (3600.0 * 24 * 365.25))) AS HypotheticalInfluenceScore,
    CASE
        WHEN u.Reputation >= 10000 AND COALESCE(ubc.GoldBadges, 0) >= 3 THEN 'Guru'
        WHEN u.Reputation >= 5000 AND COALESCE(ubc.SilverBadges, 0) >= 5 THEN 'Expert'
        WHEN u.Reputation >= 1000 AND COALESCE(ubc.BronzeBadges, 0) >= 10 THEN 'Contributor'
        ELSE 'Apprentice'
    END AS UserTier,
    UPPER(SUBSTR(COALESCE(u.Location, 'UNKNOWN'), 1, 3)) AS LocationPrefix,
    REPLACE(TRIM(SUBSTRING(q.Tags FROM 2 FOR LENGTH(q.Tags) - 2)), '><', ', ') AS FormattedTags,
    COALESCE(u.ProfileImageUrl, 'https://default.example.com/profile.png') AS ProfileImageOrDefault,
    tp.TagName AS PopularTag,
    tp.QuestionCount AS PopularTagQuestions,
    tp.AverageQuestionScore AS PopularTagAvgScore
FROM Users u
LEFT JOIN UserActivityMetrics uam ON u.Id = uam.UserId
LEFT JOIN UserBadgeCounts ubc ON u.Id = ubc.UserId
LEFT JOIN QuestionDetailedMetrics q ON u.Id = q.OwnerUserId
LEFT JOIN LATERAL (
    SELECT
        tp_inner.TagName,
        tp_inner.QuestionCount,
        tp_inner.AverageQuestionScore
    FROM TagPerformance tp_inner
    WHERE q.Tags LIKE '%' || '<' || tp_inner.TagName || '>' || '%'
    ORDER BY tp_inner.QuestionCount DESC, tp_inner.AverageQuestionScore DESC
    LIMIT 1
) tp ON TRUE
WHERE
    u.Reputation > (SELECT AVG(Reputation) FROM Users) * 1.5
    AND u.LastAccessDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year'
    AND COALESCE(u.WebsiteUrl, '') LIKE 'http%'
    AND COALESCE(uam.TotalPosts, 0) > 50
    AND COALESCE(uam.TotalComments, 0) > 20
    AND (COALESCE(ubc.GoldBadges, 0) > 0 OR COALESCE(ubc.SilverBadges, 0) >= 2)
    AND COALESCE(q.QuestionScore, 0) > 10
    AND COALESCE(q.QuestionViewCount, 0) > 500
    AND COALESCE(q.WasClosedAndReopened, 0) = 1
    AND q.AcceptedAnswerId IS NOT NULL
    AND COALESCE(q.AcceptedAnswerOwnerReputation, 0) > u.Reputation / 2
    AND q.QuestionCreationDate BETWEEN u.CreationDate AND u.LastAccessDate
    AND q.QuestionCreationDate >= COALESCE(uam.FirstActivityDate, u.CreationDate) + INTERVAL '30 days'
    AND q.Tags IS NOT NULL AND q.Tags LIKE '%<sql>%'
    AND POSITION('<python>' IN q.Tags) = 0
    AND LENGTH(COALESCE(q.Title, '')) BETWEEN 30 AND 150
    AND (u.DisplayName IS NOT NULL OR u.EmailHash IS NOT NULL)
ORDER BY
    HypotheticalInfluenceScore DESC,
    u.Reputation DESC,
    u.LastAccessDate DESC
LIMIT 100;