WITH UserEngagement AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        COALESCE(SUM(P.Score), 0) AS TotalPostScore,
        COALESCE(MAX(P.Score), 0) AS MaxPostScore,
        COUNT(DISTINCT C.Id) AS TotalComments,
        MAX(P.LastActivityDate) AS LastPostActivity,
        MIN(P.CreationDate) AS FirstPostDate,
        (SELECT COUNT(B.Id) FROM Badges B WHERE B.UserId = U.Id AND B.Class = 1) AS GoldBadgeCount
    FROM
        Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate
),
PostVersionHistory AS (
    SELECT
        PH.PostId,
        MIN(CASE WHEN PH.PostHistoryTypeId = 2 THEN PH.CreationDate END) AS OriginalBodyDate,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (5, 8) THEN PH.CreationDate END) AS LastBodyEditDate,
        MIN(CASE WHEN PH.PostHistoryTypeId = 10 THEN PH.CreationDate END) AS FirstClosedDate,
        MAX(CASE WHEN PH.PostHistoryTypeId = 11 THEN PH.CreationDate END) AS LastReopenedDate,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (12, 35) THEN PH.CreationDate END) AS LastDeletedOrMigratedDate,
        COUNT(CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN 1 END) AS TotalEdits,
        -- Fallback generic concatenation using LISTAGG/GROUP_CONCAT/LATERAL depending on dialect.
        -- Use GROUP_CONCAT for MySQL, LISTAGG for Oracle/ANSI; here provide a portable form using a derived table + aggregation where supported.
        CASE WHEN SUM(CASE WHEN PH.Comment IS NOT NULL AND PH.Comment <> '' THEN 1 ELSE 0 END) = 0 THEN NULL
             ELSE
                -- Use LISTAGG style; many engines use different function names. Here use COALESCE of GROUP_CONCAT (MySQL) or LISTAGG (ANSI) is not portable,
                -- so implement using XML PATH trick for SQL Server if supported; otherwise replace with appropriate function for your dialect.
                -- Provide a generic implementation using GROUP_CONCAT for engines that support it:
                GROUP_CONCAT(DISTINCT SUBSTRING(PH.Comment, 1, 50) SEPARATOR '; ')
        END AS RecentEditComments
    FROM
        PostHistory PH
    GROUP BY
        PH.PostId
),
QuestionAnswerEngagement AS (
    SELECT
        Q.Id AS QuestionId,
        Q.Title AS QuestionTitle,
        Q.OwnerUserId AS QuestionOwnerId,
        Q.CreationDate AS QuestionCreationDate,
        Q.Score AS QuestionScore,
        Q.ViewCount,
        Q.FavoriteCount,
        Q.Tags,
        A.Id AS AnswerId,
        A.OwnerUserId AS AnswerOwnerId,
        A.CreationDate AS AnswerCreationDate,
        A.Score AS AnswerScore,
        PVH_Q.TotalEdits AS QuestionEditCount,
        PVH_A.TotalEdits AS AnswerEditCount,
        COALESCE(CASE WHEN Q.AcceptedAnswerId = A.Id THEN 1 ELSE 0 END, 0) = 1 AS IsAcceptedAnswer,
        ROW_NUMBER() OVER (PARTITION BY Q.Id ORDER BY A.Score DESC, A.CreationDate ASC) AS Rn_BestAnswer,
        LAG(A.CreationDate) OVER (PARTITION BY Q.Id ORDER BY A.CreationDate ASC) AS PreviousAnswerDate
    FROM
        Posts Q
    LEFT JOIN Posts A ON Q.Id = A.ParentId AND A.PostTypeId = 2
    LEFT JOIN PostVersionHistory PVH_Q ON Q.Id = PVH_Q.PostId
    LEFT JOIN PostVersionHistory PVH_A ON A.Id = PVH_A.PostId
    WHERE
        Q.PostTypeId = 1
),
DetailedPostMetrics AS (
    SELECT
        QAE.QuestionId,
        QAE.QuestionTitle,
        QAE.QuestionOwnerId,
        QAE.QuestionCreationDate,
        QAE.QuestionScore,
        QAE.ViewCount,
        QAE.FavoriteCount,
        QAE.Tags,
        QAE.AnswerId,
        QAE.AnswerOwnerId,
        QAE.AnswerCreationDate,
        QAE.AnswerScore,
        QAE.IsAcceptedAnswer,
        QAE.Rn_BestAnswer,
        QAE.PreviousAnswerDate,
        UE_Q.DisplayName AS QuestionOwnerDisplayName,
        UE_Q.Reputation AS QuestionOwnerReputation,
        UE_Q.UserCreationDate AS QOwnerUserCreationDate,
        UE_A.DisplayName AS AnswerOwnerDisplayName,
        UE_A.Reputation AS AnswerOwnerReputation,
        PVH.FirstClosedDate,
        PVH.LastReopenedDate,
        (SELECT COUNT(V.Id) FROM Votes V WHERE V.PostId = QAE.QuestionId AND V.VoteTypeId = 2) AS QuestionUpVotes,
        (SELECT COUNT(V.Id) FROM Votes V WHERE V.PostId = QAE.QuestionId AND V.VoteTypeId = 3) AS QuestionDownVotes,
        AVG(QAE.AnswerScore) OVER (PARTITION BY QAE.QuestionOwnerId) AS AvgAnswerScoreByQuestionOwner,
        SUM(QAE.AnswerScore) OVER (PARTITION BY QAE.QuestionOwnerId ORDER BY QAE.AnswerCreationDate
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CumulativeAnswerScoreByQuestionOwner
    FROM
        QuestionAnswerEngagement QAE
    LEFT JOIN UserEngagement UE_Q ON QAE.QuestionOwnerId = UE_Q.UserId
    LEFT JOIN UserEngagement UE_A ON QAE.AnswerOwnerId = UE_A.UserId
    LEFT JOIN PostVersionHistory PVH ON QAE.QuestionId = PVH.PostId
    WHERE QAE.Rn_BestAnswer = 1 OR QAE.AnswerId IS NULL
),
TagAnalysis AS (
    SELECT
        P.Id AS PostId,
        -- split tags like '<tag1><tag2>' into rows; use functions available in your dialect
        -- For Postgres: unnest(string_to_array(..., '><'))
        -- For MySQL: use a user-defined function or JSON hack. Here we keep Postgres-style but avoid :: casts.
        REPLACE(TRIM(unnest(string_to_array(SUBSTRING(P.Tags FROM 2 FOR (CHAR_LENGTH(P.Tags) - 2)), '><'))), '&amp;', '&') AS TagName
    FROM
        Posts P
    WHERE
        P.PostTypeId = 1 AND P.Tags IS NOT NULL
),
TopQuestionTags AS (
    SELECT
        TA.TagName,
        COUNT(DISTINCT TA.PostId) AS TaggedQuestionCount,
        SUM(P.ViewCount) AS TotalTagViewCount,
        SUM(P.Score) AS TotalTagScore,
        RANK() OVER (ORDER BY COUNT(DISTINCT TA.PostId) DESC, SUM(P.Score) DESC) AS TagRank
    FROM
        TagAnalysis TA
    JOIN Posts P ON TA.PostId = P.Id
    GROUP BY
        TA.TagName
    HAVING
        COUNT(DISTINCT TA.PostId) > 10
),
UserPostLinkSummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        COUNT(DISTINCT PL.PostId) AS LinkedPostsAsSource,
        COUNT(DISTINCT PL.RelatedPostId) AS LinkedPostsAsTarget,
        SUM(CASE WHEN LT.Name = 'Duplicate' THEN 1 ELSE 0 END) AS DuplicateLinksAsSource,
        SUM(CASE WHEN LT.Name = 'Duplicate' THEN 1 ELSE 0 END) AS DuplicateLinksAsTarget
    FROM
        Users U
    LEFT JOIN Posts P_Source ON U.Id = P_Source.OwnerUserId
    LEFT JOIN PostLinks PL ON P_Source.Id = PL.PostId
    LEFT JOIN LinkTypes LT ON PL.LinkTypeId = LT.Id
    GROUP BY
        U.Id, U.DisplayName
)
SELECT
    DPM.QuestionId,
    DPM.QuestionTitle,
    DPM.QuestionOwnerDisplayName,
    DPM.QuestionOwnerReputation,
    UE_Q.TotalPosts AS QOwnerTotalPosts,
    UE_Q.TotalQuestions AS QOwnerTotalQuestions,
    UE_Q.TotalAnswers AS QOwnerTotalAnswers,
    UE_Q.GoldBadgeCount AS QOwnerGoldBadges,
    COALESCE(DPM.AnswerId, -1) AS BestAnswerId,
    COALESCE(DPM.AnswerOwnerDisplayName, 'No Answer User') AS BestAnswerOwnerDisplayName,
    DPM.AnswerScore AS BestAnswerScore,
    DPM.IsAcceptedAnswer,
    DPM.QuestionCreationDate,
    DPM.FirstClosedDate,
    DPM.LastReopenedDate,
    DPM.ViewCount,
    DPM.FavoriteCount,
    DPM.QuestionUpVotes,
    DPM.QuestionDownVotes,
    TQT.TagName AS TopTagForQuestion,
    TQT.TaggedQuestionCount AS TopTagQuestionCount,
    (DPM.QuestionUpVotes - DPM.QuestionDownVotes) AS NetQuestionVotes,
    CEIL(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - DPM.QuestionCreationDate)) / (3600 * 24 * 30.5)) AS MonthsSinceCreation,
    CASE
        WHEN DPM.FirstClosedDate IS NOT NULL AND DPM.LastReopenedDate IS NULL THEN 'Closed_Permanent'
        WHEN DPM.FirstClosedDate IS NOT NULL AND DPM.LastReopenedDate IS NOT NULL AND DPM.LastReopenedDate > DPM.FirstClosedDate THEN 'Reopened'
        WHEN DPM.FirstClosedDate IS NOT NULL THEN 'Closed_Temporary'
        ELSE 'Open'
    END AS QuestionStatus,
    CASE
        WHEN DPM.QuestionScore > 100 AND DPM.ViewCount > 10000 THEN 'Viral'
        WHEN DPM.QuestionScore > 50 AND DPM.ViewCount > 5000 THEN 'Popular'
        WHEN DPM.AnswerId IS NULL AND DPM.QuestionCreationDate < (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year') THEN 'Stale_Unanswered'
        ELSE 'Normal'
    END AS QuestionCategory,
    UE_Q.Reputation - COALESCE(UE_A.Reputation, 0) AS QOwnerReputationDifferenceToBestAnswerer,
    (
        SELECT COUNT(DISTINCT PH.PostId)
        FROM PostHistory PH
        WHERE PH.UserId = DPM.QuestionOwnerId
          AND PH.PostHistoryTypeId = 10
          AND PH.CreationDate BETWEEN DPM.QOwnerUserCreationDate AND DPM.QuestionCreationDate
    ) AS QOwnerCloseVoteCountBeforeThisQuestion,
    DPM.AvgAnswerScoreByQuestionOwner,
    DPM.CumulativeAnswerScoreByQuestionOwner,
    UPLS.LinkedPostsAsSource,
    UPLS.DuplicateLinksAsSource,
    LAG(DPM.QuestionCreationDate, 1, TIMESTAMP '1900-01-01') OVER (PARTITION BY DPM.QuestionOwnerId ORDER BY DPM.QuestionCreationDate) AS PrevQuestionByOwnerDate
FROM
    DetailedPostMetrics DPM
LEFT JOIN UserEngagement UE_Q ON DPM.QuestionOwnerId = UE_Q.UserId
LEFT JOIN UserEngagement UE_A ON DPM.AnswerOwnerId = UE_A.UserId
LEFT JOIN (
    SELECT
        TA.PostId,
        TA.TagName
    FROM
        TagAnalysis TA
    INNER JOIN TopQuestionTags TQT ON TA.TagName = TQT.TagName
    WHERE
        TQT.TagRank = 1
) TQT ON DPM.QuestionId = TQT.PostId
LEFT JOIN UserPostLinkSummary UPLS ON DPM.QuestionOwnerId = UPLS.UserId
WHERE
    DPM.QuestionScore >= (SELECT AVG(P.Score) FROM Posts P WHERE P.PostTypeId = 1 AND P.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '3 months'))
    AND DPM.ViewCount >= 100
    AND (
        DPM.FavoriteCount IS NULL
        OR DPM.FavoriteCount > 5
        OR DPM.QuestionOwnerReputation > 5000
    )
    AND EXISTS (
        SELECT 1 FROM Badges B
        WHERE B.UserId = DPM.QuestionOwnerId
          AND B.Class = 1
          AND B.Date >= DPM.QOwnerUserCreationDate
    )

UNION ALL

SELECT
    P_Dup.Id AS QuestionId,
    P_Dup.Title AS QuestionTitle,
    UE_Dup.DisplayName AS QuestionOwnerDisplayName,
    UE_Dup.Reputation AS QuestionOwnerReputation,
    UE_Dup.TotalPosts AS QOwnerTotalPosts,
    UE_Dup.TotalQuestions AS QOwnerTotalQuestions,
    UE_Dup.TotalAnswers AS QOwnerTotalAnswers,
    UE_Dup.GoldBadgeCount AS QOwnerGoldBadges,
    -1 AS BestAnswerId,
    'N/A - Duplicate' AS BestAnswerOwnerDisplayName,
    0 AS BestAnswerScore,
    CAST(0 AS BOOLEAN) AS IsAcceptedAnswer,
    P_Dup.CreationDate AS QuestionCreationDate,
    PVH_Dup.FirstClosedDate,
    PVH_Dup.LastReopenedDate,
    P_Dup.ViewCount,
    P_Dup.FavoriteCount,
    (SELECT COUNT(V.Id) FROM Votes V WHERE V.PostId = P_Dup.Id AND V.VoteTypeId = 2) AS QuestionUpVotes,
    (SELECT COUNT(V.Id) FROM Votes V WHERE V.PostId = P_Dup.Id AND V.VoteTypeId = 3) AS QuestionDownVotes,
    NULL AS TopTagForQuestion,
    NULL AS TopTagQuestionCount,
    (SELECT COUNT(V.Id) FROM Votes V WHERE V.PostId = P_Dup.Id AND V.VoteTypeId = 2) - (SELECT COUNT(V.Id) FROM Votes V WHERE V.PostId = P_Dup.Id AND V.VoteTypeId = 3) AS NetQuestionVotes,
    CEIL(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - P_Dup.CreationDate)) / (3600 * 24 * 30.5)) AS MonthsSinceCreation,
    'Duplicate_Question' AS QuestionStatus,
    'Needs_Review' AS QuestionCategory,
    NULL AS QOwnerReputationDifferenceToBestAnswerer,
    (
        SELECT COUNT(DISTINCT PH_sub.PostId)
        FROM PostHistory PH_sub
        WHERE PH_sub.UserId = UE_Dup.UserId
          AND PH_sub.PostHistoryTypeId = 10
          AND PH_sub.CreationDate BETWEEN UE_Dup.FirstPostDate AND P_Dup.CreationDate
    ) AS QOwnerCloseVoteCountBeforeThisQuestion,
    NULL AS AvgAnswerScoreByQuestionOwner,
    NULL AS CumulativeAnswerScoreByQuestionOwner,
    UPLS_Dup.LinkedPostsAsSource,
    UPLS_Dup.DuplicateLinksAsSource,
    LAG(P_Dup.CreationDate, 1, TIMESTAMP '1900-01-01') OVER (PARTITION BY P_Dup.OwnerUserId ORDER BY P_Dup.CreationDate) AS PrevQuestionByOwnerDate
FROM
    Posts P_Dup
LEFT JOIN UserEngagement UE_Dup ON P_Dup.OwnerUserId = UE_Dup.UserId
LEFT JOIN PostVersionHistory PVH_Dup ON P_Dup.Id = PVH_Dup.PostId
LEFT JOIN UserPostLinkSummary UPLS_Dup ON P_Dup.OwnerUserId = UPLS_Dup.UserId
WHERE
    P_Dup.PostTypeId = 1
    AND P_Dup.AcceptedAnswerId IS NULL
    AND P_Dup.ClosedDate IS NOT NULL
    AND EXISTS (
        SELECT 1 FROM PostLinks PL_Dup
        WHERE PL_Dup.PostId = P_Dup.Id
          AND PL_Dup.LinkTypeId = (SELECT Id FROM LinkTypes WHERE Name = 'Duplicate')
    )
    AND P_Dup.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '2 years')
ORDER BY
    QuestionCreationDate DESC, NetQuestionVotes DESC;