WITH UserPostStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS TotalAnswerScore,
        MAX(p.CreationDate) AS LastPostDate,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE NULL END) AS AvgQuestionViews,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.ViewCount ELSE NULL END) AS AvgAnswerViews,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        STRING_AGG(DISTINCT b.Name ORDER BY b.Date, b.Name) AS BadgeList
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        TotalPosts,
        QuestionCount,
        AnswerCount,
        TotalQuestionScore,
        TotalAnswerScore,
        LastPostDate,
        AvgQuestionViews,
        AvgAnswerViews,
        BadgeCount,
        BadgeList,
        ROW_NUMBER() OVER (ORDER BY TotalQuestionScore DESC, TotalAnswerScore DESC) AS RankByScore,
        DENSE_RANK() OVER (ORDER BY Reputation DESC) AS RankByReputation,
        NTILE(10) OVER (ORDER BY Reputation) AS ReputationDecile
    FROM UserPostStats
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.Tags,
        p.ParentId,
        p.AcceptedAnswerId,
        COALESCE(p.Tags, '') AS CleanTags,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END AS PostTypeLabel,
        CASE 
            WHEN p.Score > 100 THEN 'High'
            WHEN p.Score > 50 THEN 'Medium'
            WHEN p.Score > 10 THEN 'Low'
            ELSE 'Very Low'
        END AS ScoreCategory,
        DATEDIFF(DAY, p.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS DaysSinceCreation,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 
            ELSE 0 
        END AS HasAcceptedAnswer,
        COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) AS EngagementMetric,
        STRING_TO_ARRAY(COALESCE(p.Tags, ''), '>') AS TagArray,
        CASE 
            WHEN p.Tags IS NOT NULL AND LENGTH(TRIM(p.Tags)) > 2 
            THEN LENGTH(TRIM(p.Tags)) - 2 
            ELSE 0 
        END AS TagLength,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS UserPostRank
    FROM Posts p
    WHERE p.Id IS NOT NULL
),
UserRankings AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.AccountId,
        COALESCE(SUM(pa.Score), 0) AS TotalScore,
        COALESCE(AVG(pa.Score), 0) AS AvgScore,
        COALESCE(COUNT(pa.PostId), 0) AS PostCount,
        MIN(pa.CreationDate) AS FirstPostDate,
        MAX(pa.CreationDate) AS LatestPostDate,
        CASE 
            WHEN COUNT(pa.PostId) > 0 THEN 
                CASE 
                    WHEN AVG(pa.Score) > 100 THEN 'High Engagement'
                    WHEN AVG(pa.Score) > 50 THEN 'Medium Engagement'
                    ELSE 'Low Engagement'
                END
            ELSE 'No Posts'
        END AS EngagementLevel,
        STRING_AGG(DISTINCT CASE WHEN pa.PostTypeId = 1 THEN pa.Title END, '; ') AS QuestionTitles
    FROM Users u
    LEFT JOIN PostAnalysis pa ON u.Id = pa.OwnerUserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.AccountId
),
ComplexAnalysis AS (
    SELECT 
        ur.UserId,
        ur.DisplayName,
        ur.Reputation,
        ur.AccountId,
        ur.TotalScore,
        ur.AvgScore,
        ur.PostCount,
        ur.FirstPostDate,
        ur.LatestPostDate,
        ur.EngagementLevel,
        ur.QuestionTitles,
        tu.RankByScore,
        tu.RankByReputation,
        tu.ReputationDecile,
        tu.QuestionCount,
        tu.AnswerCount,
        tu.TotalQuestionScore,
        tu.TotalAnswerScore,
        tu.BadgeCount,
        tu.BadgeList,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ur.UserId AND p.PostTypeId = 1) AS UserQuestions,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ur.UserId AND p.PostTypeId = 2) AS UserAnswers,
        (SELECT COUNT(*) FROM Comments c WHERE c.UserId = ur.UserId) AS UserComments,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = ur.UserId) AS UserBadges,
        CASE 
            WHEN tu.QuestionCount > 0 THEN tu.TotalQuestionScore * 100.0 / NULLIF(tu.QuestionCount, 0)
            ELSE 0 
        END AS AvgScorePerQuestion,
        CASE 
            WHEN tu.AnswerCount > 0 THEN tu.TotalAnswerScore * 100.0 / NULLIF(tu.AnswerCount, 0)
            ELSE 0 
        END AS AvgScorePerAnswer,
        CASE 
            WHEN tu.RankByScore <= 10 THEN 'Top 10 by Score'
            WHEN tu.RankByScore <= 20 THEN 'Top 10-20 by Score'
            ELSE 'Others'
        END AS ScoreRankCategory
    FROM UserRankings ur
    INNER JOIN TopUsers tu ON ur.UserId = tu.UserId
    WHERE ur.PostCount > 0
)
SELECT 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.TotalScore,
    ca.AvgScore,
    ca.PostCount,
    ca.FirstPostDate,
    ca.LatestPostDate,
    ca.EngagementLevel,
    ca.QuestionTitles,
    ca.RankByScore,
    ca.RankByReputation,
    ca.ReputationDecile,
    ca.QuestionCount,
    ca.AnswerCount,
    ca.TotalQuestionScore,
    ca.TotalAnswerScore,
    ca.BadgeCount,
    ca.BadgeList,
    ca.UserQuestions,
    ca.UserAnswers,
    ca.UserComments,
    ca.UserBadges,
    ca.AvgScorePerQuestion,
    ca.AvgScorePerAnswer,
    ca.ScoreRankCategory,
    CASE 
        WHEN ca.Reputation >= 10000 AND ca.BadgeCount >= 50 THEN 'Elite Contributor'
        WHEN ca.Reputation >= 5000 AND ca.BadgeCount >= 25 THEN 'Veteran Contributor'
        WHEN ca.Reputation >= 1000 AND ca.BadgeCount >= 10 THEN 'Active Contributor'
        ELSE 'Regular Contributor'
    END AS ContributorTier,
    CASE 
        WHEN ca.PostCount >= 1000 AND ca.AvgScore >= 10 THEN 'High Volume High Quality'
        WHEN ca.PostCount >= 1000 THEN 'High Volume'
        WHEN ca.AvgScore >= 50 THEN 'High Quality'
        ELSE 'Standard'
    END AS ContributionStyle,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.Score >= 100) AS HighScorePosts,
    (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.PostTypeId = 1) AS AvgQuestionScore,
    (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.PostTypeId = 2) AS AvgAnswerScore,
    CASE 
        WHEN ca.ScoreRankCategory = 'Top 10 by Score' AND ca.Reputation >= 10000 THEN 
            'Top Performer - Elite'
        WHEN ca.ScoreRankCategory = 'Top 10 by Score' THEN 
            'Top Performer'
        WHEN ca.ScoreRankCategory = 'Top 10-20 by Score' THEN 
            'High Performer'
        ELSE 
            'General Contributor'
    END AS PerformanceLabel,
    DENSE_RANK() OVER (ORDER BY ca.TotalScore DESC, ca.Reputation DESC) AS OverallRank,
    RANK() OVER (ORDER BY ca.TotalScore DESC) AS ScoreRank,
    COUNT(*) OVER () AS TotalContributors
FROM ComplexAnalysis ca
WHERE ca.PostCount > 0
HAVING 
    ca.TotalScore > 0 
    AND ca.Reputation > 100
    AND (ca.UserQuestions > 0 OR ca.UserAnswers > 0)
ORDER BY ca.TotalScore DESC, ca.Reputation DESC
OFFSET 0 ROWS
FETCH NEXT 100 ROWS ONLY;