-- {"query": "3399.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2334} 
WITH
/*--------------------------------------------------------------
  1. Basic user statistics including badge counts and last post
--------------------------------------------------------------*/
UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0)               AS NetVotes,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        (SELECT MAX(CreationDate) FROM Posts p WHERE p.OwnerUserId = u.Id)   AS LastPostDate
    FROM Users u
),

/*--------------------------------------------------------------
  2. Aggregated post information per user
--------------------------------------------------------------*/
PostAgg AS (
    SELECT
        p.OwnerUserId                                    AS UserId,
        COUNT(*)        FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(*)        FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        AVG(p.Score)    FILTER (WHERE p.PostTypeId = 1) AS AvgQuestionScore,
        AVG(p.Score)    FILTER (WHERE p.PostTypeId = 2) AS AvgAnswerScore,
        SUM(p.ViewCount)                              AS TotalViews,
        MAX(p.CreationDate)                           AS LatestPost
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),

/*--------------------------------------------------------------
  3. Tag usage per user (only for questions)
--------------------------------------------------------------*/
TagUsage AS (
    SELECT
        p.OwnerUserId                         AS UserId,
        UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<>' FROM p.Tags), '><')) AS Tag,
        COUNT(*)                              AS TagCount
    FROM Posts p
    WHERE p.Tags IS NOT NULL
      AND p.PostTypeId = 1                     -- only questions have tags
    GROUP BY p.OwnerUserId, Tag
),

/*--------------------------------------------------------------
  4. Top 5 tags per user (concatenated)
--------------------------------------------------------------*/
TopTags AS (
    SELECT
        UserId,
        STRING_AGG(Tag, ', ' ORDER BY TagCount DESC LIMIT 5) AS Top5Tags
    FROM TagUsage
    GROUP BY UserId
),

/*--------------------------------------------------------------
  5. Simple vote totals per post (used later in a correlated subquery)
--------------------------------------------------------------*/
VoteStats AS (
    SELECT
        v.PostId,
        SUM(CASE WHEN vt.Id = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN vt.Id = 3 THEN 1 ELSE 0 END) AS DownVotes
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    GROUP BY v.PostId
),

/*--------------------------------------------------------------
  6. Ranking users by reputation and by total post views
--------------------------------------------------------------*/
UserRank AS (
    SELECT
        us.Id,
        ROW_NUMBER() OVER (ORDER BY us.Reputation DESC, us.NetVotes DESC) AS ReputationRank,
        ROW_NUMBER() OVER (ORDER BY COALESCE(pa.TotalViews,0) DESC)       AS ViewsRank
    FROM UserStats us
    LEFT JOIN PostAgg pa ON pa.UserId = us.Id
)

/*--------------------------------------------------------------
  7. Final result set: a rich, multi‑column view of top users
--------------------------------------------------------------*/
SELECT
    us.Id                                   AS UserId,
    us.DisplayName,
    us.Reputation,
    us.NetVotes,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    COALESCE(pa.QuestionCount,0)            AS QuestionsAsked,
    COALESCE(pa.AnswerCount,0)              AS AnswersGiven,
    ROUND(us.NetVotes::numeric / NULLIF(us.Reputation,0),2) AS VoteToRepRatio,
    ROUND(COALESCE(pa.AvgQuestionScore,0)::numeric,2)      AS AvgQScore,
    ROUND(COALESCE(pa.AvgAnswerScore,0)::numeric,2)       AS AvgAScore,
    COALESCE(pa.TotalViews,0)               AS TotalPostViews,
    us.LastPostDate,
    tt.Top5Tags,
    ur.ReputationRank,
    ur.ViewsRank,
    CASE
        WHEN ur.ReputationRank <= 100 THEN 'Top 100 Reputation'
        WHEN ur.ViewsRank      <= 100 THEN 'Top 100 Views'
        ELSE 'Other'
    END                                      AS Tier
FROM UserStats us
LEFT JOIN PostAgg   pa ON pa.UserId = us.Id
LEFT JOIN TopTags   tt ON tt.UserId = us.Id
LEFT JOIN UserRank  ur ON ur.Id     = us.Id
WHERE (us.Reputation > 10_000 OR ur.ViewsRank <= 500)
ORDER BY us.Reputation DESC
LIMIT 100

UNION ALL

/*--------------------------------------------------------------
  Marker row to easily spot the end of the top‑user block
--------------------------------------------------------------*/
SELECT
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,
    NULL,NULL,NULL,NULL,'--- End of Top Users ---'::text;