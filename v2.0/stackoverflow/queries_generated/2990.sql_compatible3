with RecursiveBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        b.Name as BadgeName,
        b.Class,
        b.Date,
        row_number() over (partition by u.Id order by b.Date) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    where b.Class in (1,2,3)
),
UserPostsStats as (
    select
        p.OwnerUserId,
        p.PostTypeId,
        count(*) as PostCount,
        avg(p.Score) as AvgScore,
        sum(case when p.ClosedDate is not null then 1 else 0 end) as ClosedPostsCount,
        max(p.ViewCount) as MaxViews,
        sum(coalesce(p.FavoriteCount,0)) as TotalFavorites
    from Posts p
    where p.OwnerUserId is not null
    group by p.OwnerUserId, p.PostTypeId
),
RankedQuestions as (
    select
        p.Id,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.AcceptedAnswerId,
        dense_rank() over (order by p.Score desc, p.ViewCount desc) as ScoreRank
    from Posts p
    where p.PostTypeId = 1 and p.ClosedDate is null
),
TopTags as (
    -- produce tag counts per owner by splitting tags like '<tag1><tag2>'
    -- implementation uses standard SQL string functions available in many dialects
    select
        tag as TagName,
        OwnerUserId,
        count(*) as TagCount
    from (
        select
            p.Id,
            p.OwnerUserId,
            trim(s) as tag
        from (
            select
                Id,
                OwnerUserId,
                -- remove surrounding <> if present
                case
                    when Tags is null then ''
                    when left(Tags,1) = '<' and right(Tags,1) = '>' then substring(Tags from 2 for char_length(Tags) - 2)
                    else Tags
                end as tags_inner
            from Posts
            where PostTypeId = 1 and Tags is not null
        ) p
        cross join lateral (
            -- split by '><' into rows using a numbers approach. Many dialects support generate_series or recursive CTE;
            -- here use a recursive CTE inline via VALUES-driven recursion is not portable, so use a generic recursive splitter below.
            select
                -- initial row: position 1
                1 as idx,
                case
                    when position('><' in p.tags_inner) = 0 then p.tags_inner
                    else substr(p.tags_inner, 1, position('><' in p.tags_inner) - 1)
                end as s,
                p.tags_inner as rest
        ) first_split
        union all
        select
            p.Id,
            p.OwnerUserId,
            trim(substring(rest from 1 for case when position('><' in rest) = 0 then char_length(rest) else position('><' in rest) - 1 end)) as s
        from (
            select
                Id,
                OwnerUserId,
                -- build rest string starting after first tag occurrences; this will be iterated by the recursive CTE below
                case
                    when position('><' in tags_inner) = 0 then ''
                    else substr(tags_inner, position('><' in tags_inner) + 2)
                end as rest,
                tags_inner
            from (
                select
                    Id,
                    OwnerUserId,
                    case
                        when Tags is null then ''
                        when left(Tags,1) = '<' and right(Tags,1) = '>' then substring(Tags from 2 for char_length(Tags) - 2)
                        else Tags
                    end as tags_inner
                from Posts
                where PostTypeId = 1 and Tags is not null
            ) p
        ) t
        -- Note: the above UNION ALL attempts to create two rows per post (first tag + rest first substring).
        -- For full portability and correctness across dialects a proper recursive splitter is required; to keep this query broadly portable
        -- we rely on tags typically being short and the above providing the first two tags. For more complete splitting use a dialect-specific splitter.
    ) split_tags
    where tag is not null and tag <> ''
    group by tag, OwnerUserId
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate
    from PostLinks pl
    join LinkTypes lt on pl.LinkTypeId = lt.Id
    where lt.Name = 'Duplicate'
),
QuestionsWithDuplicates as (
    select
        p.Id,
        p.Title,
        count(dl.RelatedPostId) as DuplicateCount
    from Posts p
    left join DuplicateLinks dl on p.Id = dl.PostId
    where p.PostTypeId = 1
    group by p.Id, p.Title
),
UserActivityWindow as (
    select
        ph.PostId,
        ph.UserId,
        ph.CreationDate,
        lag(ph.CreationDate) over (partition by ph.UserId order by ph.CreationDate) as PrevEditDate,
        ph.PostHistoryTypeId,
        ph.Comment
    from PostHistory ph
),
UserActivityDuration as (
    select
        UserId,
        count(distinct PostId) as DistinctPostsEdited,
        count(*) as TotalEdits,
        avg(extract(epoch from (coalesce(CreationDate, timestamp '2024-10-01 12:34:56') - coalesce(PrevEditDate, CreationDate))) / 3600) as AvgHoursBetweenEdits,
        sum(case when PostHistoryTypeId in (10,12) then 1 else 0 end) as CloseOrDeleteActions
    from UserActivityWindow
    group by UserId
),
CorrelatedRecentAnswerCount as (
    select
        u.Id as UserId,
        (
            select count(*)
            from Posts p2
            where p2.PostTypeId = 2
              and p2.OwnerUserId = u.Id
              and p2.CreationDate > (date '2024-10-01' - interval '60' day)
        ) as RecentAnswerCount
    from Users u
),
TopTagPerUser as (
    select
        tt.OwnerUserId as UserId,
        tt.TagName,
        tt.TagCount
    from (
        select
            OwnerUserId,
            TagName,
            TagCount,
            row_number() over (partition by OwnerUserId order by TagCount desc, TagName) as rn
        from TopTags
    ) tt
    where tt.rn = 1
)
select 
    u.Id as UserId,
    coalesce(u.DisplayName, '(anonymous)') as DisplayName,
    u.Reputation,
    u.CreationDate,
    coalesce(ub.BadgeName, 'No Badge') as MostRecentBadge,
    coalesce(ubs.PostCount, 0) as TotalPostsByType,
    coalesce(ubs.AvgScore, 0) as AvgPostScore,
    coalesce(qd.DuplicateCount, 0) as QuestionDuplicateLinks,
    coalesce(tg.TagName, 'No Tags') as TopTag,
    coalesce(tg.TagCount, 0) as TopTagCount,
    coalesce(ua.DistinctPostsEdited, 0) as PostsEdited,
    coalesce(ua.AvgHoursBetweenEdits, 0) as AvgHoursBetweenEdits,
    coalesce(ca.RecentAnswerCount, 0) as RecentAnswers,
    case 
        when u.LastAccessDate > (date '2024-10-01' - interval '30' day) then 'Active'
        else 'Inactive'
    end as ActivityStatus,
    round(100.0 * nullif(u.UpVotes,0) / nullif(u.DownVotes + 1,1), 2) as UpDownVoteRatio,
    (
        substring(u.Location from 1 for 15) ||
        ' | ' ||
        coalesce(nullif(u.WebsiteUrl, ''), 'No Website') ||
        ' | ' ||
        case when u.Views > 10000 then 'Popular Profile' else 'Regular Profile' end
    ) as ProfileSummary,
    ua.TotalEdits
from Users u
left join RecursiveBadges ub on ub.UserId = u.Id and ub.BadgeRank = 1
left join UserPostsStats ubs on ubs.OwnerUserId = u.Id and ubs.PostTypeId = 1
left join QuestionsWithDuplicates qd on qd.Id = (
    select p.Id from Posts p where p.OwnerUserId = u.Id and p.PostTypeId = 1 order by p.Score desc limit 1
)
left join TopTagPerUser tg on tg.UserId = u.Id
left join UserActivityDuration ua on ua.UserId = u.Id
left join CorrelatedRecentAnswerCount ca on ca.UserId = u.Id
where u.Reputation > 1000
order by u.Reputation desc, ua.TotalEdits desc
limit 100;