-- {"query": "1315.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3848} 
WITH UserActivitySummary AS (
    -- Summarizes user's overall activity, reputation, and age.
    -- Incorporates LEFT JOINs to include users with no associated posts, comments, or badges.
    -- Uses COALESCE for NULL display names and aggregates counts/averages.
    -- Calculates account age and ranks users by reputation using a window function.
    SELECT
        U.Id AS UserId,
        COALESCE(U.DisplayName, 'Anonymous User') AS UserDisplayName,
        U.Reputation,
        U.UpVotes AS TotalUpVotesGiven,
        U.DownVotes AS TotalDownVotesGiven,
        U.Views AS UserProfileViews,
        EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - U.CreationDate)) / (60 * 60 * 24) AS AccountAgeDays,
        COUNT(DISTINCT P.Id) AS TotalPostsOwned,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestionsOwned,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswersOwned,
        COALESCE(SUM(P.Score), 0) AS TotalPostsScore,
        COALESCE(AVG(P.Score) FILTER (WHERE P.Score IS NOT NULL), 0.0) AS AvgPostScoreOwned,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COUNT(DISTINCT B.Id) AS TotalBadgesEarned,
        ROW_NUMBER() OVER (ORDER BY U.Reputation DESC, U.CreationDate ASC) AS GlobalReputationRank
    FROM
        Users U
    LEFT JOIN
        Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN
        Comments C ON U.Id = C.UserId
    LEFT JOIN
        Badges B ON U.Id = B.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.UpVotes, U.DownVotes, U.Views, U.CreationDate
),
PostContentMetrics AS (
    -- Analyzes post content, length, tags, and basic activity metrics.
    -- Uses string functions (LENGTH, SUBSTRING, STRING_TO_ARRAY, ARRAY_LENGTH) for text analysis.
    -- Includes a simple subquery for edit history count and boolean flags for keyword presence.
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        COALESCE(P.Title, '[Untitled Post]') AS PostTitle,
        P.Score AS PostScore,
        P.ViewCount,
        P.CreationDate AS PostCreationDate,
        P.LastActivityDate AS PostLastActivityDate,
        LENGTH(P.Body) AS BodyLength,
        LENGTH(P.Title) AS TitleLength,
        CASE
            WHEN P.Tags IS NOT NULL AND LENGTH(TRIM(P.Tags)) > 2 THEN
                ARRAY_LENGTH(STRING_TO_ARRAY(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'), 1)
            ELSE 0
        END AS TagCount,
        EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - P.LastEditDate)) / (60 * 60 * 24) AS DaysSinceLastEdit,
        EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - P.CreationDate)) / (60 * 60 * 24) AS PostAgeDays,
        COALESCE(P.AnswerCount, 0) AS DeclaredAnswerCount,
        COALESCE(P.CommentCount, 0) AS DeclaredCommentCount,
        COALESCE(P.FavoriteCount, 0) AS DeclaredFavoriteCount,
        (SELECT COUNT(DISTINCT PH.Id) FROM PostHistory PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)) AS TotalEditHistoryEntries,
        (CASE WHEN P.Body ILIKE '%performance%' OR P.Body ILIKE '%optimization%' THEN 1 ELSE 0 END) AS HasPerformanceKeywords,
        (CASE WHEN P.Body ILIKE '%bug%' OR P.Body ILIKE '%error%' OR P.Body ILIKE '%issue%' THEN 1 ELSE 0 END) AS HasProblemKeywords,
        (CASE WHEN P.Body LIKE '%<code>%' AND P.Body LIKE '%</code>%' THEN 1 ELSE 0 END) AS HasCodeBlock
    FROM
        Posts P
    WHERE
        P.PostTypeId IN (1, 2) -- Focus on Questions (1) and Answers (2)
),
PostEngagementAndModeration AS (
    -- Aggregates vote counts and checks for moderation actions using correlated subqueries and EXISTS.
    -- Calculates net votes and identifies posts closed for specific reasons.
    SELECT
        P.Id AS PostId,
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteTotal,
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteTotal,
        SUM(CASE WHEN V.VoteTypeId = 1 THEN 1 ELSE 0 END) AS AcceptedAnswerMarkCount,
        SUM(CASE WHEN V.VoteTypeId = 5 THEN 1 ELSE 0 END) AS FavoriteVoteTotal,
        SUM(CASE WHEN V.VoteTypeId = 6 THEN 1 ELSE 0 END) AS CloseVoteTotal,
        SUM(CASE WHEN V.VoteTypeId = 7 THEN 1 ELSE 0 END) AS ReopenVoteTotal,
        SUM(CASE WHEN V.VoteTypeId = 12 THEN 1 ELSE 0 END) AS SpamVoteTotal,
        (SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) - SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END)) AS NetVotes,
        MAX(CASE WHEN EXISTS (SELECT 1 FROM PostHistory PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId = 10) THEN 1 ELSE 0 END) AS WasEverClosed,
        MAX(CASE WHEN EXISTS (
            SELECT 1 FROM PostHistory PHC JOIN CloseReasonTypes CRT ON CAST(PHC.Comment AS SMALLINT) = CRT.Id
            WHERE PHC.PostId = P.Id AND PHC.PostHistoryTypeId = 10 AND CRT.Name IN ('Duplicate', 'Off-topic', 'Needs details or clarity')
        ) THEN 1 ELSE 0 END) AS ClosedForSpecificReason
    FROM
        Posts P
    LEFT JOIN
        Votes V ON P.Id = V.PostId
    WHERE P.PostTypeId IN (1, 2)
    GROUP BY
        P.Id
),
PostLinkSummary AS (
    -- Summarizes incoming and outgoing links, differentiating between linked and duplicate types.
    -- Uses multiple LEFT JOINs to count both directions of links.
    SELECT
        P.Id AS PostId,
        COUNT(DISTINCT PL_Out.RelatedPostId) FILTER (WHERE PL_Out.LinkTypeId = 1) AS OutgoingLinksCount,
        COUNT(DISTINCT PL_In.PostId) FILTER (WHERE PL_In.LinkTypeId = 1) AS IncomingLinksCount,
        COUNT(DISTINCT PL_Out.RelatedPostId) FILTER (WHERE PL_Out.LinkTypeId = 3) AS DuplicateLinksCount,
        COUNT(DISTINCT PL_In.PostId) FILTER (WHERE PL_In.LinkTypeId = 3) AS DuplicatedByCount
    FROM
        Posts P
    LEFT JOIN
        PostLinks PL_Out ON P.Id = PL_Out.PostId
    LEFT JOIN
        PostLinks PL_In ON P.Id = PL_In.RelatedPostId
    WHERE P.PostTypeId IN (1, 2)
    GROUP BY
        P.Id
),
PostCommentActivity AS (
    -- Analyzes comment engagement, average score, and sentiment (simplified keyword check).
    -- Uses COALESCE for average comment score and SUM with CASE for sentiment counts.
    SELECT
        P.Id AS PostId,
        COUNT(C.Id) AS TotalCommentsActual,
        COALESCE(AVG(C.Score), 0.0) AS AvgCommentScore,
        SUM(CASE WHEN C.Text ILIKE '%thank%' OR C.Text ILIKE '%appreciate%' OR C.Text ILIKE '%useful%' THEN 1 ELSE 0 END) AS PositiveCommentCount,
        SUM(CASE WHEN C.Text ILIKE '%confusing%' OR C.Text ILIKE '%incorrect%' OR C.Text ILIKE '%clarify%' THEN 1 ELSE 0 END) AS NegativeCommentCount,
        MAX(C.CreationDate) AS LastCommentDate
    FROM
        Posts P
    LEFT JOIN
        Comments C ON P.Id = C.PostId
    WHERE P.PostTypeId IN (1, 2)
    GROUP BY
        P.Id
),
PostTypeRankings AS (
    -- Applies various window functions to rank posts within their type based on different metrics.
    -- Includes RANK, NTILE, AVG OVER PARTITION, and CUME_DIST.
    SELECT
        PCM.PostId,
        PCM.PostTypeId,
        PCM.PostScore,
        PCM.ViewCount,
        PCM.PostCreationDate,
        PCM.PostLastActivityDate,
        PCM.DeclaredAnswerCount,
        PCM.DeclaredCommentCount,
        PCM.BodyLength,
        RANK() OVER (PARTITION BY PCM.PostTypeId ORDER BY PCM.PostScore DESC, PCM.ViewCount DESC, PCM.PostCreationDate DESC) AS RankByScoreAndViews,
        NTILE(10) OVER (PARTITION BY PCM.PostTypeId ORDER BY PCM.PostLastActivityDate DESC, PCM.PostScore DESC) AS ActivityDecile,
        AVG(PCM.DeclaredAnswerCount) OVER (PARTITION BY PCM.PostTypeId) AS AvgAnswerCountForType,
        CUME_DIST() OVER (PARTITION BY PCM.PostTypeId ORDER BY PCM.BodyLength DESC) AS BodyLengthCumeDist
    FROM
        PostContentMetrics PCM
),
HighEngagementPosts AS (
    -- Uses a UNION ALL set operator to identify posts that are highly engaged based on two different criteria:
    -- 1. High score and high answer count for questions.
    -- 2. High score and high comment count for questions.
    -- Involves subqueries to calculate dynamic thresholds based on average values.
    SELECT
        PTR.PostId,
        PTR.PostTypeId,
        'High Score & Answer Count' AS EngagementType
    FROM
        PostTypeRankings PTR
    WHERE
        PTR.PostTypeId = 1 -- Only questions
        AND PTR.PostScore >= (SELECT AVG(PostScore) * 2 FROM PostContentMetrics WHERE PostTypeId = 1) -- Score significantly above average
        AND PTR.DeclaredAnswerCount >= (SELECT AVG(DeclaredAnswerCount) * 1.5 FROM PostContentMetrics WHERE PostTypeId = 1) -- Answer count significantly above average
    UNION ALL
    SELECT
        PTR.PostId,
        PTR.PostTypeId,
        'High Score & Comment Count' AS EngagementType
    FROM
        PostTypeRankings PTR
    WHERE
        PTR.PostTypeId = 1 -- Only questions
        AND PTR.PostScore >= (SELECT AVG(PostScore) * 2 FROM PostContentMetrics WHERE PostTypeId = 1)
        AND PTR.DeclaredCommentCount >= (SELECT AVG(DeclaredCommentCount) * 1.5 FROM PostContentMetrics WHERE PostTypeId = 1)
)
-- Main query: Joins all CTEs, applies complex filtering, calculations, and NULL logic.
-- Calculates a 'WeightedEngagementScore' combining various metrics, normalized by post age and body length.
-- Uses extensive CASE statements for categorization and a NOT EXISTS correlated subquery.
SELECT
    UAS.UserId,
    UAS.UserDisplayName,
    UAS.Reputation,
    PCM.PostId,
    PCM.PostTitle,
    PT.Name AS PostTypeName,
    PCM.PostScore,
    PCM.ViewCount,
    PCE.UpVoteTotal,
    PCE.DownVoteTotal,
    PCE.NetVotes,
    PCE.WasEverClosed,
    PCE.ClosedForSpecificReason,
    PLS.OutgoingLinksCount,
    PLS.IncomingLinksCount,
    PLS.DuplicateLinksCount,
    PCA.TotalCommentsActual,
    PCA.AvgCommentScore,
    PCA.PositiveCommentCount,
    PCA.NegativeCommentCount,
    PTR.RankByScoreAndViews,
    PTR.ActivityDecile,
    PCM.HasPerformanceKeywords,
    PCM.HasProblemKeywords,
    PCM.HasCodeBlock,
    HE.EngagementType,
    -- Complicated calculation: engagement ratio adjusted for age, body length, and various interaction metrics
    (CAST(PCM.PostScore AS NUMERIC) * (PCE.NetVotes + 1) + (PCA.TotalCommentsActual * PCA.AvgCommentScore * 1.5) + (PLS.IncomingLinksCount * 5) + (PCM.DeclaredFavoriteCount * 2) + (PCM.TotalEditHistoryEntries * 0.5)) /
    NULLIF(POWER(PCM.PostAgeDays + 1, 0.75) * POWER(NULLIF(PCM.BodyLength, 0), 0.3) * POWER(NULLIF(PCM.TagCount, 0), 0.1), 0) AS WeightedEngagementScore,
    -- More complex string manipulation and NULL logic for a title snippet
    COALESCE(
        SUBSTRING(PCM.PostTitle, 1, GREATEST(15, LEAST(LENGTH(PCM.PostTitle), 50))) || CASE WHEN LENGTH(PCM.PostTitle) > 50 THEN '...' ELSE '' END,
        'Title Unavailable'
    ) AS TitleSnippet,
    -- Categorizes posts based on a combination of their characteristics
    CASE
        WHEN PCE.NetVotes > 50 AND PCE.WasEverClosed = 0 AND PCM.PostAgeDays < 365 AND PCM.HasCodeBlock = 1 AND PCM.PostTypeId = 1 THEN 'Popular & Clean Code Question'
        WHEN PCE.NetVotes <= 0 AND PCE.WasEverClosed = 1 AND PCM.PostTypeId = 1 AND PCE.ClosedForSpecificReason = 1 THEN 'Controversial/Problematic Question (Closed)'
        WHEN UAS.TotalQuestionsOwned > 100 AND UAS.AvgPostScoreOwned > 10 AND UAS.ReputationRank <= 1000 THEN 'Top Contributor\'s Valued Post'
        WHEN PCM.PostTypeId = 2 AND PCE.AcceptedAnswerMarkCount > 0 AND PCM.PostScore > 5 THEN 'Highly Accepted Answer'
        ELSE 'General Engaged Post'
    END AS PostCategorization
FROM
    PostContentMetrics PCM
INNER JOIN
    UserActivitySummary UAS ON PCM.OwnerUserId = UAS.UserId
INNER JOIN
    PostEngagementAndModeration PCE ON PCM.PostId = PCE.PostId
INNER JOIN
    PostLinkSummary PLS ON PCM.PostId = PLS.PostId
INNER JOIN
    PostCommentActivity PCA ON PCM.PostId = PCA.PostId
INNER JOIN
    PostTypeRankings PTR ON PCM.PostId = PTR.PostId
INNER JOIN
    PostTypes PT ON PCM.PostTypeId = PT.Id -- Join PostTypes for PostTypeName
LEFT JOIN
    HighEngagementPosts HE ON PCM.PostId = HE.PostId AND PCM.PostTypeId = HE.PostTypeId
WHERE
    UAS.Reputation > 1500 -- Filter for established users
    AND PCM.ViewCount > 1000 -- Only posts with significant views
    AND PCM.PostAgeDays BETWEEN 60 AND 1095 -- Posts between 2 months and 3 years old
    AND (
        (PCM.PostTypeId = 1 AND PTR.RankByScoreAndViews <= 50 AND PCM.HasProblemKeywords = 0) -- Top 50 questions by score/views, no problem keywords
        OR
        (PCM.PostTypeId = 2 AND PTR.ActivityDecile <= 2 AND PCA.AvgCommentScore > 0.5) -- Top 20% answers by activity, with positive average comment score
    )
    AND NOT EXISTS (
        SELECT 1
        FROM PostHistory PH_Del
        WHERE PH_Del.PostId = PCM.PostId AND PH_Del.PostHistoryTypeId = 12 -- Exclude explicitly deleted posts
        AND PH_Del.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '365 days' -- deleted in the last year
    )
    AND PCM.PostTitle IS NOT NULL AND LENGTH(TRIM(PCM.PostTitle)) > 10 -- Ensure title exists and is substantial
ORDER BY
    WeightedEngagementScore DESC,
    UAS.Reputation DESC,
    PCM.PostLastActivityDate DESC
LIMIT 750;