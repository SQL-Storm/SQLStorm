with RecursiveTagCounts as (
    select
        t.Id as TagId,
        t.TagName,
        t.Count,
        t.IsModeratorOnly,
        t.IsRequired,
        row_number() over(partition by coalesce(cast(t.IsModeratorOnly as int), 0) order by t.Count desc, t.TagName) as TagRank
    from Tags t
    where t.TagName is not null
),
RecentBadgeUsers as (
    select 
        b.UserId,
        max(b.Date) as LastBadgeDate,
        count(*) filter (where b.Class = 1) as GoldBadges,
        count(*) filter (where b.Class = 2) as SilverBadges,
        count(*) filter (where b.Class = 3) as BronzeBadges,
        bool_or(b.TagBased = 1) as HasTagBasedBadge
    from Badges b
    group by b.UserId
),
HighRepActiveUsers as (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        coalesce(rbu.GoldBadges, 0) as GoldBadges,
        coalesce(rbu.SilverBadges, 0) as SilverBadges,
        coalesce(rbu.BronzeBadges, 0) as BronzeBadges,
        coalesce(rbu.HasTagBasedBadge, false) as HasTagBasedBadge
    from Users u
    left join RecentBadgeUsers rbu on u.Id = rbu.UserId
    where u.Reputation > 10000
      and u.LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - interval '180 days'
),
UserQuestionStats as (
    select 
        p.OwnerUserId,
        count(*) as QuestionCount,
        avg(p.Score) as AvgQuestionScore,
        sum(case when p.AcceptedAnswerId is not null then 1 else 0 end) as QuestionsWithAcceptedAnswer,
        max(p.ViewCount) as MaxQuestionViews,
        string_agg(distinct substring(p.Tags from '<([^>]+)>'), ',' order by substring(p.Tags from '<([^>]+)>')) as UniqueTags
    from Posts p
    where p.PostTypeId = 1
      and p.OwnerUserId is not null
    group by p.OwnerUserId
),
UserAnswerStats as (
    select
        a.OwnerUserId,
        count(a.Id) as AnswerCount,
        avg(a.Score) as AvgAnswerScore,
        count(distinct a.ParentId) as QuestionsAnswered,
        count(distinct case when a.Id = q.AcceptedAnswerId then a.ParentId else null end) as AcceptedAnswersCount
    from Posts a
    left join Posts q on a.ParentId = q.Id and q.PostTypeId = 1
    where a.PostTypeId = 2
      and a.OwnerUserId is not null
    group by a.OwnerUserId
),
UserActivityWindow as (
    select 
        p.OwnerUserId,
        p.Id as PostId,
        p.CreationDate,
        sum(p.Score) over (partition by p.OwnerUserId order by p.CreationDate rows between 6 preceding and current row) as ScoreLast7Posts,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as RecentPostRank
    from Posts p
    where p.OwnerUserId is not null
),
UserWithDerived AS (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.GoldBadges,
        u.SilverBadges,
        u.BronzeBadges,
        u.HasTagBasedBadge,
        coalesce(qs.QuestionCount,0) as QuestionCount,
        coalesce(qs.AvgQuestionScore,0) as AvgQuestionScore,
        coalesce(qs.QuestionsWithAcceptedAnswer,0) as QuestionsWithAcceptedAnswer,
        coalesce(qs.MaxQuestionViews,0) as MaxQuestionViews,
        coalesce(ua.AnswerCount,0) as AnswerCount,
        coalesce(ua.AvgAnswerScore,0) as AvgAnswerScore,
        coalesce(ua.QuestionsAnswered,0) as QuestionsAnswered,
        coalesce(ua.AcceptedAnswersCount,0) as AcceptedAnswersCount
    from HighRepActiveUsers u
    left join UserQuestionStats qs on u.Id = qs.OwnerUserId
    left join UserAnswerStats ua on u.Id = ua.OwnerUserId
),
DuplicateTagQuestions as (
    select distinct p.Id, p.Title, p.Tags 
    from Posts p
    inner join PostLinks pl on pl.PostId = p.Id and pl.LinkTypeId = 3
    where p.PostTypeId = 1
),
ComplexPostsInfo as (
    select
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        phc.EditCount,
        phc.CloseVoteCount,
        phc.RollbackCount,
        coalesce(vup.UpVoteCount,0) as UpVoteCount,
        coalesce(vdp.DownVoteCount,0) as DownVoteCount,
        (p.Score + coalesce(vup.UpVoteCount,0) * 2 - coalesce(vdp.DownVoteCount,0)) as AdjustedScore
    from Posts p
    left join (
        select 
            PostId,
            count(case when PostHistoryTypeId in (4,5,6) then 1 end) as EditCount,
            count(case when PostHistoryTypeId = 10 then 1 end) as CloseVoteCount,
            count(case when PostHistoryTypeId in (7,8,9) then 1 end) as RollbackCount
        from PostHistory
        group by PostId
    ) phc on p.Id = phc.PostId
    left join (
        select 
            PostId,
            count(*) filter (where VoteTypeId = 2) as UpVoteCount
        from Votes
        group by PostId
    ) vup on p.Id = vup.PostId
    left join (
        select 
            PostId,
            count(*) filter (where VoteTypeId = 3) as DownVoteCount
        from Votes
        group by PostId
    ) vdp on p.Id = vdp.PostId
    where p.PostTypeId in (1,2)
),
RankingAndFinal as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.GoldBadges,
        u.SilverBadges,
        u.BronzeBadges,
        u.HasTagBasedBadge,
        u.QuestionCount,
        u.AvgQuestionScore,
        u.QuestionsWithAcceptedAnswer,
        u.MaxQuestionViews,
        u.AnswerCount,
        u.AvgAnswerScore,
        u.QuestionsAnswered,
        u.AcceptedAnswersCount,
        row_number() over (order by u.Reputation desc, u.GoldBadges desc, u.SilverBadges desc) as UserRank,
        (select count(distinct c.PostId) 
         from Comments c 
         where c.UserId = u.Id and c.CreationDate > cast('2024-10-01' as date) - interval '90 days'
        ) as RecentCommentCount
    from UserWithDerived u
)
select
    r.UserRank,
    r.DisplayName,
    r.Reputation,
    r.GoldBadges, r.SilverBadges, r.BronzeBadges,
    r.HasTagBasedBadge,
    r.QuestionCount,
    r.AvgQuestionScore,
    r.QuestionsWithAcceptedAnswer,
    r.MaxQuestionViews,
    r.AnswerCount,
    r.AvgAnswerScore,
    r.QuestionsAnswered,
    r.AcceptedAnswersCount,
    r.RecentCommentCount,
    dtq.Id as DuplicateQuestionId,
    dtq.Title as DuplicateQuestionTitle,
    dtq.Tags as DuplicateQuestionTags,
    cpi.Id as ComplexPostId,
    cpi.Title as ComplexPostTitle,
    cpi.Score as ComplexPostScore,
    cpi.ViewCount as ComplexPostViewCount,
    cpi.EditCount as ComplexPostEditCount,
    cpi.CloseVoteCount as ComplexPostCloseVoteCount,
    cpi.RollbackCount as ComplexPostRollbackCount,
    cpi.UpVoteCount as ComplexPostUpVotes,
    cpi.DownVoteCount as ComplexPostDownVotes,
    cpi.AdjustedScore as ComplexPostAdjustedScore
from RankingAndFinal r
left join ComplexPostsInfo cpi on cpi.OwnerUserId = r.UserId
left join DuplicateTagQuestions dtq on dtq.Id = (
    select min(d.Id) from DuplicateTagQuestions d where d.Id = (
        select PostId
        from Posts
        where OwnerUserId = r.UserId and PostTypeId = 1
        order by CreationDate desc
        limit 1
    ) 
)
where r.UserRank <= 25
order by r.UserRank, cpi.AdjustedScore desc nulls last
limit 100;