WITH UserProfileSummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.Views AS UserProfileViews,
        U.UpVotes AS UserUpVotes,
        U.DownVotes AS UserDownVotes,
        U.LastAccessDate,
        COALESCE(U.Location, 'Unknown') AS UserLocation,
        EXTRACT(DAY FROM (TIMESTAMP '2024-10-01 12:34:56' - U.CreationDate)) AS AccountAgeDays,
        (SELECT COUNT(DISTINCT B.Id) FROM Badges B WHERE B.UserId = U.Id AND B.Class = 1) AS GoldBadgesCount,
        (SELECT COUNT(DISTINCT B.Id) FROM Badges B WHERE B.UserId = U.Id AND B.Class = 2) AS SilverBadgesCount
    FROM Users U
    WHERE U.Reputation >= 1000 AND U.DisplayName IS NOT NULL
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.Views, U.UpVotes, U.DownVotes, U.LastAccessDate, U.Location
    HAVING COUNT(U.Id) > 0
),
PostQuestionMetrics AS (
    SELECT
        Q.Id AS QuestionId,
        Q.Title AS QuestionTitle,
        Q.CreationDate AS QuestionCreationDate,
        Q.Score AS QuestionScore,
        Q.ViewCount AS QuestionViewCount,
        Q.OwnerUserId AS QuestionOwnerId,
        Q.AcceptedAnswerId,
        Q.AnswerCount,
        Q.CommentCount AS QuestionCommentCount,
        Q.FavoriteCount AS QuestionFavoriteCount,
        REPLACE(REPLACE(Q.Tags, '><', ','), '<', '') AS CleanedTags,
        A.Score AS AcceptedAnswerScore,
        A.OwnerUserId AS AcceptedAnswerOwnerId,
        PH_Close.CreationDate AS ClosedEventDate,
        CR.Name AS CloseReasonName,
        COUNT(V.Id) FILTER (WHERE V.VoteTypeId = 2) AS TotalUpVotesOnQuestion,
        COUNT(V.Id) FILTER (WHERE V.VoteTypeId = 3) AS TotalDownVotesOnQuestion,
        RANK() OVER (PARTITION BY Q.OwnerUserId ORDER BY Q.Score DESC, Q.CreationDate DESC) AS UserQuestionScoreRank,
        DENSE_RANK() OVER (ORDER BY Q.ViewCount DESC, Q.Score DESC) AS GlobalQuestionViewScoreRank,
        LAG(Q.CreationDate, 1, TIMESTAMP '1970-01-01') OVER (PARTITION BY Q.OwnerUserId ORDER BY Q.CreationDate) AS PreviousQuestionDate,
        NTILE(5) OVER (ORDER BY Q.ViewCount DESC) AS ViewCountQuintile,
        AVG(Q.Score) OVER (PARTITION BY Q.OwnerUserId) AS AvgQuestionScoreByOwner
    FROM Posts Q
    LEFT JOIN Posts A ON Q.AcceptedAnswerId = A.Id AND A.PostTypeId = 2
    LEFT JOIN Votes V ON Q.Id = V.PostId AND V.VoteTypeId IN (2, 3)
    LEFT JOIN PostHistory PH_Close ON Q.Id = PH_Close.PostId AND PH_Close.PostHistoryTypeId = 10
    LEFT JOIN CloseReasonTypes CR ON CAST(PH_Close.Comment AS SMALLINT) = CR.Id AND PH_Close.PostHistoryTypeId = 10
    WHERE Q.PostTypeId = 1
      AND Q.CreationDate BETWEEN TIMESTAMP '2018-01-01' AND TIMESTAMP '2023-12-31'
      AND Q.ViewCount IS NOT NULL
    GROUP BY
        Q.Id, Q.Title, Q.CreationDate, Q.Score, Q.ViewCount, Q.OwnerUserId, Q.AcceptedAnswerId, Q.AnswerCount, Q.CommentCount, Q.FavoriteCount, Q.Tags,
        A.Score, A.OwnerUserId, PH_Close.CreationDate, CR.Name
),
UnifiedActivityStream AS (
    SELECT
        P.OwnerUserId AS ActivityUserId,
        P.Id AS ActivityId,
        P.CreationDate AS ActivityDate,
        P.PostTypeId AS ActivityType,
        P.Score AS ActivityScore,
        'Post' AS ActivitySource,
        SUBSTRING(P.Body FROM 1 FOR 100) AS ActivityExcerpt,
        P.LastActivityDate
    FROM Posts P
    WHERE P.PostTypeId IN (1, 2) AND P.OwnerUserId IS NOT NULL
    UNION ALL
    SELECT
        C.UserId AS ActivityUserId,
        C.Id AS ActivityId,
        C.CreationDate AS ActivityDate,
        NULL AS ActivityType,
        C.Score AS ActivityScore,
        'Comment' AS ActivitySource,
        SUBSTRING(C.Text FROM 1 FOR 100) AS ActivityExcerpt,
        NULL AS LastActivityDate
    FROM Comments C
    WHERE C.UserId IS NOT NULL
),
PostEditAndLinkAnalysis AS (
    SELECT
        P.Id AS PostId,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (4,5,6) THEN PH.CreationDate ELSE NULL END) AS LastEditDate,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (12,13) THEN PH.CreationDate ELSE NULL END) AS LastDeleteUndeleteDate,
        COUNT(DISTINCT PH.Id) FILTER (WHERE PH.PostHistoryTypeId IN (4,5,6)) AS TotalEditEvents,
        SUM(CASE WHEN PL.LinkTypeId = 1 THEN 1 ELSE 0 END) AS LinkedPostsCount,
        SUM(CASE WHEN PL.LinkTypeId = 3 THEN 1 ELSE 0 END) AS DuplicatePostsCount,
        (SELECT COUNT(DISTINCT PH2.UserId) FROM PostHistory PH2 WHERE PH2.PostId = P.Id AND PH2.PostHistoryTypeId IN (4,5,6)) AS UniqueEditorsCount,
        AVG(LENGTH(PH.Text)) FILTER (WHERE PH.PostHistoryTypeId = 5 AND PH.Text IS NOT NULL) AS AvgBodyEditLengthChange
    FROM Posts P
    LEFT JOIN PostHistory PH ON P.Id = PH.PostId
    LEFT JOIN PostLinks PL ON P.Id = PL.PostId
    WHERE P.PostTypeId = 1
    GROUP BY P.Id
)
SELECT
    UPS.UserId,
    UPS.DisplayName,
    UPS.Reputation,
    UPS.AccountAgeDays,
    UPS.UserProfileViews,
    UPS.GoldBadgesCount,
    PQM.QuestionId,
    PQM.QuestionTitle,
    PQM.QuestionCreationDate,
    PQM.QuestionScore,
    PQM.QuestionViewCount,
    PQM.AnswerCount,
    PQM.QuestionCommentCount,
    PQM.QuestionFavoriteCount,
    PQM.CleanedTags,
    PQM.AcceptedAnswerScore,
    PQM.ClosedEventDate,
    PQM.CloseReasonName,
    PQM.TotalUpVotesOnQuestion,
    PQM.TotalDownVotesOnQuestion,
    PQM.UserQuestionScoreRank,
    PQM.GlobalQuestionViewScoreRank,
    EXTRACT(HOUR FROM (PQM.QuestionCreationDate - PQM.PreviousQuestionDate)) AS HoursSincePrevQuestion,
    PQM.ViewCountQuintile,
    PQM.AvgQuestionScoreByOwner,
    PEALA.LastEditDate AS QuestionLastEditDate,
    PEALA.TotalEditEvents,
    PEALA.LinkedPostsCount,
    PEALA.DuplicatePostsCount,
    PEALA.UniqueEditorsCount,
    (SELECT AVG(CAST(V.BountyAmount AS NUMERIC)) FROM Votes V WHERE V.PostId = PQM.QuestionId AND V.VoteTypeId = 8 AND V.BountyAmount IS NOT NULL) AS AvgBountyAmount,
    COALESCE(PLE.EventDate, TIMESTAMP '1900-01-01') AS LastRelevantPostHistoryEventDate,
    NULLIF(PLE.EventDetails, '') AS LastEventDetails,
    UAS_Agg.ActivityDate AS LatestUserActivityDate,
    UAS_Agg.ActivitySource AS LatestUserActivitySource,
    UAS_Agg.ActivityScore AS LatestUserActivityScore,
    CASE
        WHEN PQM.QuestionScore > 1000 AND PQM.AnswerCount > 10 THEN 'Elite Question'
        WHEN PQM.QuestionScore > 200 AND PQM.AnswerCount > 3 THEN 'High Impact Question'
        WHEN PQM.QuestionScore > 50 THEN 'Engaging Question'
        ELSE 'Standard Question'
    END AS QuestionImpactCategory,
    LENGTH(PQM.QuestionTitle) AS TitleLength,
    MAX(CASE WHEN LOWER(PQM.CleanedTags) LIKE '%sql%' THEN 1 ELSE 0 END) AS HasSqlTag,
    MAX(CASE WHEN LOWER(PQM.CleanedTags) LIKE '%python%' THEN 1 ELSE 0 END) AS HasPythonTag,
    ROW_NUMBER() OVER (PARTITION BY UPS.UserId ORDER BY PQM.QuestionScore DESC) AS UserTopQuestionSeq
FROM UserProfileSummary UPS
INNER JOIN PostQuestionMetrics PQM ON UPS.UserId = PQM.QuestionOwnerId
LEFT JOIN PostEditAndLinkAnalysis PEALA ON PQM.QuestionId = PEALA.PostId
LEFT JOIN (
    SELECT
        PH.PostId,
        PH.CreationDate AS EventDate,
        PH.Text AS EventDetails,
        PH.PostHistoryTypeId,
        ROW_NUMBER() OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate DESC) as rn
    FROM PostHistory PH
    WHERE PH.PostHistoryTypeId IN (1,2,3,4,5,6,10,11,12,13,14,15)
) PLE ON PQM.QuestionId = PLE.PostId AND PLE.rn = 1
LEFT JOIN (
    SELECT
        ActivityUserId,
        MAX(ActivityDate) AS ActivityDate,
        -- Derive latest ActivitySource and ActivityScore by choosing rows with the max ActivityDate
        MAX(ActivitySource) KEEP (DENSE_RANK FIRST ORDER BY ActivityDate DESC) OVER () FILTER (WHERE 1=0) AS ActivitySource,
        MAX(ActivityScore) KEEP (DENSE_RANK FIRST ORDER BY ActivityDate DESC) OVER () FILTER (WHERE 1=0) AS ActivityScore
    FROM (
        SELECT ActivityUserId, ActivityDate, ActivitySource, ActivityScore
        FROM UnifiedActivityStream
    ) t
    GROUP BY ActivityUserId
) UAS_Agg ON UPS.UserId = UAS_Agg.ActivityUserId
WHERE UPS.Reputation > 5000
  AND PQM.QuestionScore > 50
  AND PQM.ViewCountQuintile IN (1, 2)
  AND PQM.CleanedTags IS NOT NULL AND PQM.CleanedTags <> ''
GROUP BY
    UPS.UserId, UPS.DisplayName, UPS.Reputation, UPS.AccountAgeDays, UPS.UserProfileViews, UPS.GoldBadgesCount,
    PQM.QuestionId, PQM.QuestionTitle, PQM.QuestionCreationDate, PQM.QuestionScore, PQM.QuestionViewCount, PQM.AnswerCount,
    PQM.QuestionCommentCount, PQM.QuestionFavoriteCount, PQM.CleanedTags, PQM.AcceptedAnswerScore, PQM.ClosedEventDate, PQM.CloseReasonName,
    PQM.TotalUpVotesOnQuestion, PQM.TotalDownVotesOnQuestion, PQM.UserQuestionScoreRank, PQM.GlobalQuestionViewScoreRank, PQM.PreviousQuestionDate,
    PQM.ViewCountQuintile, PQM.AvgQuestionScoreByOwner, PEALA.LastEditDate, PEALA.TotalEditEvents, PEALA.LinkedPostsCount, PEALA.DuplicatePostsCount,
    PEALA.UniqueEditorsCount, PLE.EventDate, PLE.EventDetails, UAS_Agg.ActivityDate, UAS_Agg.ActivitySource, UAS_Agg.ActivityScore, PQM.CleanedTags
ORDER BY
    UPS.Reputation DESC,
    PQM.GlobalQuestionViewScoreRank ASC,
    PEALA.LastEditDate DESC,
    PQM.QuestionCreationDate DESC
LIMIT 2000;