    'Overall' AS UserIdentifier,
    '===== ' AS ReputationStars,
    0 AS FinalAnswerCount,
    0 AS FinalMaxAnswerScore,
    0 AS FinalAvgAnswerScore
FROM (
    SELECT 
        ca.UserId,
        ca.DisplayName,
        ca.Reputation,
        ca.PostCount,
        ca.CommentCount,
        ca.BadgeCount,
        ca.UserCategory,
        ca.QuestionId,
        ca.Title,
        ca.Score,
        ca.ViewCount,
        ca.AnswerCount,
        ca.CommentCount AS QuestionCommentCount,
        ca.QuestionStatus,
        ca.TagCount,
        ca.TagCategory,
        ca.AnswerCountWithAnswers,
        ca.AvgAnswerScore,
        ca.MaxAnswerScore,
        ca.QuestionQuality,
        ca.Popularity,
        ca.DaysSinceCreation,
        ca.DaysToFirstAnswer,
        ca.ScoreRank,
        ca.ViewRank,
        ca.PreviousScore,
        ca.ScoreChange,
        ca.HighlyRatedPopularWithAnswers
    FROM ComplexAnalysis ca
) t;