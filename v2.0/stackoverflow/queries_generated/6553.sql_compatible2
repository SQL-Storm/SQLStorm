SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    AVG(p.Score) AS AvgPostScore,
    AVG(p.ViewCount) AS AvgPostViews,
    STRING_AGG(DISTINCT t.TagName, ', ') AS PopularTags,
    COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN p.Id ELSE NULL END) AS TotalDuplicatePosts,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 1 THEN p.Id ELSE NULL END) AS TotalAcceptedAnswers,
    COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id ELSE NULL END) AS TotalGoldBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id ELSE NULL END) AS TotalSilverBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id ELSE NULL END) AS TotalBronzeBadges
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Tags t ON p.Id = t.PostId
LEFT JOIN 
    PostLinks pl ON p.Id = pl.PostId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId = 10
WHERE 
    u.Reputation > 10000
    AND p.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '1' YEAR)
    AND (ph.Comment IS NULL OR ph.Comment <> '101')
GROUP BY 
    u.Id,
    u.DisplayName,
    u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    u.Reputation DESC,
    TotalPosts DESC;