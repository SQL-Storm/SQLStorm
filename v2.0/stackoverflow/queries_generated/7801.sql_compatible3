WITH UserPostStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 3 THEN p.Id END) AS Wikis,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS TotalAnswerScore,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS AvgAnswerScore,
        MAX(p.CreationDate) AS LastPostDate,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        STRING_AGG(DISTINCT b.Name, ', ') AS BadgesEarned,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                (COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) * 100.0 / COUNT(DISTINCT p.Id))
            ELSE 0 
        END AS QuestionPercentage,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS UserRank,
        RANK() OVER (ORDER BY SUM(p.Score) DESC) AS ScoreRank,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS RepRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= CAST('2010-01-01' AS TIMESTAMP)
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopPostHistory AS (
    SELECT 
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.UserId,
        ph.CreationDate,
        ph.Comment,
        ph.Text,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS RecentEdit,
        CASE 
            WHEN ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6) THEN 'Edit'
            WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13) THEN 'StatusChange'
            WHEN ph.PostHistoryTypeId IN (17, 35, 36) THEN 'Migration'
            ELSE 'Other'
        END AS ActionCategory
    FROM PostHistory ph
    WHERE ph.CreationDate >= CAST('2015-01-01' AS TIMESTAMP)
),
UserEngagement AS (
    SELECT 
        u.Id AS UserId,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COUNT(DISTINCT v.Id) AS TotalVotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId IN (2, 3) THEN v.Id END) AS TotalUpVotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId IN (5, 8, 9) THEN v.Id END) AS TotalBountyVotes,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 1 THEN v.Id END) AS TotalAcceptVotes,
        AVG(EXTRACT(EPOCH FROM v.CreationDate)) AS AvgVoteEpoch,
        STRING_AGG(DISTINCT vt.Name, ', ') AS VoteTypesUsed
    FROM Users u
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    LEFT JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    WHERE u.CreationDate >= CAST('2010-01-01' AS TIMESTAMP)
    GROUP BY u.Id
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.IsRequired,
        t.IsModeratorOnly,
        p.Id AS PostId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        CASE 
            WHEN p.Score > 100 THEN 'High'
            WHEN p.Score > 50 THEN 'Medium'
            ELSE 'Low'
        END AS ScoreCategory,
        CASE 
            WHEN p.ViewCount > 1000 THEN 'Popular'
            WHEN p.ViewCount > 500 THEN 'Moderate'
            ELSE 'LessPopular'
        END AS PopularityCategory
    FROM Tags t
    INNER JOIN Posts p ON t.Id = p.Id
    WHERE p.PostTypeId = 1
),
CombinedAnalysis AS (
    SELECT 
        ups.UserId,
        ups.DisplayName,
        ups.Reputation,
        ups.TotalPosts,
        ups.Questions,
        ups.Answers,
        ups.Wikis,
        ups.TotalQuestionScore,
        ups.TotalAnswerScore,
        ups.AvgQuestionScore,
        ups.AvgAnswerScore,
        ups.LastPostDate,
        ups.BadgeCount,
        ups.BadgesEarned,
        ups.QuestionPercentage,
        ups.UserRank,
        ups.ScoreRank,
        ups.RepRank,
        ue.TotalComments,
        ue.TotalVotes,
        ue.TotalUpVotes,
        ue.TotalBountyVotes,
        ue.TotalAcceptVotes,
        (CASE WHEN ue.AvgVoteEpoch IS NOT NULL THEN to_timestamp(ue.AvgVoteEpoch) ELSE NULL END) AS AvgVoteDate,
        ue.VoteTypesUsed,
        ta.TagName,
        ta.Count AS TagCount,
        ta.Score AS PostScore,
        ta.ViewCount AS PostViews,
        ta.CreationDate AS PostCreationDate,
        ta.ScoreCategory,
        ta.PopularityCategory,
        CASE 
            WHEN ups.Reputation >= 10000 AND ups.TotalPosts >= 100 THEN 'Expert'
            WHEN ups.Reputation >= 5000 AND ups.TotalPosts >= 50 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS UserLevel,
        CASE 
            WHEN ups.Answers > ups.Questions THEN 'AnswerFocus'
            WHEN ups.Questions > ups.Answers THEN 'QuestionFocus'
            ELSE 'Balanced'
        END AS ContributionFocus,
        CAST((CAST('2024-10-01' AS DATE) - CAST(ups.LastPostDate AS DATE)) AS INTEGER) AS DaysSinceLastActivity
    FROM UserPostStats ups
    LEFT JOIN UserEngagement ue ON ups.UserId = ue.UserId
    LEFT JOIN TagAnalysis ta ON EXISTS (
        SELECT 1 FROM Posts p WHERE p.Id = ta.PostId AND p.OwnerUserId = ups.UserId
    )
)
SELECT 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.TotalPosts,
    ca.Questions,
    ca.Answers,
    ca.Wikis,
    ca.TotalQuestionScore,
    ca.TotalAnswerScore,
    ca.AvgQuestionScore,
    ca.AvgAnswerScore,
    ca.LastPostDate,
    ca.BadgeCount,
    ca.BadgesEarned,
    ca.QuestionPercentage,
    ca.UserRank,
    ca.ScoreRank,
    ca.RepRank,
    (COALESCE(ca.TotalComments,0) + COALESCE(ca.TotalVotes,0)) AS EngagementScore,
    CASE 
        WHEN COALESCE(ca.TotalComments,0) > 0 OR COALESCE(ca.TotalVotes,0) > 0 THEN 
            CAST((CAST(COALESCE(ca.TotalVotes,0) AS NUMERIC) / NULLIF(COALESCE(ca.TotalComments,0) + COALESCE(ca.TotalVotes,0), 0)) * 100 AS INTEGER)
        ELSE 0 
    END AS VoteToCommentRatio,
    ca.TotalComments,
    ca.TotalVotes,
    ca.TotalUpVotes,
    ca.TotalBountyVotes,
    ca.TotalAcceptVotes,
    ca.AvgVoteDate,
    ca.VoteTypesUsed,
    MAX(CASE WHEN ca.TagName IS NOT NULL THEN ca.TagName ELSE NULL END) AS AssociatedTag,
    MAX(CASE WHEN COALESCE(ca.TagCount,0) > 0 THEN ca.TagCount ELSE 0 END) AS MaxTagCount,
    MAX(CASE WHEN ca.ScoreCategory = 'High' THEN 1 ELSE 0 END) AS HasHighScorePosts,
    MAX(CASE WHEN ca.PopularityCategory = 'Popular' THEN 1 ELSE 0 END) AS HasPopularPosts,
    ca.UserLevel,
    ca.ContributionFocus,
    ca.DaysSinceLastActivity,
    CASE 
        WHEN ca.DaysSinceLastActivity <= 30 THEN 'Active'
        WHEN ca.DaysSinceLastActivity <= 90 THEN 'ModeratelyActive'
        ELSE 'Inactive'
    END AS ActivityStatus,
    COUNT(*) OVER () AS TotalUsers,
    AVG(ca.Reputation) OVER () AS AvgReputation,
    AVG(ca.TotalPosts) OVER () AS AvgPostCount,
    STRING_AGG(DISTINCT ca.BadgesEarned, '; ') AS AllBadgesCombined,
    STRING_AGG(DISTINCT ca.VoteTypesUsed, '; ') AS AllVoteTypesUsed,
    CONCAT(
        'UserRank:', ca.UserRank, 
        '|ScoreRank:', ca.ScoreRank, 
        '|RepRank:', ca.RepRank,
        '|Level:', ca.UserLevel,
        '|Focus:', ca.ContributionFocus,
        '|Status:', 
        CASE 
            WHEN ca.DaysSinceLastActivity <= 30 THEN 'Active'
            WHEN ca.DaysSinceLastActivity <= 90 THEN 'ModeratelyActive'
            ELSE 'Inactive'
        END
    ) AS UserProfileSummary,
    CASE 
        WHEN ca.Reputation >= (SELECT AVG(u.Reputation) FROM Users u WHERE u.CreationDate >= CAST('2010-01-01' AS TIMESTAMP)) 
         AND ca.TotalPosts >= (SELECT AVG(ups.TotalPosts) FROM UserPostStats ups) THEN 1 
        ELSE 0 
    END AS AboveAverageUser,
    ROW_NUMBER() OVER (ORDER BY ca.Reputation DESC, ca.TotalPosts DESC) AS OverallRank
FROM CombinedAnalysis ca
WHERE ca.UserId IS NOT NULL
GROUP BY 
    ca.UserId, 
    ca.DisplayName, 
    ca.Reputation, 
    ca.TotalPosts, 
    ca.Questions, 
    ca.Answers, 
    ca.Wikis, 
    ca.TotalQuestionScore, 
    ca.TotalAnswerScore, 
    ca.AvgQuestionScore, 
    ca.AvgAnswerScore, 
    ca.LastPostDate, 
    ca.BadgeCount, 
    ca.BadgesEarned, 
    ca.QuestionPercentage, 
    ca.UserRank, 
    ca.ScoreRank, 
    ca.RepRank, 
    ca.TotalComments, 
    ca.TotalVotes, 
    ca.TotalUpVotes, 
    ca.TotalBountyVotes, 
    ca.TotalAcceptVotes, 
    ca.AvgVoteDate, 
    ca.VoteTypesUsed, 
    ca.UserLevel, 
    ca.ContributionFocus, 
    ca.DaysSinceLastActivity
HAVING 
    MAX(ca.TotalPosts) > 0
    AND (MAX(ca.TotalVotes) > 0 OR MAX(ca.TotalComments) > 0)
ORDER BY 
    ca.Reputation DESC, 
    ca.TotalPosts DESC,
    ca.ScoreRank ASC
LIMIT 5000;