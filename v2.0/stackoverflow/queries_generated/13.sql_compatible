with params as (
    select
        date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) - interval '24 months' as start_month,
        date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) - interval '1 month' as end_month,
        100 as min_rep_for_power_users
),
months as (
    select generate_series(p.start_month, p.end_month, interval '1 month')::date as month_start
    from params p
),
q_posts as (
    select
        p.Id,
        p.OwnerUserId,
        cast(p.CreationDate as date) as created_on,
        cast(date_trunc('month', p.CreationDate) as date) as month_start,
        coalesce(p.ViewCount, 0) as views,
        coalesce(p.Score, 0) as score,
        coalesce(p.FavoriteCount, 0) as favs,
        p.ClosedDate,
        (p.Tags is not null) as has_tags,
        p.Tags
    from Posts p
    where p.PostTypeId = 1
      and p.CreationDate >= (select start_month from params)
),
answers as (
    select
        a.ParentId as QuestionId,
        count(*) filter (where a.CreationDate < coalesce(q.AcceptedAnswerId, 0)::text::timestamp) as pre_accept_answers,
        count(*) as total_answers,
        max(a.Score) as max_answer_score,
        max(a.CreationDate) as last_answer_date
    from Posts a
    join Posts q on q.Id = a.ParentId and a.PostTypeId = 2
    group by a.ParentId
),
votes_by_type as (
    select
        v.PostId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as upvotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as downvotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as favorites,
        sum(case when v.VoteTypeId in (8,9) then coalesce(v.BountyAmount,0) else 0 end) as bounty_total
    from Votes v
    group by v.PostId
),
comments_agg as (
    select
        c.PostId,
        count(*) as comment_count,
        max(c.Score) as max_comment_score,
        avg(nullif(c.Score,0)) filter (where c.Score is not null) as avg_nonzero_comment_score
    from Comments c
    group by c.PostId
),
postlinks_agg as (
    select
        pl.PostId,
        sum(case when pl.LinkTypeId = 1 then 1 else 0 end) as linked_out,
        sum(case when pl.LinkTypeId = 3 then 1 else 0 end) as duplicate_of
    from PostLinks pl
    group by pl.PostId
),
close_events as (
    select
        ph.PostId,
        min(ph.CreationDate) as first_close_date,
        max(ph.CreationDate) as last_close_date,
        count(*) filter (where ph.PostHistoryTypeId = 10) as close_votes_logged
    from PostHistory ph
    where ph.PostHistoryTypeId in (10,11)
    group by ph.PostId
),
user_dim as (
    select
        u.Id as UserId,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        u.Views,
        cast(u.CreationDate as date) as user_created_on,
        coalesce(nullif(trim(coalesce(u.Location,'')),''), 'Unknown') as location_norm,
        (u.Reputation >= (select min_rep_for_power_users from params)) as is_power_user
    from Users u
),
tag_expanded as (
    select
        q.Id as PostId,
        unnest(string_to_array(substring(q.Tags, 2, length(q.Tags)-2), '><')) as tag
    from q_posts q
    where q.Tags is not null and q.Tags like '<%>'
),
tag_stats as (
    select
        te.PostId,
        array_agg(distinct te.tag order by te.tag) as tags_array,
        count(*) as tag_count,
        bool_or(te.tag ilike any (array['%sql%','%postgres%','%mysql%'])) as has_db_tag
    from tag_expanded te
    group by te.PostId
),
user_activity_window as (
    select
        q.OwnerUserId as UserId,
        q.month_start,
        count(*) as questions_in_month,
        sum(q.views) as views_in_month,
        sum(q.score) as score_in_month,
        row_number() over (partition by q.OwnerUserId order by q.month_start desc) as rn,
        sum(q.score) over (partition by q.OwnerUserId order by q.month_start rows between unbounded preceding and current row) as cum_score,
        avg(q.score) over (partition by q.OwnerUserId order by q.month_start rows between 2 preceding and current row) as moving_avg_3m_score
    from q_posts q
    group by q.OwnerUserId, q.month_start
),
user_month_padded as (
    select
        m.month_start,
        u.UserId
    from months m
    cross join (select distinct OwnerUserId as UserId from q_posts where OwnerUserId is not null) u
),
user_activity_full as (
    select
        p.UserId,
        p.month_start,
        coalesce(ua.questions_in_month,0) as questions_in_month,
        coalesce(ua.views_in_month,0) as views_in_month,
        coalesce(ua.score_in_month,0) as score_in_month
    from user_month_padded p
    left join user_activity_window ua
      on ua.UserId = p.UserId and ua.month_start = p.month_start
),
user_trends as (
    select
        uaf.UserId,
        uaf.month_start,
        uaf.questions_in_month,
        uaf.views_in_month,
        uaf.score_in_month,
        sum(uaf.questions_in_month) over (partition by uaf.UserId order by uaf.month_start rows between 5 preceding and current row) as q_6m_sum,
        stddev_pop(nullif(uaf.score_in_month,0)) over (partition by uaf.UserId order by uaf.month_start rows between 11 preceding and current row) as score_12m_stddev,
        rank() over (partition by uaf.UserId order by uaf.score_in_month desc, uaf.views_in_month desc) as best_month_rank
    from user_activity_full uaf
),
baseline as (
    select
        q.Id as PostId,
        q.OwnerUserId,
        q.month_start,
        q.created_on,
        q.views,
        q.score,
        q.favs,
        q.ClosedDate,
        q.has_tags,
        vd.upvotes,
        vd.downvotes,
        vd.favorites as vote_favorites,
        vd.bounty_total,
        coalesce(ca.comment_count,0) as comment_count,
        ca.max_comment_score,
        ca.avg_nonzero_comment_score,
        pa.linked_out,
        pa.duplicate_of,
        ce.first_close_date,
        ce.last_close_date
    from q_posts q
    left join votes_by_type vd on vd.PostId = q.Id
    left join comments_agg ca on ca.PostId = q.Id
    left join postlinks_agg pa on pa.PostId = q.Id
    left join close_events ce on ce.PostId = q.Id
),
augmented as (
    select
        b.*,
        ts.tags_array,
        ts.tag_count,
        ts.has_db_tag,
        ud.Reputation,
        ud.UpVotes as user_upvotes,
        ud.DownVotes as user_downvotes,
        ud.Views as user_profile_views,
        ud.user_created_on,
        ud.location_norm,
        ud.is_power_user,
        at.total_answers,
        at.max_answer_score,
        at.last_answer_date,
        case
            when b.ClosedDate is not null then 'Closed'
            when coalesce(pa.duplicate_of,0) > 0 then 'DuplicateFlag'
            when b.score < 0 then 'Controversial'
            when b.views > 10000 then 'Popular'
            else 'Normal'
        end as post_bucket,
        greatest(coalesce(b.views,0), coalesce(b.score,0) * 10) as attention_score,
        nullif(b.vote_favorites, 0) as nonzero_favs,
        (coalesce(b.upvotes,0) - coalesce(b.downvotes,0)) as net_votes,
        -- replace FILTER with conditional sum to be more portable
        CASE WHEN b.created_on >= (select start_month from params) THEN (coalesce(b.upvotes,0) + coalesce(b.downvotes,0)) ELSE 0 END as votes_recent_window,
        case when ud.Reputation = 0 then null else (cast(b.score as numeric) / cast(ud.Reputation as numeric)) end as score_per_rep,
        array_length(ts.tags_array,1) as tag_array_len,
        (select count(*) from Comments c where c.PostId = b.PostId and c.Score > 0) as pos_comment_count,
        exists (select 1 from Badges bb where bb.UserId = b.OwnerUserId and bb.Class = 1) as has_gold_badge
    from baseline b
    left join tag_stats ts on ts.PostId = b.PostId
    left join user_dim ud on ud.UserId = b.OwnerUserId
    left join answers at on at.QuestionId = b.PostId
    left join postlinks_agg pa on pa.PostId = b.PostId
),
ranked as (
    select
        a.*,
        row_number() over (partition by a.OwnerUserId order by a.attention_score desc, a.score desc, a.views desc, a.PostId) as rn_user_attention,
        dense_rank() over (order by a.attention_score desc) as site_attention_rank,
        percent_rank() over (order by a.net_votes) as net_votes_percentile,
        ntile(20) over (order by coalesce(a.score,0)) as score_ventile
    from augmented a
),
user_rollup as (
    select
        a.OwnerUserId,
        count(*) as q_count,
        sum(a.views) as sum_views,
        sum(a.score) as sum_score,
        avg(a.score) as avg_score,
        sum(case when a.has_db_tag then 1 else 0 end) as db_tag_qs,
        max(a.attention_score) as max_attention,
        min(a.created_on) as first_q_date
    from augmented a
    group by a.OwnerUserId
),
top_users as (
    select
        ur.*,
        rank() over (order by ur.sum_score desc, ur.sum_views desc) as user_perf_rank
    from user_rollup ur
),
final_set as (
    select
        r.PostId,
        r.OwnerUserId,
        r.created_on,
        r.month_start,
        r.views,
        r.score,
        r.net_votes,
        r.vote_favorites,
        r.bounty_total,
        r.comment_count,
        r.tag_count,
        r.tags_array,
        r.post_bucket,
        r.attention_score,
        r.site_attention_rank,
        r.rn_user_attention,
        r.score_ventile,
        coalesce(ut.user_perf_rank, 999999) as user_perf_rank,
        r.has_db_tag,
        r.is_power_user,
        r.location_norm,
        r.user_created_on,
        r.Reputation
    from ranked r
    left join top_users ut on ut.OwnerUserId = r.OwnerUserId
    where coalesce(r.views,0) + coalesce(r.score,0) + coalesce(r.comment_count,0) > 0
),
combined as (
    select * from final_set
    union all
    select * from final_set where has_db_tag
    except
    select * from final_set where post_bucket = 'Closed'
),
with_flags as (
    select
        c.*,
        case when c.user_perf_rank <= 100 then true else false end as is_top100_user,
        case when c.score_ventile >= 19 then true else false end as is_top5pct_score,
        case when c.site_attention_rank <= 1000 then true else false end as is_top1k_attention
    from combined c
)
select
    wf.PostId,
    wf.OwnerUserId,
    wf.created_on,
    wf.month_start,
    wf.views,
    wf.score,
    wf.net_votes,
    wf.vote_favorites,
    wf.bounty_total,
    wf.comment_count,
    wf.tag_count,
    wf.tags_array,
    wf.post_bucket,
    wf.attention_score,
    wf.site_attention_rank,
    wf.rn_user_attention,
    wf.score_ventile,
    wf.user_perf_rank,
    wf.has_db_tag,
    wf.is_power_user,
    wf.location_norm,
    wf.user_created_on,
    wf.Reputation,
    wf.is_top100_user,
    wf.is_top5pct_score,
    wf.is_top1k_attention,
    (
        select avg(v2.BountyAmount)
        from Votes v2
        where v2.PostId = wf.PostId
          and v2.VoteTypeId in (8,9)
          and v2.CreationDate between wf.created_on and coalesce(wf.created_on + interval '365 days', cast('2024-10-01 12:34:56' as timestamp))
    ) as avg_bounty_next_year,
    coalesce(array_to_string(wf.tags_array, '|'), 'no-tags') as tags_pipe,
    case
        when wf.location_norm ilike any (array['%us%','%usa%','%united states%']) then 'US-ish'
        when wf.location_norm ilike '%india%' then 'India'
        when wf.location_norm = 'Unknown' then 'Unknown'
        else 'Other'
    end as region_guess
from with_flags wf
where
    (
        wf.is_top100_user
        or wf.is_top5pct_score
        or (wf.is_power_user and wf.has_db_tag)
    )
    and wf.created_on >= (select start_month from params)
order by wf.site_attention_rank, wf.rn_user_attention
limit 500;