with recent_users as (
  select
    u.id as user_id,
    u.displayname,
    u.reputation,
    u.creationdate,
    date_trunc('month', u.creationdate) as cohort_month,
    u.upvotes,
    u.downvotes,
    u.views,
    coalesce(nullif(trim(u.location), ''), 'Unknown') as norm_location
  from users u
  where u.creationdate >= (select date_trunc('year', max(creationdate)) - interval '3 years' from users)
),
q_and_a as (
  select
    p.id,
    p.posttypeid,
    p.owneruserid,
    p.score,
    p.viewcount,
    p.favoritecount,
    p.commentcount,
    p.creationdate,
    p.lastactivitydate,
    p.title,
    p.tags,
    case when p.posttypeid = 1 then 'Question'
         when p.posttypeid = 2 then 'Answer'
         else 'Other' end as post_type_name,
    case
      when p.tags is null then array[]::text[]  -- keep array literal but as text[]
      else string_to_array(substring(p.tags, 2, length(p.tags)-2), '><')
    end as tag_array
  from posts p
  where p.posttypeid in (1,2) and p.creationdate is not null
),
user_posts as (
  select
    ru.user_id,
    ru.cohort_month,
    qa.post_type_name,
    count(*) as post_count,
    sum(qa.score) as total_score,
    avg(qa.score) as avg_score,
    sum(coalesce(qa.viewcount,0)) as total_views,
    sum(coalesce(qa.favoritecount,0)) as total_favs,
    sum(coalesce(qa.commentcount,0)) as total_comments,
    min(qa.creationdate) as first_post_at,
    max(qa.lastactivitydate) as last_activity_at
  from recent_users ru
  left join q_and_a qa on qa.owneruserid = ru.user_id
  group by ru.user_id, ru.cohort_month, qa.post_type_name
),
tag_expansion as (
  select
    qa.id as post_id,
    qa.owneruserid as user_id,
    unnest(qa.tag_array) as tagname
  from q_and_a qa
  where qa.post_type_name = 'Question'
),
top_user_tags as (
  select
    te.user_id,
    te.tagname,
    count(*) as tag_uses,
    row_number() over (partition by te.user_id order by count(*) desc, te.tagname) as rn
  from tag_expansion te
  group by te.user_id, te.tagname
),
badge_summary as (
  select
    b.userid as user_id,
    sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
    sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
    sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
    sum(case when coalesce(b.tagbased, false) = true then 1 else 0 end) as tag_badges,
    min(b.date) as first_badge_date,
    max(b.date) as last_badge_date
  from badges b
  group by b.userid
),
votes_agg as (
  select
    v.postid,
    sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
    sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
    sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded
  from votes v
  group by v.postid
),
user_vote_impact as (
  select
    qa.owneruserid as user_id,
    sum(coalesce(va.upvotes,0)) as post_upvotes_received,
    sum(coalesce(va.downvotes,0)) as post_downvotes_received,
    sum(coalesce(va.bounty_awarded,0)) as bounty_awarded_total
  from q_and_a qa
  left join votes_agg va on va.postid = qa.id
  group by qa.owneruserid
),
commenters as (
  select
    c.postid,
    count(*) as comment_count,
    count(distinct c.userid) filter (where c.userid is not null) as distinct_commenters
  from comments c
  group by c.postid
),
closed_questions as (
  select
    ph.postid,
    min(ph.creationdate) as first_closed_at,
    max(ph.creationdate) as last_closed_at,
    max(case when ph.posthistorytypeid = 10 then 1 else 0 end) as ever_closed
  from posthistory ph
  where ph.posthistorytypeid in (10,11)
  group by ph.postid
),
duplicates as (
  select
    pl.postid as duplicate_post_id,
    pl.relatedpostid as original_post_id,
    min(pl.creationdate) as first_linked_at
  from postlinks pl
  where pl.linktypeid = 3
  group by pl.postid, pl.relatedpostid
),
user_q_summary as (
  select
    qa.owneruserid as user_id,
    count(*) filter (where qa.post_type_name = 'Question') as questions,
    count(*) filter (where qa.post_type_name = 'Answer') as answers,
    count(*) filter (where cq.ever_closed = 1) as closed_questions,
    count(*) filter (where d.duplicate_post_id is not null) as duplicates_marked,
    avg(extract(epoch from (qa.lastactivitydate - qa.creationdate))/3600.0) as avg_active_hours
  from q_and_a qa
  left join closed_questions cq on cq.postid = qa.id
  left join duplicates d on d.duplicate_post_id = qa.id
  group by qa.owneruserid
),
monthly_engagement as (
  select
    ru.user_id,
    date_trunc('month', qa.creationdate) as month,
    count(*) as posts_in_month,
    sum(coalesce(qa.score,0)) as score_in_month
  from recent_users ru
  left join q_and_a qa on qa.owneruserid = ru.user_id
  group by ru.user_id, date_trunc('month', qa.creationdate)
),
month_stats as (
  select
    me.user_id,
    avg(me.posts_in_month) over (partition by me.user_id) as avg_posts_pm,
    stddev_pop(me.posts_in_month) over (partition by me.user_id) as sd_posts_pm,
    avg(me.score_in_month) over (partition by me.user_id) as avg_score_pm
  from monthly_engagement me
),
last_activity_gap as (
  select distinct on (qa.owneruserid)
    qa.owneruserid as user_id,
    extract(epoch from (clock_timestamp() - qa.lastactivitydate))/86400.0 as days_since_last_activity
  from q_and_a qa
  where qa.lastactivitydate is not null
  order by qa.owneruserid, qa.lastactivitydate desc
),
string_features as (
  select
    qa.owneruserid as user_id,
    sum(case when qa.title ilike '%how to%' then 1 else 0 end) as howto_titles,
    sum(case when qa.title ~* '(why|what|how|when|where)\b' then 1 else 0 end) as wh_titles,
    sum(case when qa.tags ilike '%<sql>%' then 1 else 0 end) as has_sql_tag,
    sum(length(coalesce(qa.title,''))) as total_title_len
  from q_and_a qa
  where qa.post_type_name = 'Question'
  group by qa.owneruserid
),
cohort_rank as (
  select
    ru.user_id,
    ru.cohort_month,
    rank() over (partition by ru.cohort_month order by ru.reputation desc, ru.user_id) as rep_rank_in_cohort
  from recent_users ru
),
user_activity as (
  select
    ru.user_id,
    ru.displayname,
    ru.reputation,
    ru.cohort_month,
    ru.norm_location,
    coalesce(max(case when up.post_type_name = 'Question' then up.post_count end),0) as q_posts,
    coalesce(max(case when up.post_type_name = 'Answer' then up.post_count end),0) as a_posts,
    coalesce(max(case when up.post_type_name = 'Question' then up.total_score end),0) as q_score,
    coalesce(max(case when up.post_type_name = 'Answer' then up.total_score end),0) as a_score,
    coalesce(max(up.first_post_at), null) as first_post_at,
    coalesce(max(up.last_activity_at), null) as last_activity_at,
    coalesce(b.gold_badges,0) as gold_badges,
    coalesce(b.silver_badges,0) as silver_badges,
    coalesce(b.bronze_badges,0) as bronze_badges,
    coalesce(b.tag_badges,0) as tag_badges
  from recent_users ru
  left join user_posts up on up.user_id = ru.user_id
  left join badge_summary b on b.user_id = ru.user_id
  group by
    ru.user_id, ru.displayname, ru.reputation, ru.cohort_month, ru.norm_location,
    b.gold_badges, b.silver_badges, b.bronze_badges, b.tag_badges
),
top_tag as (
  select
    tut.user_id,
    tut.tagname as top_tag,
    tut.tag_uses
  from top_user_tags tut
  where tut.rn = 1
),
score_percentiles as (
  select
    ua.user_id,
    percent_rank() over (order by (ua.q_score + ua.a_score) nulls first) as score_percentile
  from user_activity ua
),
anomalies as (
  select
    ua.user_id,
    case
      when ua.q_posts + ua.a_posts = 0 and ua.reputation > 1000 then 'high_rep_no_posts'
      when ua.q_posts > 0 and ua.a_posts = 0 and ua.q_score < 0 then 'negative_questions_only'
      when ua.a_posts > 50 and ua.a_score = 0 then 'many_answers_zero_score'
      else null
    end as anomaly_flag
  from user_activity ua
),
final_agg as (
  select
    ua.user_id,
    ua.displayname,
    ua.reputation,
    ua.cohort_month,
    cr.rep_rank_in_cohort,
    ua.norm_location as location,
    ua.q_posts,
    ua.a_posts,
    ua.q_score,
    ua.a_score,
    (ua.q_score + ua.a_score) as total_score,
    round((cast(ua.q_score as numeric) / nullif(ua.q_posts,0)) , 2) as avg_q_score,
    round((cast(ua.a_score as numeric) / nullif(ua.a_posts,0)) , 2) as avg_a_score,
    ua.first_post_at,
    ua.last_activity_at,
    coalesce(uvi.post_upvotes_received,0) as post_upvotes_received,
    coalesce(uvi.post_downvotes_received,0) as post_downvotes_received,
    coalesce(uvi.bounty_awarded_total,0) as bounty_awarded_total,
    coalesce(uqs.questions,0) as questions_total,
    coalesce(uqs.answers,0) as answers_total,
    coalesce(uqs.closed_questions,0) as closed_questions,
    coalesce(uqs.duplicates_marked,0) as duplicates_marked,
    round(uqs.avg_active_hours,2) as avg_active_hours,
    coalesce(sf.howto_titles,0) as howto_titles,
    coalesce(sf.wh_titles,0) as wh_titles,
    coalesce(sf.has_sql_tag,0) as has_sql_tag,
    coalesce(sf.total_title_len,0) as total_title_len,
    coalesce(tt.top_tag, '(none)') as top_tag,
    coalesce(tt.tag_uses,0) as top_tag_uses,
    coalesce(ms.avg_posts_pm,0) as avg_posts_per_month,
    coalesce(ms.sd_posts_pm,0.0) as sd_posts_per_month,
    coalesce(ms.avg_score_pm,0) as avg_score_per_month,
    coalesce(lag.days_since_last_activity, null) as days_since_last_activity,
    sp.score_percentile,
    a.anomaly_flag
  from user_activity ua
  left join user_vote_impact uvi on uvi.user_id = ua.user_id
  left join user_q_summary uqs on uqs.user_id = ua.user_id
  left join string_features sf on sf.user_id = ua.user_id
  left join top_tag tt on tt.user_id = ua.user_id
  left join month_stats ms on ms.user_id = ua.user_id
  left join last_activity_gap lag on lag.user_id = ua.user_id
  left join score_percentiles sp on sp.user_id = ua.user_id
  left join anomalies a on a.user_id = ua.user_id
  left join cohort_rank cr on cr.user_id = ua.user_id
),
ranked as (
  select
    fa.*,
    row_number() over (
      order by
        (fa.total_score) desc nulls last,
        fa.bounty_awarded_total desc,
        fa.q_posts + fa.a_posts desc
    ) as global_rank,
    dense_rank() over (
      partition by date_trunc('year', fa.cohort_month)
      order by fa.total_score desc nulls last
    ) as year_rank,
    sum(coalesce(fa.total_score,0)) over (order by fa.user_id rows between unbounded preceding and current row) as running_score_sum
  from final_agg fa
)
select
  r.user_id,
  r.displayname,
  r.reputation,
  r.location,
  r.cohort_month,
  r.rep_rank_in_cohort,
  r.global_rank,
  r.year_rank,
  r.total_score,
  r.avg_q_score,
  r.avg_a_score,
  r.q_posts,
  r.a_posts,
  r.closed_questions,
  r.duplicates_marked,
  r.post_upvotes_received,
  r.post_downvotes_received,
  r.bounty_awarded_total,
  r.top_tag,
  r.top_tag_uses,
  r.avg_posts_per_month,
  r.sd_posts_per_month,
  r.avg_score_per_month,
  r.days_since_last_activity,
  r.score_percentile,
  r.anomaly_flag,
  r.running_score_sum
from ranked r
where
  (r.total_score is not null and r.total_score >= (
     select percentile_disc(0.75) within group (order by total_score) from ranked
   ))
  or r.anomaly_flag is not null
order by r.global_rank nulls last, r.user_id
limit 250;