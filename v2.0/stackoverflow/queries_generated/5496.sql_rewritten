WITH
-- recent activity per post with various metrics
RecentActivity AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.Title,
    p.CreationDate,
    p.LastActivityDate,
    p.OwnerUserId,
    p.ViewCount,
    p.Score,
    p.AnswerCount,
    p.CommentCount,
    p.Tags,
    COALESCE(v1.CntUp,0) AS UpVotes,
    COALESCE(v2.CntDown,0) AS DownVotes,
    COALESCE(lk.CountLinks,0) AS LinkedPosts,
    COALESCE(pv.BountyTotal,0) AS BountyTotal,
    u.Reputation,
    u.DisplayName
  FROM
    Posts p
    LEFT JOIN (
      SELECT PostId, SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS CntUp,
                         SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS CntDown
      FROM Votes
      GROUP BY PostId
    ) v ON p.Id = v.PostId
    LEFT JOIN (
      SELECT PostId, COUNT(*) AS CountLinks
      FROM PostLinks
      GROUP BY PostId
    ) lk ON p.Id = lk.PostId
    LEFT JOIN (
      SELECT PostId, SUM(BountyAmount) AS BountyTotal
      FROM Votes
      WHERE VoteTypeId = 8 OR VoteTypeId = 9
      GROUP BY PostId
    ) pv ON p.Id = pv.PostId
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE
    p.PostTypeId IN (1,2) -- questions and answers
),
-- filter to a subset with complex predicates and calculations
Filtered AS (
  SELECT
    ra.*,
    -- compute a desirability score combining activity and reputation
    (CASE WHEN ra.ViewCount > 0 THEN (ra.Score::float / NULLIF(ra.ViewCount,0)) ELSE 0 END) +
    (CASE WHEN ra.Reputation IS NOT NULL THEN LOG(1 + ra.Reputation) ELSE 0 END) AS Desirability
  FROM RecentActivity ra
  WHERE
    ra.CreationDate >= DATEADD(DAY,-180, cast('2024-10-01 12:34:56' as timestamp)) -- last 180 days
    AND ra.LastActivityDate >= DATEADD(DAY,-60, cast('2024-10-01 12:34:56' as timestamp)) -- active in last 60 days
    AND (ra.BountyTotal IS NULL OR ra.BountyTotal < 1000)
),
-- compute windowed rankings per post type
Ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (PARTITION BY PostTypeId ORDER BY Desirability DESC, LastActivityDate DESC) AS RankWithinType
  FROM Filtered
),
-- outer join to add a synthetic tag-derived context for more complexity
TagContext AS (
  SELECT
    r.*,
    t.TagName,
    t.Count AS TagCount,
    CASE WHEN t.IsModeratorOnly = 1 THEN 'MOD_ONLY' ELSE 'OPEN' END AS TagAccessibility
  FROM Ranked r
  LEFT JOIN (
    SELECT
      unnest(string_to_array(replace(replace(r.Tags,'>','<'),'<>',''), '<')) AS TagName, -- rough tag extraction
      COUNT(*) AS Count
    FROM Posts
    GROUP BY TagName
  ) t ON TRUE
)
SELECT
  rc.PostId,
  rc.Title,
  rc.PostTypeId,
  rc.CreationDate,
  rc.LastActivityDate,
  rc.OwnerUserId,
  rc.ViewCount,
  rc.Score,
  rc.AnswerCount,
  rc.CommentCount,
  rc.Tags,
  rc.UpVotes,
  rc.DownVotes,
  rc.LinkedPosts,
  rc.BountyTotal,
  rc.Reputation,
  rc.DisplayName,
  rc.Desirability,
  rc.RankWithinType,
  tc.TagName,
  tc.TagCount,
  tc.TagAccessibility
FROM TagContext rc
LEFT JOIN PostLinks pl ON rc.PostId = pl.PostId
LEFT JOIN (
  SELECT Id, Name AS TagName FROM Tags WHERE IsModeratorOnly = 0
) t ON TRUE
ORDER BY rc.RankWithinType ASC, rc.LastActivityDate DESC
LIMIT 500;