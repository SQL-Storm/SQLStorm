SELECT 
    u.DisplayName,
    u.Reputation,
    u.Location,
    COUNT(DISTINCT v.PostId) AS TotalVotes,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) AS TotalQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id ELSE NULL END) AS TotalAnswers,
    MAX(p.Score) AS HighestScoredPost,
    MIN(p.Score) AS LowestScoredPost,
    STRING_AGG(DISTINCT t.TagName, ', ') AS MostCommonTags
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON u.Id = v.UserId
LEFT JOIN 
    -- convert XML/array-like tag storage to rows: assume Tags stored like '<tag1><tag2>'
    -- use a safe lateral split compatible approach where available; here using simple replace+split functions for SQL dialects that support regexp or replace
    (SELECT p2.Id AS PostId, TRIM(tag) AS TagName
     FROM Posts p2,
     (SELECT regexp_split_to_table(replace(replace(p2.Tags, '&lt;', '<'), '&gt;', '>'), '><') AS tag) s
    ) t ON p.Id = t.PostId
WHERE 
    u.Reputation > 1000
    AND p.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '1 year')
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, u.Location
HAVING 
    COUNT(DISTINCT v.PostId) > 50
ORDER BY 
    TotalPosts DESC, 
    HighestScoredPost DESC
LIMIT 100;