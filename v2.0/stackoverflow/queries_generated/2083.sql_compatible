WITH RecursiveUserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsAsked,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswersGiven,
        SUM(COALESCE(p.Score,0)) AS TotalPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.LastAccessDate DESC) AS UserRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
), 
TopUsers AS (
    SELECT * 
    FROM RecursiveUserActivity
    WHERE UserRank <= 50
),
PostAnswerStats AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId AS QuestionOwner,
        q.CreationDate AS QuestionCreationDate,
        (SELECT COUNT(*) FROM Posts a WHERE a.ParentId = q.Id AND a.PostTypeId = 2) AS AnswerCount,
        (SELECT AVG(a.Score) FROM Posts a WHERE a.ParentId = q.Id AND a.PostTypeId = 2) AS AvgAnswerScore,
        (SELECT COUNT(DISTINCT v.UserId) 
         FROM Votes v 
         JOIN Posts a2 ON a2.Id = v.PostId 
         WHERE a2.ParentId = q.Id AND a2.PostTypeId = 2 AND v.VoteTypeId = 2) AS UniqueUpvotersOnAnswers,
        q.Score AS QuestionScore,
        q.ViewCount,
        q.Tags,
        LAG(q.Score) OVER (ORDER BY q.CreationDate) AS PreviousQuestionScore,
        LEAD(q.Score) OVER (ORDER BY q.CreationDate) AS NextQuestionScore
    FROM Posts q
    WHERE q.PostTypeId = 1
),
UserBadgeAggregate AS (
    SELECT
        b.UserId,
        COUNT(*) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        STRING_AGG(DISTINCT b.Name, ', ') FILTER (WHERE b.Date > CAST('2024-10-01' AS date) - INTERVAL '365 days') AS RecentDistinctBadges
    FROM Badges b
    GROUP BY b.UserId
),
UserTopQuestionStats AS (
    SELECT
        p.OwnerUserId,
        COUNT(*) AS UserTopQuestionsCount,
        AVG(p.Score) AS AvgTopQuestionScore,
        MAX(p.Score) AS MaxTopQuestionScore,
        MIN(p.Score) AS MinTopQuestionScore
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.Score > 50
    GROUP BY p.OwnerUserId
),
CloseVoteSummary AS (
    SELECT
        ph.PostId,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 10) AS CloseVotes,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 11) AS ReopenVotes,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 12) AS Deletes,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 13) AS Undeletes,
        MAX(ph.CreationDate) AS LastCloseVoteDate,
        MAX(
            COALESCE(
                (SELECT crt.Name FROM CloseReasonTypes crt WHERE crt.Id = NULLIF(ph.Comment, '')::integer LIMIT 1),
                'Unknown'
            )
        ) AS LastCloseReason
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (10, 11, 12, 13)
    GROUP BY ph.PostId
),
ComplexUserActivity AS (
    SELECT 
        u.Id,
        u.DisplayName,
        COALESCE(b.TotalBadges,0) AS BadgeCount,
        COALESCE(uts.UserTopQuestionsCount,0) AS HighScoringQuestions,
        ru.QuestionsAsked,
        ru.AnswersGiven,
        ru.TotalPostScore,
        CASE WHEN ru.AnswersGiven = 0 THEN NULL ELSE ROUND(CAST(ru.TotalPostScore AS numeric) / NULLIF(ru.AnswersGiven, 0),2) END AS AvgScorePerAnswer,
        cu.LastCloseVoteDate,
        cu.CloseVotes,
        cu.ReopenVotes,
        cu.Deletes,
        cu.Undeletes,
        CASE 
            WHEN COALESCE(ru.AnswersGiven,0) = 0 THEN 'No Answers'
            WHEN COALESCE(b.TotalBadges,0) > 10 THEN 'Experienced'
            ELSE 'Active'
        END AS UserCategory
    FROM Users u
    LEFT JOIN UserBadgeAggregate b ON b.UserId = u.Id
    LEFT JOIN UserTopQuestionStats uts ON uts.OwnerUserId = u.Id
    LEFT JOIN RecursiveUserActivity ru ON ru.UserId = u.Id
    LEFT JOIN (
        SELECT 
            p.OwnerUserId,
            MAX(cv.LastCloseVoteDate) AS LastCloseVoteDate,
            SUM(cv.CloseVotes) AS CloseVotes,
            SUM(cv.ReopenVotes) AS ReopenVotes,
            SUM(cv.Deletes) AS Deletes,
            SUM(cv.Undeletes) AS Undeletes
        FROM Posts p
        LEFT JOIN CloseVoteSummary cv ON cv.PostId = p.Id
        GROUP BY p.OwnerUserId
    ) cu ON cu.OwnerUserId = u.Id
    WHERE u.Reputation > 1000
)
SELECT 
    cua.DisplayName,
    cua.UserCategory,
    cua.Reputation,
    cua.BadgeCount,
    cua.HighScoringQuestions,
    cua.QuestionsAsked,
    cua.AnswersGiven,
    cua.AvgScorePerAnswer,
    cua.CloseVotes,
    cua.ReopenVotes,
    cua.Deletes,
    cua.Undeletes,
    qas.Title AS MostRecentQuestionTitle,
    qas.AnswerCount,
    CASE 
        WHEN qas.AvgAnswerScore IS NULL THEN 0 
        ELSE ROUND(qas.AvgAnswerScore,2) 
    END AS AvgAnswerScore,
    qas.UniqueUpvotersOnAnswers,
    qas.QuestionScore,
    qas.ViewCount,
    CASE 
        WHEN qas.PreviousQuestionScore IS NULL THEN 'N/A'
        WHEN qas.QuestionScore > qas.PreviousQuestionScore THEN 'Improved'
        WHEN qas.QuestionScore = qas.PreviousQuestionScore THEN 'Same'
        ELSE 'Declined' 
    END AS QuestionScoreTrend,
    REPLACE(COALESCE(qas.Tags, ''), '><', ', ') AS ParsedTags,
    STRING_AGG(DISTINCT ph.Name, ', ') AS RecentPostHistoryActions
FROM ComplexUserActivity cua
LEFT JOIN LATERAL (
    SELECT p.*
    FROM Posts p
    WHERE p.OwnerUserId = cua.Id AND p.PostTypeId = 1
    ORDER BY p.CreationDate DESC
    LIMIT 1
) qas ON TRUE
LEFT JOIN ( 
    SELECT ph.PostId, p.OwnerUserId, p.CreationDate, p.Title, p.PostTypeId, ph2.Name
    FROM PostHistory ph
    INNER JOIN PostHistoryTypes ph2 ON ph.PostHistoryTypeId = ph2.Id
    INNER JOIN Posts p ON p.Id = ph.PostId
    WHERE ph.CreationDate > CAST('2024-10-01' AS date) - INTERVAL '180 days'
) ph ON ph.OwnerUserId = cua.Id AND ph.PostId = qas.Id
GROUP BY 
    cua.DisplayName, cua.UserCategory, cua.Reputation, cua.BadgeCount,
    cua.HighScoringQuestions, cua.QuestionsAsked, cua.AnswersGiven, cua.AvgScorePerAnswer,
    cua.CloseVotes, cua.ReopenVotes, cua.Deletes, cua.Undeletes,
    qas.Title, qas.AnswerCount, qas.AvgAnswerScore, qas.UniqueUpvotersOnAnswers,
    qas.QuestionScore, qas.ViewCount, qas.PreviousQuestionScore, qas.Tags, cua.Id
ORDER BY cua.Reputation DESC
LIMIT 100;