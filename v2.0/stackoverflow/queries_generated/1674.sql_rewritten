-- {"query": "1674.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3513} 
WITH UserEngagement AS (
    -- CTE 1: Summarize user engagement and basic activity metrics
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestionsAsked,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswersProvided,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COALESCE(SUM(CASE WHEN P.Score > 0 THEN P.Score ELSE 0 END), 0) AS TotalPostUpvotesReceived,
        COALESCE(SUM(CASE WHEN P.Score < 0 THEN P.Score ELSE 0 END), 0) AS TotalPostDownvotesReceived,
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS TotalUpVotesGiven, -- UpMod
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS TotalDownVotesGiven, -- DownMod
        MAX(P.LastActivityDate) AS LastPostActivityDate,
        MAX(C.CreationDate) AS LastCommentActivityDate,
        DENSE_RANK() OVER (ORDER BY U.Reputation DESC, U.LastAccessDate DESC) AS ReputationRank
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate
),
QuestionDetailedMetrics AS (
    -- CTE 2: Detailed metrics for questions, including answer statistics, historical edits, and linked posts
    SELECT
        Q.Id AS QuestionId,
        Q.Title AS QuestionTitle,
        Q.OwnerUserId,
        Q.CreationDate AS QuestionCreationDate,
        Q.Score AS QuestionScore,
        Q.ViewCount,
        Q.AnswerCount AS DeclaredAnswerCount,
        Q.FavoriteCount,
        Q.ClosedDate,
        Q.LastActivityDate AS QuestionLastActivityDate,
        ARRAY_REMOVE(STRING_TO_ARRAY(SUBSTRING(Q.Tags FROM 2 FOR LENGTH(Q.Tags)-2), '><'), '') AS ParsedTags,
        COALESCE(SUM(A.Score), 0) AS TotalAnswerScore,
        COUNT(DISTINCT A.Id) AS ActualAnswerCount, -- Could differ from DeclaredAnswerCount due to deletions/community ownership
        MAX(A.CreationDate) AS LatestAnswerDate,
        AVG(A.Score) OVER (PARTITION BY Q.Id) AS AverageAnswerScore,
        COUNT(DISTINCT PH.Id) AS TotalPostRevisions,
        COUNT(DISTINCT PH.UserId) AS TotalDistinctEditors,
        MIN(CASE WHEN PH.PostHistoryTypeId IN (1,2,3) THEN PH.CreationDate ELSE NULL END) AS InitialPostHistoryDate,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (4,5,6) THEN PH.CreationDate ELSE NULL END) AS LastEditHistoryDate,
        EXTRACT(EPOCH FROM (MAX(CASE WHEN PH.PostHistoryTypeId IN (4,5,6) THEN PH.CreationDate ELSE NULL END) - MIN(CASE WHEN PH.PostHistoryTypeId IN (1,2,3) THEN PH.CreationDate ELSE NULL END))) / 3600.0 AS HoursBetweenFirstAndLastEdit,
        SUM(CASE WHEN PH.PostHistoryTypeId IN (4,5,6) THEN 1 ELSE 0 END) AS ExplicitEditCount,
        MAX(CASE WHEN PH.PostHistoryTypeId = 10 THEN PH.CreationDate ELSE NULL END) AS LatestClosureHistoryDate,
        COUNT(DISTINCT CASE WHEN PL.LinkTypeId = 1 THEN PL.RelatedPostId END) AS LinkedPostsCount,
        COUNT(DISTINCT CASE WHEN PL.LinkTypeId = 3 THEN PL.RelatedPostId END) AS DuplicatePostsCount
    FROM Posts Q
    LEFT JOIN Posts A ON Q.Id = A.ParentId AND A.PostTypeId = 2 -- Answers to this question
    LEFT JOIN PostHistory PH ON Q.Id = PH.PostId
    LEFT JOIN PostLinks PL ON Q.Id = PL.PostId
    WHERE Q.PostTypeId = 1 -- Only questions
    GROUP BY Q.Id, Q.Title, Q.OwnerUserId, Q.CreationDate, Q.Score, Q.ViewCount, Q.AnswerCount, Q.FavoriteCount, Q.ClosedDate, Q.LastActivityDate, Q.Tags
),
UserBadgeSummary AS (
    -- CTE 3: Summarize user badges, including specific checks for badge types and classes
    SELECT
        B.UserId,
        COUNT(B.Id) AS TotalBadges,
        COUNT(CASE WHEN B.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN B.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN B.Class = 3 THEN 1 END) AS BronzeBadges,
        STRING_AGG(DISTINCT B.Name, '; ') AS AllBadgeNamesConcatenated,
        MAX(CASE WHEN B.Name LIKE '%Constituent%' AND B.Class = 1 THEN B.Date ELSE NULL END) IS NOT NULL AS HasSpecificGoldBadge -- Example of specific badge name and class check
    FROM Badges B
    GROUP BY B.UserId
),
TopGlobalQuestionTags AS (
    -- CTE 4: Identify overall top tags from questions and their aggregated metrics
    SELECT
        T_unnested.TagName,
        COUNT(DISTINCT QDM.QuestionId) AS QuestionsWithTag,
        SUM(QDM.QuestionScore) AS TotalTagScoreSum,
        RANK() OVER (ORDER BY COUNT(DISTINCT QDM.QuestionId) DESC, SUM(QDM.QuestionScore) DESC) AS GlobalTagPopularityRank
    FROM QuestionDetailedMetrics QDM
    CROSS JOIN UNNEST(QDM.ParsedTags) AS T_unnested(TagName)
    GROUP BY T_unnested.TagName
),
RecentPostUserActivity AS (
    -- CTE 5: Users with recent activity across posts (comments, edits, new posts)
    SELECT
        U.Id AS UserId,
        MAX(P.LastActivityDate) AS MaxPostActivity,
        MAX(C.CreationDate) AS MaxCommentActivity,
        COUNT(DISTINCT P.Id) AS RecentActivePostsCount,
        COUNT(DISTINCT C.Id) AS RecentActiveCommentsCount
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    WHERE P.LastActivityDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days' OR C.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
    GROUP BY U.Id
)
-- Main query: Combines insights from all CTEs to identify highly engaged users with popular, well-maintained questions
SELECT
    UE.UserId,
    UE.DisplayName AS UserDisplayName,
    UE.Reputation,
    UE.ReputationRank,
    UE.TotalQuestionsAsked,
    UE.TotalAnswersProvided,
    UE.TotalCommentsMade,
    UE.TotalPostUpvotesReceived,
    UE.TotalUpVotesGiven,
    QDM.QuestionId,
    QDM.QuestionTitle,
    QDM.QuestionScore,
    QDM.QuestionViewCount,
    QDM.FavoriteCount AS QuestionFavoriteCount,
    QDM.TotalAnswerScore,
    QDM.ActualAnswerCount,
    QDM.AverageAnswerScore,
    QDM.ClosedDate IS NOT NULL AS IsQuestionClosed,
    COALESCE(QDM.HoursBetweenFirstAndLastEdit, 0) AS QuestionEditDurationHours,
    QDM.TotalPostRevisions,
    QDM.TotalDistinctEditors,
    UBS.TotalBadges,
    UBS.GoldBadges,
    UBS.HasSpecificGoldBadge,
    TGT.TagName AS TopGlobalAssociatedTag,
    TGT.GlobalTagPopularityRank,
    (SELECT COUNT(DISTINCT PL_sub.RelatedPostId) FROM PostLinks PL_sub WHERE PL_sub.PostId = QDM.QuestionId AND PL_sub.LinkTypeId = 3) AS CorrelatedDuplicateLinksCount, -- Correlated Subquery Example
    SUM(CASE WHEN RPA.UserId IS NOT NULL THEN 1 ELSE 0 END) OVER (PARTITION BY UE.UserId) AS UserRecentActivityScore,
    AVG(QDM.QuestionScore) OVER (ORDER BY UE.Reputation DESC ROWS BETWEEN 50 PRECEDING AND CURRENT ROW) AS RollingAvgQuestionScoreByReputation, -- Rolling Average Window Function
    COALESCE(NULLIF(QDM.QuestionScore, 0) * QDM.TotalAnswerScore / (NULLIF(QDM.ActualAnswerCount, 0) + 1), 0) AS WeightedQuestionEngagementScore, -- Complex calculation with NULL/division-by-zero handling
    CASE
        WHEN QDM.QuestionScore > 150 AND QDM.FavoriteCount > 20 AND QDM.ActualAnswerCount > 10 AND QDM.ClosedDate IS NULL THEN 'Highly Viral & Open'
        WHEN QDM.QuestionScore BETWEEN 50 AND 150 AND QDM.AverageAnswerScore > 2 AND QDM.TotalPostRevisions > 3 THEN 'Popular, Well-Answered & Maintained'
        WHEN QDM.QuestionScore < 10 AND QDM.TotalPostRevisions > 5 AND QDM.QuestionCreationDate < cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 years' THEN 'Aging Low-Score, High-Revision'
        WHEN QDM.QuestionLastActivityDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months' AND QDM.QuestionScore > 0 AND (SELECT MAX(C_sub.CreationDate) FROM Comments C_sub WHERE C_sub.PostId = QDM.QuestionId) IS NOT NULL THEN 'Recently Active Discussion Post' -- Correlated Subquery
        ELSE 'Other Question Category'
    END AS QuestionStatusCategory,
    'Main_Highly_Engaged_Users_And_Questions' AS QuerySourceSegment
FROM UserEngagement UE
INNER JOIN QuestionDetailedMetrics QDM ON UE.UserId = QDM.OwnerUserId
LEFT JOIN UserBadgeSummary UBS ON UE.UserId = UBS.UserId
LEFT JOIN TopGlobalQuestionTags TGT ON TGT.TagName = (
    -- Correlated subquery to find the most globally popular tag for THIS specific question
    SELECT T_inner.TagName
    FROM UNNEST(QDM.ParsedTags) AS T_inner(TagName)
    LEFT JOIN TopGlobalQuestionTags TGT_inner ON T_inner.TagName = TGT_inner.TagName
    ORDER BY TGT_inner.GlobalTagPopularityRank ASC NULLS LAST
    LIMIT 1
)
LEFT JOIN RecentPostUserActivity RPA ON UE.UserId = RPA.UserId
WHERE
    UE.Reputation > 10000 -- Filter for high-reputation users
    AND UE.TotalQuestionsAsked > 25 -- Users who've asked a significant number of questions
    AND QDM.QuestionScore > 10 -- Questions with meaningful scores
    AND QDM.ActualAnswerCount >= 3 -- Questions with at least 3 answers
    AND QDM.QuestionCreationDate BETWEEN cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '7 years' AND cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 years' -- Questions from a specific historical period
    AND (
        QDM.FavoriteCount >= 10
        OR (QDM.AverageAnswerScore > 1.5 AND QDM.TotalPostRevisions >= 5)
        OR (QDM.ViewCount > 5000 AND QDM.QuestionScore > 50)
    ) -- Complex condition for question popularity/quality
    AND (UBS.GoldBadges > 0 OR UBS.HasSpecificGoldBadge) -- NULL logic check / badge class presence
    AND (QDM.ClosedDate IS NULL OR QDM.ClosedDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') -- Not closed, or recently closed/reopened
    AND QDM.QuestionTitle IS NOT NULL
UNION ALL
-- A UNION ALL branch to identify users who are extremely active in discussions (comments/edits) but might not have top-tier questions
SELECT
    UE.UserId,
    UE.DisplayName AS UserDisplayName,
    UE.Reputation,
    UE.ReputationRank,
    UE.TotalQuestionsAsked,
    UE.TotalAnswersProvided,
    UE.TotalCommentsMade,
    UE.TotalPostUpvotesReceived,
    UE.TotalUpVotesGiven,
    NULL AS QuestionId, -- No specific question tied to this result
    NULL AS QuestionTitle,
    NULL AS QuestionScore,
    NULL AS QuestionViewCount,
    NULL AS QuestionFavoriteCount,
    NULL AS TotalAnswerScore,
    NULL AS ActualAnswerCount,
    NULL AS AverageAnswerScore,
    NULL AS IsQuestionClosed,
    NULL AS QuestionEditDurationHours,
    NULL AS TotalPostRevisions,
    NULL AS TotalDistinctEditors,
    UBS.TotalBadges,
    UBS.GoldBadges,
    UBS.HasSpecificGoldBadge,
    NULL AS TopGlobalAssociatedTag,
    NULL AS GlobalTagPopularityRank,
    (SELECT COUNT(DISTINCT PL_sub.PostId) FROM PostLinks PL_sub WHERE PL_sub.RelatedPostId IN (SELECT Id FROM Posts WHERE OwnerUserId = UE.UserId)) AS TotalPostsLinkedToUserContent, -- Correlated subquery for user's overall linked posts
    SUM(CASE WHEN RPA.UserId IS NOT NULL THEN 1 ELSE 0 END) OVER (PARTITION BY UE.UserId) AS UserRecentActivityScore,
    NULL AS RollingAvgQuestionScoreByReputation,
    COALESCE(NULLIF(UE.TotalCommentsMade, 0) * UE.TotalAnswersProvided / (NULLIF(UE.TotalQuestionsAsked, 0) + 1), 0) AS WeightedEngagementContributionScore, -- Different complex calculation for this branch
    'Highly_Active_Contributor_Non_Question_Focus' AS QuestionStatusCategory,
    'Union_Branch_Active_Contributors' AS QuerySourceSegment
FROM UserEngagement UE
LEFT JOIN UserBadgeSummary UBS ON UE.UserId = UBS.UserId
LEFT JOIN RecentPostUserActivity RPA ON UE.UserId = RPA.UserId
WHERE
    UE.Reputation > 2500
    AND (UE.TotalCommentsMade > 100 OR UE.TotalUpVotesGiven > 750) -- High comment/vote activity
    AND UE.LastAccessDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '4 months'
    AND UE.TotalQuestionsAsked < 15 -- Focus on users not primarily asking questions
    AND NOT EXISTS (SELECT 1 FROM Posts P_inner WHERE P_inner.OwnerUserId = UE.UserId AND P_inner.Score > 200) -- Correlated subquery to exclude users with exceptionally popular single questions
GROUP BY
    UE.UserId, UE.DisplayName, UE.Reputation, UE.ReputationRank, UE.TotalQuestionsAsked, UE.TotalAnswersProvided, UE.TotalCommentsMade,
    UE.TotalPostUpvotesReceived, UE.TotalUpVotesGiven, UBS.TotalBadges, UBS.GoldBadges, UBS.HasSpecificGoldBadge,
    UE.LastAccessDate;