-- {"query": "7593.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 1490} 
WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        AVG(p.Score) as AvgPostScore,
        STRING_AGG(DISTINCT RIGHT(p.Tags, 10), ', ') as SampleTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopTaggedPosts AS (
    SELECT 
        t.TagName,
        COUNT(p.Id) as PostCount,
        AVG(p.Score) as AvgScore,
        STRING_AGG(p.Title, ' | ') as SampleTitles,
        ROW_NUMBER() OVER (ORDER BY COUNT(p.Id) DESC) as TagRank
    FROM Tags t
    INNER JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    WHERE p.PostTypeId = 1 AND p.CreationDate > '2020-01-01'
    GROUP BY t.TagName
),
RecentActivity AS (
    SELECT 
        ph.PostId,
        ph.UserId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ph.Comment,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) as ActivityRank,
        CASE 
            WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15) THEN 'Moderation'
            WHEN ph.PostHistoryTypeId IN (1, 4, 5, 6, 7, 8, 9) THEN 'Edit'
            ELSE 'Other'
        END as ActivityType
    FROM PostHistory ph
    WHERE ph.CreationDate > DATEADD('day', -30, cast('2024-10-01 12:34:56' as timestamp))
),
UserScoreStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) as QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) as AnswerCount,
        SUM(p.Score) as TotalScore,
        AVG(p.Score) as AvgScore,
        MAX(p.Score) as MaxScore,
        STRING_AGG(
            CASE 
                WHEN p.PostTypeId = 1 THEN 'Q:' || p.Title || '(' || p.Score || ')' 
                WHEN p.PostTypeId = 2 THEN 'A:' || p.Score 
                ELSE 'N:' || p.Score 
            END, 
            ' | ' 
            ORDER BY p.CreationDate DESC
        ) as RecentActivity
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Id IN (SELECT DISTINCT UserId FROM RecentActivity WHERE ActivityType = 'Moderation')
    GROUP BY u.Id, u.DisplayName
    HAVING SUM(p.Score) > 0
),
ComplexQueryResult AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.TotalPosts,
        uas.Questions,
        uas.Answers,
        uas.Comments,
        uas.Badges,
        uas.PostRank,
        uas.AvgPostScore,
        uas.SampleTags,
        COALESCE(ts.PostCount, 0) as PopularTagCount,
        COALESCE(ts.AvgScore, 0) as TagAvgScore,
        CASE 
            WHEN uas.TotalPosts > 100 AND uas.Comments > 50 AND uas.Badges > 20 THEN 'High Engagement'
            WHEN uas.TotalPosts > 50 AND uas.Comments > 25 AND uas.Badges > 10 THEN 'Moderate Engagement'
            ELSE 'Low Engagement'
        END as EngagementLevel,
        CASE 
            WHEN uas.Reputation > 100000 THEN 'Elite'
            WHEN uas.Reputation > 50000 THEN 'Expert'
            WHEN uas.Reputation > 10000 THEN 'Advanced'
            ELSE 'Intermediate'
        END as ReputationTier,
        COALESCE(uss.TotalScore, 0) as UserTotalScore,
        COALESCE(uss.AvgScore, 0) as UserAvgScore,
        ts.SampleTitles,
        ta.ActivityType,
        ta.CreationDate as LastActivityDate,
        CASE 
            WHEN uas.TotalPosts = 0 OR uas.Badges = 0 THEN NULL
            ELSE CAST(uas.Badges AS FLOAT) / uas.TotalPosts * 100
        END as BadgeEfficiencyRatio
    FROM UserActivityStats uas
    LEFT JOIN TopTaggedPosts ts ON ts.TagRank <= 5
    LEFT JOIN UserScoreStats uss ON uas.UserId = uss.UserId
    LEFT JOIN RecentActivity ta ON uas.UserId = ta.UserId AND ta.ActivityRank = 1
    WHERE uas.PostRank <= 100
)
SELECT 
    *,
    CASE 
        WHEN EngagementLevel = 'High Engagement' AND ReputationTier = 'Elite' THEN 'VIP Contributor'
        WHEN EngagementLevel = 'Moderate Engagement' AND ReputationTier IN ('Expert', 'Advanced') THEN 'Active Contributor'
        WHEN EngagementLevel = 'Low Engagement' AND ReputationTier = 'Intermediate' THEN 'Regular User'
        ELSE 'General User'
    END as UserCategory,
    CASE 
        WHEN TotalPosts > 0 AND AvgPostScore > 0 THEN 
            CAST((TotalPosts * AvgPostScore) AS VARCHAR) || ' (' || 
            CAST(AvgPostScore AS VARCHAR) || ' avg)'
        ELSE 'No posts or score data'
    END as ScoreContribution,
    COALESCE(SampleTags, 'No tags') as TagSummary,
    CASE 
        WHEN LastActivityDate IS NOT NULL THEN 
            DATEDIFF(day, LastActivityDate, cast('2024-10-01 12:34:56' as timestamp))
        ELSE NULL
    END as DaysSinceLastActivity
FROM ComplexQueryResult
WHERE 
    (BadgeEfficiencyRatio > 10 OR BadgeEfficiencyRatio IS NULL) AND
    (Reputation > 1000 OR Reputation IS NULL) AND
    (TotalPosts > 0 OR TotalPosts IS NULL)
ORDER BY 
    CASE WHEN Reputation > 100000 THEN 1 ELSE 2 END,
    TotalPosts DESC,
    Badges DESC
LIMIT 100;