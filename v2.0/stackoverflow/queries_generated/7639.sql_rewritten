WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        MAX(b.Date) AS LastBadgeDate,
        DATEDIFF(DAY, u.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS AccountAgeDays,
        AVG(p.Score) AS AvgPostScore,
        SUM(p.ViewCount) AS TotalViews,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LEN(p.Tags)-2), ', ') AS AllTagsUsed
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.CreationDate
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.AnswerCount,
        p.CommentCount,
        p.Tags,
        p.AcceptedAnswerId,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END AS PostTypeDesc,
        CASE 
            WHEN p.Score > 100 THEN 'HighlyVoted'
            WHEN p.Score > 50 THEN 'ModeratelyVoted'
            WHEN p.Score > 0 THEN 'SlightlyVoted'
            ELSE 'NoVotes'
        END AS VoteCategory,
        CASE 
            WHEN p.ViewCount > 1000 THEN 'Popular'
            WHEN p.ViewCount > 500 THEN 'ModeratelyPopular'
            WHEN p.ViewCount > 100 THEN 'LessPopular'
            ELSE 'NotPopular'
        END AS PopularityLevel,
        DATEDIFF(DAY, p.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) AS AgeInDays,
        CASE 
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.CommunityOwnedDate IS NOT NULL THEN 'CommunityOwned'
            WHEN p.ParentId IS NOT NULL THEN 'Answer'
            ELSE 'Question'
        END AS PostStatus,
        CASE 
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 1
            ELSE 0
        END AS HasAcceptedAnswer,
        CASE 
            WHEN p.ParentId IS NOT NULL THEN 
                (SELECT TOP 1 Title FROM Posts WHERE Id = p.ParentId)
            ELSE NULL
        END AS ParentQuestionTitle
    FROM Posts p
),
UserPostStats AS (
    SELECT 
        up.UserId,
        COUNT(up.PostId) AS TotalPosts,
        SUM(CASE WHEN up.PostTypeDesc = 'Question' THEN 1 ELSE 0 END) AS QuestionPosts,
        SUM(CASE WHEN up.PostTypeDesc = 'Answer' THEN 1 ELSE 0 END) AS AnswerPosts,
        SUM(up.Score) AS TotalScore,
        AVG(up.Score) AS AvgScore,
        MAX(up.ViewCount) AS MaxViews,
        MIN(up.CreationDate) AS FirstPostDate,
        MAX(up.CreationDate) AS LastPostDate,
        STRING_AGG(up.Title, ' | ') AS AllPostTitles,
        STRING_AGG(up.Tags, ' | ') AS AllTagsUsed
    FROM UserActivityStats uas
    INNER JOIN PostAnalysis up ON uas.UserId = up.OwnerUserId
    WHERE up.PostId IS NOT NULL
    GROUP BY up.UserId
),
ComplexAnalysis AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.TotalPosts,
        uas.QuestionCount,
        uas.AnswerCount,
        uas.CommentCount,
        uas.BadgeCount,
        uas.LastPostDate,
        uas.AccountAgeDays,
        uas.AvgPostScore,
        uas.TotalViews,
        up.TotalPosts AS UserTotalPosts,
        up.QuestionPosts AS UserQuestionPosts,
        up.AnswerPosts AS UserAnswerPosts,
        up.TotalScore AS UserTotalScore,
        up.AvgScore AS UserAvgScore,
        up.MaxViews AS UserMaxViews,
        up.FirstPostDate AS UserFirstPost,
        up.LastPostDate AS UserLastPost,
        COALESCE(up.AllPostTitles, 'No Posts') AS UserPostTitles,
        COALESCE(up.AllTagsUsed, 'No Tags') AS UserTagsUsed,
        CASE 
            WHEN up.TotalPosts > 0 AND up.UserAvgScore > 10 THEN 'HighlyActive'
            WHEN up.TotalPosts > 0 AND up.UserAvgScore > 5 THEN 'ModeratelyActive'
            WHEN up.TotalPosts > 0 THEN 'LowActive'
            ELSE 'Inactive'
        END AS EngagementLevel,
        CASE 
            WHEN uas.Reputation > 10000 THEN 'Expert'
            WHEN uas.Reputation > 5000 THEN 'Advanced'
            WHEN uas.Reputation > 1000 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS ReputationLevel,
        CASE 
            WHEN up.TotalPosts > 100 THEN 'Veteran'
            WHEN up.TotalPosts > 50 THEN 'Experienced'
            WHEN up.TotalPosts > 10 THEN 'Regular'
            ELSE 'Newbie'
        END AS ActivityLevel,
        DENSE_RANK() OVER (ORDER BY uas.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY up.TotalPosts DESC) AS PostRank,
        DENSE_RANK() OVER (ORDER BY up.TotalScore DESC) AS ScoreRank,
        ROW_NUMBER() OVER (ORDER BY uas.LastPostDate DESC) AS RecentActivityRank,
        NTILE(4) OVER (ORDER BY uas.Reputation) AS ReputationQuartile
    FROM UserActivityStats uas
    LEFT JOIN UserPostStats up ON uas.UserId = up.UserId
    WHERE uas.UserId IS NOT NULL
),
PerformanceMetrics AS (
    SELECT 
        ca.UserId,
        ca.DisplayName,
        ca.Reputation,
        ca.TotalPosts,
        ca.QuestionCount,
        ca.AnswerCount,
        ca.CommentCount,
        ca.BadgeCount,
        ca.AccountAgeDays,
        ca.AvgPostScore,
        ca.TotalViews,
        ca.UserTotalPosts,
        ca.UserQuestionPosts,
        ca.UserAnswerPosts,
        ca.UserTotalScore,
        ca.UserAvgScore,
        ca.UserMaxViews,
        ca.ReputationLevel,
        ca.ActivityLevel,
        ca.ReputationRank,
        ca.PostRank,
        ca.ScoreRank,
        ca.RecentActivityRank,
        ca.ReputationQuartile,
        CASE 
            WHEN ca.UserTotalPosts > 0 AND ca.UserTotalScore > 0 THEN (ca.UserTotalScore * 1.0 / ca.UserTotalPosts)
            ELSE 0
        END AS ScorePerPost,
        CASE 
            WHEN ca.AccountAgeDays > 0 THEN (ca.UserTotalPosts * 1.0 / ca.AccountAgeDays)
            ELSE 0
        END AS PostsPerDay,
        CASE 
            WHEN ca.Reputation > 0 THEN (ca.UserTotalScore * 1.0 / ca.Reputation)
            ELSE 0
        END AS ScoreToReputationRatio,
        CASE 
            WHEN ca.UserTotalPosts > 0 THEN 
                (SELECT COUNT(*) FROM Posts p 
                 WHERE p.OwnerUserId = ca.UserId AND 
                       p.PostTypeId = 1 AND 
                       p.AcceptedAnswerId IS NOT NULL)
            ELSE 0
        END AS QuestionsWithAcceptedAnswers,
        CASE 
            WHEN ca.UserAnswerPosts > 0 THEN 
                (SELECT COUNT(*) FROM Posts p 
                 WHERE p.OwnerUserId = ca.UserId AND 
                       p.PostTypeId = 2 AND 
                       p.Score > 0)
            ELSE 0
        END AS PositiveScoringAnswers,
        CASE 
            WHEN ca.UserTotalPosts > 0 THEN 
                (SELECT COUNT(*) FROM Posts p 
                 WHERE p.OwnerUserId = ca.UserId AND 
                       p.PostTypeId = 1 AND 
                       p.CommentCount > 0)
            ELSE 0
        END AS QuestionsWithComments,
        CASE 
            WHEN ca.UserTotalPosts > 0 THEN 
                (SELECT COUNT(*) FROM Posts p 
                 WHERE p.OwnerUserId = ca.UserId AND 
                       p.PostTypeId = 2 AND 
                       p.CommentCount > 0)
            ELSE 0
        END AS AnswerWithComments
    FROM ComplexAnalysis ca
),
FinalBenchmarkQuery AS (
    SELECT 
        pm.UserId,
        pm.DisplayName,
        pm.Reputation,
        pm.TotalPosts,
        pm.QuestionCount,
        pm.AnswerCount,
        pm.CommentCount,
        pm.BadgeCount,
        pm.AccountAgeDays,
        pm.AvgPostScore,
        pm.TotalViews,
        pm.UserTotalPosts,
        pm.UserQuestionPosts,
        pm.UserAnswerPosts,
        pm.UserTotalScore,
        pm.UserAvgScore,
        pm.UserMaxViews,
        pm.ReputationLevel,
        pm.ActivityLevel,
        pm.ReputationRank,
        pm.PostRank,
        pm.ScoreRank,
        pm.RecentActivityRank,
        pm.ReputationQuartile,
        pm.ScorePerPost,
        pm.PostsPerDay,
        pm.ScoreToReputationRatio,
        pm.QuestionsWithAcceptedAnswers,
        pm.PositiveScoringAnswers,
        pm.QuestionsWithComments,
        pm.AnswerWithComments,
        CASE 
            WHEN pm.ReputationLevel = 'Expert' AND pm.ActivityLevel = 'Veteran' THEN 'EliteContributor'
            WHEN pm.ReputationLevel IN ('Advanced', 'Expert') AND pm.UserAvgScore > 15 THEN 'TopPerformer'
            WHEN pm.ActivityLevel = 'Regular' AND pm.PostsPerDay > 0.1 THEN 'ConsistentPoster'
            WHEN pm.AccountAgeDays > 30 AND pm.UserTotalPosts > 10 THEN 'EstablishedMember'
            ELSE 'RegularMember'
        END AS MemberCategory,
        CASE 
            WHEN pm.UserTotalPosts > 50 AND pm.Reputation > 5000 THEN 'HighlyEngaged'
            WHEN pm.QuestionsWithAcceptedAnswers > 0 AND pm.PositiveScoringAnswers > 0 THEN 'QualityContributor'
            WHEN pm.UserAvgScore > 0 THEN 'ActiveContributor'
            ELSE 'PassiveMember'
        END AS EngagementStatus,
        CAST((pm.Reputation * pm.UserTotalPosts) AS BIGINT) AS ReputationProductivityScore,
        CAST((pm.AccountAgeDays * pm.UserTotalPosts) AS BIGINT) AS HistoricalProductivityScore,
        CASE 
            WHEN pm.UserAnswerPosts > 0 AND pm.UserQuestionPosts > 0 THEN 
                (pm.UserAnswerPosts * 1.0 / pm.UserQuestionPosts)
            ELSE 0
        END AS AnswerQuestionRatio,
        ROW_NUMBER() OVER (PARTITION BY pm.ReputationQuartile ORDER BY pm.UserTotalScore DESC) AS ScoreWithinQuartileRank
    FROM PerformanceMetrics pm
    WHERE pm.UserId IS NOT NULL AND pm.AccountAgeDays > 0
)
SELECT 
    fbq.UserId,
    fbq.DisplayName,
    fbq.Reputation,
    fbq.TotalPosts,
    fbq.QuestionCount,
    fbq.AnswerCount,
    fbq.CommentCount,
    fbq.BadgeCount,
    fbq.AccountAgeDays,
    fbq.AvgPostScore,
    fbq.TotalViews,
    fbq.UserTotalPosts,
    fbq.UserQuestionPosts,
    fbq.UserAnswerPosts,
    fbq.UserTotalScore,
    fbq.UserAvgScore,
    fbq.UserMaxViews,
    fbq.ReputationLevel,
    fbq.ActivityLevel,
    fbq.ReputationRank,
    fbq.PostRank,
    fbq.ScoreRank,
    fbq.RecentActivityRank,
    fbq.ReputationQuartile,
    fbq.ScorePerPost,
    fbq.PostsPerDay,
    fbq.ScoreToReputationRatio,
    fbq.QuestionsWithAcceptedAnswers,
    fbq.PositiveScoringAnswers,
    fbq.QuestionsWithComments,
    fbq.AnswerWithComments,
    fbq.MemberCategory,
    fbq.EngagementStatus,
    fbq.ReputationProductivityScore,
    fbq.HistoricalProductivityScore,
    fbq.AnswerQuestionRatio,
    fbq.ScoreWithinQuartileRank
FROM FinalBenchmarkQuery fbq
WHERE fbq.UserId IS NOT NULL
    AND fbq.Reputation > 0
    AND fbq.PostRank IS NOT NULL
    AND fbq.ScoreRank IS NOT NULL
