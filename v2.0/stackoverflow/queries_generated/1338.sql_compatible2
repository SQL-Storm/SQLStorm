WITH UserEngagement AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName AS UserName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        u.UpVotes AS UserUpVotesGiven,
        u.DownVotes AS UserDownVotesGiven,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END), 0) AS QuestionsAsked,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END), 0) AS AnswersProvided,
        COALESCE(SUM(CASE WHEN p.PostTypeId IN (1, 2) THEN p.Score ELSE 0 END), 0) AS TotalPostScore,
        COALESCE(COUNT(DISTINCT b.Id), 0) AS TotalBadges,
        COALESCE(COUNT(DISTINCT c.Id), 0) AS TotalCommentsMade,
        LAG(u.Reputation, 1, 0) OVER (ORDER BY u.CreationDate) AS PreviousUserReputationSnapshot
    FROM Users AS u
    LEFT JOIN Posts AS p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges AS b ON u.Id = b.UserId
    LEFT JOIN Comments AS c ON u.Id = c.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.UpVotes, u.DownVotes
),
PostHistoricalMetrics AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate AS PostCreationDate,
        p.LastEditDate,
        p.Score AS CurrentScore,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.Title,
        p.Tags,
        p.AcceptedAnswerId,
        COALESCE(
            (SELECT COUNT(DISTINCT ph.Id)
             FROM PostHistory AS ph
             WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4, 5, 6)
            ), 0
        ) AS EditCount,
        COALESCE(
            (SELECT MAX(ph.CreationDate)
             FROM PostHistory AS ph
             WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4, 5, 6)
            ), p.LastEditDate
        ) AS LatestEditHistoryDate,
        (SELECT COUNT(ph.Id) FROM PostHistory AS ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10) AS CloseVotesCount,
        (SELECT COUNT(ph.Id) FROM PostHistory AS ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 11) AS ReopenVotesCount,
        DENSE_RANK() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS UserPostScoreRank,
        EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate)) / (60 * 60 * 24) AS PostAgeDays,
        (SELECT u_ans.Reputation
         FROM Posts AS ans
         JOIN Users AS u_ans ON ans.OwnerUserId = u_ans.Id
         WHERE ans.Id = p.AcceptedAnswerId AND p.AcceptedAnswerId IS NOT NULL) AS AcceptedAnswerOwnerReputation
    FROM Posts AS p
),
TagList AS (
    SELECT
        phm.PostId,
        LOWER(TRIM(tag)) AS TagName
    FROM (
        SELECT PostId,
               SUBSTRING(Tags FROM 2 FOR (LENGTH(Tags) - 2)) AS inner_tags
        FROM PostHistoricalMetrics
        WHERE Tags IS NOT NULL AND LENGTH(TRIM(Tags)) > 2
    ) phm
    CROSS JOIN LATERAL (
        WITH RECURSIVE split(tag, rest) AS (
            SELECT
                CASE
                    WHEN POSITION('><' IN phm.inner_tags) = 0 THEN phm.inner_tags
                    ELSE SUBSTRING(phm.inner_tags FROM 1 FOR POSITION('><' IN phm.inner_tags) - 1)
                END AS tag,
                CASE
                    WHEN POSITION('><' IN phm.inner_tags) = 0 THEN ''
                    ELSE SUBSTRING(phm.inner_tags FROM POSITION('><' IN phm.inner_tags) + 2)
                END AS rest
            UNION ALL
            SELECT
                CASE
                    WHEN POSITION('><' IN rest) = 0 THEN rest
                    ELSE SUBSTRING(rest FROM 1 FOR POSITION('><' IN rest) - 1)
                END,
                CASE
                    WHEN POSITION('><' IN rest) = 0 THEN ''
                    ELSE SUBSTRING(rest FROM POSITION('><' IN rest) + 2)
                END
            FROM split
            WHERE rest <> ''
        )
        SELECT tag FROM split WHERE tag <> ''
    ) AS toks(tag)
),
TagPerformanceOverview AS (
    SELECT
        tl.TagName,
        COUNT(DISTINCT tl.PostId) AS QuestionsWithTag,
        COALESCE(SUM(phm.CurrentScore), 0) AS TotalTagScore,
        COALESCE(SUM(phm.ViewCount), 0) AS TotalTagViews,
        AVG(CASE WHEN phm.PostTypeId = 1 THEN phm.CurrentScore ELSE NULL END) AS AvgQuestionScoreByTag,
        NTILE(4) OVER (ORDER BY COALESCE(SUM(phm.ViewCount), 0) DESC) AS ViewCountQuartile
    FROM TagList AS tl
    JOIN PostHistoricalMetrics AS phm ON tl.PostId = phm.PostId
    WHERE phm.PostTypeId = 1
    GROUP BY tl.TagName
),
UserAnswerQuality AS (
    SELECT
        p.OwnerUserId AS UserId,
        AVG(p.Score) AS AvgAnswerScore,
        COUNT(p.Id) AS TotalUserAnswers,
        SUM(CASE WHEN p.ParentId IS NOT NULL AND p.Id = q.AcceptedAnswerId THEN 1 ELSE 0 END) AS AcceptedAnswersCount
    FROM Posts AS p
    JOIN Posts AS q ON p.ParentId = q.Id
    WHERE p.PostTypeId = 2
    GROUP BY p.OwnerUserId
),
RecentModerationEvents AS (
    SELECT
        me.PostId,
        me.EventDate AS LatestModerationEventDate,
        ph_type.Name AS EventTypeName,
        me.CloseReasonName,
        u.DisplayName AS ModeratorDisplayName
    FROM (
        SELECT
            ph.PostId,
            ph.CreationDate AS EventDate,
            ph.PostHistoryTypeId,
            ph.UserId AS ModeratorId,
            ph.Comment AS CloseReasonIdComment,
            CASE
                WHEN ph.PostHistoryTypeId = 10 AND ph.Comment IS NOT NULL AND ph.Comment ~ '^[0-9]+$' THEN
                    (SELECT crt.Name FROM CloseReasonTypes AS crt WHERE crt.Id = CAST(ph.Comment AS smallint))
                WHEN ph.PostHistoryTypeId = 10 AND ph.Comment IS NOT NULL AND NOT ph.Comment ~ '^[0-9]+$' THEN ph.Comment
                ELSE NULL
            END AS CloseReasonName,
            ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
        FROM PostHistory AS ph
        WHERE ph.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15, 19, 20, 35, 36)
    ) AS me
    LEFT JOIN PostHistoryTypes AS ph_type ON me.PostHistoryTypeId = ph_type.Id
    LEFT JOIN Users AS u ON me.ModeratorId = u.Id
    WHERE me.rn = 1
),
HighlyEngagedUsers AS (
    SELECT ue.UserId, ue.UserName, ue.Reputation, ue.QuestionsAsked, ue.AnswersProvided, ue.TotalCommentsMade
    FROM UserEngagement AS ue
    WHERE ue.Reputation > 5000
      AND ue.QuestionsAsked >= 50
      AND ue.AnswersProvided >= 100
      AND ue.TotalCommentsMade >= 200
      AND (
          SELECT COUNT(p.Id)
          FROM Posts p
          WHERE p.OwnerUserId = ue.UserId
            AND p.LastEditDate IS NOT NULL
            AND p.LastEditDate < (CAST('2024-10-01' AS date) - INTERVAL '1 year')
            AND p.ClosedDate IS NULL
      ) > 5
),
UsersWithHighImpactPosts AS (
    SELECT DISTINCT ue.UserId, ue.UserName
    FROM UserEngagement AS ue
    JOIN PostHistoricalMetrics AS phm ON ue.UserId = phm.OwnerUserId
    LEFT JOIN TagList AS tl ON tl.PostId = phm.PostId
    LEFT JOIN TagPerformanceOverview AS tpo ON tl.TagName = tpo.TagName
    WHERE phm.PostTypeId = 1
      AND phm.ViewCount > 10000
      AND phm.CurrentScore > 50
      AND COALESCE(tpo.ViewCountQuartile, 0) = 1
      AND phm.EditCount > 2
),
CombinedUserSet AS (
    SELECT UserId, UserName FROM HighlyEngagedUsers
    UNION
    SELECT UserId, UserName FROM UsersWithHighImpactPosts
)
SELECT
    cu.UserId,
    cu.UserName,
    ue.Reputation,
    ue.QuestionsAsked,
    ue.AnswersProvided,
    ue.TotalCommentsMade,
    ue.TotalBadges,
    uaq.AvgAnswerScore,
    uaq.AcceptedAnswersCount,
    phm.PostId,
    phm.Title AS PostTitle,
    phm.CurrentScore AS PostScore,
    phm.ViewCount AS PostViewCount,
    phm.EditCount AS PostEditCount,
    phm.CloseVotesCount,
    phm.ReopenVotesCount,
    phm.PostCreationDate,
    phm.LastEditDate AS PostLastEditDate,
    phm.UserPostScoreRank,
    r_mod.LatestModerationEventDate,
    r_mod.EventTypeName AS LatestModerationEventType,
    r_mod.CloseReasonName,
    r_mod.ModeratorDisplayName,
    tpo.AvgQuestionScoreByTag AS AvgSiteQuestionScoreForTag,
    CAST(phm.CurrentScore AS decimal) / COALESCE(NULLIF(phm.ViewCount, 0), 1) AS PostViewScoreRatio,
    (ue.Reputation - ue.PreviousUserReputationSnapshot) AS ReputationChangeSinceLastUser,
    phm.AcceptedAnswerOwnerReputation
FROM CombinedUserSet AS cu
JOIN UserEngagement AS ue ON cu.UserId = ue.UserId
LEFT JOIN UserAnswerQuality AS uaq ON cu.UserId = uaq.UserId
LEFT JOIN PostHistoricalMetrics AS phm ON cu.UserId = phm.OwnerUserId
LEFT JOIN RecentModerationEvents AS r_mod ON phm.PostId = r_mod.PostId
LEFT JOIN TagList AS tl ON tl.PostId = phm.PostId
LEFT JOIN TagPerformanceOverview AS tpo ON tl.TagName = tpo.TagName
WHERE phm.PostTypeId = 1
  AND phm.UserPostScoreRank <= 5
  AND phm.AcceptedAnswerId IS NOT NULL
  AND (phm.Title ILIKE '%sql%' OR phm.Title ILIKE '%performance%' OR phm.Tags ILIKE '%<database>%')
  AND NOT EXISTS (
      SELECT 1
      FROM PostLinks pl
      WHERE pl.PostId = phm.PostId AND pl.LinkTypeId = 3
  )
  AND (
      (phm.CloseVotesCount > 0 AND r_mod.EventTypeName = 'Post Reopened')
      OR
      (phm.CloseVotesCount = 0 AND phm.EditCount >= 3 AND phm.PostAgeDays > 365 AND phm.PostAgeDays < 1000)
  )
ORDER BY ue.Reputation DESC, PostViewScoreRatio DESC, phm.PostId
LIMIT 100;