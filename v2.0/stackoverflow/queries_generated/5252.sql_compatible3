WITH
RecentHot AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.Tags,
    p.OwnerUserId,
    p.LastActivityDate,
    p.PostTypeId,
    ROW_NUMBER() OVER (ORDER BY p.ViewCount DESC, p.Score DESC, p.CreationDate DESC) AS rn
  FROM Posts p
  WHERE p."IsActive" IS NULL OR p."IsActive" <> 0
),
TopTags AS (
  SELECT
    t.TagName,
    COUNT(*) AS TagCount,
    AVG(p.Score) AS AvgScore,
    SUM(p.ViewCount) AS TotalViews
  FROM Posts p,
  LATERAL (
    SELECT trim(value) AS TagName
    FROM unnest(string_to_array(regexp_replace(p.Tags, '^<|>$', ''), '><')) AS value
  ) t
  GROUP BY t.TagName
),
Correlation AS (
  SELECT
    p1.PostId,
    p1.Title AS PostTitle,
    p1.CreationDate AS PostDate,
    p1.Score,
    p1.ViewCount,
    p1.OwnerUserId,
    p2.Id AS RelatedPostId,
    p2.Title AS RelatedTitle,
    p2.ViewCount AS RelatedViews,
    p2.Score AS RelatedScore
  FROM RecentHot p1
  LEFT JOIN PostLinks pl ON pl.PostId = p1.PostId
  LEFT JOIN Posts p2 ON p2.Id = pl.RelatedPostId
  WHERE pl.LinkTypeId IN (1,3)
),
WindowStats AS (
  SELECT
    c.PostId,
    c.PostTitle,
    c.PostDate,
    c.Score,
    c.ViewCount,
    c.OwnerUserId,
    c.RelatedPostId,
    c.RelatedTitle,
    c.RelatedViews,
    c.RelatedScore,
    COUNT(*) OVER (PARTITION BY c.PostId) AS LinkCount,
    AVG(NULLIF(c.RelatedScore, 0)) OVER (PARTITION BY c.PostId) AS AvgRelatedScore
  FROM Correlation c
),
UserActivity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.AccountId,
    b.Count AS BadgeCount,
    b.Class AS BadgeClass,
    b.Name AS BadgeName,
    b.Date AS BadgeDate
  FROM Users u
  LEFT JOIN Badges b ON b.UserId = u.Id
),
TemporalFlags AS (
  SELECT
    u.UserId,
    CASE
      WHEN (CAST('2024-10-01 12:34:56' AS timestamp) - u.LastAccessDate) <= INTERVAL '7 days' THEN 1
      WHEN (CAST('2024-10-01 12:34:56' AS timestamp) - u.LastAccessDate) <= INTERVAL '30 days' THEN 2
      ELSE 3
    END AS ActiveWindow
  FROM Users u
)
SELECT
  ws.PostId,
  ws.PostTitle,
  ws.PostDate,
  ws.Score AS PostScore,
  ws.ViewCount AS PostViews,
  ws.OwnerUserId,
  ws.RelatedPostId,
  ws.RelatedTitle,
  ws.RelatedViews AS RelatedViews,
  ws.RelatedScore AS RelatedScore,
  ws.LinkCount,
  ws.AvgRelatedScore,
  ua.UserId,
  ua.DisplayName,
  ua.Reputation,
  ua.CreationDate AS UserCreated,
  ua.LastAccessDate AS UserLastActive,
  ua.Views AS UserViews,
  ua.UpVotes,
  ua.DownVotes,
  ua.AccountId,
  ua.BadgeCount,
  ua.BadgeClass,
  ua.BadgeName,
  ua.BadgeDate,
  tf.ActiveWindow
FROM WindowStats ws
JOIN UserActivity ua ON ua.UserId = (
  SELECT p2.OwnerUserId
  FROM Posts p2
  WHERE p2.Id = ws.PostId
  LIMIT 1
)
JOIN TemporalFlags tf ON tf.UserId = ua.UserId
ORDER BY ws.LinkCount DESC, ws.ViewCount DESC
LIMIT 100;