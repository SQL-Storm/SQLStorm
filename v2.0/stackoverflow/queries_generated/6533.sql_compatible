WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        P.OwnerUserId AS UserId,
        P.PostTypeId,
        U.DisplayName,
        U.Reputation,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    GROUP BY 
        U.Id
)
SELECT 
    RP.Id,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.DisplayName,
    RP.Reputation,
    RP.rank,
    COALESCE(BC.BadgeCount, 0) AS BadgeCount,
    SUM(V.Score) AS TotalVotes,
    CASE 
        WHEN RP.Score > 100 THEN 'High'
        WHEN RP.Score > 50 THEN 'Medium'
        ELSE 'Low'
    END AS ScoreTier,
    SUBSTRING(RP.Title FROM 1 FOR 50) AS ShortTitle,
    CASE 
        WHEN COALESCE(BC.BadgeCount, 0) > 5 THEN 'Active'
        ELSE 'Inactive'
    END AS UserActivity,
    RP.PostTypeId
FROM 
    RankedPosts RP
LEFT JOIN 
    BadgeCounts BC ON RP.UserId = BC.UserId
LEFT JOIN 
    Votes V ON RP.Id = V.PostId
GROUP BY 
    RP.Id, RP.Title, RP.Score, RP.ViewCount, RP.CreationDate, RP.DisplayName, RP.Reputation, RP.rank, BC.BadgeCount, RP.PostTypeId
HAVING 
    RP.Score > ALL (
        SELECT 
            MAX(RP2.Score)
        FROM 
            RankedPosts RP2
        WHERE 
            RP2.PostTypeId = RP.PostTypeId AND RP2.rank <= 10
    )
ORDER BY 
    RP.Score DESC, RP.ViewCount DESC;