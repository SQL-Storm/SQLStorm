-- {"query": "4108.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1806} 
WITH PostEditSummary AS (
    SELECT
        ph.PostId,
        COUNT(CASE WHEN ph.PostHistoryTypeId = 5 THEN 1 END) AS BodyEditCount,
        COUNT(CASE WHEN ph.PostHistoryTypeId = 4 THEN 1 END) AS TitleEditCount,
        MAX(CASE WHEN ph.PostHistoryTypeId = 4 THEN ph.CreationDate ELSE NULL END) AS LastTitleEditDate,
        MIN(CASE WHEN ph.PostHistoryTypeId = 2 THEN ph.CreationDate ELSE NULL END) AS InitialBodyDate,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (10, 12, 14, 19) THEN 1 ELSE 0 END) AS ModerationActionCount
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (2, 4, 5, 10, 12, 14, 19)
    GROUP BY ph.PostId
),
UserPostEngagement AS (
    SELECT
        p.OwnerUserId,
        COUNT(DISTINCT p.Id) AS PostsOwned,
        SUM(CASE WHEN c.UserId = p.OwnerUserId THEN 1 ELSE 0 END) AS CommentsOnOwnPosts,
        SUM(CASE WHEN v.UserId = p.OwnerUserId AND v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvotesOnOwnPosts,
        SUM(CASE WHEN v.UserId = p.OwnerUserId AND v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvotesOnOwnPosts
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.OwnerUserId IS NOT NULL AND p.OwnerUserId > 0
    GROUP BY p.OwnerUserId
)
SELECT
    u.DisplayName AS UserDisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    COALESCE(upe.PostsOwned, 0) AS TotalPostsOwned,
    COALESCE(upe.CommentsOnOwnPosts, 0) AS TotalCommentsOnOwnPosts,
    COALESCE(upe.UpvotesOnOwnPosts, 0) AS TotalUpvotesOnOwnPosts,
    COALESCE(upe.DownvotesOnOwnPosts, 0) AS TotalDownvotesOnOwnPosts,
    COALESCE(pes.BodyEditCount, 0) AS TotalBodyEdits,
    COALESCE(pes.TitleEditCount, 0) AS TotalTitleEdits,
    CASE
        WHEN pes.LastTitleEditDate IS NULL THEN 'Never Edited Title'
        WHEN pes.LastTitleEditDate < u.CreationDate THEN 'Pre-Creation Edit (Impossible)'
        ELSE 'Edited Title'
    END AS TitleEditStatus,
    CASE
        WHEN pes.InitialBodyDate IS NULL THEN 'No Initial Body Recorded'
        WHEN pes.InitialBodyDate > u.LastAccessDate THEN 'Initial Body After Last Access (Anomaly)'
        ELSE 'Body Activity Recorded'
    END AS BodyActivityIndicator,
    COALESCE(pes.ModerationActionCount, 0) AS PostModerationActions,
    COUNT(DISTINCT b.Id) AS BadgeCount,
    UPPER(SUBSTRING(u.AboutMe FROM 1 FOR 3)) AS AboutMePrefix,
    CASE
        WHEN u.WebsiteUrl IS NULL OR u.WebsiteUrl = '' THEN 'No Website'
        WHEN u.WebsiteUrl LIKE '%stackoverflow.com%' THEN 'Stack Overflow Site'
        ELSE 'External Website'
    END AS WebsiteCategory,
    (SELECT COUNT(*) FROM Badges WHERE UserId = u.Id AND Class = 1) AS GoldBadges,
    (SELECT COUNT(*) FROM Badges WHERE UserId = u.Id AND Class = 2) AS SilverBadges,
    (SELECT COUNT(*) FROM Badges WHERE UserId = u.Id AND Class = 3) AS BronzeBadges,
    CASE
        WHEN u.Views > 1000000 THEN 'High Volume User'
        WHEN u.Views BETWEEN 100000 AND 1000000 THEN 'Medium Volume User'
        ELSE 'Standard User'
    END AS UserVolumeTier,
    CASE
        WHEN u.UpVotes > u.DownVotes * 10 AND u.UpVotes > 50 THEN 'Net Positive Voter'
        WHEN u.DownVotes > u.UpVotes * 10 AND u.DownVotes > 50 THEN 'Net Negative Voter'
        ELSE 'Balanced Voter'
    END AS VotingPattern,
    CASE
        WHEN u.LastAccessDate < DATE('now', '-1 year') THEN 'Inactive'
        WHEN u.LastAccessDate < DATE('now', '-3 months') THEN 'Dormant'
        ELSE 'Active'
    END AS UserActivityStatus,
    AVG(p.Score) OVER (PARTITION BY u.Id) AS AveragePostScore,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RankByReputation
FROM Users u
LEFT JOIN UserPostEngagement upe ON u.Id = upe.OwnerUserId
LEFT JOIN PostEditSummary pes ON u.Id = pes.PostId
LEFT JOIN Badges b ON u.Id = b.UserId
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
WHERE u.DisplayName IS NOT NULL
GROUP BY
    u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.Views, u.UpVotes, u.DownVotes, u.AboutMe, u.WebsiteUrl, upe.PostsOwned, upe.CommentsOnOwnPosts, upe.UpvotesOnOwnPosts, upe.DownvotesOnOwnPosts, pes.BodyEditCount, pes.TitleEditCount, pes.LastTitleEditDate, pes.InitialBodyDate, pes.ModerationActionCount
HAVING COUNT(DISTINCT b.Id) > 0 OR COALESCE(upe.PostsOwned, 0) > 10 OR COALESCE(pes.BodyEditCount, 0) > 5
UNION
SELECT
    'Community User' AS UserDisplayName,
    0 AS Reputation,
    MIN(u.CreationDate) AS UserCreationDate,
    COUNT(DISTINCT u.Id) AS TotalPostsOwned,
    0 AS TotalCommentsOnOwnPosts,
    0 AS TotalUpvotesOnOwnPosts,
    0 AS TotalDownvotesOnOwnPosts,
    SUM(COALESCE(pes.BodyEditCount, 0)) AS TotalBodyEdits,
    SUM(COALESCE(pes.TitleEditCount, 0)) AS TotalTitleEdits,
    'N/A' AS TitleEditStatus,
    'N/A' AS BodyActivityIndicator,
    SUM(COALESCE(pes.ModerationActionCount, 0)) AS PostModerationActions,
    0 AS BadgeCount,
    'N/A' AS AboutMePrefix,
    'N/A' AS WebsiteCategory,
    0 AS GoldBadges,
    0 AS SilverBadges,
    0 AS BronzeBadges,
    'N/A' AS UserVolumeTier,
    'N/A' AS VotingPattern,
    CASE
        WHEN MIN(u.LastAccessDate) < DATE('now', '-1 year') THEN 'Inactive'
        ELSE 'Active'
    END AS UserActivityStatus,
    AVG(p.Score) AS AveragePostScore,
    MAX(ROW_NUMBER() OVER (ORDER BY 0 DESC)) AS RankByReputation
FROM Users u
LEFT JOIN PostEditSummary pes ON u.Id = pes.PostId
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
WHERE u.DisplayName IS NULL OR u.DisplayName = 'Community' OR u.Id = -1
GROUP BY u.Id
HAVING SUM(COALESCE(pes.BodyEditCount, 0)) > 5 OR SUM(COALESCE(pes.TitleEditCount, 0)) > 5;