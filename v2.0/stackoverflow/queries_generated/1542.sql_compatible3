WITH UserEngagementMetrics AS (
    SELECT
        u.Id AS UserId,
        u.Reputation,
        u.Views AS UserProfileViews,
        u.UpVotes AS UserUpVotesGiven,
        u.DownVotes AS UserDownVotesGiven,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        COUNT(DISTINCT p.Id) AS TotalPostsCreated,
        COUNT(DISTINCT c.Id) AS TotalCommentsMade,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId IN (2, 3, 5, 8, 9)) AS TotalActionVotesCast,
        COUNT(DISTINCT b.Id) AS TotalBadgesReceived,
        MAX(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS HasGoldBadge,
        AVG(EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate)) / 86400.0) FILTER (WHERE p.CreationDate IS NOT NULL) AS AvgDaysSincePostCreation,
        MAX(CASE WHEN p.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year') THEN 1 ELSE 0 END) AS PostedInLastYearFlag
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.CreationDate, u.LastAccessDate
    HAVING COUNT(DISTINCT p.Id) > 0 OR COUNT(DISTINCT c.Id) > 0 OR COUNT(DISTINCT v.Id) > 0
),
PostHistoryDetailed AS (
    SELECT
        ph.PostId,
        MIN(ph.CreationDate) FILTER (WHERE ph.PostHistoryTypeId = 1) AS InitialTitleCreationDate,
        MAX(ph.CreationDate) FILTER (WHERE ph.PostHistoryTypeId IN (4, 5, 6)) AS LastContentEditDate,
        MAX(ph.CreationDate) FILTER (WHERE ph.PostHistoryTypeId = 10) AS LastClosedDate,
        MAX(ph.CreationDate) FILTER (WHERE ph.PostHistoryTypeId = 11) AS LastReopenedDate,
        MAX(ph.CreationDate) FILTER (WHERE ph.PostHistoryTypeId = 12) AS LastDeletedDate,
        MAX(ph.CreationDate) FILTER (WHERE ph.PostHistoryTypeId = 13) AS LastUndeletedDate,
        COUNT(DISTINCT ph.Id) AS TotalHistoryEntries,
        COUNT(ph.Id) FILTER (WHERE ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)) AS TotalEditAndRollbackEvents,
        (
            SELECT MAX(ph2.CreationDate)
            FROM PostHistory ph2
            WHERE ph2.PostId = ph.PostId
              AND ph2.PostHistoryTypeId IN (4, 5, 6)
              AND ph2.CreationDate < (
                  SELECT MAX(ph3.CreationDate)
                  FROM PostHistory ph3
                  WHERE ph3.PostId = ph.PostId
                    AND ph3.PostHistoryTypeId IN (4, 5, 6)
              )
        ) AS SecondToLastEditDate,
        (
            SELECT crt.Name
            FROM PostHistory ph_close
            JOIN CloseReasonTypes crt ON CAST(SPLIT_PART(ph_close.Comment, ',', 1) AS SMALLINT) = crt.Id
            WHERE ph_close.PostId = ph.PostId
              AND ph_close.PostHistoryTypeId = 10
            ORDER BY ph_close.CreationDate DESC
            LIMIT 1
        ) AS PrimaryCloseReasonName,
        MAX(CASE WHEN ph.PostHistoryTypeId = 50 THEN 1 ELSE 0 END) AS WasCommunityBumped
    FROM PostHistory ph
    GROUP BY ph.PostId
),
PostContentAnalysis AS (
    SELECT
        p.Id AS PostId,
        LENGTH(p.Body) AS BodyCharacterCount,
        LENGTH(p.Title) AS TitleCharacterCount,
        LENGTH(p.Tags) AS TagsCharacterCount,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id AND c.Score > 0) AS PositiveCommentCount,
        (SELECT COUNT(DISTINCT pl.RelatedPostId) FROM PostLinks pl WHERE pl.PostId = p.Id AND pl.LinkTypeId = 1) AS LinksToOtherPostsCount,
        (SELECT COUNT(DISTINCT pl.RelatedPostId) FROM PostLinks pl WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3) AS DuplicatedByPostsCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvoteCountActual,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvoteCountActual,
        SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS FavoriteCountActual
    FROM Posts p
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.PostTypeId = 1
    GROUP BY p.Id, p.Body, p.Title, p.Tags
),
TagPerformanceMetrics AS (
    -- Split tags using recursive CTE to avoid dialect-specific UNNEST
    tag_source_cte AS (
        SELECT p.Id AS PostId, p.Tags
        FROM Posts p
        WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL AND LENGTH(TRIM(p.Tags)) > 2
    ),
    tag_exploded AS (
        SELECT
            PostId,
            TRIM(SUBSTR(Tags, 2, CASE WHEN INSTR(Tags, '><') > 0 THEN INSTR(Tags, '><')-2 ELSE LENGTH(Tags)-2 END)) AS tag,
            CASE
                WHEN INSTR(Tags, '><') > 0 THEN SUBSTR(Tags, INSTR(Tags, '><') + 2)
                ELSE NULL
            END AS rest
        FROM tag_source_cte
        UNION ALL
        SELECT
            PostId,
            TRIM(SUBSTR(rest, 1, CASE WHEN INSTR(rest, '><') > 0 THEN INSTR(rest, '><')-1 ELSE LENGTH(rest)-1 END)) AS tag,
            CASE
                WHEN rest IS NOT NULL AND INSTR(rest, '><') > 0 THEN SUBSTR(rest, INSTR(rest, '><')+2)
                ELSE NULL
            END AS rest
        FROM tag_exploded
        WHERE rest IS NOT NULL
    )
    SELECT
        tag AS TagName,
        COUNT(DISTINCT p.Id) AS TaggedQuestionCount,
        SUM(p.Score) AS TotalScorePerTag,
        AVG(p.Score) AS AvgScorePerTag,
        SUM(p.ViewCount) AS TotalViewsPerTag,
        AVG(p.ViewCount) AS AvgViewsPerTag,
        COUNT(DISTINCT p.OwnerUserId) AS UniqueOwnersPerTag
    FROM tag_exploded te
    JOIN Posts p ON p.Id = te.PostId
    GROUP BY tag
),
CoreQuestionData AS (
    SELECT
        p.Id AS PostId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.FavoriteCount,
        p.AnswerCount,
        p.CommentCount,
        u_owner.DisplayName AS OwnerDisplayName,
        u_owner.Location AS OwnerLocation,
        u_owner.WebsiteUrl AS OwnerWebsite,
        u_editor.DisplayName AS LastEditorDisplayName,
        uem.Reputation AS OwnerReputation,
        phd.TotalEditAndRollbackEvents,
        phd.TotalHistoryEntries,
        pca.BodyCharacterCount,
        pca.TitleCharacterCount,
        pca.PositiveCommentCount,
        pca.LinksToOtherPostsCount,
        pca.DuplicatedByPostsCount,
        pca.UpvoteCountActual,
        pca.DownvoteCountActual,
        COALESCE(phd.PrimaryCloseReasonName, 'N/A') AS PrimaryCloseReason,
        CASE
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Accepted'
            WHEN p.AnswerCount > 0 THEN 'Has Answers'
            ELSE 'No Accepted Answer'
        END AS AnswerStatus,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId, EXTRACT(YEAR FROM p.CreationDate)) AS OwnerAvgScoreInYear,
        RANK() OVER (PARTITION BY EXTRACT(YEAR FROM p.CreationDate) ORDER BY (p.Score * 2 + p.CommentCount * 3 + COALESCE(p.FavoriteCount, 0) * 5 + pca.UpvoteCountActual * 1.5) DESC, p.ViewCount DESC) AS EngagementRankByYear,
        CASE
            WHEN p.Tags IS NULL THEN ''
            ELSE REPLACE(SUBSTR(p.Tags, 2, LENGTH(p.Tags)-2), '><', ', ')
        END AS TagList,
        (
            SELECT c.Text
            FROM Comments c
            WHERE c.PostId = p.Id AND c.Score > 0
            ORDER BY c.CreationDate DESC
            LIMIT 1
        ) AS LatestPositiveCommentText,
        (p.Score * 10.0 + COALESCE(p.FavoriteCount, 0) * 5.0 + p.CommentCount * 2.0 + pca.LinksToOtherPostsCount * 3.0) / NULLIF(p.ViewCount + p.AnswerCount + 1, 0) AS WeightedEngagementRatio,
        COALESCE(p.LastEditDate, p.LastActivityDate, p.CreationDate) AS EffectiveLastActivityDate,
        (CASE WHEN p.ClosedDate IS NOT NULL THEN TRUE ELSE FALSE END) AS IsClosedFlag,
        (CASE WHEN p.CommunityOwnedDate IS NOT NULL THEN TRUE ELSE FALSE END) AS IsCommunityOwnedFlag,
        (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate) AS PostAgeInterval,
        (
            SELECT AVG(v_bounty.BountyAmount)
            FROM Votes v_bounty
            WHERE v_bounty.PostId = p.Id AND v_bounty.VoteTypeId = 8 AND v_bounty.BountyAmount IS NOT NULL
        ) AS AverageBountyAmount,
        phd.LastClosedDate,
        phd.LastReopenedDate,
        phd.LastDeletedDate,
        phd.LastUndeletedDate,
        phd.WasCommunityBumped,
        TRIM(COALESCE(
            (SELECT REGEXP_REPLACE(ph_body.Text, '[^a-zA-Z0-9 ]', '', 'g') FROM PostHistory ph_body WHERE ph_body.PostId = p.Id AND ph_body.PostHistoryTypeId = 5 ORDER BY ph_body.CreationDate DESC LIMIT 1),
            'No Body Edit'
        )) AS LastBodyEditTextClean,
        (CASE WHEN p.Tags LIKE '%<java>%' THEN 'Java Related'
              WHEN p.Tags LIKE '%<python>%' THEN 'Python Related'
              WHEN p.Tags LIKE '%<c#>%' THEN 'C# Related'
              ELSE 'Other Technology' END) AS PrimaryTechTagGroup
    FROM Posts p
    JOIN UserEngagementMetrics uem ON p.OwnerUserId = uem.UserId
    LEFT JOIN Users u_owner ON p.OwnerUserId = u_owner.Id
    LEFT JOIN Users u_editor ON p.LastEditorUserId = u_editor.Id
    LEFT JOIN PostHistoryDetailed phd ON p.Id = phd.PostId
    LEFT JOIN PostContentAnalysis pca ON p.Id = pca.PostId
    WHERE p.PostTypeId = 1
),
HighlyEngagedOrReopenedQuestions AS (
    SELECT
        'Highly Engaged Question' AS QuestionCategory,
        cq.PostId,
        cq.Title,
        cq.CreationDate,
        cq.Score,
        cq.ViewCount,
        cq.FavoriteCount,
        cq.AnswerCount,
        cq.CommentCount,
        cq.OwnerDisplayName,
        cq.OwnerLocation,
        cq.OwnerWebsite,
        cq.LastEditorDisplayName,
        cq.OwnerReputation,
        cq.TotalEditAndRollbackEvents,
        cq.TotalHistoryEntries,
        cq.BodyCharacterCount,
        cq.TitleCharacterCount,
        cq.PositiveCommentCount,
        cq.LinksToOtherPostsCount,
        cq.DuplicatedByPostsCount,
        cq.UpvoteCountActual,
        cq.DownvoteCountActual,
        cq.PrimaryCloseReason,
        cq.AnswerStatus,
        cq.OwnerAvgScoreInYear,
        cq.EngagementRankByYear,
        cq.TagList,
        cq.LatestPositiveCommentText,
        cq.WeightedEngagementRatio,
        cq.EffectiveLastActivityDate,
        cq.IsClosedFlag,
        cq.IsCommunityOwnedFlag,
        cq.PostAgeInterval,
        cq.AverageBountyAmount,
        cq.LastBodyEditTextClean,
        cq.PrimaryTechTagGroup,
        tpm.AvgScorePerTag AS FirstTagAverageScore
    FROM CoreQuestionData cq
    LEFT JOIN TagPerformanceMetrics tpm ON tpm.TagName = (
        CASE
            WHEN cq.TagList = '' THEN NULL
            WHEN INSTR(cq.TagList, ',') > 0 THEN TRIM(SUBSTR(cq.TagList, 1, INSTR(cq.TagList, ',')-1))
            ELSE TRIM(cq.TagList)
        END
    )
    WHERE
        cq.Score >= 100
        AND cq.ViewCount >= 5000
        AND cq.AnswerCount >= 5
        AND cq.TotalEditAndRollbackEvents > 3
        AND cq.WeightedEngagementRatio >= 1.5
        AND cq.BodyCharacterCount > 500
        AND cq.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '5 years')
        AND (cq.TagList ILIKE '%database%' OR cq.TagList ILIKE '%query%')
        AND (cq.OwnerLocation IS NOT NULL AND cq.OwnerLocation <> '')
        AND cq.WasCommunityBumped = 0
        AND cq.PrimaryTechTagGroup IN ('Java Related', 'Python Related', 'C# Related')
),
ControversialOrHistoricalQuestions AS (
    SELECT
        'Controversial/Historical Question' AS QuestionCategory,
        cq.PostId,
        cq.Title,
        cq.CreationDate,
        cq.Score,
        cq.ViewCount,
        cq.FavoriteCount,
        cq.AnswerCount,
        cq.CommentCount,
        cq.OwnerDisplayName,
        cq.OwnerLocation,
        cq.OwnerWebsite,
        cq.LastEditorDisplayName,
        cq.OwnerReputation,
        cq.TotalEditAndRollbackEvents,
        cq.TotalHistoryEntries,
        cq.BodyCharacterCount,
        cq.TitleCharacterCount,
        cq.PositiveCommentCount,
        cq.LinksToOtherPostsCount,
        cq.DuplicatedByPostsCount,
        cq.UpvoteCountActual,
        cq.DownvoteCountActual,
        cq.PrimaryCloseReason,
        cq.AnswerStatus,
        cq.OwnerAvgScoreInYear,
        cq.EngagementRankByYear,
        cq.TagList,
        cq.LatestPositiveCommentText,
        cq.WeightedEngagementRatio,
        cq.EffectiveLastActivityDate,
        cq.IsClosedFlag,
        cq.IsCommunityOwnedFlag,
        cq.PostAgeInterval,
        cq.AverageBountyAmount,
        cq.LastBodyEditTextClean,
        cq.PrimaryTechTagGroup,
        tpm.AvgScorePerTag AS FirstTagAverageScore
    FROM CoreQuestionData cq
    LEFT JOIN TagPerformanceMetrics tpm ON tpm.TagName = (
        CASE
            WHEN cq.TagList = '' THEN NULL
            WHEN INSTR(cq.TagList, ',') > 0 THEN TRIM(SUBSTR(cq.TagList, 1, INSTR(cq.TagList, ',')-1))
            ELSE TRIM(cq.TagList)
        END
    )
    WHERE
        (
            (cq.LastClosedDate IS NOT NULL AND cq.LastReopenedDate IS NOT NULL AND cq.LastReopenedDate > cq.LastClosedDate)
            OR (cq.LastDeletedDate IS NOT NULL AND cq.LastUndeletedDate IS NOT NULL AND cq.LastUndeletedDate > cq.LastDeletedDate)
            OR cq.TotalEditAndRollbackEvents > 10
        )
        AND cq.CreationDate < (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '3 years')
        AND cq.Score > 50
        AND cq.DuplicatedByPostsCount = 0
        AND cq.Title ILIKE '%problem%'
        AND cq.IsCommunityOwnedFlag = TRUE
        AND (cq.AverageBountyAmount IS NULL OR cq.AverageBountyAmount < 100)
)
SELECT * FROM HighlyEngagedOrReopenedQuestions
UNION ALL
SELECT * FROM ControversialOrHistoricalQuestions
ORDER BY QuestionCategory DESC, WeightedEngagementRatio DESC, EngagementRankByYear ASC, PostAgeInterval DESC, OwnerReputation DESC;