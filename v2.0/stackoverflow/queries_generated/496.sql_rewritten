-- {"query": "496.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 3535} 
with recent_questions as (
    select
        p.Id as QuestionId,
        p.CreationDate,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        coalesce(p.Title, '') as Title,
        p.Tags,
        date_trunc('month', p.CreationDate) as month_bucket
    from Posts p
    where p.PostTypeId = 1
      and p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '730 days'
),
answers as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId as AnswerOwnerId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreationDate,
        row_number() over (partition by a.ParentId order by a.Score desc nulls last, a.CreationDate asc) as rn_score,
        row_number() over (partition by a.ParentId order by a.CreationDate asc) as rn_first
    from Posts a
    where a.PostTypeId = 2
),
best_answer as (
    select
        r.QuestionId,
        a.AnswerId as TopScoredAnswerId,
        a.AnswerOwnerId as TopScorerUserId,
        a.AnswerScore as TopAnswerScore
    from recent_questions r
    left join answers a
      on a.QuestionId = r.QuestionId
     and a.rn_score = 1
),
first_answer as (
    select
        r.QuestionId,
        a.AnswerId as FirstAnswerId,
        a.AnswerOwnerId as FirstAnswerUserId,
        a.AnswerCreationDate as FirstAnswerDate
    from recent_questions r
    left join answers a
      on a.QuestionId = r.QuestionId
     and a.rn_first = 1
),
accepted_answer as (
    select
        r.QuestionId,
        p.AcceptedAnswerId
    from recent_questions r
    left join Posts p
      on p.Id = r.QuestionId
),
question_votes as (
    select
        v.PostId as QuestionId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as Favorites
    from Votes v
    join recent_questions r on r.QuestionId = v.PostId
    group by v.PostId
),
answer_votes as (
    select
        p.ParentId as QuestionId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as AnswerUpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as AnswerDownVotes
    from Posts p
    join Votes v on v.PostId = p.Id
    where p.PostTypeId = 2
      and exists (select 1 from recent_questions rq where rq.QuestionId = p.ParentId)
    group by p.ParentId
),
comment_stats as (
    select
        c.PostId,
        count(*) as CommentCount,
        max(c.Score) as MaxCommentScore,
        avg(coalesce(nullif(c.Score, 0), 0)) as AvgCommentScoreInclZero
    from Comments c
    where exists (select 1 from recent_questions rq where rq.QuestionId = c.PostId)
    group by c.PostId
),
post_history_flags as (
    select
        ph.PostId,
        max(case when ph.PostHistoryTypeId = 10 then 1 else 0 end) as WasClosed,
        max(case when ph.PostHistoryTypeId = 11 then 1 else 0 end) as WasReopened,
        max(case when ph.PostHistoryTypeId = 19 then 1 else 0 end) as WasProtected
    from PostHistory ph
    where exists (select 1 from recent_questions rq where rq.QuestionId = ph.PostId)
    group by ph.PostId
),
duplicates as (
    select
        pl.PostId as QuestionId,
        count(*) filter (where pl.LinkTypeId = 3) as DupCount,
        string_agg(distinct cast(pl.RelatedPostId as varchar), ',') as DupTargets
    from PostLinks pl
    where pl.LinkTypeId in (1,3)
      and exists (select 1 from recent_questions rq where rq.QuestionId = pl.PostId)
    group by pl.PostId
),
tag_expansion as (
    select
        r.QuestionId,
        unnest(string_to_array(substring(r.Tags, 2, greatest(length(r.Tags)-2,0)), '><')) as tag
    from recent_questions r
    where r.Tags is not null
),
primary_tag as (
    select
        QuestionId,
        min(tag) as PrimaryTag -- lexicographically earliest as surrogate for primary
    from tag_expansion
    group by QuestionId
),
tag_meta as (
    select
        te.QuestionId,
        pt.PrimaryTag,
        t.Count as TagGlobalCount,
        t.IsModeratorOnly::int as TagIsModOnly,
        t.IsRequired::int as TagIsRequired
    from primary_tag pt
    left join Tags t on t.TagName = pt.PrimaryTag
    right join tag_expansion te on te.QuestionId = pt.QuestionId
    group by te.QuestionId, pt.PrimaryTag, t.Count, t.IsModeratorOnly, t.IsRequired
),
user_summary as (
    select
        u.Id as UserId,
        u.Reputation,
        coalesce(nullif(trim(u.Location), ''), 'Unknown') as LocationNorm,
        date_trunc('month', u.CreationDate) as UserCohortMonth,
        sum(coalesce(u.UpVotes,0)) over () as TotalUpVotesAllUsers
    from Users u
),
question_owner as (
    select
        r.QuestionId,
        u.UserId,
        u.Reputation,
        u.LocationNorm,
        u.UserCohortMonth
    from recent_questions r
    left join user_summary u on u.UserId = r.OwnerUserId
),
badge_counts as (
    select
        b.UserId,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeBadges,
        sum(case when b.TagBased = 1 then 1 else 0 end) as TagBadges
    from Badges b
    group by b.UserId
),
monthly_activity as (
    select
        r.month_bucket,
        count(*) as QuestionsInMonth,
        avg(r.Score) as AvgQuestionScore,
        percentile_cont(0.5) within group (order by r.ViewCount) as MedianViews
    from recent_questions r
    group by r.month_bucket
),
accepted_vs_top as (
    select
        r.QuestionId,
        case when a.AcceptedAnswerId is null then 'none'
             when a.AcceptedAnswerId = b.TopScoredAnswerId then 'accepted_is_top'
             else 'accepted_not_top'
        end as AcceptedTopCategory
    from recent_questions r
    left join accepted_answer a on a.QuestionId = r.QuestionId
    left join best_answer b on b.QuestionId = r.QuestionId
),
complex_filters as (
    select
        r.QuestionId
    from recent_questions r
    left join question_votes qv on qv.QuestionId = r.QuestionId
    left join answer_votes av on av.QuestionId = r.QuestionId
    left join duplicates d on d.QuestionId = r.QuestionId
    where
        coalesce(qv.UpVotes,0) - coalesce(qv.DownVotes,0) + coalesce(r.Score,0) >= 0
        and coalesce(r.ViewCount,0) >= 0
        and (
            d.DupCount is null
            or d.DupCount = 0
            or (coalesce(qv.Favorites,0) > 0 and coalesce(av.AnswerUpVotes,0) > coalesce(av.AnswerDownVotes,0))
        )
)
select
    r.QuestionId,
    r.CreationDate,
    r.Title,
    coalesce(pm.PrimaryTag, '(none)') as PrimaryTag,
    coalesce(pm.TagGlobalCount, 0) as TagGlobalCount,
    coalesce(qo.UserId, -1) as OwnerUserId,
    coalesce(qo.Reputation, 0) as OwnerReputation,
    coalesce(qo.LocationNorm, 'Unknown') as OwnerLocation,
    to_char(qo.UserCohortMonth, 'YYYY-MM') as OwnerCohortMonth,
    coalesce(bc.GoldBadges,0) as OwnerGoldBadges,
    coalesce(bc.SilverBadges,0) as OwnerSilverBadges,
    coalesce(bc.BronzeBadges,0) as OwnerBronzeBadges,
    coalesce(bc.TagBadges,0) as OwnerTagBadges,
    coalesce(qv.UpVotes,0) as QUpVotes,
    coalesce(qv.DownVotes,0) as QDownVotes,
    coalesce(qv.Favorites,0) as QFavorites,
    coalesce(av.AnswerUpVotes,0) as AnsUpVotes,
    coalesce(av.AnswerDownVotes,0) as AnsDownVotes,
    coalesce(cs.CommentCount,0) as CommentCount,
    coalesce(cs.MaxCommentScore,0) as MaxCommentScore,
    coalesce(cs.AvgCommentScoreInclZero,0) as AvgCommentScoreInclZero,
    coalesce(ph.WasClosed,0) as WasClosed,
    coalesce(ph.WasReopened,0) as WasReopened,
    coalesce(ph.WasProtected,0) as WasProtected,
    coalesce(d.DupCount,0) as DuplicateLinks,
    coalesce(d.DupTargets,'') as DuplicateTargets,
    ba.TopScoredAnswerId,
    fa.FirstAnswerId,
    aa.AcceptedAnswerId,
    case when aa.AcceptedAnswerId is not null then 1 else 0 end as HasAccepted,
    evs.AcceptedTopCategory,
    rank() over (partition by pm.PrimaryTag order by coalesce(qv.UpVotes,0) - coalesce(qv.DownVotes,0) + greatest(r.Score,0) desc, r.ViewCount desc) as RankInTagByScoreViews,
    dense_rank() over (order by date_trunc('month', r.CreationDate)) as MonthOrder,
    sum(coalesce(qv.Favorites,0)) over (partition by pm.PrimaryTag) as TotalFavoritesPerTag,
    avg(coalesce(r.ViewCount,0)) over (partition by pm.PrimaryTag) as AvgViewsPerTag,
    sum(case when ph.WasClosed = 1 then 1 else 0 end) over (partition by pm.PrimaryTag) as ClosedPerTag,
    count(*) over () as TotalRowsWindow,
    case
        when pm.TagIsModOnly = 1 then 'mod-only'
        when pm.TagIsRequired = 1 then 'required'
        when pm.TagGlobalCount >= 100000 then 'very-popular'
        when pm.TagGlobalCount between 10000 and 99999 then 'popular'
        when pm.TagGlobalCount between 1000 and 9999 then 'niche'
        when pm.TagGlobalCount between 1 and 999 then 'rare'
        else 'unknown'
    end as TagBucket,
    coalesce(
        nullif(trim(regexp_replace(lower(r.Title), '[^a-z0-9]+', ' ', 'g')), ''),
        '(untitled)'
    ) as NormalizedTitle,
    length(coalesce(r.Title,'')) as TitleLength,
    case when r.Tags is null then 0 else cardinality(string_to_array(substring(r.Tags, 2, greatest(length(r.Tags)-2,0)), '><')) end as TagCount
from recent_questions r
left join best_answer ba on ba.QuestionId = r.QuestionId
left join first_answer fa on fa.QuestionId = r.QuestionId
left join accepted_answer aa on aa.QuestionId = r.QuestionId
left join question_votes qv on qv.QuestionId = r.QuestionId
left join answer_votes av on av.QuestionId = r.QuestionId
left join comment_stats cs on cs.PostId = r.QuestionId
left join post_history_flags ph on ph.PostId = r.QuestionId
left join duplicates d on d.QuestionId = r.QuestionId
left join tag_meta pm on pm.QuestionId = r.QuestionId
left join question_owner qo on qo.QuestionId = r.QuestionId
left join badge_counts bc on bc.UserId = qo.UserId
left join accepted_vs_top evs on evs.QuestionId = r.QuestionId
join complex_filters cf on cf.QuestionId = r.QuestionId
qualify
    (row_number() over (partition by pm.PrimaryTag order by r.CreationDate desc)) <= 500
union all
select
    r.QuestionId,
    r.CreationDate,
    r.Title,
    '(no-tag)' as PrimaryTag,
    0 as TagGlobalCount,
    coalesce(qo.UserId, -1) as OwnerUserId,
    coalesce(qo.Reputation, 0) as OwnerReputation,
    coalesce(qo.LocationNorm, 'Unknown') as OwnerLocation,
    to_char(qo.UserCohortMonth, 'YYYY-MM') as OwnerCohortMonth,
    coalesce(bc.GoldBadges,0) as OwnerGoldBadges,
    coalesce(bc.SilverBadges,0) as OwnerSilverBadges,
    coalesce(bc.BronzeBadges,0) as OwnerBronzeBadges,
    coalesce(bc.TagBadges,0) as OwnerTagBadges,
    coalesce(qv.UpVotes,0) as QUpVotes,
    coalesce(qv.DownVotes,0) as QDownVotes,
    coalesce(qv.Favorites,0) as QFavorites,
    coalesce(av.AnswerUpVotes,0) as AnsUpVotes,
    coalesce(av.AnswerDownVotes,0) as AnsDownVotes,
    coalesce(cs.CommentCount,0) as CommentCount,
    coalesce(cs.MaxCommentScore,0) as MaxCommentScore,
    coalesce(cs.AvgCommentScoreInclZero,0) as AvgCommentScoreInclZero,
    coalesce(ph.WasClosed,0) as WasClosed,
    coalesce(ph.WasReopened,0) as WasReopened,
    coalesce(ph.WasProtected,0) as WasProtected,
    coalesce(d.DupCount,0) as DuplicateLinks,
    coalesce(d.DupTargets,'') as DuplicateTargets,
    ba.TopScoredAnswerId,
    fa.FirstAnswerId,
    aa.AcceptedAnswerId,
    case when aa.AcceptedAnswerId is not null then 1 else 0 end as HasAccepted,
    evs.AcceptedTopCategory,
    null as RankInTagByScoreViews,
    dense_rank() over (order by date_trunc('month', r.CreationDate)) as MonthOrder,
    null as TotalFavoritesPerTag,
    null as AvgViewsPerTag,
    null as ClosedPerTag,
    count(*) over () as TotalRowsWindow,
    'unknown' as TagBucket,
    coalesce(
        nullif(trim(regexp_replace(lower(r.Title), '[^a-z0-9]+', ' ', 'g')), ''),
        '(untitled)'
    ) as NormalizedTitle,
    length(coalesce(r.Title,'')) as TitleLength,
    0 as TagCount
from recent_questions r
left join best_answer ba on ba.QuestionId = r.QuestionId
left join first_answer fa on fa.QuestionId = r.QuestionId
left join accepted_answer aa on aa.QuestionId = r.QuestionId
left join question_votes qv on qv.QuestionId = r.QuestionId
left join answer_votes av on av.QuestionId = r.QuestionId
left join comment_stats cs on cs.PostId = r.QuestionId
left join post_history_flags ph on ph.PostId = r.QuestionId
left join duplicates d on d.QuestionId = r.QuestionId
left join question_owner qo on qo.QuestionId = r.QuestionId
left join badge_counts bc on bc.UserId = qo.UserId
left join accepted_vs_top evs on evs.QuestionId = r.QuestionId
join complex_filters cf on cf.QuestionId = r.QuestionId
where r.Tags is null;