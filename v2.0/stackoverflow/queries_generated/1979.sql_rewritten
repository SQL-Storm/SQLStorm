    ATM_Ans.QuestionsWithTag,
    ATM_Ans.TotalTagScore,
    ATM_Ans.AvgTagViewCount,
    ATM_Ans.TagScoreRank,
    NULL AS RelatedPostId,
    NULL AS LinkTypeName,
    NULL AS RelatedPostTitle,
    NULL AS RelatedPostScore,
    SUBSTRING(P.Body, 1, 150) AS AcceptedAnswerBodyExcerpt, -- Directly get body excerpt for answers
    (P.Score * 100.0) / (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 2 AND Score IS NOT NULL) AS ScoreVsOverallAvgPct,
    'HighScoreAnswerEntry' AS EngagementCategory,
    UPPER(SUBSTRING(P.Title, 1, 10)) || '...' || REPLACE(LOWER(P.Title), 'answer', 'RESPONSE') AS ModifiedTitlePreview,
    U.Reputation - COALESCE(P.Score * 5, 0) AS ReputationAdjustedForAnswerScore
FROM Posts AS P
INNER JOIN Users AS U ON P.OwnerUserId = U.Id
LEFT JOIN LATERAL (
    SELECT TRIM(UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><'))) AS TagName, P.Id
) AS PostTags_Ans ON TRUE
LEFT JOIN AggregatedTagMetrics AS ATM_Ans ON PostTags_Ans.TagName = ATM_Ans.TagName
WHERE P.PostTypeId = 2 -- Only answers
AND P.Score > 50 -- Only highly upvoted answers
AND P.CreationDate >= '2023-01-01'
AND P.ParentId IS NOT NULL -- Must be an answer to a question
AND EXISTS (SELECT 1 FROM Posts Q WHERE Q.Id = P.ParentId AND Q.AcceptedAnswerId = P.Id) -- Is an accepted answer
ORDER BY PostScore DESC, Reputation DESC
LIMIT 10000;