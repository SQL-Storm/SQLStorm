    P.Title AS PostTitle,
    P.CreationDate AS PostCreationDate,
    P.Score AS PostScore,
    P.ViewCount,
    P.AnswerCount,
    P.FavoriteCount,
    'High Score Answer' AS PopularitySegment, -- Custom segment for union
    FALSE AS IsDuplicateSource,
    FALSE AS IsDuplicateTarget,
