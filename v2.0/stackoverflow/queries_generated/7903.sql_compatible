    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.UserId AND p.PostTypeId = 2) as user_answer_count,
    DENSE_RANK() OVER (ORDER BY pa.Score DESC) as post_rank_score,
    DENSE_RANK() OVER (ORDER BY pa.ViewCount DESC) as post_rank_views,
    NTILE(4) OVER (ORDER BY pa.Score) as score_quartile,
    AVG(pa.Score) OVER (PARTITION BY u.UserId) as user_avg_score,
    MAX(pa.Score) OVER (PARTITION BY u.UserId) as user_max_score,
    STRING_AGG(DISTINCT CASE WHEN pa.Score > 0 THEN ta.TagName END, ', ') as positive_tag_list,
    (
        SELECT STRING_AGG('(' || vt.Name || ':' || COUNT(*) || ')', ', ')
        FROM Votes v
        JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
        WHERE v.PostId = pa.PostId
        GROUP BY v.PostId
    ) as vote_breakdown
FROM UserStats u
INNER JOIN ComplexPostAnalysis pa ON u.UserId = pa.OwnerUserId
LEFT JOIN TagAnalysis ta ON pa.Tags LIKE '%' || ta.TagName || '%'
WHERE 
    u.post_count > 0
    AND pa.Score < 0 
    AND u.Reputation < 1000
    AND ta.Count < 10
    AND pa.engagement_level = 'Normal Engagement'
GROUP BY 
    u.DisplayName,
    u.Reputation,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    pa.PostId,
    pa.Title,
    pa.Tags,
    pa.Score,
    pa.ViewCount,
    pa.AnswerCount,
    pa.CommentCount,
    pa.FavoriteCount,
    pa.CreationDate,
    pa.score_category,
    pa.answer_to_view_ratio,
    pa.days_since_creation,
    pa.engagement_level,
    pa.score_deviation,
    pa.comment_status,
    pa.has_upvotes,
    pa.badge_names,
    ta.TagName,
    ta.Count,
    ta.popularity_level,
    ta.popularity_rank
ORDER BY 
    pa.Score DESC,
    u.Reputation DESC,
    pa.ViewCount DESC,
    pa.days_since_creation ASC;