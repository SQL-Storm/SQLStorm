-- {"query": "155.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 3618} 
with
-- recent active users with engagement metrics
u as (
  select
    u.id,
    u.displayname,
    u.reputation,
    u.creationdate,
    coalesce(nullif(trim(u.location), ''), 'Unknown') as location_norm,
    u.upvotes,
    u.downvotes,
    u.views,
    greatest(u.upvotes - u.downvotes, 0) as net_votes,
    date_trunc('month', u.creationdate) as cohort_month
  from users u
  where u.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
-- questions and answers enriched
p as (
  select
    p.id,
    p.posttypeid,
    p.owneruserid,
    p.creationdate,
    p.score,
    p.viewcount,
    p.answercount,
    p.favoritecount,
    p.commentcount,
    p.acceptedanswerid,
    p.parentid,
    p.title,
    p.tags,
    case when p.posttypeid = 1 then 'Question'
         when p.posttypeid = 2 then 'Answer'
         else 'Other' end as post_kind
  from posts p
  where p.creationdate is not null
),
-- tag string to first tag for bucketing
question_primary_tag as (
  select
    q.id as question_id,
    split_part(trim(both '<>' from coalesce(q.tags, '')), '><', 1) as primary_tag
  from p q
  where q.posttypeid = 1
),
-- compute duplicates and linked counts per question via postlinks
question_link_stats as (
  select
    pl.postid as question_id,
    sum(case when pl.linktypeid = 3 then 1 else 0 end) as duplicate_links,
    sum(case when pl.linktypeid = 1 then 1 else 0 end) as linked_links,
    count(*) as total_links
  from postlinks pl
  group by pl.postid
),
-- identify closures and close reasons from posthistory
question_closure as (
  select
    ph.postid as question_id,
    min(ph.creationdate) filter (where ph.posthistorytypeid = 10) as first_close_date,
    max(ph.creationdate) filter (where ph.posthistorytypeid = 11) as last_reopen_date,
    max(ph.creationdate) filter (where ph.posthistorytypeid = 10) as last_close_date,
    -- last close reason id from Comment field when type=10; cast safely
    cast(
      nullif(regexp_replace(ph.comment, '[^0-9]', '', 'g'), '')
      as int
    ) as close_reason_id
  from posthistory ph
  where ph.posthistorytypeid in (10,11)
  group by ph.postid, cast(nullif(regexp_replace(ph.comment, '[^0-9]', '', 'g'), '') as int)
),
-- accepted answers and their authors
accepted_answers as (
  select
    q.id as question_id,
    q.acceptedanswerid,
    a.owneruserid as accepted_owner_id,
    a.score as accepted_score,
    a.creationdate as accepted_creationdate
  from p q
  join p a on a.id = q.acceptedanswerid
  where q.posttypeid = 1 and q.acceptedanswerid is not null
),
-- user monthly activity stats with window functions
user_monthly as (
  select
    u.id as user_id,
    date_trunc('month', p.creationdate) as month,
    count(*) filter (where p.posttypeid = 1) as questions_posted,
    count(*) filter (where p.posttypeid = 2) as answers_posted,
    sum(coalesce(p.score,0)) as total_post_score,
    sum(coalesce(p.viewcount,0)) filter (where p.posttypeid = 1) as question_views,
    sum(coalesce(p.commentcount,0)) as comment_events,
    row_number() over (partition by u.id order by date_trunc('month', p.creationdate)) as month_seq,
    sum(coalesce(p.score,0)) over (partition by u.id order by date_trunc('month', p.creationdate) rows between unbounded preceding and current row) as cum_score
  from u
  left join p on p.owneruserid = u.id
  group by u.id, date_trunc('month', p.creationdate)
),
-- top tags by question count in the last 2 years
top_tags as (
  select
    qpt.primary_tag,
    count(*) as q_count
  from p q
  join question_primary_tag qpt on qpt.question_id = q.id
  where q.posttypeid = 1
    and q.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '2 years'
    and qpt.primary_tag is not null and qpt.primary_tag <> ''
  group by qpt.primary_tag
  having count(*) >= 50
),
-- comment sentiment-ish proxy: high-score comments per post
post_comment_stats as (
  select
    c.postid,
    count(*) as comments_total,
    sum(case when c.score >= 5 then 1 else 0 end) as comments_high_score,
    max(c.score) as max_comment_score,
    min(c.creationdate) as first_comment_date
  from comments c
  group by c.postid
),
-- badge counts per user with window ranks
user_badges as (
  select
    b.userid,
    sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
    sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
    sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
    sum(case when b.tagbased = 1 then 1 else 0 end) as tag_badges,
    count(*) as total_badges
  from badges b
  group by b.userid
),
-- Votes summary on posts
post_votes as (
  select
    v.postid,
    sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
    sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
    sum(case when v.votetypeid = 1 then 1 else 0 end) as accepted_by_originator,
    sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded
  from votes v
  group by v.postid
),
-- Identify "hot" questions via heuristic
hot_questions as (
  select
    q.id as question_id,
    q.creationdate,
    q.score,
    q.viewcount,
    q.answercount,
    coalesce(pv.upvotes,0) - coalesce(pv.downvotes,0) as net_votes,
    coalesce(pcs.comments_high_score,0) as hi_comments,
    coalesce(qls.duplicate_links,0) as dup_links,
    case
      when q.viewcount >= 10000 and q.score >= 10 then 'VeryHot'
      when q.viewcount >= 5000 and q.score >= 5 then 'Hot'
      when q.viewcount >= 1000 and q.score >= 2 then 'Warm'
      else 'Cold'
    end as heat_bucket
  from p q
  left join post_votes pv on pv.postid = q.id
  left join post_comment_stats pcs on pcs.postid = q.id
  left join question_link_stats qls on qls.question_id = q.id
  where q.posttypeid = 1
),
-- per-user engagement with hot questions within 30 days of joining (correlated-like)
user_early_hot_engagement as (
  select
    u.id as user_id,
    count(*) as early_hot_q_seen
  from u
  join hot_questions hq
    on hq.creationdate between u.creationdate and u.creationdate + interval '30 days'
  group by u.id
),
-- mix set operators: active vs inactive posters last year
active_users_last_year as (
  select distinct p.owneruserid as user_id
  from p
  where p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
),
inactive_users_last_year as (
  select id as user_id from users
  except
  select user_id from active_users_last_year
),
-- cross tag-user performance for top tags
user_tag_perf as (
  select
    u.id as user_id,
    tt.primary_tag,
    count(*) as q_count,
    avg(coalesce(q.score,0)) as avg_q_score,
    percentile_cont(0.5) within group (order by coalesce(q.viewcount,0)) as median_q_views
  from u
  join p q on q.owneruserid = u.id and q.posttypeid = 1
  join question_primary_tag tt on tt.question_id = q.id
  where tt.primary_tag in (select primary_tag from top_tags)
  group by u.id, tt.primary_tag
),
-- normalize displayname for grouping (case-insensitive, strip spaces)
user_name_norm as (
  select
    u.id as user_id,
    lower(regexp_replace(coalesce(u.displayname, 'user_' || u.id::text), '\s+', '', 'g')) as displayname_key
  from u
),
-- find potential duplicate accounts by name key
possible_dupe_accounts as (
  select
    unn.displayname_key,
    array_agg(unn.user_id order by unn.user_id) as user_ids,
    count(*) as user_count
  from user_name_norm unn
  group by unn.displayname_key
  having count(*) > 1
),
-- assemble final per-user metrics
user_agg as (
  select
    u.id as user_id,
    u.displayname,
    u.location_norm,
    u.reputation,
    u.cohort_month,
    u.views as profile_views,
    u.upvotes,
    u.downvotes,
    u.net_votes,
    coalesce(ub.total_badges,0) as badges_total,
    coalesce(ub.gold_badges,0) as badges_gold,
    coalesce(ub.silver_badges,0) as badges_silver,
    coalesce(ub.bronze_badges,0) as badges_bronze,
    coalesce(ub.tag_badges,0) as badges_tagbased,
    coalesce(uehe.early_hot_q_seen,0) as early_hot_q_seen,
    case when au.user_id is not null then 1 else 0 end as active_last_year,
    case when iu.user_id is not null then 1 else 0 end as inactive_last_year,
    pd.user_ids as possible_dupe_userids
  from u
  left join user_badges ub on ub.userid = u.id
  left join user_early_hot_engagement uehe on uehe.user_id = u.id
  left join active_users_last_year au on au.user_id = u.id
  left join inactive_users_last_year iu on iu.user_id = u.id
  left join user_name_norm unn on unn.user_id = u.id
  left join possible_dupe_accounts pd on pd.displayname_key = unn.displayname_key
),
-- compute per-question response latency to accepted answer
question_response_latency as (
  select
    q.id as question_id,
    extract(epoch from (a.accepted_creationdate - q.creationdate)) / 3600.0 as hours_to_accept,
    a.accepted_owner_id as answerer_id
  from p q
  join accepted_answers a on a.question_id = q.id
),
-- rank users by their median hours_to_accept across answered questions
user_accept_latency as (
  select
    qrl.answerer_id as user_id,
    percentile_cont(0.5) within group (order by qrl.hours_to_accept) as median_hours_to_accept,
    count(*) as accepted_answers_count
  from question_response_latency qrl
  group by qrl.answerer_id
),
-- heavy join bringing everything together
final as (
  select
    ua.user_id,
    ua.displayname,
    ua.location_norm,
    ua.reputation,
    ua.cohort_month,
    ua.profile_views,
    ua.upvotes,
    ua.downvotes,
    ua.net_votes,
    ua.badges_total,
    ua.badges_gold,
    ua.badges_silver,
    ua.badges_bronze,
    ua.badges_tagbased,
    ua.early_hot_q_seen,
    ua.active_last_year,
    ua.inactive_last_year,
    coalesce(ual.median_hours_to_accept, null) as median_hours_to_accept,
    coalesce(ual.accepted_answers_count, 0) as accepted_answers_count,
    coalesce(array_length(ua.possible_dupe_userids,1),0) as possible_dupe_accounts,
    -- aggregate user tagging perf into json-like text for portability
    string_agg(
      case when ut.primary_tag is null then null
      else ut.primary_tag || ':' ||
           coalesce(ut.q_count::text,'0') || '/' ||
           coalesce(round(ut.avg_q_score::numeric,2)::text,'0') || '/' ||
           coalesce(round(ut.median_q_views::numeric,2)::text,'0')
      end,
      ';'
      order by ut.q_count desc nulls last
    ) filter (where ut.primary_tag is not null) as tag_perf_compact
  from user_agg ua
  left join user_accept_latency ual on ual.user_id = ua.user_id
  left join user_tag_perf ut on ut.user_id = ua.user_id
  group by
    ua.user_id, ua.displayname, ua.location_norm, ua.reputation, ua.cohort_month,
    ua.profile_views, ua.upvotes, ua.downvotes, ua.net_votes,
    ua.badges_total, ua.badges_gold, ua.badges_silver, ua.badges_bronze, ua.badges_tagbased,
    ua.early_hot_q_seen, ua.active_last_year, ua.inactive_last_year, ual.median_hours_to_accept, ual.accepted_answers_count
),
-- enrich with per-user recent post stats and last activity via correlated subqueries
user_recent_post_stats as (
  select
    u.id as user_id,
    coalesce((
      select count(*) from p p1
      where p1.owneruserid = u.id and p1.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days'
    ),0) as posts_last_90d,
    coalesce((
      select max(p2.creationdate) from p p2 where p2.owneruserid = u.id
    ), null) as last_post_date,
    coalesce((
      select sum(case when p3.posttypeid = 2 then 1 else 0 end) from p p3 where p3.owneruserid = u.id and p3.score >= 5
    ),0) as high_score_answers
  from users u
)
select
  f.user_id,
  f.displayname,
  f.location_norm,
  f.reputation,
  f.cohort_month,
  f.profile_views,
  f.upvotes,
  f.downvotes,
  f.net_votes,
  f.badges_total,
  f.badges_gold,
  f.badges_silver,
  f.badges_bronze,
  f.badges_tagbased,
  f.early_hot_q_seen,
  f.active_last_year,
  f.inactive_last_year,
  f.median_hours_to_accept,
  f.accepted_answers_count,
  f.possible_dupe_accounts,
  coalesce(f.tag_perf_compact, '') as tag_perf_compact,
  urps.posts_last_90d,
  urps.last_post_date,
  urps.high_score_answers,
  -- composite engagement score mixing normalized components
  round((
    least(f.reputation/1000.0, 1.0) * 0.25 +
    least(nullif(f.badges_total,0)::float / greatest(f.badges_total,1), 1.0) * 0.05 + -- stabilizer
    least(coalesce(f.accepted_answers_count,0)/100.0, 1.0) * 0.2 +
    least(coalesce(urps.high_score_answers,0)/50.0, 1.0) * 0.15 +
    least(coalesce(urps.posts_last_90d,0)/20.0, 1.0) * 0.15 +
    least(greatest(0.0, 48.0 - coalesce(f.median_hours_to_accept,48.0))/48.0, 1.0) * 0.2
  )::numeric, 4) as engagement_score
from final f
left join user_recent_post_stats urps on urps.user_id = f.user_id
where coalesce(f.reputation,0) >= 1
order by engagement_score desc nulls last, f.reputation desc, f.user_id
limit 500;