WITH badge_counts AS (
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(*)                                   AS TotalBadges
    FROM Badges b
    GROUP BY b.UserId
),

/* 2️⃣ CTE: compute post‑related statistics per user */
post_stats AS (
    SELECT
        p.OwnerUserId                                            AS UserId,
        COUNT(*)                                                 AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS QuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS AnswerScore,
        AVG(p.Score)                                            AS AvgScore,
        MAX(p.LastActivityDate)                                 AS LastActivity,
        COUNT(DISTINCT p.Tags)                                   AS DistinctTagSets
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),

/* 3️⃣ CTE: for every user, find the tag (from the parent question) in which they have the most answers */
top_tag_per_user AS (
    SELECT
        a.OwnerUserId                                            AS UserId,
        COALESCE(
            (SELECT UNNEST(string_to_array(q.Tags, '><')) 
             FROM Posts q 
             WHERE q.Id = a.ParentId 
               AND q.Tags IS NOT NULL
             ORDER BY (SELECT COUNT(*) 
                       FROM Posts a2 
                       WHERE a2.OwnerUserId = a.OwnerUserId 
                         AND a2.ParentId = q.Id) DESC
             LIMIT 1),
            'unknown'
        )                                                     AS TopTag,
        ROW_NUMBER() OVER (PARTITION BY a.OwnerUserId
                           ORDER BY COUNT(*) DESC) AS rn
    FROM Posts a
    WHERE a.PostTypeId = 2                -- answers only
      AND a.OwnerUserId IS NOT NULL
    GROUP BY a.OwnerUserId, a.ParentId
),

/* 4️⃣ CTE: recent activity flag (last 30 days) */
recent_activity AS (
    SELECT
        u.Id               AS UserId,
        CASE WHEN u.LastAccessDate >= (cast('2024-10-01' as date) - INTERVAL '30 day')
             THEN 1 ELSE 0 END AS ActiveLast30d
    FROM Users u
),

/* 5️⃣ CTE: combine everything – only keep the top tag (rn = 1) */
user_aggregates AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(bc.GoldBadges,   0)    AS GoldBadges,
        COALESCE(bc.SilverBadges, 0)    AS SilverBadges,
        COALESCE(bc.BronzeBadges, 0)    AS BronzeBadges,
        COALESCE(ps.TotalPosts,   0)    AS TotalPosts,
        COALESCE(ps.QuestionScore,0)    AS QuestionScore,
        COALESCE(ps.AnswerScore,  0)    AS AnswerScore,
        COALESCE(ps.AvgScore,     0)    AS AvgScore,
        ps.LastActivity,
        tt.TopTag,
        ra.ActiveLast30d,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        -- A “complex” calculated column mixing strings, numbers and NULL logic
        CASE
            WHEN u.Location IS NULL OR u.Location = '' THEN 'Location unknown'
            ELSE CONCAT('From ', u.Location)
        END ||
        ' — ' ||
        COALESCE(NULLIF(u.WebsiteUrl, ''), 'no website')
        AS ProfileSummary
    FROM Users u
    LEFT JOIN badge_counts bc      ON bc.UserId = u.Id
    LEFT JOIN post_stats ps        ON ps.UserId = u.Id
    LEFT JOIN recent_activity ra   ON ra.UserId = u.Id
    LEFT JOIN (
        SELECT UserId, TopTag
        FROM top_tag_per_user
        WHERE rn = 1
    ) tt                          ON tt.UserId = u.Id
)

/* 6️⃣ Final SELECT – we union two logical sets to increase complexity */
SELECT
    ua.Id,
    ua.DisplayName,
    ua.Reputation,
    ua.GoldBadges,
    ua.SilverBadges,
    ua.BronzeBadges,
    ua.TotalPosts,
    ua.QuestionScore,
    ua.AnswerScore,
    ROUND(ua.AvgScore,2)                AS AvgScoreRounded,
    ua.LastActivity,
    ua.TopTag,
    ua.ActiveLast30d,
    ua.ReputationRank,
    ua.ProfileSummary
FROM user_aggregates ua
WHERE ua.Reputation >= 5000
  AND ua.ActiveLast30d = 1
  AND ua.GoldBadges > 0

UNION ALL

SELECT
    ua.Id,
    ua.DisplayName,
    ua.Reputation,
    ua.GoldBadges,
    ua.SilverBadges,
    ua.BronzeBadges,
    ua.TotalPosts,
    ua.QuestionScore,
    ua.AnswerScore,
    ROUND(ua.AvgScore,2)                AS AvgScoreRounded,
    ua.LastActivity,
    ua.TopTag,
    ua.ActiveLast30d,
    ua.ReputationRank,
    ua.ProfileSummary
FROM user_aggregates ua
WHERE ua.Reputation BETWEEN 1000 AND 4999
  AND ua.TotalPosts >= 10
  AND ua.TopTag IS NOT NULL
ORDER BY Reputation DESC, Id;