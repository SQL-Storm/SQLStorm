    SA.TotalUsers,
    ROUND(SA.MedianScore, 1) AS MedianScoreValue,
    ROUND(SA.ScoreVariance, 2) AS ScoreVarianceValue,
    ROUND(SA.ScoreStdDev, 2) AS ScoreStdDevValue
FROM FinalAnalysis SA
WHERE SA.UserId IN (
    SELECT UserId 
    FROM SetOperatorsDemo
    WHERE TotalScore > (
        SELECT AVG(TotalScore) 
        FROM FinalAnalysis
    )
)
AND SA.CreationDate >= (
    SELECT MIN(CreationDate) 
    FROM Posts 
    WHERE PostTypeId = 1
)
AND SA.DisplayName LIKE '%Stack%'
ORDER BY SA.Score DESC, SA.Reputation DESC
LIMIT 1000;