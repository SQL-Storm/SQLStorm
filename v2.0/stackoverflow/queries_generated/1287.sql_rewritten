-- {"query": "1287.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3967} 
WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.Views,
        U.UpVotes,
        U.DownVotes,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COALESCE(U.Location, 'Global_Unknown') AS UserLocation, -- NULL logic
        COUNT(DISTINCT P.Id) AS TotalPostsOwned,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestionsOwned,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswersOwned,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        MAX(P.Score) AS MaxPostScoreOwned,
        AVG(P.Score) AS AveragePostScoreOwned,
        DATE_PART('day', cast('2024-10-01 12:34:56' as timestamp) - MAX(U.LastAccessDate)) AS DaysSinceLastUserActivity, -- Date calculation
        -- Complex calculation using NULL logic and multiple fields
        CAST(COALESCE(U.UpVotes, 0) AS DECIMAL) / NULLIF(COALESCE(U.DownVotes, 0) + COALESCE(U.UpVotes, 0) + 1, 0) AS UpDownVoteRatio, -- Add 1 to denominator to avoid division by zero even if NULLIF fails
        MAX(CASE WHEN PH.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15) THEN PH.CreationDate ELSE NULL END) AS LastUserModerationActionDate
    FROM Users AS U
    LEFT JOIN Posts AS P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments AS C ON U.Id = C.UserId
    LEFT JOIN Badges AS B ON U.Id = B.UserId
    LEFT JOIN PostHistory AS PH ON U.Id = PH.UserId -- history made by user
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.Views, U.UpVotes, U.DownVotes, U.CreationDate, U.LastAccessDate, U.Location
    HAVING COUNT(DISTINCT P.Id) > 5 AND U.Reputation > 500 -- Filter for somewhat active/reputable users
),
PostEngagementMetrics AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.Score AS PostScore,
        P.ViewCount,
        P.AnswerCount,
        P.CommentCount AS PostCommentCount,
        COALESCE(P.FavoriteCount, 0) AS PostFavoriteCount,
        P.CreationDate AS PostCreationDate,
        P.LastActivityDate AS PostLastActivityDate,
        P.ClosedDate,
        P.CommunityOwnedDate,
        P.OwnerUserId,
        -- String expression to extract the first tag from the tags string
        NULLIF(SUBSTRING(P.Tags, 2, POSITION('>' IN P.Tags) - 2), '') AS PrimaryTag,
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesReceived,
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesReceived,
        SUM(CASE WHEN V.VoteTypeId = 1 THEN 1 ELSE 0 END) AS AcceptedVotes,
        -- String expression and NULL logic for title
        COALESCE(P.Title, 'No Title Provided for Post ' || P.Id) AS PostTitleClean,
        -- Correlated subquery in SELECT
        (SELECT COUNT(DISTINCT C.UserId) FROM Comments AS C WHERE C.PostId = P.Id) AS UniqueCommenters,
        (SELECT AVG(C.Score) FROM Comments AS C WHERE C.PostId = P.Id) AS AverageCommentScore
    FROM Posts AS P
    LEFT JOIN Votes AS V ON P.Id = V.PostId AND V.VoteTypeId IN (1, 2, 3)
    WHERE P.PostTypeId = 1 -- Focus on Questions
    GROUP BY P.Id, P.PostTypeId, P.Score, P.ViewCount, P.AnswerCount, P.CommentCount, P.FavoriteCount, P.CreationDate, P.LastActivityDate, P.ClosedDate, P.CommunityOwnedDate, P.OwnerUserId, P.Tags, P.Title
),
PostHistoryDetails AS (
    SELECT
        PH.PostId,
        COUNT(DISTINCT PH.Id) AS TotalHistoryEvents,
        SUM(CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN 1 ELSE 0 END) AS EditCount,
        SUM(CASE WHEN PH.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseVoteEventCount, -- Number of close events, not necessarily votes
        SUM(CASE WHEN PH.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS ReopenVoteEventCount,
        -- Correlated subquery to check if the post was ever migrated
        MAX(CASE WHEN EXISTS (
            SELECT 1
            FROM PostHistory AS PH_INNER
            WHERE PH_INNER.PostId = PH.PostId
            AND PH_INNER.PostHistoryTypeId IN (35, 36)
        ) THEN 'Migrated' ELSE 'Not Migrated' END) AS MigrationStatus,
        -- Complicated predicate/expression for close reason
        MAX(CASE WHEN PH.PostHistoryTypeId = 10 AND PH.Comment IN ('101', '102', '103', '104', '105') THEN PH.Comment ELSE NULL END) AS LatestCloseReasonCode
    FROM PostHistory AS PH
    GROUP BY PH.PostId
),
LinkedPostInfluence AS (
    SELECT
        PL.PostId,
        COUNT(DISTINCT PL.RelatedPostId) AS TotalLinkedPosts,
        SUM(CASE WHEN PL.LinkTypeId = 3 THEN 1 ELSE 0 END) AS TotalDuplicateLinks,
        -- Window function: count of linked posts over a moving window
        COUNT(PL.PostId) OVER (PARTITION BY PL.PostId ORDER BY PL.CreationDate ROWS BETWEEN 90 PRECEDING AND CURRENT ROW) AS LinkedPostsRecentWindow
    FROM PostLinks AS PL
    WHERE PL.LinkTypeId IN (1, 3) -- Linked or Duplicate
    GROUP BY PL.PostId, PL.CreationDate -- GROUP BY for the aggregates before window function application
)
-- Main query for Questions
SELECT
    PEM.PostId,
    PEM.PostTitleClean AS PostTitle,
    'Question' AS PostType,
    UAS.DisplayName AS OwnerDisplayName,
    UAS.Reputation AS OwnerReputation,
    UAS.UserLocation AS OwnerLocation,
    PEM.PostScore,
    PEM.ViewCount,
    PEM.AnswerCount,
    PEM.PostCommentCount,
    PEM.PostFavoriteCount,
    PEM.PrimaryTag,
    PEM.UpVotesReceived,
    PEM.DownVotesReceived,
    PEM.AcceptedVotes,
    PHD.TotalHistoryEvents,
    PHD.EditCount,
    PHD.CloseVoteEventCount,
    PHD.ReopenVoteEventCount,
    PHD.MigrationStatus,
    PHD.LatestCloseReasonCode,
    LPI.TotalLinkedPosts,
    LPI.TotalDuplicateLinks,
    LPI.LinkedPostsRecentWindow,
    -- Complex calculated field with NULL handling and string operations
    COALESCE(UAS.UpDownVoteRatio, 0.0) * (PEM.UpVotesReceived - PEM.DownVotesReceived) AS InfluenceScore,
    -- Correlated subquery in SELECT clause
    (SELECT MAX(V_bounty.BountyAmount) FROM Votes AS V_bounty WHERE V_bounty.PostId = PEM.PostId AND V_bounty.VoteTypeId = 8) AS MaxBountyAmount,
    -- Window functions for ranking and averages
    RANK() OVER (PARTITION BY PEM.PrimaryTag ORDER BY PEM.PostScore DESC, PEM.ViewCount DESC) AS RankWithinTagByScore,
    AVG(PEM.ViewCount) OVER (PARTITION BY UAS.UserId ORDER BY PEM.PostCreationDate) AS AvgViewCountByUser,
    LAG(PEM.PostScore, 1, 0) OVER (PARTITION BY UAS.UserId ORDER BY PEM.PostCreationDate) AS PreviousPostScoreByOwner,
    LEAD(PEM.PostScore, 1, 0) OVER (PARTITION BY UAS.UserId ORDER BY PEM.PostCreationDate) AS NextPostScoreByOwner,
    -- Conditional expressions and NULL logic for post status
    CASE
        WHEN PEM.ClosedDate IS NOT NULL AND PEM.CommunityOwnedDate IS NULL AND PHD.ReopenVoteEventCount = 0 THEN 'Closed & Unreopened'
        WHEN PEM.ClosedDate IS NOT NULL AND PEM.CommunityOwnedDate IS NOT NULL THEN 'Closed & Community Owned'
        WHEN PEM.ClosedDate IS NULL AND PEM.AnswerCount = 0 AND PEM.PostCommentCount = 0 THEN 'Open & Unanswered/Uncommented'
        WHEN PEM.AcceptedVotes > 0 THEN 'Accepted Answer Present'
        ELSE 'Active/Other'
    END AS PostStatusCategory,
    -- String expressions and complex WHERE clause components
    (PEM.PostTitleClean LIKE '%SQL%' OR LOWER(PEM.PrimaryTag) LIKE '%database%') AS IsDatabaseRelated,
    DATE_PART('day', cast('2024-10-01 12:34:56' as timestamp) - PEM.PostCreationDate) AS DaysSinceCreation,
    DATE_PART('day', cast('2024-10-01 12:34:56' as timestamp) - COALESCE(PEM.PostLastActivityDate, PEM.PostCreationDate)) AS DaysSinceLastActivityActual,
    COALESCE(PEM.AverageCommentScore, 0.0) AS AverageCommentScore,
    COALESCE(PEM.UniqueCommenters, 0) AS UniqueCommentersCount
FROM PostEngagementMetrics AS PEM
LEFT JOIN UserActivitySummary AS UAS ON PEM.OwnerUserId = UAS.UserId
LEFT JOIN PostHistoryDetails AS PHD ON PEM.PostId = PHD.PostId
LEFT JOIN LinkedPostInfluence AS LPI ON PEM.PostId = LPI.PostId
WHERE
    PEM.PostTypeId = 1 -- Ensure we are looking at questions
    AND (
        (UAS.Reputation > 10000 AND PEM.ViewCount > 50000 AND PEM.AnswerCount > 5) -- Highly engaged questions by high-rep users
        OR
        (PEM.PrimaryTag IS NOT NULL AND LOWER(PEM.PrimaryTag) IN ('python', 'java', 'javascript', 'c#', 'performance', 'sql') AND PEM.PostScore > 100) -- Popular tech questions
        OR
        (PHD.CloseVoteEventCount > 0 AND PHD.ReopenVoteEventCount > 0 AND PEM.PostScore < 0 AND PEM.PostLastActivityDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') -- Recently controversial/problematic questions
    )
    AND UAS.DaysSinceLastUserActivity < 365 -- Active users in the last year
    AND PEM.PostLastActivityDate IS NOT NULL
    AND COALESCE(PEM.AverageCommentScore, 0) > -2 -- Filter out posts with very negative average comment scores
    AND (PEM.PostTitleClean LIKE '%benchmark%' OR PEM.PostTitleClean LIKE '%optimize%' OR PEM.PostTitleClean LIKE '%latency%')
-- Set operator to combine with specific answers
UNION ALL
-- Main query for Answers
SELECT
    P.Id AS PostId,
    COALESCE(P.Title, 'Answer to Post ' || P.ParentId) AS PostTitle,
    'Answer' AS PostType,
    U.DisplayName AS OwnerDisplayName,
    U.Reputation AS OwnerReputation,
    COALESCE(U.Location, 'Answer_Unknown_Region') AS OwnerLocation,
    P.Score AS PostScore,
    NULL AS ViewCount, -- ViewCount is for questions
    NULL AS AnswerCount, -- AnswerCount is for questions
    P.CommentCount AS PostCommentCount,
    COALESCE(P.FavoriteCount, 0) AS PostFavoriteCount,
    NULL AS PrimaryTag, -- No primary tag for answers directly
    SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesReceived,
    SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesReceived,
    SUM(CASE WHEN V.VoteTypeId = 1 THEN 1 ELSE 0 END) AS AcceptedVotes,
    COUNT(DISTINCT PH.Id) AS TotalHistoryEvents,
    SUM(CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN 1 ELSE 0 END) AS EditCount,
    SUM(CASE WHEN PH.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseVoteEventCount,
    SUM(CASE WHEN PH.PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS ReopenVoteEventCount,
    MAX(CASE WHEN EXISTS (
            SELECT 1
            FROM PostHistory AS PH_INNER
            WHERE PH_INNER.PostId = P.Id
            AND PH_INNER.PostHistoryTypeId IN (35, 36)
        ) THEN 'Migrated' ELSE 'Not Migrated' END) AS MigrationStatus,
    NULL AS LatestCloseReasonCode, -- Only relevant for questions
    COUNT(DISTINCT PL.RelatedPostId) AS TotalLinkedPosts,
    SUM(CASE WHEN PL.LinkTypeId = 3 THEN 1 ELSE 0 END) AS TotalDuplicateLinks,
    COUNT(PL.PostId) OVER (PARTITION BY PL.PostId ORDER BY PL.CreationDate ROWS BETWEEN 90 PRECEDING AND CURRENT ROW) AS LinkedPostsRecentWindow,
    -- Complex calculated field for answerer influence
    CAST(COALESCE(U.UpVotes, 0) AS DECIMAL) / NULLIF(COALESCE(U.DownVotes, 0) + COALESCE(U.UpVotes, 0) + 1, 0) * P.Score AS AnswererInfluenceScore,
    (SELECT MAX(V_bounty.BountyAmount) FROM Votes AS V_bounty WHERE V_bounty.PostId = P.ParentId AND V_bounty.VoteTypeId = 8) AS MaxBountyAmountOnQuestion,
    RANK() OVER (PARTITION BY P.ParentId ORDER BY P.Score DESC, P.CreationDate ASC) AS RankWithinQuestionByScore,
    AVG(P.Score) OVER (PARTITION BY U.Id ORDER BY P.CreationDate) AS AvgScoreByUser,
    LAG(P.Score, 1, 0) OVER (PARTITION BY U.Id ORDER BY P.CreationDate) AS PreviousAnswerScoreByOwner,
    LEAD(P.Score, 1, 0) OVER (PARTITION BY U.Id ORDER BY P.CreationDate) AS NextAnswerScoreByOwner,
    CASE
        WHEN P.Score > 50 AND U.Reputation > 10000 THEN 'Highly Rated Answer by Expert'
        WHEN EXISTS (SELECT 1 FROM Posts WHERE AcceptedAnswerId = P.Id) THEN 'Accepted Answer' -- Check if this answer is accepted
        WHEN P.CreationDate < cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 year' AND P.Score < 0 THEN 'Old Low-Score Answer'
        ELSE 'Other Answer'
    END AS PostStatusCategory,
    (P.Body LIKE '%index%' OR P.Body LIKE '%query plan%' OR P.Body LIKE '%cache%' OR P.Body LIKE '%concurrency%') AS IsDatabaseRelated,
    DATE_PART('day', cast('2024-10-01 12:34:56' as timestamp) - P.CreationDate) AS DaysSinceCreation,
    DATE_PART('day', cast('2024-10-01 12:34:56' as timestamp) - COALESCE(P.LastActivityDate, P.CreationDate)) AS DaysSinceLastActivityActual,
    (SELECT AVG(C_INNER.Score) FROM Comments AS C_INNER WHERE C_INNER.PostId = P.Id) AS AverageCommentScore,
    (SELECT COUNT(DISTINCT C_INNER.UserId) FROM Comments AS C_INNER WHERE C_INNER.PostId = P.Id) AS UniqueCommentersCount
FROM Posts AS P
LEFT JOIN Users AS U ON P.OwnerUserId = U.Id
LEFT JOIN Votes AS V ON P.Id = V.PostId AND V.VoteTypeId IN (1, 2, 3)
LEFT JOIN PostHistory AS PH ON P.Id = PH.PostId
LEFT JOIN PostLinks AS PL ON P.Id = PL.PostId
WHERE P.PostTypeId = 2 -- Focus on Answers
AND P.ParentId IS NOT NULL -- Must be an answer to a question
AND U.Reputation > 200 -- Filter for answers by reasonably reputable users
AND P.Score >= 5 -- Filter for answers with at least some positive score
AND (
    LOWER(P.Body) LIKE '%performance%' OR LOWER(P.Body) LIKE '%optimization%' OR LOWER(P.Body) LIKE '%bottleneck%'
)
GROUP BY P.Id, P.Title, U.DisplayName, U.Reputation, U.Location, P.Score, P.ViewCount, P.CommentCount, P.FavoriteCount,
    U.UpVotes, U.DownVotes, P.ParentId, P.CreationDate, P.LastActivityDate, P.Body
ORDER BY PostScore DESC, DaysSinceCreation ASC
LIMIT 1000;