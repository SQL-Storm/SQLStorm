WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as rn,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_score,
        SUM(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as cumulative_score,
        NTILE(4) OVER (ORDER BY p.Score DESC) as score_quartile
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
UserActivity AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.AccountId,
        COUNT(DISTINCT p.Id) as post_count,
        COUNT(DISTINCT c.Id) as comment_count,
        COUNT(DISTINCT b.Id) as badge_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as question_count,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as answer_count,
        MAX(p.CreationDate) as last_post_date,
        MIN(p.CreationDate) as first_post_date
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.AccountId
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE WHEN t.IsModeratorOnly = TRUE THEN 'Moderator Only' ELSE 'Public' END as tag_access,
        CASE WHEN t.IsRequired = TRUE THEN 'Required' ELSE 'Optional' END as tag_required,
        COUNT(DISTINCT p.Id) as related_posts_count,
        AVG(p.Score) as avg_score,
        AVG(p.ViewCount) as avg_views,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) as questions_count,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) as answers_count
    FROM Tags t
    LEFT JOIN Posts p ON p.Tags IS NOT NULL AND EXISTS (
        SELECT 1
        FROM UNNEST(STRING_TO_ARRAY(p.Tags, '><')) AS tag
        WHERE TRIM(BOTH '<>' FROM tag) = t.TagName
    )
    GROUP BY t.TagName, t.Count, t.ExcerptPostId, t.WikiPostId, t.IsModeratorOnly, t.IsRequired
)
SELECT 
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.Views,
    ua.UpVotes,
    ua.DownVotes,
    ua.post_count,
    ua.comment_count,
    ua.badge_count,
    ua.question_count,
    ua.answer_count,
    ua.last_post_date,
    ua.first_post_date,
    CASE 
        WHEN ua.post_count > 0 THEN (ua.comment_count * 100.0 / ua.post_count)
        ELSE 0 
    END as comments_per_post,
    CASE 
        WHEN ua.question_count > 0 THEN CAST(ua.answer_count AS DOUBLE PRECISION) / CAST(ua.question_count AS DOUBLE PRECISION)
        ELSE 0 
    END as answers_per_question,
    CASE
        WHEN ua.last_post_date IS NOT NULL AND ua.first_post_date IS NOT NULL THEN 
            EXTRACT(DAY FROM (ua.last_post_date - ua.first_post_date))
        ELSE 0
    END as active_days,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN AVG(rp.Score) 
        ELSE 0 
    END as avg_recent_score,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN MAX(rp.Score) 
        ELSE 0 
    END as max_recent_score,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN MIN(rp.Score) 
        ELSE 0 
    END as min_recent_score,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY rp.Score)
        ELSE 0 
    END as median_recent_score,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN 
            STRING_AGG(
                CONCAT(
                    'Q', 
                    COALESCE(rp.Title, 'No Title'),
                    ': Score-', 
                    COALESCE(CAST(rp.Score AS VARCHAR), 'NULL'),
                    ' Views-', 
                    COALESCE(CAST(rp.ViewCount AS VARCHAR), 'NULL')
                ), 
                '; '
            ) FILTER (WHERE rp.Id IS NOT NULL)
        ELSE ''
    END as recent_questions_summary,
    CASE
        WHEN COUNT(ta.TagName) > 0 THEN 
            STRING_AGG(
                CONCAT(
                    ta.TagName,
                    ': ', 
                    ta.questions_count, 
                    'q/', 
                    ta.answers_count, 
                    'a'
                ), 
                ' | '
            )
        ELSE '' 
    END as popular_tags_summary,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN 
            AVG(CASE WHEN rp.prev_score IS NOT NULL THEN (rp.Score - rp.prev_score) ELSE 0 END)
        ELSE 0 
    END as avg_score_change,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN 
            AVG(rp.cumulative_score)
        ELSE 0 
    END as avg_cumulative_score,
    CASE
        WHEN COUNT(rp.Id) > 0 THEN 
            STRING_AGG(
                CASE WHEN rp.score_quartile = 1 THEN 'High' 
                     WHEN rp.score_quartile = 2 THEN 'Medium-High'
                     WHEN rp.score_quartile = 3 THEN 'Medium-Low' 
                     ELSE 'Low' 
                END, 
                ', '
            ) FILTER (WHERE rp.Id IS NOT NULL)
        ELSE '' 
    END as score_quartiles,
    COUNT(DISTINCT CASE 
        WHEN p.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30' DAY THEN p.Id 
        ELSE NULL 
    END) as last_30_days_posts,
    COUNT(DISTINCT CASE 
        WHEN p.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '7' DAY THEN p.Id 
        ELSE NULL 
    END) as last_7_days_posts,
    CASE
        WHEN ua.post_count > 0 THEN CAST(ua.question_count AS DOUBLE PRECISION) / CAST(ua.post_count AS DOUBLE PRECISION)
        ELSE 0 
    END as question_ratio,
    CASE
        WHEN ua.post_count > 0 THEN CAST(ua.answer_count AS DOUBLE PRECISION) / CAST(ua.post_count AS DOUBLE PRECISION)
        ELSE 0 
    END as answer_ratio,
    CASE
        WHEN ua.comment_count > 0 THEN CAST(ua.post_count AS DOUBLE PRECISION) / CAST(ua.comment_count AS DOUBLE PRECISION)
        ELSE 0 
    END as posts_per_comment,
    CASE
        WHEN ua.badge_count > 0 THEN 
            STRING_AGG(b.Name, ', ') FILTER (WHERE b.Name IS NOT NULL)
        ELSE '' 
    END as first_badges,
    CASE
        WHEN ua.badge_count > 0 THEN 
            STRING_AGG(b.Name, ', ') FILTER (WHERE b.Name IS NOT NULL)
        ELSE '' 
    END as last_badges,
    CASE
        WHEN COUNT(DISTINCT p.OwnerUserId) > 0 THEN 
            STRING_AGG(DISTINCT CAST(p.OwnerUserId AS VARCHAR), ', ')
        ELSE '' 
    END as user_ids
FROM UserActivity ua
LEFT JOIN RankedPosts rp ON ua.UserId = rp.OwnerUserId
LEFT JOIN Posts p ON ua.UserId = p.OwnerUserId
LEFT JOIN TagAnalysis ta ON EXISTS (
    SELECT 1
    FROM UNNEST(STRING_TO_ARRAY(p.Tags, '><')) AS tag
    WHERE p.Tags IS NOT NULL AND TRIM(BOTH '<>' FROM tag) = ta.TagName
)
LEFT JOIN Badges b ON ua.UserId = b.UserId
WHERE ua.UserId IN (
    SELECT u.Id 
    FROM Users u 
    WHERE u.Reputation > 10000 
    AND u.AccountId IS NOT NULL
    AND EXISTS (
        SELECT 1 
        FROM Posts p2 
        WHERE p2.OwnerUserId = u.Id 
        AND p2.PostTypeId = 1 
        AND p2.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1' YEAR
    )
)
AND (
    ua.post_count >= 10 
    OR ua.comment_count >= 5 
    OR ua.badge_count >= 3
)
GROUP BY 
    ua.UserId, 
    ua.DisplayName, 
    ua.Reputation, 
    ua.Views, 
    ua.UpVotes, 
    ua.DownVotes,
    ua.post_count, 
    ua.comment_count, 
    ua.badge_count, 
    ua.question_count, 
    ua.answer_count,
    ua.last_post_date, 
    ua.first_post_date
HAVING 
    COUNT(rp.Id) > 0 
    OR COUNT(ta.TagName) > 0
ORDER BY 
    ua.Reputation DESC, 
    ua.post_count DESC
LIMIT 50;