with RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        1 as Level,
        array[t.TagName] as Ancestry
    from Tags t
    where t.IsModeratorOnly = false and t.IsRequired = false

    union all

    select
        c.Id,
        c.TagName,
        r.Level + 1,
        array_append(r.Ancestry, c.TagName)
    from Tags c
    join RecursiveTagHierarchy r on c.Id <> r.Id and not c.TagName = any(r.Ancestry)
    where c.IsModeratorOnly = false and c.IsRequired = false and r.Level < 3
),
UserBadgeStats as (
    select
        b.UserId,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        bool_or(b.TagBased) as HasTagBasedBadge,
        max(b.Date) as LastBadgeDate
    from Badges b
    group by b.UserId
),
TopUsers as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        u.Location,
        u.Views,
        coalesce(b.GoldBadges,0) as GoldBadges,
        coalesce(b.SilverBadges,0) as SilverBadges,
        coalesce(b.BronzeBadges,0) as BronzeBadges,
        b.HasTagBasedBadge,
        b.LastBadgeDate,
        rank() over (order by u.Reputation desc, u.Views desc) as UserRank
    from Users u
    left join UserBadgeStats b on u.Id = b.UserId
    where u.Reputation > 1000
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.OwnerUserId,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount,
        q.Tags,
        count(case when a.PostTypeId = 2 then 1 end) as TotalAnswers,
        avg(case when a.PostTypeId = 2 then a.Score end) as AvgAnswerScore,
        max(case when a.PostTypeId = 2 then a.Score end) as MaxAnswerScore,
        sum(case when a.PostTypeId = 2 and a.OwnerUserId is not null then 1 else 0 end) as AnswersWithOwner,
        bool_or(case when a.PostTypeId = 2 and a.Id = q.AcceptedAnswerId then true else false end) as HasAcceptedAnswer
    from Posts q
    left join Posts a on a.ParentId = q.Id
    where q.PostTypeId = 1
    group by q.Id, q.OwnerUserId, q.CreationDate, q.Score, q.ViewCount, q.Tags, q.AcceptedAnswerId
),
AnswerCommentsStats as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        count(c.Id) as TotalComments,
        sum(c.Score) as SumCommentScores,
        avg(c.Score) as AvgCommentScore,
        bool_or(c.UserId is not null) as HasRegisteredCommenters
    from Posts a
    left join Comments c on c.PostId = a.Id
    where a.PostTypeId = 2
    group by a.Id, a.ParentId
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.CreationDate,
        count(*) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as PostsLast30Days,
        sum(coalesce(p.Score,0)) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as ScoreLast30Days
    from Users u
    join Posts p on p.OwnerUserId = u.Id
    where p.CreationDate > (cast('2024-10-01' as date) - interval '365 days')
),
QuestionsWithTopAnswers as (
    select
        qas.QuestionId,
        qas.OwnerUserId,
        qas.QuestionCreation,
        qas.QuestionScore,
        qas.TotalAnswers,
        qas.AvgAnswerScore,
        qas.MaxAnswerScore,
        qas.HasAcceptedAnswer,
        a.Id as TopAnswerId,
        a.Score as TopAnswerScore,
        ac.TotalComments as TopAnswerComments,
        ac.AvgCommentScore as TopAnswerAvgCommentScore
    from QuestionAnswerStats qas
    left join lateral (
        select p.*
        from Posts p
        where p.ParentId = qas.QuestionId and p.PostTypeId = 2
        order by p.Score desc nulls last, p.CreationDate asc
        limit 1
    ) a on true
    left join AnswerCommentsStats ac on ac.AnswerId = a.Id
)
select
    tu.Id,
    tu.DisplayName,
    tu.Reputation,
    tu.GoldBadges,
    tu.SilverBadges,
    tu.BronzeBadges,
    tu.HasTagBasedBadge,
    tu.LastBadgeDate,
    count(distinct qwt.QuestionId) as QuestionsAsked,
    count(distinct qwt.TopAnswerId) filter (where qwt.TopAnswerScore > 10) as HighScoringTopAnswers,
    avg(qwt.QuestionScore) as AvgQuestionScore,
    avg(qwt.MaxAnswerScore) as AvgMaxAnswerScore,
    avg(qwt.TopAnswerAvgCommentScore) as AvgTopAnswerCommentScore,
    max(case when uw.PostTypeId = 1 then uw.ScoreLast30Days end) as MaxQuestionScoreLast30Days,
    max(case when uw.PostTypeId = 2 then uw.ScoreLast30Days end) as MaxAnswerScoreLast30Days,
    string_agg(distinct substring(t.TagName from 1 for 10), ',' order by t.TagName) as TagsUsed,
    bool_or(qwt.HasAcceptedAnswer) as HasAtLeastOneAcceptedAnswer
from TopUsers tu
left join Posts p on p.OwnerUserId = tu.Id and p.PostTypeId = 1
left join QuestionsWithTopAnswers qwt on qwt.OwnerUserId = tu.Id
left join UserActivityWindow uw on uw.UserId = tu.Id
left join lateral (
    select unnest(string_to_array(coalesce(p.Tags,''), '><')) as TagName
) t on true
where tu.UserRank <= 100
group by tu.Id, tu.DisplayName, tu.Reputation, tu.GoldBadges, tu.SilverBadges, tu.BronzeBadges, tu.HasTagBasedBadge, tu.LastBadgeDate
having count(distinct qwt.QuestionId) > 5
union
select
    u.Id,
    u.DisplayName,
    u.Reputation,
    0 as GoldBadges,
    0 as SilverBadges,
    0 as BronzeBadges,
    false as HasTagBasedBadge,
    null as LastBadgeDate,
    0 as QuestionsAsked,
    0 as HighScoringTopAnswers,
    0.0 as AvgQuestionScore,
    0.0 as AvgMaxAnswerScore,
    0.0 as AvgTopAnswerCommentScore,
    0 as MaxQuestionScoreLast30Days,
    0 as MaxAnswerScoreLast30Days,
    '' as TagsUsed,
    false as HasAtLeastOneAcceptedAnswer
from Users u
where u.Reputation < 100
except
select
    tu.Id,
    tu.DisplayName,
    tu.Reputation,
    tu.GoldBadges,
    tu.SilverBadges,
    tu.BronzeBadges,
    tu.HasTagBasedBadge,
    tu.LastBadgeDate,
    count(distinct qwt.QuestionId) as QuestionsAsked,
    count(distinct qwt.TopAnswerId) filter (where qwt.TopAnswerScore > 10) as HighScoringTopAnswers,
    avg(qwt.QuestionScore) as AvgQuestionScore,
    avg(qwt.MaxAnswerScore) as AvgMaxAnswerScore,
    avg(qwt.TopAnswerAvgCommentScore) as AvgTopAnswerCommentScore,
    max(case when uw.PostTypeId = 1 then uw.ScoreLast30Days end) as MaxQuestionScoreLast30Days,
    max(case when uw.PostTypeId = 2 then uw.ScoreLast30Days end) as MaxAnswerScoreLast30Days,
    string_agg(distinct substring(t.TagName from 1 for 10), ',' order by t.TagName) as TagsUsed,
    bool_or(qwt.HasAcceptedAnswer) as HasAtLeastOneAcceptedAnswer
from TopUsers tu
left join Posts p on p.OwnerUserId = tu.Id and p.PostTypeId = 1
left join QuestionsWithTopAnswers qwt on qwt.OwnerUserId = tu.Id
left join UserActivityWindow uw on uw.UserId = tu.Id
left join lateral (
    select unnest(string_to_array(coalesce(p.Tags,''), '><')) as TagName
) t on true
where tu.UserRank <= 100
group by tu.Id, tu.DisplayName, tu.Reputation, tu.GoldBadges, tu.SilverBadges, tu.BronzeBadges, tu.HasTagBasedBadge, tu.LastBadgeDate
order by Reputation desc nulls last, QuestionsAsked desc nulls last
limit 50;