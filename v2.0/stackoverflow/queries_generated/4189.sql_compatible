WITH
  RankedQuestions AS (
    SELECT
      p.Id AS QuestionId,
      p.Title,
      p.OwnerUserId,
      p.CreationDate,
      p.Score,
      p.ViewCount,
      p.AnswerCount,
      ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS rn
    FROM Posts AS p
    WHERE
      p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL AND p.CommunityOwnedDate IS NULL
  ),
  TopContributors AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      COUNT(DISTINCT b.Id) AS BadgeCount,
      SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvoteCount,
      SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvoteCount,
      RANK() OVER (ORDER BY COUNT(DISTINCT b.Id) DESC, SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) DESC) AS contributor_rank
    FROM Users AS u
    LEFT JOIN Badges AS b
      ON u.Id = b.UserId
    LEFT JOIN Votes AS v
      ON u.Id = v.UserId
    WHERE
      u.Reputation > 1000
    GROUP BY
      u.Id,
      u.DisplayName
    HAVING
      COUNT(DISTINCT b.Id) > 5 OR SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) > 50
  ),
  QuestionActivity AS (
    SELECT
      p.Id AS QuestionId,
      COUNT(c.Id) AS CommentCount,
      COUNT(a.Id) AS AnswerCount,
      MAX(p.LastActivityDate) AS LastActivity,
      (
        SELECT
          SUM(v.BountyAmount)
        FROM Votes AS v
        WHERE
          v.PostId = p.Id AND v.VoteTypeId = 8
      ) AS TotalBounty
    FROM Posts AS p
    LEFT JOIN Comments AS c
      ON p.Id = c.PostId
    LEFT JOIN Posts AS a
      ON p.Id = a.ParentId AND a.PostTypeId = 2
    WHERE
      p.PostTypeId = 1
    GROUP BY
      p.Id
  ),
  HighRatedAnswers AS (
    SELECT
      a.Id AS AnswerId,
      a.ParentId AS QuestionId,
      a.OwnerUserId,
      a.Score,
      ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS answer_rn
    FROM Posts AS a
    WHERE
      a.PostTypeId = 2 AND a.OwnerUserId IS NOT NULL
  ),
  CommunityInfluence AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      COUNT(CASE WHEN ph.PostHistoryTypeId IN (16, 50) THEN 1 ELSE NULL END) AS CommunityOwnedEdits,
      COUNT(CASE WHEN ph.PostHistoryTypeId = 19 THEN 1 ELSE NULL END) AS ProtectedCount,
      SUM(CASE WHEN ph.PostHistoryTypeId IN (35, 36) THEN 1 ELSE 0 END) AS MigratedCount
    FROM Users AS u
    JOIN PostHistory AS ph
      ON u.Id = ph.UserId
    WHERE
      u.Id IN (SELECT OwnerUserId FROM Posts WHERE PostTypeId = 1)
    GROUP BY
      u.Id,
      u.DisplayName
    HAVING
      COUNT(CASE WHEN ph.PostHistoryTypeId IN (16, 50) THEN 1 ELSE NULL END) > 10 OR COUNT(CASE WHEN ph.PostHistoryTypeId = 19 THEN 1 ELSE NULL END) > 5
  )
SELECT
  rq.Title AS QuestionTitle,
  rq.CreationDate AS QuestionCreationDate,
  u.DisplayName AS QuestionOwner,
  rq.Score AS QuestionScore,
  rq.ViewCount AS QuestionViews,
  qa.CommentCount,
  qa.AnswerCount AS AnswerCountOnQuestion,
  hra.Score AS TopAnswerScore,
  tc.DisplayName AS TopContributorDisplayName,
  tc.BadgeCount AS ContributorBadges,
  ci.ProtectedCount,
  COALESCE(ci.MigratedCount, 0) AS TotalMigratedPosts,
  CASE
    WHEN rq.rn <= 10 THEN 'Top 10 Question'
    WHEN rq.rn BETWEEN 11 AND 50 THEN 'Top 50 Question'
    ELSE 'Other Question'
  END AS QuestionTier,
  UPPER(SUBSTRING(rq.Title FROM 1 FOR 3)) AS TitlePrefix,
  (CAST(rq.AnswerCount AS VARCHAR) || '-' || CAST(rq.Score AS VARCHAR)) AS AnswerScoreConcat,
  CASE
    WHEN qa.TotalBounty IS NOT NULL AND qa.TotalBounty > 0 THEN 'Has Bounty'
    WHEN (CAST('2024-10-01 12:34:56' AS timestamp) - rq.CreationDate) > INTERVAL '365 days' THEN 'Old Question'
    ELSE 'No Active Bounty / Recent'
  END AS QuestionStatus,
  pl.RelatedPostId
FROM RankedQuestions AS rq
JOIN Users AS u
  ON rq.OwnerUserId = u.Id
LEFT JOIN QuestionActivity AS qa
  ON rq.QuestionId = qa.QuestionId
LEFT JOIN HighRatedAnswers AS hra
  ON rq.QuestionId = hra.QuestionId AND hra.answer_rn = 1
LEFT JOIN TopContributors AS tc
  ON u.Id = tc.UserId
LEFT JOIN CommunityInfluence AS ci
  ON u.Id = ci.UserId
LEFT JOIN PostLinks AS pl
  ON rq.QuestionId = pl.PostId AND pl.LinkTypeId = 3
WHERE
  rq.rn <= 100
  AND rq.Score > 0
  AND (
    hra.Score IS NULL OR hra.Score >= 10
  )
  AND u.Location IS NOT NULL
  AND SUBSTRING(u.DisplayName FROM 1 FOR 1) BETWEEN 'A' AND 'M'
GROUP BY
  rq.Title,
  rq.CreationDate,
  u.DisplayName,
  rq.Score,
  rq.ViewCount,
  qa.CommentCount,
  qa.AnswerCount,
  hra.Score,
  tc.DisplayName,
  tc.BadgeCount,
  ci.ProtectedCount,
  ci.MigratedCount,
  rq.rn,
  rq.AnswerCount,
  pl.RelatedPostId,
  rq.QuestionId,
  u.Id,
  u.Location
ORDER BY
  rq.rn,
  qa.LastActivity DESC;