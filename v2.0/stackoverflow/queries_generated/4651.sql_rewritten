-- {"query": "4651.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1507} 
WITH
  UserPostInteraction AS (
    SELECT
      p.OwnerUserId,
      COUNT(DISTINCT c.Id) AS CommentCount,
      COUNT(DISTINCT v.Id) AS VoteCount,
      SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
      SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
      MAX(p.CreationDate) AS LastPostCreationDate
    FROM Posts AS p
    LEFT JOIN Comments AS c
      ON p.Id = c.PostId
    LEFT JOIN Votes AS v
      ON p.Id = v.PostId
    WHERE
      p.OwnerUserId IS NOT NULL
    GROUP BY
      p.OwnerUserId
  ),
  PostQuality AS (
    SELECT
      p.Id AS PostId,
      p.OwnerUserId,
      p.Score,
      p.AnswerCount,
      p.CommentCount,
      p.FavoriteCount,
      p.ClosedDate,
      CASE
        WHEN p.PostTypeId = 1 THEN COALESCE(pt.Name, 'Unknown')
        ELSE COALESCE(pt2.Name, 'Unknown')
      END AS PostType,
      ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS ScoreRank,
      AVG(c.Score) OVER (PARTITION BY p.OwnerUserId) AS AvgCommentScore,
      SUM(CASE WHEN pl.LinkTypeId = 3 THEN 1 ELSE 0 END) OVER (PARTITION BY p.OwnerUserId) AS DuplicateLinkCount
    FROM Posts AS p
    LEFT JOIN PostTypes AS pt
      ON p.PostTypeId = pt.Id
    LEFT JOIN PostTypes AS pt2
      ON p.PostTypeId = pt2.Id
    LEFT JOIN PostLinks AS pl
      ON p.Id = pl.PostId
    LEFT JOIN Comments AS c
      ON p.Id = c.PostId
    WHERE
      p.OwnerUserId IS NOT NULL
      AND p.CreationDate >= DATE('now', '-1 year')
  ),
  UserEngagement AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      u.Reputation,
      u.CreationDate AS UserCreationDate,
      COALESCE(upi.CommentCount, 0) AS TotalComments,
      COALESCE(upi.VoteCount, 0) AS TotalVotes,
      COALESCE(upi.QuestionCount, 0) AS TotalQuestions,
      COALESCE(upi.AnswerCount, 0) AS TotalAnswers,
      CASE
        WHEN julianday('now') - julianday(u.LastAccessDate) < 30 THEN 'Active'
        WHEN julianday('now') - julianday(u.LastAccessDate) BETWEEN 30 AND 180 THEN 'Moderately Active'
        ELSE 'Inactive'
      END AS EngagementStatus,
      (
        SELECT
          COUNT(*)
        FROM Badges AS b
        WHERE
          b.UserId = u.Id AND b.Class = 1
      ) AS GoldBadges,
      (
        SELECT
          COUNT(*)
        FROM Badges AS b
        WHERE
          b.UserId = u.Id AND b.Class = 2
      ) AS SilverBadges,
      (
        SELECT
          COUNT(*)
        FROM Badges AS b
        WHERE
          b.UserId = u.Id AND b.Class = 3
      ) AS BronzeBadges
    FROM Users AS u
    LEFT JOIN UserPostInteraction AS upi
      ON u.Id = upi.OwnerUserId
    WHERE
      u.Id <> -1
  )
SELECT
  ue.UserId,
  ue.DisplayName,
  ue.Reputation,
  ue.EngagementStatus,
  ue.GoldBadges,
  ue.SilverBadges,
  ue.BronzeBadges,
  pq.PostId,
  pq.PostType,
  pq.Score,
  pq.AnswerCount,
  pq.CommentCount,
  pq.FavoriteCount,
  pq.AvgCommentScore,
  pq.DuplicateLinkCount,
  CASE
    WHEN pq.ClosedDate IS NOT NULL THEN 'Closed'
    ELSE 'Open'
  END AS PostStatus,
  CASE
    WHEN pq.ScoreRank <= 5 THEN 'Top 5 Scorer'
    WHEN pq.ScoreRank <= 20 THEN 'Top 20 Scorer'
    ELSE 'Other'
  END AS ScoreTier
FROM UserEngagement AS ue
JOIN PostQuality AS pq
  ON ue.UserId = pq.OwnerUserId
WHERE
  ue.TotalQuestions > 5
  AND ue.TotalAnswers > 10
  AND ue.Reputation > 1000
  AND pq.Score > 0
  AND pq.PostType IN ('Question', 'Answer')
  AND (
    pq.AvgCommentScore > 5 OR pq.DuplicateLinkCount > 2
  )
  AND ue.EngagementStatus <> 'Inactive'
UNION ALL
SELECT
  ue.UserId,
  ue.DisplayName,
  ue.Reputation,
  ue.EngagementStatus,
  ue.GoldBadges,
  ue.SilverBadges,
  ue.BronzeBadges,
  NULL AS PostId,
  'Summary' AS PostType,
  NULL AS Score,
  SUM(pq.AnswerCount) AS AnswerCount,
  SUM(pq.CommentCount) AS CommentCount,
  SUM(pq.FavoriteCount) AS FavoriteCount,
  AVG(pq.AvgCommentScore) AS AvgCommentScore,
  SUM(pq.DuplicateLinkCount) AS DuplicateLinkCount,
  NULL AS PostStatus,
  'Overall' AS ScoreTier
FROM UserEngagement AS ue
JOIN PostQuality AS pq
  ON ue.UserId = pq.OwnerUserId
WHERE
  ue.TotalQuestions > 5
  AND ue.TotalAnswers > 10
  AND ue.Reputation > 1000
  AND pq.Score > 0
  AND pq.PostType IN ('Question', 'Answer')
  AND (
    pq.AvgCommentScore > 5 OR pq.DuplicateLinkCount > 2
  )
  AND ue.EngagementStatus <> 'Inactive'
GROUP BY
  ue.UserId,
  ue.DisplayName,
  ue.Reputation,
  ue.EngagementStatus,
  ue.GoldBadges,
  ue.SilverBadges,
  ue.BronzeBadges
ORDER BY
  ue.Reputation DESC,
  ue.TotalAnswers DESC;