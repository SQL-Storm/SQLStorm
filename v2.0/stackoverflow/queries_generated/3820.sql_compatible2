WITH
UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COALESCE(b.BadgeCnt, 0) AS BadgeCnt,
        COALESCE(p.PostCnt, 0) AS PostCnt,
        COALESCE(p.AnswerCnt, 0) AS AnswerCnt,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RepRank
    FROM Users u
    LEFT JOIN (
        SELECT UserId, COUNT(*) AS BadgeCnt
        FROM Badges
        GROUP BY UserId
    ) b ON u.Id = b.UserId
    LEFT JOIN (
        SELECT OwnerUserId,
               COUNT(*) AS PostCnt,
               SUM(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCnt
        FROM Posts
        GROUP BY OwnerUserId
    ) p ON u.Id = p.OwnerUserId
    WHERE u.Reputation IS NOT NULL
),
TopUsers AS (
    SELECT *
    FROM UserStats
    WHERE RepRank <= 100
),
TagStats AS (
    SELECT
        t.TagName,
        COUNT(p.Id) AS QuestionCnt,
        SUM(p.Score) AS TotalScore,
        MAX(p.CreationDate) AS LatestQDate,
        STRING_AGG(DISTINCT u.DisplayName, ', ') AS TopContributors
    FROM Tags t
    JOIN Posts p
          ON p.Tags LIKE ('%<' || t.TagName || '>%')
         AND p.PostTypeId = 1
    LEFT JOIN Users u
          ON p.OwnerUserId = u.Id
    GROUP BY t.TagName
    HAVING COUNT(p.Id) > 10
),
UserRecentActivity AS (
    SELECT
        u.Id,
        MAX(p.CreationDate) AS LastQDate,
        MAX(c.CreationDate) AS LastCmtDate,
        MAX(v.CreationDate) AS LastVoteDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY u.Id
),
Combined AS (
    SELECT
        tu.Id,
        tu.DisplayName,
        tu.Reputation,
        tu.BadgeCnt,
        tu.PostCnt,
        tu.AnswerCnt,
        ur.LastQDate,
        ur.LastCmtDate,
        ur.LastVoteDate,
        tu.RepRank
    FROM TopUsers tu
    LEFT JOIN UserRecentActivity ur ON tu.Id = ur.Id
),
FinalResult AS (
    SELECT
        c.Id,
        c.DisplayName,
        c.Reputation,
        c.BadgeCnt,
        c.PostCnt,
        c.AnswerCnt,
        COALESCE(c.LastQDate, TIMESTAMP '1970-01-01') AS LastQDate,
        COALESCE(c.LastCmtDate, TIMESTAMP '1970-01-01') AS LastCmtDate,
        COALESCE(c.LastVoteDate, TIMESTAMP '1970-01-01') AS LastVoteDate,
        ROW_NUMBER() OVER (ORDER BY c.Reputation DESC, c.BadgeCnt DESC) AS GlobalRank,
        CASE
            WHEN c.Reputation > 20000 THEN 'Elite'
            WHEN c.Reputation BETWEEN 10000 AND 20000 THEN 'Pro'
            WHEN c.Reputation BETWEEN 5000 AND 9999 THEN 'Experienced'
            ELSE 'Novice'
        END AS RepTier
    FROM Combined c
),
MaxQuestionCnt AS (
    SELECT MAX(QuestionCnt) AS MaxQ FROM TagStats
),
AvgTotalScore AS (
    SELECT AVG(TotalScore) AS AvgScore FROM TagStats
)
SELECT
    fr.Id,
    fr.DisplayName,
    fr.Reputation,
    fr.BadgeCnt,
    fr.PostCnt,
    fr.AnswerCnt,
    fr.LastQDate,
    fr.LastCmtDate,
    fr.LastVoteDate,
    fr.GlobalRank,
    fr.RepTier,
    ts.TagName,
    ts.QuestionCnt,
    ts.TotalScore,
    ts.LatestQDate,
    ts.TopContributors
FROM FinalResult fr
FULL OUTER JOIN TagStats ts
       ON ts.QuestionCnt = (SELECT MaxQ FROM MaxQuestionCnt)
WHERE fr.GlobalRank <= 50

UNION ALL

SELECT
    NULL AS Id,
    NULL AS DisplayName,
    NULL AS Reputation,
    NULL AS BadgeCnt,
    NULL AS PostCnt,
    NULL AS AnswerCnt,
    NULL AS LastQDate,
    NULL AS LastCmtDate,
    NULL AS LastVoteDate,
    NULL AS GlobalRank,
    'Separator' AS RepTier,
    t.TagName,
    t.QuestionCnt,
    t.TotalScore,
    t.LatestQDate,
    t.TopContributors
FROM TagStats t
WHERE t.TotalScore > (SELECT AvgScore FROM AvgTotalScore)

ORDER BY
    GlobalRank NULLS LAST,
    RepTier DESC,
    QuestionCnt DESC;