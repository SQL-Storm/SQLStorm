-- {"query": "6902.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 527} 
SELECT 
    u.DisplayName,
    u.Reputation,
    u.Location,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    AVG(p.Score) AS AvgPostScore,
    MAX(ph.RevisionGUID) AS LastRevisionGUID,
    (
        SELECT 
            STRING_AGG(t.TagName, ', ')
        FROM 
            Tags t
        WHERE 
            t.Id IN (
                SELECT 
                    Id
                FROM 
                    Posts
                WHERE 
                    PostId = p.Id
                    AND PostTypeId = 1
            )
    ) AS MostFrequentTags,
    (
        SELECT 
            COUNT(*)
        FROM 
            Votes v
        WHERE 
            v.PostId = p.Id
            AND v.VoteTypeId = 2
    ) AS TotalUpVotes,
    (
        SELECT 
            COUNT(*)
        FROM 
            Votes v
        WHERE 
            v.PostId = p.Id
            AND v.VoteTypeId = 3
    ) AS TotalDownVotes,
    (
        SELECT 
            COUNT(DISTINCT bl.RelatedPostId)
        FROM 
            PostLinks pl
        JOIN 
            LinkTypes lt ON pl.LinkTypeId = lt.Id
        JOIN 
            Posts bp ON pl.RelatedPostId = bp.Id
        WHERE 
            pl.PostId = p.Id
            AND lt.Name = 'Duplicate'
    ) AS DuplicateCount
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
WHERE 
    u.Reputation > 1000
    AND p.LastActivityDate >= DATEADD(month, -12, cast('2024-10-01 12:34:56' as timestamp))
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, u.Location
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;