    fa.TagComplexity,
    fa.RankCategory,
    fa.GoldBadges,
    fa.SilverBadges,
    fa.BronzeBadges,
    fa.ContributionLevel,
    fa.PerformanceTier,
    COALESCE(
        (SELECT COUNT(*) FROM Posts p2 WHERE p2.OwnerUserId = fa.UserId AND p2.PostTypeId = 1 AND p2.CreationDate > '2020-01-01'),
        0
    ) AS RecentQuestions,
    COALESCE(
        (SELECT COUNT(*) FROM Posts p3 WHERE p3.OwnerUserId = fa.UserId AND p3.PostTypeId = 2 AND p3.CreationDate > '2020-01-01'),
        0
    ) AS RecentAnswers,
    (SELECT COUNT(*) FROM Posts p4 WHERE p4.OwnerUserId = fa.UserId AND p4.CreationDate > '2020-01-01') AS RecentPosts,
    CASE 
        WHEN fa.Reputation > 10000 AND (fa.GoldBadges + fa.SilverBadges + fa.BronzeBadges) > 20 THEN 1
        WHEN fa.Reputation > 5000 AND (fa.GoldBadges + fa.SilverBadges + fa.BronzeBadges) > 15 THEN 1
        WHEN fa.Reputation > 1000 AND (fa.GoldBadges + fa.SilverBadges + fa.BronzeBadges) > 10 THEN 1
        ELSE 0
    END AS IsHighlyActive,
    (fa.Reputation * fa.Score * fa.ViewCount) AS OverallImpactScore,
    CASE 
        WHEN fa.TagCount > 0 THEN 
            (SELECT STRING_AGG(DISTINCT tag, ', ') 
             FROM unnest(string_to_array(SUBSTRING(fa.Tags FROM 2 FOR (CHAR_LENGTH(fa.Tags)-2)), '><')) AS t(tag))
        ELSE ''
    END AS ExtractedTags,
    (SELECT COUNT(*) 
     FROM PostHistory ph 
     WHERE ph.UserId = fa.UserId 
       AND ph.CreationDate > '2020-01-01'
       AND ph.PostHistoryTypeId IN (2, 5, 6)) AS RecentEdits,
    (SELECT COUNT(*) 
     FROM Comments c 
     WHERE c.UserId = fa.UserId 
       AND c.CreationDate > '2020-01-01') AS RecentComments
FROM FinalAnalysis fa
WHERE fa.Score > 50
  AND fa.ViewCount > 1000
  AND fa.UserAvgPostScore > 20
ORDER BY fa.UserAvgPostScore DESC, fa.Reputation DESC
LIMIT 2000;