WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
        COUNT(DISTINCT c.Id) AS Comments,
        COUNT(DISTINCT b.Id) AS Badges,
        MAX(p.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        PERCENT_RANK() OVER (ORDER BY u.Reputation) AS ReputationPercentile,
        AVG(p.Score) AS AvgPostScore,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), ', ') FILTER (WHERE p.Tags IS NOT NULL) AS AllTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate > '2010-01-01'
    GROUP BY u.Id, u.Reputation, u.DisplayName
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        TotalPosts,
        Questions,
        Answers,
        Comments,
        Badges,
        LastPostDate,
        ReputationRank,
        ReputationPercentile,
        AvgPostScore,
        AllTags,
        CASE 
            WHEN TotalPosts > 100 THEN 'Elite'
            WHEN TotalPosts > 50 THEN 'Veteran'
            WHEN TotalPosts > 10 THEN 'Active'
            ELSE 'Newbie'
        END AS UserTier,
        CASE 
            WHEN Reputation > 100000 THEN 'Legendary'
            WHEN Reputation > 10000 THEN 'Master'
            WHEN Reputation > 1000 THEN 'Expert'
            ELSE 'Regular'
        END AS ReputationLevel,
        LAG(Reputation) OVER (ORDER BY Reputation DESC) - Reputation AS RepDifferenceFromNext,
        LAG(TotalPosts) OVER (ORDER BY TotalPosts DESC) - TotalPosts AS PostDifferenceFromNext
    FROM UserActivityStats
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.PostTypeId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        COALESCE(EXTRACT(EPOCH FROM (p.CreationDate - u.CreationDate))/86400, 0) AS DaysSinceAccountCreation,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) AS UserAvgScore,
        RANK() OVER (ORDER BY p.Score DESC) AS ScoreRank,
        DENSE_RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) AS TypeRank,
        CASE 
            WHEN p.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = p.PostTypeId) + 2 * (SELECT STDDEV(Score) FROM Posts WHERE PostTypeId = p.PostTypeId) THEN 'High'
            WHEN p.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId = p.PostTypeId) - 2 * (SELECT STDDEV(Score) FROM Posts WHERE PostTypeId = p.PostTypeId) THEN 'Low'
            ELSE 'Normal'
        END AS ScoreCategory,
        CASE 
            WHEN p.Tags IS NOT NULL AND p.Tags != '' THEN 
                (SELECT COUNT(*) FROM unnest(string_to_array(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), '><')) AS t(tag))
            ELSE 0
        END AS TagCount,
        COALESCE(u.Reputation, 0) AS OwnerReputation,
        COALESCE(u.UpVotes, 0) AS OwnerUpvotes,
        COALESCE(u.DownVotes, 0) AS OwnerDownvotes,
        CASE 
            WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN 'Answered'
            WHEN p.PostTypeId = 1 THEN 'Unanswered'
            WHEN p.PostTypeId = 2 AND p.ParentId IS NOT NULL THEN 'Answer'
            ELSE 'Other'
        END AS PostStatus,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS Upvotes,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS Downvotes,
        (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (1, 2, 3)) AS EditCount,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCountByPosts
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.CreationDate > '2015-01-01'
      AND p.PostTypeId IN (1, 2)
),
CombinedData AS (
    SELECT 
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.TotalPosts,
        tu.Questions,
        tu.Answers,
        tu.Comments,
        tu.Badges,
        tu.LastPostDate,
        tu.ReputationRank,
        tu.ReputationPercentile,
        tu.AvgPostScore,
        tu.AllTags,
        tu.UserTier,
        tu.ReputationLevel,
        tu.RepDifferenceFromNext,
        tu.PostDifferenceFromNext,
        pa.PostId,
        pa.PostTypeId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount,
        pa.CommentCount,
        pa.CreationDate,
        pa.Tags,
        pa.DaysSinceAccountCreation,
        pa.UserAvgScore,
        pa.ScoreRank,
        pa.TypeRank,
        pa.ScoreCategory,
        pa.TagCount,
        pa.OwnerReputation,
        pa.OwnerUpvotes,
        pa.OwnerDownvotes,
        pa.PostStatus,
        pa.Upvotes,
        pa.Downvotes,
        pa.EditCount,
        pa.CommentCountByPosts,
        (pa.Score + pa.ViewCount) AS CombinedScore,
        CASE 
            WHEN pa.Score > 100 THEN 'Hot'
            WHEN pa.Score > 50 THEN 'Warm'
            WHEN pa.Score > 10 THEN 'Cool'
            ELSE 'Cold'
        END AS Temperature,
        CASE 
            WHEN pa.CommentCount > 10 THEN 'HighlyDiscussed'
            WHEN pa.CommentCount > 5 THEN 'ModeratelyDiscussed'
            WHEN pa.CommentCount > 0 THEN 'MinimallyDiscussed'
            ELSE 'Undiscussed'
        END AS DiscussionLevel,
        (pa.Score * pa.ViewCount) AS QualityMetric,
        (pa.AnswerCount * 100.0 / COALESCE(pa.CommentCount, 1)) AS AnswerCommentRatio,
        (pa.Upvotes * 100.0 / COALESCE(pa.Downvotes + pa.Upvotes, 1)) AS UpvoteRatio
    FROM TopUsers tu
    INNER JOIN PostAnalysis pa ON tu.UserId = pa.OwnerUserId
    WHERE tu.Reputation > 5000
      AND tu.TotalPosts > 5
),
FilteredData AS (
    SELECT 
        cd.UserId,
        cd.DisplayName,
        cd.Reputation,
        cd.TotalPosts,
        cd.Questions,
        cd.Answers,
        cd.Comments,
        cd.Badges,
        cd.LastPostDate,
        cd.ReputationRank,
        cd.ReputationPercentile,
        cd.AvgPostScore,
        cd.AllTags,
        cd.UserTier,
        cd.ReputationLevel,
        cd.RepDifferenceFromNext,
        cd.PostDifferenceFromNext,
        cd.PostId,
        cd.PostTypeId,
        cd.Title,
        cd.Score,
        cd.ViewCount,
        cd.AnswerCount,
        cd.CommentCount,
        cd.CreationDate,
        cd.Tags,
        cd.DaysSinceAccountCreation,
        cd.UserAvgScore,
        cd.ScoreRank,
        cd.TypeRank,
        cd.ScoreCategory,
        cd.TagCount,
        cd.OwnerReputation,
        cd.OwnerUpvotes,
        cd.OwnerDownvotes,
        cd.PostStatus,
        cd.Upvotes,
        cd.Downvotes,
        cd.EditCount,
        cd.CommentCountByPosts,
        cd.CombinedScore,
        cd.Temperature,
        cd.DiscussionLevel,
        cd.QualityMetric,
        cd.AnswerCommentRatio,
        cd.UpvoteRatio,
        ROW_NUMBER() OVER (PARTITION BY cd.UserId ORDER BY cd.Score DESC) AS UserPostRank,
        DENSE_RANK() OVER (ORDER BY cd.CombinedScore DESC) AS CombinedScoreRank,
        NTILE(4) OVER (ORDER BY cd.Score DESC) AS ScoreQuartile,
        PERCENT_RANK() OVER (ORDER BY cd.QualityMetric DESC) AS QualityPercentile,
        AVG(cd.Score) OVER (PARTITION BY cd.UserId) AS UserAvgPostScore,
        MAX(cd.ViewCount) OVER (PARTITION BY cd.UserId) AS UserMaxViewCount,
        SUM(cd.Score) OVER (PARTITION BY cd.UserId ORDER BY cd.CreationDate) AS RunningScoreTotal,
        LAG(cd.Score) OVER (PARTITION BY cd.UserId ORDER BY cd.CreationDate) AS PrevPostScore,
        LAG(cd.CreationDate) OVER (PARTITION BY cd.UserId ORDER BY cd.CreationDate) AS PrevPostDate,
        EXTRACT(EPOCH FROM (cd.CreationDate - LAG(cd.CreationDate) OVER (PARTITION BY cd.UserId ORDER BY cd.CreationDate)))/86400 AS DaysSinceLastPost,
        CASE 
            WHEN cd.EditCount > 0 THEN 'Edited'
            WHEN cd.EditCount IS NULL THEN 'NotAvailable'
            ELSE 'Unedited'
        END AS EditStatus,
        CASE 
            WHEN cd.UpvoteRatio >= 0.9 THEN 'Popular'
            WHEN cd.UpvoteRatio >= 0.7 THEN 'WellReceived'
            WHEN cd.UpvoteRatio >= 0.5 THEN 'Neutral'
            ELSE 'Contested'
        END AS ReceptionLevel,
        CASE 
            WHEN cd.TagCount > 10 THEN 'TagHeavy'
            WHEN cd.TagCount > 5 THEN 'TagModerate'
            WHEN cd.TagCount > 0 THEN 'TagLight'
            ELSE 'Tagless'
        END AS TagComplexity,
        CASE 
            WHEN cd.ScoreRank <= 10 THEN 'Top10'
            WHEN cd.ScoreRank <= 50 THEN 'Top50'
            WHEN cd.ScoreRank <= 100 THEN 'Top100'
            ELSE 'BelowTop100'
        END AS RankCategory,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = cd.UserId AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = cd.UserId AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = cd.UserId AND b.Class = 3) AS BronzeBadges
    FROM CombinedData cd
    WHERE cd.Score > 10
      AND cd.ViewCount > 100
      AND cd.AnswerCount >= 0
),
FinalAnalysis AS (
    SELECT 
        fd.UserId,
        fd.DisplayName,
        fd.Reputation,
        fd.TotalPosts,
        fd.Questions,
        fd.Answers,
        fd.Comments,
