        fd.CommentCountByPosts,
        fd.CombinedScore,
        fd.Temperature,
        fd.DiscussionLevel,
        fd.QualityMetric,
        fd.AnswerCommentRatio,
        fd.UpvoteRatio,
        fd.UserPostRank,
        fd.CombinedScoreRank,
        fd.ScoreQuartile,
        fd.QualityPercentile,
        fd.UserAvgPostScore,
        fd.UserMaxViewCount,
        fd.RunningScoreTotal,
        fd.PrevPostScore,
        fd.PrevPostDate,
        fd.DaysSinceLastPost,
        fd.EditStatus,
        fd.ReceptionLevel,
        fd.TagComplexity,
        fd.RankCategory,
        fd.GoldBadges,
        fd.SilverBadges,
        fd.BronzeBadges,
        CASE 
            WHEN fd.Reputation > 10000 AND fd.GoldBadges > 10 THEN 'EliteContributor'
            WHEN fd.Reputation > 5000 AND fd.Badges > 20 THEN 'VeteranContributor'
            WHEN fd.Reputation > 1000 AND fd.Questions > 50 THEN 'ActiveContributor'
            ELSE 'RegularContributor'
        END AS ContributionLevel,
        CASE 
            WHEN fd.CombinedScore > (SELECT AVG(CombinedScore) FROM FilteredData) + 3 * (SELECT STDDEV(CombinedScore) FROM FilteredData) THEN 'Exceptional'
            WHEN fd.CombinedScore > (SELECT AVG(CombinedScore) FROM FilteredData) + 2 * (SELECT STDDEV(CombinedScore) FROM FilteredData) THEN 'Excellent'
            WHEN fd.CombinedScore > (SELECT AVG(CombinedScore) FROM FilteredData) + 1 * (SELECT STDDEV(CombinedScore) FROM FilteredData) THEN 'Good'
            WHEN fd.CombinedScore > (SELECT AVG(CombinedScore) FROM FilteredData) THEN 'Average'
            ELSE 'BelowAverage'
        END AS PerformanceTier
    FROM FilteredData fd
)
