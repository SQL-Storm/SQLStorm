SELECT 
    u.DisplayName,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    SUM(CASE WHEN p.PostTypeId = 3 THEN 1 ELSE 0 END) AS TotalWikis,
    MAX(p.Score) AS HighestScoredPost,
    MIN(p.Score) AS LowestScoredPost,
    AVG(p.Score) AS AverageScore,
    SUM(v.BountyAmount) AS TotalBounty,
    COUNT(DISTINCT CASE WHEN pl.LinkTypeId = 3 THEN pl.RelatedPostId ELSE NULL END) AS TotalDuplicates,
    COUNT(DISTINCT CASE WHEN b.TagBased = TRUE THEN t.TagName ELSE NULL END) AS TotalTagBasedBadges,
    COUNT(DISTINCT CASE WHEN b.TagBased = FALSE THEN t.TagName ELSE NULL END) AS TotalNamedBadges
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId AND v.VoteTypeId = 8
LEFT JOIN 
    PostLinks pl ON p.Id = pl.PostId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Tags t ON b.TagBased = t.Id OR b.TagBased = CAST(t.Id AS BOOLEAN) -- accommodate possible type mismatch
WHERE 
    u.Reputation > 1000
    AND p.CreationDate BETWEEN DATE_TRUNC('month', DATE '2024-10-01') AND DATE '2024-10-01'
GROUP BY 
    u.DisplayName,
    u.Id
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    TotalPosts DESC;