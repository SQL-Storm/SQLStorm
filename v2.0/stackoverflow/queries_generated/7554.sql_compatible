SELECT 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) as TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN p.Id END) as QuestionsWithAcceptedAnswers,
    COUNT(DISTINCT b.Id) as BadgesReceived,
    COUNT(DISTINCT CASE WHEN b.Class = 1 THEN b.Id END) as GoldBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 2 THEN b.Id END) as SilverBadges,
    COUNT(DISTINCT CASE WHEN b.Class = 3 THEN b.Id END) as BronzeBadges,
    COALESCE(SUM(p.Score), 0) as TotalScore,
    COALESCE(AVG(p.Score), 0) as AverageScore,
    MAX(p.CreationDate) as LastPostDate,
    MIN(p.CreationDate) as FirstPostDate,
    CAST('2024-10-01 12:34:56' AS TIMESTAMP) - u.CreationDate as AccountAgeInterval,
    (
        SELECT COUNT(*) 
        FROM Posts p2 
        WHERE p2.OwnerUserId = u.Id 
        AND p2.PostTypeId = 1 
        AND p2.Score > (
            SELECT AVG(p3.Score) + COALESCE(STDDEV_POP(p3.Score), 0) 
            FROM Posts p3 
            WHERE p3.PostTypeId = 1 
            AND p3.OwnerUserId = u.Id
        )
    ) as HighScoringQuestions,
    (
        SELECT STRING_AGG(p4.Tags, ', ')
        FROM Posts p4
        WHERE p4.OwnerUserId = u.Id
        AND p4.PostTypeId = 1
        AND p4.Tags IS NOT NULL
        AND LENGTH(p4.Tags) > 2
    ) as UserTags,
    CASE 
        WHEN u.Reputation > 10000 THEN 'High'
        WHEN u.Reputation > 1000 THEN 'Medium'
        WHEN u.Reputation > 100 THEN 'Low'
        ELSE 'Very Low'
    END as ReputationTier,
    (
        SELECT COUNT(DISTINCT ph.Id)
        FROM PostHistory ph
        JOIN Posts p5 ON ph.PostId = p5.Id
        WHERE p5.OwnerUserId = u.Id
        AND ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6)
    ) as EditingActivity,
    (
        SELECT COUNT(*)
        FROM Comments c
        WHERE c.UserId = u.Id
    ) as CommentCount,
    (
        SELECT COUNT(*)
        FROM Posts p6
        WHERE p6.OwnerUserId = u.Id
        AND p6.CommentCount > 0
        AND p6.PostTypeId = 1
        AND EXISTS (
            SELECT 1
            FROM Votes v
            WHERE v.PostId = p6.Id
            AND v.VoteTypeId = 5
            AND v.UserId = u.Id
        )
    ) as FavoritedQuestions,
    (
        SELECT AVG(p7.Score)
        FROM Posts p7
        WHERE p7.OwnerUserId = u.Id
        AND p7.PostTypeId = 2
        AND EXISTS (
            SELECT 1
            FROM Posts p8
            WHERE p8.Id = p7.ParentId
            AND p8.OwnerUserId = u.Id
        )
    ) as AverageAnswerScoreForOwnQuestions,
    (
        SELECT COUNT(DISTINCT p9.Id)
        FROM Posts p9
        WHERE p9.OwnerUserId = u.Id
        AND p9.PostTypeId = 1
        AND (
            SELECT COUNT(*)
            FROM PostHistory ph2
            WHERE ph2.PostId = p9.Id
            AND ph2.PostHistoryTypeId IN (10, 11, 12, 13)
        ) > 0
    ) as QuestionsWithHistory,
    (
        SELECT STRING_AGG(t.TagName, ' | ')
        FROM Tags t
        WHERE t.Id IN (
            SELECT DISTINCT p10.Id
            FROM Posts p10
            WHERE p10.OwnerUserId = u.Id
            AND p10.PostTypeId = 1
            AND p10.Tags IS NOT NULL
            AND p10.Tags != ''
            AND EXISTS (
                SELECT 1
                FROM Posts p11
                WHERE p11.Id = p10.ParentId
                AND p11.PostTypeId = 2
            )
        )
    ) as QuestionTags,
    (
        SELECT COUNT(DISTINCT p12.Id)
        FROM Posts p12
        WHERE p12.OwnerUserId = u.Id
        AND p12.PostTypeId = 1
        AND (
            SELECT COUNT(*) 
            FROM PostHistory ph3
            WHERE ph3.PostId = p12.Id
            AND ph3.PostHistoryTypeId IN (4, 5, 6)
        ) >= 3
    ) as FrequentlyEditedQuestions,
    (
        SELECT COUNT(DISTINCT p13.Id)
        FROM Posts p13
        WHERE p13.OwnerUserId = u.Id
        AND p13.PostTypeId = 1
        AND EXISTS (
            SELECT 1
            FROM PostLinks pl
            WHERE pl.PostId = p13.Id
            AND pl.LinkTypeId = 1
        )
    ) as QuestionsWithLinks,
    LAG(COUNT(DISTINCT p.Id), 1, 0) OVER (ORDER BY u.Reputation DESC) as PreviousUserPostCount
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId
LEFT JOIN Badges b ON u.Id = b.UserId
WHERE u.Id IN (
    SELECT UserId 
    FROM Posts 
    WHERE PostTypeId = 1 
    GROUP BY UserId 
    HAVING COUNT(*) >= 100
    UNION
    SELECT UserId 
    FROM Badges 
    WHERE Class = 1 
    GROUP BY UserId 
    HAVING COUNT(*) >= 5
)
GROUP BY 
    u.Id, 
    u.DisplayName, 
    u.Reputation, 
    u.CreationDate
HAVING 
    COUNT(DISTINCT p.Id) > 0
    AND MAX(p.CreationDate) >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '3' MONTH)
ORDER BY 
    u.Reputation DESC,
    COALESCE(SUM(p.Score), 0) DESC,
    COUNT(DISTINCT p.Id) DESC
LIMIT 1000;