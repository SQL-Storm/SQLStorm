-- {"query": "7975.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 1927} 
WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        MAX(p.CreationDate) as LastPostDate,
        MIN(p.CreationDate) as FirstPostDate,
        DATEDIFF(DAY, MIN(p.CreationDate), MAX(p.CreationDate)) as DaysActive,
        CASE 
            WHEN u.Reputation > 10000 THEN 'Elite'
            WHEN u.Reputation > 5000 THEN 'Expert'
            WHEN u.Reputation > 1000 THEN 'Advanced'
            ELSE 'Beginner'
        END as ReputationTier
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 0
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END as PostType,
        p.Tags,
        STRING_AGG(t.TagName, ', ') as TagList
    FROM Posts p
    LEFT JOIN (
        SELECT 
            Id,
            UNNEST(STRING_TO_ARRAY(LEFT(Tags, LENGTH(Tags) - 1), '><')) as TagName
        FROM Posts 
        WHERE Tags IS NOT NULL AND Tags != ''
    ) t ON p.Id = t.Id
    WHERE p.PostTypeId IN (1, 2) -- Only questions and answers
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.CreationDate, p.OwnerUserId, p.PostTypeId, p.Tags
),
UserActivity AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        COUNT(DISTINCT ph.Id) as HistoryCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 1 THEN ph.Id END) as TitleEdits,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (2, 5) THEN ph.Id END) as BodyEdits,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId = 6 THEN ph.Id END) as TagEdits,
        MAX(ph.CreationDate) as LastActivity,
        DATEDIFF(DAY, u.CreationDate, MAX(ph.CreationDate)) as DaysSinceLastActivity
    FROM Users u
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId
    WHERE ph.CreationDate >= DATEADD(YEAR, -2, cast('2024-10-01 12:34:56' as timestamp)) -- Last 2 years
    GROUP BY u.Id, u.DisplayName, u.CreationDate
)
SELECT 
    us.UserId,
    us.DisplayName,
    us.Reputation,
    us.PostCount,
    us.CommentCount,
    us.BadgeCount,
    us.ReputationTier,
    pa.PostId,
    pa.Title,
    pa.Score,
    pa.ViewCount,
    pa.AnswerCount,
    pa.CommentCount,
    pa.CreationDate,
    pa.PostType,
    pa.TagList,
    ua.HistoryCount,
    ua.TitleEdits,
    ua.BodyEdits,
    ua.TagEdits,
    ua.LastActivity,
    CASE 
        WHEN (us.PostCount > 0 AND us.Reputation > 100) THEN 
            (us.PostCount * 0.3 + us.CommentCount * 0.2 + us.BadgeCount * 0.5) * 
            POWER(1.1, (DATEDIFF(DAY, us.FirstPostDate, cast('2024-10-01 12:34:56' as timestamp)) / 365.0))
        ELSE 0
    END as ActivityScore,
    CASE 
        WHEN us.PostCount > 0 AND pa.Score > 100 THEN 'Highly Engaged'
        WHEN us.PostCount > 0 AND pa.Score > 10 THEN 'Engaged'
        ELSE 'Low Engagement'
    END as EngagementLevel,
    CASE 
        WHEN pa.Score > 500 AND pa.AnswerCount > 5 THEN 'Expert Contributor'
        WHEN pa.Score > 100 AND pa.AnswerCount > 2 THEN 'Contributor'
        ELSE 'Member'
    END as ContributionLevel,
    CASE 
        WHEN ua.LastActivity IS NULL THEN 'Inactive'
        WHEN DATEDIFF(DAY, ua.LastActivity, cast('2024-10-01 12:34:56' as timestamp)) <= 30 THEN 'Active'
        WHEN DATEDIFF(DAY, ua.LastActivity, cast('2024-10-01 12:34:56' as timestamp)) <= 90 THEN 'Moderately Active'
        ELSE 'Inactive'
    END as ActivityStatus,
    ROW_NUMBER() OVER (PARTITION BY pa.PostTypeId ORDER BY pa.Score DESC) as ScoreRankInType,
    RANK() OVER (ORDER BY pa.Score DESC) as GlobalScoreRank,
    DENSE_RANK() OVER (ORDER BY us.Reputation DESC) as ReputationRank,
    NTILE(10) OVER (ORDER BY pa.Score DESC) as ScoreDecile,
    LAG(pa.Score, 1) OVER (ORDER BY pa.Score DESC) as PreviousScore,
    LEAD(pa.Score, 1) OVER (ORDER BY pa.Score DESC) as NextScore,
    ABS(pa.Score - LAG(pa.Score, 1) OVER (ORDER BY pa.Score DESC)) as ScoreDifference,
    COALESCE(pa.Tags, 'No Tags') as TagsOrNoTags,
    CASE 
        WHEN pa.Title LIKE '%[Qq]uestion%' OR pa.Title LIKE '%[Aa]nswer%' THEN 'Relevant'
        WHEN pa.Title LIKE '%[Ss]QL%' OR pa.Title LIKE '%[Ss]chema%' THEN 'Technical'
        WHEN pa.Title LIKE '%[Pp]erformance%' OR pa.Title LIKE '%[Bb]enchmark%' THEN 'Performance Focus'
        ELSE 'General'
    END as TitleCategory,
    CASE 
        WHEN us.Reputation < 100 THEN 'Beginner'
        WHEN us.Reputation >= 100 AND us.Reputation < 1000 THEN 'Intermediate'
        WHEN us.Reputation >= 1000 AND us.Reputation < 10000 THEN 'Advanced'
        ELSE 'Expert'
    END as UserExperienceLevel,
    CASE 
        WHEN us.BadgeCount > 10 AND us.PostCount > 50 THEN 'Super Contributor'
        WHEN us.BadgeCount > 5 AND us.PostCount > 20 THEN 'Contributor'
        ELSE 'Regular Member'
    END as MembershipLevel,
    CASE 
        WHEN pa.ViewCount > (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1) THEN 'Popular'
        WHEN pa.ViewCount > (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1) * 0.5 THEN 'Moderately Popular'
        ELSE 'Low View'
    END as PopularityLevel,
    CONCAT('User: ', us.DisplayName, ' | Post: ', pa.Title, ' | Score: ', pa.Score) as CombinedIdentifiers,
    CASE 
        WHEN pa.Score IS NULL THEN 0
        WHEN pa.Score > 0 THEN 1
        WHEN pa.Score < 0 THEN -1
        ELSE 0
    END as ScoreSign,
    DATEDIFF(DAY, pa.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) as DaysSincePost,
    'Final Report - ' + CAST(cast('2024-10-01 12:34:56' as timestamp) AS VARCHAR(20)) as ReportHeader
FROM UserStats us
INNER JOIN PostAnalysis pa ON us.UserId = pa.OwnerUserId
LEFT JOIN UserActivity ua ON us.UserId = ua.UserId
WHERE 
    (pa.Score > 0 OR pa.Score IS NULL)
    AND pa.CreationDate >= DATEADD(YEAR, -3, cast('2024-10-01 12:34:56' as timestamp))
    AND (us.PostCount > 0 OR us.CommentCount > 0)
    AND (pa.Score >= 0 OR pa.Score IS NULL)
    AND NOT (pa.PostType = 'Answer' AND pa.AnswerCount IS NULL)
    AND pa.TagList LIKE '%sql%' 
    OR pa.TagList LIKE '%performance%'
ORDER BY 
    pa.Score DESC,
    us.Reputation DESC,
    pa.CreationDate DESC
OFFSET 1000 ROWS
FETCH NEXT 1000 ROWS ONLY
HAVING 
    COUNT(*) > 0
    AND SUM(pa.Score) OVER (ORDER BY pa.Score DESC) > 10000
    AND COUNT(DISTINCT pa.PostTypeId) >= 1
    AND COUNT(DISTINCT us.UserId) > 10;