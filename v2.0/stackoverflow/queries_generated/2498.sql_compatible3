SELECT
        pl.PostId,
        lt.Name AS LinkTypeName,
        COUNT(DISTINCT pl.RelatedPostId) AS RelatedPostCount
    FROM PostLinks pl
    INNER JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
    GROUP BY pl.PostId, lt.Name
),
TagUsage AS (
    SELECT
        LOWER(tag) AS Tag,
        COUNT(*) AS QuestionCount
    FROM (
        SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags) - 2), '><')) AS tag
        FROM Posts p 
        WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    ) tags
    GROUP BY LOWER(tag)
    HAVING COUNT(*) > 10
),
TopTagsWithScores AS (
    SELECT 
        tu.Tag,
        tu.QuestionCount,
        AVG(COALESCE(p.Score,0)) AS AverageScore,
        AVG(COALESCE(p.ViewCount,0)) AS AverageViewCount
    FROM TagUsage tu
    INNER JOIN Posts p ON p.PostTypeId = 1 AND p.Tags IS NOT NULL AND p.Tags ILIKE ('%' || '<' || tu.Tag || '>' || '%')
    GROUP BY tu.Tag, tu.QuestionCount
),
FinalOutput AS (
    SELECT 
        ar.QuestionId,
        ar.QuestionTitle,
        ar.QuestionTags,
        ar.QuestionViews,
        ar.QuestionScore,
        ar.QuestionOwner,
        COALESCE(ubs.GoldBadges,0) AS QuestionOwnerGoldBadges,
        COALESCE(ubs.SilverBadges,0) AS QuestionOwnerSilverBadges,
        COALESCE(ubs.BronzeBadges,0) AS QuestionOwnerBronzeBadges,
        ar.AnswerId,
        ar.AnswerScore,
        ar.AnswerCreationDate,
        COALESCE(aru.DisplayName,'(deleted)') AS AnswerOwnerName,
        COALESCE(arb.TotalBadges, 0) AS AnswerOwnerTotalBadges,
        ar.AnswerRank,
        cs.TotalComments,
        cs.CommentsMentioningPerformance,
        cs.LastCommentDate,
        al.LinkTypeName,
        al.RelatedPostCount,
        ttws.Tag,
        ttws.QuestionCount AS TagQuestionCount,
        ttws.AverageScore AS TagAverageScore,
        ttws.AverageViewCount AS TagAverageViewCount,
        ar.QuestionWeightedScore,
        ar.AnswerWeightedScore
    FROM AnswerRankings ar
    LEFT JOIN Users ubs ON ar.QuestionOwnerId = ubs.Id
    LEFT JOIN UserBadgeSummary arb ON ar.AnswerOwnerId = arb.UserId
    LEFT JOIN Users aru ON ar.AnswerOwnerId = aru.Id
    LEFT JOIN CommentStats cs ON cs.PostId = ar.QuestionId
    LEFT JOIN AggregatedLinks al ON al.PostId = ar.QuestionId
    LEFT JOIN TopTagsWithScores ttws ON ar.QuestionTags ILIKE ('%' || '<' || ttws.Tag || '>' || '%')
    WHERE ar.AnswerRank <= 3
)
SELECT *
FROM FinalOutput
WHERE 
    (QuestionViews > 1000 OR QuestionScore > 5)
    AND (AnswerScore > 0 OR AnswerId IS NULL)
    AND (CommentsMentioningPerformance > 0 OR LinkTypeName IS NOT NULL)
ORDER BY QuestionWeightedScore DESC, AnswerWeightedScore DESC, CommentsMentioningPerformance DESC NULLS LAST
LIMIT 100;