WITH RecentPosts AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Title,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY
),
UserBadges AS (
    SELECT
        u.Id                           AS UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        MAX(b.Date)                    AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id
),
TagAggregates AS (
    SELECT
        t.TagName,
        COUNT(p.Id)                 AS QuestionCount,
        AVG(p.Score)                AS AvgScore,
        MAX(p.CreationDate)         AS LatestQuestion
    FROM Tags t
    LEFT JOIN Posts p
        ON p.Id = t.ExcerptPostId OR p.Id = t.WikiPostId
    WHERE p.PostTypeId = 1
    GROUP BY t.TagName
),
PostVoteCounts AS (
    SELECT
        ph.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
    FROM PostHistory ph
    LEFT JOIN Votes v
        ON v.PostId = ph.PostId
       AND v.VoteTypeId IN (2, 3)
    GROUP BY ph.PostId
),
UserRecentAgg AS (
    SELECT
        OwnerUserId,
        COUNT(*)                                            AS TotalPosts,
        SUM(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END)     AS AnswerCount,
        AVG(COALESCE(Score,0))                               AS AvgScore
    FROM RecentPosts
    WHERE rn = 1
    GROUP BY OwnerUserId
),
PostLatestPerUser AS (
    SELECT p2.Id, p2.OwnerUserId, p2.CreationDate
    FROM Posts p2
    WHERE p2.CreationDate IS NOT NULL
),
LatestPostByUser AS (
    SELECT p.Id, p.OwnerUserId, p.CreationDate
    FROM PostLatestPerUser p
    JOIN (
        SELECT OwnerUserId, MAX(CreationDate) AS max_cd
        FROM PostLatestPerUser
        GROUP BY OwnerUserId
    ) m ON m.OwnerUserId = p.OwnerUserId AND m.max_cd = p.CreationDate
),
TagsPerPost AS (
    SELECT
        pt.OwnerUserId,
        t.TagName
    FROM Posts pt,
    LATERAL (
        SELECT TRIM(BOTH '<>' FROM UNNEST(string_to_array(pt.Tags, '><'))) AS raw_tag
    ) AS tags_raw
    LEFT JOIN Tags t ON t.TagName = tags_raw.raw_tag
),
MainResult AS (
SELECT
    u.Id                                           AS UserId,
    COALESCE(u.DisplayName, 'Anonymous')           AS DisplayName,
    u.Reputation,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    ub.LastBadgeDate,
    rp.TotalPosts,
    rp.AnswerCount,
    rp.AvgScore,
    rv.UpVotes,
    rv.DownVotes,
    CASE
        WHEN COALESCE(ub.GoldBadges,0) > 0 THEN 'PowerUser'
        WHEN COALESCE(ub.SilverBadges,0) > 0 THEN 'Experienced'
        ELSE 'Newbie'
    END                                            AS UserTier,
    STRING_AGG(DISTINCT ta.TagName, ', ') FILTER (WHERE ta.TagName IS NOT NULL) AS TopTags
FROM Users u
LEFT JOIN UserRecentAgg rp ON rp.OwnerUserId = u.Id
LEFT JOIN UserBadges ub ON ub.UserId = u.Id
LEFT JOIN PostVoteCounts rv ON rv.PostId = (
    SELECT Id FROM LatestPostByUser l WHERE l.OwnerUserId = u.Id LIMIT 1
)
LEFT JOIN TagsPerPost ta ON ta.OwnerUserId = u.Id
WHERE (u.Reputation > 1000 OR ub.GoldBadges IS NOT NULL)
  AND (rp.TotalPosts IS NOT NULL OR COALESCE(ub.SilverBadges,0) > 0)
GROUP BY
    u.Id, u.DisplayName, u.Reputation,
    ub.GoldBadges, ub.SilverBadges, ub.BronzeBadges,
    ub.LastBadgeDate, rp.TotalPosts, rp.AnswerCount,
    rp.AvgScore, rv.UpVotes, rv.DownVotes,
    CASE
        WHEN COALESCE(ub.GoldBadges,0) > 0 THEN 'PowerUser'
        WHEN COALESCE(ub.SilverBadges,0) > 0 THEN 'Experienced'
        ELSE 'Newbie'
    END
HAVING SUM(CASE WHEN COALESCE(rp.TotalPosts,0) > 5 THEN 1 ELSE 0 END) > 0
)
SELECT * FROM MainResult
ORDER BY Reputation DESC NULLS LAST
LIMIT 100

UNION ALL

SELECT
    NULL                                         AS UserId,
    '--- Summary ---'                            AS DisplayName,
    NULL                                         AS Reputation,
    NULL AS GoldBadges, NULL AS SilverBadges, NULL AS BronzeBadges,
    NULL AS LastBadgeDate,
    SUM(COALESCE(rp.TotalPosts,0))                           AS TotalPosts,
    SUM(COALESCE(rp.AnswerCount,0))                          AS AnswerCount,
    AVG(rp.AvgScore)                             AS AvgScore,
    SUM(COALESCE(rv.UpVotes,0))                              AS UpVotes,
    SUM(COALESCE(rv.DownVotes,0))                            AS DownVotes,
    NULL AS UserTier,
    NULL AS TopTags
FROM Users u
LEFT JOIN UserRecentAgg rp ON rp.OwnerUserId = u.Id
LEFT JOIN PostVoteCounts rv ON rv.PostId = rp.OwnerUserId;