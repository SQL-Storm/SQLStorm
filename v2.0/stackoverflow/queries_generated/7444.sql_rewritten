-- {"query": "7444.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 1797} 
WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(c.CreationDate) AS LastCommentDate,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN p.Id END) AS QuestionWithAcceptedAnswer,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AnswerCount > 0 THEN p.Id END) AS QuestionWithAnswers,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 AND p.Score > 0 THEN p.Id END) AS HighScoreAnswers,
        AVG(CAST(p.Score AS FLOAT)) AS AvgPostScore,
        STRING_AGG(DISTINCT p.Tags, ', ') AS AllTags,
        COUNT(DISTINCT ph.Id) AS EditCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13) THEN ph.Id END) AS ModerationActivities
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId AND ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 24)
    WHERE u.CreationDate >= '2010-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
UserPerformance AS (
    SELECT 
        *,
        CASE 
            WHEN Reputation >= 10000 THEN 'Elite'
            WHEN Reputation >= 5000 THEN 'Advanced'
            WHEN Reputation >= 1000 THEN 'Intermediate'
            WHEN Reputation >= 100 THEN 'Beginner'
            ELSE 'Newbie'
        END AS ReputationTier,
        CASE 
            WHEN PostCount >= 1000 THEN 'Prolific'
            WHEN PostCount >= 500 THEN 'Active'
            WHEN PostCount >= 100 THEN 'Regular'
            WHEN PostCount >= 10 THEN 'Casual'
            ELSE 'Occasional'
        END AS ActivityLevel,
        CASE 
            WHEN QuestionCount > 0 THEN CAST(AnswerCount AS FLOAT) / CAST(QuestionCount AS FLOAT)
            ELSE 0 
        END AS AnswerToQuestionRatio,
        CASE 
            WHEN QuestionCount > 0 THEN CAST(QuestionWithAcceptedAnswer AS FLOAT) / CAST(QuestionCount AS FLOAT)
            ELSE 0 
        END AS AcceptedAnswerRate,
        CAST(DATEDIFF(day, LastPostDate, cast('2024-10-01 12:34:56' as timestamp)) AS FLOAT) AS DaysSinceLastPost,
        COALESCE(Score, 0) AS FinalScore
    FROM UserActivityStats
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        PostCount,
        CommentCount,
        BadgeCount,
        LastPostDate,
        QuestionCount,
        AnswerCount,
        AnswerToQuestionRatio,
        AcceptedAnswerRate,
        DaysSinceLastPost,
        ReputationTier,
        ActivityLevel,
        FinalScore,
        ROW_NUMBER() OVER (ORDER BY Reputation DESC, PostCount DESC) AS RankByReputation,
        ROW_NUMBER() OVER (ORDER BY PostCount DESC, Reputation DESC) AS RankByActivity,
        DENSE_RANK() OVER (PARTITION BY ReputationTier ORDER BY PostCount DESC) AS TierActivityRank,
        PERCENT_RANK() OVER (ORDER BY Reputation) AS ReputationPercentile,
        NTILE(100) OVER (ORDER BY Reputation) AS ReputationDecile
    FROM UserPerformance
),
ComplexFilter AS (
    SELECT 
        *,
        CASE 
            WHEN Reputation > 50000 AND PostCount > 5000 THEN 'Legendary'
            WHEN Reputation > 20000 AND PostCount > 2000 THEN 'Veteran'
            WHEN Reputation > 10000 AND PostCount > 1000 THEN 'Experienced'
            ELSE 'Standard'
        END AS RecognitionLevel,
        CASE 
            WHEN ABS(DaysSinceLastPost) > 365 THEN 'Inactive'
            WHEN DaysSinceLastPost > 30 THEN 'LessActive'
            WHEN DaysSinceLastPost < 10 THEN 'Active'
            ELSE 'ModeratelyActive'
        END AS ActivityStatus,
        CASE 
            WHEN PostCount > 500 AND AnswerCount > 100 AND QuestionCount > 100 THEN 'Productive'
            WHEN PostCount > 200 AND AnswerCount > 50 THEN 'Contributor'
            ELSE 'Participant'
        END AS ContributionLevel,
        AVG(Reputation) OVER (PARTITION BY ReputationTier) AS AvgReputationByTier,
        AVG(PostCount) OVER (PARTITION BY ReputationTier) AS AvgPostCountByTier,
        SUM(PostCount) OVER (ORDER BY Reputation DESC) AS CumulativePostCount,
        LAG(PostCount, 1) OVER (ORDER BY Reputation DESC) AS PreviousPostCount,
        LEAD(PostCount, 1) OVER (ORDER BY Reputation DESC) AS NextPostCount,
        ABS(PostCount - LAG(PostCount, 1) OVER (ORDER BY Reputation DESC)) AS PostCountChange,
        CASE 
            WHEN PostCount > (SELECT AVG(PostCount) FROM TopUsers) * 2 THEN 'AboveAverage'
            WHEN PostCount > (SELECT AVG(PostCount) FROM TopUsers) THEN 'Average'
            ELSE 'BelowAverage'
        END AS PerformanceCategory
    FROM TopUsers
)
SELECT 
    UserId,
    DisplayName,
    Reputation,
    PostCount,
    CommentCount,
    BadgeCount,
    LastPostDate,
    QuestionCount,
    AnswerCount,
    AnswerToQuestionRatio,
    AcceptedAnswerRate,
    DaysSinceLastPost,
    ReputationTier,
    ActivityLevel,
    FinalScore,
    RankByReputation,
    RankByActivity,
    TierActivityRank,
    ReputationPercentile,
    ReputationDecile,
    RecognitionLevel,
    ActivityStatus,
    ContributionLevel,
    AvgReputationByTier,
    AvgPostCountByTier,
    CumulativePostCount,
    PreviousPostCount,
    NextPostCount,
    PostCountChange,
    PerformanceCategory,
    CASE 
        WHEN RankByReputation <= 10 AND Reputation > 100000 THEN 'Top10Reputation'
        WHEN RankByActivity <= 10 AND PostCount > 5000 THEN 'Top10Activity'
        WHEN ReputationTier = 'Elite' AND RankByReputation <= 5 THEN 'EliteTop5'
        ELSE 'Other'
    END AS TopStatus,
    CASE 
        WHEN Reputation >= 100000 THEN 'Master'
        WHEN Reputation >= 10000 THEN 'Expert'
        WHEN Reputation >= 1000 THEN 'Professional'
        WHEN Reputation >= 100 THEN 'Novice'
        ELSE 'Beginner'
    END AS AchievementTier,
    ROW_NUMBER() OVER (ORDER BY Rep - 100000 DESC) AS GlobalRank,
    DENSE_RANK() OVER (ORDER BY Reputation DESC) AS GlobalDenseRank,
    COUNT(*) OVER () AS TotalUsers
FROM ComplexFilter
WHERE 
    (Reputation > 5000 OR PostCount > 100 OR CommentCount > 50) 
    AND (ActivityStatus IN ('Active', 'ModeratelyActive') OR DaysSinceLastPost < 30)
    AND (AnswerToQuestionRatio >= 0.5 OR AcceptedAnswerRate >= 0.7)
    AND FinalScore > (SELECT AVG(FinalScore) FROM ComplexFilter)
ORDER BY 
    CASE WHEN Rep > 100000 THEN 1 ELSE 2 END,
    Reputation DESC,
    PostCount DESC,
    CommentCount DESC,
    BadgeCount DESC;