WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        p.CreationDate,
        p.LastActivityDate,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS ScoreRank,
        DENSE_RANK() OVER (ORDER BY p.Score DESC) AS ScoreDenseRank,
        LAG(p.Score) OVER (ORDER BY p.Score DESC) AS PrevScore,
        LEAD(p.Score) OVER (ORDER BY p.Score DESC) AS NextScore,
        AVG(p.Score) OVER (PARTITION BY p.PostTypeId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS RollingAvgScore,
        NTILE(100) OVER (ORDER BY p.Score) AS ScorePercentile,
        CASE 
            WHEN p.PostTypeId = 1 AND p.Score >= 100 THEN 'Highly_Voted_Question'
            WHEN p.PostTypeId = 1 AND p.Score >= 10 THEN 'Moderately_Voted_Question'
            WHEN p.PostTypeId = 2 AND p.Score >= 50 THEN 'Highly_Voted_Answer'
            ELSE 'Other'
        END AS PostCategory,
        COALESCE(
            CASE 
                WHEN p.Tags LIKE '%<c>%' THEN SUBSTRING(p.Tags FROM POSITION('<c>' IN p.Tags) + 3 FOR POSITION('<' IN SUBSTRING(p.Tags FROM POSITION('<c>' IN p.Tags) + 3)) - 3)
                WHEN p.Tags LIKE '%<python>%' THEN SUBSTRING(p.Tags FROM POSITION('<python>' IN p.Tags) + 8 FOR POSITION('<' IN SUBSTRING(p.Tags FROM POSITION('<python>' IN p.Tags) + 8)) - 8)
                WHEN p.Tags LIKE '%<java>%' THEN SUBSTRING(p.Tags FROM POSITION('<java>' IN p.Tags) + 6 FOR POSITION('<' IN SUBSTRING(p.Tags FROM POSITION('<java>' IN p.Tags) + 6)) - 6)
                WHEN p.Tags LIKE '%<javascript>%' THEN SUBSTRING(p.Tags FROM POSITION('<javascript>' IN p.Tags) + 12 FOR POSITION('<' IN SUBSTRING(p.Tags FROM POSITION('<javascript>' IN p.Tags) + 12)) - 12)
                ELSE NULL
            END,
            'No_Specific_Language'
        ) AS DominantLanguage
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) AND p.Score IS NOT NULL
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        COALESCE(
            (SELECT COUNT(*) FROM Posts WHERE Tags LIKE '%' || t.TagName || '%'),
            0
        ) AS UsageCount,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 100 THEN 'Moderate'
            WHEN t.Count > 10 THEN 'Niche'
            ELSE 'Rare'
        END AS TagPopularity,
        (
            SELECT COUNT(*) 
            FROM Posts p2 
            WHERE p2.PostTypeId = 1 AND p2.Tags LIKE '%' || t.TagName || '%' AND p2.CreationDate > DATE '2022-01-01'
        ) AS RecentUsage
    FROM Tags t
    WHERE t.Count > 0
),
UserActivity AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.CreationDate,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.LastAccessDate,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        AVG(p.Score) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(p.Score) AS MaxPostScore,
        COUNT(DISTINCT v.Id) AS VoteCount,
        CASE 
            WHEN u.Reputation > 100000 THEN 'Super_User'
            WHEN u.Reputation > 50000 THEN 'Expert'
            WHEN u.Reputation > 10000 THEN 'Advanced_User'
            ELSE 'Regular'
        END AS UserTier,
        CASE 
            WHEN u.Reputation < 100 THEN 'Newbie'
            WHEN u.Reputation < 1000 THEN 'Beginner'
            WHEN u.Reputation < 10000 THEN 'Intermediate'
            WHEN u.Reputation < 100000 THEN 'Advanced'
            ELSE 'Expert'
        END AS UserLevel
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.CreationDate, u.Views, u.UpVotes, u.DownVotes, u.LastAccessDate
),
PostTagsExpanded AS (
    /* split tags per post into rows: tag values without angle brackets */
    SELECT
        p.Id AS PostId,
        TRIM(SUBSTRING(tag FROM 1 FOR CHAR_LENGTH(tag))) AS TagName
    FROM Posts p,
    LATERAL (
        SELECT TRIM(both '<>' FROM t) AS tag
        FROM (
            -- replace >< with a separator, then split; approach using regexp_split_to_table is not standard across dialects.
            -- Use a simple recursive or generic split is dialect specific; provide a portable approximate using string functions is hard.
            -- Here assume a simple split by '><' using a VARCHAR split helper if supported; otherwise this will work in many engines supporting regexp_split_to_table or JSON functions.
            -- To maximize compatibility, use a very generic method: for systems that support UNNEST/STRING_TO_ARRAY replace accordingly.
            SELECT UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<' FROM TRIM(BOTH '>' FROM p.Tags)), '><')) AS t
        ) s
    ) tag_split
    WHERE p.Tags IS NOT NULL AND p.Tags <> ''
),
PostTagRelations AS (
    SELECT
        pe.PostId,
        pe.TagName
    FROM PostTagsExpanded pe
),
ComplexJoinAnalysis AS (
    SELECT DISTINCT 
        rp.Id AS PostId,
        rp.Title,
        rp.Score,
        rp.ViewCount,
        rp.CreationDate,
        rp.DominantLanguage,
        rp.PostCategory,
        rp.PostTypeId,
        rp.PrevScore,
        rp.NextScore,
        rp.RollingAvgScore,
        rp.ScorePercentile,
        rp.AnswerCount,
        rp.CommentCount,
        rp.FavoriteCount,
        rp.OwnerUserId,
        u.DisplayName AS Author,
        u.Reputation AS AuthorReputation,
        ua.UserTier,
        ua.UserLevel,
        ta.TagName,
        ta.TagPopularity,
        ta.UsageCount,
        CASE 
            WHEN rp.Score > (SELECT AVG(p3.Score) FROM Posts p3 WHERE p3.PostTypeId = 1) THEN 'Above_Avg_Question'
            WHEN rp.Score > (SELECT AVG(p4.Score) FROM Posts p4 WHERE p4.PostTypeId = 2) THEN 'Above_Avg_Answer'
            ELSE 'Below_Avg'
        END AS ScoreComparison,
        CASE 
            WHEN rp.Score = (SELECT MAX(p5.Score) FROM Posts p5) THEN 'Highest_Score'
            WHEN rp.Score = (SELECT MIN(p6.Score) FROM Posts p6) THEN 'Lowest_Score'
            ELSE 'Normal'
        END AS ScoreStatus,
        EXTRACT(YEAR FROM DATE '2024-10-01') - EXTRACT(YEAR FROM rp.CreationDate) AS PostAgeYears,
        (rp.Score - COALESCE(rp.PrevScore, 0)) AS ScoreChangeFromPrev,
        (COALESCE(rp.NextScore, 0) - rp.Score) AS ScoreChangeToNext,
        CASE 
            WHEN rp.AnswerCount > 0 AND rp.AnswerCount >= (SELECT AVG(p7.AnswerCount) FROM Posts p7 WHERE p7.PostTypeId = 1) THEN 'Well_Answered'
            WHEN rp.AnswerCount = 0 THEN 'No_Answers'
            ELSE 'Few_Answers'
        END AS AnswerStatus,
        CASE 
            WHEN rp.CommentCount > 0 THEN 'Has_Comments'
            ELSE 'No_Comments'
        END AS CommentStatus,
        CASE 
            WHEN rp.FavoriteCount > (SELECT AVG(p8.FavoriteCount) FROM Posts p8) THEN 'Favorited'
            ELSE 'Not_Favorited'
        END AS FavoriteStatus
    FROM RankedPosts rp
    INNER JOIN Users u ON rp.OwnerUserId = u.Id
    INNER JOIN UserActivity ua ON u.Id = ua.UserId
    LEFT JOIN PostTagRelations ptr ON ptr.PostId = rp.Id
    LEFT JOIN TagAnalysis ta ON ta.TagName = ptr.TagName
    WHERE 
       rp.Score > 0 
        AND (rp.PostTypeId = 1 OR (rp.PostTypeId = 2 AND rp.Score >= 5))
        AND u.Reputation > 0
        AND ua.UserTier IN ('Super_User', 'Expert', 'Advanced_User')
)
SELECT 
    cja.PostId,
    cja.Title,
    cja.Score,
    cja.ViewCount,
    cja.CreationDate,
    cja.DominantLanguage,
    cja.PostCategory,
    cja.PostTypeId,
    cja.PrevScore,
    cja.NextScore,
    cja.RollingAvgScore,
    cja.ScorePercentile,
    cja.AnswerCount,
    cja.CommentCount,
    cja.FavoriteCount,
    cja.OwnerUserId,
    cja.Author,
    cja.AuthorReputation,
    cja.UserTier,
    cja.UserLevel,
    cja.TagName,
    cja.TagPopularity,
    cja.UsageCount,
    cja.ScoreComparison,
    cja.ScoreStatus,
    cja.PostAgeYears,
    cja.ScoreChangeFromPrev,
    cja.ScoreChangeToNext,
    cja.AnswerStatus,
    cja.CommentStatus,
    cja.FavoriteStatus,
    ROW_NUMBER() OVER (ORDER BY cja.Score DESC) AS GlobalRank,
    RANK() OVER (ORDER BY cja.Score DESC) AS GlobalRankWithTies,
    DENSE_RANK() OVER (ORDER BY cja.Score DESC) AS GlobalRankDense,
    PERCENT_RANK() OVER (ORDER BY cja.Score DESC) AS RankPercentile,
    CUME_DIST() OVER (ORDER BY cja.Score DESC) AS CumulativeDistribution,
    NTILE(4) OVER (ORDER BY cja.Score DESC) AS Quartile,
    LAG(cja.Score) OVER (ORDER BY cja.Score DESC) AS PreviousScore,
    LEAD(cja.Score) OVER (ORDER BY cja.Score DESC) AS NextScore,
    FIRST_VALUE(cja.Score) OVER (ORDER BY cja.Score DESC) AS HighestScore,
    LAST_VALUE(cja.Score) OVER (ORDER BY cja.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS LowestScore,
    NTH_VALUE(cja.Score, 10) OVER (ORDER BY cja.Score DESC) AS ScoreTenthPlace,
    SUM(cja.Score) OVER (ORDER BY cja.Score DESC ROWS BETWEEN 10 PRECEDING AND CURRENT ROW) AS RollingSum10,
    AVG(cja.Score) OVER (ORDER BY cja.Score DESC ROWS BETWEEN 5 PRECEDING AND 5 FOLLOWING) AS MovingAvg5,
    STDDEV_POP(cja.Score) OVER () AS ScoreStdDev,
    VAR_POP(cja.Score) OVER () AS ScoreVariance,
    MIN(cja.Score) OVER (ORDER BY cja.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS RunningMin,
    MAX(cja.Score) OVER (ORDER BY cja.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS RunningMax,
    NTILE(10) OVER (ORDER BY cja.Score DESC) AS ScoreDecile,
    CASE 
        WHEN cja.Score > 500 THEN 'High_Score'
        WHEN cja.Score > 100 THEN 'Medium_Score'
        WHEN cja.Score > 10 THEN 'Low_Score'
        ELSE 'Very_Low_Score'
    END AS ScoreCategory,
    CASE 
        WHEN cja.PostAgeYears >= 5 THEN 'Old_Post'
        WHEN cja.PostAgeYears >= 1 THEN 'Recent_Post'
        ELSE 'Very_Recent_Post'
    END AS PostAgeGroup,
    CASE 
        WHEN cja.ScoreChangeFromPrev > 10 THEN 'Sharp_Increase'
        WHEN cja.ScoreChangeFromPrev < -10 THEN 'Sharp_Decrease'
        ELSE 'Stable'
    END AS ScoreMovementTrend
FROM ComplexJoinAnalysis cja
WHERE 
    (cja.Score > 100 OR (cja.PostTypeId = 2 AND cja.Score > 10))
    AND cja.AuthorReputation > 1000
    AND cja.TagPopularity IN ('Popular', 'Moderate')
    AND cja.UserTier IN ('Super_User', 'Expert')
    AND cja.AnswerStatus IN ('Well_Answered', 'No_Answers')
    AND cja.CommentStatus IN ('Has_Comments', 'No_Comments')
    AND cja.FavoriteStatus IN ('Favorited', 'Not_Favorited')
    AND (
        CASE 
            WHEN cja.Score > 500 THEN 'High_Score'
            WHEN cja.Score > 100 THEN 'Medium_Score'
            WHEN cja.Score > 10 THEN 'Low_Score'
            ELSE 'Very_Low_Score'
        END
    ) IN ('High_Score', 'Medium_Score')
    AND (
        CASE 
            WHEN cja.PostAgeYears >= 5 THEN 'Old_Post'
            WHEN cja.PostAgeYears >= 1 THEN 'Recent_Post'
            ELSE 'Very_Recent_Post'
        END
    ) IN ('Old_Post', 'Recent_Post')
    AND (
        CASE 
            WHEN cja.ScoreChangeFromPrev > 10 THEN 'Sharp_Increase'
            WHEN cja.ScoreChangeFromPrev < -10 THEN 'Sharp_Decrease'
            ELSE 'Stable'
        END
    ) IN ('Sharp_Increase', 'Sharp_Decrease')
ORDER BY cja.Score DESC, cja.ViewCount DESC, cja.CreationDate DESC
LIMIT 100000
OFFSET 0;