WITH
  RankedAnswers AS (
    SELECT
      p.Id AS PostId,
      p.ParentId AS QuestionId,
      ROW_NUMBER() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC, p.CreationDate ASC) AS Rank
    FROM Posts p
    WHERE
      p.PostTypeId = 2 AND p.ParentId IS NOT NULL
  ),
  TopAnswers AS (
    SELECT
      PostId,
      QuestionId,
      Rank
    FROM RankedAnswers
    WHERE
      Rank <= 3
  ),
  QuestionsWithTopAnswers AS (
    SELECT
      q.Id AS QuestionId,
      q.Title AS QuestionTitle,
      q.OwnerUserId AS QuestionOwnerId,
      q.CreationDate AS QuestionCreationDate,
      q.Score AS QuestionScore,
      q.ViewCount AS QuestionViewCount,
      ta.PostId AS TopAnswerId,
      ta.Rank AS AnswerRank
    FROM Posts q
    JOIN TopAnswers ta
      ON q.Id = ta.QuestionId
    WHERE
      q.PostTypeId = 1
  ),
  UserActivity AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName AS UserDisplayName,
      COUNT(CASE WHEN ph.PostHistoryTypeId IN (2, 5) THEN 1 END) AS EditedPostsCount,
      COUNT(CASE WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15, 19, 20) THEN 1 END) AS ModerationActionsCount,
      SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesReceived,
      SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesReceived,
      COUNT(DISTINCT c.Id) AS CommentCount,
      MAX(u.Reputation) AS MaxUserReputation
    FROM Users u
    LEFT JOIN PostHistory ph
      ON u.Id = ph.UserId
    LEFT JOIN Votes v
      ON u.Id = v.UserId
    LEFT JOIN Comments c
      ON u.Id = c.UserId
    GROUP BY
      u.Id,
      u.DisplayName
  ),
  TagEngagement AS (
    SELECT
      t.TagName,
      COUNT(DISTINCT p.Id) AS PostsWithTag,
      SUM(p.Score) AS TotalScoreForTag
    FROM Tags t
    JOIN Posts p
      ON POSITION(CONCAT('<', t.TagName, '>') IN p.Tags) > 0
    WHERE
      p.PostTypeId = 1
      AND p.CreationDate BETWEEN (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year') AND CAST('2024-10-01 12:34:56' AS TIMESTAMP)
    GROUP BY
      t.TagName
    HAVING
      COUNT(DISTINCT p.Id) > 100
  )
SELECT
  qta.QuestionId,
  qta.QuestionTitle,
  qta.QuestionOwnerId,
  u.UserDisplayName AS QuestionOwnerDisplayName,
  qta.QuestionCreationDate,
  qta.QuestionScore,
  qta.QuestionViewCount,
  qta.TopAnswerId,
  ta.Score AS TopAnswerScore,
  ta.CreationDate AS TopAnswerCreationDate,
  qta.AnswerRank,
  ua.UserDisplayName AS TopAnswerOwnerDisplayName,
  ua.EditedPostsCount,
  ua.ModerationActionsCount,
  ua.UpVotesReceived AS TopAnswerOwnerUpVotes,
  ua.DownVotesReceived AS TopAnswerOwnerDownVotes,
  ua.CommentCount AS TopAnswerOwnerCommentCount,
  tu.TagName AS PrimaryTag,
  te.PostsWithTag AS PrimaryTagPostCount,
  te.TotalScoreForTag AS PrimaryTagTotalScore,
  CASE WHEN qta.QuestionScore > 100 AND qta.QuestionViewCount > 10000 THEN 'HighPerformance' ELSE 'Standard' END AS PerformanceCategory,
  CASE
    WHEN qta.QuestionScore < 0 THEN 'NegativeScore'
    WHEN qta.QuestionScore BETWEEN 0 AND 50 THEN 'LowScore'
    WHEN qta.QuestionScore > 50 THEN 'HighScore'
    ELSE 'NoScore'
  END AS ScoreCategory,
  SUBSTRING(qta.QuestionTitle FROM 1 FOR 10) AS TitlePrefix,
  UPPER(REPLACE(REPLACE(qta.QuestionTitle, '?', ''), '!', '')) AS CleanedTitle,
  COALESCE(u.DisplayName, 'Community') AS OwnerDisplayNameFallback,
  CASE
    WHEN ta.Score IS NULL THEN 'No Answer'
    WHEN ta.Score >= 0 THEN 'PositiveOrZeroScore'
    WHEN ta.Score < 0 THEN 'NegativeScore'
  END AS TopAnswerScoreStatus
FROM QuestionsWithTopAnswers qta
LEFT JOIN Posts ta
  ON qta.TopAnswerId = ta.Id
LEFT JOIN Users u
  ON qta.QuestionOwnerId = u.Id
LEFT JOIN Users ua
  ON ta.OwnerUserId = ua.Id
LEFT JOIN UserActivity ua_activity
  ON ta.OwnerUserId = ua_activity.UserId
LEFT JOIN TagEngagement te
  ON (
    SUBSTRING(qta.QuestionTitle FROM (POSITION('#' IN qta.QuestionTitle) + 1)
      FOR (POSITION(' ' IN SUBSTRING(qta.QuestionTitle FROM POSITION('#' IN qta.QuestionTitle) + 1)) - 1)
    ) = te.TagName
  )
LEFT JOIN Tags tu
  ON tu.TagName = (
    SUBSTRING(qta.QuestionTitle FROM (POSITION('#' IN qta.QuestionTitle) + 1)
      FOR (POSITION(' ' IN SUBSTRING(qta.QuestionTitle FROM POSITION('#' IN qta.QuestionTitle) + 1)) - 1)
    )
WHERE
  qta.QuestionCreationDate BETWEEN (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '6 months') AND CAST('2024-10-01 12:34:56' AS TIMESTAMP)
  AND qta.QuestionScore > -5
UNION
SELECT
  NULL::BIGINT AS QuestionId,
  'Summary' AS QuestionTitle,
  NULL::BIGINT AS QuestionOwnerId,
  NULL AS QuestionOwnerDisplayName,
  NULL::TIMESTAMP AS QuestionCreationDate,
  NULL::INT AS QuestionScore,
  NULL::INT AS QuestionViewCount,
  NULL::BIGINT AS TopAnswerId,
  NULL::INT AS TopAnswerScore,
  NULL::TIMESTAMP AS TopAnswerCreationDate,
  NULL::INT AS AnswerRank,
  NULL AS TopAnswerOwnerDisplayName,
  AVG(ua.EditedPostsCount::NUMERIC) AS EditedPostsCount,
  AVG(ua.ModerationActionsCount::NUMERIC) AS ModerationActionsCount,
  AVG(ua.UpVotesReceived::NUMERIC) AS TopAnswerOwnerUpVotes,
  AVG(ua.DownVotesReceived::NUMERIC) AS TopAnswerOwnerDownVotes,
  AVG(ua.CommentCount::NUMERIC) AS TopAnswerOwnerCommentCount,
  'Overall' AS PrimaryTag,
  NULL::INT AS PrimaryTagPostCount,
  NULL::INT AS PrimaryTagTotalScore,
  'Summary' AS PerformanceCategory,
  NULL AS ScoreCategory,
  NULL AS TitlePrefix,
  NULL AS CleanedTitle,
  NULL AS OwnerDisplayNameFallback,
  NULL AS TopAnswerScoreStatus
FROM UserActivity ua;