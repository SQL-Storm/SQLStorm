-- {"query": "1400.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 4539} 
WITH UserEngagement AS (
    -- CTE 1: Analyze user engagement and derive a "Reputation Tier" along with a composite activity score.
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.UpVotes,
        U.DownVotes,
        U.Views AS UserViews,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        MAX(B.Class) AS MaxBadgeClass, -- 1=Gold, 2=Silver, 3=Bronze (lower is better for class value)
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN B.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN B.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        -- Calculate an approximate 'UserActivityScore' incorporating various user metrics.
        (U.Reputation * 0.15) + (U.UpVotes * 0.08) - (U.DownVotes * 0.03) + (U.Views * 0.005) + (COUNT(DISTINCT B.Id) * 0.1) AS UserActivityScore,
        -- Categorize users into reputation tiers using complex conditional logic.
        CASE
            WHEN U.Reputation >= 20000 AND EXISTS (SELECT 1 FROM Badges B_ WHERE B_.UserId = U.Id AND B_.Class = 1 AND B_.Date >= U.CreationDate + INTERVAL '1 year') THEN 'Legendary'
            WHEN U.Reputation >= 10000 AND U.UpVotes > 1000 AND U.Views > 5000 THEN 'Elite'
            WHEN U.Reputation >= 5000 OR (U.Reputation >= 2000 AND COUNT(DISTINCT B.Id) > 15 AND U.LastAccessDate > U.CreationDate + INTERVAL '1 year') THEN 'Advanced'
            WHEN U.Reputation >= 500 AND U.LastAccessDate > U.CreationDate + INTERVAL '3 months' THEN 'Intermediate'
            ELSE 'Novice'
        END AS ReputationTier,
        -- Use a window function to rank users by their combined up/down votes within their creation year.
        ROW_NUMBER() OVER (PARTITION BY EXTRACT(YEAR FROM U.CreationDate) ORDER BY (U.UpVotes + U.DownVotes) DESC, U.Reputation DESC) AS RankInCreationYear,
        -- Calculate the average reputation of users created in the same month.
        AVG(U.Reputation) OVER (PARTITION BY DATE_TRUNC('month', U.CreationDate)) AS AvgMonthlyCohortReputation
    FROM Users U
    LEFT JOIN Badges B ON U.Id = B.UserId
    WHERE U.LastAccessDate >= U.CreationDate + INTERVAL '1 month' -- Filter out very short-lived or immediately inactive users.
      AND U.Reputation > 0 -- Exclude users with zero reputation.
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.UpVotes, U.DownVotes, U.Views
),
PostCommentSummary AS (
    -- CTE 2: Aggregate comment data for posts, including sentiment approximation.
    SELECT
        C.PostId,
        COUNT(C.Id) AS TotalComments,
        SUM(C.Score) AS TotalCommentScore,
        MAX(C.CreationDate) AS LastCommentDate,
        MIN(C.CreationDate) AS FirstCommentDate,
        COUNT(DISTINCT C.UserId) AS DistinctCommenters,
        AVG(LENGTH(C.Text)) AS AverageCommentLength,
        -- Attempt to gauge comment sentiment (very basic string match).
        SUM(CASE WHEN LOWER(C.Text) LIKE '%thank%' OR LOWER(C.Text) LIKE '%helpful%' THEN 1 ELSE 0 END) AS PositiveCommentCount,
        SUM(CASE WHEN LOWER(C.Text) LIKE '%error%' OR LOWER(C.Text) LIKE '%bug%' OR LOWER(C.Text) LIKE '%wrong%' THEN 1 ELSE 0 END) AS NegativeCommentCount
    FROM Comments C
    GROUP BY C.PostId
),
PostHistoryAggregates AS (
    -- CTE 3: Summarize post history events, focusing on edits and closure.
    SELECT
        PH.PostId,
        COUNT(PH.Id) AS TotalHistoryEvents,
        SUM(CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6, 24) THEN 1 ELSE 0 END) AS EditCount, -- Title, Body, Tags edits, Suggested Edit Applied
        SUM(CASE WHEN PH.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS CloseVoteHistoryCount, -- Explicit close votes
        MAX(CASE WHEN PH.PostHistoryTypeId = 11 THEN TRUE ELSE FALSE END) AS WasReopened,
        MAX(CASE WHEN PH.PostHistoryTypeId = 10 THEN TRUE ELSE FALSE END) AS HasCloseHistory,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (12, 13) THEN TRUE ELSE FALSE END) AS HadDeletionEvents,
        MAX(PH.CreationDate) AS LastHistoryEventDate,
        MIN(PH.CreationDate) AS FirstHistoryEventDate,
        -- Extract the primary close reason ID as a string, handling potential non-numeric data gracefully.
        COALESCE(
            (SELECT PH_Inner.Comment FROM PostHistory PH_Inner WHERE PH_Inner.PostId = PH.PostId AND PH_Inner.PostHistoryTypeId = 10 ORDER BY PH_Inner.CreationDate DESC LIMIT 1),
            '0' -- Default if no close reason found or comment is NULL
        ) AS PrimaryCloseReasonId_Str
    FROM PostHistory PH
    GROUP BY PH.PostId
),
PostMetrics AS (
    -- CTE 4: Combine core post data with aggregated comments and history,
    -- applying various calculations, string expressions, and window functions.
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.OwnerUserId,
        COALESCE(P.OwnerDisplayName, 'Community') AS ActualOwnerDisplayName,
        P.LastActivityDate,
        P.Title,
        P.Tags,
        P.AnswerCount,
        P.CommentCount AS DirectCommentCount, -- From Posts table
        P.FavoriteCount,
        P.ClosedDate,
        P.CommunityOwnedDate,
        PCS.TotalComments AS AggregatedTotalComments, -- From PostCommentSummary
        PCS.TotalCommentScore,
        PCS.LastCommentDate,
        PCS.PositiveCommentCount,
        PCS.NegativeCommentCount,
        PHA.EditCount,
        PHA.CloseVoteHistoryCount,
        PHA.WasReopened,
        PHA.HasCloseHistory,
        PHA.PrimaryCloseReasonId_Str,
        -- Calculate a 'PostQualityScore' weighing different aspects.
        (P.Score * 0.6) + (P.ViewCount * 0.008) + (COALESCE(P.FavoriteCount, 0) * 0.3) + (COALESCE(P.AnswerCount, 0) * 0.15) AS PostQualityScore,
        -- Time since post creation to last activity in days, handling NULLs by defaulting to 0 for very new posts.
        EXTRACT(EPOCH FROM (COALESCE(P.LastActivityDate, P.CreationDate) - P.CreationDate)) / 86400.0 AS DaysSinceCreationActivity,
        -- Calculate 'EngagementRatio' (answers + comments per view + score) with NULLIF for division by zero.
        (COALESCE(P.AnswerCount, 0) + COALESCE(P.CommentCount, 0) + COALESCE(PCS.TotalComments,0)) / NULLIF(P.ViewCount + P.Score + 1.0, 0) AS EngagementRatio,
        -- Extract the primary tag (first one) and normalize it to lowercase for potential joins.
        LOWER(SUBSTRING(P.Tags FROM 2 FOR POSITION('><' IN P.Tags) - 2)) AS PrimaryTagFromTagsField,
        -- Use a correlated subquery to find number of unique users who have edited this post AND whose reputation is above 1000.
        (
            SELECT COUNT(DISTINCT PH_Inner.UserId)
            FROM PostHistory PH_Inner
            INNER JOIN Users U_Inner ON PH_Inner.UserId = U_Inner.Id
            WHERE PH_Inner.PostId = P.Id
              AND PH_Inner.PostHistoryTypeId IN (4,5,6) -- Edit operations
              AND U_Inner.Reputation > 1000
        ) AS HighReputationEditors,
        -- Window function: Rank posts by their quality score within each post type and creation year.
        DENSE_RANK() OVER (PARTITION BY P.PostTypeId, EXTRACT(YEAR FROM P.CreationDate) ORDER BY P.Score DESC, P.CreationDate DESC, P.FavoriteCount DESC) AS PostTypeYearlyRank,
        -- Window function: Calculate the cumulative sum of scores for posts by the same owner in chronological order.
        SUM(P.Score) OVER (PARTITION BY P.OwnerUserId ORDER BY P.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CumulativeOwnerScore,
        -- Use LEAD to find the time difference (in hours) to the next activity for a given post by the same owner.
        EXTRACT(EPOCH FROM (LEAD(P.LastActivityDate, 1, P.LastActivityDate) OVER (PARTITION BY P.OwnerUserId ORDER BY P.CreationDate) - P.LastActivityDate)) / 3600.0 AS TimeToNextOwnerActivityHours,
        -- Categorize posts into "Heat Tiers" based on recent view growth and score.
        CASE
            WHEN P.ViewCount > 5000 AND (P.LastActivityDate - P.CreationDate) < INTERVAL '14 days' AND P.Score > 100 THEN 'Very Hot'
            WHEN P.ViewCount > 1000 AND (P.LastActivityDate - P.CreationDate) < INTERVAL '30 days' AND P.Score > 50 THEN 'Hot'
            WHEN P.ViewCount > 500 AND (P.LastActivityDate - P.CreationDate) < INTERVAL '90 days' AND P.Score > 20 THEN 'Warm'
            ELSE 'Normal'
        END AS HeatTier,
        -- String expression: Truncate title and append ellipsis if long.
        SUBSTRING(P.Title, 1, 75) || CASE WHEN LENGTH(P.Title) > 75 THEN '...' ELSE '' END AS TruncatedTitle
    FROM Posts P
    LEFT JOIN PostCommentSummary PCS ON P.Id = PCS.PostId
    LEFT JOIN PostHistoryAggregates PHA ON P.Id = PHA.PostId
    WHERE P.PostTypeId IN (1, 2) -- Focus on Questions (1) and Answers (2).
      AND P.CreationDate >= '2021-01-01' -- Limit the dataset for recent posts.
      AND P.Score >= 0 -- Exclude negatively scored posts for this analysis.
),
LinkedPostsInfo AS (
    -- CTE 5: Gather information about linked and duplicate posts using self-joins on PostLinks.
    SELECT
        PL.PostId,
        COUNT(CASE WHEN PL.LinkTypeId = 1 THEN 1 ELSE NULL END) AS OutgoingLinkedPostsCount,
        COUNT(CASE WHEN PL.LinkTypeId = 3 THEN 1 ELSE NULL END) AS OutgoingDuplicatePostsCount,
        MAX(CASE WHEN PL.LinkTypeId = 3 THEN TRUE ELSE FALSE END) AS IsSourceOfDuplicate,
        -- Correlated subquery to find the title of the most recent *incoming* linked post.
        (
            SELECT P_Incoming.Title
            FROM Posts P_Incoming
            INNER JOIN PostLinks PL_Incoming ON P_Incoming.Id = PL_Incoming.PostId
            WHERE PL_Incoming.RelatedPostId = PL.PostId AND PL_Incoming.LinkTypeId = 1
            ORDER BY PL_Incoming.CreationDate DESC
            LIMIT 1
        ) AS MostRecentIncomingLinkedPostTitle
    FROM PostLinks PL
    GROUP BY PL.PostId
),
QuestionTagDetails AS (
    -- CTE 6: Parse tags for questions and provide details from the Tags table.
    SELECT
        PM.PostId,
        unnest(string_to_array(TRIM(BOTH '<>' FROM PM.Tags), '><')) AS ParsedTag,
        PM.PostCreationDate -- Include for potential filtering/ordering
    FROM PostMetrics PM
    WHERE PM.PostTypeId = 1 AND PM.Tags IS NOT NULL
),
HighlyEngagedPosts AS (
    -- Set Operator (UNION ALL): Combine results for highly engaged questions and answers with slightly different criteria.
    SELECT
        PM.PostId,
        PM.TruncatedTitle AS ItemTitle,
        PM.PostCreationDate,
        PM.PostScore AS ItemScore,
        PM.ViewCount AS ItemViews,
        PM.AggregatedTotalComments AS ItemTotalComments,
        PM.EngagementRatio AS ItemEngagementRatio,
        PM.HeatTier AS ItemHeatTier,
        'Question' AS ItemType
    FROM PostMetrics PM
    WHERE PM.PostTypeId = 1
      AND PM.PostQualityScore > 500 -- High quality questions
      AND PM.EngagementRatio > 0.02
      AND PM.HasCloseHistory = FALSE -- Not closed
      AND PM.OwnerUserId IS NOT NULL
    UNION ALL
    SELECT
        PM.PostId,
        PM.TruncatedTitle AS ItemTitle,
        PM.PostCreationDate,
        PM.PostScore AS ItemScore,
        PM.ViewCount AS ItemViews,
        PM.AggregatedTotalComments AS ItemTotalComments,
        PM.EngagementRatio AS ItemEngagementRatio,
        PM.HeatTier AS ItemHeatTier,
        'Answer' AS ItemType
    FROM PostMetrics PM
    WHERE PM.PostTypeId = 2
      AND PM.PostScore > 100 -- High score answers
      AND PM.HighReputationEditors >= 1 -- Edited by at least one high-rep user
      AND PM.AggregatedTotalComments > 10
      AND PM.DaysSinceCreationActivity < 365 -- Relatively recent activity
)
-- Main Query: Orchestrate all CTEs with complex joins, final filtering, and calculations.
SELECT
    HEP.PostId,
    HEP.ItemTitle,
    HEP.ItemType,
    PT.Name AS PostTypeName,
    HEP.PostCreationDate,
    HEP.ItemScore,
    HEP.ItemViews,
    UE.ReputationTier,
    UE.UserActivityScore,
    PM.PostQualityScore,
    PM.EngagementRatio,
    PM.HeatTier,
    PM.DaysSinceCreationActivity,
    PM.TimeToNextOwnerActivityHours,
    PM.AggregatedTotalComments,
    PM.TotalCommentScore,
    PM.PositiveCommentCount,
    PM.NegativeCommentCount,
    PM.EditCount,
    PM.HighReputationEditors,
    PM.HasCloseHistory,
    COALESCE(CR.Name, 'No Specific Close Reason') AS CloseReasonCategory, -- Use COALESCE for NULL handling of close reason.
    LPI.OutgoingLinkedPostsCount,
    LPI.OutgoingDuplicatePostsCount,
    LPI.IsSourceOfDuplicate,
    LPI.MostRecentIncomingLinkedPostTitle,
    PM.PrimaryTagFromTagsField AS MainTag,
    T.TagName AS MainTagDetailsName,
    T.Count AS MainTagUsageCount,
    -- Calculate a sophisticated 'OverallImpactScore' for final ranking.
    (PM.PostQualityScore * 0.4) + (UE.UserActivityScore * 0.2) + (PM.EngagementRatio * 200 * 0.15) + (PM.HighReputationEditors * 10 * 0.1) + (PM.TotalCommentScore * 0.05) AS OverallImpactScore,
    -- Apply NTILE window function to categorize posts into impact quintiles.
    NTILE(5) OVER (ORDER BY (PM.PostQualityScore * 0.4) + (UE.UserActivityScore * 0.2) + (PM.EngagementRatio * 200 * 0.15) + (PM.HighReputationEditors * 10 * 0.1) + (PM.TotalCommentScore * 0.05) DESC) AS OverallImpactQuintile,
    -- Complex conditional logic for final post status.
    CASE
        WHEN PM.HeatTier = 'Very Hot' AND PM.HighReputationEditors > 0 AND PM.PositiveCommentCount > PM.NegativeCommentCount THEN 'Trending & Vetted'
        WHEN PM.HeatTier = 'Hot' AND PM.AggregatedTotalComments > 20 AND PM.EngagementRatio > 0.01 THEN 'Active Community Discussion'
        WHEN PM.HasCloseHistory AND LPI.IsSourceOfDuplicate THEN 'Problematic (Source of Duplicate)'
        WHEN PM.WasReopened AND PM.EditCount > 5 THEN 'Resolved & Improved'
        WHEN PM.HasCloseHistory THEN 'Closed Post'
        ELSE 'Standard Activity'
    END AS PostStatusClassification,
    -- Generate a composite ID string.
    'Post#' || PM.PostId::TEXT || '-' || SUBSTRING(MD5(PM.Title), 1, 5) AS CompositePostIdentifier,
    -- Check for potential NULL in critical owner information
    CASE WHEN PM.OwnerUserId IS NULL THEN 'Community Owned' ELSE 'User Owned' END AS OwnershipType
FROM HighlyEngagedPosts HEP
INNER JOIN PostMetrics PM ON HEP.PostId = PM.PostId
INNER JOIN PostTypes PT ON PM.PostTypeId = PT.Id
LEFT JOIN UserEngagement UE ON PM.OwnerUserId = UE.UserId
LEFT JOIN LinkedPostsInfo LPI ON PM.PostId = LPI.PostId
LEFT JOIN Tags T ON PM.PrimaryTagFromTagsField = LOWER(T.TagName)
LEFT JOIN CloseReasonTypes CR ON
    PM.PrimaryCloseReasonId_Str ~ '^[0-9]+$' AND CR.Id = PM.PrimaryCloseReasonId_Str::smallint
WHERE
    PM.PostQualityScore > (SELECT AVG(PM_Avg.PostQualityScore) FROM PostMetrics PM_Avg WHERE PM_Avg.PostTypeId = PM.PostTypeId AND PM_Avg.OwnerUserId IS NOT NULL) -- Filter posts above average quality for their type (excluding community posts for average calculation)
    AND PM.PostTypeYearlyRank <= 1000 -- Limit to top posts by score rank within their type and year.
    AND (
        (PM.PostTypeId = 1 AND PM.AggregatedTotalComments > 10 AND PM.EngagementRatio > 0.01 AND PM.FavoriteCount > 5) -- Questions with high engagement.
        OR
        (PM.PostTypeId = 2 AND PM.PostScore > 50 AND PM.HighReputationEditors >= 1 AND PM.DaysSinceCreationActivity < 365) -- Answers with high score, edits, and not too old.
    )
    AND UE.ReputationTier IS NOT NULL -- Exclude posts where owner's reputation tier cannot be determined.
    AND PM.TimeSinceNextOwnerActivityHours IS NOT NULL -- Focus on posts with discernible activity patterns.
ORDER BY
    OverallImpactQuintile,
    OverallImpactScore DESC,
    HEP.PostCreationDate DESC
LIMIT 2000;