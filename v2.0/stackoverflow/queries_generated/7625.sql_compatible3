WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as AnswerCount,
        MAX(p.CreationDate) as LastPostDate,
        MAX(c.CreationDate) as LastCommentDate,
        MAX(b.Date) as LastBadgeDate,
        AVG(p.Score) as AvgPostScore,
        STRING_AGG(DISTINCT p.Tags, ', ') as AllTags,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN 
                CAST((EXTRACT(EPOCH FROM MAX(p.CreationDate)) - EXTRACT(EPOCH FROM MIN(p.CreationDate))) / 86400 AS INTEGER)
            ELSE 0 
        END as ActiveDays,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL 
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
TopPosts AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        p.PostTypeId,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            WHEN p.PostTypeId = 4 THEN 'TagWikiExcerpt'
            WHEN p.PostTypeId = 5 THEN 'TagWiki'
            ELSE 'Other'
        END as PostType,
        COALESCE(LENGTH(p.Body) - LENGTH(REPLACE(p.Body, '<', '')), 0) as HtmlTagCount,
        COALESCE(LENGTH(p.Body) - LENGTH(REPLACE(p.Body, ' ', '')), 0) as WordCount,
        CASE 
            WHEN EXISTS (
                SELECT 1 FROM PostLinks pl 
                WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3
            ) THEN 'Duplicate'
            WHEN EXISTS (
                SELECT 1 FROM PostHistory ph 
                WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10
            ) THEN 'Closed'
            ELSE 'Active'
        END as Status,
        DENSE_RANK() OVER (ORDER BY p.Score DESC) as ScoreRank,
        DENSE_RANK() OVER (ORDER BY p.ViewCount DESC) as ViewRank
    FROM Posts p
    WHERE p.CreationDate >= TIMESTAMP '2021-01-01' 
      AND (p.PostTypeId = 1 OR p.PostTypeId = 2)
),
UserEngagement AS (
    SELECT 
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.PostCount,
        ua.CommentCount,
        ua.BadgeCount,
        ua.QuestionCount,
        ua.AnswerCount,
        ua.ActiveDays,
        ua.PostRank,
        ua.ReputationRank,
        CASE 
            WHEN ua.PostCount > 0 THEN 
                (CAST(ua.CommentCount AS NUMERIC) / NULLIF(ua.PostCount, 0)) * 100
            ELSE 0 
        END as CommentToPostRatio,
        CASE 
            WHEN ua.Reputation > 0 THEN 
                (CAST(ua.BadgeCount AS NUMERIC) / NULLIF(ua.Reputation, 0)) * 1000
            ELSE 0 
        END as BadgeToReputationRatio,
        CASE 
            WHEN ua.QuestionCount > 0 THEN 
                (CAST(ua.AnswerCount AS NUMERIC) / NULLIF(ua.QuestionCount, 0)) * 100
            ELSE 0 
        END as AnswersPerQuestion,
        ROW_NUMBER() OVER (PARTITION BY CASE WHEN ua.AnswerCount > 0 THEN 1 ELSE 0 END ORDER BY ua.Reputation DESC) as HighAnswerUsers,
        COUNT(*) OVER () as TotalUsers
    FROM UserActivityStats ua
    WHERE ua.Reputation > 100
),
CombinedResults AS (
    SELECT 
        ue.UserId,
        ue.DisplayName,
        ue.Reputation,
        ue.PostCount,
        ue.CommentCount,
        ue.BadgeCount,
        ue.QuestionCount,
        ue.AnswerCount,
        ue.ActiveDays,
        ue.PostRank,
        ue.ReputationRank,
        ue.CommentToPostRatio,
        ue.BadgeToReputationRatio,
        ue.AnswersPerQuestion,
        tp.PostId,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        tp.AnswerCount as PostAnswerCount,
        tp.CommentCount as PostCommentCount,
        tp.CreationDate as PostCreationDate,
        tp.Tags,
        tp.PostType,
        tp.HtmlTagCount,
        tp.WordCount,
        tp.Status,
        tp.ScoreRank,
        tp.ViewRank,
        CASE 
            WHEN ue.AnswersPerQuestion > 1.5 AND ue.PostCount > 10 THEN 'Highly Engaged'
            WHEN ue.Reputation > 10000 AND ue.BadgeCount > 20 THEN 'Veteran'
            WHEN ue.Reputation < 100 AND ue.PostCount < 5 THEN 'Newbie'
            ELSE 'Moderate'
        END as UserCategory,
        CASE 
            WHEN tp.Score > 100 AND tp.ViewCount > 1000 THEN 'Popular'
            WHEN tp.Score > 50 AND tp.ViewCount > 500 THEN 'Well Viewed'
            WHEN tp.Score > 10 THEN 'Standard'
            ELSE 'Low'
        END as PostPopularity,
        CASE 
            WHEN tp.ScoreRank <= 50 AND tp.ViewRank <= 50 THEN 'Top Performing'
            WHEN tp.ScoreRank <= 100 OR tp.ViewRank <= 100 THEN 'Good'
            ELSE 'Average'
        END as PostPerformance,
        CASE
            WHEN tp.Tags IS NOT NULL AND tp.Tags <> '' THEN
                STRING_AGG(SUBSTRING(tp.Tags FROM 2 FOR CHAR_LENGTH(tp.Tags)-2), ' ' ORDER BY tp.Score DESC)
            ELSE NULL
        END as TagList,
        CASE 
            WHEN tp.PostTypeId = 1 AND tp.ParentId IS NULL THEN 'Original Question'
            WHEN tp.PostTypeId = 1 AND tp.ParentId IS NOT NULL THEN 'Follow-up Question'
            WHEN tp.PostTypeId = 2 AND EXISTS (
                SELECT 1 FROM Posts p2 
                WHERE p2.Id = tp.ParentId AND p2.PostTypeId = 1
            ) THEN 'Answer to Question'
            ELSE 'Other'
        END as PostClassification,
        CAST((EXTRACT(EPOCH FROM TIMESTAMP '2024-10-01 12:34:56') - EXTRACT(EPOCH FROM tp.CreationDate)) / 86400 AS INTEGER) as DaysSincePost,
        CASE 
            WHEN (SELECT COUNT(*) FROM VoteTypes vt WHERE vt.Id IN (2, 3)) > 0
            THEN (SELECT COUNT(*) FROM Votes v WHERE v.PostId = tp.PostId AND v.VoteTypeId IN (2, 3))
            ELSE 0
        END as VoteCount,
        COALESCE(
            (SELECT MAX(v.CreationDate) FROM Votes v WHERE v.PostId = tp.PostId),
            tp.CreationDate
        ) as LastVoteDate,
        CASE 
            WHEN tp.ViewCount > 500 THEN 'Very High'
            WHEN tp.ViewCount > 250 THEN 'High'
            WHEN tp.ViewCount > 100 THEN 'Medium'
            ELSE 'Low'
        END as ViewCategory,
        tp.PostTypeId,
        tp.ParentId
    FROM UserEngagement ue
    INNER JOIN TopPosts tp ON ue.UserId = tp.OwnerUserId
    WHERE tp.CreationDate >= TIMESTAMP '2021-01-01' 
      AND tp.Score IS NOT NULL
      AND tp.Score >= 0
    GROUP BY 
        ue.UserId, ue.DisplayName, ue.Reputation, ue.PostCount, ue.CommentCount, 
        ue.BadgeCount, ue.QuestionCount, ue.AnswerCount, ue.ActiveDays, ue.PostRank, 
        ue.ReputationRank, ue.CommentToPostRatio, ue.BadgeToReputationRatio, 
        ue.AnswersPerQuestion, tp.PostId, tp.Title, tp.Score, tp.ViewCount, 
        tp.AnswerCount, tp.CommentCount, tp.CreationDate, tp.Tags, tp.PostType, 
        tp.HtmlTagCount, tp.WordCount, tp.Status, tp.ScoreRank, tp.ViewRank, tp.PostTypeId, tp.ParentId
)
SELECT 
    cr.UserId,
    cr.DisplayName,
    cr.Reputation,
    cr.PostCount,
    cr.CommentCount,
    cr.BadgeCount,
    cr.QuestionCount,
    cr.AnswerCount,
    cr.ActiveDays,
    cr.PostRank,
    cr.ReputationRank,
    cr.CommentToPostRatio,
    cr.BadgeToReputationRatio,
    cr.AnswersPerQuestion,
    cr.PostId,
    cr.Title,
    cr.Score,
    cr.ViewCount,
    cr.PostAnswerCount,
    cr.PostCommentCount,
    cr.PostCreationDate,
    cr.Tags,
    cr.PostType,
    cr.HtmlTagCount,
    cr.WordCount,
    cr.Status,
    cr.ScoreRank,
    cr.ViewRank,
    cr.UserCategory,
    cr.PostPopularity,
    cr.PostPerformance,
    cr.TagList,
    cr.PostClassification,
    cr.DaysSincePost,
    cr.VoteCount,
    cr.LastVoteDate,
    cr.ViewCategory,
    ROW_NUMBER() OVER (ORDER BY cr.Score DESC, cr.ViewCount DESC) as FinalRank,
    COUNT(*) OVER () as TotalResults,
    AVG(cr.Score) OVER (PARTITION BY cr.UserCategory) as AvgScoreByCategory,
    PERCENT_RANK() OVER (ORDER BY cr.Score DESC) as ScorePercentile,
    NTILE(4) OVER (ORDER BY cr.Reputation) as ReputationQuartile,
    CASE 
        WHEN COUNT(*) OVER (PARTITION BY cr.UserId) > 1 THEN 
            STRING_AGG(CONCAT(cr.Title, ' (', cr.Score, ')'), '; ' ORDER BY cr.Score DESC)
        ELSE NULL
    END as TopPostsByUser,
    CASE 
        WHEN cr.Reputation > 10000 THEN 
            CONCAT('Expert: ', 
                CASE WHEN cr.AnswerCount > 10 THEN 'High Answerer' ELSE 'Regular' END,
                ', ', 
                CASE WHEN cr.BadgeCount > 20 THEN 'Veteran' ELSE 'Intermediate' END,
                ' User')
        WHEN cr.Reputation > 1000 THEN 
            'Good User'
        WHEN cr.Reputation > 100 THEN 
            'Average User'
        ELSE 
            'Beginner'
    END as ExpertiseLevel,
    CASE 
        WHEN cr.PostPerformance = 'Top Performing' AND cr.Score > 100 THEN 
            'Top Performer'
        WHEN cr.PostPerformance = 'Top Performing' OR cr.Score > 50 THEN 
            'Strong Performer'
        WHEN cr.PostType = 'Question' AND cr.ViewCount > 200 THEN 
            'Engagement Focused'
        WHEN cr.PostType = 'Answer' AND cr.Score > 25 THEN 
            'Helpful Answerer'
        ELSE 
            'Regular Contributor'
    END as ContributionLevel,
    CASE 
        WHEN cr.ViewCategory = 'Very High' AND cr.Score > 50 THEN 
            'Trending Content'
        WHEN cr.ViewCategory IN ('High', 'Medium', 'Low') THEN 
            'Standard Content'
        ELSE 
            'Unknown Content'
    END as ContentClassification,
    ABS(cr.Score - AVG(cr.Score) OVER()) as ScoreDeviation,
    CASE WHEN cr.Reputation >= 10000 THEN 'Elite' ELSE 'Non-Elite' END as EliteStatus,
    CASE 
        WHEN cr.PostCount >= 500 AND cr.Reputation >= 50000 THEN 
            'Community Leader'
        WHEN cr.PostCount >= 100 AND cr.Reputation >= 10000 THEN 
            'Knowledge Contributor'
        WHEN cr.PostCount >= 10 AND cr.Reputation >= 1000 THEN 
            'Regular Contributor'
        ELSE 
            'New Member'
    END as CommunityRole
FROM CombinedResults cr
ORDER BY cr.Score DESC, cr.ViewCount DESC
OFFSET 0 ROWS FETCH NEXT 1000 ROWS ONLY;