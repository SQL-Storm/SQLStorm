-- {"query": "1740.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3157} 
WITH UserBadgeStats AS (
    -- CTE 1: Summarize badge achievements per user, including specific badge checks
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        MAX(CASE WHEN LOWER(b.Name) LIKE '%reviewer%' OR LOWER(b.Name) LIKE '%editor%' THEN 1 ELSE 0 END) AS HasEditorBadges,
        MIN(b.Date) AS FirstBadgeDate,
        MAX(b.Date) AS LastBadgeDate
    FROM Badges AS b
    GROUP BY b.UserId
),
PostEditActivity AS (
    -- CTE 2: Calculate post editing activity, including time between significant edits
    SELECT
        ph.PostId,
        ph.UserId AS EditorUserId,
        ph.CreationDate AS EditDate,
        ph.PostHistoryTypeId,
        LAG(ph.CreationDate, 1, ph.CreationDate) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate) AS PreviousEditDate,
        -- Calculate time difference in minutes between consecutive significant edits (Body or Tags)
        EXTRACT(EPOCH FROM (ph.CreationDate - LAG(ph.CreationDate, 1, ph.CreationDate) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate))) / 60 AS TimeSincePreviousEditMinutes,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn_latest_edit
    FROM PostHistory AS ph
    WHERE ph.PostHistoryTypeId IN (5, 6, 8, 9) -- Body Edit, Tags Edit, Rollback Body, Rollback Tags
),
PostAggregatedStats AS (
    -- CTE 3: Aggregate stats for questions (PostTypeId = 1) and their answers,
    -- including complexity metrics and recent activity for owner
    SELECT
        p.Id AS PostId,
        p.OwnerUserId,
        p.Title,
        p.Tags,
        p.CreationDate AS PostCreationDate,
        p.LastActivityDate,
        p.Score AS PostScore,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.AcceptedAnswerId,
        -- Calculate a normalized "engagement score"
        COALESCE(p.Score, 0) * 1.0
        + COALESCE(p.ViewCount, 0) / 100.0
        + COALESCE(p.AnswerCount, 0) * 5.0
        + COALESCE(p.CommentCount, 0) * 2.0
        + COALESCE(p.FavoriteCount, 0) * 10.0 AS EngagementScore,
        -- Calculate string complexity of body (approximated by length and word count)
        LENGTH(p.Body) AS BodyLength,
        LENGTH(p.Body) - LENGTH(REPLACE(p.Body, ' ', '')) + 1 AS BodyWordCount,
        -- Use NULLIF for division to prevent errors
        COALESCE(p.Score * 1.0 / NULLIF(p.ViewCount, 0), 0) AS ScorePerViewRatio,
        COALESCE(p.AnswerCount * 1.0 / NULLIF(p.ViewCount, 0), 0) AS AnswersPerViewRatio,
        -- Check if it's a closed question related to duplicates
        ph.PostHistoryTypeId AS CloseReasonTypeId,
        ph.CreationDate AS ClosedDate,
        ph.Comment AS CloseReasonComment,
        -- Correlated subquery: Get the most recent comment text for this post, if any
        (
            SELECT c.Text
            FROM Comments AS c
            WHERE c.PostId = p.Id
            ORDER BY c.CreationDate DESC
            LIMIT 1
        ) AS MostRecentCommentText
    FROM Posts AS p
    LEFT JOIN PostHistory AS ph ON p.Id = ph.PostId
        AND ph.PostHistoryTypeId = 10 -- Post Closed
        AND (ph.Comment = '101' OR ph.Comment = '1') -- Duplicate close reason (old/new)
    WHERE p.PostTypeId = 1 -- Only questions
),
UserOverallStats AS (
    -- CTE 4: Combine user details with their aggregated post and comment activity
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        u.UpVotes,
        u.DownVotes,
        u.Views AS UserProfileViews,
        u.Location,
        -- Aggregate stats from posts
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        SUM(p.Score) AS TotalPostScore,
        SUM(p.ViewCount) AS TotalPostViews,
        -- Aggregate stats from comments
        COUNT(DISTINCT c.Id) AS TotalComments,
        SUM(c.Score) AS TotalCommentScore,
        -- Calculate user's overall activity ratio (ignoring self-votes from comments for simplicity)
        COALESCE(u.UpVotes * 1.0 / NULLIF(u.UpVotes + u.DownVotes, 0), 0) AS UpVoteRatio
    FROM Users AS u
    LEFT JOIN Posts AS p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments AS c ON u.Id = c.UserId
    GROUP BY
        u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate,
        u.UpVotes, u.DownVotes, u.Views, u.Location
),
ActiveQuestionsByEditors AS (
    -- CTE 5: Questions with significant editing activity by users with "editor" badges
    SELECT
        pas.PostId,
        pas.OwnerUserId,
        pas.Title,
        pas.Tags,
        pas.PostCreationDate,
        pas.LastActivityDate,
        COUNT(DISTINCT pea.EditorUserId) AS NumUniqueEditors,
        MAX(pea.EditDate) AS LastEditDate,
        AVG(pea.TimeSincePreviousEditMinutes) FILTER (WHERE pea.TimeSincePreviousEditMinutes IS NOT NULL) AS AvgTimeBetweenEdits,
        -- Correlated subquery: Get average reputation of editors for this post
        (
            SELECT AVG(u_edit.Reputation)
            FROM PostEditActivity AS pea_inner
            JOIN Users AS u_edit ON pea_inner.EditorUserId = u_edit.Id
            WHERE pea_inner.PostId = pas.PostId AND pea_inner.PostHistoryTypeId IN (5,6) -- Only body/tag edits
        ) AS AvgEditorReputation
    FROM PostAggregatedStats AS pas
    JOIN PostEditActivity AS pea ON pas.PostId = pea.PostId
    LEFT JOIN UserBadgeStats AS ubs ON pea.EditorUserId = ubs.UserId
    WHERE
        pea.PostHistoryTypeId IN (5, 6) -- Only consider body or tag edits
        AND ubs.HasEditorBadges = 1 -- Editor must have an 'editor' badge
    GROUP BY pas.PostId, pas.OwnerUserId, pas.Title, pas.Tags, pas.PostCreationDate, pas.LastActivityDate
    HAVING COUNT(DISTINCT pea.EditorUserId) >= 2 -- At least two distinct editors
),
CombinedHighValuePosts AS (
    -- CTE 6: Combine questions based on high engagement OR being actively edited by experienced users
    SELECT
        qd.PostId,
        qd.OwnerUserId,
        qd.Title,
        qd.PostCreationDate,
        qd.EngagementScore,
        qd.ScorePerViewRatio,
        'HighEngagement' AS PostValueType,
        qd.MostRecentCommentText
    FROM PostAggregatedStats AS qd
    WHERE
        qd.EngagementScore > 100 -- Arbitrary high engagement threshold
        AND qd.PostScore > 5
        AND qd.AnswerCount >= 1
        AND qd.ClosedDate IS NULL -- Exclude closed questions
        AND qd.BodyWordCount > 50 -- Ensure substantive questions
        AND qd.PostCreationDate >= '2020-01-01' -- Recent questions
    UNION ALL
    SELECT
        aqbe.PostId,
        aqbe.OwnerUserId,
        aqbe.Title,
        aqbe.PostCreationDate,
        (SELECT EngagementScore FROM PostAggregatedStats WHERE PostId = aqbe.PostId) AS EngagementScore,
        (SELECT ScorePerViewRatio FROM PostAggregatedStats WHERE PostId = aqbe.PostId) AS ScorePerViewRatio,
        'ActivelyEdited' AS PostValueType,
        (SELECT MostRecentCommentText FROM PostAggregatedStats WHERE PostId = aqbe.PostId) AS MostRecentCommentText
    FROM ActiveQuestionsByEditors AS aqbe
    WHERE aqbe.NumUniqueEditors >= 3 -- Even stricter filter for edited questions
    AND aqbe.AvgEditorReputation > 5000 -- Ensure editors are highly reputed
)
-- Main Query: Find highly influential users and their top posts
SELECT
    u.UserId,
    u.DisplayName,
    u.Reputation,
    u.TotalPosts,
    u.TotalQuestions,
    u.TotalAnswers,
    u.TotalPostScore,
    u.TotalComments,
    ubs.GoldBadges,
    ubs.SilverBadges,
    ubs.BronzeBadges,
    chvp.PostId AS HighValuePostId,
    chvp.Title AS HighValuePostTitle,
    chvp.PostValueType,
    chvp.EngagementScore AS PostEngagementScore,
    chvp.ScorePerViewRatio AS PostScorePerViewRatio,
    chvp.MostRecentCommentText,
    -- Window function: Rank users by their total post score within their location, if available
    RANK() OVER (PARTITION BY u.Location ORDER BY u.TotalPostScore DESC, u.Reputation DESC) AS RankInLocationByPostScore,
    -- Window function: Calculate the NTILE (percentile bucket) for users based on their UpVoteRatio globally
    NTILE(10) OVER (ORDER BY u.UpVoteRatio DESC, u.Reputation DESC) AS UpVoteRatioDecile,
    -- Another correlated subquery: Average score of accepted answers provided by this user
    (
        SELECT AVG(ans.Score)
        FROM Posts AS ans
        WHERE ans.OwnerUserId = u.UserId
          AND ans.PostTypeId = 2 -- Only answers
          AND ans.Id IN (SELECT q.AcceptedAnswerId FROM Posts AS q WHERE q.AcceptedAnswerId IS NOT NULL)
          AND ans.CreationDate BETWEEN u.CreationDate AND u.LastAccessDate
    ) AS AvgAcceptedAnswerScore,
    -- Complicated calculation: Weighted influence score
    (
        u.Reputation * 0.1
        + u.TotalPostScore * 0.5
        + COALESCE(ubs.GoldBadges, 0) * 100
        + COALESCE(ubs.SilverBadges, 0) * 50
        + COALESCE(u.UpVoteRatio, 0) * 1000
        + (SELECT COUNT(DISTINCT l.RelatedPostId) FROM PostLinks AS l WHERE l.PostId = chvp.PostId AND l.LinkTypeId = 1) * 20 -- Linked posts count
    ) AS WeightedInfluenceScore,
    -- String expression: Extract the first tag from the post (assuming format <tag1><tag2>...)
    TRIM(SUBSTRING(chvp.Tags, 2, POSITION('><' IN chvp.Tags) - 2)) AS FirstTag,
    -- NULL logic and complex predicate in WHERE clause
    u.Location,
    u.LastAccessDate,
    u.UserProfileViews
FROM UserOverallStats AS u
LEFT JOIN UserBadgeStats AS ubs ON u.UserId = ubs.UserId
LEFT JOIN CombinedHighValuePosts AS chvp ON u.UserId = chvp.OwnerUserId
WHERE
    u.Reputation > 5000 -- Significant reputation
    AND u.TotalQuestions >= 5 -- Has asked at least 5 questions
    AND u.TotalAnswers >= 10 -- Has provided at least 10 answers
    AND u.UpVoteRatio > 0.6 -- High positive contribution ratio
    AND u.LastAccessDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months' -- Active in the last 6 months
    AND (
        chvp.PostId IS NOT NULL -- User has at least one high-value post
        OR (ubs.GoldBadges >= 1 AND u.UserProfileViews > 1000) -- Or has a gold badge and many profile views
    )
    -- More complex predicate: Users who contributed to tags related to 'database' or 'performance'
    AND (
        EXISTS (
            SELECT 1
            FROM Tags AS t
            WHERE t.TagName IN ('sql', 'database', 'performance', 'indexing')
              AND chvp.Tags LIKE '%' || t.TagName || '%'
        ) OR LOWER(u.Location) LIKE '%london%'
    )
ORDER BY
    WeightedInfluenceScore DESC,
    u.LastAccessDate DESC,
    chvp.PostId
LIMIT 500;