WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        MAX(p.CreationDate) AS LastPostDate,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY MAX(p.CreationDate) DESC) AS RecentPostRank,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - u.CreationDate)) / 86400 AS INTEGER) AS AccountAgeDays
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.CreationDate
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400 AS INTEGER) AS DaysSinceCreation,
        CASE 
            WHEN p.Score > 100 THEN 'High'
            WHEN p.Score > 10 THEN 'Medium'
            ELSE 'Low'
        END AS ScoreCategory,
        CASE 
            WHEN p.AnswerCount > 5 THEN 'ManyAnswers'
            WHEN p.AnswerCount > 1 THEN 'SomeAnswers'
            ELSE 'FewAnswers'
        END AS AnswerCategory,
        CASE 
            WHEN p.ViewCount > 1000 THEN 'Popular'
            WHEN p.ViewCount > 100 THEN 'Moderate'
            ELSE 'LowView'
        END AS Popularity,
        COALESCE(p.Tags, '') AS TagsList,
        LENGTH(COALESCE(p.Tags, '')) AS TagLength,
        CASE 
            WHEN p.Tags IS NOT NULL AND p.Tags != '' THEN 
                -- attempt to remove surrounding angle brackets and split is DB-specific; provide concatenated inner string
                TRIM(BOTH '<>' FROM p.Tags)
            ELSE NULL 
        END AS ExtractedTags
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.AnswerCount, 
             p.CommentCount, p.FavoriteCount, p.CreationDate, 
             p.OwnerUserId, p.PostTypeId, p.Tags
),
UserPostStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(p.Id) AS TotalPosts,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgScore,
        MAX(p.Score) AS MaxScore,
        MIN(p.Score) AS MinScore,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionPosts,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerPosts,
        STRING_AGG(CAST(p.Id AS TEXT), ',') AS PostIds,
        SUM(CASE WHEN p.Score > 0 THEN 1 ELSE 0 END) AS PositiveScorePosts,
        SUM(CASE WHEN p.Score < 0 THEN 1 ELSE 0 END) AS NegativeScorePosts
    FROM Users u
    JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE p.CreationDate >= DATE '2018-01-01'
    GROUP BY u.Id, u.DisplayName
),
ComplexQuery AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.Views,
        uas.TotalPosts,
        uas.QuestionCount,
        uas.AnswerCount,
        uas.CommentCount,
        uas.BadgeCount,
        uas.LastPostDate,
        uas.RecentPostRank,
        uas.AccountAgeDays,
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount AS PostAnswerCount,
        pa.CommentCount AS PostCommentCount,
        pa.FavoriteCount,
        pa.CreationDate AS PostCreationDate,
        pa.PostTypeId,
        pa.DaysSinceCreation,
        pa.ScoreCategory,
        pa.AnswerCategory,
        pa.Popularity,
        pa.TagsList,
        pa.TagLength,
        pa.ExtractedTags,
        ups.TotalPosts AS UserTotalPosts,
        ups.TotalScore,
        ups.AvgScore,
        ups.MaxScore,
        ups.QuestionPosts,
        ups.AnswerPosts,
        ups.PostIds,
        ups.PositiveScorePosts,
        ups.NegativeScorePosts,
        RANK() OVER (ORDER BY (pa.Score * pa.ViewCount) DESC) AS PostPerformanceRank,
        DENSE_RANK() OVER (PARTITION BY pa.PostTypeId ORDER BY pa.Score DESC) AS TypeSpecificRank,
        NTILE(4) OVER (ORDER BY pa.ViewCount) AS ViewCountQuartile,
        CASE 
            WHEN pa.Score > (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.PostTypeId = pa.PostTypeId) 
            THEN 'AboveAverage'
            ELSE 'BelowAverage'
        END AS ScorePerformance,
        CASE 
            WHEN pa.Score > (SELECT MAX(p3.Score) FROM Posts p3 WHERE p3.PostTypeId = pa.PostTypeId) * 0.9 
            THEN 'Top90Percent'
            ELSE 'NotTop90Percent'
        END AS HighScorerCategory,
        COALESCE (
            (
             SELECT p2.Title 
             FROM Posts p2 
             WHERE p2.PostTypeId = 1 
               AND EXISTS (SELECT 1 FROM Comments c2 WHERE c2.PostId = p2.Id AND c2.UserId = uas.UserId)
             ORDER BY p2.CreationDate DESC
             LIMIT 1
            ), 
            'NoRecentComments'
        ) AS UserRecentQuestion,
        CAST(LENGTH(COALESCE(pa.TagsList, '')) AS DOUBLE PRECISION) / NULLIF(CAST(LENGTH(COALESCE(pa.TagsList, '')) + 1 AS DOUBLE PRECISION), 0) AS TagDensity
    FROM UserActivityStats uas
    JOIN PostAnalysis pa ON uas.UserId = pa.OwnerUserId
    JOIN UserPostStats ups ON uas.UserId = ups.UserId
    WHERE uas.AccountAgeDays > 365
      AND pa.DaysSinceCreation < 365
      AND pa.Score >= -10
)
SELECT 
    cq.UserId,
    cq.DisplayName,
    cq.Reputation,
    cq.Views,
    cq.TotalPosts,
    cq.QuestionCount,
    cq.AnswerCount,
    cq.CommentCount,
    cq.BadgeCount,
    cq.LastPostDate,
    cq.RecentPostRank,
    cq.AccountAgeDays,
    cq.PostId,
    cq.Title,
    cq.Score,
    cq.ViewCount,
    cq.PostAnswerCount,
    cq.PostCommentCount,
    cq.FavoriteCount,
    cq.PostCreationDate,
    cq.PostTypeId,
    cq.DaysSinceCreation,
    cq.ScoreCategory,
    cq.AnswerCategory,
    cq.Popularity,
    cq.TagsList,
    cq.TagLength,
    cq.ExtractedTags,
    cq.UserTotalPosts,
    cq.TotalScore,
    cq.AvgScore,
    cq.MaxScore,
    cq.QuestionPosts,
    cq.AnswerPosts,
    cq.PostIds,
    cq.PositiveScorePosts,
    cq.NegativeScorePosts,
    cq.PostPerformanceRank,
    cq.TypeSpecificRank,
    cq.ViewCountQuartile,
    cq.ScorePerformance,
    cq.HighScorerCategory,
    cq.UserRecentQuestion,
    cq.TagDensity,
    CASE 
        WHEN ABS(cq.AvgScore) > 5 THEN 'HighScoreVariance'
        WHEN ABS(cq.AvgScore) > 2 THEN 'MediumScoreVariance'
        ELSE 'LowScoreVariance'
    END AS ScoreVarianceCategory,
    CASE 
        WHEN cq.AccountAgeDays > 730 AND cq.TotalPosts > 100 THEN 'VeteranActive'
        WHEN cq.AccountAgeDays > 365 AND cq.TotalPosts > 50 THEN 'ActiveRegular'
        WHEN cq.AccountAgeDays > 180 AND cq.TotalPosts > 10 THEN 'RegularUser'
        ELSE 'NewUser'
    END AS UserClassification,
    ROW_NUMBER() OVER (ORDER BY cq.Views DESC, cq.Score DESC) AS OverallRanking,
    PERCENT_RANK() OVER (ORDER BY cq.Score) AS ScorePercentile,
    CUME_DIST() OVER (ORDER BY cq.ViewCount) AS ViewCountCumulativeDistribution,
    LAG(cq.DisplayName) OVER (ORDER BY cq.Reputation DESC) AS PreviousReputableUser,
    LEAD(cq.DisplayName) OVER (ORDER BY cq.Reputation DESC) AS NextReputableUser
FROM ComplexQuery cq
WHERE (cq.Score > 0 OR cq.CommentCount > 0)
  AND (cq.PostTypeId = 1 OR cq.PostTypeId = 2)
  AND (
       (cq.PostTypeId = 1 AND cq.PostAnswerCount > 0)
       OR (cq.PostTypeId = 2 AND cq.PostAnswerCount IS NULL)
      )
ORDER BY cq.Score DESC, cq.ViewCount DESC, cq.Reputation DESC;