WITH UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.ViewCount,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS Answers,
        COUNT(DISTINCT c.Id) AS Comments,
        COUNT(DISTINCT b.Id) AS Badges,
        MAX(p.CreationDate) AS LastPostDate,
        AVG(p.Score) AS AvgPostScore,
        STRING_AGG(DISTINCT p.Tags, ', ') AS AllTags,
        RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS PostRank,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.ViewCount DESC) AS RepRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= TIMESTAMP '2010-01-01'
      AND u.CreationDate < TIMESTAMP '2023-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.ViewCount
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.ParentId,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            ELSE 'Other'
        END AS PostTypeDesc,
        COALESCE(p.OwnerDisplayName, 'Anonymous') AS Author,
        CAST(COALESCE(p.ClosedDate, p.LastEditDate, p.LastActivityDate) AS timestamp) - CAST(p.CreationDate AS timestamp) AS AgeInterval,
        CASE 
            WHEN p.Score > 10 AND p.ViewCount > 100 THEN 'High Engagement'
            WHEN p.Score > 5 AND p.ViewCount > 50 THEN 'Medium Engagement'
            WHEN p.Score > 0 AND p.ViewCount > 10 THEN 'Low Engagement'
            ELSE 'Minimal Engagement'
        END AS EngagementLevel,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PrevScore,
        LEAD(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS NextScore,
        PERCENT_RANK() OVER (ORDER BY p.ViewCount) AS ViewPercentile,
        NTILE(4) OVER (ORDER BY p.Score) AS ScoreQuartile
    FROM Posts p
    WHERE p.CreationDate >= TIMESTAMP '2018-01-01'
      AND p.CreationDate < TIMESTAMP '2023-01-01'
),
AnswerQuality AS (
    SELECT 
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.Score AS AnswerScore,
        a.CreationDate AS AnswerDate,
        q.Title AS QuestionTitle,
        q.Score AS QuestionScore,
        q.ViewCount AS QuestionViews,
        q.Tags AS QuestionTags,
        CASE 
            WHEN a.Score > 10 THEN 'Excellent'
            WHEN a.Score > 5 THEN 'Good'
            WHEN a.Score > 0 THEN 'Fair'
            ELSE 'Poor'
        END AS QualityLevel,
        CASE 
            WHEN a.Score >= (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.PostTypeId = 2) THEN 'Above Average'
            ELSE 'Below Average'
        END AS AvgScoreComparison,
        EXISTS (SELECT 1 FROM Votes v WHERE v.PostId = a.Id AND v.VoteTypeId = 1) AS HasAcceptedAnswer,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = a.Id) AS CommentCount
    FROM Posts a
    INNER JOIN Posts q ON a.ParentId = q.Id
    WHERE a.PostTypeId = 2
),
UserPostMetrics AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS TotalQuestions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS TotalAnswers,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS TotalAnswerScore,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS AvgAnswerScore,
        COUNT(DISTINCT p.Id) - COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) - COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS OtherPosts,
        AVG(p.Score) AS OverallAvgScore,
        MAX(p.CreationDate) AS LastActivity,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Score > 0 THEN p.Id END) AS PositiveQuestions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 AND p.Score > 0 THEN p.Id END) AS PositiveAnswers
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.CreationDate >= TIMESTAMP '2015-01-01'
      AND u.CreationDate < TIMESTAMP '2023-01-01'
    GROUP BY u.Id, u.DisplayName
),
ComplexAnalysis AS (
    SELECT 
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.ViewCount,
        ua.TotalPosts,
        ua.Questions,
        ua.Answers,
        ua.Comments,
        ua.Badges,
        ua.LastPostDate,
        ua.AvgPostScore,
        CASE 
            WHEN ua.TotalPosts > 0 THEN 
                ROUND((CAST(ua.Questions AS numeric) / CAST(ua.TotalPosts AS numeric)) * 100, 2)
            ELSE 0 
        END AS QuestionPercentage,
        CASE 
            WHEN ua.Reputation > 1000 AND ua.ViewCount > 1000 THEN 'Elite User'
            WHEN ua.Reputation > 500 AND ua.ViewCount > 500 THEN 'Active Contributor'
            WHEN ua.Reputation > 100 THEN 'Regular User'
            ELSE 'New User'
        END AS UserTier,
        ROW_NUMBER() OVER (ORDER BY ua.Reputation DESC, ua.ViewCount DESC) AS OverallRank,
        RANK() OVER (ORDER BY ua.Reputation DESC) AS RepRank,
        DENSE_RANK() OVER (ORDER BY ua.ViewCount DESC) AS ViewRank,
        LAG(ua.Reputation, 1) OVER (ORDER BY ua.Reputation DESC) AS PrevReputation,
        LEAD(ua.Reputation, 1) OVER (ORDER BY ua.Reputation DESC) AS NextReputation,
        COUNT(*) OVER () AS TotalUsers,
        AVG(ua.Reputation) OVER () AS AvgReputation,
        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY ua.Reputation) OVER () AS MedianReputation,
        STDDEV_POP(ua.Reputation) OVER () AS ReputationStdDev,
        NTH_VALUE(ua.DisplayName, 1) OVER (ORDER BY ua.Reputation DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS HighestRepUser,
        NTH_VALUE(ua.DisplayName, 2) OVER (ORDER BY ua.Reputation DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS SecondHighestRepUser
    FROM UserActivityStats ua
    WHERE ua.TotalPosts > 0
)
SELECT 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.ViewCount,
    ca.TotalPosts,
    ca.Questions,
    ca.Answers,
    ca.Comments,
    ca.Badges,
    ca.LastPostDate,
    ca.AvgPostScore,
    ca.QuestionPercentage,
    ca.UserTier,
    ca.OverallRank,
    ca.RepRank,
    ca.ViewRank,
    ca.PrevReputation,
    ca.NextReputation,
    ca.TotalUsers,
    ca.AvgReputation,
    ca.MedianReputation,
    ca.ReputationStdDev,
    ca.HighestRepUser,
    ca.SecondHighestRepUser,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.CreationDate >= TIMESTAMP '2022-01-01') AS RecentPosts2022,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.CreationDate >= TIMESTAMP '2021-01-01') AS RecentPosts2021,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.PostTypeId = 1 AND p.CreationDate >= TIMESTAMP '2019-01-01') AS RecentQuestions2019,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.PostTypeId = 2 AND p.CreationDate >= TIMESTAMP '2019-01-01') AS RecentAnswers2019,
    (
        SELECT STRING_AGG(t.TagName, ', ') 
        FROM Tags t 
        WHERE t.Id IN (
            SELECT DISTINCT CAST(tag_id AS integer)
            FROM (
                SELECT regexp_split_to_table(
                    regexp_replace(p.Tags, '^<|>$', '', 'g')
                , '><') AS tag_id
                FROM Posts p
                WHERE p.OwnerUserId = ca.UserId
                  AND p.Tags IS NOT NULL
                  AND p.Tags <> ''
            ) s
        )
    ) AS UserTags,
    CASE 
        WHEN ca.Reputation > (SELECT AVG(u2.Reputation) FROM Users u2 WHERE u2.CreationDate >= TIMESTAMP '2018-01-01') 
        THEN 'Above Average'
        ELSE 'Below Average'
    END AS ReputationPerformance,
    CAST(CAST(TIMESTAMP '2024-10-01 12:34:56' AS timestamp) - CAST(ca.LastPostDate AS timestamp) AS interval) AS DaysSinceLastPostInterval,
    (SELECT COUNT(DISTINCT v.PostId) FROM Votes v WHERE v.UserId = ca.UserId AND v.VoteTypeId BETWEEN 2 AND 3) AS UpDownVotes,
    (SELECT COUNT(DISTINCT v.PostId) FROM Votes v WHERE v.UserId = ca.UserId AND v.VoteTypeId = 5) AS Favorites,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = ca.UserId AND b.Date >= TIMESTAMP '2022-01-01') AS RecentBadges2022,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = ca.UserId AND b.Class = 1) AS GoldBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = ca.UserId AND b.Class = 2) AS SilverBadges,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = ca.UserId AND b.Class = 3) AS BronzeBadges,
    (
        CASE 
            WHEN ca.TotalPosts > 0 THEN 
                ROUND(CAST(ca.Questions AS numeric) / CAST(ca.TotalPosts AS numeric) * 100, 2) 
            ELSE 0 
        END
    ) AS QuestionRatio,
    (
        SELECT STRING_AGG(pa.PostTypeDesc, ', ') 
        FROM PostAnalysis pa 
        WHERE pa.OwnerUserId = ca.UserId AND pa.CreationDate >= TIMESTAMP '2020-01-01'
    ) AS RecentPostTypes,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.CreationDate BETWEEN TIMESTAMP '2022-01-01' AND TIMESTAMP '2022-12-31') AS Posts2022,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.CreationDate BETWEEN TIMESTAMP '2021-01-01' AND TIMESTAMP '2021-12-31') AS Posts2021,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ca.UserId AND p.CreationDate BETWEEN TIMESTAMP '2020-01-01' AND TIMESTAMP '2020-12-31') AS Posts2020,
    RANK() OVER (ORDER BY ca.Reputation DESC, ca.ViewCount DESC, ca.TotalPosts DESC) AS ComprehensiveRank,
    CASE 
        WHEN ca.Reputation > 10000 AND ca.TotalPosts > 100 THEN 'Veteran'
        WHEN ca.Reputation > 5000 AND ca.TotalPosts > 50 THEN 'Experienced'
        WHEN ca.Reputation > 1000 AND ca.TotalPosts > 20 THEN 'Intermediate'
        ELSE 'Beginner'
    END AS ExperienceLevel
FROM ComplexAnalysis ca
WHERE ca.TotalPosts > 50 
  AND (ca.Reputation > 1000 OR ca.ViewCount > 1000)
ORDER BY ca.Reputation DESC, ca.ViewCount DESC, ca.TotalPosts DESC
LIMIT 250;