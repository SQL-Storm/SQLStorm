WITH UserBaseStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate AS UserLastAccessDate,
        u.UpVotes AS UserUpVotes,
        u.DownVotes AS UserDownVotes,
        u.Views AS UserViews,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        COALESCE(SUM(p.Score), 0) AS TotalPostScore,
        COALESCE(SUM(p.ViewCount), 0) AS TotalPostViews,
        COUNT(DISTINCT c.Id) AS TotalComments,
        COALESCE(SUM(c.Score), 0) AS TotalCommentScore,
        MAX(p.LastActivityDate) AS LatestPostActivityDate
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.UpVotes, u.DownVotes, u.Views
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN b.Id END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN b.Id END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN b.Id END) AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
),
PostDetailsBase AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        pt.Name AS PostTypeName,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        p.ParentId,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.LastActivityDate,
        p.Title,
        p.Tags,
        p.FavoriteCount,
        p.ClosedDate,
        CAST(p.Score AS NUMERIC) / NULLIF(p.ViewCount + p.CommentCount + COALESCE(p.FavoriteCount, 0) + 1, 0) AS EngagementRatio,
        CASE
            WHEN p.Tags IS NOT NULL AND CHAR_LENGTH(p.Tags) > 2 THEN
                string_to_array(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)), '><')
            ELSE CAST(ARRAY[] AS VARCHAR[])
        END AS TagArray
    FROM Posts p
    JOIN PostTypes pt ON p.PostTypeId = pt.Id
),
PostWindowFunctions AS (
    SELECT
        pdb.PostId,
        pdb.PostTypeId,
        pdb.PostScore,
        pdb.PostCreationDate,
        pdb.OwnerUserId,
        pdb.LastActivityDate,
        ROW_NUMBER() OVER (PARTITION BY pdb.PostTypeId ORDER BY pdb.PostScore DESC, pdb.PostCreationDate DESC) AS PostScoreRank,
        AVG(CAST(pdb.PostScore AS NUMERIC)) OVER (PARTITION BY EXTRACT(YEAR FROM pdb.PostCreationDate), EXTRACT(MONTH FROM pdb.PostCreationDate)) AS MonthlyAvgPostScore,
        LAG(pdb.LastActivityDate, 1, pdb.PostCreationDate) OVER (PARTITION BY pdb.OwnerUserId ORDER BY pdb.PostCreationDate) AS PreviousPostActivityDate
    FROM PostDetailsBase pdb
),
PostTagAggregations AS (
    SELECT
        pdb.PostId,
        COUNT(DISTINCT t.TagName) AS UniqueTagsOnPost,
        STRING_AGG(DISTINCT t.TagName, ', ') AS AllTagsOnPost
    FROM PostDetailsBase pdb
    CROSS JOIN LATERAL unnest(pdb.TagArray) AS t(TagName)
    WHERE CARDINALITY(pdb.TagArray) > 0
    GROUP BY pdb.PostId
),
RecentPostHistory AS (
    SELECT
        ph.PostId,
        ph.CreationDate AS HistoryCreationDate,
        ph.UserId AS HistoryEditorUserId,
        ph.Text AS HistoryText,
        ph.Comment AS HistoryComment,
        pht.Name AS HistoryTypeName,
        LAST_VALUE(ph.Text) OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC, ph.Id DESC) AS LatestBodyRevision,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC, ph.Id DESC) AS rn
    FROM PostHistory ph
    JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
    WHERE ph.PostHistoryTypeId IN (5, 8)
),
ClosedQuestionDetails AS (
    SELECT
        ph.PostId,
        ph.CreationDate AS CloseDate,
        crt.Name AS CloseReason,
        (
            SELECT COUNT(DISTINCT elem.value)
            FROM (
                -- Extract the content inside "OriginalQuestionIds":[ ... ] as ids_str, then split by comma.
                -- Use standard SQL string functions and a recursive split for portability.
                WITH ids_src AS (
                    SELECT
                        ph_inner.Text AS full_text,
                        -- find start of the array
                        CASE
                            WHEN POSITION('"OriginalQuestionIds"' IN ph_inner.Text) > 0 THEN
                                -- attempt to extract between [ and ] after the key
                                SUBSTRING(
                                    ph_inner.Text FROM
                                    POSITION('[' IN SUBSTRING(ph_inner.Text FROM POSITION('"OriginalQuestionIds"' IN ph_inner.Text)))
                                    FOR
                                    (POSITION(']' IN SUBSTRING(ph_inner.Text FROM POSITION('"OriginalQuestionIds"' IN ph_inner.Text))) )
                                )
                            ELSE NULL
                        END AS ids_str_partial
                    FROM (SELECT ph.Text) ph_inner
                ), ids_trimmed AS (
                    SELECT
                        full_text,
                        TRIM(BOTH ' ' FROM
                            TRIM(BOTH '"' FROM TRIM(BOTH '[]' FROM COALESCE(ids_str_partial, '')))
                        ) AS ids_str
                    FROM ids_src
                ), recursive_split AS (
                    SELECT
                        CASE WHEN ids_str = '' THEN NULL ELSE ids_str END AS rest,
                        NULL::VARCHAR AS value,
                        1 AS lvl
                    FROM ids_trimmed
                    UNION ALL
                    SELECT
                        CASE
                            WHEN POSITION(',' IN rest) > 0 THEN LTRIM(SUBSTRING(rest FROM POSITION(',' IN rest) + 1))
                            ELSE NULL
                        END AS rest,
                        CASE
                            WHEN POSITION(',' IN rest) > 0 THEN TRIM(BOTH ' ' FROM SUBSTRING(rest FROM 1 FOR POSITION(',' IN rest) - 1))
                            ELSE TRIM(BOTH ' ' FROM rest)
                        END AS value,
                        lvl + 1
                    FROM recursive_split
                    WHERE rest IS NOT NULL
                )
                SELECT value FROM recursive_split WHERE value IS NOT NULL
            ) elem
            WHERE ph.Text IS NOT NULL AND ph.Text LIKE '%"OriginalQuestionIds"%'
        ) AS DuplicateQuestionCount
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes crt ON ph.Comment IS NOT NULL AND ph.PostHistoryTypeId = 10 AND CAST(ph.Comment AS INTEGER) = crt.Id
    WHERE ph.PostHistoryTypeId = 10
)
SELECT
    ubs.UserId,
    COALESCE(ubs.DisplayName, 'Deleted User') AS UserDisplayName,
    ubs.Reputation,
    ubs.UserCreationDate,
    ubs.UserLastAccessDate,
    EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS timestamp) - ubs.UserCreationDate)) AS DaysSinceUserCreation,
    ubs.TotalPosts,
    ubs.TotalQuestions,
    ubs.TotalAnswers,
    ubs.TotalPostScore,
    ubs.TotalPostViews,
    ubs.TotalComments,
    ubs.TotalCommentScore,
    ubs.LatestPostActivityDate,
    ubs.UserUpVotes,
    ubs.UserDownVotes,
    ubs.UserViews,
    COALESCE(ubs_badge.GoldBadges, 0) AS GoldBadges,
    COALESCE(ubs_badge.SilverBadges, 0) AS SilverBadges,
    COALESCE(ubs_badge.BronzeBadges, 0) AS BronzeBadges,
    pdb.PostId,
    pdb.PostTypeName,
    pdb.PostCreationDate,
    pdb.PostScore,
    pdb.ViewCount,
    pdb.AnswerCount,
    pdb.CommentCount,
    pdb.Title,
    pdb.FavoriteCount,
    pdb.EngagementRatio,
    pwf.PostScoreRank,
    pwf.MonthlyAvgPostScore,
    pwf.PreviousPostActivityDate,
    (SELECT c.Text FROM Comments c WHERE c.PostId = pdb.PostId ORDER BY c.Score DESC, c.CreationDate DESC LIMIT 1) AS TopCommentText,
    (SELECT AVG(a_sub.Score) FROM Posts a_sub WHERE a_sub.ParentId = pdb.PostId AND a_sub.PostTypeId = 2) AS AvgAnswerScoreForQuestion,
    rph.HistoryCreationDate AS LastEditDate,
    rph.HistoryEditorUserId AS LastEditorOfPostBody,
    rph.LatestBodyRevision AS LastKnownPostBodyRevision,
    cqd.CloseReason,
    cqd.DuplicateQuestionCount,
    (CASE WHEN EXISTS (SELECT 1 FROM PostLinks pl WHERE pl.PostId = pdb.PostId AND pl.LinkTypeId = 3) THEN 1 ELSE 0 END) AS IsDuplicateSource,
    pta.UniqueTagsOnPost,
    pta.AllTagsOnPost,
    CASE
        WHEN pdb.PostTypeId = 1 AND pdb.ClosedDate IS NOT NULL AND cqd.CloseReason LIKE '%duplicate%' THEN 'Closed-Duplicate-Question'
        WHEN pdb.PostTypeId = 1 AND pdb.ClosedDate IS NOT NULL THEN 'Closed-Question'
        WHEN pdb.PostTypeId = 1 AND pdb.AnswerCount > 0 AND pdb.AcceptedAnswerId IS NOT NULL THEN 'Answered-Accepted-Question'
        WHEN pdb.PostTypeId = 2 AND pdb.PostScore > (SELECT AVG(p_inner.Score) FROM Posts p_inner WHERE p_inner.PostTypeId = 2) THEN 'High-Score-Answer'
        WHEN pdb.PostTypeId = 2 AND pdb.ParentId IS NULL THEN 'Orphan-Answer-Suspicious'
        ELSE 'Other-Active-Post'
    END AS PostStatusClassifier,
    (ubs.Reputation * (COALESCE(pdb.PostScore, 0) + COALESCE(pdb.FavoriteCount, 0) * 2 - ubs.UserDownVotes * 0.1) + ubs.UserUpVotes * 0.5) / NULLIF(ubs.TotalPosts + ubs.TotalComments + 1, 0) AS UserPostInfluenceScore
FROM
    UserBaseStats ubs
LEFT JOIN UserBadgeSummary ubs_badge ON ubs.UserId = ubs_badge.UserId
LEFT JOIN PostDetailsBase pdb ON ubs.UserId = pdb.OwnerUserId
LEFT JOIN PostWindowFunctions pwf ON pdb.PostId = pwf.PostId
LEFT JOIN RecentPostHistory rph ON pdb.PostId = rph.PostId AND rph.rn = 1
LEFT JOIN ClosedQuestionDetails cqd ON pdb.PostId = cqd.PostId AND pdb.PostTypeId = 1
LEFT JOIN PostTagAggregations pta ON pdb.PostId = pta.PostId
WHERE
    ubs.Reputation >= 500
    AND ubs.TotalPosts > 5
    AND pdb.PostCreationDate IS NOT NULL
    AND (
        pdb.PostScore >= 10
        OR pdb.ViewCount >= 1000
        OR EXISTS (SELECT 1 FROM Comments cm WHERE cm.PostId = pdb.PostId AND CHAR_LENGTH(cm.Text) > 100 AND cm.Score > 0)
    )
    AND NOT EXISTS (
        SELECT 1 FROM Votes v
        WHERE v.PostId = pdb.PostId
          AND v.VoteTypeId = 12
          AND v.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1' YEAR
    )
    AND (ubs.UserViews > 100 OR ubs.UserUpVotes > 50)
ORDER BY
    UserPostInfluenceScore DESC,
    pdb.PostScore DESC,
    ubs.Reputation DESC,
    cqd.DuplicateQuestionCount DESC
FETCH FIRST 1000 ROWS ONLY;