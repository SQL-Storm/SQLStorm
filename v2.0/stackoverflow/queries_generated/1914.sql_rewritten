-- {"query": "1914.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3179} 
WITH UserActivitySummary AS (
    -- CTE 1: Summarize core user activity, reputation tiers, and detailed vote counts
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.UpVotes,
        U.DownVotes,
        U.Views AS UserProfileViews,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COALESCE(SUM(P.Score), 0) AS TotalPostScore,
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 9 THEN V.BountyAmount ELSE 0 END), 0) AS TotalBountyReceived,
        MAX(P.LastActivityDate) AS LastPostActivity,
        MAX(C.CreationDate) AS LastCommentActivity,
        -- Conditional calculation / string expression for reputation tier
        CASE
            WHEN U.Reputation >= 250000 THEN 'Legend'
            WHEN U.Reputation >= 50000 THEN 'Guru'
            WHEN U.Reputation >= 10000 THEN 'Expert'
            WHEN U.Reputation >= 2000 THEN 'Apprentice'
            ELSE 'Novice'
        END AS ReputationTier,
        U.Location,
        U.AboutMe
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId AND V.VoteTypeId IN (2, 3, 9) -- UpMod, DownMod, BountyClose
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.UpVotes, U.DownVotes, U.Views, U.Location, U.AboutMe
    HAVING U.Reputation >= 1000 AND U.DisplayName IS NOT NULL -- Base filter for relevant users
),
PostHistoricalMetrics AS (
    -- CTE 2: Calculate post-level historical metrics, edit count, and latest close reasons
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.AnswerCount,
        P.FavoriteCount,
        P.LastEditDate,
        COUNT(PH.Id) AS TotalEditHistoryEntries,
        SUM(CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN 1 ELSE 0 END) AS MajorEditCount,
        MAX(CASE WHEN PH.PostHistoryTypeId = 10 THEN CRT.Name ELSE NULL END) AS LatestCloseReason,
        MAX(CASE WHEN PH.PostHistoryTypeId = 2 THEN LENGTH(PH.Text) ELSE NULL END) AS InitialBodyLength,
        MAX(CASE WHEN PH.PostHistoryTypeId = 5 THEN LENGTH(PH.Text) ELSE NULL END) AS LatestBodyLength,
        ROW_NUMBER() OVER(PARTITION BY P.OwnerUserId ORDER BY P.CreationDate DESC) AS UserLatestPostRank,
        LAG(P.LastEditDate, 1, P.CreationDate) OVER(PARTITION BY P.OwnerUserId, P.Id ORDER BY PH.CreationDate) AS PreviousEditDate -- Window function
    FROM Posts P
    LEFT JOIN PostHistory PH ON P.Id = PH.PostId
    LEFT JOIN CloseReasonTypes CRT ON PH.PostHistoryTypeId = 10 AND PH.Comment IS NOT NULL AND CRT.Id = CAST(PH.Comment AS smallint)
    WHERE P.OwnerUserId IS NOT NULL
    GROUP BY P.Id, P.PostTypeId, P.OwnerUserId, P.CreationDate, P.Score, P.ViewCount, P.AnswerCount, P.FavoriteCount, P.LastEditDate
),
TagCategorization AS (
    -- CTE 3: Categorize posts by tags and calculate tag-specific metrics, using UNION ALL
    -- This helps identify users contributing to specific domains
    SELECT
        P.Id AS PostId,
        P.OwnerUserId,
        TRIM(UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'))) AS TagName,
        'Programming' AS TagCategory,
        P.Score AS TagPostScore
    FROM Posts P
    WHERE P.PostTypeId = 1 AND P.Tags IS NOT NULL AND (P.Tags LIKE '%<java>%' OR P.Tags LIKE '%<python>%' OR P.Tags LIKE '%<c#>%<' OR P.Tags LIKE '%<javascript>%')
    UNION ALL
    SELECT
        P.Id AS PostId,
        P.OwnerUserId,
        TRIM(UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'))) AS TagName,
        'Database' AS TagCategory,
        P.Score AS TagPostScore
    FROM Posts P
    WHERE P.PostTypeId = 1 AND P.Tags IS NOT NULL AND (P.Tags LIKE '%<sql>%' OR P.Tags LIKE '%<database>%' OR P.Tags LIKE '%<postgresql>%' OR P.Tags LIKE '%<mysql>%')
),
QualifiedContributors AS (
    -- CTE 4: Identify users who are "qualified" based on a blend of activity and reputation,
    -- including complex correlated subqueries and window functions.
    SELECT
        UAS.UserId,
        UAS.DisplayName,
        UAS.Reputation,
        UAS.QuestionCount,
        UAS.AnswerCount,
        UAS.TotalComments,
        UAS.TotalPostScore,
        UAS.LastPostActivity,
        UAS.LastCommentActivity,
        -- Correlated Subquery 1: Check if user has an accepted answer for a question with > 5 answers
        (SELECT
             COUNT(P_inner.Id) > 0
         FROM Posts P_inner
         WHERE P_inner.OwnerUserId = UAS.UserId
           AND P_inner.AcceptedAnswerId IS NOT NULL
           AND (SELECT P_question.AnswerCount FROM Posts P_question WHERE P_question.Id = P_inner.ParentId) > 5
        ) AS HasAcceptedInComplexQuestion,
        -- Correlated Subquery 2: Average score of their most recent 5 answers
        (SELECT
             COALESCE(AVG(P_recent_answers.Score), 0)
         FROM (
             SELECT P_sub_inner.Score
             FROM Posts P_sub_inner
             WHERE P_sub_inner.OwnerUserId = UAS.UserId AND P_sub_inner.PostTypeId = 2 -- Only answers
             ORDER BY P_sub_inner.CreationDate DESC
             LIMIT 5
         ) AS P_recent_answers
        ) AS AvgScoreLast5Answers,
        NTILE(5) OVER (ORDER BY UAS.Reputation DESC, UAS.TotalPostScore DESC) AS ReputationQuintile -- Window function
    FROM UserActivitySummary UAS
    WHERE UAS.Reputation > 2000
      AND (UAS.QuestionCount + UAS.AnswerCount) > 20
      AND UAS.TotalComments > 10
),
ModeratorEditedPosts AS (
    -- CTE 5: Posts that have been edited/locked/unlocked by a moderator (UserId implies community/mod roles)
    SELECT DISTINCT
        PH.PostId,
        MAX(PH.CreationDate) AS LastModActionDate,
        COUNT(PH.Id) AS ModActionCount
    FROM PostHistory PH
    WHERE PH.UserId IS NOT NULL AND PH.UserId BETWEEN 1 AND 3 -- Community User / Moderator IDs often fall in this range
      AND PH.PostHistoryTypeId IN (4, 5, 6, 14, 15, 19, 20) -- Edit Title, Body, Tags, Lock, Unlock, Protect, Unprotect
    GROUP BY PH.PostId
),
UserBadgeSummary AS (
    -- CTE 6: Summarize badge information per user, focusing on highest class and frequency
    SELECT
        B.UserId,
        COUNT(B.Id) AS TotalBadges,
        MAX(CASE WHEN B.Class = 1 THEN B.Name ELSE NULL END) AS GoldBadgeName,
        MAX(CASE WHEN B.Class = 2 THEN B.Name ELSE NULL END) AS SilverBadgeName,
        MAX(B.Class) AS HighestBadgeClassValue,
        MIN(B.Class) AS LowestBadgeClassValue
    FROM Badges B
    GROUP BY B.UserId
)
-- Main complex query combining results from CTEs and adding more layers of filtering and calculation
SELECT
    QC.UserId,
    QC.DisplayName,
    QC.Reputation,
    QC.ReputationQuintile,
    QC.QuestionCount,
    QC.AnswerCount,
    QC.TotalComments,
    QC.HasAcceptedInComplexQuestion,
    QC.AvgScoreLast5Answers,
    COALESCE(TP.ProgrammingTagPostCount, 0) AS ProgrammingTagContribution,
    COALESCE(TP.DatabaseTagPostCount, 0) AS DatabaseTagContribution,
    UAS.ReputationTier,
    PHM.TotalEditHistoryEntries AS LatestPostEditHistory,
    PHM.MajorEditCount AS LatestPostMajorEdits,
    PHM.LatestCloseReason AS LatestPostClosureReason,
    ABS(UAS.UpVotes - UAS.DownVotes) AS NetVoteDifference, -- Complex calculation with absolute value
    COALESCE(PHM.InitialBodyLength, 0) AS InitialPostContentLength,
    COALESCE(PHM.LatestBodyLength, 0) AS CurrentPostContentLength,
    COALESCE(MOD.LastModActionDate, '1900-01-01 00:00:00'::timestamp) AS PostLastModeratedActionDate, -- NULL logic COALESCE
    COALESCE(UBS.GoldBadgeName, UBS.SilverBadgeName, 'No Gold/Silver Badge') AS TopBadgeAwarded, -- NULL logic COALESCE
    DATE_PART('year', AGE(cast('2024-10-01 12:34:56' as timestamp), UAS.UserCreationDate)) AS YearsOnPlatform, -- Date calculation
    PERCENT_RANK() OVER (ORDER BY QC.Reputation DESC, QC.AvgScoreLast5Answers DESC) AS UserPerformancePercentRank, -- Window Function
    DENSE_RANK() OVER (PARTITION BY QC.ReputationQuintile ORDER BY QC.TotalPostScore DESC, UAS.UserProfileViews DESC) AS RankWithinReputationQuintile, -- Window Function
    (QC.TotalPostScore * 0.4 + QC.QuestionCount * 0.2 + QC.AnswerCount * 0.3 + QC.TotalComments * 0.1) AS CalculatedImpactScore, -- Elaborate weighted calculation
    -- String expression and NULL logic in a CASE WHEN
    CASE
        WHEN UAS.AboutMe IS NOT NULL AND LENGTH(UAS.AboutMe) > 200 AND UAS.AboutMe LIKE '%developer%' THEN 'Verbose Developer'
        WHEN UAS.AboutMe IS NOT NULL AND LENGTH(UAS.AboutMe) BETWEEN 50 AND 200 THEN 'Concise Contributor'
        WHEN UAS.AboutMe IS NULL THEN 'No AboutMe Info'
        ELSE 'Limited AboutMe Info'
    END AS AboutMeProfileDetail
FROM QualifiedContributors QC
JOIN UserActivitySummary UAS ON QC.UserId = UAS.UserId
LEFT JOIN PostHistoricalMetrics PHM ON QC.UserId = PHM.OwnerUserId AND PHM.UserLatestPostRank = 1
LEFT JOIN (
    -- Subquery for aggregating tag categories post counts per user
    SELECT
        OwnerUserId,
        COUNT(CASE WHEN TagCategory = 'Programming' THEN PostId END) AS ProgrammingTagPostCount,
        COUNT(CASE WHEN TagCategory = 'Database' THEN PostId END) AS DatabaseTagPostCount
    FROM TagCategorization
    GROUP BY OwnerUserId
) AS TP ON QC.UserId = TP.OwnerUserId
LEFT JOIN UserBadgeSummary UBS ON QC.UserId = UBS.UserId
LEFT JOIN ModeratorEditedPosts MOD ON PHM.PostId = MOD.PostId
WHERE QC.Reputation > 5000 -- Final filter on reputation
  AND QC.AvgScoreLast5Answers > 3 -- Ensure recent answers are well-received
  AND (PHM.PostId IS NULL OR PHM.TotalEditHistoryEntries > 0 OR PHM.PostTypeId != 1) -- Latest post must have edits or not be a question
  AND (UAS.Location IS NULL OR (LOWER(UAS.Location) NOT LIKE '%india%' AND LOWER(UAS.Location) NOT LIKE '%china%')) -- String expression with NULL logic
  AND NOT EXISTS (
      -- Anti-correlated subquery: Exclude users whose latest question was closed as duplicate or off-topic and had no accepted answers
      SELECT 1
      FROM Posts P_closed
      WHERE P_closed.Id = PHM.PostId
        AND P_closed.PostTypeId = 1
        AND P_closed.ClosedDate IS NOT NULL
        AND P_closed.AcceptedAnswerId IS NULL
        AND P_closed.Id IN (
            SELECT PH_closed.PostId
            FROM PostHistory PH_closed
            WHERE PH_closed.PostId = P_closed.Id
              AND PH_closed.PostHistoryTypeId = 10 -- Post Closed
              AND PH_closed.Comment IN ('1', '2', '101', '102') -- Exact Duplicate, Off-topic
        )
  )
ORDER BY CalculatedImpactScore DESC, UserPerformancePercentRank ASC
LIMIT 750;