WITH UserEngagementSummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        COUNT(DISTINCT p_all.Id) AS TotalPostsByOwner,
        COUNT(DISTINCT c.Id) AS TotalCommentsByOwner,
        COUNT(DISTINCT b.Id) AS TotalBadgesEarned,
        SUM(CASE WHEN vt_up.Name = 'UpMod' THEN 1 ELSE 0 END) AS TotalUpvotesReceivedOnPosts,
        SUM(CASE WHEN vt_down.Name = 'DownMod' THEN 1 ELSE 0 END) AS TotalDownvotesReceivedOnPosts,
        AVG(p_all.Score) FILTER (WHERE p_all.PostTypeId IN (1, 2)) AS AverageContentPostScore,
        MIN(p_all.CreationDate) AS FirstPostDate,
        MAX(COALESCE(p_all.LastActivityDate, p_all.CreationDate)) AS LatestUserPostActivityDate,
        (u.UpVotes - u.DownVotes) AS UserNetVotesGiven,
        u.Views AS UserProfileViews
    FROM Users u
    LEFT JOIN Posts p_all ON u.Id = p_all.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Votes v_on_posts ON p_all.Id = v_on_posts.PostId AND v_on_posts.VoteTypeId IN (2, 3)
    LEFT JOIN VoteTypes vt_up ON v_on_posts.VoteTypeId = vt_up.Id AND vt_up.Name = 'UpMod'
    LEFT JOIN VoteTypes vt_down ON v_on_posts.VoteTypeId = vt_down.Id AND vt_down.Name = 'DownMod'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.UpVotes, u.DownVotes, u.Views
),
PostDetailsAndRanks AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        pt.Name AS PostTypeName,
        p.Title,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount,
        COALESCE(p.AnswerCount, 0) AS AnswerCount,
        COALESCE(p.CommentCount, 0) AS PostCommentCount,
        p.OwnerUserId,
        p.Tags,
        COALESCE(p.FavoriteCount, 0) AS FavoriteCount,
        (
            SELECT AVG(ans.Score)
            FROM Posts ans
            WHERE ans.ParentId = p.Id AND ans.PostTypeId = 2
        ) AS AvgAnswerScoreForQuestion,
        (
            SELECT COUNT(DISTINCT ph.UserId)
            FROM PostHistory ph
            WHERE ph.PostId = p.Id
              AND ph.PostHistoryTypeId IN (4, 5, 6)
              AND ph.UserId IS NOT NULL
        ) AS DistinctEditorsCount,
        (CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN TRUE ELSE FALSE END) AS HasAcceptedAnswer,
        CASE
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.CommunityOwnedDate IS NOT NULL THEN 'CommunityOwned'
            WHEN p.ViewCount > 5000 AND COALESCE(p.AnswerCount, 0) = 0 AND p.PostTypeId = 1 THEN 'HighTrafficNoAnswer'
            WHEN p.Body LIKE '%security%' AND p.Score < 0 THEN 'SecurityConcernNegativeScore'
            WHEN p.OwnerUserId IS NULL AND p.LastEditorUserId IS NOT NULL THEN 'CommunityEditedNoOwner'
            ELSE 'Normal'
        END AS PostStatusFlag,
        RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.CreationDate DESC) AS PostScoreRankPerType,
        LAG(p.CreationDate, 1, p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) AS PrevPostCreationDateByOwner,
        DATE_PART('day', p.CreationDate - LAG(p.CreationDate, 1, p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate)) AS DaysSincePrevPostByOwner,
        array_length(string_to_array(substring(p.Tags FROM 2 FOR char_length(p.Tags) - 2), '><'), 1) AS TagCountAlternative
    FROM Posts p
    JOIN PostTypes pt ON p.PostTypeId = pt.Id
    WHERE p.PostTypeId IN (1, 2, 4, 5)
),
TagUsageAndPerformance AS (
    SELECT
        t.TagName,
        COUNT(DISTINCT p.Id) AS TotalTaggedQuestions,
        AVG(p.Score) AS AvgScoreOfTaggedQuestions,
        AVG(p.AnswerCount) AS AvgAnswerCountOfTaggedQuestions,
        SUM(p.ViewCount) AS TotalViewCountForTag,
        DENSE_RANK() OVER (ORDER BY SUM(p.ViewCount) DESC, COUNT(DISTINCT p.Id) DESC) AS TagPopularityRankByViews
    FROM Tags t
    JOIN Posts p ON p.PostTypeId = 1 AND p.Tags LIKE '%' || t.TagName || '%'
    GROUP BY t.TagName
    HAVING COUNT(DISTINCT p.Id) >= 10
),
PostsWithRecentActivity AS (
    SELECT
        v.PostId,
        COUNT(v.Id) AS RecentUpvoteCount,
        MAX(v.CreationDate) AS LastRecentUpvoteDate,
        ROW_NUMBER() OVER (ORDER BY COUNT(v.Id) DESC, MAX(v.CreationDate) DESC) AS RecentUpvoteRank
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    WHERE vt.Name = 'UpMod'
      AND v.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '60 days')
    GROUP BY v.PostId
    HAVING COUNT(v.Id) >= 5
),
ProblematicPosts AS (
    SELECT
        ph.PostId,
        COUNT(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 END) AS CloseCount,
        COUNT(CASE WHEN ph.PostHistoryTypeId = 11 THEN 1 END) AS ReopenCount,
        COUNT(CASE WHEN ph.PostHistoryTypeId = 12 THEN 1 END) AS DeleteCount,
        COUNT(CASE WHEN ph.PostHistoryTypeId = 13 THEN 1 END) AS UndeleteCount,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN phc.Name ELSE NULL END) AS LastCloseReasonName
    FROM PostHistory ph
    LEFT JOIN CloseReasonTypes phc ON ph.PostHistoryTypeId = 10 AND ph.Comment = CAST(phc.Id AS TEXT)
    WHERE ph.PostHistoryTypeId IN (10, 11, 12, 13)
    GROUP BY ph.PostId
    HAVING COUNT(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 END) > 1
        OR (COUNT(CASE WHEN ph.PostHistoryTypeId = 12 THEN 1 END) > 0 AND COUNT(CASE WHEN ph.PostHistoryTypeId = 13 THEN 1 END) > 0)
),
UsersWhoCommentedButNotAnswered AS (
    SELECT c.UserId
    FROM Comments c
    WHERE c.UserId IS NOT NULL
    EXCEPT
    SELECT p.OwnerUserId
    FROM Posts p
    WHERE p.PostTypeId = 2 AND p.OwnerUserId IS NOT NULL
)
SELECT
    ues.UserId,
    ues.DisplayName,
    ues.Reputation,
    ues.TotalPostsByOwner,
    ues.TotalCommentsByOwner,
    ues.TotalBadgesEarned,
    COALESCE(ues.AverageContentPostScore, 0.0) AS AverageContentPostScore,
    ues.FirstPostDate,
    ues.LatestUserPostActivityDate,
    pdar.PostId,
    pdar.PostTypeName,
    pdar.Title,
    pdar.PostCreationDate,
    pdar.PostScore,
    pdar.ViewCount,
    pdar.AnswerCount,
    pdar.PostCommentCount,
    pdar.AvgAnswerScoreForQuestion,
    pdar.DistinctEditorsCount,
    pdar.HasAcceptedAnswer,
    pdar.PostStatusFlag,
    pdar.PostScoreRankPerType,
    pdar.DaysSincePrevPostByOwner,
    pdar.TagCountAlternative AS PostTagCount,
    tup.TagName AS TopAssociatedTagName,
    tup.AvgScoreOfTaggedQuestions AS TopTagAvgScore,
    pr.RecentUpvoteCount,
    pr.LastRecentUpvoteDate,
    pp.CloseCount AS PostCloseEvents,
    pp.ReopenCount AS PostReopenEvents,
    pp.LastCloseReasonName,
    (ues.TotalUpvotesReceivedOnPosts * 0.7 + ues.TotalBadgesEarned * 1.5 + ues.UserProfileViews * 0.01 - ues.TotalDownvotesReceivedOnPosts * 0.5) AS UserImpactScore,
    COALESCE(UPPER(SUBSTRING(TRIM(pdar.Title) FROM 1 FOR 30)) || CASE WHEN CHAR_LENGTH(TRIM(pdar.Title)) > 30 THEN '...' ELSE '' END, 'NO_TITLE') AS TruncatedPostTitleUpper,
    CASE WHEN uwnca.UserId IS NOT NULL THEN 'CommenterOnly' ELSE 'MixedContributor' END AS ContributionType,
    (SELECT COUNT(DISTINCT p_acc.Id) FROM Posts p_acc WHERE p_acc.OwnerUserId = ues.UserId AND p_acc.AcceptedAnswerId IS NOT NULL) AS UserAcceptedAnswerCount,
    (
        SELECT ph_last.UserDisplayName
        FROM PostHistory ph_last
        WHERE ph_last.PostId = pdar.PostId
          AND ph_last.PostHistoryTypeId IN (4, 5, 6)
          AND ph_last.UserDisplayName IS NOT NULL
        ORDER BY ph_last.CreationDate DESC
        LIMIT 1
    ) AS LastEditorDisplayNameForPost,
    EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - pdar.PostCreationDate)) / (60 * 60 * 24) AS DaysSincePostCreation,
    NULLIF(ues.UserProfileViews, 0) AS UserProfileViewsIfAny,
    COALESCE(link_q.Id IS NOT NULL, FALSE) AS HasLinkedQuestions,
    COALESCE(link_d.Id IS NOT NULL, FALSE) AS HasDuplicateQuestions
FROM UserEngagementSummary ues
LEFT JOIN PostDetailsAndRanks pdar ON ues.UserId = pdar.OwnerUserId
LEFT JOIN PostsWithRecentActivity pr ON pdar.PostId = pr.PostId
LEFT JOIN ProblematicPosts pp ON pdar.PostId = pp.PostId
LEFT JOIN TagUsageAndPerformance tup ON pdar.Tags LIKE '%' || tup.TagName || '%' AND tup.TagPopularityRankByViews <= 5
LEFT JOIN UsersWhoCommentedButNotAnswered uwnca ON ues.UserId = uwnca.UserId
LEFT JOIN PostLinks link_q ON pdar.PostId = link_q.PostId AND link_q.LinkTypeId = 1
LEFT JOIN PostLinks link_d ON pdar.PostId = link_d.PostId AND link_d.LinkTypeId = 3
WHERE
    ues.Reputation >= 5000
    AND pdar.PostScore >= 0
    AND pdar.ViewCount >= 500
    AND (pdar.PostStatusFlag = 'Normal' OR pdar.PostStatusFlag = 'HighTrafficNoAnswer' OR pdar.PostStatusFlag = 'CommunityEditedNoOwner')
    AND pdar.DaysSincePrevPostByOwner IS NOT NULL
    AND EXISTS (
        SELECT 1
        FROM Comments c_exist
        WHERE c_exist.PostId = pdar.PostId
          AND c_exist.UserId IS NOT NULL
          AND c_exist.UserId <> pdar.OwnerUserId
    )
    AND (
        CASE
            WHEN ues.DisplayName LIKE 'StackOverflow%' THEN TRUE
            WHEN ues.DisplayName IS NOT NULL AND CHAR_LENGTH(TRIM(ues.DisplayName)) > 2 AND ues.DisplayName NOT LIKE 'anon%' THEN TRUE
            ELSE FALSE
        END
    )
    AND (ues.TotalBadgesEarned >= 10 OR (ues.TotalUpvotesReceivedOnPosts * 0.7 + ues.TotalBadgesEarned * 1.5 + ues.UserProfileViews * 0.01 - ues.TotalDownvotesReceivedOnPosts * 0.5) >= 500 OR pr.RecentUpvoteCount >= 10)
    AND (tup.TotalViewCountForTag IS NULL OR tup.TotalViewCountForTag > 100000)
ORDER BY
    (ues.TotalUpvotesReceivedOnPosts * 0.7 + ues.TotalBadgesEarned * 1.5 + ues.UserProfileViews * 0.01 - ues.TotalDownvotesReceivedOnPosts * 0.5) DESC,
    pdar.PostScore DESC,
    pr.RecentUpvoteCount DESC,
    pdar.PostCreationDate DESC
LIMIT 2000;