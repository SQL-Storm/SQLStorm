-- {"query": "3946.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 3407} 
WITH
/*---------------------------------------------------*/
/*  Basic per‑user activity aggregates                */
UserActivity AS (
    SELECT
        u.Id                                           AS UserId,
        u.DisplayName,
        u.Reputation,
        COALESCE(pq.QuestionCnt,0)                      AS QuestionCount,
        COALESCE(pq.AnswerCnt,0)                        AS AnswerCount,
        COALESCE(bc.BadgeCnt,0)                         AS BadgeCount,
        COALESCE(vc.VoteCnt,0)                          AS VoteCount,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RepRank
    FROM Users u
    LEFT JOIN (
        SELECT
            OwnerUserId,
            SUM(CASE WHEN PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCnt,
            SUM(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCnt
        FROM Posts
        GROUP BY OwnerUserId
    ) pq ON pq.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT UserId, COUNT(*) AS BadgeCnt
        FROM Badges
        GROUP BY UserId
    ) bc ON bc.UserId = u.Id
    LEFT JOIN (
        SELECT p.OwnerUserId, COUNT(v.Id) AS VoteCnt
        FROM Votes v
        JOIN Posts p ON p.Id = v.PostId
        WHERE v.VoteTypeId IN (2,3)                -- up / down votes
        GROUP BY p.OwnerUserId
    ) vc ON vc.OwnerUserId = u.Id
),

/*---------------------------------------------------*/
/*  Latest activity timestamps per user              */
UserRecentActivity AS (
    SELECT
        u.Id                                               AS UserId,
        (SELECT MAX(p.CreationDate)
         FROM Posts p
         WHERE p.OwnerUserId = u.Id)                       AS LastPostDate,
        (SELECT MAX(c.CreationDate)
         FROM Comments c
         WHERE c.UserId = u.Id)                            AS LastCommentDate,
        (SELECT MAX(v.CreationDate)
         FROM Votes v
         WHERE v.UserId = u.Id)                            AS LastVoteDate
    FROM Users u
),

/*---------------------------------------------------*/
/*  Tag popularity (top 20 tags)                     */
TopTags AS (
    SELECT
        t.TagName,
        t.Count                                            AS TagUseCount,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC)         AS TagRank
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
    ORDER BY t.Count DESC
    LIMIT 20
),

/*---------------------------------------------------*/
/*  Tag‑co‑occurrence (pairs that appear together)   */
TagCoOccurrence AS (
    SELECT
        ta.Tag   AS TagA,
        tb.Tag   AS TagB,
        COUNT(*) AS CoCount
    FROM Posts p
    CROSS JOIN LATERAL (
        SELECT UNNEST(string_to_array(substr(p.Tags,2,length(p.Tags)-2),'><')) AS Tag
    ) ta
    CROSS JOIN LATERAL (
        SELECT UNNEST(string_to_array(substr(p.Tags,2,length(p.Tags)-2),'><')) AS Tag
    ) tb
    WHERE ta.Tag < tb.Tag
    GROUP BY ta.Tag, tb.Tag
    HAVING COUNT(*) > 10
),

/*---------------------------------------------------*/
/*  Recent duplicate‑close events (last 30 days)    */
RecentClosedDuplicates AS (
    SELECT
        ph.PostId,
        ph.CreationDate                     AS CloseDate,
        ph.Comment                          AS CloseReasonId,   -- duplicate reason = 101
        ph.Text                             AS DuplicateInfo,
        pl.RelatedPostId                    AS DuplicateOf,
        pl.CreationDate                     AS DuplicateLinkDate
    FROM PostHistory ph
    JOIN PostLinks pl
      ON pl.PostId = ph.PostId
     AND pl.LinkTypeId = 3                         -- duplicate link
    WHERE ph.PostHistoryTypeId = 10                -- Post Closed
      AND ph.Comment = '101'                       -- Duplicate reason
      AND ph.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
),

/*---------------------------------------------------*/
/*  Score aggregates per user (questions & answers) */
AggregatedScores AS (
    SELECT
        p.OwnerUserId,
        SUM(COALESCE(p.Score,0))                 AS TotalScore,
        ROUND(AVG(p.Score)::numeric,2)           AS AvgScore,
        MAX(p.Score)                             AS MaxScore,
        MIN(p.Score)                             AS MinScore
    FROM Posts p
    WHERE p.PostTypeId IN (1,2)                  -- Q or A
    GROUP BY p.OwnerUserId
)

--==================================================================
SELECT
    ua.UserId,
    ua.DisplayName,
    ua.Reputation,
    ua.RepRank,
    ua.QuestionCount,
    ua.AnswerCount,
    ua.BadgeCount,
    ua.VoteCount,
    COALESCE(ascr.TotalScore,0)               AS TotalScore,
    COALESCE(ascr.AvgScore,0)                 AS AvgScore,
    ascr.MaxScore,
    ascr.MinScore,
    ur.LastPostDate,
    ur.LastCommentDate,
    ur.LastVoteDate,
    CASE
        WHEN ur.LastPostDate IS NULL
         AND ur.LastCommentDate IS NULL
         AND ur.LastVoteDate IS NULL                 THEN 'Never Active'
        WHEN GREATEST(COALESCE(ur.LastPostDate,'1970-01-01')
                    ,COALESCE(ur.LastCommentDate,'1970-01-01')
                    ,COALESCE(ur.LastVoteDate,'1970-01-01')) > cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
                                                       THEN 'Active'
        ELSE                                             'Dormant'
    END                                          AS ActivityStatus,
    tt.TagName,
    tt.TagUseCount,
    tt.TagRank
FROM UserActivity ua
LEFT JOIN AggregatedScores ascr
       ON ascr.OwnerUserId = ua.UserId
LEFT JOIN UserRecentActivity ur
       ON ur.UserId = ua.UserId
LEFT JOIN (
    /* pick the top tag for each user based on the TopTags list */
    SELECT
        p.OwnerUserId                AS UserId,
        MIN(tt.TagName)              AS TagName,        -- deterministic tie‑break
        MIN(tt.TagUseCount)          AS TagUseCount,
        MIN(tt.TagRank)              AS TagRank
    FROM Posts p
    CROSS JOIN LATERAL (
        SELECT UNNEST(string_to_array(substr(p.Tags,2,length(p.Tags)-2),'><')) AS Tag
    ) pt
    JOIN TopTags tt ON tt.TagName = pt.Tag
    WHERE p.PostTypeId = 1                                   -- questions only
    GROUP BY p.OwnerUserId
) tt ON tt.UserId = ua.UserId
WHERE ua.RepRank <= 1000
ORDER BY ua.RepRank
LIMIT 100

UNION ALL

/*-------------------------------------------------------------------*/
/*  Separator row (demonstrates set operator handling)              */
SELECT
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,
    NULL,NULL,NULL,'--- Separator ---',NULL,NULL,NULL
FROM (SELECT 1) s

UNION ALL

/*-------------------------------------------------------------------*/
/*  Recent duplicate‑close events (joined for benchmarking)          */
SELECT
    rc.PostId            AS UserId,                -- repurposed column
    NULL                AS DisplayName,
    NULL                AS Reputation,
    NULL                AS RepRank,
    NULL                AS QuestionCount,
    NULL                AS AnswerCount,
    NULL                AS BadgeCount,
    NULL                AS VoteCount,
    NULL                AS TotalScore,
    NULL                AS AvgScore,
    NULL                AS MaxScore,
    NULL                AS MinScore,
    rc.CloseDate        AS LastPostDate,
    rc.DuplicateLinkDate AS LastCommentDate,
    NULL                AS LastVoteDate,
    CASE WHEN rc.DuplicateOf IS NOT NULL THEN 'Duplicate' ELSE 'Closed' END
                         AS ActivityStatus,
    NULL                AS TagName,
    NULL                AS TagUseCount,
    NULL                AS TagRank
FROM RecentClosedDuplicates rc
ORDER BY RepRank NULLS LAST, CloseDate DESC
LIMIT 200;