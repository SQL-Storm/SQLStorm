-- {"query": "6914.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 466} 
SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class,
    t.TagName,
    ph.RevisionGUID,
    ph.Comment,
    ph.CreationDate AS HistoryDate,
    (
        SELECT 
            STRING_AGG(cl.Name, ', ')
        FROM 
            CloseReasonTypes cl
        WHERE 
            cl.Id = ph.Comment
    ) AS CloseReason,
    (
        SELECT 
            STRING_AGG(vl.Name, ', ')
        FROM 
            VoteTypes vl
        WHERE 
            vl.Id IN (
                SELECT 
                    VoteTypeId
                FROM 
                    Votes
                WHERE 
                    PostId = p.Id
            )
    ) AS VoteTypes
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    Tags t ON p.Tags LIKE '%' || t.TagName || '%'
WHERE 
    u.Reputation > 1000
AND 
    p.Score > 0
AND 
    p.LastEditDate > p.CreationDate
AND 
    EXISTS (
        SELECT 
            1
        FROM 
            Votes v
        WHERE 
            v.PostId = p.Id
            AND v.VoteTypeId = 2
    )
GROUP BY 
    u.Id, b.Class
HAVING 
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) > 5
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;