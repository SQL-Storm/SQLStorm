WITH UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Views, 0) AS TotalViews,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
        MAX(p.CreationDate) AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views
),

BadgeRanks AS (
    SELECT 
        b.UserId,
        SUM(CASE 
                WHEN b.Class = 1 THEN 1000
                WHEN b.Class = 2 THEN 500
                ELSE 100 
            END) AS BadgeScore,
        COUNT(*) FILTER (WHERE b.TagBased = TRUE) AS TagBadgeCount,
        COUNT(*) FILTER (WHERE b.TagBased = FALSE) AS NamedBadgeCount
    FROM Badges b
    GROUP BY b.UserId
),

RecentActivity AS (
    SELECT 
        u.Id,
        GREATEST(
            COALESCE(u.LastAccessDate, TIMESTAMP '1970-01-01'),
            COALESCE(p.LastActivityDate, TIMESTAMP '1970-01-01'),
            COALESCE(c.CreationDate, TIMESTAMP '1970-01-01')
        ) AS LastActivity
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    GROUP BY u.Id, u.LastAccessDate
),

-- Expand Tags into rows without UNNEST to be more portable
TagUsage AS (
    SELECT 
        p.OwnerUserId AS UserId,
        TRIM(tag) AS Tag,
        COUNT(*) AS Uses
    FROM Posts p
    CROSS JOIN LATERAL (
        -- split tags like '<tag1><tag2>' into rows by locating delimiters
        WITH raw AS (SELECT p.Tags AS tags_str)
        SELECT
            CASE
                WHEN pos1 = 0 THEN NULL
                ELSE SUBSTR(tags_str, pos1 + 1, pos2 - pos1 - 1)
            END AS tag
        FROM (
            SELECT
                tags_str,
                -- positions of successive '<' characters; generate series by numbers
                -- emulate a numbers table using recursive CTE
                pos1, pos2
            FROM raw
            CROSS JOIN (
                SELECT n1.pos1, COALESCE(n2.pos2, LENGTH(tags_str)+1) AS pos2
                FROM (
                    SELECT instr(tags_str, '<') AS pos1, tags_str FROM raw
                    UNION ALL
                    SELECT instr(tags_str, '<', instr(tags_str, '<')+1) AS pos1, tags_str FROM raw WHERE instr(tags_str, '<', instr(tags_str, '<')+1) > 0
                ) n1
                LEFT JOIN (
                    SELECT instr(tags_str, '>', n.pos1) AS pos2, n.pos1, tags_str
                    FROM (
                        SELECT instr(tags_str, '<') AS pos1, tags_str FROM raw
                        UNION ALL
                        SELECT instr(tags_str, '<', instr(tags_str, '<')+1) AS pos1, tags_str FROM raw WHERE instr(tags_str, '<', instr(tags_str, '<')+1) > 0
                    ) n
                ) n2 ON n2.pos1 = n1.pos1
            )
            WHERE pos1 > 0
        )
        WHERE tag IS NOT NULL AND tag <> ''
    ) t
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId, TRIM(tag)
),

TopTags AS (
    SELECT 
        tu.UserId,
        STRING_AGG(tu.Tag, ', ' ORDER BY tu.Uses DESC) AS Top3Tags
    FROM (
        SELECT 
            tu.*,
            ROW_NUMBER() OVER (PARTITION BY tu.UserId ORDER BY tu.Uses DESC) AS rn
        FROM TagUsage tu
    ) tu
    WHERE tu.rn <= 3
    GROUP BY tu.UserId
),

Combined AS (
    SELECT 
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.QuestionCount,
        us.AnswerCount,
        COALESCE(br.BadgeScore, 0) AS BadgeScore,
        us.TotalViews,
        us.UpVotesGiven,
        us.DownVotesGiven,
        ra.LastActivity,
        tt.Top3Tags,
        RANK() OVER (ORDER BY us.Reputation + COALESCE(br.BadgeScore, 0) DESC) AS ReputationBadgeRank
    FROM UserStats us
    LEFT JOIN BadgeRanks br ON br.UserId = us.Id
    LEFT JOIN RecentActivity ra ON ra.Id = us.Id
    LEFT JOIN TopTags tt ON tt.UserId = us.Id
)

SELECT *
FROM Combined
WHERE ReputationBadgeRank <= 100

UNION ALL

SELECT 
    CAST(NULL AS INTEGER) AS Id,
    'Aggregated Totals' AS DisplayName,
    SUM(Reputation) AS Reputation,
    SUM(QuestionCount) AS QuestionCount,
    SUM(AnswerCount) AS AnswerCount,
    SUM(BadgeScore) AS BadgeScore,
    SUM(TotalViews) AS TotalViews,
    SUM(UpVotesGiven) AS UpVotesGiven,
    SUM(DownVotesGiven) AS DownVotesGiven,
    MAX(LastActivity) AS LastActivity,
    CAST(NULL AS VARCHAR) AS Top3Tags,
    CAST(NULL AS INTEGER) AS ReputationBadgeRank
FROM Combined

ORDER BY ReputationBadgeRank NULLS LAST, Reputation DESC
LIMIT 101;