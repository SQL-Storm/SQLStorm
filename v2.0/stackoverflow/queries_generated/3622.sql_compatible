WITH RECURSIVE
-- 1. explode tags for every question post
question_tags AS (
    SELECT
        p.Id               AS QuestionId,
        unnest(string_to_array(
                substring(p.Tags FROM 2 FOR length(p.Tags)-2),
                '><'))     AS Tag
    FROM Posts p
    WHERE p.PostTypeId = 1               -- questions only
      AND p.Tags IS NOT NULL
),
-- 2. per‑user basic stats (reputation, creation, last access)
user_base AS (
    SELECT
        u.Id                     AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COALESCE(u.Views, 0)     AS TotalViews,
        COALESCE(u.UpVotes, 0)   AS TotalUpVotes,
        COALESCE(u.DownVotes, 0) AS TotalDownVotes
    FROM Users u
),
-- 3. per‑user badge summary (including users with no badges)
user_badges AS (
    SELECT
        ub.UserId,
        COUNT(*)                                   AS BadgeCount,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges b
    RIGHT JOIN Users ub ON ub.Id = b.UserId
    GROUP BY ub.Id
),
-- 4. per‑user vote summary (up‑votes, down‑votes, favorites)
user_votes AS (
    SELECT
        v.UserId,
        SUM(CASE WHEN vt.Id = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
        SUM(CASE WHEN vt.Id = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
        SUM(CASE WHEN vt.Id = 5 THEN 1 ELSE 0 END) AS FavoriteCount
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    GROUP BY v.UserId
),
-- 5. per‑user answer statistics, correlated subquery to fetch latest answer activity
user_answers AS (
    SELECT
        a.OwnerUserId                               AS UserId,
        COUNT(*)                                    AS AnswerCount,
        SUM(a.Score)                                AS AnswerScoreSum,
        MAX(a.CreationDate)                         AS LastAnswerDate,
        MAX(a.LastActivityDate)                     AS LastAnswerActivity,
        -- latest accepted answer per user (correlated subquery)
        (SELECT MAX(p2.Id)
         FROM Posts p2
         WHERE p2.PostTypeId = 2                -- answer
           AND p2.OwnerUserId = a.OwnerUserId
           AND p2.Id = p2.AcceptedAnswerId)      AS LatestAcceptedAnswerId
    FROM Posts a
    WHERE a.PostTypeId = 2                     -- answers only
    GROUP BY a.OwnerUserId
),
-- 6. per‑user question statistics, including tag diversity
user_questions AS (
    SELECT
        q.OwnerUserId                                   AS UserId,
        COUNT(*)                                        AS QuestionCount,
        SUM(q.Score)                                    AS QuestionScoreSum,
        MAX(q.CreationDate)                             AS LastQuestionDate,
        MAX(q.LastActivityDate)                         AS LastQuestionActivity,
        COUNT(DISTINCT qt.Tag)                          AS DistinctTagCount,
        -- most frequent tag for the user (correlated subquery)
        (SELECT qt2.Tag
         FROM question_tags qt2
         WHERE qt2.QuestionId IN (
               SELECT p2.Id
               FROM Posts p2
               WHERE p2.OwnerUserId = q.OwnerUserId
                 AND p2.PostTypeId = 1)
         GROUP BY qt2.Tag
         ORDER BY COUNT(*) DESC
         LIMIT 1)                                      AS TopTag
    FROM Posts q
    LEFT JOIN question_tags qt ON qt.QuestionId = q.Id
    WHERE q.PostTypeId = 1                     -- questions only
    GROUP BY q.OwnerUserId
),
-- 7. combine question and answer stats; users without activity still appear
user_activity AS (
    SELECT
        ub.UserId,
        ub.DisplayName,
        ub.Reputation,
        ub.TotalViews,
        ub.TotalUpVotes,
        ub.TotalDownVotes,
        COALESCE(ubd.BadgeCount,0)          AS BadgeCount,
        COALESCE(ubd.GoldBadges,0)           AS GoldBadges,
        COALESCE(ubd.SilverBadges,0)         AS SilverBadges,
        COALESCE(ubd.BronzeBadges,0)         AS BronzeBadges,
        COALESCE(uv.UpVoteCount,0)           AS PostUpVotes,
        COALESCE(uv.DownVoteCount,0)         AS PostDownVotes,
        COALESCE(uv.FavoriteCount,0)         AS PostFavorites,
        COALESCE(ua.AnswerCount,0)           AS AnswerCount,
        COALESCE(ua.AnswerScoreSum,0)        AS AnswerScoreSum,
        ua.LastAnswerDate,
        ua.LastAnswerActivity,
        ua.LatestAcceptedAnswerId,
        COALESCE(uq.QuestionCount,0)         AS QuestionCount,
        COALESCE(uq.QuestionScoreSum,0)      AS QuestionScoreSum,
        uq.LastQuestionDate,
        uq.LastQuestionActivity,
        COALESCE(uq.DistinctTagCount,0)      AS DistinctTagCount,
        uq.TopTag
    FROM user_base ub
    LEFT JOIN user_badges ubd      ON ubd.UserId = ub.UserId
    LEFT JOIN user_votes uv        ON uv.UserId = ub.UserId
    LEFT JOIN user_answers ua      ON ua.UserId = ub.UserId
    LEFT JOIN user_questions uq    ON uq.UserId = ub.UserId
),
-- 8. final ranking using window functions
ranked_users AS (
    SELECT
        ua.UserId,
        ua.DisplayName,
        ua.Reputation,
        ua.TotalViews,
        ua.TotalUpVotes,
        ua.TotalDownVotes,
        ua.BadgeCount,
        ua.GoldBadges,
        ua.SilverBadges,
        ua.BronzeBadges,
        ua.PostUpVotes,
        ua.PostDownVotes,
        ua.PostFavorites,
        ua.AnswerCount,
        ua.AnswerScoreSum,
        ua.LastAnswerDate,
        ua.LastAnswerActivity,
        ua.LatestAcceptedAnswerId,
        ua.QuestionCount,
        ua.QuestionScoreSum,
        ua.LastQuestionDate,
        ua.LastQuestionActivity,
        ua.DistinctTagCount,
        ua.TopTag,
        ROW_NUMBER() OVER (ORDER BY ua.Reputation DESC, (ua.AnswerScoreSum + ua.QuestionScoreSum) DESC) AS RankByRepScore,
        RANK()       OVER (ORDER BY ua.AnswerCount DESC)                                               AS RankByAnswers,
        DENSE_RANK() OVER (ORDER BY ua.DistinctTagCount DESC)                              AS RankByTagDiversity
    FROM user_activity ua
    WHERE ua.Reputation IS NOT NULL
)
-- 9. union two perspectives: top 10 by reputation and top 10 by answer count
SELECT *
FROM (
    SELECT *
    FROM ranked_users
    WHERE RankByRepScore <= 10
    UNION ALL
    SELECT *
    FROM ranked_users
    WHERE RankByAnswers <= 10
) AS final_set
ORDER BY RankByRepScore NULLS LAST, RankByAnswers NULLS LAST;