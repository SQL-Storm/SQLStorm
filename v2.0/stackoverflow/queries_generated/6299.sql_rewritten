-- {"query": "6299.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 396} 
SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class,
    t.TagName,
    ph.RevisionGUID,
    ph.Comment,
    CASE 
        WHEN ph.PostHistoryTypeId = 10 THEN cr.Name
        ELSE NULL
    END AS CloseReason
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Tags t ON p.Id = t.ExcerptPostId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    CloseReasonTypes cr ON ph.Comment = CAST(cr.Id AS varchar)
WHERE 
    p.PostTypeId IN (1, 2)
    AND u.Reputation > 1000
    AND p.LastEditDate > p.CreationDate
    AND p.Score > 0
    AND (ph.PostHistoryTypeId IN (1, 2, 4, 5) OR ph.PostHistoryTypeId IS NULL)
GROUP BY 
    u.Id, b.Class
HAVING 
    COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (4, 5) THEN ph.PostId END) > 1
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;