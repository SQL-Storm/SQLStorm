WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        1 AS Level,
        ARRAY[t.TagName] AS TagPath
    FROM Tags t
    WHERE t.IsRequired = 1

    UNION ALL

    SELECT
        t2.Id,
        t2.TagName,
        t2.ExcerptPostId,
        t2.WikiPostId,
        t2.IsModeratorOnly,
        t2.IsRequired,
        r.Level + 1 AS Level,
        r.TagPath || t2.TagName
    FROM Tags t2
    JOIN RecursiveTagHierarchy r ON t2.Id <> r.Id AND t2.IsRequired = 1
    WHERE NOT t2.TagName = ANY(r.TagPath)
),
UserQuestionStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsPosted,
        COUNT(DISTINCT a.Id) FILTER (WHERE a.PostTypeId = 2) AS AnswersPosted,
        COUNT(DISTINCT b.Id) AS BadgesEarned,
        COALESCE(SUM(v.UpVotes),0) AS TotalUpVotes,
        COALESCE(SUM(v.DownVotes),0) AS TotalDownVotes,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) DESC) AS QRank
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    LEFT JOIN Posts a ON a.OwnerUserId = u.Id AND a.PostTypeId = 2
    LEFT JOIN Badges b ON b.UserId = u.Id
    LEFT JOIN (
        SELECT
            p.OwnerUserId,
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN Posts p ON p.Id = v.PostId
        GROUP BY p.OwnerUserId
    ) v ON v.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
PostComplexInfo AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        p.ParentId,
        p.Title,
        p.ClosedDate,
        COUNT(DISTINCT c.Id) AS CommentsCount,
        COUNT(DISTINCT ph.Id) FILTER (WHERE ph.PostHistoryTypeId = 10) AS CloseVotesCount,
        COUNT(DISTINCT ph.Id) FILTER (WHERE ph.PostHistoryTypeId = 11) AS ReopenVotesCount,
        COUNT(DISTINCT pl.Id) FILTER (WHERE lt.Name = 'Duplicate') AS DuplicateLinksCount,
        COUNT(DISTINCT pl.Id) FILTER (WHERE lt.Name = 'Linked') AS LinkedPostsCount,
        MAX(ph.CreationDate) AS LastHistoryChange,
        MAX(v.CreationDate) AS LastVoteDate,
        (SELECT COUNT(*) FROM Comments c2 WHERE c2.PostId = p.Id AND c2.Score > 5) AS HighScoreComments,
        CASE
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Answered'
            ELSE 'Open'
        END AS PostStatus
    FROM Posts p
    LEFT JOIN Comments c ON c.PostId = p.Id
    LEFT JOIN PostHistory ph ON ph.PostId = p.Id
    LEFT JOIN PostLinks pl ON pl.PostId = p.Id
    LEFT JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    LEFT JOIN Votes v ON v.PostId = p.Id
    GROUP BY p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.Tags, p.OwnerUserId, p.AcceptedAnswerId, p.ParentId, p.Title, p.ClosedDate
),
FilteredTopPosts AS (
    SELECT
        pci.*,
        us.DisplayName AS OwnerName,
        us.Reputation AS OwnerReputation,
        us.Id AS OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY pci.PostTypeId ORDER BY pci.Score DESC, pci.ViewCount DESC) AS ScoreRank
    FROM PostComplexInfo pci
    LEFT JOIN Users us ON us.Id = pci.OwnerUserId
    WHERE pci.PostTypeId IN (1,2)
      AND pci.Score > 10 
      AND pci.ViewCount > 1000
      AND pci.PostStatus = 'Open'
),
AnswerWithQuestionInfo AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.Score AS AnswerScore,
        q.Score AS QuestionScore,
        q.Title,
        q.Tags,
        q.OwnerUserId AS QuestionOwner,
        a.OwnerUserId AS AnswerOwner,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = a.Id AND (c.Score >= 3 OR c.Text LIKE '%help%')) AS HelpfulComments,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC) AS AnswerRankPerQuestion
    FROM Posts a
    JOIN Posts q ON q.Id = a.ParentId AND q.PostTypeId = 1
    WHERE a.PostTypeId = 2
),
RecentEditorsCTE AS (
    SELECT
        ph.PostId,
        ph.UserId AS EditorUserId,
        u.DisplayName AS EditorName,
        ph.CreationDate AS EditDate,
        ph.PostHistoryTypeId,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS EditRank
    FROM PostHistory ph
    LEFT JOIN Users u ON u.Id = ph.UserId
    WHERE ph.PostHistoryTypeId IN (4,5,6)
),
CombinedPosts AS (
    SELECT
        ftp.Id AS PostId,
        ftp.PostTypeId,
        ftp.Title,
        ftp.Tags,
        ftp.Score,
        ftp.ViewCount,
        ftp.OwnerUserId,
        us.DisplayName AS OwnerDisplayName,
        us.Reputation AS OwnerReputation,
        ftp.CloseVotesCount,
        ftp.ReopenVotesCount,
        ftp.DuplicateLinksCount,
        ftp.LinkedPostsCount,
        ace.EditCount,
        ace.LastEditDate,
        ac.HighScoreComments,
        ace.LastEditorName,
        ftp.ClosedDate
    FROM FilteredTopPosts ftp
    LEFT JOIN (
        SELECT
            PostId,
            COUNT(*) AS EditCount,
            MAX(EditDate) AS LastEditDate,
            MAX(CASE WHEN EditRank = 1 THEN EditorName END) AS LastEditorName
        FROM RecentEditorsCTE
        GROUP BY PostId
    ) ace ON ace.PostId = ftp.Id
    LEFT JOIN PostComplexInfo ac ON ac.Id = ftp.Id
    LEFT JOIN Users us ON us.Id = ftp.OwnerUserId
)
SELECT DISTINCT
    cp.PostId,
    cp.Title,
    cp.Tags,
    cp.Score,
    cp.ViewCount,
    cp.OwnerDisplayName,
    cp.OwnerReputation,
    cp.CloseVotesCount,
    cp.ReopenVotesCount,
    cp.DuplicateLinksCount,
    cp.LinkedPostsCount,
    cp.EditCount,
    cp.LastEditDate,
    cp.LastEditorName,
    cp.HighScoreComments,
    uts.QuestionsPosted,
    uts.AnswersPosted,
    uts.BadgesEarned,
    uts.TotalUpVotes,
    uts.TotalDownVotes,
    uts.QRank,
    (CASE WHEN cp.Tags IS NOT NULL THEN regexp_split_to_array(trim(BOTH '<>' FROM cp.Tags), '><') ELSE ARRAY[]::text[] END) AS TagArray,
    (
        SELECT string_agg(DISTINCT t2.TagName, ', ')
        FROM Tags t2
        WHERE t2.TagName = ANY(
            CASE WHEN cp.Tags IS NOT NULL THEN regexp_split_to_array(trim(BOTH '<>' FROM cp.Tags), '><') ELSE ARRAY[]::text[] END
        )
          AND t2.IsModeratorOnly = 0
          AND t2.IsRequired = 1
    ) AS RequiredTags,
    awq.AnswerId,
    awq.AnswerScore,
    awq.HelpfulComments,
    awq.AnswerRankPerQuestion,
    CASE 
        WHEN uts.QuestionsPosted = 0 THEN NULL
        ELSE ROUND(cp.Score::NUMERIC / NULLIF(uts.QuestionsPosted,0), 2)
    END AS AvgScorePerQuestion,
    CASE
        WHEN (uts.TotalUpVotes + uts.TotalDownVotes) = 0 THEN NULL
        ELSE ROUND(uts.TotalUpVotes::NUMERIC / (uts.TotalUpVotes + uts.TotalDownVotes), 3)
    END AS UpvoteRatio,
    CASE
        WHEN cp.ClosedDate IS NULL THEN FALSE
        ELSE TRUE
    END AS IsClosed
FROM CombinedPosts cp
LEFT JOIN UserQuestionStats uts ON uts.UserId = cp.OwnerUserId
LEFT JOIN AnswerWithQuestionInfo awq ON awq.QuestionId = cp.PostId AND awq.AnswerRankPerQuestion = 1
WHERE cp.OwnerReputation > 1000
AND (cp.EditCount > 0 OR cp.CloseVotesCount > 0)
AND (
    (cp.Tags IS NOT NULL AND cp.Tags LIKE '%sql%')
    OR (cp.Title ILIKE '%performance%')
)
ORDER BY cp.Score DESC, cp.ViewCount DESC
LIMIT 100

UNION ALL

SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.Score,
    p.ViewCount,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation AS OwnerReputation,
    0 AS CloseVotesCount,
    0 AS ReopenVotesCount,
    0 AS DuplicateLinksCount,
    0 AS LinkedPostsCount,
    0 AS EditCount,
    NULL AS LastEditDate,
    NULL AS LastEditorName,
    0 AS HighScoreComments,
    0 AS QuestionsPosted,
    0 AS AnswersPosted,
    0 AS BadgesEarned,
    0 AS TotalUpVotes,
    0 AS TotalDownVotes,
    0 AS QRank,
    ARRAY[]::text[] AS TagArray,
    NULL AS RequiredTags,
    NULL AS AnswerId,
    NULL AS AnswerScore,
    NULL AS HelpfulComments,
    NULL AS AnswerRankPerQuestion,
    NULL AS AvgScorePerQuestion,
    NULL AS UpvoteRatio,
    FALSE AS IsClosed
FROM Posts p
LEFT JOIN Users u ON u.Id = p.OwnerUserId
WHERE p.PostTypeId = 3
AND p.Score > 50
AND (p.Title ILIKE '%optimization%' OR p.Body ILIKE '%optimize%')
ORDER BY p.Score DESC, p.ViewCount DESC
LIMIT 50;