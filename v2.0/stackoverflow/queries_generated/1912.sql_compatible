WITH UserInteractionMetrics AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        u.Views AS UserProfileViews,
        u.UpVotes AS UserUpVotes,
        u.DownVotes AS UserDownVotes,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END), 0) AS TotalQuestionsPosted,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END), 0) AS TotalAnswersPosted,
        COALESCE(SUM(CASE WHEN p.PostTypeId IN (1, 2) THEN p.Score ELSE 0 END), 0) AS TotalPostScores,
        COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE 0 END), 0) AS TotalQuestionViewCount,
        COUNT(DISTINCT c.Id) AS TotalCommentsMade,
        COUNT(DISTINCT b.Id) AS TotalBadgesEarned,
        MAX(p.CreationDate) AS LatestPostDate,
        MIN(p.CreationDate) AS EarliestPostDate,
        (EXTRACT(EPOCH FROM (u.LastAccessDate - u.CreationDate)) / 86400) AS UserAccountAgeDays,
        (EXTRACT(EPOCH FROM (CAST('2024-10-01' AS date) - u.LastAccessDate)) / 86400) AS DaysSinceLastAccess
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY
        u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate,
        u.Views, u.UpVotes, u.DownVotes
),
PostActivityTimelines AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount AS PostViewCount,
        p.AnswerCount AS PostAnswerCount,
        p.CommentCount AS PostCommentCount,
        p.AcceptedAnswerId,
        p.ClosedDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId, p.PostTypeId ORDER BY p.Score DESC, p.CreationDate DESC) AS PostScoreRankByOwnerAndType,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) AS AvgOwnerPostScore,
        EXTRACT(EPOCH FROM (p.CreationDate - LAG(p.CreationDate, 1, p.CreationDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate))) / 86400 AS DaysSincePreviousPost,
        CASE
            WHEN p.Tags IS NOT NULL AND CHAR_LENGTH(p.Tags) > 2
            THEN LOWER(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2))
            ELSE NULL
        END AS RawTagsString,
        (SELECT COUNT(DISTINCT ph.Id) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4,5,6)) AS EditCount,
        (SELECT COUNT(DISTINCT v.Id) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS UpVoteCount,
        (SELECT COUNT(DISTINCT v.Id) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS DownVoteCount
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL
),
TagMetrics AS (
    SELECT
        te.PostId,
        STRING_AGG(te.TagName, ';') AS AllProcessedTags,
        COUNT(te.TagName) AS NumberOfTags,
        SUM(t.Count) AS TotalTagPopularityScore
    FROM (
        SELECT
            p.Id AS PostId,
            LOWER(TRIM(UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags) - 2), '><')))) AS TagName
        FROM Posts p
        WHERE p.Tags IS NOT NULL AND CHAR_LENGTH(p.Tags) > 2 AND p.PostTypeId = 1
    ) AS te
    JOIN Tags t ON te.TagName = t.TagName
    GROUP BY te.PostId
),
AcceptedAnswerDetails AS (
    SELECT
        p_q.Id AS QuestionId,
        p_a.Id AS AcceptedAnswerId,
        p_a.OwnerUserId AS AcceptedAnswererId,
        p_a.Score AS AcceptedAnswerScore,
        u_a.Reputation AS AcceptedAnswererReputation,
        p_a.CreationDate AS AcceptedAnswerCreationDate,
        (
            SELECT AVG(p_other.Score)
            FROM Posts p_other
            WHERE p_other.OwnerUserId = p_a.OwnerUserId
              AND p_other.PostTypeId = 2
              AND p_other.Id != p_a.Id
        ) AS AvgOtherAnswererScore
    FROM Posts p_q
    JOIN Posts p_a ON p_q.AcceptedAnswerId = p_a.Id
    JOIN Users u_a ON p_a.OwnerUserId = u_a.Id
    WHERE p_q.PostTypeId = 1 AND p_a.PostTypeId = 2
)
SELECT
    uim.UserId,
    uim.DisplayName,
    uim.Reputation,
    uim.UserCreationDate,
    uim.LastAccessDate,
    uim.UserAccountAgeDays,
    uim.DaysSinceLastAccess,
    uim.UserProfileViews,
    uim.UserUpVotes,
    uim.UserDownVotes,
    uim.TotalQuestionsPosted,
    uim.TotalAnswersPosted,
    uim.TotalCommentsMade,
    uim.TotalBadgesEarned,
    uim.TotalPostScores,
    uim.TotalQuestionViewCount,
    pat.PostId AS QuestionId,
    pat.PostCreationDate AS QuestionCreationDate,
    pat.PostScore AS QuestionScore,
    pat.PostViewCount AS QuestionViewCount,
    pat.PostAnswerCount AS QuestionAnswerCount,
    pat.PostCommentCount AS QuestionCommentCount,
    pat.EditCount AS QuestionEditCount,
    pat.UpVoteCount AS QuestionUpVoteCount,
    pat.DownVoteCount AS QuestionDownVoteCount,
    pat.PostScoreRankByOwnerAndType AS QuestionRankByOwnerScore,
    pat.AvgOwnerPostScore,
    pat.DaysSincePreviousPost,
    (EXTRACT(EPOCH FROM (CAST('2024-10-01' AS date) - pat.PostCreationDate)) / 86400) AS QuestionAgeDays,
    NULLIF(pat.PostScore * 1.0 / GREATEST(1, pat.PostViewCount), 0) AS ScoreToViewRatio,
    NULLIF(pat.PostAnswerCount * 1.0 / GREATEST(1, pat.PostCommentCount), 0) AS AnswerToCommentRatio,
    (
        SELECT ph.CreationDate
        FROM PostHistory ph
        WHERE ph.PostId = pat.PostId
          AND ph.PostHistoryTypeId = 10
        ORDER BY ph.CreationDate DESC
        LIMIT 1
    ) AS LastClosedDate,
    (
        SELECT crt.Name
        FROM PostHistory ph
        JOIN CloseReasonTypes crt ON CAST(ph.Comment AS INTEGER) = crt.Id
        WHERE ph.PostId = pat.PostId
          AND ph.PostHistoryTypeId = 10
        ORDER BY ph.CreationDate DESC
        LIMIT 1
    ) AS LastCloseReason,
    CASE WHEN pat.ClosedDate IS NOT NULL THEN TRUE ELSE FALSE END AS IsQuestionClosed,
    tm.AllProcessedTags,
    tm.NumberOfTags,
    tm.TotalTagPopularityScore,
    aad.AcceptedAnswerId,
    aad.AcceptedAnswererId,
    aad.AcceptedAnswerScore,
    aad.AcceptedAnswererReputation,
    aad.AcceptedAnswerCreationDate,
    aad.AvgOtherAnswererScore,
    CASE
        WHEN uim.Reputation >= 10000 THEN 'Legendary'
        WHEN uim.Reputation >= 5000 THEN 'Expert'
        WHEN uim.Reputation >= 1000 THEN 'Advanced'
        WHEN uim.Reputation >= 200 THEN 'Contributor'
        ELSE 'Newbie'
    END AS ReputationTier,
    CONCAT(
        'User: ', COALESCE(uim.DisplayName, 'Anonymous'),
        ' | Question: ', COALESCE(p.Title, 'No Title'),
        ' (Score: ', pat.PostScore, ')'
    ) AS CombinedInfoString,
    COALESCE(
        p.LastEditorDisplayName,
        (SELECT u_editor.DisplayName FROM Users u_editor WHERE u_editor.Id = p.LastEditorUserId LIMIT 1),
        'Community'
    ) AS EffectiveLastEditorDisplayName
FROM UserInteractionMetrics uim
JOIN PostActivityTimelines pat ON uim.UserId = pat.OwnerUserId
JOIN Posts p ON pat.PostId = p.Id AND p.PostTypeId = 1
LEFT JOIN TagMetrics tm ON pat.PostId = tm.PostId
LEFT JOIN AcceptedAnswerDetails aad ON pat.PostId = aad.QuestionId
WHERE
    uim.TotalQuestionsPosted > 0
    AND pat.PostCreationDate >= DATE '2020-01-01'
    AND pat.DaysSincePreviousPost IS NOT NULL
    AND (pat.PostScore > 10 OR pat.PostViewCount > 500)
    AND (
        (uim.DisplayName IS NOT NULL AND uim.DisplayName LIKE '%User%')
        OR (uim.Reputation > 5000 AND uim.TotalBadgesEarned > 50)
        OR (pat.RawTagsString LIKE '%sql%' AND pat.PostScore > 50)
    )

UNION ALL

SELECT
    uim.UserId,
    uim.DisplayName,
    uim.Reputation,
    uim.UserCreationDate,
    uim.LastAccessDate,
    uim.UserAccountAgeDays,
    uim.DaysSinceLastAccess,
    uim.UserProfileViews,
    uim.UserUpVotes,
    uim.UserDownVotes,
    uim.TotalQuestionsPosted,
    uim.TotalAnswersPosted,
    uim.TotalCommentsMade,
    uim.TotalBadgesEarned,
    uim.TotalPostScores,
    uim.TotalQuestionViewCount,
    pat.PostId AS AnswerId,
    pat.PostCreationDate AS AnswerCreationDate,
    pat.PostScore AS AnswerScore,
    pat.PostViewCount AS AnswerViewCount,
    pat.PostAnswerCount AS AnswerCount,
    pat.PostCommentCount AS AnswerCommentCount,
    pat.EditCount AS AnswerEditCount,
    pat.UpVoteCount AS AnswerUpVoteCount,
    pat.DownVoteCount AS AnswerDownVoteCount,
    pat.PostScoreRankByOwnerAndType AS AnswerRankByOwnerScore,
    pat.AvgOwnerPostScore,
    pat.DaysSincePreviousPost,
    (EXTRACT(EPOCH FROM (CAST('2024-10-01' AS date) - pat.PostCreationDate)) / 86400) AS AnswerAgeDays,
    NULLIF(pat.PostScore * 1.0 / GREATEST(1, pat.PostViewCount), 0) AS ScoreToViewRatio,
    NULLIF(pat.PostAnswerCount * 1.0 / GREATEST(1, pat.PostCommentCount), 0) AS AnswerToCommentRatio,
    NULL AS LastClosedDate,
    NULL AS LastCloseReason,
    FALSE AS IsQuestionClosed,
    NULL AS AllProcessedTags,
    0 AS NumberOfTags,
    0 AS TotalTagPopularityScore,
    NULL AS AcceptedAnswerId,
    NULL AS AcceptedAnswererId,
    NULL AS AcceptedAnswerScore,
    NULL AS AcceptedAnswererReputation,
    NULL AS AcceptedAnswerCreationDate,
    NULL AS AvgOtherAnswererScore,
    CASE
        WHEN uim.Reputation >= 10000 THEN 'Legendary'
        WHEN uim.Reputation >= 5000 THEN 'Expert'
        WHEN uim.Reputation >= 1000 THEN 'Advanced'
        WHEN uim.Reputation >= 200 THEN 'Contributor'
        ELSE 'Newbie'
    END AS ReputationTier,
    CONCAT(
        'User: ', COALESCE(uim.DisplayName, 'Anonymous'),
        ' | Answer (to Post ', pat.PostId, '): ',
        SUBSTRING(COALESCE(p.Body, 'No Body') FROM 1 FOR 50), '...'
    ) AS CombinedInfoString,
    COALESCE(
        p.LastEditorDisplayName,
        (SELECT u_editor.DisplayName FROM Users u_editor WHERE u_editor.Id = p.LastEditorUserId LIMIT 1),
        'Community'
    ) AS EffectiveLastEditorDisplayName
FROM UserInteractionMetrics uim
JOIN PostActivityTimelines pat ON uim.UserId = pat.OwnerUserId
JOIN Posts p ON pat.PostId = p.Id AND p.PostTypeId = 2
WHERE
    uim.TotalAnswersPosted > 0
    AND pat.PostCreationDate >= DATE '2020-01-01'
    AND pat.DaysSincePreviousPost IS NOT NULL
    AND pat.PostScore > 5
    AND (
        p.Body LIKE '%solution%' OR p.Body LIKE '%fix%'
        OR uim.Reputation > 2000
    )
ORDER BY
    Reputation DESC,
    QuestionCreationDate DESC,
    AnswerCreationDate DESC
LIMIT 10000;