WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        CAST((EXTRACT(EPOCH FROM TIMESTAMP '2024-10-01 12:34:56') - EXTRACT(EPOCH FROM u.CreationDate)) / 86400 AS INTEGER) as AccountAgeDays,
        CASE 
            WHEN u.Reputation >= 1000000 THEN 'Legendary'
            WHEN u.Reputation >= 100000 THEN 'Godlike'
            WHEN u.Reputation >= 10000 THEN 'Master'
            WHEN u.Reputation >= 1000 THEN 'Expert'
            WHEN u.Reputation >= 100 THEN 'Intermediate'
            ELSE 'Beginner'
        END as ReputationTier,
        LAG(u.Reputation, 1, 0) OVER (ORDER BY u.Reputation DESC) - u.Reputation as RepDifferenceFromNext
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.CreationDate
),
TopPosts AS (
    SELECT 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.ParentId,
        p.PostTypeId,
        p.Tags,
        DENSE_RANK() OVER (ORDER BY p.Score DESC) as ScoreRank,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) as TypeScoreRank,
        NTILE(10) OVER (ORDER BY p.Score DESC) as ScoreDecile,
        AVG(p.Score) OVER (PARTITION BY p.PostTypeId) as AvgScoreByType,
        LAG(p.Score, 1, 0) OVER (ORDER BY p.Score DESC) - p.Score as ScoreDifferenceFromNext,
        CASE 
            WHEN p.Score >= 1000 THEN 'Epic'
            WHEN p.Score >= 100 THEN 'Great'
            WHEN p.Score >= 10 THEN 'Good'
            WHEN p.Score >= 1 THEN 'Average'
            ELSE 'Poor'
        END as ScoreCategory,
        REPLACE(REPLACE(p.Tags, '<', ''), '>', '') as CleanTags,
        STRING_AGG(p.Tags, '; ' ORDER BY p.CreationDate DESC) as TagHistory
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) 
    AND p.Score IS NOT NULL
    AND p.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '1 year')
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, p.OwnerUserId, p.ParentId, p.PostTypeId, p.Tags
),
PostAnalysis AS (
    SELECT 
        tp.Id,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        tp.CreationDate,
        tp.OwnerUserId,
        tp.ParentId,
        tp.PostTypeId,
        tp.Tags,
        tp.ScoreRank,
        tp.TypeScoreRank,
        tp.ScoreDecile,
        tp.AvgScoreByType,
        tp.ScoreDifferenceFromNext,
        tp.ScoreCategory,
        tp.CleanTags,
        tp.TagHistory,
        CASE 
            WHEN tp.ViewCount > 0 THEN ROUND(CAST(tp.Score AS numeric) / NULLIF(CAST(tp.ViewCount AS numeric),0) * 100, 2)
            ELSE 0 
        END as ScorePerView,
        CASE 
            WHEN (EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56')) - EXTRACT(EPOCH FROM tp.CreationDate)) / 86400 > 0 THEN 
                ROUND(CAST(tp.Score AS numeric) / ((EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56')) - EXTRACT(EPOCH FROM tp.CreationDate)) / 86400), 2)
            ELSE tp.Score 
        END as ScorePerDay,
        CASE 
            WHEN EXISTS (SELECT 1 FROM Posts WHERE ParentId = tp.Id AND PostTypeId = 2 AND Score > 0) THEN 1
            ELSE 0
        END as HasAcceptedAnswers,
        COALESCE(
            (SELECT COUNT(*) FROM Comments c WHERE c.PostId = tp.Id AND c.Score > 0),
            0
        ) as PositiveComments,
        COALESCE(
            (SELECT COUNT(*) FROM Posts p WHERE p.ParentId = tp.Id AND p.PostTypeId = 2 AND p.Score > 0),
            0
        ) as AnswerCountScored
    FROM TopPosts tp
    GROUP BY tp.Id, tp.Title, tp.Score, tp.ViewCount, tp.CreationDate, tp.OwnerUserId, tp.ParentId, tp.PostTypeId, tp.Tags, tp.ScoreRank, tp.TypeScoreRank, tp.ScoreDecile, tp.AvgScoreByType, tp.ScoreDifferenceFromNext, tp.ScoreCategory, tp.CleanTags, tp.TagHistory
),
TagStats AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        STRING_AGG(CASE WHEN p.PostTypeId = 1 THEN p.Title END, '; ' ORDER BY p.CreationDate DESC) as SampleQuestions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as AnswerCount,
        AVG(CAST(p.Score AS numeric)) as AvgScore,
        MAX(p.Score) as MaxScore,
        MIN(p.Score) as MinScore,
        STRING_AGG(p.Tags, '; ' ORDER BY p.CreationDate DESC) as TagHistory
    FROM Tags t
    LEFT JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    WHERE p.PostTypeId IN (1, 2)
    GROUP BY t.TagName, t.Count, t.ExcerptPostId, t.WikiPostId, t.IsModeratorOnly, t.IsRequired
),
CombinedAnalysis AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Reputation,
        us.Views,
        us.UpVotes,
        us.DownVotes,
        us.TotalPosts,
        us.Questions,
        us.Answers,
        us.Comments,
        us.Badges,
        us.LastPostDate,
        us.AccountAgeDays,
        us.ReputationTier,
        us.RepDifferenceFromNext,
        pa.Id as PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.CreationDate as PostCreationDate,
        pa.PostTypeId,
        pa.Tags,
        pa.ScoreRank,
        pa.TypeScoreRank,
        pa.ScoreDecile,
        pa.AvgScoreByType,
        pa.ScoreDifferenceFromNext,
        pa.ScoreCategory,
        pa.CleanTags,
        pa.ScorePerView,
        pa.ScorePerDay,
        pa.HasAcceptedAnswers,
        pa.PositiveComments,
        pa.AnswerCountScored,
        ts.TagName,
        ts.Count as TagCount,
        ts.QuestionCount,
        ts.AnswerCount,
        ts.AvgScore as TagAvgScore,
        ts.MaxScore as TagMaxScore,
        ts.SampleQuestions,
        CASE 
            WHEN us.Reputation > 100000 AND pa.Score > 50 AND pa.ViewCount > 5000 THEN 'High Impact'
            WHEN us.Reputation > 50000 AND pa.Score > 25 AND pa.ViewCount > 1000 THEN 'Medium Impact'
            WHEN us.Reputation > 10000 AND pa.Score > 10 AND pa.ViewCount > 500 THEN 'Low Impact'
            ELSE 'Regular'
        END as UserPostImpact,
        ROW_NUMBER() OVER (PARTITION BY us.UserId ORDER BY pa.Score DESC) as UserPostRank,
        DENSE_RANK() OVER (ORDER BY pa.Score DESC, us.Reputation DESC) as CombinedRank,
        PERCENT_RANK() OVER (ORDER BY pa.Score DESC) as ScorePercentile,
        CASE 
            WHEN pa.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Above Avg'
            WHEN pa.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Below Avg'
            ELSE 'Average'
        END as ScoreComparison,
        CASE 
            WHEN ts.Count > 100 THEN 'Popular'
            WHEN ts.Count > 50 THEN 'Moderately Popular'
            WHEN ts.Count > 10 THEN 'Less Popular'
            ELSE 'Rare'
        END as PopularityTier,
        CASE 
            WHEN pa.HasAcceptedAnswers = 1 AND pa.AnswerCountScored > 0 THEN 
                ROUND(CAST(pa.AnswerCountScored AS numeric) / NULLIF(CAST(pa.AnswerCountScored AS numeric),0) * 100, 2)
            ELSE 0
        END as AcceptanceRate,
        ( 'User: ' || us.DisplayName
            || ' | Post: ' || pa.Title
            || ' | Score: ' || pa.Score
            || ' | Views: ' || pa.ViewCount
            || ' | Tags: ' || pa.CleanTags
            || ' | Rank: ' || pa.ScoreRank
            || ' | Impact: ' || CASE WHEN us.Reputation > 100000 THEN 'Legendary' ELSE 'Regular' END
        ) as FullAnalysisString
    FROM UserStats us
    LEFT JOIN PostAnalysis pa ON us.UserId = pa.OwnerUserId
    LEFT JOIN TagStats ts ON pa.CleanTags LIKE '%' || ts.TagName || '%'
    WHERE us.Reputation > 1000
    AND pa.Score IS NOT NULL
    GROUP BY 
        us.UserId, us.DisplayName, us.Reputation, us.Views, us.UpVotes, us.DownVotes, us.TotalPosts, us.Questions, us.Answers, us.Comments, us.Badges, us.LastPostDate, us.AccountAgeDays, us.ReputationTier, us.RepDifferenceFromNext,
        pa.Id, pa.Title, pa.Score, pa.ViewCount, pa.CreationDate, pa.OwnerUserId, pa.ParentId, pa.PostTypeId, pa.Tags, pa.ScoreRank, pa.TypeScoreRank, pa.ScoreDecile, pa.AvgScoreByType, pa.ScoreDifferenceFromNext, pa.ScoreCategory, pa.CleanTags, pa.ScorePerView, pa.ScorePerDay, pa.HasAcceptedAnswers, pa.PositiveComments, pa.AnswerCountScored,
        ts.TagName, ts.Count, ts.QuestionCount, ts.AnswerCount, ts.AvgScore, ts.MaxScore, ts.SampleQuestions
),
FinalAggregation AS (
    SELECT 
        COUNT(*) as TotalRecords,
        COUNT(DISTINCT UserId) as UniqueUsers,
        COUNT(DISTINCT PostId) as UniquePosts,
        COUNT(DISTINCT TagName) as UniqueTags,
        AVG(Reputation) as AvgUserReputation,
        AVG(Score) as AvgPostScore,
        AVG(ViewCount) as AvgPostViews,
        MAX(TotalPosts) as MaxUserPosts,
        MIN(RepDifferenceFromNext) as MinRepDiff,
        MAX(ScorePerView) as MaxScorePerView,
        SUM(Badges) as TotalBadges,
        AVG(AnswerCountScored) as AvgAnswerCountScored
    FROM CombinedAnalysis
)
SELECT 
    fa.TotalRecords,
    fa.UniqueUsers,
    fa.UniquePosts,
    fa.UniqueTags,
    fa.AvgUserReputation,
    fa.AvgPostScore,
    fa.AvgPostViews,
    fa.MaxUserPosts,
    fa.MinRepDiff,
    fa.MaxScorePerView,
    fa.TotalBadges,
    fa.AvgAnswerCountScored,
    (
        SELECT STRING_AGG(
            DisplayName || ' (' || Reputation || ' rep) - ' || 
            TotalPosts || ' posts, ' || Questions || ' q, ' || Answers || ' a', '; '
        ) 
        FROM (
            SELECT DisplayName, Reputation, TotalPosts, Questions, Answers
            FROM UserStats 
            WHERE Reputation > 100000
            ORDER BY Reputation DESC
            LIMIT 5
        ) top_users
    ) as TopUsers,
    (
        SELECT STRING_AGG(
            Title || ' (' || Score || ' score) - ' || 
            ViewCount || ' views, ' || CleanTags, '; '
        ) 
        FROM (
            SELECT Title, Score, ViewCount, CleanTags
            FROM PostAnalysis 
            WHERE Score > 100
            ORDER BY Score DESC
            LIMIT 5
        ) top_posts
    ) as TopPosts,
    (
        SELECT STRING_AGG(
            TagName || ' (' || Count || ' uses) - ' || 'Avg Score: ' || ROUND(AvgScore, 2), '; '
        ) 
        FROM (
            SELECT TagName, Count, AvgScore
            FROM TagStats 
            WHERE Count > 50
            ORDER BY Count DESC
            LIMIT 5
        ) top_tags
    ) as TopTags,
    STRING_AGG(
        CASE 
            WHEN UserPostImpact = 'High Impact' THEN 
                DisplayName || ' - ' || Score || ' score - ' || ScorePerView || ' per view'
            ELSE NULL
        END, '; '
    ) as HighImpactUsers,
    (
        SELECT STRING_AGG(
            inner_agg, '| '
        ) 
        FROM (
            SELECT STRING_AGG(
                CASE 
                    WHEN ScoreCat = 'Epic' THEN 
                        UserId || ':' || DisplayName || ' - ' || Score || ' | '
                    ELSE NULL 
                END, ' - '
            ) as inner_agg
            FROM (
                SELECT 
                    ca.UserId,
                    ca.DisplayName,
                    ca.Score,
                    ca.ScoreCategory as ScoreCat,
                    ROW_NUMBER() OVER (PARTITION BY ca.UserId ORDER BY ca.Score DESC) as rn
                FROM CombinedAnalysis ca
                WHERE ca.ScoreCategory = 'Epic'
            ) epic_scores
        ) t
    ) as EpicScoresByUser
FROM FinalAggregation fa
LEFT JOIN CombinedAnalysis ca ON 1 = 1
GROUP BY 
    fa.TotalRecords,
    fa.UniqueUsers,
    fa.UniquePosts,
    fa.UniqueTags,
    fa.AvgUserReputation,
    fa.AvgPostScore,
    fa.AvgPostViews,
    fa.MaxUserPosts,
    fa.MinRepDiff,
    fa.MaxScorePerView,
    fa.TotalBadges,
    fa.AvgAnswerCountScored
HAVING COUNT(*) > 0;