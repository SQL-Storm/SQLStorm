with recent_users as (
    select
        u.id as user_id,
        u.displayname,
        u.reputation,
        u.creationdate,
        u.location,
        date_trunc('month', u.creationdate) as cohort_month,
        row_number() over (order by u.creationdate desc, u.id desc) as rn_global
    from users u
    where u.creationdate >= (select coalesce(max(creationdate), timestamp '2024-10-01 12:34:56') - interval '3 years' from users)
),
user_activity as (
    select
        p.owneruserid as user_id,
        count(*) filter (where p.posttypeid = 1) as q_count,
        count(*) filter (where p.posttypeid = 2) as a_count,
        sum(coalesce(p.score, 0)) as post_score_sum,
        sum(coalesce(p.viewcount, 0)) filter (where p.posttypeid = 1) as q_views_sum,
        max(p.lastactivitydate) as last_activity,
        avg(nullif(p.commentcount, 0)) as avg_commentcount_nonzero
    from posts p
    where p.owneruserid is not null
    group by p.owneruserid
),
user_comment_stats as (
    select
        c.userid as user_id,
        count(*) as comment_count,
        avg(c.score) as avg_comment_score,
        max(c.creationdate) as last_comment_ts
    from comments c
    where c.userid is not null
    group by c.userid
),
user_badges as (
    select
        b.userid as user_id,
        count(*) as badge_count,
        count(*) filter (where b.class = 1) as gold_count,
        count(*) filter (where b.class = 2) as silver_count,
        count(*) filter (where b.class = 3) as bronze_count,
        min(case when b.tagbased = true then b.date end) as first_tagbadge_ts
    from badges b
    group by b.userid
),
votes_agg as (
    select
        v.userid as user_id,
        count(*) filter (where v.votetypeid = 2) as upvotes_made,
        count(*) filter (where v.votetypeid = 3) as downvotes_made,
        count(*) filter (where v.votetypeid = 5) as favorites_made,
        sum(coalesce(v.bountyamount, 0)) filter (where v.votetypeid in (8,9)) as bounty_sum_given,
        min(v.creationdate) as first_vote_ts
    from votes v
    where v.userid is not null
    group by v.userid
),
post_scores as (
    select
        p.id,
        p.owneruserid as user_id,
        p.posttypeid,
        p.score,
        p.viewcount,
        p.creationdate,
        coalesce(p.favoritecount, 0) as favoritecount,
        case when p.posttypeid = 1 then 1 else 0 end as is_question
    from posts p
),
question_answer_links as (
    select
        q.id as question_id,
        a.id as answer_id,
        a.owneruserid as answerer_id,
        q.owneruserid as asker_id,
        a.score as answer_score,
        q.score as question_score,
        q.acceptedanswerid,
        case when q.acceptedanswerid = a.id then 1 else 0 end as is_accepted
    from posts q
    join posts a on a.parentid = q.id and a.posttypeid = 2
    where q.posttypeid = 1
),
user_q_a_perf as (
    select
        qal.answerer_id as user_id,
        count(*) as answers_posted,
        sum(is_accepted) as accepted_answers,
        avg(qal.answer_score) as avg_answer_score,
        percentile_cont(0.5) within group (order by qal.answer_score) as p50_answer_score,
        count(distinct qal.question_id) filter (where qal.is_accepted = 1) as accepted_questions_covered,
        avg(qal.question_score) as avg_target_question_score
    from question_answer_links qal
    group by qal.answerer_id
),
tag_extract as (
    select
        p.id as post_id,
        p.owneruserid as user_id,
        unnest(string_to_array(substring(p.tags, 2, length(p.tags)-2), '><')) as tag
    from posts p
    where p.posttypeid = 1 and p.tags is not null and length(p.tags) > 2
),
user_top_tag as (
    select user_id, tag, cnt, rn
    from (
        select
            t.user_id,
            t.tag,
            count(*) as cnt,
            row_number() over (partition by t.user_id order by count(*) desc, min(t.post_id)) as rn
        from tag_extract t
        group by t.user_id, t.tag
    ) s
    where rn = 1
),
postlink_dups as (
    select
        pl.postid as post_id,
        count(*) filter (where pl.linktypeid = 3) as dup_links
    from postlinks pl
    group by pl.postid
),
close_events as (
    select
        ph.postid,
        ph.userid as closer_user_id,
        ph.creationdate as close_ts,
        ph.comment as close_reason_id_text,
        cast(nullif(ph.comment, '') as integer) as close_reason_id
    from posthistory ph
    where ph.posthistorytypeid = 10
),
user_close_impact as (
    select
        u.id as user_id,
        count(distinct ce.postid) as closes_associated_to_user_posts,
        count(*) filter (where ce.close_reason_id = 101) as closes_as_duplicate_on_user_posts
    from users u
    left join posts p on p.owneruserid = u.id
    left join close_events ce on ce.postid = p.id
    group by u.id
),
post_engagement as (
    select
        p.owneruserid as user_id,
        sum(case when v.votetypeid = 2 then 1 else 0 end) as received_upvotes,
        sum(case when v.votetypeid = 3 then 1 else 0 end) as received_downvotes,
        sum(case when v.votetypeid = 5 then 1 else 0 end) as received_favorites,
        sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounties_on_user_posts
    from posts p
    left join votes v on v.postid = p.id
    where p.owneruserid is not null
    group by p.owneruserid
),
recent_q_views as (
    select
        p.owneruserid as user_id,
        sum(p.viewcount) as recent_views_90d
    from posts p
    where p.posttypeid = 1
      and p.creationdate >= timestamp '2024-10-01 12:34:56' - interval '90 days'
    group by p.owneruserid
),
user_rank as (
    select
        u.id as user_id,
        dense_rank() over (order by coalesce(ua.post_score_sum,0) + coalesce(pe.received_upvotes,0)*2 - coalesce(pe.received_downvotes,0) desc, u.reputation desc, u.id) as activity_rank
    from users u
    left join user_activity ua on ua.user_id = u.id
    left join post_engagement pe on pe.user_id = u.id
),
heavy_calc as (
    select
        u.id as user_id,
        sqrt(greatest(0, coalesce(ua.post_score_sum,0))) as sqrt_post_score,
        ln(1 + coalesce(pe.received_upvotes,0) + coalesce(pe.received_favorites,0)) as ln_up_fav,
        coalesce(ub.gold_count,0)*5 + coalesce(ub.silver_count,0)*2 + coalesce(ub.bronze_count,0) as badge_points,
        case when coalesce(u.location,'') ilike '%remote%' then 1 else 0 end as is_remote_hint,
        case when position('http' in coalesce(u.websiteurl,'')) > 0 then 1 else 0 end as has_website
    from users u
    left join user_activity ua on ua.user_id = u.id
    left join post_engagement pe on pe.user_id = u.id
    left join user_badges ub on ub.user_id = u.id
),
nullable_demo as (
    select
        u.id as user_id,
        nullif(trim(coalesce(u.displayname,'')), '') as dn_maybe_null,
        coalesce(nullif(u.location,''), 'Unknown') as normalized_location,
        case when u.emailhash is null then 'nohash' else 'hash' end as hash_flag
    from users u
),
joined as (
    select
        ru.user_id,
        ru.displayname,
        ru.reputation,
        ru.cohort_month,
        coalesce(ua.q_count,0) as q_count,
        coalesce(ua.a_count,0) as a_count,
        coalesce(ua.post_score_sum,0) as post_score_sum,
        coalesce(ua.q_views_sum,0) as q_views_sum,
        coalesce(ucs.comment_count,0) as comment_count,
        coalesce(ucs.avg_comment_score,0) as avg_comment_score,
        coalesce(ub.badge_count,0) as badge_count,
        coalesce(ub.gold_count,0) as gold_count,
        coalesce(ub.silver_count,0) as silver_count,
        coalesce(ub.bronze_count,0) as bronze_count,
        coalesce(va.upvotes_made,0) as upvotes_made,
        coalesce(va.downvotes_made,0) as downvotes_made,
        coalesce(va.favorites_made,0) as favorites_made,
        coalesce(va.bounty_sum_given,0) as bounty_sum_given,
        coalesce(uqap.answers_posted,0) as answers_posted,
        coalesce(uqap.accepted_answers,0) as accepted_answers,
        coalesce(uqap.avg_answer_score,0) as avg_answer_score,
        coalesce(uqap.p50_answer_score,0) as p50_answer_score,
        coalesce(uqap.accepted_questions_covered,0) as accepted_questions_covered,
        coalesce(uqap.avg_target_question_score,0) as avg_target_question_score,
        coalesce(pl.dup_links,0) as dup_links_on_posts,
        coalesce(uci.closes_associated_to_user_posts,0) as closes_on_user_posts,
        coalesce(uci.closes_as_duplicate_on_user_posts,0) as duplicate_closes_on_user_posts,
        coalesce(pe.received_upvotes,0) as received_upvotes,
        coalesce(pe.received_downvotes,0) as received_downvotes,
        coalesce(pe.received_favorites,0) as received_favorites,
        coalesce(pe.bounties_on_user_posts,0) as bounties_on_user_posts,
        coalesce(rqv.recent_views_90d,0) as recent_views_90d,
        ut.tag as top_tag,
        hc.sqrt_post_score,
        hc.ln_up_fav,
        hc.badge_points,
        hc.is_remote_hint,
        hc.has_website,
        nd.dn_maybe_null,
        nd.normalized_location,
        nd.hash_flag,
        ur.activity_rank,
        ru.rn_global
    from recent_users ru
    left join user_activity ua on ua.user_id = ru.user_id
    left join user_comment_stats ucs on ucs.user_id = ru.user_id
    left join user_badges ub on ub.user_id = ru.user_id
    left join votes_agg va on va.user_id = ru.user_id
    left join user_q_a_perf uqap on uqap.user_id = ru.user_id
    left join (
        select p.owneruserid as user_id, sum(pl.dup_links) as dup_links
        from post_scores p
        left join postlink_dups pl on pl.post_id = p.id
        group by p.owneruserid
    ) pl on pl.user_id = ru.user_id
    left join user_close_impact uci on uci.user_id = ru.user_id
    left join post_engagement pe on pe.user_id = ru.user_id
    left join recent_q_views rqv on rqv.user_id = ru.user_id
    left join user_top_tag ut on ut.user_id = ru.user_id
    left join heavy_calc hc on hc.user_id = ru.user_id
    left join nullable_demo nd on nd.user_id = ru.user_id
    left join user_rank ur on ur.user_id = ru.user_id
),
scored as (
    select
        j.user_id,
        j.displayname,
        j.reputation,
        j.cohort_month,
        j.q_count,
        j.a_count,
        j.post_score_sum,
        j.q_views_sum,
        j.comment_count,
        j.avg_comment_score,
        j.badge_count,
        j.gold_count,
        j.silver_count,
        j.bronze_count,
        j.upvotes_made,
        j.downvotes_made,
        j.favorites_made,
        j.bounty_sum_given,
        j.answers_posted,
        j.accepted_answers,
        j.avg_answer_score,
        j.p50_answer_score,
        j.accepted_questions_covered,
        j.avg_target_question_score,
        j.dup_links_on_posts,
        j.closes_on_user_posts,
        j.duplicate_closes_on_user_posts,
        j.received_upvotes,
        j.received_downvotes,
        j.received_favorites,
        j.bounties_on_user_posts,
        j.recent_views_90d,
        j.top_tag,
        j.sqrt_post_score,
        j.ln_up_fav,
        j.badge_points,
        j.is_remote_hint,
        j.has_website,
        j.dn_maybe_null,
        j.normalized_location,
        j.hash_flag,
        j.activity_rank,
        j.rn_global,
        case
            when j.answers_posted > 0 then cast(j.accepted_answers as numeric) / j.answers_posted
            else null
        end as accept_rate,
        (coalesce(j.post_score_sum,0)
         + coalesce(j.received_upvotes,0)*2
         - coalesce(j.received_downvotes,0)
         + coalesce(j.badge_points,0)
         + case when j.recent_views_90d > 0 then ln(j.recent_views_90d + 1) else 0 end
        ) as composite_score,
        rank() over (order by
            (coalesce(j.post_score_sum,0)
             + coalesce(j.received_upvotes,0)*2
             - coalesce(j.received_downvotes,0)
             + coalesce(j.badge_points,0)
             + case when j.recent_views_90d > 0 then ln(j.recent_views_90d + 1) else 0 end
            ) desc, j.user_id) as composite_rank,
        dense_rank() over (partition by j.cohort_month order by j.post_score_sum desc) as cohort_rank,
        sum(j.q_count + j.a_count) over (order by j.rn_global rows between unbounded preceding and current row) as running_post_count
    from joined j
),
banded as (
    select
        s.user_id,
        s.displayname,
        s.reputation,
        s.cohort_month,
        s.q_count,
        s.a_count,
        s.post_score_sum,
        s.q_views_sum,
        s.comment_count,
        s.avg_comment_score,
        s.badge_count,
        s.gold_count,
        s.silver_count,
        s.bronze_count,
        s.upvotes_made,
        s.downvotes_made,
        s.favorites_made,
        s.bounty_sum_given,
        s.answers_posted,
        s.accepted_answers,
        s.accept_rate,
        s.avg_answer_score,
        s.p50_answer_score,
        s.accepted_questions_covered,
        s.avg_target_question_score,
        s.dup_links_on_posts,
        s.closes_on_user_posts,
        s.duplicate_closes_on_user_posts,
        s.received_upvotes,
        s.received_downvotes,
        s.received_favorites,
        s.bounties_on_user_posts,
        s.recent_views_90d,
        s.top_tag,
        s.sqrt_post_score,
        s.ln_up_fav,
        s.badge_points,
        s.is_remote_hint,
        s.has_website,
        s.dn_maybe_null,
        s.normalized_location,
        s.hash_flag,
        s.activity_rank,
        s.rn_global,
        s.composite_score,
        s.composite_rank,
        s.cohort_rank,
        s.running_post_count,
        ntile(10) over (order by s.composite_score desc) as decile,
        case
            when s.accept_rate is null then 'no-answers'
            when s.accept_rate >= 0.8 then 'elite'
            when s.accept_rate >= 0.5 then 'strong'
            when s.accept_rate >= 0.2 then 'fair'
            else 'low'
        end as accept_band
    from scored s
),
with_outliers as (
    select
        b.*,
        avg(b.composite_score) over () as mean_score,
        stddev_pop(b.composite_score) over () as stddev_score,
        case when b.composite_score is not null and stddev_pop(b.composite_score) over () > 0
             then (b.composite_score - avg(b.composite_score) over ()) / nullif(stddev_pop(b.composite_score) over (),0)
             else null end as zscore
    from banded b
),
final_union as (
    select
        'top' as bucket,
        f.*
    from with_outliers f
    where f.decile in (1,2,3)
    union all
    select
        'mid' as bucket,
        f.*
    from with_outliers f
    where f.decile in (4,5,6,7)
    union all
    select
        'tail' as bucket,
        f.*
    from with_outliers f
    where f.decile in (8,9,10) or f.composite_score is null
)
select
    bucket,
    user_id,
    coalesce(displayname, '[unknown]') as displayname,
    reputation,
    cohort_month,
    q_count,
    a_count,
    post_score_sum,
    q_views_sum,
    comment_count,
    avg_comment_score,
    badge_count,
    gold_count,
    silver_count,
    bronze_count,
    upvotes_made,
    downvotes_made,
    favorites_made,
    bounty_sum_given,
    answers_posted,
    accepted_answers,
    round(accept_rate, 4) as accept_rate,
    avg_answer_score,
    p50_answer_score,
    accepted_questions_covered,
    avg_target_question_score,
    dup_links_on_posts,
    closes_on_user_posts,
    duplicate_closes_on_user_posts,
    received_upvotes,
    received_downvotes,
    received_favorites,
    bounties_on_user_posts,
    recent_views_90d,
    top_tag,
    sqrt_post_score,
    ln_up_fav,
    badge_points,
    is_remote_hint,
    has_website,
    dn_maybe_null,
    normalized_location,
    hash_flag,
    activity_rank,
    composite_score,
    composite_rank,
    cohort_rank,
    decile,
    accept_band,
    zscore
from final_union
where
    (
        top_tag is null
        or top_tag not ilike any (array['%homework%','%career%'])
        or (normalized_location ilike '%usa%' and coalesce(received_upvotes,0) > coalesce(received_downvotes,0))
    )
    and (
        composite_score is null
        or composite_score >= (
            select percentile_cont(0.25) within group (order by composite_score)
            from with_outliers
        ) - 1.0
    )
    and (
        (answers_posted > 10 and accepted_answers >= 1)
        or (q_count >= 5 and recent_views_90d > 0)
        or (badge_points >= 10)
    )
order by bucket, composite_rank, user_id
limit 500;