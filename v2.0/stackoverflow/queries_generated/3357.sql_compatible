WITH RECURSIVE
UserBadgeStats AS (
    SELECT u.Id,
           u.DisplayName,
           COUNT(*) FILTER (WHERE b.Class = 1)   AS GoldBadges,
           COUNT(*) FILTER (WHERE b.Class = 2)   AS SilverBadges,
           COUNT(*) FILTER (WHERE b.Class = 3)   AS BronzeBadges,
           MAX(b.Date)                           AS LastBadgeDate
    FROM   Users u
    LEFT   JOIN Badges b ON b.UserId = u.Id
    GROUP  BY u.Id, u.DisplayName
),
UserPostStats AS (
    SELECT p.OwnerUserId                                    AS UserId,
           COUNT(*) FILTER (WHERE p.PostTypeId = 1)        AS Questions,
           COUNT(*) FILTER (WHERE p.PostTypeId = 2)        AS Answers,
           COALESCE(SUM(p.Score),0)                        AS TotalScore,
           MAX(p.CreationDate)                             AS LastPostDate,
           STRING_AGG(DISTINCT
               CASE WHEN p.Tags IS NOT NULL
                    THEN REGEXP_REPLACE(p.Tags, '[<>]', '', 'g')
               END, ',')                                  AS TagList
    FROM   Posts p
    GROUP  BY p.OwnerUserId
),
UserActivity AS (
    SELECT u.Id,
           GREATEST(
               COALESCE(ubs.LastBadgeDate, TIMESTAMP '1970-01-01'),
               COALESCE(ups.LastPostDate, TIMESTAMP '1970-01-01')
           )                                            AS LastActivity,
           u.DisplayName
    FROM   Users u
    LEFT   JOIN UserBadgeStats ubs ON ubs.Id = u.Id
    LEFT   JOIN UserPostStats ups  ON ups.UserId = u.Id
    GROUP  BY u.Id, u.DisplayName, ubs.LastBadgeDate, ups.LastPostDate
),
TopUsers AS (
    SELECT ua.Id,
           ua.DisplayName,
           COALESCE(ub.GoldBadges,0)   AS GoldBadges,
           COALESCE(ub.SilverBadges,0) AS SilverBadges,
           COALESCE(ub.BronzeBadges,0) AS BronzeBadges,
           COALESCE(up.Questions,0)    AS Questions,
           COALESCE(up.Answers,0)      AS Answers,
           COALESCE(up.TotalScore,0)   AS TotalScore,
           ua.LastActivity,
           ROW_NUMBER() OVER (
               ORDER BY COALESCE(ub.GoldBadges,0) DESC,
                        COALESCE(up.TotalScore,0) DESC,
                        ua.LastActivity DESC
           )                                            AS Rank
    FROM   Users ua
    LEFT   JOIN UserBadgeStats ub ON ub.Id = ua.Id
    LEFT   JOIN UserPostStats up ON up.UserId = ua.Id
    LEFT   JOIN UserActivity ua ON ua.Id = ua.Id
    WHERE  ua.Reputation > 5000
      AND  (ub.GoldBadges IS NOT NULL AND ub.GoldBadges > 0)
    GROUP  BY ua.Id, ua.DisplayName, ub.GoldBadges, ub.SilverBadges, ub.BronzeBadges,
              up.Questions, up.Answers, up.TotalScore, ua.LastActivity
)
SELECT tu.Id,
       tu.DisplayName,
       tu.GoldBadges,
       tu.SilverBadges,
       tu.BronzeBadges,
       tu.Questions,
       tu.Answers,
       tu.TotalScore,
       tu.LastActivity,
       tu.Rank,
       (
           SELECT COUNT(DISTINCT t.TagName)
           FROM   Posts p2,
                  LATERAL (
                      SELECT REGEXP_SPLIT_TO_TABLE(p2.Tags, '[><]+') AS tagname
                  ) AS tag
           JOIN   Tags t ON t.TagName = tag.tagname
           WHERE  p2.OwnerUserId = tu.Id
             AND  p2.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '30 days'
       ) AS RecentDistinctTagCount
FROM   TopUsers tu
WHERE  tu.Rank <= 100
ORDER  BY tu.Rank;