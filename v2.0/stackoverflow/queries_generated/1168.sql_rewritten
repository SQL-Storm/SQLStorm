-- {"query": "1168.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 2945} 
WITH UserEngagement AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.Location,
        EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - u.CreationDate)) / (60 * 60 * 24) AS DaysSinceCreation,
        EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - u.LastAccessDate)) / (60 * 60 * 24) AS DaysSinceLastAccess,
        COALESCE(u.WebsiteUrl, 'N/A') AS UserWebsite,
        -- Calculate an engagement ratio, handling potential division by zero
        CAST(u.UpVotes - u.DownVotes AS NUMERIC) / NULLIF(u.Views + COALESCE(u.UpVotes, 0) + COALESCE(u.DownVotes, 0), 0) AS EngagementRatio,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        MAX(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS HasGoldBadge,
        -- Aggregate names of gold badges
        STRING_AGG(DISTINCT b.Name, '; ') FILTER (WHERE b.Class = 1) AS GoldBadgeNames
    FROM Users AS u
    LEFT JOIN Badges AS b ON u.Id = b.UserId
    WHERE u.CreationDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '5 year') -- Only consider users active in the last 5 years
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.Location, u.CreationDate, u.LastAccessDate, u.WebsiteUrl
    HAVING COUNT(DISTINCT b.Id) >= 3 AND u.Reputation >= 1000
),
PostHistoricalMetrics AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate AS PostCreationDate,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.AcceptedAnswerId,
        p.ParentId,
        p.Title,
        p.Tags,
        p.LastEditDate,
        COUNT(DISTINCT ph.Id) AS RevisionCount,
        MAX(ph.CreationDate) AS LastHistoryDate,
        -- Check if post has ever been closed
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS WasEverClosed,
        -- Calculate time difference between post creation and first body edit, if any
        MIN(CASE WHEN ph.PostHistoryTypeId = 5 THEN ph.CreationDate END) - p.CreationDate AS TimeToFirstBodyEdit,
        -- Aggregate specific close reasons
        STRING_AGG(DISTINCT crt.Name, '; ') FILTER (WHERE ph.PostHistoryTypeId = 10 AND ph.Comment IS NOT NULL AND crt.Id IS NOT NULL) AS CloseReasons,
        -- Correlated subquery: Find the highest scoring comment on this post by its owner
        (
            SELECT MAX(c.Score)
            FROM Comments AS c
            WHERE c.PostId = p.Id AND c.UserId = p.OwnerUserId
        ) AS MaxOwnerCommentScore
    FROM Posts AS p
    LEFT JOIN PostHistory AS ph ON p.Id = ph.PostId
    LEFT JOIN CloseReasonTypes AS crt ON ph.PostHistoryTypeId = 10 AND ph.Comment = CAST(crt.Id AS VARCHAR) -- Assumes Comment holds CloseReasonId as string
    WHERE p.PostTypeId IN (1, 2) -- Only Questions (1) and Answers (2)
    GROUP BY p.Id, p.PostTypeId, p.OwnerUserId, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount, p.AcceptedAnswerId, p.ParentId, p.Title, p.Tags, p.LastEditDate
    HAVING COUNT(DISTINCT ph.Id) > 1 -- Only posts with more than 1 revision
),
PostTagAnalysis AS (
    SELECT
        phm.PostId,
        phm.OwnerUserId,
        phm.Score,
        phm.ViewCount,
        phm.Title,
        -- Extract individual tags using string_to_array and UNNEST
        UNNEST(string_to_array(SUBSTRING(phm.Tags FROM 2 FOR LENGTH(phm.Tags) - 2), '><')) AS TagName,
        phm.WasEverClosed
    FROM PostHistoricalMetrics AS phm
    WHERE phm.Tags IS NOT NULL AND LENGTH(phm.Tags) > 2
),
TagPerformance AS (
    SELECT
        pta.TagName,
        COUNT(DISTINCT pta.PostId) AS TaggedPostCount,
        SUM(pta.Score) AS TotalTagScore,
        SUM(pta.ViewCount) AS TotalTagViews,
        AVG(pta.Score) AS AvgTagScore,
        SUM(CASE WHEN pta.WasEverClosed = 1 THEN 1 ELSE 0 END) AS ClosedTaggedPostsCount,
        -- Window function: Rank tags by their total views, breaking ties by total score
        DENSE_RANK() OVER (ORDER BY SUM(pta.ViewCount) DESC, SUM(pta.Score) DESC) AS ViewRank
    FROM PostTagAnalysis AS pta
    GROUP BY pta.TagName
    HAVING COUNT(DISTINCT pta.PostId) >= 5
),
UserPostPerformance AS (
    SELECT
        phm.OwnerUserId AS UserId,
        COUNT(phm.PostId) AS TotalOwnedPosts,
        SUM(phm.Score) AS TotalPostScore,
        AVG(phm.Score) AS AveragePostScore,
        SUM(phm.ViewCount) AS TotalPostViews,
        SUM(phm.RevisionCount) AS TotalRevisionsOnOwnedPosts,
        MAX(phm.TimeToFirstBodyEdit) AS MaxTimeToFirstEdit,
        -- Window function: Calculate average score of all posts by users who created posts around the same month
        AVG(phm.Score) OVER (PARTITION BY DATE_TRUNC('month', phm.PostCreationDate)) AS AvgScoreForPostsInMonth,
        -- Identify latest question and answer dates
        MAX(CASE WHEN phm.PostTypeId = 1 THEN phm.PostCreationDate ELSE NULL END) AS LatestQuestionDate,
        MAX(CASE WHEN phm.PostTypeId = 2 THEN phm.PostCreationDate ELSE NULL END) AS LatestAnswerDate
    FROM PostHistoricalMetrics AS phm
    GROUP BY phm.OwnerUserId
    HAVING COUNT(phm.PostId) > 0
),
ModeratorReviewSummary AS (
    -- Identify posts that received moderator review votes but are NOT linked as duplicates
    SELECT
        v.PostId,
        COUNT(DISTINCT v.UserId) AS ModeratorReviewers,
        MAX(v.CreationDate) AS LastModeratorReview,
        SUM(CASE WHEN v.VoteTypeId = 15 THEN 1 ELSE 0 END) AS ModReviewCount
    FROM Votes AS v
    LEFT JOIN PostLinks AS pl ON v.PostId = pl.PostId AND pl.LinkTypeId = 3 -- Duplicate link type
    WHERE v.VoteTypeId = 15 -- ModeratorReview vote type
    AND pl.PostId IS NULL -- Exclude posts that are duplicates
    GROUP BY v.PostId
    HAVING COUNT(DISTINCT v.UserId) >= 2
)
-- Main query combining all CTEs and other complex logic
SELECT
    ue.UserId,
    ue.DisplayName,
    ue.Reputation,
    ue.Location,
    ue.DaysSinceCreation,
    ue.EngagementRatio,
    ue.TotalBadges,
    ue.HasGoldBadge,
    ue.GoldBadgeNames,
    upp.TotalOwnedPosts,
    upp.TotalPostScore,
    upp.AveragePostScore,
    upp.TotalPostViews,
    upp.TotalRevisionsOnOwnedPosts,
    upp.MaxTimeToFirstEdit,
    upp.AvgScoreForPostsInMonth,
    tp.TagName AS TopContributingTag,
    tp.TotalTagScore AS TopTagScore,
    tp.ViewRank AS TopTagViewRank,
    phm_main.Title AS ExamplePostTitle,
    phm_main.MaxOwnerCommentScore,
    phm_main.RevisionCount AS ExamplePostRevisions,
    COALESCE(phm_main.CloseReasons, 'Not Closed') AS ExamplePostCloseReasons,
    COALESCE(mrs.ModeratorReviewers, 0) AS AssociatedModeratorReviewers,
    -- String expression: Extract first 20 characters of location, default to 'Unknown'
    LEFT(COALESCE(ue.Location, 'Unknown'), 20) AS ShortLocation,
    -- Complex calculation: Ratio of total post score to total badges, handling division by zero
    CAST(upp.TotalPostScore AS NUMERIC) / NULLIF(ue.TotalBadges, 0) AS ScorePerBadgeRatio,
    -- More advanced window function: Ratio of user's average post score to the average for posts in their creation month
    CAST(upp.AveragePostScore AS NUMERIC) / NULLIF(upp.AvgScoreForPostsInMonth, 0) AS UserVsMonthlyAvgScoreRatio,
    -- Correlated Subquery: Check if the user has any posts that were accepted answers to other questions
    EXISTS (
        SELECT 1
        FROM Posts AS p_ans
        WHERE p_ans.PostTypeId = 2 -- Answer
          AND p_ans.OwnerUserId = ue.UserId
          AND p_ans.Id IN (SELECT q.AcceptedAnswerId FROM Posts AS q WHERE q.PostTypeId = 1 AND q.AcceptedAnswerId IS NOT NULL)
    ) AS HasAcceptedAnswersToOtherQuestions,
    -- Set operator usage: Identify users who have either edited their own popular questions OR edited their own popular answers
    CASE
        WHEN ue.UserId IN (
            (
                SELECT p_q.OwnerUserId
                FROM Posts AS p_q
                INNER JOIN PostHistory AS ph_q ON p_q.Id = ph_q.PostId AND ph_q.UserId = p_q.OwnerUserId AND ph_q.PostHistoryTypeId IN (4, 5, 6) -- Edit Title/Body/Tags
                WHERE p_q.PostTypeId = 1 AND p_q.ViewCount > 500
            )
            UNION
            (
                SELECT p_a.OwnerUserId
                FROM Posts AS p_a
                INNER JOIN PostHistory AS ph_a ON p_a.Id = ph_a.PostId AND ph_a.UserId = p_a.OwnerUserId AND ph_a.PostHistoryTypeId IN (4, 5, 6) -- Edit Title/Body/Tags
                WHERE p_a.PostTypeId = 2 AND p_a.Score > 200
            )
        ) THEN TRUE
        ELSE FALSE
    END AS EditedPopularSelfPostsCombined
FROM UserEngagement AS ue
INNER JOIN UserPostPerformance AS upp ON ue.UserId = upp.UserId
LEFT JOIN PostTagAnalysis AS pta_top ON ue.UserId = pta_top.OwnerUserId
LEFT JOIN TagPerformance AS tp ON pta_top.TagName = tp.TagName AND tp.ViewRank = 1 -- Get the top ranked tag for which the user contributed
LEFT JOIN PostHistoricalMetrics AS phm_main ON ue.UserId = phm_main.OwnerUserId
    AND phm_main.PostTypeId = 1 -- Example: pick a question by the user
    AND phm_main.Score = (SELECT MAX(phm_sub.Score) FROM PostHistoricalMetrics AS phm_sub WHERE phm_sub.OwnerUserId = ue.UserId AND phm_sub.PostTypeId = 1) -- Correlated: Pick the highest scoring question by the user
LEFT JOIN ModeratorReviewSummary AS mrs ON phm_main.PostId = mrs.PostId
WHERE
    ue.EngagementRatio IS NOT NULL AND ue.EngagementRatio > 0.005 -- Filter for engaged users
    AND upp.TotalPostViews > 750
    AND (
        (phm_main.WasEverClosed = 0 OR phm_main.WasEverClosed IS NULL) -- User primarily has open posts or no example post selected
        OR (phm_main.TimeToFirstBodyEdit IS NOT NULL AND phm_main.TimeToFirstBodyEdit < INTERVAL '2 hour') -- Or they fix posts quickly
    )
    AND COALESCE(phm_main.Title, '') LIKE '%SQL%' -- Filtering example posts by title
ORDER BY
    ue.Reputation DESC,
    ScorePerBadgeRatio DESC NULLS LAST, -- Handle NULLs for sorting
    UserVsMonthlyAvgScoreRatio DESC NULLS LAST
LIMIT 100;