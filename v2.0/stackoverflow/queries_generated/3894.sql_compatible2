WITH
    UserStats AS (
        SELECT
            u.Id,
            u.DisplayName,
            u.Reputation,
            COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetVotes,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
            u.CreationDate,
            u.LastAccessDate
        FROM Users u
    ),

    AnswerMetrics AS (
        SELECT
            a.OwnerUserId AS UserId,
            COUNT(*)                                   AS AnswerCount,
            AVG(COALESCE(a.Score, 0))                  AS AvgScore,
            MAX(a.CreationDate)                        AS LastAnswerDate,
            SUM(CASE WHEN a.Id = p.AcceptedAnswerId THEN 1 ELSE 0 END) AS AcceptedAnswers
        FROM Posts a
        LEFT JOIN Posts p ON p.AcceptedAnswerId = a.Id
        WHERE a.PostTypeId = 2
        GROUP BY a.OwnerUserId
    ),

    QuestionTagStats AS (
        SELECT
            p.OwnerUserId AS UserId,
            UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><')) AS Tag,
            COUNT(*) AS QCount
        FROM Posts p
        WHERE p.PostTypeId = 1
          AND p.Tags IS NOT NULL
        GROUP BY p.OwnerUserId, Tag
    ),

    TopTags AS (
        SELECT
            UserId,
            STRING_AGG(Tag, ', ') FILTER (WHERE rn <= 5) AS Top5Tags
        FROM (
            SELECT
                UserId,
                Tag,
                ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY QCount DESC) AS rn
            FROM QuestionTagStats
        ) t
        GROUP BY UserId
    ),

    RecentActivity AS (
        SELECT
            u.Id,
            GREATEST(
                COALESCE(u.LastAccessDate, TIMESTAMP '1970-01-01'),
                COALESCE((SELECT MAX(CreationDate) FROM Posts p WHERE p.OwnerUserId = u.Id), TIMESTAMP '1970-01-01'),
                COALESCE((SELECT MAX(CreationDate) FROM Comments c WHERE c.UserId = u.Id), TIMESTAMP '1970-01-01')
            ) AS LastActivity
        FROM Users u
    ),

    Combined AS (
        SELECT
            us.Id,
            us.DisplayName,
            us.Reputation,
            us.NetVotes,
            us.GoldBadges,
            us.SilverBadges,
            us.BronzeBadges,
            COALESCE(am.AnswerCount, 0)               AS AnswerCount,
            COALESCE(am.AvgScore, 0)                  AS AvgAnswerScore,
            COALESCE(am.AcceptedAnswers, 0)           AS AcceptedAnswers,
            COALESCE(ra.LastActivity, us.CreationDate) AS LastActivityDate,
            COALESCE(tt.Top5Tags, '')                 AS Top5Tags
        FROM UserStats us
        LEFT JOIN AnswerMetrics am   ON am.UserId = us.Id
        LEFT JOIN RecentActivity ra  ON ra.Id = us.Id
        LEFT JOIN TopTags tt        ON tt.UserId = us.Id
    ),

-- Build the primary result set and the separator row first, then apply INTERSECT
    PrimaryResults AS (
        SELECT *
        FROM Combined
        WHERE Reputation > 10000
           OR (AnswerCount >= 100 AND AvgAnswerScore > 5)
        ORDER BY Reputation DESC, AvgAnswerScore DESC
        LIMIT 100

        UNION ALL

        SELECT
            CAST(NULL AS INTEGER)          AS Id,
            CAST('---' AS VARCHAR(40))     AS DisplayName,
            CAST(NULL AS INTEGER)          AS Reputation,
            CAST(NULL AS INTEGER)          AS NetVotes,
            CAST(NULL AS INTEGER)          AS GoldBadges,
            CAST(NULL AS INTEGER)          AS SilverBadges,
            CAST(NULL AS INTEGER)          AS BronzeBadges,
            CAST(NULL AS INTEGER)          AS AnswerCount,
            CAST(NULL AS NUMERIC)          AS AvgAnswerScore,
            CAST(NULL AS INTEGER)          AS AcceptedAnswers,
            CAST(NULL AS TIMESTAMP)        AS LastActivityDate,
            CAST(NULL AS VARCHAR(4000))    AS Top5Tags
    )

SELECT pr.*
FROM PrimaryResults pr
INTERSECT
SELECT *
FROM Combined
WHERE GoldBadges >= 5;