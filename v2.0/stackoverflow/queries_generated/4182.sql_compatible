WITH RankedPostEdits AS (
    SELECT
        ph.PostId,
        ph.UserId,
        ph.CreationDate,
        ph.PostHistoryTypeId,
        ROW_NUMBER() OVER(PARTITION BY ph.PostId, ph.UserId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4, 5, 6)
),
UserPostContribution AS (
    SELECT
        p.OwnerUserId,
        COUNT(DISTINCT p.Id) AS QuestionsPosted,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersPosted,
        SUM(p.CommentCount) AS TotalComments,
        MAX(p.Score) AS MaxPostScore,
        AVG(p.Score) AS AvgPostScore
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL AND p.OwnerUserId <> -1
    GROUP BY p.OwnerUserId
),
UserActivitySummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        COALESCE(upc.QuestionsPosted, 0) AS QuestionsPosted,
        COALESCE(upc.AnswersPosted, 0) AS AnswersPosted,
        COALESCE(upc.TotalComments, 0) AS TotalComments,
        COALESCE(upc.MaxPostScore, 0) AS MaxPostScore,
        COALESCE(upc.AvgPostScore, 0.0) AS AvgPostScore,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        (SELECT COUNT(DISTINCT rpe.PostId) FROM RankedPostEdits rpe WHERE rpe.UserId = u.Id AND rpe.rn = 1) AS PostsLastEdited,
        MAX(c.CreationDate) AS LastCommentDate
    FROM Users u
    LEFT JOIN UserPostContribution upc ON u.Id = upc.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, upc.QuestionsPosted, upc.AnswersPosted, upc.TotalComments, upc.MaxPostScore, upc.AvgPostScore
),
CommunityResponse AS (
    SELECT
        p.Id AS QuestionId,
        p.OwnerUserId,
        p.CreationDate AS QuestionCreationDate,
        p.AcceptedAnswerId,
        p.AnswerCount,
        p.FavoriteCount,
        p.Score AS QuestionScore,
        (SELECT COUNT(c.Id) FROM Comments c WHERE c.PostId = p.Id AND c.UserId IS NOT NULL) AS QuestionCommentsCount,
        (SELECT COUNT(ph.Id) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10) AS CloseVotesCount,
        (SELECT MAX(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = p.Id AND ph.PostHistoryTypeId = 10) AS LastCloseVoteDate,
        CASE
            WHEN p.AcceptedAnswerId IS NOT NULL THEN
                (SELECT COUNT(DISTINCT v.UserId) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 1)
            ELSE 0
        END AS AcceptedAnswerVoteCount
    FROM Posts p
    WHERE p.PostTypeId = 1
),
DetailedUserPerformance AS (
    SELECT
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.UserCreationDate,
        uas.QuestionsPosted,
        uas.AnswersPosted,
        uas.TotalComments,
        uas.MaxPostScore,
        uas.AvgPostScore,
        uas.GoldBadges,
        uas.SilverBadges,
        uas.BronzeBadges,
        uas.PostsLastEdited,
        uas.LastCommentDate,
        cr.QuestionId,
        cr.QuestionCreationDate,
        cr.AcceptedAnswerId,
        cr.AnswerCount,
        cr.FavoriteCount,
        cr.QuestionScore,
        cr.QuestionCommentsCount,
        cr.CloseVotesCount,
        cr.LastCloseVoteDate,
        cr.AcceptedAnswerVoteCount,
        CAST(
            JULIANDAY(cr.QuestionCreationDate) - JULIANDAY(uas.UserCreationDate)
            AS INTEGER
        ) AS DaysFromUserCreationToQuestion,
        CASE
            WHEN cr.AcceptedAnswerId IS NOT NULL AND cr.AnswerCount > 0 THEN
                CAST(cr.AcceptedAnswerVoteCount AS NUMERIC) / cr.AnswerCount
            ELSE 0.0
        END AS AcceptedAnswerRatio,
        cr.AnswerCount * 1.0 / NULLIF(cr.FavoriteCount, 0) AS AnswerFavoriteRatio,
        CASE WHEN cr.CloseVotesCount > 0 THEN 'Closed' ELSE 'Open' END AS QuestionStatus,
        cr.QuestionScore * 1.0 / ( (CAST((JULIANDAY('2024-10-01 12:34:56') - JULIANDAY(cr.QuestionCreationDate)) * 24 AS NUMERIC)) + 1) AS ScorePerHour,
        cr.QuestionScore - cr.QuestionCommentsCount AS NetScore,
        CASE WHEN cr.AcceptedAnswerId IS NULL THEN 1 ELSE 0 END AS UnacceptedAnswerFlag,
        cr.AnswerCount - (SELECT COUNT(a.Id) FROM Posts a WHERE a.ParentId = cr.QuestionId AND a.OwnerUserId = uas.UserId) AS AnswersByOthers
    FROM UserActivitySummary uas
    LEFT JOIN CommunityResponse cr ON uas.UserId = cr.OwnerUserId
    WHERE uas.Reputation > 1000
)
SELECT
    d.DisplayName,
    d.Reputation,
    d.QuestionsPosted,
    d.AnswersPosted,
    d.TotalComments,
    d.GoldBadges,
    d.SilverBadges,
    d.BronzeBadges,
    d.PostsLastEdited,
    d.QuestionId,
    d.QuestionCreationDate,
    d.QuestionScore,
    d.AnswerCount,
    d.FavoriteCount,
    d.QuestionCommentsCount,
    d.CloseVotesCount,
    d.AcceptedAnswerVoteCount,
    d.DaysFromUserCreationToQuestion,
    d.AcceptedAnswerRatio,
    d.AnswerFavoriteRatio,
    d.QuestionStatus,
    d.ScorePerHour,
    d.NetScore,
    d.UnacceptedAnswerFlag,
    d.AnswersByOthers,
    UPPER(SUBSTR(d.DisplayName, 1, 3)) AS DisplayNamePrefix,
    LENGTH(d.DisplayName) AS DisplayNameLength,
    d.LastCommentDate,
    CAST(STRFTIME('%Y', d.UserCreationDate) AS INTEGER) AS UserCreationYear,
    CAST(STRFTIME('%H', d.QuestionCreationDate) AS INTEGER) AS QuestionCreationHour,
    CASE
        WHEN d.QuestionScore > 100 THEN 'HighScore'
        WHEN d.QuestionScore > 50 THEN 'MediumScore'
        ELSE 'LowScore'
    END AS ScoreCategory,
    CASE
        WHEN d.AnswerCount > d.QuestionCommentsCount THEN 'MoreAnswersThanComments'
        WHEN d.AnswerCount < d.QuestionCommentsCount THEN 'FewerAnswersThanComments'
        ELSE 'EqualAnswersAndComments'
    END AS AnswerCommentBalance,
    COALESCE(d.LastCloseVoteDate, d.QuestionCreationDate) AS EffectiveCloseDate
FROM DetailedUserPerformance d
WHERE d.QuestionId IS NOT NULL
ORDER BY d.Reputation DESC, d.QuestionScore DESC
LIMIT 1000;