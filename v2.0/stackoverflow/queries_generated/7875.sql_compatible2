WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        SUM(COALESCE(p.Score, 0)) as TotalScore,
        MAX(p.CreationDate) as LastActivityDate,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - u.CreationDate)) / 86400 AS INTEGER) as AccountAgeDays,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 100 THEN 'High'
            WHEN COUNT(DISTINCT p.Id) > 50 THEN 'Medium'
            ELSE 'Low'
        END as ActivityLevel,
        COALESCE(
            (SELECT COUNT(*) 
             FROM Posts p2 
             WHERE p2.ParentId = p.Id 
               AND p2.PostTypeId = 2 
               AND p2.Score >= 10
            ), 0
        ) as HighScoredAnswers,
        ROW_NUMBER() OVER (ORDER BY SUM(COALESCE(p.Score, 0)) DESC) as ScoreRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId OR u.Id = p.LastEditorUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE WHEN t.IsRequired = 1 THEN 'Required' ELSE 'Optional' END as TagType,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as PopularityRank,
        LAG(t.Count) OVER (ORDER BY t.Count DESC) - t.Count as PopularityDifference
    FROM Tags t
    WHERE t.Count > 0
),
ComplexPostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Body,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.ParentId,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.Tags,
        COALESCE(p.AnswerCount, 0) - COALESCE(p.CommentCount, 0) as NetAnswerToCommentRatio,
        CASE 
            WHEN p.Tags IS NOT NULL AND p.Tags != '' THEN 
                LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', '')) + 1
            ELSE 0 
        END as TagCount,
        CASE 
            WHEN p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.PostTypeId = 2 AND EXISTS (
                SELECT 1 FROM Posts pa 
                WHERE pa.Id = p.ParentId 
                AND pa.AcceptedAnswerId = p.Id
            ) THEN 'AcceptedAnswer'
            ELSE 'Open'
        END as PostStatus,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400 AS INTEGER) as AgeInDays,
        COALESCE(ABS(p.Score - (SELECT AVG(Score) FROM Posts)), 0) as ScoreDeviation,
        RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) as ScoreRankByType
    FROM Posts p
    WHERE p.Id IS NOT NULL
    AND (p.PostTypeId IN (1, 2) OR (p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL))
),
UserEngagement AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (1, 2, 3) THEN ph.Id END) as EditCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13) THEN ph.Id END) as ActionCount,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId IN (1, 2, 3) THEN v.Id END) as VoteCount,
        STRING_AGG(DISTINCT COALESCE(p.Title, 'No Title'), ' ; ') as RecentPosts,
        AVG(COALESCE(c.Score, 0)) as AverageCommentScore,
        (SELECT COUNT(*) FROM Posts p2 WHERE p2.OwnerUserId = u.Id AND p2.PostTypeId = 1 AND p2.AcceptedAnswerId IS NOT NULL) as AcceptedAnswers,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY ph.CreationDate DESC) as RecentActivityRank
    FROM Users u
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName
)
SELECT 
    uas.UserId,
    uas.DisplayName,
    uas.Reputation,
    uas.TotalPosts,
    uas.Questions,
    uas.Answers,
    uas.Comments,
    uas.Badges,
    uas.TotalScore,
    uas.ActivityLevel,
    uas.ScoreRank,
    uas.HighScoredAnswers,
    CASE 
        WHEN uas.Reputation > 10000 THEN 'Elite'
        WHEN uas.Reputation > 5000 THEN 'Veteran'
        WHEN uas.Reputation > 1000 THEN 'Contributor'
        ELSE 'Beginner'
    END as ReputationTier,
    tt.TagName,
    tt.Count as TagCount,
    tt.PopularityRank,
    tpa.PostId,
    tpa.Title as PostTitle,
    tpa.Body as PostBody,
    tpa.Score as PostScore,
    tpa.ViewCount as PostViews,
    tpa.AgeInDays,
    tpa.NetAnswerToCommentRatio,
    tpa.PostStatus,
    tpa.ScoreRankByType,
    ue.EditCount,
    ue.ActionCount,
    ue.VoteCount,
    ue.AverageCommentScore,
    CASE 
        WHEN (uas.TotalPosts * 0.3) > uas.HighScoredAnswers THEN 'Conservative'
        WHEN (uas.TotalPosts * 0.7) > uas.HighScoredAnswers THEN 'Balanced'
        ELSE 'Aggressive'
    END as PostingStyle,
    CASE 
        WHEN uas.TotalPosts > 100 AND uas.Reputation > 5000 THEN 'PowerUser'
        WHEN uas.TotalPosts > 50 AND uas.Reputation > 2000 THEN 'ActiveUser'
        ELSE 'RegularUser'
    END as UserCategory,
    CASE WHEN uas.TotalPosts > 0 THEN 
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId IN (
            SELECT Id FROM Posts p WHERE p.OwnerUserId = uas.UserId
        )) / CAST(uas.TotalPosts AS FLOAT) 
    ELSE 0 
    END as CommentPerPostRatio,
    CASE WHEN tt.Count > 1 THEN 
        (SELECT COUNT(*) FROM Posts p WHERE p.Tags LIKE '%' || tt.TagName || '%') 
    ELSE 0 END as TagUsageFrequency,
    CASE WHEN tpa.PostStatus = 'Closed' THEN 
        (SELECT COUNT(*) FROM PostHistory ph WHERE ph.PostId = tpa.PostId AND ph.PostHistoryTypeId = 10) 
    ELSE 0 END as ClosedCount,
    CASE WHEN tpa.PostStatus = 'AcceptedAnswer' THEN 
        (SELECT COUNT(*) FROM Posts p WHERE p.ParentId = tpa.PostId AND p.AcceptedAnswerId IS NOT NULL) 
    ELSE 0 END as AnswerAcceptanceCount,
    CASE WHEN tpa.AgeInDays > 30 THEN 'Old' ELSE 'Recent' END as PostAgeCategory,
    CASE WHEN LENGTH(tpa.Body) > 1000 THEN 'Long' ELSE 'Short' END as PostLengthCategory,
    CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - uas.LastActivityDate)) / 86400 AS INTEGER) as DaysSinceLastActivity,
    CASE WHEN uas.AccountAgeDays > 365 THEN 'Veteran' ELSE 'New' END as AccountAgeCategory,
    COALESCE((SELECT COUNT(*) FROM Badges b WHERE b.UserId = uas.UserId AND b.Class = 1), 0) as GoldBadges,
    COALESCE((SELECT COUNT(*) FROM Badges b WHERE b.UserId = uas.UserId AND b.Class = 2), 0) as SilverBadges,
    COALESCE((SELECT COUNT(*) FROM Badges b WHERE b.UserId = uas.UserId AND b.Class = 3), 0) as BronzeBadges,
    NULLIF((uas.Comments + uas.Badges + uas.Answers) / NULLIF(uas.Questions, 0), 0) as EngagementRatio
FROM UserActivityStats uas
LEFT JOIN TopTags tt ON tt.PopularityRank BETWEEN 1 AND 20
LEFT JOIN ComplexPostAnalysis tpa ON tpa.OwnerUserId = uas.UserId
LEFT JOIN UserEngagement ue ON ue.UserId = uas.UserId
WHERE uas.TotalPosts > 0 
AND (tt.Count IS NOT NULL OR tpa.PostId IS NOT NULL OR ue.UserId IS NOT NULL)
GROUP BY 
    uas.UserId, uas.DisplayName, uas.Reputation, uas.TotalPosts, uas.Questions, 
    uas.Answers, uas.Comments, uas.Badges, uas.TotalScore, uas.ActivityLevel, 
    uas.ScoreRank, uas.HighScoredAnswers, tt.TagName, tt.Count, tt.PopularityRank, 
    tpa.PostId, tpa.Title, tpa.Body, tpa.Score, tpa.ViewCount, tpa.AgeInDays, 
    tpa.NetAnswerToCommentRatio, tpa.PostStatus, tpa.ScoreRankByType, 
    ue.EditCount, ue.ActionCount, ue.VoteCount, ue.AverageCommentScore, 
    uas.LastActivityDate, uas.AccountAgeDays
HAVING 
    COUNT(*) > 1 
    OR COUNT(tpa.PostId) > 0 
    OR COUNT(ue.UserId) > 0
ORDER BY 
    uas.ScoreRank,
    uas.TotalPosts DESC,
    uas.Reputation DESC,
    tt.PopularityRank
LIMIT 1000;