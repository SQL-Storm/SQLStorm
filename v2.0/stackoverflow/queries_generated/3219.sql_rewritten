-- {"query": "3219.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2702} 
WITH
/* -----------------------------------------------------------------------
   1. Basic user metrics (reputation, net votes, badge counts) */
UserBase AS (
    SELECT
        u.Id                                           AS UserId,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0) AS NetVotes,
        /* correlated sub‑queries for badge classes */
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges
    FROM Users u
    WHERE u.Reputation > 500
),

/* -----------------------------------------------------------------------
   2. Question activity per user */
QStats AS (
    SELECT
        p.OwnerUserId               AS UserId,
        COUNT(*)                    AS QCount,
        AVG(p.Score)                AS AvgQScore,
        MAX(p.CreationDate)         AS LastQDate
    FROM Posts p
    WHERE p.PostTypeId = 1            -- Question
      AND p.Score IS NOT NULL
    GROUP BY p.OwnerUserId
),

/* -----------------------------------------------------------------------
   3. Answer activity per user */
AStats AS (
    SELECT
        p.OwnerUserId               AS UserId,
        COUNT(*)                    AS ACount,
        AVG(p.Score)                AS AvgAScore,
        MAX(p.CreationDate)         AS LastADate
    FROM Posts p
    WHERE p.PostTypeId = 2            -- Answer
      AND p.Score IS NOT NULL
    GROUP BY p.OwnerUserId
),

/* -----------------------------------------------------------------------
   4. Vote summary per user (up‑votes minus down‑votes) */
VoteSum AS (
    SELECT
        v.UserId,
        SUM(CASE v.VoteTypeId
                WHEN 2 THEN  1   -- UpMod
                WHEN 3 THEN -1   -- DownMod
                ELSE 0
            END) AS NetVotesGiven
    FROM Votes v
    GROUP BY v.UserId
),

/* -----------------------------------------------------------------------
   5. Duplicate‑link count per post (used later via a lateral join) */
DupLinks AS (
    SELECT
        pl.PostId,
        COUNT(*) FILTER (WHERE pl.LinkTypeId = 3) AS DupCount
    FROM PostLinks pl
    GROUP BY pl.PostId
),

/* -----------------------------------------------------------------------
   6. Tag information (pick the most used tag per user) */
UserTag AS (
    SELECT
        t.TagName,
        t.Count                      AS TagUseCount,
        LENGTH(p.Body)               AS ExcerptLen,
        LENGTH(p2.Body)              AS WikiLen,
        p.OwnerUserId                AS UserId,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY t.Count DESC) AS rn
    FROM Tags t
    JOIN Posts p  ON p.Id = t.ExcerptPostId
    LEFT JOIN Posts p2 ON p2.Id = t.WikiPostId
    WHERE t.IsModeratorOnly = 0
)
SELECT
    /* --------------------------------------------------------------------
       Final projection – mixture of aggregates, window ranks, case exprs,
       string concat, and null handling */
    ROW_NUMBER() OVER (ORDER BY ub.Reputation DESC, ub.NetVotes DESC) AS RankByRep,
    ub.UserId,
    ub.DisplayName,
    ub.Reputation,
    ub.NetVotes,
    ub.GoldBadges,
    ub.SilverBadges,
    ub.BronzeBadges,
    COALESCE(q.QCount,0)                          AS QuestionsPosted,
    COALESCE(a.ACount,0)                          AS AnswersPosted,
    COALESCE(v.NetVotesGiven,0)                   AS NetVotesGiven,
    COALESCE(dl.DupCount,0)                       AS DuplicateLinksOnLatestPost,
    CASE
        WHEN ub.Reputation >= 20000 THEN 'Legendary'
        WHEN ub.Reputation >= 10000 THEN 'Expert'
        WHEN ub.Reputation >= 5000  THEN 'Seasoned'
        ELSE 'Contributor'
    END                                            AS ReputationTier,
    /* concatenate top tag info, handling possible NULLs */
    COALESCE(t.TagName,'<no‑tag>') || ' (uses=' ||
    COALESCE(t.TagUseCount::text,'0') || ',ex=' ||
    COALESCE(t.ExcerptLen::text,'0') || ',wk=' ||
    COALESCE(t.WikiLen::text,'0') || ')'        AS TopTagInfo,
    /* a derived column using a correlated sub‑query */
    (SELECT COUNT(*)
     FROM Posts p2
     WHERE p2.OwnerUserId = ub.UserId
       AND p2.CreationDate >= DATE_TRUNC('year', cast('2024-10-01' as date))
       AND p2.Score > 0)                         AS PostsThisYear
FROM UserBase ub
LEFT JOIN QStats q   ON q.UserId = ub.UserId
LEFT JOIN AStats a   ON a.UserId = ub.UserId
LEFT JOIN VoteSum v  ON v.UserId = ub.UserId
LEFT JOIN (
    /* fetch the latest post of the user to join duplicate‑link stats */
    SELECT p.OwnerUserId, p.Id
    FROM Posts p
    WHERE p.PostTypeId IN (1,2)               -- Q or A
    QUALIFY ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) = 1
) lp ON lp.OwnerUserId = ub.UserId
LEFT JOIN DupLinks dl ON dl.PostId = lp.Id
LEFT JOIN (
    SELECT TagName, TagUseCount, ExcerptLen, WikiLen, UserId
    FROM UserTag
    WHERE rn = 1
) t ON t.UserId = ub.UserId
WHERE ub.Reputation IS NOT NULL
/* --------------------------------------------------------------------
   Benchmarking set operator – ensure the optimizer sees a UNION ALL */
UNION ALL
SELECT NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
WHERE NOT EXISTS (SELECT 1 FROM UserBase WHERE Reputation > 5000)
ORDER BY RankByRep
LIMIT 150;