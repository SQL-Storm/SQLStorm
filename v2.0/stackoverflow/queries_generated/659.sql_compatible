with recent_users as (
  select u.id as user_id,
         u.displayname,
         u.reputation,
         u.creationdate,
         u.location,
         coalesce(nullif(trim(u.websiteurl), ''), 'n/a') as websiteurl_norm
  from users u
  where u.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
post_kinds as (
  select pt.id as posttypeid, pt.name as posttypename
  from posttypes pt
),
user_posts as (
  select p.id,
         p.posttypeid,
         p.owneruserid as user_id,
         p.creationdate,
         p.score,
         p.viewcount,
         p.title,
         p.tags,
         p.acceptedanswerid,
         p.parentid,
         p.lastactivitydate,
         p.commentcount
  from posts p
  where p.owneruserid is not null
),
user_activity as (
  select ru.user_id,
         count(*) filter (where up.posttypeid = 1) as q_count,
         count(*) filter (where up.posttypeid = 2) as a_count,
         avg(nullif(up.score,0)) filter (where up.posttypeid in (1,2)) as avg_nonzero_score,
         max(up.viewcount) filter (where up.posttypeid = 1) as max_question_views,
         min(up.creationdate) as first_post_date,
         max(up.lastactivitydate) as last_post_activity
  from recent_users ru
  left join user_posts up on up.user_id = ru.user_id
  group by ru.user_id
),
tag_extract as (
  select up.id as post_id,
         unnest(string_to_array(substring(up.tags, 2, greatest(length(up.tags)-2,0)), '><')) as tag
  from user_posts up
  where up.posttypeid = 1
    and up.tags is not null
),
fav_votes as (
  select v.postid,
         count(*) as fav_count
  from votes v
  where v.votetypeid = 5
  group by v.postid
),
score_ranked as (
  select up.id as post_id,
         up.user_id,
         up.posttypeid,
         up.score,
         up.viewcount,
         up.creationdate,
         row_number() over (partition by up.user_id, up.posttypeid order by up.score desc nulls last, up.viewcount desc nulls last, up.creationdate asc) as rn,
         dense_rank() over (partition by up.user_id order by up.score desc nulls last) as dr_overall
  from user_posts up
  where up.posttypeid in (1,2)
),
accepted_answer_stats as (
  select q.owneruserid as asker_id,
         count(*) as answers_with_accepts,
         sum(case when a.id = q.acceptedanswerid then 1 else 0 end) as accepted_by_asker,
         avg(a.score) as avg_answer_score_on_asked
  from posts q
  join posts a on a.parentid = q.id and a.posttypeid = 2
  where q.posttypeid = 1
  group by q.owneruserid
),
badge_rollup as (
  select b.userid,
         count(*) as total_badges,
         count(*) filter (where b.class = 1) as gold_badges,
         count(*) filter (where b.class = 2) as silver_badges,
         count(*) filter (where b.class = 3) as bronze_badges,
         count(*) filter (where b.tagbased = true) as tag_badges
  from badges b
  group by b.userid
),
comment_engagement as (
  select c.userid as user_id,
         count(*) as comments_made,
         avg(c.score) as avg_comment_score,
         max(c.creationdate) as last_comment_date
  from comments c
  group by c.userid
),
post_close_info as (
  select ph.postid,
         max(ph.creationdate) filter (where ph.posthistorytypeid in (10,11)) as last_close_or_reopen,
         max(case when ph.posthistorytypeid = 10 then ph.creationdate end) as last_closed_date,
         max(case when ph.posthistorytypeid = 11 then ph.creationdate end) as last_reopened_date,
         max(case when ph.posthistorytypeid = 10 then ph.comment end) as last_close_reason_code
  from posthistory ph
  where ph.posthistorytypeid in (10,11)
  group by ph.postid
),
dupe_links as (
  select pl.postid as dup_post_id,
         pl.relatedpostid as canonical_post_id,
         count(*) as dupe_link_count
  from postlinks pl
  where pl.linktypeid = 3
  group by pl.postid, pl.relatedpostid
),
top_tag_per_user as (
  select te.tag,
         up.user_id,
         count(*) as tag_uses,
         row_number() over (partition by up.user_id order by count(*) desc, te.tag) as tag_rn
  from tag_extract te
  join user_posts up on up.id = te.post_id
  group by te.tag, up.user_id
),
question_quality as (
  select q.id as question_id,
         q.owneruserid as user_id,
         q.score,
         q.viewcount,
         q.answercount,
         coalesce(fv.fav_count,0) as favs,
         coalesce(pc.last_close_reason_code,'') as last_close_reason_code,
         case when q.acceptedanswerid is not null then 1 else 0 end as has_accepted,
         case when dl.dup_post_id is not null then 1 else 0 end as is_marked_duplicate,
         (coalesce(q.viewcount,0) / nullif(1 + extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - q.creationdate))/86400.0,0)) as views_per_day
  from posts q
  left join fav_votes fv on fv.postid = q.id
  left join post_close_info pc on pc.postid = q.id
  left join dupe_links dl on dl.dup_post_id = q.id
  where q.posttypeid = 1
),
user_quality_agg as (
  select qq.user_id,
         percentile_cont(0.9) within group (order by qq.score) as p90_q_score,
         avg(qq.views_per_day) as avg_q_vpd,
         sum(qq.favs) as total_q_favs,
         sum(qq.has_accepted) as accepted_q_count,
         sum(qq.is_marked_duplicate) as dup_q_count
  from question_quality qq
  group by qq.user_id
),
answer_accept_rate as (
  select a.owneruserid as answerer_id,
         count(*) as answers_written,
         sum(case when q.acceptedanswerid = a.id then 1 else 0 end) as answers_accepted,
         1.0 * sum(case when q.acceptedanswerid = a.id then 1 else 0 end) / nullif(count(*),0) as accept_rate
  from posts a
  join posts q on q.id = a.parentid and q.posttypeid = 1
  where a.posttypeid = 2
  group by a.owneruserid
),
activity_density as (
  select ru.user_id,
         count(*) as total_posts_last_year,
         sum(case when up.posttypeid = 1 then 1 else 0 end) as questions_last_year,
         sum(case when up.posttypeid = 2 then 1 else 0 end) as answers_last_year
  from recent_users ru
  left join user_posts up
    on up.user_id = ru.user_id
   and up.creationdate >= date_trunc('year', cast('2024-10-01 12:34:56' as timestamp)) - interval '1 year'
  group by ru.user_id
),
posttype_pivot as (
  select up.user_id,
         sum(case when pk.posttypename ilike '%question%' then 1 else 0 end) as any_question_marker,
         sum(case when pk.posttypename ilike '%answer%' then 1 else 0 end) as any_answer_marker
  from user_posts up
  join post_kinds pk on pk.posttypeid = up.posttypeid
  group by up.user_id
),
stringy as (
  select ru.user_id,
         upper(coalesce(nullif(ru.displayname,''), 'ANON')) as display_upper,
         left(coalesce(ru.location,'unknown'), 20) as location_short,
         case
           when ru.websiteurl_norm like 'http%' then ru.websiteurl_norm
           when ru.websiteurl_norm = 'n/a' then null
           else 'http://' || ru.websiteurl_norm
         end as website_normalized
  from recent_users ru
),
best_posts as (
  select sr.user_id,
         max(case when sr.posttypeid = 1 and sr.rn = 1 then sr.post_id end) as best_question_id,
         max(case when sr.posttypeid = 2 and sr.rn = 1 then sr.post_id end) as best_answer_id,
         max(case when sr.dr_overall = 1 then sr.post_id end) as best_overall_post_id
  from score_ranked sr
  group by sr.user_id
),
recent_hot as (
  select ph.postid,
         max(ph.creationdate) as last_hot_date
  from posthistory ph
  where ph.posthistorytypeid in (52, 53)
  group by ph.postid
),
final_users as (
  select
    ru.user_id,
    s.display_upper as displayname,
    s.location_short,
    s.website_normalized,
    ru.reputation,
    ua.q_count,
    ua.a_count,
    ua.avg_nonzero_score,
    ua.max_question_views,
    ua.first_post_date,
    ua.last_post_activity,
    ar.accept_rate,
    ar.answers_written,
    b.total_badges,
    b.gold_badges,
    b.silver_badges,
    b.bronze_badges,
    b.tag_badges,
    ce.comments_made,
    ce.avg_comment_score,
    ce.last_comment_date,
    ad.total_posts_last_year,
    ad.questions_last_year,
    ad.answers_last_year,
    pq.any_question_marker,
    pq.any_answer_marker,
    uq.p90_q_score,
    uq.avg_q_vpd,
    uq.total_q_favs,
    uq.accepted_q_count,
    uq.dup_q_count,
    bt.best_question_id,
    bt.best_answer_id,
    bt.best_overall_post_id,
    tt.tag as top_tag
  from recent_users ru
  left join stringy s on s.user_id = ru.user_id
  left join user_activity ua on ua.user_id = ru.user_id
  left join answer_accept_rate ar on ar.answerer_id = ru.user_id
  left join badge_rollup b on b.userid = ru.user_id
  left join comment_engagement ce on ce.user_id = ru.user_id
  left join activity_density ad on ad.user_id = ru.user_id
  left join posttype_pivot pq on pq.user_id = ru.user_id
  left join user_quality_agg uq on uq.user_id = ru.user_id
  left join best_posts bt on bt.user_id = ru.user_id
  left join top_tag_per_user tt on tt.user_id = ru.user_id and tt.tag_rn = 1
),
ranked as (
  select
    fu.*,
    row_number() over (order by coalesce(fu.reputation,0) desc, coalesce(fu.p90_q_score,0) desc nulls last) as rn_bug,
    row_number() over (order by coalesce(fu.reputation,0) desc, coalesce(fu.avg_q_vpd,0) desc nulls last) as user_rank
  from final_users fu
),
post_summaries as (
  select
    p.id,
    p.posttypeid,
    p.owneruserid as user_id,
    p.score,
    p.viewcount,
    p.title,
    r.last_hot_date,
    qi.last_close_reason_code,
    case when qi.last_close_reason_code ~ '^[0-9]+$'
         then (select crt.name from closereasontypes crt where crt.id = cast(qi.last_close_reason_code as smallint))
         else null end as last_close_reason_name
  from posts p
  left join recent_hot r on r.postid = p.id
  left join post_close_info qi on qi.postid = p.id
  where p.posttypeid in (1,2)
),
unioned_best as (
  select 'best_question' as kind, ps.*
  from post_summaries ps
  join ranked rk on rk.best_question_id = ps.id
  union all
  select 'best_answer' as kind, ps.*
  from post_summaries ps
  join ranked rk on rk.best_answer_id = ps.id
  union all
  select 'best_overall' as kind, ps.*
  from post_summaries ps
  join ranked rk on rk.best_overall_post_id = ps.id
),
correlated_flags as (
  select rk.user_id,
         exists (
           select 1
           from posts p2
           where p2.owneruserid = rk.user_id
             and p2.posttypeid = 1
             and p2.score < 0
             and p2.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days'
         ) as has_recent_neg_q,
         exists (
           select 1
           from votes v2
           join posts p3 on p3.id = v2.postid
           where p3.owneruserid = rk.user_id
             and v2.votetypeid = 2
             and v2.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
         ) as has_recent_upvotes
  from ranked rk
)
select
  rk.user_id,
  rk.displayname,
  rk.location_short,
  rk.website_normalized,
  rk.reputation,
  rk.q_count,
  rk.a_count,
  rk.avg_nonzero_score,
  rk.p90_q_score,
  rk.avg_q_vpd,
  rk.total_q_favs,
  rk.accepted_q_count,
  rk.dup_q_count,
  rk.total_badges,
  rk.gold_badges,
  rk.silver_badges,
  rk.bronze_badges,
  rk.tag_badges,
  rk.comments_made,
  rk.avg_comment_score,
  rk.last_comment_date,
  rk.total_posts_last_year,
  rk.questions_last_year,
  rk.answers_last_year,
  rk.accept_rate,
  rk.answers_written,
  rk.any_question_marker,
  rk.any_answer_marker,
  rk.first_post_date,
  rk.last_post_activity,
  rk.top_tag,
  cf.has_recent_neg_q,
  cf.has_recent_upvotes,
  json_build_object(
    'best_question', json_agg(case when ub.kind = 'best_question' then json_build_object(
        'post_id', ub.id,
        'score', ub.score,
        'views', ub.viewcount,
        'title', ub.title,
        'hot_at', ub.last_hot_date,
        'close_reason', coalesce(ub.last_close_reason_name, ''))
      end) filter (where ub.kind = 'best_question'),
    'best_answer', json_agg(case when ub.kind = 'best_answer' then json_build_object(
        'post_id', ub.id,
        'score', ub.score,
        'views', ub.viewcount,
        'title', ub.title)
      end) filter (where ub.kind = 'best_answer'),
    'best_overall', json_agg(case when ub.kind = 'best_overall' then json_build_object(
        'post_id', ub.id,
        'score', ub.score,
        'views', ub.viewcount,
        'title', ub.title)
      end) filter (where ub.kind = 'best_overall')
  ) as best_posts_json,
  sum(case when ub.kind = 'best_question' then ub.viewcount else 0 end) as best_q_views,
  sum(case when ub.kind = 'best_answer' then ub.viewcount else 0 end) as best_a_views
from ranked rk
left join correlated_flags cf on cf.user_id = rk.user_id
left join unioned_best ub on ub.user_id = rk.user_id
where coalesce(rk.q_count,0) + coalesce(rk.a_count,0) > 0
  and (rk.gold_badges is null or rk.gold_badges >= 0)
  and (rk.displayname is not null or rk.location_short is not null)
group by
  rk.user_id, rk.displayname, rk.location_short, rk.website_normalized, rk.reputation,
  rk.q_count, rk.a_count, rk.avg_nonzero_score, rk.p90_q_score, rk.avg_q_vpd, rk.total_q_favs,
  rk.accepted_q_count, rk.dup_q_count, rk.total_badges, rk.gold_badges, rk.silver_badges,
  rk.bronze_badges, rk.tag_badges, rk.comments_made, rk.avg_comment_score, rk.last_comment_date,
  rk.total_posts_last_year, rk.questions_last_year, rk.answers_last_year, rk.accept_rate,
  rk.answers_written, rk.any_question_marker, rk.any_answer_marker, rk.first_post_date,
  rk.last_post_activity, rk.top_tag, cf.has_recent_neg_q, cf.has_recent_upvotes
having coalesce(sum(case when ub.kind = 'best_question' then 1 else 0 end),0) >= 0
order by rk.user_rank nulls last, rk.user_id
limit 250;