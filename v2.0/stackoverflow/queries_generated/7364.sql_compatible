SELECT 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) as TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 3 THEN p.Id END) as Wikis,
    SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) as TotalQuestionScore,
    SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) as TotalAnswerScore,
    AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE NULL END) as AvgQuestionScore,
    AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE NULL END) as AvgAnswerScore,
    MAX(p.CreationDate) as LatestPostDate,
    MIN(p.CreationDate) as EarliestPostDate,
    COUNT(DISTINCT b.Id) as BadgesCount,
    STRING_AGG(DISTINCT b.Name, ', ') as BadgeNames,
    COUNT(DISTINCT COALESCE(p.OwnerUserId, p.LastEditorUserId)) as PostEditCount,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN p.Id END) as QuestionsWithAcceptedAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL THEN p.Id END) as ClosedQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.AnswerCount > 0 THEN p.Id END) as QuestionsWithAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 AND p.ParentId IS NOT NULL THEN p.Id END) as AnsweredPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.Tags IS NOT NULL AND p.Tags != '' THEN p.Id END) as TaggedQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 AND p.ViewCount > 1000 THEN p.Id END) as HighlyViewedQuestions,
    CASE 
        WHEN COUNT(DISTINCT p.Id) > 0 THEN 
            ROUND((COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) * 100.0 / COUNT(DISTINCT p.Id)), 2)
        ELSE 0 
    END as QuestionPercentage,
    CASE 
        WHEN MAX(p.CreationDate) IS NOT NULL AND MIN(p.CreationDate) IS NOT NULL THEN 
            CAST((JULIANDAY(MAX(p.CreationDate)) - JULIANDAY(MIN(p.CreationDate))) AS INTEGER)
        ELSE 0 
    END as ActiveDays,
    ROW_NUMBER() OVER (ORDER BY SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) DESC) as QuestionScoreRank,
    RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostCountRank,
    DENSE_RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
    CASE 
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 100 THEN 'Elite'
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 50 THEN 'Veteran'
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 10 THEN 'Regular'
        ELSE 'Newbie'
    END as UserTier,
    (SELECT COUNT(*) 
     FROM Posts p2 
     WHERE p2.OwnerUserId = u.Id 
       AND p2.PostTypeId = 1 
       AND p2.CreationDate >= DATETIME('2024-10-01 12:34:56', '-1 year')) as RecentQuestions,
    (SELECT COUNT(*) 
     FROM Posts p3 
     WHERE p3.OwnerUserId = u.Id 
       AND p3.PostTypeId = 2 
       AND p3.CreationDate >= DATETIME('2024-10-01 12:34:56', '-1 year')) as RecentAnswers,
    CASE 
        WHEN u.Reputation < 1000 THEN 'Beginner'
        WHEN u.Reputation BETWEEN 1000 AND 5000 THEN 'Intermediate'
        WHEN u.Reputation BETWEEN 5001 AND 10000 THEN 'Advanced'
        WHEN u.Reputation > 10000 THEN 'Expert'
        ELSE 'Novice'
    END as ReputationTier,
    COALESCE(
        (SELECT GROUP_CONCAT(t.TagName, ', ')
         FROM (
             SELECT TRIM(tag) as TagName
             FROM Posts p4,
                  (SELECT 1) AS dummy,
                  (SELECT NULL) AS split_helper
             CROSS JOIN (
                 SELECT 
                     SUBSTR(p4.Tags, start+1, endpos-start-1) AS tag
                 FROM (
                     SELECT -1 as start
                     UNION ALL
                     SELECT instr(substr(p4.Tags, start+2), '><')+start+1 FROM (SELECT -1 as start)
                 ) s
             ) tags_extracted
         ) tt
         WHERE p4.OwnerUserId = u.Id 
           AND p4.PostTypeId = 1
           AND LENGTH(p4.Tags) > 2
         ), 'No Tags'
    ) as FavoredTags,
    ROUND(
        (COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) * 100.0 / 
         NULLIF((SELECT COUNT(*) FROM Posts WHERE PostTypeId = 1), 0)),
        4
    ) as PercentageOfTotalQuestions,
    CASE 
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 0 
             AND COUNT(DISTINCT b.Id) > 0 
        THEN CAST(COUNT(DISTINCT b.Id) AS DOUBLE) / CAST(COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS DOUBLE)
        ELSE 0 
    END as BadgesPerQuestion,
    (SELECT p5.Title 
     FROM Posts p5 
     WHERE p5.OwnerUserId = u.Id 
       AND p5.PostTypeId = 1 
     ORDER BY p5.CreationDate DESC
     LIMIT 1) as LatestQuestionTitle,
    (SELECT p6.Body 
     FROM Posts p6 
     WHERE p6.OwnerUserId = u.Id 
       AND p6.PostTypeId = 1 
     ORDER BY p6.CreationDate DESC
     LIMIT 1) as LatestQuestionBody
FROM Users u
LEFT JOIN Posts p ON u.Id = p.OwnerUserId OR u.Id = p.LastEditorUserId
LEFT JOIN Badges b ON u.Id = b.UserId
WHERE u.Id > 0 
  AND u.Reputation > 0
  AND (p.PostTypeId = 1 OR p.PostTypeId = 2 OR p.PostTypeId = 3 OR p.PostTypeId IS NULL)
GROUP BY u.Id, u.DisplayName, u.Reputation
HAVING COUNT(DISTINCT p.Id) > 0
   OR COUNT(DISTINCT b.Id) > 0
   OR COUNT(DISTINCT p.OwnerUserId) > 0
ORDER BY u.Reputation DESC, COUNT(DISTINCT p.Id) DESC
LIMIT 1000 OFFSET 0;