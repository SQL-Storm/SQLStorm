WITH UserStats AS (
    SELECT u.Id,
           u.DisplayName,
           u.Reputation,
           (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id)                              AS TotalPosts,
           (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1)          AS Questions,
           (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2)          AS Answers,
           (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1)                    AS GoldBadges,
           (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2)                    AS SilverBadges,
           (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3)                    AS BronzeBadges,
           (SELECT AVG(p.Score::numeric) FROM Posts p WHERE p.OwnerUserId = u.Id)                            AS AvgScore
    FROM Users u
),
RecentVotes AS (
    SELECT v.UserId,
           COUNT(CASE WHEN vt.Name = 'UpMod' THEN 1 END)      AS UpVotes,
           COUNT(CASE WHEN vt.Name = 'DownMod' THEN 1 END)    AS DownVotes,
           COUNT(CASE WHEN vt.Name = 'Favorite' THEN 1 END)   AS Favorites,
           MAX(v.CreationDate)                                AS LastVoteDate
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE v.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '30 days')
    GROUP BY v.UserId
),
TagInfo AS (
    SELECT t.TagName,
           t.Count                                            AS TagUseCount,
           COALESCE(p.Title,  '')                             AS TagWikiTitle,
           COALESCE(p.Body,   '')                             AS TagWikiExcerpt
    FROM Tags t
    LEFT JOIN Posts p ON p.Id = t.WikiPostId
    WHERE t.IsModeratorOnly = FALSE
),
TopQuestions AS (
    SELECT p.Id,
           p.Title,
           p.Score,
           p.ViewCount,
           ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS Rank
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.ClosedDate IS NULL
      AND p.Score > 0
),
DuplicateLinks AS (
    SELECT pl.PostId      AS QuestionId,
           pl.RelatedPostId AS DuplicateOf,
           pl.CreationDate
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    WHERE lt.Name = 'Duplicate'
),
UserQuestionStats AS (
    SELECT u.Id                                                AS UserId,
           COUNT(CASE WHEN p.Score >= 10 THEN 1 END)             AS HighScoreQuestions,
           MAX(p.CreationDate)                                   AS LastQuestionDate,
           STRING_AGG(DISTINCT COALESCE(NULLIF(TRIM(BOTH '><' FROM p.Tags), ''), ''), ';')
                                                               AS AllTags
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    GROUP BY u.Id
)
SELECT us.Id,
       us.DisplayName,
       us.Reputation,
       us.TotalPosts,
       us.Questions,
       us.Answers,
       us.GoldBadges,
       us.SilverBadges,
       us.BronzeBadges,
       ROUND(us.AvgScore, 2)                                        AS AvgScore,
       COALESCE(rv.UpVotes, 0)                                      AS RecentUpVotes,
       COALESCE(rv.DownVotes, 0)                                    AS RecentDownVotes,
       COALESCE(rv.Favorites, 0)                                    AS RecentFavorites,
       rv.LastVoteDate,
       uqs.HighScoreQuestions,
       uqs.LastQuestionDate,
       uqs.AllTags,
       CASE
           WHEN EXISTS (SELECT 1
                        FROM DuplicateLinks dl
                        WHERE dl.QuestionId IN (SELECT p.Id
                                               FROM Posts p
                                               WHERE p.OwnerUserId = us.Id
                                                 AND p.PostTypeId = 1))
               THEN 'Has Duplicates'
           ELSE 'No Duplicates'
       END                                                         AS DuplicateStatus,
       tq.Id                                                        AS TopQuestionId,
       tq.Title                                                     AS TopQuestionTitle,
       tq.Score                                                     AS TopQuestionScore,
       tq.ViewCount                                                 AS TopQuestionViews
FROM UserStats us
LEFT JOIN RecentVotes rv          ON rv.UserId = us.Id
LEFT JOIN UserQuestionStats uqs   ON uqs.UserId = us.Id
LEFT JOIN LATERAL (
        SELECT tq.Id, tq.Title, tq.Score, tq.ViewCount
        FROM TopQuestions tq
        WHERE tq.Id = (SELECT p.Id
                       FROM Posts p
                       WHERE p.OwnerUserId = us.Id
                         AND p.PostTypeId = 1
                       ORDER BY p.Score DESC
                       LIMIT 1)
        LIMIT 1
) tq ON TRUE
WHERE us.Reputation > 10000
  AND (us.GoldBadges + us.SilverBadges + us.BronzeBadges) >= 10
  AND us.AvgScore IS NOT NULL

UNION ALL

SELECT NULL::integer                                          AS Id,
       'Tag Summary'                                           AS DisplayName,
       NULL::integer                                          AS Reputation,
       NULL::integer                                          AS TotalPosts,
       NULL::integer                                          AS Questions,
       NULL::integer                                          AS Answers,
       NULL::integer                                          AS GoldBadges,
       NULL::integer                                          AS SilverBadges,
       NULL::integer                                          AS BronzeBadges,
       NULL::numeric                                          AS AvgScore,
       NULL::integer                                          AS RecentUpVotes,
       NULL::integer                                          AS RecentDownVotes,
       NULL::integer                                          AS RecentFavorites,
       NULL::timestamp                                        AS LastVoteDate,
       NULL::integer                                          AS HighScoreQuestions,
       NULL::timestamp                                        AS LastQuestionDate,
       NULL::text                                             AS AllTags,
       NULL::text                                             AS DuplicateStatus,
       ti.TagName::text                                       AS TopQuestionId,
       ti.TagUseCount::text                                   AS TopQuestionTitle,
       ti.TagWikiTitle::text                                  AS TopQuestionScore,
       ti.TagWikiExcerpt::text                                AS TopQuestionViews
FROM TagInfo ti
WHERE ti.TagUseCount > 1000
ORDER BY Reputation DESC NULLS LAST,
         DuplicateStatus ASC NULLS LAST
LIMIT 100;