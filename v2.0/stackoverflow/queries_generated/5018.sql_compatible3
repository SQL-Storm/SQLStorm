WITH
RecentTopPosts AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.Tags,
    p.OwnerUserId,
    u.DisplayName AS OwnerName,
    ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.ViewCount DESC, p.CreationDate DESC) AS rn
  FROM Posts p
  JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '180' DAY
),
TagAnalysis AS (
  SELECT
    t.TagName,
    COUNT(*) AS TagCount,
    AVG(p.Score) AS AvgScore,
    MAX(p.ViewCount) AS MaxViews
  FROM tagging tg
  JOIN Tags t ON tg.TagId = t.Id
  JOIN Posts p ON p.Id = tg.PostId
  GROUP BY t.TagName
),
CorrelatedNotes AS (
  SELECT
    r.PostId,
    r.Title,
    r.OwnerName,
    r.CreationDate,
    r.Score,
    r.ViewCount,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = r.PostId) AS CommentCount,
    (SELECT STRING_AGG(CONCAT('u', c.UserId, ':', c.Score), '|' ORDER BY c.Id) FROM Comments c WHERE c.PostId = r.PostId) AS CommentVotes,
    (SELECT MAX(v.CreationDate) FROM Votes v WHERE v.PostId = r.PostId) AS LastVoteDate
  FROM RecentTopPosts r
  WHERE r.rn <= 5
)
SELECT
  c.PostId,
  c.Title,
  c.OwnerName,
  c.CreationDate,
  c.Score,
  c.ViewCount,
  c.CommentCount,
  c.CommentVotes,
  c.LastVoteDate,
  ta.TagName,
  ta.TagCount,
  ta2.AvgScore,
  ta2.MaxViews
FROM CorrelatedNotes c
LEFT JOIN (
  SELECT
    p.Id AS PostId,
    t.TagName,
    COUNT(*) OVER (PARTITION BY t.TagName) AS TagCount,
    t.TagName AS TagAlias
  FROM Posts p
  JOIN Tags t ON p.Tags LIKE '%' || t.TagName || '%'
  WHERE p.PostTypeId = 1
) ta ON ta.PostId = c.PostId
LEFT JOIN TagAnalysis ta2 ON ta.TagName = ta2.TagName
GROUP BY
  c.PostId,
  c.Title,
  c.OwnerName,
  c.CreationDate,
  c.Score,
  c.ViewCount,
  c.CommentCount,
  c.CommentVotes,
  c.LastVoteDate,
  ta.TagName,
  ta.TagCount,
  ta2.AvgScore,
  ta2.MaxViews
ORDER BY c.CreationDate DESC, c.Score DESC
LIMIT 100;