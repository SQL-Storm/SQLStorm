SELECT 
    u.DisplayName,
    u.Reputation,
    u.Location,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) AS TotalQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id ELSE NULL END) AS TotalAnswers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 3 THEN p.Id ELSE NULL END) AS TotalWikis,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.PostId ELSE NULL END) AS TotalUpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.PostId ELSE NULL END) AS TotalDownVotes,
    MAX(p.Score) AS HighestScoredPost,
    AVG(p.Score) AS AverageScore,
    MIN(p.LastEditDate) AS FirstEditedPost,
    MAX(p.LastEditDate) AS MostRecentlyEditedPost,
    STRING_AGG(DISTINCT t.TagName, ', ') AS MostCommonTags,
    (
        SELECT COUNT(*) 
        FROM Badges b 
        WHERE b.UserId = u.Id AND b.Class = 1
    ) AS GoldBadgeCount,
    (
        SELECT COUNT(*) 
        FROM Badges b 
        WHERE b.UserId = u.Id AND b.Class = 2
    ) AS SilverBadgeCount,
    (
        SELECT COUNT(*) 
        FROM Badges b 
        WHERE b.UserId = u.Id AND b.Class = 3
    ) AS BronzeBadgeCount,
    (
        SELECT COUNT(*) 
        FROM Comments c 
        WHERE c.UserId = u.Id
    ) AS CommentCount,
    (
        SELECT SUM(p2.Score) 
        FROM Posts p2 
        WHERE p2.OwnerUserId = u.Id 
    ) AS TotalOwnerScore,
    (
        SELECT COUNT(*) 
        FROM Posts p3 
        WHERE p3.AcceptedAnswerId IS NOT NULL AND p3.OwnerUserId = u.Id
    ) AS AcceptedAnswerCount
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    Tags t ON (t.TagName = REPLACE(REPLACE(t.TagName, '<', ''), '>', ''))
    OR EXISTS (
        SELECT 1
        FROM (
            SELECT value AS tag
            FROM (
                -- split tags string like '<tag1><tag2>' into rows in a dialect-neutral way using common table expression of numbers
                SELECT
                    CASE
                        WHEN p.Tags IS NULL OR p.Tags = '' THEN NULL
                        ELSE p.Tags
                    END AS tags_example
            ) te
            CROSS JOIN LATERAL (
                -- generate tags by repeatedly extracting between '<' and '>'
                SELECT TRIM(both ' ' FROM sub.tag) AS value
                FROM (
                    SELECT
                        -- replace leading and trailing angle brackets, then split by '><'
                        -- use replace to normalize: remove leading '<' and trailing '>'
                        -- then split using simple string splitting via builtin functions depending on dialect; fallback to single value
                        CASE
                            WHEN te.tags_example IS NULL THEN ''
                            ELSE te.tags_example
                        END AS raw_tags
                ) r
                CROSS JOIN LATERAL (
                    -- attempt to split using a simple method: replace '><' with a delimiter and then split by that delimiter
                    SELECT value
                    FROM (
                        SELECT regexp_split_to_table(r.raw_tags, '><') AS value
                    ) s
                ) sub
            ) sub
        ) s
        WHERE s.tag IS NOT NULL AND s.tag <> '' AND s.tag = t.TagName
    )
GROUP BY 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.Location
ORDER BY 
    u.Reputation DESC;