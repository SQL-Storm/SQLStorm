WITH 
    q_posts AS (
        SELECT 
            p.Id,
            p.Title,
            p.CreationDate,
            p.OwnerUserId,
            p.Score,
            p.ViewCount,
            NULLIF(p.Tags,'') AS RawTags,
            p.Tags,
            p.PostTypeId
        FROM Posts p
        WHERE p.PostTypeId = 1
    ),
    tags_expanded AS (
        SELECT
            q.Id,
            q.Title,
            q.CreationDate,
            q.OwnerUserId,
            q.Score,
            q.ViewCount,
            TRIM(BOTH '<' FROM TRIM(BOTH '>' FROM token)) AS Tag
        FROM q_posts q,
        LATERAL (
          SELECT unnest(string_to_array(TRIM(BOTH '><' FROM q.RawTags), '><')) AS token
        ) s
        WHERE q.RawTags IS NOT NULL
    ),
    user_agg AS (
        SELECT 
            u.Id AS UserId,
            u.DisplayName,
            u.Reputation,
            COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
            COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
            COALESCE(SUM(b.Class),0) AS BadgeScore,
            ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY u.Reputation DESC) AS RepRank
        FROM Users u
        LEFT JOIN Posts p ON p.OwnerUserId = u.Id
        LEFT JOIN Badges b ON b.UserId = u.Id
        GROUP BY u.Id, u.DisplayName, u.Reputation
    ),
    top_tags AS (
        SELECT 
            te.Tag,
            COUNT(*) AS TagUseCount,
            ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC) AS TagRank
        FROM tags_expanded te
        GROUP BY te.Tag
        HAVING COUNT(*) > 10
    ),
    answer_stats AS (
        SELECT 
            a.ParentId AS QuestionId,
            COUNT(*) AS AnswerCount,
            AVG(a.Score) AS AvgAnswerScore,
            MAX(a.Score) AS MaxAnswerScore,
            SUM(CASE WHEN a.OwnerUserId IS NULL THEN 1 ELSE 0 END) AS AnonymousAnswers
        FROM Posts a
        WHERE a.PostTypeId = 2
        GROUP BY a.ParentId
    ),
    recent_votes AS (
        SELECT 
            v.PostId,
            v.VoteTypeId,
            v.CreationDate,
            ROW_NUMBER() OVER (PARTITION BY v.PostId ORDER BY v.CreationDate DESC) AS VoteSeq
        FROM Votes v
        WHERE v.CreationDate >= (DATE '2024-10-01' - INTERVAL '30' DAY)
    ),
    voted_posts AS (
        SELECT 
            rv.PostId,
            MAX(CASE WHEN rv.VoteTypeId = 2 THEN 1 ELSE 0 END) AS HasRecentUpvote,
            MAX(CASE WHEN rv.VoteTypeId = 3 THEN 1 ELSE 0 END) AS HasRecentDownvote
        FROM recent_votes rv
        GROUP BY rv.PostId
    ),
    main_results AS (
      SELECT 
          q.Id                                 AS QuestionId,
          q.Title,
          q.CreationDate,
          q.Score,
          q.ViewCount,
          COALESCE(u.DisplayName,'Community')   AS OwnerName,
          u.Reputation,
          u.QuestionCount,
          u.AnswerCount,
          u.BadgeScore,
          t.Tag,
          t.TagUseCount,
          a.AnswerCount                         AS TotalAnswers,
          a.AvgAnswerScore,
          a.MaxAnswerScore,
          a.AnonymousAnswers,
          CASE 
              WHEN vp.HasRecentUpvote = 1   THEN 'Upvoted Recently'
              WHEN vp.HasRecentDownvote = 1 THEN 'Downvoted Recently'
              ELSE                               'No Recent Vote'
          END                                   AS RecentVoteStatus,
          ROW_NUMBER() OVER (ORDER BY q.Score DESC, q.ViewCount DESC, q.Id) AS RankByScore
      FROM q_posts q
      LEFT JOIN user_agg u      ON u.UserId = q.OwnerUserId
      LEFT JOIN tags_expanded te ON te.Id = q.Id
      LEFT JOIN top_tags t      ON t.Tag = te.Tag
      LEFT JOIN answer_stats a  ON a.QuestionId = q.Id
      LEFT JOIN voted_posts vp  ON vp.PostId = q.Id
      WHERE 
          (q.Score > 0 OR q.ViewCount > 1000)
          AND (t.TagRank IS NULL OR t.TagRank <= 5)
          AND (u.RepRank <= 100 OR u.BadgeScore > 0)
          AND (COALESCE(q.Tags,'') ILIKE '%<sql>%')
          AND NOT EXISTS (
              SELECT 1 
              FROM PostHistory ph 
              WHERE ph.PostId = q.Id 
                AND ph.PostHistoryTypeId = 12
          )
    ),
    deleted_results AS (
      SELECT 
          p.Id,
          p.Title,
          p.CreationDate,
          p.Score,
          p.ViewCount,
          'Deleted'                               AS OwnerName,
          CAST(NULL AS VARCHAR)                    AS Reputation,
          CAST(NULL AS INTEGER)                   AS QuestionCount,
          CAST(NULL AS INTEGER)                   AS AnswerCount,
          CAST(NULL AS INTEGER)                   AS BadgeScore,
          CAST(NULL AS VARCHAR)                    AS Tag,
          CAST(NULL AS INTEGER)                   AS TagUseCount,
          CAST(NULL AS INTEGER)                   AS TotalAnswers,
          CAST(NULL AS NUMERIC)                   AS AvgAnswerScore,
          CAST(NULL AS INTEGER)                   AS MaxAnswerScore,
          CAST(NULL AS INTEGER)                   AS AnonymousAnswers,
          'Deleted Post'                          AS RecentVoteStatus,
          ROW_NUMBER() OVER (ORDER BY p.CreationDate DESC, p.Id) AS RankByScore
      FROM Posts p
      WHERE p.PostTypeId = 1
        AND p.Id NOT IN (SELECT Id FROM q_posts)
        AND p.CreationDate < (DATE '2024-10-01' - INTERVAL '5' YEAR)
    ),
    combined AS (
      SELECT 
        QuestionId,
        Title,
        CreationDate,
        Score,
        ViewCount,
        OwnerName,
        Reputation,
        QuestionCount,
        AnswerCount,
        BadgeScore,
        Tag,
        TagUseCount,
        TotalAnswers,
        AvgAnswerScore,
        MaxAnswerScore,
        AnonymousAnswers,
        RecentVoteStatus,
        RankByScore
      FROM main_results
      UNION ALL
      SELECT 
        Id AS QuestionId,
        Title,
        CreationDate,
        Score,
        ViewCount,
        OwnerName,
        Reputation,
        QuestionCount,
        AnswerCount,
        BadgeScore,
        Tag,
        TagUseCount,
        TotalAnswers,
        AvgAnswerScore,
        MaxAnswerScore,
        AnonymousAnswers,
        RecentVoteStatus,
        RankByScore
      FROM deleted_results
    )
SELECT *
FROM combined
ORDER BY RankByScore DESC
LIMIT 120;