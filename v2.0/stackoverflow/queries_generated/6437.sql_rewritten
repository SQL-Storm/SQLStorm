-- {"query": "6437.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 463} 
SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class AS BadgeClass,
    t.TagName,
    ph.RevisionGUID,
    ph.CreationDate AS LastRevisionDate,
    ph.Comment,
    v.VoteTypeId,
    v.BountyAmount,
    c.Text AS CommentText,
    l.LinkTypeId,
    l.RelatedPostId
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    Comments c ON p.Id = c.PostId
LEFT JOIN 
    PostLinks l ON p.Id = l.PostId
LEFT JOIN 
    Tags t ON t.ExcerptPostId = p.Id
WHERE 
    u.Reputation > 1000
    AND p.Score > 0
    AND (v.VoteTypeId = 2 OR v.VoteTypeId = 3)
    AND p.LastActivityDate > p.CreationDate
    AND ph.PostHistoryTypeId IN (1, 2, 5, 6) 
    AND (ph.Comment IS NOT NULL OR ph.RevisionGUID IS NOT NULL)
GROUP BY 
    u.Id, b.Class, t.Id, ph.Id, v.Id, c.Id, l.Id
HAVING 
    COUNT(DISTINCT v.PostId) > 10
ORDER BY 
    u.Reputation DESC
LIMIT 100;