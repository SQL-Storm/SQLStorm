WITH 
    UserStats AS (
        SELECT 
            u.Id,
            u.DisplayName,
            u.Reputation,
            COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0) AS NetVotes,
            (SELECT COUNT(*) FROM Posts p 
               WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
            (SELECT COUNT(*) FROM Posts p 
               WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
            (SELECT MAX(CreationDate) FROM Posts p 
               WHERE p.OwnerUserId = u.Id) AS LastPostDate
        FROM Users u
    ),

    BadgeAgg AS (
        SELECT 
            b.UserId,
            SUM(CASE WHEN b.Class = 1 THEN 1000 WHEN b.Class = 2 THEN 500 ELSE 100 END) AS BadgeScore,
            SUM(CASE WHEN b.TagBased = 1 THEN 1 ELSE 0 END) AS TagBadgeCount,
            SUM(CASE WHEN b.TagBased = 0 THEN 1 ELSE 0 END) AS NamedBadgeCount
        FROM Badges b
        GROUP BY b.UserId
    ),

    TagPopularity AS (
        SELECT 
            t.TagName,
            t.Count,
            ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS TagRank
        FROM Tags t
        WHERE t.TagName IS NOT NULL
    ),

    UserTagActivity AS (
        SELECT 
            u.Id AS UserId,
            UNNEST(string_to_array(TRIM(BOTH '<>' FROM p.Tags), '><')) AS Tag,
            COUNT(*) AS PostsWithTag
        FROM Users u
        JOIN Posts p ON p.OwnerUserId = u.Id
        WHERE p.PostTypeId = 1
          AND p.Tags IS NOT NULL
        GROUP BY u.Id, Tag
    ),

    RankedUsers AS (
        SELECT 
            us.Id,
            us.DisplayName,
            us.Reputation,
            us.NetVotes,
            COALESCE(ba.BadgeScore,0) AS BadgeScore,
            (COALESCE(us.QuestionCount,0)+COALESCE(us.AnswerCount,0)) AS TotalPosts,
            ROW_NUMBER() OVER (ORDER BY (us.Reputation + COALESCE(ba.BadgeScore,0) + us.NetVotes) DESC) AS OverallRank,
            us.LastPostDate
        FROM UserStats us
        LEFT JOIN BadgeAgg ba ON ba.UserId = us.Id
        WHERE us.Reputation > 1000
    )

SELECT
    ru.Id,
    ru.DisplayName,
    ru.Reputation,
    ru.NetVotes,
    ru.BadgeScore,
    ru.TotalPosts,
    ru.OverallRank,
    COALESCE(ru.LastPostDate, CAST('1970-01-01' AS timestamp)) AS LastPostDate,
    COALESCE(uta.PostsWithTag,0) AS PostsWithTopTag,
    COALESCE(tp.TagName,'<no tag>') AS TopTag,
    CASE 
        WHEN ru.OverallRank <= 10  THEN 'Elite'
        WHEN ru.OverallRank <= 100 THEN 'Pro'
        ELSE 'Member' 
    END AS Tier,
    (SELECT COUNT(*) FROM Votes v 
        WHERE v.UserId = ru.Id AND v.VoteTypeId = 2) AS UpVoteGivenCount,
    (SELECT COUNT(*) FROM Votes v 
        WHERE v.PostId IN (SELECT p.Id FROM Posts p WHERE p.OwnerUserId = ru.Id)
          AND v.VoteTypeId = 5) AS FavoritesReceived,
    vs.VoteScore
FROM RankedUsers ru
LEFT JOIN UserTagActivity uta 
       ON uta.UserId = ru.Id
LEFT JOIN TagPopularity tp 
       ON tp.TagName = uta.Tag AND tp.TagRank = 1
LEFT JOIN LATERAL (
    SELECT SUM(CASE v.VoteTypeId 
                 WHEN 2 THEN 1
                 WHEN 3 THEN -1
                 ELSE 0 
               END) AS VoteScore
    FROM Votes v
    WHERE v.PostId IN (SELECT p.Id FROM Posts p WHERE p.OwnerUserId = ru.Id)
) vs ON TRUE
WHERE (tp.TagRank IS NULL OR tp.TagRank <= 5)
ORDER BY ru.OverallRank
LIMIT 100

UNION ALL

SELECT
    CAST(NULL AS integer)          AS Id,
    CAST('---' AS varchar(40))     AS DisplayName,
    CAST(NULL AS integer)          AS Reputation,
    CAST(NULL AS integer)          AS NetVotes,
    CAST(NULL AS integer)          AS BadgeScore,
    CAST(NULL AS integer)          AS TotalPosts,
    CAST(NULL AS integer)          AS OverallRank,
    CAST(NULL AS timestamp)        AS LastPostDate,
    CAST(NULL AS integer)          AS PostsWithTopTag,
    CAST(NULL AS varchar(35))      AS TopTag,
    CAST(NULL AS varchar(10))      AS Tier,
    CAST(NULL AS integer)          AS UpVoteGivenCount,
    CAST(NULL AS integer)          AS FavoritesReceived,
    CAST(NULL AS integer)          AS VoteScore
WHERE FALSE;