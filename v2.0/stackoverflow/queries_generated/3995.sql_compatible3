WITH UserStats AS (
    SELECT u.Id                          AS UserId,
           u.DisplayName,
           u.Reputation,
           COUNT(p.Id)                    AS TotalPosts,
           SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
           SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
           AVG(p.Score)                   AS AvgPostScore,
           MAX(p.CreationDate)            AS LastPostDate
    FROM   Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
BadgeStats AS (
    SELECT b.UserId,
           COUNT(*)                                    AS TotalBadges,
           SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
           SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
           SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM   Badges b
    GROUP BY b.UserId
),
-- Replace UNNEST/string_to_array with string splitting using a recursive CTE compatible approach
TagPairs AS (
    SELECT p.OwnerUserId AS UserId,
           TRIM(BOTH '<>' FROM p.Tags) AS TagsStr
    FROM   Posts p
    WHERE  p.Tags IS NOT NULL
),
SplitTags AS (
    SELECT UserId,
           CASE
             WHEN TagsStr = '' THEN NULL
             WHEN INSTR(TagsStr, '><') = 0 THEN TagsStr
             ELSE SUBSTR(TagsStr, 1, CASE WHEN INSTR(TagsStr, '><')=0 THEN LENGTH(TagsStr) ELSE INSTR(TagsStr, '><')-1 END)
           END AS Tag,
           CASE
             WHEN INSTR(TagsStr, '><') = 0 THEN NULL
             ELSE SUBSTR(TagsStr, INSTR(TagsStr, '><')+2)
           END AS Remainder
    FROM TagPairs
    UNION ALL
    SELECT UserId,
           CASE
             WHEN Remainder = '' THEN NULL
             WHEN INSTR(Remainder, '><') = 0 THEN Remainder
             ELSE SUBSTR(Remainder, 1, INSTR(Remainder, '><')-1)
           END AS Tag,
           CASE
             WHEN INSTR(Remainder, '><') = 0 THEN NULL
             ELSE SUBSTR(Remainder, INSTR(Remainder, '><')+2)
           END AS Remainder
    FROM SplitTags
    WHERE Remainder IS NOT NULL
),
TagUsage AS (
    SELECT UserId,
           Tag,
           COUNT(*) AS TagCount
    FROM SplitTags
    WHERE Tag IS NOT NULL AND TRIM(Tag) <> ''
    GROUP BY UserId, Tag
),
TopTags AS (
    SELECT tu.UserId,
           LISTAGG(tu.Tag || ':' || CAST(tu.TagCount AS VARCHAR), ', ') WITHIN GROUP (ORDER BY tu.TagCount DESC) AS TopTagsList
    FROM (
        SELECT tu_inner.*,
               ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY TagCount DESC) AS rn
        FROM   TagUsage tu_inner
    ) tu
    WHERE  tu.rn <= 5
    GROUP BY tu.UserId
),
RecentActivity AS (
    SELECT u.Id                                        AS UserId,
           MAX(COALESCE(p.LastActivityDate, p.CreationDate)) AS RecentActivityDate,
           COUNT(DISTINCT c.Id)                      AS RecentCommentCount
    FROM   Users u
    LEFT JOIN Posts    p ON p.OwnerUserId = u.Id
                         AND p.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30' DAY)
    LEFT JOIN Comments c ON c.UserId = u.Id
                         AND c.CreationDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30' DAY)
    GROUP BY u.Id
),
UserRanking AS (
    SELECT us.UserId,
           us.Reputation,
           ROW_NUMBER() OVER (ORDER BY us.Reputation DESC) AS RepRank,
           PERCENT_RANK() OVER (ORDER BY us.Reputation)   AS RepPercentile
    FROM   UserStats us
)
SELECT us.UserId,
       us.DisplayName,
       us.Reputation,
       us.TotalPosts,
       us.QuestionCount,
       us.AnswerCount,
       ROUND(CAST(us.AvgPostScore AS NUMERIC), 2)            AS AvgScore,
       COALESCE(bs.TotalBadges, 0)                  AS TotalBadges,
       COALESCE(bs.GoldBadges, 0)                   AS GoldBadges,
       COALESCE(bs.SilverBadges, 0)                 AS SilverBadges,
       COALESCE(bs.BronzeBadges, 0)                 AS BronzeBadges,
       COALESCE(tt.TopTagsList, '')                 AS TopTags,
       ur.RepRank,
       ROUND(CAST(ur.RepPercentile * 100 AS NUMERIC), 2)   AS RepPercentile,
       ra.RecentActivityDate,
       ra.RecentCommentCount,
       CASE
           WHEN us.Reputation > (SELECT AVG(u2.Reputation) FROM Users u2) THEN 'Above Avg'
           WHEN us.Reputation = (SELECT AVG(u2.Reputation) FROM Users u2) THEN 'Average'
           ELSE 'Below Avg'
       END                                          AS ReputationTier,
       (SELECT COUNT(*) FROM Posts p2
        WHERE p2.OwnerUserId = us.UserId AND p2.Score < 0) AS NegativeScorePosts,
       (SELECT COUNT(*) FROM Votes v
        WHERE v.UserId = us.UserId AND v.VoteTypeId = 2)   AS UpVotesGiven,
       (SELECT COUNT(*) FROM Votes v
        WHERE v.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = us.UserId)
          AND v.VoteTypeId = 2)                           AS UpVotesReceived,
       (SELECT STRING_AGG(DISTINCT t.TagName, ', ')
        FROM   Tags t
        JOIN   PostLinks pl ON pl.RelatedPostId = t.WikiPostId
        WHERE  pl.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = us.UserId)
       )                                                  AS AllUserTags
FROM   UserStats      us
LEFT JOIN BadgeStats    bs ON bs.UserId = us.UserId
LEFT JOIN TopTags       tt ON tt.UserId = us.UserId
LEFT JOIN RecentActivity ra ON ra.UserId = us.UserId
LEFT JOIN UserRanking   ur ON ur.UserId = us.UserId
WHERE  us.Reputation IS NOT NULL
GROUP BY
       us.UserId,
       us.DisplayName,
       us.Reputation,
       us.TotalPosts,
       us.QuestionCount,
       us.AnswerCount,
       us.AvgPostScore,
       bs.TotalBadges,
       bs.GoldBadges,
       bs.SilverBadges,
       bs.BronzeBadges,
       tt.TopTagsList,
       ur.RepRank,
       ur.RepPercentile,
       ra.RecentActivityDate,
       ra.RecentCommentCount
ORDER BY us.Reputation DESC
LIMIT 100;