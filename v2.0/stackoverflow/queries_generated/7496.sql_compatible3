WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.DisplayName,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        COUNT(DISTINCT v.Id) AS VoteCount,
        MAX(p.CreationDate) AS LastPostDate,
        MAX(v.CreationDate) AS LastVoteDate,
        MAX(c.CreationDate) AS LastCommentDate,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)), ', ') AS AllTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Votes v ON u.Id = v.UserId
    WHERE u.Id >= 1000
    GROUP BY u.Id, u.Reputation, u.DisplayName, u.Views, u.UpVotes, u.DownVotes
),
TopPosts AS (
    SELECT 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.PostTypeId,
        p.OwnerUserId,
        p.AnswerCount,
        p.CommentCount,
        p.Tags,
        CASE WHEN p.PostTypeId = 1 THEN p.AcceptedAnswerId ELSE NULL END AS AcceptedAnswerId,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) AS ScoreRank,
        DENSE_RANK() OVER (ORDER BY p.ViewCount DESC) AS ViewRank,
        PERCENT_RANK() OVER (ORDER BY p.Score) AS ScorePercentile,
        LAG(p.Score, 1) OVER (ORDER BY p.Score DESC) AS PrevScore,
        LEAD(p.Score, 1) OVER (ORDER BY p.Score DESC) AS NextScore
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) 
      AND p.Score > 0
),
PostsWithBadges AS (
    SELECT 
        tp.Id,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        tp.CreationDate,
        tp.PostTypeId,
        tp.OwnerUserId,
        tp.AnswerCount,
        tp.CommentCount,
        tp.Tags,
        tp.ScoreRank,
        tp.ViewRank,
        tp.ScorePercentile,
        tp.PrevScore,
        tp.NextScore,
        CASE WHEN b.Id IS NOT NULL THEN 1 ELSE 0 END AS HasBadge,
        COALESCE(u.DisplayName, 'Anonymous') AS AuthorName,
        COALESCE(COUNT(b.Id) OVER (PARTITION BY tp.OwnerUserId), 0) AS OwnerBadgeCount
    FROM TopPosts tp
    LEFT JOIN Badges b ON tp.OwnerUserId = b.UserId
    LEFT JOIN Users u ON tp.OwnerUserId = u.Id
    WHERE tp.ScoreRank <= 50
),
FinalResults AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.PostTypeId,
        p.OwnerUserId,
        p.AnswerCount,
        p.CommentCount,
        p.Tags,
        p.ScoreRank,
        p.ViewRank,
        p.ScorePercentile,
        p.PrevScore,
        p.NextScore,
        p.HasBadge,
        p.AuthorName,
        p.OwnerBadgeCount,
        CAST((EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400) AS INTEGER) AS DaysSincePost,
        CASE 
            WHEN p.Score > 1000 THEN 'Very High'
            WHEN p.Score > 500 THEN 'High'
            WHEN p.Score > 100 THEN 'Medium'
            WHEN p.Score > 0 THEN 'Low'
            ELSE 'None'
        END AS ScoreCategory,
        CASE 
            WHEN p.ViewCount > 10000 THEN 'Very Popular'
            WHEN p.ViewCount > 5000 THEN 'Popular'
            WHEN p.ViewCount > 1000 THEN 'Moderate'
            ELSE 'Low View'
        END AS PopularityCategory,
        CASE 
            WHEN p.AnswerCount > 10 THEN 'Highly Answered'
            WHEN p.AnswerCount > 5 THEN 'Moderately Answered'
            WHEN p.AnswerCount > 0 THEN 'Answered'
            ELSE 'Unanswered'
        END AS AnswerStatus,
        (p.Score * p.ViewCount) AS ScoreViewProduct,
        COALESCE(p.AcceptedAnswerId, 0) AS AcceptanceId,
        CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Yes' ELSE 'No' END AS IsAnswered,
        COALESCE(NULLIF(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)), ''), 'No Tags') AS CleanTags,
        COALESCE(CHAR_LENGTH(p.Tags), 0) AS TagLength,
        COALESCE(p.OwnerBadgeCount, 0) AS OwnerTotalBadges,
        COALESCE(
            (SELECT COUNT(*) FROM Posts ps WHERE ps.ParentId = p.Id AND ps.PostTypeId = 2 AND ps.Score > 0), 
            0
        ) AS PositiveAnswersCount,
        ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS OverallRank
    FROM PostsWithBadges p
    WHERE p.Score > 0
      AND p.ViewCount > 0
)
SELECT 
    fr.PostId,
    fr.Title,
    fr.Score,
    fr.ViewCount,
    fr.CreationDate,
    fr.PostTypeId,
    fr.OwnerUserId,
    fr.AnswerCount,
    fr.CommentCount,
    fr.Tags,
    fr.ScoreRank,
    fr.ViewRank,
    fr.ScorePercentile,
    fr.PrevScore,
    fr.NextScore,
    fr.HasBadge,
    fr.AuthorName,
    fr.OwnerBadgeCount,
    fr.DaysSincePost,
    fr.ScoreCategory,
    fr.PopularityCategory,
    fr.AnswerStatus,
    fr.ScoreViewProduct,
    fr.AcceptanceId,
    fr.IsAnswered,
    fr.CleanTags,
    fr.TagLength,
    fr.OwnerTotalBadges,
    fr.PositiveAnswersCount,
    fr.OverallRank,
    CASE 
        WHEN fr.Score > (
            SELECT AVG(Score) 
            FROM Posts p2 
            WHERE p2.PostTypeId = 1 
              AND p2.Score > 0
        ) THEN 'Above Average'
        ELSE 'Below Average'
    END AS PerformanceRating,
    CASE 
        WHEN fr.ScorePercentile > 0.9 THEN 'Top 10%'
        WHEN fr.ScorePercentile > 0.75 THEN 'Top 25%'
        WHEN fr.ScorePercentile > 0.5 THEN 'Top 50%'
        ELSE 'Below Median'
    END AS PerformanceTier,
    CASE 
        WHEN fr.DaysSincePost < 30 THEN 'Recently Active'
        WHEN fr.DaysSincePost < 90 THEN 'Recently Moderated'
        ELSE 'Historical'
    END AS TimeFrame,
    ('Post #' || fr.PostId || ' by ' || fr.AuthorName || ' - Score: ' || fr.Score) AS PostSummary,
    CASE 
        WHEN fr.AnswerStatus LIKE 'Highly%' AND fr.Score > 100 THEN 'Great Question'
        WHEN fr.AnswerStatus LIKE 'Answered%' AND fr.Score > 50 THEN 'Good Question'
        WHEN fr.AnswerStatus LIKE 'Unanswered%' AND fr.Score > 25 THEN 'Good Unanswered Question'
        ELSE 'Standard Post'
    END AS PostQuality,
    CASE 
        WHEN (fr.Score * 0.7 + fr.ViewCount * 0.3) > 100 THEN 'Engaging Content'
        WHEN (fr.Score * 0.7 + fr.ViewCount * 0.3) > 50 THEN 'Moderate Engagement'
        ELSE 'Limited Engagement'
    END AS EngagementCategory,
    CASE 
        WHEN fr.Score > 500 AND fr.ViewCount > 1000 THEN 'Popular Post'
        WHEN fr.Score > 100 AND fr.ViewCount > 500 THEN 'Moderately Popular'
        WHEN fr.Score > 50 AND fr.ViewCount > 100 THEN 'Low Popularity'
        ELSE 'Rarely Viewed'
    END AS PopularityLevel
FROM FinalResults fr
WHERE fr.Score >= 10
  AND fr.ViewCount >= 10
  AND fr.DaysSincePost < 365
  AND fr.HasBadge = 0
  AND EXISTS (
    SELECT 1 
    FROM Users u 
    WHERE u.Id = fr.OwnerUserId 
      AND u.Reputation > 10000
  )
  AND (
    (fr.Score > (SELECT AVG(Score) FROM Posts p WHERE p.PostTypeId = 1 AND p.Score > 0) AND fr.ViewCount > 100)
    OR fr.AnswerStatus LIKE 'Highly%'
  )
  AND NOT (
    fr.CleanTags LIKE '%' OR 
    fr.CleanTags LIKE '%programming%' OR 
    fr.CleanTags LIKE '%sql%' 
  )
  AND COALESCE(
    (SELECT COUNT(v.Id) FROM Votes v WHERE v.PostId = fr.PostId AND v.VoteTypeId = 1), 
    0
  ) > 0
UNION ALL
