-- {"query": "1668.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3003} 
WITH UserEngagement AS (
    -- CTE 1: Filters and aggregates user data, focusing on active users with a substantial post history.
    -- Calculates basic stats like total posts, question/answer counts, and average post age.
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
        SUM(COALESCE(p.Score, 0)) AS TotalPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        AVG(EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - p.CreationDate)) / (60*60*24)) AS AvgPostAgeDays -- Average age of posts by user in days
    FROM Users AS u
    JOIN Posts AS p ON u.Id = p.OwnerUserId
    WHERE
        u.Reputation >= 500 -- Minimum reputation threshold
        AND u.LastAccessDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1.5 year') -- Active within the last 1.5 years
        AND u.DisplayName IS NOT NULL
        AND u.DisplayName NOT LIKE 'anon%' -- Exclude effectively anonymous users
    GROUP BY
        u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate, u.UpVotes, u.DownVotes
    HAVING
        COUNT(DISTINCT p.Id) > 5 -- At least 5 posts
),
TrendingTags AS (
    -- CTE 2: Identifies "trending" tags based on recent, high-scoring questions.
    -- Utilizes string manipulation (`string_to_array`, `unnest`, `REPLACE`, `LOWER`) to extract and normalize tags.
    SELECT
        LOWER(TRIM(SUBSTRING(unnest(string_to_array(REPLACE(REPLACE(t.Tags, '><', '|'), '<', ''), '>')), 1, 50))) AS TagName,
        SUM(p.Score) AS TagScore,
        COUNT(p.Id) AS TagQuestionCount
    FROM Posts AS p
    CROSS JOIN LATERAL unnest(string_to_array(REPLACE(REPLACE(p.Tags, '><', '|'), '<', ''), '>')) AS t(Tags)
    WHERE
        p.PostTypeId = 1 -- Only questions
        AND p.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '9 months') -- Recent questions
        AND p.Score > 7 -- High-scoring questions
        AND p.Tags IS NOT NULL
    GROUP BY 1
    HAVING
        COUNT(p.Id) > 30 AND SUM(p.Score) > 150 -- Sufficient activity for the tag
    ORDER BY TagScore DESC
    LIMIT 15 -- Top 15 trending tags
),
PostDetailsAndComments AS (
    -- CTE 3: Gathers detailed post information, including aggregates and correlated subqueries for comment analysis.
    -- Includes `Body` for later string searching and `COALESCE` for NULL handling.
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.LastActivityDate,
        p.AcceptedAnswerId,
        p.Title,
        p.Tags,
        p.Body, -- Include body for string search
        COALESCE(p.LastEditorUserId, -1) AS LastEditorUserId, -- NULL logic: -1 if no specific editor
        -- Correlated subquery 1: Comments within the first week of post creation
        (
            SELECT COUNT(c.Id)
            FROM Comments AS c
            WHERE c.PostId = p.Id
            AND c.CreationDate BETWEEN (p.CreationDate + INTERVAL '1 day') AND (p.CreationDate + INTERVAL '7 day')
        ) AS CommentsFirstWeek,
        -- Correlated subquery 2: Average comment score from logged-in users on the post
        (
            SELECT AVG(c.Score)
            FROM Comments AS c
            WHERE c.PostId = p.Id AND c.UserId IS NOT NULL
        ) AS AvgCommentScoreByLoggedInUsers,
        -- Correlated subquery 3: Most recent comment content, cleaned using string expressions
        (
            SELECT REPLACE(REPLACE(c_corr.Text, '&nbsp;', ' '), CHR(10), ' ') -- String expressions: clean up comment text
            FROM Comments AS c_corr
            WHERE c_corr.PostId = p.Id
            ORDER BY c_corr.CreationDate DESC
            LIMIT 1
        ) AS MostRecentCommentContent
    FROM Posts AS p
    WHERE
        p.DeletionDate IS NULL
        AND p.ClosedDate IS NULL
        AND p.CommunityOwnedDate IS NULL
        AND p.PostTypeId IN (1, 2) -- Only questions and answers
),
PostHistoryAgg AS (
    -- CTE 4: Aggregates post history events, including edit counts and key date markers.
    SELECT
        ph.PostId,
        COUNT(ph.Id) AS TotalHistoryEvents,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6) THEN 1 ELSE 0 END) AS EditCount, -- Title, Body, Tags edits
        MAX(ph.CreationDate) AS LastHistoryEventDate,
        MIN(ph.CreationDate) AS FirstHistoryEventDate,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.CreationDate ELSE NULL END) AS ClosedDateHistory -- Get closed date from history
    FROM PostHistory AS ph
    WHERE ph.PostHistoryTypeId <= 100 -- Focus on common history types
    GROUP BY ph.PostId
),
UserBadgeSummary AS (
    -- CTE 5: Summarizes user's gold/silver badges, including total count and latest badge details.
    -- Uses `ARRAY_AGG` and array indexing for the latest badge name.
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalGoldSilverBadges,
        MAX(CASE WHEN b.Class = 1 THEN b.Date ELSE NULL END) AS LastGoldBadgeDate,
        MAX(CASE WHEN b.Class = 2 THEN b.Date ELSE NULL END) AS LastSilverBadgeDate,
        MAX(b.Date) FILTER (WHERE b.Class IN (1,2)) AS LatestHighClassBadgeDate,
        (ARRAY_AGG(b.Name ORDER BY b.Date DESC) FILTER (WHERE b.Class IN (1,2)))[1] AS LatestHighClassBadgeName -- Array aggregation and indexing for latest badge name
    FROM Badges AS b
    WHERE b.Class IN (1, 2) -- Gold or Silver badges
    GROUP BY b.UserId
),
CombinedPosts AS (
    -- CTE 6: Uses a set operator (`UNION ALL`) to combine questions and their accepted answers into a single view.
    SELECT
        p.PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.PostCreationDate,
        p.PostScore,
        p.ViewCount,
        p.Title,
        p.Tags,
        'Question' AS PostCategory
    FROM PostDetailsAndComments AS p
    WHERE p.PostTypeId = 1 -- Questions

    UNION ALL

    SELECT
        p.PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.PostCreationDate,
        p.PostScore,
        p.ViewCount,
        parent.Title AS Title, -- Get parent question title for answers
        parent.Tags AS Tags, -- Get parent question tags for answers
        'AcceptedAnswer' AS PostCategory
    FROM PostDetailsAndComments AS p
    JOIN Posts AS parent ON p.ParentId = parent.Id
    WHERE p.PostTypeId = 2 AND parent.AcceptedAnswerId = p.PostId -- Only accepted answers
)
SELECT
    ue.UserId,
    ue.DisplayName,
    ue.Reputation,
    ue.UserCreationDate,
    ue.LastAccessDate,
    ue.TotalPosts,
    ue.QuestionCount,
    ue.AnswerCount,
    ue.TotalPostScore,
    ue.AvgPostAgeDays,
    ubs.TotalGoldSilverBadges,
    ubs.LatestHighClassBadgeName,
    ubs.LatestHighClassBadgeDate,
    COUNT(DISTINCT cbp.PostId) FILTER (WHERE cbp.PostCategory = 'Question' AND cbp.PostScore >= 20) AS HighScoreQuestionsCount,
    COUNT(DISTINCT cbp.PostId) FILTER (WHERE cbp.PostCategory = 'AcceptedAnswer') AS AcceptedAnswersCount,
    SUM(cbp.ViewCount) AS TotalViewCountOnCombinedPosts,
    -- Complicated calculation: Average time from post creation to last edit, in days. Uses `EXTRACT` and `ROUND`.
    ROUND(AVG(EXTRACT(EPOCH FROM (pha.LastHistoryEventDate - p.PostCreationDate)) / (60*60*24)), 2) AS AvgDaysToLastEdit,
    -- String expressions and calculations with `CASE` statement to categorize posts.
    SUM(CASE
        WHEN p.Title LIKE '%performance%' OR p.Body LIKE '%benchmark%' THEN 1
        ELSE 0
    END) AS PostsAboutPerformanceBenchmarking,
    SUM(CASE
        WHEN p.PostScore > 50 AND p.CommentsFirstWeek > 5 AND p.AvgCommentScoreByLoggedInUsers > 2 THEN 1
        ELSE 0
    END) AS HighlyEngagingPosts,
    -- NULL logic with `COALESCE` for the sample comment text.
    MAX(COALESCE(p.MostRecentCommentContent, 'No recent comments found for active posts')) AS LastActivityCommentSample,
    -- Window functions:
    RANK() OVER (ORDER BY ue.Reputation DESC, ue.LastAccessDate DESC) AS GlobalReputationRank, -- Rank users globally by reputation and last access.
    DENSE_RANK() OVER (PARTITION BY DATE_TRUNC('quarter', ue.CreationDate) ORDER BY ue.Reputation DESC) AS QuarterlyReputationRank, -- Rank users within their creation quarter.
    AVG(ue.TotalPostScore) OVER (PARTITION BY ubs.TotalGoldSilverBadges ORDER BY ue.Reputation) AS AvgScoreByBadgeTier, -- Average total post score for users with the same number of gold/silver badges.
    LAG(ue.Reputation, 1, 0) OVER (ORDER BY ue.UserCreationDate) AS PrevUserReputationByCreationDate -- Reputation of the user created just before this one (for sequential comparison).
FROM UserEngagement AS ue
LEFT JOIN UserBadgeSummary AS ubs ON ue.UserId = ubs.UserId
LEFT JOIN PostDetailsAndComments AS p ON ue.UserId = p.OwnerUserId
LEFT JOIN PostHistoryAgg AS pha ON p.PostId = pha.PostId
LEFT JOIN CombinedPosts AS cbp ON ue.UserId = cbp.OwnerUserId
                               AND p.PostId = cbp.PostId -- Ensure join on specific post ID to avoid fan-out issues
WHERE
    (ue.QuestionCount > 0 OR ue.AnswerCount > 0)
    AND ue.TotalPostScore > 75 -- Higher bar for total post score
    AND EXISTS ( -- Correlated EXISTS subquery: user has at least one high-scoring question in a trending tag.
        SELECT 1
        FROM PostDetailsAndComments p_inner
        JOIN TrendingTags tt_inner ON p_inner.Tags LIKE '%' || tt_inner.TagName || '%' -- String matching for trending tags.
        WHERE p_inner.OwnerUserId = ue.UserId
          AND p_inner.PostTypeId = 1
          AND p_inner.PostScore >= 15
    )
    AND NOT EXISTS ( -- Correlated NOT EXISTS subquery: user has not had any of their posts closed recently.
        SELECT 1
        FROM PostHistory pha_inner
        WHERE pha_inner.PostId = p.PostId -- Correlates with 'p' (PostDetailsAndComments)
          AND pha_inner.PostHistoryTypeId = 10 -- Post Closed event
          AND pha_inner.CreationDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months')
    )
GROUP BY
    ue.UserId, ue.DisplayName, ue.Reputation, ue.UserCreationDate, ue.LastAccessDate,
    ue.TotalPosts, ue.QuestionCount, ue.AnswerCount, ue.TotalPostScore, ue.AvgPostAgeDays,
    ubs.TotalGoldSilverBadges, ubs.LatestHighClassBadgeName, ubs.LatestHighClassBadgeDate
ORDER BY
    GlobalReputationRank ASC, HighlyEngagingPosts DESC
LIMIT 1000;