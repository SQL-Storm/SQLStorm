with recent_users as (
    select u.id as user_id,
           u.displayname,
           u.reputation,
           u.creationdate,
           coalesce(nullif(trim(u.location), ''), 'Unknown') as location_norm,
           date_trunc('month', u.creationdate) as cohort_month,
           row_number() over (order by u.creationdate desc, u.id desc) as rn
    from users u
),
active_cohorts as (
    select r.*
    from recent_users r
    where r.rn <= 1000
),
post_base as (
    select p.id,
           p.posttypeid,
           p.owneruserid,
           p.creationdate,
           p.score,
           p.viewcount,
           p.answercount,
           p.commentcount,
           p.favoritecount,
           p.closeddate,
           p.acceptedanswerid,
           p.parentid,
           p.title,
           p.tags,
           case when p.tags is not null and position('<sql>' in lower(p.tags)) > 0 then 1 else 0 end as has_sql_tag
    from posts p
    where p.creationdate >= (select min(cohort_month) from active_cohorts)
),
user_posts as (
    select a.user_id,
           pb.id,
           pb.posttypeid,
           pb.owneruserid,
           pb.creationdate,
           pb.score,
           pb.viewcount,
           pb.answercount,
           pb.commentcount,
           pb.favoritecount,
           pb.closeddate,
           pb.acceptedanswerid,
           pb.parentid,
           pb.title,
           pb.tags,
           pb.has_sql_tag
    from active_cohorts a
    left join post_base pb
      on pb.owneruserid = a.user_id
),
answers_to_user_questions as (
    select q.owneruserid as question_owner_id,
           a.id as answer_id,
           a.owneruserid as answer_owner_id,
           a.creationdate as answer_date,
           a.score as answer_score,
           a.commentcount as answer_comments
    from posts q
    join posts a
      on a.parentid = q.id
     and a.posttypeid = 2
    where q.posttypeid = 1
),
accepted_answer_info as (
    select q.id as question_id,
           q.owneruserid as question_owner_id,
           q.acceptedanswerid,
           aa.owneruserid as accepted_owner_id,
           aa.score as accepted_score,
           aa.creationdate as accepted_date
    from posts q
    left join posts aa
      on aa.id = q.acceptedanswerid
),
post_votes as (
    select v.postid,
           sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
           sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
           sum(case when v.votetypeid = 5 then 1 else 0 end) as favorites,
           sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounty_total
    from votes v
    group by v.postid
),
post_activity as (
    select up.user_id,
           up.id as post_id,
           up.posttypeid,
           up.creationdate,
           up.score,
           up.viewcount,
           up.answercount,
           up.commentcount,
           up.favoritecount,
           up.closeddate,
           up.title,
           up.tags,
           pv.upvotes,
           pv.downvotes,
           pv.favorites,
           pv.bounty_total
    from user_posts up
    left join post_votes pv
      on pv.postid = up.id
),
comment_engagement as (
    select c.userid as commenter_id,
           c.postid,
           count(*) as comments_made,
           sum(case when c.score > 0 then 1 else 0 end) as pos_comments,
           max(c.creationdate) as last_comment_date
    from comments c
    group by c.userid, c.postid
),
badge_stats as (
    select b.userid,
           sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
           sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
           sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
           sum(case when b.tagbased = true then 1 else 0 end) as tag_badges,
           min(b.date) as first_badge_date,
           max(b.date) as last_badge_date
    from badges b
    group by b.userid
),
question_quality as (
    select pa.user_id,
           pa.post_id,
           pa.title,
           pa.tags,
           coalesce(pa.upvotes,0) - coalesce(pa.downvotes,0) as net_votes,
           pa.viewcount,
           coalesce(pa.answercount,0) as answercount,
           case when coalesce(pa.answercount,0) >= 2 and coalesce(pa.upvotes,0) >= 5 then 1 else 0 end as is_popular_q,
           length(coalesce(pa.title,'')) as title_len,
           cardinality(nullif(string_to_array(substring(pa.tags, 2, greatest(length(pa.tags)-2,0)), '><'), NULL)) as tag_count
    from post_activity pa
    where pa.posttypeid = 1
),
answer_quality as (
    select pa.user_id,
           pa.post_id,
           coalesce(pa.upvotes,0) - coalesce(pa.downvotes,0) as net_votes,
           pa.commentcount,
           pa.bounty_total,
           case when pa.bounty_total > 0 then 1 else 0 end as got_bounty
    from post_activity pa
    where pa.posttypeid = 2
),
user_rollup as (
    select a.user_id,
           min(case when pa.posttypeid in (1,2) then pa.creationdate end) as first_post_date,
           max(case when pa.posttypeid in (1,2) then pa.creationdate end) as last_post_date,
           count(case when pa.posttypeid = 1 then 1 end) as questions_count,
           count(case when pa.posttypeid = 2 then 1 end) as answers_count,
           sum(coalesce(pa.upvotes,0)) as total_upvotes,
           sum(coalesce(pa.downvotes,0)) as total_downvotes,
           sum(coalesce(pa.favorites,0)) as total_favorites,
           sum(coalesce(pa.bounty_total,0)) as total_bounty_earned
    from active_cohorts a
    left join post_activity pa
      on pa.user_id = a.user_id
    group by a.user_id
),
accepted_stats as (
    select a.user_id,
           count(case when q.acceptedanswerid is not null then 1 end) as asked_with_accept,
           count(case when q.acceptedanswerid is null then 1 end) as asked_without_accept
    from active_cohorts a
    left join posts q
      on q.owneruserid = a.user_id and q.posttypeid = 1
    group by a.user_id
),
answer_accepts as (
    select a.user_id,
           count(*) as answers_total,
           sum(case when aa.acceptedanswerid = pa.post_id then 1 else 0 end) as answers_accepted
    from active_cohorts a
    left join post_activity pa
      on pa.user_id = a.user_id and pa.posttypeid = 2
    left join posts q
      on q.id = pa.parentid
    left join accepted_answer_info aa
      on aa.question_id = q.id
    group by a.user_id
),
dup_closure as (
    select ph.postid,
           sum(case when ph.posthistorytypeid = 10 and ph.comment in ('1','101') then 1 else 0 end) as closed_as_dup_votes,
           max(case when ph.posthistorytypeid = 10 and ph.comment in ('1','101') then ph.creationdate end) as last_dup_close
    from posthistory ph
    group by ph.postid
),
link_graph as (
    select pl.postid,
           sum(case when pl.linktypeid = 1 then 1 else 0 end) as links_out,
           sum(case when pl.linktypeid = 3 then 1 else 0 end) as dup_links
    from postlinks pl
    group by pl.postid
),
tag_popularity as (
    select lower(t.tagname) as tagname,
           t.count as tag_count
    from tags t
),
question_tags_enriched as (
    select qq.user_id,
           qq.post_id,
           qq.title,
           qq.tags,
           qq.net_votes,
           qq.viewcount,
           qq.answercount,
           qq.is_popular_q,
           qq.title_len,
           qq.tag_count,
           sum(tp.tag_count) as total_tag_popularity
    from question_quality qq
    left join lateral (
        select tp.tag_count
        from unnest(nullif(string_to_array(substring(qq.tags, 2, greatest(length(qq.tags)-2,0)), '><'), NULL)) as tg(tag)
        left join tag_popularity tp on tp.tagname = lower(tg.tag)
    ) tag_counts on true
    group by qq.user_id, qq.post_id, qq.title, qq.tags, qq.net_votes, qq.viewcount, qq.answercount, qq.is_popular_q, qq.title_len, qq.tag_count
),
activity_window as (
    select pa.user_id,
           pa.post_id,
           pa.creationdate,
           sum(1) over (partition by pa.user_id order by pa.creationdate rows between unbounded preceding and current row) as cumulative_posts,
           avg(coalesce(pv.score,0)) over (partition by pa.user_id order by pa.creationdate rows between 10 preceding and current row) as moving_avg_score
    from post_activity pa
    left join posts pv on pv.id = pa.post_id
),
final_agg as (
    select a.user_id,
           a.displayname,
           a.reputation,
           a.cohort_month,
           a.location_norm,
           ur.questions_count,
           ur.answers_count,
           ur.total_upvotes,
           ur.total_downvotes,
           ur.total_favorites,
           ur.total_bounty_earned,
           coalesce(bs.gold_badges,0) as gold_badges,
           coalesce(bs.silver_badges,0) as silver_badges,
           coalesce(bs.bronze_badges,0) as bronze_badges,
           coalesce(bs.tag_badges,0) as tag_badges,
           aa.answers_total,
           aa.answers_accepted,
           case when aa.answers_total > 0 then round(cast(aa.answers_accepted as numeric) / aa.answers_total, 4) else 0 end as answer_accept_rate,
           ac.asked_with_accept,
           ac.asked_without_accept,
           min(aw.creationdate) as first_activity,
           max(aw.creationdate) as last_activity,
           max(aw.cumulative_posts) as cumulative_posts,
           avg(aw.moving_avg_score) as avg_moving_score_last_11
    from active_cohorts a
    left join user_rollup ur on ur.user_id = a.user_id
    left join badge_stats bs on bs.userid = a.user_id
    left join answer_accepts aa on aa.user_id = a.user_id
    left join accepted_stats ac on ac.user_id = a.user_id
    left join activity_window aw on aw.user_id = a.user_id
    group by a.user_id, a.displayname, a.reputation, a.cohort_month, a.location_norm,
             ur.questions_count, ur.answers_count, ur.total_upvotes, ur.total_downvotes, ur.total_favorites, ur.total_bounty_earned,
             bs.gold_badges, bs.silver_badges, bs.bronze_badges, bs.tag_badges,
             aa.answers_total, aa.answers_accepted, ac.asked_with_accept, ac.asked_without_accept
),
outlier_detection as (
    select f.*,
           percentile_cont(0.95) within group (order by coalesce(f.total_upvotes,0)) over () as p95_upvotes,
           percentile_cont(0.95) within group (order by coalesce(f.total_bounty_earned,0)) over () as p95_bounty
    from final_agg f
),
ranked_users as (
    select o.*,
           dense_rank() over (order by coalesce(o.total_upvotes,0) desc, coalesce(o.answers_count,0) desc, coalesce(o.reputation,0) desc) as rank_by_upvotes,
           dense_rank() over (order by coalesce(o.total_bounty_earned,0) desc) as rank_by_bounty
    from outlier_detection o
),
question_detail_rollup as (
    select qte.user_id,
           count(*) as questions_analyzed,
           sum(case when qte.is_popular_q = 1 then 1 else 0 end) as popular_questions,
           avg(qte.net_votes) as avg_q_net_votes,
           avg(qte.viewcount) as avg_q_views,
           avg(qte.title_len) as avg_title_length,
           avg(qte.tag_count) as avg_tag_count,
           sum(coalesce(qte.total_tag_popularity,0)) as sum_tag_popularity
    from question_tags_enriched qte
    group by qte.user_id
),
answer_detail_rollup as (
    select aq.user_id,
           count(*) as answers_analyzed,
           avg(aq.net_votes) as avg_a_net_votes,
           sum(case when aq.got_bounty = 1 then 1 else 0 end) as answers_got_bounty
    from answer_quality aq
    group by aq.user_id
),
engagement_rollup as (
    select a.user_id,
           sum(coalesce(ce.comments_made,0)) as comments_made_on_own_posts,
           sum(coalesce(ce.pos_comments,0)) as positive_comments_on_own_posts,
           max(ce.last_comment_date) as last_comment_on_own_post
    from active_cohorts a
    left join user_posts up on up.user_id = a.user_id
    left join comment_engagement ce on ce.postid = up.id
    group by a.user_id
)
select ru.user_id,
       ru.displayname,
       ru.reputation,
       ru.cohort_month,
       ru.location_norm,
       ru.questions_count,
       ru.answers_count,
       ru.total_upvotes,
       ru.total_downvotes,
       ru.total_favorites,
       ru.total_bounty_earned,
       ru.gold_badges,
       ru.silver_badges,
       ru.bronze_badges,
       ru.tag_badges,
       ru.answers_total,
       ru.answers_accepted,
       ru.answer_accept_rate,
       ru.asked_with_accept,
       ru.asked_without_accept,
       ru.first_activity,
       ru.last_activity,
       ru.cumulative_posts,
       ru.avg_moving_score_last_11,
       qdr.questions_analyzed,
       qdr.popular_questions,
       qdr.avg_q_net_votes,
       qdr.avg_q_views,
       qdr.avg_title_length,
       qdr.avg_tag_count,
       qdr.sum_tag_popularity,
       adr.answers_analyzed,
       adr.avg_a_net_votes,
       adr.answers_got_bounty,
       er.comments_made_on_own_posts,
       er.positive_comments_on_own_posts,
       er.last_comment_on_own_post,
       ru.p95_upvotes,
       ru.p95_bounty,
       ru.rank_by_upvotes,
       ru.rank_by_bounty,
       case when coalesce(ru.total_upvotes,0) >= ru.p95_upvotes then 'UPVOTE_OUTLIER' else 'NORMAL' end as upvote_outlier_flag,
       case when coalesce(ru.total_bounty_earned,0) >= ru.p95_bounty then 'BOUNTY_OUTLIER' else 'NORMAL' end as bounty_outlier_flag
from ranked_users ru
left join question_detail_rollup qdr on qdr.user_id = ru.user_id
left join answer_detail_rollup adr on adr.user_id = ru.user_id
left join engagement_rollup er on er.user_id = ru.user_id
where (coalesce(ru.questions_count,0) + coalesce(ru.answers_count,0)) > 0
  and (
       ru.location_norm ilike '%united states%' or
       ru.location_norm ilike '%india%' or
       ru.location_norm ilike '%germany%' or
       ru.location_norm = 'Unknown'
  )
  and ru.cohort_month >= date_trunc('month', cast('2024-10-01 12:34:56' as timestamp) - interval '5 years')
order by ru.rank_by_upvotes, ru.rank_by_bounty, ru.user_id
limit 200;