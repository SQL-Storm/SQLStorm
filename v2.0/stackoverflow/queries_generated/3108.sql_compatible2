WITH UserPosts AS (
    SELECT u.Id                              AS UserId,
           u.DisplayName,
           COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
           COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
           SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS QuestionScoreSum,
           SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS AnswerScoreSum,
           MAX(p.CreationDate)               AS LastPostDate
    FROM   Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
UserBadges AS (
    SELECT b.UserId,
           COUNT(*)                                            AS TotalBadges,
           COUNT(CASE WHEN b.Class = 1 THEN 1 END)             AS GoldBadges,
           COUNT(CASE WHEN b.Class = 2 THEN 1 END)             AS SilverBadges,
           COUNT(CASE WHEN b.Class = 3 THEN 1 END)             AS BronzeBadges,
           STRING_AGG(DISTINCT b.Name, ',')                   AS BadgeNames
    FROM   Badges b
    GROUP BY b.UserId
),
UserVotes AS (
    SELECT v.UserId,
           COUNT(*)                                           AS TotalVotesCast,
           COUNT(CASE WHEN vt.Name = 'UpMod' THEN 1 END)      AS UpVotesCast,
           COUNT(CASE WHEN vt.Name = 'DownMod' THEN 1 END)    AS DownVotesCast,
           COUNT(CASE WHEN vt.Name = 'Favorite' THEN 1 END)   AS FavoriteVotesCast
    FROM   Votes v
    JOIN   VoteTypes vt ON vt.Id = v.VoteTypeId
    GROUP BY v.UserId
),
TopQuestions AS (
    SELECT p.OwnerUserId,
           p.Id,
           p.Title,
           p.Score,
           ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId
                              ORDER BY p.Score DESC,
                                       p.CreationDate DESC) AS rn
    FROM   Posts p
    WHERE  p.PostTypeId = 1
),
TagStats AS (
    SELECT t.TagName,
           t.Count                                             AS TagUseCount,
           COALESCE(e.ExcerptLength, 0)                        AS ExcerptLength,
           COALESCE(w.WikiLength, 0)                           AS WikiLength,
           COUNT(DISTINCT pl.PostId)                           AS LinkedPosts
    FROM   Tags t
    LEFT JOIN LATERAL (
        SELECT LENGTH(p.Body) AS ExcerptLength
        FROM   Posts p
        WHERE  p.Id = t.ExcerptPostId
        LIMIT 1
    ) e ON TRUE
    LEFT JOIN LATERAL (
        SELECT LENGTH(p.Body) AS WikiLength
        FROM   Posts p
        WHERE  p.Id = t.WikiPostId
        LIMIT 1
    ) w ON TRUE
    LEFT JOIN PostLinks pl ON pl.RelatedPostId = t.Id
                           AND pl.LinkTypeId = 1
    GROUP BY t.TagName, t.Count, e.ExcerptLength, w.WikiLength
),
RecentClosedQuestions AS (
    SELECT p.Id,
           p.Title,
           ph.CreationDate                            AS ClosedDate,
           COALESCE(crt.Name, 'Unknown')              AS CloseReason,
           ROW_NUMBER() OVER (ORDER BY ph.CreationDate DESC) AS rn
    FROM   Posts p
    JOIN   PostHistory ph ON ph.PostId = p.Id
                           AND ph.PostHistoryTypeId = 10
    LEFT JOIN CloseReasonTypes crt ON crt.Id = CAST(ph.Comment AS INTEGER)
    WHERE  p.PostTypeId = 1
),
Aggregated AS (
    SELECT u.Id,
           COALESCE(up.DisplayName, 'DeletedUser')   AS DisplayName,
           COALESCE(up.QuestionCount,0)              AS QuestionCount,
           COALESCE(up.AnswerCount,0)                AS AnswerCount,
           COALESCE(up.QuestionScoreSum,0)           AS QuestionScoreSum,
           COALESCE(up.AnswerScoreSum,0)             AS AnswerScoreSum,
           COALESCE(ub.TotalBadges,0)                AS TotalBadges,
           COALESCE(ub.GoldBadges,0)                 AS GoldBadges,
           COALESCE(ub.SilverBadges,0)               AS SilverBadges,
           COALESCE(ub.BronzeBadges,0)               AS BronzeBadges,
           COALESCE(uv.TotalVotesCast,0)             AS TotalVotesCast,
           COALESCE(uv.UpVotesCast,0)                AS UpVotesCast,
           COALESCE(uv.DownVotesCast,0)              AS DownVotesCast,
           COALESCE(uv.FavoriteVotesCast,0)          AS FavoriteVotesCast,
           tq.Id                                      AS TopQuestionId,
           tq.Title                                   AS TopQuestionTitle,
           tq.Score                                   AS TopQuestionScore,
           ts.TagName,
           ts.TagUseCount,
           ts.ExcerptLength,
           ts.WikiLength,
           ts.LinkedPosts,
           rcq.Title                                  AS RecentClosedTitle,
           rcq.CloseReason,
           rcq.ClosedDate
    FROM   Users u
    LEFT JOIN UserPosts up   ON up.UserId = u.Id
    LEFT JOIN UserBadges ub  ON ub.UserId = u.Id
    LEFT JOIN UserVotes uv   ON uv.UserId = u.Id
    LEFT JOIN TopQuestions tq ON tq.OwnerUserId = u.Id AND tq.rn = 1
    LEFT JOIN LATERAL (
        SELECT t.TagName, t.TagUseCount, t.ExcerptLength, t.WikiLength, t.LinkedPosts
        FROM   TagStats t
        ORDER BY t.TagUseCount DESC
        LIMIT 1
    ) ts ON TRUE
    LEFT JOIN LATERAL (
        SELECT rcq.Title, rcq.CloseReason, rcq.ClosedDate
        FROM   RecentClosedQuestions rcq
        WHERE  rcq.rn = 1
    ) rcq ON TRUE
)
SELECT *
FROM   Aggregated
WHERE  (QuestionCount + AnswerCount) > 0
   OR  TotalBadges > 0
   OR  TotalVotesCast > 0
ORDER BY TotalBadges DESC,
         (QuestionScoreSum + AnswerScoreSum) DESC
LIMIT  100
OFFSET 0

UNION ALL

SELECT NULL AS Id,
       NULL AS DisplayName,
       NULL AS QuestionCount,
       NULL AS AnswerCount,
       NULL AS QuestionScoreSum,
       NULL AS AnswerScoreSum,
       NULL AS TotalBadges,
       NULL AS GoldBadges,
       NULL AS SilverBadges,
       NULL AS BronzeBadges,
       NULL AS TotalVotesCast,
       NULL AS UpVotesCast,
       NULL AS DownVotesCast,
       NULL AS FavoriteVotesCast,
       NULL AS TopQuestionId,
       NULL AS TopQuestionTitle,
       NULL AS TopQuestionScore,
       NULL AS TagName,
       NULL AS TagUseCount,
       NULL AS ExcerptLength,
       NULL AS WikiLength,
       NULL AS LinkedPosts,
       NULL AS RecentClosedTitle,
       NULL AS CloseReason,
       NULL AS ClosedDate
WHERE NOT EXISTS (SELECT 1 FROM Users LIMIT 1);