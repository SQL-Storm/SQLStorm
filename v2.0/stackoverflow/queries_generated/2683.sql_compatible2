with RecursiveUserPosts as (
    select
        u.Id as UserId,
        u.DisplayName,
        p.Id as PostId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        coalesce(p.AnswerCount, 0) as AnswerCount,
        p.CreationDate,
        row_number() over (partition by u.Id order by p.CreationDate desc) as PostRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    where u.Reputation > 1000
),
FilteredUserPosts as (
    select *
    from RecursiveUserPosts
    where
        PostRank <= 10
),
PostVoteStats as (
    select
        p.Id as PostId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        count(v.UserId) as UniqueVoters_estimate
    from Posts p
    left join Votes v on v.PostId = p.Id
    group by p.Id
),
PostLatestCloseReason as (
    select ph.PostId,
        cast(ph.Comment as varchar) as CloseReasonName,
        ph.CreationDate as CloseDate,
        row_number() over (partition by ph.PostId order by ph.CreationDate desc) as rn
    from PostHistory ph
    where ph.PostHistoryTypeId = 10
),
UserBadgeAgg as (
    select
        b.UserId,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        max(case when b.TagBased then 1 else 0 end) = 1 as HasTagBadges
    from Badges b
    group by b.UserId
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.OwnerUserId,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.Tags,
        coalesce(count(a.Id),0) as AnswersCount,
        coalesce(max(a.Score),0) as MaxAnswerScore,
        coalesce(min(a.Score),0) as MinAnswerScore
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id, q.OwnerUserId, q.Score, q.ViewCount, q.Tags
),
UserActivityWindows as (
    select
        u.Id,
        u.DisplayName,
        -- approximate PostsInLast30Days and CommentsInLast30Days without DISTINCT in window:
        sum(case when p.CreationDate >= (u.CreationDate - interval '100 years') then 1 else 0 end) over (
            partition by u.Id
            order by p.CreationDate
            range between interval '30 days' preceding and current row
        ) as PostsInLast30Days,
        sum(case when c.CreationDate >= (u.CreationDate - interval '100 years') then 1 else 0 end) over (
            partition by u.Id
            order by c.CreationDate
            range between interval '30 days' preceding and current row
        ) as CommentsInLast30Days,
        u.Reputation,
        u.CreationDate as UserCreationDate,
        u.LastAccessDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    where u.Reputation > 0
),
PopularTags as (
    select TagName, Count
    from Tags
    where Count > 5000
),
QuestionsWithPopularTags as (
    select qas.*
    from QuestionAnswerStats qas
    where exists (
        select 1
        from PopularTags pt
        where qas.Tags like '%' || '<' || pt.TagName || '>' || '%'
    )
),
PostSnippets as (
    select
        p.Id as PostId,
        substring(p.Title from 1 for 100) as title_sim,
        substring(p.Body from 1 for 200) as body_snippet
    from Posts p
)
select distinct
    u.Id as UserId,
    u.DisplayName,
    coalesce(ua.GoldBadges,0) as GoldBadges,
    coalesce(ua.SilverBadges,0) as SilverBadges,
    coalesce(ua.BronzeBadges,0) as BronzeBadges,
    fup.PostId,
    fup.PostTypeId,
    fup.Score,
    fup.ViewCount,
    fup.AnswerCount,
    pvs.UpVotes,
    pvs.DownVotes,
    pvs.UniqueVoters_estimate as UniqueVoters,
    case when plc.rn = 1 then plc.CloseReasonName else null end as LatestCloseReason,
    qwp.QuestionId,
    qwp.Tags,
    qwp.AnswersCount,
    qwp.MaxAnswerScore,
    qwp.MinAnswerScore,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    ua.HasTagBadges,
    ual.PostsInLast30Days,
    ual.CommentsInLast30Days,
    s.title_sim,
    s.body_snippet,
    case
        when ual.PostsInLast30Days > 5 and coalesce(ua.GoldBadges,0) > 1 then 'High Activity & High Recognition'
        when ual.PostsInLast30Days > 5 then 'High Activity'
        when coalesce(ua.GoldBadges,0) > 1 then 'High Recognition'
        else 'Average User'
    end as UserCategory
from Users u
left join UserBadgeAgg ua on ua.UserId = u.Id
left join FilteredUserPosts fup on fup.UserId = u.Id
left join PostVoteStats pvs on pvs.PostId = fup.PostId
left join PostLatestCloseReason plc on plc.PostId = fup.PostId and plc.rn = 1
left join QuestionsWithPopularTags qwp on qwp.OwnerUserId = u.Id
left join UserActivityWindows ual on ual.Id = u.Id
left join PostSnippets s on s.PostId = fup.PostId
where u.Reputation > 500
and (fup.PostTypeId in (1,2) or fup.PostTypeId is null)
and (
    (pvs.UpVotes > pvs.DownVotes)
    or pvs.UpVotes is null
)
order by u.Reputation desc, fup.Score desc
limit 100;