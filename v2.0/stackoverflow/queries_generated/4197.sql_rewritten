WITH RecentQuestions AS (
    SELECT
        p.Id AS QuestionId,
        p.Title AS QuestionTitle,
        p.OwnerUserId,
        p.CreationDate AS QuestionCreationDate,
        p.Score AS QuestionScore,
        p.ViewCount AS QuestionViewCount,
        p.AnswerCount,
        p.FavoriteCount,
        pt.Name AS PostTypeName,
        u.DisplayName AS OwnerDisplayName,
        COALESCE(u.Reputation, 0) AS OwnerReputation,
        u.CreationDate AS OwnerCreationDate,
        ROW_NUMBER() OVER (ORDER BY p.CreationDate DESC) AS rn
    FROM Posts p
    JOIN PostTypes pt ON p.PostTypeId = pt.Id
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1 -- Questions
      AND p.CreationDate >= DATE('now', '-1 year')
),
TopAnswers AS (
    SELECT
        a.Id AS AnswerId,
        a.ParentId AS QuestionId,
        a.OwnerUserId,
        a.CreationDate AS AnswerCreationDate,
        a.Score AS AnswerScore,
        a.ContentLicense,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) AS answer_rank
    FROM Posts a
    WHERE a.PostTypeId = 2 -- Answers
),
AnswerMetrics AS (
    SELECT
        ta.QuestionId,
        COUNT(ta.AnswerId) AS TotalAnswers,
        SUM(CASE WHEN ta.answer_rank = 1 THEN 1 ELSE 0 END) AS AcceptedAnswerCount,
        AVG(ta.AnswerScore) AS AverageAnswerScore,
        MAX(ta.AnswerScore) AS MaxAnswerScore,
        SUM(CASE WHEN ta.ContentLicense = 'CC BY-SA' THEN 1 ELSE 0 END) AS CCBYSAAnswers
    FROM TopAnswers ta
    GROUP BY ta.QuestionId
),
QuestionComments AS (
    SELECT
        c.PostId,
        COUNT(c.Id) AS CommentCount,
        SUM(CASE WHEN c.UserId IS NULL THEN 1 ELSE 0 END) AS AnonymousCommentCount,
        MAX(c.Score) AS MaxCommentScore,
        STRING_AGG(c.Text, ' | ') WITHIN GROUP (ORDER BY c.CreationDate) AS ConcatenatedComments
    FROM Comments c
    WHERE c.PostId IN (SELECT QuestionId FROM RecentQuestions WHERE rn <= 1000)
    GROUP BY c.PostId
),
QuestionHistory AS (
    SELECT
        ph.PostId,
        COUNT(CASE WHEN ph.PostHistoryTypeId IN (4, 6) THEN 1 ELSE NULL END) AS EditCount,
        MAX(ph.CreationDate) AS LastEditDate
    FROM PostHistory ph
    WHERE ph.PostId IN (SELECT QuestionId FROM RecentQuestions WHERE rn <= 1000)
    GROUP BY ph.PostId
)
SELECT
    rq.QuestionTitle,
    rq.OwnerDisplayName,
    rq.OwnerReputation,
    rq.OwnerCreationDate,
    rq.QuestionCreationDate,
    rq.QuestionScore,
    rq.QuestionViewCount,
    rq.AnswerCount,
    rq.FavoriteCount,
    COALESCE(am.TotalAnswers, 0) AS TotalAnswers,
    COALESCE(am.AcceptedAnswerCount, 0) AS AcceptedAnswers,
    COALESCE(am.AverageAnswerScore, 0) AS AvgAnswerScore,
    COALESCE(am.MaxAnswerScore, 0) AS MaxAnswerScore,
    COALESCE(am.CCBYSAAnswers, 0) AS CCBYSAAnswerCount,
    COALESCE(qc.CommentCount, 0) AS TotalComments,
    COALESCE(qc.AnonymousCommentCount, 0) AS AnonymousComments,
    qc.MaxCommentScore,
    qh.EditCount AS TitleOrTagEdits,
    qh.LastEditDate,
    CASE
        WHEN rq.QuestionScore > 1000 AND rq.FavoriteCount > 50 THEN 'Highly Engaged'
        WHEN rq.QuestionScore < 0 AND rq.AnswerCount = 0 THEN 'Unpopular'
        WHEN rq.AnswerCount > 10 THEN 'Many Answers'
        WHEN rq.QuestionViewCount > 10000 THEN 'High Views'
        ELSE 'Standard'
    END AS QuestionEngagementLevel,
    CASE
        WHEN EXISTS (SELECT 1 FROM PostLinks pl WHERE pl.PostId = rq.QuestionId AND pl.LinkTypeId = 3) THEN 'Linked as Duplicate'
        WHEN EXISTS (SELECT 1 FROM PostLinks pl WHERE pl.RelatedPostId = rq.QuestionId AND pl.LinkTypeId = 3) THEN 'Is Duplicate Of'
        ELSE 'No Duplicate Link'
    END AS DuplicateStatus
FROM RecentQuestions rq
LEFT JOIN AnswerMetrics am ON rq.QuestionId = am.QuestionId
LEFT JOIN QuestionComments qc ON rq.QuestionId = qc.PostId
LEFT JOIN QuestionHistory qh ON rq.QuestionId = qh.PostId
WHERE rq.rn <= 1000
ORDER BY rq.QuestionScore DESC, rq.QuestionCreationDate DESC
LIMIT 100;