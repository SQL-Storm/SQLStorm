WITH PopularTags AS (
    SELECT
        T.TagName,
        T.Id AS TagId,
        COUNT(P.Id) AS PostCount
    FROM Tags T
    JOIN Posts P ON P.Tags IS NOT NULL AND EXISTS (
        SELECT 1
        FROM UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><')) AS PostTag
        WHERE PostTag = T.TagName
    )
    WHERE P.PostTypeId = 1 -- Only questions contribute to tag popularity
      AND P.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 year') -- Filter for recent activity
    GROUP BY T.TagName, T.Id
    HAVING COUNT(P.Id) > 750 -- Higher threshold for popularity
),
