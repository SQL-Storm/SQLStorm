WITH
TopTags AS (
  SELECT
    t.TagName,
    COUNT(*) AS PostCount,
    AVG(p.Score) AS AvgScore,
    SUM(p.ViewCount) AS TotalViews,
    MAX(p.CreationDate) AS LastCreated
  FROM Posts p
  JOIN Posts tpost ON p.Id = tpost.ParentId
  JOIN Tags t ON t.Id = tpost.Id OR t.Id = tpost.ExcerptPostId OR t.Id = tpost.WikiPostId
  WHERE p.PostTypeId = 1
    AND t.TagName IS NOT NULL
    AND (t.IsModeratorOnly = FALSE OR t.IsModeratorOnly = 0) -- support both boolean and integer representations
  GROUP BY t.TagName
),
RecentQualified AS (
  SELECT
    p.Id,
    p.Title,
    p.Tags,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.OwnerUserId,
    COALESCE(v.Count, 0) AS VoteCount
  FROM Posts p
  LEFT JOIN (
    SELECT PostId, COUNT(*) AS Count
    FROM Votes
    WHERE VoteTypeId IN (2, 3)
    GROUP BY PostId
  ) v ON v.PostId = p.Id
  WHERE p.PostTypeId = 1
    AND p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30' DAY)
),
UserRank AS (
  SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS RevRank
  FROM Users u
  WHERE u.Reputation IS NOT NULL
),
ComplexFilter AS (
  SELECT
    rp.Id AS PostId,
    rp.Title,
    rp.Tags,
    rp.CreationDate,
    rp.Score,
    rp.ViewCount,
    u.Id AS OwnerUserId,
    u.DisplayName AS OwnerName,
    u.Reputation,
    COALESCE(w.Action, 0) AS WindowAction
  FROM RecentQualified rp
  JOIN Users u ON u.Id = rp.OwnerUserId
  LEFT JOIN (
    SELECT
      PostId,
      MAX(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoted,
      MAX(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoted,
      1 AS Action
    FROM Votes
    GROUP BY PostId
  ) w ON w.PostId = rp.Id
  WHERE rp.ViewCount > 100 AND rp.Score >= -5
  GROUP BY
    rp.Id,
    rp.Title,
    rp.Tags,
    rp.CreationDate,
    rp.Score,
    rp.ViewCount,
    u.Id,
    u.DisplayName,
    u.Reputation,
    w.Action
),
FinalCompute AS (
  SELECT
    cf.PostId,
    cf.Title,
    cf.Tags,
    cf.CreationDate,
    cf.Score,
    cf.ViewCount,
    cf.OwnerUserId,
    cf.OwnerName,
    cf.Reputation,
    cf.WindowAction,
    CASE
      WHEN cf.Reputation IS NULL THEN 0
      ELSE cf.Reputation * 0.5 + cf.Score * 1.2 + cf.ViewCount * 0.001
    END AS BenchmarkScore
  FROM ComplexFilter cf
),
Aggregates AS (
  SELECT
    ft.TagName,
    ft.PostCount,
    ft.AvgScore,
    ft.TotalViews,
    ft.LastCreated
  FROM TopTags ft
  GROUP BY
    ft.TagName,
    ft.PostCount,
    ft.AvgScore,
    ft.TotalViews,
    ft.LastCreated
),
Ranked AS (
  SELECT
    fc.PostId,
    fc.Title,
    fc.Tags,
    fc.CreationDate,
    fc.Score,
    fc.ViewCount,
    fc.OwnerUserId,
    fc.OwnerName,
    fc.Reputation,
    fc.WindowAction,
    fc.BenchmarkScore,
    ROW_NUMBER() OVER (ORDER BY fc.BenchmarkScore DESC, fc.CreationDate DESC) AS RN
  FROM FinalCompute fc
)
SELECT
  r.PostId,
  r.Title,
  r.Tags,
  r.OwnerName,
  r.Reputation,
  r.Score,
  r.ViewCount,
  r.BenchmarkScore,
  r.RN
FROM Ranked r
WHERE r.RN <= 100
ORDER BY r.BenchmarkScore DESC, r.RN ASC;