WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as PostCount,
        COUNT(DISTINCT c.Id) as CommentCount,
        COUNT(DISTINCT b.Id) as BadgeCount,
        MAX(p.CreationDate) as LastPostDate,
        MAX(c.CreationDate) as LastCommentDate,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT b.Id) DESC) as BadgeRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= DATEADD(YEAR, -2, cast('2024-10-01 12:34:56' as timestamp))
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        PostCount,
        CommentCount,
        BadgeCount,
        LastPostDate,
        LastCommentDate,
        PostRank,
        BadgeRank,
        CASE 
            WHEN PostCount > 100 AND BadgeCount > 50 THEN 'Elite'
            WHEN PostCount > 50 OR BadgeCount > 25 THEN 'Active'
            ELSE 'Regular'
        END as UserCategory
    FROM UserActivityStats
    WHERE PostRank <= 100 OR BadgeRank <= 100
),
QuestionStats AS (
    SELECT 
        p.Id as QuestionId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        CASE 
            WHEN p.Tags IS NOT NULL AND p.Tags LIKE '%<%%>%' THEN 
                (SELECT COUNT(*) FROM STRING_SPLIT(SUBSTRING(p.Tags, 2, LEN(p.Tags)-2), '><'))
            ELSE 0 
        END as TagCount,
        COALESCE(p.OwnerUserId, -1) as UserId,
        CASE 
            WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
            WHEN p.Score < 0 THEN 'Negative Score'
            WHEN p.Score >= 10 THEN 'Highly Rated'
            ELSE 'Normal'
        END as QuestionStatus
    FROM Posts p
    WHERE p.PostTypeId = 1 
      AND p.CreationDate >= DATEADD(MONTH, -6, cast('2024-10-01 12:34:56' as timestamp))
),
PostTags AS (
    SELECT 
        QuestionId,
        TagCount,
        CASE 
            WHEN TagCount >= 3 THEN 'Multi Tagged'
            WHEN TagCount = 1 THEN 'Single Tagged'
            ELSE 'No Tags'
        END as TagCategory
    FROM QuestionStats
),
AnswerStats AS (
    SELECT 
        p.ParentId as QuestionId,
        COUNT(p.Id) as AnswerCount,
        AVG(p.Score) as AvgAnswerScore,
        MAX(p.CreationDate) as LatestAnswerDate,
        MAX(p.Score) as MaxAnswerScore,
        SUM(CASE WHEN p.Score > 0 THEN 1 ELSE 0 END) as PositiveAnswers,
        SUM(CASE WHEN p.Score < 0 THEN 1 ELSE 0 END) as NegativeAnswers,
        SUM(CASE WHEN p.Score = 0 THEN 1 ELSE 0 END) as ZeroScoreAnswers
    FROM Posts p
    WHERE p.PostTypeId = 2
      AND p.CreationDate >= DATEADD(MONTH, -6, cast('2024-10-01 12:34:56' as timestamp))
    GROUP BY p.ParentId
),
ComplexAnalysis AS (
    SELECT 
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.PostCount,
        tu.CommentCount,
        tu.BadgeCount,
        tu.UserCategory,
        qs.QuestionId,
        qs.Title,
        qs.Score,
        qs.ViewCount,
        qs.AnswerCount,
        qs.CommentCount,
        qs.QuestionStatus,
        qs.TagCount,
        qs.TagCategory,
        COALESCE(as_.AnswerCount, 0) as AnswerCountWithAnswers,
        COALESCE(as_.AvgAnswerScore, 0) as AvgAnswerScore,
        COALESCE(as_.MaxAnswerScore, 0) as MaxAnswerScore,
        CASE 
            WHEN qs.AnswerCount > 0 AND as_.AvgAnswerScore > 2 THEN 'High Quality'
            WHEN qs.AnswerCount > 0 THEN 'Moderate Quality'
            ELSE 'No Answers'
        END as QuestionQuality,
        CASE 
            WHEN qs.Score >= 50 THEN 'Very Popular'
            WHEN qs.Score >= 20 THEN 'Popular'
            WHEN qs.Score >= 10 THEN 'Moderate'
            ELSE 'Low'
        END as Popularity,
        DATEDIFF(DAY, qs.CreationDate, cast('2024-10-01 12:34:56' as timestamp)) as DaysSinceCreation,
        DATEDIFF(DAY, qs.CreationDate, COALESCE(as_.LatestAnswerDate, qs.CreationDate)) as DaysToFirstAnswer,
        ROW_NUMBER() OVER (PARTITION BY tu.UserId ORDER BY qs.Score DESC) as ScoreRank,
        ROW_NUMBER() OVER (ORDER BY qs.Views DESC) as ViewRank,
        LAG(qs.Score, 1) OVER (ORDER BY qs.CreationDate) as PreviousScore,
        (qs.Score - LAG(qs.Score, 1) OVER (ORDER BY qs.CreationDate)) as ScoreChange,
        IIF(qs.Score >= 50 AND qs.AnswerCount > 3, 1, 0) as HighlyRatedPopularWithAnswers
    FROM TopUsers tu
    INNER JOIN QuestionStats qs ON tu.UserId = qs.UserId
    LEFT JOIN PostTags pt ON qs.QuestionId = pt.QuestionId
    LEFT JOIN AnswerStats as_ ON qs.QuestionId = as_.QuestionId
)
SELECT 
    *,
    (SELECT COUNT(*) FROM ComplexAnalysis ca2 WHERE ca2.UserId = ca.UserId) as UserQuestionCount,
    (SELECT AVG(Score) FROM ComplexAnalysis ca3 WHERE ca3.UserId = ca.UserId) as AvgUserScore,
    SUM(Score) OVER (PARTITION BY UserId) as UserTotalScore,
    MAX(Score) OVER (PARTITION BY UserId) as UserMaxScore,
    AVG(Score) OVER (ORDER BY UserId, QuestionId) as SlidingAverageScore,
    CASE 
        WHEN DaysToFirstAnswer <= 1 THEN 'Quick Response'
        WHEN DaysToFirstAnswer <= 7 THEN 'Quick Discussion'
        WHEN DaysToFirstAnswer <= 30 THEN 'Moderate Engagement'
        ELSE 'Delayed Engagement'
    END as EngagementLevel,
    CASE 
        WHEN AVGAnswerScore >= 5 THEN 'Excellent Answers'
        WHEN AVGAnswerScore >= 2 THEN 'Good Answers'
        WHEN AVGAnswerScore >= 0 THEN 'Average Answers'
        ELSE 'Poor Answers'
    END as AnswerQuality,
    CASE 
        WHEN QuestionQuality = 'High Quality' AND QuestionStatus = 'Closed' THEN 'High Quality Closed'
        WHEN QuestionQuality = 'High Quality' THEN 'High Quality'
        WHEN QuestionStatus = 'Closed' THEN 'Regular Closed'
        ELSE 'Regular'
    END as QuestionClassification,
    CASE 
        WHEN Score >= 100 AND AnswerCount >= 10 THEN 'Veteran Questioner'
        WHEN Score >= 50 THEN 'Experienced Questioner'
        WHEN PostCount >= 20 THEN 'Frequent Poster'
        ELSE 'New Poster'
    END as UserClassification,
    IIF(QuestionStatus IN ('Closed', 'Community Owned'), 0, 1) as StatusWeight,
    CASE 
        WHEN ViewCount > 1000 THEN 'Viral'
        WHEN ViewCount > 100 THEN 'Popular'
        WHEN ViewCount > 10 THEN 'Moderate'
        ELSE 'Low'
    END as ViewCategory,
    CASE 
        WHEN Popularity = 'Very Popular' THEN 'Top 10% Popularity'
        WHEN Popularity = 'Popular' THEN 'Top 30% Popularity'
        ELSE 'Moderate Popularity'
    END as PopularityCategory,
    COALESCE(ScoreChange, 0) as ScoreChange,
    (COALESCE(ScoreChange, 0) * 100.0 / NULLIF(LAG(Score, 1) OVER (ORDER BY QuestionId), 0)) as ScoreChangePercentage,
    CONCAT('Post_', QuestionId) as PostIdentifier,
    CONCAT('User_', UserId) as UserIdentifier,
    REPLICATE('=', CASE 
        WHEN Reputation >= 1000 THEN 5
        WHEN Reputation >= 500 THEN 4
        WHEN Reputation >= 100 THEN 3
        WHEN Reputation >= 10 THEN 2
        ELSE 1 
    END) as ReputationStars,
    COALESCE(AnswerCountWithAnswers, 0) as FinalAnswerCount,
    COALESCE(MaxAnswerScore, 0) as FinalMaxAnswerScore,
    COALESCE(AvgAnswerScore, 0) as FinalAvgAnswerScore
FROM ComplexAnalysis ca
WHERE Score > 0
  AND ViewCount > 10
  AND (QuestionStatus = 'Normal' OR QuestionStatus = 'Highly Rated')
  AND TagCount >= 1
  AND UserId IN (SELECT DISTINCT UserId FROM TopUsers WHERE UserCategory = 'Elite')
  AND QuestionId NOT IN (
    SELECT DISTINCT PostId 
    FROM PostHistory 
    WHERE PostHistoryTypeId IN (12, 13) 
      AND CreationDate >= DATEADD(MONTH, -3, cast('2024-10-01 12:34:56' as timestamp))
  )
ORDER BY Score DESC, AnswerCount DESC, ViewCount DESC
HAVING COUNT(*) > 0
UNION ALL
