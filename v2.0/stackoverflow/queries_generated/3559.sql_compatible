WITH user_stats AS (
    SELECT
        u.Id                                   AS user_id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0) AS net_votes,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)      AS question_cnt,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)      AS answer_cnt,
        COUNT(b.Id) FILTER (WHERE b.Class = 1)          AS gold_badges,
        COUNT(b.Id) FILTER (WHERE b.Class = 2)          AS silver_badges,
        COUNT(b.Id) FILTER (WHERE b.Class = 3)          AS bronze_badges,
        MAX(p.CreationDate)                            AS last_post_dt
    FROM Users u
    LEFT JOIN Posts   p ON p.OwnerUserId = u.Id
    LEFT JOIN Badges  b ON b.UserId      = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.UpVotes, u.DownVotes
),
top_tags AS (
    SELECT
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rn
    FROM Tags t
    WHERE t.IsModeratorOnly = FALSE
),
recent_votes AS (
    SELECT
        v.PostId,
        SUM(CASE WHEN vt.Id = 2 THEN 1
                 WHEN vt.Id = 3 THEN -1
                 ELSE 0 END)                      AS vote_score,
        MAX(v.CreationDate)                       AS last_vote_dt
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE vt.Id IN (2,3)
    GROUP BY v.PostId
),
question_closure AS (
    SELECT
        ph.PostId,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.CreationDate END) AS closed_on,
        MAX(CASE WHEN ph.PostHistoryTypeId = 11 THEN ph.CreationDate END) AS reopened_on,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.Comment END)      AS close_reason_id
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (10,11)
    GROUP BY ph.PostId
)
SELECT
    us.user_id,
    us.DisplayName,
    us.Reputation,
    us.net_votes,
    us.question_cnt,
    us.answer_cnt,
    us.gold_badges,
    us.silver_badges,
    us.bronze_badges,
    us.last_post_dt,
    COALESCE(rv.vote_score,0)           AS recent_vote_score,
    rv.last_vote_dt,
    qc.closed_on,
    qc.reopened_on,
    crt.Name                           AS close_reason,
    STRING_AGG(DISTINCT tt.TagName, ', ') FILTER (WHERE tt.rn <= 5) AS top_5_tags
FROM user_stats us
LEFT JOIN LATERAL (
    SELECT p.Id
    FROM Posts p
    WHERE p.OwnerUserId = us.user_id AND p.PostTypeId = 1
    ORDER BY p.CreationDate DESC
    LIMIT 1
) latest_q ON TRUE
LEFT JOIN recent_votes rv        ON rv.PostId = latest_q.Id
LEFT JOIN question_closure qc    ON qc.PostId = latest_q.Id
LEFT JOIN CloseReasonTypes crt  ON crt.Id = NULLIF(qc.close_reason_id, '')::INTEGER
LEFT JOIN LATERAL (
    SELECT UNNEST(string_to_array(p.Tags, '><')) AS raw_tag
    FROM Posts p
    WHERE p.Id = latest_q.Id
) ptags ON TRUE
LEFT JOIN LATERAL (
    SELECT t.TagName, tt.rn
    FROM Tags t
    JOIN top_tags tt ON tt.TagName = t.TagName
    WHERE t.TagName = REPLACE(REPLACE(ptags.raw_tag, '<', ''), '>', '')
) tt ON TRUE
GROUP BY
    us.user_id, us.DisplayName, us.Reputation, us.net_votes,
    us.question_cnt, us.answer_cnt, us.gold_badges, us.silver_badges,
    us.bronze_badges, us.last_post_dt, rv.vote_score, rv.last_vote_dt,
    qc.closed_on, qc.reopened_on, crt.Name
HAVING COUNT(*) FILTER (WHERE us.Reputation > 1000) > 0

UNION ALL

SELECT
    -1                                    AS user_id,
    'Aggregate'                           AS DisplayName,
    SUM(us.Reputation)                    AS Reputation,
    SUM(us.net_votes)                     AS net_votes,
    SUM(us.question_cnt)                  AS question_cnt,
    SUM(us.answer_cnt)                    AS answer_cnt,
    SUM(us.gold_badges)                   AS gold_badges,
    SUM(us.silver_badges)                 AS silver_badges,
    SUM(us.bronze_badges)                 AS bronze_badges,
    MAX(us.last_post_dt)                  AS last_post_dt,
    SUM(rv.vote_score)                    AS recent_vote_score,
    MAX(rv.last_vote_dt)                  AS last_vote_dt,
    NULL                                  AS closed_on,
    NULL                                  AS reopened_on,
    NULL                                  AS close_reason,
    NULL                                  AS top_5_tags
FROM user_stats us
LEFT JOIN recent_votes rv ON rv.PostId IN (
    SELECT p.Id
    FROM Posts p
    WHERE p.OwnerUserId = us.user_id AND p.PostTypeId = 1
)
WHERE us.Reputation IS NOT NULL
ORDER BY Reputation DESC
LIMIT 100;