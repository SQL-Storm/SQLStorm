WITH UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, '[unknown]') AS Location,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        SUM(p.Score) FILTER (WHERE p.PostTypeId IN (1,2)) AS TotalScore,
        AVG(p.Score) FILTER (WHERE p.PostTypeId IN (1,2)) AS AvgScore,
        MAX(p.CreationDate) AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Location
),
BadgeCounts AS (
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(*) AS TotalBadges
    FROM Badges b
    GROUP BY b.UserId
),
TopTags AS (
    SELECT
        pt.UserId,
        STRING_AGG(t.TagName, ', ') AS TopTagList
    FROM (
        SELECT
            p.OwnerUserId AS UserId,
            UNNEST(string_to_array(TRIM(BOTH '<>' FROM p.Tags), '><')) AS Tag
        FROM Posts p
        WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    ) pt
    JOIN Tags t ON t.TagName = pt.Tag
    GROUP BY pt.UserId
),
RecentVotes AS (
    SELECT
        p.OwnerUserId AS UserId,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 2) AS UpVotesReceived,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 3) AS DownVotesReceived,
        COUNT(*) FILTER (WHERE v.VoteTypeId = 5) AS FavoritesReceived
    FROM Votes v
    JOIN Posts p ON p.Id = v.PostId
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
TopUsers AS (
    SELECT
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.Location,
        us.QuestionCount,
        us.AnswerCount,
        us.TotalScore,
        ROUND(CAST(us.AvgScore AS numeric), 2) AS AvgScore,
        bc.GoldBadges,
        bc.SilverBadges,
        bc.BronzeBadges,
        bc.TotalBadges,
        tt.TopTagList,
        rv.UpVotesReceived,
        rv.DownVotesReceived,
        rv.FavoritesReceived,
        CASE
            WHEN us.LastPostDate IS NULL THEN 'No posts'
            ELSE TO_CHAR(us.LastPostDate, 'YYYY-MM-DD')
        END AS LastPostDate,
        ROW_NUMBER() OVER (ORDER BY us.Reputation DESC, us.TotalScore DESC) AS RankByRepScore
    FROM UserStats us
    LEFT JOIN BadgeCounts bc   ON bc.UserId = us.Id
    LEFT JOIN TopTags tt       ON tt.UserId = us.Id
    LEFT JOIN RecentVotes rv   ON rv.UserId = us.Id
    WHERE us.Reputation > 10000
)
SELECT *
FROM TopUsers
ORDER BY RankByRepScore
FETCH FIRST 10 ROWS ONLY

UNION ALL

SELECT
    NULL AS Id,
    'Aggregates' AS DisplayName,
    NULL AS Reputation,
    NULL AS Location,
    SUM(u.QuestionCount) AS QuestionCount,
    SUM(u.AnswerCount) AS AnswerCount,
    SUM(u.TotalScore) AS TotalScore,
    NULL AS AvgScore,
    SUM(bc.GoldBadges) AS GoldBadges,
    SUM(bc.SilverBadges) AS SilverBadges,
    SUM(bc.BronzeBadges) AS BronzeBadges,
    SUM(bc.TotalBadges) AS TotalBadges,
    NULL AS TopTagList,
    SUM(rv.UpVotesReceived) AS UpVotesReceived,
    SUM(rv.DownVotesReceived) AS DownVotesReceived,
    SUM(rv.FavoritesReceived) AS FavoritesReceived,
    NULL AS LastPostDate,
    NULL AS RankByRepScore
FROM UserStats u
LEFT JOIN BadgeCounts bc   ON bc.UserId = u.Id
LEFT JOIN RecentVotes rv   ON rv.UserId = u.Id
WHERE u.Reputation > 10000;