with RecursiveTagCounts as (
    select
        t.Id,
        t.TagName,
        t.Count,
        coalesce(p.OwnerUserId, -1) as OwnerUserId,
        p.CreationDate as PostCreationDate,
        row_number() over (partition by t.Id order by p.CreationDate desc) as rn
    from Tags t
    left join Posts p on p.Tags like concat('%<', t.TagName, '>%')
    where t.IsModeratorOnly = false and t.IsRequired = false
),
FilteredPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.AcceptedAnswerId,
        u.Reputation,
        u.Location,
        u.CreationDate as UserCreationDate,
        coalesce(bc.BadgeCount,0) as BadgeCount
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    left join (
        select UserId, count(*) as BadgeCount
        from Badges
        where Class = 1 -- Gold badges only
        group by UserId
    ) bc on bc.UserId = p.OwnerUserId
    where p.PostTypeId in (1,2) -- Questions and Answers
      and p.CreationDate >= timestamp '2019-01-01'
),
AggregatedVotes as (
    select
        v.PostId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotes,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotes
    from Votes v
    inner join VoteTypes vt on vt.Id = v.VoteTypeId
    group by v.PostId
),
CTEQuestionsWithActivity as (
    select
        fp.Id,
        fp.PostTypeId,
        fp.OwnerUserId,
        fp.CreationDate,
        fp.Score,
        fp.ViewCount,
        fp.Tags,
        fp.AcceptedAnswerId,
        fp.Reputation,
        fp.Location,
        fp.UserCreationDate,
        fp.BadgeCount,
        coalesce(av.UpVotes,0) as UpVotes,
        coalesce(av.DownVotes,0) as DownVotes,
        ph.PostHistoryTypeId,
        ph.CreationDate as LastEditDate,
        cr.Name as CloseReasonName,
        case when max(case when ph.PostHistoryTypeId = 10 then 1 else 0 end) over (partition by fp.Id) = 1 then 1 else 0 end as IsClosed
    from FilteredPosts fp
    left join AggregatedVotes av on av.PostId = fp.Id
    left join PostHistory ph on ph.PostId = fp.Id
    left join CloseReasonTypes cr on cr.Id = cast(ph.Comment as integer)
    where fp.PostTypeId = 1
),
RankedAnswers as (
    select
        a.Id,
        a.PostTypeId,
        a.OwnerUserId,
        a.ParentId,
        a.CreationDate,
        a.Score,
        a.ViewCount,
        a.Tags,
        a.AcceptedAnswerId,
        u.DisplayName as AnswerOwnerDisplayName,
        row_number() over (partition by a.ParentId order by a.Score desc, a.CreationDate asc) as AnswerRank,
        count(*) over (partition by a.ParentId) as AnswerCountByQuestion,
        coalesce(av.UpVotes,0) as AnswerUpVotes,
        coalesce(av.DownVotes,0) as AnswerDownVotes
    from Posts a
    left join Users u on u.Id = a.OwnerUserId
    left join AggregatedVotes av on av.PostId = a.Id
    where a.PostTypeId = 2
),
FinalSelection as (
    select
        q.Id as QuestionId,
        q.Tags,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.UpVotes as QuestionUpVotes,
        q.DownVotes as QuestionDownVotes,
        q.Reputation as QuestionOwnerReputation,
        q.BadgeCount as QuestionOwnerGoldBadges,
        q.IsClosed,
        q.CloseReasonName,
        q.LastEditDate as QuestionLastEdit,
        r.AnswerRank,
        r.Id as AnswerId,
        r.Score as AnswerScore,
        r.AnswerUpVotes,
        r.AnswerDownVotes,
        r.AnswerCountByQuestion,
        r.AnswerOwnerDisplayName,
        percent_rank() over (partition by r.ParentId order by r.Score) as AnswerScorePercentile,
        -- normalized tag list length
        cast(length(replace(replace(coalesce(q.Tags, ''), '<', ''), '>', '')) as double precision)
            / nullif(cast(array_length(string_to_array(replace(coalesce(q.Tags, ''), '><', ','), ','), 1) as double precision), 0) as AvgTagNameLength,
        case when q.AcceptedAnswerId = r.Id then 1 else 0 end as IsAccepted,
        (select max(length(c.Text))
         from Comments c
         where c.PostId = r.Id
         and c.CreationDate > r.CreationDate - interval '30 days') as MaxRecentCommentLength,
        q.Id as q_Id,
        q.Tags as q_Tags,
        q.Score as q_Score,
        q.ViewCount as q_ViewCount,
        q.Reputation as q_Reputation,
        q.BadgeCount as q_BadgeCount,
        q.CloseReasonName as q_CloseReasonName,
        q.LastEditDate as q_LastEditDate,
        r.ParentId as r_ParentId,
        r.CreationDate as r_CreationDate
    from CTEQuestionsWithActivity q
    left join RankedAnswers r on r.ParentId = q.Id
    where r.AnswerRank is not null
)
select * from FinalSelection
where QuestionViews > 1000
  and QuestionScore > 5
  and (IsClosed = 0 or CloseReasonName is null)
union
select
    q.Id as QuestionId,
    q.Tags,
    q.Score as QuestionScore,
    q.ViewCount as QuestionViews,
    q.UpVotes as QuestionUpVotes,
    q.DownVotes as QuestionDownVotes,
    q.Reputation as QuestionOwnerReputation,
    q.BadgeCount as QuestionOwnerGoldBadges,
    q.IsClosed,
    q.CloseReasonName,
    q.LastEditDate as QuestionLastEdit,
    cast(null as integer) as AnswerRank,
    cast(null as integer) as AnswerId,
    cast(null as integer) as AnswerScore,
    cast(null as integer) as AnswerUpVotes,
    cast(null as integer) as AnswerDownVotes,
    cast(null as integer) as AnswerCountByQuestion,
    cast(null as varchar) as AnswerOwnerDisplayName,
    cast(null as double precision) as AnswerScorePercentile,
    cast(length(replace(replace(coalesce(q.Tags, ''), '<', ''), '>', '')) as double precision)
        / nullif(cast(array_length(string_to_array(replace(coalesce(q.Tags, ''), '><', ','), ','), 1) as double precision), 0) as AvgTagNameLength,
    cast(null as integer) as IsAccepted,
    cast(null as integer) as MaxRecentCommentLength,
    q.Id as q_Id,
    q.Tags as q_Tags,
    q.Score as q_Score,
    q.ViewCount as q_ViewCount,
    q.Reputation as q_Reputation,
    q.BadgeCount as q_BadgeCount,
    q.CloseReasonName as q_CloseReasonName,
    q.LastEditDate as q_LastEditDate,
    null as r_ParentId,
    null as r_CreationDate
from CTEQuestionsWithActivity q
where q.Id not in (select ParentId from RankedAnswers)
order by QuestionViews desc, QuestionScore desc, AnswerScore desc nulls last
limit 100;