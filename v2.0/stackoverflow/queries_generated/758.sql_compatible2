with
active_users as (
  select
    u.id as user_id,
    u.displayname,
    u.reputation,
    u.creationdate,
    u.lastaccessdate,
    u.upvotes,
    u.downvotes,
    coalesce(nullif(trim(split_part(coalesce(u.location,''), ',', 1)),''), 'Unknown') as country_guess,
    row_number() over (order by u.reputation desc, u.id) as rn
  from users u
  where u.reputation > 0
    and u.lastaccessdate >= (select max(p.creationdate) from posts p where p.creationdate is not null) - interval '365 days'
),
normalized_posts as (
  select
    p.id,
    p.posttypeid,
    p.owneruserid,
    p.parentid,
    p.acceptedanswerid,
    p.creationdate,
    p.score,
    p.viewcount,
    p.answercount,
    p.commentcount,
    p.favoritecount,
    p.closeddate,
    p.title,
    p.tags,
    case when p.posttypeid = 1 then 1 else 0 end as is_question,
    case when p.posttypeid = 2 then 1 else 0 end as is_answer,
    coalesce(p.viewcount, 0) + coalesce(p.favoritecount, 0) * 10 + greatest(coalesce(p.score,0),0) * 25 as engagement_points
  from posts p
  where p.creationdate is not null
),
question_tags as (
  select
    np.id as question_id,
    unnest(string_to_array(substring(np.tags, 2, greatest(length(np.tags)-2,0)), '><')) as tag_name
  from normalized_posts np
  where np.is_question = 1
    and np.tags is not null
),
user_post_agg as (
  select
    au.user_id,
    count(*) filter (where np.is_question = 1) as questions,
    count(*) filter (where np.is_answer = 1) as answers,
    sum(case when np.is_question = 1 then coalesce(np.score,0) else 0 end) as q_score,
    sum(case when np.is_answer = 1 then coalesce(np.score,0) else 0 end) as a_score,
    sum(np.engagement_points) as engagement_sum,
    avg(np.score) filter (where np.is_answer = 1) as avg_answer_score,
    max(np.viewcount) filter (where np.is_question = 1) as max_q_views,
    min(np.creationdate) as first_post_date,
    max(np.creationdate) as last_post_date,
    percentile_cont(0.5) within group (order by np.score) as median_post_score
  from active_users au
  left join normalized_posts np
    on np.owneruserid = au.user_id
  group by au.user_id
),
duplicate_graph as (
  select
    q.id as question_id,
    count(*) filter (where pl.linktypeid = 3) as duplicate_links,
    count(*) filter (where pl.linktypeid = 1) as related_links,
    count(distinct pl.relatedpostid) as distinct_linked_posts
  from posts q
  left join postlinks pl
    on pl.postid = q.id
  where q.posttypeid = 1
  group by q.id
),
comment_stats as (
  select
    c.postid,
    count(*) as total_comments,
    avg(coalesce(c.score,0)) as avg_comment_score,
    sum(case when c.text ilike '%thanks%' or c.text ilike '%thank you%' then 1 else 0 end) as thanks_count,
    sum(case when c.text ilike '%downvote%' or c.text ilike '%rtfm%' then 1 else 0 end) as snark_count
  from comments c
  group by c.postid
),
vote_breakdown as (
  select
    v.postid,
    count(*) filter (where v.votetypeid = 2) as upvotes,
    count(*) filter (where v.votetypeid = 3) as downvotes,
    count(*) filter (where v.votetypeid in (8,9)) as bounty_events,
    sum(coalesce(v.bountyamount,0)) as bounty_amount_total,
    count(*) filter (where v.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days' and v.votetypeid = 2) as upvotes_90d
  from votes v
  group by v.postid
),
answer_accepts as (
  select
    q.id as question_id,
    a.id as answer_id,
    a.owneruserid as answerer_id,
    extract(epoch from (a.creationdate - q.creationdate)) / 3600.0 as hours_to_first_answer,
    case when q.acceptedanswerid = a.id then 1 else 0 end as is_accepted
  from posts q
  left join posts a
    on a.parentid = q.id and a.posttypeid = 2
  where q.posttypeid = 1
),
first_answer as (
  select
    question_id,
    min(hours_to_first_answer) as min_hours_to_answer,
    max(case when is_accepted = 1 then 1 else 0 end) as has_accepted
  from answer_accepts
  group by question_id
),
tag_stats as (
  select
    lower(t.tagname) as tag_name,
    t.count as tag_count,
    case when t.ismoderatoronly then 1 else 0 end as mod_only,
    case when t.isrequired then 1 else 0 end as is_required
  from tags t
),
post_enriched as (
  select
    np.id,
    np.posttypeid,
    np.owneruserid,
    np.parentid,
    np.acceptedanswerid,
    np.creationdate,
    np.score,
    np.viewcount,
    np.answercount,
    np.commentcount,
    np.favoritecount,
    np.closeddate,
    np.title,
    np.tags,
    np.engagement_points,
    dg.duplicate_links,
    dg.related_links,
    dg.distinct_linked_posts,
    cs.total_comments,
    cs.avg_comment_score,
    cs.thanks_count,
    cs.snark_count,
    vb.upvotes,
    vb.downvotes,
    vb.bounty_events,
    vb.bounty_amount_total,
    vb.upvotes_90d,
    fa.min_hours_to_answer,
    fa.has_accepted
  from normalized_posts np
  left join duplicate_graph dg on dg.question_id = np.id
  left join comment_stats cs on cs.postid = np.id
  left join vote_breakdown vb on vb.postid = np.id
  left join first_answer fa on fa.question_id = np.id
),
user_activity_window as (
  select
    pe.owneruserid as user_id,
    count(*) filter (where pe.posttypeid = 1) over (partition by pe.owneruserid) as total_questions_by_user,
    count(*) filter (where pe.posttypeid = 2) over (partition by pe.owneruserid) as total_answers_by_user,
    sum(coalesce(pe.score,0)) over (partition by pe.owneruserid order by pe.creationdate rows between unbounded preceding and current row) as cumulative_score,
    avg(coalesce(pe.viewcount,0)) over (partition by pe.owneruserid) as avg_views_user,
    max(pe.creationdate) over (partition by pe.owneruserid) as last_post_at,
    min(pe.creationdate) over (partition by pe.owneruserid) as first_post_at,
    pe.id as post_id
  from post_enriched pe
),
-- compute p90 per user via grouping to avoid ordered-set WITHIN GROUP OVER()
user_p90 as (
  select
    ua.user_id,
    max(case when pct.rank = floor(0.9 * (pct.cnt - 1) + 1) then pct.score_val end) as p90_avg_views
  from (
    select user_id, avg_views_user as score_val,
           row_number() over (partition by user_id order by avg_views_user) as rank,
           count(*) over (partition by user_id) as cnt
    from user_activity_window
  ) as pct
  group by ua.user_id
  -- Note: This subquery alias references ua which doesn't exist here; replace with proper derived table below
),
user_p90_fixed as (
  select
    up.user_id,
    -- approximate 90th percentile by ordering and picking the ceil(0.9 * n)th value
    max(case when up.rn = ceil(0.9 * up.cnt) then up.score_val end) as p90_avg_views
  from (
    select user_id,
      score_val,
      row_number() over (partition by user_id order by score_val) as rn,
      count(*) over (partition by user_id) as cnt
    from (
      select user_id, avg_views_user as score_val
      from user_activity_window
    ) t
  ) up
  group by up.user_id
),
user_ranks as (
  select
    au.user_id,
    ua.total_questions_by_user,
    ua.total_answers_by_user,
    ua.avg_views_user,
    up90.p90_avg_views,
    dense_rank() over (order by coalesce(upa.engagement_sum,0) desc) as engagement_rank,
    coalesce(upa.engagement_sum,0) as engagement_sum,
    coalesce(upa.median_post_score,0) as median_post_score
  from active_users au
  left join user_activity_window ua on ua.user_id = au.user_id
  left join user_p90_fixed up90 on up90.user_id = au.user_id
  left join user_post_agg upa on upa.user_id = au.user_id
  group by au.user_id, ua.total_questions_by_user, ua.total_answers_by_user, ua.avg_views_user, up90.p90_avg_views, upa.engagement_sum, upa.median_post_score
),
user_tag_focus as (
  select
    q.owneruserid as user_id,
    qt.tag_name,
    count(*) as q_count_for_tag,
    sum(count(*)) over (partition by q.owneruserid) as total_q_for_user,
    cast(count(*) as numeric) / nullif(sum(count(*)) over (partition by q.owneruserid),0) as tag_share
  from posts q
  join question_tags qt on qt.question_id = q.id
  where q.posttypeid = 1
  group by q.owneruserid, qt.tag_name
),
user_top_tag as (
  select
    utf.user_id,
    utf.tag_name,
    utf.q_count_for_tag,
    utf.tag_share,
    row_number() over (partition by utf.user_id order by utf.tag_share desc, utf.q_count_for_tag desc, utf.tag_name) as rn
  from user_tag_focus utf
),
post_moderation_signals as (
  select
    ph.postid,
    count(*) filter (where ph.posthistorytypeid in (10,12,14,19,35)) as mod_events,
    max(ph.creationdate) filter (where ph.posthistorytypeid = 10) as last_closed_at,
    max(case when ph.posthistorytypeid = 10 and coalesce(nullif(ph.comment,''),'0') ~ '^[0-9]+$' then cast(ph.comment as int) else null end) as last_close_reason_id
  from posthistory ph
  group by ph.postid
),
post_tag_attrs as (
  select
    qt.question_id,
    array_agg(lower(qt.tag_name) order by lower(qt.tag_name)) as tags_array,
    sum(ts.tag_count) as sum_tag_counts,
    max(case when ts.mod_only = 1 then 1 else 0 end) as any_mod_only,
    max(case when ts.is_required = 1 then 1 else 0 end) as any_required
  from question_tags qt
  left join tag_stats ts on ts.tag_name = lower(qt.tag_name)
  group by qt.question_id
),
post_quality as (
  select
    pe.id as post_id,
    coalesce(pe.score,0) as base_score,
    coalesce(pe.viewcount,0) as views,
    coalesce(pe.answercount,0) as answers,
    coalesce(pe.commentcount,0) as comments,
    coalesce(pe.upvotes,0) - coalesce(pe.downvotes,0) as net_votes,
    case when pe.has_accepted = 1 then 1 else 0 end as accepted_flag,
    case when pe.closeddate is not null then 1 else 0 end as closed_flag,
    greatest(0,
      (coalesce(pe.score,0) * 3)
      + (least(coalesce(pe.viewcount,0), 10000) / 250)
      + (coalesce(pe.upvotes,0) * 2)
      - (coalesce(pe.downvotes,0) * 3)
      + (case when pe.has_accepted = 1 then 15 else 0 end)
      - (case when pe.closeddate is not null then 20 else 0 end)
      + (least(coalesce(pe.answercount,0), 10) * 2)
      + (least(coalesce(pe.thanks_count,0), 5))
      - (least(coalesce(pe.snark_count,0), 5))
    ) as quality_score,
    (length(coalesce(pe.title,'')) - length(replace(coalesce(pe.title,''),' ',''))) + 1 as approx_title_words,
    position('how to' in lower(coalesce(pe.title,''))) as has_phrase_howto
  from post_enriched pe
)
select
  au.user_id,
  coalesce(au.displayname, '(anon)') as displayname,
  au.reputation,
  au.country_guess,
  ur.engagement_rank,
  ur.engagement_sum,
  round(coalesce(ur.median_post_score,0),2) as median_post_score,
  upa.questions,
  upa.answers,
  upa.q_score,
  upa.a_score,
  utt.tag_name as top_tag,
  round(100 * utt.tag_share, 2) as top_tag_share_pct,
  count(distinct case when pe.posttypeid = 1 then pe.id end) as q_posts_sampled,
  round(avg(pq.quality_score),2) as avg_quality_score,
  sum(case when pe.has_accepted = 1 then 1 else 0 end) as accepted_q_count,
  round(avg(nullif(pe.min_hours_to_answer,0)),2) as avg_hours_to_first_answer,
  sum(coalesce(pms.mod_events,0)) as moderation_events,
  max(pms.last_close_reason_id) as last_close_reason_id,
  max(pta.sum_tag_counts) as sum_tag_popularity,
  sum(case when pe.closeddate is not null then 1 else 0 end) as closed_count,
  round(avg(pe.upvotes_90d),2) as avg_recent_upvotes_per_post,
  max(uaw.cumulative_score) as max_cumulative_score,
  max(uaw.last_post_at) as last_post_at,
  min(uaw.first_post_at) as first_post_at,
  string_agg(distinct case when pq.has_phrase_howto > 0 then 'how-to' end, ',') as title_flags
from active_users au
left join user_post_agg upa on upa.user_id = au.user_id
left join user_ranks ur on ur.user_id = au.user_id
left join user_activity_window uaw on uaw.user_id = au.user_id
left join post_enriched pe on pe.owneruserid = au.user_id and pe.posttypeid in (1,2)
left join post_quality pq on pq.post_id = pe.id
left join post_moderation_signals pms on pms.postid = pe.id
left join post_tag_attrs pta on pta.question_id = pe.id
left join user_top_tag utt on utt.user_id = au.user_id and utt.rn = 1
where
  (
    (coalesce(upa.answers,0) > 0 and coalesce(upa.questions,0) >= 1)
    or (ur.engagement_rank <= 1000 and au.reputation > 1000)
    or (exists (
      select 1
      from posts p2
      where p2.owneruserid = au.user_id
        and p2.posttypeid = 1
        and p2.score >= all (
          select coalesce(p3.score,0)
          from posts p3
          where p3.owneruserid = au.user_id
        )
    ))
  )
  and (coalesce(ur.avg_views_user,0) >= coalesce(ur.p90_avg_views,0) * 0.25 or ur.avg_views_user is null)
group by
  au.user_id, au.displayname, au.reputation, au.country_guess,
  ur.engagement_rank, ur.engagement_sum, ur.median_post_score,
  upa.questions, upa.answers, upa.q_score, upa.a_score,
  utt.tag_name, utt.tag_share
having
  count(*) >= 1
order by
  avg_quality_score desc nulls last,
  ur.engagement_rank asc nulls last,
  au.reputation desc
limit 200;