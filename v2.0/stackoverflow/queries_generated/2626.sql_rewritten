-- {"query": "2626.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1580} 
with RecursiveTags as (
    -- Recursive CTE to explode tags array from Posts table questions
    select 
        p.Id as PostId,
        trim(tag.value) as Tag,
        1 as Level
    from 
        Posts p
        cross join lateral unnest(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) tag(value)
    where p.PostTypeId = 1 and p.Tags is not null
    union all
    select
        rt.PostId,
        trim(rt.Tag) || '_ext' as Tag,
        rt.Level + 1
    from RecursiveTags rt
    where rt.Level < 2
),
UserBadgeCounts as (
    select 
        b.UserId,
        b.Class,
        count(*) as BadgeCount
    from Badges b
    group by b.UserId, b.Class
),
UserReputationStats as (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        coalesce(ubc_g.GoldCount, 0) as GoldBadges,
        coalesce(ubc_s.SilverCount, 0) as SilverBadges,
        coalesce(ubc_b.BronzeCount, 0) as BronzeBadges,
        rank() over (order by u.Reputation desc) as RepRank,
        dense_rank() over (partition by coalesce(u.Location, 'Unknown') order by u.Reputation desc) as LocationRepRank
    from Users u
    left join (
        select UserId, BadgeCount as GoldCount from UserBadgeCounts where Class = 1
    ) ubc_g on ubc_g.UserId = u.Id
    left join (
        select UserId, BadgeCount as SilverCount from UserBadgeCounts where Class = 2
    ) ubc_s on ubc_s.UserId = u.Id
    left join (
        select UserId, BadgeCount as BronzeCount from UserBadgeCounts where Class = 3
    ) ubc_b on ubc_b.UserId = u.Id
),
PostAnswerDetails as (
    select 
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreationDate,
        q.OwnerUserId,
        q.Score as QuestionScore,
        count(a.Id) filter (where a.Id is not null) as AnswerCount,
        max(a.Score) as MaxAnswerScore,
        avg(a.Score) as AvgAnswerScore,
        min(a.CreationDate) as FirstAnswerDate,
        max(a.CreationDate) as LastAnswerDate,
        string_agg(distinct rt.Tag, ',' order by rt.Tag) as Tags,
        case when q.ClosedDate is not null then 1 else 0 end as IsClosed
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join RecursiveTags rt on rt.PostId = q.Id
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.CreationDate, q.OwnerUserId, q.Score, q.ClosedDate
),
UserActivityWindow as (
    select 
        ph.UserId,
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        lag(ph.CreationDate) over (partition by ph.UserId order by ph.CreationDate) as PreviousEditDate,
        lead(ph.CreationDate) over (partition by ph.UserId order by ph.CreationDate) as NextEditDate,
        case 
            when ph.PostHistoryTypeId in (10,12) then 1 else 0 
        end as IsClosedOrDeleted
    from PostHistory ph
    where ph.UserId is not null
),
FilteredPostLinks as (
    select 
        pl.PostId,
        pl.RelatedPostId,
        lt.Name as LinkTypeName
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where lt.Name in ('Duplicate', 'Linked')
),
HighImpactPosts as (
    select 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        p.CreationDate,
        case 
            when p.Score > 100 then 'High'
            when p.Score between 50 and 100 then 'Medium'
            else 'Low'
        end as ImpactLevel
    from Posts p
    where p.PostTypeId = 1 and p.Score is not null
),
AllUserQuestionsAnswers as (
    select u.Id as UserId, p.Id as PostId, p.PostTypeId, p.Score, p.CreationDate
    from Users u 
    left join Posts p on p.OwnerUserId = u.Id and p.PostTypeId in (1, 2)
)
select 
    hq.Id as QuestionId,
    hq.Title,
    hq.Tags,
    hq.AnswerCount,
    hq.MaxAnswerScore,
    hq.AvgAnswerScore::numeric(10,2),
    hq.QuestionScore,
    hq.IsClosed,
    urs.DisplayName as OwnerName,
    urs.Reputation as OwnerReputation,
    urs.GoldBadges,
    urs.SilverBadges,
    urs.BronzeBadges,
    urs.LocationRepRank,
    hl.ViewCount,
    hl.ImpactLevel,
    coalesce(lkdups.DuplicateCount,0) as DuplicateLinks,
    coalesce(lklinks.LinkedCount,0) as LinkedCount,
    lastActivity.LastEditDate,
    pg.CommentCount,
    case 
        when hq.AnswerCount > 0 and pg.FavoriteCount is null then 'Popular Question Without Favorites' 
        when pg.FavoriteCount is not null then 'Favorited Question' 
        else 'Unfavored and Unanswered'
    end as PopularityStatus,
    case when urs.Location is null then 'Unknown' else urs.Location end as OwnerLocation
from PostAnswerDetails hq
join Users urs on urs.Id = hq.OwnerUserId
left join Posts pg on pg.Id = hq.QuestionId
left join HighImpactPosts hl on hl.Id = hq.QuestionId
left join (
    select PostId, count(*) as DuplicateCount
    from FilteredPostLinks
    where LinkTypeName = 'Duplicate'
    group by PostId
) lkdups on lkdups.PostId = hq.QuestionId
left join (
    select PostId, count(*) as LinkedCount
    from FilteredPostLinks
    where LinkTypeName = 'Linked'
    group by PostId
) lklinks on lklinks.PostId = hq.QuestionId
left join (
    select PostId, max(LastEditDate) as LastEditDate
    from Posts
    group by PostId
) lastActivity on lastActivity.PostId = hq.QuestionId
where 
    -- Complex predicate involving score and dates and NULL logic
    ((hq.QuestionScore > 10 and hq.AnswerCount >= 3 and (hq.MaxAnswerScore > hq.QuestionScore or hq.MaxAnswerScore is null))
    or (hq.IsClosed = 0 and hq.QuestionCreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '180 days'))
    and (
        urs.Reputation >= 1000 or urs.GoldBadges >= 1 or urs.SilverBadges >= 3
    )
order by hq.QuestionScore desc, hq.AnswerCount desc, urs.Reputation desc
limit 100;