WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        U.DisplayName,
        U.Reputation,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    GROUP BY 
        U.Id
)
SELECT 
    RP.Id,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.DisplayName,
    RP.Reputation,
    RP.rank,
    B.BadgeCount,
    SUM(V.Score) AS TotalVotes,
    CASE 
        WHEN RP.rank = 1 THEN 'Top Score'
        WHEN RP.rank = 2 THEN 'Second Best'
        WHEN RP.rank = 3 THEN 'Third Best'
        ELSE 'Other'
    END AS RankLabel,
    CASE
        WHEN B.BadgeCount >= 5 THEN 'Elite'
        WHEN B.BadgeCount >= 3 THEN 'Advanced'
        ELSE 'Beginner'
    END AS BadgeLevel
FROM 
    RankedPosts RP
LEFT JOIN 
    BadgeCounts B ON RP.OwnerUserId = B.UserId
LEFT JOIN 
    Votes V ON RP.Id = V.PostId
GROUP BY 
    RP.Id, RP.Title, RP.Score, RP.ViewCount, RP.CreationDate, RP.DisplayName, RP.Reputation, RP.rank, B.BadgeCount
ORDER BY 
    TotalVotes DESC, RP.Score DESC;