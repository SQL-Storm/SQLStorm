WITH
  RankedAnswers AS (
    SELECT
      p.Id AS PostId,
      p.ParentId AS QuestionId,
      p.OwnerUserId,
      p.CreationDate AS AnswerCreationDate,
      ROW_NUMBER() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC, p.CreationDate ASC) AS AnswerRank
    FROM Posts p
    WHERE
      p.PostTypeId = 2
  ),
  QuestionDetails AS (
    SELECT
      q.Id AS QuestionId,
      q.OwnerUserId AS QuestionOwnerUserId,
      q.CreationDate AS QuestionCreationDate,
      q.Score AS QuestionScore,
      q.ViewCount AS QuestionViewCount,
      q.AnswerCount,
      q.FavoriteCount,
      q.ClosedDate,
      q.Tags,
      u.DisplayName AS QuestionOwnerDisplayName,
      u.Reputation AS QuestionOwnerReputation,
      COALESCE(u.WebsiteUrl, 'No Website') AS QuestionOwnerWebsite,
      CASE WHEN u.Location IS NULL OR u.Location = '' THEN 'Unknown Location' ELSE u.Location END AS QuestionOwnerLocation,
      (
        SELECT
          COUNT(ph.Id)
        FROM PostHistory ph
        WHERE
          ph.PostId = q.Id AND ph.PostHistoryTypeId IN (4, 5, 6)
      ) AS EditCount,
      COALESCE(
        (
          SELECT
            MAX(ph.CreationDate)
          FROM PostHistory ph
          WHERE
            ph.PostId = q.Id AND ph.PostHistoryTypeId IN (4, 5, 6)
        ),
        q.CreationDate
      ) AS LastEditActivityDate
    FROM Posts q
    LEFT JOIN Users u
      ON q.OwnerUserId = u.Id
    WHERE
      q.PostTypeId = 1
  ),
  UserVoteSummary AS (
    SELECT
      UserId,
      COUNT(CASE WHEN VoteTypeId = 2 THEN 1 END) AS UpVoteCount,
      COUNT(CASE WHEN VoteTypeId = 3 THEN 1 END) AS DownVoteCount,
      COUNT(CASE WHEN VoteTypeId = 8 THEN 1 END) AS BountyStartCount,
      COUNT(CASE WHEN VoteTypeId = 5 THEN 1 END) AS FavoriteCount
    FROM Votes
    WHERE
      UserId IS NOT NULL
    GROUP BY
      UserId
  ),
  AggregatedPostInfo AS (
    SELECT
      p.Id,
      p.PostTypeId,
      p.OwnerUserId,
      p.CreationDate,
      p.Score,
      p.ViewCount,
      p.AnswerCount,
      p.CommentCount,
      p.FavoriteCount,
      p.ClosedDate,
      p.Tags,
      ROW_NUMBER() OVER (ORDER BY p.CreationDate DESC) AS PostSequence
    FROM Posts p
    WHERE
      p.PostTypeId IN (1, 2)
  )
SELECT
  QD.QuestionId,
  QD.QuestionOwnerDisplayName,
  QD.QuestionOwnerReputation,
  QD.QuestionOwnerWebsite,
  QD.QuestionOwnerLocation,
  QD.QuestionCreationDate,
  QD.QuestionScore,
  QD.QuestionViewCount,
  QD.AnswerCount AS TotalAnswerCount,
  QD.FavoriteCount AS QuestionFavoriteCount,
  QD.ClosedDate,
  QD.EditCount,
  QD.LastEditActivityDate,
  RA1.OwnerUserId AS BestAnswerOwnerUserId,
  RA1.AnswerCreationDate AS BestAnswerCreationDate,
  UVS.UpVoteCount AS QuestionUpVoteCount,
  UVS.DownVoteCount AS QuestionDownVoteCount,
  UVS.BountyStartCount,
  CASE WHEN QD.Tags LIKE '%<sql>%' THEN 'SQL Related' ELSE 'Other' END AS TagCategory,
  (
    SELECT
      COUNT(*)
    FROM Comments c
    WHERE
      c.PostId = QD.QuestionId
  ) AS TotalCommentsOnQuestion,
  (
    SELECT
      SUM(CAST(c.Score AS NUMERIC))
    FROM Comments c
    WHERE
      c.PostId = QD.QuestionId
  ) AS TotalCommentsScoreOnQuestion,
  (
    SELECT
      AVG(CAST(LENGTH(c.Text) AS DOUBLE PRECISION))
    FROM Comments c
    WHERE
      c.PostId = QD.QuestionId
  ) AS AvgCommentLengthOnQuestion,
  CASE WHEN QD.QuestionScore > 1000 AND QD.AnswerCount > 10 THEN 'High Engagement' WHEN QD.QuestionScore < 0 THEN 'Low Engagement' ELSE 'Moderate Engagement' END AS EngagementLevel,
  CASE
    WHEN QD.ClosedDate IS NOT NULL THEN 'Closed'
    WHEN QD.LastEditActivityDate > QD.QuestionCreationDate + INTERVAL '30 days' THEN 'Recently Edited'
    ELSE 'Active'
  END AS PostStatus,
  (QD.QuestionOwnerDisplayName || ' (Rep: ' || CAST(QD.QuestionOwnerReputation AS TEXT) || ')') AS OwnerInfo,
  COALESCE(
    (
      SELECT
        COUNT(ph.Id)
      FROM PostHistory ph
      WHERE
        ph.PostId = QD.QuestionId AND ph.PostHistoryTypeId = 2
    ),
    0
  ) AS InitialBodyHistoryCount,
  COALESCE(
    (
      SELECT
        SUM(CAST(ph.Comment AS INTEGER))
      FROM PostHistory ph
      WHERE
        ph.PostId = QD.QuestionId AND ph.PostHistoryTypeId = 10
    ),
    0
  ) AS CloseVoteCount,
  (
    SELECT
      COUNT(DISTINCT ph.UserId)
    FROM PostHistory ph
    WHERE
      ph.PostId = QD.QuestionId AND ph.PostHistoryTypeId IN (4, 5, 6)
  ) AS DistinctEditorsCount,
  (
    SELECT
      COUNT(*)
    FROM PostLinks pl
    WHERE
      pl.PostId = QD.QuestionId AND pl.LinkTypeId = 3
  ) AS DuplicateLinkCount,
  (
    SELECT
      COUNT(*)
    FROM Badges b
    WHERE
      b.UserId = QD.QuestionOwnerUserId AND b.Class = 1
  ) AS OwnerGoldBadges,
  CASE
    WHEN QD.QuestionScore > (
      SELECT
        AVG(p_avg.Score)
      FROM Posts p_avg
      WHERE
        p_avg.PostTypeId = 1 AND p_avg.CreationDate BETWEEN QD.QuestionCreationDate - INTERVAL '7 days' AND QD.QuestionCreationDate + INTERVAL '7 days'
    ) THEN 'Above Average Score'
    ELSE 'Average or Below Score'
  END AS ScoreComparisonToPeer,
  (
    SELECT
      MIN(p_oldest.CreationDate)
    FROM Posts p_oldest
    WHERE
      p_oldest.ParentId = QD.QuestionId AND p_oldest.PostTypeId = 2
  ) AS OldestAnswerDate,
  NULL AS PlaceholderForUnion
FROM QuestionDetails QD
LEFT JOIN RankedAnswers RA1
  ON QD.QuestionId = RA1.QuestionId AND RA1.AnswerRank = 1
LEFT JOIN UserVoteSummary UVS
  ON QD.QuestionOwnerUserId = UVS.UserId
WHERE
  QD.QuestionScore > 0
  AND QD.AnswerCount > 0
  AND QD.QuestionOwnerReputation > 1000
  AND QD.QuestionCreationDate >= DATE '2023-01-01'
GROUP BY
  QD.QuestionId,
  QD.QuestionOwnerDisplayName,
  QD.QuestionOwnerReputation,
  QD.QuestionOwnerWebsite,
  QD.QuestionOwnerLocation,
  QD.QuestionCreationDate,
  QD.QuestionScore,
  QD.QuestionViewCount,
  QD.AnswerCount,
  QD.FavoriteCount,
  QD.ClosedDate,
  QD.EditCount,
  QD.LastEditActivityDate,
  RA1.OwnerUserId,
  RA1.AnswerCreationDate,
  UVS.UpVoteCount,
  UVS.DownVoteCount,
  UVS.BountyStartCount,
  QD.Tags
ORDER BY
  QD.QuestionScore DESC
LIMIT 100;