-- {"query": "2590.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1358} 
with RankedPosts as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.Title,
        p.AnswerCount,
        p.ClosedDate,
        row_number() over (
            partition by p.OwnerUserId 
            order by p.Score desc, p.CreationDate desc
        ) as rn
    from Posts p
    where p.PostTypeId in (1, 2)
      and p.OwnerUserId is not null
      and p.Score is not null
),
-- Top scored questions per user
TopQuestions as (
    select rp.*
    from RankedPosts rp
    where rp.PostTypeId = 1 and rp.rn = 1
),
-- Top scored answers per user
TopAnswers as (
    select rp.*
    from RankedPosts rp
    where rp.PostTypeId = 2 and rp.rn = 1
),
-- Aggregate badge info per user with conditional aggregation and string aggregation
UserBadges as (
    select
        b.UserId,
        count(*) as TotalBadges,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        string_agg(distinct b.Name, ', ' order by b.Name) as BadgeNames
    from Badges b
    group by b.UserId
),
-- Most common close reasons from PostHistory for questions closed in last year
CloseReasonsCounts as (
    select
        ph.Comment::int as CloseReasonId,
        crt.Name,
        count(*) as CloseCount
    from PostHistory ph
    inner join CloseReasonTypes crt on crt.Id = ph.Comment::int
    where ph.PostHistoryTypeId = 10
      and ph.CreationDate > cast('2024-10-01' as date) - interval '365 days'
    group by ph.Comment::int, crt.Name
    order by CloseCount desc
    limit 5
),
-- Users with their top question, top answer, badges, last activity and reputation percentiles
UsersSummary as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        ub.TotalBadges,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        ub.BadgeNames,
        tq.Title as TopQuestionTitle,
        tq.Score as TopQuestionScore,
        ta.Title as TopAnswerTitle,
        ta.Score as TopAnswerScore,
        -- Days since creation and last access
        date_part('day', cast('2024-10-01 12:34:56' as timestamp) - u.CreationDate) as DaysSinceCreation,
        date_part('day', cast('2024-10-01 12:34:56' as timestamp) - u.LastAccessDate) as DaysSinceLastAccess,
        -- Null-safe coalesce on strings
        coalesce(u.Location, 'Unknown') as Location,
        -- Compute reputation percentile
        percentile_cont(0.95) within group (order by u.Reputation) over () as Reputation95pct
    from Users u
    left join UserBadges ub on ub.UserId = u.Id
    left join TopQuestions tq on tq.OwnerUserId = u.Id
    left join TopAnswers ta on ta.OwnerUserId = u.Id
),
-- Posts with tags split into rows for tag frequency analysis
ExplodedTags as (
    select
        p.Id as PostId,
        p.PostTypeId,
        unnest(string_to_array(substring(p.Tags from 2 for length(p.Tags) - 2), '><')) as Tag
    from Posts p
    where p.Tags is not null
),
-- Tag frequency and average question score
TagStats as (
    select
        et.Tag,
        count(distinct et.PostId) as TaggedPosts,
        avg(p.Score) as AvgScore,
        count(distinct case when p.PostTypeId = 1 and p.ClosedDate is null then p.Id end) as OpenQuestions
    from ExplodedTags et
    inner join Posts p on p.Id = et.PostId
    group by et.Tag
    having count(distinct et.PostId) > 100
),
-- Correlated subquery to find for each user's top question the number of answers posted in last 30 days
UserTopQAnswerCount as (
    select
        u.Id as UserId,
        coalesce((
          select count(*)
          from Posts a
          where a.PostTypeId = 2
          and a.ParentId = (
              select q.Id from Posts q where q.PostTypeId = 1 and q.OwnerUserId = u.Id order by q.Score desc limit 1
          )
          and a.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - interval '30 days'
        ), 0) as RecentAnswersOnTopQuestion
    from Users u
)
select
    us.UserId,
    us.DisplayName,
    us.Reputation,
    us.Reputation95pct,
    us.DaysSinceCreation,
    us.DaysSinceLastAccess,
    us.Location,
    us.TotalBadges,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.BadgeNames,
    us.TopQuestionTitle,
    us.TopQuestionScore,
    us.TopAnswerTitle,
    us.TopAnswerScore,
    uqc.RecentAnswersOnTopQuestion,
    tr.Tag as PopularTag,
    tr.TaggedPosts,
    tr.AvgScore,
    tr.OpenQuestions,
    crc.Name as PopularCloseReason,
    crc.CloseCount
from UsersSummary us
left join UserTopQAnswerCount uqc on uqc.UserId = us.UserId
left join LATERAL (
    select ts.Tag, ts.TaggedPosts, ts.AvgScore, ts.OpenQuestions
    from TagStats ts
    where ts.Tag = (
        select et.Tag from ExplodedTags et
        where et.PostId = (
            select tq.Id from TopQuestions tq where tq.OwnerUserId = us.UserId limit 1
        )
        limit 1
    )
    limit 1
) tr on true
left join CloseReasonsCounts crc on crc.CloseReasonId = 102 -- Off-topic, for example
where us.Reputation > 1000
order by us.Reputation desc nulls last
limit 50;