with recursive TagHierarchy as (
    select Id, TagName, WikiPostId, 1 as Level
    from Tags
    where IsRequired = true
    union all
    select t.Id, t.TagName, t.WikiPostId, th.Level + 1
    from Tags t
    join TagHierarchy th on substring(t.TagName from 1 for 3) = substring(th.TagName from 1 for 3)
    and t.Id <> th.Id
    and th.Level < 3
),
UserBadgeCounts as (
    select UserId,
        sum(case when "Class" = 1 then 1 else 0 end) as GoldBadges,
        sum(case when "Class" = 2 then 1 else 0 end) as SilverBadges,
        sum(case when "Class" = 3 then 1 else 0 end) as BronzeBadges
    from Badges
    group by UserId
),
PostAnswerRanks as (
    select p.Id as AnswerId, p.ParentId as QuestionId, p.Score, p.CreationDate,
        row_number() over (partition by p.ParentId order by p.Score desc, p.CreationDate asc) as AnswerRank
    from Posts p
    where p.PostTypeId = 2
),
QuestionInfo as (
    select q.Id, q.Title, q.Tags, u.DisplayName as OwnerName, q.Score, q.ViewCount,
           coalesce(ubc.GoldBadges,0) as GoldBadges, coalesce(ubc.SilverBadges,0) as SilverBadges,
           coalesce(ubc.BronzeBadges,0) as BronzeBadges,
           (select count(*) from Comments c where c.PostId = q.Id) as CommentTotal,
           (select max(Score) from Posts a where a.ParentId = q.Id) as MaxAnswerScore,
           (select count(distinct pht.Id)
            from PostHistory pht
            where pht.PostId = q.Id and pht.PostHistoryTypeId in (10,11)) as CloseReopenCount,
           row_number() over (order by q.Score desc, q.ViewCount desc) as QuestionRank
    from Posts q
    left join Users u on u.Id = q.OwnerUserId
    left join UserBadgeCounts ubc on ubc.UserId = q.OwnerUserId
    where q.PostTypeId = 1
),
CloseReasonStats as (
    select crt.Id, crt.Name, count(ph.Id) as CloseCount
    from CloseReasonTypes crt
    left join PostHistory ph on ph.PostHistoryTypeId = 10 and ph."Comment" = cast(crt.Id as varchar)
    group by crt.Id, crt.Name
),
UserActivityWindow as (
    select u.Id, u.DisplayName, u.Reputation, u.CreationDate, 
        count(distinct p.Id) filter (where p.PostTypeId in (1,2)) over (partition by u.Id order by p.CreationDate rows between 30 preceding and current row) as PostsLast30Days,
        count(distinct v.Id) filter (where v.CreationDate >= (date '2024-10-01' - interval '30' day)) as VotesLast30Days
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.UserId = u.Id
),
DuplicatedPosts as (
    select pl.PostId, pl.RelatedPostId, lt.Name as LinkTypeName,
        case when lt.Id = 3 then 1 else 0 end as IsDuplicate
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where lt.Id in (1,3)
),
QuestionUserAggregates as (
    select q.Id, count(distinct a.Id) as TotalAnswers,
        count(distinct case when ub.GoldBadges > 0 then a.OwnerUserId end) as AnswersFromGoldUsers,
        avg(a.Score) as AvgAnswerScore
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join UserBadgeCounts ub on ub.UserId = a.OwnerUserId
    where q.PostTypeId = 1
    group by q.Id
)
select qi.Id as QuestionId, qi.Title, qi.OwnerName, qi.Score as QuestionScore, qi.ViewCount,
    qi.GoldBadges, qi.SilverBadges, qi.BronzeBadges,
    qi.CommentTotal, qi.MaxAnswerScore, qi.CloseReopenCount, qi.QuestionRank,
    qua.TotalAnswers, qua.AnswersFromGoldUsers, qua.AvgAnswerScore,
    crs.Name as MostCommonCloseReason,
    ua.PostsLast30Days, ua.VotesLast30Days,
    ('Tags: ' || string_agg(distinct th.TagName, ', ' order by th.TagName)) as RelatedTags,
    (select json_agg(json_build_object(
        'AnswerId', pa.AnswerId,
        'AnswerScore', pa.Score,
        'AnswerRank', pa.AnswerRank,
        'OwnerReputation', coalesce(u.Reputation, 0),
        'OwnerDisplayName', u.DisplayName,
        'AgeDays', extract(day from (timestamp '2024-10-01 12:34:56' - pa.CreationDate))
    ) order by pa.AnswerRank) 
     from PostAnswerRanks pa 
     left join Users u on u.Id = (
          select p.OwnerUserId from Posts p where p.Id = pa.AnswerId
     )
     where pa.QuestionId = qi.Id and pa.AnswerRank <= 3
    ) as TopAnswersInfo,
    (select count(*) from DuplicatedPosts dp where dp.PostId = qi.Id and dp.IsDuplicate = 1) as DuplicateCount
from QuestionInfo qi
left join QuestionUserAggregates qua on qua.Id = qi.Id
left join LATERAL (
    select crt.Name
    from CloseReasonStats crt
    order by crt.CloseCount desc
    limit 1
) crs ON true
left join UserActivityWindow ua on ua.Id = qi.Id
left join TagHierarchy th on position(th.TagName in coalesce(qi.Tags, '')) > 0
where qi.Score > 5
group by qi.Id, qi.Title, qi.OwnerName, qi.Score, qi.ViewCount, qi.GoldBadges, qi.SilverBadges, qi.BronzeBadges,
         qi.CommentTotal, qi.MaxAnswerScore, qi.CloseReopenCount, qi.QuestionRank,
         qua.TotalAnswers, qua.AnswersFromGoldUsers, qua.AvgAnswerScore,
         crs.Name, ua.PostsLast30Days, ua.VotesLast30Days, qi.Tags
order by qi.QuestionRank
limit 100;