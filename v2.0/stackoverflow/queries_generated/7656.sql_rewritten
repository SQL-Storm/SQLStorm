-- {"query": "7656.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 2368} 
WITH UserStats AS (
  SELECT 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    COUNT(DISTINCT p.Id) as PostCount,
    COUNT(DISTINCT c.Id) as CommentCount,
    COUNT(DISTINCT b.Id) as BadgeCount,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) as QuestionCount,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) as AnswerCount,
    SUM(COALESCE(p.Score, 0)) as TotalScore,
    AVG(COALESCE(p.Score, 0)) as AvgScore,
    STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ', ') as TagsList,
    MAX(p.CreationDate) as LastPostDate,
    MAX(u.LastAccessDate) as LastAccessDate
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId
  LEFT JOIN Comments c ON u.Id = c.UserId
  LEFT JOIN Badges b ON u.Id = b.UserId
  WHERE u.CreationDate >= '2010-01-01'
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
RankedUsers AS (
  SELECT 
    *,
    ROW_NUMBER() OVER (ORDER BY TotalScore DESC, Reputation DESC) as RankByScore,
    DENSE_RANK() OVER (ORDER BY Reputation DESC) as RankByReputation,
    NTILE(100) OVER (ORDER BY Reputation DESC) as RepPercentile,
    LAG(DisplayName) OVER (ORDER BY Reputation DESC) as PrevUser,
    LEAD(DisplayName) OVER (ORDER BY Reputation DESC) as NextUser
  FROM UserStats
),
PostAnalytics AS (
  SELECT 
    p.Id as PostId,
    p.Title,
    p.Body,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.OwnerUserId,
    p.PostTypeId,
    p.AnswerCount,
    p.CommentCount,
    p.Tags,
    p.ParentId,
    CASE 
      WHEN p.PostTypeId = 1 AND p.AcceptedAnswerId IS NOT NULL THEN 'Question with Accepted Answer'
      WHEN p.PostTypeId = 1 THEN 'Question without Answer'
      WHEN p.PostTypeId = 2 THEN 'Answer'
      ELSE 'Other'
    END as PostTypeCategory,
    CASE 
      WHEN p.Score >= 100 THEN 'Gold'
      WHEN p.Score >= 50 THEN 'Silver'
      WHEN p.Score >= 10 THEN 'Bronze'
      ELSE 'Common'
    END as ScoreTier,
    LENGTH(p.Body) as BodyLength,
    ARRAY_LENGTH(string_to_array(p.Tags, '>'), 1) as TagCount,
    EXTRACT(DAY FROM (cast('2024-10-01 12:34:56' as timestamp) - p.CreationDate)) as DaysOld,
    CASE 
      WHEN p.CommentCount > 0 AND p.Score = 0 THEN 'Controversial'
      WHEN p.CommentCount > 10 AND p.Score > 20 THEN 'Highly Engaged'
      ELSE 'Normal'
    END as EngagementLevel,
    STRING_AGG(SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ', ') OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as CumulativeTags,
    AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) as UserAvgScore,
    LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PrevScore
  FROM Posts p
  WHERE p.CreationDate >= '2015-01-01'
),
TopQuestions AS (
  SELECT 
    pa.PostId,
    pa.Title,
    pa.Score,
    pa.ViewCount,
    pa.OwnerUserId,
    pa.TagCount,
    pa.DaysOld,
    pa.ScoreTier,
    pa.TagCount * pa.Score as TagScoreProduct,
    RANK() OVER (ORDER BY pa.Score DESC, pa.ViewCount DESC) as RankByScoreAndView,
    ROW_NUMBER() OVER (PARTITION BY pa.OwnerUserId ORDER BY pa.Score DESC) as UserPostRank
  FROM PostAnalytics pa
  WHERE pa.PostTypeId = 1
),
UserActivity AS (
  SELECT 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    u.Views,
    COUNT(p.Id) as PostCount,
    COUNT(c.Id) as CommentCount,
    COUNT(DISTINCT p.ParentId) as AnswerCount,
    COUNT(DISTINCT p.Id) as QuestionCount,
    AVG(COALESCE(p.Score, 0)) as AvgPostScore,
    MAX(p.CreationDate) as LastPostDate,
    MAX(u.LastAccessDate) as LastAccessDate,
    MAX(p.CreationDate) >= '2019-01-01' as IsActiveRecent,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) as QuestionCountRecent,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id ELSE NULL END) as AnswerCountRecent,
    SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) as QuestionScoreTotal,
    SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) as AnswerScoreTotal,
    COUNT(DISTINCT b.Id) as BadgeCount,
    STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ', ') as Tags
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId 
    AND p.CreationDate >= '2010-01-01'
  LEFT JOIN Comments c ON u.Id = c.UserId 
    AND c.CreationDate >= '2010-01-01'
  LEFT JOIN Badges b ON u.Id = b.UserId 
    AND b.Date >= '2010-01-01'
  WHERE u.CreationDate >= '2010-01-01'
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views
)
SELECT 
  'User Activity Analysis' as ReportType,
  COUNT(*) as TotalUsers,
  AVG(Reputation) as AvgReputation,
  AVG(views) as AvgViews,
  SUM(PostCount) as TotalPosts,
  SUM(CommentCount) as TotalComments,
  SUM(QuestionCount) as TotalQuestions,
  SUM(AnswerCount) as TotalAnswers,
  AVG(AvgPostScore) as AvgPostScore,
  COUNT(DISTINCT CASE WHEN IsActiveRecent = TRUE THEN UserId ELSE NULL END) as ActiveUsers,
  MAX(LastAccessDate) as MostRecentAccess,
  MIN(LastPostDate) as EarliestPost,
  STRING_AGG(DISTINCT DisplayName, ', ') as UserList
FROM UserActivity
WHERE Reputation > 1000
  AND LastAccessDate >= '2020-01-01'
  AND (QuestionCount > 0 OR AnswerCount > 0)

UNION ALL

SELECT 
  'Post Performance Analysis' as ReportType,
  COUNT(*) as TotalPosts,
  AVG(Score) as AvgScore,
  AVG(ViewCount) as AvgViews,
  SUM(CASE WHEN PostTypeId = 1 THEN 1 ELSE 0 END) as QuestionCount,
  SUM(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END) as AnswerCount,
  AVG(TagCount) as AvgTagCount,
  SUM(Score * TagCount) as ScoreTagProductSum,
  AVG(DaysOld) as AvgAgeDays,
  MAX(CreationDate) as MostRecentPost,
  MIN(CreationDate) as EarliestPost,
  STRING_AGG(Title, '; ') as TopTitles
FROM PostAnalytics
WHERE Score >= 50
  AND DaysOld <= 365
  AND Length(Body) > 100

UNION ALL

SELECT 
  'Top Questions Summary' as ReportType,
  COUNT(*) as TotalQuestions,
  AVG(Score) as AvgScore,
  AVG(ViewCount) as AvgViews,
  AVG(TagCount) as AvgTagCount,
  SUM(TagScoreProduct) as TotalTagScoreProduct,
  AVG(DaysOld) as AvgAgeDays,
  MAX(Score) as MaxScore,
  MIN(Score) as MinScore,
  STRING_AGG(Title, ', ') as TopQuestionTitles
FROM TopQuestions
WHERE RankByScoreAndView <= 100
  AND Score > 20
  AND DaysOld <= 180

UNION ALL

SELECT 
  'Community Engagement' as ReportType,
  COUNT(*) as UniqueTagCount,
  AVG(Reputation) as AvgReputation,
  AVG(views) as AvgViews,
  SUM(TotalScore) as TotalCommunityScore,
  AVG(Comments) as AvgComments,
  AVG(Answers) as AvgAnswers,
  AVG(Questions) as AvgQuestions,
  AVG(Badges) as AvgBadges,
  MAX(LastAccessDate) as MaxLastAccess,
  MIN(FirstPostDate) as MinFirstPost,
  CONCAT('Users with ', MIN(COUNT(DISTINCT TagId)), '+ tags') as TagEngagementMetric
FROM (
  SELECT 
    u.Id as UserId,
    u.Reputation,
    u.Views,
    SUM(COALESCE(p.Score, 0)) as TotalScore,
    COUNT(DISTINCT c.Id) as Comments,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id ELSE NULL END) as Answers,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) as Questions,
    COUNT(DISTINCT b.Id) as Badges,
    MAX(u.LastAccessDate) as LastAccessDate,
    MIN(p.CreationDate) as FirstPostDate,
    STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ',') as TagList,
    ARRAY_LENGTH(string_to_array(STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ','), ','), 1) as TagCount
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId AND p.CreationDate >= '2010-01-01'
  LEFT JOIN Comments c ON u.Id = c.UserId AND c.CreationDate >= '2010-01-01'
  LEFT JOIN Badges b ON u.Id = b.UserId AND b.Date >= '2010-01-01'
  WHERE u.CreationDate >= '2010-01-01'
    AND u.Reputation >= 100
  GROUP BY u.Id, u.Reputation, u.Views
  HAVING ARRAY_LENGTH(string_to_array(STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), ','), ','), 1) >= 2
) grouped_users;