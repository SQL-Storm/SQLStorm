-- {"query": "233.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 4837} 
with
-- Anchor users with activity and derive engagement metrics
active_users as (
  select
    u.id as user_id,
    u.displayname,
    u.reputation,
    u.creationdate,
    u.location,
    coalesce(nullif(trim(split_part(coalesce(u.websiteurl, ''), '/', 3)), ''), 'n/a') as website_host,
    date_part('year', age(cast('2024-10-01 12:34:56' as timestamp), u.creationdate))::int as account_age_years,
    u.upvotes,
    u.downvotes,
    (u.upvotes - u.downvotes) as net_votes,
    row_number() over (order by u.reputation desc, u.id) as rn_rep
  from users u
  where u.reputation > 0
),
-- Posts authored by these users with post categorization
user_posts as (
  select
    p.id as post_id,
    p.owneruserid as user_id,
    p.posttypeid,
    p.creationdate,
    p.score,
    p.viewcount,
    p.answercount,
    p.commentcount,
    p.favoritecount,
    p.title,
    p.tags,
    p.closeddate,
    p.acceptedanswerid,
    case when p.posttypeid = 1 then 'Question'
         when p.posttypeid = 2 then 'Answer'
         else 'Other' end as post_type_name
  from posts p
  where p.owneruserid in (select user_id from active_users)
),
-- Capture tag array and tag count for questions
question_tags as (
  select
    up.post_id,
    string_to_array(substring(up.tags, 2, greatest(length(up.tags)-2,0)), '><') as tag_arr,
    coalesce(array_length(string_to_array(substring(up.tags, 2, greatest(length(up.tags)-2,0)), '><'), 1), 0) as tag_count
  from user_posts up
  where up.posttypeid = 1
),
-- Votes aggregation per post
post_votes as (
  select
    v.postid as post_id,
    sum(case when v.votetypeid = 2 then 1 else 0 end) as upvote_cnt,
    sum(case when v.votetypeid = 3 then 1 else 0 end) as downvote_cnt,
    sum(case when v.votetypeid = 5 then 1 else 0 end) as favorite_cnt,
    sum(case when v.votetypeid = 8 then coalesce(v.bountyamount,0) else 0 end) as bounty_started,
    sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded,
    min(v.creationdate) as first_vote_at,
    max(v.creationdate) as last_vote_at,
    count(*) as total_votes
  from votes v
  group by v.postid
),
-- Comments aggregation per post
post_comments as (
  select
    c.postid as post_id,
    count(*) as comment_cnt,
    sum(c.score) as comment_score_sum,
    max(c.creationdate) as last_comment_at
  from comments c
  group by c.postid
),
-- Link relationships (duplicates and linked)
post_links_agg as (
  select
    pl.postid as post_id,
    sum(case when pl.linktypeid = 3 then 1 else 0 end) as duplicate_links,
    sum(case when pl.linktypeid = 1 then 1 else 0 end) as related_links,
    count(*) as total_links,
    max(pl.creationdate) as last_link_at
  from postlinks pl
  group by pl.postid
),
-- Close/ reopen history per post
post_closure as (
  select
    ph.postid as post_id,
    sum(case when ph.posthistorytypeid = 10 then 1 else 0 end) as close_events,
    sum(case when ph.posthistorytypeid = 11 then 1 else 0 end) as reopen_events,
    max(case when ph.posthistorytypeid = 10 then ph.creationdate end) as last_closed_at,
    max(case when ph.posthistorytypeid = 11 then ph.creationdate end) as last_reopened_at,
    -- extract last close reason id if stored in Comment field
    max(case when ph.posthistorytypeid = 10 then nullif(ph.comment,'') end) as last_close_reason_raw
  from posthistory ph
  where ph.posthistorytypeid in (10,11)
  group by ph.postid
),
-- Accepted answer relation and answer latency
accepted_answer as (
  select
    q.id as question_id,
    q.acceptedanswerid as accepted_answer_id,
    a.owneruserid as answer_owner_id,
    a.creationdate as answer_created_at,
    q.creationdate as question_created_at,
    extract(epoch from (a.creationdate - q.creationdate))::bigint as accept_latency_seconds
  from posts q
  join posts a on a.id = q.acceptedanswerid
  where q.posttypeid = 1
    and q.acceptedanswerid is not null
),
-- Window metrics per user: rolling post stats
user_post_metrics as (
  select
    up.user_id,
    up.post_id,
    up.post_type_name,
    up.creationdate,
    coalesce(up.score,0) as score,
    coalesce(up.viewcount,0) as views,
    sum(coalesce(up.score,0)) over (partition by up.user_id order by up.creationdate rows between unbounded preceding and current row) as cum_score,
    avg(coalesce(up.score,0)) over (partition by up.user_id) as avg_score_user,
    rank() over (partition by up.user_id order by coalesce(up.score,0) desc nulls last, up.creationdate) as score_rank_within_user
  from user_posts up
),
-- Per-tag popularity for user's questions
user_tag_stats as (
  select
    up.user_id,
    unnest(qt.tag_arr) as tag_name,
    count(*) as q_cnt,
    avg(coalesce(up.score,0)) as avg_q_score,
    sum(coalesce(up.viewcount,0)) as sum_q_views
  from user_posts up
  join question_tags qt on qt.post_id = up.post_id
  where up.posttypeid = 1
  group by up.user_id, unnest(qt.tag_arr)
),
-- Top tag per user by weighted formula
user_top_tag as (
  select distinct on (user_id)
    user_id,
    tag_name,
    q_cnt,
    avg_q_score,
    sum_q_views,
    (q_cnt * 1.0 + coalesce(avg_q_score,0) * 0.5 + ln(greatest(sum_q_views,1))::numeric) as tag_weight
  from user_tag_stats
  order by user_id, tag_weight desc nulls last, tag_name
),
-- Rank users by composite engagement score
user_engagement as (
  select
    au.user_id,
    au.displayname,
    au.reputation,
    au.account_age_years,
    coalesce(sum(case when up.posttypeid = 1 then 1 else 0 end),0) as questions_authored,
    coalesce(sum(case when up.posttypeid = 2 then 1 else 0 end),0) as answers_authored,
    coalesce(sum(up.score),0) as posts_score_sum,
    coalesce(sum(up.viewcount),0) as posts_views_sum,
    coalesce(avg(nullif(up.score,0)),0) as avg_nonzero_post_score,
    max(up.creationdate) as last_post_at,
    max(pc.comment_cnt) as max_comments_on_post,
    sum(coalesce(pv.total_votes,0)) as total_votes_on_posts,
    sum(coalesce(pv.upvote_cnt,0)) as upvotes_on_posts,
    sum(coalesce(pv.downvote_cnt,0)) as downvotes_on_posts,
    sum(coalesce(pv.favorite_cnt,0)) as favorites_on_posts,
    sum(coalesce(pv.bounty_started,0)) as bounty_started_sum,
    sum(coalesce(pv.bounty_awarded,0)) as bounty_awarded_sum
  from active_users au
  left join user_posts up on up.user_id = au.user_id
  left join post_votes pv on pv.post_id = up.post_id
  left join post_comments pc on pc.post_id = up.post_id
  group by au.user_id, au.displayname, au.reputation, au.account_age_years
),
-- Compute per-user ranks and dense ranks
user_engagement_ranked as (
  select
    ue.*,
    coalesce(answers_authored,0) + coalesce(questions_authored,0) as total_posts_authored,
    (coalesce(posts_score_sum,0) + coalesce(upvotes_on_posts,0) - coalesce(downvotes_on_posts,0))::numeric /
      nullif(greatest(coalesce(answers_authored,0) + coalesce(questions_authored,0), 1),0) as score_per_post,
    dense_rank() over (order by coalesce(posts_views_sum,0) desc, coalesce(posts_score_sum,0) desc) as dr_views_score,
    dense_rank() over (order by coalesce(bounty_awarded_sum,0) desc) as dr_bounty,
    row_number() over (order by coalesce(total_votes_on_posts,0) desc, user_id) as rn_votes
  from user_engagement ue
),
-- Badge stats per user
user_badges as (
  select
    b.userid as user_id,
    sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
    sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
    sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
    sum(case when b.tagbased = 1 then 1 else 0 end) as tag_badges,
    min(b.date) as first_badge_at,
    max(b.date) as last_badge_at,
    count(*) as total_badges
  from badges b
  group by b.userid
),
-- Find first and latest activity dates per user across posts, comments, votes
user_activity_span as (
  select
    u.id as user_id,
    least(
      coalesce(min(p.creationdate), cast('2024-10-01 12:34:56' as timestamp)),
      coalesce((select min(c.creationdate) from comments c where c.userid = u.id), cast('2024-10-01 12:34:56' as timestamp)),
      coalesce((select min(v.creationdate) from votes v where v.userid = u.id), cast('2024-10-01 12:34:56' as timestamp))
    ) as first_activity_at,
    greatest(
      coalesce(max(p.lastactivitydate), timestamp 'epoch'),
      coalesce((select max(c.creationdate) from comments c where c.userid = u.id), timestamp 'epoch'),
      coalesce((select max(v.creationdate) from votes v where v.userid = u.id), timestamp 'epoch')
    ) as last_activity_any_at
  from users u
  left join posts p on p.owneruserid = u.id
  group by u.id
),
-- Bring everything together for final benchmark set
final_users as (
  select
    uer.user_id,
    uer.displayname,
    uer.reputation,
    uer.account_age_years,
    uer.questions_authored,
    uer.answers_authored,
    uer.total_posts_authored,
    uer.posts_score_sum,
    uer.posts_views_sum,
    uer.avg_nonzero_post_score,
    uer.score_per_post,
    uer.dr_views_score,
    uer.dr_bounty,
    uer.rn_votes,
    coalesce(ub.gold_badges,0) as gold_badges,
    coalesce(ub.silver_badges,0) as silver_badges,
    coalesce(ub.bronze_badges,0) as bronze_badges,
    coalesce(ub.tag_badges,0) as tag_badges,
    coalesce(ub.total_badges,0) as total_badges,
    ub.first_badge_at,
    ub.last_badge_at,
    uas.first_activity_at,
    uas.last_activity_any_at,
    utt.tag_name as top_tag,
    utt.tag_weight as top_tag_weight
  from user_engagement_ranked uer
  left join user_badges ub on ub.user_id = uer.user_id
  left join user_activity_span uas on uas.user_id = uer.user_id
  left join user_top_tag utt on utt.user_id = uer.user_id
),
-- Correlated subquery: determine a user's highest scoring post title and id
user_best_post as (
  select
    up.user_id,
    (select p2.id
     from posts p2
     where p2.owneruserid = up.user_id
     order by p2.score desc nulls last, p2.viewcount desc nulls last, p2.id
     limit 1) as best_post_id,
    (select p2.title
     from posts p2
     where p2.owneruserid = up.user_id and p2.posttypeid = 1
     order by p2.score desc nulls last, p2.viewcount desc nulls last, p2.id
     limit 1) as best_question_title
  from (select distinct user_id from user_posts) up
),
-- For each question, compute time to first vote and comment
question_engagement as (
  select
    q.id as question_id,
    q.owneruserid as user_id,
    q.creationdate as q_created_at,
    (select min(v.creationdate) from votes v where v.postid = q.id) as first_vote_at,
    (select min(c.creationdate) from comments c where c.postid = q.id) as first_comment_at,
    extract(epoch from (coalesce((select min(v.creationdate) from votes v where v.postid = q.id), q.creationdate) - q.creationdate))::bigint as secs_to_first_vote,
    extract(epoch from (coalesce((select min(c.creationdate) from comments c where c.postid = q.id), q.creationdate) - q.creationdate))::bigint as secs_to_first_comment
  from posts q
  where q.posttypeid = 1
),
-- Summarize question responsiveness per user
user_q_response as (
  select
    qe.user_id,
    avg(nullif(qe.secs_to_first_vote,0)) as avg_secs_to_first_vote,
    percentile_cont(0.5) within group (order by qe.secs_to_first_vote) as p50_secs_to_first_vote,
    avg(nullif(qe.secs_to_first_comment,0)) as avg_secs_to_first_comment,
    percentile_cont(0.5) within group (order by qe.secs_to_first_comment) as p50_secs_to_first_comment
  from question_engagement qe
  group by qe.user_id
),
-- Normalize close reason id to text via CloseReasonTypes if possible
close_reason_lookup as (
  select
    crt.id::varchar as close_reason_id,
    crt.name as close_reason_name
  from closereasontypes crt
),
-- Per-user rate of closures on questions
user_closure_stats as (
  select
    up.user_id,
    count(*) filter (where pc.close_events > 0) as closed_questions,
    count(*) filter (where up.posttypeid = 1) as total_questions,
    sum(pc.close_events) as total_close_events,
    sum(pc.reopen_events) as total_reopen_events,
    max(pc.last_closed_at) as last_closed_at,
    max(pc.last_reopened_at) as last_reopened_at,
    max(coalesce(crt.close_reason_name, 'Unknown')) as last_close_reason_name
  from user_posts up
  left join post_closure pc on pc.post_id = up.post_id
  left join lateral (
    select crl.close_reason_name
    from close_reason_lookup crl
    where crl.close_reason_id = coalesce(pc.last_close_reason_raw, '')
    limit 1
  ) crt on true
  where up.posttypeid = 1
  group by up.user_id
),
-- Combine per-post aggregates for final selection set
post_agg as (
  select
    up.post_id,
    up.user_id,
    coalesce(pv.upvote_cnt,0) as upvote_cnt,
    coalesce(pv.downvote_cnt,0) as downvote_cnt,
    coalesce(pc.comment_cnt,0) as comment_cnt,
    coalesce(pl.total_links,0) as link_cnt,
    coalesce(pl.duplicate_links,0) as duplicate_links,
    coalesce(qt.tag_count,0) as tag_count
  from user_posts up
  left join post_votes pv on pv.post_id = up.post_id
  left join post_comments pc on pc.post_id = up.post_id
  left join post_links_agg pl on pl.post_id = up.post_id
  left join question_tags qt on qt.post_id = up.post_id
),
-- Compute z-score like normalization per user for posts' upvotes
post_scores_norm as (
  select
    pa.*,
    avg(upvote_cnt) over (partition by user_id) as avg_upvotes_user,
    stddev_pop(upvote_cnt) over (partition by user_id) as std_upvotes_user,
    case
      when stddev_pop(upvote_cnt) over (partition by user_id) > 0
        then (upvote_cnt - avg(upvote_cnt) over (partition by user_id)) / nullif(stddev_pop(upvote_cnt) over (partition by user_id),0)
      else null end as upvote_z
  from post_agg pa
),
-- Filter to a challenging subset using complex predicates
candidate_users as (
  select
    fu.*,
    ubp.best_post_id,
    ubp.best_question_title,
    coalesce(uqr.avg_secs_to_first_vote, 0) as avg_secs_to_first_vote,
    coalesce(uqr.avg_secs_to_first_comment, 0) as avg_secs_to_first_comment,
    coalesce(ucs.closed_questions,0) as closed_questions,
    coalesce(ucs.total_questions,0) as total_questions,
    coalesce(ucs.last_close_reason_name, 'Unknown') as last_close_reason_name
  from final_users fu
  left join user_best_post ubp on ubp.user_id = fu.user_id
  left join user_q_response uqr on uqr.user_id = fu.user_id
  left join user_closure_stats ucs on ucs.user_id = fu.user_id
  where
    fu.total_posts_authored >= 5
    and (fu.posts_views_sum > 1000 or fu.posts_score_sum > 50)
    and (fu.gold_badges + fu.silver_badges + fu.bronze_badges) >= 1
),
-- For each candidate, compute percentile ranks across candidates
candidate_rank as (
  select
    cu.*,
    percent_rank() over (order by cu.posts_views_sum) as pr_views,
    percent_rank() over (order by cu.posts_score_sum) as pr_scores,
    percent_rank() over (order by cu.score_per_post) as pr_score_per_post,
    percent_rank() over (order by cu.total_badges) as pr_badges,
    percent_rank() over (order by cu.avg_secs_to_first_vote asc nulls last) as pr_fast_vote,
    percent_rank() over (order by cu.avg_secs_to_first_comment asc nulls last) as pr_fast_comment
  from candidate_users cu
),
-- Assemble final benchmark rows with set operators joining with a different slice:
-- union distinct users who have accepted answers posted by others within 24h (fast acceptance)
fast_accept_users as (
  select
    distinct on (q.owneruserid) q.owneruserid as user_id
  from posts q
  join accepted_answer aa on aa.question_id = q.id
  where aa.accept_latency_seconds <= 86400
),
selected_users as (
  select user_id from candidate_rank
  union
  select user_id from fast_accept_users
),
-- Final selection joining back to richness
final as (
  select
    cr.user_id,
    cr.displayname,
    cr.reputation,
    cr.account_age_years,
    cr.total_posts_authored,
    cr.questions_authored,
    cr.answers_authored,
    cr.posts_views_sum,
    cr.posts_score_sum,
    cr.score_per_post,
    cr.total_badges,
    cr.gold_badges,
    cr.silver_badges,
    cr.bronze_badges,
    cr.tag_badges,
    cr.top_tag,
    cr.top_tag_weight,
    cr.avg_secs_to_first_vote,
    cr.avg_secs_to_first_comment,
    cr.closed_questions,
    cr.total_questions,
    cr.last_close_reason_name,
    cr.pr_views,
    cr.pr_scores,
    cr.pr_score_per_post,
    cr.pr_badges,
    cr.pr_fast_vote,
    cr.pr_fast_comment,
    ubp.best_post_id,
    ubp.best_question_title,
    uas.last_activity_any_at
  from candidate_rank cr
  join selected_users su on su.user_id = cr.user_id
  left join user_best_post ubp on ubp.user_id = cr.user_id
  left join user_activity_span uas on uas.user_id = cr.user_id
)
select
  f.*,
  -- computed labels and buckets
  case
    when f.score_per_post >= 10 then 'elite'
    when f.score_per_post >= 5 then 'high'
    when f.score_per_post >= 2 then 'medium'
    when f.score_per_post is null then 'unknown'
    else 'low'
  end as performance_bucket,
  case
    when f.top_tag is null then 'untagged'
    when length(f.top_tag) > 20 then 'longtag'
    else 'normaltag'
  end as top_tag_class,
  -- correlated scalar subquery: proportion of user's posts with more upvotes than downvotes and at least one comment
  (
    select coalesce(avg(case when pa.upvote_cnt > pa.downvote_cnt and pa.comment_cnt > 0 then 1.0 else 0.0 end),0.0)
    from post_scores_norm pa
    where pa.user_id = f.user_id
  ) as share_positive_discussed_posts
from final f
where
  -- complex predicate mixing null logic and expressions
  coalesce(f.posts_views_sum,0) + coalesce(f.posts_score_sum,0) > 500
  and (f.closed_questions::numeric / nullif(f.total_questions,0)) is distinct from 1.0
order by
  f.pr_scores desc nulls last,
  f.pr_views desc nulls last,
  f.user_id
limit 200;