-- {"query": "562.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 3398} 
with recent_users as (
    select
        u.id as user_id,
        u.displayname,
        u.reputation,
        u.creationdate,
        date_trunc('month', u.creationdate) as signup_month,
        coalesce(nullif(trim(u.location), ''), 'Unknown') as norm_location,
        count(b.id) filter (where b.class = 1) as gold_badges,
        count(b.id) filter (where b.class = 2) as silver_badges,
        count(b.id) filter (where b.class = 3) as bronze_badges,
        count(*) over (partition by date_trunc('month', u.creationdate)) as cohort_size
    from users u
    left join badges b
      on b.userid = u.id
      and b.date >= u.creationdate
    where u.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by u.id, u.displayname, u.reputation, u.creationdate, norm_location
),
question_activity as (
    select
        p.owneruserid as user_id,
        date_trunc('month', p.creationdate) as post_month,
        count(*) filter (where p.posttypeid = 1) as questions,
        sum(p.viewcount) filter (where p.posttypeid = 1) as question_views,
        avg(nullif(p.answercount, 0)) filter (where p.posttypeid = 1) as avg_answers_when_nonzero,
        count(*) filter (where p.posttypeid = 1 and p.closeddate is not null) as closed_questions,
        count(*) filter (where p.posttypeid = 1 and p.acceptedanswerid is not null) as accepted_questions,
        sum(case when p.posttypeid = 1 and p.tags is not null and position('python' in lower(p.tags)) > 0 then 1 else 0 end) as python_tagged_q
    from posts p
    where p.owneruserid is not null
      and p.owneruserid > 0
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
      and p.posttypeid in (1,2)
    group by p.owneruserid, date_trunc('month', p.creationdate)
),
answer_activity as (
    select
        p.owneruserid as user_id,
        date_trunc('month', p.creationdate) as post_month,
        count(*) filter (where p.posttypeid = 2) as answers,
        sum(p.score) filter (where p.posttypeid = 2) as answer_score,
        max(p.score) filter (where p.posttypeid = 2) as best_answer_score,
        count(distinct p.parentid) filter (where p.posttypeid = 2) as distinct_questions_answered
    from posts p
    where p.owneruserid is not null
      and p.owneruserid > 0
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
      and p.posttypeid in (1,2)
    group by p.owneruserid, date_trunc('month', p.creationdate)
),
votes_by_user_month as (
    select
        p.owneruserid as user_id,
        date_trunc('month', v.creationdate) as vote_month,
        count(*) filter (where v.votetypeid = 2) as upvotes,
        count(*) filter (where v.votetypeid = 3) as downvotes,
        count(*) filter (where v.votetypeid = 1) as accept_marks,
        sum(v.bountyamount) filter (where v.votetypeid in (8,9)) as bounty_amount_total
    from votes v
    join posts p
      on p.id = v.postid
    where p.owneruserid is not null
      and p.owneruserid > 0
      and v.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by p.owneruserid, date_trunc('month', v.creationdate)
),
comment_metrics as (
    select
        p.owneruserid as user_id,
        date_trunc('month', c.creationdate) as comment_month,
        count(*) as comments_on_user_posts,
        avg(c.score) as avg_comment_score,
        sum(case when c.text ilike '%thanks%' or c.text ilike '%thank you%' then 1 else 0 end) as gratitude_comments
    from comments c
    join posts p
      on p.id = c.postid
    where p.owneruserid is not null
      and p.owneruserid > 0
      and c.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by p.owneruserid, date_trunc('month', c.creationdate)
),
duplicate_links as (
    select
        pl.relatedpostid as canonical_post_id,
        count(*) as dup_count,
        min(pl.creationdate) as first_dup_date,
        max(pl.creationdate) as last_dup_date
    from postlinks pl
    where pl.linktypeid = 3
    group by pl.relatedpostid
),
post_quality as (
    select
        p.id as post_id,
        p.owneruserid as user_id,
        p.posttypeid,
        coalesce(p.score, 0) as score,
        coalesce(p.viewcount, 0) as views,
        coalesce(p.commentcount, 0) as comments,
        coalesce(p.favoritecount, 0) as favorites,
        date_trunc('month', p.creationdate) as post_month,
        row_number() over (partition by p.owneruserid order by p.score desc nulls last, p.viewcount desc nulls last, p.id) as rn_best_by_user,
        dense_rank() over (order by coalesce(p.score,0) + coalesce(p.viewcount,0)/50.0 + coalesce(p.favoritecount,0)*2 desc) as global_quality_rank
    from posts p
    where p.owneruserid is not null
      and p.owneruserid > 0
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
title_lengths as (
    select
        p.owneruserid as user_id,
        date_trunc('month', p.creationdate) as post_month,
        avg(length(coalesce(p.title, ''))) filter (where p.posttypeid = 1) as avg_title_len,
        percentile_disc(0.9) within group (order by length(coalesce(p.title, ''))) filter (where p.posttypeid = 1) as p90_title_len
    from posts p
    where p.owneruserid is not null
      and p.owneruserid > 0
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by p.owneruserid, date_trunc('month', p.creationdate)
),
edit_events as (
    select
        ph.postid,
        ph.userid as editor_user_id,
        date_trunc('month', ph.creationdate) as edit_month,
        count(*) filter (where ph.posthistorytypeid in (4,5,6,7,8,9,24)) as edit_count,
        count(*) filter (where ph.posthistorytypeid = 10) as close_events,
        count(*) filter (where ph.posthistorytypeid = 11) as reopen_events
    from posthistory ph
    where ph.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by ph.postid, ph.userid, date_trunc('month', ph.creationdate)
),
user_monthly as (
    select
        ru.user_id,
        ru.displayname,
        ru.reputation,
        ru.signup_month,
        ru.norm_location,
        ru.gold_badges,
        ru.silver_badges,
        ru.bronze_badges,
        ru.cohort_size,
        coalesce(qa.post_month, aa.post_month, vm.vote_month, cm.comment_month, tl.post_month) as activity_month,
        coalesce(qa.questions, 0) as questions,
        coalesce(qa.question_views, 0) as question_views,
        coalesce(qa.avg_answers_when_nonzero, 0) as avg_answers_when_nonzero,
        coalesce(qa.closed_questions, 0) as closed_questions,
        coalesce(qa.accepted_questions, 0) as accepted_questions,
        coalesce(qa.python_tagged_q, 0) as python_tagged_q,
        coalesce(aa.answers, 0) as answers,
        coalesce(aa.answer_score, 0) as answer_score,
        coalesce(aa.best_answer_score, 0) as best_answer_score,
        coalesce(aa.distinct_questions_answered, 0) as distinct_questions_answered,
        coalesce(vm.upvotes, 0) as upvotes,
        coalesce(vm.downvotes, 0) as downvotes,
        coalesce(vm.accept_marks, 0) as accept_marks,
        coalesce(vm.bounty_amount_total, 0) as bounty_amount_total,
        coalesce(cm.comments_on_user_posts, 0) as comments_on_user_posts,
        coalesce(cm.avg_comment_score, 0) as avg_comment_score,
        coalesce(cm.gratitude_comments, 0) as gratitude_comments,
        coalesce(tl.avg_title_len, 0) as avg_title_len,
        coalesce(tl.p90_title_len, 0) as p90_title_len
    from recent_users ru
    left join question_activity qa
      on qa.user_id = ru.user_id
    full outer join answer_activity aa
      on aa.user_id = ru.user_id
      and aa.post_month = qa.post_month
    full outer join votes_by_user_month vm
      on vm.user_id = ru.user_id
      and vm.vote_month = coalesce(qa.post_month, aa.post_month)
    full outer join comment_metrics cm
      on cm.user_id = ru.user_id
      and cm.comment_month = coalesce(qa.post_month, aa.post_month, vm.vote_month)
    left join title_lengths tl
      on tl.user_id = ru.user_id
      and tl.post_month = coalesce(qa.post_month, aa.post_month, vm.vote_month, cm.comment_month)
),
user_monthly_enriched as (
    select
        um.*,
        case
            when um.upvotes + um.downvotes = 0 then null
            else um.upvotes::decimal / nullif(um.upvotes + um.downvotes, 0)
        end as upvote_ratio,
        case
            when um.questions + um.answers = 0 then 0
            else (um.answer_score + um.accept_marks*15 + um.questions*1 + um.answers*2 + um.bounty_amount_total/50.0)
        end as engagement_score,
        sum(um.answers) over (partition by um.user_id order by um.activity_month rows between unbounded preceding and current row) as cum_answers,
        sum(um.questions) over (partition by um.user_id order by um.activity_month rows between unbounded preceding and current row) as cum_questions,
        avg(um.answer_score) over (partition by um.user_id order by um.activity_month rows between 2 preceding and current row) as rolling3_answer_score,
        lag(um.answers) over (partition by um.user_id order by um.activity_month) as prev_answers,
        lead(um.answers) over (partition by um.user_id order by um.activity_month) as next_answers
    from user_monthly um
),
best_posts_per_user as (
    select
        pq.user_id,
        pq.post_id,
        pq.posttypeid,
        pq.score,
        pq.views,
        pq.favorites,
        pq.post_month,
        pq.rn_best_by_user
    from post_quality pq
    where pq.rn_best_by_user <= 3
),
dup_impact as (
    select
        p.owneruserid as user_id,
        count(*) as dup_canonical_count,
        sum(dl.dup_count) as dup_inbound_total
    from duplicate_links dl
    join posts p on p.id = dl.canonical_post_id
    group by p.owneruserid
),
final_agg as (
    select
        ume.user_id,
        min(ume.signup_month) as signup_month,
        max(ume.activity_month) as last_activity_month,
        max(ume.displayname) keep (dense_rank last order by ume.activity_month) as last_displayname -- for Oracle; fallback for Postgres below
    from user_monthly_enriched ume
    group by ume.user_id
),
final_agg_pg as (
    select
        ume.user_id,
        min(ume.signup_month) as signup_month,
        max(ume.activity_month) as last_activity_month,
        (array_agg(ume.displayname order by ume.activity_month desc))[1] as last_displayname
    from user_monthly_enriched ume
    group by ume.user_id
),
location_rank as (
    select
        norm_location,
        count(distinct user_id) as users_in_location,
        dense_rank() over (order by count(distinct user_id) desc, norm_location) as loc_rank
    from recent_users
    group by norm_location
)
select
    coalesce(fap.user_id, fpg.user_id) as user_id,
    coalesce(fap.signup_month, fpg.signup_month) as signup_month,
    coalesce(fap.last_activity_month, fpg.last_activity_month) as last_activity_month,
    coalesce(fap.last_displayname, fpg.last_displayname) as last_displayname,
    ru.reputation,
    ru.norm_location,
    lr.loc_rank,
    um.activity_month,
    um.questions,
    um.answers,
    um.answer_score,
    um.accept_marks,
    um.upvotes,
    um.downvotes,
    um.upvote_ratio,
    um.engagement_score,
    um.cum_questions,
    um.cum_answers,
    um.rolling3_answer_score,
    um.prev_answers,
    um.next_answers,
    um.python_tagged_q,
    um.closed_questions,
    um.accepted_questions,
    um.question_views,
    um.avg_title_len,
    um.p90_title_len,
    coalesce(di.dup_canonical_count, 0) as dup_canonical_posts,
    coalesce(di.dup_inbound_total, 0) as dup_inbound_total,
    bp.post_id as top_post_id,
    bp.posttypeid as top_post_type,
    bp.score as top_post_score,
    bp.views as top_post_views,
    bp.favorites as top_post_favorites
from final_agg fap
full outer join final_agg_pg fpg
  on fpg.user_id = fap.user_id
join recent_users ru
  on ru.user_id = coalesce(fap.user_id, fpg.user_id)
left join location_rank lr
  on lr.norm_location = ru.norm_location
left join user_monthly_enriched um
  on um.user_id = ru.user_id
left join dup_impact di
  on di.user_id = ru.user_id
left join best_posts_per_user bp
  on bp.user_id = ru.user_id
  and bp.rn_best_by_user = 1
where
  -- complicated predicate mixing null logic and expressions
  (
    (um.engagement_score > 10 and coalesce(um.upvote_ratio, 0) >= 0.6)
    or (um.answers >= 5 and um.answer_score >= 10)
    or (um.questions >= 3 and um.accepted_questions >= 1)
  )
  and not (
    ru.norm_location ilike any (array['%test%', '%dummy%', '%null%'])
    or ru.displayname ilike '%bot%'
  )
  and (coalesce(um.downvotes, 0) = 0 or um.downvotes <= um.upvotes)
  and (bp.post_id is null or bp.score >= 0 or (bp.views > 1000 and bp.favorites > 0))
order by
  um.engagement_score desc nulls last,
  um.upvote_ratio desc nulls last,
  um.answers desc nulls last,
  um.questions desc nulls last,
  coalesce(bp.score, -999999) desc nulls last
limit 500;