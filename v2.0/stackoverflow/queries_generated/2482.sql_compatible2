with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        b.Name as BadgeName,
        b.Class as BadgeClass,
        row_number() over (partition by u.Id order by b.Date) as BadgeRank,
        count(*) over (partition by u.Id) as TotalBadges
    from Users u
    left join Badges b on u.Id = b.UserId
    where u.Reputation > 1000
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount as QuestionViews,
        q.Tags,
        a.Id as AnswerId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreation,
        a.OwnerUserId as AnswerOwner,
        coalesce(
            (select sum(case when v.VoteTypeId = cast(2 as smallint) then 1 else 0 end) from Votes v where v.PostId = a.Id),
            0
        ) as AnswerUpVotes,
        coalesce(
            (select sum(case when v.VoteTypeId = cast(3 as smallint) then 1 else 0 end) from Votes v where v.PostId = a.Id),
            0
        ) as AnswerDownVotes,
        case when q.AcceptedAnswerId = a.Id then 1 else 0 end as IsAccepted
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
),
UserActivity as (
    select
        u.Id,
        u.DisplayName,
        count(distinct p.Id) filter (where p.PostTypeId = 1) as QuestionsAsked,
        count(distinct p.Id) filter (where p.PostTypeId = 2) as AnswersProvided,
        count(distinct c.Id) as CommentsMade,
        max(p.CreationDate) as LastPostDate,
        max(c.CreationDate) as LastCommentDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName
),
DuplicateLinksCTE as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate,
        lt.Name as LinkTypeName,
        p1.Title as PostTitle,
        p2.Title as RelatedPostTitle
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    join Posts p1 on p1.Id = pl.PostId
    join Posts p2 on p2.Id = pl.RelatedPostId
    where lt.Name = 'Duplicate'
),
FilteredPosts as (
    select
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.CreationDate desc) as RankByUserScore
    from Posts p
    where p.PostTypeId in (1, 2) and p.Score >= 5 and p.Tags is not null
),
TopRankedPosts as (
    select *
    from FilteredPosts
    where RankByUserScore <= 3
),
CTE_Combined as (
    select
        ru.UserId,
        ru.DisplayName,
        ru.Reputation,
        ru.BadgeName,
        ru.BadgeClass,
        ru.BadgeRank,
        ru.TotalBadges,
        qas.QuestionId,
        qas.Title as QuestionTitle,
        qas.QuestionScore,
        qas.QuestionViews,
        qas.Tags as QuestionTags,
        qas.AnswerId,
        qas.AnswerScore,
        qas.AnswerUpVotes,
        qas.AnswerDownVotes,
        qas.IsAccepted
    from RecursiveUserBadges ru
    left join QuestionAnswerStats qas on qas.AnswerOwner = ru.UserId
    where ru.BadgeRank <= 5
)
select
    c.UserId,
    c.DisplayName,
    c.Reputation,
    string_agg(c.BadgeName || ' (' || case c.BadgeClass when 1 then 'Gold' when 2 then 'Silver' else 'Bronze' end || ')', ', ' ORDER BY c.BadgeClass, c.BadgeName) as Badges,
    count(distinct c.QuestionId) as QuestionsWithAnswers,
    count(distinct c.AnswerId) filter (where c.IsAccepted = 1) as AcceptedAnswersCount,
    avg(c.QuestionScore) as AvgQuestionScore,
    avg(c.AnswerScore) as AvgAnswerScore,
    (
        select string_agg(tag, ', ' ORDER BY cnt desc)
        from (
            select tag, count(*) as cnt 
            from (
                select unnest(string_to_array(substring(c.QuestionTags from 2 for char_length(c.QuestionTags)-2), '><')) as tag
            ) tags
            group by tag
            order by cnt desc
            limit 3
        ) topTags
    ) as Top3Tags,
    row_number() over (partition by c.UserId order by c.QuestionScore desc NULLS LAST, c.AnswerScore desc NULLS LAST) as AnswerRank,
    case when c.AnswerScore > c.QuestionScore then 'AnswerBetter' else 'QuestionBetterOrEqual' end as QualityComparison
from CTE_Combined c
where c.Reputation > 2000
group by c.UserId, c.DisplayName, c.Reputation, c.BadgeClass, c.BadgeName, c.QuestionScore, c.AnswerScore, c.QuestionTags, c.IsAccepted, c.QuestionId, c.AnswerId
order by AvgAnswerScore desc NULLS LAST, AvgQuestionScore desc NULLS LAST
union
select
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    'No badges' as Badges,
    0 as QuestionsWithAnswers,
    0 as AcceptedAnswersCount,
    cast(null as double precision) as AvgQuestionScore,
    cast(null as double precision) as AvgAnswerScore,
    null as Top3Tags,
    null as AnswerRank,
    null as QualityComparison
from Users u
where u.Reputation > 5000
and not exists (select 1 from Badges b where b.UserId = u.Id)
order by AvgAnswerScore desc NULLS LAST, AvgQuestionScore desc NULLS LAST
limit 10;