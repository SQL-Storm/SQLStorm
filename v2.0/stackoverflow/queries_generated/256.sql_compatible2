with recursive tag_hierarchy as (
    select
        t.Id as TagId,
        t.TagName::text as TagName,
        t.TagName::text as RootTag,
        0 as depth
    from Tags t
    where t.IsModeratorOnly = false or t.IsModeratorOnly is null

    union all

    select
        th.TagId,
        th.TagName,
        case
            when position('/' in th.RootTag) > 0 then split_part(th.RootTag, '/', 1)
            else th.RootTag
        end,
        th.depth + 1
    from tag_hierarchy th
    where th.depth < 2
),
question_base as (
    select
        p.Id,
        p.OwnerUserId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        coalesce(p.AnswerCount, 0) as AnswerCount,
        p.Tags,
        case
            when p.ClosedDate is not null then 1 else 0
        end as IsClosed,
        string_to_array(substring(p.Tags from 2 for length(p.Tags)-2), '><') as tag_arr
    from Posts p
    where p.PostTypeId = 1
),
question_tags as (
    select
        qb.Id as QuestionId,
        lower(trim(t)) as TagName
    from question_base qb,
         unnest(qb.tag_arr) as t
),
tagged_questions as (
    select
        qt.QuestionId,
        qt.TagName,
        qb.OwnerUserId,
        qb.CreationDate,
        qb.Score,
        qb.ViewCount,
        qb.AnswerCount,
        qb.IsClosed
    from question_tags qt
    join question_base qb on qb.Id = qt.QuestionId
),
user_activity as (
    select
        u.Id as UserId,
        u.Reputation,
        u.CreationDate as UserCreationDate,
        u.UpVotes,
        u.DownVotes,
        u.Views as ProfileViews,
        case when nullif(trim(u.Location), '') is null then 'Unknown' else u.Location end as LocationNorm,
        coalesce(nullif(trim(u.WebsiteUrl), ''), 'n/a') as WebsiteUrlNorm
    from Users u
),
answers as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId as AnswerUserId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreationDate
    from Posts a
    where a.PostTypeId = 2
),
accepted as (
    select
        q.Id as QuestionId,
        q.AcceptedAnswerId
    from Posts q
    where q.PostTypeId = 1 and q.AcceptedAnswerId is not null
),
votes_agg as (
    select
        v.PostId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as Favorites,
        sum(case when v.VoteTypeId = 8 then coalesce(v.BountyAmount,0) else 0 end) as BountyStart,
        sum(case when v.VoteTypeId = 9 then coalesce(v.BountyAmount,0) else 0 end) as BountyClose
    from Votes v
    group by v.PostId
),
link_dupes as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pl.CreationDate as LinkDate,
        lt.Name as LinkTypeName
    from PostLinks pl
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where pl.LinkTypeId in (1,3)
),
posthistory_closure as (
    select
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ph.Comment,
        ph.Text
    from PostHistory ph
    where ph.PostHistoryTypeId in (10,11,12,13,35,36,37,38)
),
close_reasons as (
    select
        ph.PostId,
        ph.CreationDate as CloseEventDate,
        cr.Name as CloseReasonName
    from posthistory_closure ph
    left join CloseReasonTypes cr
      on ph.PostHistoryTypeId = 10
     and cr.Id = nullif(trim(ph.Comment), '')
),
question_metrics as (
    select
        tq.QuestionId,
        tq.TagName,
        tq.OwnerUserId,
        ua.Reputation,
        tq.CreationDate,
        tq.Score,
        tq.ViewCount,
        tq.AnswerCount,
        tq.IsClosed,
        va.UpVotes as QUp,
        va.DownVotes as QDown,
        coalesce(va.Favorites,0) as QFavs,
        coalesce(va.BountyStart,0) as QBountyStart,
        coalesce(va.BountyClose,0) as QBountyClose,
        cr.CloseReasonName,
        min(ans.AnswerCreationDate) filter (where ans.AnswerId is not null) over (partition by tq.QuestionId) as FirstAnswerDate,
        count(ans.AnswerId) over (partition by tq.QuestionId) as TotalAnswers,
        sum(case when ans.AnswerId = acc.AcceptedAnswerId then 1 else 0 end) over (partition by tq.QuestionId) as HasAccepted,
        max(case when ld.PostId is not null and ld.LinkTypeName = 'Duplicate' then 1 else 0 end) over (partition by tq.QuestionId) as IsDuplicateLinked
    from tagged_questions tq
    left join user_activity ua on ua.UserId = tq.OwnerUserId
    left join votes_agg va on va.PostId = tq.QuestionId
    left join answers ans on ans.QuestionId = tq.QuestionId
    left join accepted acc on acc.QuestionId = tq.QuestionId
    left join link_dupes ld on ld.PostId = tq.QuestionId and ld.LinkTypeName = 'Duplicate'
    left join close_reasons cr on cr.PostId = tq.QuestionId
),
ranked_questions as (
    select
        qm.*,
        row_number() over (partition by qm.TagName order by qm.Score desc nulls last, qm.ViewCount desc nulls last, qm.CreationDate asc) as rn_score,
        row_number() over (partition by qm.TagName order by qm.ViewCount desc nulls last, qm.Score desc nulls last) as rn_views,
        percentile_disc(0.9) within group (order by coalesce(qm.ViewCount,0)) over (partition by qm.TagName) as p90_views,
        percentile_disc(0.9) within group (order by coalesce(qm.Score,0)) over (partition by qm.TagName) as p90_score
    from question_metrics qm
),
tag_rollups as (
    select
        rq.TagName,
        count(distinct rq.QuestionId) as Questions,
        sum(rq.QFavs) as Favorites,
        avg(coalesce(rq.Score,0)) as AvgScore,
        avg(coalesce(rq.ViewCount,0)) as AvgViews,
        sum(case when rq.HasAccepted > 0 then 1 else 0 end) as WithAccepted,
        sum(case when rq.IsClosed = 1 then 1 else 0 end) as ClosedCount,
        sum(case when rq.IsDuplicateLinked = 1 then 1 else 0 end) as DuplicateLinkedCount,
        count(distinct case when rq.CloseReasonName is not null then rq.QuestionId end) as ClosedWithReason
    from ranked_questions rq
    group by rq.TagName
),
user_rollups as (
    select
        rq.OwnerUserId,
        count(distinct rq.QuestionId) as QCount,
        avg(coalesce(rq.Score,0)) as AvgQScore,
        avg(coalesce(rq.ViewCount,0)) as AvgQViews,
        sum(case when rq.HasAccepted > 0 then 1 else 0 end) as AcceptedQs,
        max(rq.Reputation) as MaxReputation
    from ranked_questions rq
    group by rq.OwnerUserId
),
top_per_tag as (
    select
        rq.TagName,
        rq.QuestionId,
        rq.Score,
        rq.ViewCount,
        rq.Reputation,
        rq.OwnerUserId,
        rq.CloseReasonName,
        rq.p90_views,
        rq.p90_score
    from ranked_questions rq
    where rq.rn_score <= 5 or rq.rn_views <= 5
),
stringy as (
    select
        tpt.TagName,
        tpt.QuestionId,
        'Q' || cast(tpt.QuestionId as varchar)
            || ':' || coalesce(initcap(replace(tpt.CloseReasonName, '_', ' ')), 'Open')
            || ':' || lpad(coalesce(cast(tpt.Score as varchar),'0'), 3, '0')
            || ':' || case when tpt.ViewCount >= tpt.p90_views then 'HOT' else 'COLD' end
            as Descriptor
    from top_per_tag tpt
),
null_logic as (
    select
        s.*,
        case
            when s.Descriptor is null then 'UNKNOWN'
            when s.Descriptor like '%HOT' then 'ALERT'
            when s.Descriptor like '%COLD' then null
            else 'NORMAL'
        end as StatusFlag
    from stringy s
),
cte_union as (
    select TagName, QuestionId, Descriptor, StatusFlag from null_logic
    union
    select tr.TagName, cast(null as integer) as QuestionId, cast(null as varchar) as Descriptor, cast(null as varchar) as StatusFlag
    from tag_rollups tr
    where tr.Questions = 0
)
select
    th.RootTag as RootTagGroup,
    tr.TagName,
    tr.Questions,
    tr.Favorites,
    tr.AvgScore,
    tr.AvgViews,
    tr.WithAccepted,
    tr.ClosedCount,
    tr.DuplicateLinkedCount,
    tr.ClosedWithReason,
    ur.OwnerUserId,
    ur.QCount,
    ur.AvgQScore,
    ur.AvgQViews,
    ur.AcceptedQs,
    ur.MaxReputation,
    cu.QuestionId,
    cu.Descriptor,
    coalesce(cu.StatusFlag, 'NONE') as StatusFlag,
    case
        when tr.AvgViews > 0 then round(tr.AvgScore / nullif(tr.AvgViews,0), 6)
        else null
    end as ScorePerView,
    case
        when tr.Questions > 10 and tr.AvgViews > 1000 then 'MATURE'
        when tr.Questions > 5 then 'GROWING'
        else 'NICHE'
    end as Segment
from tag_rollups tr
left join tag_hierarchy th on lower(th.TagName) = lower(tr.TagName)
left join lateral (
    select
        ur.OwnerUserId,
        ur.QCount,
        ur.AvgQScore,
        ur.AvgQViews,
        ur.AcceptedQs,
        ur.MaxReputation
    from user_rollups ur
    where ur.QCount = (
        select max(ur2.QCount) from user_rollups ur2
    )
    order by ur.AvgQScore desc nulls last
    limit 1
) ur on true
left join cte_union cu on lower(cu.TagName) = lower(tr.TagName)
where (tr.AvgScore is not null or tr.AvgViews is not null)
order by
    RootTagGroup nulls last,
    tr.TagName,
    coalesce(ur.MaxReputation, 0) desc,
    coalesce(cu.QuestionId, 2147483647),
    coalesce(tr.Favorites, 0) desc;