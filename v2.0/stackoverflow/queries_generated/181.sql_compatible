with
-- Rank users by activity and reputation, and compute rolling metrics
user_activity as (
  select
    u.id as user_id,
    u.displayname,
    u.reputation,
    cast(u.creationdate as date) as user_since,
    coalesce(u.location, 'Unknown') as location,
    count(distinct p.id) filter (where p.posttypeid in (1,2)) as total_posts,
    count(distinct c.id) as total_comments,
    count(distinct b.id) as total_badges,
    sum(coalesce(p.score,0)) as sum_post_scores,
    sum(coalesce(c.score,0)) as sum_comment_scores,
    sum(coalesce(case when v.votetypeid=2 then 1 when v.votetypeid=3 then -1 else 0 end,0)) as net_votes_cast,
    greatest(u.lastaccessdate, max(coalesce(p.lastactivitydate, u.creationdate)) over (partition by u.id)) as last_seen_any,
    row_number() over (order by u.reputation desc, u.id) as rep_rank_global,
    dense_rank() over (partition by coalesce(nullif(trim(split_part(u.location, ',', 1)), ''), 'Unknown') order by u.reputation desc) as rep_rank_by_country
  from users u
  left join posts p on p.owneruserid = u.id
  left join comments c on c.userid = u.id
  left join votes v on v.userid = u.id
  left join badges b on b.userid = u.id
  group by u.id, u.displayname, u.reputation, u.creationdate, u.location, u.lastaccessdate
),
-- Identify question/answer pairs and engagement
qa as (
  select
    q.id as question_id,
    q.owneruserid as q_owner_id,
    cast(q.creationdate as date) as q_date,
    q.score as q_score,
    q.viewcount as q_views,
    q.title as q_title,
    q.tags as q_tags,
    a.id as answer_id,
    a.owneruserid as a_owner_id,
    a.score as a_score,
    a.creationdate as a_date,
    case when a.id = q.acceptedanswerid then 1 else 0 end as is_accepted,
    count(distinct cq.id) as q_comment_count,
    count(distinct ca.id) as a_comment_count
  from posts q
  left join posts a on a.parentid = q.id and a.posttypeid = 2
  left join comments cq on cq.postid = q.id
  left join comments ca on ca.postid = a.id
  where q.posttypeid = 1
  group by q.id, q.owneruserid, q.creationdate, q.score, q.viewcount, q.title, q.tags, a.id, a.owneruserid, a.score, a.creationdate, q.acceptedanswerid
),
-- Compute tag expansion from string field into normalized rows
question_tags as (
  select
    q.question_id,
    lower(trim(t)) as tag
  from qa q
  cross join lateral unnest(
    case
      when q.q_tags is null then array[]::varchar[]
      else string_to_array(substring(q.q_tags, 2, char_length(q.q_tags)-2), '><')
    end
  ) as t
),
-- Per-tag performance and difficulty metrics
tag_metrics as (
  select
    qt.tag,
    count(distinct qt.question_id) as questions,
    count(distinct qa.answer_id) as answers,
    sum(qa.is_accepted) as accepted_answers,
    avg(qa.q_score) as avg_q_score,
    avg(qa.a_score) filter (where qa.answer_id is not null) as avg_a_score,
    percentile_cont(0.5) within group (order by qa.q_views) as med_views,
    sum(qa.q_comment_count + qa.a_comment_count) as total_comments_in_threads
  from question_tags qt
  join qa on qa.question_id = qt.question_id
  group by qt.tag
),
-- Duplicate relationships and closure reasons
dupes_and_closures as (
  select
    q.id as question_id,
    max(case when pl.linktypeid = 3 then 1 else 0 end) as has_duplicate_link,
    max(case when ph.posthistorytypeid = 10 then 1 else 0 end) as was_closed,
    max(
      case
        when ph.posthistorytypeid = 10 and ph.comment ~ '^[0-9]+$'
        then cast(ph.comment as integer)
        else null
      end
    ) as close_reason_id
  from posts q
  left join postlinks pl on pl.postid = q.id and pl.linktypeid in (1,3)
  left join posthistory ph on ph.postid = q.id and ph.posthistorytypeid in (10)
  where q.posttypeid = 1
  group by q.id
),
-- Votes aggregation by post
post_votes as (
  select
    p.id as post_id,
    sum(case when v.votetypeid=2 then 1 when v.votetypeid=3 then -1 else 0 end) as net_votes,
    count(*) filter (where v.votetypeid=5) as favorites,
    sum(coalesce(v.bountyamount,0)) as bounty_total
  from posts p
  left join votes v on v.postid = p.id
  group by p.id
),
-- Windowed engagement per question across its answers
question_answer_stats as (
  select
    qa.question_id,
    count(*) filter (where qa.answer_id is not null) as answer_count,
    sum(qa.is_accepted) as accepted_count,
    max(qa.a_score) filter (where qa.answer_id is not null) as max_answer_score,
    avg(qa.a_score) filter (where qa.answer_id is not null) as avg_answer_score
  from qa
  group by qa.question_id
),
-- Users' temporal posting cadence and moving averages
user_post_tempo as (
  select
    p.owneruserid as user_id,
    date_trunc('month', p.creationdate) as month,
    count(*) as posts_in_month,
    sum(case when p.posttypeid=1 then 1 else 0 end) as questions_in_month,
    sum(case when p.posttypeid=2 then 1 else 0 end) as answers_in_month,
    avg(coalesce(p.score,0)) as avg_score_in_month,
    sum(coalesce(pv.net_votes,0)) as net_votes_in_month,
    sum(coalesce(pv.bounty_total,0)) as bounty_in_month
  from posts p
  left join post_votes pv on pv.post_id = p.id
  where p.owneruserid is not null
  group by p.owneruserid, date_trunc('month', p.creationdate)
),
user_tempo_enhanced as (
  select
    user_id,
    month,
    posts_in_month,
    questions_in_month,
    answers_in_month,
    avg_score_in_month,
    net_votes_in_month,
    bounty_in_month,
    sum(posts_in_month) over (partition by user_id order by month rows between 11 preceding and current row) as posts_rolling_12m,
    avg(avg_score_in_month) over (partition by user_id order by month rows between 5 preceding and current row) as avgscore_rolling_6m,
    sum(net_votes_in_month) over (partition by user_id order by month rows between unbounded preceding and current row) as net_votes_cum
  from user_post_tempo
),
-- CTE to densify month series per active user (last 24 months)
active_users as (
  select user_id
  from user_activity
  where total_posts >= 10 or reputation >= 1000
),
months as (
  select date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) - (interval '1 month' * g) as month
  from generate_series(0, 23) g
),
user_month_grid as (
  select au.user_id, m.month
  from active_users au
  cross join months m
),
user_tempo_filled as (
  select
    g.user_id,
    g.month,
    coalesce(te.posts_in_month, 0) as posts_in_month,
    coalesce(te.questions_in_month, 0) as questions_in_month,
    coalesce(te.answers_in_month, 0) as answers_in_month,
    coalesce(te.avg_score_in_month, 0) as avg_score_in_month,
    coalesce(te.net_votes_in_month, 0) as net_votes_in_month,
    coalesce(te.bounty_in_month, 0) as bounty_in_month
  from user_month_grid g
  left join user_post_tempo te on te.user_id = g.user_id and te.month = g.month
),
user_tempo_roll as (
  select
    user_id,
    month,
    posts_in_month,
    questions_in_month,
    answers_in_month,
    avg_score_in_month,
    net_votes_in_month,
    bounty_in_month,
    sum(posts_in_month) over (partition by user_id order by month rows between 11 preceding and current row) as posts_rolling_12m,
    avg(nullif(avg_score_in_month,0)) over (partition by user_id order by month rows between 5 preceding and current row) as avgscore_rolling_6m,
    sum(net_votes_in_month) over (partition by user_id order by month rows between unbounded preceding and current row) as net_votes_cum
  from user_tempo_filled
),
-- Synthesized user quality score combining activity, reputation, and engagement
user_quality as (
  select
    ua.user_id,
    ua.displayname,
    ua.location,
    ua.reputation,
    ua.total_posts,
    ua.total_comments,
    ua.total_badges,
    ua.sum_post_scores,
    ua.sum_comment_scores,
    ua.net_votes_cast,
    ua.rep_rank_global,
    ua.rep_rank_by_country,
    round(
      0.4 * ln(1 + ua.reputation)
      + 0.2 * ln(1 + coalesce(ua.total_posts,0))
      + 0.1 * ln(1 + coalesce(ua.total_badges,0))
      + 0.2 * greatest(0, coalesce(ur.posts_rolling_12m,0)) / nullif(12.0,0)
      + 0.1 * coalesce(ur.avgscore_rolling_6m, 0),
      4
    ) as quality_score,
    case
      when ua.reputation >= 20000 then 'legend'
      when ua.reputation >= 10000 then 'expert'
      when ua.reputation >= 2000 then 'advanced'
      when ua.reputation >= 200 then 'intermediate'
      else 'novice'
    end as tier
  from user_activity ua
  left join lateral (
    select
      posts_rolling_12m,
      avgscore_rolling_6m,
      month
    from user_tempo_roll utr
    where utr.user_id = ua.user_id
    order by month desc
    limit 1
  ) ur on true
),
-- Derive per-question composite difficulty using tags, duplicates, closures, votes
question_difficulty as (
  select
    q.id as question_id,
    left(coalesce(q.title,''), 120) as title_snippet,
    q.owneruserid as owner_id,
    cast(q.creationdate as date) as q_date,
    q.viewcount,
    q.score,
    coalesce(qas.answer_count,0) as answer_count,
    coalesce(qas.max_answer_score,0) as max_answer_score,
    coalesce(qas.avg_answer_score,0) as avg_answer_score,
    coalesce(dac.has_duplicate_link,0) as has_duplicate_link,
    coalesce(dac.was_closed,0) as was_closed,
    dac.close_reason_id,
    coalesce(pv.net_votes,0) as net_votes,
    coalesce(pv.favorites,0) as favorites,
    coalesce(pv.bounty_total,0) as bounty_total,
    round(
      0.35 * greatest(0, ln(1 + q.viewcount) - ln(1 + coalesce(qas.answer_count,0)))
      + 0.25 * (case when coalesce(qas.answer_count,0)=0 then 1 else 0 end)
      + 0.15 * (case when coalesce(dac.was_closed,0)=1 then 1 else 0 end)
      + 0.15 * (case when coalesce(dac.has_duplicate_link,0)=1 then 0.5 else 0 end)
      + 0.10 * (case when coalesce(pv.bounty_total,0) > 0 then 0.5 else 0 end)
    , 4) as difficulty_score
  from posts q
  left join question_answer_stats qas on qas.question_id = q.id
  left join dupes_and_closures dac on dac.question_id = q.id
  left join post_votes pv on pv.post_id = q.id
  where q.posttypeid = 1
),
-- Select top tags by engagement to join with questions
top_tags as (
  select tag, questions, answers, accepted_answers, avg_q_score, avg_a_score, med_views, total_comments_in_threads,
         row_number() over (order by questions desc, answers desc) as r
  from tag_metrics
),
-- Map questions to their top tag among top N tags
question_top_tag as (
  select distinct on (qt.question_id)
    qt.question_id,
    tt.tag,
    tt.questions,
    tt.answers,
    tt.accepted_answers
  from question_tags qt
  join top_tags tt on tt.tag = qt.tag
  where tt.r <= 200
  order by qt.question_id, tt.questions desc, tt.answers desc
),
-- Capture recent hot questions from PostHistory events
hot_questions as (
  select ph.postid as question_id,
    max(ph.creationdate) as last_hot_date
  from posthistory ph
  where ph.posthistorytypeid in (52)
  group by ph.postid
),
-- Bring it all together
final_agg as (
  select
    qd.question_id,
    qd.title_snippet,
    qd.q_date,
    qd.viewcount,
    qd.score,
    qd.answer_count,
    qd.avg_answer_score,
    qd.max_answer_score,
    qd.has_duplicate_link,
    qd.was_closed,
    qd.close_reason_id,
    qd.net_votes,
    qd.favorites,
    qd.bounty_total,
    qd.difficulty_score,
    qt.tag as primary_tag,
    tt.questions as tag_questions,
    tt.answers as tag_answers,
    uq.displayname as owner_name,
    uq.location as owner_location,
    uq.tier as owner_tier,
    uq.quality_score as owner_quality,
    hq.last_hot_date
  from question_difficulty qd
  left join question_top_tag qt on qt.question_id = qd.question_id
  left join top_tags tt on tt.tag = qt.tag
  left join users u on u.id = qd.owner_id
  left join user_quality uq on uq.user_id = u.id
  left join hot_questions hq on hq.question_id = qd.question_id
),
-- Rank questions by composite score and recency using window functions
ranked as (
  select
    f.question_id,
    f.title_snippet,
    f.q_date,
    f.viewcount,
    f.score,
    f.answer_count,
    f.avg_answer_score,
    f.max_answer_score,
    f.has_duplicate_link,
    f.was_closed,
    f.close_reason_id,
    f.net_votes,
    f.favorites,
    f.bounty_total,
    f.difficulty_score,
    f.primary_tag,
    f.tag_questions,
    f.tag_answers,
    f.owner_name,
    f.owner_location,
    f.owner_tier,
    f.owner_quality,
    f.last_hot_date,
    row_number() over (
      order by
        coalesce(f.last_hot_date, timestamp 'epoch') desc,
        f.difficulty_score desc,
        f.viewcount desc,
        f.score asc
    ) as global_rank,
    dense_rank() over (
      partition by coalesce(f.primary_tag, 'untagged')
      order by f.difficulty_score desc, f.viewcount desc
    ) as tag_rank
  from final_agg f
)
select *
from ranked
where global_rank <= 200
union all
select *
from ranked
where primary_tag is null and tag_rank <= 10
order by coalesce(primary_tag, 'zzzz_untagged') asc, global_rank asc, tag_rank asc;