    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL
FROM Users u
WHERE NOT EXISTS (SELECT 1 FROM HighScoringQuestions hq WHERE hq.OwnerUserId = u.Id)
AND u.Reputation > 100000;