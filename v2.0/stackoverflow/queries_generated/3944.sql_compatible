WITH
    top_reps AS (
        SELECT
            u.Id                                   AS user_id,
            u.DisplayName,
            u.Reputation,
            RANK() OVER (ORDER BY u.Reputation DESC) AS rep_rank
        FROM Users u
    ),
    user_posts AS (
        SELECT
            p.OwnerUserId                         AS user_id,
            COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS question_cnt,
            COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS answer_cnt,
            COALESCE(SUM(p.Score),0)               AS total_score,
            AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS avg_question_score,
            AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS avg_answer_score,
            MAX(p.CreationDate)                   AS last_post_date
        FROM Posts p
        WHERE p.OwnerUserId IS NOT NULL
        GROUP BY p.OwnerUserId
    ),
    user_badges AS (
        SELECT
            b.UserId                              AS user_id,
            COUNT(CASE WHEN b.Class = 1 THEN 1 END)   AS gold_cnt,
            COUNT(CASE WHEN b.Class = 2 THEN 1 END)   AS silver_cnt,
            COUNT(CASE WHEN b.Class = 3 THEN 1 END)   AS bronze_cnt,
            STRING_AGG(DISTINCT b.Name, ', ')     AS badge_list
        FROM Badges b
        GROUP BY b.UserId
    ),
    recent_votes AS (
        SELECT
            v.UserId                              AS voter_id,
            v.PostId,
            vt.Name                               AS vote_type,
            v.CreationDate                        AS vote_date,
            ROW_NUMBER() OVER (PARTITION BY v.UserId ORDER BY v.CreationDate DESC) AS rn
        FROM Votes v
        JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    ),
    user_tags AS (
        SELECT
            p.OwnerUserId                         AS user_id,
            COUNT(DISTINCT tag)                   AS distinct_tag_cnt,
            ARRAY_AGG(DISTINCT tag ORDER BY tag LIMIT 5) AS top_5_tags
        FROM (
            SELECT OwnerUserId,
                   TRIM(BOTH '<>' FROM COALESCE(Tags, '')) AS tagstr,
                   UNNEST(string_to_array(TRIM(BOTH '<>' FROM COALESCE(Tags, '')), '><')) AS tag
            FROM Posts
            WHERE PostTypeId = 1
              AND OwnerUserId IS NOT NULL
        ) t
        GROUP BY OwnerUserId
    ),
    badge_only_users AS (
        SELECT DISTINCT b.UserId AS user_id
        FROM Badges b
        LEFT JOIN Posts p ON p.OwnerUserId = b.UserId
        WHERE p.Id IS NULL
    )
SELECT
    tr.user_id,
    tr.DisplayName,
    tr.Reputation,
    tr.rep_rank,
    COALESCE(up.question_cnt,0)                AS questions_posted,
    COALESCE(up.answer_cnt,0)                  AS answers_posted,
    up.total_score,
    ROUND(CAST(up.avg_question_score AS numeric),2)   AS avg_q_score,
    ROUND(CAST(up.avg_answer_score AS numeric),2)     AS avg_a_score,
    up.last_post_date,
    ub.gold_cnt,
    ub.silver_cnt,
    ub.bronze_cnt,
    ub.badge_list,
    rv.vote_type                               AS last_vote_type,
    rv.vote_date                               AS last_vote_date,
    COALESCE(ut.distinct_tag_cnt,0)            AS distinct_tags_used,
    CASE
        WHEN ut.top_5_tags IS NOT NULL THEN array_to_string(ut.top_5_tags, ', ')
        ELSE NULL
    END                                        AS top_5_tags,
    CASE
        WHEN up.user_id IS NULL THEN 'Badge-only user'
        ELSE 'Active user'
    END                                        AS user_category
FROM top_reps tr
LEFT JOIN user_posts up            ON up.user_id = tr.user_id
LEFT JOIN user_badges ub           ON ub.user_id = tr.user_id
LEFT JOIN (
        SELECT voter_id, vote_type, vote_date
        FROM recent_votes
        WHERE rn = 1
     ) rv                           ON rv.voter_id = tr.user_id
LEFT JOIN user_tags ut            ON ut.user_id = tr.user_id
FULL OUTER JOIN badge_only_users bo ON bo.user_id = tr.user_id
WHERE tr.rep_rank <= 10
   OR bo.user_id IS NOT NULL
GROUP BY
    tr.user_id,
    tr.DisplayName,
    tr.Reputation,
    tr.rep_rank,
    up.question_cnt,
    up.answer_cnt,
    up.total_score,
    up.avg_question_score,
    up.avg_answer_score,
    up.last_post_date,
    ub.gold_cnt,
    ub.silver_cnt,
    ub.bronze_cnt,
    ub.badge_list,
    rv.vote_type,
    rv.vote_date,
    ut.distinct_tag_cnt,
    ut.top_5_tags,
    up.user_id,
    tr.DisplayName,
    bo.user_id
ORDER BY tr.rep_rank ASC,
         tr.Reputation DESC,
         tr.DisplayName;