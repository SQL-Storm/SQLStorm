WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.IsModeratorOnly,
        t.IsRequired,
        1 AS Level,
        CAST(ARRAY[t.TagName] AS text[]) AS Path
    FROM Tags t
    WHERE t.IsRequired = TRUE

    UNION ALL

    SELECT
        child.Id,
        child.TagName,
        child.Count,
        child.IsModeratorOnly,
        child.IsRequired,
        rh.Level + 1,
        rh.Path || child.TagName
    FROM Tags child
    JOIN Posts p ON p.Tags LIKE '%' || '<' || child.TagName || '>' || '%'
    JOIN RecursiveTagHierarchy rh ON rh.TagName = ANY(string_to_array(regexp_replace(p.Tags, '^<|>$', '', 'g'), '><'))
    WHERE child.IsRequired = TRUE
),
UserBadgeStats AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        COUNT(DISTINCT p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionsCount,
        COUNT(DISTINCT p2.Id) FILTER (WHERE p2.PostTypeId = 2) AS AnswersCount,
        AVG(COALESCE(p.Score,0)) FILTER (WHERE p.PostTypeId = 1) AS AvgQuestionScore,
        AVG(COALESCE(p2.Score,0)) FILTER (WHERE p2.PostTypeId = 2) AS AvgAnswerScore
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN Posts p2 ON p2.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
PostPopularity AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        p.Title,
        COALESCE(v.UpVotes, 0) AS UpVotes,
        COALESCE(v.DownVotes, 0) AS DownVotes,
        RANK() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.ViewCount DESC) AS PopularityRank,
        COUNT(c.Id) AS CommentsCount
    FROM Posts p
    LEFT JOIN (
        SELECT
            PostId,
            SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
        GROUP BY PostId
    ) v ON v.PostId = p.Id
    LEFT JOIN Comments c ON c.PostId = p.Id
    WHERE p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.Tags, p.OwnerUserId, p.Title, v.UpVotes, v.DownVotes
),
TopUserAnswers AS (
    SELECT
        p.OwnerUserId,
        p.Id AS AnswerId,
        p.ParentId AS QuestionId,
        p.Score,
        p.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate ASC) AS AnswerRank
    FROM Posts p
    WHERE p.PostTypeId = 2
),
TopQuestionTopAnswer AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.OwnerUserId AS QuestionOwnerId,
        a.Id AS AnswerId,
        a.OwnerUserId AS AnswerOwnerId,
        a.Score AS AnswerScore,
        a.CreationDate AS AnswerCreationDate
    FROM Posts q
    LEFT JOIN Posts a ON a.Id = q.AcceptedAnswerId AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1
),
UserActivityWindow AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        p.PostTypeId,
        COUNT(p.Id) AS PostCount,
        SUM(COALESCE(p.Score, 0)) AS TotalScore,
        SUM(COALESCE(vt.UpVotes, 0)) AS TotalUpVotes,
        SUM(COALESCE(vt.DownVotes, 0)) AS TotalDownVotes,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY MIN(p.CreationDate)) AS UserFirstPostOrder
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT
            PostId,
            SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
        GROUP BY PostId
    ) vt ON vt.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, p.PostTypeId
),
CombinedPostLinks AS (
    SELECT
        pl.Id,
        pl.PostId,
        pl.RelatedPostId,
        lt.Name AS LinkTypeName,
        pl.CreationDate
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    WHERE lt.Name IN ('Linked', 'Duplicate')
),
DuplicateQuestionsWithAnswers AS (
    SELECT DISTINCT
        p.Id AS QuestionId,
        p.Title,
        dpl.RelatedPostId AS DuplicateOfQuestionId,
        a.Id AS AnswerId,
        a.Score AS AnswerScore,
        a.OwnerUserId AS AnswerOwnerId
    FROM Posts p
    JOIN CombinedPostLinks dpl ON dpl.PostId = p.Id AND dpl.LinkTypeName = 'Duplicate'
    JOIN Posts a ON a.ParentId = dpl.RelatedPostId AND a.PostTypeId = 2
    WHERE p.PostTypeId = 1
),
FilteredPostHistory AS (
    SELECT
        ph.PostId,
        ph.PostHistoryTypeId,
        pht.Name AS HistoryTypeName,
        ph.CreationDate,
        ph.UserId,
        ph.UserDisplayName,
        ph.Comment
    FROM PostHistory ph
    JOIN PostHistoryTypes pht ON pht.Id = ph.PostHistoryTypeId
    WHERE ph.CreationDate > CAST('2024-10-01' AS DATE) - INTERVAL '1 year'
        AND ph.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15)
),
LatestPostEdits AS (
    SELECT DISTINCT ON (ph.PostId)
        ph.PostId,
        ph.UserId AS EditorUserId,
        ph.UserDisplayName,
        ph.PostHistoryTypeId,
        ph.CreationDate AS EditDate,
        ph.Comment
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4, 5, 6)
    ORDER BY ph.PostId, ph.CreationDate DESC
)
SELECT
    ubs.UserId,
    ubs.DisplayName,
    ubs.Reputation,
    ubs.GoldBadges,
    ubs.SilverBadges,
    ubs.BronzeBadges,
    ubs.QuestionsCount,
    ubs.AnswersCount,
    ROUND(CAST(ubs.AvgQuestionScore AS NUMERIC), 2) AS AvgQuestionScore,
    ROUND(CAST(ubs.AvgAnswerScore AS NUMERIC), 2) AS AvgAnswerScore,
    pw.PostCount,
    pw.TotalScore,
    pw.TotalUpVotes,
    pw.TotalDownVotes,
    rh.Level AS RequiredTagLevel,
    array_to_string(rh.Path, ' -> ') AS TagHierarchyPath,
    pp.Id AS PopularPostId,
    pp.PostTypeId AS PopularPostType,
    pp.Title AS PopularPostTitle,
    pp.Score AS PopularPostScore,
    pp.ViewCount AS PopularPostViews,
    pp.UpVotes AS PopularPostUpVotes,
    pp.DownVotes AS PopularPostDownVotes,
    pp.CommentsCount AS PopularPostComments,
    tqa.QuestionId,
    tqa.Title AS DupQuestionTitle,
    tqa.DuplicateOfQuestionId,
    tqa.AnswerId AS DupAnswerId,
    tqa.AnswerScore AS DupAnswerScore,
    tqa.AnswerOwnerId AS DupAnswerOwnerId,
    lpe.EditorUserId AS LastEditorId,
    lpe.UserDisplayName AS LastEditorName,
    lpe.EditDate,
    lpe.Comment AS LastEditComment
FROM UserBadgeStats ubs
LEFT JOIN UserActivityWindow pw ON pw.UserId = ubs.UserId
LEFT JOIN RecursiveTagHierarchy rh ON rh.Level = 1
LEFT JOIN PostPopularity pp ON pp.OwnerUserId = ubs.UserId AND pp.PopularityRank <= 3
LEFT JOIN DuplicateQuestionsWithAnswers tqa ON tqa.AnswerOwnerId = ubs.UserId
LEFT JOIN LatestPostEdits lpe ON lpe.EditorUserId = ubs.UserId
WHERE ubs.Reputation > (
    SELECT AVG(Reputation) FROM Users
)
AND EXISTS (
    SELECT 1
    FROM Posts p
    WHERE p.OwnerUserId = ubs.UserId AND p.PostTypeId = 1 AND p.CreationDate > CAST('2024-10-01' AS DATE) - INTERVAL '6 months'
)
ORDER BY ubs.GoldBadges DESC, ubs.Reputation DESC, pp.Score DESC NULLS LAST
LIMIT 50;