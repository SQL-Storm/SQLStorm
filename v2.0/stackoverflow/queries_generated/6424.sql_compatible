SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LastPostActivity,
    SUM(v.BountyAmount) AS TotalBountyPoints,
    MAX(ph.RevisionGUID) AS LastRevisionGUID,
    ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.LastActivityDate DESC) AS MostActivePost,
    (
        SELECT STRING_AGG(tg.TagName, ', ')
        FROM Tags tg
        WHERE tg.Id IN (
            SELECT DISTINCT CAST((Tags_array[1]) AS INTEGER)
            FROM (
                SELECT
                    -- attempt to normalize tag storage: if Tags is a text like '<tag1><tag2>' extract first tag,
                    -- or if it's a JSON/array string try to parse to array; adjust expression per actual schema.
                    -- Here we handle common formats: XML-like "<tag1><tag2>" -> 'tag1' ; JSON array '["a","b"]' -> first element.
                    CASE
                        WHEN Tags LIKE '<%>' THEN
                            -- extract first tag between first '<' and following '>'
                            SUBSTRING(Tags FROM '<([^>]+)>') 
                        WHEN Tags LIKE '[%' THEN
                            -- JSON array or SQL array textual representation: try to strip leading [ or { and get first element
                            TRIM(BOTH '["{' FROM TRIM(BOTH '"]}' FROM Tags))
                        ELSE
                            Tags
                    END AS Tags_normalized,
                    -- try to produce a one-based SQL array for safe indexing; wrappers differ by dialect.
                    -- Here create a one-element array from normalized tag to allow [1] access above.
                    ARRAY[CASE
                        WHEN Tags LIKE '<%>' THEN SUBSTRING(Tags FROM '<([^>]+)>')
                        WHEN Tags LIKE '[%' THEN TRIM(BOTH '"]}' FROM TRIM(BOTH '["{' FROM Tags))
                        ELSE Tags
                    END] AS Tags_array
                FROM Posts
                WHERE Posts.Id = p.Id
                LIMIT 1
            ) AS sub
        )
    ) AS TagsUsed,
    (
        SELECT COUNT(*) 
        FROM PostLinks pl 
        WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3
    ) AS DuplicateCount,
    (
        SELECT COUNT(DISTINCT b.Id)
        FROM Badges b
        WHERE b.UserId = u.Id AND b.Class = 1
    ) AS GoldBadgeCount
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
WHERE 
    u.Reputation > 10000
    AND p.LastEditDate > (
        SELECT MAX(LastEditDate) 
        FROM Posts 
        WHERE PostTypeId = 1
    )
GROUP BY 
    u.Id,
    u.DisplayName,
    u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 100
ORDER BY 
    TotalBountyPoints DESC, 
    TotalPosts DESC
LIMIT 100;