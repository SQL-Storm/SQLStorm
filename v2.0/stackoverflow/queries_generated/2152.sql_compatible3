with recursive RecursiveTagHierarchy as (
    select
        t.Id,
        t.TagName,
        array[t.TagName]::varchar[] as TagPath,
        1 as level
    from Tags t
    where t.IsModeratorOnly = false

    union all

    select
        t2.Id,
        t2.TagName,
        (rth.TagPath || t2.TagName)::varchar[],
        rth.level + 1
    from RecursiveTagHierarchy rth
    join Posts p on p.Tags like ('%<' || rth.TagName || '>%') and p.PostTypeId = 1
    join PostLinks pl on pl.PostId = p.Id and pl.LinkTypeId = 3
    join Posts p2 on pl.RelatedPostId = p2.Id
    join Tags t2 on p2.Tags like ('%<' || t2.TagName || '>%')
    where t2.TagName <> all(rth.TagPath)
      and rth.level < 3
),
UserActivity as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        count(distinct case when p.PostTypeId = 1 then p.Id end) as QuestionCount,
        count(distinct case when p.PostTypeId = 2 then p.Id end) as AnswerCount,
        coalesce(sum(case when v.VoteTypeId = 2 then 1 else 0 end), 0) as UpVotesGiven,
        coalesce(sum(case when v.VoteTypeId = 3 then 1 else 0 end), 0) as DownVotesGiven,
        coalesce(sum(votesUp.VoteCount),0) as TotalUpVotesReceived,
        coalesce(sum(votesDown.VoteCount),0) as TotalDownVotesReceived,
        rank() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Votes v on v.UserId = u.Id
    left join (
        select p.OwnerUserId, count(*) as VoteCount
        from Votes v
        join Posts p on p.Id = v.PostId
        where v.VoteTypeId = 2
        group by p.OwnerUserId
    ) votesUp on votesUp.OwnerUserId = u.Id
    left join (
        select p.OwnerUserId, count(*) as VoteCount
        from Votes v
        join Posts p on p.Id = v.PostId
        where v.VoteTypeId = 3
        group by p.OwnerUserId
    ) votesDown on votesDown.OwnerUserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
),
PostEngagement as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        u.DisplayName as OwnerName,
        q.CreationDate,
        q.Score,
        q.ViewCount,
        coalesce(q.AnswerCount, 0) as Answers,
        coalesce(q.CommentCount, 0) as Comments,
        coalesce(q.FavoriteCount, 0) as Favorites,
        coalesce(closedReasons.Name, 'Open') as CloseReason,
        max(coalesce(ph.CreationDate, q.LastActivityDate)) as LastActivity,
        coalesce(badges.BadgeScore, 0) as OwnerBadgeScore,
        case
            when q.ViewCount > 10000 and q.Score > 50 then 
                q.Score * 2 + q.FavoriteCount * 3 + q.AnswerCount * 5
            when q.ClosedDate is not null then 
                q.Score/2 + q.AnswerCount
            else
                q.Score + q.AnswerCount * 3
        end as HotnessScore
    from Posts q
    left join Users u on u.Id = q.OwnerUserId
    left join CloseReasonTypes closedReasons on closedReasons.Id = (
        select cast(ph2.CloseReasonId as smallint)
        from PostHistory ph2
        where ph2.PostId = q.Id and ph2.PostHistoryTypeId = 10
        order by ph2.CreationDate desc
        limit 1
    )
    left join (
        select UserId, sum(
            case 
                when Class = 1 then 5
                when Class = 2 then 3
                else 1
            end
        ) as BadgeScore
        from Badges
        group by UserId
    ) badges on badges.UserId = q.OwnerUserId
    left join PostHistory ph on ph.PostId = q.Id
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.OwnerUserId, u.DisplayName, q.CreationDate, q.Score, q.ViewCount, q.AnswerCount, q.CommentCount, q.FavoriteCount, closedReasons.Name, q.ClosedDate, badges.BadgeScore
),
AnswerQuality as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId,
        u.DisplayName as AnswererName,
        a.Score,
        a.CreationDate,
        length(regexp_replace(a.Body, '<[^>]*>', '', 'g')) as AnswerTextLength,
        rank() over (partition by a.ParentId order by a.Score desc) as AnswerRank,
        (select count(*) from Comments c where c.PostId = a.Id) as CommentCount,
        case when q.AcceptedAnswerId = a.Id then 1 else 0 end as IsAccepted,
        extract(epoch from (a.CreationDate - q.CreationDate))/3600 as HoursToAnswer
    from Posts a
    join Posts q on q.Id = a.ParentId and q.PostTypeId = 1
    left join Users u on u.Id = a.OwnerUserId
    where a.PostTypeId = 2
),
AnswerAggregate as (
    select
        aq.QuestionId,
        count(*) as TotalAnswers,
        sum(case when IsAccepted = 1 then 1 else 0 end) as AcceptedAnswers,
        avg(AnswerTextLength) as AvgAnswerLength,
        max(Score) as MaxAnswerScore,
        percentile_cont(0.5) within group (order by Score) as MedianAnswerScore,
        avg(HoursToAnswer) filter (where HoursToAnswer <= 48) as AvgAnswerWithin2Days
    from AnswerQuality aq
    group by aq.QuestionId
),
FinalOutput as (
    select
        pe.QuestionId,
        pe.Title,
        pe.OwnerName,
        ua.Reputation,
        pe.Score as QuestionScore,
        pe.ViewCount as QuestionViews,
        pe.Answers as QuestionAnswerCount,
        ag.TotalAnswers,
        ag.AcceptedAnswers,
        ag.AvgAnswerLength,
        ag.MaxAnswerScore,
        ag.MedianAnswerScore,
        ag.AvgAnswerWithin2Days,
        pe.CloseReason,
        pe.HotnessScore,
        pe.OwnerBadgeScore,
        ua.UpVotesGiven,
        ua.DownVotesGiven,
        ua.TotalUpVotesReceived,
        ua.TotalDownVotesReceived,
        ua.ReputationRank,
        coalesce(
            substring(
                string_agg(distinct rth.TagName, ', ') over (partition by pe.QuestionId),
                1, 100
            ),
            'No Tags'
        ) as RelatedTags,
        case 
            when pe.LastActivity is not null then
                extract(day from (timestamp '2024-10-01 12:34:56' - pe.LastActivity))
            else null
        end as DaysSinceLastActivity
    from PostEngagement pe
    left join UserActivity ua on ua.UserId = pe.OwnerUserId
    left join RecursiveTagHierarchy rth on rth.TagName = any(string_to_array(regexp_replace(pe.Title, '.*<([^>]+)>.*', '\1'), '><'))
    left join AnswerAggregate ag on ag.QuestionId = pe.QuestionId
    group by
        pe.QuestionId, pe.Title, pe.OwnerName, ua.Reputation, pe.Score, pe.ViewCount, pe.Answers,
        ag.TotalAnswers, ag.AcceptedAnswers, ag.AvgAnswerLength, ag.MaxAnswerScore, ag.MedianAnswerScore, ag.AvgAnswerWithin2Days,
        pe.CloseReason, pe.HotnessScore, pe.OwnerBadgeScore, ua.UpVotesGiven, ua.DownVotesGiven, ua.TotalUpVotesReceived, ua.TotalDownVotesReceived, ua.ReputationRank,
        pe.LastActivity
    order by pe.HotnessScore desc nulls last
    limit 50
)
select * from FinalOutput;