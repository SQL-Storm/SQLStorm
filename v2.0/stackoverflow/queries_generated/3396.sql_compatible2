WITH recent_questions AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.OwnerUserId,
        regexp_split_to_table(p.Tags, '\\><') AS tag
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
),

tag_agg AS (
    SELECT
        q.tag,
        COUNT(*)                     AS q_count,
        SUM(q.Score)                 AS total_score,
        AVG(q.Score)                 AS avg_score
    FROM recent_questions q
    GROUP BY q.tag
),

user_badges AS (
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END)    AS gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END)    AS silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END)    AS bronze_badges,
        SUM(CASE WHEN b.TagBased = 1 THEN 1 ELSE 0 END) AS tag_badges
    FROM Badges b
    GROUP BY b.UserId
),

user_votes AS (
    SELECT
        v.UserId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS up_votes_given,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS down_votes_given,
        SUM(CASE WHEN v.VoteTypeId = 8 THEN 1 ELSE 0 END) AS bounties_started
    FROM Votes v
    WHERE v.UserId IS NOT NULL
    GROUP BY v.UserId
),

user_activity AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(ub.gold_badges,   0) AS gold_badges,
        COALESCE(ub.silver_badges, 0) AS silver_badges,
        COALESCE(ub.bronze_badges, 0) AS bronze_badges,
        COALESCE(ub.tag_badges,    0) AS tag_badges,
        COALESCE(uv.up_votes_given,   0) AS up_votes_given,
        COALESCE(uv.down_votes_given, 0) AS down_votes_given,
        COALESCE(uv.bounties_started, 0) AS bounties_started,
        (SELECT MAX(p.CreationDate) FROM Posts p WHERE p.OwnerUserId = u.Id) AS last_post_date,
        (SELECT MAX(v.CreationDate) FROM Votes v WHERE v.UserId = u.Id)      AS last_vote_date
    FROM Users u
    LEFT JOIN user_badges ub ON ub.UserId = u.Id
    LEFT JOIN user_votes uv ON uv.UserId = u.Id
),

ranked_users AS (
    SELECT
        ua.Id,
        ua.DisplayName,
        ua.Reputation,
        ua.gold_badges,
        ua.silver_badges,
        ua.bronze_badges,
        ua.tag_badges,
        ua.up_votes_given,
        ua.down_votes_given,
        ua.bounties_started,
        ua.last_post_date,
        ua.last_vote_date,
        ROW_NUMBER() OVER (ORDER BY ua.Reputation DESC, ua.gold_badges DESC, ua.silver_badges DESC) AS rep_rank,
        RANK()      OVER (ORDER BY (ua.gold_badges * 100 + ua.silver_badges * 10 + ua.bronze_badges) DESC) AS badge_rank
    FROM user_activity ua
),

top_tags AS (
    SELECT
        tag,
        q_count,
        total_score,
        avg_score,
        ROW_NUMBER() OVER (ORDER BY q_count DESC) AS tag_pop_rank
    FROM tag_agg
),

main_result AS (
    SELECT
        ru.Id,
        ru.DisplayName,
        ru.Reputation,
        ru.gold_badges,
        ru.silver_badges,
        ru.bronze_badges,
        ru.tag_badges,
        ru.up_votes_given,
        ru.down_votes_given,
        ru.bounties_started,
        ru.rep_rank,
        ru.badge_rank,
        COALESCE(ru.last_post_date, CAST('1970-01-01' AS timestamp)) AS last_post_date,
        COALESCE(ru.last_vote_date, CAST('1970-01-01' AS timestamp)) AS last_vote_date,
        tt.tag,
        tt.q_count,
        tt.total_score,
        tt.avg_score,
        tt.tag_pop_rank
    FROM ranked_users ru
    FULL OUTER JOIN top_tags tt
        ON TRUE
    WHERE (tt.tag_pop_rank IS NOT NULL AND tt.tag_pop_rank <= 5 OR tt.tag_pop_rank IS NULL)
      AND (ru.rep_rank IS NOT NULL AND ru.rep_rank <= 10 OR ru.rep_rank IS NULL)
      AND (ru.Reputation > 10000 OR ru.gold_badges > 5)
    ORDER BY ru.rep_rank, tt.tag_pop_rank
    LIMIT 100
)

SELECT * FROM main_result

UNION ALL

SELECT
    NULL::bigint IS NOT NULL THEN NULL END,  -- placeholder to preserve column count
    NULL::text,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::integer,
    NULL::timestamp,
    NULL::timestamp,
    NULL::text,
    NULL::bigint,
    NULL::bigint,
    NULL::numeric,
    NULL::integer
WHERE NOT EXISTS (SELECT 1 FROM ranked_users ru WHERE ru.Reputation > 10000);