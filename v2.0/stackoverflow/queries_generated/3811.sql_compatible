WITH
    TopUsers AS (
        SELECT
            u.Id,
            u.DisplayName,
            u.Reputation,
            COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
            COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
            COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
            ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RepRank
        FROM Users u
        LEFT JOIN Badges b ON b.UserId = u.Id
        LEFT JOIN Votes v  ON v.UserId = u.Id
        GROUP BY u.Id, u.DisplayName, u.Reputation
    ),
    RecentPosts AS (
        SELECT
            p.Id,
            p.Title,
            p.CreationDate,
            p.OwnerUserId,
            p.Score,
            p.ViewCount,
            p.AnswerCount,
            p.FavoriteCount,
            p.Tags,
            p.AcceptedAnswerId,
            ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
        FROM Posts p
        WHERE p.PostTypeId = 1
    ),
    TagStats AS (
        SELECT
            t.TagName,
            t.Count AS TagUseCount,
            COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
            AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
            MAX(p.CreationDate) AS LastQuestionDate
        FROM Tags t
        LEFT JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
        GROUP BY t.TagName, t.Count
    ),
    LatestCloseReason AS (
        SELECT
            ph.PostId,
            ph.Comment AS CloseReason,
            ph.CreationDate AS ClosedOn,
            ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
        FROM PostHistory ph
        WHERE ph.PostHistoryTypeId = 10
    ),
    TopUsersWithPost AS (
        SELECT
            tu.RepRank,
            tu.DisplayName,
            tu.Reputation,
            tu.GoldBadges,
            tu.SilverBadges,
            tu.BronzeBadges,
            COALESCE(tu.UpVotesGiven,0) - COALESCE(tu.DownVotesGiven,0) AS VoteBalance,
            rp.Id AS PostId,
            rp.Title,
            rp.CreationDate,
            rp.Score,
            rp.ViewCount,
            rp.AnswerCount,
            rp.FavoriteCount,
            rp.Tags,
            rp.AcceptedAnswerId,
            COALESCE(lcr.CloseReason,'Not Closed') AS CloseReason,
            ts.TagName,
            ts.TagUseCount,
            ts.QuestionCount,
            ROUND(ts.AvgQuestionScore,2) AS AvgQuestionScore,
            ts.LastQuestionDate,
            CASE
                WHEN rp.AnswerCount = 0 THEN 'Unanswered'
                WHEN rp.AcceptedAnswerId IS NOT NULL THEN 'Answered & Accepted'
                ELSE 'Answered'
            END AS AnswerStatus,
            (SELECT COUNT(*) FROM Comments c WHERE c.PostId = rp.Id AND c.Score > 0) AS PositiveCommentCount
        FROM TopUsers tu
        LEFT JOIN RecentPosts rp ON rp.OwnerUserId = tu.Id AND rp.rn = 1
        LEFT JOIN LatestCloseReason lcr ON lcr.PostId = rp.Id AND lcr.rn = 1
        LEFT JOIN LATERAL (
            SELECT TRIM(BOTH '<>' FROM UNNEST(string_to_array(rp.Tags, '><'))) AS TagName
        ) t ON rp.Tags IS NOT NULL
        LEFT JOIN TagStats ts ON ts.TagName = t.TagName
        WHERE tu.RepRank <= 100
    )

SELECT
    RepRank,
    DisplayName,
    Reputation,
    GoldBadges,
    SilverBadges,
    BronzeBadges,
    VoteBalance,
    Title,
    CreationDate,
    Score,
    ViewCount,
    AnswerCount,
    FavoriteCount,
    Tags,
    CloseReason,
    TagName,
    TagUseCount,
    QuestionCount,
    AvgQuestionScore,
    LastQuestionDate,
    AnswerStatus,
    PositiveCommentCount
FROM TopUsersWithPost
ORDER BY RepRank, CreationDate DESC

UNION ALL

SELECT
    NULL AS RepRank,
    u.DisplayName,
    u.Reputation,
    NULL AS GoldBadges,
    NULL AS SilverBadges,
    NULL AS BronzeBadges,
    NULL AS VoteBalance,
    NULL AS Title,
    NULL AS CreationDate,
    NULL AS Score,
    NULL AS ViewCount,
    NULL AS AnswerCount,
    NULL AS FavoriteCount,
    NULL AS Tags,
    NULL AS CloseReason,
    NULL AS TagName,
    NULL AS TagUseCount,
    NULL AS QuestionCount,
    NULL AS AvgQuestionScore,
    NULL AS LastQuestionDate,
    NULL AS AnswerStatus,
    NULL AS PositiveCommentCount
FROM Users u
WHERE u.Reputation < 100
ORDER BY DisplayName DESC
LIMIT 10;