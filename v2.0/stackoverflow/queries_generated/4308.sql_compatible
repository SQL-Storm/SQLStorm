WITH UserPostInteractions AS (
    SELECT
        p.Id AS PostId,
        p.OwnerUserId,
        p.CreationDate AS PostCreationDate,
        pt.Name AS PostType,
        COALESCE(p.CommentCount, 0) AS CommentCount,
        COALESCE(p.AnswerCount, 0) AS AnswerCount,
        COALESCE(p.FavoriteCount, 0) AS FavoriteCount,
        u.Reputation AS OwnerReputation,
        COUNT(DISTINCT v.Id) AS TotalVotes,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
        MAX(ph.CreationDate) AS LastEditDate,
        -- use standard SQL date difference in days; for portability, use extract(epoch ...) for postgres could be different,
        -- here compute days as CAST((JulianDay equivalent) - (JulianDay) ... is DB-specific; use simple DATE_PART for Postgres/MySQL alternatives.
        CAST((JULIANDAY(p.LastActivityDate) - JULIANDAY(p.CreationDate)) AS INTEGER) AS DaysSinceLastActivity,
        CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END AS IsClosed,
        CASE WHEN p.CommunityOwnedDate IS NOT NULL THEN 1 ELSE 0 END AS IsCommunityOwned
    FROM Posts AS p
    JOIN PostTypes AS pt ON p.PostTypeId = pt.Id
    LEFT JOIN Comments AS c ON p.Id = c.PostId
    LEFT JOIN Votes AS v ON p.Id = v.PostId
    LEFT JOIN PostHistory AS ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (4, 5, 6)
    LEFT JOIN Users AS u ON p.OwnerUserId = u.Id
    WHERE p.OwnerUserId IS NOT NULL AND p.OwnerUserId <> -1 AND p.PostTypeId IN (1, 2)
    GROUP BY
        p.Id,
        p.OwnerUserId,
        p.CreationDate,
        pt.Name,
        p.CommentCount,
        p.AnswerCount,
        p.FavoriteCount,
        u.Reputation,
        p.ClosedDate,
        p.CommunityOwnedDate,
        p.LastActivityDate
),
RankedUserInteractions AS (
    SELECT
        upi.*,
        ROW_NUMBER() OVER (PARTITION BY upi.OwnerUserId ORDER BY upi.PostCreationDate DESC) AS PostRank,
        AVG(upi.TotalVotes) OVER (PARTITION BY upi.OwnerUserId) AS AvgUserVotes,
        SUM(upi.TotalVotes) OVER (PARTITION BY upi.OwnerUserId) AS TotalUserVotes,
        RANK() OVER (ORDER BY upi.OwnerReputation DESC, SUM(upi.TotalVotes) OVER (PARTITION BY upi.OwnerUserId) DESC) AS UserReputationRank
    FROM UserPostInteractions AS upi
),
UserAnswersWithBadges AS (
    SELECT
        r.OwnerUserId,
        COUNT(DISTINCT CASE WHEN r.PostType = 'Answer' THEN r.PostId ELSE NULL END) AS AnswerCountWithRanks,
        COUNT(DISTINCT b.Id) AS BadgeCount
    FROM RankedUserInteractions AS r
    LEFT JOIN Badges AS b ON r.OwnerUserId = b.UserId
    WHERE r.PostRank <= 10
    GROUP BY r.OwnerUserId
)
SELECT
    r.OwnerUserId,
    u.DisplayName AS OwnerDisplayName,
    r.OwnerReputation,
    r.UserReputationRank,
    COUNT(DISTINCT r.PostId) AS TotalPostsConsidered,
    SUM(r.CommentCount) AS TotalComments,
    SUM(r.AnswerCount) AS TotalAnswers,
    SUM(r.FavoriteCount) AS TotalFavorites,
    SUM(r.TotalVotes) AS TotalVotesOnPosts,
    AVG(r.DaysSinceLastActivity) AS AvgDaysSinceLastActivity,
    SUM(r.IsClosed) AS TotalClosedPosts,
    SUM(r.IsCommunityOwned) AS TotalCommunityOwnedPosts,
    COALESCE(uab.AnswerCountWithRanks, 0) AS AnswersWithRank,
    COALESCE(uab.BadgeCount, 0) AS TotalBadges,
    CASE
        WHEN u.CreationDate < DATEADD(year, -5, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) THEN 'Veteran'
        WHEN u.CreationDate < DATEADD(year, -1, CAST('2024-10-01 12:34:56' AS TIMESTAMP)) THEN 'Experienced'
        ELSE 'New'
    END AS UserTenure,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = r.PostId AND pl.LinkTypeId = 3) AS DuplicateLinks
FROM RankedUserInteractions AS r
JOIN Users AS u ON r.OwnerUserId = u.Id
LEFT JOIN UserAnswersWithBadges AS uab ON r.OwnerUserId = uab.OwnerUserId
WHERE r.PostRank <= 20
GROUP BY
    r.OwnerUserId,
    u.DisplayName,
    r.OwnerReputation,
    r.UserReputationRank,
    uab.AnswerCountWithRanks,
    uab.BadgeCount,
    u.CreationDate,
    r.OwnerUserId -- ensure any window/grouped columns included
HAVING SUM(r.TotalVotes) > 10
ORDER BY r.UserReputationRank;