WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT Q.Id) FILTER (WHERE Q.PostTypeId = 1) AS TotalQuestions,
        COUNT(DISTINCT A.Id) FILTER (WHERE A.PostTypeId = 2) AS TotalAnswers,
        COUNT(DISTINCT C.Id) AS TotalComments,
        SUM(P.Score) AS TotalPostScore,
        SUM(C.Score) AS TotalCommentScore,
        MAX(P.LastActivityDate) AS LastPostActivity,
        MAX(C.CreationDate) AS LastCommentActivity,
        COALESCE(
            CAST(U.Reputation AS numeric) / NULLIF(EXTRACT(EPOCH FROM (U.LastAccessDate - U.CreationDate)) / (24 * 3600), 0),
            0.0
        ) AS AvgDailyReputationGain,
        RANK() OVER (PARTITION BY EXTRACT(YEAR FROM U.CreationDate) ORDER BY SUM(P.Score) DESC) AS RankByScoreInCreationYear
    FROM Users AS U
    LEFT JOIN Posts AS P ON U.Id = P.OwnerUserId
    LEFT JOIN Posts AS Q ON U.Id = Q.OwnerUserId AND Q.PostTypeId = 1
    LEFT JOIN Posts AS A ON U.Id = A.OwnerUserId AND A.PostTypeId = 2
    LEFT JOIN Comments AS C ON U.Id = C.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate
),
PostHistoricalEdits AS (
    SELECT
        PostId,
        COUNT(DISTINCT Id) FILTER (WHERE PostHistoryTypeId IN (4, 5, 6)) AS NumberOfMinorEdits,
        COUNT(DISTINCT RevisionGUID) FILTER (WHERE PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)) AS NumberOfUniqueRevisions,
        MAX(CreationDate) AS LastEditHistoryDate
    FROM PostHistory
    GROUP BY PostId
),
QuestionAnswerDetails AS (
    SELECT
        Q.Id AS QuestionId,
        Q.OwnerUserId AS QuestionOwnerId,
        Q.CreationDate AS QuestionCreationDate,
        Q.Score AS QuestionScore,
        Q.ViewCount,
        Q.AnswerCount,
        Q.FavoriteCount,
        Q.ClosedDate,
        PHE.NumberOfUniqueRevisions AS QuestionRevisions,
        A.Id AS AnswerId,
        A.Score AS AnswerScore,
        Q.AcceptedAnswerId,
        AVG(A.Score) OVER (PARTITION BY Q.Id) AS QuestionAvgAnswerScore_WF,
        ROW_NUMBER() OVER (PARTITION BY Q.OwnerUserId ORDER BY Q.Score DESC, Q.CreationDate DESC) AS UserQuestionRank
    FROM Posts AS Q
    LEFT JOIN Posts AS A ON Q.Id = A.ParentId AND A.PostTypeId = 2
    LEFT JOIN PostHistoricalEdits AS PHE ON Q.Id = PHE.PostId
    WHERE Q.PostTypeId = 1
),
QuestionAnswerPerformance AS (
    SELECT
        QuestionId,
        QuestionOwnerId,
        QuestionCreationDate,
        QuestionScore,
        ViewCount,
        AnswerCount,
        FavoriteCount,
        ClosedDate,
        QuestionRevisions,
        COALESCE(SUM(AnswerScore) FILTER (WHERE AnswerId = AcceptedAnswerId), 0) AS AcceptedAnswerScore,
        COALESCE(MAX(QuestionAvgAnswerScore_WF), 0.0) AS AvgAnswerScore,
        (SELECT COUNT(V.Id) FROM Votes AS V WHERE V.PostId = QuestionId AND V.VoteTypeId = 2) AS UpVoteCount,
        (SELECT COUNT(V.Id) FROM Votes AS V WHERE V.PostId = QuestionId AND V.VoteTypeId = 3) AS DownVoteCount,
        (SELECT COUNT(PL.RelatedPostId) FROM PostLinks AS PL WHERE PL.PostId = QuestionId AND PL.LinkTypeId = 3) AS DuplicateLinkCount,
        MAX(UserQuestionRank) FILTER (WHERE UserQuestionRank <= 5) IS NOT NULL AS IsTop5UserQuestion
    FROM QuestionAnswerDetails
    GROUP BY
        QuestionId, QuestionOwnerId, QuestionCreationDate, QuestionScore, ViewCount, AnswerCount, FavoriteCount, ClosedDate, QuestionRevisions
),
UserTagEngagement AS (
    SELECT
        U.Id AS UserId,
        T.TagName,
        COUNT(DISTINCT P.Id) AS PostsWithTag,
        SUM(P.Score) AS TaggedPostScore,
        AVG(P.Score) AS AvgTaggedPostScore,
        (
            SELECT COUNT(DISTINCT U2.Id)
            FROM Users AS U2
            JOIN Posts AS P2 ON U2.Id = P2.OwnerUserId
            WHERE P2.Tags LIKE '%' || T.TagName || '%'
              AND U2.Reputation > U.Reputation
              AND U2.Id <> U.Id
        ) AS HigherReputationContributorsToTag
    FROM Users AS U
    JOIN Posts AS P ON U.Id = P.OwnerUserId AND P.PostTypeId = 1 AND P.Tags IS NOT NULL
    CROSS JOIN LATERAL (
        SELECT TRIM(UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'))) AS TagName
    ) AS TagList
    JOIN Tags AS T ON TagList.TagName = T.TagName
    GROUP BY U.Id, U.DisplayName, U.Reputation, T.TagName
),
UserBadgeStats AS (
    SELECT
        UserId,
        COUNT(Id) AS TotalBadges,
        COUNT(Id) FILTER (WHERE Class = 1) AS GoldBadges,
        COUNT(Id) FILTER (WHERE Class = 2) AS SilverBadges,
        COUNT(Id) FILTER (WHERE Class = 3) AS BronzeBadges,
        MAX(Date) AS LatestBadgeDate
    FROM Badges
    GROUP BY UserId
),
HighImpactUsersCandidate AS (
    SELECT UserId FROM UserActivitySummary WHERE Reputation > 5000 AND TotalPosts > 100
    UNION ALL
    SELECT QuestionOwnerId AS UserId FROM QuestionAnswerPerformance WHERE AvgAnswerScore > 5 AND AcceptedAnswerScore > 0
    UNION ALL
    SELECT UserId FROM UserBadgeStats WHERE GoldBadges > 0
)
SELECT
    UAS.UserId,
    UAS.DisplayName,
    UAS.Reputation,
    UAS.TotalPosts,
    UAS.TotalQuestions,
    UAS.TotalAnswers,
    UAS.TotalComments,
    UAS.TotalPostScore,
    UAS.TotalCommentScore,
    UBS.TotalBadges,
    UBS.GoldBadges,
    UBS.SilverBadges,
    UBS.BronzeBadges,
    UBS.LatestBadgeDate,
    AVG(QAP.QuestionScore) AS AvgQuestionScore,
    AVG(QAP.AvgAnswerScore) AS AvgQuestionAvgAnswerScore,
    SUM(QAP.UpVoteCount) AS TotalQuestionUpVotes,
    SUM(QAP.DownVoteCount) AS TotalQuestionDownVotes,
    SUM(QAP.DuplicateLinkCount) AS TotalDuplicateQuestionsLinked,
    MAX(QAP.QuestionRevisions) AS MaxQuestionRevisions,
    MIN(QAP.QuestionRevisions) AS MinQuestionRevisions,
    NTILE(10) OVER (ORDER BY UAS.Reputation DESC) AS ReputationDecile,
    CASE
        WHEN UAS.Reputation > 10000 AND UAS.TotalPosts > 500 AND UAS.AvgDailyReputationGain > 10 THEN 'Elite Contributor'
        WHEN UAS.Reputation > 1000 AND UAS.TotalPosts > 100 THEN 'Active Contributor'
        WHEN UAS.Reputation IS NULL OR UAS.Reputation = 0 THEN 'New/Inactive'
        ELSE 'Regular User'
    END AS UserCategory,
    COALESCE(UAS.DisplayName, 'Anonymous User') AS EffectiveDisplayName,
    CAST(EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - UAS.UserCreationDate)) / (365.25 * 24 * 3600) AS numeric(10, 2)) AS AccountAgeYears,
    AVG(CASE WHEN QAP.ClosedDate IS NOT NULL THEN 1.0 ELSE 0.0 END) AS PctQuestionsClosed,
    (
        SELECT COALESCE(SUM(V.BountyAmount), 0)
        FROM Votes AS V
        WHERE V.UserId = UAS.UserId AND V.VoteTypeId IN (8, 9)
    ) AS TotalBountyActivity,
    STRING_AGG(DISTINCT UTE.TagName, '; ' ORDER BY UTE.TaggedPostScore DESC) FILTER (WHERE UTE.PostsWithTag > 10 AND UTE.AvgTaggedPostScore > 2) AS TopActiveTags,
    COALESCE(SUM(UTE.HigherReputationContributorsToTag), 0) AS TotalHigherRepContributorsAcrossTags,
    COUNT(DISTINCT SELF_ANS.Id) FILTER (WHERE SELF_ANS.Id IS NOT NULL) AS SelfAcceptedAnswersCount
FROM UserActivitySummary AS UAS
LEFT JOIN UserBadgeStats AS UBS ON UAS.UserId = UBS.UserId
LEFT JOIN QuestionAnswerPerformance AS QAP ON UAS.UserId = QAP.QuestionOwnerId
LEFT JOIN UserTagEngagement AS UTE ON UAS.UserId = UTE.UserId
LEFT JOIN Posts AS SELF_ANS ON UAS.UserId = SELF_ANS.OwnerUserId AND SELF_ANS.PostTypeId = 2 AND SELF_ANS.ParentId = QAP.QuestionId AND SELF_ANS.Id = QAP.AcceptedAnswerId
JOIN (SELECT DISTINCT UserId FROM HighImpactUsersCandidate) AS HIC ON UAS.UserId = HIC.UserId
WHERE
    UAS.Reputation > 100
    AND UAS.LastAccessDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'
    AND (QAP.QuestionScore > 5 OR QAP.AvgAnswerScore > 3.0 OR QAP.QuestionId IS NULL)
    AND (
        LOWER(UAS.DisplayName) LIKE '%dev%' OR LOWER(UAS.DisplayName) LIKE '%sql%'
        OR LOWER(COALESCE(UAS.AboutMe, '')) LIKE '%developer%' OR LOWER(COALESCE(UAS.AboutMe, '')) LIKE '%database%'
        OR UAS.Location IS NULL
    )
GROUP BY
    UAS.UserId, UAS.DisplayName, UAS.Reputation, UAS.TotalPosts, UAS.TotalQuestions, UAS.TotalAnswers,
    UAS.TotalComments, UAS.TotalPostScore, UAS.TotalCommentScore, UBS.TotalBadges, UBS.GoldBadges,
    UBS.SilverBadges, UBS.BronzeBadges, UBS.LatestBadgeDate, UAS.UserCreationDate, UAS.LastAccessDate
ORDER BY
    ReputationDecile,
    UAS.Reputation DESC,
    UAS.LastAccessDate DESC
LIMIT 1000;