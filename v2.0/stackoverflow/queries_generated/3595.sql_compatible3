WITH 
user_stats AS (
    SELECT 
        u.Id                     AS user_id,
        u.DisplayName            AS display_name,
        u.Reputation,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)            AS q_cnt,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)            AS a_cnt,
        AVG(p.Score) FILTER (WHERE p.PostTypeId IN (1,2))      AS avg_score,
        MAX(p.CreationDate)                                   AS last_post_dt
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
badge_latest AS (
    SELECT 
        b.UserId,
        b.Name                      AS badge_name,
        b.Date                      AS badge_date,
        ROW_NUMBER() OVER (PARTITION BY b.UserId ORDER BY b.Date DESC) AS rn
    FROM Badges b
),
vote_summary AS (
    SELECT 
        v.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS up_votes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS down_votes
    FROM Votes v
    GROUP BY v.PostId
),
tag_activity AS (
    SELECT 
        u.Id                         AS user_id,
        tag.TagName,
        COUNT(*)                     AS tag_use_cnt,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY COUNT(*) DESC) AS rn
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    CROSS JOIN LATERAL (
        SELECT UNNEST(string_to_array(TRIM(BOTH '<>' FROM p.Tags), '><')) AS TagName
    ) tag
    GROUP BY u.Id, tag.TagName
),
closed_q AS (
    SELECT 
        p.OwnerUserId                AS user_id,
        COUNT(*)                     AS closed_cnt
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.ClosedDate IS NOT NULL
    GROUP BY p.OwnerUserId
),
net_votes_latest_post AS (
    SELECT 
        p.OwnerUserId                AS user_id,
        COALESCE(vs.up_votes,0) - COALESCE(vs.down_votes,0) AS net_votes
    FROM Posts p
    LEFT JOIN vote_summary vs ON vs.PostId = p.Id
    WHERE p.CreationDate = (
        SELECT MAX(p2.CreationDate)
        FROM Posts p2
        WHERE p2.OwnerUserId = p.OwnerUserId
    )
),
global_agg AS (
    SELECT 
        CAST(NULL AS INTEGER)               AS user_id,
        'GLOBAL_STATS'                      AS display_name,
        CAST(NULL AS INTEGER)               AS reputation,
        SUM(us.q_cnt)                       AS q_cnt,
        SUM(us.a_cnt)                       AS a_cnt,
        AVG(us.avg_score)                   AS avg_score,
        CAST(NULL AS TIMESTAMP)             AS last_post_dt,
        CAST(NULL AS VARCHAR)               AS badge_name,
        CAST(NULL AS TIMESTAMP)             AS badge_date,
        SUM(nv.net_votes)                   AS net_votes,
        SUM(cq.closed_cnt)                  AS closed_cnt,
        CAST(NULL AS VARCHAR)               AS top_tag,
        CAST(NULL AS INTEGER)               AS tag_use_cnt,
        CAST(NULL AS VARCHAR)               AS tier,
        CAST(NULL AS VARCHAR)               AS slug
    FROM user_stats us
    LEFT JOIN net_votes_latest_post nv ON nv.user_id = us.user_id
    LEFT JOIN closed_q cq ON cq.user_id = us.user_id
)

SELECT *
FROM (
    SELECT
        us.user_id,
        us.display_name,
        us.reputation,
        us.q_cnt,
        us.a_cnt,
        COALESCE(us.avg_score,0)               AS avg_score,
        us.last_post_dt,
        bl.badge_name,
        bl.badge_date,
        COALESCE(nv.net_votes,0)               AS net_votes,
        COALESCE(cq.closed_cnt,0)              AS closed_questions,
        ta.TagName                             AS top_tag,
        ta.tag_use_cnt,
        CASE
            WHEN us.reputation > 20000 THEN 'Elite'
            WHEN us.reputation > 10000 THEN 'Veteran'
            WHEN us.reputation > 1000  THEN 'Contributor'
            ELSE 'Newbie'
        END                                    AS tier,
        ('user_' || us.user_id || '_' || REPLACE(COALESCE(us.display_name,''), ' ', '_')) AS slug
    FROM user_stats us
    LEFT JOIN (
        SELECT UserId, badge_name, badge_date
        FROM badge_latest
        WHERE rn = 1
    ) bl ON bl.UserId = us.user_id
    LEFT JOIN net_votes_latest_post nv ON nv.user_id = us.user_id
    LEFT JOIN closed_q cq ON cq.user_id = us.user_id
    LEFT JOIN (
        SELECT user_id, TagName, tag_use_cnt
        FROM tag_activity
        WHERE rn = 1
    ) ta ON ta.user_id = us.user_id
    WHERE us.reputation IS NOT NULL
      AND us.user_id IS NOT NULL
      AND us.last_post_dt < (CAST('2024-10-01' AS DATE) - INTERVAL '1 year')
    ORDER BY us.reputation DESC
    LIMIT 100

    UNION ALL

    SELECT
        user_id,
        display_name,
        reputation,
        q_cnt,
        a_cnt,
        COALESCE(avg_score,0) AS avg_score,
        last_post_dt,
        badge_name,
        badge_date,
        COALESCE(net_votes,0) AS net_votes,
        COALESCE(closed_cnt,0) AS closed_questions,
        top_tag,
        tag_use_cnt,
        tier,
        slug
    FROM global_agg
) t
ORDER BY reputation DESC NULLS LAST;