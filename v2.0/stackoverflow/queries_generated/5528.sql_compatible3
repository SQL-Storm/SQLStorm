WITH TopQuestions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.LastActivityDate,
    p.CommentCount,
    p.AnswerCount,
    p.FavoriteCount,
    p.ContentLicense,
    u.Reputation,
    u.DisplayName AS OwnerDisplayName,
    u.AccountId,
    ROW_NUMBER() OVER (
      PARTITION BY CAST(p.CreationDate AS DATE)
      ORDER BY p.Score DESC, p.ViewCount DESC, p.CreationDate ASC
    ) AS DayRank
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.PostTypeId = 1
    AND p.ClosedDate IS NULL
    AND p.Tags IS NOT NULL
),
TagAggregates AS (
  -- split tags like '<tag1><tag2>' into rows using standard SQL functions
  SELECT
    tag AS TagName,
    COUNT(*) AS QuestionCount,
    AVG(UsageCount) AS AvgTagUsage
  FROM (
    SELECT
      t.Id,
      TRIM(tag_elem) AS tag,
      1 AS UsageCount
    FROM Tags t,
    LATERAL (
      SELECT
        -- generate rows by splitting on '><'
        -- emulate by using a simple splitting approach: iterate positions using recursive CTE
        -- produce tag_elem values via string operations
        -- The following produces tag elements for each tag row
        (SELECT tag_elem FROM (
          WITH RECURSIVE split(pos, rest, tag_elem) AS (
            SELECT
              1,
              t.TagName,
              NULL
            UNION ALL
            SELECT
              instr_pos + 1,
              CASE
                WHEN instr_pos > 0 THEN substr(rest, instr_pos + 2)
                ELSE ''
              END,
              CASE
                WHEN instr_pos > 0 THEN
                  CASE WHEN pos = 1 AND substr(rest,1,1) = '<' THEN
                    CASE
                      WHEN instr_pos > 0 THEN substr(rest, 2, instr_pos - 2)
                      ELSE NULL
                    END
                  ELSE NULL END
                ELSE NULL END
            FROM (
              SELECT
                (CASE
                  WHEN pos = 1 THEN instr(rest, '><')
                  ELSE instr(rest, '><')
                END) AS instr_pos,
                pos,
                rest
              FROM split
            ) t2
            WHERE rest <> ''
          )
          SELECT
            COALESCE(
              CASE
                WHEN substr(rest,1,1) = '<' AND instr(rest, '><') > 0 THEN substr(rest, 2, instr(rest, '><') - 2)
                WHEN substr(rest,1,1) = '<' AND instr(rest, '><') = 0 THEN substr(rest, 2, length(rest)-2)
                ELSE NULL
              END,
              tag_elem
            ) AS tag_elem
          FROM split
          WHERE rest IS NOT NULL
        ) generated_tags WHERE tag_elem IS NOT NULL)
    ) s
  ) tg
  GROUP BY tag
),
CommentStats AS (
  SELECT
    p.Id AS PostId,
    COUNT(c.Id) AS CommentCount
  FROM Posts p
  LEFT JOIN Comments c ON c.PostId = p.Id
  GROUP BY p.Id
),
RecentActivity AS (
  SELECT
    p.Id AS PostId,
    MAX(v.CreationDate) AS LastVoteDate
  FROM Posts p
  LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId IN (2,3,16)
  GROUP BY p.Id
)
SELECT
  tq.PostId,
  tq.Title,
  tq.Tags,
  tq.CreationDate,
  tq.Score,
  tq.ViewCount,
  tq.OwnerDisplayName,
  tq.Reputation,
  COALESCE(tc.CommentCount, 0) AS CommentCount,
  ra.LastVoteDate,
  ta.QuestionCount,
  ta.AvgTagUsage,
  (CASE WHEN tq.Score > 100 THEN 'Hot' ELSE 'Normal' END) AS Bucketing,
  (CASE WHEN tq.ViewCount > 10000 THEN CAST(1 AS INTEGER) ELSE CAST(0 AS INTEGER) END) AS HighView
FROM TopQuestions tq
LEFT JOIN CommentStats tc ON tc.PostId = tq.PostId
LEFT JOIN RecentActivity ra ON ra.PostId = tq.PostId
LEFT JOIN TagAggregates ta ON EXISTS (
  SELECT 1
  FROM (
    -- split tq.Tags using standard functions in a derived table
    WITH RECURSIVE split_tags(pos, rest, tag) AS (
      SELECT 1, tq.Tags, NULL
      UNION ALL
      SELECT
        pos + 1,
        CASE
          WHEN instr(rest, '><') > 0 THEN substr(rest, instr(rest, '><') + 2)
          ELSE ''
        END,
        CASE
          WHEN substr(rest,1,1) = '<' AND instr(rest, '><') > 0 THEN substr(rest, 2, instr(rest, '><') - 2)
          WHEN substr(rest,1,1) = '<' AND instr(rest, '><') = 0 THEN substr(rest, 2, length(rest)-2)
          ELSE NULL
        END
      FROM split_tags
      WHERE rest <> ''
    )
    SELECT tag FROM split_tags WHERE tag IS NOT NULL
  ) split_tags
  WHERE split_tags.tag = ta.TagName
)
WHERE
  tq.DayRank <= 5
ORDER BY tq.CreationDate DESC
LIMIT 200;