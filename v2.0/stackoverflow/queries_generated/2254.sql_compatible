with recursive RecursiveUserHierarchy as (
    select 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        u.AccountId,
        0 as depth
    from Users u
    where u.Reputation > 10000
    union all
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.Location,
        u.AccountId,
        rh.depth + 1
    from Users u
    inner join RecursiveUserHierarchy rh on u.AccountId = rh.AccountId and u.Id != rh.Id and rh.depth < 3
), LatestPostEdits as (
    select ph.PostId, max(ph.CreationDate) as LastEditDate
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6,7,8,9)
    group by ph.PostId
), PostWithAnswers as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate as QuestionCreation,
        q.Score as QuestionScore,
        q.ViewCount,
        q.Tags,
        a.Id as AnswerId,
        a.CreationDate as AnswerCreation,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswererUserId,
        u.DisplayName as AnswererName,
        row_number() over(partition by q.Id order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join Users u on u.Id = a.OwnerUserId
    where q.PostTypeId = 1
), QAnswerAggregates as (
    select
        QuestionId,
        count(AnswerId) as TotalAnswers,
        max(AnswerScore) as MaxAnswerScore,
        avg(coalesce(AnswerScore,0)) as AvgAnswerScore,
        sum(case when AnswerScore > 10 then 1 else 0 end) as HighlyRatedAnswers
    from PostWithAnswers
    group by QuestionId
), CloseVotesAndDuplicates as (
    select 
        ph.PostId,
        sum(case when ph.PostHistoryTypeId = 10 then 1 else 0 end) as CloseVotesCount,
        sum(case when lt.Name = 'Duplicate' then 1 else 0 end) as DuplicateCount
    from PostHistory ph
    left join Posts p on p.Id = ph.PostId
    left join PostLinks pl on pl.PostId = ph.PostId
    left join LinkTypes lt on lt.Id = pl.LinkTypeId
    where ph.PostHistoryTypeId in (10,11)
    group by ph.PostId
), UserBadgeStats as (
    select
        b.UserId,
        count(case when b.Class = 1 then 1 end) as GoldBadges,
        count(case when b.Class = 2 then 1 end) as SilverBadges,
        count(case when b.Class = 3 then 1 end) as BronzeBadges,
        count(*) as TotalBadges,
        max(b.Date) as LatestBadgeDate
    from Badges b
    group by b.UserId
), UserActivityRankings as (
    select
        u.Id,
        u.DisplayName,
        sum(case when p.PostTypeId = 1 then 1 else 0 end) as QuestionCount,
        sum(case when p.PostTypeId = 2 then 1 else 0 end) as AnswerCount,
        count(c.Id) as CommentCount,
        u.Reputation,
        rank() over(order by u.Reputation desc, sum(case when p.PostTypeId = 1 then 1 else 0 end) desc) as ReputationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation
), RecentPopularQuestions as (
    select
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        u.DisplayName as OwnerName,
        u.Reputation as OwnerReputation,
        row_number() over (order by p.Score desc, p.ViewCount desc) as PopularRank
    from Posts p
    left join Users u on u.Id = p.OwnerUserId
    where p.PostTypeId = 1 and p.CreationDate > (cast('2024-10-01' as date) - interval '90' day) and p.Score >= 10
)
select distinct 
    rpq.Id as QuestionId,
    rpq.Title,
    rpq.CreationDate,
    rpq.Score as QuestionScore,
    rpq.ViewCount,
    coalesce(qa.TotalAnswers,0) as TotalAnswers,
    coalesce(qa.MaxAnswerScore,0) as MaxAnswerScore,
    cast(coalesce(qa.AvgAnswerScore,0) as numeric(10,2)) as AvgAnswerScore,
    coalesce(qa.HighlyRatedAnswers,0) as HighlyRatedAnswers,
    cb.CloseVotesCount,
    cb.DuplicateCount,
    ubs.GoldBadges,
    ubs.SilverBadges,
    ubs.BronzeBadges,
    ubs.TotalBadges,
    uar.ReputationRank,
    rpq.OwnerName,
    rpq.OwnerReputation,
    array_to_string(string_to_array(regexp_replace(coalesce(rpq.Tags,''), '[<>]', ' ', 'g'), ' '), ', ') as TagList,
    (select avg(v.Score) 
     from Votes v 
     join Posts p2 on p2.Id = v.PostId 
     where p2.OwnerUserId = rpq.OwnerReputation and v.VoteTypeId = 2
    ) as AvgUpvotesPerUserPost,
    (select count(*) from Comments c2 where c2.PostId = rpq.Id and c2.CreationDate > (cast('2024-10-01' as date) - interval '30' day)) as RecentCommentCount,
    case when coalesce(qa.TotalAnswers,0) > 0 then
        (select u2.DisplayName 
         from Posts a2 
         join Users u2 on u2.Id = a2.OwnerUserId 
         where a2.ParentId = rpq.Id 
         order by a2.Score desc 
         limit 1)
    else null end as TopAnswerer,
    (select count(*) from PostLinks pl where pl.PostId = rpq.Id and pl.LinkTypeId = 3) as DuplicateLinksCount
from RecentPopularQuestions rpq
left join QAnswerAggregates qa on qa.QuestionId = rpq.Id
left join CloseVotesAndDuplicates cb on cb.PostId = rpq.Id
left join UserBadgeStats ubs on ubs.UserId = rpq.OwnerReputation
left join UserActivityRankings uar on uar.Id = rpq.OwnerReputation
where rpq.PopularRank <= 50
order by rpq.Score desc, qa.MaxAnswerScore desc, qa.AvgAnswerScore desc
limit 100;