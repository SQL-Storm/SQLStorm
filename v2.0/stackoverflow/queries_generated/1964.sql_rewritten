-- {"query": "1964.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 2887} 
WITH UserEngagement AS (
    SELECT
        U.Id AS UserId,
        COALESCE(U.DisplayName, 'Anonymous') AS DisplayName,
        U.Reputation,
        U.CreationDate,
        U.LastAccessDate,
        U.Views AS UserProfileViews,
        U.UpVotes AS UserUpVotesGiven,
        U.DownVotes AS UserDownVotesGiven,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT P.Id) FILTER (WHERE P.PostTypeId = 1) AS TotalQuestions,
        COUNT(DISTINCT P.Id) FILTER (WHERE P.PostTypeId = 2) AS TotalAnswers,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        SUM(CASE WHEN V_Rec.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotesReceivedPosts,
        SUM(CASE WHEN V_Rec.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownvotesReceivedPosts,
        SUM(CASE WHEN V_Rec.VoteTypeId = 5 THEN 1 ELSE 0 END) AS TotalFavoritesReceivedPosts,
        AVG(CASE WHEN P.PostTypeId IN (1,2) THEN P.Score ELSE 0 END) AS AvgPostScore,
        AVG(CASE WHEN P.PostTypeId = 1 THEN P.ViewCount ELSE 0 END) AS AvgQuestionViews,
        MAX(P.CreationDate) AS LastPostDate,
        MAX(CASE WHEN B.Class = 1 AND B.TagBased = TRUE THEN 1 ELSE 0 END) AS HasTagBasedGoldBadge, -- Correlated for specific badge
        -- Custom activity score calculation
        (U.Reputation * 0.5 + COUNT(DISTINCT P.Id) * 2 + COUNT(DISTINCT C.Id) * 0.5 + U.UpVotes * 0.1 - U.DownVotes * 0.2) AS UserActivityScore,
        ROW_NUMBER() OVER (ORDER BY U.Reputation DESC, COUNT(DISTINCT P.Id) DESC, COUNT(DISTINCT C.Id) DESC) AS UserOverallRank
    FROM Users AS U
    LEFT JOIN Posts AS P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments AS C ON U.Id = C.UserId
    LEFT JOIN Badges AS B ON U.Id = B.UserId
    LEFT JOIN Votes AS V_Rec ON P.Id = V_Rec.PostId AND V_Rec.VoteTypeId IN (2,3,5)
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.Views, U.UpVotes, U.DownVotes
),
PostContentAnalysis AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.CreationDate,
        P.Score,
        P.ViewCount,
        COALESCE(P.Title, 'Untitled Post') AS PostTitle,
        LENGTH(P.Body) AS BodyLength,
        CASE
            WHEN P.Tags IS NULL OR LENGTH(P.Tags) < 2 THEN ARRAY[]::TEXT[]
            ELSE string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><')
        END AS ParsedTagsArray,
        CASE
            WHEN P.Tags IS NULL OR LENGTH(P.Tags) < 2 THEN 0
            ELSE ARRAY_LENGTH(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><'), 1)
        END AS TagCount,
        (SELECT COUNT(PH.Id) FROM PostHistory AS PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId IN (4,5,6,7,8,9)) AS EditAndRollbackCount, -- Correlated subquery for post history
        DENSE_RANK() OVER (PARTITION BY P.OwnerUserId ORDER BY P.Score DESC, P.ViewCount DESC) AS RankByOwnerEngagement,
        P.LastEditDate,
        P.LastActivityDate,
        P.ClosedDate,
        P.CommunityOwnedDate,
        NULLIF(P.Score, 0)::NUMERIC / NULLIF(P.ViewCount, 0) AS ScorePerViewRatio -- NULL logic for division by zero
    FROM Posts AS P
    WHERE P.PostTypeId IN (1, 2, 4, 5) -- Focus on Questions, Answers, TagWikiExcerpt, TagWiki
),
PostClosingAndLinkTrends AS (
    SELECT
        PH.PostId,
        MAX(PH.CreationDate) FILTER (WHERE PH.PostHistoryTypeId = 10) AS LastClosedDate,
        MAX(PH.CreationDate) FILTER (WHERE PH.PostHistoryTypeId = 11) AS LastReopenedDate,
        STRING_AGG(DISTINCT CRT.Name, '; ') FILTER (WHERE PH.PostHistoryTypeId = 10 AND PH.Comment ~ '^[0-9]+$') AS CloseReasonNames, -- Using regex to filter valid close reason IDs
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId = 10 THEN PH.UserId END) AS UniqueClosers,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId = 11 THEN PH.UserId END) AS UniqueReopeners,
        -- Attempt to extract Duplicate Question IDs from JSON in PostHistory.Text if available (PostgreSQL specific jsonb functions)
        (
            SELECT ARRAY_AGG(DISTINCT CAST(jsonb_array_elements_text(ph_json.Text::jsonb -> 'OriginalQuestionIds') AS INT))
            FROM PostHistory AS ph_json
            WHERE ph_json.PostId = PH.PostId
              AND ph_json.PostHistoryTypeId = 10
              AND ph_json.Text LIKE '{%"OriginalQuestionIds"%}'
        ) AS AllDuplicateOriginalQuestionIds,
        COUNT(DISTINCT PL.RelatedPostId) FILTER (WHERE PL.LinkTypeId = 1) AS LinkedPostsCount,
        COUNT(DISTINCT PL.RelatedPostId) FILTER (WHERE PL.LinkTypeId = 3) AS DuplicatePostsCount
    FROM PostHistory AS PH
    LEFT JOIN CloseReasonTypes AS CRT ON PH.PostHistoryTypeId = 10 AND CAST(CRT.Id AS VARCHAR) = PH.Comment
    LEFT JOIN PostLinks AS PL ON PH.PostId = PL.PostId
    WHERE PH.PostHistoryTypeId IN (10, 11) OR PL.PostId IS NOT NULL
    GROUP BY PH.PostId
),
UserTopTagContribution AS (
    WITH TopGlobalTags AS (
        SELECT
            unnest(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags)-2), '><')) AS TagName,
            SUM(P.Score) AS TotalTagScore,
            COUNT(P.Id) AS TagPostCount
        FROM Posts AS P
        WHERE P.Tags IS NOT NULL AND LENGTH(P.Tags) > 2 AND P.PostTypeId = 1
        GROUP BY 1
        HAVING SUM(P.Score) > 0
    ),
    UserTagScores AS (
        SELECT
            PCA_agg.OwnerUserId,
            Tag_Item AS TagName,
            SUM(tt.TotalTagScore) AS TotalUserTagScore,
            SUM(tt.TagPostCount) AS TotalUserTagPostCount,
            ROW_NUMBER() OVER (PARTITION BY PCA_agg.OwnerUserId ORDER BY SUM(tt.TotalTagScore) DESC, SUM(tt.TagPostCount) DESC) as rn
        FROM PostContentAnalysis AS PCA_agg
        CROSS JOIN LATERAL UNNEST(PCA_agg.ParsedTagsArray) AS Tag_Item
        INNER JOIN TopGlobalTags AS tt ON Tag_Item = tt.TagName
        GROUP BY PCA_agg.OwnerUserId, Tag_Item
    )
    SELECT OwnerUserId, TagName, TotalUserTagScore, TotalUserTagPostCount
    FROM UserTagScores
    WHERE rn = 1
)
-- Main Query
SELECT
    UE.UserId,
    UE.DisplayName,
    UE.Reputation,
    UE.TotalPosts,
    UE.TotalQuestions,
    UE.TotalAnswers,
    UE.TotalComments,
    UE.UserOverallRank,
    (AGE(cast('2024-10-01 12:34:56' as timestamp), UE.CreationDate)) AS AccountAge, -- Date calculation
    COALESCE(UE.AvgPostScore, 0.0) AS AveragePostScore,
    COALESCE(UE.AvgQuestionViews, 0.0) AS AverageQuestionViews,
    UE.UserActivityScore,
    UE.TotalUpvotesReceivedPosts,
    UE.TotalDownvotesReceivedPosts,
    UE.TotalFavoritesReceivedPosts,
    UE.HasTagBasedGoldBadge,
    COALESCE(UE.UserProfileViews * 1.0 / NULLIF(EXTRACT(EPOCH FROM AGE(cast('2024-10-01 12:34:56' as timestamp), UE.CreationDate)), 0) * 86400, 0.0) AS AvgDailyProfileViews, -- Views per day
    (SELECT C.Text FROM Comments AS C WHERE C.UserId = UE.UserId ORDER BY C.CreationDate DESC LIMIT 1) AS LatestCommentText, -- Correlated subquery
    PQ.PostId AS MostViewedQuestionId,
    PQ.PostTitle AS MostViewedQuestionTitle,
    PQ.ViewCount AS MostViewedQuestionViews,
    PQ.BodyLength AS MostViewedQuestionBodyLength,
    PCA.EditAndRollbackCount AS LatestPostEditCount,
    PCA.ScorePerViewRatio AS LatestPostScorePerView,
    PCT.LastClosedDate,
    PCT.CloseReasonNames,
    PCT.UniqueClosers,
    PCT.AllDuplicateOriginalQuestionIds,
    PCT.LinkedPostsCount,
    NTILE(5) OVER (ORDER BY UE.UserActivityScore DESC) AS PerformanceTier, -- Window function: NTILE for user performance tiers
    UTT.TagName AS TopTagContributed,
    UTT.TotalUserTagScore AS TopTagContributionScore,
    UTT.TotalUserTagPostCount AS TopTagPostCount,
    LOWER(SUBSTRING(U.Location, 1, 50)) AS UserLocationSnippet, -- String manipulation
    CASE
        WHEN U.WebsiteUrl IS NOT NULL AND U.WebsiteUrl LIKE 'http://%' THEN REPLACE(U.WebsiteUrl, 'http://', '')
        WHEN U.WebsiteUrl IS NOT NULL AND U.WebsiteUrl LIKE 'https://%' THEN REPLACE(U.WebsiteUrl, 'https://', '')
        ELSE U.WebsiteUrl -- Keep original if no match or NULL
    END AS CleanWebsiteUrl,
    COALESCE(SUBSTRING(U.AboutMe, 1, 200), 'No "About Me" provided') AS AboutMeTextSnippet, -- NULL logic, string manipulation
    POSITION('SQL' IN UPPER(COALESCE(U.AboutMe, ''))) > 0 AS IsSqlEnthusiast, -- String expression and NULL logic
    (SELECT AVG(PCA_Inner.TagCount) FROM PostContentAnalysis AS PCA_Inner WHERE PCA_Inner.OwnerUserId = UE.UserId AND PCA_Inner.TagCount > 0) AS AvgTagsPerPost -- Correlated subquery
FROM UserEngagement AS UE
LEFT JOIN Users AS U ON UE.UserId = U.Id -- Re-join Users for AboutMe, Location, WebsiteUrl
LEFT JOIN PostContentAnalysis AS PCA ON UE.UserId = PCA.OwnerUserId AND PCA.PostId = (
    SELECT P_Inner.Id FROM Posts AS P_Inner WHERE P_Inner.OwnerUserId = UE.UserId ORDER BY P_Inner.CreationDate DESC LIMIT 1
) -- Get analysis for the user's latest post
LEFT JOIN Posts AS PQ ON UE.UserId = PQ.OwnerUserId AND PQ.PostTypeId = 1 AND PQ.ViewCount = (
    SELECT MAX(P_Max.ViewCount) FROM Posts AS P_Max WHERE P_Max.OwnerUserId = UE.UserId AND P_Max.PostTypeId = 1
) -- Get user's most viewed question (can return multiple if tied)
LEFT JOIN PostClosingAndLinkTrends AS PCT ON PQ.Id = PCT.PostId -- Link closing/linking trends to the most viewed question
LEFT JOIN UserTopTagContribution AS UTT ON UE.UserId = UTT.OwnerUserId
WHERE UE.Reputation > 1000 -- Filter for more active/established users
  AND UE.TotalPosts > 5
  AND UE.LastAccessDate > cast('2024-10-01' as date) - INTERVAL '1 year' -- Recently active users
ORDER BY UE.UserActivityScore DESC, UE.Reputation DESC
LIMIT 500;