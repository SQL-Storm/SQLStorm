SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class,
    t.TagName,
    ph.RevisionGUID,
    ph.Comment,
    CASE 
        WHEN ph.PostHistoryTypeId = 10 THEN cr.Name
        WHEN ph.PostHistoryTypeId = 101 THEN 'Duplicate'
        WHEN ph.PostHistoryTypeId = 102 THEN 'Off-topic'
        WHEN ph.PostHistoryTypeId = 103 THEN 'Needs details or clarity'
        WHEN ph.PostHistoryTypeId = 104 THEN 'Needs more focus'
        WHEN ph.PostHistoryTypeId = 105 THEN 'Opinion-based'
    END AS CloseReason,
    v.VoteTypeId
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    CloseReasonTypes cr ON CAST(ph.Comment AS INTEGER) = cr.Id
LEFT JOIN 
    Votes v ON p.Id = v.PostId
LEFT JOIN 
    Tags t ON p.Tags LIKE '%' || t.TagName || '%'
WHERE 
    u.Reputation > 1000
    AND p.Score > 0
    AND p.LastEditDate > p.CreationDate
    AND p.ViewCount > 100
    AND p.AnswerCount > 0
    AND p.PostTypeId = 1
GROUP BY 
    u.DisplayName,
    u.Reputation,
    b.Class,
    t.TagName,
    ph.RevisionGUID,
    ph.Comment,
    ph.PostHistoryTypeId,
    cr.Name,
    v.VoteTypeId,
    p.Score
HAVING 
    COUNT(v.Id) > 1
ORDER BY 
    u.Reputation DESC,
    p.Score DESC
LIMIT 100;