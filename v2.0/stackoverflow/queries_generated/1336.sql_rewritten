-- {"query": "1336.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 2956} 
WITH UserQuestionDetails AS (
    -- Initial selection of question details, counting edits, and checking close status
    SELECT
        p.Id AS QuestionId,
        p.OwnerUserId,
        p.CreationDate AS QuestionCreationDate,
        p.AcceptedAnswerId,
        p.Score AS QuestionScore,
        p.ViewCount,
        p.AnswerCount,
        p.Tags,
        p.LastEditDate,
        p.LastActivityDate,
        -- Count distinct editing events for each question (Type 4: Edit Title, 5: Edit Body, 6: Edit Tags, 7: Rollback Title, 8: Rollback Body, 9: Rollback Tags)
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9) THEN ph.Id END) AS EditCount,
        -- Check if the question was ever explicitly closed
        MAX(CASE WHEN ph_close.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS WasClosed
    FROM Posts p
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId
    LEFT JOIN PostHistory ph_close ON p.Id = ph_close.PostId AND ph_close.PostHistoryTypeId = 10
    WHERE
        p.PostTypeId = 1 -- Filter for questions only
        AND p.CreationDate >= '2022-01-01' -- Focus on recent activity
        AND p.OwnerUserId IS NOT NULL
        AND p.Tags IS NOT NULL
    GROUP BY
        p.Id, p.OwnerUserId, p.CreationDate, p.AcceptedAnswerId, p.Score, p.ViewCount, p.AnswerCount, p.Tags, p.LastEditDate, p.LastActivityDate
),
FilteredQuestions AS (
    -- Filter questions based on complexity criteria
    SELECT
        q.QuestionId,
        q.OwnerUserId,
        q.QuestionCreationDate,
        q.AcceptedAnswerId,
        q.QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        q.Tags,
        q.LastEditDate,
        q.LastActivityDate
    FROM UserQuestionDetails q
    WHERE
        q.EditCount >= 2 -- Must have been edited at least twice
        AND q.AnswerCount >= 1 -- Must have at least one answer
        AND q.ViewCount > 150 -- Must have a decent view count
        AND NOT q.WasClosed -- Must not be a closed question
        AND (q.Tags LIKE '%<sql>%' OR q.Tags LIKE '%<database>%' OR q.Tags LIKE '%<performance>%') -- Must contain specific technical tags
),
UserQuestionAggregates AS (
    -- Aggregate question metrics per user
    SELECT
        fq.OwnerUserId,
        COUNT(fq.QuestionId) AS TotalQuestionsConsidered,
        SUM(fq.QuestionScore) AS TotalQuestionScore,
        AVG(fq.QuestionScore * 1.0) AS AvgQuestionScore,
        -- Correlated subquery: Find the maximum score of a high-scoring question by this user within a recent period
        (SELECT
            MAX(sq.QuestionScore)
         FROM UserQuestionDetails sq
         WHERE
            sq.OwnerUserId = fq.OwnerUserId
            AND sq.QuestionCreationDate >= (fq.QuestionCreationDate - INTERVAL '6 months') -- Within 6 months of the current question's creation date
            AND sq.QuestionScore > 50
        ) AS MaxRecentHighScoreQuestion,
        -- String expression: Indicate if the user has questions tagged with '<sql>'
        MAX(CASE WHEN fq.Tags LIKE '%<sql>%' THEN 'SQL_TAG_USED' ELSE NULL END) AS SqlTagPresenceIndicator
    FROM FilteredQuestions fq
    GROUP BY fq.OwnerUserId
    HAVING COUNT(fq.QuestionId) > 3 -- Only consider users with more than 3 qualifying questions
),
UserAnswerPerformance AS (
    -- Aggregate answer metrics per user, including a window function
    SELECT
        p.OwnerUserId,
        AVG(p.Score * 1.0) AS AvgAnswerScore,
        COUNT(p.Id) AS TotalAnswers,
        -- Window function: Rank users based on their average answer score
        RANK() OVER (ORDER BY AVG(p.Score * 1.0) DESC NULLS LAST) AS AnswerScoreRank
    FROM Posts p
    WHERE
        p.PostTypeId = 2 -- Filter for answers only
        AND p.OwnerUserId IS NOT NULL
        AND p.CreationDate >= '2022-01-01'
    GROUP BY p.OwnerUserId
    HAVING COUNT(p.Id) > 5 -- Only consider users with at least 5 answers
),
UserBadgeSummary AS (
    -- Summarize badge counts per user
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges, -- Count Gold badges
        SUM(CASE WHEN b.TagBased = TRUE THEN 1 ELSE 0 END) AS TagBasedBadges
    FROM Badges b
    GROUP BY b.UserId
),
UserTagUsage AS (
    -- Prepare data for finding the most frequent question tag for each user
    SELECT
        u.Id AS UserId,
        tag_exploded.tag_name,
        COUNT(*) AS tag_count
    FROM Users u
    JOIN Posts p ON u.Id = p.OwnerUserId
    -- Complicated string expression: split tags string into individual tags
    JOIN LATERAL UNNEST(string_to_array(SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2), '><')) AS tag_exploded(tag_name) ON TRUE
    WHERE
        p.PostTypeId = 1 -- Only questions for tag analysis
        AND p.Tags IS NOT NULL
        AND u.Id IS NOT NULL
    GROUP BY u.Id, tag_exploded.tag_name
),
MostFrequentUserTag AS (
    -- Use a window function to select the most frequent tag for each user
    SELECT
        UserId,
        tag_name AS MostFrequentQuestionTag
    FROM (
        SELECT
            UserId,
            tag_name,
            tag_count,
            ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY tag_count DESC, tag_name ASC) AS rn
        FROM UserTagUsage
    ) AS sub
    WHERE rn = 1
),
AcceptedAnswerLatency AS (
    -- Calculate the average time taken for questions to receive an accepted answer
    SELECT
        q.OwnerUserId AS UserId,
        -- Date calculation: Average time from question creation to accepted answer creation, in hours
        AVG(EXTRACT(EPOCH FROM (a.CreationDate - q.QuestionCreationDate)) / 3600.0) AS AvgAcceptLatencyHours,
        COUNT(q.AcceptedAnswerId) AS AcceptedAnswerCount
    FROM UserQuestionDetails q
    JOIN Posts a ON q.AcceptedAnswerId = a.Id
    WHERE
        q.AcceptedAnswerId IS NOT NULL
        AND q.OwnerUserId IS NOT NULL
        AND q.QuestionCreationDate IS NOT NULL AND a.CreationDate IS NOT NULL
    GROUP BY q.OwnerUserId
),
ProblematicUsers AS (
    -- Identify users involved in too many 'duplicate' post links
    SELECT
        p.OwnerUserId AS UserId
    FROM Posts p
    JOIN PostLinks pl ON p.Id = pl.PostId
    WHERE
        pl.LinkTypeId = 3 -- LinkType 3 indicates 'Duplicate'
        AND p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
    HAVING COUNT(DISTINCT pl.RelatedPostId) >= 3 -- If a user's posts are linked as duplicates to 3+ unique related posts
),
FinalUserRanking AS (
    -- Combine all calculated metrics and derive a composite engagement score
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        u.Views AS UserViews,
        u.UpVotes AS UserUpVotes,
        COALESCE(uqa.TotalQuestionsConsidered, 0) AS TotalRelevantQuestions,
        COALESCE(uqa.AvgQuestionScore, 0.0) AS AvgRelevantQuestionScore,
        COALESCE(uap.AvgAnswerScore, 0.0) AS AvgUserAnswerScore,
        COALESCE(ubs.TotalBadges, 0) AS TotalBadges,
        COALESCE(ubs.GoldBadges, 0) AS GoldBadges,
        mft.MostFrequentQuestionTag,
        COALESCE(aal.AvgAcceptLatencyHours, 0.0) AS AvgQuestionAcceptLatencyHours,
        -- Complicated expression: A weighted "Engagement Score" combining various user metrics
        (u.Reputation * 0.05) -- Base on reputation
        + (COALESCE(uqa.AvgQuestionScore, 0) * 0.8) -- High weight for question quality
        + (COALESCE(uap.AvgAnswerScore, 0) * 0.4) -- Medium weight for answer quality
        + (COALESCE(ubs.GoldBadges, 0) * 15) -- Significant boost for gold badges
        + (COALESCE(uqa.MaxRecentHighScoreQuestion, 0) * 0.1) -- Small boost for recent high-scoring questions
        - (CASE WHEN uqa.SqlTagPresenceIndicator IS NULL THEN 10 ELSE 0 END) -- Penalty if no SQL tag in relevant questions
        - (CASE WHEN uap.TotalAnswers IS NULL OR uap.TotalAnswers < 10 THEN (10 - COALESCE(uap.TotalAnswers, 0)) * 2 ELSE 0 END) -- Penalty for low answer count
        + (CASE WHEN u.AboutMe IS NOT NULL AND LENGTH(u.AboutMe) > 100 THEN 5 ELSE 0 END) -- Bonus for detailed 'About Me'
        AS UserEngagementScore,
        -- String expression with NULL and length logic for formatting user location
        CASE
            WHEN u.Location IS NULL OR TRIM(u.Location) = '' THEN 'Unspecified'
            WHEN LENGTH(u.Location) > 40 THEN LEFT(u.Location, 37) || '...'
            ELSE u.Location
        END AS FormattedLocation,
        -- Date arithmetic: Calculate the age of the user account as an INTERVAL
        (u.LastAccessDate - u.CreationDate) AS UserAccountAgeInterval,
        -- Non-correlated subquery: Count posts commented on by the user in the last year
        (SELECT COUNT(DISTINCT c.PostId) FROM Comments c WHERE c.UserId = u.Id AND c.CreationDate >= (u.LastAccessDate - INTERVAL '1 year')) AS RecentCommentedPostsCount
    FROM Users u
    LEFT JOIN UserQuestionAggregates uqa ON u.Id = uqa.OwnerUserId
    LEFT JOIN UserAnswerPerformance uap ON u.Id = uap.OwnerUserId
    LEFT JOIN UserBadgeSummary ubs ON u.Id = ubs.UserId
    LEFT JOIN MostFrequentUserTag mft ON u.Id = mft.UserId
    LEFT JOIN AcceptedAnswerLatency aal ON u.Id = aal.UserId
    WHERE
        u.Reputation > 2500 -- Minimum reputation
        AND u.Views > 200 -- Minimum profile views
        AND u.DisplayName IS NOT NULL
        -- Exclude users identified as problematic
        AND u.Id NOT IN (SELECT UserId FROM ProblematicUsers)
        -- Non-correlated subquery as part of a complex predicate: Ensure user has posted at least one question in the last 3 years
        AND EXISTS (
            SELECT 1
            FROM Posts p_check
            WHERE p_check.OwnerUserId = u.Id
              AND p_check.PostTypeId = 1
              AND p_check.CreationDate >= (cast('2024-10-01' as date) - INTERVAL '3 years')
            LIMIT 1
        )
)
-- Final selection and ranking of the top engaged users
SELECT
    UserId,
    DisplayName,
    FormattedLocation,
    Reputation,
    TotalRelevantQuestions,
    AvgRelevantQuestionScore,
    AvgUserAnswerScore,
    TotalBadges,
    GoldBadges,
    MostFrequentQuestionTag,
    AvgQuestionAcceptLatencyHours,
    UserEngagementScore,
    UserAccountAgeInterval,
    RecentCommentedPostsCount,
    -- Final window function: Densely rank users based on their engagement score
    DENSE_RANK() OVER (ORDER BY UserEngagementScore DESC, Reputation DESC, TotalRelevantQuestions DESC) AS OverallEngagementRank
FROM FinalUserRanking
WHERE
    AvgRelevantQuestionScore > 0 -- Ensure user has actual relevant question activity
    AND TotalRelevantQuestions > 0
ORDER BY OverallEngagementRank ASC, UserId ASC
LIMIT 50;