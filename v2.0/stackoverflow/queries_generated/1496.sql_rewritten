-- {"query": "1496.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3086} 
WITH UserEngagementSummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.UpVotes AS UserUpvotesGiven,
        U.DownVotes AS UserDownvotesGiven,
        U.Views AS UserProfileViews,
        COUNT(DISTINCT P.Id) AS TotalPostsCreated,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        SUM(P.ViewCount) AS SumPostViews,
        SUM(P.Score) AS SumPostScore,
        SUM(COALESCE(P.FavoriteCount, 0)) AS SumPostFavorites,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        MAX(PH.CreationDate) AS LastPostHistoryEvent,
        -- Correlated subquery for questions with accepted answers
        (SELECT COUNT(DISTINCT Q_sub.Id)
         FROM Posts Q_sub
         WHERE Q_sub.OwnerUserId = U.Id
           AND Q_sub.PostTypeId = 1
           AND Q_sub.AcceptedAnswerId IS NOT NULL
        ) AS QuestionsWithAcceptedAnswers,
        -- Correlated subquery for total upvotes received on all posts by this user
        (SELECT SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END)
         FROM Votes V
         WHERE V.PostId IN (SELECT P_sub.Id FROM Posts P_sub WHERE P_sub.OwnerUserId = U.Id)
           AND V.VoteTypeId = 2
        ) AS TotalUpvotesReceivedOnPosts,
        -- Correlated subquery for total downvotes received on all posts by this user
        (SELECT SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END)
         FROM Votes V
         WHERE V.PostId IN (SELECT P_sub.Id FROM Posts P_sub WHERE P_sub.OwnerUserId = U.Id)
           AND V.VoteTypeId = 3
        ) AS TotalDownvotesReceivedOnPosts
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    LEFT JOIN PostHistory PH ON U.Id = PH.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate,
        U.UpVotes, U.DownVotes, U.Views
),
PostContentMetrics AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.Score AS PostScore,
        P.ViewCount,
        P.CreationDate,
        P.LastActivityDate,
        P.FavoriteCount,
        P.CommentCount,
        P.AnswerCount,
        LENGTH(COALESCE(P.Body, '')) AS BodyLength,
        LENGTH(COALESCE(P.Title, '')) AS TitleLength,
        COALESCE(ARRAY_LENGTH(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'), 1), 0) AS TagCount,
        COUNT(DISTINCT C_ext.Id) AS ExternalCommentCount, -- Comments by users other than the post owner or by anonymous
        AVG(CASE WHEN A.PostTypeId = 2 THEN A.Score END) AS AvgAnswerScore,
        MAX(CASE WHEN A.PostTypeId = 2 THEN A.CreationDate END) AS LatestAnswerDate,
        SUM(CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN 1 ELSE 0 END) AS TotalEditsToPostContent,
        MAX(CASE WHEN PH.PostHistoryTypeId IN (10, 101, 102, 103, 104, 105) THEN 1 ELSE 0 END) AS WasClosedFlag,
        COALESCE(P.ClosedDate, '1900-01-01 00:00:00') AS ActualClosedDate
    FROM Posts P
    LEFT JOIN Comments C_ext ON P.Id = C_ext.PostId AND C_ext.UserId != P.OwnerUserId -- Assuming OwnerUserId can be NULL for community posts
    LEFT JOIN Posts A ON P.Id = A.ParentId AND A.PostTypeId = 2
    LEFT JOIN PostHistory PH ON P.Id = PH.PostId
    GROUP BY
        P.Id, P.PostTypeId, P.OwnerUserId, P.Score, P.ViewCount, P.CreationDate, P.LastActivityDate,
        P.FavoriteCount, P.CommentCount, P.AnswerCount, P.Body, P.Title, P.Tags, P.ClosedDate
),
TagPerformance AS (
    SELECT
        T.TagName,
        COUNT(PTA.PostId) AS TaggedPostsCount,
        SUM(PTA.PostScore) AS TotalTagScore,
        AVG(PTA.PostScore) AS AverageTagPostScore,
        COUNT(DISTINCT PTA.OwnerUserId) AS UniqueContributorsToTag,
        RANK() OVER (ORDER BY COUNT(PTA.PostId) DESC, SUM(PTA.PostScore) DESC) AS TagPopularityRank
    FROM Tags T
    INNER JOIN (
        SELECT
            P.Id AS PostId,
            P.Score AS PostScore,
            P.OwnerUserId,
            TRIM(UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'))) AS TagName
        FROM Posts P
        WHERE P.PostTypeId = 1 AND P.Tags IS NOT NULL AND LENGTH(P.Tags) > 2
    ) PTA ON T.TagName = PTA.TagName
    GROUP BY T.TagName
),
UserPostHistoryAggregates AS (
    SELECT
        PH.UserId,
        PH.PostId,
        COUNT(PH.Id) AS EditCountForPost,
        MAX(PH.CreationDate) AS LatestEditDate,
        MIN(PH.CreationDate) AS FirstEditDate,
        EXTRACT(EPOCH FROM (MAX(PH.CreationDate) - MIN(PH.CreationDate))) / 3600.0 AS TimeSpanBetweenFirstAndLastEditHours,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId IN (1,2,3) THEN PH.Id END) AS InitialContentHistoryEntries,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId IN (4,5,6) THEN PH.Id END) AS ContentEditHistoryEntries,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId IN (10,11,12,13,14,15,19,20,35) THEN PH.Id END) AS StatusChangeHistoryEntries,
        -- Correlated subquery for duplicate links from this post
        (SELECT COUNT(*) FROM PostLinks PL WHERE PL.PostId = PH.PostId AND PL.LinkTypeId = 3) AS DuplicateLinksFromPostCount,
        -- Correlated subquery for duplicate links to this post
        (SELECT COUNT(*) FROM PostLinks PL WHERE PL.RelatedPostId = PH.PostId AND PL.LinkTypeId = 3) AS IsDuplicatedByCount
    FROM PostHistory PH
    WHERE PH.UserId IS NOT NULL
    GROUP BY PH.UserId, PH.PostId
),
UserActivityAndRankings AS (
    SELECT
        UES.UserId,
        UES.DisplayName,
        UES.Reputation,
        UES.TotalPostsCreated,
        UES.TotalQuestions,
        UES.TotalAnswers,
        UES.TotalCommentsMade,
        UES.TotalBadges,
        UES.SumPostScore,
        UES.SumPostFavorites,
        UES.TotalUpvotesReceivedOnPosts,
        UES.TotalDownvotesReceivedOnPosts,
        UES.QuestionsWithAcceptedAnswers,
        UES.UserCreationDate,
        UES.LastAccessDate,
        -- Correlated subquery for recent upvotes given by the user
        (SELECT COUNT(DISTINCT V.PostId)
         FROM Votes V
         WHERE V.UserId = UES.UserId
           AND V.VoteTypeId = 2
           AND V.CreationDate >= UES.LastAccessDate - INTERVAL '30 days'
        ) AS RecentUpvotesGiven,
        -- Correlated subquery for recent downvotes given by the user
        (SELECT COUNT(DISTINCT V.PostId)
         FROM Votes V
         WHERE V.UserId = UES.UserId
           AND V.VoteTypeId = 3
           AND V.CreationDate >= UES.LastAccessDate - INTERVAL '30 days'
        ) AS RecentDownvotesGiven,
        SUM(PCM.PostScore) OVER (PARTITION BY UES.UserId) AS UserTotalPostScoreAgg,
        AVG(PCM.ViewCount) OVER (PARTITION BY UES.UserId) AS UserAvgPostViews,
        COUNT(DISTINCT UPHA.PostId) OVER (PARTITION BY UES.UserId) AS UniquePostsWithHistoryEdits,
        SUM(UPHA.EditCountForPost) OVER (PARTITION BY UES.UserId) AS TotalPostEditsByUser,
        NTILE(10) OVER (ORDER BY UES.Reputation DESC, UES.TotalUpvotesReceivedOnPosts DESC) AS ReputationDecileRank,
        ROW_NUMBER() OVER (PARTITION BY UES.UserId ORDER BY UPHA.LatestEditDate DESC, UPHA.PostId DESC) AS rn_post_history_for_user_filter -- Pick one representative history entry per user if multiple
    FROM UserEngagementSummary UES
    LEFT JOIN PostContentMetrics PCM ON UES.UserId = PCM.OwnerUserId
    LEFT JOIN UserPostHistoryAggregates UPHA ON UES.UserId = UPHA.UserId
    WHERE UES.Reputation >= 100 -- Filter for users with a minimum reputation
)
SELECT
    URA.UserId,
    URA.DisplayName,
    URA.Reputation,
    URA.TotalPostsCreated,
    URA.TotalQuestions,
    URA.TotalAnswers,
    URA.TotalCommentsMade,
    URA.TotalBadges,
    URA.SumPostScore,
    URA.SumPostFavorites,
    URA.TotalUpvotesReceivedOnPosts,
    URA.TotalDownvotesReceivedOnPosts,
    URA.QuestionsWithAcceptedAnswers,
    URA.RecentUpvotesGiven,
    URA.RecentDownvotesGiven,
    URA.UserAvgPostViews,
    URA.UniquePostsWithHistoryEdits,
    URA.TotalPostEditsByUser,
    URA.ReputationDecileRank,
    (
        SELECT
            TRIM(UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'))) AS Tag
        FROM Posts P
        WHERE P.OwnerUserId = URA.UserId
        AND P.PostTypeId = 1
        AND P.Tags IS NOT NULL AND LENGTH(P.Tags) > 2
        GROUP BY Tag
        ORDER BY COUNT(P.Id) DESC, SUM(P.Score) DESC
        LIMIT 1
    ) AS MostFrequentTagByPostsAndScore,
    TP.TagName AS TopOverallPopularTag,
    TP.TaggedPostsCount AS TopOverallPopularTagPosts,
    TP.TotalTagScore AS TopOverallPopularTagScore,
    TP.TagPopularityRank AS TopOverallPopularTagRank,
    CAST(URA.QuestionsWithAcceptedAnswers AS DECIMAL) / COALESCE(NULLIF(URA.TotalQuestions, 0), 1.0) AS AcceptedAnswerRatio,
    CAST(URA.TotalUpvotesReceivedOnPosts AS DECIMAL) / COALESCE(NULLIF(URA.TotalPostsCreated, 0), 1.0) AS AvgUpvotesPerPost,
    CASE
        WHEN URA.Reputation > 5000 AND URA.TotalQuestions > 10 AND URA.QuestionsWithAcceptedAnswers > 5 THEN 'Guru'
        WHEN URA.Reputation > 1000 AND URA.TotalAnswers > 20 AND URA.SumPostScore > 100 THEN 'Expert'
        WHEN URA.Reputation > 200 AND URA.TotalPostsCreated > 5 THEN 'Contributor'
        ELSE 'Novice'
    END AS UserCategory,
    'Complex StackOverflow User Benchmark Query v1.0' AS QueryIdentifier,
    AGE(cast('2024-10-01 12:34:56' as timestamp), URA.UserCreationDate) AS UserAge
FROM UserActivityAndRankings URA
LEFT JOIN TagPerformance TP ON TP.TagPopularityRank = 1 -- Get the single most popular tag overall
WHERE URA.rn_post_history_for_user_filter = 1 -- Ensure we pick one representative history record per user from the join
AND URA.ReputationDecileRank <= 3 -- Focus on top 30% of users by reputation
AND URA.UserCreationDate < (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '5 year') -- Filter for older, established users
AND URA.TotalPostsCreated > 0
ORDER BY URA.Reputation DESC, URA.TotalUpvotesReceivedOnPosts DESC, URA.TotalPostsCreated DESC
LIMIT 1000;