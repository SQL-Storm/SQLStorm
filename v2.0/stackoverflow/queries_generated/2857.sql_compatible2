with RecursiveTagIssues as (
    select
        t.Id as TagId,
        t.TagName,
        p.Id as PostId,
        p.Title,
        p.OwnerUserId,
        p.CreationDate,
        ph.CreationDate as LastTagEditDate,
        ph.UserId as LastTagEditor,
        row_number() over (partition by t.Id order by ph.CreationDate desc) as rn
    from
        Tags t
        left join Posts p on p.PostTypeId = 1 and p.Tags like '%' || '<' || t.TagName || '>' || '%'
        left join PostHistory ph on ph.PostId = p.Id and ph.PostHistoryTypeId in (3,6,9)
    where
        t.IsModeratorOnly = false and t.IsRequired = false
),
LatestTagEdits as (
    select
        TagId,
        TagName,
        PostId,
        Title,
        OwnerUserId,
        CreationDate,
        LastTagEditDate,
        LastTagEditor
    from RecursiveTagIssues
    where rn = 1
),
UserBadges as (
    select
        b.UserId,
        b.Name,
        b.Class,
        b.TagBased,
        count(*) over (partition by b.UserId) as TotalBadges
    from Badges b
),
UserEliteBadgeCounts as (
    select
        UserId,
        sum(case when Class = 1 then 1 else 0 end) as GoldBadges,
        sum(case when Class = 2 then 1 else 0 end) as SilverBadges,
        sum(case when Class = 3 then 1 else 0 end) as BronzeBadges
    from Badges
    group by UserId
),
UserRankings as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        coalesce(eb.GoldBadges,0) as GoldBadges,
        coalesce(eb.SilverBadges,0) as SilverBadges,
        coalesce(eb.BronzeBadges,0) as BronzeBadges,
        rank() over (order by u.Reputation desc, u.CreationDate) as RepRank,
        dense_rank() over (order by coalesce(eb.GoldBadges,0) desc, u.Reputation desc) as BadgeEliteRank
    from Users u
    left join UserEliteBadgeCounts eb on eb.UserId = u.Id
),
TopPosts as (
    select
        p.Id,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.PostTypeId,
        p.Title,
        p.AcceptedAnswerId,
        count(c.Id) as CommentCount,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes
    from
        Posts p
        left join Comments c on c.PostId = p.Id
        left join Votes v on v.PostId = p.Id and v.VoteTypeId in (2,3)
    where
        p.PostTypeId in (1,2)
    group by p.Id, p.OwnerUserId, p.Score, p.ViewCount, p.CreationDate, p.PostTypeId, p.Title, p.AcceptedAnswerId
),
AcceptedAnswerDetails as (
    select
        p.Id,
        p.ParentId,
        p.Score as AnswerScore,
        p.OwnerUserId as AnswerOwner,
        p.CreationDate as AnswerCreationDate
    from Posts p
    where p.PostTypeId = 2
),
QuestionsWithAcceptedAnswer as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId as QuestionOwner,
        q.Score as QuestionScore,
        q.ViewCount,
        q.CreationDate as QuestionCreationDate,
        a.Id as AcceptedAnswerId,
        a.AnswerOwner,
        a.AnswerScore,
        a.AnswerCreationDate
    from Posts q
    left join AcceptedAnswerDetails a on a.Id = q.AcceptedAnswerId
    where q.PostTypeId = 1
),
RankedAnswers as (
    select
        p.Id as AnswerId,
        p.ParentId as QuestionId,
        p.Score,
        p.CreationDate,
        row_number() over (partition by p.ParentId order by p.Score desc, p.CreationDate) as AnswerRank
    from Posts p
    where p.PostTypeId = 2
),
FilteredAnswers as (
    select
        r.AnswerId,
        r.QuestionId,
        r.Score,
        r.CreationDate,
        q.Title as QuestionTitle,
        u.DisplayName as AnswerOwnerName,
        u.Reputation as AnswerOwnerRep,
        qwa.AnswerScore as AcceptedAnswerScore,
        qwa.AnswerOwner as AcceptedAnswerOwnerId
    from RankedAnswers r
    join Posts q on q.Id = r.QuestionId
    join Users u on u.Id = q.OwnerUserId
    left join QuestionsWithAcceptedAnswer qwa on qwa.QuestionId = r.QuestionId
    where r.AnswerRank = 1 and r.Score > coalesce(qwa.AnswerScore,0)
),
HighRepUsersWithNoAcceptedAnswer as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        count(p.Id) over(partition by u.Id) as TotalQuestions,
        count(q.AcceptedAnswerId) over(partition by u.Id) as QuestionsWithAcceptedAnswer
    from Users u
    left join Posts p on p.OwnerUserId = u.Id and p.PostTypeId = 1
    left join QuestionsWithAcceptedAnswer q on q.QuestionId = p.Id
    where u.Reputation > 10000
),
UserVoteSummary as (
    select
        v.UserId,
        sum(case when vt.Name = 'UpMod' then 1 else 0 end) as UpVotesGiven,
        sum(case when vt.Name = 'DownMod' then 1 else 0 end) as DownVotesGiven,
        count(distinct v.PostId) as DistinctPostsVoted
    from Votes v
    join VoteTypes vt on vt.Id = v.VoteTypeId
    where v.UserId is not null
    group by v.UserId
)
select
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    coalesce(ubc.GoldBadges,0) as GoldBadges,
    coalesce(ubc.SilverBadges,0) as SilverBadges,
    coalesce(ubc.BronzeBadges,0) as BronzeBadges,
    hruwa.TotalQuestions,
    hruwa.QuestionsWithAcceptedAnswer,
    uv.UpVotesGiven,
    uv.DownVotesGiven,
    uv.DistinctPostsVoted,
    max(case when tp.PostTypeId = 1 then tp.Score end) as MaxQuestionScore,
    max(case when tp.PostTypeId = 2 then tp.Score end) as MaxAnswerScore,
    (case when u.WebsiteUrl is null then 'No Website' else
        ('Website: ' || substring(u.WebsiteUrl from 1 for 30) ||
            case when char_length(u.WebsiteUrl) > 30 then '...' else '' end)
    end) as ShortWebsite,
    ('User created: ' || to_char(u.CreationDate, 'YYYY-MM-DD')) as CreatedDateInfo,
    (select count(ph.Id) from PostHistory ph where ph.UserId = u.Id and ph.PostHistoryTypeId = 6) as TagEditsMade,
    (select count(pl.Id) from PostLinks pl where pl.PostId in (select Id from Posts where OwnerUserId = u.Id)) as LinksFromUserPosts,
    coalesce(lt.Name, 'No Favorite Vote') as FavoriteVoteTypeName
from
    Users u
    left join UserEliteBadgeCounts ubc on ubc.UserId = u.Id
    left join HighRepUsersWithNoAcceptedAnswer hruwa on hruwa.Id = u.Id
    left join UserVoteSummary uv on uv.UserId = u.Id
    left join TopPosts tp on tp.OwnerUserId = u.Id
    left join Votes fv on fv.UserId = u.Id and fv.VoteTypeId = 5
    left join VoteTypes lt on lt.Id = fv.VoteTypeId
where
    u.Id in (
        select OwnerUserId from Posts where PostTypeId = 1 and Score > 100 order by CreationDate desc limit 100
    )
group by
    u.Id,
    u.DisplayName,
    u.Reputation,
    ubc.GoldBadges,
    ubc.SilverBadges,
    ubc.BronzeBadges,
    hruwa.TotalQuestions,
    hruwa.QuestionsWithAcceptedAnswer,
    uv.UpVotesGiven,
    uv.DownVotesGiven,
    uv.DistinctPostsVoted,
    ShortWebsite,
    CreatedDateInfo,
    lt.Name
order by
    u.Reputation desc,
    GoldBadges desc,
    TotalQuestions desc
limit 50;