WITH
user_agg AS (
    SELECT
        u.Id                               AS user_id,
        u.DisplayName,
        COALESCE(u.Reputation, 0)          AS reputation,
        COUNT(p.Id)                        AS total_posts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS answers,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.PostId END) AS upvoted_posts,
        COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.PostId END) AS downvoted_posts,
        COUNT(b.Id)                        AS badges_earned,
        MIN(u.CreationDate)               AS first_seen,
        MAX(p.CreationDate)               AS last_post_date
    FROM Users u
    LEFT JOIN Posts p   ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v   ON v.UserId = u.Id
    LEFT JOIN Badges b  ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),

tag_stats AS (
    SELECT
        t.Id           AS tag_id,
        t.TagName,
        t.Count        AS tag_question_count,
        COALESCE(e.PostId, 0)   AS excerpt_post_id,
        COALESCE(w.PostId, 0)   AS wiki_post_id,
        AVG(CASE WHEN p.Score IS NOT NULL AND p.PostTypeId = 1 THEN p.Score END) AS avg_question_score,
        MAX(CASE WHEN p.CreationDate IS NOT NULL AND p.PostTypeId = 1 THEN p.CreationDate END) AS latest_question_date
    FROM Tags t
    LEFT JOIN Posts e ON e.Id = t.ExcerptPostId
    LEFT JOIN Posts w ON w.Id = t.WikiPostId
    LEFT JOIN PostTags pt ON pt.TagId = t.Id
    LEFT JOIN Posts p ON p.Id = pt.PostId
    GROUP BY t.Id, t.TagName, t.Count, e.PostId, w.PostId
),

top_posts AS (
    SELECT
        p.OwnerUserId               AS user_id,
        p.Id                        AS post_id,
        p.Title,
        p.Score,
        p.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC, p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.PostTypeId IN (1,2)
),

latest_badge AS (
    SELECT
        b.UserId      AS user_id,
        b.Name        AS badge_name,
        b.Date        AS awarded_on
    FROM Badges b
    WHERE b.Date = (
        SELECT MAX(b2.Date)
        FROM Badges b2
        WHERE b2.UserId = b.UserId
    )
),

high_rep_vs_tagged AS (
    SELECT user_id FROM user_agg WHERE reputation >= 20000
    UNION
    SELECT ub.user_id
    FROM (
        SELECT
            t.OwnerUserId AS user_id,
            COUNT(DISTINCT t.tag) AS distinct_tags
        FROM (
            SELECT
                p.OwnerUserId,
                TRIM(s.tag) AS tag
            FROM Posts p
            CROSS JOIN LATERAL (
                SELECT regexp_split_to_table(p.Tags, '><') AS tag
            ) s
            WHERE p.Tags IS NOT NULL AND p.Tags <> ''
        ) t
        GROUP BY t.OwnerUserId
        HAVING COUNT(DISTINCT t.tag) >= 15
    ) ub
),

final_set AS (
    SELECT
        ua.user_id,
        ua.DisplayName,
        ua.reputation,
        ua.total_posts,
        ua.questions,
        ua.answers,
        ua.upvoted_posts,
        ua.downvoted_posts,
        ua.badges_earned,
        ua.first_seen,
        ua.last_post_date,
        lb.badge_name,
        lb.awarded_on,
        tp.post_id,
        tp.Title,
        tp.Score    AS post_score,
        tp.CreationDate AS post_date,
        CASE
            WHEN ua.reputation IS NULL THEN 'No Rep'
            WHEN ua.reputation < 1000 THEN 'Newbie'
            WHEN ua.reputation >= 1000 AND ua.reputation <= 5000 THEN 'Intermediate'
            ELSE 'Expert'
        END AS reputation_tier,
        COALESCE(NULLIF(ua.total_posts,0),0) 
            + COALESCE(NULLIF(ua.badges_earned,0),0) 
            + COALESCE(NULLIF(ua.upvoted_posts,0),0) 
            - COALESCE(NULLIF(ua.downvoted_posts,0),0) AS activity_score
    FROM user_agg ua
    LEFT JOIN latest_badge lb          ON lb.user_id = ua.user_id
    LEFT JOIN top_posts tp            ON tp.user_id = ua.user_id AND tp.rn = 1
    WHERE ua.user_id IN (SELECT user_id FROM high_rep_vs_tagged)
)

SELECT
    fs.user_id,
    fs.DisplayName,
    fs.reputation,
    fs.total_posts,
    fs.questions,
    fs.answers,
    fs.upvoted_posts,
    fs.downvoted_posts,
    fs.badges_earned,
    fs.first_seen,
    fs.last_post_date,
    fs.badge_name,
    fs.awarded_on,
    fs.post_id,
    fs.Title,
    fs.post_score,
    fs.post_date,
    fs.reputation_tier,
    fs.activity_score,
    RANK() OVER (ORDER BY fs.activity_score DESC) AS activity_rank,
    PERCENT_RANK() OVER (ORDER BY fs.activity_score) AS activity_percentile,
    (SELECT STRING_AGG(t.tag_name, ', ')
     FROM (
         SELECT tag_name, rn FROM (
             SELECT
                 TRIM(tag) AS tag_name,
                 ROW_NUMBER() OVER () AS rn
             FROM Posts p
             CROSS JOIN LATERAL (
                 SELECT regexp_split_to_table(p.Tags, '><') AS tag
             ) s
             WHERE p.OwnerUserId = fs.user_id AND p.Tags IS NOT NULL AND p.Tags <> ''
         ) x
         WHERE tag_name IS NOT NULL
         ORDER BY rn
         LIMIT 3
     ) t) AS sample_tags,
    CASE 
        WHEN fs.last_post_date IS NOT NULL AND fs.last_post_date > fs.first_seen THEN 'Active Post'
        ELSE 'Never Posted'
    END AS post_activity_flag
FROM final_set fs
ORDER BY fs.activity_score DESC
LIMIT 100;