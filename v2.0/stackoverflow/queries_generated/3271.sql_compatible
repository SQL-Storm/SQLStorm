WITH UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS Questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS Answers,
        COALESCE(SUM(p.Score), 0) AS ScoreSum,
        AVG(p.Score) AS AvgScore,
        MAX(p.CreationDate) AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
BadgeAgg AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        -- aggregate named badges (non-tag-based)
        CASE WHEN COUNT(CASE WHEN b.TagBased = 0 THEN 1 END) = 0 THEN NULL
             ELSE LISTAGG(CASE WHEN b.TagBased = 0 THEN b.Name END, ', ') END AS NamedBadges,
        CASE WHEN COUNT(CASE WHEN b.TagBased = 1 THEN 1 END) = 0 THEN NULL
             ELSE LISTAGG(CASE WHEN b.TagBased = 1 THEN b.Name END, ', ') END AS TagBadges
    FROM Badges b
    GROUP BY b.UserId
),
TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rn
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
),
UserTagActivity AS (
    SELECT 
        u.Id AS UserId,
        pt.TagName,
        COUNT(*) AS TaggedPosts
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id
    CROSS JOIN LATERAL (
        -- split tags like '<tag1><tag2>' into rows; use replace and split where UNNEST may not exist
        -- implementation depends on dialect; here use a simple string split function fallback
        SELECT value AS TagName
        FROM (
            SELECT regexp_split_to_table(trim(BOTH '<>' FROM p.Tags), '\>\s*\<') AS value
        ) s
    ) pt
    JOIN Tags t ON t.TagName = pt.TagName
    GROUP BY u.Id, pt.TagName
),
RecentVotes AS (
    SELECT 
        v.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
        MAX(v.CreationDate) AS LastVoteDate
    FROM Votes v
    WHERE v.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY)
    GROUP BY v.PostId
)
SELECT 
    us.Id,
    us.DisplayName,
    us.Reputation,
    us.TotalPosts,
    us.Questions,
    us.Answers,
    us.ScoreSum,
    ROUND(us.AvgScore::numeric, 2) AS AvgScore,
    ba.GoldBadges,
    ba.SilverBadges,
    ba.BronzeBadges,
    ba.NamedBadges,
    ba.TagBadges,
    COALESCE(rv.UpVotes, 0) AS RecentUpVotes,
    COALESCE(rv.DownVotes, 0) AS RecentDownVotes,
    -- Top 5 global tags per TopTags.rn <=5 joined via LEFT JOIN below, aggregate distinct
    LISTAGG(tt.TagName, ', ') WITHIN GROUP (ORDER BY tt.TagName) AS Top5TagsGlobal,
    LISTAGG(uta.TagName || ':' || CAST(uta.TaggedPosts AS VARCHAR), ', ') WITHIN GROUP (ORDER BY uta.TagName) AS UserTopTags
FROM UserStats us
LEFT JOIN BadgeAgg ba ON ba.UserId = us.Id
LEFT JOIN RecentVotes rv ON rv.PostId IN (
    SELECT p.Id FROM Posts p WHERE p.OwnerUserId = us.Id
)
LEFT JOIN TopTags tt ON tt.rn <= 5
LEFT JOIN UserTagActivity uta ON uta.UserId = us.Id
WHERE us.Reputation > 10000
  AND (us.TotalPosts IS NULL OR us.TotalPosts > 10)
  AND (ba.GoldBadges IS NULL OR ba.GoldBadges >= 1)
GROUP BY 
    us.Id, us.DisplayName, us.Reputation, us.TotalPosts, us.Questions,
    us.Answers, us.ScoreSum, us.AvgScore,
    ba.GoldBadges, ba.SilverBadges, ba.BronzeBadges,
    ba.NamedBadges, ba.TagBadges,
    rv.UpVotes, rv.DownVotes
ORDER BY us.Reputation DESC
LIMIT 100
OFFSET 0
UNION ALL
SELECT 
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
WHERE 1=0;