-- {"query": "3658.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2211} 
WITH 
    -- Aggregate user statistics, including badge count and post scores
    UserStats AS (
        SELECT 
            u.Id                         AS UserId,
            u.DisplayName,
            u.Reputation,
            COUNT(b.Id)                  AS BadgeCount,
            SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS QuestionScoreSum,
            SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS AnswerScoreSum,
            COUNT(p.Id)                  AS TotalPosts
        FROM Users u
        LEFT JOIN Badges b   ON b.UserId = u.Id
        LEFT JOIN Posts p    ON p.OwnerUserId = u.Id
        GROUP BY u.Id, u.DisplayName, u.Reputation
    ),

    -- Compute the number of tags for each question (using Post.Tags stored as <tag1><tag2>…)
    TagUsage AS (
        SELECT 
            p.Id                               AS PostId,
            p.Tags,
            CASE 
                WHEN p.Tags IS NULL THEN 0
                ELSE array_length(string_to_array(substring(p.Tags,2,length(p.Tags)-2), '><'),1)
            END                                AS TagCount
        FROM Posts p
        WHERE p.PostTypeId = 1                -- only questions
    ),

    -- Rank each user's questions by score, keep the top one per user
    TopPosts AS (
        SELECT 
            p.Id,
            p.Title,
            p.Score,
            p.ViewCount,
            p.CreationDate,
            COALESCE(p.Tags,'')                AS Tags,
            tu.TagCount,
            ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS rn
        FROM Posts p
        LEFT JOIN TagUsage tu ON tu.PostId = p.Id
        WHERE p.PostTypeId = 1
          AND p.CreationDate >= DATE '2020-01-01'
    ),

    -- Comment aggregates per post
    CommentStats AS (
        SELECT 
            c.PostId,
            COUNT(*)                        AS CommentCount,
            MAX(c.CreationDate)             AS LastCommentDate
        FROM Comments c
        GROUP BY c.PostId
    ),

    -- Recent voting activity (last 30 days)
    RecentVotes AS (
        SELECT 
            v.PostId,
            SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        WHERE v.CreationDate >= cast('2024-10-01' as date) - INTERVAL '30 days'
        GROUP BY v.PostId
    ),

    -- Combine top‑post data with its comment and vote stats
    SelectedPosts AS (
        SELECT 
            tp.Id,
            tp.Title,
            tp.Score,
            tp.ViewCount,
            tp.Tags,
            tp.TagCount,
            cs.CommentCount,
            rv.UpVotes,
            rv.DownVotes
        FROM TopPosts tp
        LEFT JOIN CommentStats cs ON cs.PostId = tp.Id
        LEFT JOIN RecentVotes rv   ON rv.PostId = tp.Id
        WHERE tp.rn = 1
    )

-- Final result set
SELECT 
    us.UserId,
    us.DisplayName,
    us.Reputation,
    us.BadgeCount,
    us.QuestionScoreSum,
    us.AnswerScoreSum,
    us.TotalPosts,
    sp.Id                              AS TopPostId,
    sp.Title                           AS TopPostTitle,
    sp.Score                           AS TopPostScore,
    sp.ViewCount                       AS TopPostViews,
    sp.TagCount                        AS TopPostTagCount,
    COALESCE(sp.CommentCount,0)        AS TopPostCommentCount,
    COALESCE(sp.UpVotes,0) - COALESCE(sp.DownVotes,0) AS TopPostVoteBalance
FROM UserStats us
LEFT JOIN SelectedPosts sp 
       ON sp.Id = (
            SELECT p2.Id 
            FROM Posts p2 
            WHERE p2.OwnerUserId = us.UserId 
              AND p2.PostTypeId = 1 
            ORDER BY p2.Score DESC 
            LIMIT 1
          )
WHERE us.Reputation > 10000 
   OR us.BadgeCount >= 5
ORDER BY us.Reputation DESC, us.BadgeCount DESC
LIMIT 100

UNION ALL

-- Include very old users with no posts (to stress outer joins and set operators)
SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    0               AS BadgeCount,
    0               AS QuestionScoreSum,
    0               AS AnswerScoreSum,
    0               AS TotalPosts,
    NULL            AS TopPostId,
    NULL            AS TopPostTitle,
    NULL            AS TopPostScore,
    NULL            AS TopPostViews,
    NULL            AS TopPostTagCount,
    NULL            AS TopPostCommentCount,
    NULL            AS TopPostVoteBalance
FROM Users u
WHERE NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id)
  AND u.CreationDate < DATE '2010-01-01'
ORDER BY u.Reputation DESC
LIMIT 10;