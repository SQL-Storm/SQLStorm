WITH UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, '[unknown]') AS Location,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
        (SELECT AVG(v.Score) FROM Votes v JOIN Posts p2 ON v.PostId = p2.Id
         WHERE p2.OwnerUserId = u.Id AND v.VoteTypeId = 2) AS AvgUpVoteScore
    FROM Users u
    WHERE u.Reputation > 1000
),
RecentActivity AS (
    SELECT
        u.Id,
        GREATEST(
            COALESCE(MAX(p.LastActivityDate), TIMESTAMP '1970-01-01'),
            COALESCE(MAX(c.CreationDate),   TIMESTAMP '1970-01-01')
        ) AS MostRecentActivity
    FROM Users u
    LEFT JOIN Posts    p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId   = u.Id
    GROUP BY u.Id
),
TagPopularity AS (
    SELECT
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS TagRank
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
),
TopTagPosts AS (
    SELECT
        p.Id,
        p.OwnerUserId,
        p.Title,
        STRING_AGG(t.TagName, ',') AS TagList,
        p.Score,
        p.ViewCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS RankPerUser
    FROM Posts p
    JOIN LATERAL (
        SELECT unnest(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) AS TagName
    ) pt ON true
    JOIN Tags t ON t.TagName = pt.TagName
    WHERE p.PostTypeId = 1
      AND p.Tags IS NOT NULL
    GROUP BY p.Id, p.OwnerUserId, p.Title, p.Score, p.ViewCount
),
Combined AS (
    SELECT
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.Location,
        us.GoldBadges,
        us.SilverBadges,
        us.BronzeBadges,
        us.QuestionCount,
        us.AnswerCount,
        us.AvgUpVoteScore,
        ra.MostRecentActivity,
        CASE
            WHEN ra.MostRecentActivity > CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30 days' THEN 'Active'
            ELSE 'Stale'
        END AS ActivityStatus
    FROM UserStats us
    JOIN RecentActivity ra ON ra.Id = us.Id
)
SELECT
    c.Id,
    c.DisplayName,
    c.Reputation,
    c.Location,
    c.GoldBadges,
    c.SilverBadges,
    c.BronzeBadges,
    c.QuestionCount,
    c.AnswerCount,
    ROUND(COALESCE(c.AvgUpVoteScore,0),2) AS AvgUpVoteScore,
    c.ActivityStatus,
    tp.Title      AS TopQuestion,
    tp.TagList    AS TopQuestionTags,
    tp.Score      AS TopQuestionScore,
    tp.ViewCount  AS TopQuestionViews
FROM Combined c
LEFT JOIN (
    SELECT
        tp.OwnerUserId,
        tp.Title,
        tp.TagList,
        tp.Score,
        tp.ViewCount,
        ROW_NUMBER() OVER (PARTITION BY tp.OwnerUserId ORDER BY tp.Score DESC) AS rn
    FROM TopTagPosts tp
    WHERE tp.RankPerUser = 1
) tp ON tp.OwnerUserId = c.Id AND tp.rn = 1
WHERE c.Reputation > (
    SELECT PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY Reputation) FROM Users
)
ORDER BY c.Reputation DESC
LIMIT 100

UNION ALL

SELECT
    NULL::bigint AS Id,
    '---'::text AS DisplayName,
    NULL::integer AS Reputation,
    NULL::text AS Location,
    NULL::integer AS GoldBadges,
    NULL::integer AS SilverBadges,
    NULL::integer AS BronzeBadges,
    NULL::integer AS QuestionCount,
    NULL::integer AS AnswerCount,
    NULL::numeric AS AvgUpVoteScore,
    NULL::text AS ActivityStatus,
    NULL::text AS TopQuestion,
    NULL::text AS TopQuestionTags,
    NULL::integer AS TopQuestionScore,
    NULL::integer AS TopQuestionViews
FROM (SELECT 1) AS dummy;