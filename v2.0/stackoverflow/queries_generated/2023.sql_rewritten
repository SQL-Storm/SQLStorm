-- {"query": "2023.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1731} 
WITH RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.IsModeratorOnly,
        t.IsRequired,
        1 AS Level,
        ARRAY[t.Id] AS Path
    FROM Tags t
    WHERE NOT t.IsModeratorOnly = 1

    UNION ALL

    SELECT
        t.Id,
        t.TagName,
        t.Count,
        t.IsModeratorOnly,
        t.IsRequired,
        r.Level + 1,
        r.Path || t.Id
    FROM Tags t
    JOIN PostLinks pl ON pl.PostId = t.ExcerptPostId
    JOIN RecursiveTagHierarchy r ON r.Id = pl.RelatedPostId
    WHERE NOT t.IsModeratorOnly = 1 AND NOT t.Id = ANY(r.Path)
),
RecentActiveUsers AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COUNT(DISTINCT p.Id) AS PostCount,
        SUM(COALESCE(p.Score,0)) AS TotalPostScore,
        SUM(COALESCE(vt.UpVotes,0)) AS TotalUpVotes,
        SUM(COALESCE(vt.DownVotes,0)) AS TotalDownVotes,
        MAX(b.Date) AS LastBadgeDate,
        COUNT(b.Id) AS BadgeCount
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
        AND p.CreationDate > cast('2024-10-01' as date) - INTERVAL '1 year'
    LEFT JOIN (
        SELECT v.PostId,
            SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
        GROUP BY v.PostId
    ) vt ON vt.PostId = p.Id
    LEFT JOIN Badges b ON b.UserId = u.Id
    WHERE u.LastAccessDate > cast('2024-10-01' as date) - INTERVAL '6 months'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
),
QuestionAnswerStats AS (
    SELECT
        q.Id AS QuestionId,
        q.Title,
        q.CreationDate,
        q.ViewCount,
        q.Score AS QuestionScore,
        COUNT(a.Id) AS AnswerCount,
        AVG(COALESCE(a.Score,0)) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore,
        SUM(COALESCE(vt.UpVotes,0)) AS TotalUpVotesOnQuestionAndAnswers
    FROM Posts q
    LEFT JOIN Posts a ON a.ParentId = q.Id AND a.PostTypeId = 2
    LEFT JOIN (
        SELECT v.PostId,
            SUM(CASE WHEN vt.Name = 'UpMod' THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
        GROUP BY v.PostId
    ) vt ON vt.PostId IN (q.Id, a.Id)
    WHERE q.PostTypeId = 1
    GROUP BY q.Id, q.Title, q.CreationDate, q.ViewCount, q.Score
),
UserRankings AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.PostCount,
        u.TotalPostScore,
        u.TotalUpVotes,
        u.TotalDownVotes,
        u.BadgeCount,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.LastAccessDate DESC) AS ReputationRank,
        RANK() OVER (ORDER BY u.BadgeCount DESC, u.TotalUpVotes DESC) AS BadgeRank
    FROM RecentActiveUsers u
),
PostHistoryFiltering AS (
    SELECT
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ph.UserId,
        ph.Comment,
        ph.Text,
        p.Title,
        u.DisplayName AS EditorName,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory ph
    LEFT JOIN Posts p ON p.Id = ph.PostId
    LEFT JOIN Users u ON u.Id = ph.UserId
    WHERE ph.PostHistoryTypeId IN (4,5,6,10,11,14)
      AND ph.CreationDate > cast('2024-10-01' as date) - INTERVAL '2 years'
),
LatestPostHistories AS (
    SELECT *
    FROM PostHistoryFiltering
    WHERE rn = 1
),
DuplicatePostLinks AS (
    SELECT pl.PostId, pl.RelatedPostId, pl.CreationDate
    FROM PostLinks pl
    WHERE pl.LinkTypeId = 3
),
FinalSelection AS (
    SELECT
        qa.QuestionId,
        qa.Title AS QuestionTitle,
        qa.CreationDate AS QuestionDate,
        qa.ViewCount,
        qa.QuestionScore,
        qa.AnswerCount,
        qa.AvgAnswerScore,
        qa.MaxAnswerScore,
        qa.TotalUpVotesOnQuestionAndAnswers,
        ur.DisplayName AS TopUserDisplayName,
        ur.Reputation,
        ur.BadgeCount,
        lph.PostHistoryTypeId,
        lph.CreationDate AS LastEditDate,
        lph.EditorName,
        STRING_AGG(DISTINCT t.TagName, ', ') AS AllTags,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT dpl.RelatedPostId) AS DuplicateCount,
        CASE
            WHEN qa.AnswerCount = 0 THEN 'Unanswered'
            WHEN qa.MaxAnswerScore >= 10 THEN 'Highly Rated Answer'
            ELSE 'Normal'
        END AS QuestionStatus,
        CASE 
            WHEN ur.Reputation > 10000 THEN 'Expert'
            WHEN ur.Reputation BETWEEN 1000 AND 10000 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS UserExperienceLevel
    FROM QuestionAnswerStats qa
    LEFT JOIN Posts p ON p.Id = qa.QuestionId
    LEFT JOIN Tags t ON strpos(qa.Title || COALESCE(p.Tags,''), t.TagName) > 0 AND NOT t.IsModeratorOnly = 1
    LEFT JOIN Comments c ON c.PostId = qa.QuestionId
    LEFT JOIN DuplicatePostLinks dpl ON dpl.PostId = qa.QuestionId
    LEFT JOIN LatestPostHistories lph ON lph.PostId = qa.QuestionId
    LEFT JOIN UserRankings ur ON ur.Id = p.OwnerUserId
    WHERE qa.QuestionDate > cast('2024-10-01' as date) - INTERVAL '3 years'
    GROUP BY qa.QuestionId, qa.Title, qa.CreationDate, qa.ViewCount, qa.QuestionScore, qa.AnswerCount, qa.AvgAnswerScore, qa.MaxAnswerScore,
             qa.TotalUpVotesOnQuestionAndAnswers, ur.DisplayName, ur.Reputation, ur.BadgeCount, lph.PostHistoryTypeId, lph.CreationDate, lph.EditorName
)
SELECT *
FROM FinalSelection
ORDER BY TotalUpVotesOnQuestionAndAnswers DESC, BadgeCount DESC, QuestionDate DESC
LIMIT 100
UNION
SELECT
    NULL AS QuestionId,
    'Summary Row' AS QuestionTitle,
    NULL AS QuestionDate,
    SUM(ViewCount) AS ViewCount,
    AVG(QuestionScore) AS AverageQuestionScore,
    SUM(AnswerCount) AS TotalAnswers,
    AVG(AvgAnswerScore) AS AverageAnswerScore,
    MAX(MaxAnswerScore) AS MaxAnswerScore,
    SUM(TotalUpVotesOnQuestionAndAnswers) AS TotalUpVotes,
    NULL AS TopUserDisplayName,
    AVG(Reputation) AS AvgUserReputation,
    SUM(BadgeCount) AS TotalBadges,
    NULL AS PostHistoryTypeId,
    NULL AS LastEditDate,
    NULL AS EditorName,
    NULL AS AllTags,
    SUM(CommentCount) AS TotalComments,
    SUM(DuplicateCount) AS TotalDuplicates,
    NULL AS QuestionStatus,
    NULL AS UserExperienceLevel
FROM FinalSelection;