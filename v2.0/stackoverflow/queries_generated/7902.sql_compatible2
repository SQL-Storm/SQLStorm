WITH UserActivity AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
        DENSE_RANK() OVER (ORDER BY u.Views DESC) as ViewRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= TIMESTAMP '2010-01-01 00:00:00'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        Views,
        TotalPosts,
        Questions,
        Answers,
        Comments,
        Badges,
        LastPostDate,
        PostRank,
        ReputationRank,
        ViewRank,
        CASE 
            WHEN ReputationRank <= 1000 THEN 'Top 1000'
            WHEN ReputationRank <= 10000 THEN 'Top 10000'
            ELSE 'Other'
        END as ReputationTier,
        CASE 
            WHEN Views > 100000 THEN 'High Viewers'
            WHEN Views > 10000 THEN 'Medium Viewers'
            WHEN Views > 1000 THEN 'Low Viewers'
            ELSE 'Minimal Viewers'
        END as ViewerCategory
    FROM UserActivity
    WHERE TotalPosts > 0
),
PostStats AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END as HasAcceptedAnswer,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PrevScore,
        LEAD(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as NextScore,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) as UserAvgScore,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) as ScoreRankInUser,
        CASE 
            WHEN p.Score > 100 THEN 'Highly Rated'
            WHEN p.Score > 50 THEN 'Moderately Rated'
            WHEN p.Score > 0 THEN 'Low Rated'
            ELSE 'Negative Rated'
        END as RatingCategory
    FROM Posts p
    WHERE p.CreationDate >= TIMESTAMP '2015-01-01 00:00:00'
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        t.IsModeratorOnly,
        t.IsRequired,
        CASE 
            WHEN t.Count >= 1000 THEN 'Popular'
            WHEN t.Count >= 100 THEN 'Moderate'
            WHEN t.Count >= 10 THEN 'Niche'
            ELSE 'Rare'
        END as PopularityLevel,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as PopularityRank,
        LAG(t.Count) OVER (ORDER BY t.Count DESC) - t.Count as PopularityChange
    FROM Tags t
    WHERE t.Count > 0
),
CombinedData AS (
    SELECT 
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.Views,
        tu.TotalPosts,
        tu.Questions,
        tu.Answers,
        tu.Comments,
        tu.Badges,
        tu.LastPostDate,
        ps.PostId,
        ps.Title,
        ps.PostTypeId,
        ps.Score,
        ps.ViewCount,
        ps.CreationDate as PostCreationDate,
        ps.Tags,
        ps.AnswerCount,
        ps.CommentCount,
        ps.FavoriteCount,
        ps.HasAcceptedAnswer,
        ps.PrevScore,
        ps.NextScore,
        ps.UserAvgScore,
        ps.ScoreRankInUser,
        ps.RatingCategory,
        ta.TagName,
        ta.Count as TagCount,
        ta.PopularityLevel,
        ta.PopularityRank,
        CASE 
            WHEN ps.Score > ta.Count THEN 'High Score vs Tag Popularity'
            WHEN ps.Score < (ta.Count / 10) THEN 'Low Score vs Tag Popularity'
            ELSE 'Balanced Score'
        END as ScoreTagBalance,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - ps.CreationDate)) / 86400 AS INTEGER) as DaysSincePost,
        CASE 
            WHEN ps.ViewCount > 1000 AND ps.Score > 50 THEN 'High Engagement'
            WHEN ps.ViewCount > 500 AND ps.Score > 25 THEN 'Medium Engagement'
            WHEN ps.ViewCount > 100 AND ps.Score > 10 THEN 'Low Engagement'
            ELSE 'Minimal Engagement'
        END as EngagementLevel
    FROM TopUsers tu
    LEFT JOIN PostStats ps ON tu.UserId = ps.OwnerUserId
    LEFT JOIN TagAnalysis ta ON ps.Tags LIKE '%' || ta.TagName || '%'
    WHERE ps.Score IS NOT NULL OR ps.PostId IS NULL
)
SELECT 
    UserId,
    DisplayName,
    Reputation,
    Views,
    TotalPosts,
    Questions,
    Answers,
    Comments,
    Badges,
    LastPostDate,
    PostId,
    Title,
    PostTypeId,
    Score,
    ViewCount,
    PostCreationDate,
    Tags,
    AnswerCount,
    CommentCount,
    FavoriteCount,
    HasAcceptedAnswer,
    PrevScore,
    NextScore,
    UserAvgScore,
    ScoreRankInUser,
    RatingCategory,
    TagName,
    TagCount,
    PopularityLevel,
    PopularityRank,
    ScoreTagBalance,
    DaysSincePost,
    EngagementLevel,
    CASE 
        WHEN TotalPosts > 500 AND Reputation > 100000 THEN 'Elite Contributor'
        WHEN TotalPosts > 100 AND Reputation > 10000 THEN 'Veteran Contributor'
        WHEN TotalPosts > 10 AND Reputation > 1000 THEN 'Regular Contributor'
        WHEN TotalPosts > 0 AND Reputation > 100 THEN 'New Contributor'
        ELSE 'Inactive'
    END as ContributorStatus,
    AVG(Score) OVER (PARTITION BY UserId) as UserAvgScoreOverTime,
    MAX(Score) OVER (PARTITION BY UserId) as UserMaxScore,
    MIN(Score) OVER (PARTITION BY UserId) as UserMinScore,
    COUNT(*) OVER (PARTITION BY UserId) as UserPostCount,
    COUNT(*) OVER (PARTITION BY TagName) as TagPostCount,
    STRING_AGG(CONCAT(Tags, ' (', Score, ')'), '; ' ORDER BY Score DESC) as TopTagScores,
    CASE 
        WHEN MAX(CASE WHEN PostTypeId = 1 THEN 1 ELSE 0 END) = 1 THEN 'Question Author'
        WHEN MAX(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END) = 1 THEN 'Answerer'
        ELSE 'Participant'
    END as UserRole
FROM CombinedData cd
GROUP BY 
    UserId,
    DisplayName,
    Reputation,
    Views,
    TotalPosts,
    Questions,
    Answers,
    Comments,
    Badges,
    LastPostDate,
    PostId,
    Title,
    PostTypeId,
    Score,
    ViewCount,
    PostCreationDate,
    Tags,
    AnswerCount,
    CommentCount,
    FavoriteCount,
    HasAcceptedAnswer,
    PrevScore,
    NextScore,
    UserAvgScore,
    ScoreRankInUser,
    RatingCategory,
    TagName,
    TagCount,
    PopularityLevel,
    PopularityRank,
    ScoreTagBalance,
    DaysSincePost,
    EngagementLevel
HAVING 
    COUNT(*) > 0
    AND (Score > 0 OR Score IS NULL)
    AND (PostId IS NOT NULL OR PostId IS NULL)
ORDER BY 
    Reputation DESC,
    TotalPosts DESC,
    Score DESC;