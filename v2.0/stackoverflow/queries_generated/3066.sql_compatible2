WITH 
UserBadges AS (
    SELECT 
        UserId,
        SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldCount,
        SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverCount,
        SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeCount
    FROM Badges
    GROUP BY UserId
),
UserPosts AS (
    SELECT 
        OwnerUserId,
        COUNT(CASE WHEN PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN PostTypeId = 2 THEN 1 END) AS AnswerCount,
        AVG(CASE WHEN PostTypeId = 1 THEN Score END) AS AvgQuestionScore,
        AVG(CASE WHEN PostTypeId = 2 THEN Score END) AS AvgAnswerScore
    FROM Posts
    GROUP BY OwnerUserId
),
RecentVotes AS (
    SELECT 
        v.PostId,
        v.VoteTypeId,
        v.CreationDate,
        v.UserId AS VoterId,
        ROW_NUMBER() OVER (PARTITION BY v.PostId ORDER BY v.CreationDate DESC) AS rn
    FROM Votes v
    WHERE v.CreationDate >= DATE '2024-10-01' - INTERVAL '30' DAY
),
TagActivity AS (
    SELECT 
        t.TagName,
        COUNT(DISTINCT p.Id)               AS QuestionCount,
        SUM(p.Score)                       AS TotalScore,
        AVG(p.Score)                       AS AvgScore,
        MAX(p.CreationDate)                AS LastAsked,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) AS TagRank
    FROM Tags t
    JOIN Posts p 
        ON p.Tags IS NOT NULL
       AND POSITION('<' || t.TagName || '>' IN p.Tags) > 0
       AND p.PostTypeId = 1
    GROUP BY t.TagName
),
TopQuestions AS (
    SELECT 
        p.Id,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        u.DisplayName,
        ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS Rank
    FROM Posts p
    LEFT JOIN Users u ON p.OwnerUserId = u.Id
    WHERE p.PostTypeId = 1
      AND p.CreationDate >= DATE '2024-10-01' - INTERVAL '1' YEAR
),
UserMetrics AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(b.GoldCount,   0) AS GoldBadges,
        COALESCE(b.SilverCount, 0) AS SilverBadges,
        COALESCE(b.BronzeCount, 0) AS BronzeBadges,
        COALESCE(p.QuestionCount, 0) AS QuestionsPosted,
        COALESCE(p.AnswerCount,   0) AS AnswersPosted,
        COALESCE(p.AvgQuestionScore, 0) AS AvgQScore,
        COALESCE(p.AvgAnswerScore,   0) AS AvgAScore,
        COALESCE(rv.VoteCnt, 0) AS RecentVoteCount,
        MIN(tq.Rank) FILTER (WHERE tq.Rank IS NOT NULL) AS BestQuestionRank
    FROM Users u
    LEFT JOIN UserBadges b   ON u.Id = b.UserId
    LEFT JOIN UserPosts p    ON u.Id = p.OwnerUserId
    LEFT JOIN (
        SELECT 
            p.OwnerUserId,
            COUNT(*) AS VoteCnt
        FROM RecentVotes rv
        JOIN Posts p ON rv.PostId = p.Id
        WHERE rv.rn = 1
        GROUP BY p.OwnerUserId
    ) rv ON u.Id = rv.OwnerUserId
    LEFT JOIN TopQuestions tq ON u.Id = (
        SELECT OwnerUserId 
        FROM Posts p2 
        WHERE p2.Id = tq.Id
    )
    GROUP BY 
        u.Id, u.DisplayName, u.Reputation,
        b.GoldCount, b.SilverCount, b.BronzeCount,
        p.QuestionCount, p.AnswerCount,
        p.AvgQuestionScore, p.AvgAnswerScore,
        rv.VoteCnt
),
UserTopTag AS (
    SELECT 
        um.Id,
        ta.TagName,
        ta.QuestionCount,
        ta.AvgScore,
        ROW_NUMBER() OVER (PARTITION BY um.Id ORDER BY ta.QuestionCount DESC) AS rn
    FROM UserMetrics um
    JOIN Posts p 
        ON p.OwnerUserId = um.Id
       AND p.PostTypeId = 1
    JOIN Tags t 
        ON t.Tags IS NOT NULL
       AND POSITION('<' || t.TagName || '>' IN p.Tags) > 0
    JOIN TagActivity ta 
        ON ta.TagName = t.TagName
)
SELECT 
    um.Id,
    um.DisplayName,
    um.Reputation,
    um.GoldBadges,
    um.SilverBadges,
    um.BronzeBadges,
    um.QuestionsPosted,
    um.AnswersPosted,
    ROUND(um.AvgQScore, 2) AS AvgQuestionScore,
    ROUND(um.AvgAScore, 2) AS AvgAnswerScore,
    um.RecentVoteCount,
    um.BestQuestionRank,
    CASE 
        WHEN um.Reputation >= 20000 THEN 'Legendary'
        WHEN um.Reputation >= 10000 THEN 'Master'
        WHEN um.Reputation >= 5000  THEN 'Experienced'
        WHEN um.Reputation >= 1000  THEN 'Intermediate'
        ELSE 'Novice' 
    END AS ReputationBand,
    COALESCE(utt.TagName, '<none>') AS TopTag,
    COALESCE(utt.QuestionCount, 0)   AS TagQuestionCount,
    COALESCE(ROUND(utt.AvgScore,2),0) AS TagAvgScore
FROM UserMetrics um
LEFT JOIN UserTopTag utt 
    ON um.Id = utt.Id AND utt.rn = 1
WHERE um.Reputation > 5000
ORDER BY um.Reputation DESC, um.QuestionsPosted DESC
LIMIT 100

UNION ALL

SELECT 
    NULL AS Id,
    'Aggregated Summary' AS DisplayName,
    SUM(um.Reputation)                 AS Reputation,
    SUM(um.GoldBadges)                 AS GoldBadges,
    SUM(um.SilverBadges)               AS SilverBadges,
    SUM(um.BronzeBadges)               AS BronzeBadges,
    SUM(um.QuestionsPosted)            AS QuestionsPosted,
    SUM(um.AnswersPosted)              AS AnswersPosted,
    AVG(um.AvgQScore)                  AS AvgQuestionScore,
    AVG(um.AvgAScore)                  AS AvgAnswerScore,
    SUM(um.RecentVoteCount)            AS RecentVoteCount,
    NULL                               AS BestQuestionRank,
    NULL                               AS ReputationBand,
    NULL                               AS TopTag,
    NULL                               AS TagQuestionCount,
    NULL                               AS TagAvgScore
FROM UserMetrics um
WHERE um.Reputation > 5000;