with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        b.Class,
        b.Name as BadgeName,
        b.Date,
        row_number() over (partition by u.Id order by b.Date desc) as rn
    from Users u
    left join Badges b on u.Id = b.UserId
    where b.Id is not null
), RecentUserBadges as (
    select *
    from RecursiveUserBadges
    where rn <= 3
), PostScoreRanks as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.CreationDate,
        rank() over (partition by p.OwnerUserId order by p.Score desc NULLS LAST) as ScoreRank
    from Posts p
    where p.OwnerUserId is not null and p.PostTypeId in (1,2)
), TopPostsWithComments as (
    select
        p.Id as PostId,
        p.Title,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        count(c.Id) as CommentCount,
        string_agg(distinct u.DisplayName, ', ') as Commenters
    from Posts p
    left join Comments c on p.Id = c.PostId
    left join Users u on c.UserId = u.Id
    where p.PostTypeId = 1
    group by p.Id, p.Title, p.OwnerUserId, p.Score, p.ViewCount, p.CreationDate
), DuplicateLinkCounts as (
    select
        pl.PostId,
        count(pl.RelatedPostId) filter (where lt.Name = 'Duplicate') as DuplicateCount
    from PostLinks pl
    join LinkTypes lt on pl.LinkTypeId = lt.Id
    group by pl.PostId
), UserActivityWindow as (
    select
        p.OwnerUserId,
        p.CreationDate,
        count(*) over (partition by p.OwnerUserId order by p.CreationDate range between interval '30 days' preceding and current row) as PostsInLast30Days
    from Posts p
    where p.OwnerUserId is not null
), QuestionsWithAcceptedAnswerScore as (
    select
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.Score as QuestionScore,
        a.Score as AcceptedAnswerScore,
        (a.Score::numeric / nullif(q.Score,0)) as ScoreRatio,
        q.CreationDate as QuestionDate
    from Posts q
    left join Posts a on q.AcceptedAnswerId = a.Id
    where q.PostTypeId = 1
), UserReputationChange as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        coalesce(u.UpVotes, 0) - coalesce(u.DownVotes, 0) as NetVotes,
        (select count(*) from Posts p where p.OwnerUserId = u.Id and p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year') as PostsLastYear,
        (select count(*) from Comments c where c.UserId = u.Id and c.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year') as CommentsLastYear,
        (select count(*) from Votes v where v.UserId = u.Id and v.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year' and v.VoteTypeId = 2) as UpVotesGivenLastYear
    from Users u
)
select
    u.DisplayName as User,
    urc.Reputation,
    urc.NetVotes,
    urc.PostsLastYear,
    urc.CommentsLastYear,
    urc.UpVotesGivenLastYear,
    coalesce(ps.Score, 0) as HighestPostScore,
    coalesce(tc.CommentCount, 0) as CommentsOnUserTopQuestion,
    coalesce(dc.DuplicateCount, 0) as DuplicateLinksOnTopQuestion,
    rubu.Class as BadgeClass,
    rubu.BadgeName,
    qaa.Title as ExampleQuestion,
    qaa.ScoreRatio
from UserReputationChange urc
join Users u on urc.UserId = u.Id
left join (
    select OwnerUserId, max(Score) as Score
    from Posts
    where PostTypeId in (1, 2)
    group by OwnerUserId
) ps on ps.OwnerUserId = u.Id
left join TopPostsWithComments tc on tc.OwnerUserId = u.Id
left join DuplicateLinkCounts dc on dc.PostId = tc.PostId
left join RecentUserBadges rubu on rubu.UserId = u.Id and rubu.rn = 1
left join (
    select OwnerUserId, Title, ScoreRatio
    from QuestionsWithAcceptedAnswerScore qaa
) qaa on qaa.OwnerUserId = u.Id
where urc.Reputation > 1000
  and (coalesce(tc.CommentCount, 0) > 10 or coalesce(dc.DuplicateCount, 0) > 0)
order by urc.Reputation desc, urc.NetVotes desc
limit 100;