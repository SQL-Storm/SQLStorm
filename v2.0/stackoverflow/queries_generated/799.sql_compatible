with recent_questions as (
    select
        q.Id as QuestionId,
        q.Title,
        q.CreationDate,
        coalesce(q.ViewCount, 0) as ViewCount,
        q.Score as QuestionScore,
        q.OwnerUserId,
        q.AcceptedAnswerId,
        q.Tags,
        string_to_array(substring(q.Tags, 2, length(q.Tags)-2), '><') as TagArray
    from Posts q
    where q.PostTypeId = 1
      and q.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '365 days'
),
tag_expanded as (
    select
        rq.QuestionId,
        rq.Title,
        rq.CreationDate,
        rq.ViewCount,
        rq.QuestionScore,
        rq.OwnerUserId,
        rq.AcceptedAnswerId,
        lower(trim(t)) as TagName
    from recent_questions rq
         left join lateral unnest(rq.TagArray) as t on true
),
tag_ranked as (
    select
        te.QuestionId,
        te.Title,
        te.CreationDate,
        te.ViewCount,
        te.QuestionScore,
        te.OwnerUserId,
        te.AcceptedAnswerId,
        te.TagName,
        row_number() over (
            partition by te.QuestionId
            order by coalesce(t.Count, 0) desc, te.TagName
        ) as tag_priority,
        sum(coalesce(t.Count, 0)) over (partition by te.QuestionId) as tag_popularity_sum
    from tag_expanded te
    left join Tags t
      on lower(t.TagName) = te.TagName
),
best_tag as (
    select *
    from tag_ranked
    where tag_priority = 1
),
answers as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId,
        a.Score as AnswerScore,
        a.CreationDate as AnswerCreationDate,
        a.LastActivityDate as AnswerLastActivityDate
    from Posts a
    where a.PostTypeId = 2
),
answer_stats as (
    select
        a.QuestionId,
        count(*) as AnswerCount,
        max(a.AnswerScore) as MaxAnswerScore,
        min(a.AnswerScore) as MinAnswerScore,
        avg(cast(a.AnswerScore as numeric)) as AvgAnswerScore,
        max(a.AnswerCreationDate) as LatestAnswerDate
    from answers a
    group by a.QuestionId
),
owner_enriched as (
    select
        bt.QuestionId,
        bt.Title,
        bt.CreationDate,
        bt.ViewCount,
        bt.QuestionScore,
        bt.AcceptedAnswerId,
        bt.TagName as TopTag,
        bt.tag_popularity_sum,
        u.Id as OwnerUserId,
        u.Reputation,
        u.CreationDate as UserCreationDate,
        u.Location,
        u.UpVotes,
        u.DownVotes,
        u.Views as ProfileViews
    from best_tag bt
    left join Users u
      on u.Id = bt.OwnerUserId
),
vote_agg as (
    select
        v.PostId,
        sum(case when v.VoteTypeId = 2 then 1 else 0 end) as UpVotes,
        sum(case when v.VoteTypeId = 3 then 1 else 0 end) as DownVotes,
        sum(case when v.VoteTypeId = 5 then 1 else 0 end) as Favorites,
        sum(case when v.VoteTypeId in (8,9) then coalesce(v.BountyAmount,0) else 0 end) as BountyTotal,
        max(case when v.VoteTypeId in (8,9) then v.CreationDate end) as LastBountyDate
    from Votes v
    group by v.PostId
),
comment_agg as (
    select
        c.PostId,
        count(*) as CommentCount,
        max(c.CreationDate) as LastCommentDate,
        max(case when c.Score is not null then c.Score else 0 end) as MaxCommentScore
    from Comments c
    group by c.PostId
),
close_events as (
    select
        ph.PostId,
        min(ph.CreationDate) as FirstCloseDate,
        max(ph.CreationDate) as LastCloseDate,
        count(*) filter (where ph.PostHistoryTypeId = 10) as CloseVoteEvents,
        count(*) filter (where ph.PostHistoryTypeId = 11) as ReopenEvents,
        max(
            case
                when ph.PostHistoryTypeId = 10
                then nullif(trim(ph.Comment), '')
            end
        ) as CloseReasonIdRaw
    from PostHistory ph
    where ph.PostHistoryTypeId in (10, 11)
    group by ph.PostId
),
close_reason_map as (
    select
        ce.PostId,
        ce.FirstCloseDate,
        ce.LastCloseDate,
        ce.CloseVoteEvents,
        ce.ReopenEvents,
        crt.Name as CloseReasonName
    from close_events ce
    left join CloseReasonTypes crt
      on crt.Id = cast(ce.CloseReasonIdRaw as smallint)
),
dupe_links as (
    select
        pl.PostId as DuplicateId,
        pl.RelatedPostId as OriginalId,
        min(pl.CreationDate) as FirstDupLinkDate,
        count(*) as DupLinkCount
    from PostLinks pl
    where pl.LinkTypeId = 3
    group by pl.PostId, pl.RelatedPostId
),
accepted_answer as (
    select
        rq.QuestionId,
        aa.Id as AcceptedAnswerId,
        aa.Score as AcceptedAnswerScore,
        aa.CreationDate as AcceptedAnswerDate
    from recent_questions rq
    left join Posts aa
      on aa.Id = rq.AcceptedAnswerId
),
owner_badges as (
    select
        b.UserId,
        count(*) as BadgeCount,
        sum(case when b.Class = 1 then 1 else 0 end) as GoldCount,
        sum(case when b.Class = 2 then 1 else 0 end) as SilverCount,
        sum(case when b.Class = 3 then 1 else 0 end) as BronzeCount,
        max(b.Date) as LastBadgeDate
    from Badges b
    group by b.UserId
),
question_activity as (
    select
        rq.QuestionId,
        rq.Title,
        oe.OwnerUserId,
        coalesce(rq.ViewCount, 0) as Views,
        rq.QuestionScore,
        coalesce(vg.UpVotes, 0) as UpVotes,
        coalesce(vg.DownVotes, 0) as DownVotes,
        coalesce(vg.Favorites, 0) as Favorites,
        coalesce(vg.BountyTotal, 0) as BountyTotal,
        vg.LastBountyDate,
        coalesce(ca.CommentCount, 0) as CommentCount,
        ca.LastCommentDate,
        ast.AnswerCount,
        ast.MaxAnswerScore,
        ast.MinAnswerScore,
        ast.AvgAnswerScore,
        ast.LatestAnswerDate,
        cr.CloseReasonName,
        crm.FirstCloseDate,
        crm.LastCloseDate,
        crm.CloseVoteEvents,
        crm.ReopenEvents,
        dl.OriginalId as DuplicateOfId,
        dl.FirstDupLinkDate,
        dl.DupLinkCount,
        aa.AcceptedAnswerId,
        aa.AcceptedAnswerScore,
        aa.AcceptedAnswerDate,
        oe.TopTag,
        oe.tag_popularity_sum,
        oe.Reputation as OwnerReputation,
        ob.BadgeCount as OwnerBadgeCount,
        ob.GoldCount,
        ob.SilverCount,
        ob.BronzeCount,
        oe.Location as OwnerLocation,
        oe.UserCreationDate as OwnerSince
    from recent_questions rq
    join owner_enriched oe
      on oe.QuestionId = rq.QuestionId
    left join vote_agg vg
      on vg.PostId = rq.QuestionId
    left join comment_agg ca
      on ca.PostId = rq.QuestionId
    left join answer_stats ast
      on ast.QuestionId = rq.QuestionId
    left join close_reason_map crm
      on crm.PostId = rq.QuestionId
    left join CloseReasonTypes cr
      on cr.Name = crm.CloseReasonName
    left join dupe_links dl
      on dl.DuplicateId = rq.QuestionId
    left join accepted_answer aa
      on aa.QuestionId = rq.QuestionId
    left join owner_badges ob
      on ob.UserId = oe.OwnerUserId
),
ranked as (
    select
        qa.*,
        (
            coalesce(qa.QuestionScore, 0) * 3
            + coalesce(qa.UpVotes, 0) * 2
            - coalesce(qa.DownVotes, 0) * 5
            + coalesce(qa.Favorites, 0) * 4
            + coalesce(qa.CommentCount, 0) * 1
            + coalesce(qa.AnswerCount, 0) * 6
            + least(coalesce(qa.Views, 0) / 100, 50)
            + case when qa.AcceptedAnswerId is not null then 20 else 0 end
            + least(coalesce(qa.BountyTotal, 0) / 50, 40)
            - case when qa.CloseReasonName is not null then 30 else 0 end
            - case when qa.DuplicateOfId is not null then 15 else 0 end
        )::numeric as EngagementScore,
        exp(-extract(epoch from (cast('2024-10-01 12:34:56' as timestamp) - qa.CreationDate)) / cast((60*60*24*90) as numeric)) as RecencyFactor,
        (1 + ln(greatest(qa.OwnerReputation, 1))) as OwnerInfluence,
        (1 + cast(coalesce(qa.tag_popularity_sum, 0) as numeric) / nullif((select sum("Count") from Tags), 0)) as TagPopularityFactor
    from question_activity qa
),
scored as (
    select
        r.*,
        (r.EngagementScore * r.RecencyFactor * r.OwnerInfluence * r.TagPopularityFactor) as FinalScore,
        row_number() over (
            partition by coalesce(r.TopTag, 'untagged')
            order by (r.EngagementScore * r.RecencyFactor * r.OwnerInfluence * r.TagPopularityFactor) desc,
                     r.CreationDate desc
        ) as RankWithinTag,
        dense_rank() over (
            order by (r.EngagementScore * r.RecencyFactor * r.OwnerInfluence * r.TagPopularityFactor) desc
        ) as GlobalRank
    from ranked r
),
anomalies as (
    select
        s.QuestionId,
        case
            when s.AnswerCount = 0 and s.QuestionScore >= 5 and s.Views >= 1000 then 'HighViewsNoAnswers'
            when s.AnswerCount >= 5 and coalesce(s.AcceptedAnswerId, 0) = 0 then 'ManyAnswersNoAccepted'
            when s.CloseReasonName is not null and s.QuestionScore >= 10 then 'ClosedButHighScore'
            when s.DownVotes > s.UpVotes and s.Favorites > 0 then 'Controversial'
            when s.DuplicateOfId is not null and s.Favorites >= 10 then 'PopularDuplicate'
        end as AnomalyType
    from scored s
),
final as (
    select
        s.QuestionId,
        s.Title,
        s.TopTag,
        s.OwnerUserId,
        s.OwnerReputation,
        s.OwnerLocation,
        s.OwnerSince,
        s.Views,
        s.QuestionScore,
        s.UpVotes,
        s.DownVotes,
        s.Favorites,
        s.AnswerCount,
        s.AcceptedAnswerId,
        s.AcceptedAnswerScore,
        s.BountyTotal,
        s.CloseReasonName,
        s.DuplicateOfId,
        s.CreationDate,
        s.LastCommentDate,
        s.LatestAnswerDate,
        s.FinalScore,
        s.RankWithinTag,
        s.GlobalRank,
        string_agg(a.AnomalyType, ', ' order by a.AnomalyType) filter (where a.AnomalyType is not null) as Anomalies
    from scored s
    left join anomalies a
      on a.QuestionId = s.QuestionId
    group by
        s.QuestionId, s.Title, s.TopTag, s.OwnerUserId, s.OwnerReputation, s.OwnerLocation, s.OwnerSince,
        s.Views, s.QuestionScore, s.UpVotes, s.DownVotes, s.Favorites, s.AnswerCount, s.AcceptedAnswerId,
        s.AcceptedAnswerScore, s.BountyTotal, s.CloseReasonName, s.DuplicateOfId, s.CreationDate,
        s.LastCommentDate, s.LatestAnswerDate, s.FinalScore, s.RankWithinTag, s.GlobalRank
)
select *
from final
where
    (
        (FinalScore > 50 and AnswerCount >= 1)
        or (FinalScore > 20 and Favorites >= 5 and UpVotes > DownVotes)
        or (CloseReasonName is not null and FinalScore > 10)
    )
    and coalesce(OwnerReputation, 0) >= 1
    and (
        OwnerLocation is null
        or lower(OwnerLocation) like any (array['%united states%','%india%','%germany%','%canada%','%uk%','%remote%'])
        or length(OwnerLocation) > 0
    )
    and (AcceptedAnswerId is not null or coalesce(AnswerCount, 0) >= 2)
order by GlobalRank, RankWithinTag, FinalScore desc
limit 200;