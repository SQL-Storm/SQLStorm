WITH RecentQuestions AS (
    SELECT
        p.Id AS QuestionId,
        p.Title AS QuestionTitle,
        p.OwnerUserId,
        p.CreationDate AS QuestionCreationDate,
        p.Score AS QuestionScore,
        p.AnswerCount,
        ROW_NUMBER() OVER (ORDER BY p.CreationDate DESC) as rn
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.CreationDate > cast('2024-10-01' as date) - INTERVAL '30 days'
),
HighScoringAnswers AS (
    SELECT
        a.ParentId AS QuestionId,
        a.Id AS AnswerId,
        a.OwnerUserId AS AnswerOwnerUserId,
        a.CreationDate AS AnswerCreationDate,
        a.Score AS AnswerScore,
        ROW_NUMBER() OVER (PARTITION BY a.ParentId ORDER BY a.Score DESC, a.CreationDate ASC) as answer_rank
    FROM Posts a
    WHERE a.PostTypeId = 2 AND a.ParentId IN (SELECT QuestionId FROM RecentQuestions)
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        COUNT(DISTINCT ph.Id) AS PostHistoryCount,
        SUM(CASE WHEN ph.PostHistoryTypeId = 2 THEN 1 ELSE 0 END) AS BodyEdits,
        MAX(ph.CreationDate) AS LastPostHistoryDate
    FROM Users u
    JOIN PostHistory ph ON u.Id = ph.UserId
    WHERE ph.CreationDate > cast('2024-10-01' as date) - INTERVAL '90 days'
    GROUP BY u.Id, u.DisplayName
    HAVING COUNT(DISTINCT ph.Id) > 5
),
TagPopularity AS (
    SELECT
        t.TagName,
        t.Count AS TagCount,
        COUNT(DISTINCT p.Id) AS QuestionsWithTag,
        AVG(CAST(p.AnswerCount AS DOUBLE PRECISION)) AS AvgAnswersPerQuestion
    FROM Tags t
    LEFT JOIN Posts p ON p.Id = t.WikiPostId AND p.PostTypeId = 1
    WHERE t.TagName NOT LIKE '%-%'
    GROUP BY t.TagName, t.Count
    HAVING COUNT(DISTINCT p.Id) > 100
),
PostTags AS (
    /* Split tag string like '<tag1><tag2>' into rows: compatible approach using regexp_matches */
    SELECT
        p.Id,
        (regexp_matches(p.Tags, '<([^>]+)>', 'g'))[1] AS TagName
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
),
PostTagsExpanded AS (
    -- regexp_matches with the 'g' flag returns multiple rows per row in PostgreSQL when used in a lateral join.
    SELECT p.Id, m.tag AS TagName
    FROM Posts p
    JOIN LATERAL (
        SELECT (regexp_matches(p.Tags, '<([^>]+)>', 'g'))[1] AS tag
    ) m ON TRUE
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
)
SELECT
    rq.QuestionTitle,
    rq.QuestionScore,
    COALESCE(ua.DisplayName, 'Anonymous') AS QuestionOwnerDisplayName,
    COALESCE(ua.PostHistoryCount, 0) AS QuestionOwnerHistoryCount,
    hsa.AnswerId,
    hsa.AnswerScore,
    COALESCE(ua_ans.DisplayName, 'Anonymous') AS AnswerOwnerDisplayName,
    COALESCE(ua_ans.BodyEdits, 0) AS AnswerOwnerBodyEdits,
    tp.TagName,
    tp.TagCount,
    tp.AvgAnswersPerQuestion,
    CASE
        WHEN rq.AnswerCount > 5 THEN 'High Answer Count'
        WHEN rq.QuestionScore < 0 THEN 'Negative Score'
        ELSE 'Standard'
    END AS QuestionStatus,
    CASE
        WHEN hsa.AnswerScore > (SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.PostTypeId = 2 AND p2.ParentId = rq.QuestionId)
        THEN 'Above Average Answer'
        WHEN hsa.AnswerScore <= 0 THEN 'Zero or Negative Answer Score'
        ELSE 'Average Answer'
    END AS AnswerQualityIndicator,
    hsa.AnswerCreationDate,
    rq.QuestionCreationDate
FROM RecentQuestions rq
LEFT JOIN UserActivity ua ON rq.OwnerUserId = ua.UserId
LEFT JOIN HighScoringAnswers hsa ON rq.QuestionId = hsa.QuestionId AND hsa.answer_rank = 1
LEFT JOIN UserActivity ua_ans ON hsa.AnswerOwnerUserId = ua_ans.UserId
LEFT JOIN (
    SELECT DISTINCT
        pte.Id,
        pte.TagName
    FROM PostTagsExpanded pte
    JOIN Tags t ON t.TagName = pte.TagName
) AS post_tags ON rq.QuestionId = post_tags.Id
LEFT JOIN TagPopularity tp ON post_tags.TagName = tp.TagName
WHERE rq.rn BETWEEN 1 AND 500
ORDER BY rq.QuestionCreationDate DESC, hsa.AnswerScore DESC
LIMIT 100;