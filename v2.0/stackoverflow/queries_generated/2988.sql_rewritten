-- {"query": "2988.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1531} 
with RecursiveTagHierarchy as (
    select 
        t.Id,
        t.TagName,
        t.Count,
        0 as Level,
        cast(t.TagName as varchar(1000)) as Path
    from Tags t
    where t.IsModeratorOnly = 0
    union all
    select 
        t2.Id,
        t2.TagName,
        t2.Count,
        r.Level + 1,
        r.Path || '>' || t2.TagName
    from Tags t2
    inner join RecursiveTagHierarchy r on t2.Id = r.Id - 1 and r.Level < 3
    where t2.IsModeratorOnly = 0
),
UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct case when b.Class = 1 then b.Id end) as GoldBadges,
        count(distinct case when b.Class = 2 then b.Id end) as SilverBadges,
        count(distinct case when b.Class = 3 then b.Id end) as BronzeBadges,
        count(distinct b.Id) as TotalBadges,
        sum(case when b.Date >= '2023-01-01' then 1 else 0 end) as BadgesThisYear
    from Users u
    left join Badges b on u.Id = b.UserId
    group by u.Id, u.DisplayName
),
PostActivityRanked as (
    select
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.LastActivityDate,
        p.AcceptedAnswerId,
        row_number() over (partition by p.OwnerUserId order by p.Score desc, p.ViewCount desc) as UserBestPostRank
    from Posts p
    where p.PostTypeId in (1,2) -- Questions or Answers
),
CloseReasonsLast30d as (
    select
        ph.PostId,
        crt.Name as CloseReason,
        ph.CreationDate
    from PostHistory ph
    inner join CloseReasonTypes crt on cast(ph.Comment as int) = crt.Id
    where ph.PostHistoryTypeId = 10 and ph.CreationDate >= cast('2024-10-01' as date) - interval '30 day'
),
QuestionsWithAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        q.Score as QuestionScore,
        q.ViewCount,
        q.AnswerCount,
        count(a.Id) as ValidAnswerCount,
        avg(coalesce(a.Score,0)) filter (where a.Id is not null) as AvgAnswerScore,
        max(coalesce(a.Score,0)) filter (where a.Id is not null) as MaxAnswerScore,
        sum(case when a.OwnerUserId is not null then 1 else 0 end) as AnswersWithOwnerCount,
        case when q.AcceptedAnswerId is not null then 1 else 0 end as HasAcceptedAnswer,
        coalesce(cr.CloseReason,'Open') as LastCloseReason,
        coalesce(cr.CreationDate, timestamp 'epoch') as CloseDate
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    left join CloseReasonsLast30d cr on cr.PostId = q.Id
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.OwnerUserId, q.CreationDate, q.Score, q.ViewCount, q.AnswerCount, cr.CloseReason, cr.CreationDate, q.AcceptedAnswerId
),
UserReputationChangeWindow as (
    select
        v.UserId,
        sum(case when vt.Name = 'UpMod' then 10 
                 when vt.Name = 'DownMod' then -2
                 when vt.Name = 'AcceptedByOriginator' then 15
                 else 0 end) as ReputationChange,
        v.CreationDate
    from Votes v
    inner join VoteTypes vt on v.VoteTypeId = vt.Id
    where v.UserId is not null
    group by v.UserId, v.CreationDate
),
UserReputationWindowRank as (
    select
        urcw.UserId,
        urcw.CreationDate,
        urcw.ReputationChange,
        sum(urcw.ReputationChange) over (partition by urcw.UserId order by urcw.CreationDate rows between 29 preceding and current row) as Rolling30DayRepChange
    from UserReputationChangeWindow urcw
),
TopContributors as (
    select
        u.Id,
        u.DisplayName,
        u.Reputation,
        ursw.Rolling30DayRepChange,
        u.CreationDate,
        row_number() over (order by ursw.Rolling30DayRepChange desc nulls last) as RankByRepChange
    from Users u
    left join (
        select 
            UserId, 
            max(Rolling30DayRepChange) as Rolling30DayRepChange
        from UserReputationWindowRank
        group by UserId
    ) ursw on u.Id = ursw.UserId
    where u.Reputation > 1000
    order by ursw.Rolling30DayRepChange desc nulls last
    limit 10
)
select
    ubs.UserId,
    ubs.DisplayName,
    ubs.GoldBadges,
    ubs.SilverBadges,
    ubs.BronzeBadges,
    ubs.TotalBadges,
    ubs.BadgesThisYear,
    tac.UserBestPostRank,
    qws.QuestionId,
    qws.Title as QuestionTitle,
    qws.QuestionScore,
    qws.ViewCount as QuestionViewCount,
    qws.AnswerCount,
    qws.ValidAnswerCount,
    qws.AvgAnswerScore,
    qws.MaxAnswerScore,
    qws.AnswersWithOwnerCount,
    qws.HasAcceptedAnswer,
    qws.LastCloseReason,
    qws.CloseDate,
    tcht.Path as TagPath,
    tc.Id as TagId,
    tc.TagName,
    tc.Count as TagCount,
    tc.IsModeratorOnly,
    tc.IsRequired,
    tc.ExcerptPostId,
    tc.WikiPostId,
    tc.IsModeratorOnly,
    tc.IsRequired,
    topc.RankByRepChange,
    topc.Rolling30DayRepChange
from UserBadgeStats ubs
left join PostActivityRanked tac on tac.OwnerUserId = ubs.UserId and tac.UserBestPostRank = 1
left join QuestionsWithAnswerStats qws on qws.OwnerUserId = ubs.UserId
left join RecursiveTagHierarchy tcht on strpos(qws.Title, tcht.TagName) > 0
left join Tags tc on tcht.Id = tc.Id
left join TopContributors topc on topc.Id = ubs.UserId
where (ubs.GoldBadges + ubs.SilverBadges + ubs.BronzeBadges) > 10
  and qws.AnswerCount > 0
order by topc.RankByRepChange asc nulls last, qws.QuestionScore desc
limit 100;