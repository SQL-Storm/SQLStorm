with
params as (
  select
    interval '365 days' as recent_window,
    10 as min_ans,
    3 as min_comm,
    50 as min_rep
),
active_users as (
  select u.id as user_id,
         u.displayname,
         u.reputation,
         u.location,
         u.creationdate,
         coalesce(nullif(trim(u.websiteurl), ''), 'n/a') as websiteurl
  from users u
  where u.reputation >= (select min_rep from params)
),
recent_posts as (
  select p.*,
         case when p.posttypeid = 1 then string_to_array(substring(p.tags, 2, greatest(length(p.tags)-2,0)), '><') end as tag_arr
  from posts p
  where p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - (select recent_window from params)
),
link_rollup as (
  select
    pl.postid,
    pl.relatedpostid,
    pl.linktypeid,
    count(*) as link_count
  from postlinks pl
  group by pl.postid, pl.relatedpostid, pl.linktypeid
),
vote_agg as (
  select
    v.postid,
    sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
    sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
    sum(case when v.votetypeid = 5 then 1 else 0 end) as favorites,
    sum(case when v.votetypeid = 8 then coalesce(v.bountyamount,0) else 0 end) as bounty_started,
    sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded,
    count(*) as total_votes
  from votes v
  group by v.postid
),
comment_agg as (
  select
    c.postid,
    count(*) as comment_count,
    max(c.creationdate) as last_comment_at,
    sum(greatest(c.score,0)) as nonneg_comment_score
  from comments c
  group by c.postid
),
history_flags as (
  select
    ph.postid,
    sum(case when ph.posthistorytypeid = 10 then 1 else 0 end) as closed_events,
    sum(case when ph.posthistorytypeid = 11 then 1 else 0 end) as reopened_events,
    sum(case when ph.posthistorytypeid = 50 then 1 else 0 end) as bumps,
    sum(case when ph.posthistorytypeid = 52 then 1 else 0 end) as hot_selected,
    sum(case when ph.posthistorytypeid = 53 then 1 else 0 end) as hot_removed,
    max(case when ph.posthistorytypeid = 10 then ph.creationdate end) as last_closed_at,
    max(case when ph.posthistorytypeid = 11 then ph.creationdate end) as last_reopened_at
  from posthistory ph
  group by ph.postid
),
answers as (
  select
    a.parentid as question_id,
    a.id as answer_id,
    a.owneruserid as answerer_id,
    a.score as answer_score,
    a.creationdate as answer_date
  from posts a
  where a.posttypeid = 2
),
answer_stats as (
  select
    q.id as question_id,
    count(a.answer_id) as answer_count,
    sum(case when a.answer_score > 0 then 1 else 0 end) as pos_answer_count,
    max(a.answer_score) as max_answer_score,
    min(a.answer_score) as min_answer_score,
    avg(a.answer_score * 1.0) as avg_answer_score,
    max(a.answer_date) as last_answer_at
  from posts q
  left join answers a on a.question_id = q.id
  where q.posttypeid = 1
  group by q.id
),
badge_mix as (
  select
    b.userid,
    sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
    sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
    sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
    sum(case when coalesce(b.tagbased,0) = 1 then 1 else 0 end) as tag_badges,
    count(*) as total_badges,
    max(b.date) as last_badge_at
  from badges b
  group by b.userid
),
question_features as (
  select
    q.id as question_id,
    q.owneruserid as asker_id,
    q.acceptedanswerid,
    q.creationdate as asked_at,
    q.score as q_score,
    q.viewcount as q_views,
    q.favoritecount as q_favs,
    qa.answer_count,
    qa.pos_answer_count,
    qa.max_answer_score,
    qa.min_answer_score,
    qa.avg_answer_score,
    qa.last_answer_at,
    coalesce(v.upvotes,0) as upvotes,
    coalesce(v.downvotes,0) as downvotes,
    coalesce(v.favorites,0) as favorites_votes,
    coalesce(v.bounty_started,0) as bounty_started,
    coalesce(v.bounty_awarded,0) as bounty_awarded,
    coalesce(v.total_votes,0) as total_votes,
    coalesce(c.comment_count,0) as comment_count,
    c.last_comment_at,
    coalesce(c.nonneg_comment_score,0) as comment_score_nonneg,
    coalesce(h.closed_events,0) as closed_events,
    coalesce(h.reopened_events,0) as reopened_events,
    coalesce(h.bumps,0) as bumps,
    coalesce(h.hot_selected,0) as hot_selected,
    coalesce(h.hot_removed,0) as hot_removed,
    h.last_closed_at,
    h.last_reopened_at,
    q.tags as raw_tags,
    rp.tag_arr as tag_arr,
    greatest(
      0,
      (coalesce(qa.answer_count,0) * 3)
      + (coalesce(qa.pos_answer_count,0) * 5)
      + (coalesce(q.score,0) * 4)
      + (coalesce(q.viewcount,0) / 250.0)
      + (coalesce(coalesce(v.upvotes,0) - coalesce(v.downvotes,0),0) * 2)
      + (coalesce(c.comment_count,0))
      + (coalesce(h.hot_selected,0) * 50)
      - (coalesce(h.hot_removed,0) * 25)
      - (case when q.closeddate is not null then 20 else 0 end)
      + (case when q.acceptedanswerid is not null then 15 else 0 end)
    ) * 1.0 as composite_score
  from posts q
  join recent_posts rp on rp.id = q.id and rp.posttypeid = 1
  left join answer_stats qa on qa.question_id = q.id
  left join vote_agg v on v.postid = q.id
  left join comment_agg c on c.postid = q.id
  left join history_flags h on h.postid = q.id
),
tag_expanded as (
  select
    qf.*,
    unnest(coalesce(qf.tag_arr, array['untagged'])) as tagname
  from question_features qf
),
ranked as (
  select
    t.*,
    row_number() over (order by composite_score desc, q_views desc) as global_rank,
    row_number() over (partition by tagname order by composite_score desc, q_views desc) as tag_rank,
    ntile(10) over (order by composite_score desc) as global_decile,
    dense_rank() over (order by coalesce(bounty_awarded,0) desc) as bounty_rank
  from tag_expanded t
),
heavy_q as (
  select *
  from ranked
  where (answer_count >= (select min_ans from params)
     or comment_count >= (select min_comm from params))
),
enriched as (
  select
    hq.*,
    au.displayname as asker_name,
    au.reputation as asker_rep,
    coalesce(bm.gold_badges,0) as gold_badges,
    coalesce(bm.silver_badges,0) as silver_badges,
    coalesce(bm.bronze_badges,0) as bronze_badges,
    coalesce(bm.tag_badges,0) as tag_badges,
    bm.last_badge_at
  from heavy_q hq
  left join active_users au on au.user_id = hq.asker_id
  left join badge_mix bm on bm.userid = hq.asker_id
),
accepted_answerer as (
  select
    q.question_id,
    a.owneruserid as accepted_user_id,
    u.displayname as accepted_user,
    u.reputation as accepted_user_rep
  from posts q
  join posts a on a.id = q.acceptedanswerid
  left join users u on u.id = a.owneruserid
  where q.posttypeid = 1 and q.acceptedanswerid is not null
),
stats as (
  select
    avg(q_views * 1.0) as mean_views,
    stddev_pop(q_views * 1.0) as sd_views,
    avg(q_score * 1.0) as mean_score,
    stddev_pop(q_score * 1.0) as sd_score
  from ranked
),
scored as (
  select
    e.*,
    aa.accepted_user,
    aa.accepted_user_rep,
    case
      when (select sd_views from stats) > 0 then (e.q_views - (select mean_views from stats)) / nullif((select sd_views from stats),0)
      else null
    end as z_views,
    case
      when (select sd_score from stats) > 0 then (e.q_score - (select mean_score from stats)) / nullif((select sd_score from stats),0)
      else null
    end as z_score
  from enriched e
  left join accepted_answerer aa on aa.question_id = e.question_id
),
dup_inbound as (
  select
    rl.relatedpostid as question_id,
    sum(case when rl.linktypeid = 3 then rl.link_count else 0 end) as inbound_dups,
    sum(case when rl.linktypeid = 1 then rl.link_count else 0 end) as inbound_links
  from link_rollup rl
  group by rl.relatedpostid
),
top_global as (
  select * from scored where global_rank <= 200
),
top_per_tag as (
  select * from scored where tag_rank <= 10
),
outliers as (
  select * from scored where coalesce(z_views,0) >= 2 or coalesce(z_score,0) >= 2
),
unioned as (
  select * from top_global
  union
  select * from top_per_tag
  union
  select * from outliers
)
select
  u.question_id,
  u.tagname,
  u.global_rank,
  u.tag_rank,
  u.global_decile,
  u.bounty_rank,
  u.composite_score,
  u.q_score,
  u.q_views,
  u.q_favs,
  u.answer_count,
  u.pos_answer_count,
  u.max_answer_score,
  u.min_answer_score,
  round(u.avg_answer_score * 1.0, 3) as avg_answer_score,
  u.comment_count,
  u.comment_score_nonneg,
  u.upvotes,
  u.downvotes,
  u.favorites_votes,
  u.bounty_started,
  u.bounty_awarded,
  u.closed_events,
  u.reopened_events,
  u.bumps,
  u.hot_selected,
  u.hot_removed,
  u.last_answer_at,
  u.last_comment_at,
  u.last_closed_at,
  u.last_reopened_at,
  coalesce(di.inbound_dups,0) as inbound_dups,
  coalesce(di.inbound_links,0) as inbound_links,
  coalesce(u.asker_name, '[deleted]') as asker_name,
  coalesce(u.asker_rep, 0) as asker_rep,
  u.gold_badges,
  u.silver_badges,
  u.bronze_badges,
  u.tag_badges,
  u.last_badge_at,
  coalesce(u.accepted_user, '[none]') as accepted_user,
  coalesce(u.accepted_user_rep, 0) as accepted_user_rep,
  case
    when u.tagname = 'untagged' then '[untagged]'
    else lower(u.tagname)
  end as tagname_norm,
  case
    when u.acceptedanswerid is null then 'unaccepted'
    else 'accepted'
  end as accept_state,
  case
    when (u.closed_events > 0 and u.reopened_events = 0) or u.last_closed_at is not null then 1
    when u.closed_events = 0 and u.reopened_events > 0 then 0
    else null
  end as likely_closed_flag,
  (
    select count(distinct c.userid)
    from comments c
    where c.postid = u.question_id
      and c.userid is not null
  ) as distinct_commenters,
  coalesce(array_to_string(u.tag_arr, '|'), '') as tags_pipe,
  sum(u.composite_score) over (partition by u.tagname) as tag_total_composite,
  avg(u.composite_score) over () as global_avg_composite
from unioned u
left join dup_inbound di on di.question_id = u.question_id
group by
  u.question_id,
  u.tagname,
  u.global_rank,
  u.tag_rank,
  u.global_decile,
  u.bounty_rank,
  u.composite_score,
  u.q_score,
  u.q_views,
  u.q_favs,
  u.answer_count,
  u.pos_answer_count,
  u.max_answer_score,
  u.min_answer_score,
  u.avg_answer_score,
  u.comment_count,
  u.comment_score_nonneg,
  u.upvotes,
  u.downvotes,
  u.favorites_votes,
  u.bounty_started,
  u.bounty_awarded,
  u.closed_events,
  u.reopened_events,
  u.bumps,
  u.hot_selected,
  u.hot_removed,
  u.last_answer_at,
  u.last_comment_at,
  u.last_closed_at,
  u.last_reopened_at,
  di.inbound_dups,
  di.inbound_links,
  u.asker_name,
  u.asker_rep,
  u.gold_badges,
  u.silver_badges,
  u.bronze_badges,
  u.tag_badges,
  u.last_badge_at,
  u.accepted_user,
  u.accepted_user_rep,
  u.tag_arr,
  u.acceptedanswerid,
  u.composite_score
order by
  u.global_rank nulls last,
  u.tag_rank nulls last,
  u.composite_score desc,
  u.q_views desc
limit 1000;