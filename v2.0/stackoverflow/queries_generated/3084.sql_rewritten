-- {"query": "3084.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2175} 
WITH 
-- 1. Basic per‑user statistics (aggregates + window function)
usr_stats AS (
    SELECT 
        u.Id                               AS user_id,
        u.DisplayName                      AS display_name,
        u.Reputation,
        COUNT(p.Id)                        AS post_cnt,
        COALESCE(SUM(p.Score),0)           AS total_score,
        COALESCE(AVG(p.Score),0)           AS avg_score,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY COALESCE(SUM(p.Score),0) DESC) AS rn_score
    FROM Users u
    LEFT JOIN Posts p
           ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),

-- 2. Badge aggregation with conditional counting
badge_agg AS (
    SELECT 
        b.UserId                              AS user_id,
        MAX(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS has_gold,
        MAX(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS has_silver,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze_cnt
    FROM Badges b
    GROUP BY b.UserId
),

-- 3. Top 50 tags (excluding moderator‑only) ranked with window function
top_tags AS (
    SELECT 
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS tag_rank
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
    ORDER BY t.Count DESC
    LIMIT 50
),

-- 4. Per‑user tag activity (correlated sub‑query + lateral unnest)
usr_tag_activity AS (
    SELECT 
        u.Id                                 AS user_id,
        tt.TagName,
        COUNT(*) FILTER (WHERE p.Score > 0)  AS pos_posts,
        COUNT(*) FILTER (WHERE p.Score < 0)  AS neg_posts
    FROM Users u
    JOIN Posts p
          ON p.OwnerUserId = u.Id
    CROSS JOIN LATERAL (
        SELECT unnest(string_to_array(
                     substring(p.Tags, 2, length(p.Tags)-2), '><')) AS TagName
    ) AS pt
    JOIN top_tags tt
          ON tt.TagName = pt.TagName
    GROUP BY u.Id, tt.TagName
),

-- 5. Recent vote stats for the latest post of each user (correlated sub‑query)
recent_votes AS (
    SELECT 
        u.Id                                 AS user_id,
        COALESCE(SUM(CASE WHEN vt.Name = 'UpMod'   THEN 1 ELSE 0 END),0) AS up_votes,
        COALESCE(SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END),0) AS down_votes,
        MAX(v.CreationDate)                  AS last_vote_ts
    FROM Users u
    LEFT JOIN LATERAL (
        SELECT p.Id
        FROM Posts p
        WHERE p.OwnerUserId = u.Id
        ORDER BY p.CreationDate DESC
        LIMIT 1
    ) AS latest_post ON TRUE
    LEFT JOIN Votes v
           ON v.PostId = latest_post.Id
    LEFT JOIN VoteTypes vt
           ON vt.Id = v.VoteTypeId
    WHERE v.CreationDate >= (cast('2024-10-01' as date) - INTERVAL '30 days')
    GROUP BY u.Id
),

-- 6. Users that should be excluded (example: missing email hash or flagged)
exclusion_set AS (
    SELECT u.Id AS user_id
    FROM Users u
    WHERE u.EmailHash IS NULL
       OR u.Reputation < 100
)

-- Final result set with outer joins, complex predicates, NULL handling,
-- UNION ALL and EXCEPT to stress the engine
SELECT
    us.user_id,
    us.display_name,
    us.Reputation,
    us.post_cnt,
    us.total_score,
    us.avg_score,
    ba.has_gold,
    ba.has_silver,
    ba.bronze_cnt,
    uta.TagName,
    uta.pos_posts,
    uta.neg_posts,
    rv.up_votes,
    rv.down_votes,
    rv.last_vote_ts
FROM usr_stats us
LEFT JOIN badge_agg ba
       ON ba.user_id = us.user_id
LEFT JOIN usr_tag_activity uta
       ON uta.user_id = us.user_id
LEFT JOIN recent_votes rv
       ON rv.user_id = us.user_id
WHERE us.Reputation > 10000
  AND (ba.has_gold = 1 OR ba.bronze_cnt >= 5)
  AND (uta.pos_posts > uta.neg_posts OR uta.pos_posts IS NULL)
  AND us.rn_score = 1                                 -- keep only top‑scoring row per user
UNION ALL
SELECT
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
EXCEPT
SELECT
    e.user_id,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
FROM exclusion_set e;