with recent_users as (
    select
        u.id as user_id,
        u.displayname,
        u.reputation,
        u.creationdate,
        u.location,
        coalesce(nullif(trim(split_part(coalesce(u.websiteurl, ''), '/', 3)), ''), 'unknown') as domain,
        date_trunc('month', u.creationdate) as signup_month,
        row_number() over (partition by coalesce(u.location, 'unknown') order by u.reputation desc, u.id) as rn_loc
    from users u
    where u.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
question_activity as (
    select
        p.owneruserid as user_id,
        count(*) as q_count,
        sum(coalesce(p.viewcount,0)) as q_views,
        sum(case when p.acceptedanswerid is not null then 1 else 0 end) as q_with_accepted,
        avg(nullif(p.score,0)) filter (where p.score is not null) as avg_q_score_nonzero,
        max(p.lastactivitydate) as last_q_activity
    from posts p
    where p.posttypeid = 1
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by p.owneruserid
),
answer_activity as (
    select
        p.owneruserid as user_id,
        count(*) as a_count,
        sum(coalesce(p.score,0)) as a_score,
        count(distinct p.parentid) as answered_questions,
        percentile_cont(0.5) within group (order by coalesce(p.score,0)) as median_a_score
    from posts p
    where p.posttypeid = 2
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by p.owneruserid
),
comment_stats as (
    select
        c.userid as user_id,
        count(*) as c_count,
        sum(coalesce(c.score,0)) as c_score,
        max(c.creationdate) as last_comment_date
    from comments c
    where c.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by c.userid
),
badge_pivot as (
    select
        b.userid as user_id,
        sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
        sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
        sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
        sum(case when b.tagbased = 1 then 1 else 0 end) as tag_badges,
        count(*) as total_badges,
        min(b.date) as first_badge_date,
        max(b.date) as last_badge_date
    from badges b
    where b.date >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by b.userid
),
vote_pivot as (
    select
        v.userid as user_id,
        sum(case when v.votetypeid = 2 then 1 else 0 end) as upmods,
        sum(case when v.votetypeid = 3 then 1 else 0 end) as downmods,
        sum(case when v.votetypeid = 8 then coalesce(v.bountyamount,0) else 0 end) as bounty_started,
        sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded,
        count(*) filter (where v.votetypeid in (10,11,12)) as del_undel_spam
    from votes v
    where v.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    group by v.userid
),
dup_links as (
    select
        pl.postid as dup_post_id,
        pl.relatedpostid as canonical_post_id,
        count(*) as dup_links_count,
        min(pl.creationdate) as first_dup_link_date
    from postlinks pl
    where pl.linktypeid = 3
    group by pl.postid, pl.relatedpostid
),
closed_reasons as (
    select
        ph.postid,
        max(ph.creationdate) filter (where ph.posthistorytypeid = 10) as last_closed_date,
        max(case when ph.posthistorytypeid = 10 then nullif(ph.comment,'') end) as last_close_reason_text
    from posthistory ph
    where ph.posthistorytypeid in (10,11,12,13,14,15,19,20,35)
    group by ph.postid
),
question_flags as (
    select
        p.id as post_id,
        p.owneruserid as user_id,
        case when cr.last_close_reason_text in ('101') then 1 else 0 end as was_duplicate,
        case when cr.last_close_reason_text in ('102') then 1 else 0 end as was_offtopic,
        case when cr.last_close_reason_text in ('103','104','105') then 1 else 0 end as was_quality_close,
        case when cr.last_closed_date is not null then 1 else 0 end as was_closed
    from posts p
    left join closed_reasons cr on cr.postid = p.id
    where p.posttypeid = 1
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
user_quality as (
    select
        qa.user_id,
        sum(qa.was_duplicate) as dup_q,
        sum(qa.was_offtopic) as offtopic_q,
        sum(qa.was_quality_close) as quality_close_q,
        sum(qa.was_closed) as closed_q
    from question_flags qa
    group by qa.user_id
),
tag_activity as (
    select
        p.owneruserid as user_id,
        unnest(string_to_array(coalesce(nullif(substring(p.tags, 2, length(p.tags)-2), ''), ''), '><')) as tag_name
    from posts p
    where p.posttypeid = 1
      and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
top_tags as (
    select
        ta.user_id,
        t.tagname,
        sum(t.count) over (partition by ta.user_id) as user_tag_total,
        count(*) as tag_uses,
        row_number() over (partition by ta.user_id order by count(*) desc, t.count desc nulls last, t.tagname) as rn_tag
    from tag_activity ta
    left join tags t on lower(t.tagname) = lower(ta.tag_name)
    group by ta.user_id, t.tagname
),
user_recent_score_trend as (
    select
        p.owneruserid as user_id,
        date_trunc('month', p.creationdate) as month,
        sum(coalesce(p.score,0)) as month_score,
        avg(sum(coalesce(p.score,0))) over (partition by p.owneruserid order by date_trunc('month', p.creationdate) rows between 2 preceding and current row) as rolling_3mo_avg_score
    from posts p
    where p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '18 months'
      and p.posttypeid in (1,2)
    group by p.owneruserid, date_trunc('month', p.creationdate)
),
ranked_recent_users as (
    select
        ru.*,
        dense_rank() over (order by ru.reputation desc, ru.user_id) as dr_all,
        dense_rank() over (partition by coalesce(ru.location,'unknown') order by ru.reputation desc, ru.user_id) as dr_by_loc
    from recent_users ru
),
engagement as (
    select
        u.id as user_id,
        coalesce(q.q_count,0) + coalesce(a.a_count,0) as posts_last5y,
        coalesce(c.c_count,0) as comments_last5y,
        coalesce(v.upmods,0) - coalesce(v.downmods,0) as net_votes_cast,
        coalesce(a.a_score,0) + coalesce(q.avg_q_score_nonzero,0) as combined_score_metric
    from users u
    left join question_activity q on q.user_id = u.id
    left join answer_activity a on a.user_id = u.id
    left join comment_stats c on c.user_id = u.id
    left join vote_pivot v on v.user_id = u.id
),
qualified_users as (
    select
        rr.user_id,
        rr.displayname,
        rr.reputation,
        rr.location,
        rr.domain,
        rr.signup_month,
        rr.dr_all,
        rr.dr_by_loc,
        e.posts_last5y,
        e.comments_last5y,
        e.net_votes_cast,
        e.combined_score_metric,
        coalesce(q.q_count,0) as q_count,
        coalesce(q.q_views,0) as q_views,
        coalesce(q.q_with_accepted,0) as q_with_accepted,
        coalesce(a.a_count,0) as a_count,
        coalesce(a.answered_questions,0) as answered_questions,
        coalesce(a.median_a_score,0) as median_a_score,
        coalesce(c.c_count,0) as c_count,
        coalesce(b.total_badges,0) as total_badges,
        coalesce(b.gold_badges,0) as gold_badges,
        coalesce(b.silver_badges,0) as silver_badges,
        coalesce(b.bronze_badges,0) as bronze_badges,
        coalesce(b.tag_badges,0) as tag_badges,
        coalesce(v.upmods,0) as upmods_cast,
        coalesce(v.downmods,0) as downmods_cast,
        coalesce(v.bounty_started,0) as bounty_started,
        coalesce(v.bounty_awarded,0) as bounty_awarded,
        coalesce(uq.dup_q,0) as dup_q,
        coalesce(uq.offtopic_q,0) as offtopic_q,
        coalesce(uq.quality_close_q,0) as quality_close_q,
        coalesce(uq.closed_q,0) as closed_q
    from ranked_recent_users rr
    left join question_activity q on q.user_id = rr.user_id
    left join answer_activity a on a.user_id = rr.user_id
    left join comment_stats c on c.user_id = rr.user_id
    left join badge_pivot b on b.user_id = rr.user_id
    left join vote_pivot v on v.user_id = rr.user_id
    left join user_quality uq on uq.user_id = rr.user_id
    left join engagement e on e.user_id = rr.user_id
    where rr.rn_loc <= 500
),
final_scores as (
    select
        qu.*,
        coalesce(nullif(least(greatest(qu.reputation, 1), 1000000),0),1) as rep_cap,
        coalesce(nullif(qu.a_count + qu.q_count,0),1) as posts_cnt_safe,
        coalesce(nullif(qu.total_badges,0),1) as badges_safe,
        case
            when qu.q_count > 0 then cast(qu.q_with_accepted as numeric) / nullif(qu.q_count,0)
            else 0
        end as accept_ratio,
        case
            when qu.answered_questions > 0 then cast(qu.a_count as numeric) / nullif(qu.answered_questions,0)
            else 0
        end as answers_per_question_ratio,
        (coalesce(qu.gold_badges,0)*5 + coalesce(qu.silver_badges,0)*3 + coalesce(qu.bronze_badges,0))::numeric as badge_weight,
        greatest(0, 1 - (coalesce(qu.dup_q,0) + coalesce(qu.offtopic_q,0) + coalesce(qu.quality_close_q,0))::numeric / (1 + coalesce(qu.q_count,0))) as quality_penalty,
        case when coalesce(qu.bounty_started,0) > 0 then ln(1 + coalesce(qu.bounty_awarded,0)) else 0 end as bounty_signal
    from qualified_users qu
),
scored as (
    select
        fs.*,
        (
            0.35 * ln(1 + fs.rep_cap)
          + 0.20 * ln(1 + fs.posts_cnt_safe)
          + 0.10 * ln(1 + fs.badges_safe + fs.badge_weight)
          + 0.15 * (fs.accept_ratio * 10 + fs.answers_per_question_ratio * 5 + greatest(0, fs.median_a_score))
          + 0.08 * ln(1 + greatest(0, fs.net_votes_cast + fs.upmods_cast - fs.downmods_cast))
          + 0.07 * ln(1 + fs.comments_last5y)
          + 0.05 * fs.bounty_signal
        ) * fs.quality_penalty as composite_score
    from final_scores fs
),
with_top_tag as (
    select
        s.*,
        tt.tagname as top_tag,
        tt.tag_uses,
        tt.user_tag_total
    from scored s
    left join top_tags tt
      on tt.user_id = s.user_id
     and tt.rn_tag = 1
),
activity_span as (
    select
        qt.user_id,
        min(coalesce(qh.creationdate, ah.creationdate, ch.creationdate)) as first_activity,
        max(coalesce(qh.lastactivitydate, ah.creationdate, ch.creationdate)) as last_activity
    from qualified_users qt
    left join lateral (
        select min(p.creationdate) as creationdate, max(p.lastactivitydate) as lastactivitydate
        from posts p
        where p.owneruserid = qt.user_id
          and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    ) qh on true
    left join lateral (
        select min(p.creationdate) as creationdate
        from posts p
        where p.owneruserid = qt.user_id
          and p.posttypeid = 2
          and p.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    ) ah on true
    left join lateral (
        select min(c.creationdate) as creationdate
        from comments c
        where c.userid = qt.user_id
          and c.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
    ) ch on true
    group by qt.user_id
),
domain_rollup as (
    select
        wt.domain,
        percentile_cont(0.9) within group (order by wt.composite_score) as p90_score,
        avg(wt.composite_score) as avg_score,
        count(*) as domain_users
    from with_top_tag wt
    group by wt.domain
),
final_rank as (
    select
        wt.*,
        a.first_activity,
        a.last_activity,
        dr.p90_score,
        dr.avg_score,
        dr.domain_users,
        row_number() over (order by wt.composite_score desc, wt.reputation desc, wt.user_id) as global_rank,
        row_number() over (partition by coalesce(wt.location,'unknown') order by wt.composite_score desc, wt.reputation desc, wt.user_id) as location_rank,
        row_number() over (partition by coalesce(wt.top_tag,'unknown') order by wt.composite_score desc, wt.reputation desc, wt.user_id) as tag_rank
    from with_top_tag wt
    left join activity_span a on a.user_id = wt.user_id
    left join domain_rollup dr on dr.domain = wt.domain
)
select
    fr.user_id,
    fr.displayname,
    fr.location,
    fr.domain,
    fr.signup_month,
    fr.reputation,
    fr.global_rank,
    fr.location_rank,
    fr.tag_rank,
    fr.top_tag,
    fr.tag_uses,
    fr.user_tag_total,
    fr.q_count,
    fr.a_count,
    fr.c_count,
    fr.q_views,
    fr.q_with_accepted,
    fr.accept_ratio,
    fr.answered_questions,
    fr.answers_per_question_ratio,
    fr.median_a_score,
    fr.total_badges,
    fr.gold_badges,
    fr.silver_badges,
    fr.bronze_badges,
    fr.tag_badges,
    fr.upmods_cast,
    fr.downmods_cast,
    fr.bounty_started,
    fr.bounty_awarded,
    fr.dup_q,
    fr.offtopic_q,
    fr.quality_close_q,
    fr.closed_q,
    fr.composite_score,
    fr.first_activity,
    fr.last_activity,
    fr.p90_score as domain_p90_score,
    fr.avg_score as domain_avg_score,
    fr.domain_users
from final_rank fr
where fr.composite_score is not null
  and fr.global_rank <= 1000
order by fr.composite_score desc, fr.reputation desc, fr.user_id;