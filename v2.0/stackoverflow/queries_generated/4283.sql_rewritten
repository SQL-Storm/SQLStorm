-- {"query": "4283.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1505} 
WITH UserPostActivity AS (
    SELECT
        p.OwnerUserId,
        COUNT(p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswerCount,
        AVG(p.Score) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        COALESCE(SUM(p.FavoriteCount), 0) AS TotalFavorites
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL
    GROUP BY p.OwnerUserId
),
UserCommentActivity AS (
    SELECT
        c.UserId,
        COUNT(c.Id) AS TotalComments,
        AVG(c.Score) AS AvgCommentScore,
        MAX(c.CreationDate) AS LastCommentDate
    FROM Comments c
    WHERE c.UserId IS NOT NULL
    GROUP BY c.UserId
),
UserVoteActivity AS (
    SELECT
        v.UserId,
        COUNT(CASE WHEN vt.Name = 'UpMod' THEN v.Id ELSE NULL END) AS UpVotesReceived,
        COUNT(CASE WHEN vt.Name = 'DownMod' THEN v.Id ELSE NULL END) AS DownVotesReceived,
        COUNT(CASE WHEN vt.Name = 'Favorite' THEN v.Id ELSE NULL END) AS FavoritesGiven,
        MAX(v.CreationDate) AS LastVoteDate
    FROM Votes v
    JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
    WHERE v.UserId IS NOT NULL
    GROUP BY v.UserId
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN b.Id ELSE NULL END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN b.Id ELSE NULL END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN b.Id ELSE NULL END) AS BronzeBadges,
        MAX(b.Date) AS LastBadgeDate
    FROM Badges b
    WHERE b.UserId IS NOT NULL
    GROUP BY b.UserId
),
QuestionDetails AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.OwnerUserId,
        p.CreationDate AS QuestionCreationDate,
        p.AnswerCount,
        p.Score AS QuestionScore,
        p.ViewCount,
        p.ClosedDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS RowNum
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL
)
SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.Views AS UserViews,
    u.UpVotes AS UserUpVotes,
    u.DownVotes AS UserDownVotes,
    u.CreationDate AS UserCreationDate,
    COALESCE(upa.TotalPosts, 0) AS TotalPostsByUpa,
    COALESCE(upa.QuestionCount, 0) AS QuestionCountByUpa,
    COALESCE(upa.AnswerCount, 0) AS AnswerCountByUpa,
    upa.AvgPostScore,
    COALESCE(uca.TotalComments, 0) AS TotalCommentsByUca,
    uca.AvgCommentScore,
    COALESCE(uva.UpVotesReceived, 0) AS UpVotesReceivedByUva,
    COALESCE(uva.DownVotesReceived, 0) AS DownVotesReceivedByUva,
    COALESCE(ubs.GoldBadges, 0) AS GoldBadgesByUbs,
    COALESCE(ubs.SilverBadges, 0) AS SilverBadgesByUbs,
    COALESCE(ubs.BronzeBadges, 0) AS BronzeBadgesByUbs,
    CASE
        WHEN u.WebsiteUrl IS NULL OR u.WebsiteUrl = '' THEN 'No Website'
        WHEN u.WebsiteUrl LIKE '%stackoverflow.com%' THEN 'Stack Overflow Related'
        ELSE 'External Website'
    END AS WebsiteCategory,
    CASE
        WHEN qd.AnswerCount > 10 AND qd.QuestionScore > 50 THEN 'High Performing Question'
        WHEN qd.ClosedDate IS NOT NULL THEN 'Closed Question'
        ELSE 'Standard Question'
    END AS QuestionStatus,
    COALESCE(pht.EditCount, 0) AS PostEditCount,
    COALESCE(pl.DuplicateLinkCount, 0) AS DuplicateLinkCount,
    UPPER(SUBSTRING(u.DisplayName FROM 1 FOR 3)) AS DisplayNamePrefix,
    upa.LastPostDate,
    uca.LastCommentDate,
    uva.LastVoteDate,
    ubs.LastBadgeDate,
    qd.QuestionCreationDate AS MostRecentQuestionDate,
    qd.ViewCount AS MostRecentQuestionViews,
    qd.QuestionScore AS MostRecentQuestionScore,
    qd.Title AS MostRecentQuestionTitle,
    CASE
        WHEN u.AccountId IS NULL THEN 'No AccountId'
        WHEN u.AccountId = -1 THEN 'Community User'
        ELSE 'Regular User'
    END AS AccountType,
    CAST(strftime('%Y', u.CreationDate) AS INTEGER) AS UserCreationYear,
    CASE
        WHEN u.LastAccessDate < DATETIME('now', '-1 year') THEN 'Inactive User'
        ELSE 'Active User'
    END AS UserActivityStatus
FROM Users u
LEFT OUTER JOIN UserPostActivity upa ON u.Id = upa.OwnerUserId
LEFT OUTER JOIN UserCommentActivity uca ON u.Id = uca.UserId
LEFT OUTER JOIN UserVoteActivity uva ON u.Id = uva.UserId
LEFT OUTER JOIN UserBadgeSummary ubs ON u.Id = ubs.UserId
LEFT OUTER JOIN (
    SELECT OwnerUserId, COUNT(*) AS EditCount
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4, 5, 6) -- Edit Title, Edit Body, Edit Tags
    GROUP BY OwnerUserId
) pht ON u.Id = pht.OwnerUserId
LEFT OUTER JOIN (
    SELECT PostId, COUNT(*) AS DuplicateLinkCount
    FROM PostLinks
    WHERE LinkTypeId = 3
    GROUP BY PostId
) pl ON u.Id = pl.PostId
LEFT OUTER JOIN QuestionDetails qd ON u.Id = qd.OwnerUserId AND qd.RowNum = 1
ORDER BY u.Reputation DESC
LIMIT 100;