WITH recent_closed AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.OwnerDisplayName,
    p.ParentId,
    p.PostTypeId,
    p.AcceptedAnswerId,
    p.LastEditorUserId,
    b.Name AS BadgeName,
    b.Class AS BadgeClass,
    pv.VoteTypeId,
    pv.UserId AS VoterUserId,
    pv.CreationDate AS VoteDate,
    ht.Name AS HistTypeName
  FROM Posts p
  LEFT JOIN PostHistory ph
    ON ph.PostId = p.Id
  LEFT JOIN PostHistoryTypes ht
    ON ht.Id = ph.PostHistoryTypeId
  LEFT JOIN Badges b
    ON b.UserId = p.OwnerUserId
  LEFT JOIN Votes pv
    ON pv.PostId = p.Id
  WHERE
    p.CloseDate IS NOT NULL OR ph.PostHistoryTypeId = 10
),
qualified AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.OwnerDisplayName,
    p.ParentId,
    p.PostTypeId,
    p.AcceptedAnswerId,
    p.LastEditorUserId,
    ROW_NUMBER() OVER (
      PARTITION BY p.OwnerUserId
      ORDER BY p.LastActivityDate DESC, p.Score DESC
    ) AS rn_by_owner,
    ROW_NUMBER() OVER (
      ORDER BY p.ViewCount DESC, p.Score DESC, p.LastActivityDate DESC
    ) AS overall_rank
  FROM Posts p
  LEFT JOIN PostLinks pl ON pl.PostId = p.Id
  LEFT JOIN Votes v ON v.PostId = p.Id
  WHERE
    p.PostTypeId = 1 -- only Questions
    AND p.CreationDate >= DATEADD(year, -2, cast('2024-10-01' as date))
),
complex AS (
  SELECT
    q.PostId,
    q.Title,
    q.Tags,
    q.CreationDate,
    q.LastActivityDate,
    q.Score,
    q.ViewCount,
    q.OwnerUserId,
    u.Reputation,
    u.DisplayName,
    COUNT(DISTINCT cl.Id) AS CommentCount,
    COUNT(DISTINCT a.Id) AS AnswerCount,
    STRING_AGG(DISTINCT lt.Name, ',') AS LinkedTypes,
    MAX(CASE WHEN v.VoteTypeId = 2 THEN v.CreationDate END) AS LastUpvoteDate,
    MAX(CASE WHEN v.VoteTypeId = 3 THEN v.CreationDate END) AS LastDownvoteDate
  FROM qualified q
  LEFT JOIN Users u ON u.Id = q.OwnerUserId
  LEFT JOIN Posts a ON a.ParentId = q.PostId AND a.PostTypeId = 2
  LEFT JOIN PostLinks pl ON pl.PostId = q.PostId
  LEFT JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
  LEFT JOIN Votes v ON v.PostId = q.PostId
  LEFT JOIN Comments cl ON cl.PostId = q.PostId
  GROUP BY
    q.PostId, q.Title, q.Tags, q.CreationDate, q.LastActivityDate,
    q.Score, q.ViewCount, q.OwnerUserId, u.Reputation, u.DisplayName
),
final AS (
  SELECT
    c.PostId,
    c.Title,
    c.Tags,
    c.CreationDate,
    c.LastActivityDate,
    c.Score,
    c.ViewCount,
    c.OwnerUserId,
    c.Reputation,
    c.DisplayName,
    c.CommentCount,
    c.AnswerCount,
    c.LinkedTypes,
    c.LastUpvoteDate,
    c.LastDownvoteDate,
    ROW_NUMBER() OVER (
      PARTITION BY c.OwnerUserId
      ORDER BY c.LastActivityDate DESC, c.Score DESC
    ) AS rn_owner
  FROM complex c
)
SELECT
  f.PostId,
  f.Title,
  f.Tags,
  f.CreationDate,
  f.LastActivityDate,
  f.Score,
  f.ViewCount,
  f.OwnerUserId,
  f.Reputation,
  f.DisplayName,
  f.CommentCount,
  f.AnswerCount,
  f.LinkedTypes,
  f.LastUpvoteDate,
  f.LastDownvoteDate,
  f.rn_owner
FROM final f
WHERE f.rn_owner <= 5
ORDER BY f.LastActivityDate DESC, f.Score DESC
;