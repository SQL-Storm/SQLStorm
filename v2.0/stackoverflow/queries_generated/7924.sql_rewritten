-- {"query": "7924.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "qwen3-coder", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2102, "output_tokens": 2478} 
WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        AVG(p.Score) AS AvgPostScore,
        MAX(p.CreationDate) AS LatestPostDate,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS rn,
        CASE 
            WHEN u.Reputation >= 10000 THEN 'Elite'
            WHEN u.Reputation >= 1000 THEN 'Veteran'
            WHEN u.Reputation >= 100 THEN 'Regular'
            ELSE 'Newbie'
        END AS ReputationTier,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2) FROM STRING_TO_ARRAY(p.Tags, '><') WHERE p.Tags IS NOT NULL AND p.Tags != '') AS AllTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId OR u.Id = p.LastEditorUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IN (SELECT DISTINCT OwnerUserId FROM Posts WHERE OwnerUserId IS NOT NULL)
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
TopPosts AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Tags,
        p.ParentId,
        ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS RankByScore,
        DENSE_RANK() OVER (ORDER BY p.CreationDate DESC) AS RecentRank,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostType,
        (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId IN (2, 3)) AS VoteCount,
        (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCountActual,
        COALESCE(p.AcceptedAnswerId, 0) AS HasAcceptedAnswer
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) 
      AND p.CreationDate >= DATEADD('year', -1, cast('2024-10-01' as date)) 
      AND p.Score >= 100
),
RecentActivity AS (
    SELECT 
        ph.PostId,
        ph.UserId,
        ph.CreationDate,
        ph.PostHistoryTypeId,
        ph.Comment,
        ph.Text,
        (SELECT Name FROM PostHistoryTypes WHERE Id = ph.PostHistoryTypeId) AS ActionName,
        CASE 
            WHEN ph.PostHistoryTypeId IN (10, 11) THEN 'Closed/Reopened'
            WHEN ph.PostHistoryTypeId IN (12, 13) THEN 'Deleted/Undeleted'
            WHEN ph.PostHistoryTypeId IN (14, 15) THEN 'Locked/Unlocked'
            ELSE 'Other'
        END AS Category,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS ActivityRank
    FROM PostHistory ph
    WHERE ph.CreationDate >= DATEADD('month', -6, cast('2024-10-01' as date))
),
BadgeAnalysis AS (
    SELECT 
        b.UserId,
        b.Name,
        b.Date,
        b.Class,
        CASE 
            WHEN b.Class = 1 THEN 'Gold'
            WHEN b.Class = 2 THEN 'Silver'
            ELSE 'Bronze'
        END AS BadgeTier,
        COUNT(*) OVER (PARTITION BY b.UserId, b.Class) AS ClassCount,
        RANK() OVER (PARTITION BY b.UserId ORDER BY b.Date DESC) AS RecentBadgeRank,
        LAG(b.Date) OVER (PARTITION BY b.UserId ORDER BY b.Date ASC) AS PreviousBadgeDate
    FROM Badges b
    WHERE b.Class IN (1, 2, 3)
),
CombinedAnalysis AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Reputation,
        us.PostCount,
        us.CommentCount,
        us.BadgeCount,
        us.AvgPostScore,
        us.LatestPostDate,
        us.ReputationTier,
        us.AllTags,
        tp.PostId,
        tp.Title,
        tp.Score,
        tp.ViewCount,
        tp.AnswerCount,
        tp.CommentCount AS ExpectedComments,
        tp.CommentCountActual AS ActualComments,
        tp.CreationDate AS PostCreationDate,
        tp.PostType,
        tp.RankByScore,
        tp.RecentRank,
        ra.ActionName,
        ra.Category,
        ra.CreationDate AS ActivityDate,
        ba.Name AS BadgeName,
        ba.BadgeTier,
        ba.ClassCount,
        ba.RecentBadgeRank
    FROM UserStats us
    INNER JOIN TopPosts tp ON us.UserId = tp.OwnerUserId
    LEFT JOIN RecentActivity ra ON tp.PostId = ra.PostId AND ra.ActivityRank = 1
    LEFT JOIN BadgeAnalysis ba ON us.UserId = ba.UserId AND ba.RecentBadgeRank = 1
    WHERE us.Reputation > 500 
      AND us.PostCount > 10
      AND (tp.Score > 500 OR tp.ViewCount > 1000)
)
SELECT 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.PostCount,
    ca.CommentCount,
    ca.BadgeCount,
    ca.AvgPostScore,
    ca.LatestPostDate,
    ca.ReputationTier,
    ca.AllTags,
    ca.PostId,
    ca.Title,
    ca.Score,
    ca.ViewCount,
    ca.AnswerCount,
    ca.ExpectedComments,
    ca.ActualComments,
    ca.PostCreationDate,
    ca.PostType,
    ca.RankByScore,
    ca.RecentRank,
    ca.ActionName,
    ca.Category,
    ca.ActivityDate,
    ca.BadgeName,
    ca.BadgeTier,
    ca.ClassCount,
    ca.RecentBadgeRank,
    (SELECT COUNT(*) FROM CombinedAnalysis WHERE UserId = ca.UserId) AS UserTotalRecords,
    CASE 
        WHEN ca.ReputationTier IN ('Elite', 'Veteran') AND ca.PostCount > 50 THEN 'Highly Active'
        WHEN ca.ReputationTier IN ('Regular') AND ca.Score > 1000 THEN 'High Scorer'
        ELSE 'Standard'
    END AS UserSegment,
    ABS(DATEDIFF('day', ca.PostCreationDate, cast('2024-10-01' as date)) - 
         COALESCE(DATEDIFF('day', ca.ActivityDate, cast('2024-10-01' as date)), 30)) AS DaysSincePost,
    ROUND(
        CASE 
            WHEN ca.ViewCount > 0 THEN (CAST(ca.Score AS FLOAT) / CAST(ca.ViewCount AS FLOAT)) * 1000
            ELSE 0
        END, 2
    ) AS ScorePerView,
    CASE 
        WHEN ca.Score > (SELECT AVG(Score) FROM TopPosts) THEN 'Above Average Score'
        WHEN ca.Score < (SELECT AVG(Score) FROM TopPosts) THEN 'Below Average Score'
        ELSE 'Average Score'
    END AS RelativeScoreCategory,
    CASE 
        WHEN LENGTH(ca.Title) > 100 THEN LEFT(ca.Title, 100) || '...'
        ELSE ca.Title
    END AS ShortenedTitle,
    COALESCE(NULLIF(ca.BadgeName, ''), 'No Badge') AS CurrentBadge,
    (SELECT STRING_AGG(DISTINCT SUBSTRING(t.Tags, 2, LENGTH(t.Tags) - 2) FROM STRING_TO_ARRAY(t.Tags, '><') AS t WHERE t.Tags IS NOT NULL AND t.Tags != '' AND COALESCE(ca.Tags, '') LIKE '%' || t || '%') AS MatchingTags,
    COALESCE(
        (SELECT STRING_AGG(DISTINCT bt.Name, ', ') FROM BadgeAnalysis bt WHERE bt.UserId = ca.UserId AND bt.ClassCount > 1), 
        'No Multi-Class Badges'
    ) AS MultiClassBadges,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = ca.PostId AND v.VoteTypeId = 3) AS DownvoteCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = ca.PostId AND v.VoteTypeId = 2) AS UpvoteCount,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = ca.PostId AND c.Score > 5) AS HighScoreComments,
    (SELECT COUNT(*) FROM Posts p WHERE p.ParentId = ca.PostId AND p.PostTypeId = 2) AS AnswerCountActual,
    (CASE WHEN ca.HasAcceptedAnswer > 0 THEN 'Has Accepted Answer' ELSE 'No Accepted Answer' END) AS AcceptanceStatus,
    (
        SELECT STRING_AGG(ClassName, '; ') 
        FROM (
            SELECT DISTINCT 
                SUBSTRING(ClassName, 1, 1) || LOWER(SUBSTRING(ClassName, 2)) AS ClassName
            FROM (
                SELECT UNNEST(STRING_TO_ARRAY(TRANSLATE(SUBSTRING(ca.AllTags, 1, 100), '|', ','), ',')) AS ClassName
            ) tags
            WHERE LENGTH(ClassName) > 1
        ) classes
    ) AS PopularClassNames,
    (SELECT AVG(Score) FROM TopPosts tp WHERE tp.OwnerUserId = ca.UserId) AS AvgUserPostScore,
    (SELECT MAX(VoteCount) FROM TopPosts tp WHERE tp.OwnerUserId = ca.UserId) AS MaxUserVotes,
    (SELECT COUNT(*) FROM Posts WHERE OwnerUserId = ca.UserId AND PostTypeId = 1) AS QuestionCount,
    (SELECT COUNT(*) FROM Posts WHERE OwnerUserId = ca.UserId AND PostTypeId = 2) AS AnswerCount,
    (SELECT COUNT(*) FROM Posts WHERE OwnerUserId = ca.UserId AND CreationDate >= DATEADD('week', -2, cast('2024-10-01' as date))) AS RecentPostCount,
    (SELECT COUNT(*) FROM Votes WHERE UserId = ca.UserId AND VoteTypeId IN (2, 3, 5)) AS TotalVotes,
    COALESCE(
        (SELECT SUM(BountyAmount) FROM Votes WHERE UserId = ca.UserId AND VoteTypeId = 8),
        0
    ) AS TotalBountyAmount
FROM CombinedAnalysis ca
WHERE ca.BadgeCount > 0
  AND (ca.Score > 100)
  AND (ca.ViewCount > 50 OR ca.AnswerCount > 5)
  AND ca.PostType = 'Question'
GROUP BY 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.PostCount,
    ca.CommentCount,
    ca.BadgeCount,
    ca.AvgPostScore,
    ca.LatestPostDate,
    ca.ReputationTier,
    ca.AllTags,
    ca.PostId,
    ca.Title,
    ca.Score,
    ca.ViewCount,
    ca.AnswerCount,
    ca.ExpectedComments,
    ca.ActualComments,
    ca.PostCreationDate,
    ca.PostType,
    ca.RankByScore,
    ca.RecentRank,
    ca.ActionName,
    ca.Category,
    ca.ActivityDate,
    ca.BadgeName,
    ca.BadgeTier,
    ca.ClassCount,
    ca.RecentBadgeRank,
    ca.HasAcceptedAnswer
HAVING 
    COUNT(*) > 0
ORDER BY 
    ca.Score DESC,
    ca.Reputation DESC,
    ca.LatestPostDate DESC,
    ca.BadgeCount DESC
LIMIT 100;