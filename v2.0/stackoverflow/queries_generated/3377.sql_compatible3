WITH
TopUsers AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS rn
    FROM Users u
    WHERE u.Reputation IS NOT NULL
),
UserBadgeStats AS (
    SELECT
        b.UserId,
        COUNT(*)                           AS BadgeCount,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS Gold,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS Silver,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS Bronze,
        MAX(b.Date)                        AS LastBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),
TagActivity AS (
    SELECT
        t.TagName,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        SUM(p.Score)                              AS TotalScore,
        AVG(p.ViewCount)                          AS AvgViews,
        STRING_AGG(DISTINCT p.Title, '; ') FILTER (WHERE p.Title IS NOT NULL) AS SampleTitles
    FROM Tags t
    LEFT JOIN Posts p
        ON p.Tags LIKE ('%<' || t.TagName || '>%')
    GROUP BY t.TagName
),
PostScoreHistory AS (
    SELECT
        ph.PostId,
        ph.CreationDate,
        ph.UserId,
        COALESCE(CAST(ph.Text AS INTEGER), 0) AS ScoreChange,
        SUM(COALESCE(CAST(ph.Text AS INTEGER),0)) OVER (
            PARTITION BY ph.PostId
            ORDER BY ph.CreationDate
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS CumulativeScore
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (5,6)
),
RecentClosedDuplicates AS (
    SELECT
        p.Id                     AS QuestionId,
        p.Title,
        p.Tags,
        p.CreationDate,
        ph.CreationDate          AS ClosedDate,
        CAST(ph.Comment AS INTEGER)  AS DuplicateOfId,
        dup.Title                AS DuplicateOfTitle
    FROM Posts p
    JOIN PostHistory ph
        ON ph.PostId = p.Id
       AND ph.PostHistoryTypeId = 10
    LEFT JOIN Posts dup
        ON dup.Id = CAST(ph.Comment AS INTEGER)
    WHERE ph.Comment ~ '^\d+$'
),
AggregatedUserStats AS (
    SELECT
        tu.Id                                   AS UserId,
        tu.DisplayName,
        tu.Reputation,
        ub.BadgeCount,
        ub.Gold,
        ub.Silver,
        ub.Bronze,
        COALESCE(ub.LastBadgeDate, TIMESTAMP '1970-01-01') AS LastBadgeDate,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = tu.Id)                AS TotalPosts,
        (SELECT COUNT(*) FROM Posts a
            WHERE a.ParentId IN (
                SELECT Id FROM Posts q WHERE q.OwnerUserId = tu.Id
            ))                                                                    AS TotalAnswersGiven,
        (SELECT MAX(p.Score) FROM Posts p WHERE p.OwnerUserId = tu.Id)           AS MaxPostScore,
        (SELECT AVG(p.Score) FROM Posts p WHERE p.OwnerUserId = tu.Id)           AS AvgPostScore,
        (SELECT SUM(v.BountyAmount) FROM Votes v
            WHERE v.UserId = tu.Id AND v.VoteTypeId = 8)                         AS TotalBountyStarted,
        (SELECT SUM(v.BountyAmount) FROM Votes v
            WHERE v.UserId = tu.Id AND v.VoteTypeId = 9)                         AS TotalBountyEarned,
        ROW_NUMBER() OVER (ORDER BY tu.Reputation DESC)                         AS ReputationRank,
        COALESCE(latest_psh.CumulativeScore,0)                                   AS LatestCumulativeScore
    FROM TopUsers tu
    LEFT JOIN UserBadgeStats ub
        ON ub.UserId = tu.Id
    LEFT JOIN (
        SELECT psh.CumulativeScore, psh.CreationDate, psh.UserId, psh.PostId
        FROM PostScoreHistory psh
    ) ps ON ps.UserId = tu.Id
    LEFT JOIN LATERAL (
        SELECT psh2.CumulativeScore, psh2.CreationDate, psh2.UserId, psh2.PostId
        FROM PostScoreHistory psh2
        WHERE psh2.UserId = tu.Id
        ORDER BY psh2.CreationDate DESC
        LIMIT 1
    ) latest_psh ON TRUE
    WHERE tu.rn <= 100
)
SELECT
    au.UserId,
    au.DisplayName,
    au.Reputation,
    au.BadgeCount,
    au.Gold,
    au.Silver,
    au.Bronze,
    au.LastBadgeDate,
    au.TotalPosts,
    au.TotalAnswersGiven,
    au.MaxPostScore,
    au.AvgPostScore,
    au.TotalBountyStarted,
    au.TotalBountyEarned,
    au.ReputationRank,
    au.LatestCumulativeScore,
    t.TagName,
    t.QuestionCount,
    t.AnswerCount,
    t.TotalScore,
    t.AvgViews,
    t.SampleTitles
FROM AggregatedUserStats au
LEFT JOIN LATERAL (
    SELECT
        ta.TagName,
        ta.QuestionCount,
        ta.AnswerCount,
        ta.TotalScore,
        ta.AvgViews,
        ta.SampleTitles
    FROM TagActivity ta
    ORDER BY ta.TotalScore DESC
    LIMIT 5
) t ON TRUE

UNION ALL

SELECT
    NULL         AS UserId,
    NULL         AS DisplayName,
    NULL         AS Reputation,
    NULL         AS BadgeCount,
    NULL         AS Gold,
    NULL         AS Silver,
    NULL         AS Bronze,
    NULL         AS LastBadgeDate,
    NULL         AS TotalPosts,
    NULL         AS TotalAnswersGiven,
    NULL         AS MaxPostScore,
    NULL         AS AvgPostScore,
    NULL         AS TotalBountyStarted,
    NULL         AS TotalBountyEarned,
    NULL         AS ReputationRank,
    NULL         AS LatestCumulativeScore,
    recent.TagName,
    recent.QuestionCount,
    recent.AnswerCount,
    recent.TotalScore,
    recent.AvgViews,
    recent.SampleTitles
FROM (
    SELECT
        TRIM(BOTH '<>' FROM tag) AS TagName,
        COUNT(*) FILTER (WHERE p.PostTypeId = 1)                AS QuestionCount,
        COUNT(*) FILTER (WHERE p.PostTypeId = 2)                AS AnswerCount,
        SUM(p.Score)                                            AS TotalScore,
        AVG(p.ViewCount)                                        AS AvgViews,
        STRING_AGG(DISTINCT p.Title, '; ') FILTER (WHERE p.Title IS NOT NULL) AS SampleTitles
    FROM Posts p,
    LATERAL (
        SELECT value AS tag
        FROM UNNEST(STRING_SPLIT(REGEXP_REPLACE(p.Tags, '^<|>$', ''), '><')) AS s(value)
    ) tags
    WHERE p.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY)
    GROUP BY TRIM(BOTH '<>' FROM tag)
    HAVING COUNT(*) > 10
) recent
ORDER BY
    ReputationRank NULLS LAST,
    TotalScore DESC NULLS LAST;