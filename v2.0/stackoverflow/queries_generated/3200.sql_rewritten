WITH RankedPosts AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        p.ClosedDate,
        p.CommunityOwnedDate,
        ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC) AS rn,
        COALESCE(p.Tags, '') AS TagsRaw
    FROM Posts p
    WHERE p.PostTypeId = 1
),
TagList AS (
    SELECT
        rp.Id        AS PostId,
        UNNEST(STRING_TO_ARRAY(SUBSTRING(rp.TagsRaw, 2, LENGTH(rp.TagsRaw) - 2), '><')) AS Tag
    FROM RankedPosts rp
    WHERE rp.rn <= 100
),
TagStats AS (
    SELECT
        tl.Tag,
        COUNT(*)                         AS TagUsage,
        SUM(p.Score)                     AS TotalScore,
        AVG(p.ViewCount)                 AS AvgViews
    FROM TagList tl
    JOIN Posts p ON p.Id = tl.PostId
    GROUP BY tl.Tag
),
UserBadgeAgg AS (
    SELECT
        u.Id                                   AS UserId,
        u.DisplayName,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        MAX(b.Date)                            AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id, u.DisplayName
),
TopUsers AS (
    SELECT
        uba.*,
        RANK() OVER (ORDER BY (uba.GoldBadges*3 + uba.SilverBadges*2 + uba.BronzeBadges) DESC) AS ReputationRank
    FROM UserBadgeAgg uba
    WHERE (uba.GoldBadges + uba.SilverBadges + uba.BronzeBadges) > 0
),
PostVoteSummary AS (
    SELECT
        v.PostId,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
        MAX(CASE WHEN v.VoteTypeId = 5 THEN v.UserId END)   AS FavoritedByUserId
    FROM Votes v
    GROUP BY v.PostId
)
SELECT
    rp.Id                                   AS PostId,
    rp.Title,
    rp.Score,
    rp.CreationDate,
    COALESCE(pvs.UpVotes, 0)                AS UpVotes,
    COALESCE(pvs.DownVotes, 0)              AS DownVotes,
    tl.Tag,
    ts.TagUsage,
    ts.TotalScore,
    ts.AvgViews,
    u.DisplayName                           AS OwnerDisplayName,
    u.GoldBadges,
    u.SilverBadges,
    u.BronzeBadges,
    u.ReputationRank,
    CASE WHEN pvs.FavoritedByUserId IS NOT NULL THEN 'YES' ELSE 'NO' END AS IsFavorited,
    CASE
        WHEN rp.ClosedDate IS NOT NULL          THEN 'CLOSED'
        WHEN rp.CommunityOwnedDate IS NOT NULL  THEN 'COMMUNITY'
        ELSE 'OPEN'
    END                                      AS PostStatus,
    COALESCE(rp.Tags, '')                    AS FullTags,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = rp.Id AND c.Score > 0) AS PositiveCommentCount,
    (SELECT MAX(c.CreationDate) FROM Comments c WHERE c.PostId = rp.Id)    AS LastCommentDate
FROM RankedPosts rp
LEFT JOIN PostVoteSummary pvs ON pvs.PostId = rp.Id
LEFT JOIN TagList tl          ON tl.PostId = rp.Id
LEFT JOIN TagStats ts         ON ts.Tag = tl.Tag
LEFT JOIN Users u             ON u.Id = rp.OwnerUserId
WHERE rp.rn <= 10
ORDER BY rp.Score DESC, ts.TotalScore DESC

UNION ALL

SELECT
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
WHERE NOT EXISTS (SELECT 1 FROM RankedPosts rp WHERE rp.rn <= 10);