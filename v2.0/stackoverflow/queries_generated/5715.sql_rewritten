-- {"query": "5715.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 863} 
WITH popular_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.LastActivityDate,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    U.DisplayName AS OwnerDisplayName,
    U.Reputation AS OwnerReputation
  FROM Posts p
  LEFT JOIN Users U ON p.OwnerUserId = U.Id
  WHERE p.PostTypeId = 1 -- Questions
    AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '360 days'
),
tag_summary AS (
  SELECT
    t.TagName,
    COUNT(*) AS question_count,
    AVG(p.Score) AS avg_score,
    SUM(p.ViewCount) AS total_views
  FROM Tags t
  JOIN Posts p ON p.Id = t.Id AND p.PostTypeId = 1
  GROUP BY t.TagName
),
complex_metrics AS (
  SELECT
    q.PostId,
    q.Title,
    q.OwnerDisplayName,
    q.OwnerReputation,
    q.ViewCount,
    q.Score,
    q.AnswerCount,
    q.CommentCount,
    q.FavoriteCount,
    q.CreationDate,
    q.LastActivityDate,
    q.Tags,
    -- window function: cumulative average score by day for recent questions
    AVG(q.Score) OVER (PARTITION BY DATE(q.CreationDate) ORDER BY q.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cum_avg_score_by_day,
    -- ranking within day by score
    ROW_NUMBER() OVER (PARTITION BY DATE(q.CreationDate) ORDER BY q.Score DESC, q.LastActivityDate DESC) AS rank_by_day
  FROM popular_questions q
),
joined_links AS (
  SELECT
    cm.PostId,
    cm.Title,
    cm.OwnerDisplayName,
    cm.OwnerReputation,
    cm.ViewCount,
    cm.Score,
    cm.AnswerCount,
    cm.CommentCount,
    cm.FavoriteCount,
    cm.CreationDate,
    cm.LastActivityDate,
    cm.Tags,
    -- left join to related posts via PostLinks (e.g., duplicates)
    pl.RelatedPostId,
    pl.LinkTypeId,
    p2.Title AS RelatedTitle,
    p2.OwnerUserId AS RelatedOwnerId
  FROM complex_metrics cm
  LEFT JOIN PostLinks pl ON pl.PostId = cm.PostId
  LEFT JOIN Posts p2 ON pl.RelatedPostId = p2.Id
),
advanced_filter AS (
  SELECT
    j.PostId,
    j.Title,
    j.OwnerDisplayName,
    j.OwnerReputation,
    j.ViewCount,
    j.Score,
    j.AnswerCount,
    j.CommentCount,
    j.FavoriteCount,
    j.CreationDate,
    j.LastActivityDate,
    j.Tags,
    j.RelatedPostId,
    j.RelatedTitle,
    j.RelatedOwnerId,
    -- compute NULL-safe checks and string expressions
    CASE
      WHEN j.Tags ~ '\\y<' || '|' || '\\y' THEN true
      ELSE false
    END AS has_tags_matching,
    COALESCE(LOWER(j.RelatedTitle), ''),
    CASE
      WHEN j.RelatedOwnerId IS NULL THEN 'no_related'
      ELSE 'has_related'
    END AS related_presence
  FROM joined_links j
)
SELECT
  af.PostId,
  af.Title,
  af.OwnerDisplayName,
  af.OwnerReputation,
  af.ViewCount,
  af.Score,
  af.AnswerCount,
  af.CommentCount,
  af.FavoriteCount,
  af.CreationDate,
  af.LastActivityDate,
  af.Tags,
  af.RelatedPostId,
  af.RelatedTitle,
  af.RelatedOwnerId,
  af.has_tags_matching,
  af.related_presence,
  af.cum_avg_score_by_day,
  af.rank_by_day
FROM advanced_filter af
ORDER BY af.LastActivityDate DESC, af.Score DESC
LIMIT 200;