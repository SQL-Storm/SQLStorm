SELECT
  u.Id AS UserId,
  u.DisplayName,
  u.Reputation,
  COUNT(DISTINCT p.Id) AS PostCount,
  AVG(COALESCE(p.Score, 0)) AS AvgPostScore,
  SUM(COALESCE(v.BountyAmount, 0)) AS TotalBounty,
  MAX(p.CreationDate) AS LastPostDate,
  STRING_AGG(DISTINCT COALESCE(tg_all.TagName, tag_split.TagName), ',') AS TopCategories,
  COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionCount,
  COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswerCount
FROM
  Users u
LEFT JOIN Posts p ON p.OwnerUserId = u.Id
LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId = 2
LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
LEFT JOIN LATERAL (
  SELECT
    p2.OwnerUserId AS UserForTag,
    tg.TagName
  FROM
    Posts p2
    JOIN Tags tg ON tg.ExcerptPostId = p2.Id
  WHERE p2.OwnerUserId = u.Id
  GROUP BY p2.OwnerUserId, tg.TagName
) AS tg_all ON true
LEFT JOIN LATERAL (
  SELECT
    p2.OwnerUserId AS UserForTag2,
    regexp_split_to_table(TRIM(BOTH '<>' FROM p2.Tags), '><') AS TagName
  FROM Posts p2
  WHERE p2.Tags IS NOT NULL
    AND p2.OwnerUserId = u.Id
) AS tag_split ON true
LEFT JOIN PostHistory ph ON ph.PostId = p.Id
LEFT JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
GROUP BY
  u.Id, u.DisplayName, u.Reputation
HAVING
  COUNT(DISTINCT p.Id) > 5
ORDER BY
  u.Reputation DESC, LastPostDate DESC
LIMIT 100;