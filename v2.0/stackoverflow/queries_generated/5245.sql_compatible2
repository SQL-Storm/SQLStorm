WITH
UserSignals AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    COALESCE(p.RecentPostActivity, 0) * 4 +
    COALESCE(c.RecentCommentActivity, 0) * 2 +
    COALESCE(v.RecentVoteActivity, 0) AS ActivityScore,
    EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - u.LastAccessDate)) AS SecondsSinceLastAccess
  FROM Users u
  LEFT JOIN (
    SELECT OwnerUserId AS UserId, COUNT(*) AS RecentPostActivity
    FROM Posts
    WHERE CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '7' DAY)
    GROUP BY OwnerUserId
  ) p ON p.UserId = u.Id
  LEFT JOIN (
    SELECT UserId, COUNT(*) AS RecentCommentActivity
    FROM Comments
    WHERE CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '7' DAY)
    GROUP BY UserId
  ) c ON c.UserId = u.Id
  LEFT JOIN (
    SELECT UserId, COUNT(*) AS RecentVoteActivity
    FROM Votes
    WHERE CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '7' DAY)
    GROUP BY UserId
  ) v ON v.UserId = u.Id
),
PostSignals AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.PostTypeId,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.LastActivityDate,
    p.AcceptedAnswerId,
    (SELECT COUNT(*) FROM PostLinks pl
     WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3) AS DuplicateLinks,
    ROW_NUMBER() OVER (PARTITION BY CAST(p.CreationDate AS DATE)
                       ORDER BY p.Score DESC, p.ViewCount DESC) AS DailyRank
  FROM Posts p
),
TagStats AS (
  SELECT
    t.TagName,
    t.Count,
    t.ExcerptPostId,
    t.WikiPostId,
    COALESCE(t.Count, 0) * 1.5 +
    COALESCE((SELECT AVG(p2.Score) FROM Posts p2 WHERE p2.Tags LIKE '%' || '<' || t.TagName || '>' || '%'), 0) AS PopularityScore,
    CASE WHEN t.IsModeratorOnly = TRUE THEN 1 ELSE 0 END AS IsModeratorOnlyFlag
  FROM Tags t
),
TopPosts AS (
  SELECT Id
  FROM Posts
  WHERE PostTypeId IN (1, 2)
  ORDER BY Score DESC
  OFFSET 0 ROWS FETCH NEXT 100 ROWS ONLY
),
TopPosts_Other AS (
  SELECT Id
  FROM Posts
  WHERE PostTypeId = 5
  ORDER BY CreationDate DESC
  OFFSET 0 ROWS FETCH NEXT 50 ROWS ONLY
)
SELECT
  us.UserId,
  us.DisplayName AS UserDisplayName,
  us.Reputation,
  us.UserCreationDate,
  us.LastAccessDate,
  us.ActivityScore,
  ps.PostId,
  ps.PostTypeId,
  ps.Title,
  ps.Tags,
  ps.Score,
  ps.ViewCount,
  ps.CommentCount,
  ps.DailyRank,
  ds.DuplicateLinks,
  ts.TagName,
  ts.PopularityScore,
  t.IsModeratorOnly AS TagIsModeratorOnly,
  CASE WHEN ps.AcceptedAnswerId IS NULL THEN NULL ELSE ps.AcceptedAnswerId END AS AcceptedAnswer,
  CASE
    WHEN ps.PostTypeId = 1 AND ps.Title IS NOT NULL THEN
      (UPPER(SUBSTRING(ps.Title FROM 1 FOR 60)) || '...')
    ELSE NULL
  END AS TruncatedTitle
FROM UserSignals us
JOIN TopPosts tp ON 1=1
JOIN Posts ps ON ps.Id = tp.Id
LEFT JOIN PostLinks ds ON ds.PostId = ps.Id
LEFT JOIN TagStats ts ON ts.TagName LIKE '%' || ps.Tags || '%'
LEFT JOIN Tags t ON t.IsModeratorOnly = FALSE
WHERE
  (ps.ViewCount > 0 OR ps.Score IS NOT NULL)
  AND (ps.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '2' YEAR) OR ps.CreationDate IS NULL)
  AND (us.UserId IS NOT NULL)
UNION ALL
SELECT
  us.UserId,
  us.DisplayName,
  us.Reputation,
  us.UserCreationDate,
  us.LastAccessDate,
  us.ActivityScore,
  p.Id,
  p.PostTypeId,
  p.Title,
  p.Tags,
  p.Score,
  p.ViewCount,
  p.CommentCount,
  NULL AS DailyRank,
  NULL AS DuplicateLinks,
  NULL AS TagName,
  NULL AS PopularityScore,
  NULL::boolean AS TagIsModeratorOnly,
  NULL AS AcceptedAnswer,
  NULL AS TruncatedTitle
FROM UserSignals us
JOIN TopPosts_Other tp ON 1=1
JOIN Posts p ON p.Id = tp.Id
LEFT JOIN PostLinks l ON l.PostId = p.Id
ORDER BY UserId, PostId
LIMIT 200;