-- {"query": "6586.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 503} 
SELECT 
    u.DisplayName, 
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(p.Score) AS HighestScoredPost,
    MIN(p.CreationDate) AS FirstPostDate,
    MAX(p.LastActivityDate) AS LastActivityDate,
    b.Name AS LatestBadge,
    v.Name AS MostVotedType,
    t.TagName AS MostUsedTag
FROM 
    Users u
LEFT JOIN 
    Badges b ON b.UserId = u.Id AND b.Date = (SELECT MAX(Date) FROM Badges WHERE UserId = u.Id)
LEFT JOIN 
    (SELECT 
        UserId, 
        MAX(CASE WHEN VoteTypeId = 1 THEN Name END) AS Name,
        MAX(CASE WHEN VoteTypeId = 1 THEN CreationDate END) AS VotedDate
     FROM 
        Votes
     GROUP BY 
        UserId) v ON v.UserId = u.Id
LEFT JOIN 
    (SELECT 
        PostId, 
        STRING_AGG(Tags::text, ', ') AS Tags
     FROM 
        Posts
     WHERE 
        PostTypeId = 1
     GROUP BY 
        PostId) ptags ON ptags.PostId = u.Id
LEFT JOIN 
    Posts p ON p.OwnerUserId = u.Id
LEFT JOIN 
    (SELECT 
        TagName, 
        COUNT(*) AS Count
     FROM 
        Tags
     GROUP BY 
        TagName
     ORDER BY 
        Count DESC 
     LIMIT 1) t ON t.TagName IN (SELECT unnest(string_to_array(ptags.Tags, ', ')))
WHERE 
    u.Reputation > 1000
    AND p.CreationDate >= DATE_TRUNC('month', cast('2024-10-01' as date)) - INTERVAL '1 year'
GROUP BY 
    u.Id, u.DisplayName, u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 10
ORDER BY 
    u.Reputation DESC;