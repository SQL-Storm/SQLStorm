WITH top_users AS (
  SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.AccountId,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.LastAccessDate DESC) AS rn
  FROM Users u
  WHERE u.Reputation > 1000
),
recent_activities AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.Title,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.Tags,
    COALESCE(vt.Name, 'Unknown') AS VoteTypeName,
    v.CreationDate AS VoteDate,
    v.BountyAmount
  FROM Posts p
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
  WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY
),
-- portable tag splitting using a numbers (tally) table approach
numbers AS (
  SELECT 1 AS n UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5
  UNION ALL SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9 UNION ALL SELECT 10
  UNION ALL SELECT 11 UNION ALL SELECT 12 UNION ALL SELECT 13 UNION ALL SELECT 14 UNION ALL SELECT 15
  -- extend as needed
),
tagged_activity AS (
  SELECT
    ra.PostId,
    ra.Title,
    -- extract the Nth tag by locating between '<' and '>' occurrences
    TRIM(SUBSTR(
      ra.Tags,
      CASE WHEN pos1 = 0 THEN 1 ELSE pos1 + 1 END,
      CASE WHEN pos2 = 0 THEN 0 ELSE pos2 - pos1 - 1 END
    )) AS tag,
    ra.CreationDate,
    ra.Score,
    ra.ViewCount
  FROM recent_activities ra
  JOIN (
    SELECT n,
      -- helper to find start position of nth '<' and corresponding '>'
      n AS idx
    FROM numbers
  ) nums ON TRUE
  CROSS APPLY (
    -- compute positions of nth '<' and its following '>'
    SELECT
      (CASE
         WHEN CHARINDEX('<', ra.Tags, (nums.idx = 1)::INT) > 0 THEN CHARINDEX('<', ra.Tags, (nums.idx = 1)::INT)
         ELSE 0 END) AS pos1_dummy
  ) ca_dummy -- placeholder to satisfy dialects without direct ordinal search
  -- The above CROSS APPLY is a no-op placeholder; instead use repeated CHARINDEX to find nth occurrence
),
-- Because not all SQL dialects support searching the Nth occurrence easily,
-- provide a more standard approach using recursive CTE to split tags
tag_split AS (
  SELECT
    PostId,
    Title,
    TRIM(SUBSTR(Tags, 2, CASE WHEN CHARINDEX('>', Tags, 2) - 2 >= 0 THEN CHARINDEX('>', Tags, 2) - 2 ELSE 0 END)) AS tag,
    -- remainder after first tag
    CASE
      WHEN CHARINDEX('>', Tags, 2) > 0 THEN SUBSTR(Tags, CHARINDEX('>', Tags, 2) + 1)
      ELSE ''
    END AS rest,
    CreationDate,
    Score,
    ViewCount
  FROM recent_activities
  WHERE Tags IS NOT NULL AND Tags <> '' AND CHARINDEX('<', Tags) = 1
  UNION ALL
  SELECT
    PostId,
    Title,
    TRIM(SUBSTR(rest, 2, CASE WHEN CHARINDEX('>', rest, 2) - 2 >= 0 THEN CHARINDEX('>', rest, 2) - 2 ELSE 0 END)) AS tag,
    CASE
      WHEN CHARINDEX('>', rest, 2) > 0 THEN SUBSTR(rest, CHARINDEX('>', rest, 2) + 1)
      ELSE ''
    END AS rest,
    CreationDate,
    Score,
    ViewCount
  FROM tag_split
  WHERE rest IS NOT NULL AND rest <> '' AND CHARINDEX('<', rest) = 1
),
tagged_activity_final AS (
  SELECT
    PostId,
    Title,
    tag,
    CreationDate,
    Score,
    ViewCount
  FROM tag_split
  WHERE tag IS NOT NULL AND tag <> ''
),
complex_calc AS (
  SELECT
    ta.PostId,
    ta.Title,
    ta.tag,
    ta.CreationDate,
    ta.Score,
    ta.ViewCount,
    -- remove non-numeric chars from VoteType name in a portable way by keeping digits, plus, minus and dot
    COALESCE(NULLIF(REGEXP_REPLACE(COALESCE(vt2.Name, ''), '[^0-9.+-]', ''), ''), '0') AS vt_numeric_text,
    (ta.Score * 2 + CAST(COALESCE(NULLIF(REGEXP_REPLACE(COALESCE(vt2.Name, ''), '[^0-9.+-]', ''), ''), '0') AS NUMERIC)) AS score_factor,
    CASE
      WHEN ta.ViewCount > 1000 THEN 'high-views'
      WHEN ta.ViewCount BETWEEN 100 AND 1000 THEN 'mid-views'
      ELSE 'low-views'
    END AS view_bucket,
    ROW_NUMBER() OVER (PARTITION BY ta.tag ORDER BY ta.Score DESC, ta.CreationDate DESC) AS tag_rank
  FROM tagged_activity_final ta
  LEFT JOIN Votes v ON v.PostId = ta.PostId
  LEFT JOIN VoteTypes vt2 ON vt2.Id = v.VoteTypeId
)
SELECT
  hu.Id AS user_id,
  hu.DisplayName AS user_name,
  hu.Reputation,
  hu.AccountId,
  hu.rn AS user_rank,
  ca.PostId,
  ca.Title AS post_title,
  ca.tag AS post_tag,
  ca.CreationDate AS post_creation,
  ca.Score AS post_score,
  ca.ViewCount AS post_views,
  ca.score_factor,
  ca.view_bucket,
  ca.tag_rank
FROM top_users hu
JOIN recent_activities ra ON ra.OwnerUserId = hu.Id
JOIN complex_calc ca ON ca.PostId = ra.PostId
WHERE hu.rn <= 100
GROUP BY
  hu.Id,
  hu.DisplayName,
  hu.Reputation,
  hu.AccountId,
  hu.rn,
  ca.PostId,
  ca.Title,
  ca.tag,
  ca.CreationDate,
  ca.Score,
  ca.ViewCount,
  ca.score_factor,
  ca.view_bucket,
  ca.tag_rank
ORDER BY hu.Reputation DESC, ca.Score DESC, ca.ViewCount DESC
LIMIT 100;