WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        AVG(p.Score) as AvgPostScore,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), ', ') as AllTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.AccountId IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
PostPerformance AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate AS DaysInterval,
        EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate)) / 86400 AS DaysSinceCreation,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END as PostType,
        CASE WHEN p.AcceptedAnswerId IS NULL THEN 0 ELSE 1 END as HasAcceptedAnswer,
        CASE 
            WHEN p.Tags IS NOT NULL AND CHAR_LENGTH(p.Tags) > 2 THEN 
                (SELECT COUNT(*) FROM UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), '><')) AS tag)
            ELSE 0
        END as TagCount,
        CASE 
            WHEN p.Score >= 100 THEN 'High'
            WHEN p.Score >= 10 THEN 'Medium'
            WHEN p.Score >= 0 THEN 'Low'
            ELSE 'Negative'
        END as ScoreCategory,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as PostRank,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PrevScore,
        ABS(p.Score - LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate)) as ScoreChange,
        p.OwnerUserId
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
BadgeAnalysis AS (
    SELECT 
        b.UserId,
        b.Name as BadgeName,
        b.Date as BadgeDate,
        b.Class,
        DENSE_RANK() OVER (PARTITION BY b.UserId ORDER BY b.Date) as BadgeRank,
        COUNT(*) OVER (PARTITION BY b.UserId) as TotalBadges,
        CASE 
            WHEN b.Class = 1 THEN 'Gold'
            WHEN b.Class = 2 THEN 'Silver'
            ELSE 'Bronze'
        END as BadgeTier
    FROM Badges b
),
ComplexActivity AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.TotalPosts,
        uas.Questions,
        uas.Answers,
        uas.Comments,
        uas.Badges,
        uas.LastPostDate,
        uas.AvgPostScore,
        uas.AllTags,
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount,
        pa.CommentCount,
        pa.CreationDate,
        pa.DaysSinceCreation,
        pa.PostType,
        pa.HasAcceptedAnswer,
        pa.TagCount,
        pa.ScoreCategory,
        pa.PostRank,
        pa.PrevScore,
        pa.ScoreChange,
        ba.BadgeName,
        ba.BadgeDate,
        ba.BadgeRank,
        ba.TotalBadges,
        ba.BadgeTier,
        CASE 
            WHEN uas.Reputation >= 10000 AND uas.Badges >= 50 THEN 'Elite'
            WHEN uas.Reputation >= 5000 AND uas.Badges >= 25 THEN 'Veteran'
            WHEN uas.Reputation >= 1000 AND uas.Badges >= 10 THEN 'Regular'
            ELSE 'Newbie'
        END as UserLevel,
        CASE 
            WHEN pa.Score > (SELECT AVG(CAST(Score AS numeric)) FROM Posts WHERE PostTypeId = 1) THEN 'AboveAvgQ'
            WHEN pa.Score < (SELECT AVG(CAST(Score AS numeric)) FROM Posts WHERE PostTypeId = 1) THEN 'BelowAvgQ'
            ELSE 'AvgQ'
        END as QuestionPerformance,
        CASE 
            WHEN pa.ScoreChange > 50 THEN 'HighVolatility'
            WHEN pa.ScoreChange BETWEEN 10 AND 50 THEN 'MediumVolatility'
            WHEN pa.ScoreChange < 10 THEN 'LowVolatility'
            ELSE 'NoChange'
        END as ScoreVolatility,
        COALESCE(pa.ScoreChange, 0) as CorrectedScoreChange
    FROM UserActivityStats uas
    LEFT JOIN PostPerformance pa ON uas.UserId = pa.OwnerUserId
    LEFT JOIN BadgeAnalysis ba ON uas.UserId = ba.UserId
),
FinalAnalysis AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        TotalPosts,
        Questions,
        Answers,
        Comments,
        Badges,
        LastPostDate,
        AvgPostScore,
        AllTags,
        PostId,
        Title,
        Score,
        ViewCount,
        AnswerCount,
        CommentCount,
        CreationDate,
        DaysSinceCreation,
        PostType,
        HasAcceptedAnswer,
        TagCount,
        ScoreCategory,
        PostRank,
        PrevScore,
        ScoreChange,
        BadgeName,
        BadgeDate,
        BadgeRank,
        TotalBadges,
        BadgeTier,
        UserLevel,
        QuestionPerformance,
        ScoreVolatility,
        CorrectedScoreChange,
        ROW_NUMBER() OVER (ORDER BY CorrectedScoreChange DESC, Reputation DESC) as RowNum,
        RANK() OVER (PARTITION BY PostType ORDER BY Score DESC) as TopScorePerType,
        DENSE_RANK() OVER (ORDER BY Reputation DESC, TotalPosts DESC) as ReputationRank,
        NTILE(4) OVER (ORDER BY Reputation) as ReputationQuartile,
        PERCENT_RANK() OVER (ORDER BY Reputation) as ReputationPercentile,
        CUME_DIST() OVER (ORDER BY Score) as ScoreCumulativeDistribution,
        LAG(Reputation, 1) OVER (ORDER BY Reputation DESC) as PrevReputation,
        LEAD(Reputation, 1) OVER (ORDER BY Reputation DESC) as NextReputation,
        AVG(Score) OVER (PARTITION BY PostType) as AvgScorePerType,
        MAX(AvgPostScore) OVER () as OverallAvgPostScore
    FROM ComplexActivity
)
SELECT 
    UserId,
    DisplayName,
    Reputation,
    TotalPosts,
    Questions,
    Answers,
    Comments,
    Badges,
    LastPostDate,
    AvgPostScore,
    AllTags,
    PostId,
    Title,
    Score,
    ViewCount,
    AnswerCount,
    CommentCount,
    CreationDate,
    DaysSinceCreation,
    PostType,
    HasAcceptedAnswer,
    TagCount,
    ScoreCategory,
    PostRank,
    PrevScore,
    ScoreChange,
    BadgeName,
    BadgeDate,
    BadgeRank,
    TotalBadges,
    BadgeTier,
    UserLevel,
    QuestionPerformance,
    ScoreVolatility,
    CorrectedScoreChange,
    RowNum,
    TopScorePerType,
    ReputationRank,
    ReputationQuartile,
    ReputationPercentile,
    ScoreCumulativeDistribution,
    PrevReputation,
    NextReputation,
    AvgScorePerType,
    OverallAvgPostScore,
    CASE 
        WHEN Reputation >= 10000 THEN 'High'
        WHEN Reputation >= 5000 THEN 'Medium'
        WHEN Reputation >= 1000 THEN 'Low'
        ELSE 'VeryLow'
    END as ReputationLevel,
    CASE 
        WHEN TagCount > 5 THEN 'TagHeavy'
        WHEN TagCount > 2 THEN 'TagModerate'
        WHEN TagCount > 0 THEN 'TagLight'
        ELSE 'NoTags'
    END as TagDensity,
    COALESCE(PrevReputation - Reputation, 0) as ReputationChangeFromPrevious,
    COALESCE(Reputation - NextReputation, 0) as ReputationChangeToNext,
    CASE 
        WHEN Score > (AvgScorePerType * 1.5) THEN 'Exceptional'
        WHEN Score > AvgScorePerType THEN 'AboveAverage'
        WHEN Score = AvgScorePerType THEN 'Average'
        WHEN Score < AvgScorePerType THEN 'BelowAverage'
        ELSE 'Poor'
    END as PerformanceTier,
    ROUND(
        (Reputation * 0.3 + 
         TotalPosts * 10 + 
         Badges * 50 + 
         ViewCount * 0.01 + 
         Score * 0.5 + 
         AnswerCount * 20) / 
        NULLIF(Reputation + TotalPosts + Badges + ViewCount + Score + AnswerCount, 0), 
        2
    ) as CompositeScore,
    CASE 
        WHEN UserLevel = 'Elite' AND Score > 100 AND PostType = 'Question' THEN 'TopContributor'
        WHEN UserLevel IN ('Veteran', 'Regular') AND AllTags IS NOT NULL AND TagCount > 2 THEN 'ActiveMember'
        WHEN TotalPosts > 100 AND Reputation > 500 THEN 'ConsistentPoster'
        ELSE 'Regular'
    END as UserClassification,
    CAST('2024-10-01 12:34:56' AS timestamp) as AnalysisTimestamp,
    (SELECT COUNT(*) FROM FinalAnalysis) as TotalRecordsProcessed,
    EXTRACT(EPOCH FROM (LastPostDate - CreationDate)) / 86400 AS DaysActive,
    ROUND((COALESCE(ViewCount, 0) * 100.0 / NULLIF(Score, 0)), 2) as ViewsPerScore,
    ROUND(Score * 100.0 / NULLIF(OverallAvgPostScore, 0), 2) as ScoreAsPercentageOfAvg,
    CASE 
        WHEN DaysSinceCreation > 30 AND Score > 10 THEN 'LongActive'
        WHEN DaysSinceCreation > 30 THEN 'LongInactive'
        WHEN DaysSinceCreation <= 30 AND Score > 10 THEN 'RecentlyActive'
        ELSE 'RecentlyInactive'
    END as ActivityStatus,
    STRING_AGG(
        CASE 
            WHEN BadgeTier = 'Gold' THEN BadgeName || ':' || CAST(BadgeRank AS text)
            ELSE NULL
        END, 
        '; '
    ) as TopGoldBadges,
    STRING_AGG(
        CASE 
            WHEN PostType = 'Question' THEN Title || ' (' || CAST(Score AS text) || ')'
            ELSE NULL
        END, 
        ' | '
    ) as TopQuestions,
    NULLIF(Reputation - COALESCE(PrevReputation, 0), 0) as ReputationGrowth,
    CASE 
        WHEN Badges > 0 AND COALESCE(PrevReputation, 0) > 0 THEN (Reputation - PrevReputation) / NULLIF(PrevReputation, 0)
        ELSE NULL
    END as ReputationGrowthRate,
    'Rank-' || CAST(ReputationRank AS text) || '-Level-' || UserLevel as UserProfileTag,
    ROUND(AVG(Score) OVER (PARTITION BY PostType), 2) as AvgScorePerTypeNormalized,
    ROUND(COUNT(*) OVER (), 0) as TotalResults,
    (SELECT COUNT(DISTINCT UserId) FROM FinalAnalysis) as DistinctUsers,
    ROUND(SUM(Score) OVER (ORDER BY CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 2) as CumulativeScore
FROM FinalAnalysis
WHERE 
    Reputation > 0 
    AND TotalPosts > 0 
    AND (PostType = 'Question' OR PostType = 'Answer')
    AND DaysSinceCreation IS NOT NULL
    AND Score IS NOT NULL
    AND CreationDate IS NOT NULL
GROUP BY 
    UserId, DisplayName, Reputation, TotalPosts, Questions, Answers, Comments, Badges, 
    LastPostDate, AvgPostScore, AllTags, PostId, Title, Score, ViewCount, AnswerCount, 
    CommentCount, CreationDate, DaysSinceCreation, PostType, HasAcceptedAnswer, TagCount, 
    ScoreCategory, PostRank, PrevScore, ScoreChange, BadgeName, BadgeDate, BadgeRank, 
    TotalBadges, BadgeTier, UserLevel, QuestionPerformance, ScoreVolatility, 
    CorrectedScoreChange, RowNum, TopScorePerType, ReputationRank, ReputationQuartile, 
    ReputationPercentile, ScoreCumulativeDistribution, PrevReputation, NextReputation, 
    AvgScorePerType, OverallAvgPostScore, ReputationLevel, TagDensity, 
    ReputationChangeFromPrevious, ReputationChangeToNext, PerformanceTier, CompositeScore, 
    UserClassification, AnalysisTimestamp, DaysActive, ViewsPerScore, ScoreAsPercentageOfAvg, 
    ActivityStatus, ReputationGrowth, ReputationGrowthRate, UserProfileTag, 
    AvgScorePerTypeNormalized, TotalResults, DistinctUsers, CumulativeScore
HAVING 
    COUNT(*) > 0
    AND COUNT(CreationDate) > 1
ORDER BY 
    Reputation DESC,
    TotalPosts DESC,
    AVG(Score) DESC
LIMIT 1000 OFFSET 100;