WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.LastActivityDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) as rn,
        AVG(COALESCE(p.Score, 0)) OVER (PARTITION BY p.OwnerUserId) as avg_score,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) as total_posts,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_score,
        LEAD(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as next_score,
        CASE WHEN p.Tags IS NULL OR p.Tags = '' THEN 0 ELSE 1 END as has_tags,
        CASE WHEN COALESCE(p.AnswerCount,0) > 0 THEN 1 ELSE 0 END as has_answers,
        CASE WHEN COALESCE(p.CommentCount,0) > 0 THEN 1 ELSE 0 END as has_comments,
        CASE WHEN COALESCE(p.FavoriteCount,0) > 0 THEN 1 ELSE 0 END as is_favorite,
        COALESCE(p.Score, 0) + COALESCE(p.ViewCount, 0) + COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) as combined_metrics,
        CAST((CAST('2024-10-01 12:34:56' AS timestamp) - p.CreationDate) AS integer) as days_since_creation,
        CAST((p.LastActivityDate - p.CreationDate) AS integer) as days_since_activity
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT rp.Id) as user_post_count,
        SUM(COALESCE(rp.Score, 0)) as total_score,
        AVG(COALESCE(rp.Score, 0)) as avg_score,
        MAX(COALESCE(rp.Score, 0)) as max_score,
        SUM(COALESCE(rp.ViewCount, 0)) as total_views,
        SUM(COALESCE(rp.AnswerCount, 0)) as total_answers,
        SUM(COALESCE(rp.CommentCount, 0)) as total_comments,
        SUM(COALESCE(rp.FavoriteCount, 0)) as total_favorites,
        (u.CreationDate + INTERVAL '30 day') as thirty_days_from_join,
        CASE WHEN u.Reputation > 10000 THEN 'High' 
             WHEN u.Reputation > 5000 THEN 'Medium' 
             ELSE 'Low' END as rep_level
    FROM Users u
    LEFT JOIN RankedPosts rp ON u.Id = rp.OwnerUserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.CreationDate
),
TagAnalysis AS (
    SELECT 
        t.Id,
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE WHEN t.Count > 1000 THEN 'Popular' 
             WHEN t.Count > 100 THEN 'Moderate' 
             ELSE 'Rare' END as tag_category,
        t.IsModeratorOnly,
        t.IsRequired,
        COALESCE(t.Count, 0) * 1.5 as adjusted_count,
        LAG(t.Count, 1) OVER (ORDER BY t.Count DESC) as prev_count,
        LEAD(t.Count, 1) OVER (ORDER BY t.Count DESC) as next_count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as rank_by_count
    FROM Tags t
),
QuestionAnalysis AS (
    SELECT 
        q.Id as QuestionId,
        q.Title,
        q.Tags,
        q.Score,
        q.ViewCount,
        q.AnswerCount,
        q.CommentCount,
        q.FavoriteCount,
        q.CreationDate,
        q.LastActivityDate,
        COALESCE(q.Score, 0) + COALESCE(q.ViewCount, 0) as question_complexity,
        CASE WHEN q.Tags IS NOT NULL AND q.Tags <> '' THEN 
            (CHAR_LENGTH(q.Tags) - CHAR_LENGTH(REPLACE(q.Tags, '>', ''))) END as tag_count,
        CASE WHEN q.Score > 10 THEN 'Highly Upvoted' 
             WHEN q.Score > 5 THEN 'Moderately Upvoted' 
             ELSE 'Low Upvoted' END as upvote_category,
        COALESCE(q.AnswerCount, 0) as answer_count,
        COALESCE(q.CommentCount, 0) as comment_count,
        COALESCE(q.FavoriteCount, 0) as favorite_count
    FROM Posts q
    WHERE q.PostTypeId = 1
)
SELECT 
    'Performance Benchmark Query Results' as QueryType,
    COUNT(*) as TotalRecords,
    COUNT(DISTINCT us.UserId) as DistinctUsers,
    COUNT(DISTINCT ta.Id) as DistinctTags,
    COUNT(DISTINCT qa.QuestionId) as DistinctQuestions,
    SUM(COALESCE(us.total_score, 0)) as TotalUserScores,
    AVG(COALESCE(us.avg_score, 0)) as AverageUserScore,
    MAX(COALESCE(us.max_score, 0)) as MaxUserScore,
    SUM(COALESCE(ta.adjusted_count, 0)) as TotalAdjustedTagCounts,
    AVG(COALESCE(ta.adjusted_count, 0)) as AverageTagCount,
    SUM(COALESCE(qa.question_complexity, 0)) as TotalQuestionComplexity,
    AVG(COALESCE(qa.question_complexity, 0)) as AverageQuestionComplexity,
    STRING_AGG(CAST(us.UserId AS VARCHAR(20)), ', ') as UserIds,
    STRING_AGG(CAST(ta.TagName AS VARCHAR(50)), ', ') as TagNames,
    STRING_AGG(CAST(qa.Title AS VARCHAR(100)), ', ') as QuestionTitles,
    (
        SELECT STRING_AGG(CAST(rp.Id AS VARCHAR(10)), ', ')
        FROM RankedPosts rp
        WHERE rp.OwnerUserId = us.UserId
        AND rp.rn <= 3
    ) as TopRankedPosts,
    CASE 
        WHEN SUM(COALESCE(us.total_score, 0)) > 100000 THEN 'High'
        WHEN SUM(COALESCE(us.total_score, 0)) > 50000 THEN 'Medium'
        ELSE 'Low' 
    END as ScoreLevel,
    CASE 
        WHEN COUNT(DISTINCT ta.Id) > 500 THEN 'Large'
        WHEN COUNT(DISTINCT ta.Id) > 100 THEN 'Medium'
        ELSE 'Small' 
    END as TagSize,
    CASE 
        WHEN COUNT(DISTINCT qa.QuestionId) > 10000 THEN 'Very High'
        WHEN COUNT(DISTINCT qa.QuestionId) > 5000 THEN 'High'
        WHEN COUNT(DISTINCT qa.QuestionId) > 1000 THEN 'Medium'
        ELSE 'Low' 
    END as QuestionVolume,
    CASE 
        WHEN AVG(COALESCE(us.avg_score, 0)) > 50 THEN 'Expert'
        WHEN AVG(COALESCE(us.avg_score, 0)) > 25 THEN 'Intermediate'
        WHEN AVG(COALESCE(us.avg_score, 0)) > 10 THEN 'Beginner'
        ELSE 'Novice' 
    END as UserSkillLevel,
    COUNT(DISTINCT us.UserId) * COUNT(DISTINCT ta.Id) * COUNT(DISTINCT qa.QuestionId) as InteractionMetric,
    CASE 
        WHEN SUM(COALESCE(us.total_score, 0)) > 0 
        THEN (SUM(COALESCE(qa.question_complexity, 0)) * 100.0) / SUM(COALESCE(us.total_score, 0)) 
        ELSE 0 
    END as ScoreEfficiencyRatio,
    CASE 
        WHEN AVG(COALESCE(qa.question_complexity, 0)) > 100 
        THEN 'Complex' 
        WHEN AVG(COALESCE(qa.question_complexity, 0)) > 50 
        THEN 'Moderate' 
        ELSE 'Simple' 
    END as AvgQuestionComplexityLevel,
    CASE 
        WHEN AVG(COALESCE(ta.adjusted_count, 0)) > 500 
        THEN 'High Tag Popularity' 
        WHEN AVG(COALESCE(ta.adjusted_count, 0)) > 100 
        THEN 'Moderate Tag Popularity' 
        ELSE 'Low Tag Popularity' 
    END as TagPopularityLevel,
    ROW_NUMBER() OVER (ORDER BY SUM(COALESCE(us.total_score, 0)) DESC) as OverallRank,
    COUNT(*) OVER() as TotalQueryResultLines
FROM UserStats us
FULL OUTER JOIN TagAnalysis ta ON 1=1
LEFT JOIN QuestionAnalysis qa ON 1=1
LEFT JOIN RankedPosts rp ON us.UserId = rp.OwnerUserId
WHERE (us.UserId IS NOT NULL OR ta.Id IS NOT NULL OR qa.QuestionId IS NOT NULL)
    AND (us.rep_level IN ('High', 'Medium') OR ta.tag_category IN ('Popular', 'Moderate'))
    AND (qa.question_complexity > 50 OR qa.question_complexity IS NULL)
    AND (us.thirty_days_from_join < CAST('2024-10-01 12:34:56' AS timestamp))
    AND COALESCE(qa.question_complexity, 0) <= 500
    AND (ta.rank_by_count BETWEEN 1 AND 100 OR ta.rank_by_count IS NULL)
    AND EXISTS (
        SELECT 1 
        FROM Posts p 
        WHERE p.OwnerUserId = us.UserId 
        AND p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '365 day')
        AND p.PostTypeId IN (1, 2)
    )
    AND (
        EXISTS (
            SELECT 1 
            FROM Posts p 
            WHERE p.OwnerUserId = us.UserId 
            AND p.Tags LIKE '%<%' 
            AND p.Tags LIKE '%>%' 
        )
        OR ta.tag_category IN ('Popular', 'Moderate')
    )
    AND (
        (qa.QuestionId IS NOT NULL AND qa.Score IS NOT NULL AND qa.Score > 0) 
        OR (qa.QuestionId IS NULL AND ta.Id IS NOT NULL)
    )
    AND COALESCE(rp.Score, 0) BETWEEN 0 AND 1000
    AND (us.total_score IS NULL OR us.total_score > 10)
GROUP BY 
    us.UserId,
    us.DisplayName,
    us.Reputation,
    us.Views,
    us.UpVotes,
    us.DownVotes,
    us.thirty_days_from_join,
    us.rep_level,
    ta.Id,
    ta.TagName,
    ta.Count,
    ta.ExcerptPostId,
    ta.WikiPostId,
    ta.tag_category,
    ta.IsModeratorOnly,
    ta.IsRequired,
    ta.adjusted_count,
    ta.prev_count,
    ta.next_count,
    ta.rank_by_count,
    qa.QuestionId,
    qa.Title,
    qa.Tags,
    qa.Score,
    qa.ViewCount,
    qa.AnswerCount,
    qa.CommentCount,
    qa.FavoriteCount,
    qa.CreationDate,
    qa.LastActivityDate,
    qa.question_complexity,
    qa.tag_count,
    qa.upvote_category,
    qa.answer_count,
    qa.comment_count,
    qa.favorite_count
HAVING 
    COUNT(*) > 0
    AND (
        COUNT(DISTINCT us.UserId) > 0 
        OR COUNT(DISTINCT ta.Id) > 0 
        OR COUNT(DISTINCT qa.QuestionId) > 0
    )
ORDER BY 
    SUM(COALESCE(us.total_score, 0)) DESC,
    SUM(COALESCE(ta.adjusted_count, 0)) DESC,
    SUM(COALESCE(qa.question_complexity, 0)) DESC
OFFSET 0 ROWS
FETCH NEXT 1000 ROWS ONLY;