    ca.ContentLicense,
    ca.LastEditorDisplayName,
    ca.LastActivityDate,
    ca.PostIDNullCheck,
    ca.SafeTitle,
    ca.SafeScore,
    ca.TitleLength,
    ca.AnswerStatus,
    ca.ScoreTiers,
    ca.IsAboveUserAverageAndHigh,
    ca.IsHighlyEngaged,
    ca.IsActiveAndPopular,
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.Views,
    ca.UpVotes,
    ca.DownVotes,
    ca.TotalPosts,
    ca.Questions,
    ca.Answers,
    ca.Comments,
    ca.Badges,
    ca.LastPostDate,
    ca.LastCommentDate,
    ca.AllTags,
    ca.AnswerPercentage,
    ca.ReputationLevel,
    ca.RecentActiveUser,
    ca.ActivityRank,
    DENSE_RANK() OVER (ORDER BY ca.Score DESC) as DenseScoreRank,
    RANK() OVER (PARTITION BY ca.PostTypeId ORDER BY ca.Score DESC) as PostTypeScoreRank,
    COUNT(*) OVER () as TotalRecords,
    AVG(ca.Score) OVER () as AvgScore,
    SUM(ca.ViewCount) OVER () as TotalViews,
    MAX(ca.DaysActive) OVER () as MaxDaysActive,
    MIN(ca.FavoriteCount) OVER () as MinFavorites,
    STRING_AGG(ca.ScoreTiers, '; ') OVER (ORDER BY ca.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as ScoreTiersAggregate,
    CASE 
        WHEN ca.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId IN (1, 2)) THEN 'AboveAverage'
        WHEN ca.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId IN (1, 2)) THEN 'BelowAverage'
        ELSE 'Average'
    END as ScoreComparison,
    CASE 
        WHEN ca.AnswerCount > (SELECT AVG(AnswerCount) FROM Posts WHERE PostTypeId = 1) THEN 'AboveAvgAnswers'
        ELSE 'BelowAvgAnswers'
    END as AnswerComparison
FROM CombinedAnalysis ca
WHERE ca.PostId IS NOT NULL
    AND (ca.Score > 5 OR ca.ViewCount > 100)
    AND (ca.UserId IS NOT NULL OR ca.OwnerUserId IS NOT NULL)
HAVING COUNT(*) OVER () > 0
ORDER BY ca.Score DESC, ca.ViewCount DESC
LIMIT 1000000;