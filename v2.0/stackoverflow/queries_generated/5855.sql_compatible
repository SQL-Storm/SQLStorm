WITH
RecentActivity AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.OwnerUserId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.CommentCount,
    p.AnswerCount,
    p.FavoriteCount,
    p.Body,
    p.ContentLicense,
    u.Reputation,
    u.DisplayName AS OwnerDisplayName,
    u.Created AS UserCreated
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.LastActivityDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days'
),
TagExploded AS (
  SELECT
    ra.PostId,
    ra.Title,
    tag.TagName,
    ra.Reputation,
    ra.LastActivityDate,
    ra.Score,
    ra.ViewCount,
    ra.CommentCount
  FROM RecentActivity ra,
  LATERAL (
    SELECT unnest(string_to_array(substr(COALESCE(ra.Tags, '[]'), 2, length(COALESCE(ra.Tags, '[]')) - 2), '><')) AS TagName
  ) AS tag
),
TopTags AS (
  SELECT
    TagName,
    COUNT(*) AS PostCount,
    AVG(Score) AS AvgScore,
    SUM(ViewCount) AS TotalViews
  FROM TagExploded
  GROUP BY TagName
  ORDER BY PostCount DESC, AvgScore DESC
  LIMIT 10
),
ComplexJoins AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CommentCount,
    p.AnswerCount,
    p.FavoriteCount,
    v.VoteTypeId,
    vt.Name AS VoteTypeName,
    c.Id AS CommentId,
    c.Text AS CommentText,
    c.Score AS CommentScore,
    u.Id AS UserId,
    u.DisplayName AS UserDisplayName,
    u.Reputation AS UserReputation,
    b.Id AS BadgeId,
    b.Name AS BadgeName,
    b.Class AS BadgeClass,
    b.Date AS BadgeDate,
    p.Tags AS PostTags
  FROM Posts p
  LEFT JOIN Votes v ON v.PostId = p.Id
  LEFT JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
  LEFT JOIN Comments c ON c.PostId = p.Id
  LEFT JOIN Users u ON c.UserId = u.Id
  LEFT JOIN Badges b ON b.UserId = u.Id
  WHERE p.LastActivityDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '60 days'
),
TagFromComplex AS (
  SELECT
    cj.PostId,
    cj.Title,
    cj.Score,
    cj.ViewCount,
    cj.CommentCount,
    cj.AnswerCount,
    cj.FavoriteCount,
    cj.VoteTypeName,
    cj.CommentText,
    cj.UserDisplayName,
    cj.UserReputation,
    tag.TagName
  FROM ComplexJoins cj,
  LATERAL (
    SELECT unnest(string_to_array(substr(COALESCE(cj.PostTags, '[]'), 2, length(COALESCE(cj.PostTags, '[]')) - 2), '><')) AS TagName
  ) AS tag
  WHERE tag.TagName IS NOT NULL
),
WindowAgg AS (
  SELECT
    t.PostId,
    t.Title,
    t.Score,
    t.ViewCount,
    t.CommentCount,
    t.AnswerCount,
    t.FavoriteCount,
    t.VoteTypeName,
    t.CommentText,
    t.UserDisplayName,
    t.UserReputation,
    t.TagName,
    ROW_NUMBER() OVER (PARTITION BY t.TagName ORDER BY t.Score DESC, t.ViewCount DESC) AS rn
  FROM TagFromComplex t
)
SELECT
  w.PostId,
  w.Title,
  w.Score,
  w.ViewCount,
  w.CommentCount,
  w.AnswerCount,
  w.FavoriteCount,
  w.VoteTypeName,
  w.CommentText,
  w.UserDisplayName,
  w.UserReputation,
  tt.TagName,
  tt.PostCount
FROM WindowAgg w
JOIN TopTags tt ON tt.TagName = w.TagName
WHERE w.rn = 1
ORDER BY tt.PostCount DESC, w.Score DESC
LIMIT 100;