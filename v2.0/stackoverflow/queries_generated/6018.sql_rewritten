-- {"query": "6018.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 607} 
SELECT 
    u.DisplayName, 
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(p.Score) AS HighestScoredPost,
    MIN(p.CreationDate) AS FirstPost,
    MAX(p.LastActivityDate) AS LastActivity,
    b.Name AS LatestBadge,
    ph.Comment AS LastEditComment,
    (
        SELECT STRING_AGG(t.TagName, ', ')
        FROM Tags t
        WHERE t.Id IN (
            SELECT Id
            FROM UNNEST(STRING_TO_ARRAY(p.Tags, '/><')) AS tag
        )
    ) AS Tags,
    v.VoteTypeId AS LastVoteType,
    vl.BountyAmount AS LastBounty
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    (
        SELECT 
            UserId, 
            Max(Date) AS MaxDate
        FROM 
            Badges
        GROUP BY 
            UserId
    ) bb ON u.Id = bb.UserId
LEFT JOIN 
    (
        SELECT 
            UserId, 
            PostId, 
            VoteTypeId, 
            BountyAmount
        FROM 
            Votes
        WHERE 
            CreationDate IN (
                SELECT MAX(CreationDate)
                FROM Votes
                GROUP BY UserId
            )
    ) v ON u.Id = v.UserId
LEFT JOIN 
    (
        SELECT 
            PostId, 
            MAX(CreationDate) AS MaxDate, 
            UserId, 
            Comment
        FROM 
            PostHistory
        WHERE 
            PostHistoryTypeId IN (2, 5, 6, 8, 10, 11, 12, 13, 14, 15, 19, 20, 35)
        GROUP BY 
            PostId, 
            UserId
    ) ph ON u.Id = ph.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Votes vl ON p.Id = vl.PostId AND vl.VoteTypeId = 8
WHERE 
    u.Reputation > 1000
    AND p.LastEditDate > p.CreationDate
GROUP BY 
    u.Id, u.DisplayName, u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    u.Reputation DESC, 
    TotalPosts DESC;