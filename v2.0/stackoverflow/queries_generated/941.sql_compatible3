with recent_users as (
  select
    u.id,
    u.displayname,
    u.reputation,
    u.creationdate,
    coalesce(nullif(trim(u.location), ''), 'UNKNOWN') as norm_location,
    date_trunc('month', u.creationdate) as cohort_month,
    row_number() over (order by u.creationdate desc, u.id desc) as rn_desc_signup
  from users u
  where u.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '5 years'
),
user_badge_agg as (
  select
    b.userid,
    count(*) as total_badges,
    sum(case when b.class = 1 then 1 else 0 end) as gold_badges,
    sum(case when b.class = 2 then 1 else 0 end) as silver_badges,
    sum(case when b.class = 3 then 1 else 0 end) as bronze_badges,
    max(b.date) as last_badge_date,
    count(*) filter (where b.tagbased = true) as tag_badges
  from badges b
  group by b.userid
),
q_posts as (
  select
    p.id,
    p.owneruserid,
    p.creationdate,
    p.score,
    p.viewcount,
    p.title,
    p.tags,
    p.answercount,
    p.closeddate,
    p.acceptedanswerid,
    array_length(string_to_array(coalesce(nullif(substring(p.tags, 2, greatest(length(p.tags)-2,0)), ''), ''), '><'), 1) as tag_count
  from posts p
  where p.posttypeid = 1
),
a_posts as (
  select
    p.id,
    p.parentid as question_id,
    p.owneruserid,
    p.creationdate,
    p.score
  from posts p
  where p.posttypeid = 2
),
question_activity as (
  select
    q.id as question_id,
    q.owneruserid,
    q.creationdate as q_created,
    q.score as q_score,
    q.viewcount,
    q.title,
    q.tags,
    q.answercount,
    q.closeddate,
    q.acceptedanswerid,
    q.tag_count,
    count(a.id) as answers_total,
    count(a.id) filter (where a.score > 0) as answers_positive,
    max(a.score) as max_answer_score,
    min(a.creationdate) as first_answer_at,
    avg(a.score) as avg_answer_score
  from q_posts q
  left join a_posts a on a.question_id = q.id
  group by q.id, q.owneruserid, q.creationdate, q.score, q.viewcount, q.title, q.tags, q.answercount, q.closeddate, q.acceptedanswerid, q.tag_count
),
votes_agg as (
  select
    v.postid,
    count(*) filter (where v.votetypeid = 2) as upvotes,
    count(*) filter (where v.votetypeid = 3) as downvotes,
    count(*) filter (where v.votetypeid = 5) as favorites,
    sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounty_sum,
    max(v.creationdate) as last_vote_at
  from votes v
  group by v.postid
),
comment_agg as (
  select
    c.postid,
    count(*) as comments,
    count(*) filter (where c.score > 0) as pos_comments,
    max(c.creationdate) as last_comment_at,
    max(length(c.text)) as max_comment_len
  from comments c
  group by c.postid
),
ph_closure as (
  select
    ph.postid,
    min(ph.creationdate) filter (where ph.posthistorytypeid = 10) as first_closed_at,
    min(ph.creationdate) filter (where ph.posthistorytypeid = 11) as first_reopened_at,
    max(case when ph.posthistorytypeid = 10 then cast(ph.comment as integer) end) as any_close_reason_id
  from posthistory ph
  where ph.posthistorytypeid in (10,11)
  group by ph.postid
),
dupe_links as (
  select
    pl.postid,
    count(*) filter (where pl.linktypeid = 3) as dupe_links_count,
    count(*) filter (where pl.linktypeid = 1) as linked_count,
    max(pl.creationdate) as last_link_at
  from postlinks pl
  group by pl.postid
),
tag_popularity as (
  select
    t.tagname,
    t.count as tag_total_count,
    ntile(5) over (order by t.count desc nulls last) as tag_pop_quintile
  from tags t
),
question_tag_expanded as (
  select
    qa.question_id,
    lower(trim(both ' ' from unnest(string_to_array(coalesce(nullif(substring(qa.tags, 2, greatest(length(qa.tags)-2,0)), ''), ''), '><')))) as tagname
  from question_activity qa
  where qa.tags is not null
),
question_tag_rank as (
  select
    qte.question_id,
    qte.tagname,
    tp.tag_total_count,
    tp.tag_pop_quintile,
    row_number() over (partition by qte.question_id order by tp.tag_total_count desc nulls last, qte.tagname) as tag_rank
  from question_tag_expanded qte
  left join tag_popularity tp on tp.tagname = qte.tagname
),
accepted_answer_latency as (
  select
    qa.question_id,
    case
      when qa.acceptedanswerid is null then null
      else (select a.creationdate from a_posts a where a.id = qa.acceptedanswerid)
    end as accepted_at,
    qa.q_created
  from question_activity qa
),
user_posting_summary as (
  select
    ru.id as user_id,
    ru.displayname,
    ru.norm_location,
    ru.cohort_month,
    ua.total_badges,
    coalesce(ua.gold_badges,0) as gold_badges,
    coalesce(ua.silver_badges,0) as silver_badges,
    coalesce(ua.bronze_badges,0) as bronze_badges,
    coalesce(ua.tag_badges,0) as tag_badges,
    ua.last_badge_date,
    count(distinct case when p.posttypeid = 1 then p.id end) as questions_posted,
    count(distinct case when p.posttypeid = 2 then p.id end) as answers_posted,
    sum(case when p.posttypeid = 1 then p.score else 0 end) as q_score_sum,
    sum(case when p.posttypeid = 2 then p.score else 0 end) as a_score_sum,
    max(p.creationdate) as last_post_at
  from recent_users ru
  left join user_badge_agg ua on ua.userid = ru.id
  left join posts p on p.owneruserid = ru.id
  group by ru.id, ru.displayname, ru.norm_location, ru.cohort_month, ua.total_badges, ua.gold_badges, ua.silver_badges, ua.bronze_badges, ua.tag_badges, ua.last_badge_date
),
ranked_questions as (
  select
    qa.*,
    va.upvotes,
    va.downvotes,
    va.favorites,
    va.bounty_sum,
    va.last_vote_at,
    ca.comments,
    ca.pos_comments,
    ca.last_comment_at,
    ca.max_comment_len,
    pc.first_closed_at,
    pc.first_reopened_at,
    pc.any_close_reason_id,
    dl.dupe_links_count,
    dl.linked_count,
    dl.last_link_at,
    aal.accepted_at,
    extract(epoch from (aal.accepted_at - qa.q_created)) / 3600.0 as hours_to_accept,
    sum(qa.viewcount) over (order by qa.q_created rows between unbounded preceding and current row) as running_views,
    avg(qa.q_score) over (partition by date_trunc('month', qa.q_created)) as monthly_avg_qscore,
    rank() over (order by coalesce(va.upvotes,0) - coalesce(va.downvotes,0) desc, qa.viewcount desc, qa.q_score desc, qa.question_id) as global_popularity_rank,
    qa.owneruserid,
    qa.q_created as creationdate
  from question_activity qa
  left join votes_agg va on va.postid = qa.question_id
  left join comment_agg ca on ca.postid = qa.question_id
  left join ph_closure pc on pc.postid = qa.question_id
  left join dupe_links dl on dl.postid = qa.question_id
  left join accepted_answer_latency aal on aal.question_id = qa.question_id
),
question_top_tag as (
  select
    qtr.question_id,
    qtr.tagname as top_tag,
    qtr.tag_total_count as top_tag_total_count,
    qtr.tag_pop_quintile as top_tag_quintile
  from question_tag_rank qtr
  where qtr.tag_rank = 1
),
user_recent_activity as (
  select
    ups.*,
    count(*) over (partition by ups.user_id) as user_rows
  from user_posting_summary ups
),
question_owner as (
  select
    rq.question_id,
    rq.owneruserid as user_id
  from ranked_questions rq
),
user_question_scores as (
  select
    qo.user_id,
    count(*) as questions_count,
    avg(rq.q_score) as avg_q_score,
    sum(coalesce(rq.upvotes,0) - coalesce(rq.downvotes,0)) as net_votes_sum,
    sum(coalesce(rq.viewcount,0)) as views_sum,
    avg(rq.hours_to_accept) filter (where rq.hours_to_accept is not null) as avg_hours_to_accept
  from question_owner qo
  join ranked_questions rq on rq.question_id = qo.question_id
  group by qo.user_id
),
location_quality as (
  select
    ru.norm_location,
    count(*) as users_in_loc,
    avg(coalesce(uqs.avg_q_score,0)) as loc_avg_qscore,
    percentile_cont(0.5) within group (order by coalesce(uqs.avg_q_score,0)) as loc_median_qscore
  from recent_users ru
  left join user_question_scores uqs on uqs.user_id = ru.id
  group by ru.norm_location
),
final as (
  select
    rq.question_id,
    rq.title,
    substring(coalesce(rq.title,''), 1, 80) as title_80,
    rq.tags,
    qt.top_tag,
    qt.top_tag_quintile,
    rq.tag_count,
    rq.q_score as question_score,
    rq.viewcount,
    rq.answers_total,
    rq.answers_positive,
    rq.max_answer_score,
    rq.avg_answer_score,
    rq.upvotes,
    rq.downvotes,
    rq.favorites,
    rq.bounty_sum,
    rq.comments,
    rq.pos_comments,
    rq.any_close_reason_id,
    rq.dupe_links_count,
    rq.global_popularity_rank,
    rq.monthly_avg_qscore,
    rq.hours_to_accept,
    case
      when rq.first_closed_at is not null and rq.first_reopened_at is null then 'CLOSED'
      when rq.first_closed_at is not null and rq.first_reopened_at is not null and rq.first_reopened_at > rq.first_closed_at then 'REOPENED'
      else 'OPEN_OR_UNKNOWN'
    end as closure_state,
    ru.id as owner_id,
    coalesce(nullif(ru.displayname,''), concat('user#', cast(ru.id as varchar))) as owner_displayname,
    ru.norm_location as owner_location,
    uqs.avg_q_score as owner_avg_qscore,
    uqs.net_votes_sum as owner_net_votes_on_questions,
    uqs.avg_hours_to_accept as owner_avg_hours_to_accept,
    ua.total_badges,
    ua.gold_badges,
    ua.silver_badges,
    ua.bronze_badges,
    ua.tag_badges,
    lq.loc_avg_qscore,
    lq.loc_median_qscore,
    case
      when rq.viewcount > 0 then round((coalesce(rq.upvotes,0) - coalesce(rq.downvotes,0)) / cast(rq.viewcount as numeric), 6)
      else null
    end as net_votes_per_view,
    case
      when rq.answers_total > 0 then round(coalesce(rq.answers_positive,0) / cast(rq.answers_total as numeric), 6)
      else null
    end as positive_answer_ratio,
    case
      when rq.tag_count > 0 then round(coalesce(rq.favorites,0) / cast(rq.tag_count as numeric), 6)
      else null
    end as favorites_per_tag,
    rq.running_views,
    rq.last_comment_at,
    rq.last_vote_at,
    rq.last_link_at,
    rq.creationdate
  from ranked_questions rq
  left join question_top_tag qt on qt.question_id = rq.question_id
  left join users ru on ru.id = rq.owneruserid
  left join user_badge_agg ua on ua.userid = ru.id
  left join user_question_scores uqs on uqs.user_id = ru.id
  left join location_quality lq on lq.norm_location = coalesce(nullif(trim(ru.location), ''), 'UNKNOWN')
  where rq.creationdate >= cast('2024-10-01 12:34:56' as timestamp) - interval '3 years'
    and coalesce(rq.upvotes,0) + coalesce(rq.downvotes,0) + coalesce(rq.comments,0) > 0
    and (qt.top_tag_quintile is null or qt.top_tag_quintile <= 3)
)
select *
from final
where
  (owner_avg_qscore is null or owner_avg_qscore >= (
     select avg_q_score
     from user_question_scores uqs2
     where uqs2.user_id = final.owner_id
  ))
  and coalesce(positive_answer_ratio, 0) >= (
     select coalesce(avg(cast(rq2.answers_positive as numeric) / nullif(rq2.answers_total,0)), 0)
     from ranked_questions rq2
     where date_trunc('year', rq2.creationdate) = date_trunc('year', cast('2024-10-01 12:34:56' as timestamp))
  )
order by global_popularity_rank nulls last, viewcount desc, question_id
limit 500;