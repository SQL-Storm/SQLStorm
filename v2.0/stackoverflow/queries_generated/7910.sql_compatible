SELECT 
    u.Id as UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) as TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
    COALESCE(SUM(p.Score), 0) as TotalScore,
    COALESCE(AVG(p.Score), 0) as AvgScore,
    MAX(p.CreationDate) as LastPostDate,
    MIN(p.CreationDate) as FirstPostDate,
    COUNT(DISTINCT b.Id) as BadgesCount,
    STRING_AGG(DISTINCT b.Name, ', ') as BadgeNames,
    COUNT(DISTINCT c.Id) as CommentCount,
    COUNT(DISTINCT ph.Id) as HistoryEvents,
    COUNT(DISTINCT pl.Id) as LinkCount,
    CASE 
        WHEN COUNT(DISTINCT p.Id) > 0 THEN 
            ROUND(CAST(COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS NUMERIC) / NULLIF(COUNT(DISTINCT p.Id),0) * 100, 2)
        ELSE 0 
    END as QuestionPercentage,
    CASE 
        WHEN u.Reputation > 10000 THEN 'Veteran'
        WHEN u.Reputation > 1000 THEN 'Experienced'
        WHEN u.Reputation > 100 THEN 'Intermediate'
        ELSE 'Beginner'
    END as ReputationLevel,
    COALESCE((
        SELECT p.Title
        FROM Posts p2
        WHERE p2.OwnerUserId = u.Id 
          AND p2.PostTypeId = 1
        ORDER BY p2.Score DESC, p2.CreationDate DESC
        LIMIT 1
    ), 'No Questions') as TopQuestion,
    COALESCE((
        SELECT p.Title
        FROM Posts p3
        WHERE p3.OwnerUserId = u.Id 
          AND p3.PostTypeId = 2
        ORDER BY p3.Score DESC, p3.CreationDate DESC
        LIMIT 1
    ), 'No Answers') as TopAnswer,
    CASE 
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) = 0 THEN 'No Questions'
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) = 0 THEN 'No Answers'
        ELSE 'Active'
    END as ActivityStatus,
    ROW_NUMBER() OVER (ORDER BY SUM(p.Score) DESC, COUNT(DISTINCT p.Id) DESC) as Ranking,
    DENSE_RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
    PERCENT_RANK() OVER (ORDER BY u.Reputation DESC) * 100 as ReputationPercentile,
    NTILE(10) OVER (ORDER BY u.Reputation DESC) as ReputationDecile,
    LAG(u.Reputation, 1, 0) OVER (ORDER BY u.Reputation DESC) - u.Reputation as ReputationDiffFromNext,
    LEAD(u.Reputation, 1, 0) OVER (ORDER BY u.Reputation DESC) - u.Reputation as ReputationDiffFromPrev,
    COALESCE(
        (SELECT COUNT(*) 
         FROM Posts p2 
         WHERE p2.OwnerUserId = u.Id 
           AND p2.Score > 0 
           AND p2.CreationDate BETWEEN (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30 day') AND CAST('2024-10-01 12:34:56' AS TIMESTAMP)
        ), 0
    ) as RecentActivePosts,
    CASE
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 0 
         AND COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) > 0
        THEN 'Questioner and Answerer'
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 0
        THEN 'Questioner'
        ELSE 'Answerer'
    END as UserRole,
    (
        SELECT COUNT(*) 
        FROM Posts p3 
        WHERE p3.OwnerUserId = u.Id 
          AND p3.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year')
          AND p3.PostTypeId IN (1, 2)
    ) as PostsLastYear,
    CASE 
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 0 THEN 
            (SELECT AVG(p4.Score) 
             FROM Posts p4 
             WHERE p4.OwnerUserId = u.Id 
               AND p4.PostTypeId = 1)
        ELSE 0 
    END as AvgQuestionScore,
    CASE 
        WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) > 0 THEN 
            (SELECT AVG(p5.Score) 
             FROM Posts p5 
             WHERE p5.OwnerUserId = u.Id 
               AND p5.PostTypeId = 2)
        ELSE 0 
    END as AvgAnswerScore,
    ROUND(
        CASE 
            WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 0 
            THEN CAST(SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS NUMERIC) / NULLIF(COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END),0)
            ELSE 0 
        END, 2
    ) as AvgQuestionScoreWithRound,
    (
        SELECT MAX(p6.Score)
        FROM Posts p6
        WHERE p6.OwnerUserId = u.Id
          AND p6.PostTypeId IN (1, 2)
    ) as HighestPostScore,
    (
        SELECT MIN(p7.Score)
        FROM Posts p7
        WHERE p7.OwnerUserId = u.Id
          AND p7.PostTypeId IN (1, 2)
    ) as LowestPostScore,
    (SELECT COUNT(*) FROM Votes v WHERE v.UserId = u.Id AND v.VoteTypeId = 2) as UpVotesReceived,
    (SELECT COUNT(*) FROM Votes v WHERE v.UserId = u.Id AND v.VoteTypeId = 3) as DownVotesReceived,
    (SELECT COUNT(*) FROM Comments c2 WHERE c2.UserId = u.Id) as CommentsMade,
    (SELECT COUNT(*) FROM Badges b2 WHERE b2.UserId = u.Id AND b2.Class = 1) as GoldBadges,
    (SELECT COUNT(*) FROM Badges b3 WHERE b3.UserId = u.Id AND b3.Class = 2) as SilverBadges,
    (SELECT COUNT(*) FROM Badges b4 WHERE b4.UserId = u.Id AND b4.Class = 3) as BronzeBadges,
    CASE 
        WHEN EXISTS (SELECT 1 FROM Users u2 WHERE u2.AccountId = u.AccountId AND u2.Id != u.Id) THEN 'SharedAccount'
        ELSE 'UniqueAccount'
    END as AccountStatus,
    COALESCE(
        (SELECT p8.Title 
         FROM Posts p8 
         WHERE p8.OwnerUserId = u.Id 
           AND p8.PostTypeId = 1 
           AND p8.ViewCount > 1000
         ORDER BY p8.ViewCount DESC
         LIMIT 1
        ), 'No Popular Questions'
    ) as MostViewedQuestion,
    COALESCE(
        (SELECT p9.Title 
         FROM Posts p9 
         WHERE p9.OwnerUserId = u.Id 
           AND p9.PostTypeId = 2 
           AND p9.Score > 100
         ORDER BY p9.Score DESC
         LIMIT 1
        ), 'No Popular Answers'
    ) as HighestScoringAnswer,
    (
        SELECT STRING_AGG(SUBSTRING(p10.Title FROM 1 FOR 20) || '...', ', ')
        FROM (
            SELECT p10.*
            FROM Posts p10 
            WHERE p10.OwnerUserId = u.Id 
              AND p10.PostTypeId = 1
            ORDER BY p10.CreationDate DESC
            LIMIT 5
        ) s
    ) as RecentQuestions,
    (
        SELECT STRING_AGG(SUBSTRING(p11.Body FROM 1 FOR 50) || '...', ', ')
        FROM (
            SELECT p11.*
            FROM Posts p11 
            WHERE p11.OwnerUserId = u.Id 
              AND p11.PostTypeId = 2
            ORDER BY p11.CreationDate DESC
            LIMIT 5
        ) s2
    ) as RecentAnswers,
    COALESCE(
        (SELECT COUNT(*) 
         FROM Posts p12 
         WHERE p12.OwnerUserId = u.Id 
           AND p12.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '7 day')
        ), 0
    ) as PostsLastWeek,
    COALESCE(
        (SELECT COUNT(*) 
         FROM Posts p13 
         WHERE p13.OwnerUserId = u.Id 
           AND p13.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '14 day')
           AND p13.CreationDate < (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '7 day')
        ), 0
    ) as PostsWeekBefore,
    COALESCE(
        (SELECT COUNT(*) 
         FROM Votes v2 
         WHERE v2.UserId = u.Id 
           AND v2.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '3 month')
        ), 0
    ) as VotesInLast3Months
FROM Users u
FULL OUTER JOIN Posts p ON u.Id = p.OwnerUserId
LEFT JOIN Badges b ON u.Id = b.UserId
LEFT JOIN Comments c ON u.Id = c.UserId
LEFT JOIN PostHistory ph ON u.Id = ph.UserId
LEFT JOIN PostLinks pl ON u.Id = pl.PostId
WHERE u.Id > 0 
GROUP BY 
    u.Id, u.DisplayName, u.Reputation
HAVING COUNT(DISTINCT p.Id) > 0 
   OR COUNT(DISTINCT b.Id) > 0 
   OR COUNT(DISTINCT c.Id) > 0
ORDER BY SUM(p.Score) DESC, COUNT(DISTINCT p.Id) DESC, u.Reputation DESC
OFFSET 0 ROWS FETCH NEXT 100 ROWS ONLY;