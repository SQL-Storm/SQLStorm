with
q as (
  select
    p.Id as QuestionId,
    p.OwnerUserId as OwnerId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.Title,
    p.Tags,
    p.AcceptedAnswerId,
    p.ClosedDate,
    date_trunc('month', p.CreationDate) as month_bucket
  from Posts p
  where p.PostTypeId = 1
),
answers as (
  select
    a.ParentId as QuestionId,
    a.Id as AnswerId,
    a.OwnerUserId as AnswerOwnerId,
    a.Score as AnswerScore,
    a.CreationDate as AnswerCreationDate,
    row_number() over (partition by a.ParentId order by a.Score desc nulls last, a.Id) as rn_by_score,
    row_number() over (partition by a.ParentId order by a.CreationDate asc, a.Id) as rn_by_first
  from Posts a
  where a.PostTypeId = 2
),
accepted as (
  select
    q.QuestionId,
    q.AcceptedAnswerId,
    a.AnswerId,
    a.AnswerOwnerId,
    a.AnswerScore,
    a.AnswerCreationDate
  from q
  left join answers a
    on a.AnswerId = q.AcceptedAnswerId
),
first_answer as (
  select
    a.QuestionId,
    a.AnswerId as FirstAnswerId,
    a.AnswerOwnerId as FirstAnswerOwnerId,
    a.AnswerScore as FirstAnswerScore,
    a.AnswerCreationDate as FirstAnswerCreationDate
  from answers a
  where a.rn_by_first = 1
),
top_answer as (
  select
    a.QuestionId,
    a.AnswerId as TopAnswerId,
    a.AnswerOwnerId as TopAnswerOwnerId,
    a.AnswerScore as TopAnswerScore,
    a.AnswerCreationDate as TopAnswerCreationDate
  from answers a
  where a.rn_by_score = 1
),
votes_q as (
  select
    v.PostId as QuestionId,
    sum(case when v.VoteTypeId = 2 then 1 when v.VoteTypeId = 3 then -1 else 0 end) as NetVotes,
    count(case when v.VoteTypeId = 5 then 1 end) as FavoriteVotes,
    count(case when v.VoteTypeId = 8 then 1 end) as BountyStarts,
    count(case when v.VoteTypeId = 9 then 1 end) as BountyCloses,
    sum(case when v.VoteTypeId in (8,9) then v.BountyAmount else 0 end) as BountyAmountTotal
  from Votes v
  group by v.PostId
),
user_stats as (
  select
    u.Id as UserId,
    u.Reputation,
    u.UpVotes,
    u.DownVotes,
    u.Views as ProfileViews,
    coalesce(nullif(trim(u.Location), ''), 'Unknown') as NormLocation,
    date_trunc('year', u.CreationDate) as UserCohortYear
  from Users u
),
badges_by_user as (
  select
    b.UserId,
    count(*) as BadgeCount,
    count(case when b.Class = 1 then 1 end) as GoldCount,
    count(case when b.Class = 2 then 1 end) as SilverCount,
    count(case when b.Class = 3 then 1 end) as BronzeCount,
    count(case when (b.TagBased IS NOT NULL AND b.TagBased <> 0) then 1 end) as TagBadges
  from Badges b
  group by b.UserId
),
post_links_dedupe as (
  select
    pl.PostId,
    pl.RelatedPostId,
    pl.LinkTypeId,
    min(pl.CreationDate) as FirstLinkDate,
    count(*) as LinkCount
  from PostLinks pl
  group by pl.PostId, pl.RelatedPostId, pl.LinkTypeId
),
dup_graph as (
  select
    q.QuestionId,
    count(case when pld.LinkTypeId = 3 then 1 end) as DuplicateLinks,
    count(case when pld.LinkTypeId = 1 then 1 end) as LinkedLinks,
    max(case when pld.LinkTypeId = 3 then pld.FirstLinkDate end) as LastDuplicateLinkDate
  from q
  left join post_links_dedupe pld
    on pld.PostId = q.QuestionId
  group by q.QuestionId
),
edits as (
  select
    ph.PostId as QuestionId,
    count(case when ph.PostHistoryTypeId in (4,5,6) then 1 end) as EditCount,
    max(case when ph.PostHistoryTypeId in (4,5,6) then ph.CreationDate end) as LastEditDate,
    count(case when ph.PostHistoryTypeId = 10 then 1 end) as CloseEvents,
    max(
      case
        when ph.PostHistoryTypeId = 10 and ph.Comment ~ '^[0-9]+$' then cast(ph.Comment as integer)
        else null
      end
    ) as LastCloseReasonId
  from PostHistory ph
  group by ph.PostId
),
close_reason as (
  select
    e.QuestionId,
    crt.Name as LastCloseReasonName
  from edits e
  left join CloseReasonTypes crt
    on crt.Id = e.LastCloseReasonId
),
tags_expanded as (
  select
    q.QuestionId,
    unnest(string_to_array(substring(q.Tags from 2 for length(q.Tags)-2), '><')) as tag
  from q
  where q.Tags is not null and length(q.Tags) > 2
),
tag_agg as (
  select
    te.QuestionId,
    string_agg(te.tag, ',' order by te.tag) as TagList,
    count(*) as TagCount,
    max(case when lower(te.tag) like '%sql%' then 1 else 0 end) as HasSQLish
  from tags_expanded te
  group by te.QuestionId
),
activity_lag as (
  select
    q.QuestionId,
    q.CreationDate,
    q.LastActivityDate,
    extract(epoch from (q.LastActivityDate - q.CreationDate)) as ActiveSeconds
  from Posts q
  where q.PostTypeId = 1 and q.CreationDate is not null and q.LastActivityDate is not null
),
quality_buckets as (
  select
    q.QuestionId,
    width_bucket(coalesce(q.Score,0), -5, 50, 10) as ScoreBucket,
    width_bucket(coalesce(q.ViewCount,0), 0, 100000, 10) as ViewBucket
  from q
),
comment_stats as (
  select
    c.PostId as QuestionId,
    count(*) as CommentCount,
    avg(c.Score) as AvgCommentScore,
    max(c.Score) as MaxCommentScore,
    min(c.CreationDate) as FirstCommentDate,
    max(c.CreationDate) as LastCommentDate
  from Comments c
  group by c.PostId
),
owner_norm as (
  select
    q.QuestionId,
    u.UserId as OwnerId,
    u.Reputation,
    u.UpVotes,
    u.DownVotes,
    u.ProfileViews,
    u.NormLocation,
    u.UserCohortYear,
    coalesce(b.BadgeCount,0) as BadgeCount,
    coalesce(b.GoldCount,0) as GoldCount,
    coalesce(b.SilverCount,0) as SilverCount,
    coalesce(b.BronzeCount,0) as BronzeCount,
    coalesce(b.TagBadges,0) as TagBadges
  from q
  left join user_stats u on u.UserId = q.OwnerId
  left join badges_by_user b on b.UserId = q.OwnerId
),
accept_metrics as (
  select
    q.QuestionId,
    case when q.AcceptedAnswerId is not null then 1 else 0 end as HasAccepted,
    case when a.AnswerId is not null then 1 else 0 end as AcceptedFound,
    case when fa.FirstAnswerId is not null then 1 else 0 end as HasAnyAnswer,
    case when a.AnswerId is not null and fa.FirstAnswerId is not null
         then extract(epoch from (a.AnswerCreationDate - fa.FirstAnswerCreationDate))
         else null end as SecondsToAcceptFromFirst,
    case when a.AnswerId is not null and a.AnswerOwnerId = q.OwnerId then 1 else 0 end as SelfAccepted,
    case when a.AnswerId is not null and ta.TopAnswerId = a.AnswerId then 1 else 0 end as AcceptedIsTopByScore
  from q
  left join accepted a on a.QuestionId = q.QuestionId
  left join first_answer fa on fa.QuestionId = q.QuestionId
  left join top_answer ta on ta.QuestionId = q.QuestionId
),
scored as (
  select
    q.QuestionId,
    q.Title,
    q.Score,
    q.ViewCount,
    qa.NetVotes,
    qa.FavoriteVotes,
    qa.BountyStarts,
    qa.BountyCloses,
    qa.BountyAmountTotal,
    coalesce(t.TagList,'') as TagList,
    coalesce(t.TagCount,0) as TagCount,
    coalesce(t.HasSQLish,0) as HasSQLish,
    coalesce(cs.CommentCount,0) as CommentCount,
    cs.AvgCommentScore,
    cs.MaxCommentScore,
    e.EditCount,
    e.LastEditDate,
    e.CloseEvents,
    cr.LastCloseReasonName,
    ag.ActiveSeconds,
    qb.ScoreBucket,
    qb.ViewBucket,
    am.HasAccepted,
    am.AcceptedFound,
    am.HasAnyAnswer,
    am.SecondsToAcceptFromFirst,
    am.SelfAccepted,
    am.AcceptedIsTopByScore
  from q
  left join votes_q qa on qa.QuestionId = q.QuestionId
  left join tag_agg t on t.QuestionId = q.QuestionId
  left join comment_stats cs on cs.QuestionId = q.QuestionId
  left join edits e on e.QuestionId = q.QuestionId
  left join close_reason cr on cr.QuestionId = q.QuestionId
  left join activity_lag ag on ag.QuestionId = q.QuestionId
  left join quality_buckets qb on qb.QuestionId = q.QuestionId
  left join accept_metrics am on am.QuestionId = q.QuestionId
),
ranked as (
  select
    s.QuestionId,
    s.Title,
    s.Score,
    s.ViewCount,
    s.NetVotes,
    s.FavoriteVotes,
    s.BountyStarts,
    s.BountyCloses,
    s.BountyAmountTotal,
    s.TagList,
    s.TagCount,
    s.HasSQLish,
    s.CommentCount,
    s.AvgCommentScore,
    s.MaxCommentScore,
    s.EditCount,
    s.LastEditDate,
    s.CloseEvents,
    s.LastCloseReasonName,
    s.ActiveSeconds,
    s.ScoreBucket,
    s.ViewBucket,
    s.HasAccepted,
    s.AcceptedFound,
    s.HasAnyAnswer,
    s.SecondsToAcceptFromFirst,
    s.SelfAccepted,
    s.AcceptedIsTopByScore,
    dense_rank() over (order by coalesce(s.Score,0) desc, coalesce(s.ViewCount,0) desc, s.QuestionId) as DenseRankByScoreViews,
    row_number() over (partition by s.ScoreBucket order by coalesce(s.ViewCount,0) desc, s.QuestionId) as RNWithinScoreBucket,
    percentile_cont(0.5) within group (order by coalesce(s.ViewCount,0)) over (partition by s.TagCount) as MedianViewsByTagCount
  from scored s
),
cohort as (
  select
    r.QuestionId,
    r.Title,
    r.Score,
    r.ViewCount,
    r.NetVotes,
    r.FavoriteVotes,
    r.BountyStarts,
    r.BountyCloses,
    r.BountyAmountTotal,
    r.TagList,
    r.TagCount,
    r.HasSQLish,
    r.CommentCount,
    r.AvgCommentScore,
    r.MaxCommentScore,
    r.EditCount,
    r.LastEditDate,
    r.CloseEvents,
    r.LastCloseReasonName,
    r.ActiveSeconds,
    r.ScoreBucket,
    r.ViewBucket,
    r.DenseRankByScoreViews,
    r.RNWithinScoreBucket,
    r.MedianViewsByTagCount,
    o.Reputation,
    o.UpVotes,
    o.DownVotes,
    o.ProfileViews,
    o.NormLocation,
    o.UserCohortYear,
    o.BadgeCount,
    o.GoldCount,
    o.SilverCount,
    o.BronzeCount,
    o.TagBadges
  from ranked r
  left join owner_norm o on o.QuestionId = r.QuestionId
),
null_logic_demo as (
  select
    c.*,
    case
      when c.LastCloseReasonName is null and c.CloseEvents > 0 then 'ClosedReasonMissing'
      when c.LastCloseReasonName is not null and (c.CloseEvents is null or c.CloseEvents = 0) then 'ReasonButNoEvent'
      else 'Consistent'
    end as CloseReasonState,
    coalesce(nullif(trim(c.Title), ''), '[no title]') as TitleNorm,
    nullif(c.TagList, '') as NonEmptyTagList
  from cohort c
),
heavy_calc as (
  select
    n.*,
    (
      coalesce(n.Score,0)*2
      + coalesce(n.NetVotes,0)
      + greatest(floor(coalesce(n.ViewCount,0)/100),0)
      + coalesce(n.CommentCount,0)
      + case when n.HasAccepted = 1 then 50 else 0 end
      + case when n.AcceptedIsTopByScore = 1 then 15 else 0 end
      - case when n.SelfAccepted = 1 then 5 else 0 end
      + least(coalesce(n.EditCount,0), 10)
      + case when n.HasSQLish = 1 then 7 else 0 end
      + least(floor(coalesce(n.BountyAmountTotal,0)/50), 40)
    ) as PerfScore,
    case
      when n.ActiveSeconds is null then null
      when n.ActiveSeconds < 3600 then 'burst'
      when n.ActiveSeconds < 86400 then 'day'
      when n.ActiveSeconds < 604800 then 'week'
      else 'long'
    end as ActiveSpan,
    md5(coalesce(n.TitleNorm,'') || '|' || coalesce(n.NonEmptyTagList,'')) as TitleTagHash
  from null_logic_demo n
),
rolling as (
  select
    h.*,
    avg(h.PerfScore) over (partition by date_trunc('month', (select CreationDate from Posts p where p.Id = h.QuestionId)) order by h.QuestionId rows between 50 preceding and current row) as RollingAvgPerfScore,
    sum(case when h.HasAccepted = 1 then 1 else 0 end) over (partition by h.ScoreBucket) as AcceptedPerScoreBucket,
    count(*) over (partition by h.NormLocation) as QuestionsPerLocation
  from heavy_calc h
),
mix_set as (
  select QuestionId, TitleNorm, PerfScore, ActiveSpan, DenseRankByScoreViews
  from rolling
  where PerfScore is not null
  union all
  select QuestionId, TitleNorm, PerfScore, ActiveSpan, DenseRankByScoreViews
  from rolling
  where PerfScore is null
),
final_rank as (
  select
    r.*,
    row_number() over (order by coalesce(r.PerfScore, -1) desc, r.DenseRankByScoreViews, r.QuestionId) as GlobalRN
  from rolling r
)
select
  fr.QuestionId,
  fr.GlobalRN,
  fr.PerfScore,
  fr.RollingAvgPerfScore,
  fr.ActiveSpan,
  fr.Score,
  fr.ViewCount,
  fr.NetVotes,
  fr.CommentCount,
  fr.TagList,
  fr.TagCount,
  fr.HasSQLish,
  fr.CloseEvents,
  fr.LastCloseReasonName,
  fr.NormLocation,
  fr.UserCohortYear,
  fr.BadgeCount,
  fr.GoldCount,
  fr.SilverCount,
  fr.BronzeCount,
  fr.BountyAmountTotal,
  fr.AcceptedPerScoreBucket,
  fr.QuestionsPerLocation,
  fr.TitleNorm,
  fr.TitleTagHash
from final_rank fr
where (
    fr.HasAnyAnswer = 1
    and (
      fr.HasAccepted = 1
      or (fr.EditCount > 0 and fr.CloseEvents = 0)
      or (fr.HasSQLish = 1 and coalesce(fr.ViewCount,0) > 1000)
    )
  )
  and (
    fr.NormLocation is null
    or lower(fr.NormLocation) not like '%test%'
    or (fr.TagCount between 1 and 5)
  )
  and (
    fr.ScoreBucket in (3,4,5,6,7,8,9,10)
    or fr.ViewBucket >= 2
  )
order by fr.GlobalRN
limit 500;