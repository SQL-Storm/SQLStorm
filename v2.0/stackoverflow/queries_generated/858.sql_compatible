with recent_users as (
    select u.id as user_id,
           u.displayname,
           u.reputation,
           u.creationdate,
           coalesce(nullif(trim(split_part(coalesce(u.location,''), ',', 1)), ''), 'Unknown') as region_hint,
           row_number() over (order by u.creationdate desc, u.id desc) as rn
    from users u
    where u.creationdate >= (select max(creationdate) - interval '365 days' from users)
), top_users as (
    select *
    from recent_users
    where rn <= 2000
),
q_and_a as (
    select p.id,
           p.posttypeid,
           p.owneruserid,
           p.creationdate,
           p.score,
           p.viewcount,
           p.title,
           p.tags,
           case when p.posttypeid = 1 then 1 else 0 end as is_question,
           case when p.posttypeid = 2 then 1 else 0 end as is_answer
    from posts p
    where p.posttypeid in (1,2)
      and p.creationdate >= (select max(creationdate) - interval '365 days' from posts)
), user_activity as (
    select tu.user_id,
           count(*) filter (where qa.is_question = 1 and qa.owneruserid = tu.user_id) as questions_posted,
           count(*) filter (where qa.is_answer = 1 and qa.owneruserid = tu.user_id) as answers_posted,
           coalesce(sum(qa.score) filter (where qa.owneruserid = tu.user_id), 0) as total_post_score,
           coalesce(sum(qa.viewcount) filter (where qa.is_question = 1 and qa.owneruserid = tu.user_id), 0) as question_views
    from top_users tu
    left join q_and_a qa
      on qa.owneruserid = tu.user_id
    group by tu.user_id
), votes_agg as (
    select tu.user_id,
           count(*) filter (where v.votetypeid = 2) as upvotes_received,
           count(*) filter (where v.votetypeid = 3) as downvotes_received,
           count(*) filter (where v.votetypeid = 8) as bounties_started,
           sum(v.bountyamount) filter (where v.votetypeid in (8,9)) as bounty_amount_total
    from top_users tu
    left join posts p on p.owneruserid = tu.user_id
    left join votes v on v.postid = p.id
    group by tu.user_id
), comments_agg as (
    select tu.user_id,
           count(c.id) as comments_made,
           coalesce(sum(c.score), 0) as comment_score_sum,
           max(c.creationdate) as last_comment_date
    from top_users tu
    left join comments c on c.userid = tu.user_id
    group by tu.user_id
), badges_agg as (
    select tu.user_id,
           count(*) as badges_total,
           count(*) filter (where b.class = 1) as gold_badges,
           count(*) filter (where b.class = 2) as silver_badges,
           count(*) filter (where b.class = 3) as bronze_badges,
           count(*) filter (where b.tagbased = true) as tag_badges,
           max(b.date) as last_badge_date
    from top_users tu
    left join badges b on b.userid = tu.user_id
    group by tu.user_id
), postlinks_agg as (
    select tu.user_id,
           count(distinct pl.id) filter (where pl.linktypeid = 1) as linked_refs,
           count(distinct pl.id) filter (where pl.linktypeid = 3) as duplicate_links
    from top_users tu
    left join posts p on p.owneruserid = tu.user_id
    left join postlinks pl on pl.postid = p.id
    group by tu.user_id
), closures as (
    select ph.postid,
           min(ph.creationdate) filter (where ph.posthistorytypeid = 10) as first_close_date,
           max(ph.creationdate) filter (where ph.posthistorytypeid = 11) as last_reopen_date,
           count(*) filter (where ph.posthistorytypeid = 10) as closes_count,
           count(*) filter (where ph.posthistorytypeid = 11) as reopens_count,
           count(*) filter (where ph.posthistorytypeid in (10,11)) as close_reopen_events
    from posthistory ph
    where ph.posthistorytypeid in (10,11)
    group by ph.postid
), questions_detail as (
    select p.id as question_id,
           p.owneruserid as owner_user_id,
           p.creationdate as q_created,
           p.score as q_score,
           p.viewcount as q_views,
           p.title as q_title,
           p.tags as q_tags,
           closures.first_close_date,
           closures.last_reopen_date,
           closures.closes_count,
           closures.reopens_count,
           array_length(string_to_array(coalesce(substring(p.tags, 2, greatest(length(p.tags)-2,0)), ''), '><'), 1) as tag_count,
           count(a.id) as answers_count,
           max(a.score) as best_answer_score,
           max(a.creationdate) as last_answer_date
    from posts p
    left join posts a on a.parentid = p.id and a.posttypeid = 2
    left join closures on closures.postid = p.id
    where p.posttypeid = 1
    group by p.id, p.owneruserid, p.creationdate, p.score, p.viewcount, p.title, p.tags,
             closures.first_close_date, closures.last_reopen_date, closures.closes_count, closures.reopens_count
), accepted_detail as (
    select q.question_id,
           pacc.id as accepted_answer_id,
           pacc.owneruserid as accepted_owner_id,
           pacc.score as accepted_score,
           pacc.creationdate as accepted_date
    from questions_detail q
    join posts qpost on qpost.id = q.question_id
    left join posts pacc on pacc.id = qpost.acceptedanswerid
), user_tag_pref as (
    select tu.user_id,
           lower(trim(x.tag)) as tag,
           count(*) as tag_uses,
           sum(coalesce(p.score,0)) as tag_score_sum
    from top_users tu
    join posts p on p.owneruserid = tu.user_id and p.posttypeid = 1
    cross join lateral (
        select unnest(string_to_array(substring(coalesce(p.tags,''), 2, greatest(length(coalesce(p.tags,''))-2,0)), '><')) as tag
    ) x
    group by tu.user_id, lower(trim(x.tag))
), fav_tag as (
    select user_id,
           tag as favorite_tag,
           tag_uses,
           tag_score_sum,
           row_number() over (partition by user_id order by tag_uses desc, tag_score_sum desc, tag asc) as rn
    from user_tag_pref
), activity_timeline as (
    select tu.user_id,
           date_trunc('month', coalesce(qa.creationdate, c.creationdate, b.date)) as month_bucket,
           count(distinct qa.id) filter (where qa.owneruserid = tu.user_id) as posts_in_month,
           count(distinct c.id) filter (where c.userid = tu.user_id) as comments_in_month,
           count(distinct b.id) filter (where b.userid = tu.user_id) as badges_in_month
    from top_users tu
    left join q_and_a qa on qa.owneruserid = tu.user_id
    left join comments c on c.userid = tu.user_id
    left join badges b on b.userid = tu.user_id
    group by tu.user_id, date_trunc('month', coalesce(qa.creationdate, c.creationdate, b.date))
), activity_stats as (
    select user_id,
           avg(posts_in_month) as avg_posts_per_month,
           stddev_samp(posts_in_month) as sd_posts_per_month,
           sum(comments_in_month) as total_comments_monthly_window,
           sum(badges_in_month) as total_badges_monthly_window
    from activity_timeline
    group by user_id
), density as (
    select p.owneruserid as user_id,
           count(*) as total_posts,
           count(*) filter (where p.lastactivitydate >= cast('2024-10-01 12:34:56' as timestamp) - interval '30 days') as posts_30d,
           avg(extract(epoch from (coalesce(p.lastactivitydate, p.creationdate) - p.creationdate)) / 3600.0) as avg_hours_to_last_activity
    from posts p
    join top_users tu on tu.user_id = p.owneruserid
    group by p.owneruserid
), quality as (
    select tu.user_id,
           percentile_cont(0.5) within group (order by coalesce(p.score,0)) as median_post_score,
           avg(nullif(p.viewcount,0)) as avg_views_nonzero,
           sum(case when p.score > 0 then 1 else 0 end) * 1.0 / nullif(count(*),0) as positive_score_ratio
    from top_users tu
    left join posts p on p.owneruserid = tu.user_id and p.posttypeid in (1,2)
    group by tu.user_id
), cross_user as (
    select qa1.owneruserid as u1,
           qa2.owneruserid as u2,
           count(*) as co_answered_questions
    from posts qa1
    join posts qa2
      on qa1.parentid = qa2.parentid
     and qa1.posttypeid = 2
     and qa2.posttypeid = 2
     and qa1.owneruserid <> qa2.owneruserid
    join top_users t1 on t1.user_id = qa1.owneruserid
    join top_users t2 on t2.user_id = qa2.owneruserid
    group by qa1.owneruserid, qa2.owneruserid
), peers as (
    select u1 as user_id,
           sum(co_answered_questions) as peer_touch_points,
           count(distinct u2) as distinct_peers
    from cross_user
    group by u1
), hotness as (
    select q.owner_user_id as user_id,
           sum(case when q.q_views >= 1000 then 1 else 0 end) as hot_questions,
           sum(case when q.answers_count >= 5 then 1 else 0 end) as heavily_answered,
           sum(case when q.q_score >= 10 then 1 else 0 end) as highly_scored
    from questions_detail q
    group by q.owner_user_id
), title_text_stats as (
    select tu.user_id,
           avg(length(coalesce(q.title,''))) as avg_title_len,
           avg((length(coalesce(q.title,'')) - length(replace(lower(coalesce(q.title,'')),'a',''))) * 1.0) as avg_title_a_count,
           sum(case when position('how' in lower(coalesce(q.title,''))) > 0 then 1 else 0 end) as how_in_title
    from top_users tu
    left join posts q on q.owneruserid = tu.user_id and q.posttypeid = 1
    group by tu.user_id
), final_scores as (
    select tu.user_id,
           tu.displayname,
           tu.region_hint,
           tu.reputation,
           ua.questions_posted,
           ua.answers_posted,
           ua.total_post_score,
           ua.question_views,
           va.upvotes_received,
           va.downvotes_received,
           coalesce(va.bounty_amount_total,0) as bounty_amount_total,
           ca.comments_made,
           ca.comment_score_sum,
           ba.badges_total,
           ba.gold_badges,
           ba.silver_badges,
           ba.bronze_badges,
           pl.linked_refs,
           pl.duplicate_links,
           ds.total_posts,
           ds.posts_30d,
           ds.avg_hours_to_last_activity,
           ql.median_post_score,
           ql.avg_views_nonzero,
           ql.positive_score_ratio,
           ps.peer_touch_points,
           ps.distinct_peers,
           ht.hot_questions,
           ht.heavily_answered,
           ht.highly_scored,
           ts.avg_title_len,
           ts.avg_title_a_count,
           ts.how_in_title,
           ad.avg_posts_per_month,
           ad.sd_posts_per_month,
           ad.total_comments_monthly_window,
           ad.total_badges_monthly_window,
           ft.favorite_tag,
           ft.tag_uses as favorite_tag_uses,
           ft.tag_score_sum as favorite_tag_score_sum,
           -- composite score with NULL-safe arithmetic
           coalesce(ua.questions_posted,0)*1.0
           + coalesce(ua.answers_posted,0)*2.0
           + coalesce(va.upvotes_received,0)*0.75
           - coalesce(va.downvotes_received,0)*0.5
           + coalesce(ba.gold_badges,0)*3
           + coalesce(ba.silver_badges,0)*1.5
           + coalesce(ba.bronze_badges,0)*0.5
           + coalesce(ds.posts_30d,0)*1.25
           + coalesce(ql.positive_score_ratio,0)*10
           + coalesce(ps.distinct_peers,0)*0.25
           + coalesce(ht.hot_questions,0)*4
           + coalesce(ht.highly_scored,0)*2
           - case when coalesce(pl.duplicate_links,0) > 0 then least(coalesce(pl.duplicate_links,0)*0.2, 5) else 0 end
           + case when coalesce(ad.sd_posts_per_month,0) = 0 then 1 else 0 end as composite_score
    from top_users tu
    left join user_activity ua on ua.user_id = tu.user_id
    left join votes_agg va on va.user_id = tu.user_id
    left join comments_agg ca on ca.user_id = tu.user_id
    left join badges_agg ba on ba.user_id = tu.user_id
    left join postlinks_agg pl on pl.user_id = tu.user_id
    left join density ds on ds.user_id = tu.user_id
    left join quality ql on ql.user_id = tu.user_id
    left join peers ps on ps.user_id = tu.user_id
    left join hotness ht on ht.user_id = tu.user_id
    left join title_text_stats ts on ts.user_id = tu.user_id
    left join activity_stats ad on ad.user_id = tu.user_id
    left join fav_tag ft on ft.user_id = tu.user_id and ft.rn = 1
), user_ranked as (
    select *,
           dense_rank() over (order by composite_score desc, reputation desc, total_posts desc, user_id) as rank_overall,
           ntile(10) over (order by composite_score desc) as decile,
           row_number() over (partition by region_hint order by composite_score desc) as regional_rank,
           sum(coalesce(questions_posted,0) + coalesce(answers_posted,0)) over (order by composite_score desc rows between unbounded preceding and current row) as running_posts
    from final_scores
), anomalies as (
    select fr.user_id,
           case
             when coalesce(fr.answers_posted,0) > 0 and coalesce(fr.questions_posted,0) = 0 and coalesce(fr.positive_score_ratio,0) < 0.2 then 'low_ratio_answerer'
             when coalesce(fr.questions_posted,0) > 50 and coalesce(fr.total_post_score,0) < 0 then 'many_questions_low_score'
             when fr.badges_total is null or fr.badges_total = 0 then 'no_badges'
             else null
           end as anomaly_flag
    from final_scores fr
)
select ur.user_id,
       ur.displayname,
       ur.region_hint,
       ur.reputation,
       ur.rank_overall,
       ur.decile,
       ur.regional_rank,
       ur.running_posts,
       ur.questions_posted,
       ur.answers_posted,
       ur.total_post_score,
       ur.question_views,
       ur.upvotes_received,
       ur.downvotes_received,
       ur.bounty_amount_total,
       ur.comments_made,
       ur.comment_score_sum,
       ur.badges_total,
       ur.gold_badges,
       ur.silver_badges,
       ur.bronze_badges,
       ur.linked_refs,
       ur.duplicate_links,
       ur.total_posts,
       ur.posts_30d,
       round(coalesce(ur.avg_hours_to_last_activity,0)::numeric, 2) as avg_hours_to_last_activity,
       round(coalesce(ur.median_post_score,0)::numeric, 2) as median_post_score,
       round(coalesce(ur.avg_views_nonzero,0)::numeric, 2) as avg_views_nonzero,
       round(coalesce(ur.positive_score_ratio,0)::numeric, 4) as positive_score_ratio,
       coalesce(ur.peer_touch_points,0) as peer_touch_points,
       coalesce(ur.distinct_peers,0) as distinct_peers,
       coalesce(ur.hot_questions,0) as hot_questions,
       coalesce(ur.heavily_answered,0) as heavily_answered,
       coalesce(ur.highly_scored,0) as highly_scored,
       round(coalesce(ur.avg_title_len,0)::numeric,2) as avg_title_len,
       round(coalesce(ur.avg_title_a_count,0)::numeric,3) as avg_title_a_count,
       coalesce(ur.how_in_title,0) as how_in_title,
       round(coalesce(ur.avg_posts_per_month,0)::numeric,3) as avg_posts_per_month,
       round(coalesce(ur.sd_posts_per_month,0)::numeric,3) as sd_posts_per_month,
       coalesce(ur.total_comments_monthly_window,0) as total_comments_monthly_window,
       coalesce(ur.total_badges_monthly_window,0) as total_badges_monthly_window,
       coalesce(ur.favorite_tag,'(none)') as favorite_tag,
       coalesce(ur.favorite_tag_uses,0) as favorite_tag_uses,
       coalesce(ur.favorite_tag_score_sum,0) as favorite_tag_score_sum,
       round(ur.composite_score::numeric, 3) as composite_score,
       an.anomaly_flag
from user_ranked ur
left join anomalies an on an.user_id = ur.user_id
where (ur.decile <= 3 or ur.regional_rank <= 10 or an.anomaly_flag is not null)
order by ur.rank_overall, ur.user_id
limit 500;