    bqr.WeightedPostEngagement,
    bqr.UpVoteCountOnPost,
    bqr.DownVoteCountOnPost,
    bqr.TotalEditEvents,
    bqr.LastCloseDate,
    bqr.CloseReasonName,
    bqr.TopContributingTag,
    bqr.AvgScoreForTag,
    bqr.TagPopularityQuintile,
    bqr.PostCreationDate,
    bqr.UserCreationDate,
    bqr.UserAgeInDays,
    bqr.PostAgeInHours,
    bqr.CalculatedAvgUserPostScore,
    bqr.PostTagsString,
    bqr.HasAcceptedAnswer,
    bqr.PostStatusCategory,
    bqr.GlobalUserRank,
    bqr.PostTypeEngagementRank,
    bqr.PreviousPostDateByUser,
    bqr.NextPostDateByUser,
    bqr.AvgAnswerScoreByUser,
    bqr.MaxQuestionEngagementByUser
FROM BaseQueryResult bqr
WHERE
    bqr.Reputation <= 500
    AND bqr.TotalPosts < 5
    AND bqr.PostScore <= 0
    AND bqr.PostTypeId IN (1, 2)
    AND (bqr.WeightedPostEngagement IS NULL OR bqr.WeightedPostEngagement < 5)
    AND (bqr.PostTagsString LIKE '%<newbie>%' OR bqr.PostTagsString LIKE '%<beginner>%') -- Hypothetical common "low-impact" tags
    AND bqr.UserPostRank = 1
    AND (
        (bqr.PostTypeName = 'Question' AND bqr.ViewCount < 100 AND bqr.AnswerCount = 0)
        OR
        (bqr.PostTypeName = 'Answer' AND bqr.PostScore < 0 AND bqr.BodyCharLength < 50)
    )
    AND (bqr.Title ILIKE '%how to basic%' OR bqr.PostCommentCount = 0)
    AND bqr.ClosedDate IS NOT NULL
ORDER BY
    bqr.Reputation ASC,
    bqr.WeightedPostEngagement ASC,
    bqr.PostCreationDate ASC
LIMIT 500;