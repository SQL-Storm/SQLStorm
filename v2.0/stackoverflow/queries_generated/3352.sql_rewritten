-- {"query": "3352.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 1854} 
WITH q_posts AS (
    SELECT
        p.Id,
        p.Title,
        p.Tags,
        p.Score,
        p.CreationDate,
        p.OwnerUserId,
        COALESCE(p.FavoriteCount,0) AS FavCnt,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.Score DESC) AS OwnerScoreRank
    FROM Posts p
    WHERE p.PostTypeId = 1                     -- only questions
),
tag_rows AS (
    SELECT
        qp.Id        AS PostId,
        qp.Title,
        qp.Score,
        qp.CreationDate,
        qp.OwnerUserId,
        qp.FavCnt,
        qp.OwnerScoreRank,
        TRIM(BOTH '<>' FROM UNNEST(string_to_array(TRIM(BOTH '<>' FROM qp.Tags), '><'))) AS Tag
    FROM q_posts qp
),
tag_agg AS (
    SELECT
        tr.Tag,
        COUNT(*)                                   AS PostsPerTag,
        AVG(tr.Score)                              AS AvgScore,
        SUM(tr.FavCnt)                             AS TotalFavorites,
        MAX(tr.Score) FILTER (WHERE tr.OwnerScoreRank = 1) AS TopOwnerScore
    FROM tag_rows tr
    GROUP BY tr.Tag
),
user_badges AS (
    SELECT
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(*) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(*) FILTER (WHERE b.Class = 3) AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
),
latest_close AS (
    SELECT DISTINCT ON (ph.PostId)
        ph.PostId,
        ph.Comment      AS CloseReason,
        ph.CreationDate AS ClosedOn
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10                -- Close events
      AND ph.Comment IS NOT NULL
    ORDER BY ph.PostId, ph.CreationDate DESC
),
final_set AS (
    SELECT
        ta.Tag,
        ta.PostsPerTag,
        ta.AvgScore,
        ta.TotalFavorites,
        ta.TopOwnerScore,
        ub.GoldBadges,
        ub.SilverBadges,
        ub.BronzeBadges,
        lc.CloseReason,
        lc.ClosedOn
    FROM tag_agg ta
    LEFT JOIN LATERAL (
        SELECT ub.*
        FROM user_badges ub
        WHERE ub.UserId = (
            SELECT tr.OwnerUserId
            FROM tag_rows tr
            WHERE tr.Tag = ta.Tag
            ORDER BY tr.Score DESC
            LIMIT 1
        )
    ) ub ON TRUE
    LEFT JOIN latest_close lc
        ON lc.PostId = (
            SELECT tr.PostId
            FROM tag_rows tr
            WHERE tr.Tag = ta.Tag
            ORDER BY tr.Score DESC
            LIMIT 1
        )
)

SELECT
    Tag,
    PostsPerTag,
    ROUND(AvgScore,2)               AS AvgScore,
    TotalFavorites,
    TopOwnerScore,
    COALESCE(GoldBadges,0)           AS GoldBadges,
    COALESCE(SilverBadges,0)         AS SilverBadges,
    COALESCE(BronzeBadges,0)         AS BronzeBadges,
    CASE
        WHEN CloseReason IS NULL THEN 'Never closed'
        ELSE CloseReason
    END                              AS CloseReason,
    ClosedOn
FROM final_set
WHERE PostsPerTag > 10
  AND (GoldBadges IS NULL OR GoldBadges = 0)
  AND COALESCE(CloseReason,'') <> ''
ORDER BY AvgScore DESC
LIMIT 100

UNION ALL

SELECT
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
WHERE FALSE;