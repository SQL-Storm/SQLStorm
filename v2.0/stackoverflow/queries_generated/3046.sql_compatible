WITH UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS RepRank,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges
    FROM Users u
),
TagScore AS (
    SELECT
        p.Id AS PostId,
        p.Tags,
        tag AS Tag,
        p.Score,
        SUM(p.Score) OVER (PARTITION BY tag
                           ORDER BY p.CreationDate 
                           ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS CumulativeTagScore,
        ROW_NUMBER() OVER (PARTITION BY tag
                           ORDER BY p.CreationDate DESC) AS TagRecencyRank
    FROM Posts p,
    LATERAL (
      SELECT UNNEST(string_to_array(substring(p.Tags,2,length(p.Tags)-2), '><')) AS tag
    ) as t
    WHERE p.PostTypeId = 1
      AND p.Tags IS NOT NULL
),
LatestHistory AS (
    SELECT
        ph.PostId,
        ph.CreationDate,
        ph.Comment,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS HistRank
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4,5,6)
)
SELECT
    us.Id                              AS UserId,
    us.DisplayName,
    us.Reputation,
    us.RepRank,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    COALESCE(p.Id, -1)                 AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    CASE
        WHEN p.ClosedDate IS NOT NULL           THEN 'Closed'
        WHEN p.CommunityOwnedDate IS NOT NULL   THEN 'Community'
        ELSE 'Open'
    END                                 AS PostState,
    COALESCE(lh.Comment, 'No recent edit')    AS LatestEditComment,
    ts.Tag,
    ts.CumulativeTagScore,
    ts.TagRecencyRank,
    CASE WHEN p.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAcceptedAnswer,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id)            AS CommentCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS UpVoteCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS DownVoteCount,
    NULLIF(p.FavoriteCount,0)               AS FavoriteCountOrNull
FROM UserStats us
LEFT JOIN Posts p          ON p.OwnerUserId = us.Id
LEFT JOIN LatestHistory lh ON lh.PostId = p.Id AND lh.HistRank = 1
LEFT JOIN TagScore ts      ON ts.PostId = p.Id
WHERE (us.Reputation > 10000 OR us.GoldBadges > 0)
  AND (p.Score IS NULL OR p.Score > 0)
  AND (p.CreationDate > DATE '2020-01-01')
UNION ALL
SELECT
    NULL::bigint            AS UserId,
    NULL::text              AS DisplayName,
    NULL::bigint            AS Reputation,
    NULL::bigint            AS RepRank,
    NULL::integer           AS GoldBadges,
    NULL::integer           AS SilverBadges,
    NULL::integer           AS BronzeBadges,
    t.WikiPostId    AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    'TagWiki'       AS PostState,
    NULL            AS LatestEditComment,
    t.TagName       AS Tag,
    NULL            AS CumulativeTagScore,
    NULL            AS TagRecencyRank,
    NULL            AS HasAcceptedAnswer,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id)            AS CommentCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS UpVoteCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS DownVoteCount,
    NULLIF(p.FavoriteCount,0)               AS FavoriteCountOrNull
FROM Tags t
JOIN Posts p ON p.Id = t.WikiPostId
WHERE t.IsModeratorOnly = false
  AND t.Count > 1000
ORDER BY RepRank NULLS LAST, CumulativeTagScore DESC NULLS LAST
LIMIT 100;