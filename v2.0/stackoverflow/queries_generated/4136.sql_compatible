WITH
  RankedAnswers AS (
    SELECT
      p.Id AS PostId,
      p.ParentId AS QuestionId,
      p.OwnerUserId,
      p.CreationDate AS AnswerCreationDate,
      p.Score AS AnswerScore,
      ROW_NUMBER() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC, p.CreationDate ASC) AS rn
    FROM
      Posts p
    WHERE
      p.PostTypeId = 2
  ),
  QuestionDetails AS (
    SELECT
      q.Id AS QuestionId,
      q.OwnerUserId AS QuestionOwnerUserId,
      q.Title AS QuestionTitle,
      q.Tags AS QuestionTags,
      q.CreationDate AS QuestionCreationDate,
      q.Score AS QuestionScore,
      q.AnswerCount AS QuestionAnswerCount,
      q.FavoriteCount AS QuestionFavoriteCount,
      q.ClosedDate AS QuestionClosedDate,
      (
        SELECT
          COUNT(ph.Id)
        FROM
          PostHistory ph
        WHERE
          ph.PostId = q.Id
          AND ph.PostHistoryTypeId IN (10, 11, 12, 13)
      ) AS PostHistoryEventCount,
      u.DisplayName AS QuestionOwnerDisplayName,
      u.Reputation AS QuestionOwnerReputation
    FROM
      Posts q
    LEFT JOIN
      Users u
      ON q.OwnerUserId = u.Id
    WHERE
      q.PostTypeId = 1
  ),
  UserActivity AS (
    SELECT
      u.Id AS UserId,
      u.DisplayName,
      u.CreationDate AS UserCreationDate,
      u.Reputation,
      u.Views AS UserViews,
      u.UpVotes AS UserUpVotes,
      u.DownVotes AS UserDownVotes,
      COUNT(DISTINCT p.Id) AS NumPosts,
      COUNT(DISTINCT c.Id) AS NumComments,
      SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS NumQuestions,
      SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS NumAnswers,
      AVG(p.Score) AS AvgPostScore,
      MAX(p.CreationDate) AS LastPostDate,
      COUNT(DISTINCT b.Id) AS NumBadges
    FROM
      Users u
    LEFT JOIN
      Posts p
      ON u.Id = p.OwnerUserId
    LEFT JOIN
      Comments c
      ON u.Id = c.UserId
    LEFT JOIN
      Badges b
      ON u.Id = b.UserId
    GROUP BY
      u.Id,
      u.DisplayName,
      u.CreationDate,
      u.Reputation,
      u.Views,
      u.UpVotes,
      u.DownVotes
  )
SELECT
  qd.QuestionId,
  qd.QuestionTitle,
  qd.QuestionCreationDate,
  qd.QuestionOwnerDisplayName,
  qd.QuestionOwnerReputation,
  qd.QuestionScore,
  qd.QuestionFavoriteCount,
  qd.QuestionAnswerCount,
  qd.QuestionClosedDate,
  qd.PostHistoryEventCount,
  ra1.OwnerUserId AS TopAnswererUserId1,
  ra1.AnswerScore AS TopAnswerScore1,
  ra1.AnswerCreationDate AS TopAnswerDate1,
  ra2.OwnerUserId AS TopAnswererUserId2,
  ra2.AnswerScore AS TopAnswerScore2,
  ua.NumPosts,
  ua.NumComments,
  ua.NumQuestions,
  ua.NumAnswers,
  ua.AvgPostScore,
  ua.NumBadges,
  CASE
    WHEN qd.QuestionScore > 100 AND qd.QuestionAnswerCount > 5 THEN 'HighEngagement'
    WHEN qd.QuestionClosedDate IS NOT NULL THEN 'Closed'
    WHEN qd.QuestionOwnerReputation < 500 THEN 'NewOwner'
    ELSE 'Standard'
  END AS QuestionCategory,
  COALESCE(qd.QuestionOwnerDisplayName, 'Community') AS DisplayNameOrCommunity,
  SUBSTRING(
    qd.QuestionTags,
    2,
    (POSITION('><' IN (qd.QuestionTags || '><')) - 2)
  ) AS FirstTag,
  CASE
    WHEN ua.UserCreationDate < qd.QuestionCreationDate THEN 'ActiveBeforeQuestion'
    WHEN ua.UserCreationDate > qd.QuestionCreationDate THEN 'ActiveAfterQuestion'
    ELSE 'SameDayActivity'
  END AS UserActivityTiming,
  ua.UserUpVotes - ua.UserDownVotes AS NetUserVotes
FROM
  QuestionDetails qd
LEFT JOIN
  RankedAnswers ra1
  ON qd.QuestionId = ra1.QuestionId
  AND ra1.rn = 1
LEFT JOIN
  RankedAnswers ra2
  ON qd.QuestionId = ra2.QuestionId
  AND ra2.rn = 2
LEFT JOIN
  UserActivity ua
  ON qd.QuestionOwnerUserId = ua.UserId
WHERE
  qd.QuestionScore > 0
  AND qd.QuestionAnswerCount BETWEEN 1 AND 10
  AND qd.QuestionFavoriteCount IS NOT NULL
  AND qd.QuestionTitle LIKE '%SQL%'
  AND (
    qd.QuestionClosedDate IS NULL
    OR qd.QuestionClosedDate > (cast('2024-10-01' as date) - INTERVAL '1 year')
  )
  AND ua.Reputation >= 1000
UNION
SELECT
  qd.QuestionId,
  qd.QuestionTitle,
  qd.QuestionCreationDate,
  qd.QuestionOwnerDisplayName,
  qd.QuestionOwnerReputation,
  qd.QuestionScore,
  qd.QuestionFavoriteCount,
  qd.QuestionAnswerCount,
  qd.QuestionClosedDate,
  qd.PostHistoryEventCount,
  ra1.OwnerUserId AS TopAnswererUserId1,
  ra1.AnswerScore AS TopAnswerScore1,
  ra1.AnswerCreationDate AS TopAnswerDate1,
  ra2.OwnerUserId AS TopAnswererUserId2,
  ra2.AnswerScore AS TopAnswerScore2,
  ua.NumPosts,
  ua.NumComments,
  ua.NumQuestions,
  ua.NumAnswers,
  ua.AvgPostScore,
  ua.NumBadges,
  CASE
    WHEN qd.QuestionScore > 100 AND qd.QuestionAnswerCount > 5 THEN 'HighEngagement'
    WHEN qd.QuestionClosedDate IS NOT NULL THEN 'Closed'
    WHEN qd.QuestionOwnerReputation < 500 THEN 'NewOwner'
    ELSE 'Standard'
  END AS QuestionCategory,
  COALESCE(qd.QuestionOwnerDisplayName, 'Community') AS DisplayNameOrCommunity,
  SUBSTRING(
    qd.QuestionTags,
    2,
    (POSITION('><' IN (qd.QuestionTags || '><')) - 2)
  ) AS FirstTag,
  CASE
    WHEN ua.UserCreationDate < qd.QuestionCreationDate THEN 'ActiveBeforeQuestion'
    WHEN ua.UserCreationDate > qd.QuestionCreationDate THEN 'ActiveAfterQuestion'
    ELSE 'SameDayActivity'
  END AS UserActivityTiming,
  ua.UserUpVotes - ua.UserDownVotes AS NetUserVotes
FROM
  QuestionDetails qd
LEFT JOIN
  RankedAnswers ra1
  ON qd.QuestionId = ra1.QuestionId
  AND ra1.rn = 1
LEFT JOIN
  RankedAnswers ra2
  ON qd.QuestionId = ra2.QuestionId
  AND ra2.rn = 2
LEFT JOIN
  UserActivity ua
  ON qd.QuestionOwnerUserId = ua.UserId
WHERE
  qd.QuestionScore < 0
  AND qd.QuestionAnswerCount > 2
  AND qd.QuestionTitle LIKE '%Performance%'
  AND qd.QuestionOwnerReputation >= 1000
  AND ua.NumBadges > 5;