WITH 
-- Basic per‑user statistics
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0)                         AS NetVotes,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)                            AS QuestionCount,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)                            AS AnswerCount,
        MAX(p.CreationDate)                                                   AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.UpVotes, u.DownVotes
),

-- Aggregate badge information per user
BadgeAgg AS (
    SELECT 
        b.UserId,
        SUM(CASE b.Class WHEN 1 THEN 5 WHEN 2 THEN 3 ELSE 1 END)            AS BadgeScore,
        STRING_AGG(DISTINCT b.Name, ',')                                    AS BadgeList,
        MAX(b.Date)                                                         AS LatestBadgeDate
    FROM Badges b
    GROUP BY b.UserId
),

-- Vote activity in the last 30 days (uses set operator for up/down votes)
RecentVotes AS (
    SELECT 
        v.UserId,
        SUM(CASE WHEN vt.Name = 'UpMod'   THEN 1 ELSE 0 END)               AS UpVotesRecent,
        SUM(CASE WHEN vt.Name = 'DownMod' THEN 1 ELSE 0 END)               AS DownVotesRecent,
        MAX(v.CreationDate)                                                AS LastVoteDate
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE v.CreationDate >= cast('2024-10-01' as date) - INTERVAL '30 days'
    GROUP BY v.UserId
),

-- Highest‑scoring question per user (window function)
TopQuestionPerUser AS (
    SELECT 
        p.OwnerUserId,
        p.Id,
        p.Title,
        p.Score,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId 
                           ORDER BY p.Score DESC NULLS LAST, p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.PostTypeId = 1
),

-- Global ranking of users (window function)
UserRanking AS (
    SELECT 
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.NetVotes,
        (us.Reputation + us.NetVotes + COALESCE(ba.BadgeScore,0))           AS CompositeScore,
        RANK() OVER (ORDER BY (us.Reputation + us.NetVotes + COALESCE(ba.BadgeScore,0)) DESC) AS GlobalRank
    FROM UserStats us
    LEFT JOIN BadgeAgg ba ON ba.UserId = us.Id
)

SELECT 
    ur.Id,
    ur.DisplayName,
    ur.Reputation,
    ur.NetVotes,
    us.QuestionCount,
    us.AnswerCount,
    us.LastPostDate,
    COALESCE(ba.BadgeScore,0)                               AS BadgeScore,
    COALESCE(ba.BadgeList,'')                               AS Badges,
    ba.LatestBadgeDate,
    COALESCE(rv.UpVotesRecent,0)                            AS UpVotesLast30d,
    COALESCE(rv.DownVotesRecent,0)                          AS DownVotesLast30d,
    COALESCE(rv.LastVoteDate, TIMESTAMP '1970-01-01')       AS LastVoteDate,
    tp.Id                                                    AS TopQuestionId,
    tp.Title                                                 AS TopQuestionTitle,
    tp.Score                                                AS TopQuestionScore,
    CASE 
        WHEN ur.Reputation > 20000 THEN 'Veteran'
        WHEN ur.Reputation BETWEEN 5000 AND 20000 THEN 'Experienced'
        ELSE 'Newbie' 
    END                                                     AS ReputationTier,
    /* Correlated sub‑query: recent comment count per user */
    (SELECT COUNT(*) 
     FROM Comments c 
     WHERE c.UserId = ur.Id 
       AND c.CreationDate >= cast('2024-10-01' as date) - INTERVAL '7 days')   AS RecentCommentCount,
    /* Extract tags from the question’s tag string (if any) */
    CASE 
        WHEN tp.Tags IS NOT NULL THEN 
            REPLACE(REPLACE(SUBSTRING(tp.Tags FROM 2 FOR CHAR_LENGTH(tp.Tags)-2), '><', ', '), '>', '')
        ELSE NULL 
    END                                                     AS TopQuestionTags,
    ur.GlobalRank,
    /* Derived column using a complex predicate */
    CASE 
        WHEN (ur.Reputation > 5000 AND us.AnswerCount > 10) 
             OR (ba.BadgeScore >= 10 AND rv.UpVotesRecent > 50) THEN 1 
        ELSE 0 
    END                                                     AS IsPowerUser
FROM UserRanking ur
JOIN UserStats us            ON us.Id = ur.Id
LEFT JOIN BadgeAgg ba       ON ba.UserId = ur.Id
LEFT JOIN RecentVotes rv    ON rv.UserId = ur.Id
LEFT JOIN TopQuestionPerUser tp 
       ON tp.OwnerUserId = ur.Id AND tp.rn = 1
WHERE ur.CompositeScore > 1000
ORDER BY ur.CompositeScore DESC
LIMIT 100
OFFSET 0;