WITH RECURSIVE RecursivePostHierarchy AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.ParentId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        0 AS Level,
        CAST(p.Id AS VARCHAR(1000)) AS Path
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.ParentId IS NULL

    UNION ALL

    SELECT 
        p.Id,
        p.PostTypeId,
        p.ParentId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        rph.Level + 1,
        rph.Path || '>' || CAST(p.Id AS VARCHAR(10))
    FROM Posts p
    INNER JOIN RecursivePostHierarchy rph ON p.ParentId = rph.Id
    WHERE rph.Level < 5
),
UserActivityStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        AVG(p.Score) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        STRING_AGG(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), ', ') AS AllTags,
        CASE WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) > 0 THEN 1 ELSE 0 END AS HasQuestions,
        CASE WHEN COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) > 0 THEN 1 ELSE 0 END AS HasAnswers
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.Reputation, u.Views, u.UpVotes, u.DownVotes
),
PostPerformanceMetrics AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.ParentId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.LastActivityDate,
        CAST(FLOOR(EXTRACT(EPOCH FROM (p.LastActivityDate - p.CreationDate)) / 86400) AS INT) AS DaysActive,
        CASE 
            WHEN p.Score > 100 THEN 'HighlyVoted'
            WHEN p.Score > 50 THEN 'ModeratelyVoted'
            WHEN p.Score > 0 THEN 'LowVoted'
            ELSE 'Unvoted'
        END AS VoteCategory,
        CASE 
            WHEN p.ViewCount > 1000 THEN 'HighTraffic'
            WHEN p.ViewCount > 500 THEN 'MediumTraffic'
            WHEN p.ViewCount > 100 THEN 'LowTraffic'
            ELSE 'MinimalTraffic'
        END AS TrafficCategory,
        COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) AS EngagementCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS UserPostRank,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) AS AvgScorePerUser,
        RANK() OVER (ORDER BY p.Score DESC) AS GlobalRank,
        PERCENT_RANK() OVER (ORDER BY p.Score) AS ScorePercentile,
        NTILE(10) OVER (ORDER BY p.ViewCount) AS ViewDecile
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) AND p.Score IS NOT NULL
),
ComplexTagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE 
            WHEN t.IsRequired = 1 THEN 'Required'
            WHEN t.IsModeratorOnly = 1 THEN 'ModeratorOnly'
            ELSE 'Standard'
        END AS TagType,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS PopularityRank,
        AVG(t.Count) OVER () AS AvgTagCount,
        LAG(t.Count, 1) OVER (ORDER BY t.Count DESC) AS PrevTagCount,
        CASE WHEN t.Count > (SELECT AVG("Count") FROM Tags) THEN 1 ELSE 0 END AS AboveAverage,
        STRING_AGG(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags)-2)), ', ' ORDER BY p.CreationDate) AS TagUsageTimeline
    FROM Tags t
    LEFT JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
    GROUP BY t.TagName, t.Count, t.ExcerptPostId, t.WikiPostId, t.IsRequired, t.IsModeratorOnly
),
ComprehensiveAnalysis AS (
    SELECT 
        uas.UserId,
        uas.Reputation,
        uas.Views,
        uas.UpVotes,
        uas.DownVotes,
        uas.PostCount,
        uas.CommentCount,
        uas.BadgeCount,
        uas.AvgPostScore,
        uas.LastPostDate,
        uas.AllTags,
        uas.HasQuestions,
        uas.HasAnswers,
        COALESCE(pmetrics.Id, 0) AS BestPostId,
        COALESCE(pmetrics.Score, 0) AS BestPostScore,
        COALESCE(pmetrics.ViewCount, 0) AS BestPostViews,
        COALESCE(pmetrics.Title, 'No Title') AS BestPostTitle,
        COALESCE(pmetrics.Tags, '') AS BestPostTags,
        COALESCE(pmetrics.VoteCategory, 'Unvoted') AS BestPostVoteCategory,
        COALESCE(pmetrics.TrafficCategory, 'MinimalTraffic') AS BestPostTrafficCategory,
        CASE 
            WHEN pmetrics.PostTypeId = 1 THEN 'Question'
            WHEN pmetrics.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS BestPostType,
        CASE 
            WHEN uas.Reputation > 10000 THEN 'Elite'
            WHEN uas.Reputation > 5000 THEN 'Veteran'
            WHEN uas.Reputation > 1000 THEN 'Experienced'
            ELSE 'Beginner'
        END AS UserTier,
        COALESCE(cta.TagName, 'No Tags') AS PopularTag,
        COALESCE(cta.Count, 0) AS PopularTagCount,
        COALESCE(cta.TagType, 'None') AS PopularTagType,
        CASE 
            WHEN uas.PostCount > 0 THEN (uas.UpVotes * 100.0) / NULLIF(uas.PostCount, 0)
            ELSE 0
        END AS UpVoteRatio,
        CASE 
            WHEN uas.PostCount > 0 THEN (uas.DownVotes * 100.0) / NULLIF(uas.PostCount, 0)
            ELSE 0
        END AS DownVoteRatio
    FROM UserActivityStats uas
    LEFT JOIN (
        SELECT *
        FROM (
            SELECT *,
                ROW_NUMBER() OVER (PARTITION BY OwnerUserId ORDER BY Score DESC) AS rn
            FROM PostPerformanceMetrics
        ) pp
        WHERE pp.rn = 1
    ) pmetrics ON uas.UserId = pmetrics.OwnerUserId
    LEFT JOIN ComplexTagAnalysis cta ON cta.PopularityRank = 1
)
SELECT 
    ca.UserId,
    ca.Reputation,
    ca.Views,
    ca.UpVotes,
    ca.DownVotes,
    ca.PostCount,
    ca.CommentCount,
    ca.BadgeCount,
    ca.AvgPostScore,
    ca.LastPostDate,
    ca.AllTags,
    ca.HasQuestions,
    ca.HasAnswers,
    ca.BestPostId,
    ca.BestPostScore,
    ca.BestPostViews,
    ca.BestPostTitle,
    ca.BestPostTags,
    ca.BestPostVoteCategory,
    ca.BestPostTrafficCategory,
    ca.BestPostType,
    ca.UserTier,
    ca.PopularTag,
    ca.PopularTagCount,
    ca.PopularTagType,
    ca.UpVoteRatio,
    ca.DownVoteRatio,
    CASE 
        WHEN ca.PostCount > 0 AND ca.CommentCount > 0 THEN 'VeryActive'
        WHEN ca.PostCount > 0 OR ca.CommentCount > 0 THEN 'Active'
        ELSE 'Inactive'
    END AS ActivityLevel,
    CASE 
        WHEN ca.BadgeCount > 5 AND ca.Reputation > 1000 THEN 'Awarded'
        WHEN ca.BadgeCount > 2 THEN 'Recognized'
        WHEN ca.Reputation > 500 THEN 'Known'
        ELSE 'New'
    END AS RecognitionStatus,
    CASE 
        WHEN ca.UserTier = 'Elite' THEN 1
        WHEN ca.UserTier = 'Veteran' THEN 2
        WHEN ca.UserTier = 'Experienced' THEN 3
        ELSE 4
    END AS TierOrder
FROM ComprehensiveAnalysis ca
WHERE ca.Reputation > 1000
  AND (ca.HasQuestions = 1 OR ca.HasAnswers = 1)
  AND (ca.PostCount > 10 OR ca.CommentCount > 20)
  AND (ca.BadgeCount > 5 OR ca.AvgPostScore > 25)
  AND ca.LastPostDate > (CAST('2024-10-01' AS DATE) + INTERVAL '-2 years')
ORDER BY ca.Reputation DESC, ca.PostCount DESC, ca.BadgeCount DESC
OFFSET 100 ROWS
FETCH NEXT 50 ROWS ONLY;