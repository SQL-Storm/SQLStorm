WITH RecentPosts AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.Title,
        p.Tags,
        p.OwnerUserId,
        p.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.CreationDate >= CAST('2024-10-01' AS date) - INTERVAL '30 days'
),
UserStats AS (
    SELECT
        u.Id                        AS UserId,
        u.DisplayName,
        COALESCE(u.Reputation,0)    AS Reputation,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1) AS GoldBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 2) AS SilverBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 3) AS BronzeBadges,
        SUM(CASE
                WHEN v.VoteTypeId = 2 THEN 1
                WHEN v.VoteTypeId = 3 THEN -1
                ELSE 0
            END)                  AS NetScore,
        MAX(p.CreationDate)        AS LastPostDate
    FROM Users u
    LEFT JOIN Badges b  ON b.UserId = u.Id
    LEFT JOIN Posts  p  ON p.OwnerUserId = u.Id
    LEFT JOIN Votes  v  ON v.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TagMetrics AS (
    SELECT
        t.TagName,
        COUNT(DISTINCT p.Id)               AS QuestionCount,
        SUM(p.Score)                       AS TotalScore,
        AVG(p.ViewCount)                   AS AvgViews,
        STRING_AGG(DISTINCT u.DisplayName, ', ') FILTER (WHERE u.Id IS NOT NULL) AS ContributingUsers
    FROM Tags t
    JOIN Posts p ON p.Tags LIKE CONCAT('%<', t.TagName, '>%')
    LEFT JOIN Users u ON u.Id = p.OwnerUserId
    WHERE p.PostTypeId = 1
    GROUP BY t.TagName
),
CloseReasonSummary AS (
    SELECT
        ph.PostId,
        COUNT(*) FILTER (WHERE ph.PostHistoryTypeId = 10) AS CloseVotes,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.Comment END) AS CloseReasonId
    FROM PostHistory ph
    GROUP BY ph.PostId
),
DuplicateGraph AS (
    SELECT
        pl.PostId        AS SrcPostId,
        pl.RelatedPostId AS DstPostId,
        lt.Name          AS LinkType,
        ROW_NUMBER() OVER (PARTITION BY pl.PostId ORDER BY pl.CreationDate DESC) AS rn
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    WHERE lt.Name = 'Duplicate'
)
SELECT
    rp.Id                             AS PostId,
    rp.Title,
    rp.CreationDate,
    COALESCE(u.DisplayName, 'Anonymous') AS OwnerName,
    u.Reputation,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.NetScore,
    CASE
        WHEN cr.CloseVotes > 0 THEN 'Closed'
        WHEN rp.PostTypeId = 2 AND rp.AcceptedAnswerId IS NOT NULL THEN 'Answered'
        ELSE 'Open'
    END                                   AS Status,
    COALESCE(tm.QuestionCount,0)          AS TagQuestionCount,
    COALESCE(tm.TotalScore,0)             AS TagTotalScore,
    COALESCE(cr.CloseReasonId, '0')       AS CloseReasonId,
    dg.DstPostId                          AS DuplicateOf,
    ROW_NUMBER() OVER (PARTITION BY rp.OwnerUserId ORDER BY rp.CreationDate DESC) AS UserPostRank,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = rp.Id AND v.VoteTypeId = 2) AS UpVoteCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = rp.Id AND v.VoteTypeId = 3) AS DownVoteCount,
    (SELECT MAX(ph.CreationDate)
        FROM PostHistory ph
        WHERE ph.PostId = rp.Id
          AND ph.PostHistoryTypeId IN (4,5,6)) AS LastEditDate,
    CASE WHEN EXISTS (
            SELECT 1 FROM PostLinks pl2
            WHERE pl2.PostId = rp.Id AND pl2.LinkTypeId = 1
        ) THEN 1 ELSE 0 END              AS HasLinkedPosts
FROM RecentPosts rp
LEFT JOIN Users u               ON u.Id = rp.OwnerUserId
LEFT JOIN UserStats us          ON us.UserId = u.Id
LEFT JOIN LATERAL (
        SELECT tm.TagName, tm.QuestionCount, tm.TotalScore, tm.AvgViews, tm.ContributingUsers
        FROM TagMetrics tm
        WHERE tm.TagName = ANY (
            SELECT TRIM(BOTH '<>' FROM unnest(string_to_array(rp.Tags, '><')))
        )
        LIMIT 1
    ) tm ON TRUE
LEFT JOIN CloseReasonSummary cr ON cr.PostId = rp.Id
LEFT JOIN DuplicateGraph dg      ON dg.SrcPostId = rp.Id AND dg.rn = 1
WHERE rp.rn <= 10
GROUP BY
    rp.Id,
    rp.Title,
    rp.CreationDate,
    u.DisplayName,
    u.Reputation,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.NetScore,
    cr.CloseVotes,
    rp.PostTypeId,
    rp.AcceptedAnswerId,
    tm.QuestionCount,
    tm.TotalScore,
    cr.CloseReasonId,
    dg.DstPostId,
    rp.OwnerUserId
ORDER BY rp.CreationDate DESC
LIMIT 100;