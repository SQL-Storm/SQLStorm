WITH
recent_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.OwnerDisplayName,
    p.LastActivityDate,
    p.CommentCount,
    p.AnswerCount,
    p.FavoriteCount,
    p.ContentLicense,
    ROW_NUMBER() OVER (ORDER BY p.CreationDate DESC) AS rn
  FROM Posts p
  WHERE p.PostTypeId = 1 -- Questions
    AND p.ClosedDate IS NULL
),
tag_stats AS (
  SELECT
    tag.TagName,
    COUNT(*) AS TagCount,
    AVG(p.Score) AS AvgScore,
    SUM(p.ViewCount) AS TotalViews
  FROM Posts p,
       -- split tags like '<tag1><tag2>' into rows
       (SELECT DISTINCT NULL) d -- placeholder for cross join style; actual splitting done below per-db
  JOIN LATERAL (
    SELECT unnest(string_to_array(substr(p.Tags, 2, length(p.Tags)-2), '><')) AS TagName
  ) AS tag ON TRUE
  GROUP BY tag.TagName
),
hot_candidates AS (
  SELECT
    rq.PostId,
    rq.Title,
    rq.Tags,
    rq.CreationDate,
    rq.ViewCount,
    rq.Score,
    rq.AnswerCount,
    rq.CommentCount,
    rq.OwnerUserId,
    rq.OwnerDisplayName,
    ROW_NUMBER() OVER (
      PARTITION BY rq.OwnerUserId
      ORDER BY rq.Score DESC, rq.ViewCount DESC, rq.CreationDate DESC
    ) AS rn_per_user
  FROM recent_questions rq
  LEFT JOIN Votes v ON v.PostId = rq.PostId
  WHERE rq.Score > 0
    AND rq.ViewCount > 100
)
SELECT
  h.PostId,
  h.Title,
  h.Tags,
  h.CreationDate,
  h.ViewCount,
  h.Score,
  h.AnswerCount,
  h.CommentCount,
  h.OwnerDisplayName,
  t.TagName,
  ts.TagCount,
  ts.AvgScore AS TagAvgScore,
  ts.TotalViews AS TagTotalViews,
  CASE
    WHEN h.Score IS NULL THEN NULL
    ELSE h.Score * 0.5 + CASE WHEN h.ViewCount > 1000 THEN 100 ELSE 0 END
  END AS composite_metric,
  (SELECT COUNT(*) FROM Posts p2 WHERE p2.OwnerUserId = h.OwnerUserId AND p2.PostTypeId = 1) AS QuestionsByOwner,
  (SELECT AVG(char_length(p3.Body)) FROM Posts p3 WHERE p3.OwnerUserId = h.OwnerUserId) AS AvgBodyLength
FROM hot_candidates h
LEFT JOIN tag_stats ts ON TRUE
LEFT JOIN LATERAL (
  SELECT unnest(string_to_array(substr(h.Tags, 2, length(h.Tags)-2), '><')) AS TagName
) AS t ON ts.TagName = t.TagName
GROUP BY
  h.PostId, h.Title, h.Tags, h.CreationDate, h.ViewCount, h.Score, h.AnswerCount,
  h.CommentCount, h.OwnerDisplayName, h.OwnerUserId,
  t.TagName, ts.TagCount, ts.AvgScore, ts.TotalViews
ORDER BY
  h.Score DESC,
  h.ViewCount DESC,
  h.CreationDate DESC
LIMIT 50;