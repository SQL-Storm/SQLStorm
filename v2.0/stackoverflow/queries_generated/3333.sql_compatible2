WITH UserPostAgg AS (
    SELECT 
        u.Id AS UserId,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
        COALESCE(SUM(p.Score), 0) AS TotalScore,
        ROUND(AVG(p.Score::numeric), 2) AS AvgScore,
        MAX(p.CreationDate) AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id
),
UserTagAgg AS (
    SELECT 
        u.Id AS UserId,
        t.TagName,
        COUNT(*) AS TagUsage
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id
    JOIN LATERAL (
        SELECT UNNEST(string_to_array(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><')) AS TagName
    ) t ON TRUE
    JOIN Tags tg ON tg.TagName = t.TagName
    GROUP BY u.Id, t.TagName
),
TopTags AS (
    SELECT 
        uta.UserId,
        STRING_AGG(uta.TagName || ':' || uta.TagUsage, ', ') AS TopTags
    FROM (
        SELECT 
            uta.*,
            ROW_NUMBER() OVER (PARTITION BY uta.UserId ORDER BY uta.TagUsage DESC, uta.TagName) AS rn
        FROM UserTagAgg uta
    ) uta
    WHERE uta.rn <= 5
    GROUP BY uta.UserId
),
UserBadgeAgg AS (
    SELECT 
        u.Id AS UserId,
        COUNT(b.Id) AS BadgeCount,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Users u
    LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY u.Id
),
RecentVotes AS (
    SELECT 
        v.PostId,
        COUNT(CASE WHEN vt.Name = 'UpMod' THEN 1 END) AS UpVotes,
        COUNT(CASE WHEN vt.Name = 'DownMod' THEN 1 END) AS DownVotes,
        MAX(v.CreationDate) AS LastVoteDate
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE v.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '30 days')
    GROUP BY v.PostId
)
SELECT 
    u.Id,
    u.DisplayName,
    COALESCE(up.QuestionCount, 0)      AS QuestionsPosted,
    COALESCE(up.AnswerCount, 0)        AS AnswersPosted,
    up.TotalScore,
    up.AvgScore,
    up.LastPostDate,
    COALESCE(bb.BadgeCount, 0)         AS TotalBadges,
    bb.GoldBadges,
    bb.SilverBadges,
    bb.BronzeBadges,
    COALESCE(tt.TopTags, '')           AS TopTags,
    rv.UpVotes,
    rv.DownVotes,
    rv.LastVoteDate,
    CASE 
        WHEN u.Location IS NULL THEN 'Unknown'
        ELSE u.Location 
    END                                AS LocationNormalized
FROM Users u
LEFT JOIN UserPostAgg up ON up.UserId = u.Id
LEFT JOIN UserBadgeAgg bb ON bb.UserId = u.Id
LEFT JOIN TopTags tt ON tt.UserId = u.Id
LEFT JOIN LATERAL (
    SELECT 
        rv.UpVotes,
        rv.DownVotes,
        rv.LastVoteDate
    FROM RecentVotes rv
    JOIN Posts p ON p.Id = rv.PostId AND p.OwnerUserId = u.Id
    ORDER BY rv.LastVoteDate DESC
    LIMIT 1
) rv ON TRUE
WHERE u.Reputation > 1000
  AND (u.CreationDate < (CAST('2024-10-01' AS date) - INTERVAL '1 year') OR u.CreationDate IS NULL)
ORDER BY up.TotalScore DESC NULLS LAST
LIMIT 100
OFFSET 0
UNION ALL
SELECT 
    CAST(NULL AS bigint),
    CAST(NULL AS text),
    CAST(NULL AS integer),
    CAST(NULL AS integer),
    CAST(NULL AS numeric),
    CAST(NULL AS numeric),
    CAST(NULL AS timestamp),
    CAST(NULL AS integer),
    CAST(NULL AS integer),
    CAST(NULL AS integer),
    CAST(NULL AS integer),
    CAST(NULL AS text),
    CAST(NULL AS integer),
    CAST(NULL AS integer),
    CAST(NULL AS timestamp),
    CAST(NULL AS text)
WHERE FALSE;