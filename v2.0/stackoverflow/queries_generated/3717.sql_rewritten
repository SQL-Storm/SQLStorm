-- {"query": "3717.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2590} 
WITH
-- Aggregate basic user statistics
user_stats AS (
    SELECT
        u.Id                                   AS user_id,
        u.DisplayName,
        COALESCE(SUM(p.Score),0)               AS total_score,
        COUNT(p.Id)                            AS post_count,
        AVG(p.Score) FILTER (WHERE p.Score IS NOT NULL) AS avg_score,
        MAX(p.CreationDate)                   AS last_post_date
    FROM Users u
    LEFT JOIN Posts p
        ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName
),

-- Count badges per user, split by class
badge_counts AS (
    SELECT
        b.UserId,
        COUNT(*) FILTER (WHERE b.Class = 1)   AS gold_badges,
        COUNT(*) FILTER (WHERE b.Class = 2)   AS silver_badges,
        COUNT(*) FILTER (WHERE b.Class = 3)   AS bronze_badges,
        COUNT(*)                              AS total_badges
    FROM Badges b
    GROUP BY b.UserId
),

-- Extract individual tags from questions and count usage per user
tag_usage AS (
    SELECT
        p.OwnerUserId                         AS user_id,
        UNNEST(string_to_array(TRIM(BOTH '<>' FROM p.Tags), '><')) AS tag,
        COUNT(*)                              AS tag_cnt
    FROM Posts p
    WHERE p.PostTypeId = 1                     -- only questions
      AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId, tag
),

-- Determine the most used tag per user (window function)
top_tag_per_user AS (
    SELECT
        t.user_id,
        t.tag,
        t.tag_cnt,
        ROW_NUMBER() OVER (PARTITION BY t.user_id ORDER BY t.tag_cnt DESC, t.tag) AS rn
    FROM tag_usage t
),

-- Recent voting activity (last 30 days)
recent_votes AS (
    SELECT
        v.UserId,
        COUNT(*) FILTER (WHERE vt.Name = 'UpMod')          AS up_votes_given,
        COUNT(*) FILTER (WHERE vt.Name = 'DownMod')        AS down_votes_given,
        COUNT(*) FILTER (WHERE vt.Name = 'AcceptedByOriginator') AS accepts_given
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    WHERE v.CreationDate >= cast('2024-10-01' as date) - INTERVAL '30 days'
    GROUP BY v.UserId
),

-- Count how many times a question has been marked as duplicate via PostLinks
duplicate_counts AS (
    SELECT
        pl.PostId                                      AS question_id,
        COUNT(*) FILTER (WHERE lt.Name = 'Duplicate') AS dup_vote_cnt
    FROM PostLinks pl
    JOIN LinkTypes lt ON lt.Id = pl.LinkTypeId
    GROUP BY pl.PostId
),

-- Assemble the final per‑user activity view, mixing all the pieces
user_activity AS (
    SELECT
        u.Id                                           AS user_id,
        COALESCE(us.DisplayName, u.DisplayName)        AS display_name,
        COALESCE(us.post_count,0)                      AS posts,
        COALESCE(bc.total_badges,0)                    AS badges,
        COALESCE(rv.up_votes_given,0)                  AS up_votes_30d,
        COALESCE(rv.down_votes_given,0)                AS down_votes_30d,
        COALESCE(rv.accepts_given,0)                   AS accepts_30d,
        COALESCE(tt.tag, '(none)')                     AS top_tag,
        COALESCE(tt.tag_cnt,0)                         AS top_tag_cnt,
        CASE
            WHEN us.last_post_date IS NULL THEN NULL
            ELSE EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - us.last_post_date)) / 3600
        END                                            AS hrs_since_last_post,
        -- Correlated sub‑query: average answer score for this user's questions
        (SELECT AVG(a.Score)::numeric
           FROM Posts q
           JOIN Posts a ON a.ParentId = q.Id
          WHERE q.OwnerUserId = u.Id
            AND q.PostTypeId = 1
            AND a.PostTypeId = 2)                     AS avg_answer_score,
        -- Left join duplicate count for the user's latest question
        dc.dup_vote_cnt                                AS recent_dup_votes
    FROM Users u
    LEFT JOIN user_stats us   ON us.user_id = u.Id
    LEFT JOIN badge_counts bc ON bc.UserId = u.Id
    LEFT JOIN recent_votes rv ON rv.UserId = u.Id
    LEFT JOIN (
        SELECT user_id, tag, tag_cnt
        FROM top_tag_per_user
        WHERE rn = 1
    ) tt ON tt.user_id = u.Id
    LEFT JOIN (
        SELECT q.OwnerUserId AS user_id, MAX(dc.dup_vote_cnt) AS dup_vote_cnt
        FROM Posts q
        LEFT JOIN duplicate_counts dc ON dc.question_id = q.Id
        WHERE q.PostTypeId = 1
        GROUP BY q.OwnerUserId
    ) dc ON dc.user_id = u.Id
)

-- Main result set: detailed per‑user rows
SELECT
    user_id,
    display_name,
    posts,
    badges,
    up_votes_30d,
    down_votes_30d,
    accepts_30d,
    top_tag,
    top_tag_cnt,
    hrs_since_last_post,
    avg_answer_score,
    recent_dup_votes
FROM user_activity
WHERE (posts > 0 OR badges > 0)
  AND (hrs_since_last_post IS NULL OR hrs_since_last_post > 24)
ORDER BY badges DESC, posts DESC, hrs_since_last_post NULLS LAST
LIMIT 100

UNION ALL

-- Summary row using set operator
SELECT
    -1                         AS user_id,
    'Overall Summary'          AS display_name,
    SUM(posts)                 AS posts,
    SUM(badges)                AS badges,
    SUM(up_votes_30d)          AS up_votes_30d,
    SUM(down_votes_30d)        AS down_votes_30d,
    SUM(accepts_30d)           AS accepts_30d,
    NULL                       AS top_tag,
    NULL                       AS top_tag_cnt,
    NULL                       AS hrs_since_last_post,
    AVG(avg_answer_score)      AS avg_answer_score,
    SUM(recent_dup_votes)      AS recent_dup_votes
FROM user_activity;