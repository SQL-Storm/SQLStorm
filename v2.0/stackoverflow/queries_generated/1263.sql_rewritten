-- {"query": "1263.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3168} 
WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.UpVotes AS TotalUpVotesGivenBySelf,
        U.DownVotes AS TotalDownVotesGivenBySelf,
        COUNT(DISTINCT P.Id) AS TotalPostsCreated,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestionsCreated,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswersCreated,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        SUM(COALESCE(P.Score, 0)) AS SumPostScores,
        AVG(COALESCE(P.Score, 0)) AS AvgPostScore,
        MAX(CASE WHEN P.PostTypeId = 1 THEN P.ViewCount ELSE 0 END) AS MaxQuestionViewCount,
        MIN(P.CreationDate) AS FirstPostDate,
        MAX(P.LastActivityDate) AS LastPostActivityDate,
        COUNT(DISTINCT B.Id) AS TotalBadges
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.UpVotes, U.DownVotes
),
PostEditDetails AS (
    SELECT
        PH.PostId,
        COUNT(DISTINCT CASE WHEN PH.PostHistoryTypeId IN (4, 5, 6) THEN PH.Id END) AS EditCount,
        MAX(PH.CreationDate) AS LastEditTimestamp,
        MIN(PH.CreationDate) AS FirstEditTimestamp,
        STRING_AGG(DISTINCT SUBSTRING(PH.Text, 1, 50), ' | ') FILTER (WHERE PH.PostHistoryTypeId = 6 AND PH.Text IS NOT NULL) AS TagChangesSummary,
        MAX(CASE WHEN PH.PostHistoryTypeId = 10 THEN 1 ELSE 0 END) AS WasClosedEver
    FROM PostHistory PH
    WHERE PH.PostHistoryTypeId IN (4, 5, 6, 10, 11, 12, 13) -- Edit, Close/Reopen/Delete/Undelete
    GROUP BY PH.PostId
),
QuestionClosureDetails AS (
    SELECT
        Q.Id AS QuestionId,
        Q.ClosedDate IS NOT NULL AS IsPermanentlyClosed,
        CR.Name AS ActualCloseReason,
        COUNT(DISTINCT V.UserId) FILTER (WHERE V.VoteTypeId = 6) AS NumberOfCloseVotesRecorded,
        AVG(EXTRACT(EPOCH FROM (V.CreationDate - Q.CreationDate)) / 3600) FILTER (WHERE V.VoteTypeId = 6) AS AvgCloseVoteLagHours
    FROM Posts Q
    LEFT JOIN (
        SELECT PostId, MAX(CreationDate) AS LastCloseDate, MAX(Comment) AS LastCloseReasonComment
        FROM PostHistory
        WHERE PostHistoryTypeId = 10 AND Comment IS NOT NULL -- Assuming Comment holds CloseReasonId directly for simplicity
        GROUP BY PostId
    ) AS LastClosePH ON Q.Id = LastClosePH.PostId
    LEFT JOIN CloseReasonTypes CR ON CR.Id = CAST(LastClosePH.LastCloseReasonComment AS SMALLINT)
    LEFT JOIN Votes V ON Q.Id = V.PostId AND V.VoteTypeId = 6 -- Close votes
    WHERE Q.PostTypeId = 1
    GROUP BY Q.Id, Q.ClosedDate, CR.Name
),
TopTagsByPostCount AS (
    SELECT
        TRIM(UNNEST(string_to_array(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2), '><'))) AS TagName,
        COUNT(P.Id) AS PostCount
    FROM Posts P
    WHERE P.PostTypeId = 1 AND P.Tags IS NOT NULL AND LENGTH(P.Tags) > 2
    GROUP BY TagName
    ORDER BY PostCount DESC
    LIMIT 100
)
SELECT
    UAS.UserId,
    UAS.DisplayName,
    UAS.Reputation,
    UAS.TotalQuestionsCreated,
    UAS.TotalAnswersCreated,
    UAS.TotalCommentsMade,
    UAS.SumPostScores,
    UAS.AvgPostScore,
    UAS.MaxQuestionViewCount,
    UAS.TotalBadges,
    P.Id AS PostId,
    P.PostTypeId,
    PT.Name AS PostTypeName,
    P.CreationDate AS PostCreationDate,
    P.LastActivityDate AS PostLastActivityDate,
    P.Score AS PostScore,
    P.ViewCount AS PostViewCount,
    P.AnswerCount AS PostAnswerCount,
    P.CommentCount AS PostCommentCount,
    P.FavoriteCount AS PostFavoriteCount,
    P.Title AS PostTitle,
    TRIM(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2)) AS FormattedTags,
    PED.EditCount,
    PED.LastEditTimestamp,
    PED.TagChangesSummary,
    GCD.IsPermanentlyClosed,
    GCD.ActualCloseReason,
    GCD.NumberOfCloseVotesRecorded,
    GCD.AvgCloseVoteLagHours,
    (SELECT COUNT(DISTINCT C.Id) FROM Comments C WHERE C.PostId = P.Id AND C.CreationDate > P.LastEditDate AND C.Score >= 3) AS RecentHighScoreComments,
    (SELECT AVG(V_inner.BountyAmount)::FLOAT FROM Votes V_inner WHERE V_inner.PostId = P.Id AND V_inner.VoteTypeId = 8) AS AvgBountyAmount,
    CASE
        WHEN P.ViewCount >= 10000 AND P.Score >= 50 THEN 'Highly Engaged'
        WHEN P.ViewCount >= 1000 AND P.Score >= 10 THEN 'Moderately Engaged'
        ELSE 'Low Engagement'
    END AS EngagementLevel,
    -- Window functions
    RANK() OVER (PARTITION BY UAS.UserId ORDER BY P.Score DESC, P.CreationDate DESC) AS PostScoreRankByUser,
    LAG(P.CreationDate) OVER (PARTITION BY UAS.UserId ORDER BY P.CreationDate) AS PreviousPostCreationDate,
    LEAD(P.CreationDate) OVER (PARTITION BY UAS.UserId ORDER BY P.CreationDate) AS NextPostCreationDate,
    AVG(P.Score) OVER (PARTITION BY UAS.UserId ORDER BY P.CreationDate ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS RollingAvgScoreLast3Posts,
    COUNT(CASE WHEN V.VoteTypeId = 2 THEN 1 END) OVER (PARTITION BY P.Id) AS TotalUpVotesOnPost,
    COALESCE(PL_Dup.DuplicateLinkCount, 0) AS NumberOfDuplicatesReferencingThis,
    (
        SELECT
            CASE
                WHEN EXISTS (SELECT 1 FROM TopTagsByPostCount TPC WHERE P.Tags LIKE '%' || TPC.TagName || '%') THEN 'PopularTag'
                ELSE 'NicheTag'
            END
    ) AS TagPopularityStatus,
    EXTRACT(EPOCH FROM (P.CreationDate - UAS.FirstPostDate)) AS TimeSinceUserFirstPostSeconds,
    EXTRACT(EPOCH FROM (P.LastActivityDate - P.CreationDate)) AS PostAgeWithActivitySeconds
FROM UserActivitySummary UAS
INNER JOIN Posts P ON UAS.UserId = P.OwnerUserId
INNER JOIN PostTypes PT ON P.PostTypeId = PT.Id
LEFT JOIN PostEditDetails PED ON P.Id = PED.PostId
LEFT JOIN QuestionClosureDetails GCD ON P.Id = GCD.QuestionId
LEFT JOIN Votes V ON P.Id = V.PostId -- Used for TotalUpVotesOnPost window function
LEFT JOIN (SELECT RelatedPostId, COUNT(*) AS DuplicateLinkCount FROM PostLinks WHERE LinkTypeId = 3 GROUP BY RelatedPostId) PL_Dup ON P.Id = PL_Dup.RelatedPostId
WHERE
    UAS.Reputation >= 10000 -- Filter for higher reputation users
    AND P.PostTypeId IN (1, 2) -- Only Questions and Answers
    AND P.CreationDate BETWEEN '2022-01-01' AND '2023-12-31'
    AND P.ViewCount > (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = P.PostTypeId AND CreationDate BETWEEN '2022-01-01' AND '2023-12-31') * 0.5 -- Post view count above 50% of average for its type in the period
    AND (
        P.Body LIKE '%performance%' OR P.Body LIKE '%optimization%' OR P.Body LIKE '%scalability%'
        OR (P.Title IS NOT NULL AND P.Title ILIKE '%index%' AND P.Score > 5)
    )
    AND (P.AcceptedAnswerId IS NOT NULL OR P.AnswerCount > 0 OR P.ClosedDate IS NOT NULL) -- Must have an answer or be closed
    AND NOT EXISTS (
        SELECT 1
        FROM Comments C_corr
        WHERE C_corr.PostId = P.Id
        AND C_corr.Text ILIKE '%spam%'
        AND C_corr.CreationDate > P.CreationDate
    )
-- UNION ALL to add another complex segment for high impact answers from very reputable users
UNION ALL
SELECT
    U.Id AS UserId,
    U.DisplayName,
    U.Reputation,
    NULL::BIGINT AS TotalQuestionsCreated,
    NULL::BIGINT AS TotalAnswersCreated,
    NULL::BIGINT AS TotalCommentsMade,
    P.Score AS SumPostScores,
    P.Score AS AvgPostScore,
    P.ViewCount AS MaxQuestionViewCount,
    (SELECT COUNT(B_sub.Id) FROM Badges B_sub WHERE B_sub.UserId = U.Id) AS TotalBadges,
    P.Id AS PostId,
    P.PostTypeId,
    PT.Name AS PostTypeName,
    P.CreationDate AS PostCreationDate,
    P.LastActivityDate AS PostLastActivityDate,
    P.Score AS PostScore,
    P.ViewCount AS PostViewCount,
    P.AnswerCount AS PostAnswerCount,
    P.CommentCount AS PostCommentCount,
    P.FavoriteCount AS PostFavoriteCount,
    P.Title AS PostTitle,
    TRIM(SUBSTRING(P.Tags, 2, LENGTH(P.Tags) - 2)) AS FormattedTags,
    NULL::BIGINT AS EditCount,
    NULL::TIMESTAMP AS LastEditTimestamp,
    NULL::VARCHAR(400) AS TagChangesSummary,
    (P.ClosedDate IS NOT NULL)::BOOLEAN AS IsPermanentlyClosed,
    NULL::VARCHAR(50) AS ActualCloseReason,
    NULL::BIGINT AS NumberOfCloseVotesRecorded,
    NULL::FLOAT AS AvgCloseVoteLagHours,
    (SELECT COUNT(C_corr.Id) FROM Comments C_corr WHERE C_corr.PostId = P.Id AND C_corr.Score >= 5) AS RecentHighScoreComments,
    (SELECT MAX(V_inner.BountyAmount)::FLOAT FROM Votes V_inner WHERE V_inner.PostId = P.Id AND V_inner.VoteTypeId = 8) AS AvgBountyAmount,
    'High Impact Answer' AS EngagementLevel,
    ROW_NUMBER() OVER (PARTITION BY U.Id ORDER BY P.Score DESC, P.CreationDate DESC) AS PostScoreRankByUser,
    LAG(P.CreationDate) OVER (PARTITION BY U.Id ORDER BY P.CreationDate) AS PreviousPostCreationDate,
    LEAD(P.CreationDate) OVER (PARTITION BY U.Id ORDER BY P.CreationDate) AS NextPostCreationDate,
    NULL::FLOAT AS RollingAvgScoreLast3Posts,
    COUNT(CASE WHEN V.VoteTypeId = 2 THEN 1 END) OVER (PARTITION BY P.Id) AS TotalUpVotesOnPost,
    COALESCE(PL_Linked.LinkedPostCount, 0) AS NumberOfDuplicatesReferencingThis, -- Re-purposing column for linked posts here
    'FeaturedTag' AS TagPopularityStatus,
    EXTRACT(EPOCH FROM (P.CreationDate - U.CreationDate)) AS TimeSinceUserFirstPostSeconds,
    EXTRACT(EPOCH FROM (P.LastActivityDate - P.CreationDate)) AS PostAgeWithActivitySeconds
FROM Users U
INNER JOIN Posts P ON U.Id = P.OwnerUserId
INNER JOIN PostTypes PT ON P.PostTypeId = PT.Id
LEFT JOIN Votes V ON P.Id = V.PostId
LEFT JOIN (SELECT PostId, COUNT(*) AS LinkedPostCount FROM PostLinks WHERE LinkTypeId = 1 GROUP BY PostId) PL_Linked ON P.Id = PL_Linked.PostId
WHERE
    P.PostTypeId = 2 -- Only Answers for this segment
    AND P.Score > 100 -- Highly upvoted answers
    AND P.CreationDate BETWEEN '2021-01-01' AND '2021-12-31'
    AND P.ParentId IS NOT NULL -- Must be an answer to a question
    AND U.Reputation > 50000 -- Very high reputation users
    AND P.Body ILIKE '%example%' AND P.Body ILIKE '%solution%'
    AND NOT EXISTS (SELECT 1 FROM Badges B_corr WHERE B_corr.UserId = U.Id AND B_corr.Name ILIKE '%critic%')
ORDER BY
    Reputation DESC, PostCreationDate DESC
LIMIT 1000;