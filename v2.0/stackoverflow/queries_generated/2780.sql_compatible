with RecursiveTagCounts as (
    select
        t.Id as TagId,
        t.TagName,
        t.Count,
        p.Id as PostId,
        p.CreationDate,
        array_length(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><'), 1) as TagCountPerPost
    from Tags t
    left join Posts p on p.PostTypeId = 1 and p.Tags like '%' || concat('<', t.TagName, '>') || '%'
    where t.IsRequired = false
),
UserBadgeStats as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(distinct b.Id) filter(where b.Class = 1) as GoldBadges,
        count(distinct b.Id) filter(where b.Class = 2) as SilverBadges,
        count(distinct b.Id) filter(where b.Class = 3) as BronzeBadges,
        coalesce(sum(case when b.TagBased = 1 then 1 else 0 end), 0) as TagBasedBadges,
        min(b.Date) as FirstBadgeDate
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName
),
PostVotesAgg as (
    select
        p.Id as PostId,
        p.PostTypeId,
        p.OwnerUserId,
        count(v.Id) filter(where v.VoteTypeId = 2) as UpVotes,
        count(v.Id) filter(where v.VoteTypeId = 3) as DownVotes,
        count(v.Id) filter(where v.VoteTypeId = 5) as FavoriteVotes,
        max(v.CreationDate) as LastVoteDate
    from Posts p
    left join Votes v on v.PostId = p.Id
    group by p.Id, p.PostTypeId, p.OwnerUserId
),
ClosedQuestions as (
    select
        ph.PostId,
        ph.CreationDate as CloseDate,
        crt.Name as CloseReason,
        ph.UserId as ClosedByUserId
    from PostHistory ph
    inner join PostHistoryTypes pht on pht.Id = ph.PostHistoryTypeId and pht.Name = 'Post Closed'
    left join CloseReasonTypes crt on crt.Id = cast(ph.Comment as integer)
),
QuestionAnswerStats as (
    select
        q.Id as QuestionId,
        q.Title,
        q.OwnerUserId,
        q.CreationDate,
        q.Score as QuestionScore,
        count(a.Id) as AnswerCount,
        sum(case when a.Score >= 0 then 1 else 0 end) filter (where a.Id is not null) as PositiveAnswers,
        max(a.Score) filter (where a.Id is not null) as MaxAnswerScore,
        avg(a.Score) filter (where a.Id is not null) as AvgAnswerScore,
        max(a.CreationDate) filter (where a.Id is not null) as LastAnswerDate,
        case when q.AcceptedAnswerId is not null then 1 else 0 end as HasAcceptedAnswer,
        q.Tags
    from Posts q
    left join Posts a on a.ParentId = q.Id and a.PostTypeId = 2
    where q.PostTypeId = 1
    group by q.Id, q.Title, q.OwnerUserId, q.CreationDate, q.Score, q.AcceptedAnswerId, q.Tags
),
AnswerRanks as (
    select
        a.Id as AnswerId,
        a.ParentId as QuestionId,
        a.OwnerUserId,
        a.Score,
        rank() over (partition by a.ParentId order by a.Score desc, a.CreationDate asc) as AnswerRank
    from Posts a
    where a.PostTypeId = 2
),
UserActivityWindow as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionsAsked,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswersPosted,
        count(c.Id) as CommentsMade,
        row_number() over (order by u.Reputation desc) as ReputationRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate
),
FinalSelection as (
    select
        q.QuestionId,
        q.Title,
        q.Tags,
        q.CreationDate as QuestionDate,
        q.Score as QuestionScore,
        q.AnswerCount,
        q.PositiveAnswers,
        q.MaxAnswerScore,
        q.HasAcceptedAnswer,
        q.AvgAnswerScore,
        q.LastAnswerDate,
        ua.DisplayName as QuestionOwner,
        ua.Reputation as OwnerReputation,
        bstats.GoldBadges,
        bstats.SilverBadges,
        bstats.BronzeBadges,
        bstats.TagBasedBadges,
        cq.CloseDate,
        cq.CloseReason,
        (select count(1) from PostLinks pl where pl.PostId = q.QuestionId and pl.LinkTypeId = 3) as DuplicateLinksCount,
        (select string_agg(distinct lt.Name, ', ') from PostLinks pl 
            inner join LinkTypes lt on lt.Id = pl.LinkTypeId 
            where pl.PostId = q.QuestionId) as LinkTypesOnQuestion,
        rank() over (order by q.Score desc nulls last, q.AnswerCount desc nulls last) as QuestionRank
    from QuestionAnswerStats q
    left join Users ua on ua.Id = q.OwnerUserId
    left join UserBadgeStats bstats on bstats.UserId = q.OwnerUserId
    left join ClosedQuestions cq on cq.PostId = q.QuestionId
    where q.AnswerCount > 0
      and q.QuestionScore >= 0
      and (cq.CloseDate is null or cq.CloseDate > q.CreationDate + interval '30 days')
)

select
    fs.QuestionRank,
    fs.QuestionId,
    fs.Title,
    fs.QuestionDate,
    fs.QuestionScore,
    fs.AnswerCount,
    fs.PositiveAnswers,
    fs.MaxAnswerScore,
    fs.HasAcceptedAnswer,
    round(cast(fs.AvgAnswerScore as numeric),2) as AvgAnswerScore,
    fs.LastAnswerDate,
    fs.QuestionOwner,
    fs.OwnerReputation,
    fs.GoldBadges,
    fs.SilverBadges,
    fs.BronzeBadges,
    fs.TagBasedBadges,
    fs.CloseDate,
    coalesce(fs.CloseReason, 'Open') as CloseReason,
    fs.DuplicateLinksCount,
    coalesce(fs.LinkTypesOnQuestion, 'None') as LinkTypesOnQuestion,
    round(
        (
        fs.QuestionScore * 0.5 +
        coalesce(fs.AnswerCount, 0) * 1.2 +
        coalesce(fs.PositiveAnswers, 0) * 1.5 +
        coalesce(fs.GoldBadges, 0) * 2.0 +
        coalesce(fs.OwnerReputation, 0) / 1000.0 -
        coalesce(floor(extract(epoch from (timestamp '2024-10-01 12:34:56' - fs.QuestionDate)) / 86400), 0) * 0.1
        )
        /
        nullif((coalesce(fs.AnswerCount, 0) + coalesce(fs.PositiveAnswers, 0) + 1), 0)
    , 3) as EngagementIndex
from FinalSelection fs
where fs.QuestionDate > (timestamp '2024-10-01 12:34:56' - interval '1 year')
order by fs.QuestionRank
limit 50;