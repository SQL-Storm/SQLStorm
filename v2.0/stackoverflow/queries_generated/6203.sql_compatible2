WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        U.DisplayName,
        U.Reputation,
        P.OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    GROUP BY 
        U.Id
)
SELECT 
    R.Id,
    R.Title,
    R.Score,
    R.ViewCount,
    R.CreationDate,
    R.DisplayName,
    R.Reputation,
    R.rank,
    B.BadgeCount,
    SUM(V.BountyAmount) AS TotalBounty,
    MAX(CASE WHEN PH.PostHistoryTypeId = 10 THEN PH.Comment END) AS CloseReason,
    (
        SELECT 
            STRING_AGG(T.TagName, ', ')
        FROM 
            Tags T
        WHERE 
            T.Id IN (
                SELECT CAST(value AS INTEGER) 
                FROM (
                    SELECT UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<>' FROM P.Tags), '><')) AS value
                ) AS t
            )
    ) AS Tags
FROM 
    RankedPosts R
LEFT JOIN 
    BadgeCounts B ON R.OwnerUserId = B.UserId
LEFT JOIN 
    Votes V ON R.Id = V.PostId AND V.VoteTypeId = 8
LEFT JOIN 
    PostHistory PH ON R.Id = PH.PostId AND PH.PostHistoryTypeId = 10
JOIN
    Posts P ON P.Id = R.Id
WHERE 
    R.rank <= 10
GROUP BY
    R.Id,
    R.Title,
    R.Score,
    R.ViewCount,
    R.CreationDate,
    R.DisplayName,
    R.Reputation,
    R.rank,
    B.BadgeCount,
    P.Tags,
    R.OwnerUserId
ORDER BY 
    R.Score DESC, 
    R.ViewCount DESC;