WITH UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(p.QCount, 0)               AS QuestionCount,
        COALESCE(p.ACount, 0)               AS AnswerCount,
        COALESCE(b.GoldCnt, 0)              AS GoldBadgeCount,
        COALESCE(b.SilverCnt, 0)            AS SilverBadgeCount,
        COALESCE(b.BronzeCnt, 0)            AS BronzeBadgeCount,
        COALESCE(v.UpVotes, 0) - COALESCE(v.DownVotes, 0) AS NetVoteScore,
        MAX(p.LastActivityDate) OVER (PARTITION BY u.Id) AS LastActivityDate,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY ph.CreationDate DESC) AS RecentHistoryRN
    FROM Users u
    LEFT JOIN (
        SELECT
            OwnerUserId,
            SUM(CASE WHEN PostTypeId = 1 THEN 1 ELSE 0 END) AS QCount,
            SUM(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END) AS ACount,
            MAX(LastActivityDate)                               AS LastActivityDate
        FROM Posts
        GROUP BY OwnerUserId
    ) p ON p.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT
            UserId,
            SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldCnt,
            SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverCnt,
            SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeCnt
        FROM Badges
        GROUP BY UserId
    ) b ON b.UserId = u.Id
    LEFT JOIN (
        SELECT
            p.OwnerUserId AS UserId,
            SUM(CASE WHEN vt.Id = 2 THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN vt.Id = 3 THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
        JOIN Posts p ON p.Id = v.PostId
        GROUP BY p.OwnerUserId
    ) v ON v.UserId = u.Id
    LEFT JOIN PostHistory ph ON ph.UserId = u.Id
),
TagUsage AS (
    SELECT
        u.Id                                    AS UserId,
        LOWER(TRIM(tag))                        AS Tag,
        COUNT(*)                                AS TagCount
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    CROSS JOIN LATERAL (
        SELECT regexp_split_to_table(
            REPLACE(REPLACE(p.Tags, '><', ','), '<', ''), ','
        ) AS tag
    ) s
    WHERE LENGTH(s.tag) > 0
    GROUP BY u.Id, LOWER(TRIM(s.tag))
),
TopUserTags AS (
    SELECT
        tu.UserId,
        tu.Tag,
        tu.TagCount,
        ROW_NUMBER() OVER (PARTITION BY tu.UserId ORDER BY tu.TagCount DESC, tu.Tag) AS rn
    FROM TagUsage tu
),
RecentClosedPosts AS (
    SELECT
        p.OwnerUserId                           AS UserId,
        p.Id                                    AS PostId,
        p.Title,
        ph.CreationDate                         AS ClosedDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY ph.CreationDate DESC) AS rn
    FROM Posts p
    JOIN PostHistory ph ON ph.PostId = p.Id
    WHERE ph.PostHistoryTypeId = 10
),
Combined AS (
    SELECT
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.QuestionCount,
        us.AnswerCount,
        us.GoldBadgeCount,
        us.SilverBadgeCount,
        us.BronzeBadgeCount,
        us.NetVoteScore,
        us.LastActivityDate,
        tu.Tag          AS TopTag,
        tu.TagCount     AS TopTagCount,
        rc.Title        AS LastClosedTitle,
        rc.ClosedDate
    FROM UserStats us
    LEFT JOIN TopUserTags tu  ON tu.UserId = us.Id AND tu.rn = 1
    LEFT JOIN RecentClosedPosts rc ON rc.UserId = us.Id AND rc.rn = 1
)

SELECT *
FROM Combined
WHERE Reputation > 1000
  AND (QuestionCount + AnswerCount) > 50
  AND (GoldBadgeCount + SilverBadgeCount + BronzeBadgeCount) >= 10
  AND NetVoteScore IS NOT NULL
ORDER BY Reputation DESC, NetVoteScore DESC
OFFSET 0 ROWS FETCH NEXT 100 ROWS ONLY

UNION ALL

SELECT
    CAST(NULL AS BIGINT)      AS Id,
    CAST(NULL AS VARCHAR)     AS DisplayName,
    CAST(NULL AS INTEGER)     AS Reputation,
    CAST(NULL AS INTEGER)     AS QuestionCount,
    CAST(NULL AS INTEGER)     AS AnswerCount,
    CAST(NULL AS INTEGER)     AS GoldBadgeCount,
    CAST(NULL AS INTEGER)     AS SilverBadgeCount,
    CAST(NULL AS INTEGER)     AS BronzeBadgeCount,
    CAST(NULL AS INTEGER)     AS NetVoteScore,
    CAST(NULL AS TIMESTAMP)   AS LastActivityDate,
    CAST(NULL AS VARCHAR)     AS TopTag,
    CAST(NULL AS INTEGER)     AS TopTagCount,
    CAST(NULL AS VARCHAR)     AS LastClosedTitle,
    CAST(NULL AS TIMESTAMP)   AS ClosedDate

EXCEPT

SELECT *
FROM Combined
WHERE Reputation < 0

INTERSECT

SELECT *
FROM Combined
WHERE LOWER(DisplayName) LIKE '%admin%';