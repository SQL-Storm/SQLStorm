SELECT 
    u.Id,
    u.DisplayName, 
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.Reputation) AS MaxReputation,
    MIN(u.CreationDate) AS EarliestJoinDate,
    -- use standard aggregation to get recent badges as a concatenated string ordered by date
    STRING_AGG(DISTINCT b.Name, ', ' ORDER BY b.Date DESC) AS RecentBadges,
    MAX(ph.RevisionGUID) AS LastRevisionGUID
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
WHERE 
    u.Id IN (
        SELECT 
            UserId 
        FROM 
            Votes 
        WHERE 
            VoteTypeId = 1 
            AND CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '12 months')
        GROUP BY 
            UserId 
        HAVING 
            COUNT(Id) > 100
    )
AND 
    p.PostTypeId IN (1, 2)
GROUP BY 
    u.Id,
    u.DisplayName
HAVING 
    AVG(p.Score) > 10
ORDER BY 
    TotalPosts DESC, 
    MaxReputation DESC;