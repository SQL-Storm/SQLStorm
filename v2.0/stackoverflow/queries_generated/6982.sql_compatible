SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class AS BadgeClass,
    t.TagName,
    ph.RevisionGUID,
    ph.LastRevisionDate AS LastRevisionDate,
    ph.Comment,
    v.VoteTypeId,
    AVG(v.BountyAmount) AS AvgBounty
FROM 
    Users u
LEFT JOIN (
    SELECT 
        ph_inner.PostId,
        ph_inner.RevisionGUID,
        ph_inner.CreationDate AS LastRevisionDate,
        ph_inner.Comment,
        ph_inner.UserId
    FROM 
        PostHistory ph_inner
    WHERE 
        ph_inner.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 13, 14, 15, 19, 20, 35)
) ph ON u.Id = ph.UserId
RIGHT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Tags t ON t.ExcerptPostId = p.Id
LEFT JOIN 
    Votes v ON p.Id = v.PostId
WHERE 
    u.Reputation > 10000
    AND p.Score > 100
    AND (p.PostTypeId = 1 OR p.PostTypeId = 2)
GROUP BY 
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    b.Class,
    t.TagName,
    ph.RevisionGUID,
    ph.LastRevisionDate,
    ph.Comment,
    v.VoteTypeId,
    p.Score
HAVING 
    COUNT(DISTINCT CASE WHEN t.TagName IS NOT NULL THEN t.Id END) > 5
    AND MAX(ph.LastRevisionDate) > (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1' YEAR)
ORDER BY 
    u.Reputation DESC,
    p.Score DESC;