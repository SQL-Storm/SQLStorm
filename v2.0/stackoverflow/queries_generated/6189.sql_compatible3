WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        U.DisplayName,
        U.Reputation,
        P.OwnerUserId,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank,
        P.Tags
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    GROUP BY 
        U.Id
)
SELECT 
    RP.Id,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.DisplayName,
    RP.Reputation,
    COALESCE(BC.BadgeCount, 0) AS BadgeCount,
    CASE 
        WHEN RP.rank <= 10 THEN 'Top'
        WHEN RP.rank <= 100 THEN 'High'
        ELSE 'Low'
    END AS RankTier,
    (
        SELECT 
            STRING_AGG(T.TagName, ', ')
        FROM 
            Tags T
        JOIN (
            SELECT
                CAST(TRIM(BOTH '<' FROM TRIM(BOTH '>' FROM token)) AS VARCHAR(255)) AS tag_token
            FROM (
                SELECT
                    CASE WHEN RP.Tags IS NULL OR RP.Tags = '' THEN NULL ELSE RP.Tags END AS tags_full
            ) tags_source
            CROSS JOIN LATERAL (
                SELECT token FROM (
                    WITH RECURSIVE splitter(start_pos, rest, token) AS (
                        SELECT 1, tags_source.tags_full,
                               NULL
                        UNION ALL
                        SELECT
                            -- compute next start_pos, rest, and token using standard SQL functions
                            CASE
                                WHEN POSITION('><' IN rest) = 0 THEN CHAR_LENGTH(rest) + 1
                                ELSE POSITION('><' IN rest) + 1
                            END,
                            CASE
                                WHEN POSITION('><' IN rest) = 0 THEN ''
                                ELSE SUBSTRING(rest FROM POSITION('><' IN rest) + 2)
                            END,
                            CASE
                                WHEN rest LIKE '<%>' THEN
                                    SUBSTRING(rest FROM 2 FOR CHAR_LENGTH(rest) - 2)
                                WHEN POSITION('><' IN rest) = 0 THEN
                                    NULL
                                ELSE
                                    SUBSTRING(rest FROM 2 FOR POSITION('><' IN rest) - 2)
                            END
                        FROM splitter
                        WHERE rest IS NOT NULL AND rest <> ''
                    )
                    SELECT token FROM splitter WHERE token IS NOT NULL
                ) s_tokens
            ) split_tokens(token)
        ) tag_tokens ON TRUE
        JOIN Tags T ON CAST(tag_tokens.tag_token AS INTEGER) = T.Id
    ) AS Tags
FROM 
    RankedPosts RP
LEFT JOIN 
    BadgeCounts BC ON RP.OwnerUserId = BC.UserId
GROUP BY
    RP.Id,
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.DisplayName,
    RP.Reputation,
    RP.rank,
    RP.Tags,
    RP.OwnerUserId,
    BC.BadgeCount
ORDER BY 
    RP.Score DESC, RP.ViewCount DESC
LIMIT 100;