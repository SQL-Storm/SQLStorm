SELECT 
    u.Id,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 1 THEN COALESCE(p.AnswerCount,0) ELSE 0 END) AS TotalAnswers,
    SUM(CASE WHEN p.PostTypeId = 1 THEN COALESCE(p.Score,0) ELSE 0 END) AS TotalScore,
    MAX(p.LastActivityDate) AS LastActivePost,
    MAX(CASE WHEN p.PostTypeId = 1 THEN p.LastEditDate ELSE NULL END) AS LastEditedQuestion,
    MIN(p.CreationDate) AS FirstPost,
    MAX(p.CreationDate) AS LastPost,
    b.Id AS BadgeId,
    b.Name AS BadgeName,
    b.Class AS BadgeClass,
    pl.LinkType,
    v.VoteType,
    COUNT(DISTINCT CASE WHEN pl.LinkType = 'Duplicate' OR pl.LinkTypeId = 3 THEN pl.RelatedPostId ELSE NULL END) FILTER (WHERE pl.RelatedPostId IS NOT NULL) AS DuplicateLinks,
    COUNT(DISTINCT CASE WHEN pl.LinkType = 'Linked' OR pl.LinkTypeId = 1 THEN pl.RelatedPostId ELSE NULL END) FILTER (WHERE pl.RelatedPostId IS NOT NULL) AS LinkedPosts,
    COUNT(DISTINCT CASE WHEN pl.LinkType = 'Linked' OR pl.LinkTypeId = 1 THEN pl.PostId ELSE NULL END) FILTER (WHERE pl.PostId IS NOT NULL) AS LinkedToPosts,
    COUNT(DISTINCT CASE WHEN pl.LinkType = 'Duplicate' OR pl.LinkTypeId = 3 THEN pl.PostId ELSE NULL END) FILTER (WHERE pl.PostId IS NOT NULL) AS DuplicateOfPosts
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    (SELECT 
        pl.PostId,
        pl.RelatedPostId,
        pl.LinkTypeId,
        lt.Name AS LinkType
     FROM 
        PostLinks pl
     JOIN 
        LinkTypes lt ON pl.LinkTypeId = lt.Id) pl ON u.Id = pl.PostId
LEFT JOIN 
    (SELECT 
        pv.Id,
        pv.PostId, 
        pv.UserId,
        pv.VoteTypeId,
        vt.Name AS VoteType,
        pv.BountyAmount
     FROM 
        Votes pv
     JOIN 
        VoteTypes vt ON pv.VoteTypeId = vt.Id) v ON u.Id = v.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
WHERE 
    (u.Reputation > 1000 OR u.Reputation IS NULL)
    AND (p.Score > 0 OR p.PostTypeId = 6 OR p.Id IS NULL)
GROUP BY 
    u.Id, u.DisplayName, u.Reputation,
    b.Id, b.Name, b.Class,
    pl.LinkType, pl.LinkTypeId,
    v.VoteType,
    v.UserId
HAVING 
    COUNT(DISTINCT p.Id) > 5
ORDER BY 
    TotalScore DESC, 
    TotalPosts DESC;