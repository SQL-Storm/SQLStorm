WITH UserEngagement AS (
    SELECT
        U.Id AS UserId,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate AS UserLastAccessDate,
        COUNT(DISTINCT P.Id) AS TotalPostsOwned,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestionsOwned,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswersOwned,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        MAX(GREATEST(COALESCE(P.LastActivityDate, TIMESTAMP '1900-01-01 00:00:00'), COALESCE(C.CreationDate, TIMESTAMP '1900-01-01 00:00:00'), U.LastAccessDate)) AS LatestActivityDate,
        SUM(COALESCE(P.Score, 0)) AS TotalPostScoreOwned,
        SUM(CASE WHEN P.PostTypeId = 1 THEN COALESCE(P.ViewCount, 0) ELSE 0 END) AS TotalQuestionViewCount,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        COUNT(DISTINCT CASE WHEN B.Class = 1 THEN B.Id END) AS GoldBadges,
        RANK() OVER (ORDER BY U.Reputation DESC, U.CreationDate ASC) AS ReputationRank,
        U.Reputation
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.CreationDate, U.LastAccessDate, U.Reputation
),
PostExtendedDetails AS (
    SELECT
        PQ.Id AS PostId,
        PQ.PostTypeId,
        PQ.CreationDate AS PostCreationDate,
        PQ.Score AS PostScore,
        PQ.ViewCount AS PostViewCount,
        PQ.OwnerUserId,
        PQ.AcceptedAnswerId,
        PQ.ParentId,
        PQ.LastEditDate,
        PQ.LastActivityDate,
        PQ.Title,
        PQ.Tags,
        PQ.AnswerCount,
        PQ.CommentCount,
        PQ.FavoriteCount,
        LENGTH(COALESCE(PQ.Body, '')) AS BodyLength,
        CASE WHEN PQ.AcceptedAnswerId IS NOT NULL THEN TRUE ELSE FALSE END AS HasAcceptedAnswer,
        (SELECT COUNT(V.Id) FROM Votes V WHERE V.PostId = PQ.Id AND V.VoteTypeId IN (2,3)) AS UpDownVoteCount,
        (SELECT MAX(PH.CreationDate) FROM PostHistory PH WHERE PH.PostId = PQ.Id AND PH.PostHistoryTypeId IN (4,5,6,8,9)) AS LastContentEditDate,
        CASE
            WHEN PQ.ClosedDate IS NOT NULL THEN 'Closed'
            WHEN PQ.CommunityOwnedDate IS NOT NULL THEN 'CommunityOwned'
            WHEN PQ.LastActivityDate IS NOT NULL AND PQ.LastActivityDate > (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '60 days') THEN 'Active'
            ELSE 'Dormant'
        END AS PostStatusCategory,
        (CASE 
            WHEN COALESCE(PQ.Tags, '') <> '' THEN
              (regexp_split_to_array(TRIM(BOTH '<>' FROM COALESCE(PQ.Tags, '')), '><'))[1]
            ELSE NULL
         END) AS FirstTagName,
        PQ.Tags,
        PQ.Body
    FROM Posts PQ
    WHERE PQ.PostTypeId IN (1, 2)
),
TagPerformance AS (
    SELECT
        Tag.tag AS TagName,
        COUNT(DISTINCT PED.PostId) AS TaggedQuestionCount,
        AVG(PED.PostScore) AS AvgScoreForTag,
        MAX(PED.PostViewCount) AS MaxViewCountForTag,
        MIN(PED.PostCreationDate) AS FirstTagUseDate,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT PED.PostId) DESC) AS GlobalTagRank
    FROM PostExtendedDetails PED,
         LATERAL regexp_split_to_table(TRIM(BOTH '<>' FROM COALESCE(PED.Tags, '')), '><') AS Tag(tag)
    WHERE PED.PostTypeId = 1 AND COALESCE(PED.Tags, '') <> '' AND TRIM(Tag.tag) <> ''
    GROUP BY Tag.tag
)
SELECT
    U.Id AS UserId,
    U.DisplayName,
    U.Reputation,
    U.CreationDate,
    U.Location,
    U.WebsiteUrl,
    UE.TotalQuestionsOwned,
    UE.TotalAnswersOwned,
    UE.TotalCommentsMade,
    UE.LatestActivityDate,
    UE.GoldBadges,
    UE.ReputationRank,
    PED.PostId,
    PT.Name AS PostTypeName,
    PED.PostCreationDate,
    PED.PostScore,
    PED.PostViewCount,
    PED.Title AS PostTitle,
    PED.HasAcceptedAnswer,
    PED.UpDownVoteCount,
    PED.BodyLength,
    PED.PostStatusCategory,
    TP.TagName AS PrimaryTagForPost,
    TP.TaggedQuestionCount AS PrimaryTagTotalQuestions,
    TP.AvgScoreForTag AS PrimaryTagAvgQuestionScore,
    TP.GlobalTagRank,
    COALESCE(U_Owner.DisplayName, 'Community User') AS PostOwnerDisplayName,
    COALESCE(U_LastEditor.DisplayName, P_Full.LastEditorDisplayName, 'Unknown Editor') AS LastEditorDisplayName,
    (PED.PostScore * (1.0 + (COALESCE(PED.UpDownVoteCount, 0) / GREATEST(1.0, COALESCE(PED.PostViewCount, 0))))) AS WeightedPostScore,
    DATE_PART('day', TIMESTAMP '2024-10-01 12:34:56' - PED.LastActivityDate) AS DaysSinceLastPostActivity,
    CASE
        WHEN U.Reputation >= 20000 AND UE.GoldBadges >= 10 AND U.AboutMe IS NOT NULL THEN 'Distinguished Expert'
        WHEN U.Reputation >= 5000 OR UE.TotalQuestionsOwned >= 100 THEN 'Proactive Contributor'
        WHEN UE.TotalPostsOwned > 0 THEN 'Engaged User'
        ELSE 'Passive User'
    END AS UserEngagementLevel,
    NTILE(10) OVER (ORDER BY U.Reputation DESC, UE.TotalPostsOwned DESC) AS ReputationPostDecile,
    RANK() OVER (PARTITION BY TP.TagName ORDER BY PED.PostScore DESC, PED.PostViewCount DESC) AS PostRankInPrimaryTag,
    AVG(PED.PostScore) OVER (PARTITION BY PED.PostTypeId) AS GlobalAvgScoreForPostType,
    LAG(PED.PostCreationDate, 1, U.CreationDate) OVER (PARTITION BY U.Id ORDER BY PED.PostCreationDate) AS PrevPostByThisUserDate,
    EXISTS (
        SELECT 1
        FROM PostHistory PH_dup
        WHERE PH_dup.PostId = PED.PostId
        AND PH_dup.PostHistoryTypeId = 10
        AND (PH_dup.Comment LIKE '101%' OR PH_dup.Text LIKE '%"OriginalQuestionIds":%')
    ) AS WasClosedAsDuplicate,
    (
        SELECT C_top.Text
        FROM Comments C_top
        WHERE C_top.PostId = PED.PostId
        ORDER BY C_top.Score DESC, C_top.CreationDate DESC
        LIMIT 1
    ) AS TopCommentText,
    COALESCE(PL_LinkType.Name, 'N/A') AS RelatedLinkTypeName,
    COALESCE(RelatedPost.Title, 'No Related Post Title') AS RelatedPostTitle,
    (
        SELECT SUM(V.BountyAmount)
        FROM Votes V
        WHERE V.PostId = PED.PostId
        AND V.VoteTypeId IN (8,9)
        AND V.CreationDate BETWEEN PED.PostCreationDate AND PED.LastActivityDate
    ) AS TotalBountyAmount,
    (LOWER(COALESCE(P_Full.Body, '')) LIKE '%performance%' OR LOWER(COALESCE(P_Full.Body, '')) LIKE '%optimization%') AS ContainsPerformanceKeywords
FROM Users U
JOIN UserEngagement UE ON U.Id = UE.UserId
LEFT JOIN PostExtendedDetails PED ON U.Id = PED.OwnerUserId
LEFT JOIN PostTypes PT ON PED.PostTypeId = PT.Id
LEFT JOIN Users U_Owner ON PED.OwnerUserId = U_Owner.Id
LEFT JOIN Posts P_Full ON PED.PostId = P_Full.Id
LEFT JOIN Users U_LastEditor ON P_Full.LastEditorUserId = U_LastEditor.Id
LEFT JOIN TagPerformance TP ON PED.FirstTagName = TP.TagName
LEFT JOIN PostLinks PL_Linked ON PED.PostId = PL_Linked.PostId AND PL_Linked.LinkTypeId = 1
LEFT JOIN Posts RelatedPost ON PL_Linked.RelatedPostId = RelatedPost.Id
LEFT JOIN LinkTypes PL_LinkType ON PL_Linked.LinkTypeId = PL_LinkType.Id
WHERE U.Reputation > 1000
AND PED.PostId IS NOT NULL
AND PED.PostScore > 10
AND PED.PostCreationDate >= DATE '2021-01-01'
AND (U.Location ILIKE '%usa%' OR U.Location ILIKE '%gb%' OR U.Location ILIKE '%ca%' OR U.Location ILIKE '%australia%')
AND U.AboutMe IS NOT NULL
AND LENGTH(COALESCE(U.AboutMe, '')) > 50
ORDER BY
    U.Reputation DESC,
    WeightedPostScore DESC,
    PED.PostCreationDate DESC
LIMIT 5000;