WITH ranked_posts AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.Tags,
    p.AnswerCount,
    p.CommentCount,
    p.LastActivityDate,
    p.PostTypeId,
    COALESCE(u.Reputation, 0) AS OwnerReputation,
    COALESCE(b.TotalBadges, 0) AS OwnerBadges,
    ROW_NUMBER() OVER (
      PARTITION BY p.PostTypeId
      ORDER BY p.Score DESC, p.ViewCount DESC, p.CreationDate ASC
    ) AS rn
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN (
    SELECT UserId, COUNT(*) AS TotalBadges
    FROM Badges
    GROUP BY UserId
  ) b ON u.Id = b.UserId
  WHERE p.PostTypeId IN (1,2)
),
cte_user_activity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS PostsCreated,
    SUM(p.ViewCount) AS TotalViews,
    MAX(p.LastActivityDate) AS LastActive
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation
),
cte_top_tags AS (
  SELECT
    t.TagName,
    COUNT(*) AS TagUses,
    MAX(t.Count) AS TagCountSnapshot
  FROM Tags t
  WHERE t.IsModeratorOnly = FALSE
  GROUP BY t.TagName
  ORDER BY TagUses DESC
  LIMIT 10
),
recent_cross_links AS (
  SELECT
    pl.PostId,
    pl.RelatedPostId,
    pl.LinkTypeId,
    pl.CreationDate
  FROM PostLinks pl
  WHERE pl.LinkTypeId IN (1,3)
    AND pl.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '180 days')
),
recent_votes AS (
  SELECT
    v.PostId,
    v.VoteTypeId,
    v.UserId,
    v.CreationDate,
    v.BountyAmount
  FROM Votes v
  WHERE v.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '180 days')
),
filtered AS (
  SELECT rp.*
  FROM ranked_posts rp
  WHERE rp.rn = 1
    AND rp.PostTypeId = 1
    AND rp.CreationDate IS NULL
)
SELECT
  rp.Id AS PostId,
  rp.Title,
  rp.CreationDate,
  rp.Score,
  rp.ViewCount,
  u.DisplayName AS OwnerDisplayName,
  COALESCE(u.Reputation, 0) AS OwnerReputation,
  COALESCE(b.TotalBadges, 0) AS OwnerBadges,
  rp.Tags,
  rp.AnswerCount,
  rp.CommentCount,
  rp.LastActivityDate,
  uad.TotalViews AS OwnerTotalViews,
  ttt.TagName AS TopTag,
  (SELECT MAX(ph.CreationDate) FROM PostHistory ph WHERE ph.PostId = rp.Id) AS LastEdited,
  (SELECT COUNT(*) FROM Comments c WHERE c.PostId = rp.Id) AS CommentCountAll,
  (SELECT COUNT(*) FROM Votes v WHERE v.PostId = rp.Id AND v.VoteTypeId = 2) AS UpvotesLast180,
  (SELECT COUNT(*) FROM Votes v WHERE v.PostId = rp.Id AND v.VoteTypeId = 3) AS DownvotesLast180,
  (SELECT STRING_AGG(CAST(v.VoteTypeId AS varchar), ',') FROM Votes v WHERE v.PostId = rp.Id AND v.CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 days')) AS RecentVoteTypes,
  (SELECT STRING_AGG('Tag:' || t.TagName, '|')
     FROM Tags t
     WHERE t.Id IN (
       SELECT CAST(x AS integer)
       FROM UNNEST(string_to_array(rp.Tags, '>')) AS x
     )
  ) AS TagFragments
FROM
  Posts rp
  LEFT JOIN Users u ON rp.OwnerUserId = u.Id
  LEFT JOIN (
    SELECT UserId, COUNT(*) AS TotalBadges
    FROM Badges
    GROUP BY UserId
  ) b ON u.Id = b.UserId
  LEFT JOIN cte_user_activity uad ON rp.OwnerUserId = uad.UserId
  LEFT JOIN cte_top_tags ttt ON TRUE
WHERE
  rp.Id = rp.Id
ORDER BY rp.Score DESC, rp.ViewCount DESC, rp.CreationDate ASC
LIMIT 100;