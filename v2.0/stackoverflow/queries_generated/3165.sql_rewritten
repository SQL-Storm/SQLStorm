-- {"query": "3165.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2532} 
WITH q_stats AS (
    /* Questions with accepted answers per user */
    SELECT
        p.OwnerUserId                       AS user_id,
        COUNT(*)                            AS q_cnt,
        AVG(
            EXTRACT(EPOCH FROM (
                (SELECT MIN(v.CreationDate)
                 FROM Votes v
                 WHERE v.PostId = p.AcceptedAnswerId
                   AND v.VoteTypeId = 1) - p.CreationDate
            ))
        )                                   AS avg_sec_to_accept,
        SUM(COALESCE(p.FavoriteCount,0))    AS tot_favs,
        MAX(p.CreationDate)                 AS last_q_date
    FROM Posts p
    WHERE p.PostTypeId = 1
      AND p.AcceptedAnswerId IS NOT NULL
    GROUP BY p.OwnerUserId
),
badge_cnt AS (
    /* Badge breakdown per user */
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze,
        COUNT(*)                                    AS total_badges
    FROM Badges b
    GROUP BY b.UserId
),
recent_edits AS (
    /* Most recent edit per post (only title/body/tag edits) */
    SELECT
        ph.UserId,
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId IN (4,5,6)      -- edit title/body/tags
),
user_tags AS (
    /* Tag usage per user – exploded from the Tags column */
    SELECT
        p.OwnerUserId                                      AS user_id,
        UNNEST(string_to_array(TRIM(BOTH '<>' FROM p.Tags), '><')) AS tag,
        COUNT(*)                                           AS tag_cnt
    FROM Posts p
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId, tag
),
top_user_tag AS (
    /* Highest‑used tag per user */
    SELECT
        ut.user_id,
        ut.tag,
        ut.tag_cnt,
        ROW_NUMBER() OVER (PARTITION BY ut.user_id ORDER BY ut.tag_cnt DESC) AS rn
    FROM user_tags ut
),
vote_stats AS (
    /* Up/Down votes on a user's questions */
    SELECT
        p.OwnerUserId                       AS user_id,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS up_votes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS down_votes,
        COUNT(DISTINCT v.PostId)                         AS voted_q_cnt
    FROM Votes v
    JOIN Posts p ON p.Id = v.PostId
    WHERE p.PostTypeId = 1
    GROUP BY p.OwnerUserId
),
high_rep_users AS (
    /* Users that satisfy the “interesting” profile */
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        u.LastAccessDate,
        COALESCE(qs.q_cnt,0)                AS question_cnt,
        qs.avg_sec_to_accept,
        qs.tot_favs,
        bc.gold, bc.silver, bc.bronze, bc.total_badges,
        vs.up_votes, vs.down_votes, vs.voted_q_cnt,
        COALESCE(tut.tag,'<none>')          AS top_tag,
        COALESCE(tut.tag_cnt,0)             AS top_tag_cnt,
        CASE WHEN u.LastAccessDate > cast('2024-10-01' as date) - INTERVAL '30 days'
             THEN 'Active' ELSE 'Dormant' END AS activity_status,
        EXISTS (
            SELECT 1
            FROM recent_edits re
            WHERE re.UserId = u.Id
              AND re.rn = 1
              AND re.CreationDate > cast('2024-10-01' as date) - INTERVAL '7 days'
        )                                   AS edited_last_week
    FROM Users u
    LEFT JOIN q_stats qs   ON qs.user_id = u.Id AND qs.q_cnt >= 5
    LEFT JOIN badge_cnt bc ON bc.UserId = u.Id
    LEFT JOIN vote_stats vs ON vs.user_id = u.Id
    LEFT JOIN (
        SELECT user_id, tag, tag_cnt
        FROM top_user_tag
        WHERE rn = 1
    ) tut ON tut.user_id = u.Id
    WHERE u.Reputation > 1000
)
SELECT *
FROM high_rep_users
ORDER BY question_cnt DESC NULLS LAST, Reputation DESC
LIMIT 100

/* UNION with a complementary set: users with many badges but few questions */
UNION ALL
SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    COALESCE(qs.q_cnt,0)                AS question_cnt,
    qs.avg_sec_to_accept,
    qs.tot_favs,
    bc.gold, bc.silver, bc.bronze, bc.total_badges,
    vs.up_votes, vs.down_votes, vs.voted_q_cnt,
    COALESCE(tut.tag,'<none>')          AS top_tag,
    COALESCE(tut.tag_cnt,0)             AS top_tag_cnt,
    CASE WHEN u.LastAccessDate > cast('2024-10-01' as date) - INTERVAL '30 days'
         THEN 'Active' ELSE 'Dormant' END AS activity_status,
    FALSE                               AS edited_last_week
FROM Users u
LEFT JOIN q_stats qs   ON qs.user_id = u.Id
LEFT JOIN badge_cnt bc ON bc.UserId = u.Id
LEFT JOIN vote_stats vs ON vs.user_id = u.Id
LEFT JOIN (
    SELECT user_id, tag, tag_cnt
    FROM top_user_tag
    WHERE rn = 1
) tut ON tut.user_id = u.Id
WHERE u.Reputation > 1000
  AND bc.total_badges >= 20
  AND COALESCE(qs.q_cnt,0) < 3
ORDER BY total_badges DESC, Reputation DESC
LIMIT 50;