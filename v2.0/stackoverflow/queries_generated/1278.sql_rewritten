-- {"query": "1278.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 2784} 
WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        U.UpVotes AS UserUpVotes,
        U.DownVotes AS UserDownVotes,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestions,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswers,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN B.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        MAX(P.CreationDate) AS LatestPostDate,
        MAX(C.CreationDate) AS LatestCommentDate,
        MAX(PH_Any.CreationDate) AS LatestHistoryDate,
        -- Correlated subquery: Check if user has received any gold badge related to specific popular tags
        EXISTS (
            SELECT 1
            FROM Badges B_corr
            WHERE B_corr.UserId = U.Id
              AND B_corr.Class = 1
              AND B_corr.TagBased = TRUE
              AND B_corr.Name IN ('c#', 'java', 'python', 'javascript', 'html', 'css', 'sql', 'php', 'android', 'ios')
        ) AS HasHighValueTagGoldBadge
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    LEFT JOIN PostHistory PH_Any ON U.Id = PH_Any.UserId -- To capture any history action by the user
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.UpVotes, U.DownVotes
),
PostEngagementMetrics AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.CreationDate AS PostCreationDate,
        P.LastActivityDate,
        P.ViewCount,
        P.Score AS PostScore,
        P.AnswerCount,
        P.CommentCount,
        P.FavoriteCount,
        P.Title,
        P.Tags,
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpVotes, -- UpMod
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownVotes, -- DownMod
        COUNT(DISTINCT PH_Close.Id) AS CloseHistoryCount, -- Count distinct history entries
        COUNT(DISTINCT PH_Reopen.Id) AS ReopenHistoryCount,
        MAX(CRT.Name) AS LastCloseReason,
        -- Window function: Rank posts by engagement (score + favorite count) within their PostTypeId
        RANK() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score + COALESCE(P.FavoriteCount, 0) DESC, P.CreationDate DESC) AS PostEngagementRank,
        COALESCE(P.Title, 'No Title Provided') AS DisplayTitle,
        -- String expression: Extract the first tag, or a default string if no tags
        COALESCE(SUBSTRING(P.Tags, 2, POSITION('><' IN P.Tags) - 2), 'untagged') AS FirstParsedTag,
        (CAST(P.Score AS NUMERIC) / NULLIF(P.ViewCount, 0)) AS ScorePerViewRatio -- NULLIF for division by zero
    FROM Posts P
    LEFT JOIN Votes V ON P.Id = V.PostId
    LEFT JOIN PostHistory PH_Close ON P.Id = PH_Close.PostId AND PH_Close.PostHistoryTypeId = 10
    LEFT JOIN PostHistory PH_Reopen ON P.Id = PH_Reopen.PostId AND PH_Reopen.PostHistoryTypeId = 11
    LEFT JOIN CloseReasonTypes CRT ON TRY_CAST(PH_Close.Comment AS SMALLINT) = CRT.Id -- TRY_CAST for robustness
    GROUP BY P.Id, P.PostTypeId, P.OwnerUserId, P.CreationDate, P.LastActivityDate, P.ViewCount, P.Score, P.AnswerCount, P.CommentCount, P.FavoriteCount, P.Title, P.Tags
),
TagUsageMetrics AS (
    SELECT
        TRIM(unnested_tag.tag_name) AS TagName,
        COUNT(DISTINCT P.Id) AS PostCount,
        SUM(P.Score) AS TotalTagScore,
        AVG(P.Score) AS AverageTagScore,
        SUM(P.ViewCount) AS TotalTagViewCount,
        -- Window function: Rank tags by their total score
        RANK() OVER (ORDER BY SUM(P.Score) DESC, COUNT(DISTINCT P.Id) DESC) AS TagScoreRank
    FROM Posts P
    CROSS JOIN LATERAL UNNEST(string_to_array(substring(P.Tags, 2, length(P.Tags)-2), '><')) AS unnested_tag(tag_name)
    WHERE P.Tags IS NOT NULL AND LENGTH(TRIM(unnested_tag.tag_name)) > 0
    GROUP BY TRIM(unnested_tag.tag_name)
    HAVING COUNT(DISTINCT P.Id) > 50 AND SUM(P.Score) > 0 -- Filter for significant and positively scored tags
),
ContentLifecycleEvents AS (
    SELECT
        PostId,
        COUNT(CASE WHEN PostHistoryTypeId IN (4,5,6) THEN 1 END) AS TotalEditEvents, -- Edit Title, Body, Tags
        COUNT(CASE WHEN PostHistoryTypeId IN (7,8,9) THEN 1 END) AS TotalRollbackEvents, -- Rollback Title, Body, Tags
        COUNT(CASE WHEN PostHistoryTypeId = 10 THEN 1 END) AS TotalCloseVotes,
        COUNT(CASE WHEN PostHistoryTypeId = 11 THEN 1 END) AS TotalReopenVotes,
        MAX(CASE WHEN PostHistoryTypeId = 10 THEN CreationDate END) AS LastClosedDate,
        MIN(CASE WHEN PostHistoryTypeId = 11 THEN CreationDate END) AS FirstReopenedDate,
        -- Check for specific sequence: closed then reopened using LAG
        MAX(CASE WHEN prev_history_type = 10 AND PostHistoryTypeId = 11 THEN 1 ELSE 0 END) AS WasClosedThenReopenedFlag,
        -- Find the 3rd editor's user ID for posts that are questions
        NTH_VALUE(UserId, 3) OVER (PARTITION BY PostId ORDER BY CreationDate ASC) AS ThirdEditorUserId
    FROM (
        SELECT
            PH.PostId,
            PH.UserId,
            PH.CreationDate,
            PH.PostHistoryTypeId,
            LAG(PH.PostHistoryTypeId, 1, 0) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS prev_history_type
        FROM PostHistory PH
        WHERE PH.PostHistoryTypeId IN (4,5,6,7,8,9,10,11) -- Focus on specific history types for efficiency
    ) AS history_with_prev_type
    GROUP BY PostId
)
SELECT
    UAS.UserId,
    UAS.DisplayName,
    UAS.Reputation,
    UAS.TotalQuestions,
    UAS.TotalAnswers,
    UAS.TotalBadges,
    UAS.GoldBadges,
    UAS.HasHighValueTagGoldBadge,
    PEM.PostId,
    PEM.DisplayTitle,
    PEM.PostScore,
    PEM.ViewCount,
    PEM.FavoriteCount,
    PEM.FirstParsedTag,
    PEM.ScorePerViewRatio,
    PEM.PostEngagementRank,
    TU.TagName AS PopularRelatedTag,
    TU.TotalTagScore AS PopularTagTotalScore,
    CLE.TotalEditEvents,
    CLE.TotalRollbackEvents,
    CLE.TotalCloseVotes,
    CLE.TotalReopenVotes,
    CLE.WasClosedThenReopenedFlag,
    CLE.ThirdEditorUserId,
    -- Complicated calculation: average days between user creation and their latest significant activity (post or comment)
    EXTRACT(DAY FROM (COALESCE(UAS.LatestPostDate, UAS.LatestCommentDate, UAS.LastAccessDate) - UAS.UserCreationDate)) / 365.25 AS YearsSinceCreationToLastActivity,
    -- String expression: Concatenate a verbose summary based on post type and close reason
    CONCAT(
        CASE
            WHEN PEM.PostTypeId = 1 THEN 'Question: '
            WHEN PEM.PostTypeId = 2 THEN 'Answer: '
            ELSE 'Other Post Type: '
        END,
        SUBSTRING(PEM.DisplayTitle, 1, 75), -- Truncate title for brevity
        ' [Score: ', CAST(PEM.PostScore AS VARCHAR),
        ', Views: ', CAST(COALESCE(PEM.ViewCount, 0) AS VARCHAR), ']',
        COALESCE(' {Closed due to: ' || PEM.LastCloseReason || '}', '')
    ) AS PostSummaryDescription,
    -- NULL logic: If no favorite count, assume 0 for calculations, and calculate an 'Effective Engagement' score
    (PEM.TotalUpVotes - PEM.TotalDownVotes + COALESCE(PEM.FavoriteCount, 0) * 2) AS EffectivePostEngagementScore,
    -- Calculation: Ratio of answers to questions for the user
    (CAST(UAS.TotalAnswers AS NUMERIC) / NULLIF(UAS.TotalQuestions, 0)) AS AnswerToQuestionRatio,
    -- Check if the post received more upvotes than its creator has total user upvotes (a highly viral post for the user)
    CASE WHEN PEM.TotalUpVotes > UAS.UserUpVotes THEN 'True' ELSE 'False' END AS IsViralForUser
FROM UserActivitySummary UAS
INNER JOIN PostEngagementMetrics PEM ON UAS.UserId = PEM.OwnerUserId
LEFT JOIN ContentLifecycleEvents CLE ON PEM.PostId = CLE.PostId
-- Outer join to TagUsageMetrics, potentially connecting to a post's first tag if it's popular
LEFT JOIN TagUsageMetrics TU ON PEM.FirstParsedTag = TU.TagName
WHERE UAS.Reputation > 7500 -- Filter for highly reputable users
  AND PEM.PostScore >= 20 -- Filter for posts with significant positive score
  AND PEM.PostTypeId IN (1, 2) -- Only questions and answers
  AND (PEM.ViewCount IS NULL OR PEM.ViewCount > 500) -- Handle NULL ViewCount, or require significant views
  AND UAS.HasHighValueTagGoldBadge IS TRUE -- Only users with specific gold badges
  AND (CLE.TotalEditEvents > 3 OR CLE.TotalRollbackEvents > 0 OR CLE.WasClosedThenReopenedFlag = 1) -- Posts with significant history or contentious lifecycle
  AND PEM.PostEngagementRank <= 500 -- Only highly ranked posts
  AND NOT EXISTS ( -- Correlated subquery to exclude users who have had more than 10% of their answers deleted, or at least 5 deleted answers
    SELECT 1
    FROM Posts P_del
    WHERE P_del.OwnerUserId = UAS.UserId
      AND P_del.PostTypeId = 2 -- Only answers
      AND P_del.Id IN (SELECT PH_del.PostId FROM PostHistory PH_del WHERE PH_del.PostHistoryTypeId = 12) -- Post Deleted
    GROUP BY P_del.OwnerUserId
    HAVING COUNT(P_del.Id) > UAS.TotalAnswers * 0.1 OR COUNT(P_del.Id) > 5
  )
ORDER BY UAS.Reputation DESC, EffectivePostEngagementScore DESC, YearsSinceCreationToLastActivity ASC
LIMIT 10000;