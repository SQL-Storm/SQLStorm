    ca.DownVotes,
    ca.total_posts,
    ca.question_count,
    ca.answer_count,
    ca.user_avg_score_final,
    ca.user_max_score,
    ca.badge_count,
    ca.badge_names,
    ca.post_type_classification,
    ca.popularity_category,
    ca.engagement_rank,
    ca.engagement_percentile,
    ca.engagement_delta,
    ca.prev_engagement_score,
    ca.normalized_title,
    ca.title_length,
    ca.normalized_tags,
    ca.tag_count,
    ca.resolution_status,
    ca.engagement_level,
    ca.score_deviation_from_avg,
    ca.score_percentage_of_max,
    ca.quality_level,
    CAST((ca.engagement_score * ca.Reputation / (NULLIF(ca.total_posts, 0) * 1000.0)) AS NUMERIC(10,2)) as reputation_efficiency_rating,
    CAST(POWER(ca.Score + 1, 2) - ca.ViewCount AS NUMERIC(10,0)) as adjusted_score,
    (SELECT COUNT(*) FROM Posts p2 WHERE p2.OwnerUserId = ca.OwnerUserId AND p2.CreationDate > ca.CreationDate) as following_posts_count,
    CASE WHEN EXISTS (SELECT 1 FROM Votes v WHERE v.PostId = ca.Id AND v.VoteTypeId = 2) THEN 'HasUpvote' ELSE 'NoUpvote' END as vote_status,
    TRIM(UPPER(COALESCE(ca.Title, ''))) as uppercase_title,
    SUBSTRING(COALESCE(ca.Tags, ''), 2, CHAR_LENGTH(COALESCE(ca.Tags, '')) - 2) as clean_tags,
    ROW_NUMBER() OVER (PARTITION BY ca.post_year, ca.post_month ORDER BY ca.engagement_score DESC) as monthly_engagement_rank,
    (SELECT COUNT(*) FROM Badges b WHERE b.UserId = ca.OwnerUserId AND b.Class = 1) as gold_badges_count,
    CASE 
        WHEN ca.user_post_count > 100 AND ca.badge_count > 50 THEN 'EliteUser'
        WHEN ca.user_post_count > 50 AND ca.badge_count > 25 THEN 'VeteranUser'
        WHEN ca.user_post_count > 10 AND ca.badge_count > 5 THEN 'RegularUser'
        ELSE 'NewUser'
    END as user_status_level,
    COALESCE(ca.prev_engagement_score, 0) as safe_prev_engagement_score,
    NULLIF(ca.engagement_score, 0) / NULLIF(ca.user_avg_score, 0) as engagement_to_avg_ratio,
    ROUND(SQRT(ca.Score) + LN(COALESCE(ca.ViewCount, 1) + 1), 2) as complex_score_metric,
    ROUND((ca.engagement_score / NULLIF(ca.weighted_score, 0)) * 100, 2) as efficiency_percentage
FROM CrossAnalysis ca
WHERE ca.engagement_score > 0
  AND ca.total_posts > 0
  AND ca.Reputation > 1000
ORDER BY ca.engagement_score DESC
LIMIT 1000;