-- {"query": "1059.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 2809} 
WITH ActiveTechUsers AS (
    -- CTE 1: Identifies users who are actively contributing to 'SQL', 'Database', or 'Performance' related content
    -- within the last 3 years and have at least 5 posts in these categories.
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.LastAccessDate,
        COUNT(DISTINCT p.Id) AS TotalTechPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TechQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TechAnswers,
        MAX(p.LastActivityDate) AS LastTechActivityDate
    FROM Users u
    INNER JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE
        p.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years')
        AND p.PostTypeId IN (1, 2) -- Only consider Questions and Answers
        AND (
            -- String expressions: Use ILIKE for tag matching and title keyword search
            p.Tags ILIKE '%<sql>%' OR
            p.Tags ILIKE '%<database>%' OR
            p.Tags ILIKE '%<performance>%' OR
            p.Title ILIKE '%SQL%' OR
            p.Title ILIKE '%Database%' OR
            p.Title ILIKE '%Performance%'
        )
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.LastAccessDate
    HAVING COUNT(DISTINCT p.Id) >= 5
),
PostEditHistorySummary AS (
    -- CTE 2: Summarizes post editing activity, focusing on owner edits, distinct editors,
    -- and the evolution of post body length over time.
    SELECT
        p.Id AS PostId,
        p.OwnerUserId,
        COUNT(DISTINCT ph.UserId) AS DistinctEditorCount,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6) AND ph.UserId = p.OwnerUserId THEN 1 ELSE 0 END) AS OwnerEditCount,
        MIN(CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6) AND ph.UserId = p.OwnerUserId THEN ph.CreationDate END) AS FirstOwnerEditDate,
        (
            -- Correlated subquery: Get initial body length from PostHistory
            SELECT LENGTH(ph_initial.Text)
            FROM PostHistory ph_initial
            WHERE ph_initial.PostId = p.Id AND ph_initial.PostHistoryTypeId = 2 -- Initial Body
            ORDER BY ph_initial.CreationDate
            LIMIT 1
        ) AS InitialBodyLength,
        LENGTH(p.Body) AS FinalBodyLength, -- String expression: Current body length
        -- Complicated calculation: Time in hours taken for the first owner edit
        EXTRACT(EPOCH FROM (MIN(CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6) AND ph.UserId = p.OwnerUserId THEN ph.CreationDate END) - p.CreationDate)) / 3600.0 AS HoursToFirstOwnerEdit
    FROM Posts p
    LEFT JOIN PostHistory ph ON p.Id = ph.PostId
    WHERE p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.OwnerUserId, p.Body, p.CreationDate
    HAVING COUNT(DISTINCT ph.UserId) > 1 OR SUM(CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6) AND ph.UserId = p.OwnerUserId THEN 1 ELSE 0 END) >= 1
),
PostEngagementMetrics AS (
    -- CTE 3: Aggregates vote counts, comment counts, and calculates a 'controversy score' for posts.
    SELECT
        p.Id AS PostId,
        COUNT(DISTINCT c.Id) AS TotalComments,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS Upvotes,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS Downvotes,
        SUM(CASE WHEN v.VoteTypeId = 5 THEN 1 ELSE 0 END) AS Favorites,
        SUM(CASE WHEN v.VoteTypeId IN (2,3) THEN 1 ELSE 0 END) AS TotalVotes,
        -- Complicated calculation with NULL logic: Controversy score
        -- Measures the absolute difference between upvotes and downvotes relative to total votes
        CASE
            WHEN SUM(CASE WHEN v.VoteTypeId IN (2,3) THEN 1 ELSE 0 END) >= 5
            THEN ABS(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) - SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END))::NUMERIC / NULLIF(SUM(CASE WHEN v.VoteTypeId IN (2,3) THEN 1 ELSE 0 END), 0)
            ELSE 0.0
        END AS ControversyScore
    FROM Posts p
    LEFT JOIN Votes v ON p.Id = v.PostId
    LEFT JOIN Comments c ON p.Id = c.PostId
    WHERE p.PostTypeId IN (1, 2)
    GROUP BY p.Id
),
UserBadgeSummary AS (
    -- CTE 4: Summarizes badge counts (Gold, Silver, Bronze) for each user.
    SELECT
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Badges b
    GROUP BY b.UserId
)
-- Main Query: Combines all the CTEs and applies complex filtering, window functions, and calculations
SELECT
    atu.DisplayName AS UserName,
    atu.Reputation,
    atu.TotalTechPosts,
    atu.TechQuestions,
    atu.TechAnswers,
    COALESCE(ubs.GoldBadges, 0) AS UserGoldBadges, -- NULL logic: replace NULL badge counts with 0
    COALESCE(ubs.SilverBadges, 0) AS UserSilverBadges,
    COALESCE(ubs.BronzeBadges, 0) AS UserBronzeBadges,
    p.Id AS PostId,
    -- String expression and NULL logic: Use post title or a snippet of the body if title is NULL
    COALESCE(p.Title, SUBSTRING(p.Body, 1, 50) || '...') AS PostTitleSnippet,
    p.ViewCount AS PostViewCount,
    p.CreationDate AS PostCreationDate,
    COALESCE(pem.TotalComments, 0) AS PostCommentCount,
    COALESCE(pem.Upvotes, 0) AS PostUpvotes,
    COALESCE(pem.Downvotes, 0) AS PostDownvotes,
    COALESCE(pem.Favorites, 0) AS PostFavorites,
    pem.ControversyScore AS PostControversyScore,
    peh.OwnerEditCount AS PostOwnerEditCount,
    peh.DistinctEditorCount AS PostDistinctEditorCount,
    peh.InitialBodyLength,
    peh.FinalBodyLength,
    -- Complicated calculation: Percentage change in body length, with NULL logic to prevent division by zero
    CASE
        WHEN peh.InitialBodyLength IS NOT NULL AND peh.InitialBodyLength > 0
        THEN (peh.FinalBodyLength - peh.InitialBodyLength)::NUMERIC / peh.InitialBodyLength * 100
        ELSE 0.0
    END AS BodyLengthChangePct,
    peh.HoursToFirstOwnerEdit,
    -- Window function: Rank users by their average controversy score within reputation tiers
    RANK() OVER (
        PARTITION BY FLOOR(atu.Reputation / 10000) -- Partition by reputation bands (e.g., 0-9999, 10000-19999)
        ORDER BY AVG(pem.ControversyScore) OVER (PARTITION BY atu.UserId) DESC, atu.Reputation DESC
    ) AS UserControversyRankByRepTier,
    -- Window function: Calculate a moving average of post scores for a user's posts
    AVG(p.Score) OVER (
        PARTITION BY p.OwnerUserId
        ORDER BY p.CreationDate
        ROWS BETWEEN 2 PRECEDING AND CURRENT ROW -- Average of current and 2 previous posts
    ) AS MovingAvgPostScoreForUser,
    -- Correlated subquery & NULL logic: Check if this post is a duplicate of a highly-viewed post with an accepted answer
    EXISTS (
        SELECT 1
        FROM PostLinks pl
        INNER JOIN Posts related_p ON pl.RelatedPostId = related_p.Id
        WHERE
            pl.PostId = p.Id
            AND pl.LinkTypeId = 3 -- Duplicate link type
            AND related_p.ViewCount > 50000
            AND related_p.AcceptedAnswerId IS NOT NULL -- NULL logic: check for accepted answer existence
    ) AS IsDuplicateOfHighViewAcceptedPost,
    -- String expression: Check for specific performance-related keywords in the post body
    (p.Body ILIKE '%optimization%' OR p.Body ILIKE '%bottleneck%' OR p.Body ILIKE '%latency%') AS ContainsPerformanceKeywords,
    -- Complicated predicate/NULL logic: Categorize post status based on multiple conditions
    CASE
        WHEN p.ClosedDate IS NOT NULL AND p.Score > 10 AND COALESCE(pem.TotalComments, 0) > 5
        THEN 'Controversial-Closed' -- High score/comments despite closure
        WHEN p.AcceptedAnswerId IS NOT NULL AND p.OwnerUserId = p.LastEditorUserId AND peh.OwnerEditCount > 0
        THEN 'Owner-Accepted-Refined' -- Owner accepted their own, and edited it
        WHEN p.CommunityOwnedDate IS NOT NULL AND COALESCE(peh.DistinctEditorCount, 0) > 2
        THEN 'Community-Driven-Evolved' -- Community owned and multi-edited
        WHEN p.Score < 0 AND pem.Downvotes > pem.Upvotes * 2
        THEN 'Highly-Negative' -- Significantly more downvotes than upvotes
        ELSE 'Standard'
    END AS PostStatusCategory
FROM ActiveTechUsers atu
INNER JOIN Posts p ON atu.UserId = p.OwnerUserId
INNER JOIN PostEngagementMetrics pem ON p.Id = pem.PostId
LEFT JOIN PostEditHistorySummary peh ON p.Id = peh.PostId -- Outer join for posts that might not have edit history
LEFT JOIN UserBadgeSummary ubs ON atu.UserId = ubs.UserId -- Outer join for users that might not have badges
WHERE
    p.PostTypeId IN (1, 2)
    AND p.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years')
    AND p.ViewCount > 1000 -- Filter for posts with reasonable visibility
    AND (peh.OwnerEditCount > 0 OR peh.DistinctEditorCount > 1) -- Only consider posts that have been edited
    AND (
        (pem.Upvotes > 20 AND pem.Downvotes < 5 AND p.FavoriteCount > 3) -- Highly positive and favorited posts
        OR (pem.ControversyScore > 0.45 AND pem.TotalVotes > 15 AND pem.TotalComments > 8) -- Highly controversial and engaged posts
        OR (peh.BodyLengthChangePct > 20 AND peh.HoursToFirstOwnerEdit < 24) -- Significantly edited soon after creation
    )
    AND EXISTS ( -- Correlated subquery: Ensure user has at least one gold or silver badge
        SELECT 1
        FROM Badges b_sub
        WHERE b_sub.UserId = atu.UserId AND b_sub.Class IN (1, 2)
    )
ORDER BY
    atu.Reputation DESC,
    UserControversyRankByRepTier ASC,
    p.CreationDate DESC,
    pem.ControversyScore DESC
;