-- {"query": "1632.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 4062} 
WITH UserEngagement AS (
    -- Summarize user activity, post contributions, and badge counts for active users
    SELECT
        u.Id AS UserId,
        COALESCE(u.DisplayName, 'AnonymousUser') AS UserDisplayName,
        u.Reputation,
        u.UpVotes AS TotalUpVotesGiven,
        u.DownVotes AS TotalDownVotesGiven,
        u.Views AS ProfileViews,
        COUNT(DISTINCT p.Id) AS TotalPostsCreated,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS QuestionsAsked,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS AnswersGiven,
        SUM(CASE WHEN p.PostTypeId IN (1, 2) THEN p.Score ELSE 0 END) AS TotalPostScore,
        AVG(CASE WHEN p.PostTypeId IN (1, 2) THEN p.Score ELSE NULL END) AS AvgPostScore,
        MAX(p.LastActivityDate) AS LastPostActivity,
        DATE_PART('day', MAX(u.LastAccessDate) - u.CreationDate) AS DaysSinceCreation,
        COUNT(DISTINCT b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        -- Calculate the time difference in hours between the user's last and second-to-last post
        -- Using COALESCE with MAX(p.CreationDate) to handle users with only one post
        DATE_PART('hour', MAX(p.CreationDate) - COALESCE(LAG(p.CreationDate, 1) OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC), MAX(p.CreationDate))) AS HoursBetweenLastTwoPosts
    FROM
        Users u
    LEFT JOIN
        Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN
        Badges b ON u.Id = b.UserId
    WHERE
        u.LastAccessDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') -- Only consider users active in the last year
    GROUP BY
        u.Id, u.DisplayName, u.Reputation, u.UpVotes, u.DownVotes, u.Views, u.CreationDate, u.LastAccessDate
),
PostDetails AS (
    -- Analyze post characteristics, comments, and recent edits/votes
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.Title,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        COALESCE(p.FavoriteCount, 0) AS FavoriteCount,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        p.ParentId,
        p.LastActivityDate, -- Needed for HotnessScore calculation
        p.Tags, -- Needed for lateral join and tag extraction
        -- Correlated subquery to count unique editors for a post (excluding the owner if they are the first editor)
        (SELECT COUNT(DISTINCT ph_sub.UserId)
         FROM PostHistory ph_sub
         WHERE ph_sub.PostId = p.Id AND ph_sub.PostHistoryTypeId IN (4, 5, 6)) AS UniqueEditors,
        -- Correlated subquery to get the text of the most recent comment on the post
        (SELECT c_sub.Text
         FROM Comments c_sub
         WHERE c_sub.PostId = p.Id
         ORDER BY c_sub.CreationDate DESC
         LIMIT 1) AS LatestCommentText,
        -- Window function for average score of comments on this post
        AVG(c.Score) OVER (PARTITION BY p.Id) AS AvgCommentScore,
        -- Total upvotes for this post
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
        -- Total downvotes for this post
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
        -- Ratio of upvotes to total votes (NULL if no votes, preventing division by zero)
        NULLIF(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) * 1.0 / NULLIF(COUNT(v.Id), 0) AS UpvoteRatio,
        -- Window function to determine closure status based on post history
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN 'Closed' ELSE 'Open' END) OVER (PARTITION BY p.Id) AS ClosureStatus,
        -- Complex "hotness" score calculation, weighted by various engagement metrics and decay over time
        (p.Score * 5 + p.ViewCount * 0.1 + p.CommentCount * 2 + COALESCE(p.FavoriteCount, 0) * 10) /
        (1.0 + EXTRACT(EPOCH FROM (cast('2024-10-01 12:34:56' as timestamp) - p.LastActivityDate)) / 3600 / 24) AS HotnessScore
    FROM
        Posts p
    LEFT JOIN
        Comments c ON p.Id = c.PostId
    LEFT JOIN
        Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3) -- Only considering up/down votes for vote counts
    LEFT JOIN
        PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId IN (10, 11) -- For Close/Reopen events
    WHERE
        p.PostTypeId IN (1, 2) -- Only questions and answers
    GROUP BY
        p.Id, p.PostTypeId, p.Title, p.CreationDate, p.Score, p.ViewCount, p.AnswerCount, p.CommentCount,
        p.FavoriteCount, p.OwnerUserId, p.AcceptedAnswerId, p.ParentId, p.LastActivityDate, p.Tags
),
TagAnalysis AS (
    -- Analyze tag usage and popularity, considering posts with parsed tags
    SELECT
        t.TagName,
        t.Count AS TotalTagUseCount,
        COUNT(DISTINCT p.Id) AS PostsWithThisTag,
        AVG(p.Score) AS AvgPostScoreForTag,
        MAX(CASE WHEN t.WikiPostId IS NOT NULL THEN 'Has Wiki' ELSE 'No Wiki' END) AS WikiStatus,
        -- Rank tags by total usage count and average post score
        ROW_NUMBER() OVER (ORDER BY t.Count DESC, AVG(p.Score) DESC) AS TagPopularityRank
    FROM
        Tags t
    INNER JOIN
        Posts p ON p.PostTypeId = 1 -- Only questions are relevant for tag analysis
        AND p.Tags IS NOT NULL
        AND LENGTH(p.Tags) > 2 -- Ensure tags string is not empty or just '<>'
        AND EXISTS (
            -- Correlated subquery to check if the tag is present in the post's tags array
            SELECT 1
            FROM UNNEST(string_to_array(substring(p.Tags, 2, length(p.Tags)-2), '><')) AS tag_arr
            WHERE tag_arr = t.TagName
        )
    GROUP BY
        t.TagName, t.Count
),
RecentlyClosedOrReopened AS (
    -- Identify posts that have been recently closed or reopened, along with the reason
    SELECT
        ph.PostId,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN crt.Name ELSE NULL END) AS LastCloseReason,
        MAX(ph.CreationDate) AS LastHistoryDate,
        -- Use ROW_NUMBER to get only the most recent close/reopen event per post
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM
        PostHistory ph
    LEFT JOIN
        CloseReasonTypes crt ON ph.Comment = crt.Id::varchar -- Assuming Comment stores CloseReasonId as string
    WHERE
        ph.PostHistoryTypeId IN (10, 11) -- Closed or Reopened events
        AND ph.CreationDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '180 days') -- Only recent history
    GROUP BY
        ph.PostId, ph.CreationDate
)
-- Main query combining information using UNION ALL for two distinct sets of "important" posts
(
    SELECT
        ue.UserId,
        ue.UserDisplayName,
        ue.Reputation,
        ue.TotalPostsCreated,
        pd.PostId,
        COALESCE(pd.Title, 'No Title (e.g., Answer)') AS PostTitle,
        pd.PostCreationDate,
        pd.PostScore,
        pd.ViewCount,
        pd.FavoriteCount,
        pd.UniqueEditors,
        pd.LatestCommentText,
        COALESCE(pd.AvgCommentScore, 0.0) AS AvgCommentScore,
        pd.UpVoteCount,
        pd.DownVoteCount,
        pd.UpvoteRatio,
        ta.TagName AS PrimaryTagName,
        ta.TagPopularityRank,
        rcr.LastCloseReason,
        rcr.LastHistoryDate,
        -- Complex weighted score for user engagement
        (ue.Reputation * 0.5 + ue.TotalPostScore * 0.2 + ue.ProfileViews * 0.01 + ue.GoldBadges * 10 + ue.SilverBadges * 5 + ue.BronzeBadges * 1) AS UserEngagementScore,
        -- Complex weighted score for post quality, incorporating hotness and accepted answers
        (pd.PostScore * 0.7 + COALESCE(pd.UpvoteRatio, 0) * 100 + pd.HotnessScore * 0.1 - COALESCE(pd.DownVoteCount, 0) * 0.5 + CASE WHEN pd.AcceptedAnswerId IS NOT NULL THEN 50 ELSE 0 END) AS PostQualityScore,
        pd.HotnessScore, -- Explicitly select for ordering
        -- Dynamic status based on post and user characteristics
        CASE
            WHEN pd.ClosureStatus = 'Closed' AND rcr.LastCloseReason IS NOT NULL THEN 'Recently Closed: ' || rcr.LastCloseReason
            WHEN pd.PostTypeId = 1 AND pd.AcceptedAnswerId IS NOT NULL THEN 'Question with Accepted Answer'
            WHEN pd.PostTypeId = 2 AND pd.ParentId IS NOT NULL THEN 'Answer to Question ' || pd.ParentId::varchar
            WHEN pd.PostScore > 50 AND pd.CommentCount > 10 THEN 'Highly Engaged Post'
            WHEN ue.HoursBetweenLastTwoPosts IS NOT NULL AND ue.HoursBetweenLastTwoPosts < 24 AND ue.TotalPostsCreated > 1 THEN 'Frequent Poster'
            ELSE 'General Activity - High Rep User'
        END AS PostActivityStatus,
        -- Correlated subquery to find the average score of all posts by the owner of the current post
        (SELECT AVG(sub_p.Score) FROM Posts sub_p WHERE sub_p.OwnerUserId = ue.UserId) AS OwnerAveragePostScore,
        -- String manipulation: combine title with first tag, trim, and limit length
        TRIM(BOTH '>' FROM SUBSTRING(COALESCE(pd.Title, 'N/A') || ' (' || COALESCE(pd_first_tag.first_tag_on_post, 'No Tags') || ')', 1, 100)) AS FormattedPostTitleAndTag
    FROM
        UserEngagement ue
    INNER JOIN
        PostDetails pd ON ue.UserId = pd.OwnerUserId
    LEFT JOIN LATERAL ( -- Lateral join to extract the first tag from the post's Tags string
        SELECT
            (string_to_array(substring(pd.Tags, 2, length(pd.Tags)-2), '><'))[1] AS first_tag_on_post
        WHERE pd.Tags IS NOT NULL AND LENGTH(pd.Tags) > 2
    ) AS pd_first_tag ON TRUE
    LEFT JOIN
        TagAnalysis ta ON pd_first_tag.first_tag_on_post = ta.TagName
    LEFT JOIN
        (SELECT PostId, LastCloseReason, LastHistoryDate FROM RecentlyClosedOrReopened WHERE rn = 1) rcr ON pd.PostId = rcr.PostId
    WHERE
        ue.Reputation > 5000 -- Filter for highly reputable users
        AND pd.PostScore > 10 -- Only posts with a decent positive score
        AND pd.PostCreationDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months') -- Only relatively recent posts
        AND COALESCE(pd.UpvoteRatio, 0) > 0.6 -- Posts with significantly more upvotes than downvotes
        AND (pd.Title LIKE '%SQL%' OR pd.LatestCommentText LIKE '%database%') -- String matching on title or latest comment
)
UNION ALL
(
    SELECT
        ue.UserId,
        ue.UserDisplayName,
        ue.Reputation,
        ue.TotalPostsCreated,
        pd.PostId,
        COALESCE(pd.Title, 'No Title (e.g., Answer)') AS PostTitle,
        pd.PostCreationDate,
        pd.PostScore,
        pd.ViewCount,
        pd.FavoriteCount,
        pd.UniqueEditors,
        pd.LatestCommentText,
        COALESCE(pd.AvgCommentScore, 0.0) AS AvgCommentScore,
        pd.UpVoteCount,
        pd.DownVoteCount,
        pd.UpvoteRatio,
        ta.TagName AS PrimaryTagName,
        ta.TagPopularityRank,
        rcr.LastCloseReason,
        rcr.LastHistoryDate,
        -- Complex weighted score for user engagement (same calculation)
        (ue.Reputation * 0.5 + ue.TotalPostScore * 0.2 + ue.ProfileViews * 0.01 + ue.GoldBadges * 10 + ue.SilverBadges * 5 + ue.BronzeBadges * 1) AS UserEngagementScore,
        -- Complex weighted score for post quality (same calculation)
        (pd.PostScore * 0.7 + COALESCE(pd.UpvoteRatio, 0) * 100 + pd.HotnessScore * 0.1 - COALESCE(pd.DownVoteCount, 0) * 0.5 + CASE WHEN pd.AcceptedAnswerId IS NOT NULL THEN 50 ELSE 0 END) AS PostQualityScore,
        pd.HotnessScore, -- Explicitly select for ordering
        -- Dynamic status (slightly different for distinction in UNION ALL)
        CASE
            WHEN pd.ClosureStatus = 'Closed' AND rcr.LastCloseReason IS NOT NULL THEN 'Recently Closed: ' || rcr.LastCloseReason
            WHEN pd.PostTypeId = 1 AND pd.AcceptedAnswerId IS NOT NULL THEN 'Question with Accepted Answer'
            WHEN pd.PostTypeId = 2 AND pd.ParentId IS NOT NULL THEN 'Answer to Question ' || pd.ParentId::varchar
            WHEN pd.PostScore > 50 AND pd.CommentCount > 10 THEN 'Highly Engaged Post'
            WHEN ue.HoursBetweenLastTwoPosts IS NOT NULL AND ue.HoursBetweenLastTwoPosts < 24 AND ue.TotalPostsCreated > 1 THEN 'Frequent Poster'
            ELSE 'General Activity - High Score Post'
        END AS PostActivityStatus,
        -- Correlated subquery (same calculation)
        (SELECT AVG(sub_p.Score) FROM Posts sub_p WHERE sub_p.OwnerUserId = ue.UserId) AS OwnerAveragePostScore,
        -- String manipulation (same calculation)
        TRIM(BOTH '>' FROM SUBSTRING(COALESCE(pd.Title, 'N/A') || ' (' || COALESCE(pd_first_tag.first_tag_on_post, 'No Tags') || ')', 1, 100)) AS FormattedPostTitleAndTag
    FROM
        UserEngagement ue
    INNER JOIN
        PostDetails pd ON ue.UserId = pd.OwnerUserId
    LEFT JOIN LATERAL ( -- Lateral join to extract the first tag from the post's Tags string
        SELECT
            (string_to_array(substring(pd.Tags, 2, length(pd.Tags)-2), '><'))[1] AS first_tag_on_post
        WHERE pd.Tags IS NOT NULL AND LENGTH(pd.Tags) > 2
    ) AS pd_first_tag ON TRUE
    LEFT JOIN
        TagAnalysis ta ON pd_first_tag.first_tag_on_post = ta.TagName
    LEFT JOIN
        (SELECT PostId, LastCloseReason, LastHistoryDate FROM RecentlyClosedOrReopened WHERE rn = 1) rcr ON pd.PostId = rcr.PostId
    WHERE
        pd.PostScore > 100 -- Filter for posts with very high score, regardless of user reputation
        AND pd.ViewCount > 5000 -- High view count
        AND pd.AnswerCount > 5 -- Many answers
        AND pd.PostCreationDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 year') -- Broader time frame for older, highly performing posts
        AND COALESCE(pd.UpvoteRatio, 0) > 0.5 -- Decent upvote ratio
        AND (pd.Title LIKE '%database%' OR pd.LatestCommentText LIKE '%performance%') -- Different string matching for diversity
)
ORDER BY
    UserEngagementScore DESC, PostQualityScore DESC, HotnessScore DESC -- Order combined results
LIMIT 500;