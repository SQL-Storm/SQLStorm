WITH UserStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.ViewCount,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) AS PostCount,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        AVG(p.Score) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate,
        CASE 
            WHEN u.Reputation > 10000 THEN 'Elite'
            WHEN u.Reputation > 5000 THEN 'Advanced'
            WHEN u.Reputation > 1000 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS ReputationLevel,
        STRING_AGG(DISTINCT SUBSTRING(p.Tags FROM 2 FOR CHAR_LENGTH(p.Tags)-2), ', ') AS AllTags
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= DATE '2010-01-01'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.ViewCount, u.UpVotes, u.DownVotes
),
TopUsers AS (
    SELECT 
        UserId,
        DisplayName,
        Reputation,
        PostCount,
        CommentCount,
        BadgeCount,
        AvgPostScore,
        LastPostDate,
        ReputationLevel,
        ROW_NUMBER() OVER (ORDER BY Reputation DESC, PostCount DESC) AS ReputationRank,
        ROW_NUMBER() OVER (ORDER BY PostCount DESC, Reputation DESC) AS ProductivityRank
    FROM UserStats
),
PostAnalysis AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        CASE 
            WHEN p.Score > 100 THEN 'Highly Upvoted'
            WHEN p.Score > 50 THEN 'Moderately Upvoted'
            WHEN p.Score > 0 THEN 'Slightly Upvoted'
            ELSE 'Downvoted or Neutral'
        END AS ScoreCategory,
        CASE 
            WHEN p.AnswerCount > 10 THEN 'Highly Active'
            WHEN p.AnswerCount > 5 THEN 'Moderately Active'
            WHEN p.AnswerCount > 0 THEN 'Low Activity'
            ELSE 'No Answers'
        END AS ActivityLevel,
        COALESCE(p.Tags, '') AS TagsStripped,
        (CASE WHEN p.Tags IS NULL OR p.Tags = '' THEN 0 ELSE (CHAR_LENGTH(p.Tags) - CHAR_LENGTH(REPLACE(p.Tags, '><', '')) + 1) END) AS TagCount,
        EXTRACT(YEAR FROM p.CreationDate) AS PostYear,
        EXTRACT(MONTH FROM p.CreationDate) AS PostMonth,
        (CAST(DATE '2024-10-01' AS DATE) - CAST(p.CreationDate AS DATE)) AS DaysSincePost
    FROM Posts p
    WHERE p.PostTypeId IN (1,2) AND p.CreationDate >= DATE '2015-01-01'
),
UserPostStats AS (
    SELECT 
        p.OwnerUserId AS UserId,
        COUNT(p.Id) AS TotalPosts,
        SUM(p.Score) AS TotalScore,
        AVG(p.Score) AS AvgScore,
        MAX(p.Score) AS MaxScore,
        MIN(p.Score) AS MinScore,
        STRING_AGG(p.Title, ' | ') AS AllTitles,
        STRING_AGG(COALESCE(p.Tags, ''), ' | ') AS AllTags
    FROM Posts p
    WHERE p.PostTypeId IN (1,2)
    GROUP BY p.OwnerUserId
),
CombinedAnalysis AS (
    SELECT 
        tu.UserId,
        tu.DisplayName,
        tu.Reputation,
        tu.PostCount,
        tu.CommentCount,
        tu.BadgeCount,
        tu.AvgPostScore,
        tu.ReputationLevel,
        tu.ReputationRank,
        tu.ProductivityRank,
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.AnswerCount,
        pa.CommentCount,
        pa.ScoreCategory,
        pa.ActivityLevel,
        pa.DaysSincePost,
        pa.TagCount,
        pa.PostYear,
        pa.PostMonth,
        ups.TotalPosts,
        ups.TotalScore,
        ups.AvgScore,
        ups.MaxScore,
        ups.MinScore,
        ups.AllTitles,
        ups.AllTags,
        CASE 
            WHEN tu.ReputationRank <= 10 THEN 'Top 10'
            WHEN tu.ReputationRank <= 50 THEN 'Top 50'
            ELSE 'Others'
        END AS ReputationTier,
        COUNT(*) OVER (PARTITION BY tu.UserId) AS UserPostCount,
        ROW_NUMBER() OVER (PARTITION BY tu.UserId ORDER BY pa.Score DESC) AS PostRankWithinUser,
        pa.CreationDate
    FROM TopUsers tu
    INNER JOIN PostAnalysis pa ON tu.UserId = pa.OwnerUserId
    LEFT JOIN UserPostStats ups ON tu.UserId = ups.UserId
    WHERE pa.Score > 0
)
SELECT 
    ca.UserId,
    ca.DisplayName,
    ca.Reputation,
    ca.PostCount,
    ca.CommentCount,
    ca.BadgeCount,
    ca.AvgPostScore,
    ca.ReputationLevel,
    ca.ReputationRank,
    ca.ProductivityRank,
    ca.PostId,
    ca.Title,
    ca.Score,
    ca.ViewCount,
    ca.AnswerCount,
    ca.CommentCount,
    ca.ScoreCategory,
    ca.ActivityLevel,
    ca.DaysSincePost,
    ca.TagCount,
    ca.PostYear,
    ca.PostMonth,
    ca.TotalPosts,
    ca.TotalScore,
    ca.AvgScore,
    ca.MaxScore,
    ca.MinScore,
    ca.ReputationTier,
    ca.UserPostCount,
    ca.PostRankWithinUser,
    CASE 
        WHEN ca.UserPostCount > 100 THEN 'Extremely Active'
        WHEN ca.UserPostCount > 50 THEN 'Very Active'
        WHEN ca.UserPostCount > 25 THEN 'Active'
        ELSE 'Regular'
    END AS PostingFrequency,
    CASE 
        WHEN ca.MaxScore > 1000 THEN 'Legend'
        WHEN ca.MaxScore > 500 THEN 'Veteran'
        WHEN ca.MaxScore > 100 THEN 'Experienced'
        ELSE 'Novice'
    END AS PostingSkillLevel,
    (ca.Reputation + ca.Score * 10 + ca.ViewCount) AS CompositeScore,
    CAST(100.0 * ca.PostRankWithinUser / NULLIF(ca.UserPostCount,0) AS DECIMAL(5,2)) AS PostRankPercentage,
    COALESCE(ca.AllTitles, 'No titles') AS UserFullTitles,
    COALESCE(ca.AllTags, 'No tags') AS UserFullTags,
    CASE 
        WHEN ca.PostYear = EXTRACT(YEAR FROM DATE '2024-10-01') AND ca.PostMonth = EXTRACT(MONTH FROM DATE '2024-10-01') 
        THEN 'This Month'
        WHEN ca.PostYear = EXTRACT(YEAR FROM DATE '2024-10-01') AND ca.PostMonth = EXTRACT(MONTH FROM DATE '2024-10-01') - 1
        THEN 'Last Month'
        ELSE 'Older'
    END AS RecencyCategory,
    LAG(ca.Score, 1) OVER (PARTITION BY ca.UserId ORDER BY ca.CreationDate) AS PrevScore,
    LEAD(ca.Score, 1) OVER (PARTITION BY ca.UserId ORDER BY ca.CreationDate) AS NextScore,
    AVG(ca.Score) OVER (PARTITION BY ca.UserId) AS UserAvgScore,
    STDDEV_POP(ca.Score) OVER (PARTITION BY ca.UserId) AS UserScoreStdDev,
    PERCENT_RANK() OVER (ORDER BY ca.Score) AS ScorePercentile,
    ROW_NUMBER() OVER (ORDER BY ca.Score DESC) AS GlobalScoreRank,
    COUNT(*) OVER () AS TotalResults,
    CASE 
        WHEN ca.ReputationRank <= 10 AND ca.PostRankWithinUser <= 1 AND ca.DaysSincePost <= 30
        THEN 'Elite Top Performer'
        WHEN ca.ReputationRank <= 50 AND ca.PostRankWithinUser <= 5 AND ca.DaysSincePost <= 60
        THEN 'High Performer'
        ELSE 'Standard'
    END AS PerformanceCategory
FROM CombinedAnalysis ca
WHERE ca.Reputation > 1000 
    AND ca.Score > 10
    AND (ca.ScoreCategory IN ('Highly Upvoted','Moderately Upvoted'))
    AND (ca.ActivityLevel IN ('Highly Active','Moderately Active'))
ORDER BY ca.Score DESC, ca.Reputation DESC, ca.PostCount DESC
LIMIT 1000;