WITH UserEngagementStats AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate,
        U.LastAccessDate,
        EXTRACT(EPOCH FROM (U.LastAccessDate - U.CreationDate)) / (60 * 60 * 24.0 * 365.25) AS AccountAgeYears,
        COALESCE(SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END), 0) AS QuestionsPosted,
        COALESCE(SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END), 0) AS AnswersPosted,
        COUNT(DISTINCT C.Id) AS CommentsMade,
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS TotalUpVotesGiven,
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS TotalDownVotesGiven,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        MAX(B.Date) AS LastBadgeDate,
        MIN(P.CreationDate) AS FirstPostDate,
        MAX(P.CreationDate) AS LastPostDate,
        SUM(CASE WHEN B.Date < U.LastAccessDate THEN 1 ELSE 0 END) AS BadgesBeforeLastAccess,
        RANK() OVER (PARTITION BY EXTRACT(YEAR FROM U.CreationDate) ORDER BY U.Reputation DESC) AS RankInCreationYear
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate
),
PostEditTimings AS (
    SELECT
        PH.PostId,
        PH.CreationDate AS CurrentEditDate,
        LAG(PH.CreationDate, 1, PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PreviousEditDate,
        PH.PostHistoryTypeId,
        ROW_NUMBER() OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate DESC) AS rn_latest_edit
    FROM PostHistory PH
    WHERE PH.PostHistoryTypeId IN (4, 5, 6)
),
PostMetricsAndActivity AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.OwnerUserId,
        P.Title,
        P.Tags,
        P.AnswerCount,
        P.CommentCount AS DirectCommentCount,
        P.FavoriteCount,
        P.ClosedDate,
        COUNT(DISTINCT PH_Edit.Id) FILTER (WHERE PH_Edit.PostHistoryTypeId IN (4, 5, 6)) AS EditCount,
        COUNT(DISTINCT PH_Close.Id) FILTER (WHERE PH_Close.PostHistoryTypeId = 10) AS CloseEventCount,
        MAX(PH_Activity.CreationDate) AS LastActivityFromHistory,
        COALESCE(MAX(C.CreationDate), P.LastActivityDate) AS LastInteractionDate,
        (SELECT AVG(C_sub.Score) FROM Comments C_sub WHERE C_sub.PostId = P.Id AND C_sub.Score IS NOT NULL) AS AvgCommentScore,
        STRING_AGG(DISTINCT LT.Name, ';') FILTER (WHERE PL.Id IS NOT NULL) AS LinkedPostTypes,
        CASE
            WHEN P.PostTypeId = 1 AND P.ClosedDate IS NOT NULL THEN 'Closed Question'
            WHEN P.PostTypeId = 1 AND P.AcceptedAnswerId IS NOT NULL THEN 'Answered Question'
            WHEN P.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other Post Type'
        END AS PostStatusCategory,
        array_length(string_to_array(substring(P.Tags, 2, length(P.Tags)-2), '><'), 1) AS TagCount,
        PH_LatestEdit.CurrentEditDate AS LatestEditDate,
        (SELECT AVG(EXTRACT(EPOCH FROM (PET_sub.CurrentEditDate - PET_sub.PreviousEditDate)) / (60*60*24.0))
         FROM PostEditTimings PET_sub
         WHERE PET_sub.PostId = P.Id AND PET_sub.PreviousEditDate != PET_sub.CurrentEditDate) AS AvgDaysBetweenEdits
    FROM Posts P
    LEFT JOIN PostHistory PH_Edit ON P.Id = PH_Edit.PostId AND PH_Edit.PostHistoryTypeId IN (4, 5, 6)
    LEFT JOIN PostHistory PH_Close ON P.Id = PH_Close.PostId AND PH_Close.PostHistoryTypeId = 10
    LEFT JOIN PostHistory PH_Activity ON P.Id = PH_Activity.PostId
    LEFT JOIN Comments C ON P.Id = C.PostId
    LEFT JOIN PostLinks PL ON P.Id = PL.PostId OR P.Id = PL.RelatedPostId
    LEFT JOIN LinkTypes LT ON PL.LinkTypeId = LT.Id
    LEFT JOIN (SELECT PostId, CurrentEditDate FROM PostEditTimings WHERE rn_latest_edit = 1) AS PH_LatestEdit ON P.Id = PH_LatestEdit.PostId
    WHERE P.Tags IS NULL OR LENGTH(TRIM(P.Tags)) > 2
    GROUP BY P.Id, P.PostTypeId, P.CreationDate, P.Score, P.ViewCount, P.OwnerUserId, P.Title, P.Tags, P.AnswerCount, P.CommentCount, P.FavoriteCount, P.ClosedDate, P.LastActivityDate, PH_LatestEdit.CurrentEditDate, P.AcceptedAnswerId
),
TopUsersWithRecentActivity AS (
    SELECT
        UES.UserId,
        UES.DisplayName,
        UES.Reputation,
        UES.AccountAgeYears,
        UES.TotalBadges,
        UES.QuestionsPosted,
        UES.AnswersPosted,
        UES.BadgesBeforeLastAccess,
        UES.RankInCreationYear,
        UES.CreationDate,
        UES.LastAccessDate,
        ROW_NUMBER() OVER (ORDER BY UES.Reputation DESC, UES.LastAccessDate DESC) AS UserRankByReputation,
        AVG(PMA.PostScore) OVER (PARTITION BY UES.UserId) AS AvgPostScore,
        SUM(PMA.EditCount) OVER (PARTITION BY UES.UserId) AS TotalEditsByOwner,
        NTILE(5) OVER (ORDER BY UES.Reputation DESC) AS ReputationQuintile
    FROM UserEngagementStats UES
    LEFT JOIN PostMetricsAndActivity PMA ON UES.UserId = PMA.OwnerUserId
    WHERE UES.Reputation > 5000 AND UES.LastAccessDate > DATE '2023-01-01'
)
SELECT
    TU.DisplayName AS User_DisplayName,
    TU.Reputation AS User_Reputation,
    TU.UserRankByReputation,
    TU.AccountAgeYears,
    TU.TotalBadges,
    TU.QuestionsPosted,
    TU.AnswersPosted,
    TU.AvgPostScore AS User_AvgPostScore,
    TU.TotalEditsByOwner,
    PMA.PostId,
    PMA.Title AS Post_Title,
    PMA.PostStatusCategory,
    PMA.PostCreationDate,
    PMA.PostScore AS Post_Score,
    PMA.ViewCount AS Post_ViewCount,
    PMA.EditCount AS Post_EditCount,
    PMA.CloseEventCount,
    PMA.AvgCommentScore,
    PMA.TagCount,
    PMA.LinkedPostTypes,
    COALESCE(PMA.FavoriteCount, 0) AS ActualFavoriteCount,
    (PMA.PostScore * 0.5 + COALESCE(PMA.ViewCount,0) * 0.1 + COALESCE(PMA.DirectCommentCount,0) * 0.3) AS EngagementScore,
    CASE
        WHEN PMA.Tags ILIKE '%<sql>%' OR PMA.Tags ILIKE '%<database>%' THEN 'Database Related'
        WHEN PMA.Tags ILIKE '%<javascript>%' OR PMA.Tags ILIKE '%<node.js>%' THEN 'Web Dev Related'
        WHEN PMA.Tags IS NULL OR LENGTH(TRIM(PMA.Tags)) <= 2 THEN 'Untagged/Generic'
        ELSE 'Other Category'
    END AS TagCategory,
    PMA.AvgDaysBetweenEdits
FROM TopUsersWithRecentActivity TU
INNER JOIN PostMetricsAndActivity PMA ON TU.UserId = PMA.OwnerUserId
WHERE
    PMA.PostScore > 10
    AND PMA.ViewCount > 1000
    AND PMA.PostCreationDate BETWEEN TU.CreationDate AND TU.LastAccessDate
    AND (
        PMA.Tags ILIKE '%<performance>%' OR PMA.Tags ILIKE '%<optimization>%' OR PMA.EditCount > 2
    )
    AND NOT EXISTS (
        SELECT 1
        FROM PostHistory PH_Del
        WHERE PH_Del.PostId = PMA.PostId
          AND PH_Del.PostHistoryTypeId = 12
          AND PH_Del.CreationDate > PMA.PostCreationDate
    )

UNION ALL

SELECT
    NULL AS User_DisplayName,
    UES.Reputation AS User_Reputation,
    NULL AS UserRankByReputation,
    UES.AccountAgeYears,
    UES.TotalBadges,
    UES.QuestionsPosted,
    UES.AnswersPosted,
    (SELECT AVG(P_sub.Score) FROM Posts P_sub WHERE P_sub.OwnerUserId = UES.UserId AND P_sub.Score IS NOT NULL) AS User_AvgPostScore,
    (SELECT COUNT(*) FROM PostHistory PH_Edit_sub WHERE PH_Edit_sub.UserId = UES.UserId AND PH_Edit_sub.PostHistoryTypeId IN (4,5,6)) AS TotalEditsByOwner,
    PMA.PostId,
    PMA.Title AS Post_Title,
    PMA.PostStatusCategory,
    PMA.PostCreationDate,
    PMA.PostScore AS Post_Score,
    PMA.ViewCount AS Post_ViewCount,
    PMA.EditCount AS Post_EditCount,
    PMA.CloseEventCount,
    PMA.AvgCommentScore,
    PMA.TagCount,
    PMA.LinkedPostTypes,
    COALESCE(PMA.FavoriteCount,0) AS ActualFavoriteCount,
    (PMA.PostScore * 0.7 + COALESCE(PMA.DirectCommentCount,0) * 0.2) AS EngagementScore,
    CASE
        WHEN PMA.Tags ILIKE '%<security>%' OR PMA.Tags ILIKE '%<vulnerability>%' THEN 'Security Related'
        WHEN PMA.Tags ILIKE '%<python>%' THEN 'Python Related'
        ELSE 'Other Specific Tag Category'
    END AS TagCategory,
    PMA.AvgDaysBetweenEdits
FROM Users U
INNER JOIN UserEngagementStats UES ON U.Id = UES.UserId
INNER JOIN PostMetricsAndActivity PMA ON U.Id = PMA.OwnerUserId
WHERE
    U.Reputation < 5000
    AND PMA.PostTypeId = 1
    AND PMA.ClosedDate IS NULL
    AND PMA.PostScore BETWEEN 5 AND 20
    AND PMA.PostCreationDate > (DATE '2024-10-01' - INTERVAL '1 year')
    AND PMA.Title LIKE '%error%'
    AND PMA.OwnerUserId IS NOT NULL
ORDER BY User_Reputation DESC, Post_Score DESC
LIMIT 10000;