WITH RECURSIVE RecursiveTagHierarchy AS (
    SELECT
        t.Id,
        t.TagName,
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        ARRAY[t.TagName] AS TagPath
    FROM
        Tags t
        JOIN Posts p ON p.Tags LIKE '%' || '<' || t.TagName || '>' || '%'
    WHERE
        p.PostTypeId = 1
    UNION ALL
    SELECT
        rh.Id,
        rh.TagName,
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.OwnerUserId,
        rh.TagPath || t2.TagName
    FROM
        RecursiveTagHierarchy rh
        JOIN Posts p ON p.ParentId = rh.PostId
        JOIN Tags t2 ON p.Tags LIKE '%' || '<' || t2.TagName || '>' || '%'
    WHERE
        p.PostTypeId = 2
),
UserRanks AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT b.Id) AS BadgeCount,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, COUNT(DISTINCT b.Id) DESC) AS Rank,
        COALESCE((
          SELECT AVG(p.Score)
          FROM Posts p
          WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1
        ), 0) AS AvgQuestionScore,
        COALESCE((
          SELECT AVG(p.Score)
          FROM Posts p
          WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2
        ), 0) AS AvgAnswerScore
    FROM
        Users u
        LEFT JOIN Badges b ON b.UserId = u.Id
    GROUP BY
        u.Id, u.DisplayName, u.Reputation
),
PostStatistics AS (
    SELECT
        p.Id,
        p.PostTypeId,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        p.Tags,
        p.OwnerUserId,
        p.AcceptedAnswerId,
        COUNT(DISTINCT c.Id) AS CommentCount,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 2) AS UpVotes,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.VoteTypeId = 3) AS DownVotes,
        MAX(ph.CreationDate) AS LastEditDate,
        CASE 
            WHEN EXISTS (
                SELECT 1 FROM PostLinks pl WHERE pl.PostId = p.Id AND pl.LinkTypeId = 3
            ) THEN 1 ELSE 0 END AS IsMarkedDuplicate,
        ROW_NUMBER() OVER (
            PARTITION BY p.Tags ORDER BY p.Score DESC, p.ViewCount DESC
        ) AS TagScoreRank
    FROM
        Posts p
        LEFT JOIN Comments c ON c.PostId = p.Id
        LEFT JOIN Votes v ON v.PostId = p.Id
        LEFT JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId IN (4,5,6,7,8,9)
    WHERE
        p.PostTypeId IN (1, 2)
    GROUP BY
        p.Id, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount, p.Tags, p.OwnerUserId, p.AcceptedAnswerId
),
PopularTags AS (
    SELECT
        t.Id,
        t.TagName,
        t.Count,
        COALESCE(pst.SumScores,0) AS TotalPostScore,
        COALESCE(pst.AvgPostScore,0) AS AvgPostScore,
        COALESCE(pst.TotalPosts,0) AS TotalPosts,
        COALESCE(pst.TotalViews,0) AS TotalViews
    FROM
        Tags t
        LEFT JOIN (
            SELECT
                unnest(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) AS TagName,
                SUM(p.Score) AS SumScores,
                AVG(p.Score) AS AvgPostScore,
                COUNT(*) AS TotalPosts,
                SUM(p.ViewCount) AS TotalViews
            FROM Posts p
            WHERE p.PostTypeId = 1
            GROUP BY TagName
        ) pst ON pst.TagName = t.TagName
),
DuplicateQuestionPairs AS (
    SELECT
        pl.PostId AS DuplicateQuestionId,
        pl.RelatedPostId AS OriginalQuestionId,
        p1.Title AS DuplicateTitle,
        p2.Title AS OriginalTitle,
        pl.CreationDate AS LinkCreated
    FROM
        PostLinks pl
        JOIN Posts p1 ON p1.Id = pl.PostId AND p1.PostTypeId = 1
        JOIN Posts p2 ON p2.Id = pl.RelatedPostId AND p2.PostTypeId = 1
    WHERE
        pl.LinkTypeId = 3
),
QuestionsWithCloseReasons AS (
    SELECT
        p.Id AS QuestionId,
        p.Title,
        p.ClosedDate,
        crt.Name AS CloseReason,
        ph.CreationDate AS CloseVoteDate,
        (SELECT COUNT(*) FROM PostHistory ph2 WHERE ph2.PostId = p.Id AND ph2.PostHistoryTypeId = 10) AS CloseVoteCount
    FROM
        Posts p
        LEFT JOIN PostHistory ph ON ph.PostId = p.Id AND ph.PostHistoryTypeId = 10
        LEFT JOIN CloseReasonTypes crt ON crt.Id = CAST(ph.Comment AS SMALLINT)
    WHERE
        p.PostTypeId = 1
        AND p.ClosedDate IS NOT NULL
),
UserActivityWindow AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        p.Id AS PostId,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate AS PostCreationDate,
        LEAD(p.CreationDate) OVER (PARTITION BY u.Id ORDER BY p.CreationDate) AS NextPostDate,
        LAG(p.CreationDate) OVER (PARTITION BY u.Id ORDER BY p.CreationDate) AS PrevPostDate,
        ROW_NUMBER() OVER (PARTITION BY u.Id ORDER BY p.CreationDate DESC) AS RecentRank
    FROM
        Users u
        LEFT JOIN Posts p ON p.OwnerUserId = u.Id
),
StrAggTags AS (
    SELECT
        p.Id AS PostId,
        string_agg(DISTINCT t.TagName, ', ' ORDER BY t.TagName) AS AggregatedTags
    FROM
        Posts p
        CROSS JOIN LATERAL (
            SELECT unnest(string_to_array(substring(p.Tags, 2, length(p.Tags) - 2), '><')) AS TagName
        ) t
    GROUP BY p.Id
)
SELECT
    pr.UserId,
    pr.DisplayName,
    pr.Reputation,
    pr.BadgeCount,
    pr.GoldBadges,
    pr.SilverBadges,
    pr.BronzeBadges,
    CAST(pr.AvgQuestionScore AS NUMERIC(10,2)) AS AvgQuestionScore,
    CAST(pr.AvgAnswerScore AS NUMERIC(10,2)) AS AvgAnswerScore,
    ps.Id AS PostId,
    ps.PostTypeId,
    ps.Score AS PostScore,
    ps.ViewCount,
    COALESCE(sa.AggregatedTags, '') AS PostTags,
    ps.CommentCount,
    ps.UpVotes,
    ps.DownVotes,
    ps.IsMarkedDuplicate,
    dq.DuplicateTitle,
    dq.OriginalTitle,
    dq.LinkCreated,
    qc.CloseReason,
    qc.CloseVoteCount,
    ua.PostCreationDate,
    ua.NextPostDate,
    ua.PrevPostDate,
    ua.RecentRank,
    phc.Name AS LastHistoryType
FROM
    UserRanks pr
    LEFT JOIN PostStatistics ps ON ps.OwnerUserId = pr.UserId
    LEFT JOIN StrAggTags sa ON sa.PostId = ps.Id
    LEFT JOIN DuplicateQuestionPairs dq ON dq.DuplicateQuestionId = ps.Id
    LEFT JOIN QuestionsWithCloseReasons qc ON qc.QuestionId = ps.Id
    LEFT JOIN UserActivityWindow ua ON ua.UserId = pr.UserId AND ua.PostId = ps.Id
    LEFT JOIN LATERAL (
        SELECT phth.Name
        FROM PostHistory phh
        JOIN PostHistoryTypes phth ON phh.PostHistoryTypeId = phth.Id
        WHERE phh.PostId = ps.Id
        ORDER BY phh.CreationDate DESC
        LIMIT 1
    ) phc ON TRUE
WHERE
    pr.Rank <= 100
    AND ps.PostTypeId = 1
    AND ps.Score >= (
        SELECT percentile_cont(0.75) WITHIN GROUP (ORDER BY Score)
        FROM Posts
        WHERE PostTypeId = 1
    )
ORDER BY
    pr.Reputation DESC,
    ps.Score DESC,
    ps.ViewCount DESC
LIMIT 500;