-- {"query": "5196.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 1093} 
WITH per_user_activity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    COUNT(p.Id) AS PostsCreated,
    SUM(p.Score) AS ScoreTotal,
    COUNT(DISTINCT c.Id) AS CommentCount,
    AVG(p.ViewCount) AS AvgViews,
    MAX(p.LastActivityDate) AS LastActivity
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  LEFT JOIN Comments c ON c.UserId = u.Id
  WHERE u.Id > 0
  GROUP BY u.Id, u.DisplayName
),
recent_history AS (
  SELECT
    ph.PostId,
    ph.UserId,
    ph.CreationDate,
    ph.PostHistoryTypeId,
    ph.Comment,
    ph.Text,
    ph.RevisionGUID,
    ph.ContentLicense
  FROM PostHistory ph
  WHERE ph.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
),
post_stats AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.PostTypeId,
    p.Title,
    p.Tags,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.CreationDate,
    p.LastActivityDate,
    p.ClosedDate,
    p.ParentId,
    p.AcceptedAnswerId,
    -- compute a complex derived metric
    (COALESCE(p.ViewCount,0) * 0.25 + COALESCE(p.Score,0) * 1.75 + COALESCE(p.AnswerCount,0) * 3.0) AS EngagementScore
  FROM Posts p
),
tag_burst AS (
  SELECT
    t.TagName,
    COUNT(*) AS TagPostCount,
    AVG(p.Score) AS AvgPostScore
  FROM Tags t
  JOIN Posts p ON p.Tags LIKE '%' || t.TagName || '%'
  WHERE p.PostTypeId = 1
  GROUP BY t.TagName
  HAVING COUNT(*) > 5
),
expensive_joins AS (
  SELECT
    p1.Id AS P1,
    p2.Id AS P2,
    p1.Title AS Title1,
    p2.Title AS Title2,
    p1.Tags AS Tags1,
    p2.Tags AS Tags2,
    p1.Score + p2.Score AS CombinedScore
  FROM Posts p1
  LEFT JOIN Posts p2 ON p2.OwnerUserId = p1.OwnerUserId
  WHERE p1.PostTypeId = 1
    AND p2.PostTypeId = 1
    AND p1.Id <> p2.Id
    AND p1.LastActivityDate > p2.LastActivityDate - INTERVAL '30 days'
),
windowed_summary AS (
  SELECT
    ps.PostId,
    ps.OwnerUserId,
    ps.PostTypeId,
    ps.Title,
    ps.Tags,
    ps.Score,
    ps.ViewCount,
    ps.AnswerCount,
    ps.CommentCount,
    ps.FavoriteCount,
    ps.CreationDate,
    ps.LastActivityDate,
    ps.ClosedDate,
    ps.ParentId,
    ps.AcceptedAnswerId,
    ps.EngagementScore,
    ROW_NUMBER() OVER (PARTITION BY ps.OwnerUserId ORDER BY ps.EngagementScore DESC, ps.LastActivityDate DESC) AS rn_by_owner,
    RANK() OVER (ORDER BY ps.EngagementScore DESC) AS global_rank
  FROM post_stats ps
)
SELECT
  u.Id AS UserId,
  u.DisplayName,
  pu.PostsCreated,
  pu.ScoreTotal,
  pu.CommentCount AS UserCommentCount,
  pu.AvgViews AS UserAvgViews,
  pu.LastActivity,
  ws.PostId,
  ws.Title AS PostTitle,
  ws.Tags AS PostTags,
  ws.Score AS PostScore,
  ws.ViewCount AS PostViews,
  ws.AnswerCount AS PostAnswers,
  ws.CommentCount AS PostComments,
  ws.FavoriteCount AS PostFavorites,
  ws.CreationDate AS PostCreationDate,
  ws.LastActivityDate AS PostLastActivityDate,
  es.EngagementScore,
  eb.Title1,
  eb.Title2,
  tb.TagName AS TopTagName,
  eb.CombinedScore
FROM windowed_summary ws
JOIN per_user_activity pu ON pu.UserId = ws.OwnerUserId
JOIN Users u ON u.Id = ws.OwnerUserId
LEFT JOIN expensive_joins ej ON ej.P1 = ws.PostId OR ej.P2 = ws.PostId
LEFT JOIN (SELECT 1 AS dummy, Title1, Title2, CombinedScore FROM expensive_joins LIMIT 0) eb ON 1=0
LEFT JOIN (
  SELECT
    MAX(Title1) AS Title1,
    MAX(Title2) AS Title2,
    MAX(CombinedScore) AS CombinedScore
  FROM expensive_joins
) es ON 1=1
LEFT JOIN (
  SELECT TagName FROM tag_burst ORDER BY AVGPostScore DESC LIMIT 1
) tb ON 1=1
WHERE ws.rn_by_owner <= 5
ORDER BY ws.global_rank, pu.ScoreTotal DESC
;