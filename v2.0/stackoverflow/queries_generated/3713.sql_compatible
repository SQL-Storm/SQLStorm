WITH
    UserStats AS (
        SELECT
            u.Id,
            u.DisplayName,
            u.Reputation,
            COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS VoteBalance,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
            (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
            (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
            (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
            (SELECT COALESCE(SUM(v.Score), 0)
               FROM Votes v
               JOIN Posts p ON v.PostId = p.Id
               WHERE p.OwnerUserId = u.Id AND v.VoteTypeId = 2) AS UpVoteReceived,
            (SELECT COALESCE(SUM(v.Score), 0)
               FROM Votes v
               JOIN Posts p ON v.PostId = p.Id
               WHERE p.OwnerUserId = u.Id AND v.VoteTypeId = 3) AS DownVoteReceived
        FROM Users u
    ),

    TagStats AS (
        SELECT
            t.TagName,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionWithTag,
            COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerWithTag,
            AVG(p.Score) AS AvgScore,
            ROW_NUMBER() OVER (ORDER BY COUNT(p.Id) DESC) AS TagRank
        FROM Tags t
        LEFT JOIN Posts p
               ON p.Tags LIKE CONCAT('%<', t.TagName, '>%')
        GROUP BY t.TagName
    ),

    UserTagActivity AS (
        SELECT
            us.Id,
            us.DisplayName,
            ts.TagName,
            COUNT(p.Id) AS PostsWithTag,
            MAX(p.Score) AS MaxScore,
            STRING_AGG(DISTINCT p.Title, '; ') FILTER (WHERE p.Title IS NOT NULL) AS SampleTitles
        FROM UserStats us
        JOIN Posts p
          ON p.OwnerUserId = us.Id
        JOIN LATERAL (
                SELECT UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<>' FROM p.Tags), '><')) AS TagName
        ) pt ON true
        JOIN TagStats ts
          ON ts.TagName = pt.TagName
        WHERE p.PostTypeId = 1
        GROUP BY us.Id, us.DisplayName, ts.TagName
        HAVING COUNT(p.Id) > 5
    ),

    TopUsers AS (
        SELECT
            us.Id,
            us.DisplayName,
            us.Reputation,
            us.GoldBadges,
            us.SilverBadges,
            us.BronzeBadges,
            us.QuestionCount,
            us.AnswerCount,
            us.VoteBalance,
            us.UpVoteReceived,
            us.DownVoteReceived,
            ROW_NUMBER() OVER (ORDER BY us.Reputation DESC, us.GoldBadges DESC) AS ReputationRank,
            (us.GoldBadges * 100 + us.SilverBadges * 10 + us.BronzeBadges) AS BadgeScore,
            (us.QuestionCount * 2 + us.AnswerCount) AS ActivityScore,
            (us.UpVoteReceived - COALESCE(us.DownVoteReceived, 0)) AS NetReceivedVotes
        FROM UserStats us
    ),

    FinalRanking AS (
        SELECT
            tu.Id,
            tu.DisplayName,
            tu.Reputation,
            tu.GoldBadges,
            tu.SilverBadges,
            tu.BronzeBadges,
            tu.QuestionCount,
            tu.AnswerCount,
            tu.VoteBalance,
            tu.BadgeScore,
            tu.ActivityScore,
            tu.NetReceivedVotes,
            tu.ReputationRank,
            CASE
                WHEN tu.ReputationRank <= 10 THEN 'Top10'
                WHEN tu.ReputationRank <= 100 THEN 'Top100'
                ELSE 'Other'
            END AS Tier,
            COALESCE(uta.TagName, 'NoTag') AS FavoriteTag,
            COALESCE(uta.PostsWithTag, 0) AS PostsInFavTag,
            COALESCE(uta.MaxScore, 0) AS MaxScoreInFavTag,
            COALESCE(uta.SampleTitles, '') AS SampleTitles
        FROM TopUsers tu
        LEFT JOIN LATERAL (
                SELECT ut.TagName, ut.PostsWithTag, ut.MaxScore, ut.SampleTitles
                FROM UserTagActivity ut
                WHERE ut.Id = tu.Id
                ORDER BY ut.PostsWithTag DESC
                LIMIT 1
        ) uta ON true
    )

SELECT *
FROM FinalRanking
WHERE (BadgeScore > 0 OR ActivityScore > 0)

UNION ALL

SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    0 AS GoldBadges,
    0 AS SilverBadges,
    0 AS BronzeBadges,
    0 AS QuestionCount,
    0 AS AnswerCount,
    COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS VoteBalance,
    0 AS BadgeScore,
    0 AS ActivityScore,
    0 AS NetReceivedVotes,
    CAST(NULL AS INTEGER) AS ReputationRank,
    'NoPosts' AS Tier,
    NULL AS FavoriteTag,
    0 AS PostsInFavTag,
    0 AS MaxScoreInFavTag,
    '' AS SampleTitles
FROM Users u
WHERE NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id)
  AND EXISTS (SELECT 1 FROM Badges b WHERE b.UserId = u.Id)

ORDER BY ReputationRank NULLS LAST, BadgeScore DESC, ActivityScore DESC
LIMIT 100;