WITH RelevantPosts AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.OwnerUserId,
    p.CreationDate AS PostCreationDate,
    p.Score AS PostScore,
    p.ViewCount AS PostViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.ClosedDate,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation AS OwnerReputation,
    u.CreationDate AS OwnerCreationDate,
    ROW_NUMBER() OVER (PARTITION BY p.PostTypeId ORDER BY p.Score DESC, p.CreationDate DESC) AS rn_by_type_score,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) OVER (PARTITION BY p.Id) AS UpVoteCount,
    COUNT(c.Id) OVER (PARTITION BY p.Id) AS CommentCountOver,
    LAG(p.Score, 1, 0) OVER (ORDER BY p.CreationDate) AS PreviousDayScore
  FROM Posts AS p
  LEFT JOIN Users AS u
    ON p.OwnerUserId = u.Id
  LEFT JOIN Votes AS v
    ON p.Id = v.PostId
  LEFT JOIN Comments AS c
    ON p.Id = c.PostId
  WHERE
    p.PostTypeId IN (1, 2) AND p.CreationDate >= '2023-01-01'
  GROUP BY
    p.Id,
    p.PostTypeId,
    p.OwnerUserId,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.ClosedDate,
    u.DisplayName,
    u.Reputation,
    u.CreationDate
), RankedQuestions AS (
  SELECT
    rp.PostId,
    rp.PostTypeId,
    rp.PostScore,
    rp.OwnerDisplayName,
    rp.OwnerReputation,
    rp.OwnerCreationDate,
    rp.UpVoteCount,
    rp.CommentCountOver,
    rp.PostViewCount,
    rp.PostCreationDate,
    (rp.PostScore * 1.5) + (rp.UpVoteCount * 0.8) + (rp.CommentCountOver * 0.2) AS CompositeScore,
    CASE WHEN rp.ClosedDate IS NOT NULL THEN 'Closed' ELSE 'Open' END AS PostStatus
  FROM RelevantPosts AS rp
  WHERE
    rp.PostTypeId = 1 AND rp.rn_by_type_score <= 100
), RankedAnswers AS (
  SELECT
    rp.PostId,
    rp.PostTypeId,
    rp.PostScore,
    rp.OwnerDisplayName,
    rp.OwnerReputation,
    rp.OwnerCreationDate,
    rp.UpVoteCount,
    rp.CommentCountOver,
    rp.PostViewCount,
    rp.PostCreationDate,
    CASE
      WHEN EXISTS (
        SELECT
          1
        FROM Posts AS q
        WHERE
          q.Id = (
            SELECT
              ParentId
            FROM Posts AS a
            WHERE
              a.Id = rp.PostId
          ) AND q.AcceptedAnswerId = rp.PostId
      ) THEN 'Accepted'
      ELSE 'Not Accepted'
    END AS AnswerStatus
  FROM RelevantPosts AS rp
  WHERE
    rp.PostTypeId = 2 AND rp.rn_by_type_score <= 200
), UserActivity AS (
  SELECT
    UserId,
    COUNT(Id) AS VoteCount,
    SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
    SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
    MAX(CreationDate) AS LastVoteDate
  FROM Votes
  WHERE
    CreationDate >= DATE_SUB(cast('2024-10-01 12:34:56' as timestamp), INTERVAL 1 YEAR)
  GROUP BY
    UserId
  HAVING
    COUNT(Id) > 10
), UserPostAnalysis AS (
  SELECT
    p.OwnerUserId,
    COUNT(p.Id) AS PostCount,
    AVG(p.Score) AS AvgScore,
    SUM(p.AnswerCount) AS TotalAnswerCount,
    SUM(p.CommentCount) AS TotalCommentCount
  FROM Posts AS p
  WHERE
    p.OwnerUserId IS NOT NULL AND p.OwnerUserId > 0
  GROUP BY
    p.OwnerUserId
)
SELECT
  rq.PostId AS QuestionId,
  rq.PostScore AS QuestionScore,
  rq.OwnerDisplayName AS QuestionOwner,
  rq.OwnerReputation AS QuestionOwnerReputation,
  rq.UpVoteCount AS QuestionUpVotes,
  rq.CommentCountOver AS QuestionComments,
  rq.PostViewCount AS QuestionViews,
  rq.PostCreationDate AS QuestionDate,
  rq.PostStatus AS QuestionStatus,
  ra.PostId AS BestAnswerId,
  ra.PostScore AS BestAnswerScore,
  ra.OwnerDisplayName AS BestAnswerOwner,
  ra.OwnerReputation AS BestAnswerOwnerReputation,
  ra.UpVoteCount AS BestAnswerUpVotes,
  ra.CommentCountOver AS BestAnswerComments,
  ua.VoteCount AS UserTotalVotesLastYear,
  upa.PostCount AS UserTotalPosts,
  upa.AvgScore AS UserAvgPostScore,
  CASE
    WHEN rq.CompositeScore > 1000 AND ra.AnswerStatus = 'Accepted' AND LENGTH(rq.OwnerDisplayName) > 5 AND SUBSTRING(rq.OwnerDisplayName, 1, 3) <> 'An ' THEN 'High Engagement Question'
    WHEN rq.PostStatus = 'Closed' AND ra.PostScore < 0 THEN 'Problematic Closed Question'
    WHEN ra.AnswerStatus = 'Accepted' AND ra.PostScore > 50 THEN 'Highly Valued Answer'
    ELSE 'Standard Post'
  END AS PerformanceCategory
FROM RankedQuestions AS rq
LEFT JOIN RankedAnswers AS ra
  ON rq.PostId = (
    SELECT
      AcceptedAnswerId
    FROM Posts
    WHERE
      Id = rq.PostId
  )
LEFT JOIN UserActivity AS ua
  ON rq.OwnerUserId = ua.UserId
LEFT JOIN UserPostAnalysis AS upa
  ON rq.OwnerUserId = upa.OwnerUserId
WHERE
  rq.PostScore > 10 OR ra.PostScore > 5 OR rq.UpVoteCount > 10 OR ra.UpVoteCount > 5 OR ua.VoteCount IS NOT NULL
ORDER BY
  rq.CompositeScore DESC,
  ra.PostScore DESC,
  rq.PostCreationDate DESC
LIMIT 100;