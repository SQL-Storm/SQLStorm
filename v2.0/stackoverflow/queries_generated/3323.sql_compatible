WITH 
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.UpVotes,0) - COALESCE(u.DownVotes,0) AS NetVotes,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
        AVG(CASE WHEN p.PostTypeId IN (1,2) THEN p.Score END) AS AvgPostScore,
        MAX(p.CreationDate) AS LastPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.UpVotes, u.DownVotes
),
BadgeAgg AS (
    SELECT 
        b.UserId,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        COUNT(*) AS TotalBadges
    FROM Badges b
    GROUP BY b.UserId
),
TagContrib AS (
    SELECT 
        p.OwnerUserId AS UserId,
        t.TagName,
        COUNT(*) AS TagPostCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId 
                           ORDER BY COUNT(*) DESC) AS rn
    FROM Posts p
    JOIN LATERAL (
        SELECT trim(both '<>' FROM p.Tags) AS cleaned_tags
    ) ct ON p.Tags IS NOT NULL
    JOIN LATERAL (
        SELECT value AS tag FROM (
            SELECT UNNEST(string_to_array(ct.cleaned_tags, '><')) AS value
        ) s
    ) tname ON TRUE
    JOIN Tags t ON t.TagName = tname.tag
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId, t.TagName
),
RecentVotes AS (
    SELECT 
        v.PostId,
        v.VoteTypeId,
        v.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY v.PostId ORDER BY v.CreationDate DESC) AS rn
    FROM Votes v
    WHERE v.CreationDate >= (CAST('2024-10-01' AS date) - INTERVAL '30 days')
)

SELECT 
    us.Id,
    us.DisplayName,
    us.Reputation,
    us.NetVotes,
    us.QuestionCount,
    us.AnswerCount,
    ROUND(CAST(us.AvgPostScore AS numeric), 2) AS AvgPostScore,
    us.LastPostDate,
    COALESCE(ba.GoldBadges,   0) AS GoldBadges,
    COALESCE(ba.SilverBadges, 0) AS SilverBadges,
    COALESCE(ba.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(ba.TotalBadges,  0) AS TotalBadges,
    tc.TagName,
    tc.TagPostCount,
    rv.VoteTypeId,
    rv.CreationDate AS RecentVoteDate,
    CASE 
        WHEN rv.VoteTypeId = 2 THEN 'UpVote'
        WHEN rv.VoteTypeId = 3 THEN 'DownVote'
        WHEN rv.VoteTypeId = 5 THEN 'Favorite'
        ELSE 'Other' 
    END AS VoteCategory
FROM UserStats us
LEFT JOIN BadgeAgg ba ON ba.UserId = us.Id
LEFT JOIN LATERAL (
    SELECT tc.TagName, tc.TagPostCount
    FROM TagContrib tc
    WHERE tc.UserId = us.Id AND tc.rn = 1
) tc ON TRUE
LEFT JOIN LATERAL (
    SELECT rv.VoteTypeId, rv.CreationDate
    FROM RecentVotes rv
    JOIN Posts p ON p.Id = rv.PostId
    WHERE p.OwnerUserId = us.Id AND rv.rn = 1
) rv ON TRUE
WHERE (us.Reputation > 10000 OR us.NetVotes > 5000)
ORDER BY us.Reputation DESC
LIMIT 100
UNION ALL
SELECT NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
WHERE FALSE;