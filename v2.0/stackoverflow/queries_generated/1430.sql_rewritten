        (SELECT COUNT(DISTINCT P_Inner.Id)
         FROM Posts P_Inner
         WHERE P_Inner.OwnerUserId = U.Id
           AND P_Inner.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
           AND P_Inner.ViewCount > 100
        ) AS RecentHighViewPosts,
        (SELECT COALESCE(SUM(P_Sub.Score), 0)
         FROM Posts P_Sub
         WHERE P_Sub.OwnerUserId = U.Id
           AND P_Sub.PostTypeId = 1
           AND P_Sub.AnswerCount IS NOT NULL
           AND P_Sub.AnswerCount > (SELECT AVG(AnswerCount) FROM Posts WHERE PostTypeId = 1 AND AnswerCount IS NOT NULL)
        ) AS ScoreFromHighAnswerQuestions,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN P.PostTypeId = 2 AND P.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS AcceptedAnswers,
        SUM(CASE WHEN PL.LinkTypeId = 3 THEN 1 ELSE 0 END) AS DuplicatePostLinksMade,
        AVG(PH.ContentEditCount) OVER (PARTITION BY U.Location) AS AvgContentEditsInLocation,
        RANK() OVER (PARTITION BY DATE_TRUNC('month', U.CreationDate) ORDER BY U.Reputation DESC) AS RankByReputationInJoinMonth,
        NTILE(10) OVER (ORDER BY UAS.TotalPosts DESC, UAS.TotalComments DESC) AS ActivityDecile,
        LAG(U.Reputation, 1, 0) OVER (ORDER BY U.CreationDate) AS PrevUserReputation,
        MAX(CASE WHEN PTC.TagName = 'sql' THEN PTC.AverageScoreWithTag ELSE 0.0 END) AS AvgSqlTagScore,
        NULLIF(U.UpVotes, 0) / NULLIF(U.DownVotes, 0) AS UpDownVoteRatio,
        COALESCE(U.AboutMe, 'No "About Me" provided') AS AboutMeSummary,
        CASE
            WHEN U.Reputation >= 10000 AND COALESCE(UBA.GoldBadges, 0) >= 3 THEN 'Guru'
            WHEN U.Reputation >= 5000 AND COALESCE(UBA.SilverBadges, 0) >= 5 THEN 'Expert'
            WHEN U.Reputation >= 1000 AND COALESCE(UBA.BronzeBadges, 0) >= 10 THEN 'Contributor'
            ELSE 'Novice'
        END AS UserCategory,
        P.Title AS LatestPostTitle,
        P.CreationDate AS LatestPostCreationDate,
        PH.WasClosed,
        PH.WasReopened,
        PH.TotalRevisions AS LatestPostRevisions,
        (PH.ReopenedTimestamp - PH.ClosedTimestamp) AS TimeToReopen,
        AC.AnswerCount AS LatestPostAnswerCount,
        AC.AverageAnswerScore AS LatestPostAvgAnswerScore,
        LPE.DisplayName AS LastEditorDisplayName,
        (
            SELECT STRING_AGG(DISTINCT T.TagName, ', ' ORDER BY P_Tags.CreationDate DESC)
            FROM Posts P_Tags
            CROSS JOIN LATERAL UNNEST(string_to_array(substring(P_Tags.Tags, 2, length(P_Tags.Tags)-2), '><')) AS unnested_tag_inner
            JOIN Tags T ON T.TagName = TRIM(unnested_tag_inner)
            WHERE P_Tags.OwnerUserId = U.Id
              AND P_Tags.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 month'
              AND T.TagName IS NOT NULL AND LENGTH(T.TagName) > 0
            LIMIT 5
        ) AS RecentTagsString
    FROM Users U
    LEFT JOIN UserActivityStats UAS ON U.Id = UAS.UserId
    LEFT JOIN UserBadgeAwards UBA ON U.Id = UBA.UserId
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId AND P.Id = (SELECT Id FROM Posts WHERE OwnerUserId = U.Id ORDER BY CreationDate DESC LIMIT 1)
    LEFT JOIN PostEditHistory PH ON P.Id = PH.PostId
    LEFT JOIN PostLinks PL ON P.Id = PL.PostId
    LEFT JOIN AnswerChainMetrics AC ON P.Id = AC.QuestionId
    LEFT JOIN Users LPE ON PH.LastEffectiveEditorId = LPE.Id
    LEFT JOIN PopularTagsContribution PTC ON U.Id = PTC.UserId AND PTC.TagName = 'sql'
    WHERE U.Id IN (SELECT UserId FROM ProblematicCommenters) -- This is the set of users to be excluded
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.Location, U.Views,
        UAS.TotalPosts, UAS.TotalAnswers, UAS.TotalComments, UAS.TotalUpvotesReceived, UAS.AveragePostScore,
        UBA.GoldBadges, UBA.SilverBadges, UBA.BronzeBadges, UBA.TotalBadges,
        P.Title, P.CreationDate, PH.WasClosed, PH.WasReopened, PH.TotalRevisions, PH.ClosedTimestamp, PH.ReopenedTimestamp,
        AC.AnswerCount, AC.AverageAnswerScore, LPE.DisplayName, U.UpVotes, U.DownVotes, U.AboutMe, PTC.AverageScoreWithTag
) AS ProblematicUsers
ORDER BY
    UserCategory DESC, Reputation DESC, DaysSinceCreation DESC
LIMIT 1000;