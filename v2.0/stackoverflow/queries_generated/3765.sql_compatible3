WITH top_tags AS (
    SELECT t.TagName
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
    ORDER BY t.Count DESC
    LIMIT 10
),
user_posts AS (
    SELECT 
        u.Id AS UserId,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS AnswerScoreSum,
        MAX(p.CreationDate) AS LastPostDate,
        MIN(p.CreationDate) AS FirstPostDate
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    GROUP BY u.Id
),
user_badges AS (
    SELECT 
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        STRING_AGG(DISTINCT CASE WHEN b.Class = 1 THEN b.Name END, ', ') AS GoldBadgeNames
    FROM Badges b
    GROUP BY b.UserId
),
user_votes AS (
    SELECT 
        v.PostId,
        SUM(CASE WHEN vt.Id = 2 THEN 1 ELSE 0 END) AS UpVotes,
        SUM(CASE WHEN vt.Id = 3 THEN 1 ELSE 0 END) AS DownVotes,
        MAX(v.CreationDate) AS LastVoteDate
    FROM Votes v
    JOIN VoteTypes vt ON vt.Id = v.VoteTypeId
    GROUP BY v.PostId
),
answer_acceptance AS (
    SELECT 
        a.OwnerUserId AS UserId,
        COUNT(*) AS AcceptedAnswerCount
    FROM Posts a
    JOIN Posts q ON q.AcceptedAnswerId = a.Id
    WHERE a.PostTypeId = 2
    GROUP BY a.OwnerUserId
),
user_recent_activity AS (
    SELECT 
        u.Id AS UserId,
        COUNT(DISTINCT ph.Id) FILTER (WHERE ph.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days') AS RecentHistoryEvents,
        COUNT(DISTINCT c.Id) FILTER (WHERE c.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days') AS RecentComments,
        COUNT(DISTINCT v.Id) FILTER (WHERE v.CreationDate > TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '30 days') AS RecentVotes
    FROM Users u
    LEFT JOIN PostHistory ph ON ph.UserId = u.Id
    LEFT JOIN Comments c ON c.UserId = u.Id
    LEFT JOIN Votes v ON v.UserId = u.Id
    GROUP BY u.Id
),
user_tag_answer_stats AS (
    SELECT 
        a.OwnerUserId AS UserId,
        t.TagName,
        COUNT(*) AS AnswersInTag,
        AVG(a.Score) AS AvgScoreInTag,
        ROW_NUMBER() OVER (PARTITION BY a.OwnerUserId ORDER BY COUNT(*) DESC) AS TagRank
    FROM Posts a
    JOIN Posts q ON q.Id = a.ParentId
    CROSS JOIN LATERAL (
        SELECT unnest(string_to_array(substring(q.Tags FROM 2 FOR char_length(q.Tags)-2), '><')) AS TagName
    ) t
    WHERE a.PostTypeId = 2
      AND t.TagName IN (SELECT TagName FROM top_tags)
    GROUP BY a.OwnerUserId, t.TagName
),
main_active AS (
    SELECT 
        u.Id,
        COALESCE(u.DisplayName, 'Anonymous') AS DisplayName,
        u.Reputation,
        up.QuestionCount,
        up.AnswerCount,
        up.AnswerScoreSum,
        ROUND(CASE WHEN up.AnswerCount = 0 OR up.AnswerCount IS NULL THEN 0 ELSE CAST(up.AnswerScoreSum AS NUMERIC) / up.AnswerCount END, 2) AS AvgAnswerScore,
        COALESCE(ub.GoldBadges, 0) AS GoldBadges,
        COALESCE(ub.SilverBadges, 0) AS SilverBadges,
        COALESCE(ub.BronzeBadges, 0) AS BronzeBadges,
        ub.GoldBadgeNames,
        COALESCE(aa.AcceptedAnswerCount, 0) AS AcceptedAnswerCount,
        COALESCE(ur.RecentHistoryEvents, 0) AS RecentHistoryEvents,
        COALESCE(ur.RecentComments, 0) AS RecentComments,
        COALESCE(ur.RecentVotes, 0) AS RecentVotes,
        ta.TagName AS TopTag,
        ta.AnswersInTag,
        ROUND(CAST(ta.AvgScoreInTag AS NUMERIC), 2) AS AvgScoreInTopTag,
        GREATEST(
            COALESCE(DATE_PART('day', TIMESTAMP '2024-10-01 12:34:56' - up.LastPostDate), 0),
            COALESCE(DATE_PART('day', TIMESTAMP '2024-10-01 12:34:56' - up.FirstPostDate), 0)
        ) AS DaysSinceLastOrFirstPost,
        CASE 
            WHEN up.AnswerCount IS NULL THEN 'No Activity'
            WHEN up.AnswerCount > 0 AND COALESCE(ub.GoldBadges, 0) > 0 THEN 'Power Contributor'
            ELSE 'Active User'
        END AS UserCategory
    FROM Users u
    LEFT JOIN user_posts up ON up.UserId = u.Id
    LEFT JOIN user_badges ub ON ub.UserId = u.Id
    LEFT JOIN answer_acceptance aa ON aa.UserId = u.Id
    LEFT JOIN user_recent_activity ur ON ur.UserId = u.Id
    LEFT JOIN (
        SELECT *
        FROM user_tag_answer_stats
        WHERE TagRank = 1
    ) ta ON ta.UserId = u.Id
    WHERE u.Reputation > 0
       AND (up.AnswerCount IS NOT NULL OR ub.GoldBadges IS NOT NULL)
),
main_inactive AS (
    SELECT 
        u.Id,
        COALESCE(u.DisplayName, 'Anonymous') AS DisplayName,
        u.Reputation,
        0 AS QuestionCount,
        0 AS AnswerCount,
        0 AS AnswerScoreSum,
        0.00 AS AvgAnswerScore,
        0 AS GoldBadges,
        0 AS SilverBadges,
        0 AS BronzeBadges,
        NULL AS GoldBadgeNames,
        0 AS AcceptedAnswerCount,
        0 AS RecentHistoryEvents,
        0 AS RecentComments,
        0 AS RecentVotes,
        NULL AS TopTag,
        0 AS AnswersInTag,
        0.00 AS AvgScoreInTopTag,
        NULL AS DaysSinceLastOrFirstPost,
        'Inactive' AS UserCategory
    FROM Users u
    WHERE NOT EXISTS (SELECT 1 FROM Posts p WHERE p.OwnerUserId = u.Id)
      AND u.Reputation > 0
)
SELECT *
FROM (
    SELECT *
    FROM main_active
    ORDER BY Reputation DESC NULLS LAST
    LIMIT 100
) a
UNION ALL
SELECT *
FROM (
    SELECT *
    FROM main_inactive
    ORDER BY Reputation DESC NULLS LAST
    LIMIT 50
) b;