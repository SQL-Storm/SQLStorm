with recent_activity as (
    select
        p.id as post_id,
        p.posttypeid,
        p.creationdate,
        p.score,
        p.viewcount,
        p.owneruserid,
        coalesce(nullif(trim(p.title), ''), '[no title]') as title_norm,
        string_agg(distinct t.tagname, ',') filter (where t.tagname is not null) as taglist,
        count(distinct c.id) as comment_cnt,
        count(distinct v.id) filter (where v.votetypeid = 2) as up_cnt,
        count(distinct v.id) filter (where v.votetypeid = 3) as down_cnt,
        sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounty_total,
        max(coalesce(p.lastactivitydate, p.creationdate)) as last_act
    from posts p
    left join comments c on c.postid = p.id
    left join votes v on v.postid = p.id
    left join lateral (
        select unnest(string_to_array(substring(p.tags, 2, length(p.tags)-2), '><')) as tagname
    ) q on p.posttypeid = 1 and p.tags is not null
    left join tags t on lower(t.tagname) = lower(q.tagname)
    where p.creationdate >= (select max(creationdate) - interval '365 days' from posts)
    group by p.id, p.posttypeid, p.creationdate, p.score, p.viewcount, p.owneruserid, p.title
),
user_agg as (
    select
        u.id as user_id,
        u.displayname,
        u.reputation,
        u.creationdate as user_created,
        u.location,
        coalesce(u.websiteurl, '') as websiteurl,
        sum(case when p.posttypeid = 1 then 1 else 0 end) as q_count,
        sum(case when p.posttypeid = 2 then 1 else 0 end) as a_count,
        count(distinct b.id) filter (where b.class = 1) as gold_badges,
        count(distinct b.id) filter (where b.class = 2) as silver_badges,
        count(distinct b.id) filter (where b.class = 3) as bronze_badges,
        count(distinct ph.id) filter (where ph.posthistorytypeid in (5,6,24)) as edit_events
    from users u
    left join posts p on p.owneruserid = u.id
    left join badges b on b.userid = u.id and b.date >= (cast('2024-10-01' as date) - interval '365 days')
    left join posthistory ph on ph.userid = u.id and ph.creationdate >= (cast('2024-10-01' as date) - interval '365 days')
    group by u.id, u.displayname, u.reputation, u.creationdate, u.location, u.websiteurl
),
close_events as (
    select
        ph.postid,
        min(ph.creationdate) as first_close_date,
        max(ph.creationdate) as last_close_date,
        count(*) as close_votes,
        -- extract reason id if present as integer (remove non-digits then NULL if empty, then cast)
        max(
            case when regexp_replace(ph.comment, '[^0-9]', '', 'g') = '' then null
                 else cast(regexp_replace(ph.comment, '[^0-9]', '', 'g') as integer)
            end
        ) as any_close_reason_id
    from posthistory ph
    where ph.posthistorytypeid in (10,35) -- closed or migrated away
    group by ph.postid
),
dup_map as (
    select
        pl.postid as dup_post_id,
        pl.relatedpostid as master_post_id,
        min(pl.creationdate) as first_link_date
    from postlinks pl
    where pl.linktypeid = 3
    group by pl.postid, pl.relatedpostid
),
answers as (
    select
        a.id as answer_id,
        a.parentid as question_id,
        a.owneruserid as answer_owner,
        a.creationdate as answer_date,
        a.score as answer_score,
        row_number() over (partition by a.parentid order by a.score desc nulls last, a.creationdate asc) as rn_score_desc,
        row_number() over (partition by a.parentid order by a.creationdate asc) as rn_oldest,
        count(*) over (partition by a.parentid) as total_answers
    from posts a
    where a.posttypeid = 2
),
question_rollup as (
    select
        r.post_id as question_id,
        r.creationdate as question_created,
        r.score as question_score,
        r.viewcount as question_views,
        r.owneruserid as asker_id,
        r.title_norm,
        r.taglist,
        r.comment_cnt,
        r.up_cnt,
        r.down_cnt,
        r.bounty_total,
        r.last_act,
        coalesce(a_best.id, a_top.answer_id, a_first.answer_id) as featured_answer_id,
        coalesce(a_best.score, a_top.answer_score, a_first.answer_score) as featured_answer_score,
        coalesce(a_any.total_answers, 0) as answer_count,
        case when ce.postid is not null then 1 else 0 end as was_closed,
        ce.first_close_date,
        ce.last_close_date,
        dm.master_post_id,
        case when dm.master_post_id is not null then 1 else 0 end as is_duplicate
    from recent_activity r
    left join posts q on q.id = r.post_id and q.posttypeid = 1
    left join answers a_any on a_any.question_id = r.post_id
    left join answers a_top on a_top.question_id = r.post_id and a_top.rn_score_desc = 1
    left join answers a_first on a_first.question_id = r.post_id and a_first.rn_oldest = 1
    left join posts a_best on a_best.id = q.acceptedanswerid
    left join close_events ce on ce.postid = r.post_id
    left join dup_map dm on dm.dup_post_id = r.post_id
    where r.posttypeid = 1
),
tag_explode as (
    select
        qr.question_id,
        lower(trim(t.tag)) as tag
    from question_rollup qr
    cross join lateral (
        select unnest(string_to_array(coalesce(qr.taglist, ''), ',')) as tag
    ) t
),
tag_rank as (
    select
        tag,
        count(*) as tag_q_count,
        sum(case when was_closed = 1 then 1 else 0 end) as tag_closed_count,
        avg(cast(question_score as numeric)) as avg_q_score,
        percentile_cont(0.9) within group (order by question_views) as p90_views
    from question_rollup qr
    join tag_explode te on te.question_id = qr.question_id
    group by tag
),
user_perf as (
    select
        ua.user_id,
        ua.displayname,
        ua.reputation,
        ua.location,
        ua.websiteurl,
        ua.q_count,
        ua.a_count,
        ua.gold_badges,
        ua.silver_badges,
        ua.bronze_badges,
        ua.edit_events,
        count(distinct qr.question_id) filter (where qr.asker_id = ua.user_id) as asked_recent,
        count(distinct a.answer_id) filter (where a.answer_owner = ua.user_id) as answered_recent,
        avg(cast(qr.question_score as numeric)) filter (where qr.asker_id = ua.user_id) as avg_q_score_recent,
        avg(cast(a.answer_score as numeric)) filter (where a.answer_owner = ua.user_id) as avg_a_score_recent
    from user_agg ua
    left join question_rollup qr on qr.asker_id = ua.user_id
    left join answers a on a.answer_owner = ua.user_id
    group by ua.user_id, ua.displayname, ua.reputation, ua.location, ua.websiteurl, ua.q_count, ua.a_count, ua.gold_badges, ua.silver_badges, ua.bronze_badges, ua.edit_events
),
dense_posts as (
    select
        qr.*,
        dense_rank() over (order by coalesce(question_views,0) desc, coalesce(question_score,0) desc, question_created asc) as dr_popularity,
        dense_rank() over (order by coalesce(featured_answer_score, -100000) desc) as dr_best_answer
    from question_rollup qr
),
license_mix as (
    select
        p.contentlicense,
        count(*) as cnt,
        count(*) filter (where p.posttypeid = 1) as q_cnt,
        count(*) filter (where p.posttypeid = 2) as a_cnt
    from posts p
    where p.creationdate >= (cast('2024-10-01' as date) - interval '365 days')
    group by p.contentlicense
),
final_set as (
    select
        dp.question_id,
        dp.title_norm,
        dp.taglist,
        dp.question_score,
        dp.question_views,
        dp.answer_count,
        dp.featured_answer_id,
        dp.featured_answer_score,
        dp.was_closed,
        dp.is_duplicate,
        dp.first_close_date,
        dp.last_close_date,
        dp.dr_popularity,
        dp.dr_best_answer,
        up.displayname as asker_name,
        up.reputation as asker_rep,
        up.location as asker_location,
        up.asked_recent,
        up.answered_recent,
        up.avg_q_score_recent,
        up.avg_a_score_recent,
        lr.contentlicense,
        tm.tag,
        tr.tag_q_count,
        tr.tag_closed_count,
        tr.avg_q_score as tag_avg_q_score,
        tr.p90_views as tag_p90_views,
        case
            when dp.question_views >= tr.p90_views then 'P90+'
            when dp.question_views >= tr.p90_views * 0.5 then 'P45-90'
            else 'SubP45'
        end as view_band,
        dp.asker_id,
        dp.first_close_date as first_close_date_dup,
        dp.last_close_date as last_close_date_dup
    from dense_posts dp
    left join users u on u.id = dp.asker_id
    left join user_perf up on up.user_id = dp.asker_id
    left join lateral (
        select coalesce(p.contentlicense, 'unknown') as contentlicense
        from posts p
        where p.id = dp.question_id
        limit 1
    ) lr on true
    left join tag_explode tm on tm.question_id = dp.question_id
    left join tag_rank tr on tr.tag = tm.tag
),
top_popular as (
    select * from final_set where dr_popularity <= 100
),
high_quality as (
    select * from final_set where featured_answer_score is not null and featured_answer_score >= 5
),
controversial as (
    select * from final_set where was_closed = 1 or is_duplicate = 1
),
unioned as (
    select tp.*, 'popular' as bucket from top_popular tp
    union
    select hq.*, 'quality' as bucket from high_quality hq
    union
    select c.*, 'controversial' as bucket from controversial c
),
ranked as (
    select
        u.*,
        row_number() over (partition by bucket order by coalesce(question_views,0) desc, coalesce(question_score,0) desc, coalesce(featured_answer_score,-999) desc) as bucket_rank
    from unioned u
)
select
    r.bucket,
    r.bucket_rank,
    r.question_id,
    r.title_norm as title,
    r.tag,
    r.view_band,
    r.question_views,
    r.question_score,
    r.answer_count,
    r.featured_answer_score,
    r.was_closed,
    r.is_duplicate,
    r.asker_name,
    r.asker_rep,
    r.asker_location,
    r.avg_q_score_recent,
    r.avg_a_score_recent,
    r.contentlicense,
    lm.cnt as license_count_global,
    lm.q_cnt as license_q_count,
    lm.a_cnt as license_a_count,
    cast('2024-10-01 12:34:56' as timestamp) as generated_at
from ranked r
left join license_mix lm on lm.contentlicense = r.contentlicense
where
    -- complicated predicate with null logic and string handling
    coalesce(nullif(r.asker_name, ''), '[anon]') is not null
    and (r.tag is null or r.tag ~ '^[a-z0-9\\-\\.\\+#]+$')
    and (r.featured_answer_score is null or r.featured_answer_score >= -5)
    and (r.question_score + coalesce(r.featured_answer_score, 0)) >= -10
    and (r.first_close_date is null or r.last_close_date >= r.first_close_date)
order by r.bucket, r.bucket_rank
limit 500;