-- {"query": "4008.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash-lite", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 1948} 
WITH
  RankedPostEdits AS (
    SELECT
      ph.PostId,
      ph.UserId,
      u.DisplayName AS EditorDisplayName,
      ph.CreationDate AS EditDate,
      ph.PostHistoryTypeId,
      pht.Name AS EditType,
      ROW_NUMBER() OVER (PARTITION BY ph.PostId, ph.PostHistoryTypeId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory AS ph
    JOIN PostHistoryTypes AS pht
      ON ph.PostHistoryTypeId = pht.Id
    JOIN Users AS u
      ON ph.UserId = u.Id
    WHERE
      ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9) AND ph.UserId IS NOT NULL
  ),
  LatestEdits AS (
    SELECT
      *
    FROM RankedPostEdits
    WHERE
      rn = 1
  ),
  PostEditCounts AS (
    SELECT
      ph.PostId,
      COUNT(DISTINCT ph.UserId) AS DistinctEditors,
      COUNT(*) AS TotalEdits
    FROM PostHistory AS ph
    WHERE
      ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)
    GROUP BY
      ph.PostId
  ),
  UserEditSummary AS (
    SELECT
      UserId,
      COUNT(*) AS UserTotalEdits,
      SUM(CASE WHEN ph.PostHistoryTypeId IN (4, 5, 6) THEN 1 ELSE 0 END) AS UserContentEdits,
      SUM(CASE WHEN ph.PostHistoryTypeId IN (7, 8, 9) THEN 1 ELSE 0 END) AS UserRollbacks
    FROM PostHistory AS ph
    WHERE
      ph.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9)
    GROUP BY
      UserId
  ),
  QuestionAnswers AS (
    SELECT
      p.Id AS QuestionId,
      p.Title AS QuestionTitle,
      p.CreationDate AS QuestionDate,
      p.OwnerUserId AS QuestionOwnerId,
      COUNT(a.Id) AS AnswerCount,
      SUM(CASE WHEN a.IsAccepted = 1 THEN 1 ELSE 0 END) AS AcceptedAnswerCount,
      AVG(a.Score) AS AvgAnswerScore,
      MAX(a.Score) AS MaxAnswerScore,
      MIN(a.Score) AS MinAnswerScore,
      SUM(CASE WHEN a.OwnerUserId = p.OwnerUserId THEN 1 ELSE 0 END) AS OwnerAnswers
    FROM Posts AS p
    LEFT JOIN Posts AS a
      ON p.Id = a.ParentId
    WHERE
      p.PostTypeId = 1 -- Questions
    GROUP BY
      p.Id,
      p.Title,
      p.CreationDate,
      p.OwnerUserId
  )
SELECT
  q.QuestionId,
  q.QuestionTitle,
  q.QuestionDate,
  q.QuestionOwnerId,
  u.DisplayName AS QuestionOwnerDisplayName,
  q.AnswerCount,
  q.AcceptedAnswerCount,
  q.AvgAnswerScore,
  q.MaxAnswerScore,
  q.MinAnswerScore,
  q.OwnerAnswers,
  le.EditType AS LatestEditType,
  le.EditDate AS LatestEditDate,
  pec.DistinctEditors,
  pec.TotalEdits,
  ues.UserTotalEdits,
  ues.UserContentEdits,
  ues.UserRollbacks,
  CASE
    WHEN q.AcceptedAnswerCount > 0 AND q.AnswerCount > 0
    THEN CAST(q.AcceptedAnswerCount AS REAL) / q.AnswerCount
    ELSE 0
  END AS AcceptanceRate,
  CASE
    WHEN q.QuestionDate < DATE('now', '-1 year') AND q.AnswerCount > 10 AND q.AvgAnswerScore > 5
    THEN 'Popular & Old'
    WHEN q.QuestionDate >= DATE('now', '-7 days') AND q.AnswerCount > 0
    THEN 'Recent & Active'
    WHEN q.AcceptedAnswerCount = 0 AND q.AnswerCount > 0
    THEN 'No Accepted Answer'
    ELSE 'Standard'
  END AS QuestionStatus,
  CONCAT(
    'User ',
    u.DisplayName,
    ' (',
    u.Reputation,
    ' Rep) last accessed on ',
    strftime('%Y-%m-%d', u.LastAccessDate)
  ) AS UserAccessInfo,
  CASE
    WHEN EXISTS (
      SELECT
        1
      FROM Badges AS b
      WHERE
        b.UserId = q.QuestionOwnerId AND b.Name LIKE '%Top%'
    )
    THEN 'Has Top Badge'
    ELSE 'No Top Badge'
  END AS UserBadgeStatus,
  -- Correlated subquery to check for specific close reasons
  (
    SELECT
      COUNT(*)
    FROM PostHistory AS ph_sub
    WHERE
      ph_sub.PostId = q.QuestionId
      AND ph_sub.PostHistoryTypeId = 10 -- Post Closed
      AND ph_sub.Comment IN ('101', '102') -- Duplicate or Off-topic
  ) AS DuplicateOrOffTopicCloseCount
FROM Posts AS p_outer
RIGHT JOIN QuestionAnswers AS q
  ON p_outer.Id = q.QuestionId
LEFT JOIN Users AS u
  ON q.QuestionOwnerId = u.Id
LEFT JOIN LatestEdits AS le
  ON q.QuestionId = le.PostId
LEFT JOIN PostEditCounts AS pec
  ON q.QuestionId = pec.PostId
LEFT JOIN UserEditSummary AS ues
  ON q.QuestionOwnerId = ues.UserId
WHERE
  q.QuestionDate >= DATE('now', '-30 day') -- Focus on recent questions
  AND q.AnswerCount > 0
  AND u.Reputation > 1000
  AND (
    q.QuestionTitle LIKE '%performance%'
    OR EXISTS (
      SELECT
        1
      FROM Tags AS t
      WHERE
        t.TagName IN ('sql', 'performance', 'database')
        AND EXISTS (
          SELECT
            1
          FROM Posts AS p_tags
          WHERE
            p_tags.Id = q.QuestionId AND ',' || REPLACE(p_tags.Tags, '><', ',') || ',' LIKE '%,' || t.TagName || ',%'
        )
    )
  )
UNION ALL
SELECT
  NULL AS QuestionId,
  NULL AS QuestionTitle,
  NULL AS QuestionDate,
  NULL AS QuestionOwnerId,
  NULL AS QuestionOwnerDisplayName,
  NULL AS AnswerCount,
  NULL AS AcceptedAnswerCount,
  NULL AS AvgAnswerScore,
  NULL AS MaxAnswerScore,
  NULL AS MinAnswerScore,
  NULL AS OwnerAnswers,
  le.EditType AS LatestEditType,
  le.EditDate AS LatestEditDate,
  pec.DistinctEditors,
  pec.TotalEdits,
  ues.UserTotalEdits,
  ues.UserContentEdits,
  ues.UserRollbacks,
  NULL AS AcceptanceRate,
  'High Reputation User Edits' AS QuestionStatus,
  CONCAT(
    'User ',
    u.DisplayName,
    ' (',
    u.Reputation,
    ' Rep) last accessed on ',
    strftime('%Y-%m-%d', u.LastAccessDate)
  ) AS UserAccessInfo,
  CASE
    WHEN EXISTS (
      SELECT
        1
      FROM Badges AS b
      WHERE
        b.UserId = u.Id AND b.Name LIKE '%Expert%'
    )
    THEN 'Has Expert Badge'
    ELSE 'No Expert Badge'
  END AS UserBadgeStatus,
  NULL AS DuplicateOrOffTopicCloseCount
FROM Users AS u
JOIN UserEditSummary AS ues
  ON u.Id = ues.UserId
LEFT JOIN LatestEdits AS le
  ON u.Id = le.UserId -- Joining LatestEdits on UserId to get edits by users with high reputation
LEFT JOIN PostEditCounts AS pec
  ON le.PostId = pec.PostId
WHERE
  u.Reputation > 50000
  AND ues.UserContentEdits > 20
  AND ues.UserRollbacks < 5 -- Users who contribute significantly but rarely rollback
ORDER BY
  QuestionDate DESC NULLS LAST,
  DistinctEditors DESC NULLS LAST;