with recent_users as (
    select u.id as user_id,
           u.displayname,
           u.reputation,
           u.creationdate,
           coalesce(nullif(trim(split_part(coalesce(u.location, ''), ',', 1)), ''), 'Unknown') as country_guess,
           count(*) filter (where b.class = 1) as gold_count,
           count(*) filter (where b.class = 2) as silver_count,
           count(*) filter (where b.class = 3) as bronze_count,
           count(*) as total_badges
    from users u
    left join badges b
      on b.userid = u.id
     and b.date >= u.creationdate
    where u.creationdate >= (select date_trunc('month', max(creationdate)) - interval '24 months' from users)
    group by u.id, u.displayname, u.reputation, u.creationdate, country_guess
), questions as (
    select p.id,
           p.owneruserid,
           p.creationdate,
           p.score,
           p.viewcount,
           p.answercount,
           p.title,
           p.tags,
           coalesce(p.favoritecount, 0) as favoritecount,
           case when p.closeddate is not null then 1 else 0 end as is_closed
    from posts p
    where p.posttypeid = 1
      and p.creationdate >= (select date_trunc('month', max(creationdate)) - interval '24 months' from posts)
), answers as (
    select a.id,
           a.parentid as question_id,
           a.owneruserid,
           a.creationdate,
           a.score
    from posts a
    where a.posttypeid = 2
), question_stats as (
    select q.id as question_id,
           q.owneruserid,
           q.creationdate,
           q.score,
           q.viewcount,
           q.answercount,
           q.favoritecount,
           q.is_closed,
           min(a.creationdate) as first_answer_date,
           extract(epoch from (min(a.creationdate) - q.creationdate)) as secs_to_first_answer,
           avg(a.score) as avg_answer_score,
           count(a.id) as total_answers
    from questions q
    left join answers a
      on a.question_id = q.id
    group by q.id, q.owneruserid, q.creationdate, q.score, q.viewcount, q.answercount, q.favoritecount, q.is_closed
), votes_agg as (
    select v.postid,
           count(*) filter (where v.votetypeid = 2) as upvotes,
           count(*) filter (where v.votetypeid = 3) as downvotes,
           sum(case when v.votetypeid = 8 then coalesce(v.bountyamount,0) else 0 end) as bounty_started,
           sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounty_awarded,
           min(v.creationdate) filter (where v.votetypeid in (2,3)) as first_vote_at,
           max(v.creationdate) filter (where v.votetypeid in (2,3)) as last_vote_at
    from votes v
    where v.creationdate >= (select date_trunc('month', max(creationdate)) - interval '24 months' from votes)
    group by v.postid
), comments_agg as (
    select c.postid,
           count(*) as comment_count,
           max(c.score) as max_comment_score,
           avg(nullif(c.score,0)) as avg_nonzero_comment_score,
           string_agg(distinct coalesce(nullif(trim(c.userdisplayname),''), '[anon]')::text, ',' order by max(c.creationdate)) as distinct_commenters
    from comments c
    where c.creationdate >= (select date_trunc('month', max(creationdate)) - interval '24 months' from comments)
    group by c.postid
), tag_expansion as (
    select q.id as question_id,
           unnest(string_to_array(substring(coalesce(q.tags,''), 2, greatest(length(coalesce(q.tags,'')) - 2, 0)), '><')) as tagname
    from questions q
), tag_quality as (
    select te.tagname,
           count(distinct te.question_id) as tagged_questions,
           avg(qs.score) as avg_q_score,
           percentile_cont(0.5) within group (order by qs.secs_to_first_answer nulls last) as p50_time_to_first_answer,
           avg(qs.viewcount) as avg_views
    from tag_expansion te
    join question_stats qs
      on qs.question_id = te.question_id
    group by te.tagname
), duplicates as (
    select pl.postid as dup_id,
           pl.relatedpostid as original_id,
           min(pl.creationdate) as first_link_date
    from postlinks pl
    where pl.linktypeid = 3
    group by pl.postid, pl.relatedpostid
), post_history_flags as (
    select ph.postid,
           max(case when ph.posthistorytypeid = 10 then 1 else 0 end) as ever_closed,
           max(case when ph.posthistorytypeid = 11 then 1 else 0 end) as ever_reopened,
           max(case when ph.posthistorytypeid in (33,34) then 1 else 0 end) as has_post_notice,
           max(case when ph.posthistorytypeid = 50 then 1 else 0 end) as community_bumped
    from posthistory ph
    group by ph.postid
), monthly_user_perf as (
    select ru.user_id,
           date_trunc('month', qs.creationdate) as month_bucket,
           count(distinct qs.question_id) filter (where qs.owneruserid = ru.user_id) as questions_asked,
           count(*) filter (where a.owneruserid = ru.user_id) as answers_posted,
           avg(qs.score) filter (where qs.owneruserid = ru.user_id) as avg_question_score,
           avg(a.score) filter (where a.owneruserid = ru.user_id) as avg_answer_score,
           sum(va.upvotes) filter (where qs.owneruserid = ru.user_id) as q_upvotes,
           sum(va.downvotes) filter (where qs.owneruserid = ru.user_id) as q_downvotes
    from recent_users ru
    left join question_stats qs
      on qs.owneruserid = ru.user_id
    left join answers a
      on a.owneruserid = ru.user_id
     and date_trunc('month', a.creationdate) = date_trunc('month', qs.creationdate)
    left join votes_agg va
      on va.postid = qs.question_id
    group by ru.user_id, month_bucket
), user_perf_ranked as (
    select mup.*,
           row_number() over (partition by mup.user_id order by mup.month_bucket desc) as rn,
           sum(coalesce(mup.questions_asked,0)) over (partition by mup.user_id order by mup.month_bucket rows between 11 preceding and current row) as rolling_12m_q,
           sum(coalesce(mup.answers_posted,0)) over (partition by mup.user_id order by mup.month_bucket rows between 11 preceding and current row) as rolling_12m_a
    from monthly_user_perf mup
), top_users as (
    select ru.user_id,
           ru.displayname,
           ru.reputation,
           ru.country_guess,
           ru.total_badges,
           up.rn,
           up.rolling_12m_q,
           up.rolling_12m_a
    from recent_users ru
    left join user_perf_ranked up
      on up.user_id = ru.user_id
     and up.rn = 1
    where coalesce(up.rolling_12m_q,0) + coalesce(up.rolling_12m_a,0) > 0
), final_questions as (
    select qs.question_id,
           qs.owneruserid,
           qs.creationdate,
           qs.score,
           qs.viewcount,
           qs.answercount,
           qs.favoritecount,
           qs.is_closed,
           qs.first_answer_date,
           qs.secs_to_first_answer,
           qs.avg_answer_score,
           qs.total_answers,
           va.upvotes,
           va.downvotes,
           va.bounty_started,
           va.bounty_awarded,
           extract(epoch from (va.last_vote_at - va.first_vote_at)) as vote_span_secs,
           ca.comment_count,
           ca.max_comment_score,
           ca.avg_nonzero_comment_score,
           coalesce(ca.distinct_commenters, '') as distinct_commenters,
           phf.ever_closed,
           phf.ever_reopened,
           phf.has_post_notice,
           phf.community_bumped,
           case when d.dup_id is not null then 1 else 0 end as is_duplicate,
           d.original_id as dup_of_id
    from question_stats qs
    left join votes_agg va on va.postid = qs.question_id
    left join comments_agg ca on ca.postid = qs.question_id
    left join post_history_flags phf on phf.postid = qs.question_id
    left join duplicates d on d.dup_id = qs.question_id
), question_tag_features as (
    select fq.question_id,
           count(*) as tag_count,
           sum(tq.tagged_questions) as tag_pop_sum,
           avg(tq.avg_q_score) as tag_avg_of_avg_q_score,
           min(tq.p50_time_to_first_answer) as min_p50_tta,
           max(tq.avg_views) as max_tag_avg_views
    from final_questions fq
    left join tag_expansion te on te.question_id = fq.question_id
    left join tag_quality tq on tq.tagname = te.tagname
    group by fq.question_id
), enriched as (
    select fq.*,
           qtf.tag_count,
           qtf.tag_pop_sum,
           qtf.tag_avg_of_avg_q_score,
           qtf.min_p50_tta,
           qtf.max_tag_avg_views,
           u.displayname as owner_name,
           u.reputation as owner_reputation,
           tu.country_guess as owner_country,
           tu.total_badges as owner_badges,
           (
             coalesce(fq.score,0)*1.0
             + coalesce(fq.upvotes,0)*0.7
             - coalesce(fq.downvotes,0)*1.1
             + least(coalesce(fq.viewcount,0)/100.0, 50)
             + coalesce(nullif(fq.favoritecount,0),0)*0.9
             + case when fq.is_duplicate = 1 then -15 else 0 end
             + case when fq.ever_reopened = 1 then 5 else 0 end
             + coalesce(fq.total_answers,0)*1.2
             + case when fq.secs_to_first_answer is null then -10 else -ln(greatest(fq.secs_to_first_answer,1)) end
             + coalesce(qtf.tag_pop_sum,0)*0.0001
           ) as quality_score
    from final_questions fq
    left join question_tag_features qtf on qtf.question_id = fq.question_id
    left join users u on u.id = fq.owneruserid
    left join top_users tu on tu.user_id = fq.owneruserid
), ranked as (
    select e.*,
           dense_rank() over (order by e.quality_score desc nulls last) as quality_rank,
           row_number() over (partition by date_trunc('month', e.creationdate) order by e.quality_score desc nulls last) as monthly_rank
    from enriched e
)
select
    r.question_id,
    coalesce(r.owner_name, '[deleted]') as owner_name,
    r.owner_reputation,
    coalesce(r.owner_country, 'Unknown') as owner_country,
    r.owner_badges,
    r.creationdate,
    r.score,
    r.viewcount,
    r.answercount,
    r.favoritecount,
    r.upvotes,
    r.downvotes,
    r.bounty_started,
    r.bounty_awarded,
    r.vote_span_secs,
    r.comment_count,
    r.max_comment_score,
    r.avg_nonzero_comment_score,
    r.ever_closed,
    r.ever_reopened,
    r.has_post_notice,
    r.community_bumped,
    r.is_duplicate,
    r.dup_of_id,
    r.tag_count,
    r.tag_pop_sum,
    r.tag_avg_of_avg_q_score,
    r.min_p50_tta,
    r.max_tag_avg_views,
    r.secs_to_first_answer,
    r.quality_score,
    r.quality_rank,
    r.monthly_rank,
    r.distinct_commenters
from ranked r
where (
    (r.quality_rank <= 500 or (r.monthly_rank <= 10 and r.score >= 0))
    and coalesce(r.tag_count, 0) between 1 and 7
    and (r.is_closed = 0 or r.ever_reopened = 1 or r.community_bumped = 1)
    and (r.upvotes - r.downvotes >= -2)
    and (r.bounty_awarded is null or r.bounty_awarded >= 0)
    and (r.distinct_commenters is null or length(r.distinct_commenters) >= 0)
)
order by r.quality_rank nulls last, r.creationdate desc
limit 500;