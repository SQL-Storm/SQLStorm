WITH
  RankedPostEdits AS (
    SELECT
      ph.PostId,
      ph.UserId,
      ph.CreationDate,
      ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
    FROM PostHistory ph
    WHERE
      ph.PostHistoryTypeId IN (4, 5, 6)
  ),
  UserPostContributions AS (
    SELECT
      p.OwnerUserId,
      COUNT(p.Id) AS QuestionCount,
      SUM(p.AnswerCount) AS TotalAnswers,
      SUM(p.FavoriteCount) AS TotalFavorites
    FROM Posts p
    WHERE
      p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL
    GROUP BY
      p.OwnerUserId
  ),
  AvgScoreByTag AS (
    SELECT
      t.TagName,
      AVG(CAST(p.Score AS NUMERIC(10, 2))) AS AverageScore
    FROM Tags t
    JOIN Posts p
      ON POSITION(('<' || t.TagName || '>') IN COALESCE(p.Tags, '')) > 0
    WHERE
      p.PostTypeId = 1 AND p.Score IS NOT NULL
    GROUP BY
      t.TagName
  ),
  HighReputationUsers AS (
    SELECT
      u.Id,
      u.DisplayName,
      u.Reputation,
      u.CreationDate
    FROM Users u
    WHERE
      u.Reputation > 50000
  )
SELECT
  hru.DisplayName AS UserName,
  hru.Reputation,
  hru.CreationDate AS UserCreationDate,
  COALESCE(upc.QuestionCount, 0) AS QuestionsAsked,
  COALESCE(upc.TotalAnswers, 0) AS AnswersGiven,
  COALESCE(upc.TotalFavorites, 0) AS TotalQuestionFavorites,
  (
    SELECT
      COUNT(*)
    FROM Badges b
    WHERE
      b.UserId = hru.Id AND b.Class = 1
  ) AS GoldBadges,
  (
    SELECT
      SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END)
    FROM Votes v
    WHERE
      v.UserId = hru.Id
      AND v.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year')
  ) AS UpvotesLastYear,
  CASE
    WHEN rpe.UserId IS NOT NULL THEN 'Has Recent Edits'
    ELSE 'No Recent Edits'
  END AS EditStatus,
  COALESCE(ast.AverageScore, 0.0) AS AvgQuestionScoreForTopTags
FROM HighReputationUsers hru
LEFT JOIN UserPostContributions upc
  ON hru.Id = upc.OwnerUserId
LEFT JOIN RankedPostEdits rpe
  ON hru.Id = rpe.UserId AND rpe.rn = 1
LEFT JOIN AvgScoreByTag ast
  ON EXISTS (
    SELECT
      1
    FROM Tags t2
    WHERE
      t2.TagName IN ('sql', 'performance', 'benchmark')
      AND t2.Id IN (
        SELECT
          t3.Id
        FROM Posts p3
        JOIN Tags t3
          ON POSITION(('<' || t3.TagName || '>') IN COALESCE(p3.Tags, '')) > 0
        WHERE
          p3.Id = (
            SELECT
              p4.Id
            FROM Posts p4
            WHERE
              p4.OwnerUserId = hru.Id
            ORDER BY
              p4.CreationDate ASC
            LIMIT 1
          )
      )
      AND ast.TagName = t2.TagName
  )
WHERE
  hru.DisplayName LIKE '%[a-z]%'
ORDER BY
  hru.Reputation DESC,
  hru.CreationDate ASC
LIMIT 100;