WITH UserActivity AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestions,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswers,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COUNT(DISTINCT PH.Id) AS TotalPostHistoryEvents,
        SUM(P.Score) AS TotalPostScore,
        SUM(P.ViewCount) AS TotalPostViews,
        MAX(P.CreationDate) AS LatestPostDate,
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS TotalUpvotesGiven,
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS TotalDownvotesGiven,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN B.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN B.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN PostHistory PH ON U.Id = PH.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate
),
HighlyVotedComments AS (
    SELECT
        C.Id AS CommentId,
        C.PostId,
        C.UserId,
        C.Score AS CommentScore,
        C.CreationDate AS CommentCreationDate,
        P.OwnerUserId AS PostOwnerId,
        P.PostTypeId,
        P.Title AS PostTitle,
        ROW_NUMBER() OVER (PARTITION BY C.UserId ORDER BY C.Score DESC, C.CreationDate DESC) AS UserCommentRank
    FROM Comments C
    JOIN Posts P ON C.PostId = P.Id
    WHERE C.Score > 5
      AND C.UserId IS NOT NULL
),
HistoricalPostStatus AS (
    SELECT
        PH.PostId,
        PH.PostHistoryTypeId,
        PHT.Name AS HistoryTypeName,
        PH.CreationDate AS HistoryDate,
        PH.UserId AS HistoryInitiatorUserId,
        CASE
            WHEN PH.PostHistoryTypeId IN (10, 12, 14) THEN 'Closed/Deleted/Locked'
            WHEN PH.PostHistoryTypeId IN (11, 13, 15) THEN 'Reopened/Undeleted/Unlocked'
            ELSE 'OtherEdit'
        END AS PostStatusChangeType,
        LAG(PH.PostHistoryTypeId) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PrevHistoryTypeId
    FROM PostHistory PH
    JOIN PostHistoryTypes PHT ON PH.PostHistoryTypeId = PHT.Id
    WHERE PH.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15, 16)
),
UserReceivedVotes AS (
    SELECT
        P.OwnerUserId AS UserId,
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS ReceivedUpvotes,
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS ReceivedDownvotes
    FROM Posts P
    JOIN Votes V ON P.Id = V.PostId
    WHERE P.OwnerUserId IS NOT NULL
    GROUP BY P.OwnerUserId
),
UnionAllPostsAndEditedContent AS (
    SELECT
        P.Id AS ContentId,
        P.PostTypeId,
        P.OwnerUserId AS ContributorUserId,
        P.CreationDate,
        P.Score,
        P.ViewCount,
        P.Title,
        'Original Question' AS ContributionType,
        CASE
          WHEN P.Tags IS NOT NULL AND LENGTH(P.Tags) > 2
          THEN (
            SELECT ARRAY_AGG(TRIM(LOWER(x)))
            FROM (SELECT regexp_split_to_table(SUBSTRING(P.Tags FROM 2 FOR (LENGTH(P.Tags) - 2)), '><') AS x) t
          )
          ELSE CAST(NULL AS text[])
        END AS TagArray
    FROM Posts P
    WHERE P.OwnerUserId IS NOT NULL AND P.PostTypeId = 1

    UNION ALL

    SELECT
        P.Id AS ContentId,
        P.PostTypeId,
        P.OwnerUserId AS ContributorUserId,
        P.CreationDate,
        P.Score,
        P.ViewCount,
        P.Title,
        'Original Answer' AS ContributionType,
        CAST(NULL AS text[]) AS TagArray
    FROM Posts P
    WHERE P.OwnerUserId IS NOT NULL AND P.PostTypeId = 2

    UNION ALL

    SELECT
        PH.PostId AS ContentId,
        P_Edited.PostTypeId AS PostTypeId,
        PH.UserId AS ContributorUserId,
        PH.CreationDate,
        P_Edited.Score AS Score,
        P_Edited.ViewCount AS ViewCount,
        P_Edited.Title AS Title,
        'Significant Edit' AS ContributionType,
        CASE
          WHEN P_Edited.Tags IS NOT NULL AND LENGTH(P_Edited.Tags) > 2
          THEN (
            SELECT ARRAY_AGG(TRIM(LOWER(x)))
            FROM (SELECT regexp_split_to_table(SUBSTRING(P_Edited.Tags FROM 2 FOR (LENGTH(P_Edited.Tags) - 2)), '><') AS x) t
          )
          ELSE CAST(NULL AS text[])
        END AS TagArray
    FROM PostHistory PH
    JOIN Posts P_Edited ON PH.PostId = P_Edited.Id
    WHERE PH.UserId IS NOT NULL
      AND PH.PostHistoryTypeId IN (5, 6)
      AND P_Edited.OwnerUserId <> PH.UserId
      AND PH.CreationDate > P_Edited.CreationDate + INTERVAL '1 hour'
),
RankedCombinedContributions AS (
    SELECT
        UAC.ContributorUserId AS UserId,
        UAC.ContentId,
        UAC.Title,
        UAC.ContributionType,
        UAC.Score,
        UAC.ViewCount,
        UAC.PostTypeId,
        UAC.TagArray,
        ROW_NUMBER() OVER (PARTITION BY UAC.ContributorUserId, UAC.ContributionType ORDER BY UAC.Score DESC, UAC.ViewCount DESC, UAC.CreationDate DESC) AS RankPerContributionType,
        NTILE(10) OVER (PARTITION BY UAC.PostTypeId ORDER BY UAC.Score DESC) AS PostScoreDecile
    FROM UnionAllPostsAndEditedContent UAC
    WHERE UAC.ContributorUserId IS NOT NULL AND UAC.Score IS NOT NULL
)
SELECT
    UA.UserId,
    UA.DisplayName,
    U_Main.Location,
    U_Main.WebsiteUrl,
    U_Main.AboutMe,
    UA.Reputation,
    UA.UserCreationDate,
    UA.TotalPosts,
    UA.TotalQuestions,
    UA.TotalAnswers,
    UA.TotalComments,
    UA.TotalPostScore,
    UA.TotalPostViews,
    UA.GoldBadges,
    UA.SilverBadges,
    UA.BronzeBadges,
    COALESCE(URV.ReceivedUpvotes, 0) AS TotalUpvotesReceived,
    COALESCE(URV.ReceivedDownvotes, 0) AS TotalDownvotesReceived,
    COALESCE(UA.TotalUpvotesGiven, 0) AS TotalUpvotesGivenByUser,
    COALESCE(UA.TotalDownvotesGiven, 0) AS TotalDownvotesGivenByUser,
    COALESCE(MAX(CASE WHEN RCC.ContributionType = 'Original Question' AND RCC.RankPerContributionType = 1 THEN RCC.Title END), 'N/A') AS HighestScoringQuestionTitle,
    COALESCE(MAX(CASE WHEN RCC.ContributionType = 'Original Question' AND RCC.RankPerContributionType = 1 THEN RCC.Score END), 0) AS HighestScoringQuestionScore,
    COALESCE(MAX(CASE WHEN RCC.ContributionType = 'Original Answer' AND RCC.RankPerContributionType = 1 THEN RCC.Title END), 'N/A') AS HighestScoringAnswerTitle,
    COALESCE(MAX(CASE WHEN RCC.ContributionType = 'Original Answer' AND RCC.RankPerContributionType = 1 THEN RCC.Score END), 0) AS HighestScoringAnswerScore,
    COALESCE(MAX(CASE WHEN RCC.ContributionType = 'Significant Edit' AND RCC.RankPerContributionType = 1 THEN RCC.Title END), 'N/A') AS HighestScoringEditTitle,
    COALESCE(MAX(CASE WHEN RCC.ContributionType = 'Significant Edit' AND RCC.RankPerContributionType = 1 THEN RCC.Score END), 0) AS HighestScoringEditScore,
    COALESCE(SUM(CASE WHEN RCC.PostTypeId = 1 AND RCC.PostScoreDecile = 10 THEN 1 ELSE 0 END), 0) AS TopDecileQuestionsCount,
    COALESCE(SUM(CASE WHEN RCC.PostTypeId = 2 AND RCC.PostScoreDecile = 10 THEN 1 ELSE 0 END), 0) AS TopDecileAnswersCount,
    COALESCE(HVC.CommentCount, 0) AS HighScoringCommentsCount,
    COALESCE(MAX(UA.LatestPostDate), UA.UserCreationDate) AS MostRecentContributionDate
FROM UserActivity UA
LEFT JOIN Users U_Main ON UA.UserId = U_Main.Id
LEFT JOIN UserReceivedVotes URV ON UA.UserId = URV.UserId
LEFT JOIN (
    SELECT
        UserId,
        COUNT(*) AS CommentCount
    FROM HighlyVotedComments
    GROUP BY UserId
) HVC ON UA.UserId = HVC.UserId
LEFT JOIN RankedCombinedContributions RCC ON UA.UserId = RCC.UserId
GROUP BY
    UA.UserId,
    UA.DisplayName,
    U_Main.Location,
    U_Main.WebsiteUrl,
    U_Main.AboutMe,
    UA.Reputation,
    UA.UserCreationDate,
    UA.TotalPosts,
    UA.TotalQuestions,
    UA.TotalAnswers,
    UA.TotalComments,
    UA.TotalPostScore,
    UA.TotalPostViews,
    UA.GoldBadges,
    UA.SilverBadges,
    UA.BronzeBadges,
    COALESCE(URV.ReceivedUpvotes, 0),
    COALESCE(URV.ReceivedDownvotes, 0),
    COALESCE(UA.TotalUpvotesGiven, 0),
    COALESCE(UA.TotalDownvotesGiven, 0),
    COALESCE(HVC.CommentCount, 0),
    UA.LatestPostDate,
    U_Main.Id
ORDER BY UA.TotalPostScore DESC, UA.Reputation DESC;