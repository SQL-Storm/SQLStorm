WITH
RecentActivePosts AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.PostTypeId,
    p.ParentId,
    p.AcceptedAnswerId
  FROM Posts p
  WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '90' DAY
),
TopTags AS (
  SELECT
    t.TagName,
    t.Count AS TagCount
  FROM Tags t
  WHERE COALESCE(t.IsModeratorOnly, FALSE) = FALSE
),
UserActivity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.AccountId,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
    MAX(v.CreationDate) AS LastVoteDate
  FROM Users u
  LEFT JOIN Votes v ON v.UserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.AccountId
),
TagFollowerJoin AS (
  SELECT
    u.Id AS UserId,
    b.Name AS TagName
  FROM Users u
  JOIN Badges b ON b.UserId = u.Id AND b.Name = 'TagFollower'
  JOIN Tags t ON t.TagName = b.Name
),
ConcurrentEngagement AS (
  SELECT
    p.PostId,
    p.OwnerUserId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.LastActivityDate,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.LastActivityDate DESC) AS rn
  FROM RecentActivePosts p
  WHERE p.LastActivityDate IS NOT NULL
)
SELECT
  rp.PostId,
  rp.Title AS PostTitle,
  rp.Tags,
  rp.Score AS PostScore,
  rp.ViewCount,
  rp.AnswerCount,
  rp.CommentCount,
  ru.UserId,
  ru.DisplayName AS OwnerDisplayName,
  ru.Reputation,
  ru.LastVoteDate,
  t.TagName AS HighlightTag,
  ta.TagCount,
  rp.LastActivityDate
FROM ConcurrentEngagement rp
LEFT JOIN UserActivity ru ON ru.UserId = rp.OwnerUserId
LEFT JOIN TopTags ta
  ON EXISTS (
    SELECT 1
    FROM (
      -- split tags like '<tag1><tag2>' into rows in a dialect-neutral way using a derived table
      SELECT TRIM(value) AS tag
      FROM (
        SELECT
          REGEXP_REPLACE(rp.Tags, '^<|>$', '') AS stripped_tags
      ) s
      CROSS JOIN LATERAL (
        SELECT
          REGEXP_SPLIT_TO_TABLE(s.stripped_tags, '><') AS value
      ) split
    ) split_tags
    WHERE split_tags.tag = ta.TagName
  )
LEFT JOIN (
  SELECT pl.PostId, pl.RelatedPostId
  FROM PostLinks pl
  WHERE pl.LinkTypeId = 1
    AND pl.PostId IS NOT NULL
  -- keep ORDER BY only if the outer engine supports ordering in derived tables; otherwise remove
) pl ON pl.PostId = rp.PostId
LEFT JOIN PostLinks pl2 ON pl2.PostId = rp.PostId AND pl2.RelatedPostId IS NOT NULL
LEFT JOIN LATERAL (
  SELECT t2.Id, t2.TagName
  FROM Tags t2
  WHERE EXISTS (
    SELECT 1
    FROM (
      SELECT TRIM(value) AS tag
      FROM (
        SELECT REGEXP_REPLACE(rp.Tags, '^<|>$', '') AS stripped_tags
      ) s
      CROSS JOIN LATERAL (
        SELECT REGEXP_SPLIT_TO_TABLE(s.stripped_tags, '><') AS value
      ) split
    ) split_tags
    WHERE split_tags.tag = t2.TagName
  )
  LIMIT 1
) t ON true
WHERE rp.rn = 1
  AND rp.OwnerUserId IS NOT NULL
GROUP BY
  rp.PostId,
  rp.Title,
  rp.Tags,
  rp.Score,
  rp.ViewCount,
  rp.AnswerCount,
  rp.CommentCount,
  ru.UserId,
  ru.DisplayName,
  ru.Reputation,
  ru.LastVoteDate,
  t.TagName,
  ta.TagCount,
  rp.LastActivityDate
ORDER BY rp.LastActivityDate DESC
LIMIT 100;