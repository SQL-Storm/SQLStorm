WITH
user_agg AS (
    SELECT
        u.Id                                 AS user_id,
        u.DisplayName,
        u.Reputation,
        COUNT(b.Id)                           AS total_badges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold_badges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver_badges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze_badges,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN p.Id END) AS question_count,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN p.Id END) AS answer_count,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS avg_question_score,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS avg_answer_score,
        MAX(p.CreationDate)                  AS last_post_date
    FROM Users u
    LEFT JOIN Badges b      ON b.UserId = u.Id
    LEFT JOIN Posts  p      ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),

recent_activity AS (
    SELECT
        ua.user_id,
        SUM(CASE WHEN p.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY) THEN 1 ELSE 0 END) AS recent_posts,
        ( SELECT COUNT(*) FROM Comments c WHERE c.UserId = ua.user_id AND c.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY) ) AS recent_comments,
        ( SELECT COUNT(*) FROM Votes v WHERE v.UserId = ua.user_id AND v.CreationDate >= (CAST('2024-10-01' AS DATE) - INTERVAL '30' DAY) AND v.VoteTypeId = 2 ) AS recent_upvotes
    FROM user_agg ua
    LEFT JOIN Posts p ON p.OwnerUserId = ua.user_id
    GROUP BY ua.user_id
),

tag_agg AS (
    SELECT
        u.Id                                   AS user_id,
        tag,
        COUNT(*)                               AS tag_uses,
        MAX(p.Score)                           AS max_score_per_tag
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id
                 AND p.PostTypeId = 1
                 AND p.Tags IS NOT NULL
    CROSS JOIN LATERAL (
        SELECT TRIM(BOTH '<>' FROM t) AS tag
        FROM (
            SELECT regexp_split_to_table(p.Tags, '><') AS t
        ) s
    ) tag_split
    GROUP BY u.Id, tag
),

top_answers AS (
    SELECT
        q.Id                                   AS question_id,
        a.Id                                   AS answer_id,
        a.OwnerUserId                          AS answer_author_id,
        a.Score,
        ROW_NUMBER() OVER (PARTITION BY q.Id ORDER BY a.Score DESC, a.CreationDate ASC) AS rn
    FROM Posts q
    JOIN Posts a ON a.ParentId = q.Id
                AND a.PostTypeId = 2
    WHERE q.PostTypeId = 1
),

question_answer AS (
    SELECT
        qa.question_id,
        qa.answer_id,
        qa.answer_author_id,
        qa.Score AS answer_score
    FROM top_answers qa
    WHERE qa.rn = 1
),

influence_raw AS (
    SELECT ua.user_id, (ua.Reputation * 0.6 + ua.total_badges * 5 + COALESCE(ra.recent_upvotes,0) * 0.2) AS raw_score
    FROM user_agg ua
    JOIN recent_activity ra ON ra.user_id = ua.user_id
),

influence_rank AS (
    SELECT
        ir.user_id,
        ir.raw_score,
        RANK() OVER (ORDER BY ir.raw_score DESC) AS influence_rank
    FROM influence_raw ir
),

users_without_posts AS (
    SELECT u.Id AS user_id, u.DisplayName
    FROM Users u
    LEFT JOIN Posts p ON p.OwnerUserId = u.Id
    WHERE p.Id IS NULL
),

active_inactive_union AS (
    SELECT ua.user_id FROM user_agg ua
    UNION ALL
    SELECT uwp.user_id FROM users_without_posts uwp
)

SELECT
    ua.user_id,
    ua.DisplayName,
    ua.Reputation,
    ua.total_badges,
    ua.gold_badges,
    ua.silver_badges,
    ua.bronze_badges,
    ua.question_count,
    ua.answer_count,
    ua.avg_question_score,
    ua.avg_answer_score,
    ra.recent_posts,
    ra.recent_comments,
    ra.recent_upvotes,
    ir.raw_score,
    ir.influence_rank,
    COALESCE(tagg.tag, '<no-tag>')                     AS most_used_tag,
    COALESCE(tagg.tag_uses, 0)                         AS tag_uses,
    COALESCE(tagg.max_score_per_tag, 0)               AS max_tag_score,
    qa.answer_id,
    qa.answer_score,
    qa.answer_author_id,
    CASE
        WHEN ua.last_post_date IS NULL THEN 'Never posted'
        ELSE to_char(ua.last_post_date, 'YYYY-MM-DD')
    END                                               AS last_post_date_formatted,
    CASE
        WHEN ua.Reputation IS NULL THEN 0
        ELSE ua.Reputation
    END                                               AS reputation_nonnull
FROM user_agg ua
FULL OUTER JOIN recent_activity ra      ON ra.user_id = ua.user_id
LEFT JOIN influence_rank ir           ON ir.user_id = ua.user_id
LEFT JOIN (
    SELECT user_id, tag, tag_uses, max_score_per_tag,
           ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY tag_uses DESC, max_score_per_tag DESC) AS rn
    FROM tag_agg
) tagg ON tagg.user_id = ua.user_id AND tagg.rn = 1
LEFT JOIN question_answer qa          ON qa.answer_author_id = ua.user_id
WHERE ua.user_id IN (SELECT user_id FROM active_inactive_union)
ORDER BY ir.influence_rank NULLS LAST, ua.Reputation DESC
LIMIT 100;