SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT v.PostId) AS TotalVotes,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) AS TotalQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id ELSE NULL END) AS TotalAnswers,
    MAX(p.Score) AS HighestScoredPost,
    MIN(p.CreationDate) AS FirstPostDate,
    MAX(p.LastActivityDate) AS LastActivePostDate,
    MAX(ph.CreationDate) AS LastEditedDate,
    AVG(p.ViewCount) AS AvgViewCount,
    STRING_AGG(t.TagName, ', ' ORDER BY t.TagName DESC) AS MostCommonTags
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId AND ph.PostHistoryTypeId = 2
LEFT JOIN 
    (
        SELECT
            p2.Id AS PostId,
            TRIM(both '<>' FROM regexp_split) AS TagName
        FROM
            Posts p2,
            LATERAL (
                SELECT regexp_split_to_table(TRIM(BOTH '<>' FROM p2.Tags), '>') AS regexp_split
            ) rs
        WHERE
            p2.Tags IS NOT NULL AND p2.Tags <> ''
    ) t ON p.Id = t.PostId
LEFT JOIN 
    Votes v ON p.Id = v.PostId
WHERE 
    u.Reputation > 1000
    AND p.CreationDate >= DATE '2020-01-01'
GROUP BY 
    u.Id,
    u.DisplayName,
    u.Reputation
HAVING 
    AVG(p.ViewCount) > 100
ORDER BY 
    TotalVotes DESC, 
    HighestScoredPost DESC;