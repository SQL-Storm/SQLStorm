WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.AccountId,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT b.Id) as Badges,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT ph.Id) as HistoryActions,
        AVG(p.Score) as AvgPostScore,
        MAX(p.CreationDate) as LastPostDate,
        RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
        DENSE_RANK() OVER (ORDER BY u.Views DESC) as ViewsRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.AccountId
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.Tags,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            WHEN p.PostTypeId = 4 THEN 'TagWikiExcerpt'
            WHEN p.PostTypeId = 5 THEN 'TagWiki'
            ELSE 'Other'
        END as PostType,
        CASE 
            WHEN p.Score > 100 THEN 'HighlyVoted'
            WHEN p.Score > 50 THEN 'WellVoted'
            WHEN p.Score > 10 THEN 'ModeratelyVoted'
            WHEN p.Score > 0 THEN 'SlightlyVoted'
            ELSE 'NoVotes'
        END as VotingCategory,
        CASE 
            WHEN p.ViewCount > 10000 THEN 'Viral'
            WHEN p.ViewCount > 5000 THEN 'Popular'
            WHEN p.ViewCount > 1000 THEN 'WellKnown'
            WHEN p.ViewCount > 100 THEN 'Moderate'
            ELSE 'Unknown'
        END as PopularityLevel,
        STRING_AGG(SUBSTRING(p.Tags FROM 2 FOR (CHAR_LENGTH(p.Tags) - 2)), ', ' ORDER BY p.Id) as CombinedTagList,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PrevScore,
        LEAD(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as NextScore,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PostSequence,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) as TotalPostsByUser
    FROM Posts p
    WHERE p.CreationDate >= TIMESTAMP '2020-01-01 00:00:00' 
      AND p.CreationDate < TIMESTAMP '2024-01-01 00:00:00'
      AND p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, p.OwnerUserId, p.PostTypeId, p.AnswerCount, p.CommentCount, p.FavoriteCount, p.Tags
),
TaggedQuestions AS (
    SELECT 
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.Tags,
        CASE 
            WHEN pa.Tags LIKE '%<java>%' THEN 'Java'
            WHEN pa.Tags LIKE '%<python>%' THEN 'Python'
            WHEN pa.Tags LIKE '%<c++>%' THEN 'C++'
            WHEN pa.Tags LIKE '%<javascript>%' THEN 'JavaScript'
            ELSE 'Other'
        END as PrimaryLanguage,
        regexp_split_to_array(SUBSTRING(pa.Tags FROM 2 FOR (CHAR_LENGTH(pa.Tags) - 2)), '><') as TagArray,
        array_length(regexp_split_to_array(SUBSTRING(pa.Tags FROM 2 FOR (CHAR_LENGTH(pa.Tags) - 2)), '><'), 1) as TotalTags,
        CASE 
            WHEN pa.Tags LIKE '%<java>%<python>%' THEN 'MultiLang'
            WHEN pa.Tags LIKE '%<java>%<c++>%' THEN 'MultiLang'
            WHEN pa.Tags LIKE '%<javascript>%<python>%' THEN 'MultiLang'
            ELSE 'SingleLang'
        END as LanguageComplexity
    FROM PostAnalysis pa
    WHERE pa.PostTypeId = 1
),
ComplexQueryResults AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Reputation,
        us.Views,
        us.TotalPosts,
        us.Questions,
        us.Answers,
        us.Badges,
        us.Comments,
        us.HistoryActions,
        us.AvgPostScore,
        us.ReputationRank,
        us.ViewsRank,
        COALESCE(pa.Score, 0) as LatestPostScore,
        COALESCE(pa.Title, 'No Posts') as LastPostTitle,
        COALESCE(pa.PostType, 'None') as LastPostType,
        COALESCE(pa.VotingCategory, 'Unknown') as CurrentVotingStatus,
        COALESCE(pa.PopularityLevel, 'Unknown') as PopularityStatus,
        COALESCE(tq.PrimaryLanguage, 'Unknown') as MainLanguage,
        COALESCE(tq.LanguageComplexity, 'Unknown') as Complexity,
        CASE 
            WHEN pa.Score IS NOT NULL AND (pa.Score - COALESCE(pa.PrevScore, 0)) > 10 THEN 'SignificantIncrease'
            WHEN pa.Score IS NOT NULL AND (pa.Score - COALESCE(pa.PrevScore, 0)) < -10 THEN 'SignificantDecrease'
            WHEN pa.Score IS NOT NULL AND ABS(pa.Score - COALESCE(pa.PrevScore, 0)) <= 10 THEN 'Stable'
            ELSE 'NoChange'
        END as RecentTrend,
        CASE 
            WHEN pa.Score IS NOT NULL AND pa.Score > 100 AND pa.ViewCount > 500 THEN 1
            WHEN pa.Score IS NOT NULL AND pa.Score > 50 AND pa.ViewCount > 200 THEN 1
            ELSE 0
        END as HighValueFlag,
        CAST(0 AS INTEGER) as CalculatedValue,
        us.LastPostDate
    FROM UserStats us
    LEFT JOIN PostAnalysis pa ON us.UserId = pa.OwnerUserId AND pa.PostSequence = us.TotalPosts
    LEFT JOIN TaggedQuestions tq ON pa.PostId = tq.PostId
    WHERE us.TotalPosts > 0
)
SELECT 
    cqr.UserId,
    cqr.DisplayName,
    cqr.Reputation,
    cqr.Views,
    cqr.TotalPosts,
    cqr.Questions,
    cqr.Answers,
    cqr.Badges,
    cqr.Comments,
    cqr.HistoryActions,
    cqr.AvgPostScore,
    cqr.ReputationRank,
    cqr.ViewsRank,
    cqr.LatestPostScore,
    cqr.LastPostTitle,
    cqr.LastPostType,
    cqr.CurrentVotingStatus,
    cqr.PopularityStatus,
    cqr.MainLanguage,
    cqr.Complexity,
    cqr.RecentTrend,
    cqr.HighValueFlag,
    (cqr.Reputation * cqr.Views * cqr.TotalPosts * cqr.Questions * cqr.Answers) / 
     NULLIF((cqr.Badges + cqr.Comments + cqr.HistoryActions), 0) as PerformanceIndex,
    CASE 
        WHEN cqr.Reputation >= 100000 AND cqr.TotalPosts > 100 AND cqr.Questions > 50 THEN 'EliteContributor'
        WHEN cqr.Reputation >= 50000 AND cqr.TotalPosts > 50 AND cqr.Questions > 25 THEN 'TopContributor'
        WHEN cqr.Reputation >= 10000 AND cqr.TotalPosts > 20 THEN 'ActiveContributor'
        ELSE 'RegularContributor'
    END as ContributorTier,
    ROW_NUMBER() OVER (ORDER BY (cqr.Reputation * cqr.Views * cqr.TotalPosts * cqr.Questions * cqr.Answers) / NULLIF((cqr.Badges + cqr.Comments + cqr.HistoryActions), 0) DESC) as PerformanceRank,
    RANK() OVER (ORDER BY cqr.AvgPostScore DESC) as ScoreRank,
    DENSE_RANK() OVER (ORDER BY cqr.Views DESC) as EngagementRank,
    cqr.LastPostDate
FROM ComplexQueryResults cqr
WHERE (cqr.Reputation + cqr.Views + cqr.TotalPosts) > 0
  AND (cqr.TotalPosts >= 1)
  AND cqr.DisplayName IS NOT NULL
  AND cqr.DisplayName != ''
  AND cqr.LastPostDate >= TIMESTAMP '2020-01-01 00:00:00' 
  AND (CASE WHEN cqr.LastPostDate IS NOT NULL THEN cqr.LastPostDate ELSE TIMESTAMP '1900-01-01 00:00:00' END) < TIMESTAMP '2024-10-01 12:34:56'
  AND ((cqr.Reputation > 1000 AND cqr.Questions > 10) OR 
       (cqr.Reputation > 5000 AND cqr.Answers > 5) OR 
       (cqr.Reputation > 25000 AND cqr.Badges > 20))
ORDER BY PerformanceIndex DESC, Reputation DESC, TotalPosts DESC
LIMIT 200;