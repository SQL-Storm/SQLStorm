WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        COUNT(CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestions,
        COUNT(CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswers,
        SUM(P.Score) AS TotalPostScore,
        AVG(P.Score) FILTER (WHERE P.PostTypeId IN (1, 2, 8)) AS AvgRelevantPostScore, -- Aggregate with FILTER clause
        MAX(P.CreationDate) AS LatestPostDate,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COUNT(DISTINCT V.Id) AS TotalVotesGiven,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        -- Correlated subquery: Count specific edit history entries for the user
        (SELECT COUNT(PH.Id) FROM PostHistory PH WHERE PH.UserId = U.Id AND PH.PostHistoryTypeId IN (4, 5, 6)) AS TotalEditHistoryEntries,
        SUM(CASE WHEN P.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END) AS AcceptedAnswersReceivedCount
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate
),
PostDetailsExtended AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.AnswerCount,
        P.FavoriteCount,
        P.Tags,
        P.Title,
        P.AcceptedAnswerId,
        COALESCE(P.ClosedDate, '2999-01-01 00:00:00'::timestamp) AS EffectiveClosedDate, -- NULL logic with a sentinel date
        SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
        SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
        COUNT(DISTINCT Co.Id) AS CommentCount,
        -- Window function: Rank posts by score within each post type and owner
        ROW_NUMBER() OVER(PARTITION BY P.PostTypeId, P.OwnerUserId ORDER BY P.Score DESC, P.CreationDate DESC) AS RankInPostTypeByUser,
        -- Window function: Average score of posts by the same user in a 30-day rolling window
        AVG(P.Score) OVER (PARTITION BY P.OwnerUserId ORDER BY P.CreationDate ROWS BETWEEN 15 PRECEDING AND 15 FOLLOWING) AS RollingAvgUserPostScore,
        -- Correlated subquery: Get the text of the highest-scored comment for this post
        (
            SELECT Co2.Text
            FROM Comments Co2
            WHERE Co2.PostId = P.Id
            ORDER BY Co2.Score DESC, Co2.CreationDate DESC
            LIMIT 1
        ) AS TopCommentText
    FROM Posts P
    LEFT JOIN Votes V ON P.Id = V.PostId
    LEFT JOIN Comments Co ON P.Id = Co.PostId
    GROUP BY P.Id, P.PostTypeId, P.OwnerUserId, P.CreationDate, P.Score, P.ViewCount, P.AnswerCount, P.FavoriteCount, P.Tags, P.Title, P.AcceptedAnswerId, P.ClosedDate
),
TagAnalysis AS (
    SELECT
        PDE.OwnerUserId AS UserId,
        T.TagName,
        COUNT(DISTINCT PDE.PostId) AS PostsWithTag,
        SUM(PDE.PostScore) AS TotalTagScore,
        MAX(PDE.PostCreationDate) AS LatestTagPostDate
    FROM PostDetailsExtended PDE
    -- String expression + LATERAL UNNEST for tag parsing
    JOIN LATERAL UNNEST(string_to_array(SUBSTRING(PDE.Tags, 2, LENGTH(PDE.Tags)-2), '><')) AS T(TagName)
    WHERE PDE.Tags IS NOT NULL AND PDE.OwnerUserId IS NOT NULL
    GROUP BY PDE.OwnerUserId, T.TagName
    HAVING COUNT(DISTINCT PDE.PostId) > 1 -- Only consider tags used multiple times
),
ComplexPostHistoryEvents AS (
    -- Set operator: Combine significant post history events and specific vote types
    SELECT
        PH.PostId,
        PH.UserId,
        PH.CreationDate AS EventDate,
        PH.PostHistoryTypeId,
        PHT.Name AS EventType,
        PH.Comment,
        PH.Text AS HistoryText,
        'PostHistory' AS SourceTable
    FROM PostHistory PH
    JOIN PostHistoryTypes PHT ON PH.PostHistoryTypeId = PHT.Id
    WHERE PH.PostHistoryTypeId IN (10, 11, 12, 13, 14, 15, 19, 20, 35, 36) -- Closed, Reopened, Deleted, Undeleted, Locked, Unlocked, Protected, Unprotected, Migrated Away/Here
    UNION ALL
    SELECT
        V.PostId,
        V.UserId,
        V.CreationDate AS EventDate,
        V.VoteTypeId AS PostHistoryTypeId, -- Reusing column name for union compatibility
        VT.Name AS EventType,
        NULL AS Comment,
        'Vote Action: ' || VT.Name AS HistoryText, -- String concatenation
        'Votes' AS SourceTable
    FROM Votes V
    JOIN VoteTypes VT ON V.VoteTypeId = VT.Id
    WHERE V.VoteTypeId IN (4, 10, 11, 12) -- Offensive, Deletion, Undeletion, Spam votes
),
AggregatedHistoryPerPost AS (
    SELECT
        CPE.PostId,
        CPE.UserId,
        MIN(CPE.EventDate) AS FirstEventDate,
        MAX(CPE.EventDate) AS LastEventDate,
        COUNT(DISTINCT CPE.PostHistoryTypeId) AS UniqueEventTypesCount,
        STRING_AGG(DISTINCT CPE.EventType, '; ') AS AllEventTypes, -- String aggregation
        SUM(CASE WHEN CPE.EventType LIKE '%Close%' THEN 1 ELSE 0 END) AS CloseEvents,
        SUM(CASE WHEN CPE.EventType LIKE '%Migrated%' THEN 1 ELSE 0 END) AS MigrationEvents,
        -- Window function: calculate rank of post based on event date for each user
        RANK() OVER (PARTITION BY CPE.UserId ORDER BY MIN(CPE.EventDate)) AS EventPostRankByUser
    FROM ComplexPostHistoryEvents CPE
    GROUP BY CPE.PostId, CPE.UserId
)
SELECT
    UAS.UserId,
    COALESCE(UAS.DisplayName, 'AnonymousUser_' || UAS.UserId::text) AS DisplayNameWithFallback, -- NULL logic, string concatenation with type cast
    UAS.Reputation,
    UAS.UserCreationDate,
    UAS.TotalPosts,
    UAS.TotalQuestions,
    UAS.TotalAnswers,
    UAS.AvgRelevantPostScore,
    UAS.LatestPostDate,
    UAS.TotalEditHistoryEntries,
    UAS.AcceptedAnswersReceivedCount,
    -- Aggregate from PostDetailsExtended for specific post insights
    MAX(CASE WHEN PDE.PostTypeId = 1 THEN PDE.ViewCount ELSE 0 END) AS MaxQuestionViewCount,
    MAX(CASE WHEN PDE.PostTypeId = 2 THEN PDE.PostScore ELSE 0 END) AS MaxAnswerScore,
    -- Complicated calculation: Ratio of accepted answers to total answers, handling division by zero
    CAST(UAS.AcceptedAnswersReceivedCount AS DECIMAL) / NULLIF(UAS.TotalAnswers, 0) AS AcceptedAnswerRatio,
    -- Complicated predicate in CASE statement for user activity tier
    CASE
        WHEN UAS.Reputation > 1000 AND UAS.LatestPostDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months') AND UAS.TotalBadges > 10 THEN 'Highly Active & Reputable'
        WHEN UAS.Reputation > 200 AND UAS.LastAccessDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year') AND UAS.TotalPosts > 5 THEN 'Moderately Active'
        ELSE 'Inactive/New User'
    END AS UserActivityTier,
    -- Correlated subquery in SELECT clause: Find the average score of questions posted by this user
    (
        SELECT AVG(P.Score)
        FROM Posts P
        WHERE P.OwnerUserId = UAS.UserId
          AND P.PostTypeId = 1
          AND P.CreationDate BETWEEN UAS.UserCreationDate AND UAS.LatestPostDate
    ) AS AvgQuestionScore,
    -- Window function: Rank users based on their total post score
    RANK() OVER (ORDER BY UAS.TotalPostScore DESC, UAS.Reputation DESC) AS UserTotalScoreRank,
    -- Window function: Calculate percentage of total questions this user contributed
    CAST(UAS.TotalQuestions AS DECIMAL) / NULLIF(SUM(UAS.TotalQuestions) OVER (), 0) * 100 AS PctOfTotalQuestions,
    -- Subquery in WHERE: Filter users who have at least one question with more than 50 upvotes
    EXISTS (SELECT 1 FROM PostDetailsExtended PDE2 WHERE PDE2.OwnerUserId = UAS.UserId AND PDE2.PostTypeId = 1 AND PDE2.UpVoteCount > 50) AS HasHighlyUpvotedQuestion,
    -- Correlated subquery for most frequent tag
    (
        SELECT TA.TagName
        FROM TagAnalysis TA
        WHERE TA.UserId = UAS.UserId
        ORDER BY TA.PostsWithTag DESC, TA.TotalTagScore DESC
        LIMIT 1
    ) AS MostFrequentTag,
    -- Aggregate from AggregatedHistoryPerPost: count of distinct event types
    COALESCE(SUM(AHP.UniqueEventTypesCount), 0) AS TotalUniquePostHistoryEvents,
    -- Complicated expression involving string operations and NULL logic
    UPPER(LEFT(COALESCE(UAS.DisplayName, 'UNKNOWN'), 1)) || COALESCE(SUBSTRING(UAS.DisplayName, 2), '****') AS FormattedDisplayNamePrefix,
    -- Calculate a weighted activity score with a logarithmic component
    (UAS.Reputation * 0.1 + UAS.TotalPosts * 0.5 + UAS.TotalComments * 0.3 + UAS.TotalEditHistoryEntries * 0.7 + LOG(COALESCE(NULLIF(UAS.TotalBadges, 0), 1) + 1) * 2) AS WeightedActivityScore
FROM UserActivitySummary UAS
LEFT JOIN PostDetailsExtended PDE ON UAS.UserId = PDE.OwnerUserId
LEFT JOIN AggregatedHistoryPerPost AHP ON UAS.UserId = AHP.UserId
WHERE
    UAS.TotalQuestions > 0 -- Must have posted at least one question
    AND UAS.TotalAnswers > 0 -- Must have posted at least one answer
    AND UAS.AcceptedAnswersReceivedCount > 0 -- Must have received at least one accepted answer
    AND UAS.LatestPostDate IS NOT NULL -- User must have some post activity
    AND UAS.Reputation > 50 -- Filter by a minimum reputation
    AND EXISTS ( -- Correlated subquery in WHERE clause for a complex condition
        SELECT 1
        FROM PostLinks PL
        WHERE PL.PostId IN (SELECT Id FROM Posts WHERE OwnerUserId = UAS.UserId AND PostTypeId = 1 AND CreationDate > UAS.UserCreationDate)
          AND PL.LinkTypeId = 3 -- Check for questions that are duplicates of others
          AND PL.CreationDate > (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '5 years')
    )
GROUP BY
    UAS.UserId,
    UAS.DisplayName,
    UAS.Reputation,
    UAS.UserCreationDate,
    UAS.LastAccessDate,
    UAS.TotalPosts,
    UAS.TotalQuestions,
    UAS.TotalAnswers,
    UAS.AvgRelevantPostScore,
    UAS.LatestPostDate,
    UAS.TotalEditHistoryEntries,
    UAS.AcceptedAnswersReceivedCount,
    UAS.TotalBadges
HAVING
    SUM(CASE WHEN PDE.PostTypeId = 1 AND PDE.CommentCount > 5 AND PDE.ViewCount > 1000 THEN 1 ELSE 0 END) > 0 -- At least one high-engagement question
    OR SUM(CASE WHEN PDE.PostTypeId = 2 AND PDE.PostScore > 20 AND PDE.RollingAvgUserPostScore > 15 THEN 1 ELSE 0 END) > 0 -- Or at least one high-score answer by a consistently good user
ORDER BY
    WeightedActivityScore DESC,
    UserTotalScoreRank ASC
LIMIT 100;