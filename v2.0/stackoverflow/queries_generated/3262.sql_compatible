WITH
    BadgeAgg AS (
        SELECT  UserId,
                COUNT(*)                                                AS BadgeCnt,
                SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END)             AS GoldCnt,
                SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END)             AS SilverCnt,
                SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END)             AS BronzeCnt
        FROM    Badges
        GROUP BY UserId
    ),

    PostAgg AS (
        SELECT  OwnerUserId                                   AS UserId,
                COUNT(*)                                      AS PostCnt,
                SUM(CASE WHEN PostTypeId = 1 THEN 1 ELSE 0 END) AS QCnt,
                SUM(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END) AS ACnt,
                MAX(CreationDate)                             AS LastPostDt,
                COUNT(DISTINCT t.tag)                         AS DistTagCnt
        FROM    Posts p
        LEFT JOIN LATERAL (
                SELECT regexp_split_to_table(p.Tags, '[><]') AS tag
        ) t ON p.Tags IS NOT NULL
        WHERE   p.OwnerUserId IS NOT NULL
        GROUP BY OwnerUserId
    ),

    VoteAgg AS (
        SELECT  p.OwnerUserId                                 AS UserId,
                SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoted,
                SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoted
        FROM    Posts p
        LEFT JOIN Votes v ON v.PostId = p.Id
        GROUP BY p.OwnerUserId
    ),

    UserScore AS (
        SELECT  u.Id,
                u.DisplayName,
                u.Reputation,
                COALESCE(b.BadgeCnt,0)           AS BadgeCnt,
                COALESCE(b.GoldCnt,0)            AS GoldCnt,
                COALESCE(b.SilverCnt,0)          AS SilverCnt,
                COALESCE(b.BronzeCnt,0)          AS BronzeCnt,
                COALESCE(p.PostCnt,0)            AS PostCnt,
                COALESCE(p.QCnt,0)               AS QCnt,
                COALESCE(p.ACnt,0)               AS ACnt,
                COALESCE(v.UpVoted,0)            AS UpVoted,
                COALESCE(v.DownVoted,0)          AS DownVoted,
                p.LastPostDt,
                p.DistTagCnt,
                (SELECT c.Text
                 FROM   Comments c
                 WHERE  c.UserId = u.Id
                 ORDER BY c.CreationDate DESC
                 LIMIT 1)                         AS RecentComment
        FROM    Users u
        LEFT JOIN BadgeAgg b ON b.UserId = u.Id
        LEFT JOIN PostAgg  p ON p.UserId = u.Id
        LEFT JOIN VoteAgg  v ON v.UserId = u.Id
    ),

    RankedUsers AS (
        SELECT  u.Id,
                u.DisplayName,
                u.Reputation,
                u.BadgeCnt,
                u.GoldCnt,
                u.SilverCnt,
                u.BronzeCnt,
                u.PostCnt,
                u.QCnt,
                u.ACnt,
                u.UpVoted,
                u.DownVoted,
                u.LastPostDt,
                u.DistTagCnt,
                u.RecentComment,
                ROW_NUMBER() OVER (ORDER BY u.Reputation DESC,
                                         u.BadgeCnt DESC,
                                         u.PostCnt DESC)          AS Rnk,
                CASE
                    WHEN u.Reputation >= 20000 THEN 'Elite'
                    WHEN u.Reputation >= 10000 THEN 'Pro'
                    WHEN u.Reputation >= 5000  THEN 'Experienced'
                    ELSE 'Member'
                END                                                     AS Tier,
                COALESCE(u.RecentComment,'No comments') ||
                ' | DistTags: ' ||
                COALESCE(CAST(u.DistTagCnt AS VARCHAR), '0')               AS CommentTagInfo
        FROM    UserScore u
    )

SELECT  Rnk,
        Id,
        DisplayName,
        Reputation,
        BadgeCnt,
        GoldCnt,
        SilverCnt,
        BronzeCnt,
        PostCnt,
        QCnt,
        ACnt,
        UpVoted,
        DownVoted,
        CASE WHEN LastPostDt IS NULL THEN 'Never' 
             ELSE TO_CHAR(LastPostDt,'YYYY-MM-DD')
        END                                                    AS LastPost,
        Tier,
        CommentTagInfo
FROM    RankedUsers
WHERE   Rnk <= 100

UNION ALL
SELECT NULL::integer AS Rnk,
       NULL::integer AS Id,
       '---'::text AS DisplayName,
       NULL::integer AS Reputation,
       NULL::integer AS BadgeCnt,
       NULL::integer AS GoldCnt,
       NULL::integer AS SilverCnt,
       NULL::integer AS BronzeCnt,
       NULL::integer AS PostCnt,
       NULL::integer AS QCnt,
       NULL::integer AS ACnt,
       NULL::integer AS UpVoted,
       NULL::integer AS DownVoted,
       NULL::text AS LastPost,
       NULL::text AS Tier,
       NULL::text AS CommentTagInfo
FROM   (SELECT 1) AS dummy

EXCEPT

SELECT  Rnk,Id,DisplayName,Reputation,BadgeCnt,GoldCnt,SilverCnt,BronzeCnt,
        PostCnt,QCnt,ACnt,UpVoted,DownVoted,
        CASE WHEN LastPostDt IS NULL THEN 'Never' 
             ELSE TO_CHAR(LastPostDt,'YYYY-MM-DD')
        END,
        Tier,CommentTagInfo
FROM    RankedUsers
WHERE   Reputation IS NULL;