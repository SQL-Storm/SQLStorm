-- {"query": "6782.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 596} 
SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LastPostActivity,
    AVG(p.Score) AS AvgPostScore,
    MAX(CASE WHEN ph.PostHistoryTypeId = 1 THEN ph.CreationDate END) AS FirstPostTitleEdit,
    MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.CreationDate END) AS FirstPostCloseDate,
    MAX(CASE WHEN ph.PostHistoryTypeId = 33 THEN ph.CreationDate END) AS LastPostNotice,
    MAX(CASE WHEN ph.PostHistoryTypeId = 50 THEN ph.CreationDate END) AS LastCommunityBump,
    MAX(CASE WHEN pl.LinkTypeId = 3 THEN pl.CreationDate END) AS LastDuplicateLink,
    COUNT(DISTINCT v.Id) AS TotalVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 2 THEN v.UserId END) AS TotalUpVotes,
    COUNT(DISTINCT CASE WHEN v.VoteTypeId = 3 THEN v.UserId END) AS TotalDownVotes,
    COUNT(DISTINCT CASE WHEN b.TagBased = 0 THEN t.TagName END) AS TotalNamedBadges,
    COUNT(DISTINCT CASE WHEN b.TagBased = 1 THEN t.TagName END) AS TotalTagBadges,
    STRING_AGG(DISTINCT CASE WHEN pl.LinkTypeId = 1 THEN p.Title END, ', ') AS LinkedPostTitles
FROM 
    Users u
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    PostHistory ph ON p.Id = ph.PostId
LEFT JOIN 
    PostLinks pl ON p.Id = pl.PostId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Tags t ON b.TagBased = t.Id
LEFT JOIN 
    Votes v ON p.Id = v.PostId
WHERE 
    u.Reputation > 1000
    AND p.CreationDate >= DATEADD(year, -2, cast('2024-10-01 12:34:56' as timestamp))
GROUP BY 
    u.Id, u.DisplayName, u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 10
ORDER BY 
    u.Reputation DESC
OFFSET 0 ROWS FETCH NEXT 100 ROWS ONLY;