WITH
    TopReputation AS (
        SELECT
            u.Id,
            u.DisplayName,
            u.Reputation,
            ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS rn,
            COALESCE(u.Location, 'Unknown') AS Location
        FROM Users u
        WHERE u.Reputation IS NOT NULL
    ),
    UserBadgeCounts AS (
        SELECT
            b.UserId,
            COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
            COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
            COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
            COUNT(*)                           AS TotalBadges
        FROM Badges b
        GROUP BY b.UserId
    ),
    TagExplode AS (
        SELECT
            p.Id      AS PostId,
            TRIM(t)   AS Tag
        FROM Posts p,
             regexp_split_to_table(
                 regexp_replace(p.Tags, '^<|>$', '', 'g'), '><') AS t
        WHERE p.PostTypeId = 1            -- only questions
    ),
    TagPopularity AS (
        SELECT
            Tag,
            COUNT(*)                                    AS TagCount,
            SUM(p.Score)                                AS TotalScore,
            ROW_NUMBER() OVER (ORDER BY COUNT(*) DESC)  AS TagRank
        FROM TagExplode te
        JOIN Posts p ON p.Id = te.PostId
        GROUP BY Tag
    ),
    RecentClosed AS (
        SELECT
            p.Id,
            p.Title,
            p.CreationDate,
            p.ClosedDate,
            ph.Comment AS CloseReason,
            ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId
                               ORDER BY p.ClosedDate DESC) AS rn_user_closed,
            p.OwnerUserId
        FROM Posts p
        LEFT JOIN PostHistory ph
               ON ph.PostId = p.Id
              AND ph.PostHistoryTypeId = 10          -- close vote
        WHERE p.PostTypeId = 1
          AND p.ClosedDate >= (CAST('2024-10-01' AS date) - INTERVAL '365 days')
    ),
    QuestionAnswerStats AS (
        SELECT
            q.Id                                 AS QuestionId,
            q.Title,
            q.Score                              AS QuestionScore,
            q.ViewCount,
            COALESCE(a.AnswerCount, 0)           AS AnswerCount,
            (SELECT MAX(sc.Score)
               FROM Posts sc
              WHERE sc.ParentId = q.Id
                AND sc.PostTypeId = 2)           AS MaxAnswerScore,
            (SELECT COUNT(*)
               FROM Votes v
              WHERE v.PostId = q.Id
                AND v.VoteTypeId = 2)            AS UpVotes,
            (SELECT COUNT(*)
               FROM Votes v
              WHERE v.PostId = q.Id
                AND v.VoteTypeId = 3)            AS DownVotes,
            CASE WHEN q.AcceptedAnswerId IS NOT NULL THEN 1 ELSE 0 END AS HasAcceptedAnswer,
            ROW_NUMBER() OVER (ORDER BY q.CreationDate DESC) AS RecentRank,
            q.OwnerUserId
        FROM Posts q
        LEFT JOIN (
            SELECT ParentId, COUNT(*) AS AnswerCount
            FROM Posts
            WHERE PostTypeId = 2
            GROUP BY ParentId
        ) a ON a.ParentId = q.Id
        WHERE q.PostTypeId = 1
    ),
    Combined AS (
        SELECT
            tr.Id                                 AS UserId,
            tr.DisplayName,
            tr.Reputation,
            tr.rn                                 AS ReputationRank,
            tr.Location,
            COALESCE(ub.GoldBadges,   0)          AS GoldBadges,
            COALESCE(ub.SilverBadges, 0)          AS SilverBadges,
            COALESCE(ub.BronzeBadges, 0)          AS BronzeBadges,
            COALESCE(ub.TotalBadges,  0)          AS TotalBadges,
            qa.QuestionId,
            qa.Title,
            qa.QuestionScore,
            qa.ViewCount,
            qa.AnswerCount,
            qa.MaxAnswerScore,
            qa.HasAcceptedAnswer,
            qa.RecentRank,
            tp.Tag,
            tp.TagCount,
            tp.TotalScore,
            tp.TagRank,
            rc.CloseReason,
            rc.ClosedDate
        FROM TopReputation tr
        LEFT JOIN UserBadgeCounts ub ON ub.UserId = tr.Id
        LEFT JOIN QuestionAnswerStats qa ON qa.OwnerUserId = tr.Id
        LEFT JOIN (
            SELECT
                p.OwnerUserId,
                tp.Tag,
                tp.TagCount,
                tp.TotalScore,
                tp.TagRank
            FROM TagPopularity tp
            JOIN Posts p
              ON p.Id = (
                         SELECT MIN(p2.Id)
                         FROM Posts p2
                         WHERE p2.Tags LIKE '%' || tp.Tag || '%'
                         )
            WHERE p.OwnerUserId IS NOT NULL
        ) tp ON tp.OwnerUserId = tr.Id
        LEFT JOIN RecentClosed rc ON rc.Id = qa.QuestionId
    )

SELECT *
FROM Combined
WHERE ReputationRank <= 100
   OR GoldBadges > 0
   OR (TagRank IS NOT NULL AND TagRank <= 10)

UNION ALL

SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    NULL AS ReputationRank,
    COALESCE(u.Location, 'Unknown') AS Location,
    0 AS GoldBadges,
    0 AS SilverBadges,
    0 AS BronzeBadges,
    0 AS TotalBadges,
    NULL AS QuestionId,
    NULL AS Title,
    NULL AS QuestionScore,
    NULL AS ViewCount,
    NULL AS AnswerCount,
    NULL AS MaxAnswerScore,
    NULL AS HasAcceptedAnswer,
    NULL AS RecentRank,
    NULL AS Tag,
    NULL AS TagCount,
    NULL AS TotalScore,
    NULL AS TagRank,
    NULL AS CloseReason,
    NULL AS ClosedDate
FROM Users u
WHERE u.Id NOT IN (SELECT Id FROM TopReputation)
ORDER BY Reputation DESC NULLS LAST
LIMIT 200;