WITH
  QuestionStats AS (
    SELECT
      p.Id AS QuestionId,
      p.Title AS QuestionTitle,
      p.OwnerUserId,
      p.CreationDate AS QuestionCreationDate,
      p.Score AS QuestionScore,
      p.ViewCount AS QuestionViewCount,
      p.AnswerCount,
      p.FavoriteCount,
      p.ClosedDate,
      u.DisplayName AS OwnerDisplayName,
      u.Reputation AS OwnerReputation,
      ROW_NUMBER() OVER (
        ORDER BY
          p.Score DESC,
          p.ViewCount DESC
      ) AS RankByScoreView,
      AVG(CAST(c.Score AS DECIMAL(10, 2))) OVER (PARTITION BY p.Id) AS AvgCommentScoreForQuestion,
      COUNT(a.Id) OVER (PARTITION BY p.Id) AS AnswerCountForQuestion
    FROM
      Posts AS p
      LEFT JOIN Users AS u
        ON p.OwnerUserId = u.Id
      LEFT JOIN Comments AS c
        ON p.Id = c.PostId
      LEFT JOIN Posts AS a
        ON p.Id = a.ParentId
    WHERE
      p.PostTypeId = 1
      AND p.CreationDate >= (cast('2024-10-01' as date) - INTERVAL '1 year')
    GROUP BY
      p.Id,
      p.Title,
      p.OwnerUserId,
      p.CreationDate,
      p.Score,
      p.ViewCount,
      p.AnswerCount,
      p.FavoriteCount,
      p.ClosedDate,
      u.DisplayName,
      u.Reputation
  ),
  AnswerStats AS (
    SELECT
      p.Id AS AnswerId,
      p.ParentId AS QuestionId,
      p.OwnerUserId,
      p.CreationDate AS AnswerCreationDate,
      p.Score AS AnswerScore,
      u.DisplayName AS AnswererDisplayName,
      u.Reputation AS AnswererReputation,
      ROW_NUMBER() OVER (PARTITION BY p.ParentId ORDER BY p.Score DESC) AS RankByScoreForQuestion,
      CASE
        WHEN p.Id = ps.AcceptedAnswerId THEN 1
        ELSE 0
      END AS IsAcceptedAnswer
    FROM
      Posts AS p
      JOIN Posts AS ps
        ON p.ParentId = ps.Id
      LEFT JOIN Users AS u
        ON p.OwnerUserId = u.Id
    WHERE
      p.PostTypeId = 2
      AND p.CreationDate >= (cast('2024-10-01' as date) - INTERVAL '1 year')
  ),
  HotQuestions AS (
    SELECT
      QuestionId,
      QuestionTitle,
      OwnerDisplayName,
      OwnerReputation,
      QuestionScore,
      QuestionViewCount,
      AnswerCount,
      FavoriteCount,
      AvgCommentScoreForQuestion,
      AnswerCountForQuestion,
      QuestionCreationDate,
      ROW_NUMBER() OVER (
        ORDER BY
          (
            QuestionScore + (AnswerCount * 2) + (FavoriteCount * 3)
          ) DESC
      ) AS NetworkRank
    FROM
      QuestionStats
    WHERE
      ClosedDate IS NULL
      AND QuestionScore > 10
      AND AnswerCount > 0
      AND QuestionViewCount > 1000
  ),
  UserActivity AS (
    SELECT
      OwnerUserId AS UserId,
      COUNT(Id) AS TotalPosts,
      SUM(CASE WHEN PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsAsked,
      SUM(CASE WHEN PostTypeId = 2 THEN 1 ELSE 0 END) AS AnswersGiven,
      SUM(Score) AS TotalScore,
      MAX(CreationDate) AS LastPostDate
    FROM
      Posts
    WHERE
      OwnerUserId IS NOT NULL
      AND OwnerUserId <> -1
    GROUP BY
      OwnerUserId
    HAVING
      COUNT(Id) > 5
  ),
  TopUsers AS (
    SELECT
      u.Id,
      u.DisplayName,
      u.Reputation,
      u.CreationDate,
      u.Views,
      ua.TotalPosts,
      ua.QuestionsAsked,
      ua.AnswersGiven,
      ua.TotalScore,
      ua.LastPostDate,
      COUNT(b.Id) AS BadgeCount,
      SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
      SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
      SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
      CASE
        WHEN u.LastAccessDate < (cast('2024-10-01' as date) - INTERVAL '6 months') THEN 'Inactive'
        WHEN u.LastAccessDate < (cast('2024-10-01' as date) - INTERVAL '1 month') THEN 'Moderately Active'
        ELSE 'Active'
      END AS ActivityStatus
    FROM
      Users AS u
      LEFT JOIN UserActivity AS ua
        ON u.Id = ua.UserId
      LEFT JOIN Badges AS b
        ON u.Id = b.UserId
    WHERE
      u.Reputation > 1000
    GROUP BY
      u.Id,
      u.DisplayName,
      u.Reputation,
      u.CreationDate,
      u.Views,
      ua.TotalPosts,
      ua.QuestionsAsked,
      ua.AnswersGiven,
      ua.TotalScore,
      ua.LastPostDate,
      u.LastAccessDate
    ORDER BY
      u.Reputation DESC
    LIMIT 100
  )
SELECT
  hq.QuestionTitle,
  hq.OwnerDisplayName AS QuestionOwner,
  hq.QuestionScore,
  hq.QuestionViewCount,
  hq.AnswerCount,
  hq.FavoriteCount,
  hq.AvgCommentScoreForQuestion,
  hq.NetworkRank,
  STRING_AGG(a.AnswererDisplayName || ' (Score: ' || a.AnswerScore || ')' || CASE WHEN a.IsAcceptedAnswer = 1 THEN ' [Accepted]' ELSE '' END, ' | ') AS TopAnswers,
  tu.DisplayName AS TopUserForQuestion,
  tu.Reputation AS TopUserReputation,
  tu.ActivityStatus,
  CASE
    WHEN hq.ClosedDate IS NOT NULL THEN 'Closed'
    WHEN hq.QuestionScore > 50 AND hq.AnswerCount > 10 THEN 'Popular'
    WHEN hq.AvgCommentScoreForQuestion > 3 THEN 'Highly Discussed'
    ELSE 'Standard'
  END AS QuestionCategory,
  REPLACE(REPLACE(hq.QuestionTitle, '<p>', ''), '</p>', '') AS CleanedTitle,
  CHAR_LENGTH(hq.QuestionTitle) AS TitleLength,
  SUBSTRING(hq.QuestionTitle FROM 1 FOR 20) AS TitlePrefix,
  COALESCE(hq.OwnerDisplayName, 'Community') AS KnownOwner,
  CASE
    WHEN hq.OwnerReputation > 10000 THEN 'Expert'
    WHEN hq.OwnerReputation > 1000 THEN 'Intermediate'
    ELSE 'Beginner'
  END AS OwnerExpertise
FROM
  HotQuestions AS hq
LEFT JOIN AnswerStats AS a
  ON hq.QuestionId = a.QuestionId
LEFT JOIN TopUsers AS tu
  ON hq.OwnerUserId = tu.Id
WHERE
  hq.NetworkRank <= 50
GROUP BY
  hq.QuestionId,
  hq.QuestionTitle,
  hq.OwnerDisplayName,
  hq.QuestionScore,
  hq.QuestionViewCount,
  hq.AnswerCount,
  hq.FavoriteCount,
  hq.AvgCommentScoreForQuestion,
  hq.NetworkRank,
  tu.DisplayName,
  tu.Reputation,
  tu.ActivityStatus,
  hq.ClosedDate,
  hq.OwnerReputation
ORDER BY
  hq.NetworkRank;