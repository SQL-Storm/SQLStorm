WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.Reputation,
        u.CreationDate,
        u.DisplayName,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        DATEDIFF(cast('2024-10-01 12:34:56' as timestamp), u.CreationDate) as AccountAgeDays,
        CASE 
            WHEN u.Reputation >= 10000 THEN 'Expert'
            WHEN u.Reputation >= 1000 THEN 'Advanced'
            WHEN u.Reputation >= 100 THEN 'Intermediate'
            ELSE 'Beginner'
        END as ReputationLevel
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.Reputation, u.CreationDate, u.DisplayName
),
PostPerformance AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        DATEDIFF(cast('2024-10-01 12:34:56' as timestamp), p.CreationDate) as PostAgeDays,
        CASE 
            WHEN p.Score > 100 THEN 'HighlyVoted'
            WHEN p.Score > 50 THEN 'ModeratelyVoted'
            WHEN p.Score > 0 THEN 'SlightlyVoted'
            ELSE 'Unvoted'
        END as VoteCategory,
        COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) as EngagementCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as UserPostRank,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PreviousScore,
        NTILE(4) OVER (ORDER BY p.Score DESC) as ScoreQuartile
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) AND p.CreationDate IS NOT NULL
),
UserEngagement AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6) THEN ph.Id END) as EditCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13) THEN ph.Id END) as StatusChangeCount,
        COUNT(DISTINCT CASE WHEN ph.PostHistoryTypeId IN (24) THEN ph.Id END) as EditAppliedCount,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (24) THEN 1 ELSE 0 END) as EditAppliedTotal,
        AVG(CASE WHEN ph.PostHistoryTypeId IN (24) THEN 1 ELSE 0 END) as EditApprovalRate
    FROM Users u
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId
    GROUP BY u.Id, u.DisplayName
),
TopPerformers AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        ua.TotalPosts,
        ua.Questions,
        ua.Answers,
        ua.Comments,
        ua.Badges,
        RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
        RANK() OVER (ORDER BY ua.TotalPosts DESC) as PostivityRank,
        DENSE_RANK() OVER (ORDER BY ua.Questions DESC) as QuestionRank,
        CASE 
            WHEN ua.Questions >= 100 AND ua.Reputation >= 5000 THEN 'Elite'
            WHEN ua.Questions >= 50 AND ua.Reputation >= 2500 THEN 'Seasoned'
            WHEN ua.Questions >= 20 AND ua.Reputation >= 1000 THEN 'Experienced'
            ELSE 'Active'
        END as UserStatus
    FROM Users u
    INNER JOIN UserActivityStats ua ON u.Id = ua.UserId
    WHERE ua.TotalPosts >= 5
)
SELECT 
    tp.UserStatus,
    tp.ReputationRank,
    tp.PostivityRank,
    tp.QuestionRank,
    tp.DisplayName,
    tp.Reputation,
    tp.TotalPosts,
    tp.Questions,
    tp.Answers,
    tp.Comments,
    tp.Badges,
    CASE 
        WHEN tp.Reputation > 10000 THEN 'Diamond'
        WHEN tp.Reputation > 5000 THEN 'Platinum'
        WHEN tp.Reputation > 1000 THEN 'Gold'
        WHEN tp.Reputation > 500 THEN 'Silver'
        ELSE 'Bronze'
    END as MedalTier,
    STRING_AGG(DISTINCT pp.Title, '; ') as RecentTitles,
    MAX(pp.Score) as MaxScore,
    AVG(pp.ViewCount) as AvgViews,
    COUNT(DISTINCT CASE WHEN pp.PostAgeDays <= 30 THEN pp.PostId END) as RecentPostCount,
    AVG(pp.EngagementCount) as AvgEngagement,
    ROW_NUMBER() OVER (ORDER BY tp.Reputation DESC, tp.TotalPosts DESC) as OverallRank,
    DENSE_RANK() OVER (ORDER BY tp.UserStatus, tp.Reputation DESC) as StatusReputationRank,
    CASE 
        WHEN tp.TotalPosts > 100 AND tp.Reputation > 2000 THEN 'Pro'
        WHEN tp.TotalPosts > 50 AND tp.Reputation > 1000 THEN 'Advanced'
        WHEN tp.TotalPosts > 20 AND tp.Reputation > 500 THEN 'Intermediate'
        ELSE 'Beginner'
    END as ActivityLevel,
    ABS(COALESCE(pp.Score, 0) - COALESCE(pp.PreviousScore, 0)) as ScoreChange,
    CASE 
        WHEN pp.ScoreQuartile = 1 THEN 'Top 25% Scoring Posts'
        WHEN pp.ScoreQuartile = 2 THEN 'Top 50% Scoring Posts'
        WHEN pp.ScoreQuartile = 3 THEN 'Bottom 50% Scoring Posts'
        ELSE 'Bottom 25% Scoring Posts'
    END as PerformanceQuartile,
    COALESCE(ue.EditCount, 0) as EditCount,
    COALESCE(ue.EditAppliedCount, 0) as SuggestedEdits,
    CASE 
        WHEN ue.EditApprovalRate > 0.8 THEN 'Excellent Editor'
        WHEN ue.EditApprovalRate > 0.6 THEN 'Good Editor'
        WHEN ue.EditApprovalRate > 0.4 THEN 'Fair Editor'
        ELSE 'Needs Improvement'
    END as EditorQuality,
    CASE 
        WHEN tp.Questions > tp.Answers THEN 'Question Focused'
        WHEN tp.Answers > tp.Questions THEN 'Answer Focused'
        ELSE 'Balanced'
    END as ContributionFocus,
    CONCAT('User_', tp.UserId) as UserIdentifier,
    CASE 
        WHEN tp.TotalPosts > 30 AND tp.Answers >= tp.Questions THEN 'Answer Heavy'
        WHEN tp.TotalPosts > 30 AND tp.Questions >= tp.Answers THEN 'Question Heavy'
        ELSE 'Balanced Contributor'
    END as ContributionStyle,
    IIF(tp.Badges > 10, 'Veteran', 'Regular') as BadgeStatus,
    CASE 
        WHEN tp.UserStatus = 'Elite' THEN 'Highest Priority'
        WHEN tp.UserStatus IN ('Seasoned', 'Experienced') THEN 'High Priority'
        ELSE 'Standard Priority'
    END as PriorityLevel,
    CASE 
        WHEN tp.QuestionRank <= 5 THEN 'Top Questioner'
        WHEN tp.QuestionRank <= 20 THEN 'Active Questioner'
        ELSE 'Occasional Questioner'
    END as QuestionerStatus,
    COALESCE(STRING_AGG(DISTINCT ps.Name, ', '), 'No Tags') as TagPreferences,
    IIF(tp.Badges > 0, 1, 0) as HasBadges
FROM TopPerformers tp
LEFT JOIN UserEngagement ue ON tp.UserId = ue.UserId
LEFT JOIN PostPerformance pp ON tp.UserId = pp.OwnerUserId
LEFT JOIN (
    SELECT PostId, STRING_AGG(TagName, ', ') as Name
    FROM Posts p, UNNEST(string_to_array(SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2), '><')) AS TagName
    WHERE p.Tags IS NOT NULL AND p.Tags != ''
    GROUP BY PostId
) ps ON pp.PostId = ps.PostId
GROUP BY 
    tp.UserStatus, tp.ReputationRank, tp.PostivityRank, tp.QuestionRank,
    tp.DisplayName, tp.Reputation, tp.TotalPosts, tp.Questions, tp.Answers,
    tp.Comments, tp.Badges, pp.Score, pp.PreviousScore, pp.ScoreQuartile,
    ue.EditCount, ue.EditAppliedCount, ue.EditApprovalRate, tp.QuestionRank
HAVING 
    tp.TotalPosts >= 5 
    AND tp.Reputation >= 100
    AND (tp.TotalPosts > 10 OR tp.Reputation > 1000)
ORDER BY 
    tp.Reputation DESC, 
    tp.TotalPosts DESC,
    tp.QuestionRank ASC,
    tp.PostivityRank ASC
LIMIT 1000