WITH
usr_agg AS (
    SELECT
        u.Id                                   AS user_id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT b.Id)                   AS badge_cnt,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS gold_cnt,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS silver_cnt,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS bronze_cnt,
        COALESCE(SUM(
            CASE v.VoteTypeId
                 WHEN 2 THEN  1
                 WHEN 3 THEN -1
                 ELSE 0
            END),0)                              AS vote_score,
        MAX(p.CreationDate)                    AS last_post_dt
    FROM Users u
    LEFT JOIN Badges b           ON b.UserId = u.Id
    LEFT JOIN Posts p            ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v            ON v.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
usr_last_act AS (
    SELECT
        u.Id                                   AS user_id,
        GREATEST(
            COALESCE(MAX(c.CreationDate),   TIMESTAMP '1970-01-01'),
            COALESCE(MAX(ph.CreationDate),  TIMESTAMP '1970-01-01'),
            COALESCE(MAX(v.CreationDate),   TIMESTAMP '1970-01-01')
        )                                      AS last_activity_dt
    FROM Users u
    LEFT JOIN Comments   c  ON c.UserId   = u.Id
    LEFT JOIN PostHistory ph ON ph.UserId = u.Id
    LEFT JOIN Votes      v  ON v.UserId   = u.Id
    GROUP BY u.Id
),
tag_stats AS (
    SELECT
        t.TagName,
        t.Count                              AS tag_use_cnt,
        COALESCE(SUM(p.Score),0)             AS total_score,
        COUNT(DISTINCT p.Id)                 AS question_cnt,
        STRING_AGG(DISTINCT u.DisplayName, ', ')
            FILTER (WHERE u.Id IS NOT NULL) AS top_contributors
    FROM Tags t
    LEFT JOIN PostLinks pl
           ON pl.RelatedPostId = t.WikiPostId
    LEFT JOIN Posts p
           ON p.Id = pl.PostId AND p.PostTypeId = 1
    LEFT JOIN Users u
           ON u.Id = p.OwnerUserId
    GROUP BY t.TagName, t.Count
),
dup_closed AS (
    SELECT
        ph.PostId                                 AS question_id,
        CAST(json_value(CAST(ph.Text AS varchar), '$.OriginalQuestionIds[0]') AS int) AS duplicate_of,
        ph.Text
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10
      AND ph.Comment ~ '^\d+$'
      AND ph.Text IS NOT NULL
),
ranked_users AS (
    SELECT
        ua.*,
        ROW_NUMBER() OVER (ORDER BY ua.Reputation DESC, ua.badge_cnt DESC) AS rk
    FROM usr_agg ua
)
SELECT
    ru.user_id,
    ru.DisplayName,
    ru.Reputation,
    ru.badge_cnt,
    ru.gold_cnt,
    ru.silver_cnt,
    ru.bronze_cnt,
    ru.vote_score,
    ru.last_post_dt,
    ula.last_activity_dt,
    CASE WHEN dc.question_id IS NOT NULL THEN 1 ELSE 0 END AS is_closed_duplicate,
    CAST(NULL AS varchar)   AS tag_name,
    CAST(NULL AS int)       AS tag_use_cnt,
    CAST(NULL AS int)       AS total_score,
    CAST(NULL AS int)       AS question_cnt,
    CAST(NULL AS varchar)   AS top_contributors,
    ru.rk           AS rank_position
FROM ranked_users ru
LEFT JOIN usr_last_act ula          ON ula.user_id = ru.user_id
LEFT JOIN LATERAL (
        SELECT dc.question_id
        FROM dup_closed dc
        WHERE dc.question_id = (
            SELECT p.Id
            FROM Posts p
            WHERE p.OwnerUserId = ru.user_id
              AND p.PostTypeId = 1
            ORDER BY p.CreationDate DESC
            LIMIT 1
        )
        LIMIT 1
) dc ON TRUE
WHERE ru.rk <= 100

UNION ALL

SELECT
    CAST(NULL AS int),
    CAST(NULL AS varchar),
    CAST(NULL AS int),
    CAST(NULL AS int),
    CAST(NULL AS int),
    CAST(NULL AS int),
    CAST(NULL AS int),
    CAST(NULL AS int),
    CAST(NULL AS timestamp),
    CAST(NULL AS timestamp),
    CAST(NULL AS int),
    ts.TagName,
    ts.tag_use_cnt,
    ts.total_score,
    ts.question_cnt,
    ts.top_contributors,
    CAST(NULL AS int)
FROM tag_stats ts
ORDER BY
    rank_position NULLS LAST,
    tag_use_cnt DESC,
    total_score DESC
LIMIT 150;