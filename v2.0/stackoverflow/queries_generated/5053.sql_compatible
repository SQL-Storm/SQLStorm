WITH
UserAgg AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.LastAccessDate DESC) AS rn_user
  FROM Users u
),
RecentPosts AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.Title,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.PostTypeId,
    p.Tags,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn_post
  FROM Posts p
  WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30' DAY
),
BadgeDiversity AS (
  SELECT
    b.UserId,
    COUNT(DISTINCT b.Name) AS DistinctBadges
  FROM Badges b
  GROUP BY b.UserId
),
Activity AS (
  SELECT
    u.Id AS UserId,
    COALESCE(SUM(p.Score), 0) AS PostScore,
    COALESCE(SUM(CASE WHEN c.Id IS NOT NULL THEN 1 ELSE 0 END), 0) AS CommentCount,
    COALESCE(SUM(v.BountyAmount), 0) AS BountiesAwarded
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  LEFT JOIN Comments c ON c.UserId = u.Id
  LEFT JOIN Votes v ON v.UserId = u.Id
  GROUP BY u.Id
),
PostLinksLatest AS (
  SELECT
    pl.PostId,
    pl.RelatedPostId,
    pl.LinkTypeId,
    (SELECT p2.CreationDate FROM Posts p2 WHERE p2.Id = pl.RelatedPostId) AS RelatedCreationDate
  FROM PostLinks pl
  WHERE pl.LinkTypeId IN (1, 3)
),
PostTypeRolling AS (
  SELECT
    p.PostTypeId,
    COUNT(*) OVER (
      PARTITION BY p.PostTypeId
      ORDER BY p.CreationDate
      ROWS BETWEEN 59 PRECEDING AND CURRENT ROW
    ) AS RollingCount60,
    p.CreationDate
  FROM Posts p
  WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '60' DAY
)
SELECT
  u.Id AS UserId,
  u.DisplayName,
  u.Reputation,
  u.CreationDate AS UserCreationDate,
  u.LastAccessDate,
  (SELECT COUNT(*) FROM Posts pr WHERE pr.OwnerUserId = u.Id AND pr.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '7' DAY) AS PostsLast7d,
  (SELECT COUNT(*) FROM Comments c WHERE c.UserId = u.Id AND c.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '7' DAY) AS CommentsLast7d,
  (SELECT COUNT(*) FROM Votes v WHERE v.UserId = u.Id AND v.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '7' DAY) AS VotesLast7d,
  (
    SELECT p.Title
    FROM Posts p
    WHERE p.OwnerUserId = u.Id AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '7' DAY
    ORDER BY p.Score DESC, p.CreationDate DESC
    FETCH FIRST 1 ROW ONLY
  ) AS TopPost7dTitle,
  bd.DistinctBadges,
  a.PostScore,
  a.CommentCount,
  a.BountiesAwarded,
  (
    SELECT pll.RelatedPostId
    FROM PostLinksLatest pll
    WHERE pll.PostId = (
      SELECT MAX(pl.PostId) FROM PostLinks pl2 WHERE pl2.PostId = u.Id
    )
    FETCH FIRST 1 ROW ONLY
  ) AS LatestLinkedPostId,
  (
    SELECT SUM(rc.RollingCount60)
    FROM PostTypeRolling rc
    WHERE rc.PostTypeId = 1
  ) AS RollingQuestions60
FROM Users u
LEFT JOIN BadgeDiversity bd ON bd.UserId = u.Id
LEFT JOIN Activity a ON a.UserId = u.Id
ORDER BY u.Reputation DESC, u.LastAccessDate DESC
FETCH FIRST 100 ROWS ONLY;