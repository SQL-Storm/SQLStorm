WITH RankedPosts AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.Title,
        p.Tags,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.LastActivityDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as rn,
        LAG(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as prev_score,
        AVG(p.Score) OVER (PARTITION BY p.PostTypeId ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) as moving_avg_score,
        NTILE(4) OVER (ORDER BY p.Score) as quartile,
        CASE 
            WHEN p.Tags IS NOT NULL AND p.Tags <> '' THEN 
                (LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '>', '')) + 1)
            ELSE 0 
        END as tag_count
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2) 
),
UserStats AS (
    SELECT 
        u.Id as UserId,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.AccountId,
        COUNT(DISTINCT p.Id) as post_count,
        COUNT(DISTINCT b.Id) as badge_count,
        AVG(p.Score) as avg_post_score,
        MAX(p.CreationDate) as latest_post_date,
        STRING_AGG(DISTINCT p.Title, '; ') as user_titles,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) as question_count,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) as answer_count
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Reputation > 1000
    GROUP BY u.Id, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.AccountId
),
PostMetrics AS (
    SELECT 
        rp.Id,
        rp.PostTypeId,
        rp.Score,
        rp.ViewCount,
        rp.CreationDate,
        rp.OwnerUserId,
        rp.Title,
        rp.Tags,
        rp.AnswerCount,
        rp.CommentCount,
        rp.FavoriteCount,
        rp.LastActivityDate,
        rp.rn,
        rp.prev_score,
        rp.moving_avg_score,
        rp.quartile,
        rp.tag_count,
        CASE WHEN rp.prev_score IS NOT NULL THEN 
            CAST((rp.Score - rp.prev_score) AS FLOAT) / NULLIF(rp.prev_score, 0) * 100 
        END as score_change_pct,
        -- standard SQL: use CAST(last - first AS INTEGER) for day difference when dates are date/time; use EXTRACT(EPOCH FROM ...) for seconds in some dialects.
        CAST((rp.LastActivityDate - rp.CreationDate) AS INTEGER) as days_since_creation,
        CASE WHEN rp.Score > 100 THEN 'High' 
             WHEN rp.Score > 50 THEN 'Medium' 
             ELSE 'Low' END as score_category,
        CASE WHEN rp.AnswerCount > 10 THEN 'Highly Answered'
             WHEN rp.AnswerCount > 5 THEN 'Moderately Answered'
             ELSE 'Less Answered' END as answer_category
    FROM RankedPosts rp
    WHERE rp.rn <= 5
),
UserActivity AS (
    SELECT 
        us.UserId,
        us.Reputation,
        us.Views,
        us.UpVotes,
        us.DownVotes,
        us.post_count,
        us.badge_count,
        us.avg_post_score,
        us.latest_post_date,
        us.user_titles,
        us.question_count,
        us.answer_count,
        CASE WHEN us.post_count > 100 THEN 'Veteran' 
             WHEN us.post_count > 50 THEN 'Experienced' 
             ELSE 'Beginner' END as user_level,
        CASE WHEN us.badge_count > 1 THEN 'Badge Holder' 
             ELSE 'No Badges' END as badge_status
    FROM UserStats us
),
FilteredPosts AS (
    SELECT 
        pm.Id,
        pm.PostTypeId,
        pm.Score,
        pm.ViewCount,
        pm.CreationDate,
        pm.OwnerUserId,
        pm.Title,
        pm.Tags,
        pm.AnswerCount,
        pm.CommentCount,
        pm.FavoriteCount,
        pm.LastActivityDate,
        pm.rn,
        pm.prev_score,
        pm.moving_avg_score,
        pm.quartile,
        pm.tag_count,
        pm.score_change_pct,
        pm.days_since_creation,
        pm.score_category,
        pm.answer_category
    FROM PostMetrics pm
    WHERE pm.Score > 0 
      AND pm.ViewCount > 100 
      AND pm.days_since_creation > 7
    UNION
    SELECT 
        pm.Id,
        pm.PostTypeId,
        pm.Score,
        pm.ViewCount,
        pm.CreationDate,
        pm.OwnerUserId,
        pm.Title,
        pm.Tags,
        pm.AnswerCount,
        pm.CommentCount,
        pm.FavoriteCount,
        pm.LastActivityDate,
        pm.rn,
        pm.prev_score,
        pm.moving_avg_score,
        pm.quartile,
        pm.tag_count,
        pm.score_change_pct,
        pm.days_since_creation,
        pm.score_category,
        pm.answer_category
    FROM PostMetrics pm
    WHERE pm.score_category IN ('High', 'Medium')
      AND pm.answer_category = 'Highly Answered'
)
SELECT 
    fp.Id,
    fp.PostTypeId,
    fp.Score,
    fp.ViewCount,
    fp.CreationDate,
    fp.OwnerUserId,
    fp.Title,
    fp.Tags,
    fp.AnswerCount,
    fp.CommentCount,
    fp.FavoriteCount,
    fp.LastActivityDate,
    fp.rn,
    fp.prev_score,
    fp.moving_avg_score,
    fp.quartile,
    fp.tag_count,
    fp.score_change_pct,
    fp.days_since_creation,
    fp.score_category,
    fp.answer_category,
    COALESCE(ua.user_level, 'Unknown') as user_level,
    COALESCE(ua.badge_status, 'Unknown') as badge_status,
    CASE WHEN fp.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Above Avg'
         WHEN fp.Score < (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 'Below Avg'
         ELSE 'Avg' END as relative_score,
    CASE WHEN fp.ViewCount > (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1) THEN 'Above Avg Views'
         WHEN fp.ViewCount < (SELECT AVG(ViewCount) FROM Posts WHERE PostTypeId = 1) THEN 'Below Avg Views'
         ELSE 'Avg Views' END as relative_views,
    COUNT(*) OVER() as total_filtered_posts,
    LAG(fp.Score) OVER (ORDER BY fp.CreationDate) as previous_post_score,
    LEAD(fp.Score) OVER (ORDER BY fp.CreationDate) as next_post_score,
    ROW_NUMBER() OVER (ORDER BY fp.Score DESC) as ranking_by_score,
    RANK() OVER (PARTITION BY fp.PostTypeId ORDER BY fp.Score DESC) as rank_by_type,
    DENSE_RANK() OVER (ORDER BY fp.Score DESC) as dense_rank_by_score,
    PERCENT_RANK() OVER (ORDER BY fp.Score) as percentile_rank,
    NTH_VALUE(fp.Score, 1) OVER (ORDER BY fp.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as highest_score,
    NTH_VALUE(fp.Score, 2) OVER (ORDER BY fp.Score DESC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) as second_highest_score,
    (fp.Score + fp.ViewCount) as score_view_sum,
    CASE 
        WHEN fp.Tags IS NOT NULL THEN 
            (SELECT COUNT(*) FROM (SELECT UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<>' FROM fp.Tags), '><')) AS tag) sub)
        ELSE 0 
    END as tag_count2,
    TRIM(fp.Title) as cleaned_title,
    UPPER(SUBSTRING(fp.Title FROM 1 FOR 10)) as truncated_title_upper,
    ('Post ID: ' || fp.Id || ' | Score: ' || fp.Score || ' | Views: ' || fp.ViewCount) as summary,
    CASE 
        WHEN fp.Score > 100 AND fp.ViewCount > 1000 THEN 'Popular'
        WHEN fp.Score < 10 AND fp.ViewCount < 100 THEN 'Obscure'
        ELSE 'Moderate'
    END as popularity_level,
    CAST(fp.CreationDate AS DATE) as creation_date_only,
    -- standard SQL DATE add: use DATE + integer for many dialects; here add 30 days
    (fp.CreationDate + INTERVAL '30' DAY) as thirty_days_later,
    CAST((DATE '2023-12-31' - CAST(fp.CreationDate AS DATE)) AS INTEGER) as days_to_end_of_year,
    CASE WHEN EXISTS (SELECT 1 FROM Posts p2 WHERE p2.ParentId = fp.Id) THEN 'Has Answers' ELSE 'No Answers' END as answer_status,
    CASE WHEN EXISTS (SELECT 1 FROM Comments c WHERE c.PostId = fp.Id) THEN 'Has Comments' ELSE 'No Comments' END as comment_status
FROM FilteredPosts fp
LEFT JOIN UserActivity ua ON fp.OwnerUserId = ua.UserId
WHERE fp.OwnerUserId IS NOT NULL
  AND fp.Score IS NOT NULL
  AND fp.Score > 0  
  AND (fp.Score + fp.ViewCount + fp.AnswerCount + fp.CommentCount + fp.FavoriteCount) > 0
  AND (fp.Title IS NOT NULL AND LENGTH(TRIM(fp.Title)) > 0)
  AND fp.CreationDate >= TIMESTAMP '2020-01-01 00:00:00'
  AND fp.CreationDate <= TIMESTAMP '2023-12-31 23:59:59'
  AND fp.Id IS NOT NULL
ORDER BY fp.Score DESC, fp.ViewCount DESC, fp.LastActivityDate DESC
LIMIT 1000;