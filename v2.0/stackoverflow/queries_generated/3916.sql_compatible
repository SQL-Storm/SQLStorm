WITH UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Views,0)                         AS TotalViews,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1) AS QuestionCount,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2) AS AnswerCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
        MAX(p.CreationDate)                         AS LastPostDate
    FROM Users u
    LEFT JOIN Posts   p ON p.OwnerUserId = u.Id
    LEFT JOIN Votes   v ON v.UserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views
),

BadgeRanks AS (
    SELECT 
        b.UserId,
        SUM(CASE 
                WHEN b.Class = 1 THEN 1000
                WHEN b.Class = 2 THEN 500
                ELSE 100 
            END)                                         AS BadgeScore,
        COUNT(*) FILTER (WHERE b.TagBased = TRUE)      AS TagBadgeCount,
        COUNT(*) FILTER (WHERE b.TagBased = FALSE)     AS NamedBadgeCount
    FROM Badges b
    GROUP BY b.UserId
),

RecentActivity AS (
    SELECT 
        u.Id,
        GREATEST(
            COALESCE(u.LastAccessDate,        CAST('1970-01-01' AS TIMESTAMP)),
            COALESCE(p.LastActivityDate,     CAST('1970-01-01' AS TIMESTAMP)),
            COALESCE(c.CreationDate,         CAST('1970-01-01' AS TIMESTAMP))
        )                                               AS LastActivity
    FROM Users u
    LEFT JOIN Posts    p ON p.OwnerUserId = u.Id
    LEFT JOIN Comments c ON c.UserId      = u.Id
),

TagUsage AS (
    SELECT 
        p.OwnerUserId                              AS UserId,
        UNNEST(string_to_array(trim(both '<>' FROM p.Tags), '><')) AS Tag,
        COUNT(*)                                   AS Uses
    FROM Posts p
    WHERE p.PostTypeId = 1 AND p.Tags IS NOT NULL
    GROUP BY p.OwnerUserId, Tag
),

TopTags AS (
    SELECT 
        tu.UserId,
        STRING_AGG(tu.Tag, ', ' ORDER BY tu.Uses DESC) 
            FILTER (WHERE tu.rn <= 3)               AS Top3Tags
    FROM (
        SELECT 
            tu.*,
            ROW_NUMBER() OVER (PARTITION BY tu.UserId ORDER BY tu.Uses DESC) AS rn
        FROM TagUsage tu
    ) tu
    GROUP BY tu.UserId
),

Combined AS (
    SELECT 
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.QuestionCount,
        us.AnswerCount,
        COALESCE(br.BadgeScore,0)                         AS BadgeScore,
        us.TotalViews,
        us.UpVotesGiven,
        us.DownVotesGiven,
        ra.LastActivity,
        tt.Top3Tags,
        RANK() OVER (ORDER BY us.Reputation + COALESCE(br.BadgeScore,0) DESC) 
                                                          AS ReputationBadgeRank
    FROM UserStats       us
    LEFT JOIN BadgeRanks      br ON br.UserId = us.Id
    LEFT JOIN RecentActivity  ra ON ra.Id    = us.Id
    LEFT JOIN TopTags         tt ON tt.UserId = us.Id
)

SELECT *
FROM Combined
WHERE ReputationBadgeRank <= 100

UNION ALL

SELECT 
    CAST(NULL AS INTEGER)               AS Id,
    'Aggregated Totals'                 AS DisplayName,
    SUM(Reputation)                     AS Reputation,
    SUM(QuestionCount)                  AS QuestionCount,
    SUM(AnswerCount)                    AS AnswerCount,
    SUM(BadgeScore)                     AS BadgeScore,
    SUM(TotalViews)                     AS TotalViews,
    SUM(UpVotesGiven)                   AS UpVotesGiven,
    SUM(DownVotesGiven)                 AS DownVotesGiven,
    MAX(LastActivity)                   AS LastActivity,
    CAST(NULL AS TEXT)                  AS Top3Tags,
    CAST(NULL AS INTEGER)               AS ReputationBadgeRank
FROM Combined

ORDER BY ReputationBadgeRank NULLS LAST, Reputation DESC
LIMIT 101;