WITH 
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, '<unknown>') AS Location,
        (
            SELECT COUNT(*) 
            FROM Posts p 
            WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1
        ) AS QuestionCount,
        (
            SELECT COUNT(*) 
            FROM Posts p 
            WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2
        ) AS AnswerCount,
        (
            SELECT COUNT(*) 
            FROM Comments c 
            WHERE c.UserId = u.Id
        ) AS CommentCount,
        (
            SELECT COUNT(*) 
            FROM Badges b 
            WHERE b.UserId = u.Id
        ) AS BadgeCount,
        (
            SELECT MAX(p.CreationDate) 
            FROM Posts p 
            WHERE p.OwnerUserId = u.Id
        ) AS LastPostDate
    FROM Users u
),
TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rn
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
),
UserRecentPosts AS (
    SELECT 
        p.OwnerUserId,
        p.Id AS PostId,
        p.Title,
        p.Score,
        p.CreationDate,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
    FROM Posts p
    WHERE p.OwnerUserId IS NOT NULL
),
UserTagInfo AS (
    SELECT 
        pt.OwnerUserId,
        pt.TagName,
        ROW_NUMBER() OVER (PARTITION BY pt.OwnerUserId ORDER BY tt.Count DESC) AS rn
    FROM (
        SELECT 
            p.OwnerUserId,
            -- standard SQL: split tags by removing surrounding <> and splitting on '><'
            -- Use a generic string-splitting approach: many dialects have JSON or regexp functions;
            -- fallback using a recursive split for portability is complex; here assume a split function named SPLIT (some SQLs use STRING_SPLIT, others require custom)
            -- For broad compatibility, emulate UNNEST(STRING_TO_ARRAY(...)) with a VALUES-driven approach where supported.
            -- But to keep compatibility, use a common technique: replace '><' with '>|<' and then split on '|' — here we use a simple regexp_split_to_table where available.
            -- Replace Postgres-specific functions with a portable expression: assume Tags stored as '<tag1><tag2>' and use REPLACE and a generic split function named regexp_split_to_table if supported.
            -- To avoid dialect-specific function names, use a derived approach relying on XML functions in some RDBMS is not feasible here.
            -- Use standard-conforming approach: remove leading/trailing '<' and '>' then split on '><' using a split function name SPLIT_PART in a cross-apply style.
            -- Many dialects support a table-valued function to split; here we present a commonly supported approach using a recursive CTE to split tags.
            TRIM(BOTH '<' FROM TRIM(BOTH '>' FROM p.Tags)) AS tagstring
        FROM Posts p
        WHERE p.Tags IS NOT NULL
    ) src
    CROSS JOIN LATERAL (
        -- split tagstring by '><' into rows in a dialect-agnostic way using recursive CTE
        SELECT value AS TagName, OwnerUserId
        FROM (
            WITH RECURSIVE splitter(pos, rest, OwnerUserId) AS (
                SELECT 1, src.tagstring || '><', src.OwnerUserId
                UNION ALL
                SELECT
                    CASE WHEN INSTR(rest, '><') = 0 THEN NULL ELSE INSTR(rest, '><') + 2 END,
                    CASE WHEN INSTR(rest, '><') = 0 THEN '' ELSE SUBSTR(rest, INSTR(rest, '><') + 2) END,
                    OwnerUserId
                FROM splitter
                WHERE rest <> ''
            ),
            extracted AS (
                SELECT
                    CASE
                        WHEN INSTR(rest, '><') = 0 THEN TRIM(rest)
                        ELSE TRIM(SUBSTR(rest, 1, INSTR(rest, '><') - 1))
                    END AS value,
                    OwnerUserId
                FROM splitter
                WHERE rest <> ''
            )
            SELECT value, OwnerUserId FROM extracted WHERE value <> ''
        )
    ) pt(tagname, OwnerUserId)
    JOIN Tags tt ON tt.TagName = pt.tagname
),
Combined AS (
    SELECT 
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.Location,
        us.QuestionCount,
        us.AnswerCount,
        us.CommentCount,
        us.BadgeCount,
        us.LastPostDate,
        COALESCE(urp.Title, '<no recent post>') AS RecentPostTitle,
        COALESCE(urp.Score, 0) AS RecentPostScore,
        CASE 
            WHEN us.Reputation > 20000 THEN 'Elite'
            WHEN us.Reputation > 5000 THEN 'Power'
            ELSE 'Regular'
        END AS ReputationTier,
        -- Use LISTAGG for compatibility; if not available, some DBs use STRING_AGG
        -- Use LISTAGG with DISTINCT emulate by grouping before aggregation
        STRING_AGG(uti.TagName, ', ') FILTER (WHERE uti.rn <= 5) AS Top5Tags
    FROM UserStats us
    LEFT JOIN UserRecentPosts urp ON urp.OwnerUserId = us.Id AND urp.rn = 1
    LEFT JOIN UserTagInfo uti ON uti.OwnerUserId = us.Id
    GROUP BY 
        us.Id, us.DisplayName, us.Reputation, us.Location,
        us.QuestionCount, us.AnswerCount, us.CommentCount,
        us.BadgeCount, us.LastPostDate,
        urp.Title, urp.Score
    HAVING COUNT(uti.TagName) FILTER (WHERE uti.rn <= 5) > 0
)
SELECT 
    c.Id,
    c.DisplayName,
    c.Reputation,
    c.Location,
    c.QuestionCount,
    c.AnswerCount,
    c.CommentCount,
    c.BadgeCount,
    c.LastPostDate,
    c.RecentPostTitle,
    c.RecentPostScore,
    c.ReputationTier,
    c.Top5Tags
FROM Combined c
ORDER BY c.Reputation DESC
LIMIT 100

UNION ALL

SELECT 
    CAST(NULL AS INTEGER) AS Id,
    'Aggregate Summary' AS DisplayName,
    CAST(NULL AS INTEGER) AS Reputation,
    CAST(NULL AS VARCHAR(4000)) AS Location,
    SUM(QuestionCount) AS QuestionCount,
    SUM(AnswerCount) AS AnswerCount,
    SUM(CommentCount) AS CommentCount,
    SUM(BadgeCount) AS BadgeCount,
    CAST(NULL AS TIMESTAMP) AS LastPostDate,
    CAST(NULL AS VARCHAR(4000)) AS RecentPostTitle,
    CAST(NULL AS INTEGER) AS RecentPostScore,
    CAST(NULL AS VARCHAR(50)) AS ReputationTier,
    CAST(NULL AS VARCHAR(4000)) AS Top5Tags
FROM Combined;