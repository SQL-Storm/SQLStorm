-- {"query": "377.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 3723} 
with recent_users as (
    select
        u.id as user_id,
        u.displayname,
        u.reputation,
        u.creationdate,
        u.location,
        coalesce(nullif(trim(u.websiteurl), ''), 'http://example.invalid') as websiteurl_norm,
        dense_rank() over (order by date_trunc('month', u.creationdate) desc, u.reputation desc) as recency_rank
    from users u
    where u.creationdate >= (select date_trunc('month', max(creationdate)) - interval '12 months' from users)
),
user_badge_agg as (
    select
        b.userid,
        count(*) as badge_count,
        sum(case when b.class = 1 then 1 else 0 end) as gold_count,
        sum(case when b.class = 2 then 1 else 0 end) as silver_count,
        sum(case when b.class = 3 then 1 else 0 end) as bronze_count,
        min(b.date) as first_badge_date,
        max(b.date) as last_badge_date
    from badges b
    group by b.userid
),
user_post_activity as (
    select
        p.owneruserid as user_id,
        sum(case when p.posttypeid = 1 then 1 else 0 end) as questions,
        sum(case when p.posttypeid = 2 then 1 else 0 end) as answers,
        sum(coalesce(p.viewcount,0)) as total_views,
        sum(case when p.closeddate is not null then 1 else 0 end) as closed_posts,
        avg(nullif(p.score,0)) filter (where p.posttypeid in (1,2)) as avg_nonzero_score_qna,
        max(p.lastactivitydate) as last_post_activity
    from posts p
    where p.owneruserid is not null
    group by p.owneruserid
),
q_edit_volatility as (
    select
        ph.postid,
        count(*) filter (where ph.posthistorytypeid in (4,5,6,7,8,9,24)) as edit_events,
        count(*) filter (where ph.posthistorytypeid in (10,11,12,13,14,15,19,20,35)) as mod_events,
        min(ph.creationdate) as first_ph_date,
        max(ph.creationdate) as last_ph_date
    from posthistory ph
    group by ph.postid
),
accepted_answerers as (
    select
        p.parentid as question_id,
        p.owneruserid as answerer_id,
        p.id as answer_id
    from posts p
    join posts q on q.acceptedanswerid = p.id
    where p.posttypeid = 2
),
question_metrics as (
    select
        q.id as question_id,
        q.owneruserid as asker_id,
        q.score,
        q.viewcount,
        q.answercount,
        q.creationdate,
        q.lastactivitydate,
        coalesce(e.edit_events,0) as edit_events,
        coalesce(e.mod_events,0) as mod_events,
        case when q.tags is null then 0 else cardinality(string_to_array(substring(q.tags, 2, length(q.tags)-2), '><')) end as tag_count,
        exists (
            select 1
            from votes v
            where v.postid = q.id and v.votetypeid = 5
        ) as had_favorite,
        (
            select count(*)
            from comments c
            where c.postid = q.id and c.score > 0
        ) as pos_comment_count
    from posts q
    left join q_edit_volatility e on e.postid = q.id
    where q.posttypeid = 1
),
dupe_chains as (
    select
        pl.postid as dup_post_id,
        pl.relatedpostid as canonical_id,
        pl.creationdate as dup_link_date,
        row_number() over (partition by pl.postid order by pl.creationdate asc) as dup_order
    from postlinks pl
    where pl.linktypeid = 3
),
user_vote_summary as (
    select
        u.id as user_id,
        sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes_cast,
        sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes_cast,
        sum(case when v.votetypeid = 8 then coalesce(v.bountyamount,0) else 0 end) as bounties_started,
        sum(case when v.votetypeid = 9 then coalesce(v.bountyamount,0) else 0 end) as bounties_awarded
    from users u
    left join votes v on v.userid = u.id
    group by u.id
),
active_tag_usage as (
    select
        t.tagname,
        t.count as tag_total_count,
        t.ismoderaTORonly as mod_only,
        t.isrequired as is_required,
        coalesce(sum(case when q.creationdate >= (cast('2024-10-01 12:34:56' as timestamp) - interval '90 days') then 1 else 0 end),0) as recent_q
    from tags t
    left join posts q
      on q.posttypeid = 1
     and q.tags like concat('%<', t.tagname, '>%')
    group by t.tagname, t.count, t.ismoderaTORonly, t.isrequired
),
u_qna_window as (
    select
        p.owneruserid as user_id,
        p.id as post_id,
        p.posttypeid,
        p.creationdate,
        p.score,
        sum(case when p.posttypeid = 1 then 1 else 0 end) over (partition by p.owneruserid order by p.creationdate rows between unbounded preceding and current row) as running_questions,
        sum(case when p.posttypeid = 2 then 1 else 0 end) over (partition by p.owneruserid order by p.creationdate rows between unbounded preceding and current row) as running_answers,
        avg(p.score) over (partition by p.owneruserid order by p.creationdate rows between 10 preceding and current row) as rolling_score_avg_10
    from posts p
    where p.owneruserid is not null
      and p.posttypeid in (1,2)
),
user_outliers as (
    select
        u.user_id,
        percentile_cont(0.9) within group (order by coalesce(uw.rolling_score_avg_10,0)) as p90_roll_avg,
        max(uw.running_answers) as max_running_answers
    from recent_users u
    left join u_qna_window uw on uw.user_id = u.user_id
    group by u.user_id
),
user_latest_dupe_canonical as (
    select
        q.owneruserid as user_id,
        d.canonical_id,
        d.dup_link_date,
        row_number() over (partition by q.owneruserid order by d.dup_link_date desc, d.dup_order desc) as rn
    from dupe_chains d
    join posts q on q.id = d.dup_post_id
    where q.owneruserid is not null
),
final_user as (
    select
        ru.user_id,
        ru.displayname,
        ru.reputation,
        ru.creationdate,
        ru.location,
        ru.websiteurl_norm,
        ru.recency_rank,
        uba.badge_count,
        uba.gold_count,
        uba.silver_count,
        uba.bronze_count,
        upa.questions,
        upa.answers,
        upa.total_views,
        upa.closed_posts,
        upa.avg_nonzero_score_qna,
        upa.last_post_activity,
        uvs.upvotes_cast,
        uvs.downvotes_cast,
        uvs.bounties_started,
        uvs.bounties_awarded,
        uo.p90_roll_avg,
        uo.max_running_answers,
        uldc.canonical_id as latest_dupe_canonical_id
    from recent_users ru
    left join user_badge_agg uba on uba.userid = ru.user_id
    left join user_post_activity upa on upa.user_id = ru.user_id
    left join user_vote_summary uvs on uvs.user_id = ru.user_id
    left join user_outliers uo on uo.user_id = ru.user_id
    left join user_latest_dupe_canonical uldc on uldc.user_id = ru.user_id and uldc.rn = 1
),
tag_extract as (
    select
        q.question_id,
        unnest(string_to_array(substring(q.tags, 2, length(q.tags)-2), '><')) as tagname
    from posts p
    join question_metrics q on q.question_id = p.id
    where p.posttypeid = 1
      and p.tags is not null
),
question_tag_stats as (
    select
        te.question_id,
        count(*) as tag_count,
        sum(case when at.mod_only = 1 then 1 else 0 end) as mod_only_tags,
        sum(case when at.is_required = 1 then 1 else 0 end) as required_tags,
        max(at.recent_q) as tag_recent_q_max
    from tag_extract te
    left join active_tag_usage at on at.tagname = te.tagname
    group by te.question_id
),
accepted_answerer_quality as (
    select
        aa.answerer_id,
        count(*) as accepted_answers,
        avg(qm.score) as avg_q_score_where_accepted,
        sum(coalesce(qm.viewcount,0)) as total_q_views_where_accepted
    from accepted_answerers aa
    join question_metrics qm on qm.question_id = aa.question_id
    group by aa.answerer_id
),
question_enriched as (
    select
        qm.question_id,
        qm.asker_id,
        qm.score,
        qm.viewcount,
        qm.answercount,
        qm.creationdate,
        qm.lastactivitydate,
        qm.edit_events,
        qm.mod_events,
        qm.tag_count,
        qm.had_favorite::int as had_favorite,
        qm.pos_comment_count,
        qts.mod_only_tags,
        qts.required_tags,
        qts.tag_recent_q_max,
        coalesce(aq.accepted_answers,0) as asker_accepted_answers_given,
        coalesce(aq.avg_q_score_where_accepted,0) as asker_avg_q_score_where_accepted,
        coalesce(aq.total_q_views_where_accepted,0) as asker_total_q_views_where_accepted
    from question_metrics qm
    left join question_tag_stats qts on qts.question_id = qm.question_id
    left join accepted_answerer_quality aq on aq.answerer_id = qm.asker_id
),
scored_users as (
    select
        fu.user_id,
        fu.displayname,
        fu.reputation,
        fu.recency_rank,
        coalesce(fu.badge_count,0) as badge_count,
        coalesce(fu.gold_count,0) as gold_count,
        coalesce(fu.silver_count,0) as silver_count,
        coalesce(fu.bronze_count,0) as bronze_count,
        coalesce(fu.questions,0) as questions,
        coalesce(fu.answers,0) as answers,
        coalesce(fu.total_views,0) as total_views,
        coalesce(fu.closed_posts,0) as closed_posts,
        coalesce(fu.avg_nonzero_score_qna,0) as avg_nonzero_score_qna,
        coalesce(fu.upvotes_cast,0) as upvotes_cast,
        coalesce(fu.downvotes_cast,0) as downvotes_cast,
        coalesce(fu.bounties_started,0) as bounties_started,
        coalesce(fu.bounties_awarded,0) as bounties_awarded,
        coalesce(fu.p90_roll_avg,0) as p90_roll_avg,
        coalesce(fu.max_running_answers,0) as max_running_answers,
        fu.latest_dupe_canonical_id,
        sum(case
                when qe.score >= 5 then 2
                when qe.score >= 0 then 1
                else 0
            end
        ) as pos_q_contrib,
        sum(case when qe.had_favorite = 1 then 3 else 0 end) as fav_q_bonus,
        avg(qe.viewcount) as avg_q_views,
        count(qe.question_id) as q_count_sampled
    from final_user fu
    left join question_enriched qe on qe.asker_id = fu.user_id
    group by fu.user_id, fu.displayname, fu.reputation, fu.recency_rank, fu.badge_count, fu.gold_count, fu.silver_count, fu.bronze_count, fu.questions, fu.answers, fu.total_views, fu.closed_posts, fu.avg_nonzero_score_qna, fu.upvotes_cast, fu.downvotes_cast, fu.bounties_started, fu.bounties_awarded, fu.p90_roll_avg, fu.max_running_answers, fu.latest_dupe_canonical_id
),
ranked as (
    select
        su.*,
        row_number() over (
            order by
                -- composite score emphasizing quality, activity, consistency
                (coalesce(su.pos_q_contrib,0) * 1.0)
              + (coalesce(su.fav_q_bonus,0) * 1.5)
              + (least(coalesce(su.answers,0), 500) * 0.05)
              + (least(coalesce(su.questions,0), 200) * 0.1)
              + (case when su.p90_roll_avg > 0 then ln(1 + su.p90_roll_avg) else 0 end) * 4
              + (case when su.avg_nonzero_score_qna > 0 then su.avg_nonzero_score_qna else 0 end) * 0.5
              + (case when su.gold_count > 0 then su.gold_count * 2 else 0 end)
              + (case when su.silver_count > 0 then su.silver_count * 1 else 0 end)
              + (case when su.bronze_count > 0 then su.bronze_count * 0.5 else 0 end)
              - (coalesce(su.downvotes_cast,0) * 0.1)
              + (case when su.q_count_sampled > 0 then (su.avg_q_views / greatest(su.q_count_sampled,1)) else 0 end) * 0.01
        desc, su.reputation desc, su.user_id asc
        ) as overall_rank
    from scored_users su
),
null_logic_demo as (
    select
        r.*,
        coalesce(nullif(trim(r.displayname), ''), concat('user#', r.user_id::varchar)) as safe_displayname,
        case
            when r.latest_dupe_canonical_id is null then 'NoRecentDupes'
            when r.latest_dupe_canonical_id = r.user_id then 'SelfRefAnomaly'
            else 'HasRecentDupeLink'
        end as dupe_status
    from ranked r
),
string_math_predicate as (
    select
        n.*,
        -- complicated predicate demo for filtering; keep in CTE to materialize
        (case
            when position(' ' in n.safe_displayname) > 0 then length(split_part(n.safe_displayname, ' ', 1))
            else length(n.safe_displayname)
         end
        + coalesce(n.badge_count,0)
        + greatest(coalesce(n.answers,0) - coalesce(n.questions,0), 0)
        - least(coalesce(n.downvotes_cast,0), 10)
        ) as funky_score_component
    from null_logic_demo n
)
select
    s.overall_rank,
    s.user_id,
    s.safe_displayname as displayname,
    s.reputation,
    s.recency_rank,
    s.badge_count,
    s.gold_count,
    s.silver_count,
    s.bronze_count,
    s.questions,
    s.answers,
    s.total_views,
    s.closed_posts,
    round(coalesce(s.avg_nonzero_score_qna,0)::numeric, 3) as avg_nonzero_score_qna,
    s.upvotes_cast,
    s.downvotes_cast,
    s.bounties_started,
    s.bounties_awarded,
    round(coalesce(s.p90_roll_avg,0)::numeric, 3) as p90_roll_avg,
    s.max_running_answers,
    s.latest_dupe_canonical_id,
    s.pos_q_contrib,
    s.fav_q_bonus,
    round(coalesce(s.avg_q_views,0)::numeric, 1) as avg_q_views,
    s.q_count_sampled,
    s.dupe_status,
    s.funky_score_component,
    case when s.funky_score_component > percentile_cont(0.75) within group (order by s.funky_score_component) over () then 'TopQuartile' else 'LowerQuartiles' end as funky_score_bucket
from string_math_predicate s
where (
        s.recency_rank <= 100
        or (s.answers >= 50 and s.reputation >= 1000)
        or (s.pos_q_contrib + s.fav_q_bonus) >= 25
      )
  and not (
        s.dupe_status = 'SelfRefAnomaly'
        and s.funky_score_component < 0
      )
order by s.overall_rank
limit 250;