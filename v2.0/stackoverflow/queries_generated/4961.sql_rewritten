WITH QuestionScores AS (
    SELECT
        p.Id AS QuestionId,
        p.Title AS QuestionTitle,
        p.CreationDate AS QuestionCreationDate,
        p.OwnerUserId,
        COUNT(CASE WHEN v.VoteTypeId = 2 THEN 1 END) AS UpVoteCount,
        COUNT(CASE WHEN v.VoteTypeId = 3 THEN 1 END) AS DownVoteCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 WHEN v.VoteTypeId = 3 THEN -1 ELSE 0 END) AS NetScore,
        AVG(p.AnswerCount) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN 10 PRECEDING AND CURRENT ROW) AS AvgRecentAnswers,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS QuestionSequence
    FROM Posts p
    LEFT JOIN Votes v ON p.Id = v.PostId
    WHERE p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL AND p.OwnerUserId != -1
    GROUP BY p.Id, p.Title, p.CreationDate, p.OwnerUserId, p.AnswerCount
),
UserActivity AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges,
        COUNT(DISTINCT c.Id) AS CommentCount,
        SUM(CASE WHEN ph.PostHistoryTypeId IN (2, 5) THEN 1 ELSE 0 END) AS BodyEdits,
        MAX(qs.QuestionCreationDate) AS LastQuestionDate
    FROM Users u
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId AND ph.PostHistoryTypeId IN (2, 5)
    LEFT JOIN QuestionScores qs ON u.Id = qs.OwnerUserId
    WHERE u.DisplayName IS NOT NULL AND u.DisplayName NOT LIKE '%(deleted)%'
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.CreationDate
)
SELECT
    qs.QuestionId,
    qs.QuestionTitle,
    ua.DisplayName AS OwnerDisplayName,
    ua.Reputation,
    qs.UpVoteCount,
    qs.DownVoteCount,
    qs.NetScore,
    ua.GoldBadges,
    ua.SilverBadges,
    ua.BronzeBadges,
    qs.AvgRecentAnswers,
    ua.CommentCount,
    ua.BodyEdits,
    CASE
        WHEN qs.QuestionSequence = 1 THEN 'Most Recent'
        WHEN qs.QuestionSequence <= 5 THEN 'Top 5 Recent'
        ELSE 'Other'
    END AS QuestionRecencyCategory,
    CASE
        WHEN ua.Reputation > 100000 THEN 'Expert'
        WHEN ua.Reputation > 10000 THEN 'Experienced'
        WHEN ua.Reputation > 1000 THEN 'Intermediate'
        ELSE 'Beginner'
    END AS ReputationLevel,
    COALESCE(ua.LastQuestionDate, ua.UserCreationDate) AS EffectiveLastActivity,
    CASE WHEN qs.NetScore > 50 AND qs.UpVoteCount > qs.DownVoteCount * 5 THEN 'Highly Rated' ELSE 'Standard' END AS ScoreClassification
FROM QuestionScores qs
INNER JOIN UserActivity ua ON qs.OwnerUserId = ua.UserId
WHERE
    qs.QuestionCreationDate >= '2023-01-01'
    AND qs.NetScore >= 0
    AND ua.Reputation > 100
    AND ua.UserCreationDate < DATE('now', '-1 year')
    AND qs.QuestionSequence <= 10
    AND qs.AvgRecentAnswers IS NOT NULL
ORDER BY
    qs.NetScore DESC,
    ua.Reputation DESC
LIMIT 100;