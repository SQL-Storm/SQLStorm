WITH PostStats AS (
    SELECT 
        p.Id,
        p.PostTypeId,
        p.ParentId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.CreationDate,
        p.LastActivityDate,
        p.Title,
        p.Tags,
        p.Body,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END AS PostType,
        CASE 
            WHEN p.Score > 100 THEN 'High'
            WHEN p.Score > 50 THEN 'Medium'
            ELSE 'Low'
        END AS ScoreCategory,
        COALESCE(p.AnswerCount, 0) AS AnswerCountOrZero,
        COALESCE(p.CommentCount, 0) AS CommentCountOrZero,
        COALESCE(p.Tags, '') AS ProperTags,
        LENGTH(p.Body) AS BodyLength,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - p.CreationDate)) / 86400 AS integer) AS DaysSinceCreation,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS UserPostRank,
        RANK() OVER (ORDER BY p.Score DESC) AS ScoreRank,
        DENSE_RANK() OVER (ORDER BY p.ViewCount DESC) AS ViewRank,
        AVG(p.Score) OVER (PARTITION BY p.OwnerUserId) AS AvgScorePerUser,
        MAX(p.Score) OVER (PARTITION BY p.OwnerUserId) AS MaxScorePerUser,
        LAG(p.Score, 1) OVER (ORDER BY p.CreationDate) AS PreviousScore,
        LEAD(p.Score, 1) OVER (ORDER BY p.CreationDate) AS NextScore,
        NTILE(10) OVER (ORDER BY p.ViewCount) AS ViewQuartile
    FROM Posts p
    WHERE p.PostTypeId IN (1, 2)
),
AnswerStats AS (
    SELECT 
        a.ParentId AS QuestionId,
        COUNT(*) AS AnswerCount,
        SUM(a.Score) AS TotalAnswerScore,
        AVG(a.Score) AS AvgAnswerScore,
        MAX(a.Score) AS MaxAnswerScore
    FROM Posts a
    WHERE a.PostTypeId = 2
    GROUP BY a.ParentId
),
UserReputationStats AS (
    SELECT 
        u.Id AS UserId,
        u.Reputation,
        u.UpVotes,
        u.DownVotes,
        u.ViewCount AS UserViewCount,
        u.AccountId,
        u.DisplayName,
        CASE 
            WHEN u.Reputation > 10000 THEN 'Expert'
            WHEN u.Reputation > 5000 THEN 'Advanced'
            WHEN u.Reputation > 1000 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS ReputationTier,
        COALESCE(u.WebsiteUrl, 'No Website') AS WebsiteInfo,
        COALESCE(u.Location, 'Unknown Location') AS LocationInfo,
        LENGTH(u.AboutMe) AS AboutMeLength,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - u.CreationDate)) / 86400 AS integer) AS DaysSinceJoin,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        ROW_NUMBER() OVER (ORDER BY u.DownVotes DESC) AS DownVoteRank,
        COALESCE(u.EmailHash, 'No Email') AS EmailHashInfo
    FROM Users u
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count AS TagCount,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE 
            WHEN t.Count > 1000 THEN 'Popular'
            WHEN t.Count > 500 THEN 'Moderately Popular'
            ELSE 'Less Popular'
        END AS PopularityCategory,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - (
            SELECT MIN(CreationDate) FROM Posts WHERE Tags LIKE '%' || t.TagName || '%'
        ))) / 86400 AS integer) AS TagAgeDays,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS PopularTagRank
    FROM Tags t
    WHERE t.Count > 0
),
QuestionDetails AS (
    SELECT 
        q.Id AS QuestionId,
        q.Title,
        q.Tags,
        q.AnswerCount,
        q.CommentCount,
        q.ViewCount,
        q.Score,
        q.CreationDate,
        q.OwnerUserId,
        q.LastActivityDate,
        q.AcceptedAnswerId,
        CASE 
            WHEN q.AcceptedAnswerId IS NOT NULL THEN 'Answered'
            ELSE 'Unanswered'
        END AS QuestionStatus,
        CASE 
            WHEN q.ClosedDate IS NOT NULL THEN 'Closed'
            ELSE 'Open'
        END AS QuestionOpenStatus,
        COALESCE(q.AnswerCount, 0) AS SafeAnswerCount,
        COALESCE(q.CommentCount, 0) AS SafeCommentCount,
        CASE 
            WHEN q.ViewCount > 1000 THEN 'High View'
            WHEN q.ViewCount > 500 THEN 'Medium View'
            ELSE 'Low View'
        END AS ViewCategory,
        ROW_NUMBER() OVER (ORDER BY q.Score DESC) AS ScoreRankOnQuestion,
        DENSE_RANK() OVER (PARTITION BY q.OwnerUserId ORDER BY q.Score DESC) AS OwnerScoreRank
    FROM Posts q
    WHERE q.PostTypeId = 1
),
CommentAnalysis AS (
    SELECT 
        c.PostId,
        c.UserId,
        c.Score AS CommentScore,
        LENGTH(c.Text) AS CommentTextLength,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - c.CreationDate)) / 86400 AS integer) AS CommentAgeDays,
        ROW_NUMBER() OVER (PARTITION BY c.PostId ORDER BY c.CreationDate ASC) AS CommentOrder,
        COALESCE(c.UserDisplayName, 'Anonymous') AS CommentAuthorName,
        CASE 
            WHEN LENGTH(c.Text) > 100 THEN 'Long Comment'
            WHEN LENGTH(c.Text) > 50 THEN 'Medium Comment'
            ELSE 'Short Comment'
        END AS CommentLengthCategory
    FROM Comments c
),
PostHistoryAnalysis AS (
    SELECT 
        ph.PostId,
        ph.PostHistoryTypeId,
        ph.UserId,
        ph.CreationDate,
        ph.Comment,
        ph.Text,
        ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate ASC) AS EditOrder,
        CASE 
            WHEN ph.PostHistoryTypeId IN (10, 11, 12, 13, 14) THEN 'Moderation'
            WHEN ph.PostHistoryTypeId IN (1, 4, 5, 6) THEN 'Content'
            ELSE 'Other'
        END AS HistoryTypeCategory
    FROM PostHistory ph
),
CombinedPostAnalysis AS (
    SELECT 
        ps.Id AS PostId,
        ps.PostTypeId,
        ps.Title,
        ps.Tags,
        ps.Score,
        ps.ViewCount,
        ps.AnswerCountOrZero,
        ps.CommentCountOrZero,
        ps.CreationDate,
        ps.OwnerUserId,
        ps.LastActivityDate,
        ps.PostType,
        ps.ScoreCategory,
        ps.BodyLength,
        ps.DaysSinceCreation,
        ps.UserPostRank,
        ps.ScoreRank,
        ps.ViewRank,
        ps.AvgScorePerUser,
        ps.MaxScorePerUser,
        ps.PreviousScore,
        ps.NextScore,
        ps.ViewQuartile,
        COALESCE(as1.AnswerCount, 0) AS AnswerCountFromAnswerTable,
        COALESCE(as1.TotalAnswerScore, 0) AS TotalAnswerScore,
        COALESCE(as1.AvgAnswerScore, 0) AS AvgAnswerScore,
        COALESCE(as1.MaxAnswerScore, 0) AS MaxAnswerScore,
        rs.Reputation,
        rs.UpVotes,
        rs.DownVotes,
        rs.ReputationTier,
        rs.DaysSinceJoin,
        rs.ReputationRank,
        ta.TagName,
        ta.PopularityCategory,
        ta.PopularTagRank,
        qa.QuestionId,
        qa.QuestionStatus,
        qa.QuestionOpenStatus,
        qa.SafeAnswerCount,
        qa.SafeCommentCount,
        qa.ScoreRankOnQuestion,
        qa.OwnerScoreRank,
        ca.CommentScore,
        ca.CommentTextLength,
        ca.CommentAgeDays,
        ca.CommentOrder,
        pa.HistoryTypeCategory,
        COUNT(*) OVER () AS TotalRecordCount,
        STDDEV_POP(ps.Score) OVER (ORDER BY ps.CreationDate) AS ScoreStdDev,
        SUM(ps.Score) OVER (ORDER BY ps.CreationDate ROWS UNBOUNDED PRECEDING) AS CumulativeScore,
        LAG(ps.Score) OVER (ORDER BY ps.CreationDate) - ps.Score AS ScoreDifferenceFromPrevious,
        CASE 
            WHEN ps.Score > (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1) THEN 1
            ELSE 0
        END AS AboveAverageScore,
        COALESCE(ps.AvgScorePerUser, 0) AS SafeAvgScorePerUser
    FROM PostStats ps
    LEFT JOIN AnswerStats as1 ON ps.Id = as1.QuestionId
    LEFT JOIN UserReputationStats rs ON ps.OwnerUserId = rs.UserId
    LEFT JOIN (
        SELECT DISTINCT 
            ps.Id,
            ta.TagName,
            ta.PopularityCategory,
            ta.PopularTagRank
        FROM PostStats ps
        CROSS JOIN TagAnalysis ta
        WHERE ps.ProperTags LIKE '%' || ta.TagName || '%'
    ) ta ON ps.Id = ta.Id
    LEFT JOIN QuestionDetails qa ON ps.Id = qa.QuestionId
    LEFT JOIN CommentAnalysis ca ON ps.Id = ca.PostId
    LEFT JOIN PostHistoryAnalysis pa ON ps.Id = pa.PostId
)
SELECT 
    cpa.PostId,
    cpa.Title,
    cpa.Tags,
    cpa.Score,
    cpa.ViewCount,
    cpa.AnswerCountFromAnswerTable,
    cpa.CommentCountOrZero,
    cpa.CreationDate,
    cpa.OwnerUserId,
    cpa.PostType,
    cpa.ScoreCategory,
    cpa.Reputation,
    cpa.ReputationTier,
    cpa.TagName,
    cpa.PopularityCategory,
    cpa.QuestionStatus,
    cpa.QuestionOpenStatus,
    cpa.CommentScore,
    cpa.CommentTextLength,
    cpa.CommentAgeDays,
    cpa.CommentOrder,
    cpa.HistoryTypeCategory,
    cpa.AboveAverageScore,
    CASE 
        WHEN cpa.AnswerCountFromAnswerTable > 0 THEN cpa.Score * 1.2
        ELSE cpa.Score
    END AS AdjustedScore,
    COALESCE(cpa.AnswerCountFromAnswerTable, 0) + COALESCE(cpa.CommentCountOrZero, 0) AS EngagementCount,
    cpa.BodyLength,
    cpa.DaysSinceCreation,
    cpa.UserPostRank,
    cpa.ScoreRank,
    cpa.ViewRank,
    cpa.AvgScorePerUser,
    cpa.MaxScorePerUser,
    cpa.PreviousScore,
    cpa.NextScore,
    cpa.ViewQuartile,
    cpa.DaysSinceJoin,
    cpa.ReputationRank,
    cpa.PopularTagRank,
    cpa.ScoreRankOnQuestion,
    cpa.OwnerScoreRank,
    CASE 
        WHEN cpa.QuestionOpenStatus = 'Open' AND cpa.QuestionStatus = 'Answered' THEN 'Active Answered Question'
        WHEN cpa.QuestionOpenStatus = 'Open' AND cpa.QuestionStatus = 'Unanswered' THEN 'Active Unanswered Question'
        WHEN cpa.QuestionOpenStatus = 'Closed' THEN 'Closed Question'
        ELSE 'Other Question Status'
    END AS QuestionStatusCategory,
    CASE 
        WHEN cpa.AnswerCountFromAnswerTable > 1 THEN 'Multiple Answers'
        WHEN cpa.AnswerCountFromAnswerTable = 1 THEN 'Single Answer'
        ELSE 'No Answers'
    END AS AnswerCategory,
    TRIM(
        REPLACE(
            REPLACE(
                REPLACE(
                    REPLACE(
                        REPLACE(
                            REPLACE(
                                REPLACE(
                                    REPLACE(
                                        REPLACE(
                                            cpa.Title,
                                            '<', ' '
                                        ),
                                        '>', ' '
                                    ),
                                    '&', ' '
                                ),
                                '#', ' '
                            ),
                            '@', ' '
                        ),
                        ',', ' '
                    ),
                    '.', ' '
                ),
                '!', ' '
            ),
            '?', ' '
        )
    ) AS CleanedTitle,
    ABS(cpa.Score - (SELECT AVG(Score) FROM Posts WHERE PostTypeId = 1)) AS ScoreDeviation,
    cpa.AvgAnswerScore,
    cpa.MaxAnswerScore,
    cpa.TotalAnswerScore,
    CASE 
        WHEN cpa.Reputation > 5000 AND cpa.AnswerCountFromAnswerTable > 10 THEN 'High Engager'
        WHEN cpa.Reputation < 10000 AND cpa.AnswerCountFromAnswerTable < 5 THEN 'Low Engager'
        ELSE 'Moderate Engager'
    END AS UserEngagementLevel
FROM CombinedPostAnalysis cpa
WHERE (
    cpa.CreationDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '12 months')
    OR cpa.LastActivityDate >= (TIMESTAMP '2024-10-01 12:34:56' - INTERVAL '6 months')
)
AND cpa.AnswerCountFromAnswerTable >= 0
AND cpa.Score IS NOT NULL
AND cpa.ViewCount IS NOT NULL
AND cpa.PostType = 'Question'
ORDER BY 
    cpa.Score DESC,
    cpa.ViewCount DESC,
    cpa.DaysSinceCreation ASC
LIMIT 1000;