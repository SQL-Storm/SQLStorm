WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        CAST(EXTRACT(EPOCH FROM (TIMESTAMP '2024-10-01 12:34:56' - u.CreationDate)) / 86400 AS INTEGER) as AccountAgeDays,
        CASE 
            WHEN u.Reputation >= 10000 THEN 'Elite'
            WHEN u.Reputation >= 1000 THEN 'Veteran'
            WHEN u.Reputation >= 100 THEN 'Member'
            ELSE 'Newbie'
        END as ReputationTier,
        COALESCE(SUM(p.Score), 0) as TotalScore,
        COALESCE(AVG(p.Score), 0) as AvgPostScore,
        ROW_NUMBER() OVER (ORDER BY SUM(p.Score) DESC) as ScoreRank,
        RANK() OVER (ORDER BY u.Reputation DESC) as RepRank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as ActivityRank,
        CASE 
            WHEN COUNT(DISTINCT p.Id) > 0 THEN COALESCE(CAST(SUM(p.Score) AS NUMERIC) / COUNT(DISTINCT p.Id), 0)
            ELSE 0 
        END as AvgScorePerPost,
        CASE 
            WHEN u.Reputation > 0 AND COUNT(DISTINCT p.Id) > 0 
            THEN COALESCE(CAST(u.UpVotes AS NUMERIC) * 100 / u.Reputation, 0)
            ELSE 0 
        END as UpVoteRatio,
        (CASE WHEN length(u.DisplayName) >= 1 THEN upper(substring(u.DisplayName from 1 for 1)) ELSE '' END) ||
        (CASE WHEN LENGTH(u.DisplayName) > 1 THEN upper(substring(u.DisplayName from char_length(u.DisplayName) for 1)) ELSE '' END) as DisplayNameInitials
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.Id IS NOT NULL
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.CreationDate
),
TopPerformers AS (
    SELECT 
        *,
        CASE 
            WHEN ScoreRank <= 100 THEN 'Top 100'
            WHEN ScoreRank <= 1000 THEN 'Top 1000'
            WHEN ScoreRank <= 10000 THEN 'Top 10000'
            ELSE 'Below Top 10k'
        END as PerformanceCategory
    FROM UserActivityStats
    WHERE TotalPosts >= 50
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.PostTypeId,
        p.OwnerUserId,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.Title,
        TRIM(BOTH '<>' FROM COALESCE(p.Tags, '')) as CleanTags,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            WHEN p.PostTypeId = 4 THEN 'TagWikiExcerpt'
            WHEN p.PostTypeId = 5 THEN 'TagWiki'
            WHEN p.PostTypeId = 6 THEN 'ModeratorNomination'
            ELSE 'Other'
        END as PostCategory,
        CASE 
            WHEN LENGTH(p.Title) > 100 THEN substring(p.Title from 1 for 100) || '...'
            ELSE p.Title 
        END as ShortTitle,
        SUM(p.Score) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) as RunningScoreTotal,
        (SELECT COUNT(*) FROM Posts p2 
         WHERE p2.ParentId = p.Id 
         AND p2.PostTypeId = 2 
         AND p2.Score > 0) as PositiveAnswers
    FROM Posts p
    WHERE p.CreationDate >= TIMESTAMP '2020-01-01 00:00:00'
    AND p.OwnerUserId IS NOT NULL
),
TagAnalysis AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE 
            WHEN t.Count >= 1000 THEN 'Popular'
            WHEN t.Count >= 100 THEN 'Moderate'
            WHEN t.Count >= 10 THEN 'Common'
            ELSE 'Rare'
        END as TagPopularity,
        CAST(ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS NUMERIC) as RankInPopularity,
        CASE 
            WHEN t.ExcerptPostId IS NOT NULL AND t.WikiPostId IS NOT NULL THEN 'Complete'
            WHEN t.ExcerptPostId IS NOT NULL THEN 'ExcerptOnly'
            WHEN t.WikiPostId IS NOT NULL THEN 'WikiOnly'
            ELSE 'Incomplete'
        END as TagCompleteness,
        (SELECT COUNT(*) FROM Posts p 
         WHERE p.Tags LIKE '%' || t.TagName || '%'
         AND p.PostTypeId = 1) as QuestionCountWithTag
    FROM Tags t
    WHERE t.TagName IS NOT NULL
    AND LENGTH(t.TagName) > 0
),
FinalCombinedResult AS (
    SELECT 
        'UserPerformance' as DataType,
        CAST(tp.UserId as VARCHAR) as Id,
        tp.DisplayName as Name,
        CAST(tp.Reputation as VARCHAR) as Value1,
        CAST(tp.TotalScore as VARCHAR) as Value2,
        tp.ReputationTier as Value3,
        CAST(tp.ScoreRank as VARCHAR) as Rank1,
        NULL as Rank2,
        'Active' as Status
    FROM TopPerformers tp
    
    UNION ALL
    
    SELECT 
        'PostAnalysis' as DataType,
        CAST(pa.PostId as VARCHAR) as Id,
        pa.ShortTitle as Name,
        CAST(pa.Score as VARCHAR) as Value1,
        CAST(pa.ViewCount as VARCHAR) as Value2,
        pa.PostCategory as Value3,
        CAST(pa.PositiveAnswers as VARCHAR) as Rank1,
        NULL as Rank2,
        CASE 
            WHEN pa.Score > 10 THEN 'High'
            WHEN pa.Score > 0 THEN 'Medium'
            ELSE 'Low'
        END as Status
    FROM PostAnalysis pa
    
    UNION ALL
    
    SELECT 
        'TagAnalysis' as DataType,
        ta.TagName as Id,
        ta.TagName as Name,
        CAST(ta.Count as VARCHAR) as Value1,
        CAST(ta.QuestionCountWithTag as VARCHAR) as Value2,
        ta.TagPopularity as Value3,
        CAST(ta.RankInPopularity as VARCHAR) as Rank1,
        NULL as Rank2,
        ta.TagCompleteness as Status
    FROM TagAnalysis ta
)
SELECT 
    fc.DataType,
    fc.Id,
    fc.Name,
    fc.Value1,
    fc.Value2,
    fc.Value3,
    fc.Rank1,
    fc.Rank2,
    fc.Status,
    CASE 
        WHEN fc.Value1 IS NOT NULL AND fc.Value2 IS NOT NULL 
        THEN CAST(COALESCE(NULLIF(fc.Value1, ''), '0') AS INTEGER) + 
             CAST(COALESCE(NULLIF(fc.Value2, ''), '0') AS INTEGER)
        ELSE 0
    END as CombinedValue,
    COUNT(*) OVER (PARTITION BY fc.DataType, fc.Id, fc.Name, fc.Value1, fc.Value2, fc.Value3, fc.Rank1, fc.Rank2, fc.Status ORDER BY fc.Value1 ROWS BETWEEN 10 PRECEDING AND 10 FOLLOWING) as WindowCount,
    (SELECT COUNT(*) FROM Users u 
     LEFT JOIN Posts p ON u.Id = p.OwnerUserId 
     WHERE u.Id = CAST(fc.Id AS INTEGER) 
     AND p.CreationDate > TIMESTAMP '2020-01-01 00:00:00'
     AND p.PostTypeId = 1) as QuestionCount,
    -- STRING_AGG is not ANSI-standard as a windowed aggregate in many engines; emulate neighboring names using LISTAGG window if available or skip window aggregation.
    NULL as NeighboringNames
FROM FinalCombinedResult fc
WHERE fc.Id IS NOT NULL
AND (fc.Value1 IS NOT NULL OR fc.Value2 IS NOT NULL)
GROUP BY
    fc.DataType,
    fc.Id,
    fc.Name,
    fc.Value1,
    fc.Value2,
    fc.Value3,
    fc.Rank1,
    fc.Rank2,
    fc.Status
ORDER BY fc.DataType, 
         COALESCE(CAST(fc.Value1 AS INTEGER), 0) DESC,
         COALESCE(CAST(fc.Value2 AS INTEGER), 0) DESC
LIMIT 1000;