WITH warmed AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.Location,
    u.AboutMe,
    u.ProfileImageUrl,
    u.EmailHash AS EmailHash,
    u.AccountId,
    COALESCE(b.TotalBadges, 0) AS BadgeCount
  FROM Users u
  LEFT JOIN (
    SELECT UserId, COUNT(*) AS TotalBadges
    FROM Badges
    GROUP BY UserId
  ) b ON b.UserId = u.Id
),
recent_questions AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.CommentCount,
    p.FavoriteCount,
    p.LastActivityDate,
    p.AnswerCount,
    p.PostTypeId,
    p.AcceptedAnswerId,
    p.ParentId,
    p.LastEditorUserId,
    p.LastEditDate,
    p.ContentLicense
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '30' DAY)
),
tag_wiki_activity AS (
  SELECT
    t.TagName,
    t.Count AS TagCount,
    t.WikiPostId,
    w.Id AS WikiPostIdResolved,
    w.Title AS WikiTitle,
    w.CreationDate AS WikiCreated,
    pc.PostId,
    pc.ComputedScore
  FROM Tags t
  LEFT JOIN Posts w ON w.Id = t.WikiPostId
  LEFT JOIN (
    SELECT
      p.Id AS PostId,
      p.Score AS ComputedScore,
      p.CreationDate AS CreationDate
    FROM Posts p
    WHERE p.PostTypeId IN (4,5)
  ) pc ON pc.PostId = t.WikiPostId
)
SELECT
  warmed.UserId,
  warmed.DisplayName,
  warmed.Reputation,
  warmed.UserCreationDate,
  warmed.LastAccessDate,
  warmed.Location,
  warmed.AboutMe,
  warmed.Views,
  warmed.UpVotes,
  warmed.DownVotes,
  warmed.ProfileImageUrl,
  warmed.EmailHash,
  warmed.AccountId,
  warmed.BadgeCount,
  recent_questions.PostId AS QuestionId,
  recent_questions.Title AS QuestionTitle,
  recent_questions.Tags,
  recent_questions.CreationDate AS QuestionCreationDate,
  recent_questions.Score AS QuestionScore,
  recent_questions.ViewCount AS QuestionViews,
  recent_questions.CommentCount AS QuestionCommentCount,
  recent_questions.FavoriteCount AS QuestionFavorites,
  recent_questions.LastActivityDate AS QuestionLastActivity,
  recent_questions.AnswerCount,
  recent_questions.AcceptedAnswerId,
  recent_questions.ParentId,
  recent_questions.LastEditorUserId,
  recent_questions.LastEditDate AS QuestionLastEditDate,
  recent_questions.ContentLicense,
  RANK() OVER (
    ORDER BY warmed.Reputation DESC, warmed.UserId ASC
  ) AS UserRankByReputation,
  (
    SELECT COUNT(*) FROM (
      SELECT DISTINCT b.Id
      FROM Badges b
      WHERE b.UserId = warmed.UserId
    ) AS sub
  ) AS UserBadgeCount,
  taginfo.TagName AS TagName,
  taginfo.Count AS TagCount,
  taginfo.WikiPostId AS TagWikiPostId,
  taginfo.ExcerptPostId AS TagExcerptPostId,
  twa.TagName AS TwaTagName,
  twa.TagCount AS TwaTagCount,
  twa.WikiPostIdResolved,
  twa.WikiTitle,
  twa.WikiCreated,
  twa.PostId AS TwaPostId,
  twa.ComputedScore AS TwaComputedScore
FROM warmed
LEFT JOIN recent_questions
  ON recent_questions.OwnerUserId = warmed.UserId
LEFT JOIN (
  SELECT
    t.TagName,
    t.Count,
    t.WikiPostId,
    t.ExcerptPostId
  FROM Tags t
) AS taginfo ON 1 = 1
LEFT JOIN tag_wiki_activity twa
  ON twa.TagName = taginfo.TagName
GROUP BY
  warmed.UserId,
  warmed.DisplayName,
  warmed.Reputation,
  warmed.UserCreationDate,
  warmed.LastAccessDate,
  warmed.Location,
  warmed.AboutMe,
  warmed.Views,
  warmed.UpVotes,
  warmed.DownVotes,
  warmed.ProfileImageUrl,
  warmed.EmailHash,
  warmed.AccountId,
  warmed.BadgeCount,
  recent_questions.PostId,
  recent_questions.Title,
  recent_questions.Tags,
  recent_questions.CreationDate,
  recent_questions.Score,
  recent_questions.ViewCount,
  recent_questions.CommentCount,
  recent_questions.FavoriteCount,
  recent_questions.LastActivityDate,
  recent_questions.AnswerCount,
  recent_questions.AcceptedAnswerId,
  recent_questions.ParentId,
  recent_questions.LastEditorUserId,
  recent_questions.LastEditDate,
  recent_questions.ContentLicense,
  taginfo.TagName,
  taginfo.Count,
  taginfo.WikiPostId,
  taginfo.ExcerptPostId,
  twa.TagName,
  twa.TagCount,
  twa.WikiPostIdResolved,
  twa.WikiTitle,
  twa.WikiCreated,
  twa.PostId,
  twa.ComputedScore,
  RANK() OVER (
    ORDER BY warmed.Reputation DESC, warmed.UserId ASC
  ),
  (
    SELECT COUNT(*) FROM (
      SELECT DISTINCT b.Id
      FROM Badges b
      WHERE b.UserId = warmed.UserId
    ) AS sub
  )
ORDER BY UserRankByReputation ASC, warmed.UserId ASC
LIMIT 100;