WITH UserPostActivity AS (
    SELECT
        p.OwnerUserId,
        p.PostTypeId,
        p.CreationDate AS PostCreationDate,
        p.Score AS PostScore,
        p.ViewCount AS PostViewCount,
        COUNT(c.Id) AS CommentCount,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVoteCount,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVoteCount,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) as rn
    FROM Posts p
    LEFT JOIN Comments c ON p.Id = c.PostId
    LEFT JOIN Votes v ON p.Id = v.PostId AND v.VoteTypeId IN (2, 3)
    WHERE p.OwnerUserId IS NOT NULL AND p.OwnerUserId <> -1
    GROUP BY p.OwnerUserId, p.PostTypeId, p.CreationDate, p.Score, p.ViewCount
),
UserEngagement AS (
    SELECT
        upa.OwnerUserId,
        AVG(upa.PostScore) AS AvgPostScore,
        SUM(upa.PostViewCount) AS TotalPostViews,
        SUM(upa.CommentCount) AS TotalComments,
        SUM(upa.UpVoteCount) AS TotalUpvotes,
        SUM(upa.DownVoteCount) AS TotalDownvotes,
        CASE WHEN MAX(upa.rn) > 100 THEN 'High Activity' ELSE 'Standard Activity' END AS ActivityLevel
    FROM UserPostActivity upa
    GROUP BY upa.OwnerUserId, upa.rn
),
TopUsersWithBadges AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(b.Id) AS BadgeCount,
        MAX(b.Date) AS LastBadgeDate
    FROM Users u
    LEFT JOIN Badges b ON u.Id = b.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation
    HAVING COUNT(b.Id) > 5
)
SELECT
    t.DisplayName AS TopUserDisplayName,
    t.Reputation AS TopUserReputation,
    ue.AvgPostScore,
    ue.TotalPostViews,
    ue.TotalComments,
    ue.TotalUpvotes,
    ue.TotalDownvotes,
    ue.ActivityLevel,
    (SELECT COUNT(*) FROM PostHistory ph WHERE ph.UserId = t.UserId AND ph.PostHistoryTypeId IN (2, 5)) AS BodyEditCount,
    COALESCE(t.BadgeCount, 0) AS NumberOfBadges,
    t.LastBadgeDate,
    CASE
        WHEN u.Location IS NULL THEN 'Unknown'
        WHEN u.Location LIKE '%United States%' THEN 'USA'
        WHEN u.Location LIKE '%Canada%' THEN 'Canada'
        ELSE 'Other'
    END AS UserLocationCategory,
    COALESCE(DATEDIFF(day, u.CreationDate, cast('2024-10-01 12:34:56' as timestamp)), 0) AS AccountAgeDays,
    CASE WHEN u.WebsiteUrl IS NOT NULL AND u.WebsiteUrl <> '' THEN 1 ELSE 0 END AS HasWebsite,
    (
        SELECT COUNT(*)
        FROM Posts p_sub
        INNER JOIN PostLinks pl_sub ON p_sub.Id = pl_sub.PostId
        WHERE p_sub.OwnerUserId = t.UserId AND pl_sub.LinkTypeId = 3
    ) AS DuplicateLinkCount
FROM TopUsersWithBadges t
JOIN UserEngagement ue ON t.UserId = ue.OwnerUserId
LEFT JOIN Users u ON t.UserId = u.Id
WHERE ue.TotalUpvotes > 1000
  AND ue.TotalComments > 500
ORDER BY ue.AvgPostScore DESC, ue.TotalPostViews DESC
LIMIT 100;