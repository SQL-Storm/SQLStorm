WITH UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COALESCE(u.Location, '[unknown]')               AS Location,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id)                         AS TotalBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1)         AS GoldBadges,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 1) AS QuestionCount,
        (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = u.Id AND p.PostTypeId = 2) AS AnswerCount,
        (SELECT COALESCE(SUM(v.Score),0)
           FROM Votes v
           JOIN Posts p ON v.PostId = p.Id
          WHERE p.OwnerUserId = u.Id AND v.VoteTypeId = 2)                         AS UpVoteSum
    FROM Users u
    WHERE u.Reputation > 10000
),
RecentActivity AS (
    SELECT 
        u.Id,
        GREATEST(MAX(p.LastActivityDate), MAX(v.CreationDate)) AS LastActivity
    FROM Users u
    LEFT JOIN Posts p  ON p.OwnerUserId = u.Id
    LEFT JOIN Votes v  ON v.UserId = u.Id
    GROUP BY u.Id
),
TagPopularity AS (
    SELECT 
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS TagRank
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
),
TopTags AS (
    SELECT TagName, Count
    FROM TagPopularity
    WHERE TagRank <= 10
),
UserTagScore AS (
    SELECT 
        u.Id,
        SUM(CASE WHEN p.Tags LIKE '%' || tg.TagName || '%' THEN 1 ELSE 0 END) AS MatchingTagPosts
    FROM Users u
    JOIN Posts p ON p.OwnerUserId = u.Id AND p.PostTypeId = 1
    CROSS JOIN TopTags tg
    GROUP BY u.Id
),
Combined AS (
    SELECT 
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.Location,
        us.TotalBadges,
        us.GoldBadges,
        us.QuestionCount,
        us.AnswerCount,
        us.UpVoteSum,
        ra.LastActivity,
        COALESCE(uts.MatchingTagPosts,0) AS TagMatchCount
    FROM UserStats us
    LEFT JOIN RecentActivity ra ON ra.Id = us.Id
    LEFT JOIN UserTagScore uts  ON uts.Id = us.Id
)
SELECT
    c.Id,
    c.DisplayName,
    c.Reputation,
    c.Location,
    c.TotalBadges,
    c.GoldBadges,
    c.QuestionCount,
    c.AnswerCount,
    c.UpVoteSum,
    CASE 
        WHEN c.LastActivity IS NULL THEN 'Never'
        ELSE TO_CHAR(c.LastActivity,'YYYY-MM-DD')
    END                                    AS LastActiveDate,
    c.TagMatchCount,
    CASE 
        WHEN c.Reputation > 20000 AND c.GoldBadges >= 5 THEN 'Elite'
        WHEN c.Reputation > 15000 THEN 'Veteran'
        ELSE 'Member'
    END                                    AS Tier,
    (SELECT STRING_AGG(b.Name, ', ')
       FROM Badges b
      WHERE b.UserId = c.Id AND b.Class = 1) AS GoldBadgeNames
FROM Combined c
WHERE c.TagMatchCount > 0
ORDER BY c.Reputation DESC, c.GoldBadges DESC
OFFSET 0 ROWS FETCH NEXT 100 ROWS ONLY

UNION ALL

SELECT
    NULL,
    '---',
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL,
    NULL
WHERE NOT EXISTS (SELECT 1 FROM Combined c WHERE c.TagMatchCount > 0);