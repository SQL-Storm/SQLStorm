WITH RecentAnswers AS (
    SELECT
        p.Id                      AS AnswerId,
        p.OwnerUserId             AS OwnerUserId,
        p.CreationDate            AS AnswerDate,
        p.Score                   AS AnswerScore,
        p.ParentId                AS QuestionId,
        ROW_NUMBER() OVER (
            PARTITION BY p.OwnerUserId
            ORDER BY p.CreationDate DESC
        )                         AS rn
    FROM Posts p
    WHERE p.PostTypeId = 2
      AND p.CreationDate >= CAST('2024-10-01' AS DATE) - INTERVAL '90' DAY
),
PythonQuestions AS (
    SELECT
        q.Id                     AS QuestionId,
        q.Title                  AS QuestionTitle,
        regexp_split_to_table(
            trim(BOTH '<>' FROM q.Tags),
            '><'
        )                        AS Tag,
        q.Tags                   AS OriginalTags
    FROM Posts q
    WHERE q.PostTypeId = 1
),
UserBadgeAgg AS (
    SELECT
        b.UserId,
        COUNT(CASE WHEN b.Class = 1 THEN 1 END) AS GoldBadges,
        COUNT(CASE WHEN b.Class = 2 THEN 1 END) AS SilverBadges,
        COUNT(CASE WHEN b.Class = 3 THEN 1 END) AS BronzeBadges,
        COUNT(*)                            AS TotalBadges
    FROM Badges b
    GROUP BY b.UserId
),
AnswerStats AS (
    SELECT
        ra.OwnerUserId                       AS OwnerUserId,
        COUNT(*)                             AS TotalAnswers,
        AVG(ra.AnswerScore)                  AS AvgScore,
        SUM(
            CASE
                WHEN ph.PostHistoryTypeId = 10 THEN 1
                ELSE 0
            END
        )                                    AS CloseVotes,
        COUNT(DISTINCT ra.QuestionId) FILTER (
            WHERE q.AcceptedAnswerId = ra.AnswerId
        )                                    AS AcceptedAnswers
    FROM RecentAnswers ra
    LEFT JOIN PostHistory ph
           ON ph.PostId = ra.AnswerId
          AND ph.PostHistoryTypeId = 10
    LEFT JOIN Posts q
           ON q.Id = ra.QuestionId
    GROUP BY ra.OwnerUserId
)
SELECT
    u.Id                                   AS UserId,
    u.DisplayName,
    u.Reputation,
    COALESCE(uba.GoldBadges,   0)          AS GoldBadges,
    COALESCE(uba.SilverBadges, 0)          AS SilverBadges,
    COALESCE(uba.BronzeBadges, 0)          AS BronzeBadges,
    COALESCE(asb.TotalAnswers,0)           AS RecentAnswerCount,
    ROUND(COALESCE(asb.AvgScore,0),2)      AS AvgAnswerScore,
    COALESCE(asb.AcceptedAnswers,0)        AS AcceptedAnswerCount,
    COALESCE(asb.CloseVotes,0)             AS CloseVoteCount,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC,
                                 COALESCE(asb.TotalAnswers,0) DESC) AS ReputationRank,
    CASE
        WHEN u.Location IS NULL THEN 'Unknown'
        ELSE u.Location
    END                                    AS NormalizedLocation,
    STRING_AGG(DISTINCT t.Tag, ', ') FILTER (WHERE t.Tag IS NOT NULL) AS TagsAnswered
FROM Users u
LEFT JOIN UserBadgeAgg uba
       ON uba.UserId = u.Id
LEFT JOIN AnswerStats asb
       ON asb.OwnerUserId = u.Id
LEFT JOIN RecentAnswers ra
       ON ra.OwnerUserId = u.Id
LEFT JOIN PythonQuestions pq
       ON pq.QuestionId = ra.QuestionId
LEFT JOIN LATERAL (
        SELECT regexp_split_to_table(
                   trim(BOTH '<>' FROM pq.OriginalTags),
                   '><'
               ) AS Tag
) t ON true
WHERE u.Reputation > 1000
GROUP BY
    u.Id, u.DisplayName, u.Reputation,
    uba.GoldBadges, uba.SilverBadges, uba.BronzeBadges,
    asb.TotalAnswers, asb.AvgScore, asb.AcceptedAnswers, asb.CloseVotes,
    u.Location
HAVING COUNT(DISTINCT ra.AnswerId) > 5
UNION ALL
SELECT
    NULL, NULL, NULL, NULL, NULL, NULL,
    NULL, NULL, NULL, NULL, NULL, NULL, NULL
EXCEPT
SELECT *
FROM (
    SELECT 1 AS dummy
) d;