WITH UserStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.AccountId,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT b.Id) as Badges,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT ph.Id) as HistoryActions,
        AVG(p.Score) as AvgPostScore,
        MAX(p.CreationDate) as LastPostDate,
        RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
        DENSE_RANK() OVER (ORDER BY u.Views DESC) as ViewsRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN PostHistory ph ON u.Id = ph.UserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.AccountId
),
PostAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.CreationDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.AnswerCount,
        p.CommentCount,
        p.FavoriteCount,
        p.Tags,
        CASE 
            WHEN p.PostTypeId = 1 THEN 'Question'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            WHEN p.PostTypeId = 3 THEN 'Wiki'
            WHEN p.PostTypeId = 4 THEN 'TagWikiExcerpt'
            WHEN p.PostTypeId = 5 THEN 'TagWiki'
            ELSE 'Other'
        END as PostType,
        CASE 
            WHEN p.Score > 100 THEN 'HighlyVoted'
            WHEN p.Score > 50 THEN 'WellVoted'
            WHEN p.Score > 10 THEN 'ModeratelyVoted'
            WHEN p.Score > 0 THEN 'SlightlyVoted'
            ELSE 'NoVotes'
        END as VotingCategory,
        CASE 
            WHEN p.ViewCount > 10000 THEN 'Viral'
            WHEN p.ViewCount > 5000 THEN 'Popular'
            WHEN p.ViewCount > 1000 THEN 'WellKnown'
            WHEN p.ViewCount > 100 THEN 'Moderate'
            ELSE 'Unknown'
        END as PopularityLevel,
        STRING_AGG(SUBSTRING(p.Tags, 2, LENGTH(p.Tags) - 2), ', ') WITHIN GROUP (ORDER BY p.Id) as CombinedTagList,
        LAG(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PrevScore,
        LEAD(p.Score, 1) OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as NextScore,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate) as PostSequence,
        COUNT(*) OVER (PARTITION BY p.OwnerUserId) as TotalPostsByUser
    FROM Posts p
    WHERE p.CreationDate >= '2020-01-01 00:00:00' 
      AND p.CreationDate < '2024-01-01 00:00:00'
      AND p.PostTypeId IN (1, 2)
    GROUP BY p.Id, p.Title, p.Score, p.ViewCount, p.CreationDate, p.OwnerUserId, p.PostTypeId, p.AnswerCount, p.CommentCount, p.FavoriteCount, p.Tags
),
TaggedQuestions AS (
    SELECT 
        pa.PostId,
        pa.Title,
        pa.Score,
        pa.ViewCount,
        pa.Tags,
        CASE 
            WHEN pa.Tags LIKE '%<java>%' THEN 'Java'
            WHEN pa.Tags LIKE '%<python>%' THEN 'Python'
            WHEN pa.Tags LIKE '%<c++>%' THEN 'C++'
            WHEN pa.Tags LIKE '%<javascript>%' THEN 'JavaScript'
            ELSE 'Other'
        END as PrimaryLanguage,
        STRING_TO_ARRAY(SUBSTRING(pa.Tags, 2, LENGTH(pa.Tags) - 2), '><') as TagArray,
        array_length(STRING_TO_ARRAY(SUBSTRING(pa.Tags, 2, LENGTH(pa.Tags) - 2), '><'), 1) as TotalTags,
        CASE 
            WHEN pa.Tags LIKE '%<java>%<python>%' THEN 'MultiLang'
            WHEN pa.Tags LIKE '%<java>%<c++>%' THEN 'MultiLang'
            WHEN pa.Tags LIKE '%<javascript>%<python>%' THEN 'MultiLang'
            ELSE 'SingleLang'
        END as LanguageComplexity
    FROM PostAnalysis pa
    WHERE pa.PostTypeId = 1
),
ComplexQueryResults AS (
    SELECT 
        us.UserId,
        us.DisplayName,
        us.Reputation,
        us.Views,
        us.TotalPosts,
        us.Questions,
        us.Answers,
        us.Badges,
        us.Comments,
        us.HistoryActions,
        us.AvgPostScore,
        us.ReputationRank,
        us.ViewsRank,
        COALESCE(pa.Score, 0) as LatestPostScore,
        COALESCE(pa.Title, 'No Posts') as LastPostTitle,
        COALESCE(pa.PostType, 'None') as LastPostType,
        COALESCE(pa.VotingCategory, 'Unknown') as CurrentVotingStatus,
        COALESCE(pa.PopularityLevel, 'Unknown') as PopularityStatus,
        COALESCE(tq.PrimaryLanguage, 'Unknown') as MainLanguage,
        COALESCE(tq.LanguageComplexity, 'Unknown') as Complexity,
        CASE 
            WHEN pa.Score IS NOT NULL AND (pa.Score - COALESCE(pa.PrevScore, 0)) > 10 THEN 'SignificantIncrease'
            WHEN pa.Score IS NOT NULL AND (pa.Score - COALESCE(pa.PrevScore, 0)) < -10 THEN 'SignificantDecrease'
            WHEN pa.Score IS NOT NULL AND ABS(pa.Score - COALESCE(pa.PrevScore, 0)) <= 10 THEN 'Stable'
            ELSE 'NoChange'
        END as RecentTrend,
        CASE 
            WHEN pa.Score IS NOT NULL AND pa.Score > 100 AND pa.ViewCount > 500 THEN 1
            WHEN pa.Score IS NOT NULL AND pa.Score > 50 AND pa.ViewCount > 200 THEN 1
            ELSE 0
        END as HighValueFlag,
        CAST(0 AS INTEGER) as CalculatedValue
    FROM UserStats us
    LEFT JOIN PostAnalysis pa ON us.UserId = pa.OwnerUserId AND pa.PostSequence = us.TotalPosts
    LEFT JOIN TaggedQuestions tq ON pa.PostId = tq.PostId
    WHERE us.TotalPosts > 0
)
SELECT 
    UserId,
    DisplayName,
    Reputation,
    Views,
    TotalPosts,
    Questions,
    Answers,
    Badges,
    Comments,
    HistoryActions,
    AvgPostScore,
    ReputationRank,
    ViewsRank,
    LatestPostScore,
    LastPostTitle,
    LastPostType,
    CurrentVotingStatus,
    PopularityStatus,
    MainLanguage,
    Complexity,
    RecentTrend,
    HighValueFlag,
    (Reputation * Views * TotalPosts * Questions * Answers) / 
     NULLIF((Badges + Comments + HistoryActions), 0) as PerformanceIndex,
    CASE 
        WHEN Reputation >= 100000 AND TotalPosts > 100 AND Questions > 50 THEN 'EliteContributor'
        WHEN Reputation >= 50000 AND TotalPosts > 50 AND Questions > 25 THEN 'TopContributor'
        WHEN Reputation >= 10000 AND TotalPosts > 20 THEN 'ActiveContributor'
        ELSE 'RegularContributor'
    END as ContributorTier,
    ROW_NUMBER() OVER (ORDER BY PerformanceIndex DESC) as PerformanceRank,
    RANK() OVER (ORDER BY AvgPostScore DESC) as ScoreRank,
    DENSE_RANK() OVER (ORDER BY Views DESC) as EngagementRank
FROM ComplexQueryResults
WHERE (Reputation + Views + TotalPosts) > 0
  AND (TotalPosts >= 1 OR Reports > 0)
  AND DisplayName IS NOT NULL
  AND DisplayName != ''
  AND LastPostDate >= '2020-01-01 00:00:00' 
  AND (CASE WHEN LastPostDate IS NOT NULL THEN LastPostDate ELSE '1900-01-01 00:00:00' END) < cast('2024-10-01 12:34:56' as timestamp)
  AND ((Reputation > 1000 AND Questions > 10) OR 
       (Reputation > 5000 AND Answers > 5) OR 
       (Reputation > 25000 AND Badges > 20))
QUALIFY PerformanceRank <= 200
ORDER BY PerformanceIndex DESC, Reputation DESC, TotalPosts DESC;