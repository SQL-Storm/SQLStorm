-- {"query": "3457.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-oss-120b", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2089, "output_tokens": 2172} 
WITH 
/* 1️⃣ Aggregate per‑user statistics */
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id)                                   AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END)      AS Questions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END)      AS Answers,
        COALESCE(SUM(v.UpVotes),0) - COALESCE(SUM(v.DownVotes),0) AS NetScore,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 1) AS GoldBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 2) AS SilverBadges,
        (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id AND b.Class = 3) AS BronzeBadges
    FROM Users u
    LEFT JOIN Posts p               ON p.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT 
            v.PostId,
            SUM(CASE WHEN vt.Id = 2 THEN 1 ELSE 0 END) AS UpVotes,
            SUM(CASE WHEN vt.Id = 3 THEN 1 ELSE 0 END) AS DownVotes
        FROM Votes v
        JOIN VoteTypes vt            ON vt.Id = v.VoteTypeId
        GROUP BY v.PostId
    ) v                           ON v.PostId = p.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),

/* 2️⃣ Rank tags by overall usage (ignore moderator‑only tags) */
TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rn
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
),

/* 3️⃣ Gather per‑user tag activity (tag edits, top 10 tags) */
UserTagActivity AS (
    SELECT 
        us.Id                                            AS UserId,
        STRING_AGG(DISTINCT tt.TagName, ',') 
            FILTER (WHERE tt.rn <= 10)                  AS Top10Tags,
        COUNT(DISTINCT ph.Id)                           AS TagEdits
    FROM UserStats us
    LEFT JOIN Posts p                                 ON p.OwnerUserId = us.Id
    LEFT JOIN LATERAL (
        SELECT UNNEST(STRING_TO_ARRAY(TRIM(BOTH '<>' FROM p.Tags), '><')) AS Tag
    ) pt                                            ON true
    LEFT JOIN Tags t                                 ON t.TagName = pt.Tag
    LEFT JOIN PostHistory ph 
        ON ph.PostId = p.Id 
       AND ph.PostHistoryTypeId = 6                   -- Edit Tags
    LEFT JOIN TopTags tt                             ON tt.TagName = t.TagName
    GROUP BY us.Id
),

/* 4️⃣ Recent closed questions per user (most recent only) */
RecentClosedQuestions AS (
    SELECT 
        p.Id,
        p.Title,
        p.CreationDate,
        ph.CreationDate                                   AS ClosedDate,
        ph.Comment::int                                   AS CloseReasonId,
        cr.Name                                           AS CloseReason,
        ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId 
                           ORDER BY ph.CreationDate DESC) AS rn,
        p.OwnerUserId
    FROM Posts p
    JOIN PostHistory ph 
        ON ph.PostId = p.Id 
       AND ph.PostHistoryTypeId = 10                     -- Post Closed
    LEFT JOIN CloseReasonTypes cr 
        ON cr.Id = ph.Comment::int
    WHERE p.PostTypeId = 1                               -- Questions only
),

/* 5️⃣ Combine everything into a single result set */
Combined AS (
    SELECT
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.TotalPosts,
        us.Questions,
        us.Answers,
        us.NetScore,
        us.GoldBadges,
        us.SilverBadges,
        us.BronzeBadges,
        uta.Top10Tags,
        uta.TagEdits,
        rcq.Title            AS LastClosedQuestionTitle,
        rcq.CloseReason,
        rcq.ClosedDate
    FROM UserStats us
    LEFT JOIN UserTagActivity uta     ON uta.UserId = us.Id
    LEFT JOIN RecentClosedQuestions rcq 
        ON rcq.rn = 1 
       AND rcq.OwnerUserId = us.Id
)

/* 6️⃣ Final SELECT with heavy predicates, windowing, set ops and pagination */
SELECT *
FROM Combined
WHERE 
      Reputation > 10000
   OR NetScore   > 5000
   OR GoldBadges > 0
   OR EXISTS (
         SELECT 1 
         FROM Posts p
         WHERE p.OwnerUserId = Combined.Id
           AND p.PostTypeId = 2               -- Answers
           AND p.Score > 100
       )
ORDER BY Reputation DESC, NetScore DESC
OFFSET 0 ROWS FETCH NEXT 100 ROWS ONLY

/* 7️⃣ Add a dummy UNION ALL to force the optimizer to handle set operators */
UNION ALL
SELECT 
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,
    NULL,NULL,NULL,NULL,NULL
WHERE FALSE;