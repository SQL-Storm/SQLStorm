-- {"query": "2218.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1129} 
with recursive UserBadgeCounts as (
    select
        u.Id as UserId,
        u.DisplayName,
        count(*) filter (where b.Class = 1) as GoldBadges,
        count(*) filter (where b.Class = 2) as SilverBadges,
        count(*) filter (where b.Class = 3) as BronzeBadges,
        row_number() over (order by u.Reputation desc nulls last, u.CreationDate) as UserRank
    from Users u
    left join Badges b on u.Id = b.UserId
    group by u.Id, u.DisplayName, u.Reputation, u.CreationDate
), RecursiveSubquery as (
    select
        p.Id as PostId,
        p.Title,
        p.OwnerUserId,
        1 as Depth
    from Posts p
    where p.PostTypeId = 1 and p.OwnerUserId is not null
    union all
    select
        pl.RelatedPostId,
        p2.Title,
        p2.OwnerUserId,
        rs.Depth + 1
    from RecursiveSubquery rs
    join PostLinks pl on rs.PostId = pl.PostId and pl.LinkTypeId = 1
    join Posts p2 on pl.RelatedPostId = p2.Id
    where rs.Depth < 3
), UserRecentActivity as (
    select
        u.Id as UserId,
        max(coalesce(p.LastActivityDate, p.CreationDate)) as LastPostActivity,
        max(c.CreationDate) as LastCommentDate,
        max(ph.CreationDate) as LastHistoryEdit
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join PostHistory ph on ph.UserId = u.Id
    group by u.Id
), PostScoresWithWindow as (
    select
        p.Id,
        p.PostTypeId,
        p.Title,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        dense_rank() over (partition by p.PostTypeId order by p.Score desc nulls last) as ScoreRank,
        avg(p.Score) over (partition by p.PostTypeId) as AvgScore,
        max(p.Score) over (partition by p.PostTypeId) as MaxScore
    from Posts p
    where p.PostTypeId in (1,2)
), DuplicateQuestionsCTE as (
    select distinct pl.PostId as DuplicateQuestionId, pl.RelatedPostId as OriginalQuestionId
    from PostLinks pl
    join Posts p1 on pl.PostId = p1.Id and p1.PostTypeId = 1
    join Posts p2 on pl.RelatedPostId = p2.Id and p2.PostTypeId = 1
    where pl.LinkTypeId = 3
), UserPostsStats as (
    select
        u.Id as UserId,
        count(p.Id) filter (where p.PostTypeId = 1) as QuestionsCount,
        count(p.Id) filter (where p.PostTypeId = 2) as AnswersCount,
        coalesce(sum(p.Score),0) as TotalPostScore,
        max(p.CreationDate) as LastPostDate
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    group by u.Id
)
select
    ubc.UserId,
    ubc.DisplayName,
    ubc.GoldBadges,
    ubc.SilverBadges,
    ubc.BronzeBadges,
    ubc.UserRank,
    ups.QuestionsCount,
    ups.AnswersCount,
    ups.TotalPostScore,
    ur.LastPostActivity,
    ur.LastCommentDate,
    ur.LastHistoryEdit,
    p.WinAvgScore,
    p.MaxScore,
    dup.DuplicateCount,
    concat_ws(' | ', 
        case when ups.QuestionsCount > 50 then 'Prolific Questioner' else null end,
        case when ups.AnswersCount > 100 then 'Answering Machine' else null end,
        case when ubc.GoldBadges > 5 then 'Elite Badge Owner' else null end
    ) as UserTags
from UserBadgeCounts ubc
left join UserPostsStats ups on ubc.UserId = ups.UserId
left join UserRecentActivity ur on ubc.UserId = ur.UserId
left join (
    select
        p.OwnerUserId,
        avg(p.Score) as WinAvgScore,
        max(p.Score) as MaxScore
    from Posts p
    where p.PostTypeId in (1,2)
    group by p.OwnerUserId
) p on ubc.UserId = p.OwnerUserId
left join (
    select
        dup.OriginalQuestionId,
        count(*) as DuplicateCount
    from DuplicateQuestionsCTE dup
    group by dup.OriginalQuestionId
) dup on dup.OriginalQuestionId = (select p.Id from Posts p where p.OwnerUserId = ubc.UserId and p.PostTypeId = 1 order by p.CreationDate desc limit 1)
where ubc.GoldBadges + ubc.SilverBadges + ubc.BronzeBadges > 10
  and ur.LastPostActivity > cast('2024-10-01 12:34:56' as timestamp) - interval '6 months'
order by ubc.UserRank
limit 50;