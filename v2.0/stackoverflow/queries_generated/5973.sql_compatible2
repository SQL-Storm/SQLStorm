WITH recent_questions AS (
  SELECT 
    p.Id AS PostId,
    p.Title,
    p.CreationDate,
    p.ViewCount,
    p.Score,
    p.OwnerUserId,
    p.Tags,
    p.LastActivityDate,
    p.CommentCount,
    p.AnswerCount,
    p.FavoriteCount,
    p.Body,
    p.ParentId,
    p.AcceptedAnswerId
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '60' DAY
),
tag_stats AS (
  SELECT
    tag_value AS tag,
    COUNT(*) AS question_count,
    AVG(rq.Score) AS avg_score,
    SUM(rq.ViewCount) AS total_views
  FROM recent_questions rq,
       UNNEST(string_to_array(SUBSTR(rq.Tags, 2, LENGTH(rq.Tags) - 2), '><')) AS t(tag_value)
  GROUP BY tag_value
),
user_activity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT q.PostId) AS questions_created,
    SUM(q.ViewCount) AS total_question_views,
    AVG(q.Score) AS avg_question_score,
    MAX(q.LastActivityDate) AS last_question_activity
  FROM Users u
  LEFT JOIN recent_questions q ON q.OwnerUserId = u.Id
  GROUP BY u.Id, u.DisplayName, u.Reputation
),
complex_metrics AS (
  SELECT
    rq.PostId,
    rq.Title,
    rq.CreationDate,
    rq.LastActivityDate,
    rq.Score,
    rq.ViewCount,
    rq.Tags,
    rq.OwnerUserId,
    EXISTS (SELECT 1 FROM Votes v WHERE v.PostId = rq.PostId AND v.VoteTypeId = 2) AS has_upvote,
    EXISTS (SELECT 1 FROM Votes v WHERE v.PostId = rq.PostId AND v.VoteTypeId = 3) AS has_downvote,
    rq.FavoriteCount,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = rq.PostId) AS comment_count,
    COALESCE(rq.AnswerCount, 0) AS answer_count,
    COALESCE((SELECT AVG(v.BountyAmount) FROM Votes v WHERE v.PostId = rq.PostId AND v.VoteTypeId = 8), 0) AS avg_bounty_at_start
  FROM recent_questions rq
),
outer_join_example AS (
  SELECT
    cq.PostId,
    cq.Title,
    qq.question_count AS related_questions_in_same_tag,
    ts.avg_score AS average_question_score_for_tag,
    uu.total_question_views,
    cq.OwnerUserId,
    cq.Tags
  FROM complex_metrics cq
  LEFT JOIN LATERAL (
    SELECT t.tag_value AS tag, ts2.avg_score
    FROM (
      SELECT tag_value, avg_score
      FROM tag_stats
    ) ts2
    JOIN UNNEST(string_to_array(SUBSTR(cq.Tags, 2, LENGTH(cq.Tags) - 2), '><')) AS t(tag_value)
      ON t.tag_value = ts2.tag_value
    LIMIT 1
  ) ts ON TRUE
  LEFT JOIN LATERAL (
    SELECT t.tag_value AS tag, ts3.question_count
    FROM (
      SELECT tag_value, question_count
      FROM tag_stats
    ) ts3
    JOIN UNNEST(string_to_array(SUBSTR(cq.Tags, 2, LENGTH(cq.Tags) - 2), '><')) AS t(tag_value)
      ON t.tag_value = ts3.tag_value
    GROUP BY t.tag_value, ts3.question_count
    LIMIT 1
  ) qq ON TRUE
  LEFT JOIN user_activity uu
    ON uu.UserId = cq.OwnerUserId
)
SELECT
  oq.PostId,
  oq.Title,
  oq.LastActivityDate,
  oq.Score,
  oq.ViewCount,
  oq.Tags,
  oq.comment_count,
  oq.answer_count,
  oq.avg_bounty_at_start,
  ua.UserId,
  ua.DisplayName AS OwnerDisplayName,
  ua.Reputation,
  ua.questions_created,
  ua.total_question_views,
  aq.related_questions_in_same_tag,
  aq.average_question_score_for_tag,
  aq.total_question_views AS owner_total_views
FROM complex_metrics oq
JOIN outer_join_example aq ON aq.PostId = oq.PostId
LEFT JOIN user_activity ua ON ua.UserId = oq.OwnerUserId
ORDER BY oq.LastActivityDate DESC
LIMIT 100;