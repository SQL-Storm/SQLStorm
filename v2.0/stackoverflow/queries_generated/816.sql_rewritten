-- {"query": "816.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 4167} 
with params as (
  select
    date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) - interval '24 months' as start_month,
    date_trunc('month', cast('2024-10-01 12:34:56' as timestamp)) - interval '1 month' as end_month
),
month_grid as (
  select generate_series(
           (select start_month from params),
           (select end_month from params),
           interval '1 month'
         )::date as month_start
),
user_activity as (
  select
    u.id as user_id,
    date_trunc('month', u.creationdate)::date as signup_month,
    u.reputation,
    coalesce(nullif(trim(u.location), ''), 'Unknown') as norm_location,
    case when u.websiteurl ilike any (array['%github.%','%gitlab.%','%bitbucket.%']) then 1 else 0 end as has_dev_site
  from users u
),
posts_enriched as (
  select
    p.id,
    p.posttypeid,
    p.owneruserid,
    date_trunc('month', p.creationdate)::date as month_start,
    p.score,
    p.viewcount,
    p.answercount,
    p.favoritecount,
    p.commentcount,
    p.acceptedanswerid,
    p.parentid,
    p.title,
    p.tags,
    case when p.tags is not null then array_length(string_to_array(substring(p.tags, 2, length(p.tags)-2), '><'), 1) else 0 end as tag_count,
    case when p.closeddate is not null then 1 else 0 end as is_closed
  from posts p
  where p.creationdate >= (select start_month from params)
    and p.creationdate < (select end_month from params) + interval '1 month'
    and p.posttypeid in (1,2)
),
votes_agg as (
  select
    v.postid,
    date_trunc('month', v.creationdate)::date as month_start,
    sum(case when v.votetypeid = 2 then 1 else 0 end) as upvotes,
    sum(case when v.votetypeid = 3 then 1 else 0 end) as downvotes,
    sum(case when v.votetypeid = 1 then 1 else 0 end) as accepts,
    count(*) as total_votes
  from votes v
  where v.creationdate >= (select start_month from params)
    and v.creationdate < (select end_month from params) + interval '1 month'
    and v.votetypeid in (1,2,3)
  group by v.postid, date_trunc('month', v.creationdate)::date
),
comments_agg as (
  select
    c.postid,
    date_trunc('month', c.creationdate)::date as month_start,
    count(*) as comments,
    sum(greatest(c.score,0)) as nonneg_comment_score,
    max(c.score) as max_comment_score
  from comments c
  where c.creationdate >= (select start_month from params)
    and c.creationdate < (select end_month from params) + interval '1 month'
  group by c.postid, date_trunc('month', c.creationdate)::date
),
links_agg as (
  select
    pl.postid,
    date_trunc('month', pl.creationdate)::date as month_start,
    sum(case when pl.linktypeid = 1 then 1 else 0 end) as linked_count,
    sum(case when pl.linktypeid = 3 then 1 else 0 end) as duplicate_links
  from postlinks pl
  where pl.creationdate >= (select start_month from params)
    and pl.creationdate < (select end_month from params) + interval '1 month'
  group by pl.postid, date_trunc('month', pl.creationdate)::date
),
close_reasons as (
  select
    ph.postid,
    date_trunc('month', ph.creationdate)::date as month_start,
    count(*) filter (where ph.posthistorytypeid = 10) as close_events,
    count(*) filter (where ph.posthistorytypeid = 11) as reopen_events,
    max((regexp_match(coalesce(ph.comment,''), '(\d+)'))[1])::int as last_close_reason_id
  from posthistory ph
  where ph.creationdate >= (select start_month from params)
    and ph.creationdate < (select end_month from params) + interval '1 month'
    and ph.posthistorytypeid in (10,11)
  group by ph.postid, date_trunc('month', ph.creationdate)::date
),
accepted_answer_latency as (
  select
    q.id as question_id,
    date_trunc('month', q.creationdate)::date as month_start,
    case
      when q.acceptedanswerid is not null then
        (select extract(epoch from (a.creationdate - q.creationdate)) / 3600.0
         from posts a
         where a.id = q.acceptedanswerid)
      else null
    end as accept_latency_hours
  from posts q
  where q.posttypeid = 1
    and q.creationdate >= (select start_month from params)
    and q.creationdate < (select end_month from params) + interval '1 month'
),
answers_per_question as (
  select
    q.id as question_id,
    date_trunc('month', q.creationdate)::date as month_start,
    count(a.id) as answers_count,
    avg(a.score) as avg_answer_score,
    sum(case when a.score > 0 then 1 else 0 end) as pos_answer_count
  from posts q
  left join posts a
    on a.parentid = q.id and a.posttypeid = 2
  where q.posttypeid = 1
    and q.creationdate >= (select start_month from params)
    and q.creationdate < (select end_month from params) + interval '1 month'
  group by q.id, date_trunc('month', q.creationdate)::date
),
tag_explosion as (
  select
    p.id as post_id,
    p.month_start,
    unnest(string_to_array(substring(p.tags, 2, length(p.tags)-2), '><')) as tag
  from posts_enriched p
  where p.posttypeid = 1
    and p.tags is not null
),
top_tags_monthly as (
  select
    t.month_start,
    t.tag,
    count(*) as tag_uses,
    row_number() over (partition by t.month_start order by count(*) desc, t.tag) as tag_rank
  from tag_explosion t
  group by t.month_start, t.tag
),
user_post_rollup as (
  select
    p.owneruserid as user_id,
    p.month_start,
    count(*) filter (where p.posttypeid = 1) as questions,
    count(*) filter (where p.posttypeid = 2) as answers,
    sum(p.score) as post_score_sum,
    avg(p.score) as post_score_avg,
    sum(p.viewcount) as views_sum
  from posts_enriched p
  group by p.owneruserid, p.month_start
),
user_badges_monthly as (
  select
    b.userid as user_id,
    date_trunc('month', b.date)::date as month_start,
    count(*) as badges_total,
    sum(case when b.class = 1 then 1 else 0 end) as golds,
    sum(case when b.class = 2 then 1 else 0 end) as silvers,
    sum(case when b.class = 3 then 1 else 0 end) as bronzes
  from badges b
  where b.date >= (select start_month from params)
    and b.date < (select end_month from params) + interval '1 month'
  group by b.userid, date_trunc('month', b.date)::date
),
question_quality as (
  select
    p.id as post_id,
    p.month_start,
    greatest(coalesce(v.upvotes,0) - coalesce(v.downvotes,0), 0) as net_votes,
    coalesce(c.comments,0) as comments_count,
    coalesce(l.linked_count,0) as linked_in_count,
    coalesce(l.duplicate_links,0) as duplicate_links,
    coalesce(cr.close_events,0) as close_events,
    coalesce(cr.reopen_events,0) as reopen_events,
    case when coalesce(cr.last_close_reason_id,0) in (101,1) then 1 else 0 end as is_duplicate_flag,
    case when p.answercount is null then 0 else p.answercount end as answercount,
    coalesce(aq.answers_count,0) as answers_count_calc,
    coalesce(aq.avg_answer_score,0) as avg_answer_score,
    coalesce(aq.pos_answer_count,0) as pos_answer_count,
    aal.accept_latency_hours
  from posts_enriched p
  left join votes_agg v
    on v.postid = p.id and v.month_start = p.month_start
  left join comments_agg c
    on c.postid = p.id and c.month_start = p.month_start
  left join links_agg l
    on l.postid = p.id and l.month_start = p.month_start
  left join close_reasons cr
    on cr.postid = p.id and cr.month_start = p.month_start
  left join answers_per_question aq
    on aq.question_id = p.id and aq.month_start = p.month_start
  left join accepted_answer_latency aal
    on aal.question_id = p.id and aal.month_start = p.month_start
  where p.posttypeid = 1
),
quality_scored as (
  select
    q.post_id,
    q.month_start,
    -- Arbitrary composite score for benchmarking
    ( 0.40 * q.net_votes
    + 0.15 * coalesce(q.avg_answer_score,0)
    + 0.10 * q.pos_answer_count
    + 0.15 * case when q.accept_latency_hours is null then 0 else greatest(48 - q.accept_latency_hours, 0) / 48.0 end
    + 0.10 * ln(1 + q.comments_count)
    + 0.05 * ln(1 + q.linked_in_count)
    - 0.20 * q.duplicate_links
    - 0.25 * q.close_events
    + 0.10 * q.reopen_events
    ) as quality_score
  from question_quality q
),
user_monthly as (
  select
    mg.month_start,
    ua.user_id,
    ua.norm_location,
    ua.has_dev_site,
    coalesce(upr.questions,0) as questions,
    coalesce(upr.answers,0) as answers,
    coalesce(upr.post_score_sum,0) as post_score_sum,
    coalesce(upr.post_score_avg,0.0) as post_score_avg,
    coalesce(upr.views_sum,0) as views_sum,
    coalesce(ub.badges_total,0) as badges,
    coalesce(ub.golds,0) as golds,
    coalesce(ub.silvers,0) as silvers,
    coalesce(ub.bronzes,0) as bronzes
  from month_grid mg
  left join user_activity ua
    on ua.signup_month <= mg.month_start
  left join user_post_rollup upr
    on upr.user_id = ua.user_id and upr.month_start = mg.month_start
  left join user_badges_monthly ub
    on ub.user_id = ua.user_id and ub.month_start = mg.month_start
  where ua.user_id is not null
),
user_windows as (
  select
    um.*,
    sum(um.questions) over (partition by um.user_id order by um.month_start rows between unbounded preceding and current row) as cum_questions,
    sum(um.answers) over (partition by um.user_id order by um.month_start rows between unbounded preceding and current row) as cum_answers,
    avg(nullif(um.post_score_avg,0)) over (partition by um.user_id order by um.month_start rows between 5 preceding and current row) as rolling_avg_post_score,
    sum(um.badges) over (partition by um.user_id order by um.month_start rows between unbounded preceding and current row) as cum_badges,
    lag(um.answers) over (partition by um.user_id order by um.month_start) as prev_answers,
    lead(um.answers) over (partition by um.user_id order by um.month_start) as next_answers
  from user_monthly um
),
monthly_question_cohort as (
  select
    p.month_start,
    count(*) as questions_posted,
    avg(p.score) as avg_q_score,
    percentile_disc(0.5) within group (order by p.score) as median_q_score,
    avg(coalesce(qs.quality_score,0)) as avg_quality_score
  from posts_enriched p
  left join quality_scored qs
    on qs.post_id = p.id and qs.month_start = p.month_start
  where p.posttypeid = 1
  group by p.month_start
),
monthly_answer_cohort as (
  select
    p.month_start,
    count(*) as answers_posted,
    avg(p.score) as avg_a_score,
    percentile_disc(0.5) within group (order by p.score) as median_a_score
  from posts_enriched p
  where p.posttypeid = 2
  group by p.month_start
),
location_norm as (
  select
    norm_location,
    case
      when norm_location ilike any (array['%usa%','%united states%','%u.s.%','%u.s.a%','%california%','%new york%']) then 'USA'
      when norm_location ilike any (array['%india%']) then 'India'
      when norm_location ilike any (array['%uk%','%united kingdom%','%england%','%scotland%','%wales%']) then 'UK'
      when norm_location ilike any (array['%germany%']) then 'Germany'
      when norm_location ilike any (array['%canada%']) then 'Canada'
      when norm_location ilike any (array['%australia%']) then 'Australia'
      when norm_location ilike any (array['%france%']) then 'France'
      when norm_location ilike any (array['%brazil%']) then 'Brazil'
      when norm_location ilike any (array['%russia%']) then 'Russia'
      when norm_location ilike any (array['%china%']) then 'China'
      else 'Other'
    end as country_bucket
  from (select distinct norm_location from user_activity) x
),
user_windows_enriched as (
  select
    uw.*,
    ln(1 + greatest(uw.cum_answers,0)) - ln(1 + greatest(coalesce(uw.prev_answers,0),0)) as answer_momentum,
    case when uw.next_answers is null then 0 when uw.answers = 0 and uw.next_answers > 0 then 1 else 0 end as reactivation_flag
  from user_windows uw
),
final_agg as (
  select
    mg.month_start,
    lc.country_bucket,
    sum(case when uw.has_dev_site = 1 then 1 else 0 end) as dev_site_users,
    count(distinct uw.user_id) as active_users,
    sum(uw.questions) as questions,
    sum(uw.answers) as answers,
    avg(nullif(uw.post_score_avg,0.0)) as avg_post_score_if_any,
    avg(uw.rolling_avg_post_score) as avg_rolling_post_score,
    avg(uw.answer_momentum) as avg_answer_momentum,
    sum(uw.reactivation_flag) as reactivations,
    sum(uw.golds) as golds,
    sum(uw.silvers) as silvers,
    sum(uw.bronzes) as bronzes,
    coalesce(mqc.questions_posted,0) as questions_posted,
    coalesce(mac.answers_posted,0) as answers_posted,
    coalesce(mqc.avg_q_score,0) as avg_q_score,
    coalesce(mac.avg_a_score,0) as avg_a_score,
    coalesce(mqc.median_q_score,0) as median_q_score,
    coalesce(mac.median_a_score,0) as median_a_score,
    coalesce(mqc.avg_quality_score,0) as avg_quality_score,
    tt.tag, tt.tag_uses,
    row_number() over (partition by mg.month_start order by coalesce(mqc.avg_quality_score,0) desc, count(distinct uw.user_id) desc) as month_rank_quality
  from month_grid mg
  left join user_windows_enriched uw
    on uw.month_start = mg.month_start
  left join user_activity ua
    on ua.user_id = uw.user_id
  left join location_norm lc
    on lc.norm_location = ua.norm_location
  left join monthly_question_cohort mqc
    on mqc.month_start = mg.month_start
  left join monthly_answer_cohort mac
    on mac.month_start = mg.month_start
  left join lateral (
    select tag, tag_uses
    from top_tags_monthly ttm
    where ttm.month_start = mg.month_start and ttm.tag_rank <= 3
    order by ttm.tag_rank
  ) tt on true
  group by
    mg.month_start,
    lc.country_bucket,
    mqc.questions_posted, mac.answers_posted,
    mqc.avg_q_score, mac.avg_a_score,
    mqc.median_q_score, mac.median_a_score, mqc.avg_quality_score,
    tt.tag, tt.tag_uses
),
benchmarked as (
  select
    f.*,
    sum(f.questions) over (partition by f.country_bucket order by f.month_start rows between 2 preceding and current row) as q_3mo_sum,
    sum(f.answers) over (partition by f.country_bucket order by f.month_start rows between 2 preceding and current row) as a_3mo_sum,
    avg(f.avg_quality_score) over (order by f.month_start rows between 5 preceding and current row) as rolling_quality_global,
    dense_rank() over (partition by f.month_start order by f.avg_quality_score desc, f.active_users desc) as country_quality_rank
  from final_agg f
)
select
  b.month_start,
  b.country_bucket,
  b.active_users,
  b.dev_site_users,
  b.questions,
  b.answers,
  b.q_3mo_sum,
  b.a_3mo_sum,
  round(b.avg_q_score::numeric, 2) as avg_q_score,
  round(b.avg_a_score::numeric, 2) as avg_a_score,
  round(b.avg_quality_score::numeric, 3) as avg_quality_score,
  round(b.rolling_quality_global::numeric, 3) as rolling_quality_global,
  b.median_q_score,
  b.median_a_score,
  b.golds, b.silvers, b.bronzes,
  b.tag as top_tag_candidate,
  b.tag_uses,
  b.country_quality_rank,
  b.month_rank_quality
from benchmarked b
where (b.tag is not null or b.active_users > 0)
order by b.month_start asc, b.country_bucket asc, b.tag asc nulls last;