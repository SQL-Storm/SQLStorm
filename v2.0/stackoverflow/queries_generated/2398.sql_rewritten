-- {"query": "2398.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1432} 
with RecursiveUserBadgeCounts as (
    select 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        b.Class,
        count(b.Id) as BadgeCount,
        row_number() over (partition by u.Id order by count(b.Id) desc) as rn
    from Users u
    left join Badges b on b.UserId = u.Id
    group by u.Id, u.DisplayName, u.Reputation, b.Class
),
TopBadgesPerUser as (
    select UserId, DisplayName, Reputation, Class, BadgeCount
    from RecursiveUserBadgeCounts
    where rn = 1
),
RecentQuestions as (
    select 
        p.Id,
        p.OwnerUserId,
        p.Title,
        p.CreationDate,
        p.Score,
        p.ViewCount,
        coalesce(p.Tags, '') as Tags,
        p.AcceptedAnswerId,
        row_number() over (partition by p.OwnerUserId order by p.CreationDate desc) as rn
    from Posts p
    where p.PostTypeId = 1 and p.CreationDate > cast('2024-10-01' as date) - interval '180 days'
),
AnswerStats as (
    select 
        a.ParentId as QuestionId,
        count(*) as TotalAnswers,
        sum(case when a.Score > 0 then 1 else 0 end) as PositiveScoreAnswers,
        max(a.Score) as MaxAnswerScore,
        avg(a.Score) as AvgAnswerScore
    from Posts a
    where a.PostTypeId = 2
    group by a.ParentId
),
TopAnswersWithVotes as (
    select 
        a.Id,
        a.ParentId as QuestionId,
        a.Score,
        a.CreationDate,
        v.VoteTypeId,
        count(v.Id) as VoteCount
    from Posts a
    left join Votes v on v.PostId = a.Id
    where a.PostTypeId = 2
    group by a.Id, a.ParentId, a.Score, a.CreationDate, v.VoteTypeId
),
HighestVotedAnswers as (
    select 
        t.QuestionId,
        max(t.Score) as HighestScore
    from Posts p
    join Posts a on a.ParentId = p.Id and a.PostTypeId = 2
    join TopAnswersWithVotes t on t.Id = a.Id
    group by t.QuestionId
),
QuestionLatestEdits as (
    select ph.PostId, max(ph.CreationDate) as LastEditDate
    from PostHistory ph
    where ph.PostHistoryTypeId in (4,5,6,7,8,9,24)
    group by ph.PostId
),
QuestionsWithLinks as (
    select distinct p.Id as QuestionId, pl.RelatedPostId, lt.Name as LinkTypeName
    from Posts p
    join PostLinks pl on pl.PostId = p.Id
    join LinkTypes lt on lt.Id = pl.LinkTypeId
    where p.PostTypeId = 1
),
UserActivityWindow as (
    select 
        u.Id as UserId,
        u.DisplayName,
        p.PostTypeId,
        count(p.Id) as PostCount,
        sum(case when p.PostTypeId = 2 then p.Score else 0 end) as AnswerScoreSum,
        avg(coalesce(p.Score, 0)) over (partition by u.Id order by p.CreationDate rows between 6 preceding and current row) as MovingAvgPostScore
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    group by u.Id, u.DisplayName, p.PostTypeId
)
select 
    q.Id as QuestionId,
    q.Title,
    q.CreationDate,
    q.Score as QuestionScore,
    q.ViewCount,
    q.Tags,
    tbu.Class as TopBadgeClass,
    tbu.BadgeCount as TopBadgeCount,
    asg.TotalAnswers,
    asg.PositiveScoreAnswers,
    asg.MaxAnswerScore,
    asg.AvgAnswerScore,
    qae.LastEditDate as QuestionLastEdit,
    count(distinct c.Id) as CommentCount,
    exists(
        select 1 
        from Votes v2 
        where v2.PostId = q.Id and v2.VoteTypeId = 2 and v2.CreationDate > cast('2024-10-01' as date) - interval '30 days'
    ) as HasRecentUpvotes,
    coalesce(
        (select string_agg(distinct lt.Name, ', ')
         from Posts p2
         join PostLinks pl2 on pl2.PostId = p2.Id
         join LinkTypes lt on lt.Id = pl2.LinkTypeId
         where p2.Id = q.Id
        ), '') as LinkTypesInQuestion,
    case 
        when asg.MaxAnswerScore is null then 'No Answers'
        when asg.MaxAnswerScore >= 10 then 'High Scoring Answer'
        else 'Low Scoring Answer'
    end as AnswerQualityCategory,
    case 
        when q.ClosedDate is not null then 'Closed'
        when q.AcceptedAnswerId is not null then 'Answered & Accepted'
        else 'Open'
    end as QuestionStatus,
    (select u.DisplayName from Users u where u.Id = q.OwnerUserId) as QuestionOwnerName,
    (select max(p.Score) from Posts p where p.ParentId = q.Id and p.PostTypeId = 2) as MaxAnswerScoreValue,
    (select count(*) from Comments c3 where c3.PostId = q.Id and c3.CreationDate > cast('2024-10-01' as date) - interval '7 days') as LatestWeekComments,
    wu.MovingAvgPostScore,
    wu.PostCount as UserPostCount,
    wu.AnswerScoreSum as UserAnswerScoreSum
from RecentQuestions q
left join TopBadgesPerUser tbu on tbu.UserId = q.OwnerUserId
left join AnswerStats asg on asg.QuestionId = q.Id
left join QuestionLatestEdits qae on qae.PostId = q.Id
left join Comments c on c.PostId = q.Id and c.CreationDate > cast('2024-10-01' as date) - interval '30 days'
left join UserActivityWindow wu on wu.UserId = q.OwnerUserId
group by 
    q.Id, q.Title, q.CreationDate, q.Score, q.ViewCount, q.Tags, 
    tbu.Class, tbu.BadgeCount, asg.TotalAnswers, asg.PositiveScoreAnswers, asg.MaxAnswerScore, asg.AvgAnswerScore, 
    qae.LastEditDate, q.ClosedDate, q.AcceptedAnswerId, q.OwnerUserId,
    wu.MovingAvgPostScore, wu.PostCount, wu.AnswerScoreSum
order by q.ViewCount desc, q.Score desc
limit 100;