WITH RankedPosts AS (
    SELECT 
        P.Id,
        P.Title,
        P.Score,
        P.ViewCount,
        P.CreationDate,
        U.DisplayName,
        U.Reputation,
        ROW_NUMBER() OVER (PARTITION BY P.PostTypeId ORDER BY P.Score DESC, P.ViewCount DESC) AS rank
    FROM 
        Posts P
    JOIN 
        Users U ON P.OwnerUserId = U.Id
    WHERE 
        P.PostTypeId IN (1, 2) AND P.Score > 0
),
BadgeCounts AS (
    SELECT 
        U.Id AS UserId,
        COUNT(DISTINCT B.Id) AS BadgeCount
    FROM 
        Users U
    JOIN 
        Badges B ON U.Id = B.UserId
    WHERE 
        B.Class = 1 AND B.Date >= cast('2024-10-01' as date) - INTERVAL '1 year'
    GROUP BY 
        U.Id
)
SELECT 
    RP.Id, 
    RP.Title,
    RP.Score,
    RP.ViewCount,
    RP.CreationDate,
    RP.rank,
    U.DisplayName,
    U.Reputation,
    BC.BadgeCount,
    SUM(V.Score) OVER (PARTITION BY RP.Id ORDER BY V.CreationDate) AS cumulative_score,
    CASE 
        WHEN RP.rank <= 3 THEN 'Top'
        WHEN RP.rank <= 10 THEN 'High'
        ELSE 'Low'
    END AS rank_category
FROM 
    RankedPosts RP
LEFT JOIN 
    Users U ON RP.OwnerUserId = U.Id
LEFT JOIN 
    BadgeCounts BC ON RP.OwnerUserId = BC.UserId
LEFT JOIN 
    Votes V ON RP.Id = V.PostId
WHERE 
    EXISTS (
        SELECT 1 
        FROM 
            Tags T
        WHERE 
            T.Id = ANY (
                SELECT 
                    STRING_TO_ARRAY(P.Tags, '><')
                FROM 
                    Posts P
                WHERE 
                    P.Id = RP.Id
            )
            AND T.TagName IN ('SQL', 'Performance', 'Benchmarking')
    )
ORDER BY 
    RP.rank, 
    cumulative_score DESC;