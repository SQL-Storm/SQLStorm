-- {"query": "6982.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "nova-micro", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2098, "output_tokens": 497} 
SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
    SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
    MAX(u.CreationDate) AS LatestAccountActivity,
    MAX(p.LastActivityDate) AS LatestPostActivity,
    b.Class AS BadgeClass,
    t.TagName,
    ph.RevisionGUID,
    ph.CreationDate AS LastRevisionDate,
    ph.Comment,
    v.VoteTypeId,
    AVG(v.BountyAmount) AS AvgBounty
FROM 
    Users u
LEFT JOIN 
    (SELECT 
        ph.PostId,
        ph.RevisionGUID,
        ph.CreationDate AS LastRevisionDate,
        ph.Comment
     FROM 
        PostHistory ph
     WHERE 
        ph.PostHistoryTypeId IN (1, 2, 3, 4, 5, 6, 7, 10, 11, 12, 13, 14, 15, 19, 20, 35)
     ) ph ON u.Id = ph.UserId
RIGHT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Tags t ON t.ExcerptPostId = p.Id
LEFT JOIN 
    Votes v ON p.Id = v.PostId
WHERE 
    u.Reputation > 10000
    AND p.Score > 100
    AND (p.PostTypeId = 1 OR p.PostTypeId = 2)
GROUP BY 
    u.Id, u.DisplayName, u.Reputation, b.Class
HAVING 
    COUNT(DISTINCT CASE WHEN t.TagName IS NOT NULL THEN t.Id END) > 5
    AND MAX(ph.CreationDate) > DATE_SUB(cast('2024-10-01 12:34:56' as timestamp), INTERVAL 1 YEAR)
ORDER BY 
    u.Reputation DESC, p.Score DESC;