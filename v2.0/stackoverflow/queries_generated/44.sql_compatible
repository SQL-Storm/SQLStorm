with recent_users as (
    select u.id as user_id,
           u.displayname,
           u.reputation,
           u.creationdate,
           date_trunc('month', u.creationdate) as cohort_month,
           coalesce(nullif(trim(split_part(coalesce(u.location, ''), ',', 1)), ''), 'Unknown') as location_region
    from users u
    where u.creationdate >= (select date_trunc('year', max(creationdate)) - interval '2 years' from users)
),
posts_enriched as (
    select p.id,
           p.posttypeid,
           p.owneruserid,
           p.score,
           p.viewcount,
           p.creationdate,
           p.lastactivitydate,
           p.tags,
           p.title,
           case when p.posttypeid = 1 then 1 else 0 end as is_question,
           case when p.posttypeid = 2 then 1 else 0 end as is_answer
    from posts p
    where p.creationdate is not null
),
user_activity as (
    select ru.user_id,
           count(*) filter (where pe.is_question = 1) as q_count,
           count(*) filter (where pe.is_answer = 1) as a_count,
           sum(pe.score) as total_post_score,
           sum(coalesce(pe.viewcount,0)) as total_views,
           max(pe.lastactivitydate) as last_post_activity,
           min(pe.creationdate) as first_post_date
    from recent_users ru
    left join posts_enriched pe
      on pe.owneruserid = ru.user_id
    group by ru.user_id
),
comment_stats as (
    select c.userid as user_id,
           count(*) as comment_count,
           sum(c.score) as comment_score,
           avg(nullif(length(c.text),0)) as avg_comment_len
    from comments c
    where c.userid is not null
      and c.creationdate >= (select min(creationdate) from recent_users)
    group by c.userid
),
vote_stats as (
    select v.userid as user_id,
           count(*) filter (where v.votetypeid = 2) as upvotes_cast,
           count(*) filter (where v.votetypeid = 3) as downvotes_cast,
           count(*) filter (where v.votetypeid in (8,9)) as bounties_interactions,
           sum(case when v.votetypeid in (8,9) then coalesce(v.bountyamount,0) else 0 end) as bounty_total
    from votes v
    where v.userid is not null
      and v.creationdate >= (select min(creationdate) from recent_users)
    group by v.userid
),
answer_accepts as (
    select a.owneruserid as user_id,
           count(*) as answers_accepted
    from posts q
    join posts a
      on a.id = q.acceptedanswerid
    where q.posttypeid = 1
      and a.posttypeid = 2
    group by a.owneruserid
),
question_closure as (
    select q.owneruserid as user_id,
           count(*) as questions_closed
    from posts q
    where q.posttypeid = 1
      and q.closeddate is not null
    group by q.owneruserid
),
linkage as (
    select p.owneruserid as user_id,
           count(*) filter (where pl.linktypeid = 1) as links_count,
           count(*) filter (where pl.linktypeid = 3) as dup_count
    from postlinks pl
    join posts p on p.id = pl.postid
    group by p.owneruserid
),
tag_extracted as (
    select pe.id as post_id,
           unnest(string_to_array(substring(pe.tags, 2, greatest(length(pe.tags)-2,0)), '><')) as tagname
    from posts_enriched pe
    where pe.is_question = 1
      and pe.tags is not null
),
user_top_tags as (
    select p.owneruserid as user_id,
           te.tagname,
           count(*) as tag_uses,
           row_number() over (partition by p.owneruserid order by count(*) desc, te.tagname) as rn
    from tag_extracted te
    join posts p on p.id = te.post_id
    -- join tags t on t.tagname = te.tagname  -- not needed for tagname usage; removed to avoid ambiguity
    group by p.owneruserid, te.tagname
),
badge_agg as (
    select b.userid as user_id,
           count(*) as badges_total,
           count(*) filter (where b.class = 1) as gold_count,
           count(*) filter (where b.class = 2) as silver_count,
           count(*) filter (where b.class = 3) as bronze_count,
           max(b.date) as last_badge_date
    from badges b
    where b.date >= (select min(creationdate) from recent_users) - interval '6 months'
    group by b.userid
),
post_history_events as (
    select ph.userid as user_id,
           count(*) filter (where ph.posthistorytypeid in (10,11,12,13,14,15,19,20,31,33,34,35,36,50,52,53)) as mod_event_count,
           count(*) filter (where ph.posthistorytypeid = 10 and ph.comment ~ '^(101|102|103|104|105)$') as close_votes_structured,
           max(ph.creationdate) as last_event_date
    from posthistory ph
    where ph.userid is not null
      and ph.creationdate >= (select min(creationdate) from recent_users)
    group by ph.userid
),
activity_calendar as (
    select ru.user_id,
           date_trunc('month', generate_series(date_trunc('month', ru.creationdate), cast('2024-10-01 12:34:56' as timestamp), interval '1 month')) as month_bucket
    from recent_users ru
),
monthly_posting as (
    select ru.user_id,
           date_trunc('month', pe.creationdate) as month_bucket,
           count(*) as posts_in_month,
           sum(pe.score) as month_score
    from recent_users ru
    left join posts_enriched pe
      on pe.owneruserid = ru.user_id
    group by ru.user_id, date_trunc('month', pe.creationdate)
),
monthly_activity as (
    select ac.user_id,
           ac.month_bucket,
           coalesce(mp.posts_in_month, 0) as posts_in_month,
           coalesce(mp.month_score, 0) as month_score,
           sum(coalesce(mp.posts_in_month, 0)) over (partition by ac.user_id order by ac.month_bucket rows between unbounded preceding and current row) as cum_posts,
           sum(coalesce(mp.month_score, 0)) over (partition by ac.user_id order by ac.month_bucket rows between unbounded preceding and current row) as cum_score
    from activity_calendar ac
    left join monthly_posting mp
      on mp.user_id = ac.user_id and mp.month_bucket = ac.month_bucket
),
user_engagement_score as (
    select ru.user_id,
           0.3 * ln(1 + ua.q_count + ua.a_count) +
           0.2 * ln(1 + ua.total_views) +
           0.25 * ln(1 + coalesce(vs.upvotes_cast,0) + 2*coalesce(vs.downvotes_cast,0)) +
           0.15 * ln(1 + coalesce(aa.answers_accepted,0)) +
           0.1 * ln(1 + coalesce(ba.gold_count,0)*9 + coalesce(ba.silver_count,0)*3 + coalesce(ba.bronze_count,0)) as engagement_score_raw
    from recent_users ru
    left join user_activity ua on ua.user_id = ru.user_id
    left join vote_stats vs on vs.user_id = ru.user_id
    left join answer_accepts aa on aa.user_id = ru.user_id
    left join badge_agg ba on ba.user_id = ru.user_id
),
normalized_scores as (
    select ues.user_id,
           ues.engagement_score_raw,
           (ues.engagement_score_raw - avg(ues.engagement_score_raw) over ())
           / nullif(stddev_pop(ues.engagement_score_raw) over (), 0) as engagement_score_z
    from user_engagement_score ues
),
dup_network as (
    select q.owneruserid as user_id,
           count(distinct case when pl.linktypeid = 3 then pl.relatedpostid end) as distinct_dup_targets,
           count(distinct case when pl.linktypeid = 3 then pl.postid end) as distinct_dup_sources
    from posts q
    left join postlinks pl on pl.postid = q.id
    where q.posttypeid = 1
    group by q.owneruserid
),
question_quality as (
    select q.owneruserid as user_id,
           avg(nullif(q.score,0)) filter (where q.score is not null) as avg_question_score_nonzero,
           percentile_disc(0.9) within group (order by coalesce(q.viewcount,0)) filter (where q.posttypeid = 1) as p90_views,
           sum(case when q.favoritecount is not null and q.favoritecount > 0 then 1 else 0 end) as questions_favorited
    from posts q
    where q.posttypeid = 1
    group by q.owneruserid
),
string_patterns as (
    select p.owneruserid as user_id,
           count(*) filter (where p.title ilike '%how to%' or p.title ilike 'how do i%') as howto_titles,
           count(*) filter (where p.title ~* '^\s*\[.*\]\s*') as bracketed_prefix_titles,
           count(*) filter (where coalesce(p.title,'') ~* '\?$') as question_mark_end,
           count(*) filter (where p.tags like '%<sql>%' or p.tags like '%<postgresql>%') as sql_tagged
    from posts p
    where p.posttypeid = 1
    group by p.owneruserid
),
user_rollup as (
    select
        ru.user_id,
        ru.displayname,
        ru.reputation,
        ru.cohort_month,
        ru.location_region,
        ua.q_count, ua.a_count, ua.total_post_score, ua.total_views, ua.last_post_activity, ua.first_post_date,
        cs.comment_count, cs.comment_score, cs.avg_comment_len,
        vs.upvotes_cast, vs.downvotes_cast, vs.bounties_interactions, vs.bounty_total,
        coalesce(aa.answers_accepted,0) as answers_accepted,
        coalesce(qc.questions_closed,0) as questions_closed,
        coalesce(lk.links_count,0) as links_count,
        coalesce(lk.dup_count,0) as dup_count,
        coalesce(ba.badges_total,0) as badges_total,
        ba.gold_count, ba.silver_count, ba.bronze_count, ba.last_badge_date,
        phe.mod_event_count, phe.close_votes_structured, phe.last_event_date,
        ns.engagement_score_z,
        dn.distinct_dup_targets, dn.distinct_dup_sources,
        qq.avg_question_score_nonzero, qq.p90_views, qq.questions_favorited,
        sp.howto_titles, sp.bracketed_prefix_titles, sp.question_mark_end, sp.sql_tagged
    from recent_users ru
    left join user_activity ua on ua.user_id = ru.user_id
    left join comment_stats cs on cs.user_id = ru.user_id
    left join vote_stats vs on vs.user_id = ru.user_id
    left join answer_accepts aa on aa.user_id = ru.user_id
    left join question_closure qc on qc.user_id = ru.user_id
    left join linkage lk on lk.user_id = ru.user_id
    left join badge_agg ba on ba.user_id = ru.user_id
    left join post_history_events phe on phe.user_id = ru.user_id
    left join normalized_scores ns on ns.user_id = ru.user_id
    left join dup_network dn on dn.user_id = ru.user_id
    left join question_quality qq on qq.user_id = ru.user_id
    left join string_patterns sp on sp.user_id = ru.user_id
),
top_tag_pivot as (
    select utt.user_id,
           max(case when utt.rn = 1 then utt.tagname end) as top_tag_1,
           max(case when utt.rn = 2 then utt.tagname end) as top_tag_2,
           max(case when utt.rn = 3 then utt.tagname end) as top_tag_3
    from user_top_tags utt
    where utt.rn <= 3
    group by utt.user_id
),
ranked_users as (
    select ur.*,
           tt.top_tag_1, tt.top_tag_2, tt.top_tag_3,
           row_number() over (order by coalesce(ur.engagement_score_z, -10) desc, coalesce(ur.total_post_score,0) desc, ur.reputation desc, ur.user_id) as rn_global,
           row_number() over (partition by ur.location_region order by coalesce(ur.engagement_score_z, -10) desc, coalesce(ur.total_post_score,0) desc, ur.reputation desc) as rn_by_region,
           row_number() over (partition by date_trunc('quarter', ur.cohort_month) order by coalesce(ur.engagement_score_z, -10) desc) as rn_by_cohort
    from user_rollup ur
    left join top_tag_pivot tt on tt.user_id = ur.user_id
),
agg_monthly as (
    select ma.user_id,
           count(*) as active_months,
           max(case when ma.cum_posts >= 10 then ma.month_bucket end) as month_reached_10_posts,
           max(case when ma.cum_score >= 100 then ma.month_bucket end) as month_reached_100_score
    from monthly_activity ma
    group by ma.user_id
),
final_scores as (
    select ru.user_id,
           0.4 * coalesce(ru.engagement_score_z, -1) +
           0.2 * ln(1 + coalesce(ru.total_views,0)) +
           0.15 * ln(1 + coalesce(ru.badges_total,0)) +
           0.1 * ln(1 + coalesce(ru.answers_accepted,0)) +
           0.05 * ln(1 + coalesce(ru.sql_tagged,0)) +
           0.1 * ln(1 + coalesce(ru.comment_count,0)) as final_score
    from user_rollup ru
)
select
    r.rn_global,
    r.rn_by_region,
    r.rn_by_cohort,
    r.user_id,
    coalesce(nullif(r.displayname,''),'(anonymous)') as displayname,
    r.reputation,
    r.location_region,
    r.cohort_month,
    r.q_count, r.a_count, r.total_post_score, r.total_views,
    r.upvotes_cast, r.downvotes_cast, r.bounty_total,
    r.answers_accepted, r.questions_closed,
    r.links_count, r.dup_count, r.distinct_dup_targets, r.distinct_dup_sources,
    r.badges_total, r.gold_count, r.silver_count, r.bronze_count,
    r.avg_question_score_nonzero, r.p90_views, r.questions_favorited,
    r.howto_titles, r.bracketed_prefix_titles, r.question_mark_end,
    r.sql_tagged,
    r.top_tag_1, r.top_tag_2, r.top_tag_3,
    fm.active_months,
    fm.month_reached_10_posts,
    fm.month_reached_100_score,
    round(coalesce(ns.engagement_score_z, -1)::numeric, 3) as engagement_score_z,
    round(coalesce(fs.final_score, 0)::numeric, 3) as final_score,
    case
        when coalesce(fs.final_score,0) >= percentile_disc(0.95) within group (order by coalesce(fs.final_score,0)) over ()
            then 'Elite'
        when coalesce(fs.final_score,0) >= percentile_disc(0.75) within group (order by coalesce(fs.final_score,0)) over ()
            then 'High'
        when coalesce(fs.final_score,0) >= percentile_disc(0.50) within group (order by coalesce(fs.final_score,0)) over ()
            then 'Medium'
        else 'Low'
    end as segment
from ranked_users r
left join agg_monthly fm on fm.user_id = r.user_id
left join normalized_scores ns on ns.user_id = r.user_id
left join final_scores fs on fs.user_id = r.user_id
where (r.q_count + r.a_count) > 0
  and coalesce(r.questions_closed,0) <= (coalesce(r.q_count,0) * 2)
  and not (
        r.top_tag_1 is null
        and r.top_tag_2 is null
        and r.top_tag_3 is null
        and coalesce(r.sql_tagged,0) = 0
  )
order by r.rn_global
limit 200;