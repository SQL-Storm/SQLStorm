WITH UserStats AS (
    SELECT
        u.Id,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 1)               AS GoldBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 2)               AS SilverBadges,
        COUNT(DISTINCT b.Id) FILTER (WHERE b.Class = 3)               AS BronzeBadges,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END)             AS UpVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END)             AS DownVotesGiven,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 1)                   AS QuestionsAsked,
        COUNT(p.Id) FILTER (WHERE p.PostTypeId = 2)                   AS AnswersGiven,
        MAX(p.CreationDate)                                           AS LastPostDate
    FROM Users u
    LEFT JOIN Badges b       ON b.UserId = u.Id
    LEFT JOIN Votes v        ON v.UserId = u.Id
    LEFT JOIN Posts p        ON p.OwnerUserId = u.Id
    GROUP BY u.Id, u.DisplayName, u.Reputation
),

UserTagActivity AS (
    SELECT
        us.Id                                      AS UserId,
        tt.TagName,
        COUNT(*)                                   AS TagUseCount,
        ROW_NUMBER() OVER (PARTITION BY us.Id ORDER BY COUNT(*) DESC) AS TagRank
    FROM UserStats us
    JOIN Posts p
        ON p.OwnerUserId = us.Id
       AND p.PostTypeId = 1
    CROSS JOIN LATERAL (
        SELECT UNNEST(STRING_TO_ARRAY(SUBSTRING(p.Tags, 2, LENGTH(p.Tags)-2), '><')) AS tag
    ) AS pt
    JOIN Tags tt
        ON tt.TagName = pt.tag
       AND (tt.IsModeratorOnly = FALSE OR tt.IsModeratorOnly = 0)
    GROUP BY us.Id, tt.TagName
),

RecentClosedQuestions AS (
    SELECT
        p.Id,
        p.Title,
        p.CreationDate,
        ph.CreationDate                         AS ClosedDate,
        COALESCE(NULLIF(ph.Comment, ''), 'Unknown') AS CloseReasonCode,
        JSONB_EXTRACT_PATH_TEXT(ph.Text, 'users')   AS CloseVoterIds
    FROM Posts p
    JOIN PostHistory ph
        ON ph.PostId = p.Id
       AND ph.PostHistoryTypeId = 10               -- Close event
    WHERE p.PostTypeId = 1
      AND ph.CreationDate > (CAST('2024-10-01' AS DATE) - INTERVAL '30 days')
),

Combined AS (
    SELECT
        us.Id,
        us.DisplayName,
        us.Reputation,
        us.GoldBadges,
        us.SilverBadges,
        us.BronzeBadges,
        us.UpVotesGiven,
        us.DownVotesGiven,
        us.QuestionsAsked,
        us.AnswersGiven,
        us.LastPostDate,
        COALESCE(uta.TagName, 'None')           AS FavoriteTag,
        COALESCE(uta.TagUseCount, 0)            AS FavoriteTagUse,
        rcq.Title                               AS RecentClosedTitle,
        rcq.ClosedDate,
        rcq.CloseReasonCode
    FROM UserStats us
    LEFT JOIN (
        SELECT UserId, TagName, TagUseCount
        FROM UserTagActivity
        WHERE TagRank = 1
    ) uta
        ON uta.UserId = us.Id
    LEFT JOIN LATERAL (
        SELECT rcq.Title, rcq.ClosedDate, rcq.CloseReasonCode
        FROM RecentClosedQuestions rcq
        WHERE rcq.Id = (
            SELECT p2.Id
            FROM Posts p2
            WHERE p2.OwnerUserId = us.Id
              AND p2.PostTypeId = 1
            ORDER BY p2.CreationDate DESC
            LIMIT 1
        )
        LIMIT 1
    ) rcq ON TRUE
)

SELECT
    Id,
    DisplayName,
    Reputation,
    GoldBadges,
    SilverBadges,
    BronzeBadges,
    UpVotesGiven,
    DownVotesGiven,
    QuestionsAsked,
    AnswersGiven,
    LastPostDate,
    FavoriteTag,
    FavoriteTagUse,
    RecentClosedTitle,
    ClosedDate,
    CloseReasonCode
FROM Combined
WHERE Reputation > 5000
   OR GoldBadges >= 5
   OR (AnswersGiven > 100 AND UpVotesGiven > (DownVotesGiven * 2))

UNION ALL

SELECT
    -1                                              AS Id,
    'Aggregate'                                     AS DisplayName,
    (SELECT MAX(Reputation) FROM Users)             AS Reputation,
    0                                               AS GoldBadges,
    0                                               AS SilverBadges,
    0                                               AS BronzeBadges,
    0                                               AS UpVotesGiven,
    0                                               AS DownVotesGiven,
    0                                               AS QuestionsAsked,
    0                                               AS AnswersGiven,
    CAST('2024-10-01 12:34:56' AS TIMESTAMP)        AS LastPostDate,
    NULL                                            AS FavoriteTag,
    0                                               AS FavoriteTagUse,
    NULL                                            AS RecentClosedTitle,
    NULL                                            AS ClosedDate,
    NULL                                            AS CloseReasonCode

ORDER BY Reputation DESC, GoldBadges DESC, AnswersGiven DESC
LIMIT 101;