-- {"query": "2756.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-4.1-mini", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2027, "output_tokens": 1550} 
with RecursiveUserBadges as (
    select
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        b.Name as BadgeName,
        b.Class as BadgeClass,
        row_number() over (partition by u.Id order by b.Date desc, b.Name) as BadgeRank
    from Users u
    left join Badges b on u.Id = b.UserId
    where u.Reputation > 1000
),
TopUsersWithBadges as (
    select
        UserId,
        DisplayName,
        Reputation,
        BadgeName,
        BadgeClass
    from RecursiveUserBadges
    where BadgeRank <= 5
),
PostsWithAnswers as (
    select
        p.Id as QuestionId,
        p.Title,
        p.Tags,
        p.CreationDate as QuestionDate,
        p.Score as QuestionScore,
        a.Id as AnswerId,
        a.CreationDate as AnswerDate,
        a.Score as AnswerScore,
        a.OwnerUserId as AnswerOwnerUserId,
        a.Body as AnswerBody,
        u.DisplayName as AnswerOwnerDisplayName
    from Posts p
    left join Posts a on a.ParentId = p.Id and a.PostTypeId = 2
    left join Users u on a.OwnerUserId = u.Id
    where p.PostTypeId = 1
      and p.Score > 5
),
PostCommentsAgg as (
    select
        c.PostId,
        count(*) filter (where c.Score is not null and c.Score >= 0) as PositiveComments,
        count(*) filter (where c.Score is not null and c.Score < 0) as NegativeComments,
        string_agg(coalesce(c.Text, ''), ' | ' order by c.CreationDate desc) as RecentCommentsConcat
    from Comments c
    group by c.PostId
),
AnswerRanks as (
    select
        q.QuestionId,
        q.Title,
        q.Tags,
        q.QuestionDate,
        q.QuestionScore,
        q.AnswerId,
        q.AnswerDate,
        q.AnswerScore,
        q.AnswerOwnerUserId,
        q.AnswerBody,
        q.AnswerOwnerDisplayName,
        row_number() over (partition by q.QuestionId order by q.AnswerScore desc nulls last, q.AnswerDate asc) as AnswerRank
    from PostsWithAnswers q
),
DuplicateLinks as (
    select
        pl.PostId,
        pl.RelatedPostId,
        pt1.Title as OriginalTitle,
        pt2.Title as DuplicateOfTitle
    from PostLinks pl
    join Posts pt1 on pl.PostId = pt1.Id
    join Posts pt2 on pl.RelatedPostId = pt2.Id
    where pl.LinkTypeId = 3  -- duplicates
),
UserActivityRanks as (
    select
        u.Id,
        u.DisplayName,
        count(distinct p.Id) as PostsCount,
        count(distinct c.Id) as CommentsCount,
        count(distinct v.Id) as VotesCastCount,
        rank() over (order by count(distinct p.Id) desc) as PostsRank,
        rank() over (order by count(distinct c.Id) desc) as CommentsRank,
        rank() over (order by count(distinct v.Id) desc) as VotesCastRank
    from Users u
    left join Posts p on p.OwnerUserId = u.Id
    left join Comments c on c.UserId = u.Id
    left join Votes v on v.UserId = u.Id
    group by u.Id, u.DisplayName
),
BountyStats as (
    select
        p.Id as PostId,
        coalesce(sum(v.BountyAmount), 0) as TotalBounty
    from Posts p
    left join Votes v on v.PostId = p.Id and v.VoteTypeId = 8 -- BountyStart
    group by p.Id
),
FinalSelection as (
    select
        au.UserId,
        au.DisplayName,
        au.Reputation,
        au.BadgeName,
        au.BadgeClass,
        pr.QuestionId,
        pr.Title as QuestionTitle,
        pr.Tags as QuestionTags,
        pr.QuestionDate,
        pr.QuestionScore,
        pr.AnswerId,
        pr.AnswerDate,
        pr.AnswerScore,
        pr.AnswerOwnerUserId,
        pr.AnswerOwnerDisplayName,
        pca.PositiveComments,
        pca.NegativeComments,
        pca.RecentCommentsConcat,
        dl.RelatedPostId as DuplicatePostId,
        dl.DuplicateOfTitle,
        uar.PostsCount,
        uar.CommentsCount,
        uar.VotesCastCount,
        bs.TotalBounty
    from TopUsersWithBadges au
    join AnswerRanks pr on pr.AnswerOwnerUserId = au.UserId and pr.AnswerRank = 1
    left join PostCommentsAgg pca on pca.PostId = pr.AnswerId
    left join DuplicateLinks dl on dl.PostId = pr.QuestionId
    left join UserActivityRanks uar on uar.Id = au.UserId
    left join BountyStats bs on bs.PostId = pr.QuestionId
    where pr.AnswerScore > 0
)
select
    UserId,
    DisplayName,
    Reputation,
    coalesce(BadgeName, 'No Badge') as BadgeName,
    case BadgeClass
        when 1 then 'Gold'
        when 2 then 'Silver'
        when 3 then 'Bronze'
        else 'None'
    end as BadgeClass,
    QuestionId,
    QuestionTitle,
    -- Calculate tags count by splitting tags string and counting elements (tags stored like '<tag1><tag2>')
    cardinality(string_to_array(substring(QuestionTags from 2 for length(QuestionTags)-2), '><')) as TagCount,
    QuestionDate,
    QuestionScore,
    AnswerId,
    AnswerDate,
    AnswerScore,
    AnswerOwnerUserId,
    AnswerOwnerDisplayName,
    PositiveComments,
    NegativeComments,
    case 
        when length(RecentCommentsConcat) > 100 then substring(RecentCommentsConcat from 1 for 100) || ' ...'
        else RecentCommentsConcat
    end as RecentCommentsSnippet,
    DuplicatePostId,
    DuplicateOfTitle,
    PostsCount,
    CommentsCount,
    VotesCastCount,
    TotalBounty,
    -- Complex expression: weighted score with null-safe coalesce and sign checks
    round(
      coalesce(AnswerScore, 0) * 1.5
      + coalesce(QuestionScore, 0) * 1.2
      + coalesce(PositiveComments, 0) * 0.5
      - coalesce(NegativeComments, 0) * 0.75
      + (case when TotalBounty > 0 then log(TotalBounty + 1) else 0 end)
    , 2) as WeightedAnswerImpactScore
from FinalSelection
where
    -- Complex predicate including null check and string pattern matching
    (DisplayName is not null and DisplayName <> '' and DisplayName not like '%bot%')
    and (QuestionDate > cast('2024-10-01' as date) - interval '5 years')
    and (BadgeClass in ('Gold', 'Silver') or BadgeName is null)
order by WeightedAnswerImpactScore desc, Reputation desc, DisplayName
limit 100;