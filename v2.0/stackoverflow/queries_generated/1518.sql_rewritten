-- {"query": "1518.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 2772} 
WITH UserEngagement AS (
    -- CTE 1: Aggregate user-level activity and reputation
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.Views AS UserProfileViews,
        U.UpVotes AS TotalUpvotesGiven,
        U.DownVotes AS TotalDownvotesGiven,
        COUNT(DISTINCT P.Id) AS TotalPostsCreated,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 1 THEN P.Id END) AS TotalQuestions,
        COUNT(DISTINCT CASE WHEN P.PostTypeId = 2 THEN P.Id END) AS TotalAnswers,
        SUM(P.Score) AS TotalPostScoreReceived,
        COUNT(C.Id) AS TotalCommentsMade,
        MAX(U.LastAccessDate) AS LastUserActivityDate,
        AVG(P.Score) FILTER (WHERE P.PostTypeId IN (1,2)) AS AvgQuestionAnswerScore
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.Views, U.UpVotes, U.DownVotes
),
PostDetailMetrics AS (
    -- CTE 2: Detailed metrics for posts, including associated vote counts and comment summaries
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        P.AnswerCount,
        P.CommentCount,
        P.FavoriteCount,
        P.Title,
        P.Tags,
        LENGTH(P.Body) AS BodyLength,
        CASE WHEN P.AcceptedAnswerId IS NOT NULL THEN TRUE ELSE FALSE END AS HasAcceptedAnswer,
        CASE WHEN P.ClosedDate IS NOT NULL THEN TRUE ELSE FALSE END AS IsClosed,
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 2 THEN 1 ELSE 0 END), 0) AS PostUpVotes, -- UpMod
        COALESCE(SUM(CASE WHEN V.VoteTypeId = 3 THEN 1 ELSE 0 END), 0) AS PostDownVotes, -- DownMod
        COUNT(DISTINCT C.UserId) AS DistinctCommenters,
        (SELECT COUNT(DISTINCT UserId) FROM Votes WHERE PostId = P.Id AND VoteTypeId IN (2,3)) AS DistinctVoters, -- Correlated subquery example
        ROW_NUMBER() OVER (PARTITION BY P.OwnerUserId ORDER BY P.CreationDate DESC) AS rn_latest_post_by_user
    FROM Posts P
    LEFT JOIN Votes V ON P.Id = V.PostId
    LEFT JOIN Comments C ON P.Id = C.PostId
    GROUP BY
        P.Id, P.PostTypeId, P.OwnerUserId, P.CreationDate, P.Score, P.ViewCount,
        P.AnswerCount, P.CommentCount, P.FavoriteCount, P.Title, P.Tags, P.Body, P.AcceptedAnswerId, P.ClosedDate
),
RecentPostActivity AS (
    -- CTE 3: Filter recent posts and categorize them
    SELECT
        PDM.PostId,
        PDM.OwnerUserId,
        PDM.PostTypeId,
        PDM.PostCreationDate,
        PDM.Title,
        PDM.PostScore,
        PDM.PostUpVotes,
        PDM.PostDownVotes,
        PDM.CommentCount,
        PDM.BodyLength,
        PDM.Tags,
        PDM.HasAcceptedAnswer,
        ARRAY_LENGTH(string_to_array(SUBSTRING(PDM.Tags, 2, LENGTH(PDM.Tags) - 2), '><'), 1) AS TagCount,
        CASE
            WHEN PDM.BodyLength > 2000 THEN 'Very Long'
            WHEN PDM.BodyLength BETWEEN 501 AND 2000 THEN 'Medium'
            ELSE 'Short'
        END AS BodyLengthCategory,
        CASE
            WHEN PDM.PostTypeId = 1 AND PDM.PostScore > 50 THEN 'High Impact Question'
            WHEN PDM.PostTypeId = 2 AND PDM.PostScore > 20 AND PDM.HasAcceptedAnswer THEN 'High Impact Accepted Answer'
            WHEN PDM.PostTypeId IN (1,2) AND PDM.PostScore > 10 THEN 'Medium Impact Post'
            ELSE 'Low Impact Post'
        END AS PostImpactCategory,
        PDM.rn_latest_post_by_user
    FROM PostDetailMetrics PDM
    WHERE PDM.PostCreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '6 months') -- Only consider posts from the last 6 months
),
PostLinkInformation AS (
    -- CTE 4: Information about post links, specifically duplicates
    SELECT
        PL.PostId,
        PL.RelatedPostId,
        LT.Name AS LinkTypeName
    FROM PostLinks PL
    JOIN LinkTypes LT ON PL.LinkTypeId = LT.Id
    WHERE LT.Id = 3 -- Duplicate links
),
PostEditorHistory AS (
    -- CTE 5: Track edit history for posts, focusing on the original author's edits
    SELECT
        PH.PostId,
        PH.UserId AS EditorUserId,
        COUNT(PH.Id) AS EditCount,
        MAX(PH.CreationDate) AS LastEditDate
    FROM PostHistory PH
    WHERE PH.PostHistoryTypeId IN (4, 5, 6) -- Edit Title, Edit Body, Edit Tags
    GROUP BY PH.PostId, PH.UserId
),
BadgesSummary AS (
    -- CTE 6: Summarize recent badge acquisitions for users
    SELECT
        B.UserId,
        COUNT(B.Id) AS RecentBadgesCount,
        MAX(B.Date) AS LastBadgeDate,
        STRING_AGG(DISTINCT B.Name, ', ' ORDER BY B.Name) AS RecentBadgeNames -- String aggregation
    FROM Badges B
    WHERE B.Date >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year')
    GROUP BY B.UserId
),
TopUsersByMetric AS (
    -- CTE 7: Select users based on high upvotes or high post scores for recent questions/answers
    -- This CTE uses a set operator (UNION ALL)
    SELECT UE.UserId, 'High Upvoted Questions' AS MetricType
    FROM UserEngagement UE
    JOIN RecentPostActivity RPA ON UE.UserId = RPA.OwnerUserId
    WHERE RPA.PostTypeId = 1 AND RPA.PostUpVotes > 100 AND RPA.PostImpactCategory = 'High Impact Question'
    UNION ALL
    SELECT UE.UserId, 'Highly Scored Answers' AS MetricType
    FROM UserEngagement UE
    JOIN RecentPostActivity RPA ON UE.UserId = RPA.OwnerUserId
    WHERE RPA.PostTypeId = 2 AND RPA.PostScore > 50 AND RPA.HasAcceptedAnswer
)
-- Main Query: Combine all CTEs to find highly engaged users with specific characteristics
SELECT
    UE.UserId,
    UE.DisplayName,
    UE.Reputation,
    UE.UserCreationDate,
    UE.UserProfileViews,
    UE.TotalPostsCreated,
    UE.TotalQuestions,
    UE.TotalAnswers,
    UE.TotalPostScoreReceived,
    UE.TotalCommentsMade,
    UE.LastUserActivityDate,
    UE.AvgQuestionAnswerScore,
    BS.RecentBadgesCount,
    BS.LastBadgeDate,
    BS.RecentBadgeNames,
    COUNT(DISTINCT RPA.PostId) AS RecentActivePostsCount,
    COALESCE(SUM(RPA.PostUpVotes), 0) AS TotalRecentUpvotes,
    COALESCE(SUM(RPA.PostDownVotes), 0) AS TotalRecentDownvotes,
    COALESCE(SUM(CASE WHEN RPA.BodyLengthCategory = 'Very Long' THEN 1 ELSE 0 END), 0) AS VeryLongPostsCount,
    COALESCE(SUM(CASE WHEN RPA.BodyLengthCategory = 'Medium' THEN 1 ELSE 0 END), 0) AS MediumPostsCount,
    COALESCE(SUM(CASE WHEN RPA.TagCount > 5 THEN 1 ELSE 0 END), 0) AS PostsWithManyTagsCount,
    -- Window function: Rank users by their total recent upvotes
    RANK() OVER (ORDER BY COALESCE(SUM(RPA.PostUpVotes), 0) DESC, UE.Reputation DESC, UE.TotalPostsCreated DESC) AS OverallEngagementRank,
    -- Correlated subquery in SELECT clause: calculate average score of *all other* posts by this user
    (
        SELECT AVG(P_OTHER.Score)
        FROM Posts P_OTHER
        WHERE P_OTHER.OwnerUserId = UE.UserId
          AND P_OTHER.PostTypeId IN (1, 2)
          AND P_OTHER.Id NOT IN (SELECT PostId FROM RecentPostActivity WHERE OwnerUserId = UE.UserId)
    ) AS AvgOtherPostScore,
    -- Check if any recent post by the user is linked as a duplicate (NULL logic)
    MAX(CASE WHEN PLI.PostId IS NOT NULL THEN TRUE ELSE FALSE END) AS HasRecentDuplicateLinkedPost,
    -- Check if the user has edited their own recent posts frequently (more than 3 times for their latest post)
    MAX(CASE WHEN PEH.EditCount > 3 AND PEH.PostId = RPA.PostId AND PEH.EditorUserId = UE.UserId AND RPA.rn_latest_post_by_user = 1 THEN TRUE ELSE FALSE END) AS LatestPostEditedFrequentlyBySelf,
    -- Aggregated string expression for diverse post categories
    STRING_AGG(DISTINCT RPA.PostImpactCategory || ' (' || RPA.BodyLengthCategory || ')', '; ' ORDER BY RPA.PostImpactCategory) FILTER (WHERE RPA.PostImpactCategory IS NOT NULL) AS RecentPostCategoryMix,
    COUNT(DISTINCT TUM.MetricType) AS DistinctTopMetricTypes -- From UNION ALL CTE
FROM UserEngagement UE
LEFT JOIN RecentPostActivity RPA ON UE.UserId = RPA.OwnerUserId
LEFT JOIN PostLinkInformation PLI ON RPA.PostId = PLI.PostId
LEFT JOIN PostEditorHistory PEH ON RPA.PostId = PEH.PostId AND UE.UserId = PEH.EditorUserId -- Check self-edits
LEFT JOIN BadgesSummary BS ON UE.UserId = BS.UserId
LEFT JOIN TopUsersByMetric TUM ON UE.UserId = TUM.UserId
WHERE
    UE.Reputation > 10000 -- High reputation users
    AND UE.TotalPostsCreated > 10 -- Active contributors
    AND UE.LastUserActivityDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 months') -- Recently active
    AND (
        (RPA.PostTypeId = 1 AND RPA.PostScore >= 20) OR -- Questions with good score
        (RPA.PostTypeId = 2 AND RPA.PostScore >= 10 AND RPA.HasAcceptedAnswer) OR -- Accepted answers with decent score
        RPA.PostId IS NULL -- Include users with no recent posts matching criteria but still high rep/activity
    )
    -- NULL logic: ensure DisplayName is not null for reporting and filter out users with default/null display names
    AND UE.DisplayName IS NOT NULL AND UE.DisplayName != ''
GROUP BY
    UE.UserId, UE.DisplayName, UE.Reputation, UE.UserCreationDate, UE.UserProfileViews, UE.TotalPostsCreated,
    UE.TotalQuestions, UE.TotalAnswers, UE.TotalPostScoreReceived, UE.TotalCommentsMade,
    UE.LastUserActivityDate, UE.AvgQuestionAnswerScore, BS.RecentBadgesCount, BS.LastBadgeDate, BS.RecentBadgeNames
HAVING
    COUNT(DISTINCT RPA.PostId) > 0 -- Must have at least one recent active post meeting criteria
    OR UE.TotalPostsCreated > 50 -- Or simply a prolific user, even if recent posts don't meet strict criteria
ORDER BY
    OverallEngagementRank ASC, UE.Reputation DESC, TotalRecentUpvotes DESC
LIMIT 100;