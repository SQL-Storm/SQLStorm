WITH UserActivitySummary AS (
    SELECT
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.CreationDate AS UserCreationDate,
        u.Views AS UserProfileViews,
        u.UpVotes AS UserUpVotes,
        u.DownVotes AS UserDownVotes,
        COALESCE(u.Location, 'Unknown') AS UserLocation,
        u.WebsiteUrl,
        COUNT(DISTINCT p.Id) AS TotalPosts,
        SUM(CASE WHEN p.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN p.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        AVG(COALESCE(p.Score, 0)) AS AveragePostScore,
        SUM(COALESCE(p.FavoriteCount, 0)) AS TotalPostFavorites,
        COUNT(DISTINCT c.Id) AS TotalComments,
        AVG(COALESCE(c.Score, 0)) AS AverageCommentScore,
        MAX(p.LastActivityDate) AS LastPostActivity,
        MAX(c.CreationDate) AS LastCommentActivity
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    GROUP BY
        u.Id, u.DisplayName, u.Reputation, u.CreationDate, u.Views, u.UpVotes, u.DownVotes, u.Location, u.WebsiteUrl
),
PostEditAndModerationStats AS (
    SELECT
        p.Id AS PostId,
        p.PostTypeId,
        p.CreationDate AS PostCreationDate,
        p.OwnerUserId,
        p.Score AS PostScore,
        p.ViewCount AS PostViewCount,
        p.AnswerCount,
        p.CommentCount AS PostCommentCount,
        p.FavoriteCount AS PostFavoriteCount,
        p.Title AS PostTitle,
        p.Tags AS PostTags,
        p.AcceptedAnswerId,
        p.ClosedDate,
        COUNT(DISTINCT ph_edit.Id) AS EditCount,
        MAX(ph_edit.CreationDate) AS LastEditDate,
        COUNT(CASE WHEN ph_close.PostHistoryTypeId IN (10, 101, 102, 103, 104, 105) THEN 1 ELSE NULL END) AS CloseVotesCount,
        MAX(CASE WHEN ph_close.PostHistoryTypeId IN (10, 101, 102, 103, 104, 105) THEN ph_close.CreationDate ELSE NULL END) AS LastCloseDate,
        COUNT(DISTINCT ph_reopen.Id) AS ReopenCount,
        COUNT(DISTINCT ph_delete.Id) AS DeleteCount,
        STRING_AGG(DISTINCT crt.Name, '; ') FILTER (WHERE crt.Name IS NOT NULL) AS DistinctCloseReasons
    FROM Posts p
    LEFT JOIN PostHistory ph_edit ON p.Id = ph_edit.PostId
        AND ph_edit.PostHistoryTypeId IN (4, 5, 6, 7, 8, 9, 24) -- Edit types
    LEFT JOIN PostHistory ph_close ON p.Id = ph_close.PostId
        AND ph_close.PostHistoryTypeId IN (10, 101, 102, 103, 104, 105) -- Close types
    LEFT JOIN CloseReasonTypes crt ON ph_close.Comment = crt.Id::varchar(50) -- Assuming Comment field stores CloseReasonId as string
    LEFT JOIN PostHistory ph_reopen ON p.Id = ph_reopen.PostId
        AND ph_reopen.PostHistoryTypeId = 11 -- Reopen type
    LEFT JOIN PostHistory ph_delete ON p.Id = ph_delete.PostId
        AND ph_delete.PostHistoryTypeId = 12 -- Delete type
    GROUP BY
        p.Id, p.PostTypeId, p.CreationDate, p.OwnerUserId, p.Score, p.ViewCount, p.AnswerCount,
        p.CommentCount, p.FavoriteCount, p.Title, p.Tags, p.AcceptedAnswerId, p.ClosedDate
),
UserBadgeSummary AS (
    SELECT
        b.UserId,
        COUNT(b.Id) AS TotalBadges,
        SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        MIN(b.Date) AS FirstBadgeDate,
        MAX(b.Date) AS LastBadgeDate,
        COUNT(DISTINCT b.Name) AS UniqueBadgeNames,
        STRING_AGG(DISTINCT b.Name, '; ') FILTER (WHERE b.Name IS NOT NULL AND b.Class = 1) AS GoldBadgeNames
    FROM Badges b
    GROUP BY b.UserId
),
PostLinkAnalysis AS (
    SELECT
        pl.PostId,
        COUNT(DISTINCT pl.RelatedPostId) FILTER (WHERE pl.LinkTypeId = 1) AS LinkedToCount,
        COUNT(DISTINCT pl.RelatedPostId) FILTER (WHERE pl.LinkTypeId = 3) AS DuplicateOfCount,
        STRING_AGG(DISTINCT t.TagName, '; ') FILTER (WHERE t.TagName IS NOT NULL) AS AllRelatedTags
    FROM PostLinks pl
    JOIN Posts related_p ON pl.RelatedPostId = related_p.Id
    LEFT JOIN LATERAL UNNEST(string_to_array(SUBSTRING(related_p.Tags, 2, LENGTH(related_p.Tags) - 2), '><')) AS tag_name ON TRUE
    LEFT JOIN Tags t ON t.TagName = tag_name
    GROUP BY pl.PostId
),
UserVoteAnalysis AS (
    SELECT
        v.UserId,
        COUNT(v.Id) AS TotalVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
        SUM(CASE WHEN v.VoteTypeId = 8 THEN 1 ELSE 0 END) AS BountyStartsGiven,
        SUM(COALESCE(v.BountyAmount, 0)) AS TotalBountyGiven
    FROM Votes v
    WHERE v.UserId IS NOT NULL
    GROUP BY v.UserId
)
SELECT
    uas.UserId,
    uas.DisplayName,
    uas.Reputation,
    uas.UserCreationDate,
    uas.UserProfileViews,
    uas.TotalQuestions,
    uas.TotalAnswers,
    uas.AveragePostScore,
    uas.TotalComments,
    COALESCE(ubs.GoldBadges, 0) AS GoldBadges,
    COALESCE(ubs.SilverBadges, 0) AS SilverBadges,
    COALESCE(ubs.BronzeBadges, 0) AS BronzeBadges,
    COALESCE(uva.UpVotesGiven, 0) AS UserUpVotesGiven,
    COALESCE(uva.DownVotesGiven, 0) AS UserDownVotesGiven,
    -- Correlated subquery: Get the title of the highest scored answer given by this user to a question within the first year of their activity
    (
        SELECT pa.Title
        FROM Posts pa
        WHERE pa.OwnerUserId = uas.UserId
          AND pa.PostTypeId = 2 -- Answer
          AND pa.CreationDate BETWEEN uas.UserCreationDate AND uas.UserCreationDate + INTERVAL '1 year'
        ORDER BY pa.Score DESC, pa.CreationDate DESC
        LIMIT 1
    ) AS TopAnswerTitleInFirstYear,
    -- Another correlated subquery: Check if the user has any question that was closed as a duplicate within 30 days of creation
    EXISTS (
        SELECT 1
        FROM PostEditAndModerationStats pems_corr
        WHERE pems_corr.OwnerUserId = uas.UserId
          AND pems_corr.PostTypeId = 1
          AND pems_corr.ClosedDate IS NOT NULL
          AND pems_corr.PostCreationDate BETWEEN uas.UserCreationDate AND uas.UserCreationDate + INTERVAL '30 days'
          AND pems_corr.DistinctCloseReasons LIKE '%Duplicate%'
    ) AS HasEarlyDuplicateClose,
    -- Window function: Rank users by reputation within their creation year
    RANK() OVER (PARTITION BY EXTRACT(YEAR FROM uas.UserCreationDate) ORDER BY uas.Reputation DESC) AS RankInCreationYear,
    NTILE(10) OVER (ORDER BY uas.Reputation DESC) AS ReputationDecile, -- Divide users into 10 groups by reputation
    -- Complex calculation based on various metrics, including COALESCE for NULL safety
    (uas.Reputation * 0.5 + COALESCE(uas.UserProfileViews, 0) * 0.1 + COALESCE(uas.TotalQuestions, 0) * 5 + COALESCE(uas.TotalAnswers, 0) * 3 + COALESCE(uas.AveragePostScore, 0) * 2 + COALESCE(ubs.GoldBadges, 0) * 100) AS UserEngagementScore,
    -- String expression and NULL logic: Combine user location and website, or indicate missing
    COALESCE(uas.UserLocation || ' (' || uas.WebsiteUrl || ')', uas.UserLocation, 'No Location or Website') AS LocationAndWebsiteInfo,
    -- Aggregate some post stats for high-reputation users, limited to posts with specific tags
    (
        SELECT SUM(pems.PostScore)
        FROM PostEditAndModerationStats pems
        WHERE pems.OwnerUserId = uas.UserId
          AND pems.PostTypeId = 1 -- Questions
          AND COALESCE(pems.PostScore, 0) > 5
          AND (pems.PostTags LIKE '%<sql>%' OR pems.PostTags LIKE '%<postgresql>%' OR pems.PostTags LIKE '%<database>%')
    ) AS HighScoreSqlQuestionSum,
    -- Subquery using a set operator to find posts that were either closed or deleted, and link them to user stats
    (
        SELECT COUNT(DISTINCT ClosedOrDeletedPosts.PostId)
        FROM (
            SELECT ph.PostId
            FROM PostHistory ph
            WHERE ph.PostHistoryTypeId = 10 -- Post Closed
            UNION ALL
            SELECT ph.PostId
            FROM PostHistory ph
            WHERE ph.PostHistoryTypeId = 12 -- Post Deleted
        ) AS ClosedOrDeletedPosts
        JOIN Posts p ON ClosedOrDeletedPosts.PostId = p.Id
        WHERE p.OwnerUserId = uas.UserId
    ) AS UserClosedOrDeletedPostCount,
    -- Aggregated stats from PostEditAndModerationStats for posts owned by the user
    SUM(COALESCE(pems_main.EditCount, 0)) AS TotalEditsOnOwnedPosts,
    AVG(COALESCE(pems_main.CloseVotesCount, 0)) AS AvgCloseVotesOnOwnedPosts,
    SUM(CASE WHEN pems_main.AcceptedAnswerId IS NOT NULL AND pems_main.PostTypeId = 1 THEN 1 ELSE 0 END) AS QuestionsWithAcceptedAnswers,
    -- String expression for tags, checking if a user has contributed to specific tag categories
    STRING_AGG(DISTINCT SUBSTRING(t.TagName, 1, 10), ', ') FILTER (WHERE t.TagName IN ('sql', 'postgresql', 'database', 'javascript', 'python')) AS TopCategoryTagsContributed,
    -- Aggregate related post tags via PostLinkAnalysis
    STRING_AGG(DISTINCT pla_main.AllRelatedTags, '; ') FILTER (WHERE pla_main.AllRelatedTags IS NOT NULL) AS AllRelatedPostTagsSummary,
    -- Complex predicate: filter users with high engagement score who also have posts edited frequently
    SUM(CASE WHEN COALESCE(pems_main.EditCount, 0) > 5 THEN 1 ELSE 0 END) AS HighlyEditedOwnedPostsCount,
    -- Conditional string output based on badge achievements and overall activity
    CASE
        WHEN COALESCE(ubs.GoldBadges, 0) > 2 THEN 'Elite Member'
        WHEN COALESCE(ubs.SilverBadges, 0) > 5 AND COALESCE(uas.TotalQuestions, 0) > 20 THEN 'Distinguished Contributor'
        WHEN COALESCE(ubs.TotalBadges, 0) > 10 OR COALESCE(uas.TotalComments, 0) > 50 THEN 'Active Participant'
        ELSE 'Casual User'
    END AS UserTier
FROM UserActivitySummary uas
LEFT JOIN UserBadgeSummary ubs ON uas.UserId = ubs.UserId
LEFT JOIN UserVoteAnalysis uva ON uas.UserId = uva.UserId
LEFT JOIN PostEditAndModerationStats pems_main ON uas.UserId = pems_main.OwnerUserId
LEFT JOIN PostLinkAnalysis pla_main ON pems_main.PostId = pla_main.PostId -- Joining PostLinkAnalysis
-- Lateral unnest for tags owned by the user, for TopCategoryTagsContributed
LEFT JOIN LATERAL UNNEST(string_to_array(SUBSTRING(pems_main.PostTags, 2, LENGTH(pems_main.PostTags) - 2), '><')) AS post_tag_name ON TRUE
LEFT JOIN Tags t ON t.TagName = post_tag_name
WHERE
    uas.Reputation > 500
    AND uas.TotalPosts > 10
    AND uas.UserCreationDate >= '2015-01-01'
    AND (uas.UserLocation ILIKE '%usa%' OR uas.UserLocation ILIKE '%canada%' OR uas.UserLocation IS NULL) -- NULL logic in predicate
GROUP BY
    uas.UserId, uas.DisplayName, uas.Reputation, uas.UserCreationDate, uas.UserProfileViews,
    uas.TotalQuestions, uas.TotalAnswers, uas.AveragePostScore, uas.TotalComments,
    ubs.GoldBadges, ubs.SilverBadges, ubs.BronzeBadges, uva.UpVotesGiven, uva.DownVotesGiven,
    uas.UserLocation, uas.WebsiteUrl
ORDER BY
    UserEngagementScore DESC, ReputationDecile ASC
LIMIT 100;