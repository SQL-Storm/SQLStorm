-- {"query": "1906.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gemini-2.5-flash", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2111, "output_tokens": 3142} 
WITH UserEngagement AS (
    -- CTE 1: Summarizes user activity, including post types, comment counts, badge classes, and reputation trends.
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate,
        COUNT(DISTINCT P_Q.Id) AS TotalQuestionsPosted,
        COUNT(DISTINCT P_A.Id) AS TotalAnswersPosted,
        COUNT(DISTINCT C.Id) AS TotalCommentsMade,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        SUM(CASE WHEN B.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
        SUM(CASE WHEN B.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
        MAX(P_Q.CreationDate) AS LatestQuestionDate,
        MAX(P_A.CreationDate) AS LatestAnswerDate,
        COALESCE(SUM(P_Q.ViewCount), 0) + COALESCE(SUM(P_A.ViewCount), 0) AS TotalPostViewsOwned,
        COALESCE(SUM(P_Q.Score), 0) + COALESCE(SUM(P_A.Score), 0) AS TotalPostScoreOwned,
        (EXTRACT(EPOCH FROM (U.LastAccessDate - U.CreationDate)) / (3600 * 24 * 365.25)) AS AccountAgeYears,
        U.UpVotes AS TotalUpVotesGiven,
        U.DownVotes AS TotalDownVotesGiven,
        (SELECT COUNT(V.Id) FROM Votes AS V WHERE V.UserId = U.Id AND V.VoteTypeId = 5) AS TotalFavoritesMade -- Correlated subquery for a specific vote type
    FROM
        Users AS U
    LEFT JOIN
        Posts AS P_Q ON U.Id = P_Q.OwnerUserId AND P_Q.PostTypeId = 1 -- Questions
    LEFT JOIN
        Posts AS P_A ON U.Id = P_A.OwnerUserId AND P_A.PostTypeId = 2 -- Answers
    LEFT JOIN
        Comments AS C ON U.Id = C.UserId
    LEFT JOIN
        Badges AS B ON U.Id = B.UserId
    WHERE
        U.Reputation > 5000 AND U.LastAccessDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year')
        AND U.Location IS NOT NULL
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate, U.UpVotes, U.DownVotes
),
QuestionPerformance AS (
    -- CTE 2: Analyzes question performance, including accepted answer details, tags, view/score quartiles, and editor activity.
    SELECT
        Q.Id AS QuestionId,
        Q.Title,
        Q.CreationDate AS QuestionCreationDate,
        Q.ViewCount,
        Q.Score AS QuestionScore,
        Q.OwnerUserId,
        Q.AnswerCount,
        Q.FavoriteCount,
        Q.ClosedDate,
        Q.Tags,
        A.Id AS AcceptedAnswerId,
        A.CreationDate AS AcceptedAnswerCreationDate,
        A.Score AS AcceptedAnswerScore,
        A.OwnerUserId AS AcceptedAnswerOwnerId,
        (EXTRACT(EPOCH FROM (A.CreationDate - Q.CreationDate)) / 3600.0) AS TimeToAcceptedAnswerHours,
        COALESCE(Q.FavoriteCount, 0) / NULLIF(Q.ViewCount, 0) AS FavoriteRate,
        NTILE(4) OVER (ORDER BY Q.ViewCount DESC) AS ViewCountQuartile,
        ROW_NUMBER() OVER (PARTITION BY Q.OwnerUserId ORDER BY Q.Score DESC, Q.CreationDate DESC) AS UserTopScoringQuestionRank,
        STRING_TO_ARRAY(SUBSTRING(Q.Tags, 2, LENGTH(Q.Tags) - 2), '><') AS TagArray,
        Q.LastEditDate,
        Q.LastEditorUserId,
        U_EDITOR.DisplayName AS LastEditorDisplayName,
        (SELECT COUNT(DISTINCT PH.Id) FROM PostHistory AS PH WHERE PH.PostId = Q.Id AND PH.PostHistoryTypeId IN (4,5,6)) AS TotalEditEvents,
        (SELECT MAX(PH.CreationDate) FROM PostHistory AS PH WHERE PH.PostId = Q.Id AND PH.PostHistoryTypeId = 10) AS LastClosureEventDate
    FROM
        Posts AS Q
    LEFT JOIN
        Posts AS A ON Q.AcceptedAnswerId = A.Id AND A.PostTypeId = 2
    LEFT JOIN
        Users AS U_EDITOR ON Q.LastEditorUserId = U_EDITOR.Id
    WHERE
        Q.PostTypeId = 1
        AND Q.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '3 years')
        AND Q.ViewCount > 1000
        AND Q.Score >= 10
),
PostHistoryTimeline AS (
    -- CTE 3: Examines post history for specific events, calculating time differences between them.
    SELECT
        PH.PostId,
        PH.PostHistoryTypeId,
        PHT.Name AS HistoryTypeName,
        PH.CreationDate AS HistoryDate,
        PH.UserId AS EditorUserId,
        PH.Comment AS HistoryComment,
        PH.Text AS HistoryText,
        LAG(PH.CreationDate, 1, PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PreviousHistoryDate,
        EXTRACT(EPOCH FROM (PH.CreationDate - LAG(PH.CreationDate, 1, PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate))) / 3600.0 AS HoursSincePreviousEdit,
        CASE WHEN PH.PostHistoryTypeId IN (5, 8) THEN LENGTH(PH.Text) - LENGTH(LAG(PH.Text, 1, '')) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) ELSE 0 END AS BodyTextChangeDelta
    FROM
        PostHistory AS PH
    JOIN
        PostHistoryTypes AS PHT ON PH.PostHistoryTypeId = PHT.Id
    WHERE
        PH.PostHistoryTypeId IN (1, 2, 5, 8, 10, 11, 12, 13) -- Initial Title/Body, Edit Body, Rollback Body, Closed, Reopened, Deleted, Undeleted
        AND PH.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '5 years')
),
DuplicatedPostDetails AS (
    -- CTE 4: Identifies questions that are duplicates and links to their original questions, including creation date difference.
    SELECT
        PL.PostId AS DuplicateQuestionId,
        PL.RelatedPostId AS OriginalQuestionId,
        Q_DUP.Title AS DuplicateTitle,
        Q_ORIG.Title AS OriginalTitle,
        Q_DUP.CreationDate AS DuplicateCreationDate,
        Q_ORIG.CreationDate AS OriginalCreationDate,
        (EXTRACT(EPOCH FROM (Q_DUP.CreationDate - Q_ORIG.CreationDate)) / (3600 * 24)) AS DaysBeforeDuplicated
    FROM
        PostLinks AS PL
    JOIN
        LinkTypes AS LT ON PL.LinkTypeId = LT.Id
    JOIN
        Posts AS Q_DUP ON PL.PostId = Q_DUP.Id AND Q_DUP.PostTypeId = 1
    JOIN
        Posts AS Q_ORIG ON PL.RelatedPostId = Q_ORIG.Id AND Q_ORIG.PostTypeId = 1
    WHERE
        LT.Name = 'Duplicate'
        AND Q_DUP.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '7 years')
)
-- Main query combining results from CTEs with additional filtering, string functions, and NULL handling
SELECT
    UE.UserId,
    UE.DisplayName,
    UE.Reputation,
    UE.TotalQuestionsPosted,
    UE.TotalAnswersPosted,
    UE.GoldBadges,
    UE.SilverBadges,
    UE.TotalPostViewsOwned,
    UE.AccountAgeYears,
    UE.TotalFavoritesMade,
    QP.QuestionId,
    QP.Title AS QuestionTitle,
    QP.QuestionCreationDate,
    QP.ViewCount,
    QP.QuestionScore,
    QP.AcceptedAnswerId,
    QP.TimeToAcceptedAnswerHours,
    QP.FavoriteRate,
    QP.ViewCountQuartile,
    QP.UserTopScoringQuestionRank,
    QP.LastEditorDisplayName,
    COALESCE(PH_LAT.HistoryTypeName, 'No Recent History') AS LastRelevantHistoryType,
    PH_LAT.HistoryDate AS LastHistoryDate,
    PH_LAT.HoursSincePreviousEdit,
    PH_LAT.BodyTextChangeDelta,
    DPT.OriginalQuestionId,
    DPT.OriginalTitle,
    DPT.DaysBeforeDuplicated,
    (SELECT AVG(C.Score) FROM Comments AS C WHERE C.PostId = QP.QuestionId AND C.CreationDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year')) AS AvgRecentCommentScoreOnQuestion,
    EXISTS (SELECT 1 FROM PostHistory AS PH_sub WHERE PH_sub.PostId = QP.QuestionId AND PH_sub.PostHistoryTypeId = 8 AND PH_sub.UserId = UE.UserId) AS OwnerInitiatedRollback,
    STRING_AGG(DISTINCT T.TagName, ', ') FILTER (WHERE T.TagName LIKE '%api%' OR T.TagName LIKE '%web%') AS RelatedWebAPITags,
    'https://stackoverflow.com/questions/' || QP.QuestionId AS QuestionURL,
    CASE
        WHEN QP.ClosedDate IS NOT NULL THEN 'Closed'
        WHEN DPT.DuplicateQuestionId IS NOT NULL THEN 'Duplicate_Detected'
        WHEN QP.AcceptedAnswerId IS NOT NULL AND QP.TimeToAcceptedAnswerHours < 24 THEN 'Quickly_Answered_And_Accepted'
        WHEN QP.TotalEditEvents >= 5 AND PH_LAT.BodyTextChangeDelta > 100 THEN 'Heavily_Edited_Content'
        ELSE 'Standard_Open_Question'
    END AS QuestionLifecycleStatus,
    COALESCE(NULLIF(UE.TotalQuestionsPosted + UE.TotalAnswersPosted, 0), 1.0) AS TotalPostsRatioDenominator,
    (UE.TotalCommentsMade * 1.0) / COALESCE(NULLIF(UE.TotalQuestionsPosted + UE.TotalAnswersPosted, 0), 1.0) AS CommentPerPostRatio,
    (UE.Reputation * 1.0) / COALESCE(NULLIF(UE.AccountAgeYears, 0), 1.0) AS ReputationPerYear
FROM
    UserEngagement AS UE
INNER JOIN
    QuestionPerformance AS QP ON UE.UserId = QP.OwnerUserId
LEFT JOIN LATERAL ( -- Lateral join to get the most recent relevant history event for a post
    SELECT PHTL.*
    FROM PostHistoryTimeline AS PHTL
    WHERE PHTL.PostId = QP.QuestionId AND PHTL.HistoryDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '2 years')
    ORDER BY PHTL.HistoryDate DESC
    LIMIT 1
) AS PH_LAT ON TRUE
LEFT JOIN
    DuplicatedPostDetails AS DPT ON QP.QuestionId = DPT.DuplicateQuestionId
LEFT JOIN
    Tags AS T ON T.TagName = ANY(QP.TagArray)
WHERE
    QP.QuestionScore >= 100
    AND (QP.TimeToAcceptedAnswerHours IS NULL OR QP.TimeToAcceptedAnswerHours <= 168.0) -- Accepted within 7 days or no accepted answer
    AND (
        QP.Tags ILIKE '%<python>%' OR
        QP.Tags ILIKE '%<javascript>%' OR
        QP.Tags ILIKE '%<java>%' OR
        QP.Tags ILIKE '%<c#>%' OR
        QP.Tags ILIKE '%<php>%'
    )
    AND (QP.ClosedDate IS NULL OR QP.LastClosureEventDate >= (cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year')) -- Include recently closed questions
    AND NOT EXISTS (SELECT 1 FROM PostHistory AS PH_del WHERE PH_del.PostId = QP.QuestionId AND PH_del.PostHistoryTypeId = 12) -- Exclude deleted questions
GROUP BY
    UE.UserId, UE.DisplayName, UE.Reputation, UE.TotalQuestionsPosted, UE.TotalAnswersPosted, UE.GoldBadges, UE.SilverBadges, UE.TotalPostViewsOwned, UE.AccountAgeYears, UE.TotalFavoritesMade,
    QP.QuestionId, QP.Title, QP.QuestionCreationDate, QP.ViewCount, QP.QuestionScore, QP.AcceptedAnswerId, QP.TimeToAcceptedAnswerHours,
    QP.FavoriteRate, QP.ViewCountQuartile, QP.UserTopScoringQuestionRank, QP.LastEditorDisplayName, QP.Tags, QP.ClosedDate, QP.TotalEditEvents, QP.LastClosureEventDate,
    PH_LAT.HistoryTypeName, PH_LAT.HistoryDate, PH_LAT.HoursSincePreviousEdit, PH_LAT.BodyTextChangeDelta, DPT.OriginalQuestionId, DPT.OriginalTitle, DPT.DaysBeforeDuplicated
HAVING
    COUNT(DISTINCT T.TagName) >= 2 -- At least two distinct tags from the TagArray must be present in the Tags table, contributing to `RelatedWebAPITags`
    OR UE.TotalCommentsMade > 50
ORDER BY
    UE.Reputation DESC, QP.ViewCount DESC, QP.QuestionCreationDate DESC, QP.QuestionScore DESC
LIMIT 1000;