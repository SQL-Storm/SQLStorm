-- {"query": "5285.sql", "dataset": "stackoverflow", "version": "v2.0", "prompt": "p1", "model": "gpt-5-nano", "temperature": 1.0, "max_tokens": 16384, "reasoning": "minimal", "input_tokens": 2026, "output_tokens": 856} 
WITH top_posts AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Score,
    p.ViewCount,
    p.CreationDate,
    p.LastActivityDate,
    p.Tags,
    p.OwnerUserId,
    p.OwnerDisplayName,
    p.PostTypeId,
    p.ParentId,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.ContentLicense
  FROM Posts p
  WHERE p.PostTypeId = 1 -- Questions
),
recent_user_activity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate AS UserCreationDate,
    u.LastAccessDate,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.Location,
    u.WebsiteUrl,
    u.AboutMe,
    COALESCE(b.TotalBadges, 0) AS BadgeCount
  FROM Users u
  LEFT JOIN (
    SELECT UserId, COUNT(*) AS TotalBadges
    FROM Badges
    GROUP BY UserId
  ) b ON b.UserId = u.Id
),
complex_joins AS (
  SELECT
    tp.PostId,
    tp.Title,
    tp.Score,
    tp.ViewCount,
    tp.Tags,
    tp.OwnerUserId,
    tp.OwnerDisplayName,
    vt.VoteCounts,
    cl.Name AS CloseReason,
    lf.RelatedPostId AS LinkedWith,
    ln.Name AS LinkedType
  FROM top_posts tp
  LEFT JOIN (
    SELECT PostId, SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS Upvotes,
                   SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS Downvotes,
                   SUM(CASE WHEN VoteTypeId = 10 THEN 1 ELSE 0 END) AS Deletions
    FROM Votes
    GROUP BY PostId
  ) vt ON vt.PostId = tp.PostId
  LEFT JOIN PostHistory ph ON ph.PostId = tp.PostId AND ph.PostHistoryTypeId = 10
  LEFT JOIN CloseReasonTypes cl ON cl.Id = CAST(COALESCE(ph.Comment, NULL) AS int)
  LEFT JOIN PostLinks lf ON lf.PostId = tp.PostId
  LEFT JOIN Posts ln ON ln.Id = lf.RelatedPostId
  WHERE tp.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
)
SELECT
  rp.PostId,
  rp.Title,
  rp.Score,
  rp.ViewCount,
  rp.Tags,
  rp.OwnerUserId,
  rp.OwnerDisplayName,
  fu.DisplayName AS LastEditor,
  fu.Reputation AS EditorReputation,
  fu.LastAccessDate AS EditorLastActivity,
  rc.CloseReason,
  (rp.Score::float / NULLIF(rp.ViewCount,0)) AS ScorePerView,
  ARRAY_AGG(DISTINCT ln.Name) FILTER (WHERE ln.Name IS NOT NULL) AS LinkedTypes,
  ARRAY_AGG(DISTINCT l.Name) FILTER (WHERE l.Name IS NOT NULL) AS LinkTypesUsed,
  cu.BadgeCount AS OwnerBadgeCount,
  ROW_NUMBER() OVER (PARTITION BY rp.OwnerUserId ORDER BY rp.LastActivityDate DESC) AS rn
FROM complex_joins rp
LEFT JOIN Votes v ON v.PostId = rp.PostId AND v.VoteTypeId = 2
LEFT JOIN Users fu ON fu.Id = rp.OwnerUserId
LEFT JOIN recent_user_activity cu ON cu.UserId = rp.OwnerUserId
LEFT JOIN PostLinks l ON l.PostId = rp.PostId
LEFT JOIN LinkTypes ltype ON ltype.Id = l.LinkTypeId
LEFT JOIN Posts ln ON ln.Id = l.RelatedPostId
GROUP BY
  rp.PostId, rp.Title, rp.Score, rp.ViewCount, rp.Tags, rp.OwnerUserId, rp.OwnerDisplayName,
  fu.DisplayName, fu.Reputation, fu.LastAccessDate, rc.CloseReason
ORDER BY rp.LastActivityDate DESC, rp.Score DESC
LIMIT 100;