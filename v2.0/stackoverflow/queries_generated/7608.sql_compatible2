  ua.QuestionWithCommentsRate,
  ua.AvgPostViews,
  ua.AvgPostScore,
  ua.AvgAnswersPerQuestion,
  ua.AvgCommentsPerPost,
  ua.AvgFavoritesPerPost,
  ua.EditedRatio,
  ua.ClosedRatio,
  ua.DaysSinceLastAccess,
  CASE WHEN pa.TagArray IS NOT NULL THEN 1 ELSE 0 END AS HasTags,
  CASE WHEN pa.Tags_groupby IS NOT NULL THEN CARDINALITY(pa.TagArray_groupby) ELSE 0 END AS TagArrayLength,
  CASE WHEN pa.MaxAnswerScore IS NOT NULL THEN 1 ELSE 0 END AS HasAnswerScores,
  CASE WHEN pa.TopAnswerUserId IS NOT NULL THEN 1 ELSE 0 END AS HasTopAnswer,
  CASE WHEN pa.ParentQuestionTitle IS NOT NULL THEN 1 ELSE 0 END AS HasParentTitle,
  CASE WHEN pa.DuplicateCount > 0 THEN 1 ELSE 0 END AS IsDuplicate,
  CASE WHEN pa.DuplicatedCount > 0 THEN 1 ELSE 0 END AS IsDuplicated,
  CASE WHEN pa.GreatBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasGreatBadges,
  CASE WHEN pa.GreatAnswerBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasGreatAnswerBadges,
  CASE WHEN pa.AnswererBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasAnswererBadges,
  CASE WHEN pa.QuestionAnswererBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasQuestionAnswererBadges,
  CASE WHEN pa.PopularQuestionBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasPopularQuestionBadges,
  CASE WHEN pa.NotableQuestionBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasNotableQuestionBadges,
  CASE WHEN pa.FamousQuestionBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasFamousQuestionBadges,
  CASE WHEN pa.StellarQuestionBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasStellarQuestionBadges,
  CASE WHEN pa.SelfLearnerBadgesInLastYear > 0 THEN 1 ELSE 0 END AS HasSelfLearnerBadges,
  COALESCE(pa.AnswerCountForQuestion, 0) * COALESCE(pa.UpVotesForQuestion, 0) + 
  COALESCE(pa.CommentCountForQuestion, 0) * COALESCE(pa.Score, 0) AS ComplexEngagementMetric,
  (COALESCE(pa.TagCount, 0) + COALESCE(pa.VoteCount, 0) + COALESCE(pa.ViewCount, 0)) * 
  COALESCE(pa.Score, 0) AS WeightedMetric,
  CASE 
    WHEN pa.ScorePercentile >= 90 THEN 'Top 10%'
    WHEN pa.ScorePercentile >= 70 THEN 'Top 30%'
    WHEN pa.ScorePercentile >= 50 THEN 'Top 50%'
    WHEN pa.ScorePercentile >= 30 THEN 'Top 70%'
    ELSE 'Bottom 30%'
  END AS ScorePercentileCategory,
  CASE 
    WHEN pa.VoteCount >= 100 THEN 'Highly Voted'
    WHEN pa.VoteCount >= 50 THEN 'Moderately Voted'
    WHEN pa.VoteCount >= 10 THEN 'Low Voted'
    ELSE 'Very Low Voted'
  END AS VoteCategory,
  CASE 
    WHEN pa.ViewCount >= 1000 THEN 'Highly Viewed'
    WHEN pa.ViewCount >= 100 THEN 'Moderately Viewed'
    WHEN pa.ViewCount >= 10 THEN 'Low Viewed'
    ELSE 'Very Low Viewed'
  END AS ViewCategory,
  CASE 
    WHEN pa.Score > 0 THEN 'Positive Score'
    WHEN pa.Score < 0 THEN 'Negative Score'
    ELSE 'Zero Score'
  END AS ScoreCategory,
  CASE 
    WHEN pa.DaysActive >= 365 THEN 'Yearly Active'
    WHEN pa.DaysActive >= 90 THEN 'Quarterly Active'
    WHEN pa.DaysActive >= 30 THEN 'Monthly Active'
    WHEN pa.DaysActive >= 7 THEN 'Weekly Active'
    ELSE 'Daily Active'
  END AS ActivityCategory,
  CASE 
    WHEN pa.TagCount >= 5 THEN 'High Tag Count'
    WHEN pa.TagCount >= 3 THEN 'Medium Tag Count'
    WHEN pa.TagCount >= 1 THEN 'Low Tag Count'
    ELSE 'No Tags'
  END AS TagCategory,
  CASE 
    WHEN pa.NetUserReputation > 10000 THEN 'Expert'
    WHEN pa.NetUserReputation > 1000 THEN 'Intermediate'
    WHEN pa.NetUserReputation > 100 THEN 'Beginner'
    ELSE 'Novice'
  END AS ReputationCategory,
  COALESCE(SUBSTRING(pa.ParentQuestionTitle FROM 1 FOR 50), 'N/A') || ' - ' || 
  COALESCE(CAST(pa.AnswerCountForQuestion AS VARCHAR(10)), '0') || ' answers' AS QuestionSummary
FROM PostAggregates pa
LEFT JOIN UserActivity ua ON pa.OwnerReputationWeighted IS NOT NULL AND pa.OwnerReputationWeighted <> 0 AND pa.OwnerDisplayName = ua.DisplayName
WHERE pa.Id IS NOT NULL
  AND (pa.Score > 0 OR pa.ViewCount > 0 OR pa.VoteCount > 0 OR pa.AnswerCount > 0 OR pa.CommentCount > 0)
  AND pa.PostStatus != 'Closed'
  AND pa.TemporalCategory IN ('Recent', 'Last Month', 'Last Quarter')
  AND (pa.TagCount >= 1 OR pa.Score > 5 OR pa.ViewCount > 100 OR pa.VoteCount > 10)
ORDER BY pa.Score DESC, pa.ViewCount DESC, pa.VoteCount DESC, pa.AnswerCount DESC, pa.CommentCount DESC
OFFSET 0
FETCH NEXT 1000 ROWS ONLY;