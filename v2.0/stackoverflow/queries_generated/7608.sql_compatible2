WITH PostStats AS (
  SELECT 
    p.Id,
    p.PostTypeId,
    p.Score,
    p.ViewCount,
    p.AnswerCount,
    p.CommentCount,
    p.FavoriteCount,
    p.CreationDate,
    p.OwnerUserId,
    p.ParentId,
    p.Title,
    p.Tags,
    p.Body,
    p.LastEditDate,
    p.LastActivityDate,
    p.ClosedDate,
    CAST(
      (EXTRACT(EPOCH FROM (COALESCE(p.LastActivityDate, p.CreationDate) - p.CreationDate)) / 86400)
      AS INTEGER
    ) AS DaysActive,
    CASE WHEN p.Score > 0 THEN p.Score ELSE 0 END AS PositiveScore,
    CASE WHEN p.Score < 0 THEN ABS(p.Score) ELSE 0 END AS NegativeScore,
    COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) AS EngagementCount,
    CASE 
      WHEN p.PostTypeId = 1 THEN 'Question'
      WHEN p.PostTypeId = 2 THEN 'Answer'
      ELSE 'Other'
    END AS PostTypeDesc,
    CASE 
      WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
      WHEN p.CommunityOwnedDate IS NOT NULL THEN 'Community Owned'
      ELSE 'Open'
    END AS PostStatus,
    COUNT(v.Id) OVER (PARTITION BY p.Id) AS VoteCount,
    SUM(CASE WHEN v.VoteTypeId IN (2,3) THEN 1 ELSE 0 END) OVER (PARTITION BY p.Id) AS VoteActivity,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS UserPostRank,
    ROW_NUMBER() OVER (ORDER BY p.Score DESC, p.ViewCount DESC) AS GlobalRank,
    LAG(p.Score) OVER (ORDER BY p.CreationDate) AS PrevScore,
    LEAD(p.Score) OVER (ORDER BY p.CreationDate) AS NextScore,
    AVG(p.Score) OVER (ORDER BY p.CreationDate ROWS BETWEEN 5 PRECEDING AND 5 FOLLOWING) AS MovingAverageScore,
    NTILE(100) OVER (ORDER BY p.Score DESC) AS ScorePercentile,
    RANK() OVER (ORDER BY p.Score DESC) AS ScoreRank,
    DENSE_RANK() OVER (ORDER BY p.Score DESC) AS DenseScoreRank,
    CAST(
      (EXTRACT(EPOCH FROM (p.LastEditDate - p.CreationDate)) / 86400)
      AS INTEGER
    ) AS DaysSinceLastEdit,
    CASE 
      WHEN p.Tags IS NOT NULL AND LENGTH(p.Tags) > 0 THEN 
        (CARDINALITY(string_to_array(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><')) - 1)
      ELSE 0 
    END AS TagCount,
    CASE 
      WHEN p.OwnerUserId IS NOT NULL AND p.OwnerUserId > 0 THEN u.Reputation * 10 
      ELSE 0 
    END AS OwnerReputationWeighted,
    CASE 
      WHEN p.OwnerUserId IS NULL OR p.OwnerUserId <= 0 THEN 'Deleted User'
      ELSE COALESCE(u.DisplayName, 'Unknown')
    END AS OwnerDisplayName,
    CASE 
      WHEN p.ParentId IS NOT NULL THEN 'Answer'
      ELSE 'Question'
    END AS IsAnswer,
    CASE 
      WHEN p.PostTypeId = 1 AND p.AnswerCount > 0 THEN TRUE
      ELSE FALSE 
    END AS HasAnswers,
    COALESCE(u.UpVotes, 0) - COALESCE(u.DownVotes, 0) AS NetUserReputation,
    CASE 
      WHEN p.Title IS NOT NULL AND LENGTH(p.Title) > 0 THEN LENGTH(p.Title) 
      ELSE 0 
    END AS TitleLength,
    CASE 
      WHEN p.Body IS NOT NULL AND LENGTH(p.Body) > 0 THEN LENGTH(p.Body) 
      ELSE 0 
    END AS BodyLength,
    CASE 
      WHEN p.Tags IS NOT NULL AND LENGTH(p.Tags) > 0 THEN 
        SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2)
      ELSE '' 
    END AS CleanTags,
    CASE 
      WHEN p.Tags IS NOT NULL AND LENGTH(p.Tags) > 0 AND p.PostTypeId = 1 THEN 
        string_to_array(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags)-2), '><')
      ELSE ARRAY[]::text[]
    END AS TagArray,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Posts WHERE ParentId = p.Id AND PostTypeId = 2)
      ELSE 0
    END AS AnswerCountForQuestion,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Comments WHERE PostId = p.Id)
      ELSE 0
    END AS CommentCountForQuestion,
    CASE 
      WHEN p.PostTypeId = 2 THEN 
        (SELECT Title FROM Posts WHERE Id = p.ParentId)
      ELSE NULL
    END AS ParentQuestionTitle,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT UserId FROM Posts WHERE ParentId = p.Id AND PostTypeId = 2 ORDER BY Score DESC LIMIT 1)
      ELSE NULL
    END AS TopAnswerUserId,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT MAX(Score) FROM Posts WHERE ParentId = p.Id AND PostTypeId = 2)
      ELSE NULL
    END AS MaxAnswerScore,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT AVG(Score) FROM Posts WHERE ParentId = p.Id AND PostTypeId = 2)
      ELSE NULL
    END AS AvgAnswerScore,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Votes WHERE PostId = p.Id AND VoteTypeId IN (2,3))
      ELSE NULL
    END AS UpVotesForQuestion,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Votes WHERE PostId = p.Id AND VoteTypeId = 1) 
      ELSE NULL
    END AS AcceptedAnswerCount,
    CASE 
      WHEN p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '7 days') THEN 'Recent'
      WHEN p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '30 days') THEN 'Last Month'
      WHEN p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 days') THEN 'Last Quarter'
      ELSE 'Older'
    END AS TemporalCategory,
    COALESCE(u.ViewCount, 0) AS UserViewCount,
    CASE 
      WHEN p.OwnerUserId IS NOT NULL AND p.OwnerUserId > 0 THEN 
        (SELECT COUNT(*) FROM Posts WHERE OwnerUserId = p.OwnerUserId AND PostTypeId IN (1,2) AND CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0 
    END AS PostsInLastYear,
    CASE 
      WHEN p.OwnerUserId IS NOT NULL AND p.OwnerUserId > 0 THEN 
        (SELECT COUNT(*) FROM Comments WHERE UserId = p.OwnerUserId AND CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0 
    END AS CommentsInLastYear,
    CASE 
      WHEN p.OwnerUserId IS NOT NULL AND p.OwnerUserId > 0 THEN 
        (SELECT COUNT(*) FROM Votes WHERE UserId = p.OwnerUserId AND VoteTypeId IN (2,3) AND CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0 
    END AS VotesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM PostHistory WHERE PostId = p.Id AND PostHistoryTypeId IN (4,5,6) AND CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS EditsInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(DISTINCT UserId) FROM Votes WHERE PostId = p.Id AND VoteTypeId IN (2,3) AND UserId IS NOT NULL)
      ELSE 0
    END AS VotersCount,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM PostHistory WHERE PostId = p.Id AND PostHistoryTypeId = 10 AND CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS CloseVotesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM PostHistory WHERE PostId = p.Id AND PostHistoryTypeId = 35 AND CreationDate >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS MigrationsInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM PostLinks WHERE PostId = p.Id AND LinkTypeId = 3)
      ELSE 0
    END AS DuplicateCount,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM PostLinks WHERE RelatedPostId = p.Id AND LinkTypeId = 3)
      ELSE 0
    END AS DuplicatedCount,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name IN ('Great Question', 'Good Question') AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS GreatBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name IN ('Great Answer', 'Good Answer') AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS GreatAnswerBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name = 'Answerer' AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS AnswererBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name = 'Question Answerer' AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS QuestionAnswererBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name = 'Popular Question' AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS PopularQuestionBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name = 'Notable Question' AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS NotableQuestionBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name = 'Famous Question' AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS FamousQuestionBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name = 'Stellar Question' AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS StellarQuestionBadgesInLastYear,
    CASE 
      WHEN p.PostTypeId = 1 THEN 
        (SELECT COUNT(*) FROM Badges WHERE UserId = p.OwnerUserId AND Name = 'Self-Learner' AND Date >= (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year'))
      ELSE 0
    END AS SelfLearnerBadgesInLastYear
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN Votes v ON p.Id = v.PostId
),
PostAggregates AS (
  SELECT 
    Id,
    PostTypeId,
    Score,
    ViewCount,
    AnswerCount,
    CommentCount,
    FavoriteCount,
    DaysActive,
    PositiveScore,
    NegativeScore,
    EngagementCount,
    PostTypeDesc,
    PostStatus,
    VoteCount,
    VoteActivity,
    UserPostRank,
    GlobalRank,
    PrevScore,
    NextScore,
    MovingAverageScore,
    ScorePercentile,
    ScoreRank,
    DenseScoreRank,
    DaysSinceLastEdit,
    TagCount,
    OwnerReputationWeighted,
    OwnerDisplayName,
    IsAnswer,
    HasAnswers,
    NetUserReputation,
    TitleLength,
    BodyLength,
    CleanTags,
    TagArray,
    AnswerCountForQuestion,
    CommentCountForQuestion,
    ParentQuestionTitle,
    TopAnswerUserId,
    MaxAnswerScore,
    AvgAnswerScore,
    UpVotesForQuestion,
    AcceptedAnswerCount,
    TemporalCategory,
    UserViewCount,
    PostsInLastYear,
    CommentsInLastYear,
    VotesInLastYear,
    EditsInLastYear,
    VotersCount,
    CloseVotesInLastYear,
    MigrationsInLastYear,
    DuplicateCount,
    DuplicatedCount,
    GreatBadgesInLastYear,
    GreatAnswerBadgesInLastYear,
    AnswererBadgesInLastYear,
    QuestionAnswererBadgesInLastYear,
    PopularQuestionBadgesInLastYear,
    NotableQuestionBadgesInLastYear,
    FamousQuestionBadgesInLastYear,
    StellarQuestionBadgesInLastYear,
    SelfLearnerBadgesInLastYear,
    COALESCE(AnswerCountForQuestion, 0) / NULLIF(COALESCE(CommentCountForQuestion, 1), 0) AS AnswerToCommentRatio,
    CASE 
      WHEN COALESCE(MaxAnswerScore, 0) > 0 THEN 
        (COALESCE(Score, 0) - COALESCE(MaxAnswerScore, 0)) / NULLIF(COALESCE(MaxAnswerScore, 1), 0)
      ELSE 0 
    END AS ScoreVsTopAnswer,
    CASE 
      WHEN COALESCE(UpVotesForQuestion, 0) > 0 THEN 
        COALESCE(UpVotesForQuestion, 0) / NULLIF(COALESCE(VoteCount, 1), 0) 
      ELSE 0 
    END AS UpVotePercentage,
    CASE 
      WHEN COALESCE(ClosedDate, CreationDate) > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year') THEN 1
      ELSE 0
    END AS RecentlyModified,
    CASE 
      WHEN COALESCE(AnswerCount, 0) > 0 THEN 
        COALESCE(Score, 0) / NULLIF(COALESCE(AnswerCount, 1), 0) 
      ELSE 0 
    END AS ScorePerAnswer,
    CASE 
      WHEN COALESCE(CommentCount, 0) > 0 THEN 
        COALESCE(Score, 0) / NULLIF(COALESCE(CommentCount, 1), 0) 
      ELSE 0 
    END AS ScorePerComment,
    CASE 
      WHEN COALESCE(ViewCount, 0) > 0 THEN 
        COALESCE(EngagementCount, 0) / NULLIF(COALESCE(ViewCount, 1), 0) 
      ELSE 0 
    END AS EngagementPerView,
    OwnerDisplayName AS OwnerDisplayName_groupby,
    TagArray AS TagArray_groupby,
    Tags AS Tags_groupby,
    Score AS Score_groupby,
    VoteCount AS VoteCount_groupby
  FROM PostStats
  GROUP BY
    Id, PostTypeId, Score, ViewCount, AnswerCount, CommentCount, FavoriteCount, DaysActive, PositiveScore, NegativeScore,
    EngagementCount, PostTypeDesc, PostStatus, VoteCount, VoteActivity, UserPostRank, GlobalRank, PrevScore, NextScore,
    MovingAverageScore, ScorePercentile, ScoreRank, DenseScoreRank, DaysSinceLastEdit, TagCount, OwnerReputationWeighted,
    OwnerDisplayName, IsAnswer, HasAnswers, NetUserReputation, TitleLength, BodyLength, CleanTags, TagArray, AnswerCountForQuestion,
    CommentCountForQuestion, ParentQuestionTitle, TopAnswerUserId, MaxAnswerScore, AvgAnswerScore, UpVotesForQuestion,
    AcceptedAnswerCount, TemporalCategory, UserViewCount, PostsInLastYear, CommentsInLastYear, VotesInLastYear,
    EditsInLastYear, VotersCount, CloseVotesInLastYear, MigrationsInLastYear, DuplicateCount, DuplicatedCount,
    GreatBadgesInLastYear, GreatAnswerBadgesInLastYear, AnswererBadgesInLastYear, QuestionAnswererBadgesInLastYear,
    PopularQuestionBadgesInLastYear, NotableQuestionBadgesInLastYear, FamousQuestionBadgesInLastYear,
    StellarQuestionBadgesInLastYear, SelfLearnerBadgesInLastYear, ClosedDate, CreationDate, OwnerDisplayName_groupby,
    TagArray_groupby, Tags_groupby, Score_groupby, VoteCount_groupby
),
UserActivity AS (
  SELECT 
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.CreationDate,
    COALESCE(COUNT(DISTINCT p.Id), 0) AS TotalPosts,
    COALESCE(COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END), 0) AS TotalQuestions,
    COALESCE(COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END), 0) AS TotalAnswers,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END), 0) AS TotalQuestionScore,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END), 0) AS TotalAnswerScore,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 1 THEN p.ViewCount ELSE 0 END), 0) AS TotalQuestionViews,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 2 THEN p.ViewCount ELSE 0 END), 0) AS TotalAnswerViews,
    COALESCE(COUNT(DISTINCT c.Id), 0) AS TotalComments,
    COALESCE(SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(v.Id), 0), 0) AS UpVoteRatio,
    COALESCE(COUNT(DISTINCT b.Id), 0) AS TotalBadges,
    COALESCE(SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END), 0) AS GoldBadges,
    COALESCE(SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END), 0) AS SilverBadges,
    COALESCE(SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END), 0) AS BronzeBadges,
    COALESCE(AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE NULL END), 0) AS AvgQuestionScore,
    COALESCE(AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE NULL END), 0) AS AvgAnswerScore,
    COALESCE(MIN(p.CreationDate), u.CreationDate) AS FirstPostDate,
    COALESCE(MAX(p.CreationDate), u.CreationDate) AS LastPostDate,
    CAST(
      (EXTRACT(EPOCH FROM (MAX(p.CreationDate) - MIN(p.CreationDate))) / 86400)
      AS INTEGER
    ) AS ActiveDays,
    COALESCE(SUM(CASE WHEN p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '1 year') THEN 1 ELSE 0 END), 0) AS RecentPosts,
    COALESCE(SUM(CASE WHEN p.CreationDate > (CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '6 months') THEN 1 ELSE 0 END), 0) AS RecentPosts6Months,
    100 * COALESCE(SUM(CASE WHEN p.PostTypeId = 1 AND p.Score > 0 THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END), 0), 0) AS PositiveQuestionRate,
    100 * COALESCE(SUM(CASE WHEN p.PostTypeId = 2 AND p.Score > 0 THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END), 0), 0) AS PositiveAnswerRate,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 1 AND p.AnswerCount > 0 THEN 1 ELSE 0 END), 0) * 1.0 / NULLIF(COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END), 0) AS QuestionWithAnswersRate,
    COALESCE(SUM(CASE WHEN p.PostTypeId = 1 AND p.CommentCount > 0 THEN 1 ELSE 0 END), 0) * 1.0 / NULLIF(COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END), 0) AS QuestionWithCommentsRate,
    COALESCE(SUM(p.ViewCount) * 1.0 / NULLIF(COUNT(p.Id), 0), 0) AS AvgPostViews,
    COALESCE(SUM(p.Score) * 1.0 / NULLIF(COUNT(p.Id), 0), 0) AS AvgPostScore,
    COALESCE(SUM(p.AnswerCount) * 1.0 / NULLIF(COUNT(p.Id), 0), 0) AS AvgAnswersPerQuestion,
    COALESCE(SUM(p.CommentCount) * 1.0 / NULLIF(COUNT(p.Id), 0), 0) AS AvgCommentsPerPost,
    COALESCE(SUM(p.FavoriteCount) * 1.0 / NULLIF(COUNT(p.Id), 0), 0) AS AvgFavoritesPerPost,
    COALESCE(SUM(CASE WHEN p.LastEditDate IS NOT NULL THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(p.Id), 0), 0) AS EditedRatio,
    COALESCE(SUM(CASE WHEN p.ClosedDate IS NOT NULL THEN 1 ELSE 0 END) * 1.0 / NULLIF(COUNT(p.Id), 0), 0) AS ClosedRatio,
    CAST(
      (EXTRACT(EPOCH FROM (u.LastAccessDate - u.CreationDate)) / 86400)
      AS INTEGER
    ) AS DaysSinceLastAccess
  FROM Users u
  LEFT JOIN Posts p ON u.Id = p.OwnerUserId
  LEFT JOIN Comments c ON u.Id = c.UserId
  LEFT JOIN Votes v ON u.Id = v.UserId
  LEFT JOIN Badges b ON u.Id = b.UserId
  GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.CreationDate, u.LastAccessDate
)
SELECT 
