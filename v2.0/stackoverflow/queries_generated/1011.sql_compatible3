WITH UserActivitySummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        COUNT(DISTINCT P.Id) AS TotalPosts,
        SUM(CASE WHEN P.PostTypeId = 1 THEN 1 ELSE 0 END) AS TotalQuestions,
        SUM(CASE WHEN P.PostTypeId = 2 THEN 1 ELSE 0 END) AS TotalAnswers,
        SUM(COALESCE(P.Score, 0)) AS TotalPostScore,
        AVG(COALESCE(P.Score, 0)) AS AvgPostScore,
        COUNT(DISTINCT C.Id) AS TotalComments,
        COUNT(DISTINCT CASE WHEN V.VoteTypeId = 2 THEN V.Id END) AS TotalUpvotesGiven,
        COUNT(DISTINCT B.Id) AS TotalBadges,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
        MAX(P.LastActivityDate) AS LastPostActivity
    FROM Users U
    LEFT JOIN Posts P ON U.Id = P.OwnerUserId
    LEFT JOIN Comments C ON U.Id = C.UserId
    LEFT JOIN Votes V ON U.Id = V.UserId
    LEFT JOIN Badges B ON U.Id = B.UserId
    GROUP BY U.Id, U.DisplayName, U.Reputation, U.CreationDate
    HAVING COUNT(P.Id) > 50 AND U.Reputation > 5000
),
PostEngagementMetrics AS (
    SELECT
        P.Id AS PostId,
        P.PostTypeId,
        P.OwnerUserId,
        P.Title,
        P.Tags,
        P.ParentId,
        P.CreationDate AS PostCreationDate,
        P.Score AS PostScore,
        P.ViewCount,
        COALESCE(P.AnswerCount, 0) AS AnswerCount,
        COALESCE(P.FavoriteCount, 0) AS FavoriteCount,
        (SELECT COUNT(*) FROM PostHistory PH WHERE PH.PostId = P.Id AND PH.PostHistoryTypeId IN (10, 11)) AS CloseReopenEvents,
        ROW_NUMBER() OVER (PARTITION BY P.OwnerUserId, P.PostTypeId ORDER BY P.Score DESC, COALESCE(P.ViewCount, 0) DESC) AS RnPerUserPostScore
    FROM Posts P
    WHERE P.PostTypeId IN (1, 2)
),
PostHistoryTrend AS (
    SELECT
        PH.PostId,
        PH.PostHistoryTypeId,
        PH.CreationDate AS HistoryDate,
        PH.UserId AS EditorUserId,
        PH.Text AS HistoryText,
        LAG(PH.CreationDate, 1, PH.CreationDate) OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate) AS PrevHistoryDate,
        ROW_NUMBER() OVER (PARTITION BY PH.PostId ORDER BY PH.CreationDate DESC) AS rn_latest_history
    FROM PostHistory PH
    WHERE PH.PostHistoryTypeId IN (5, 6, 10, 11)
),
HighImpactQuestions AS (
    SELECT
        UAS.DisplayName AS AuthorDisplayName,
        UAS.Reputation,
        UAS.GoldBadges,
        PEM.PostId,
        PEM.Title AS PostTitle,
        PEM.Tags AS PostTags,
        'Question' AS PostType,
        PEM.PostCreationDate,
        PEM.PostScore,
        PEM.ViewCount,
        PEM.AnswerCount,
        CAST(NULL AS INTEGER) AS ParentPostId,
        CAST(NULL AS VARCHAR(300)) AS ParentPostTitle,
        (SELECT AVG(A.Score) FROM Posts A WHERE A.ParentId = PEM.PostId AND A.PostTypeId = 2) AS AvgAnswerScore,
        (SELECT MAX(A.Score) FROM Posts A INNER JOIN Posts Q_inner ON A.Id = Q_inner.AcceptedAnswerId WHERE Q_inner.Id = PEM.PostId) AS AcceptedAnswerScore,
        (SELECT COUNT(C.Id) FROM Comments C WHERE C.PostId = PEM.PostId) AS PostCommentCount,
        PHT.HistoryDate AS LastEditOrCloseDate,
        PHT.PostHistoryTypeId AS LastHistoryEventType,
        EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS timestamp) - PEM.PostCreationDate)) AS PostAgeInDays,
        CASE
            WHEN PEM.PostScore > 100 AND PEM.AnswerCount > 5 THEN 'High-Impact Question'
            WHEN PEM.ViewCount > 10000 AND PEM.FavoriteCount > 50 THEN 'Highly Viewed & Favorited'
            WHEN (SELECT MAX(A.Score) FROM Posts A INNER JOIN Posts Q_inner ON A.Id = Q_inner.AcceptedAnswerId WHERE Q_inner.Id = PEM.PostId) IS NOT NULL
                 AND (SELECT MAX(A.Score) FROM Posts A INNER JOIN Posts Q_inner ON A.Id = Q_inner.AcceptedAnswerId WHERE Q_inner.Id = PEM.PostId) >= 50
                THEN 'Question with Stellar Accepted Answer'
            ELSE 'Standard Question'
        END AS PostImpactCategory,
        COALESCE(P.Body, 'No body content available') AS PostBodySample,
        CHAR_LENGTH(P.Body) AS BodyLength,
        (
            SELECT AVG(COALESCE(Vt.Value, Vt.Score))
            FROM Votes Vt
            WHERE Vt.PostId = PEM.PostId AND Vt.VoteTypeId = 2
        ) AS AverageUpvoteScoreForPost,
        (
            SELECT
                COUNT(DISTINCT B2.Id)
            FROM Badges B2
            WHERE B2.UserId = UAS.UserId
              AND B2.Class = 1
              AND EXISTS (
                    SELECT 1
                    FROM (
                        SELECT unnest(string_to_array(substring(PEM.Tags, 2, length(PEM.Tags)-2), '><')) AS TagName
                    ) AS PostTag
                    WHERE B2.Name = PostTag.TagName AND B2.TagBased = TRUE
                )
        ) AS GoldTagBadgesRelatedToPost,
        (SELECT MAX(C2.CreationDate) FROM Comments C2 WHERE C2.PostId = PEM.PostId) AS LatestPostCommentDate,
        PEM.CloseReopenEvents,
        PHT.PrevHistoryDate,
        EXTRACT(HOUR FROM (PHT.HistoryDate - PHT.PrevHistoryDate)) AS HoursSincePrevHistoryEvent,
        CASE WHEN PHT.PrevHistoryDate IS NOT NULL AND PHT.HistoryDate - PHT.PrevHistoryDate < INTERVAL '24 hour' THEN TRUE ELSE FALSE END AS RapidHistoryChange,
        (
            SELECT COALESCE(STRING_AGG(T.TagName, ', '), 'No Tags')
            FROM (
                SELECT unnest(string_to_array(substring(PEM.Tags, 2, length(PEM.Tags)-2), '><')) AS TagName
            ) AS Tag
            JOIN Tags T ON T.TagName = Tag.TagName
            WHERE T.IsModeratorOnly = TRUE
        ) AS ModeratorOnlyTags
    FROM UserActivitySummary UAS
    INNER JOIN PostEngagementMetrics PEM ON UAS.UserId = PEM.OwnerUserId
    INNER JOIN Posts P ON PEM.PostId = P.Id AND PEM.PostTypeId = 1
    LEFT JOIN PostHistoryTrend PHT ON PEM.PostId = PHT.PostId AND PHT.rn_latest_history = 1
    WHERE UAS.Reputation >= 10000
      AND PEM.RnPerUserPostScore <= 3
      AND (
            (LOWER(PEM.Title) LIKE '%api%' OR LOWER(PEM.Title) LIKE '%web service%')
            OR (PEM.Tags LIKE '%<json>%' OR PEM.Tags LIKE '%<rest>%')
          )
      AND NOT EXISTS (
            SELECT 1
            FROM PostHistory PH_closed
            WHERE PH_closed.PostId = PEM.PostId
              AND PH_closed.PostHistoryTypeId = 10
              AND PH_closed.CreationDate > CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '6 months'
              AND PH_closed.Comment IN ('101', '102')
        )
),
HighImpactAnswers AS (
    SELECT
        UAS.DisplayName AS AuthorDisplayName,
        UAS.Reputation,
        UAS.GoldBadges,
        PEM.PostId,
        CAST(NULL AS VARCHAR(300)) AS PostTitle,
        CAST(NULL AS VARCHAR(4000)) AS PostTags,
        'Answer' AS PostType,
        PEM.PostCreationDate,
        PEM.PostScore,
        PEM.ViewCount,
        CAST(NULL AS INTEGER) AS AnswerCount,
        PEM.ParentId AS ParentPostId,
        (SELECT Title FROM Posts WHERE Id = PEM.ParentId) AS ParentPostTitle,
        CAST(NULL AS NUMERIC) AS AvgAnswerScore,
        PEM.PostScore AS AcceptedAnswerScore,
        (SELECT COUNT(C.Id) FROM Comments C WHERE C.PostId = PEM.PostId) AS PostCommentCount,
        PHT.HistoryDate AS LastEditOrCloseDate,
        PHT.PostHistoryTypeId AS LastHistoryEventType,
        EXTRACT(DAY FROM (CAST('2024-10-01 12:34:56' AS timestamp) - PEM.PostCreationDate)) AS PostAgeInDays,
        CASE
            WHEN PEM.PostScore >= 75 THEN 'Exceptional Answer'
            WHEN PEM.PostScore >= 25 THEN 'High-Value Answer'
            ELSE 'Standard Answer'
        END AS PostImpactCategory,
        COALESCE(P.Body, 'No body content available') AS PostBodySample,
        CHAR_LENGTH(P.Body) AS BodyLength,
        (
            SELECT AVG(COALESCE(Vt2.Value, Vt2.Score))
            FROM Votes Vt2
            WHERE Vt2.PostId = PEM.PostId AND Vt2.VoteTypeId = 2
        ) AS AverageUpvoteScoreForPost,
        (
            SELECT
                COUNT(DISTINCT B3.Id)
            FROM Badges B3
            WHERE B3.UserId = UAS.UserId
              AND B3.Class = 1
              AND EXISTS (
                    SELECT 1
                    FROM Posts QP_inner
                    JOIN (
                        SELECT unnest(string_to_array(substring(QP_inner.Tags, 2, length(QP_inner.Tags)-2), '><')) AS TagName
                    ) AS PostTag ON TRUE
                    WHERE QP_inner.Id = PEM.ParentId AND B3.Name = PostTag.TagName AND B3.TagBased = TRUE
                )
        ) AS GoldTagBadgesRelatedToPost,
        (SELECT MAX(C3.CreationDate) FROM Comments C3 WHERE C3.PostId = PEM.PostId) AS LatestPostCommentDate,
        PEM.CloseReopenEvents,
        PHT.PrevHistoryDate,
        EXTRACT(HOUR FROM (PHT.HistoryDate - PHT.PrevHistoryDate)) AS HoursSincePrevHistoryEvent,
        CASE WHEN PHT.PrevHistoryDate IS NOT NULL AND PHT.HistoryDate - PHT.PrevHistoryDate < INTERVAL '24 hour' THEN TRUE ELSE FALSE END AS RapidHistoryChange,
        (
            SELECT COALESCE(STRING_AGG(T2.TagName, ', '), 'No Tags')
            FROM Posts QP_inner
            JOIN (
                SELECT unnest(string_to_array(substring(QP_inner.Tags, 2, length(QP_inner.Tags)-2), '><')) AS TagName
            ) AS Tag ON TRUE
            JOIN Tags T2 ON T2.TagName = Tag.TagName
            WHERE QP_inner.Id = PEM.ParentId AND T2.IsModeratorOnly = TRUE
        ) AS ModeratorOnlyTags
    FROM UserActivitySummary UAS
    INNER JOIN PostEngagementMetrics PEM ON UAS.UserId = PEM.OwnerUserId
    INNER JOIN Posts P ON PEM.PostId = P.Id AND PEM.PostTypeId = 2
    INNER JOIN Posts QP ON P.ParentId = QP.Id AND QP.AcceptedAnswerId = PEM.PostId
    LEFT JOIN PostHistoryTrend PHT ON PEM.PostId = PHT.PostId AND PHT.rn_latest_history = 1
    WHERE UAS.Reputation >= 20000
      AND PEM.RnPerUserPostScore <= 2
      AND PEM.PostScore >= 50
      AND (LOWER(P.Body) LIKE '%solution%' OR LOWER(P.Body) LIKE '%fixed%')
)
SELECT *
FROM (
    SELECT * FROM HighImpactQuestions
    UNION ALL
    SELECT * FROM HighImpactAnswers
) AS combined
ORDER BY Reputation DESC, PostScore DESC, PostCreationDate DESC
LIMIT 1000;