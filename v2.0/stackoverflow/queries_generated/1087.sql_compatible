WITH UserEngagementSummary AS (
    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate AS UserLastAccessDate,
        COUNT(DISTINCT A.Id) AS TotalAnswers,
        COALESCE(SUM(A.Score), 0) AS TotalAnswerScore,
        COALESCE(AVG(A.Score), 0.0) AS AvgAnswerScore,
        COUNT(DISTINCT AcceptedQ.Id) AS AcceptedAnswersProvidedCount,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadgesCount,
        MIN(CASE WHEN B.Class = 1 THEN B.Date END) AS FirstGoldBadgeDate,
        'HighReputation' AS UserCategory
    FROM
        Users U
    LEFT JOIN
        Posts A ON U.Id = A.OwnerUserId AND A.PostTypeId = 2
    LEFT JOIN
        Posts AcceptedQ ON A.Id = AcceptedQ.AcceptedAnswerId AND AcceptedQ.PostTypeId = 1
    LEFT JOIN
        Badges B ON U.Id = B.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate
    HAVING
        U.Reputation >= 10000
        AND COUNT(DISTINCT A.Id) >= 50
        AND SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) >= 1
        AND U.LastAccessDate IS NOT NULL

    UNION ALL

    SELECT
        U.Id AS UserId,
        U.DisplayName,
        U.Reputation,
        U.CreationDate AS UserCreationDate,
        U.LastAccessDate AS UserLastAccessDate,
        COUNT(DISTINCT A.Id) AS TotalAnswers,
        COALESCE(SUM(A.Score), 0) AS TotalAnswerScore,
        COALESCE(AVG(A.Score), 0.0) AS AvgAnswerScore,
        COUNT(DISTINCT AcceptedQ.Id) AS AcceptedAnswersProvidedCount,
        SUM(CASE WHEN B.Class = 1 THEN 1 ELSE 0 END) AS GoldBadgesCount,
        MIN(CASE WHEN B.Class = 1 THEN B.Date END) AS FirstGoldBadgeDate,
        'HighScoreContributor' AS UserCategory
    FROM
        Users U
    INNER JOIN
        Posts A ON U.Id = A.OwnerUserId AND A.PostTypeId = 2
    LEFT JOIN
        Posts AcceptedQ ON A.Id = AcceptedQ.AcceptedAnswerId AND AcceptedQ.PostTypeId = 1
    LEFT JOIN
        Badges B ON U.Id = B.UserId
    GROUP BY
        U.Id, U.DisplayName, U.Reputation, U.CreationDate, U.LastAccessDate
    HAVING
        COALESCE(SUM(A.Score), 0) >= 2000
        AND COUNT(DISTINCT A.Id) >= 10
        AND U.Reputation < 10000
        AND U.LastAccessDate IS NOT NULL
),
QuestionAnswerDetails AS (
    SELECT
        Q.Id AS QuestionId,
        Q.Title AS QuestionTitle,
        Q.CreationDate AS QuestionCreationDate,
        Q.OwnerUserId AS QuestionOwnerId,
        Q.Tags,
        A.Id AS AcceptedAnswerId,
        A.OwnerUserId AS AcceptedAnswerOwnerId,
        A.Score AS AcceptedAnswerScore,
        COALESCE(Q.AnswerCount, 0) AS TotalAnswerCountForQuestion,
        Q.ViewCount AS QuestionViewCount,
        Q.FavoriteCount AS QuestionFavoriteCount,
        (SELECT COUNT(C.Id) FROM Comments C WHERE C.PostId = Q.Id AND C.CreationDate > Q.CreationDate) AS QuestionCommentCount,
        (SELECT COUNT(DISTINCT PH.Id) FROM PostHistory PH WHERE PH.PostId = Q.Id AND PH.PostHistoryTypeId IN (4, 5, 6)) AS QuestionEditCount,
        (Q.ClosedDate IS NOT NULL) AS IsQuestionClosed,
        Q.LastActivityDate AS QuestionLastActivityDate,
        COALESCE(SUBSTRING(Q.Body, 1, 100), 'No Body Excerpt') AS BodyExcerpt,
        (SELECT MAX(V.CreationDate) FROM Votes V WHERE V.PostId = Q.Id AND V.VoteTypeId = 2) AS LatestUpvoteDate
    FROM
        Posts Q
    INNER JOIN
        Posts A ON Q.AcceptedAnswerId = A.Id AND Q.PostTypeId = 1 AND A.PostTypeId = 2
    WHERE
        Q.CreationDate >= DATE '2020-01-01'
        AND Q.Tags IS NOT NULL
        AND Q.Score > 0
),
AggregatedTagMetrics AS (
    SELECT
        QAD.QuestionId,
        QAD.QuestionTitle,
        QAD.QuestionCreationDate,
        QAD.QuestionOwnerId,
        QAD.AcceptedAnswerId,
        QAD.AcceptedAnswerOwnerId,
        QAD.AcceptedAnswerScore,
        QAD.TotalAnswerCountForQuestion,
        QAD.QuestionFavoriteCount,
        QAD.QuestionCommentCount,
        QAD.QuestionEditCount,
        QAD.IsQuestionClosed,
        QAD.QuestionLastActivityDate,
        QAD.BodyExcerpt,
        QAD.LatestUpvoteDate,
        TRIM(tag_value) AS TagName,
        ROW_NUMBER() OVER (PARTITION BY QAD.AcceptedAnswerOwnerId ORDER BY QAD.QuestionCreationDate DESC, QAD.QuestionId) AS AnswererQuestionRankByDate,
        AVG(QAD.AcceptedAnswerScore) OVER (PARTITION BY TRIM(tag_value)) AS AvgAcceptedScorePerTag,
        COUNT(QAD.QuestionId) OVER (PARTITION BY TRIM(tag_value)) AS QuestionCountPerTag,
        NTH_VALUE(QAD.QuestionTitle, 1) OVER (PARTITION BY TRIM(tag_value) ORDER BY QAD.QuestionViewCount DESC) AS MostViewedQuestionInTag
    FROM
        QuestionAnswerDetails QAD,
        -- Portable tag-splitting using standard string functions: remove leading '<' and trailing '>' then split on '><'
        (
          SELECT
              regexp_split_to_table(
                  CASE
                    WHEN LEFT(QAD.Tags,1) = '<' AND RIGHT(QAD.Tags,1) = '>' THEN SUBSTRING(QAD.Tags FROM 2 FOR CHAR_LENGTH(QAD.Tags)-2)
                    ELSE QAD.Tags
                  END,
                  '><'
              ) AS tag_value
        ) AS tags_split
    WHERE
        TRIM(tag_value) IS NOT NULL
        AND CHAR_LENGTH(TRIM(tag_value)) > 0
)
SELECT
    UES.UserId,
    UES.DisplayName,
    UES.Reputation,
    UES.UserCategory,
    UES.TotalAnswers,
    UES.AvgAnswerScore,
    UES.AcceptedAnswersProvidedCount,
    UES.GoldBadgesCount,
    UES.FirstGoldBadgeDate,
    ATM.QuestionId,
    ATM.QuestionTitle,
    ATM.TagName,
    ATM.AcceptedAnswerScore,
    ATM.AvgAcceptedScorePerTag,
    ATM.QuestionCountPerTag,
    ATM.AnswererQuestionRankByDate,
    ATM.QuestionCommentCount,
    ATM.QuestionEditCount,
    ATM.IsQuestionClosed,
    ATM.MostViewedQuestionInTag,
    CASE
        WHEN UES.UserLastAccessDate > ATM.QuestionLastActivityDate THEN 'UserActivityMoreRecent'
        WHEN UES.UserLastAccessDate < ATM.QuestionLastActivityDate THEN 'QuestionActivityMoreRecent'
        ELSE 'ActivityDatesMatch'
    END AS ActivityComparison,
    (SELECT COUNT(DISTINCT V.PostId)
     FROM Votes V
     WHERE V.UserId = UES.UserId
       AND V.VoteTypeId = 2
       AND V.CreationDate >= ATM.QuestionCreationDate
       AND EXISTS (
           SELECT 1
           FROM Posts UpvotedPost,
                (
                  SELECT
                      regexp_split_to_table(
                          CASE
                            WHEN LEFT(UpvotedPost.Tags,1) = '<' AND RIGHT(UpvotedPost.Tags,1) = '>' THEN SUBSTRING(UpvotedPost.Tags FROM 2 FOR CHAR_LENGTH(UpvotedPost.Tags)-2)
                            ELSE UpvotedPost.Tags
                          END,
                          '><'
                      ) AS upvote_tag
                ) AS upvote_tags
           WHERE UpvotedPost.Id = V.PostId
             AND TRIM(upvote_tag) = ATM.TagName
             AND UpvotedPost.PostTypeId = 1
       )
    ) AS UpvotedQuestionsInSameTagByAnswerer,
    COALESCE(
        (SELECT PHT.Name FROM PostHistory PHS
         INNER JOIN PostHistoryTypes PHT ON PHS.PostHistoryTypeId = PHT.Id
         WHERE PHS.PostId = ATM.QuestionId
         ORDER BY PHS.CreationDate DESC
         LIMIT 1),
        'NoDetailedHistory'
    ) AS LatestQuestionHistoryTypeName,
    (ATM.LatestUpvoteDate IS NOT NULL AND ATM.LatestUpvoteDate < (ATM.QuestionCreationDate + INTERVAL '1' DAY)) AS UpvoteWithinDayOfQuestion,
    COALESCE(Users.Location, 'Unknown Location') AS UserLocation
FROM
    UserEngagementSummary UES
INNER JOIN
    AggregatedTagMetrics ATM ON UES.UserId = ATM.AcceptedAnswerOwnerId
LEFT JOIN Users ON UES.UserId = Users.Id
WHERE
    ATM.AnswererQuestionRankByDate <= 5
    AND ATM.TagName IN ('sql', 'database', 'performance', 'indexing', 'json', 'python', 'javascript')
    AND ATM.AcceptedAnswerScore > ATM.AvgAcceptedScorePerTag
    AND UES.UserCreationDate < ATM.QuestionCreationDate
    AND (ATM.IsQuestionClosed = FALSE OR UES.Reputation > 25000)
    AND (CHAR_LENGTH(TRIM(ATM.BodyExcerpt)) > 50 OR ATM.QuestionFavoriteCount > 10)
ORDER BY
    UES.Reputation DESC,
    UES.UserId,
    ATM.TagName,
    ATM.AnswererQuestionRankByDate ASC;