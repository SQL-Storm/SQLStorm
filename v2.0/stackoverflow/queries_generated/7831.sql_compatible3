    FROM DetailedBadges db3
    LEFT JOIN UserStats us3 ON us3.UserId = db3.UserId
    LEFT JOIN PostAnalysis pa3 ON us3.UserId = pa3.OwnerUserId
    LEFT JOIN TagAnalysis ta3 ON us3.UserId = ta3.Id OR pa3.OwnerUserId = ta3.Id
    WHERE 
