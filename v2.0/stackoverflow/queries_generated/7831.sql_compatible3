        ta2.TagName,
        ta2.Count as TagCount,
        ta2.PopularityLevel,
        ta2.PopularityRank
    FROM PostAnalysis pa2
    LEFT JOIN UserStats us2 ON us2.UserId = pa2.OwnerUserId
    LEFT JOIN DetailedBadges db2 ON us2.UserId = db2.UserId
    LEFT JOIN TagAnalysis ta2 ON us2.UserId = ta2.Id OR pa2.OwnerUserId = ta2.Id
    WHERE 
        (us2.UserId IS NOT NULL OR pa2.PostId IS NOT NULL OR db2.Id IS NOT NULL OR ta2.Id IS NOT NULL)
        AND 
        (
            (pa2.PostId IS NOT NULL AND pa2.Score > 0 AND pa2.Score / NULLIF(pa2.ViewCount, 0) > 0.01)
            OR (db2.Id IS NOT NULL AND db2.BadgeTier IN ('Gold', 'Silver'))
            OR (ta2.Id IS NOT NULL AND ta2.Count > 50)
            OR (us2.UserId IS NOT NULL AND us2.Reputation > 5000)
        )

    UNION

    SELECT 
        us3.UserId,
        us3.DisplayName,
        us3.Reputation,
        us3.TotalPosts,
        us3.Questions,
        us3.Answers,
        us3.Badges,
        us3.Comments,
