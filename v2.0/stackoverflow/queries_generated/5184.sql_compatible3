WITH
RecentHot AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.LastActivityDate,
    p.CommentCount,
    p.AnswerCount,
    m.Name AS PostTypeName,
    p.PostTypeId
  FROM Posts p
  JOIN PostTypes m ON p.PostTypeId = m.Id
  WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS timestamp) - INTERVAL '90 days'
),
TopTags AS (
  SELECT
    t.TagName,
    AVG(p.Score) AS avg_score,
    COUNT(*) AS post_count,
    MAX(p.LastActivityDate) AS last_active
  FROM Posts p
  JOIN LATERAL (
    SELECT regexp_split_to_table(trim(both '<>' FROM p.Tags), '><') AS TagName
  ) t ON TRUE
  GROUP BY t.TagName
  HAVING COUNT(*) > 5
),
UserActivity AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    COUNT(DISTINCT p.Id) AS posts_created,
    SUM(COALESCE(p.ViewCount,0)) AS total_views,
    SUM(COALESCE(v.BountyAmount,0)) AS total_bounties
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  LEFT JOIN Votes v ON v.PostId = p.Id AND v.VoteTypeId = 8
  WHERE u.AccountId IS NOT NULL
  GROUP BY u.Id, u.DisplayName
),
ComplexQuery AS (
  SELECT
    rh.PostId,
    rh.Title,
    rh.Tags,
    rh.CreationDate,
    rh.Score,
    rh.ViewCount,
    rh.OwnerUserId,
    rh.LastActivityDate,
    rh.CommentCount,
    rh.AnswerCount,
    p2.PostTypeId AS RelatedPostTypeId,
    pv.UserId AS VotedUserId,
    pv.VoteTypeId,
    CASE
      WHEN pv.VoteTypeId IN (2,3) THEN 'UpOrDown'
      WHEN pv.VoteTypeId = 10 THEN 'Deletion'
      ELSE 'Other'
    END AS VoteCategory,
    w1.Name AS LastEditor,
    w1.LastEditDate
  FROM RecentHot rh
  LEFT JOIN Posts p2 ON p2.ParentId = rh.PostId
  LEFT JOIN Votes pv ON pv.PostId = rh.PostId
  LEFT JOIN PostTypes w1 ON rh.PostTypeId = w1.Id
  WHERE rh.Score > 0
    OR rh.ViewCount > 100
)
SELECT
  cr.PostId,
  cr.Title,
  cr.Tags,
  cr.CreationDate,
  cr.Score,
  cr.ViewCount,
  cr.OwnerUserId,
  cr.LastActivityDate,
  cr.CommentCount,
  cr.AnswerCount,
  U1.DisplayName AS OwnerDisplayName,
  U1.Reputation AS OwnerReputation,
  U2.DisplayName AS LastEditorName,
  U2.LastEditDate AS LastEditDate,
  (SELECT AVG(v2.BountyAmount) FROM Votes v2 WHERE v2.PostId = cr.PostId) AS AvgBounty,
  (SELECT COUNT(*) FROM Comments c WHERE c.PostId = cr.PostId) AS CommentCountAll,
  (SELECT COUNT(*) FROM Votes v3 WHERE v3.PostId = cr.PostId AND v3.VoteTypeId = 2) AS UpVotesOnPost,
  (SELECT COUNT(*) FROM Votes v4 WHERE v4.PostId = cr.PostId AND v4.VoteTypeId = 3) AS DownVotesOnPost,
  TH.avg_score AS TagRelatedAvgScore,
  TH.post_count AS TagRelatedPostCount,
  UA.total_views AS UserTotalViews,
  UA.posts_created AS UserPostCount
FROM (
  SELECT
    rh.PostId,
    rh.Title,
    rh.Tags,
    rh.CreationDate,
    rh.Score,
    rh.ViewCount,
    rh.OwnerUserId,
    rh.LastActivityDate,
    rh.CommentCount,
    rh.AnswerCount
  FROM RecentHot rh
) cr
LEFT JOIN Users U1 ON cr.OwnerUserId = U1.Id
LEFT JOIN (SELECT Id, DisplayName, LastEditDate FROM Users) U2 ON U2.Id = cr.OwnerUserId
LEFT JOIN PostTypes PT ON cr.PostId = PT.Id
LEFT JOIN LATERAL (
  SELECT p.Name AS LastEditorDisplayName, p.LastEditDate
  FROM Posts p
  WHERE p.Id = cr.PostId
  LIMIT 1
) w1 ON TRUE
LEFT JOIN TopTags TH ON TH.TagName IS NOT NULL
LEFT JOIN UserActivity UA ON cr.OwnerUserId = UA.UserId
GROUP BY
  cr.PostId,
  cr.Title,
  cr.Tags,
  cr.CreationDate,
  cr.Score,
  cr.ViewCount,
  cr.OwnerUserId,
  cr.LastActivityDate,
  cr.CommentCount,
  cr.AnswerCount,
  U1.DisplayName,
  U1.Reputation,
  U2.DisplayName,
  U2.LastEditDate,
  TH.avg_score,
  TH.post_count,
  UA.total_views,
  UA.posts_created
ORDER BY cr.LastActivityDate DESC
LIMIT 100;