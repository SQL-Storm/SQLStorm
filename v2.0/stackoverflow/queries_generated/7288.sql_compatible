WITH UserPostStats AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(p.Id) AS TotalPosts,
        COUNT(CASE WHEN p.PostTypeId = 1 THEN 1 END) AS QuestionCount,
        COUNT(CASE WHEN p.PostTypeId = 2 THEN 1 END) AS AnswerCount,
        SUM(CASE WHEN p.PostTypeId = 1 THEN p.Score ELSE 0 END) AS TotalQuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN p.Score ELSE 0 END) AS TotalAnswerScore,
        AVG(CASE WHEN p.PostTypeId = 1 THEN p.Score END) AS AvgQuestionScore,
        AVG(CASE WHEN p.PostTypeId = 2 THEN p.Score END) AS AvgAnswerScore,
        MAX(p.CreationDate) AS LastPostDate,
        STRING_AGG(DISTINCT p.Tags, ', ') AS AllTags,
        COUNT(DISTINCT CASE WHEN p.Tags IS NOT NULL THEN p.Tags END) AS TagCount
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    WHERE u.Id > 0
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        t.ExcerptPostId,
        t.WikiPostId,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS RankByPopularity
    FROM Tags t
    WHERE t.Count > 100
),
UserBadgesWithRanking AS (
    SELECT 
        b.UserId,
        b.Name AS BadgeName,
        b.Date,
        b.Class,
        COUNT(*) OVER (PARTITION BY b.UserId) AS TotalBadges,
        ROW_NUMBER() OVER (PARTITION BY b.UserId ORDER BY b.Date DESC) AS RecentBadgeRank,
        CASE 
            WHEN b.Class = 1 THEN 'Gold'
            WHEN b.Class = 2 THEN 'Silver'
            WHEN b.Class = 3 THEN 'Bronze'
            ELSE 'Unknown'
        END AS BadgeTier,
        CAST( (JULIANDAY('2024-10-01 12:34:56') - JULIANDAY(b.Date)) AS INTEGER ) AS DaysSinceBadge
    FROM Badges b
),
PostActivityWithComments AS (
    SELECT 
        p.Id AS PostId,
        p.Title,
        p.Body,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.LastActivityDate,
        p.OwnerUserId,
        p.PostTypeId,
        p.Tags,
        c.Text AS LastCommentText,
        c.CreationDate AS LastCommentDate,
        CAST((JULIANDAY(p.LastActivityDate) - JULIANDAY(p.CreationDate)) * 24 AS INTEGER) AS ActivityDurationHours,
        CASE 
            WHEN p.PostTypeId = 1 THEN 
                CASE 
                    WHEN p.AcceptedAnswerId IS NOT NULL THEN 'Answered'
                    WHEN p.ClosedDate IS NOT NULL THEN 'Closed'
                    ELSE 'Open'
                END
            ELSE 'NotQuestion'
        END AS QuestionStatus,
        COALESCE(p.AnswerCount, 0) + COALESCE(p.CommentCount, 0) AS EngagementScore
    FROM Posts p
    LEFT JOIN (
        SELECT 
            PostId, 
            Text, 
            CreationDate,
            ROW_NUMBER() OVER (PARTITION BY PostId ORDER BY CreationDate DESC) AS rn
        FROM Comments
    ) c ON p.Id = c.PostId AND c.rn = 1
    WHERE p.PostTypeId IN (1, 2)
),
UserScores AS (
    SELECT 
        u.Id AS UserId,
        u.DisplayName,
        u.Reputation,
        u.Views,
        u.UpVotes,
        u.DownVotes,
        u.AccountId,
        SUM(COALESCE(p.Score, 0)) AS TotalScore,
        SUM(CASE WHEN p.PostTypeId = 1 THEN COALESCE(p.Score, 0) ELSE 0 END) AS QuestionScore,
        SUM(CASE WHEN p.PostTypeId = 2 THEN COALESCE(p.Score, 0) ELSE 0 END) AS AnswerScore,
        CASE 
            WHEN SUM(COALESCE(p.Score, 0)) = 0 THEN 0
            ELSE ROUND(
                (SUM(CASE WHEN p.PostTypeId = 1 THEN COALESCE(p.Score, 0) ELSE 0 END) * 100.0) / 
                SUM(COALESCE(p.Score, 0)), 2
            )
        END AS QuestionContributionPercentage,
        COUNT(p.Id) AS PostCount,
        AVG(COALESCE(p.Score, 0)) AS AvgPostScore,
        (u.UpVotes - u.DownVotes) AS NetVoteDifference,
        CASE 
            WHEN u.UpVotes > 0 THEN CAST(u.DownVotes AS FLOAT) / u.UpVotes
            ELSE 0
        END AS DownvoteToUpvoteRatio,
        CASE 
            WHEN u.Reputation > 10000 THEN 'Expert'
            WHEN u.Reputation > 1000 THEN 'Advanced'
            WHEN u.Reputation > 100 THEN 'Intermediate'
            ELSE 'Beginner'
        END AS UserLevel,
        ROW_NUMBER() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
        DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRankDense
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    GROUP BY u.Id, u.DisplayName, u.Reputation, u.Views, u.UpVotes, u.DownVotes, u.AccountId
)
SELECT 
    us.ReputationRank,
    us.DisplayName,
    us.Reputation,
    us.TotalScore,
    us.QuestionScore,
    us.AnswerScore,
    us.QuestionContributionPercentage,
    us.PostCount,
    us.AvgPostScore,
    us.NetVoteDifference,
    us.DownvoteToUpvoteRatio,
    us.UserLevel,
    ups.TotalPosts,
    ups.QuestionCount,
    ups.AnswerCount,
    ups.TotalQuestionScore,
    ups.TotalAnswerScore,
    ups.AvgQuestionScore,
    ups.AvgAnswerScore,
    ups.TagCount,
    tb.BadgeName,
    tb.BadgeTier,
    tb.RecentBadgeRank,
    tb.DaysSinceBadge,
    ta.TagName,
    ta.Count AS TagPopularity,
    ta.RankByPopularity,
    pa.PostId,
    pa.Title,
    pa.Score AS PostScore,
    pa.ViewCount,
    pa.AnswerCount AS PostAnswerCount,
    pa.CommentCount AS PostCommentCount,
    pa.ActivityDurationHours,
    pa.QuestionStatus,
    pa.EngagementScore,
    CASE 
        WHEN pa.EngagementScore > 50 THEN 'Highly Engaged'
        WHEN pa.EngagementScore > 20 THEN 'Moderately Engaged'
        WHEN pa.EngagementScore > 5 THEN 'Slightly Engaged'
        ELSE 'Not Engaged'
    END AS EngagementLevel,
    CASE 
        WHEN pa.LastCommentDate IS NULL THEN 'No Comments'
        WHEN CAST((JULIANDAY('2024-10-01 12:34:56') - JULIANDAY(pa.LastCommentDate)) AS INTEGER) > 30 THEN 'Old Comments'
        ELSE 'Recent Comments'
    END AS CommentStatus,
    CASE 
        WHEN pa.Score < 0 THEN 'Negative Reputation'
        WHEN pa.Score > 100 THEN 'Highly Rated'
        WHEN pa.Score > 50 THEN 'Well Rated'
        WHEN pa.Score > 10 THEN 'Average Rated'
        ELSE 'Low Rated'
    END AS PostRating,
    CASE 
        WHEN ups.TotalPosts > 500 THEN 'Veteran'
        WHEN ups.TotalPosts > 100 THEN 'Regular'
        WHEN ups.TotalPosts > 10 THEN 'Newbie'
        ELSE 'Beginner'
    END AS PostingFrequencyLevel,
    CASE 
        WHEN ups.QuestionCount > up.PostCount / 2 THEN 'Question Focused'
        WHEN ups.AnswerCount > up.PostCount / 2 THEN 'Answer Focused'
        ELSE 'Well Balanced'
    END AS ContributionFocus,
    DENSE_RANK() OVER (ORDER BY pa.Score DESC) AS PostRank,
    CASE 
        WHEN ups.TotalPosts > 0 THEN ROUND(
            (ups.QuestionCount * 100.0) / ups.TotalPosts, 2
        )
        ELSE 0
    END AS QuestionPercentage,
    CASE 
        WHEN ups.TotalPosts > 0 THEN ROUND(
            (ups.AnswerCount * 100.0) / ups.TotalPosts, 2
        )
        ELSE 0
    END AS AnswerPercentage,
    (
        SELECT GROUP_CONCAT(DISTINCT t.TagName, ', ')
        FROM Tags t
        WHERE t.TagName IN (
            SELECT TRIM(value) FROM (
                SELECT TRIM(value) AS value
                FROM (
                    SELECT value FROM (
                        SELECT json_each.value AS value
                        FROM json_each('["' || REPLACE(ups.AllTags, ', ', '","') || '"]')
                    )
                )
            )
        )
    ) AS TagList,
    'Top User Analysis - ' || STRFTIME('%m/%d/%Y', '2024-10-01 12:34:56') AS ReportHeader
FROM UserScores us
JOIN UserPostStats ups ON us.UserId = ups.UserId
LEFT JOIN UserBadgesWithRanking tb ON us.UserId = tb.UserId AND tb.RecentBadgeRank <= 3
LEFT JOIN TopTags ta ON ta.RankByPopularity <= 10
LEFT JOIN PostActivityWithComments pa ON pa.OwnerUserId = us.UserId
LEFT JOIN (
    SELECT UserId, COUNT(*) as PostCount
    FROM Posts
    GROUP BY UserId
) up ON us.UserId = up.UserId
WHERE (us.Reputation > 100 OR ups.TotalPosts > 5 OR tb.BadgeName IS NOT NULL)
    AND (pa.PostId IS NULL OR pa.Score > 10)
    AND (ta.TagName IS NULL OR ta.Count > 500)
GROUP BY 
    us.ReputationRank, us.DisplayName, us.Reputation, us.TotalScore, 
    us.QuestionScore, us.AnswerScore, us.QuestionContributionPercentage, 
    us.PostCount, us.AvgPostScore, us.NetVoteDifference, us.DownvoteToUpvoteRatio, 
    us.UserLevel, ups.TotalPosts, ups.QuestionCount, ups.AnswerCount, 
    ups.TotalQuestionScore, ups.TotalAnswerScore, ups.AvgQuestionScore, 
    ups.AvgAnswerScore, ups.TagCount, tb.BadgeName, tb.BadgeTier, 
    tb.RecentBadgeRank, tb.DaysSinceBadge, ta.TagName, ta.Count, 
    ta.RankByPopularity, pa.PostId, pa.Title, pa.Score, pa.ViewCount, 
    pa.AnswerCount, pa.CommentCount, pa.ActivityDurationHours, 
    pa.QuestionStatus, pa.EngagementScore, pa.LastCommentDate,
    ups.AllTags, up.PostCount, us.UserId
HAVING COUNT(*) > 0
ORDER BY us.Reputation DESC, us.TotalScore DESC, ups.TotalPosts DESC;