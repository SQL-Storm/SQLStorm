WITH UserActivityStats AS (
    SELECT 
        u.Id as UserId,
        u.DisplayName,
        u.Reputation,
        COUNT(DISTINCT p.Id) as TotalPosts,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) as Questions,
        COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id END) as Answers,
        COUNT(DISTINCT c.Id) as Comments,
        COUNT(DISTINCT b.Id) as Badges,
        MAX(p.CreationDate) as LastPostDate,
        ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT p.Id) DESC) as PostRank,
        RANK() OVER (ORDER BY u.Reputation DESC) as ReputationRank,
        DENSE_RANK() OVER (ORDER BY COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id END) DESC) as QuestionRank
    FROM Users u
    LEFT JOIN Posts p ON u.Id = p.OwnerUserId
    LEFT JOIN Comments c ON u.Id = c.UserId
    LEFT JOIN Badges b ON u.Id = b.UserId
    WHERE u.CreationDate >= TIMESTAMP '2010-01-01 00:00:00'
    GROUP BY u.Id, u.DisplayName, u.Reputation
),
TopTags AS (
    SELECT 
        t.TagName,
        t.Count as TagCount,
        t.ExcerptPostId,
        t.WikiPostId,
        CASE 
            WHEN t.Count > 1000 THEN 'High'
            WHEN t.Count > 500 THEN 'Medium'
            ELSE 'Low'
        END as PopularityLevel,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) as TagRank
    FROM Tags t
    WHERE t.TagName IS NOT NULL AND t.TagName <> ''
),
PostComplexityAnalysis AS (
    SELECT 
        p.Id as PostId,
        p.Title,
        p.Body,
        p.Score,
        p.ViewCount,
        p.AnswerCount,
        p.CommentCount,
        p.CreationDate,
        p.OwnerUserId,
        CASE 
            WHEN p.PostTypeId = 1 AND p.AnswerCount > 0 THEN 'QuestionWithAnswers'
            WHEN p.PostTypeId = 1 AND p.AnswerCount = 0 THEN 'UnansweredQuestion'
            WHEN p.PostTypeId = 2 THEN 'Answer'
            ELSE 'Other'
        END as PostCategory,
        LENGTH(p.Body) as BodyLength,
        LENGTH(p.Title) as TitleLength,
        CASE 
            WHEN p.Body LIKE '%<code>%' OR p.Body LIKE '%`%' THEN 'HasCode'
            ELSE 'NoCode'
        END as HasCode,
        CASE 
            WHEN p.Tags IS NOT NULL AND p.Tags <> '' THEN array_length(string_to_array(replace(replace(p.Tags, '<', ''), '>', ''), ' '), 1)
            ELSE 0
        END as TagCount
    FROM Posts p
    WHERE p.CreationDate >= TIMESTAMP '2015-01-01 00:00:00'
),
UserPostAnalysis AS (
    SELECT 
        uas.UserId,
        uas.DisplayName,
        uas.Reputation,
        uas.TotalPosts,
        uas.Questions,
        uas.Answers,
        uas.Comments,
        uas.Badges,
        uas.PostRank,
        uas.ReputationRank,
        uas.QuestionRank,
        (CASE WHEN uas.Questions > 0 THEN CAST(uas.Answers AS DOUBLE PRECISION) / CAST(uas.Questions AS DOUBLE PRECISION) ELSE 0 END) as AnswerToQuestionRatio,
        (CASE WHEN uas.TotalPosts > 0 THEN CAST(uas.Comments AS DOUBLE PRECISION) / CAST(uas.TotalPosts AS DOUBLE PRECISION) ELSE 0 END) as CommentsPerPost,
        (CASE WHEN uas.Badges > 0 THEN CAST(uas.Reputation AS DOUBLE PRECISION) / CAST(uas.Badges AS DOUBLE PRECISION) ELSE 0 END) as RepPerBadge
    FROM UserActivityStats uas
    WHERE uas.TotalPosts > 0
)
SELECT 
    ups.UserId,
    ups.DisplayName,
    ups.Reputation,
    ups.TotalPosts,
    ups.Questions,
    ups.Answers,
    ups.Comments,
    ups.Badges,
    ups.PostRank,
    ups.ReputationRank,
    ups.QuestionRank,
    ups.AnswerToQuestionRatio,
    ups.CommentsPerPost,
    ups.RepPerBadge,
    CASE 
        WHEN ups.ReputationRank <= 100 THEN 'Top100'
        WHEN ups.ReputationRank <= 500 THEN 'Top500'
        WHEN ups.ReputationRank <= 1000 THEN 'Top1000'
        ELSE 'Other'
    END as ReputationTier,
    CASE 
        WHEN ups.TotalPosts >= 1000 THEN 'Elite'
        WHEN ups.TotalPosts >= 500 THEN 'Veteran'
        WHEN ups.TotalPosts >= 100 THEN 'Experienced'
        ELSE 'Beginner'
    END as PostingExperience,
    COALESCE((
        SELECT STRING_AGG(tag_list.Tag, ', ')
        FROM (
            SELECT DISTINCT unnest(string_to_array(replace(replace(p2.Tags, '<', ''), '>', ''), ' ')) as Tag
            FROM Posts p2
            WHERE p2.OwnerUserId = ups.UserId AND p2.PostTypeId = 1 AND p2.Tags IS NOT NULL
        ) tag_list
        WHERE tag_list.Tag IS NOT NULL AND tag_list.Tag <> ''
        GROUP BY tag_list.Tag
        HAVING COUNT(*) > 0
    ), 'No Tags') as UserTags,
    (SELECT COUNT(*) FROM Posts p WHERE p.OwnerUserId = ups.UserId AND p.CreationDate > TIMESTAMP '2020-01-01 00:00:00') as RecentPosts2020,
    (
        SELECT 
            COALESCE(
                CAST((COUNT(CASE WHEN ph.PostHistoryTypeId IN (1, 4, 5, 6) THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0) AS NUMERIC(5,2)), 
                0
            ) 
        FROM PostHistory ph 
        WHERE ph.UserId = ups.UserId AND ph.CreationDate >= TIMESTAMP '2015-01-01 00:00:00'
    ) as EditsPercentage,
    (
        SELECT 
            AVG(p.Score) 
        FROM Posts p 
        WHERE p.OwnerUserId = ups.UserId 
        AND p.PostTypeId = 1 
        AND p.CreationDate >= TIMESTAMP '2015-01-01 00:00:00'
    ) as AvgQuestionScore,
    (
        SELECT 
            AVG(p.Score) 
        FROM Posts p 
        WHERE p.OwnerUserId = ups.UserId 
        AND p.PostTypeId = 2 
        AND p.CreationDate >= TIMESTAMP '2015-01-01 00:00:00'
    ) as AvgAnswerScore,
    COALESCE(
        (
            WITH RECURSIVE QuestionHierarchy AS (
                SELECT 
                    p.Id, 
                    p.ParentId, 
                    p.OwnerUserId,
                    1 as Level,
                    0 as Distance
                FROM Posts p
                WHERE p.Id IN (
                    SELECT p2.Id 
                    FROM Posts p2 
                    WHERE p2.OwnerUserId = ups.UserId AND p2.PostTypeId = 1
                )
                AND p.PostTypeId = 2
                UNION ALL
                SELECT 
                    p.Id, 
                    p.ParentId, 
                    p.OwnerUserId, 
                    qh.Level + 1, 
                    qh.Distance + 1
                FROM Posts p
                INNER JOIN QuestionHierarchy qh ON p.ParentId = qh.Id
                WHERE qh.Level < 5 AND p.OwnerUserId = ups.UserId
            )
            SELECT COUNT(*) FROM QuestionHierarchy
        ), 0
    ) as AnswerHierarchyDepth,
    (
        SELECT 
            COUNT(*) 
        FROM Badges b 
        WHERE b.UserId = ups.UserId 
        AND b.Date >= TIMESTAMP '2015-01-01 00:00:00'
        AND b.Class = 1
    ) as GoldBadgesCount,
    (
        SELECT 
            COUNT(*) 
        FROM Badges b 
        WHERE b.UserId = ups.UserId 
        AND b.Date >= TIMESTAMP '2015-01-01 00:00:00'
        AND b.Class = 2
    ) as SilverBadgesCount,
    (
        SELECT 
            COUNT(*) 
        FROM Badges b 
        WHERE b.UserId = ups.UserId 
        AND b.Date >= TIMESTAMP '2015-01-01 00:00:00'
        AND b.Class = 3
    ) as BronzeBadgesCount
FROM UserPostAnalysis ups
WHERE ups.Reputation > 1000
    AND ups.TotalPosts >= 50
    AND ups.PostRank <= 1000
    AND ups.ReputationRank <= 1000
ORDER BY ups.Reputation DESC, ups.TotalPosts DESC, ups.PostRank ASC
LIMIT 500;