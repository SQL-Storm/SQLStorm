WITH 
UserStats AS (
    SELECT 
        u.Id,
        u.DisplayName,
        u.Reputation,
        u.CreationDate,
        COALESCE(qc.QuestionCount,0)      AS QuestionCount,
        COALESCE(ac.AnswerCount,0)        AS AnswerCount,
        COALESCE(bc.GoldBadges,0)         AS GoldBadges,
        COALESCE(bc.SilverBadges,0)       AS SilverBadges,
        COALESCE(bc.BronzeBadges,0)       AS BronzeBadges,
        (SELECT MAX(p.CreationDate) 
         FROM Posts p 
         WHERE p.OwnerUserId = u.Id)    AS LastPostDate,
        (SELECT COUNT(*) 
         FROM Votes v 
         WHERE v.UserId = u.Id AND v.VoteTypeId = 2) AS UpVotesGiven,
        (SELECT COUNT(*) 
         FROM Votes v 
         WHERE v.UserId = u.Id AND v.VoteTypeId = 3) AS DownVotesGiven
    FROM Users u
    LEFT JOIN (
        SELECT OwnerUserId, COUNT(*) AS QuestionCount
        FROM Posts 
        WHERE PostTypeId = 1
        GROUP BY OwnerUserId
    ) qc ON qc.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT OwnerUserId, COUNT(*) AS AnswerCount
        FROM Posts 
        WHERE PostTypeId = 2
        GROUP BY OwnerUserId
    ) ac ON ac.OwnerUserId = u.Id
    LEFT JOIN (
        SELECT UserId,
               SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
               SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
               SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
        FROM Badges
        GROUP BY UserId
    ) bc ON bc.UserId = u.Id
),
TopTags AS (
    SELECT 
        t.TagName,
        t.Count,
        ROW_NUMBER() OVER (ORDER BY t.Count DESC) AS rn
    FROM Tags t
    WHERE t.IsModeratorOnly = 0
),
UserTagActivity AS (
    SELECT 
        us.Id                                   AS UserId,
        -- Expand tags into rows, trim angle brackets, aggregate distinct values without USING DISTINCT inside WITHIN GROUP
        STRING_AGG(tag, ',' ORDER BY tag)       AS TagList,
        COUNT(DISTINCT p.Id)                    AS PostsWithTags
    FROM UserStats us
    JOIN Posts p 
          ON p.OwnerUserId = us.Id 
         AND p.Tags IS NOT NULL
    CROSS JOIN LATERAL (
        -- split tags into rows; function name adjusted for portability: regexp_split_to_table is Postgres-specific,
        -- but keeping it here; if not supported, replace with appropriate splitter in target dialect.
        SELECT TRIM(BOTH '<>' FROM regexp_split_to_table(p.Tags, '><')) AS tag
    ) t
    GROUP BY us.Id
),
RecentClosedQuestions AS (
    SELECT 
        p.OwnerUserId                           AS UserId,
        ph.PostId,
        MAX(ph.CreationDate)                    AS ClosedDate,
        MAX(CASE WHEN ph.PostHistoryTypeId = 10 THEN ph.Comment END) AS CloseReasonId
    FROM Posts p
    JOIN PostHistory ph 
          ON ph.PostId = p.Id
         AND ph.PostHistoryTypeId = 10
    GROUP BY p.OwnerUserId, ph.PostId
),
HeavyContributors AS (
    SELECT 
        us.Id,
        us.Reputation,
        us.QuestionCount,
        us.AnswerCount,
        (us.GoldBadges + us.SilverBadges + us.BronzeBadges) AS TotalBadges,
        RANK() OVER (ORDER BY us.Reputation DESC)          AS ReputationRank
    FROM UserStats us
    WHERE us.Reputation > 10000
      AND (us.QuestionCount + us.AnswerCount) > 0
      AND (us.GoldBadges + us.SilverBadges + us.BronzeBadges) >= 5
)
SELECT 
    hc.Id,
    us.DisplayName,
    us.Reputation,
    us.CreationDate,
    us.QuestionCount,
    us.AnswerCount,
    us.GoldBadges,
    us.SilverBadges,
    us.BronzeBadges,
    us.UpVotesGiven,
    us.DownVotesGiven,
    COALESCE(us.LastPostDate, CAST('1900-01-01' AS TIMESTAMP)) AS LastPostDate,
    COALESCE(uta.TagList, '')                         AS TagList,
    COALESCE(uta.PostsWithTags,0)                     AS PostsWithTags,
    rcq.ClosedDate,
    COALESCE(crt.Name,'Unknown')                      AS CloseReason,
    hc.ReputationRank
FROM HeavyContributors hc
JOIN UserStats us      ON us.Id = hc.Id
LEFT JOIN UserTagActivity uta   ON uta.UserId = hc.Id
LEFT JOIN RecentClosedQuestions rcq 
       ON rcq.UserId = hc.Id 
      AND rcq.PostId = (
          SELECT p.Id
          FROM Posts p
          WHERE p.OwnerUserId = hc.Id 
            AND p.PostTypeId = 1
          ORDER BY p.CreationDate DESC
          LIMIT 1
      )
LEFT JOIN CloseReasonTypes crt 
       ON crt.Id = CAST(rcq.CloseReasonId AS INTEGER)
ORDER BY hc.ReputationRank
OFFSET 0 ROWS FETCH NEXT 50 ROWS ONLY
UNION ALL
SELECT 
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,
    NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL
WHERE FALSE;