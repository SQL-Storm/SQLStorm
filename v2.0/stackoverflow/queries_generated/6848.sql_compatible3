SELECT 
    u.DisplayName,
    u.Reputation,
    COUNT(DISTINCT p.Id) AS TotalPosts,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 1 THEN p.Id ELSE NULL END) AS TotalQuestions,
    COUNT(DISTINCT CASE WHEN p.PostTypeId = 2 THEN p.Id ELSE NULL END) AS TotalAnswers,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.ClosedDate IS NOT NULL) AS TotalClosedPosts,
    COUNT(DISTINCT p.Id) FILTER (WHERE p.CommunityOwnedDate IS NOT NULL) AS TotalCommunityOwnedPosts,
    COUNT(DISTINCT CASE WHEN b.Id IS NOT NULL THEN u.Id ELSE NULL END) AS TotalBadges,
    MAX(u.Reputation) AS MaxReputation,
    MIN(u.Reputation) AS MinReputation,
    AVG(u.Reputation) AS AvgReputation,
    STRING_AGG(t.TagName, ', ' ORDER BY t.TagName) AS PopularTags,
    SUM(CASE WHEN v_up.PostId IS NOT NULL THEN 1 ELSE 0 END) AS TotalUpVotes,
    SUM(CASE WHEN v_down.PostId IS NOT NULL THEN 1 ELSE 0 END) AS TotalDownVotes
FROM 
    Users u
LEFT JOIN 
    Badges b ON u.Id = b.UserId
LEFT JOIN 
    Posts p ON u.Id = p.OwnerUserId
LEFT JOIN 
    Tags t ON p.Id = t.PostId
LEFT JOIN 
    (
        SELECT 
            ph.PostId,
            ROW_NUMBER() OVER (PARTITION BY ph.PostId ORDER BY ph.CreationDate DESC) AS rn
        FROM 
            PostHistory ph
    ) ph ON p.Id = ph.PostId AND ph.rn = 1
LEFT JOIN
    Votes v_up ON v_up.PostId = p.Id AND v_up.VoteTypeId = 2
LEFT JOIN
    Votes v_down ON v_down.PostId = p.Id AND v_down.VoteTypeId = 3
WHERE 
    u.Id IN (
        SELECT 
            UserId
        FROM 
            Votes
        GROUP BY 
            UserId
        HAVING 
            COUNT(*) > 100
    )
GROUP BY 
    u.Id, u.DisplayName, u.Reputation
HAVING 
    COUNT(DISTINCT p.Id) > 50
ORDER BY 
    u.Reputation DESC;