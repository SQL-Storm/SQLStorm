WITH
recent_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.LastActivityDate
  FROM Posts p
  WHERE p.PostTypeId = 1
    AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '30 days'
),
top_users AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.LastAccessDate DESC) AS rn
  FROM Users u
  WHERE u.Reputation > 1000
),
tag_stats AS (
  SELECT
    t.TagName,
    COUNT(*) AS tag_question_count,
    AVG(p.Score) AS avg_score,
    MAX(p.ViewCount) AS max_views
  FROM Posts p
  JOIN UNNEST(string_to_array(p.Tags, '><')) AS t(TagName) ON true
  WHERE p.PostTypeId = 1
  GROUP BY t.TagName
),
complex_join AS (
  SELECT
    rq.PostId,
    rq.Title,
    rq.Tags,
    rq.CreationDate,
    rq.Score,
    rq.ViewCount,
    tu.UserId AS OwnerId,
    tu.DisplayName AS OwnerName,
    wa.TotalAnswers,
    wa.TotalComments,
    ch.CloseDate
  FROM recent_questions rq
  LEFT JOIN top_users tu
    ON rq.OwnerUserId = tu.UserId
  LEFT JOIN (
    SELECT
      p.ParentId,
      COUNT(*) AS TotalAnswers
    FROM Posts p
    WHERE p.PostTypeId = 2
    GROUP BY p.ParentId
  ) wa ON rq.PostId = wa.ParentId
  LEFT JOIN (
    SELECT
      c.PostId,
      COUNT(*) AS TotalComments
    FROM Comments c
    GROUP BY c.PostId
  ) c ON rq.PostId = c.PostId
  LEFT JOIN (
    SELECT
      ph.PostId,
      MIN(ph.CreationDate) AS CloseDate
    FROM PostHistory ph
    WHERE ph.PostHistoryTypeId = 10 -- Post Closed
    GROUP BY ph.PostId
  ) ch ON rq.PostId = ch.PostId
),
windowed AS (
  SELECT
    c.*,
    SUM(c.TotalAnswers) OVER (PARTITION BY OwnerId ORDER BY CreationDate ROWS BETWEEN 29 PRECEDING AND CURRENT ROW) AS rolling_answers_30d
  FROM complex_join c
)
SELECT
  w.PostId,
  w.Title,
  w.Tags,
  w.CreationDate,
  w.Score,
  w.ViewCount,
  w.OwnerName,
  w.TotalAnswers,
  w.TotalComments,
  w.CloseDate,
  w.rolling_answers_30d,
  (CASE
     WHEN w.TotalComments > 0 THEN w.TotalAnswers * 1.0 / w.TotalComments
     ELSE NULL
   END) AS answers_per_comment,
  (CASE
     WHEN w.ViewCount > 0 THEN w.Score::float / w.ViewCount
     ELSE NULL
   END) AS score_per_view,
  (CASE
     WHEN w.rolling_answers_30d > 0 THEN w.Score::float / w.rolling_answers_30d
     ELSE NULL
   END) AS score_per_rolling_answer
FROM windowed w
JOIN tag_stats ts
  ON ts.TagName ILIKE ANY (STRING_TO_ARRAY(w.Tags, '><'))
ORDER BY w.CreationDate DESC
LIMIT 100;