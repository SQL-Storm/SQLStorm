WITH
RecentPosts AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Body,
    p.PostTypeId,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.Tags,
    p.CommentCount,
    p.AcceptedAnswerId,
    p.FavoriteCount,
    u.DisplayName AS OwnerDisplayName,
    u.Reputation,
    u.Location,
    u.AccountId,
    LAG(p.LastActivityDate) OVER (PARTITION BY p.OwnerUserId ORDER BY p.LastActivityDate DESC) AS PrevActivityDate,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.LastActivityDate DESC) AS rn
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE
    p.PostTypeId = 1
    AND p.LastActivityDate > (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year')
    AND p.Score > 5
),
VoteAgg AS (
  SELECT
    v.PostId,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotes,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotes,
    SUM(CASE WHEN v.VoteTypeId = 8 THEN 1 ELSE 0 END) AS BountyStarts,
    SUM(CASE WHEN v.VoteTypeId = 9 THEN 1 ELSE 0 END) AS BountyCloses,
    COUNT(*) AS VoteCount
  FROM Votes v
  GROUP BY v.PostId
),
TagInfo AS (
  SELECT
    t.Id AS TagPostId,
    t.TagName,
    t.Count,
    t.ExcerptPostId,
    t.WikiPostId
  FROM Tags t
),
RecentComments AS (
  SELECT
    c.PostId,
    COUNT(*) AS CommentCountLastYear
  FROM Comments c
  WHERE c.CreationDate > (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '1 year')
  GROUP BY c.PostId
),
PostLinksAgg AS (
  SELECT
    pl.PostId,
    COUNT(*) AS LinkCount,
    SUM(CASE WHEN lt.Name ILIKE '%duplicate%' THEN 1 ELSE 0 END) AS DuplicateLinks
  FROM PostLinks pl
  JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
  GROUP BY pl.PostId
),
OwnerHotness AS (
  SELECT
    p.Id AS PostId,
    p.OwnerUserId,
    p.Score,
    p.ViewCount,
    ROW_NUMBER() OVER (ORDER BY p.Score * 0.6 + p.ViewCount * 0.4 DESC) AS HotRank
  FROM Posts p
  WHERE p.OwnerUserId IS NOT NULL
)
SELECT
  rp.PostId,
  rp.Title,
  rp.Body,
  rp.CreationDate,
  rp.LastActivityDate,
  rp.Score,
  rp.ViewCount,
  rp.OwnerDisplayName,
  rp.Location,
  ra.UpVotes,
  ra.DownVotes,
  ra.BountyStarts,
  ra.BountyCloses,
  COALESCE(cli.CommentCountLastYear, 0) AS RecentComments,
  pli.LinkCount,
  COALESCE(ti.Count, 0) AS TagCount,
  CASE
    WHEN rp.ViewCount = 0 THEN NULL
    ELSE ROUND((rp.Score::numeric / rp.ViewCount) * 100.0, 2)
  END AS ScorePerView,
  CASE
    WHEN rp.OwnerUserId IS NULL THEN 'Unknown'
    ELSE COALESCE(ou.DisplayName, 'Unknown')
  END AS LastEditorName,
  CAST('2024-10-01 12:34:56' AS TIMESTAMP) AS BenchmarkRunAt
FROM RecentPosts rp
LEFT JOIN VoteAgg ra ON rp.PostId = ra.PostId
LEFT JOIN RecentComments cli ON rp.PostId = cli.PostId
LEFT JOIN PostLinksAgg pli ON rp.PostId = pli.PostId
LEFT JOIN TagInfo ti ON rp.PostId = ti.TagPostId
LEFT JOIN Users ou ON rp.OwnerUserId = ou.Id
LEFT JOIN (
  SELECT PostId, MAX(DisplayName) AS DisplayName
  FROM Posts p
  JOIN Users u ON p.OwnerUserId = u.Id
  GROUP BY PostId
) AS lastEditor ON rp.PostId = lastEditor.PostId
ORDER BY rp.LastActivityDate DESC
LIMIT 100
UNION ALL
SELECT
  rp2.PostId,
  rp2.Title,
  rp2.Body,
  rp2.CreationDate,
  rp2.LastActivityDate,
  rp2.Score,
  rp2.ViewCount,
  rp2.OwnerDisplayName,
  rp2.Location,
  ra2.UpVotes,
  ra2.DownVotes,
  ra2.BountyStarts,
  ra2.BountyCloses,
  COALESCE(cli2.CommentCountLastYear, 0) AS RecentComments,
  pli2.LinkCount,
  COALESCE(ti2.Count, 0) AS TagCount,
  CASE
    WHEN rp2.ViewCount = 0 THEN NULL
    ELSE ROUND((rp2.Score::numeric / rp2.ViewCount) * 100.0, 2)
  END AS ScorePerView,
  CASE
    WHEN rp2.OwnerUserId IS NULL THEN 'Unknown'
    ELSE COALESCE(ou2.DisplayName, 'Unknown')
  END AS LastEditorName,
  CAST('2024-10-01 12:34:56' AS TIMESTAMP) AS BenchmarkRunAt
FROM RecentPosts rp2
JOIN VoteAgg ra2 ON rp2.PostId = ra2.PostId
LEFT JOIN RecentComments cli2 ON rp2.PostId = cli2.PostId
LEFT JOIN PostLinksAgg pli2 ON rp2.PostId = pli2.PostId
LEFT JOIN TagInfo ti2 ON rp2.PostId = ti2.TagPostId
LEFT JOIN Users ou2 ON rp2.OwnerUserId = ou2.Id
WHERE rp2.Score > 100
ORDER BY rp2.LastActivityDate DESC
LIMIT 50
;