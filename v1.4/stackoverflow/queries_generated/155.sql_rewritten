WITH
-- 90 days activity snapshot by user (posts created, average post score, view count)
RecentPosts AS (
  SELECT
    p.OwnerUserId,
    COUNT(*) AS PostCount,
    AVG(p.Score) AS AvgPostScore,
    SUM(p.ViewCount) AS TotalViews,
    MAX(p.LastActivityDate) AS LastActivity
  FROM Posts p
  WHERE p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '90 days'
    AND p.OwnerUserId IS NOT NULL
  GROUP BY p.OwnerUserId
),
-- Votes activity by user (upvotes/downvotes) in the last year
VotesActivity AS (
  SELECT
    v.UserId,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesGiven,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesGiven,
    COUNT(*) AS TotalVotes
  FROM Votes v
  WHERE v.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - interval '1 year'
  GROUP BY v.UserId
),
-- Badge counts by user (gold/silver/bronze)
BadgeCounts AS (
  SELECT
    b.UserId,
    SUM(CASE WHEN b.Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
    SUM(CASE WHEN b.Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
    SUM(CASE WHEN b.Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges,
    COUNT(*) AS TotalBadges
  FROM Badges b
  GROUP BY b.UserId
),
-- Top linked posts per user by total link score (outer join example)
TopLinkedPosts AS (
  SELECT
    p.OwnerUserId,
    pl.RelatedPostId,
    SUM(plk.LinkTypeId = 1 OR plk.LinkTypeId = 3) AS LinkCount
  FROM Posts p
  LEFT JOIN PostLinks pl ON pl.PostId = p.Id
  LEFT JOIN PostLinks plk ON plk.RelatedPostId = pl.RelatedPostId
  WHERE p.OwnerUserId IS NOT NULL
  GROUP BY p.OwnerUserId, pl.RelatedPostId
),
-- Correlated subquery: last edited post per user (most recent LastEditDate)
LastEdited AS (
  SELECT DISTINCT ON (p.OwnerUserId)
    p.OwnerUserId,
    p.Id AS PostId,
    p.LastEditDate,
    p.Title
  FROM Posts p
  ORDER BY p.OwnerUserId, p.LastEditDate DESC
)
SELECT
  u.Id AS UserId,
  u.DisplayName,
  u.Reputation,
  u.CreationDate,
  COALESCE(rp.PostCount, 0) AS PostCountLast90,
  COALESCE(rp.AvgPostScore, 0) AS AvgPostScoreLast90,
  COALESCE(rp.TotalViews, 0) AS TotalViewsLast90,
  COALESCE(vt.UpVotesGiven, 0) AS UpVotesGivenYear,
  COALESCE(vt.DownVotesGiven, 0) AS DownVotesGivenYear,
  COALESCE(vt.TotalVotes, 0) AS TotalVotesYear,
  COALESCE(bc.GoldBadges, 0) AS GoldBadges,
  COALESCE(bc.SilverBadges, 0) AS SilverBadges,
  COALESCE(bc.BronzeBadges, 0) AS BronzeBadges,
  COALESCE(bc.TotalBadges, 0) AS TotalBadges,
  -- Complex string and NULL handling: user location or 'Unknown'
  COALESCE(NULLIF(u.Location, ''), 'Unknown') AS UserLocation,
  -- Example of a computed expression with NULL-safe arithmetic
  CASE
    WHEN u.AccountId IS NULL THEN NULL
    ELSE (EXTRACT(EPOCH FROM cast('2024-10-01 12:34:56' as timestamp))::bigint - EXTRACT(EPOCH FROM u.CreationDate)) / 86400
  END AS AccountAgeDays,
  -- Windowed metric: rank of user by Reputation within the result set (dense_rank)
  DENSE_RANK() OVER (ORDER BY u.Reputation DESC) AS ReputationRank,
  -- Correlated subquery: most recently edited post for the user
  la.PostId AS LastEditedPostId,
  la.LastEditDate AS LastEditedPostDate,
  la.Title AS LastEditedPostTitle,
  -- Set operator style: union with a synthetic row for benchmarking
  -- Not executed as a separate part; kept here to illustrate potential benchmarking variants
  NULL AS BenchmarkMarker
FROM Users u
LEFT JOIN RecentPosts rp ON rp.OwnerUserId = u.Id
LEFT JOIN VotesActivity vt ON vt.UserId = u.Id
LEFT JOIN BadgeCounts bc ON bc.UserId = u.Id
LEFT JOIN LastEdited la ON la.OwnerUserId = u.Id
ORDER BY ReputationRank, u.Id
LIMIT 100;