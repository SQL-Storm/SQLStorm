WITH MostActive AS (
  SELECT 
    p.Id AS PostId,
    p.Title,
    p.PostTypeId,
    p.OwnerUserId,
    u.DisplayName AS OwnerName,
    u.Reputation AS OwnerReputation,
    p.CreationDate,
    p.LastActivityDate,
    p.ViewCount,
    p.Score,
    COALESCE(lu.DisplayName, '') AS LastEditorName,
    p.Tags
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN Users lu ON p.LastEditorUserId = lu.Id
  WHERE p.CreationDate >= DATEADD(year, -1, CAST('2024-10-01 12:34:56' AS TIMESTAMP))
),
MostActiveWithMeta AS (
  SELECT 
    m.PostId,
    m.Title,
    m.PostTypeId,
    m.OwnerUserId,
    m.OwnerName,
    m.OwnerReputation,
    m.CreationDate,
    m.LastActivityDate,
    m.ViewCount,
    m.Score,
    m.LastEditorName,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = m.PostId) AS CommentCount,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = m.PostId) AS LinkCount,
    CASE WHEN m.Tags IS NULL OR LENGTH(TRIM(m.Tags)) = 0 THEN 0
         ELSE (LENGTH(m.Tags) - LENGTH(REPLACE(m.Tags, '><', ''))) / 2 + 1
    END AS TagCount
  FROM MostActive m
),
SecondSet AS (
  SELECT 
    p.Id AS PostId,
    p.Title,
    p.PostTypeId,
    p.OwnerUserId,
    u.DisplayName AS OwnerName,
    u.Reputation AS OwnerReputation,
    p.CreationDate,
    p.LastActivityDate,
    p.ViewCount,
    p.Score,
    COALESCE(lu.DisplayName, '') AS LastEditorName,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCount,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id) AS LinkCount,
    CASE WHEN p.Tags IS NULL OR LENGTH(TRIM(p.Tags)) = 0 THEN 0
         ELSE (LENGTH(p.Tags) - LENGTH(REPLACE(p.Tags, '><', ''))) / 2 + 1
    END AS TagCount
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  LEFT JOIN Users lu ON p.LastEditorUserId = lu.Id
  WHERE p.CreationDate >= DATEADD(day, -7, CAST('2024-10-01 12:34:56' AS TIMESTAMP))
)
SELECT PostId, Title, PostTypeId, OwnerUserId, OwnerName, OwnerReputation,
       CreationDate, LastActivityDate, ViewCount, Score, LastEditorName,
       CommentCount, LinkCount, TagCount,
       TypeRank
FROM (
  SELECT 
    m.PostId, m.Title, m.PostTypeId, m.OwnerUserId, m.OwnerName, m.OwnerReputation,
    m.CreationDate, m.LastActivityDate, m.ViewCount, m.Score, m.LastEditorName,
    m.CommentCount, m.LinkCount, m.TagCount,
    ROW_NUMBER() OVER (PARTITION BY m.PostTypeId ORDER BY m.Score DESC, m.ViewCount DESC) AS TypeRank
  FROM MostActiveWithMeta m
  UNION ALL
  SELECT 
    s.PostId, s.Title, s.PostTypeId, s.OwnerUserId, s.OwnerName, s.OwnerReputation,
    s.CreationDate, s.LastActivityDate, s.ViewCount, s.Score, s.LastEditorName,
    s.CommentCount, s.LinkCount, s.TagCount,
    ROW_NUMBER() OVER (PARTITION BY s.PostTypeId ORDER BY s.Score DESC, s.ViewCount DESC) AS TypeRank
  FROM SecondSet s
) AS Combined
ORDER BY PostTypeId, TypeRank
OFFSET 0 ROWS FETCH NEXT 500 ROWS ONLY;