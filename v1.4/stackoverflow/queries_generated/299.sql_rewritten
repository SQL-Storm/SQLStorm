WITH
UserPosts AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName AS UserDisplayName,
    p.Id AS PostId,
    pt.Name AS PostTypeName,
    p.Title,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS UpVotes,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS DownVotes,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCount,
    (SELECT STUFF((SELECT ',' + t.TagName
                   FROM Tags t
                   WHERE t.ExcerptPostId = p.Id
                   FOR XML PATH(''), TYPE).value('.', 'nvarchar(max)'), 1, 1, '')) AS TagList
  FROM Users u
  LEFT JOIN Posts p ON p.OwnerUserId = u.Id
  LEFT JOIN PostTypes pt ON p.PostTypeId = pt.Id
  WHERE p.CreationDate >= DATEADD(day, -90, cast('2024-10-01 12:34:56' as timestamp))
),
Ranked AS (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY UserId ORDER BY Score DESC, LastActivityDate DESC) AS rn
  FROM UserPosts
),
UserSummary AS (
  SELECT u.Id AS UserId,
         u.DisplayName AS UserDisplayName
  FROM Users u
  GROUP BY u.Id, u.DisplayName
)
SELECT
  UserId,
  UserDisplayName,
  PostId,
  PostTypeName,
  Title,
  CreationDate,
  LastActivityDate,
  Score,
  ViewCount,
  UpVotes,
  DownVotes,
  CommentCount,
  TagList,
  rn AS RankInUser
FROM Ranked
WHERE rn <= 3
UNION ALL
SELECT
  UserId,
  UserDisplayName,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL,
  NULL
FROM UserSummary
ORDER BY UserId, RankInUser;