WITH
recent AS (
  SELECT p.Id AS PostId, p.Title, p.Tags, p.CreationDate, p.LastActivityDate, p.ViewCount, p.Score, p.OwnerUserId
  FROM Posts p
  WHERE p.CreationDate >= CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '365' DAY
),
votes AS (
  SELECT PostId, SUM(CASE WHEN VoteTypeId = 2 THEN 1 ELSE 0 END) AS Upvotes,
         SUM(CASE WHEN VoteTypeId = 3 THEN 1 ELSE 0 END) AS Downvotes
  FROM Votes
  GROUP BY PostId
),
allvotes AS (
  SELECT PostId, Upvotes, Downvotes, (COALESCE(Upvotes,0) + COALESCE(Downvotes,0)) AS TotalVotes
  FROM votes
),
tagcounts AS (
  SELECT p.Id AS PostId,
         CASE 
           WHEN p.Tags IS NULL OR LENGTH(p.Tags) < 3 THEN 0
           ELSE ARRAY_LENGTH(STRING_TO_ARRAY(SUBSTRING(p.Tags FROM 2 FOR LENGTH(p.Tags) - 2), '><'), 1)
         END AS TagCount
  FROM Posts p
),
close_info AS (
  SELECT m.PostId,
         COALESCE(crt.Name, 'None') AS CloseReasonName
  FROM (
     SELECT ph.PostId, MAX(ph.CreationDate) AS max_close
     FROM PostHistory ph
     WHERE ph.PostHistoryTypeId = 10
     GROUP BY ph.PostId
  ) AS m
  LEFT JOIN PostHistory ph ON ph.PostId = m.PostId AND ph.CreationDate = m.max_close
  LEFT JOIN CloseReasonTypes crt ON crt.Id = CASE
       WHEN ph.PostHistoryTypeId = 10 AND ph.Comment ~ '^[0-9]+$' THEN CAST(ph.Comment AS INTEGER)
       ELSE NULL
  END
),
owners AS (
  SELECT Id, DisplayName, Reputation
  FROM Users
),
badges_by_user AS (
  SELECT UserId,
         SUM(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS Gold,
         SUM(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS Silver,
         SUM(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS Bronze
  FROM Badges
  GROUP BY UserId
),
dataset AS (
  SELECT
    r.PostId,
    r.Title,
    r.Tags,
    r.CreationDate,
    COALESCE(r.LastActivityDate, r.CreationDate) AS LastActivityDate,
    r.ViewCount,
    r.Score,
    r.OwnerUserId,
    COALESCE(a.Upvotes, 0) AS Upvotes,
    COALESCE(a.Downvotes, 0) AS Downvotes,
    COALESCE(a.TotalVotes, 0) AS TotalVotes,
    COALESCE(tc.TagCount, 0) AS TagCount,
    COALESCE(ci.CloseReasonName, 'None') AS CloseReasonName,
    o.DisplayName AS OwnerDisplayName,
    o.Reputation AS OwnerReputation,
    LENGTH(r.Title) AS TitleLength,
    MD5(r.Title) AS TitleHash,
    COALESCE(bi.Gold, 0) AS GoldBadges,
    COALESCE(bi.Silver, 0) AS SilverBadges,
    COALESCE(bi.Bronze, 0) AS BronzeBadges,
    (r.Score * 1.5
     + COALESCE(a.TotalVotes, 0) * 1.0
     + COALESCE(tc.TagCount, 0) * 0.5
     + COALESCE(o.Reputation, 0) * 0.01
     + COALESCE(bi.Gold, 0) * 20
     + COALESCE(bi.Silver, 0) * 8
     + COALESCE(bi.Bronze, 0) * 3
    ) AS ScoreWeight,
    ROW_NUMBER() OVER (ORDER BY
      (r.Score * 1.5
       + COALESCE(a.TotalVotes, 0) * 1.0
       + COALESCE(tc.TagCount, 0) * 0.5
       + COALESCE(o.Reputation, 0) * 0.01
       + COALESCE(bi.Gold, 0) * 20
       + COALESCE(bi.Silver, 0) * 8
       + COALESCE(bi.Bronze, 0) * 3
      ) DESC) AS WeightRank,
    ROW_NUMBER() OVER (ORDER BY COALESCE(r.LastActivityDate, r.CreationDate) DESC) AS TimeRank
  FROM recent r
  LEFT JOIN allvotes a ON a.PostId = r.PostId
  LEFT JOIN tagcounts tc ON tc.PostId = r.PostId
  LEFT JOIN close_info ci ON ci.PostId = r.PostId
  LEFT JOIN owners o ON o.Id = r.OwnerUserId
  LEFT JOIN badges_by_user bi ON bi.UserId = r.OwnerUserId
)
SELECT *
FROM dataset
WHERE WeightRank <= 300
UNION ALL
SELECT *
FROM dataset
WHERE TimeRank <= 300;