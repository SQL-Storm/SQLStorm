WITH top_questions AS (
  SELECT
    p.Id AS PostId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    p.LastActivityDate,
    ROW_NUMBER() OVER (PARTITION BY p.OwnerUserId ORDER BY p.CreationDate DESC) AS rn
  FROM Posts p
  WHERE p.PostTypeId = 1 -- Questions
    AND p.ClosedDate IS NULL
    AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '1 year'
),
recent_activities AS (
  SELECT
    q.PostId,
    q.Title,
    q.CreationDate AS QuestionCreated,
    MAX(v.CreationDate) AS LastVoteDate,
    MAX(c.CreationDate) AS LastCommentDate,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpvotesReceived,
    SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownvotesReceived,
    SUM(CASE WHEN v.VoteTypeId = 2 THEN v.BountyAmount ELSE 0 END) AS PlaceholderForUpMods
  FROM top_questions q
  LEFT JOIN Votes v ON v.PostId = q.PostId
  LEFT JOIN Comments c ON c.PostId = q.PostId
  GROUP BY q.PostId, q.Title, q.CreationDate
),
tiered AS (
  SELECT
    q.PostId,
    q.Title,
    q.CreationDate,
    q.ViewCount,
    q.Score,
    q.OwnerUserId,
    ra.LastVoteDate,
    ra.LastCommentDate,
    ra.UpvotesReceived,
    ra.DownvotesReceived,
    ROW_NUMBER() OVER (
      ORDER BY q.ViewCount DESC,
               q.Score DESC,
               COALESCE(ra.LastVoteDate, q.CreationDate) DESC,
               q.PostId
    ) AS rank_in_year
  FROM top_questions q
  LEFT JOIN recent_activities ra ON ra.PostId = q.PostId
)
SELECT
  t.PostId,
  t.Title,
  t.CreationDate,
  t.ViewCount,
  t.Score,
  u.DisplayName AS Owner,
  u.Reputation,
  t.LastActivityDate,
  CASE
    WHEN t.ViewCount > 1000 THEN 'Hot'
    WHEN t.ViewCount > 100 THEN 'Warm'
    ELSE 'Cold'
  END AS VelocityTier,
  (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = t.PostId) AS RelatedLinks,
  (SELECT ARRAY_AGG(pt.Name) 
     FROM PostLinks pl2
     JOIN Posts p2 ON pl2.RelatedPostId = p2.Id
     JOIN PostTypes pt ON p2.PostTypeId = pt.Id
     WHERE pl2.PostId = t.PostId
  ) AS RelatedPostTypes,
  (SELECT STRING_AGG(CONCAT('(', pl.LinkTypeId, ') ', bt.Name), ', ')
     FROM PostLinks pl
     JOIN LinkTypes bt ON pl.LinkTypeId = bt.Id
     WHERE pl.PostId = t.PostId
  ) AS LinkTypesSummary,
  (SELECT MAX(ba.Date) FROM Badges ba WHERE ba.UserId = t.OwnerUserId) AS LastBadgeDate,
  (SELECT COUNT(*) FROM Badges b WHERE b.UserId = t.OwnerUserId AND b.Class = 1) AS GoldBadges,
  (SELECT COUNT(*) FROM Votes v2 WHERE v2.PostId = t.PostId AND v2.VoteTypeId = 14) AS ModeratorNominations
FROM tiered t
LEFT JOIN Users u ON u.Id = t.OwnerUserId
LEFT JOIN Posts p ON p.Id = t.PostId
WHERE t.rank_in_year <= 100
GROUP BY
  t.PostId,
  t.Title,
  t.CreationDate,
  t.ViewCount,
  t.Score,
  t.OwnerUserId,
  t.LastActivityDate,
  u.DisplayName,
  u.Reputation
ORDER BY t.rank_in_year, t.CreationDate DESC
LIMIT 200;