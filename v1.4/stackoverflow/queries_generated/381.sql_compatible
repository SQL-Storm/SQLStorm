WITH 
hot_posts AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    p.Title,
    p.OwnerUserId,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.Tags,
    CASE
      WHEN p.LastActivityDate IS NULL THEN NULL
      ELSE (EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - p.LastActivityDate)) / 3600.0)
    END AS hours_since_last_activity,
    CASE
      WHEN p.Tags IS NULL OR LENGTH(p.Tags) <= 2 THEN ARRAY[]::text[]
      ELSE string_to_array(SUBSTR(p.Tags, 2, LENGTH(p.Tags) - 2), '><')
    END AS TagArray,
    CASE
      WHEN p.Tags IS NULL OR LENGTH(p.Tags) <= 2 THEN 0
      ELSE ARRAY_LENGTH(string_to_array(SUBSTR(p.Tags, 2, LENGTH(p.Tags) - 2), '><'), 1)
    END AS TagCount,
    COALESCE((SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id), 0) AS CommentCount,
    COALESCE((SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2), 0) AS UpVotes,
    COALESCE((SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3), 0) AS DownVotes,
    COALESCE((SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id), 0) AS RelatedCount,
    COALESCE((SELECT MAX(v.CreationDate) FROM Votes v WHERE v.PostId = p.Id), NULL) AS LastVoteDate
  FROM Posts p
  WHERE p.LastActivityDate IS NOT NULL
    AND p.PostTypeId IN (1, 2)
),
hot_ranked AS (
  SELECT
    h.*,
    CASE
      WHEN h.hours_since_last_activity IS NULL THEN 0
      ELSE (h.Score * 4.0) + (h.ViewCount * 0.75) - h.hours_since_last_activity
    END AS Hotness
  FROM hot_posts h
),
top_posts AS (
  SELECT
    hr.*,
    ROW_NUMBER() OVER (ORDER BY Hotness DESC, LastActivityDate DESC, ViewCount DESC) AS rn
  FROM hot_ranked hr
  WHERE hr.LastActivityDate > (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '730 days')
),
tag_exploded AS (
  SELECT
    tp.PostId,
    tp.PostTypeId,
    tp.Title,
    tp.OwnerUserId,
    tp.CreationDate,
    tp.LastActivityDate,
    tp.Score,
    tp.ViewCount,
    tp.TagCount,
    tp.CommentCount,
    tp.UpVotes,
    tp.DownVotes,
    tp.RelatedCount,
    tp.LastVoteDate,
    t.Tag
  FROM top_posts tp
  LEFT JOIN LATERAL UNNEST(tp.TagArray) AS t(Tag) ON TRUE
),
final_set1 AS (
  SELECT
    te.PostId,
    te.PostTypeId,
    COALESCE(u.DisplayName, 'Unknown') AS OwnerDisplayName,
    te.Title,
    te.LastActivityDate,
    te.Score,
    te.ViewCount,
    te.Tag,
    te.TagCount,
    te.CommentCount,
    te.UpVotes,
    te.DownVotes,
    te.RelatedCount,
    te.LastVoteDate,
    te.rn
  FROM tag_exploded te
  LEFT JOIN Users u ON u.Id = te.OwnerUserId
),
final_set2 AS (
  SELECT
    p.Id AS PostId,
    p.PostTypeId,
    COALESCE(u.DisplayName, 'Unknown') AS OwnerDisplayName,
    p.Title,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    'NoTag' AS Tag,
    CASE
      WHEN p.Tags IS NULL OR LENGTH(p.Tags) <= 2 THEN 0
      ELSE ARRAY_LENGTH(string_to_array(SUBSTR(p.Tags, 2, LENGTH(p.Tags) - 2), '><'), 1)
    END AS TagCount,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCount,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 2) AS UpVotes,
    (SELECT COUNT(*) FROM Votes v WHERE v.PostId = p.Id AND v.VoteTypeId = 3) AS DownVotes,
    (SELECT COUNT(*) FROM PostLinks pl WHERE pl.PostId = p.Id) AS RelatedCount,
    (SELECT MAX(v.CreationDate) FROM Votes v WHERE v.PostId = p.Id) AS LastVoteDate,
    999999 AS rn
  FROM Posts p
  LEFT JOIN Users u ON u.Id = p.OwnerUserId
  WHERE p.LastActivityDate IS NOT NULL
    AND p.PostTypeId IN (1, 2)
    AND (p.Tags IS NULL OR LENGTH(p.Tags) <= 2)
)
SELECT *
FROM final_set1
UNION ALL
SELECT *
FROM final_set2
ORDER BY rn
LIMIT 1000;