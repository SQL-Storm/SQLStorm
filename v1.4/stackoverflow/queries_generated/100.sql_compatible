WITH
TopActiveTags AS (
  SELECT
    t.TagName,
    t.Id AS TagId,
    SUM(p.ViewCount) AS TotalViews,
    COUNT(p.Id) AS PostCount
  FROM Posts p
  JOIN Posts_tags pt ON p.Id = pt.PostId
  JOIN Tags t ON pt.TagId = t.Id
  WHERE p.PostTypeId = 1 -- questions
    AND p.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '180 days'
  GROUP BY t.TagName, t.Id
),
RecentModeration AS (
  SELECT
    ph.PostId,
    ph.CreationDate AS ModerationDate,
    ph.PostHistoryTypeId,
    ph.Comment
  FROM PostHistory ph
  WHERE ph.PostHistoryTypeId IN (10, 11, 14, 15, 16, 33, 34)
    AND ph.CreationDate >= cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '90 days'
),
TopUsers AS (
  SELECT
    u.Id AS UserId,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.Location,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.ProfileImageUrl,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.Views DESC) AS rn
  FROM Users u
  WHERE u.AccountId IS NOT NULL
),
TagAgg AS (
  SELECT
    t.TagName,
    t.Id AS TagId,
    MAX(p.LastActivityDate) AS LastActivity,
    AVG(p.Score) AS AvgScore,
    SUM(p.ViewCount) AS ViewsSum,
    COUNT(p.Id) AS Qs
  FROM Posts p
  JOIN Tags t ON p.OwnerUserId = t.Id OR p.Tags LIKE '%' || t.TagName || '%'
  WHERE p.PostTypeId = 1
  GROUP BY t.TagName, t.Id
),
CrossJoinEval AS (
  SELECT
    t.TagName,
    u.DisplayName AS TopEditor,
    vh.TotalViews,
    vh.PostCount,
    tr.ModerationDate,
    tr.PostId
  FROM TopActiveTags vh
  LEFT JOIN TopUsers u ON u.rn = 1
  LEFT JOIN RecentModeration tr ON tr.PostId = vh.TagId
  LEFT JOIN TagAgg ta ON ta.TagId = vh.TagId
)
SELECT
  t.TagName AS tag_name,
  t.TagId,
  vh.TotalViews,
  vh.PostCount,
  ta.LastActivity,
  ta.AvgScore,
  ta.Qs,
  cu.TopEditor,
  cu.ModerationDate
FROM TopActiveTags t
LEFT JOIN TagAgg ta ON ta.TagId = t.TagId
LEFT JOIN CrossJoinEval cu ON cu.TagId = t.TagId
ORDER BY vh.TotalViews DESC NULLS LAST, ta.LastActivity DESC NULLS LAST
LIMIT 100;