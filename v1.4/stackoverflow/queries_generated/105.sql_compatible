WITH
LastActivity AS (
  SELECT OwnerUserId, MAX(LastActivityDate) AS LastActivityDate
  FROM Posts
  WHERE OwnerUserId IS NOT NULL
  GROUP BY OwnerUserId
),
PostCounts AS (
  SELECT OwnerUserId, COUNT(*) AS PostCount
  FROM Posts
  GROUP BY OwnerUserId
),
VoteSums AS (
  SELECT p.OwnerUserId,
         SUM(CASE WHEN v.VoteTypeId = 2 THEN 1 ELSE 0 END) AS UpVotesCast,
         SUM(CASE WHEN v.VoteTypeId = 3 THEN 1 ELSE 0 END) AS DownVotesCast
  FROM Posts p
  LEFT JOIN Votes v ON v.PostId = p.Id
  GROUP BY p.OwnerUserId
),
BadgeStats AS (
  SELECT UserId,
         MAX(CASE WHEN Class = 1 THEN 1 ELSE 0 END) AS GoldBadges,
         MAX(CASE WHEN Class = 2 THEN 1 ELSE 0 END) AS SilverBadges,
         MAX(CASE WHEN Class = 3 THEN 1 ELSE 0 END) AS BronzeBadges
  FROM Badges
  GROUP BY UserId
),
TopTagCandidates AS (
  -- collect top tags used by each user via their questions' tags
  SELECT p.OwnerUserId AS UserId,
         UNNEST(string_to_array(substr(p.Tags, 2, length(p.Tags) - 2), '><')) AS TagName
  FROM Posts p
  WHERE p.PostTypeId = 1 AND p.OwnerUserId IS NOT NULL
),
UserTopTags AS (
  SELECT UserId,
         ARRAY_AGG(DISTINCT TagName ORDER BY TagName) AS TopTags
  FROM TopTagCandidates
  JOIN Tags t ON t.TagName = TagName
  GROUP BY UserId
)
SELECT
  u.Id,
  u.DisplayName,
  u.Reputation,
  COALESCE(pc.PostCount, 0) AS TotalPosts,
  COALESCE(vs.UpVotesCast, 0) AS UpVotesCast,
  COALESCE(vs.DownVotesCast, 0) AS DownVotesCast,
  COALESCE(la.LastActivityDate, u.CreationDate) AS LastActivityDate,
  COALESCE(bs.GoldBadges, 0) AS GoldBadges,
  COALESCE(bs.SilverBadges, 0) AS SilverBadges,
  COALESCE(bs.BronzeBadges, 0) AS BronzeBadges,
  COALESCE(utt.TopTags, ARRAY[]::text[]) AS TopTags,
  (SELECT AVG(CHAR_LENGTH(p.Body)) FROM Posts p WHERE p.OwnerUserId = u.Id) AS AvgPostBodyLength,
  (SELECT COUNT(*) FROM Comments c WHERE c.UserId = u.Id) AS CommentCount,
  (SELECT COUNT(*) FROM Badges b WHERE b.UserId = u.Id) AS BadgeCount,
  -- Example complex expression to benchmark NULL handling and calculations
  (CASE WHEN u.LastAccessDate IS NULL THEN 0
        ELSE EXTRACT(EPOCH FROM (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - u.LastAccessDate))::INT END) AS SecondsSinceLastAccess
FROM Users u
LEFT JOIN PostCounts pc ON pc.OwnerUserId = u.Id
LEFT JOIN VoteSums vs ON vs.OwnerUserId = u.Id
LEFT JOIN LastActivity la ON la.OwnerUserId = u.Id
LEFT JOIN BadgeStats bs ON bs.UserId = u.Id
LEFT JOIN UserTopTags utt ON utt.UserId = u.Id
GROUP BY
  u.Id,
  u.DisplayName,
  u.Reputation,
  pc.PostCount,
  vs.UpVotesCast,
  vs.DownVotesCast,
  la.LastActivityDate,
  bs.GoldBadges,
  bs.SilverBadges,
  bs.BronzeBadges,
  utt.TopTags
ORDER BY u.Reputation DESC, TotalPosts DESC
LIMIT 200;