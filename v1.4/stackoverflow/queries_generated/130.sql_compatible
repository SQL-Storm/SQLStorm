WITH
RecentPosts AS (
  SELECT
    p.Id,
    p.Title,
    p.CreationDate,
    p.LastActivityDate,
    p.Score,
    p.ViewCount,
    p.OwnerUserId,
    u.DisplayName AS OwnerName,
    u.Reputation,
    p.PostTypeId,
    (SELECT COUNT(*) FROM Comments c WHERE c.PostId = p.Id) AS CommentCount
  FROM Posts p
  LEFT JOIN Users u ON p.OwnerUserId = u.Id
  WHERE p.CreationDate > cast('2024-10-01 12:34:56' as timestamp) - INTERVAL '180 days'
),
UpVotes AS (
  SELECT
    v.PostId,
    COUNT(*) AS UpVotes
  FROM Votes v
  JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
  WHERE vt.Name IN ('UpMod', 'AcceptedByOriginator')
  GROUP BY v.PostId
),
DownVotes AS (
  SELECT
    v.PostId,
    COUNT(*) AS DownVotes
  FROM Votes v
  JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
  WHERE vt.Name = 'DownMod'
  GROUP BY v.PostId
),
TagInfo AS (
  SELECT
    t.TagName,
    t.Count,
    t.ExcerptPostId,
    t.WikiPostId
  FROM Tags t
),
Links AS (
  SELECT
    pl.PostId,
    COUNT(*) FILTER (WHERE lt.Id = 1) AS LinkedCount,
    COUNT(*) FILTER (WHERE lt.Id = 3) AS DuplicateCount
  FROM PostLinks pl
  JOIN LinkTypes lt ON pl.LinkTypeId = lt.Id
  GROUP BY pl.PostId
),
Merged AS (
  SELECT
    rp.Id,
    rp.Title,
    rp.CreationDate,
    rp.LastActivityDate,
    rp.Score,
    rp.ViewCount,
    rp.OwnerUserId,
    rp.OwnerName,
    rp.Reputation,
    COALESCE(uv.UpVotes, 0) AS UpVotes,
    COALESCE(dv.DownVotes, 0) AS DownVotes,
    COALESCE(ti.Count, 0) AS TagCount,
    COALESCE(li.LinkedCount, 0) AS LinkedCount,
    COALESCE(rp.CommentCount, 0) AS CommentCount,
    ROW_NUMBER() OVER (PARTITION BY rp.PostTypeId ORDER BY rp.Score DESC, rp.LastActivityDate DESC) AS TypeRank,
    (
      SELECT STRING_AGG(TagName, ',')
      FROM Tags t
      WHERE t.Id IN (
        SELECT CAST(value AS INTEGER)
        FROM UNNEST(string_to_array(rp.Tags, '>')) AS value
      )
    ) AS TagList
  FROM RecentPosts rp
  LEFT JOIN UpVotes uv ON rp.Id = uv.PostId
  LEFT JOIN DownVotes dv ON rp.Id = dv.PostId
  LEFT JOIN TagInfo ti ON rp.Id = ti.ExcerptPostId OR rp.Id = ti.WikiPostId
  LEFT JOIN Links li ON rp.Id = li.PostId
)
SELECT
  Id,
  Title,
  CreationDate,
  LastActivityDate,
  Score,
  ViewCount,
  OwnerUserId,
  OwnerName,
  Reputation,
  UpVotes,
  DownVotes,
  TagCount,
  LinkedCount,
  CommentCount,
  TypeRank,
  TagList
FROM Merged
ORDER BY CreationDate DESC
LIMIT 100;