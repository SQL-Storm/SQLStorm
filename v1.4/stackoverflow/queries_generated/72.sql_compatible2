WITH top_users AS (
  SELECT
    u.Id,
    u.DisplayName,
    u.Reputation,
    u.CreationDate,
    u.LastAccessDate,
    u.Location,
    u.Views,
    u.UpVotes,
    u.DownVotes,
    u.AccountId,
    ROW_NUMBER() OVER (ORDER BY u.Reputation DESC, u.Views DESC, u.LastAccessDate DESC) AS rn
  FROM Users u
),
recent_posts AS (
  SELECT
    p.Id,
    p.OwnerUserId,
    p.PostTypeId,
    p.Title,
    p.Tags,
    p.CreationDate,
    p.Score,
    p.ViewCount,
    p.CommentCount,
    p.AnswerCount,
    p.LastActivityDate,
    p.ParentId,
    p.AcceptedAnswerId
  FROM Posts p
  WHERE p.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '90 days')
),
recent_votes AS (
  SELECT
    v.Id,
    v.PostId,
    v.VoteTypeId,
    v.UserId,
    v.CreationDate,
    v.BountyAmount,
    vt.Name AS VoteTypeName
  FROM Votes v
  JOIN VoteTypes vt ON v.VoteTypeId = vt.Id
  WHERE v.CreationDate >= (CAST('2024-10-01 12:34:56' AS TIMESTAMP) - INTERVAL '90 days')
),
tag_relations AS (
  SELECT
    t.Id AS TagId,
    t.TagName,
    t.Count,
    t.IsModeratorOnly,
    t.IsRequired,
    t.ExcerptPostId,
    t.WikiPostId
  FROM Tags t
  WHERE t.IsModeratorOnly = 0
),
post_history_summary AS (
  SELECT
    ph.PostId,
    MAX(CASE WHEN pht.Name = 'Post Closed' THEN ph.CreationDate END) AS last_closed_date,
    MAX(CASE WHEN pht.Name = 'Post Reopened' THEN ph.CreationDate END) AS last_reopened_date,
    COUNT(*) FILTER (WHERE ph.PostHistoryTypeId IN (10,11,12,13,14,15,19,20)) AS history_lock_or_vote_events
  FROM PostHistory ph
  JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
  GROUP BY ph.PostId
),
complex_joins AS (
  SELECT
    pr.Id AS PostId,
    pr.Title,
    pr.Score,
    pr.ViewCount,
    pr.CommentCount,
    pr.AnswerCount,
    pr.CreationDate,
    pr.LastActivityDate,
    pr.OwnerUserId,
    uu.DisplayName AS OwnerDisplayName,
    COALESCE(vt.Name, 'Unknown') AS LastEditorVoteType,
    COALESCE(lb.TagBased, 0) AS IsTagBased
  FROM recent_posts pr
  LEFT JOIN Users uu ON pr.OwnerUserId = uu.Id
  LEFT JOIN PostHistory ph ON ph.PostId = pr.Id
  LEFT JOIN PostHistoryTypes pht ON ph.PostHistoryTypeId = pht.Id
  LEFT JOIN Votes v ON v.PostId = pr.Id AND v.UserId = ph.UserId
  LEFT JOIN Tags lb ON pr.Tags LIKE '%' || lb.TagName || '%'
)
SELECT
  tu.Id AS UserId,
  tu.DisplayName AS UserDisplayName,
  tu.Reputation,
  tu.CreationDate AS UserCreationDate,
  tu.LastAccessDate AS UserLastAccessDate,
  tu.Location,
  tu.Views,
  tu.UpVotes,
  tu.DownVotes,
  pr.PostId,
  pr.Title AS PostTitle,
  pr.Score,
  pr.ViewCount,
  pr.CommentCount,
  pr.AnswerCount,
  pr.CreationDate AS PostCreationDate,
  pr.LastActivityDate AS PostLastActivityDate,
  pr.OwnerDisplayName,
  pr.LastEditorVoteType,
  pr.IsTagBased,
  rps.last_closed_date AS PostLastClosedDate,
  rps.last_reopened_date AS PostLastReopenedDate,
  rps.history_lock_or_vote_events,
  av.Name AS RelatedVoteTypeName
FROM top_users tu
JOIN complex_joins pr ON pr.OwnerUserId = tu.Id
LEFT JOIN post_history_summary rps ON rps.PostId = pr.PostId
LEFT JOIN recent_votes rv ON rv.PostId = pr.PostId
LEFT JOIN Votes av ON av.PostId = pr.PostId AND av.VoteTypeId = 16
WHERE tu.rn <= 100
ORDER BY tu.Reputation DESC, pr.LastActivityDate DESC
FETCH FIRST 100 ROWS ONLY;